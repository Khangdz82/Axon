// Axon Production SQLite3 Binding (`std/sqlite.ax`)
// Dynamically binds `winsqlite3.dll` (built into Windows 10/11), `sqlite3.dll`,
// `libsqlite3.so.0`, or `libsqlite3.dylib` via `std::ffi`.
// Supports in-memory (`":memory:"`) and persistent databases with SQL-injection-proof prepared statements.

use std::ffi
use std::fmt

struct SqliteApi {
    lib: i64
    fn_open: i64
    fn_close: i64
    fn_close_v2: i64
    fn_exec: i64
    fn_prepare_v2: i64
    fn_bind_null: i64
    fn_bind_int64: i64
    fn_bind_text: i64
    fn_bind_blob: i64
    fn_step: i64
    fn_reset: i64
    fn_col_count: i64
    fn_col_type: i64
    fn_col_int64: i64
    fn_col_text: i64
    fn_col_blob: i64
    fn_col_bytes: i64
    fn_col_name: i64
    fn_finalize: i64
    fn_changes: i64
    fn_last_rowid: i64
    fn_errmsg: i64
}

struct SqliteDb {
    handle: i64
    api: SqliteApi
}

struct SqliteStmt {
    handle: i64
    api: SqliteApi
}

fn sqlite_load() -> SqliteApi ! i64 {
    mut lib := ffi_open_one("winsqlite3.dll")
    if lib == 0 { lib = ffi_open("sqlite3.dll", "libsqlite3.so.0", "libsqlite3.dylib") }
    if lib == 0 { lib = ffi_open_one("libsqlite3.so") }
    if lib == 0 { return err(-200) }
    api := SqliteApi(
        lib = lib,
        fn_open = ffi_sym(lib, "sqlite3_open"),
        fn_close = ffi_sym(lib, "sqlite3_close"),
        fn_close_v2 = ffi_sym(lib, "sqlite3_close_v2"),
        fn_exec = ffi_sym(lib, "sqlite3_exec"),
        fn_prepare_v2 = ffi_sym(lib, "sqlite3_prepare_v2"),
        fn_bind_null = ffi_sym(lib, "sqlite3_bind_null"),
        fn_bind_int64 = ffi_sym(lib, "sqlite3_bind_int64"),
        fn_bind_text = ffi_sym(lib, "sqlite3_bind_text"),
        fn_bind_blob = ffi_sym(lib, "sqlite3_bind_blob"),
        fn_step = ffi_sym(lib, "sqlite3_step"),
        fn_reset = ffi_sym(lib, "sqlite3_reset"),
        fn_col_count = ffi_sym(lib, "sqlite3_column_count"),
        fn_col_type = ffi_sym(lib, "sqlite3_column_type"),
        fn_col_int64 = ffi_sym(lib, "sqlite3_column_int64"),
        fn_col_text = ffi_sym(lib, "sqlite3_column_text"),
        fn_col_blob = ffi_sym(lib, "sqlite3_column_blob"),
        fn_col_bytes = ffi_sym(lib, "sqlite3_column_bytes"),
        fn_col_name = ffi_sym(lib, "sqlite3_column_name"),
        fn_finalize = ffi_sym(lib, "sqlite3_finalize"),
        fn_changes = ffi_sym(lib, "sqlite3_changes"),
        fn_last_rowid = ffi_sym(lib, "sqlite3_last_insert_rowid"),
        fn_errmsg = ffi_sym(lib, "sqlite3_errmsg")
    )
    if api.fn_open == 0 { return err(-201) }
    return ok(api)
}

fn _sqlite_has_nul(s: str) -> bool {
    n := str_len(s)
    mut i := 0
    while i < n {
        if str_byte(s, i) == 0 { return true }
        i += 1
    }
    return false
}

fn sqlite_open(path: str) -> SqliteDb ! i64 {
    if _sqlite_has_nul(path) { return err(-203) }
    api := sqlite_load() or return
    cp := ffi_cstr(path)
    out_box := ffi_alloc(16)
    if cp == 0 or out_box == 0 {
        ffi_free(cp)
        ffi_free(out_box)
        return err(-204)
    }
    rc := ffi_sext32(ffi_call2(api.fn_open, cp, out_box))
    h := ffi_read_i64(out_box, 0)
    ffi_free(out_box)
    ffi_free(cp)
    if rc != 0 or h == 0 {
        if h != 0 { _ := ffi_call1(if api.fn_close_v2 != 0 { api.fn_close_v2 } else { api.fn_close }, h) }
        return err(if rc != 0 { rc } else { -205 })
    }
    return ok(SqliteDb(handle = h, api = api))
}

fn sqlite_exec(db: SqliteDb, sql: str) -> bool {
    if db.handle == 0 or _sqlite_has_nul(sql) { return false }
    cs := ffi_cstr(sql)
    if cs == 0 { return false }
    rc := ffi_sext32(ffi_call5(db.api.fn_exec, db.handle, cs, 0, 0, 0))
    ffi_free(cs)
    return rc == 0
}

fn sqlite_prepare(db: SqliteDb, sql: str) -> SqliteStmt ! i64 {
    if db.handle == 0 or _sqlite_has_nul(sql) or str_len(sql) > 0x7FFFFFFF { return err(-202) }
    cs := ffi_cstr(sql)
    out_box := ffi_alloc(16)
    if cs == 0 or out_box == 0 {
        ffi_free(cs)
        ffi_free(out_box)
        return err(-204)
    }
    rc := ffi_sext32(ffi_call5(db.api.fn_prepare_v2, db.handle, cs, str_len(sql), out_box, 0))
    sh := ffi_read_i64(out_box, 0)
    ffi_free(out_box)
    ffi_free(cs)
    if rc != 0 or sh == 0 { return err(if rc != 0 { rc } else { -205 }) }
    return ok(SqliteStmt(handle = sh, api = db.api))
}

fn sqlite_bind_null(stmt: SqliteStmt, idx_1based: i64) -> bool {
    if stmt.handle == 0 or stmt.api.fn_bind_null == 0 { return false }
    return ffi_sext32(ffi_call2(stmt.api.fn_bind_null, stmt.handle, idx_1based)) == 0
}

fn sqlite_bind_i64(stmt: SqliteStmt, idx_1based: i64, val: i64) -> bool {
    if stmt.handle == 0 { return false }
    return ffi_sext32(ffi_call3(stmt.api.fn_bind_int64, stmt.handle, idx_1based, val)) == 0
}

fn sqlite_bind_f64(stmt: SqliteStmt, idx_1based: i64, val: f64) -> bool {
    return sqlite_bind_text(stmt, idx_1based, fmt_f64(val, 10))
}

fn sqlite_bind_text(stmt: SqliteStmt, idx_1based: i64, text: str) -> bool {
    if stmt.handle == 0 or str_len(text) > 0x7FFFFFFF { return false }
    ct := ffi_cstr(text)
    if ct == 0 { return false }
    // SQLITE_TRANSIENT = -1 so SQLite copies the buffer immediately
    rc := ffi_sext32(ffi_call5(stmt.api.fn_bind_text, stmt.handle, idx_1based, ct, str_len(text), -1))
    ffi_free(ct)
    return rc == 0
}

fn sqlite_bind_blob(stmt: SqliteStmt, idx_1based: i64, data: ByteBuf) -> bool {
    n := buf_len(data)
    if stmt.handle == 0 or stmt.api.fn_bind_blob == 0 or n > 0x7FFFFFFF { return false }
    if n == 0 {
        empty_p := ffi_alloc(8)
        rc0 := ffi_sext32(ffi_call5(stmt.api.fn_bind_blob, stmt.handle, idx_1based, empty_p, 0, -1))
        ffi_free(empty_p)
        return rc0 == 0
    }
    bp := ffi_bytes_to_ptr(data)
    if bp == 0 { return false }
    rc := ffi_sext32(ffi_call5(stmt.api.fn_bind_blob, stmt.handle, idx_1based, bp, n, -1))
    ffi_free(bp)
    return rc == 0
}

// Returns `100` (`SQLITE_ROW`) when a row is ready, `101` (`SQLITE_DONE`) when finished
fn sqlite_step(stmt: SqliteStmt) -> i64 {
    if stmt.handle == 0 { return -202 }
    return ffi_sext32(ffi_call1(stmt.api.fn_step, stmt.handle))
}

fn sqlite_reset(stmt: SqliteStmt) -> bool {
    if stmt.handle == 0 or stmt.api.fn_reset == 0 { return false }
    return ffi_sext32(ffi_call1(stmt.api.fn_reset, stmt.handle)) == 0
}

fn sqlite_col_count(stmt: SqliteStmt) -> i64 {
    if stmt.handle == 0 { return 0 }
    return ffi_sext32(ffi_call1(stmt.api.fn_col_count, stmt.handle))
}

// Column affinity type: `1=SQLITE_INTEGER, 2=SQLITE_FLOAT, 3=SQLITE_TEXT, 4=SQLITE_BLOB, 5=SQLITE_NULL`
fn sqlite_col_type(stmt: SqliteStmt, col_0based: i64) -> i64 {
    if stmt.handle == 0 or col_0based < 0 or stmt.api.fn_col_type == 0 { return 5 }
    return ffi_sext32(ffi_call2(stmt.api.fn_col_type, stmt.handle, col_0based))
}

fn sqlite_col_i64(stmt: SqliteStmt, col_0based: i64) -> i64 {
    if stmt.handle == 0 or col_0based < 0 { return 0 }
    return ffi_call2(stmt.api.fn_col_int64, stmt.handle, col_0based)
}

fn sqlite_col_f64(stmt: SqliteStmt, col_0based: i64) -> f64 {
    s := sqlite_col_text(stmt, col_0based)
    n := str_len(s)
    if n == 0 { return 0.0 }
    mut pos := 0
    mut sign := 1.0
    if str_byte(s, 0) == 45 { sign = -1.0; pos = 1 } else if str_byte(s, 0) == 43 { pos = 1 }
    mut int_p := 0.0
    while pos < n {
        ch := str_byte(s, pos)
        if ch >= 48 and ch <= 57 { int_p = int_p * 10.0 + ((ch - 48) as f64); pos += 1 } else { break }
    }
    mut frac_p := 0.0
    mut scale := 1.0
    if pos < n and str_byte(s, pos) == 46 {
        pos += 1
        while pos < n {
            ch := str_byte(s, pos)
            if ch >= 48 and ch <= 57 { frac_p = frac_p * 10.0 + ((ch - 48) as f64); scale = scale * 10.0; pos += 1 } else { break }
        }
    }
    return sign * (int_p + frac_p / scale)
}

fn sqlite_col_blob(stmt: SqliteStmt, col_0based: i64) -> ByteBuf {
    if stmt.handle == 0 or col_0based < 0 or stmt.api.fn_col_blob == 0 or stmt.api.fn_col_bytes == 0 {
        return buf_new(0)
    }
    p := ffi_call2(stmt.api.fn_col_blob, stmt.handle, col_0based)
    nb := ffi_sext32(ffi_call2(stmt.api.fn_col_bytes, stmt.handle, col_0based))
    if p == 0 or nb <= 0 { return buf_new(0) }
    return ffi_read_bytes(p, nb)
}

fn sqlite_col_text(stmt: SqliteStmt, col_0based: i64) -> str {
    if stmt.handle == 0 or col_0based < 0 { return "" }
    p := ffi_call2(stmt.api.fn_col_text, stmt.handle, col_0based)
    if p == 0 { return "" }
    if stmt.api.fn_col_bytes != 0 {
        mut nb := ffi_sext32(ffi_call2(stmt.api.fn_col_bytes, stmt.handle, col_0based))
        if nb <= 0 { return "" }
        if nb > 67108864 { nb = 67108864 }
        out := buf_new(nb + 4)
        mut i := 0
        unsafe {
            while i < nb {
                buf_push(out, ptr_read_u8(p + i, 0))
                i += 1
            }
        }
        return buf_to_owned_str(move out)
    }
    return ffi_read_cstr(p, 65536)
}

fn sqlite_col_name(stmt: SqliteStmt, col_0based: i64) -> str {
    if stmt.handle == 0 or col_0based < 0 { return "" }
    p := ffi_call2(stmt.api.fn_col_name, stmt.handle, col_0based)
    if p == 0 { return "" }
    return ffi_read_cstr(p, 1024)
}

fn sqlite_finalize(stmt: SqliteStmt) {
    if stmt.handle != 0 { _ := ffi_call1(stmt.api.fn_finalize, stmt.handle) }
}

fn sqlite_changes(db: SqliteDb) -> i64 {
    if db.handle == 0 { return 0 }
    return ffi_sext32(ffi_call1(db.api.fn_changes, db.handle))
}

fn sqlite_last_insert_rowid(db: SqliteDb) -> i64 {
    if db.handle == 0 { return 0 }
    return ffi_call1(db.api.fn_last_rowid, db.handle)
}

fn sqlite_errmsg(db: SqliteDb) -> str {
    if db.handle == 0 { return "" }
    p := ffi_call1(db.api.fn_errmsg, db.handle)
    return ffi_read_cstr(p, 4096)
}

fn sqlite_close(db: SqliteDb) {
    if db.handle != 0 {
        f_cls := if db.api.fn_close_v2 != 0 { db.api.fn_close_v2 } else { db.api.fn_close }
        _ := ffi_call1(f_cls, db.handle)
    }
}
