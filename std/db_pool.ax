// Axon Standard Library — SQL-Injection-Proof `SqlBuilder`, Connection Pool & Schema Migrations (`std/db_pool.ax`)
// 100% Pure Axon. Enforces strict `[A-Za-z0-9_.]` identifier allowlists and 100% parameterized
// bound values (`?` for SQLite/MySQL, `$1..$N` for PostgreSQL), plus WAL-tuned `SqlitePool` & `db_migrate_sqlite`.

use std::str
use std::ds
use std::sqlite

fn sql_dialect_sqlite() -> i64   { return 1 } // `?`
fn sql_dialect_mysql() -> i64    { return 1 } // `?`
fn sql_dialect_postgres() -> i64 { return 2 } // `$1, $2, ...`

struct SqlBuilder {
    dialect: i64
    kind: i64
    table: str
    select_cols: str
    where_sql: ByteBuf
    set_sql: ByteBuf
    ins_cols: StrVec
    order_clause: str
    limit_val: i64
    param_types: IntBuf
    param_ints: IntBuf
    param_strs: StrVec
    valid: bool
}

struct SqlitePool {
    path: str
    conns: IntBuf
    in_use: IntBuf
    api: SqliteApi
    cap: i64
}

fn _sqlb_ident_ok(ident: str) -> bool {
    n := str_len(ident)
    if n <= 0 or n > 128 { return false }
    mut i := 0
    while i < n {
        ch := str_byte(ident, i)
        ok_ch := (ch >= 65 and ch <= 90)
              or (ch >= 97 and ch <= 122)
              or (ch >= 48 and ch <= 57 and i > 0)
              or ch == 95 or ch == 46 or ch == 42
        if not ok_ch { return false }
        i += 1
    }
    return true
}

fn _sqlb_cols_ok(cols: str) -> bool {
    trimmed := str_trim(cols)
    n := str_len(trimmed)
    if n <= 0 or n > 512 { return false }
    if str_eq(trimmed, "*") { return true }
    mut pos := 0
    while pos < n {
        mut comma := str_find_byte(trimmed, 44, pos)
        if comma < 0 { comma = n }
        part := str_trim(str_slice(trimmed, pos, comma))
        if str_eq(part, "*") or str_contains(part, "*") or not _sqlb_ident_ok(part) {
            return false
        }
        pos = comma + 1
    }
    return true
}

fn _sqlb_placeholder(dialect: i64, idx_1based: i64) -> str {
    if dialect == 2 { return "$" + str_from_i64(idx_1based) }
    return "?"
}

fn sqlb_select(table: str, cols: str = "*", dialect: i64 = 1) -> SqlBuilder {
    ok_id := _sqlb_ident_ok(table) and _sqlb_cols_ok(cols)
    return SqlBuilder(
        dialect = dialect,
        kind = 1,
        table = table,
        select_cols = str_trim(cols),
        where_sql = buf_new(4096),
        set_sql = buf_new(256),
        ins_cols = svec_new(64, 1024),
        order_clause = "",
        limit_val = -1,
        param_types = ibuf_new(256),
        param_ints = ibuf_new(256),
        param_strs = svec_new(256, 4096),
        valid = ok_id
    )
}

fn sqlb_insert(table: str, dialect: i64 = 1) -> SqlBuilder {
    ok_id := _sqlb_ident_ok(table)
    return SqlBuilder(
        dialect = dialect,
        kind = 2,
        table = table,
        select_cols = "",
        where_sql = buf_new(256),
        set_sql = buf_new(256),
        ins_cols = svec_new(64, 1024),
        order_clause = "",
        limit_val = -1,
        param_types = ibuf_new(256),
        param_ints = ibuf_new(256),
        param_strs = svec_new(256, 4096),
        valid = ok_id
    )
}

fn sqlb_free(move b: SqlBuilder) {
    buf_free(b.where_sql)
    buf_free(b.set_sql)
    svec_free(b.ins_cols)
    buf_free(b.param_types)
    buf_free(b.param_ints)
    svec_free(b.param_strs)
}

fn _sqlb_add_param_i64(mut b: SqlBuilder, val: i64) -> str {
    if ibuf_len(b.param_types) >= 256 { b.valid = false; return "?" }
    ibuf_push(b.param_types, 1)
    ibuf_push(b.param_ints, val)
    svec_push(mut b.param_strs, "")
    return _sqlb_placeholder(b.dialect, ibuf_len(b.param_types))
}

fn _sqlb_add_param_str(mut b: SqlBuilder, val: str) -> str {
    if ibuf_len(b.param_types) >= 256 { b.valid = false; return "?" }
    ibuf_push(b.param_types, 2)
    ibuf_push(b.param_ints, 0)
    svec_push(mut b.param_strs, val)
    return _sqlb_placeholder(b.dialect, ibuf_len(b.param_types))
}

fn sqlb_insert_i64(mut b: SqlBuilder, col: str, val: i64) {
    if not _sqlb_ident_ok(col) or svec_len(b.ins_cols) >= 64 { b.valid = false; return }
    svec_push(mut b.ins_cols, col)
    _ := _sqlb_add_param_i64(mut b, val)
}

fn sqlb_insert_str(mut b: SqlBuilder, col: str, val: str) {
    if not _sqlb_ident_ok(col) or svec_len(b.ins_cols) >= 64 { b.valid = false; return }
    svec_push(mut b.ins_cols, col)
    _ := _sqlb_add_param_str(mut b, val)
}

fn _sqlb_op_ok(op: str) -> bool {
    return str_eq(op, "=") or str_eq(op, "!=") or str_eq(op, ">")
        or str_eq(op, ">=") or str_eq(op, "<") or str_eq(op, "<=") or str_eq(op, "LIKE")
}

fn sqlb_where_i64(mut b: SqlBuilder, col: str, op: str, val: i64) {
    if not _sqlb_ident_ok(col) or not _sqlb_op_ok(op) { b.valid = false; return }
    ph := _sqlb_add_param_i64(mut b, val)
    if buf_len(b.where_sql) + str_len(col) + str_len(op) + str_len(ph) + 12 >= 4096 { b.valid = false; return }
    if buf_len(b.where_sql) > 0 { buf_push_str(b.where_sql, " AND ") }
    buf_push_str(b.where_sql, col + " " + op + " " + ph)
}

fn sqlb_where_str(mut b: SqlBuilder, col: str, op: str, val: str) {
    if not _sqlb_ident_ok(col) or not _sqlb_op_ok(op) { b.valid = false; return }
    ph := _sqlb_add_param_str(mut b, val)
    if buf_len(b.where_sql) + str_len(col) + str_len(op) + str_len(ph) + 12 >= 4096 { b.valid = false; return }
    if buf_len(b.where_sql) > 0 { buf_push_str(b.where_sql, " AND ") }
    buf_push_str(b.where_sql, col + " " + op + " " + ph)
}

fn sqlb_order_by(mut b: SqlBuilder, col: str, asc: bool = true) {
    if not _sqlb_ident_ok(col) { b.valid = false; return }
    b.order_clause = col + (if asc { " ASC" } else { " DESC" })
}

fn sqlb_limit(mut b: SqlBuilder, n: i64) {
    b.limit_val = n
}

fn sqlb_build_sql(b: SqlBuilder) -> str ! i64 {
    if not b.valid { return err(400) }
    need_cap := str_len(b.table) + str_len(b.select_cols) + buf_len(b.where_sql) + str_len(b.order_clause) + (svec_len(b.ins_cols) * 48) + 256
    out := buf_new(need_cap)
    if b.kind == 1 {
        buf_push_str(out, "SELECT " + b.select_cols + " FROM " + b.table)
        if buf_len(b.where_sql) > 0 {
            buf_push_str(out, " WHERE ")
            buf_push_str(out, buf_slice_str(b.where_sql, 0, buf_len(b.where_sql)))
        }
        if str_len(b.order_clause) > 0 {
            buf_push_str(out, " ORDER BY " + b.order_clause)
        }
        if b.limit_val >= 0 {
            buf_push_str(out, " LIMIT " + str_from_i64(b.limit_val))
        }
        return ok(buf_to_owned_str(move out))
    }
    if b.kind == 2 {
        nc := svec_len(b.ins_cols)
        if nc <= 0 { buf_free(move out); return err(400) }
        buf_push_str(out, "INSERT INTO " + b.table + " (")
        mut i := 0
        while i < nc {
            if i > 0 { buf_push_str(out, ", ") }
            buf_push_str(out, svec_get(b.ins_cols, i))
            i += 1
        }
        buf_push_str(out, ") VALUES (")
        i = 0
        while i < nc {
            if i > 0 { buf_push_str(out, ", ") }
            buf_push_str(out, _sqlb_placeholder(b.dialect, i + 1))
            i += 1
        }
        buf_push_str(out, ")")
        return ok(buf_to_owned_str(move out))
    }
    buf_free(move out)
    return err(400)
}

// Prepares and binds all `SqlBuilder` parameters securely onto a `SqliteDb` statement!
fn sqlb_prepare_sqlite(db: SqliteDb, b: SqlBuilder) -> SqliteStmt ! i64 {
    sql := sqlb_build_sql(b) or return err(400)
    stmt := sqlite_prepare(db, sql) or return err(500)
    np := ibuf_len(b.param_types)
    mut i := 0
    while i < np {
        pt := ibuf_get(b.param_types, i)
        ok_b := if pt == 1 {
            sqlite_bind_i64(stmt, i + 1, ibuf_get(b.param_ints, i))
        } else {
            sqlite_bind_text(stmt, i + 1, svec_get(b.param_strs, i))
        }
        if not ok_b {
            sqlite_finalize(stmt)
            return err(500)
        }
        i += 1
    }
    return ok(stmt)
}

// ============================================================================
// 2. WAL-Tuned SQLite Connection Pool (`SqlitePool`) & Transactional Migrations
// ============================================================================

fn db_pool_open_sqlite(path: str, pool_size: i64 = 4) -> SqlitePool ! i64 {
    sz := if pool_size < 1 { 1 } else { pool_size }
    first := sqlite_open(path) or return err(-200)
    _ := sqlite_exec(first, "PRAGMA journal_mode=WAL; PRAGMA synchronous=NORMAL; PRAGMA foreign_keys=ON;")
    conns := ibuf_new(sz + 4)
    in_use := ibuf_new(sz + 4)
    ibuf_push(conns, first.handle)
    ibuf_push(in_use, 0)
    mut i := 1
    while i < sz {
         extra := sqlite_open(path) or return err(-205)
        _ := sqlite_exec(extra, "PRAGMA foreign_keys=ON;")
        ibuf_push(conns, extra.handle)
        ibuf_push(in_use, 0)
        i += 1
    }
    return ok(SqlitePool(path, conns, in_use, first.api, sz))
}

fn db_pool_acquire(pool: SqlitePool) -> SqliteDb ! i64 {
    mut i := 0
    while i < pool.cap {
        if ibuf_get(pool.in_use, i) == 0 {
            ibuf_set(pool.in_use, i, 1)
            return ok(SqliteDb(ibuf_get(pool.conns, i), pool.api))
        }
        i += 1
    }
    return err(503) // Pool exhausted
}

fn db_pool_release(pool: SqlitePool, db: SqliteDb) {
    mut i := 0
    while i < pool.cap {
        if ibuf_get(pool.conns, i) == db.handle {
            ibuf_set(pool.in_use, i, 0)
            return
        }
        i += 1
    }
}

fn db_pool_close(move pool: SqlitePool) {
    mut i := 0
    while i < pool.cap {
        sqlite_close(SqliteDb(ibuf_get(pool.conns, i), pool.api))
        i += 1
    }
    buf_free(pool.conns)
    buf_free(pool.in_use)
}

// Idempotent, transactional schema migration runner (`_axon_migrations` ledger).
fn db_migrate_sqlite(db: SqliteDb, version: i64, name: str, up_sql: str) -> bool {
    ok_tbl := sqlite_exec(db, "CREATE TABLE IF NOT EXISTS _axon_migrations (version INTEGER PRIMARY KEY, name TEXT NOT NULL);")
    if not ok_tbl { return false }
    chk := sqlite_prepare(db, "SELECT version FROM _axon_migrations WHERE version = ?;") or return false
    _ := sqlite_bind_i64(chk, 1, version)
    rc_step := sqlite_step(chk)
    sqlite_finalize(chk)
    if rc_step == 100 {
        return true // Already applied!
    }
    if not sqlite_exec(db, "BEGIN IMMEDIATE;") { return false }
    if not sqlite_exec(db, up_sql) {
        _ := sqlite_exec(db, "ROLLBACK;")
        return false
    }
    ins := sqlite_prepare(db, "INSERT INTO _axon_migrations (version, name) VALUES (?, ?);") or SqliteStmt(0, db.api)
    if ins.handle == 0 {
        _ := sqlite_exec(db, "ROLLBACK;")
        return false
    }
    _ := sqlite_bind_i64(ins, 1, version)
    _ := sqlite_bind_text(ins, 2, name)
    st := sqlite_step(ins)
    sqlite_finalize(ins)
    if st != 101 {
        _ := sqlite_exec(db, "ROLLBACK;")
        return false
    }
    return sqlite_exec(db, "COMMIT;")
}
