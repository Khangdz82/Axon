// Axon Standard Library: INI ConfigParser & `.env` Loader (`std/configparser.ax`)
// 100% Pure Axon replacement for Python's `configparser.ConfigParser` + `python-dotenv`.
// Supports `[section]` headers, `DEFAULT` section inheritance, `key=val` & `key:val`, `#`/`;` comments,
// typed getters (`ini_get`, `ini_get_i64`, `ini_get_bool`), serializer, and `.env` quoted unescaping.

use std::str
use std::ds
use std::sys
use std::shutil

struct IniConfig {
    entries: StrMap
    sections: StrVec
}

fn ini_new() -> IniConfig {
    return IniConfig(entries = smap_new(32), sections = svec_new(16, 128))
}

fn ini_free(move cfg: IniConfig) {
    smap_free(move cfg.entries)
    svec_free(move cfg.sections)
}

fn _ini_has_section(cfg: IniConfig, sec: str) -> bool {
    n := svec_len(cfg.sections)
    mut i := 0
    while i < n {
        if str_eq(svec_get(cfg.sections, i), sec) { return true }
        i += 1
    }
    return false
}

fn _ini_key(section: str, option: str) -> str {
    return section + "\x01" + str_to_lower(option)
}

fn _ini_strip_quotes(s: str) -> str {
    t := str_trim(s)
    n := str_len(t)
    if n >= 2 {
        c0 := str_byte(t, 0)
        c1 := str_byte(t, n - 1)
        if (c0 == 34 and c1 == 34) or (c0 == 39 and c1 == 39) {
            return str_slice(t, 1, n - 1)
        }
    }
    return t
}

fn ini_set(mut cfg: IniConfig, section: str, option: str, val: str) {
    sec := str_trim(section)
    opt := str_trim(option)
    if str_len(sec) == 0 or str_len(opt) == 0 { return }
    if not str_eq(sec, "DEFAULT") and not _ini_has_section(cfg, sec) {
        svec_push(mut cfg.sections, sec)
    }
    smap_set_str(mut cfg.entries, _ini_key(sec, opt), val)
}

fn ini_parse(text: str) -> IniConfig {
    mut cfg := ini_new()
    mut cur_sec := "DEFAULT"
    n := str_len(text)
    mut pos := 0
    while pos < n {
        mut nl := str_find_byte(text, 10, pos)
        if nl < 0 { nl = n }
        mut lend := nl
        if lend > pos and str_byte(text, lend - 1) == 13 { lend -= 1 }
        line := str_trim(str_slice(text, pos, lend))
        ln := str_len(line)
        if ln > 0 {
            c0 := str_byte(line, 0)
            if c0 != 35 and c0 != 59 { // not '#' and not ';'
                if c0 == 91 and str_byte(line, ln - 1) == 93 {
                    sec_name := str_trim(str_slice(line, 1, ln - 1))
                    if str_len(sec_name) > 0 {
                        cur_sec = sec_name
                        if not str_eq(cur_sec, "DEFAULT") and not _ini_has_section(cfg, cur_sec) {
                            svec_push(mut cfg.sections, cur_sec)
                        }
                    }
                } else {
                    // Find earliest '=' (61) or ':' (58)
                    eq := str_find_byte(line, 61, 0)
                    col := str_find_byte(line, 58, 0)
                    mut sep := -1
                    if eq > 0 and (col <= 0 or eq < col) { sep = eq }
                    else if col > 0 { sep = col }
                    if sep > 0 {
                        k := str_trim(str_slice(line, 0, sep))
                        v := _ini_strip_quotes(str_slice(line, sep + 1, ln))
                        if str_len(k) > 0 {
                            ini_set(mut cfg, cur_sec, k, v)
                        }
                    }
                }
            }
        }
        if nl >= n { break }
        pos = nl + 1
    }
    return cfg
}

fn ini_parse_file(file_path: str) -> IniConfig ! i64 {
    txt := shutil_read_text(file_path) or return
    return ok(ini_parse(txt))
}

fn ini_has_option(cfg: IniConfig, section: str, option: str) -> bool {
    if smap_has(cfg.entries, _ini_key(section, option)) { return true }
    return smap_has(cfg.entries, _ini_key("DEFAULT", option))
}

fn _ini_clone(s: str) -> str {
    n := str_len(s)
    if n == 0 { return "" }
    b := buf_new(n + 1)
    buf_push_str(b, s)
    return buf_to_owned_str(move b)
}

fn ini_get(cfg: IniConfig, section: str, option: str, default_val: str = "") -> str {
    k1 := _ini_key(section, option)
    if smap_has(cfg.entries, k1) { return _ini_clone(smap_get_str(cfg.entries, k1, default_val)) }
    k2 := _ini_key("DEFAULT", option)
    if smap_has(cfg.entries, k2) { return _ini_clone(smap_get_str(cfg.entries, k2, default_val)) }
    return default_val
}

fn ini_get_i64(cfg: IniConfig, section: str, option: str, default_val: i64 = 0) -> i64 {
    s := ini_get(cfg, section, option, "")
    if str_len(s) == 0 { return default_val }
    return parse_i64(s) or default_val
}

fn ini_get_bool(cfg: IniConfig, section: str, option: str, default_val: bool = false) -> bool {
    s := str_to_lower(str_trim(ini_get(cfg, section, option, "")))
    if str_eq(s, "1") or str_eq(s, "true") or str_eq(s, "yes") or str_eq(s, "on") { return true }
    if str_eq(s, "0") or str_eq(s, "false") or str_eq(s, "no") or str_eq(s, "off") { return false }
    return default_val
}

fn ini_section_count(cfg: IniConfig) -> i64 {
    return svec_len(cfg.sections)
}

fn ini_section_at(cfg: IniConfig, idx: i64) -> str {
    return svec_get(cfg.sections, idx)
}

// --- `.env` Parser & Loader (`python-dotenv`) ---
fn _dotenv_unescape_dq(s: str) -> str {
    n := str_len(s)
    out := buf_new(n + 4)
    mut i := 0
    while i < n {
        c := str_byte(s, i)
        if c == 92 and i + 1 < n {
            nx := str_byte(s, i + 1)
            if nx == 110 { buf_push(out, 10); i += 2; continue }      // \n
            else if nx == 114 { buf_push(out, 13); i += 2; continue } // \r
            else if nx == 116 { buf_push(out, 9); i += 2; continue }  // \t
            else if nx == 34 { buf_push(out, 34); i += 2; continue }  // \"
            else if nx == 92 { buf_push(out, 92); i += 2; continue }  // \\
        }
        buf_push(out, c)
        i += 1
    }
    return buf_to_owned_str(move out)
}

fn dotenv_parse(text: str) -> StrMap {
    mut m := smap_new(32)
    n := str_len(text)
    mut pos := 0
    while pos < n {
        mut nl := str_find_byte(text, 10, pos)
        if nl < 0 { nl = n }
        mut lend := nl
        if lend > pos and str_byte(text, lend - 1) == 13 { lend -= 1 }
        mut line := str_trim(str_slice(text, pos, lend))
        if str_len(line) > 0 and str_byte(line, 0) != 35 {
            if str_starts_with(line, "export ") {
                line = str_trim(str_slice(line, 7, str_len(line)))
            }
            eq := str_find_byte(line, 61, 0)
            if eq > 0 {
                k := str_trim(str_slice(line, 0, eq))
                raw_v := str_trim(str_slice(line, eq + 1, str_len(line)))
                vn := str_len(raw_v)
                mut v := raw_v
                if vn >= 2 and str_byte(raw_v, 0) == 34 and str_byte(raw_v, vn - 1) == 34 {
                    v = _dotenv_unescape_dq(str_slice(raw_v, 1, vn - 1))
                } else if vn >= 2 and str_byte(raw_v, 0) == 39 and str_byte(raw_v, vn - 1) == 39 {
                    v = str_slice(raw_v, 1, vn - 1)
                } else {
                    // Strip inline `# comment` preceded by whitespace on unquoted values
                    mut ci := 0
                    while ci < vn {
                        if str_byte(raw_v, ci) == 35 and ci > 0 and (str_byte(raw_v, ci - 1) == 32 or str_byte(raw_v, ci - 1) == 9) {
                            v = str_trim(str_slice(raw_v, 0, ci))
                            break
                        }
                        ci += 1
                    }
                }
                if str_len(k) > 0 {
                    smap_set_str(mut m, k, v)
                }
            }
        }
        if nl >= n { break }
        pos = nl + 1
    }
    return m
}

// Loads `.env` file into process environment (`override_existing = false` matches `python-dotenv` default).
fn dotenv_load_file(file_path: str, override_existing: bool = false) -> i64 ! i64 {
    txt := shutil_read_text(file_path) or return
    m := dotenv_parse(txt)
    keys := smap_keys(m)
    nk := svec_len(keys)
    mut applied := 0
    mut i := 0
    while i < nk {
        k := svec_get(keys, i)
        v := smap_get_str(m, k, "")
        if override_existing or str_len(sys_env_get(k)) == 0 {
            if sys_env_set(k, v) { applied += 1 }
        }
        i += 1
    }
    svec_free(move keys)
    smap_free(move m)
    return ok(applied)
}
