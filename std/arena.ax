// Axon Standard Library: Lock-Free Region Arena & Perceus Hybrid Allocator
// Enables O(1) bulk destruction of dynamic graphs, ASTs, and JSON parser tokens.

/// Thread-local memory region with bump-pointer allocation.
struct MemoryRegion {
    region_id: i64,
    capacity_bytes: i64,
    allocated_bytes: i64,
    chunk_count: i32,
    is_active: i32,
}

/// Allocates a new contiguous thread-local memory region.
fn region_new(capacity: i64) -> MemoryRegion {
    return MemoryRegion(1, capacity, 0, 1, 1);
}

/// Bump-allocates N bytes within the current active region.
fn region_alloc(mut r: MemoryRegion, bytes: i64) -> (MemoryRegion, i64) {
    let aligned_bytes = (bytes + 7) & -8; // 8-byte word alignment
    let offset = r.allocated_bytes;
    r.allocated_bytes += aligned_bytes;
    return (r, offset);
}

/// Resets bump pointer to 0, freeing all allocated objects in 1 CPU cycle (O(1)).
fn region_reset(mut r: MemoryRegion) -> MemoryRegion {
    r.allocated_bytes = 0;
    return r;
}

/// Closes the memory region and returns underlying pages to OS.
fn region_destroy(mut r: MemoryRegion) -> i32 {
    r.is_active = 0;
    return 0;
}
