// Axon Standard Library: Native CSS Parser & Style Engine (`std/css.ax`)
// Pure native zero-CEF CSS3 parser, selector matching, color decoders & cascade solver.

use std::os
use std::str
use std::html
use std::ui_tailwind

struct ComputedStyle {
    display: i64        // 0: block, 1: flex, 2: inline, 3: none, 4: grid
    flex_direction: i64 // 0: row, 1: column
    justify_content: i64// 0: flex-start, 1: center, 2: flex-end, 3: space-between, 4: space-around
    align_items: i64    // 0: stretch, 1: center, 2: flex-start, 3: flex-end
    gap: i64
    width: i64          // -1: auto, -2: flex-1, -3: w-auto, <= -1000: pct
    height: i64         // -1: auto, -100: h-full/h-screen
    padding_x: i64
    padding_y: i64
    margin_x: i64
    margin_y: i64
    bg_color: i64       // 32-bit ARGB: (a << 24) | (r << 16) | (g << 8) | b
    text_color: i64     // 32-bit ARGB
    border_width: i64
    border_color: i64
    border_radius: i64
    font_size: i64      // logical px; 0 = derive from element tag
    font_weight: i64    // 0 = derive from element tag, else 400..700
    text_align: i64     // 0 left, 1 center, 2 right
    grad_dir: i64       // 0 none, 1 to-r, 2 to-b, 3 to-br
    grad_from: i64      // ARGB start stop
    grad_to: i64        // ARGB end stop
    shadow: i64         // 0 none, 1 sm, 2 md, 3 lg, 4 xl, 5 2xl
    opacity: i64        // 0..100
    hover_bg: i64       // ARGB override on :hover
    hover_border: i64   // ARGB override on :hover
    hover_text: i64     // ARGB override on :hover
    margin_auto: bool   // mx-auto / margin: auto horizontal centering
    max_width: i64      // > 0 clamps box width
    grid_cols: i64      // > 0 when display == 4 (CSS Grid columns)
    flex_wrap: bool     // flex-wrap: wrap
    flex_grow: i64      // flex: 1 / flex-grow
    font_mono: bool     // monospace font family
    overflow_hidden: bool // overflow: hidden
    overflow_scroll: bool // overflow-y: auto / scroll (independent per-container scroll)
    position: i64       // 0: static/relative, 1: absolute, 2: fixed
    pos_top: i64        // -999999 = unset
    pos_left: i64       // -999999 = unset
    pos_right: i64      // -999999 = unset
    pos_bottom: i64     // -999999 = unset
    text_transform: i64 // 0: none, 1: uppercase, 2: lowercase
    border_sides: i64   // 0 = all 4 sides (default), else bitmask: 1=top, 2=right, 4=bottom, 8=left
    margin_top_auto: bool
    margin_bottom_auto: bool
    margin_left_auto: bool
    margin_right_auto: bool
    min_width: i64
    min_height: i64
    max_height: i64
    flex_shrink: i64    // 1 default, 0 = shrink-0
    cursor: i64         // 0 default, 1 pointer, 2 text
    line_height: i64    // 0 auto, else px
    white_space: i64    // 0 normal, 1 nowrap, 2 pre
    text_decoration: i64 // 0 none, 1 underline, 2 line-through
    font_italic: bool
    focus_border: i64
    focus_bg: i64
    active_bg: i64
    grad_via: i64
    z_index: i64
    has_color: bool
    glass_blur: i64     // 0 none, 1..6 backdrop-blur intensity (sm..3xl)
    ring_width: i64     // separate outer focus/accent ring width (px)
    ring_color: i64     // ARGB outer ring color
    ring_offset: i64    // px gap between border and ring
    shadow_color: i64   // 0 default dark shadow, else colored ARGB shadow/glow
    text_ellipsis: bool // text-overflow: ellipsis / truncate
    bg_clip_text: bool  // bg-clip-text gradient text rendering
    gap_x: i64          // -1 inherit gap, else column-gap px
    gap_y: i64          // -1 inherit gap, else row-gap px
    object_fit: i64     // 0 fill, 1 cover, 2 contain
    border_style: i64   // 0 solid, 1 dashed, 2 dotted
    letter_spacing: i64 // 0 normal, else 1/10 px
    hover_shadow: i64   // 0 unchanged, else shadow level on :hover
    hover_opacity: i64  // -1 unchanged, else 0..100 on :hover
    has_hover: bool     // true if node has any :hover CSS rule or Tailwind hover:*
    pad_top: i64        // -1 = fallback padding_y / 2
    pad_right: i64      // -1 = fallback padding_x / 2
    pad_bottom: i64     // -1 = fallback padding_y / 2
    pad_left: i64       // -1 = fallback padding_x / 2
    mar_top: i64        // -1 = fallback margin_y / 2
    mar_right: i64      // -1 = fallback margin_x / 2
    mar_bottom: i64     // -1 = fallback margin_y / 2
    mar_left: i64       // -1 = fallback margin_x / 2
    col_span: i64       // 0/1 = 1 col, >1 = span N grid cols, -1 = col-span-full
    align_self: i64     // 0 = auto, 1 = center, 2 = start, 3 = end, 4 = stretch
}

@inline
fn style_pad_top(s: ComputedStyle) -> i64 { return if s.pad_top >= 0 { s.pad_top } else { s.padding_y / 2 } }
@inline
fn style_pad_right(s: ComputedStyle) -> i64 { return if s.pad_right >= 0 { s.pad_right } else { s.padding_x / 2 } }
@inline
fn style_pad_bottom(s: ComputedStyle) -> i64 { return if s.pad_bottom >= 0 { s.pad_bottom } else { s.padding_y / 2 } }
@inline
fn style_pad_left(s: ComputedStyle) -> i64 { return if s.pad_left >= 0 { s.pad_left } else { s.padding_x / 2 } }
@inline
fn style_mar_top(s: ComputedStyle) -> i64 { return if s.mar_top >= 0 { s.mar_top } else { s.margin_y / 2 } }
@inline
fn style_mar_right(s: ComputedStyle) -> i64 { return if s.mar_right >= 0 { s.mar_right } else { s.margin_x / 2 } }
@inline
fn style_mar_bottom(s: ComputedStyle) -> i64 { return if s.mar_bottom >= 0 { s.mar_bottom } else { s.margin_y / 2 } }
@inline
fn style_mar_left(s: ComputedStyle) -> i64 { return if s.mar_left >= 0 { s.mar_left } else { s.margin_x / 2 } }

fn style_set_pad_side(mut s: ComputedStyle, side: i64, val: i64) {
    // side: 0=all, 1=top, 2=right, 3=bottom, 4=left, 5=x, 6=y
    if side == 0 {
        s.pad_top = val; s.pad_right = val; s.pad_bottom = val; s.pad_left = val
        s.padding_x = val * 2; s.padding_y = val * 2
    } else if side == 5 {
        s.pad_left = val; s.pad_right = val; s.padding_x = val * 2
    } else if side == 6 {
        s.pad_top = val; s.pad_bottom = val; s.padding_y = val * 2
    } else if side == 1 {
        pb := style_pad_bottom(s)
        s.pad_top = val; s.pad_bottom = pb; s.padding_y = val + pb
    } else if side == 3 {
        pt := style_pad_top(s)
        s.pad_top = pt; s.pad_bottom = val; s.padding_y = pt + val
    } else if side == 4 {
        pr := style_pad_right(s)
        s.pad_left = val; s.pad_right = pr; s.padding_x = val + pr
    } else if side == 2 {
        pl := style_pad_left(s)
        s.pad_left = pl; s.pad_right = val; s.padding_x = pl + val
    }
}

fn style_set_mar_side(mut s: ComputedStyle, side: i64, val: i64) {
    if side == 0 {
        s.mar_top = val; s.mar_right = val; s.mar_bottom = val; s.mar_left = val
        s.margin_x = val * 2; s.margin_y = val * 2
    } else if side == 5 {
        s.mar_left = val; s.mar_right = val; s.margin_x = val * 2
    } else if side == 6 {
        s.mar_top = val; s.mar_bottom = val; s.margin_y = val * 2
    } else if side == 1 {
        mb := style_mar_bottom(s)
        s.mar_top = val; s.mar_bottom = mb; s.margin_y = val + mb
    } else if side == 3 {
        mt := style_mar_top(s)
        s.mar_top = mt; s.mar_bottom = val; s.margin_y = mt + val
    } else if side == 4 {
        mr := style_mar_right(s)
        s.mar_left = val; s.mar_right = mr; s.margin_x = val + mr
    } else if side == 2 {
        ml := style_mar_left(s)
        s.mar_left = ml; s.mar_right = val; s.margin_x = ml + val
    }
}

fn style_default() -> ComputedStyle {
    return ComputedStyle(
        display = 0,         // block
        flex_direction = 0,  // row
        justify_content = 0, // flex-start
        align_items = 0,     // stretch
        gap = 0,
        width = -1,
        height = -1,
        padding_x = 0,
        padding_y = 0,
        margin_x = 0,
        margin_y = 0,
        bg_color = 0,        // transparent
        text_color = 0xFFFFFFFF, // white
        border_width = 0,
        border_color = 0,
        border_radius = 0,
        font_size = 0,
        font_weight = 0,
        text_align = 0,
        grad_dir = 0,
        grad_from = 0,
        grad_to = 0,
        shadow = 0,
        opacity = 100,
        hover_bg = 0,
        hover_border = 0,
        hover_text = 0,
        margin_auto = false,
        max_width = 0,
        grid_cols = 0,
        flex_wrap = false,
        flex_grow = 0,
        font_mono = false,
        overflow_hidden = false,
        overflow_scroll = false,
        position = 0,
        pos_top = -999999,
        pos_left = -999999,
        pos_right = -999999,
        pos_bottom = -999999,
        text_transform = 0,
        border_sides = 0,
        margin_top_auto = false,
        margin_bottom_auto = false,
        margin_left_auto = false,
        margin_right_auto = false,
        min_width = 0,
        min_height = 0,
        max_height = 0,
        flex_shrink = 1,
        cursor = 0,
        line_height = 0,
        white_space = 0,
        text_decoration = 0,
        font_italic = false,
        focus_border = 0,
        focus_bg = 0,
        active_bg = 0,
        grad_via = 0,
        z_index = 0,
        has_color = false,
        glass_blur = 0,
        ring_width = 0,
        ring_color = 0,
        ring_offset = 0,
        shadow_color = 0,
        text_ellipsis = false,
        bg_clip_text = false,
        gap_x = -1,
        gap_y = -1,
        object_fit = 0,
        border_style = 0,
        letter_spacing = 0,
        hover_shadow = 0,
        hover_opacity = -1,
        has_hover = false,
        pad_top = -1,
        pad_right = -1,
        pad_bottom = -1,
        pad_left = -1,
        mar_top = -1,
        mar_right = -1,
        mar_bottom = -1,
        mar_left = -1,
        col_span = 1,
        align_self = 0
    )
}

fn css_hex_digit(ch: i64) -> i64 {
    if ch >= 48 and ch <= 57 { return ch - 48 }
    if ch >= 97 and ch <= 102 { return ch - 97 + 10 }
    if ch >= 65 and ch <= 70 { return ch - 65 + 10 }
    return 0
}

fn _css_parse_alpha_255(astr_in: str) -> i64 {
    astr := str_trim(astr_in)
    an := str_len(astr)
    if an == 0 { return 255 }
    if str_ends_with(astr, "%") {
        pct := css_parse_px(str_slice(astr, 0, an - 1))
        if pct <= 0 { return 0 }
        if pct >= 100 { return 255 }
        return (pct * 255) / 100
    }
    if str_eq(astr, "0") or str_eq(astr, "0.0") or str_eq(astr, ".0") { return 0 }
    if str_eq(astr, "1") or str_eq(astr, "1.0") { return 255 }
    dot := str_find_byte(astr, 46, 0)
    if dot >= 0 and dot + 1 < an {
        d1 := str_byte(astr, dot + 1) - 48
        d2 := if dot + 2 < an { str_byte(astr, dot + 2) - 48 } else { 0 }
        if d1 >= 0 and d1 <= 9 {
            pct := d1 * 10 + (if d2 >= 0 and d2 <= 9 { d2 } else { 0 })
            return (pct * 255) / 100
        }
    }
    return 255
}

fn _css_hsl_to_rgb(h_in: i64, s_pct: i64, l_pct: i64, a: i64) -> i64 {
    mut h := h_in % 360
    if h < 0 { h += 360 }
    mut s := s_pct
    if s < 0 { s = 0 } else if s > 100 { s = 100 }
    mut l := l_pct
    if l < 0 { l = 0 } else if l > 100 { l = 100 }
    // Integer HSL -> RGB (scaled by 10000)
    mut l2 := 2 * l - 100
    if l2 < 0 { l2 = 0 - l2 }
    c := (100 - l2) * s // 0..10000
    mut hmod := h % 120 - 60
    if hmod < 0 { hmod = 0 - hmod }
    x := (c * (60 - hmod)) / 60
    m := l * 100 - c / 2
    mut r1 := 0
    mut g1 := 0
    mut b1 := 0
    if h < 60 { r1 = c; g1 = x; b1 = 0 }
    else if h < 120 { r1 = x; g1 = c; b1 = 0 }
    else if h < 180 { r1 = 0; g1 = c; b1 = x }
    else if h < 240 { r1 = 0; g1 = x; b1 = c }
    else if h < 300 { r1 = x; g1 = 0; b1 = c }
    else { r1 = c; g1 = 0; b1 = x }
    mut r := ((r1 + m) * 255 + 5000) / 10000
    mut g := ((g1 + m) * 255 + 5000) / 10000
    mut b := ((b1 + m) * 255 + 5000) / 10000
    if r < 0 { r = 0 } else if r > 255 { r = 255 }
    if g < 0 { g = 0 } else if g > 255 { g = 255 }
    if b < 0 { b = 0 } else if b > 255 { b = 255 }
    return (a << 24) | (r << 16) | (g << 8) | b
}

fn css_parse_color(val: str) -> i64 {
    s := str_trim(val)
    n := str_len(s)
    if n == 0 { return 0 }
    c0 := str_byte(s, 0)

    if c0 == 35 { // '#'
        if n == 4 { // #RGB
            r := css_hex_digit(str_byte(s, 1)) * 17
            g := css_hex_digit(str_byte(s, 2)) * 17
            b := css_hex_digit(str_byte(s, 3)) * 17
            return (0xFF << 24) | (r << 16) | (g << 8) | b
        }
        if n == 5 { // #RGBA
            r := css_hex_digit(str_byte(s, 1)) * 17
            g := css_hex_digit(str_byte(s, 2)) * 17
            b := css_hex_digit(str_byte(s, 3)) * 17
            a := css_hex_digit(str_byte(s, 4)) * 17
            return (a << 24) | (r << 16) | (g << 8) | b
        }
        if n == 7 { // #RRGGBB
            r := (css_hex_digit(str_byte(s, 1)) << 4) | css_hex_digit(str_byte(s, 2))
            g := (css_hex_digit(str_byte(s, 3)) << 4) | css_hex_digit(str_byte(s, 4))
            b := (css_hex_digit(str_byte(s, 5)) << 4) | css_hex_digit(str_byte(s, 6))
            return (0xFF << 24) | (r << 16) | (g << 8) | b
        }
        if n == 9 { // #RRGGBBAA
            r := (css_hex_digit(str_byte(s, 1)) << 4) | css_hex_digit(str_byte(s, 2))
            g := (css_hex_digit(str_byte(s, 3)) << 4) | css_hex_digit(str_byte(s, 4))
            b := (css_hex_digit(str_byte(s, 5)) << 4) | css_hex_digit(str_byte(s, 6))
            a := (css_hex_digit(str_byte(s, 7)) << 4) | css_hex_digit(str_byte(s, 8))
            return (a << 24) | (r << 16) | (g << 8) | b
        }
    }

    if c0 == 116 and str_eq(s, "transparent") { return 0 }

    if c0 == 114 and (str_starts_with(s, "rgb(") or str_starts_with(s, "rgba(")) {
        lp := str_find_byte(s, 40, 0)
        rp := str_find_byte(s, 41, lp + 1)
        if lp >= 0 and rp > lp {
            inner := str_trim(str_slice(s, lp + 1, rp))
            c1 := str_find_byte(inner, 44, 0)
            if c1 >= 0 {
                c2 := str_find_byte(inner, 44, c1 + 1)
                if c2 > c1 {
                    mut r := css_parse_px(str_slice(inner, 0, c1))
                    mut g := css_parse_px(str_slice(inner, c1 + 1, c2))
                    c3 := str_find_byte(inner, 44, c2 + 1)
                    mut b := if c3 > c2 { css_parse_px(str_slice(inner, c2 + 1, c3)) } else { css_parse_px(str_slice(inner, c2 + 1, str_len(inner))) }
                    mut a := 255
                    if c3 > c2 { a = _css_parse_alpha_255(str_slice(inner, c3 + 1, str_len(inner))) }
                    if r < 0 { r = 0 } else if r > 255 { r = 255 }
                    if g < 0 { g = 0 } else if g > 255 { g = 255 }
                    if b < 0 { b = 0 } else if b > 255 { b = 255 }
                    return (a << 24) | (r << 16) | (g << 8) | b
                }
            } else {
                // CSS Color 4 space-separated syntax: `rgb(255 0 128 / 50%)` or `rgb(255 0 128 / 0.5)`
                slash := str_find_byte(inner, 47, 0)
                rgb_part := str_trim(if slash >= 0 { str_slice(inner, 0, slash) } else { inner })
                mut a := if slash >= 0 { _css_parse_alpha_255(str_slice(inner, slash + 1, str_len(inner))) } else { 255 }
                sp1 := str_find_byte(rgb_part, 32, 0)
                if sp1 > 0 {
                    mut p2 := sp1 + 1
                    rn := str_len(rgb_part)
                    while p2 < rn and str_byte(rgb_part, p2) == 32 { p2 += 1 }
                    sp2 := str_find_byte(rgb_part, 32, p2)
                    if sp2 > p2 {
                        mut r := css_parse_px(str_slice(rgb_part, 0, sp1))
                        mut g := css_parse_px(str_slice(rgb_part, p2, sp2))
                        mut b := css_parse_px(str_slice(rgb_part, sp2 + 1, rn))
                        if r < 0 { r = 0 } else if r > 255 { r = 255 }
                        if g < 0 { g = 0 } else if g > 255 { g = 255 }
                        if b < 0 { b = 0 } else if b > 255 { b = 255 }
                        return (a << 24) | (r << 16) | (g << 8) | b
                    }
                }
            }
        }
    }

    if c0 == 104 and (str_starts_with(s, "hsl(") or str_starts_with(s, "hsla(")) {
        lp := str_find_byte(s, 40, 0)
        rp := str_find_byte(s, 41, lp + 1)
        if lp >= 0 and rp > lp {
            inner := str_trim(str_slice(s, lp + 1, rp))
            c1 := str_find_byte(inner, 44, 0)
            mut h := 0
            mut sat := 0
            mut lit := 0
            mut a := 255
            if c1 >= 0 {
                c2 := str_find_byte(inner, 44, c1 + 1)
                if c2 > c1 {
                    h = css_parse_px(str_slice(inner, 0, c1))
                    s_raw := str_trim(str_slice(inner, c1 + 1, c2))
                    sat = if str_ends_with(s_raw, "%") { css_parse_px(str_slice(s_raw, 0, str_len(s_raw) - 1)) } else { css_parse_px(s_raw) }
                    c3 := str_find_byte(inner, 44, c2 + 1)
                    l_raw := str_trim(if c3 > c2 { str_slice(inner, c2 + 1, c3) } else { str_slice(inner, c2 + 1, str_len(inner)) })
                    lit = if str_ends_with(l_raw, "%") { css_parse_px(str_slice(l_raw, 0, str_len(l_raw) - 1)) } else { css_parse_px(l_raw) }
                    if c3 > c2 { a = _css_parse_alpha_255(str_slice(inner, c3 + 1, str_len(inner))) }
                    return _css_hsl_to_rgb(h, sat, lit, a)
                }
            } else {
                slash := str_find_byte(inner, 47, 0)
                hsl_part := str_trim(if slash >= 0 { str_slice(inner, 0, slash) } else { inner })
                if slash >= 0 { a = _css_parse_alpha_255(str_slice(inner, slash + 1, str_len(inner))) }
                sp1 := str_find_byte(hsl_part, 32, 0)
                if sp1 > 0 {
                    mut p2 := sp1 + 1
                    hn := str_len(hsl_part)
                    while p2 < hn and str_byte(hsl_part, p2) == 32 { p2 += 1 }
                    sp2 := str_find_byte(hsl_part, 32, p2)
                    if sp2 > p2 {
                        h = css_parse_px(str_slice(hsl_part, 0, sp1))
                        s_raw := str_trim(str_slice(hsl_part, p2, sp2))
                        l_raw := str_trim(str_slice(hsl_part, sp2 + 1, hn))
                        sat = if str_ends_with(s_raw, "%") { css_parse_px(str_slice(s_raw, 0, str_len(s_raw) - 1)) } else { css_parse_px(s_raw) }
                        lit = if str_ends_with(l_raw, "%") { css_parse_px(str_slice(l_raw, 0, str_len(l_raw) - 1)) } else { css_parse_px(l_raw) }
                        return _css_hsl_to_rgb(h, sat, lit, a)
                    }
                }
            }
        }
    }

    // First-byte fast dispatch for CSS named colors
    if c0 == 98 {
        if str_eq(s, "black") { return 0xFF000000 }
        if str_eq(s, "blue") { return 0xFF0000FF }
        if str_eq(s, "blue-500") { return 0xFF3B82F6 }
    } else if c0 == 119 {
        if str_eq(s, "white") { return 0xFFFFFFFF }
    } else if c0 == 114 {
        if str_eq(s, "red") { return 0xFFFF0000 }
    } else if c0 == 103 {
        if str_eq(s, "green") { return 0xFF00FF00 }
        if str_eq(s, "gray") or str_eq(s, "grey") { return 0xFF808080 }
    } else if c0 == 121 {
        if str_eq(s, "yellow") { return 0xFFFFFF00 }
    } else if c0 == 111 {
        if str_eq(s, "orange") { return 0xFFFFA500 }
    } else if c0 == 112 {
        if str_eq(s, "purple") { return 0xFF800080 }
        if str_eq(s, "pink") { return 0xFFFFC0CB }
    } else if c0 == 99 {
        if str_eq(s, "cyan") { return 0xFF00FFFF }
    } else if c0 == 97 {
        if str_eq(s, "aqua") { return 0xFF00FFFF }
    } else if c0 == 116 {
        if str_eq(s, "teal") { return 0xFF008080 }
    } else if c0 == 105 {
        if str_eq(s, "indigo") { return 0xFF4B0082 }
    } else if c0 == 115 {
        if str_eq(s, "silver") { return 0xFFC0C0C0 }
        if str_eq(s, "slate-900") { return 0xFF0F172A }
        if str_eq(s, "slate-800") { return 0xFF1E293B }
    } else if c0 == 110 {
        if str_eq(s, "navy") { return 0xFF000080 }
    }

    return 0xFFFFFFFF
}

fn _css_strip_important(val: str) -> str {
    s := str_trim(val)
    n := str_len(s)
    if n >= 10 and str_ends_with(s, "!important") {
        return str_trim(str_slice(s, 0, n - 10))
    }
    return s
}

fn _css_find_top_comma(s: str, start: i64) -> i64 {
    n := str_len(s)
    mut depth := 0
    mut i := start
    while i < n {
        b := str_byte(s, i)
        if b == 40 { depth += 1 }
        else if b == 41 { if depth > 0 { depth -= 1 } }
        else if b == 44 and depth == 0 { return i }
        i += 1
    }
    return -1
}

fn _css_find_matching_rparen(s: str, lp: i64) -> i64 {
    n := str_len(s)
    mut depth := 1
    mut i := lp + 1
    while i < n {
        b := str_byte(s, i)
        if b == 40 { depth += 1 }
        else if b == 41 {
            depth -= 1
            if depth == 0 { return i }
        }
        i += 1
    }
    return -1
}

fn _css_parse_grad_stop_color(stop_raw: str) -> i64 {
    s := str_trim(stop_raw)
    n := str_len(s)
    if n == 0 { return 0 }
    // Strip trailing stop position e.g. `#0f172a 0%` or `rgba(0,0,0,0.5) 50%`
    mut depth := 0
    mut last_sp := -1
    mut i := 0
    while i < n {
        b := str_byte(s, i)
        if b == 40 { depth += 1 }
        else if b == 41 { if depth > 0 { depth -= 1 } }
        else if (b == 32 or b == 9) and depth == 0 { last_sp = i }
        i += 1
    }
    if last_sp > 0 {
        tail := str_trim(str_slice(s, last_sp + 1, n))
        if str_len(tail) > 0 {
            tc0 := str_byte(tail, 0)
            if (tc0 >= 48 and tc0 <= 57) or tc0 == 45 {
                return css_parse_color(str_slice(s, 0, last_sp))
            }
        }
    }
    return css_parse_color(s)
}

fn css_parse_px(val: str) -> i64 {
    s := _css_strip_important(val)
    if str_eq(s, "auto") { return -1 }
    if str_eq(s, "100%") { return -1 }
    if str_eq(s, "0") { return 0 }

    mut n := str_len(s)
    if n == 0 { return 0 }
    // Basic CSS `calc(A + B)` / `calc(A - B)` pixel arithmetic
    if n > 6 and str_byte(s, 0) == 99 and str_starts_with(s, "calc(") {
        rp := _css_find_matching_rparen(s, 4)
        if rp > 5 {
            inner := str_trim(str_slice(s, 5, rp))
            in_n := str_len(inner)
            mut op_pos := -1
            mut op_ch := 0
            mut k := 1
            while k + 1 < in_n {
                b := str_byte(inner, k)
                if (b == 43 or b == 45) and str_byte(inner, k - 1) == 32 and str_byte(inner, k + 1) == 32 {
                    op_pos = k
                    op_ch = b
                    break
                }
                k += 1
            }
            if op_pos > 0 {
                lhs := css_parse_px(str_slice(inner, 0, op_pos))
                rhs := css_parse_px(str_slice(inner, op_pos + 1, in_n))
                if lhs >= 0 and rhs >= 0 {
                    res := if op_ch == 43 { lhs + rhs } else { lhs - rhs }
                    return if res > 0 { res } else { 0 }
                }
                if lhs > 0 { return lhs }
                if rhs > 0 { return rhs }
                return 0
            }
            return css_parse_px(inner)
        }
    }
    mut is_pct := false
    mut is_rem := false
    if str_ends_with(s, "%") {
        n -= 1
        is_pct = true
    } else if str_ends_with(s, "px") {
        n -= 2
    } else if str_ends_with(s, "rem") {
        n -= 3
        is_rem = true
    } else if str_ends_with(s, "em") {
        n -= 2
        is_rem = true
    }
    mut v := 0
    mut frac := 0
    mut i := 0
    mut neg := false
    if i < n and str_byte(s, i) == 45 {
        neg = true
        i += 1
    } else if i < n and str_byte(s, i) == 43 {
        i += 1
    }
    while i < n {
        ch := str_byte(s, i)
        if ch >= 48 and ch <= 57 {
            if v < 100000000 { // Prevent i64 overflow DoS under --shield
                v = v * 10 + (ch - 48)
            }
        } else if ch == 46 and is_rem and i + 1 < n {
            d := str_byte(s, i + 1) - 48
            if d >= 0 and d <= 9 { frac = (d * 16) / 10 }
            break
        } else {
            break
        }
        i += 1
    }
    if is_pct {
        if neg or v <= 0 { return 0 }
        if v >= 100 { return -1 }
        return 0 - (1000 + v)
    }
    if is_rem { v = v * 16 + frac }
    if v > 100000 { v = 100000 }
    if neg {
        // Clamp negative px to > -1000 so it never collides with percentage sentinels `<= -1000`
        if v > 999 { v = 999 }
        return 0 - v
    }
    return v
}

fn css_apply_property(mut style: ComputedStyle, prop_name: str, prop_val: str) {
    p := str_trim(prop_name)
    pn := str_len(p)
    if pn == 0 { return }
    v := _css_strip_important(prop_val)
    if str_len(v) == 0 { return }
    p0 := str_byte(p, 0)

    if p0 == 98 { // 'b': background*, border*, box-shadow, bottom, backdrop-filter
        if str_eq(p, "background") or str_eq(p, "background-color") or str_eq(p, "background-image") {
            if str_starts_with(v, "linear-gradient(") {
                lp := str_find_byte(v, 40, 0)
                rp := if lp >= 0 { _css_find_matching_rparen(v, lp) } else { -1 }
                if lp >= 0 and rp > lp {
                    inner := str_slice(v, lp + 1, rp)
                    in_n := str_len(inner)
                    c1 := _css_find_top_comma(inner, 0)
                    if c1 >= 0 {
                        first := str_trim(str_slice(inner, 0, c1))
                        mut dir := 2
                        mut is_dir := false
                        if str_starts_with(first, "to ") or str_ends_with(first, "deg") {
                            is_dir = true
                            if str_contains(first, "to right") or str_eq(first, "90deg") { dir = 1 }
                            else if str_contains(first, "to left") or str_eq(first, "270deg") { dir = 4 }
                            else if str_contains(first, "to top right") or str_eq(first, "45deg") { dir = 6 }
                            else if str_contains(first, "to top left") or str_eq(first, "315deg") { dir = 7 }
                            else if str_contains(first, "to top") or str_eq(first, "0deg") { dir = 5 }
                            else if str_contains(first, "bottom left") or str_eq(first, "225deg") { dir = 8 }
                            else if str_contains(first, "bottom right") or str_eq(first, "135deg") { dir = 3 }
                            else { dir = 2 }
                        }
                        style.grad_dir = dir
                        if is_dir {
                            c2 := _css_find_top_comma(inner, c1 + 1)
                            if c2 > c1 {
                                c3 := _css_find_top_comma(inner, c2 + 1)
                                style.grad_from = _css_parse_grad_stop_color(str_slice(inner, c1 + 1, c2))
                                if c3 > c2 {
                                    style.grad_via = _css_parse_grad_stop_color(str_slice(inner, c2 + 1, c3))
                                    style.grad_to = _css_parse_grad_stop_color(str_slice(inner, c3 + 1, in_n))
                                } else {
                                    style.grad_to = _css_parse_grad_stop_color(str_slice(inner, c2 + 1, in_n))
                                }
                            }
                        } else {
                            c2 := _css_find_top_comma(inner, c1 + 1)
                            style.grad_from = _css_parse_grad_stop_color(first)
                            if c2 > c1 {
                                style.grad_via = _css_parse_grad_stop_color(str_slice(inner, c1 + 1, c2))
                                style.grad_to = _css_parse_grad_stop_color(str_slice(inner, c2 + 1, in_n))
                            } else {
                                style.grad_to = _css_parse_grad_stop_color(str_slice(inner, c1 + 1, in_n))
                            }
                        }
                    }
                }
            } else if str_starts_with(v, "radial-gradient(") {
                lp := str_find_byte(v, 40, 0)
                rp := if lp >= 0 { _css_find_matching_rparen(v, lp) } else { -1 }
                if lp >= 0 and rp > lp {
                    inner := str_slice(v, lp + 1, rp)
                    in_n := str_len(inner)
                    c1 := _css_find_top_comma(inner, 0)
                    if c1 >= 0 {
                        first := str_trim(str_slice(inner, 0, c1))
                        style.grad_dir = 9
                        if str_contains(first, "circle") or str_contains(first, "ellipse") or str_contains(first, "at ") {
                            c2 := _css_find_top_comma(inner, c1 + 1)
                            if c2 > c1 {
                                style.grad_from = _css_parse_grad_stop_color(str_slice(inner, c1 + 1, c2))
                                style.grad_to = _css_parse_grad_stop_color(str_slice(inner, c2 + 1, in_n))
                            }
                        } else {
                            style.grad_from = _css_parse_grad_stop_color(first)
                            style.grad_to = _css_parse_grad_stop_color(str_slice(inner, c1 + 1, in_n))
                        }
                    }
                }
            } else {
                style.bg_color = css_parse_color(v)
            }
        } else if str_eq(p, "background-clip") or str_eq(p, "-webkit-background-clip") {
            style.bg_clip_text = str_eq(v, "text")
        } else if str_eq(p, "backdrop-filter") or str_eq(p, "-webkit-backdrop-filter") {
            if str_contains(v, "blur(") {
                bp := str_find(v, "blur(", 0)
                br := str_find_byte(v, 41, bp + 5)
                if br > bp + 5 {
                    px := css_parse_px(str_slice(v, bp + 5, br))
                    if px <= 0 { style.glass_blur = 0 }
                    else if px <= 4 { style.glass_blur = 1 }
                    else if px <= 8 { style.glass_blur = 2 }
                    else if px <= 16 { style.glass_blur = 3 }
                    else if px <= 24 { style.glass_blur = 4 }
                    else { style.glass_blur = 5 }
                } else {
                    style.glass_blur = 2
                }
            } else if str_eq(v, "none") {
                style.glass_blur = 0
            }
        } else if str_eq(p, "border-radius") {
            style.border_radius = css_parse_px(v)
        } else if str_eq(p, "border-width") {
            style.border_width = css_parse_px(v)
        } else if str_eq(p, "border-color") {
            style.border_color = css_parse_color(v)
        } else if str_eq(p, "border-style") {
            if str_eq(v, "dashed") { style.border_style = 1 }
            else if str_eq(v, "dotted") { style.border_style = 2 }
            else { style.border_style = 0 }
        } else if str_eq(p, "border") {
            if str_eq(v, "none") or str_eq(v, "0") {
                style.border_width = 0
            } else {
                mut bi := 0
                bn := str_len(v)
                while bi < bn {
                    while bi < bn and (str_byte(v, bi) == 32 or str_byte(v, bi) == 9) { bi += 1 }
                    mut bj := bi
                    mut dp := 0
                    while bj < bn {
                        cb := str_byte(v, bj)
                        if cb == 40 { dp += 1 }
                        else if cb == 41 { if dp > 0 { dp -= 1 } }
                        else if (cb == 32 or cb == 9) and dp == 0 { break }
                        bj += 1
                    }
                    if bj > bi {
                        tok := str_slice(v, bi, bj)
                        ch0 := str_byte(tok, 0)
                        if ch0 >= 48 and ch0 <= 57 {
                            style.border_width = css_parse_px(tok)
                        } else if str_eq(tok, "dashed") {
                            style.border_style = 1
                        } else if str_eq(tok, "dotted") {
                            style.border_style = 2
                        } else if not str_eq(tok, "solid") {
                            style.border_color = css_parse_color(tok)
                        }
                    }
                    bi = bj + 1
                }
            }
        } else if str_eq(p, "border-top") or str_eq(p, "border-right") or str_eq(p, "border-bottom") or str_eq(p, "border-left") {
            mut side_bit := 8
            if str_eq(p, "border-top") { side_bit = 1 }
            else if str_eq(p, "border-right") { side_bit = 2 }
            else if str_eq(p, "border-bottom") { side_bit = 4 }
            if str_eq(v, "none") or str_eq(v, "0") {
                style.border_sides = style.border_sides & (15 ^ side_bit)
            } else {
                style.border_sides = style.border_sides | side_bit
                mut bi := 0
                bn := str_len(v)
                while bi < bn {
                    while bi < bn and (str_byte(v, bi) == 32 or str_byte(v, bi) == 9) { bi += 1 }
                    mut bj := bi
                    mut dp := 0
                    while bj < bn {
                        cb := str_byte(v, bj)
                        if cb == 40 { dp += 1 }
                        else if cb == 41 { if dp > 0 { dp -= 1 } }
                        else if (cb == 32 or cb == 9) and dp == 0 { break }
                        bj += 1
                    }
                    if bj > bi {
                        tok := str_slice(v, bi, bj)
                        ch0 := str_byte(tok, 0)
                        if ch0 >= 48 and ch0 <= 57 {
                            style.border_width = css_parse_px(tok)
                        } else if not str_eq(tok, "solid") and not str_eq(tok, "dashed") and not str_eq(tok, "dotted") {
                            style.border_color = css_parse_color(tok)
                        }
                    }
                    bi = bj + 1
                }
                if style.border_width == 0 { style.border_width = 1 }
            }
        } else if str_eq(p, "box-shadow") {
            if str_eq(v, "none") { style.shadow = 0; style.shadow_color = 0 }
            else {
                style.shadow = 3
                // Detect colored shadow e.g. `0 10px 25px rgba(59,130,246,0.35)`
                rp_pos := str_find(v, "rgba(", 0)
                if rp_pos >= 0 {
                    re := _css_find_matching_rparen(v, rp_pos + 4)
                    if re > rp_pos { style.shadow_color = css_parse_color(str_slice(v, rp_pos, re + 1)) }
                } else {
                    hp_pos := str_find_byte(v, 35, 0)
                    if hp_pos >= 0 {
                        mut he := hp_pos + 1
                        vn := str_len(v)
                        while he < vn and str_byte(v, he) != 32 and str_byte(v, he) != 44 { he += 1 }
                        style.shadow_color = css_parse_color(str_slice(v, hp_pos, he))
                    }
                }
            }
        } else if str_eq(p, "bottom") {
            style.pos_bottom = css_parse_px(v)
        }
        return
    }

    if p0 == 100 { // 'd': display
        if str_eq(p, "display") {
            if str_eq(v, "flex") { style.display = 1 }
            else if str_eq(v, "inline") or str_eq(v, "inline-block") { style.display = 2 }
            else if str_eq(v, "none") { style.display = 3 }
            else if str_eq(v, "grid") { style.display = 4; if style.grid_cols <= 0 { style.grid_cols = 1 } }
            else { style.display = 0 }
        }
        return
    }

    if p0 == 102 { // 'f': flex*, font*
        if str_eq(p, "flex-direction") {
            if str_eq(v, "column") { style.flex_direction = 1 }
            else { style.flex_direction = 0 }
        } else if str_eq(p, "flex-wrap") {
            style.flex_wrap = str_eq(v, "wrap")
        } else if str_eq(p, "flex") or str_eq(p, "flex-grow") {
            fg := css_parse_px(v)
            if fg > 0 { style.flex_grow = fg; if style.width == -1 { style.width = -2 } }
        } else if str_eq(p, "flex-shrink") {
            style.flex_shrink = css_parse_px(v)
        } else if str_eq(p, "font-size") {
            fs := css_parse_px(v)
            if fs > 0 { style.font_size = fs }
        } else if str_eq(p, "font-weight") {
            if str_eq(v, "normal") or str_eq(v, "lighter") { style.font_weight = 400 }
            else if str_eq(v, "bold") or str_eq(v, "bolder") { style.font_weight = 700 }
            else {
                w := css_parse_px(v)
                if w >= 100 and w <= 900 { style.font_weight = w }
            }
        } else if str_eq(p, "font-family") {
            if str_contains(v, "mono") or str_contains(v, "Consolas") or str_contains(v, "Courier") or str_contains(v, "JetBrains") or str_contains(v, "Fira Code") {
                style.font_mono = true
            }
        } else if str_eq(p, "font-style") {
            style.font_italic = str_eq(v, "italic")
        }
        return
    }

    if p0 == 112 { // 'p': padding*, position
        if str_eq(p, "padding") {
            sp := str_find_byte(v, 32, 0)
            if sp > 0 {
                py := css_parse_px(str_slice(v, 0, sp))
                px := css_parse_px(str_slice(v, sp + 1, str_len(v)))
                style_set_pad_side(mut style, 6, py)
                style_set_pad_side(mut style, 5, px)
            } else {
                px := css_parse_px(v)
                style_set_pad_side(mut style, 0, px)
            }
        } else if str_eq(p, "padding-left") {
            style_set_pad_side(mut style, 4, css_parse_px(v))
        } else if str_eq(p, "padding-right") {
            style_set_pad_side(mut style, 2, css_parse_px(v))
        } else if str_eq(p, "padding-top") {
            style_set_pad_side(mut style, 1, css_parse_px(v))
        } else if str_eq(p, "padding-bottom") {
            style_set_pad_side(mut style, 3, css_parse_px(v))
        } else if str_eq(p, "position") {
            if str_eq(v, "absolute") { style.position = 1 }
            else if str_eq(v, "fixed") { style.position = 2 }
            else { style.position = 0 }
        }
        return
    }

    if p0 == 109 { // 'm': margin*, min-*, max-*
        if str_eq(p, "margin") {
            if str_contains(v, "auto") { style.margin_auto = true }
            sp := str_find_byte(v, 32, 0)
            if sp > 0 {
                my := css_parse_px(str_slice(v, 0, sp))
                mx := css_parse_px(str_slice(v, sp + 1, str_len(v)))
                if my >= 0 { style_set_mar_side(mut style, 6, my) }
                if mx >= 0 { style_set_mar_side(mut style, 5, mx) }
            } else {
                px := css_parse_px(v)
                if px >= 0 { style_set_mar_side(mut style, 0, px) }
            }
        } else if str_eq(p, "margin-left") {
            if str_eq(v, "auto") { style.margin_auto = true; style.margin_left_auto = true }
            else { style_set_mar_side(mut style, 4, css_parse_px(v)) }
        } else if str_eq(p, "margin-right") {
            if str_eq(v, "auto") { style.margin_auto = true; style.margin_right_auto = true }
            else { style_set_mar_side(mut style, 2, css_parse_px(v)) }
        } else if str_eq(p, "margin-top") {
            if str_eq(v, "auto") { style.margin_top_auto = true }
            else { style_set_mar_side(mut style, 1, css_parse_px(v)) }
        } else if str_eq(p, "margin-bottom") {
            if str_eq(v, "auto") { style.margin_bottom_auto = true }
            else { style_set_mar_side(mut style, 3, css_parse_px(v)) }
        } else if str_eq(p, "max-width") {
            mw := css_parse_px(v)
            if mw > 0 { style.max_width = mw }
        } else if str_eq(p, "min-width") {
            mw := css_parse_px(v)
            if mw > 0 { style.min_width = mw }
        } else if str_eq(p, "min-height") {
            mh := css_parse_px(v)
            if mh > 0 { style.min_height = mh }
        } else if str_eq(p, "max-height") {
            mh := css_parse_px(v)
            if mh > 0 { style.max_height = mh }
        }
        return
    }

    if p0 == 99 { // 'c': color, cursor, column-gap
        if str_eq(p, "color") {
            style.text_color = css_parse_color(v)
            style.has_color = true
        } else if str_eq(p, "cursor") {
            if str_eq(v, "pointer") { style.cursor = 1 }
            else if str_eq(v, "text") { style.cursor = 2 }
            else if str_eq(v, "not-allowed") { style.cursor = 3 }
            else if str_eq(v, "grab") or str_eq(v, "grabbing") { style.cursor = 4 }
            else if str_eq(v, "ew-resize") or str_eq(v, "col-resize") { style.cursor = 5 }
            else if str_eq(v, "ns-resize") or str_eq(v, "row-resize") { style.cursor = 6 }
            else if str_eq(v, "crosshair") { style.cursor = 7 }
            else { style.cursor = 0 }
        } else if str_eq(p, "column-gap") {
            style.gap_x = css_parse_px(v)
        }
        return
    }

    if p0 == 116 { // 't': text-*, top
        if str_eq(p, "text-align") {
            if str_eq(v, "center") { style.text_align = 1 }
            else if str_eq(v, "right") or str_eq(v, "end") { style.text_align = 2 }
            else { style.text_align = 0 }
        } else if str_eq(p, "text-transform") {
            if str_eq(v, "uppercase") { style.text_transform = 1 }
            else if str_eq(v, "lowercase") { style.text_transform = 2 }
            else if str_eq(v, "capitalize") { style.text_transform = 3 }
            else { style.text_transform = 0 }
        } else if str_eq(p, "text-decoration") {
            if str_contains(v, "underline") { style.text_decoration = 1 }
            else if str_contains(v, "line-through") { style.text_decoration = 2 }
            else { style.text_decoration = 0 }
        } else if str_eq(p, "text-overflow") {
            style.text_ellipsis = str_eq(v, "ellipsis")
        } else if str_eq(p, "top") {
            style.pos_top = css_parse_px(v)
        }
        return
    }

    if p0 == 119 { // 'w': width, white-space
        if str_eq(p, "width") {
            style.width = css_parse_px(v)
        } else if str_eq(p, "white-space") {
            if str_eq(v, "nowrap") { style.white_space = 1 }
            else if str_eq(v, "pre") or str_eq(v, "pre-wrap") { style.white_space = 2 }
            else { style.white_space = 0 }
        }
        return
    }

    if p0 == 104 { // 'h': height
        if str_eq(p, "height") {
            if str_eq(v, "100%") or str_eq(v, "100vh") { style.height = -100 }
            else { style.height = css_parse_px(v) }
        }
        return
    }

    if p0 == 103 { // 'g': gap, grid-template-columns
        if str_eq(p, "gap") {
            style.gap = css_parse_px(v)
        } else if str_eq(p, "grid-template-columns") {
            if str_starts_with(v, "repeat(") {
                c1 := str_find_byte(v, 44, 7)
                if c1 > 7 {
                    nc := css_parse_px(str_slice(v, 7, c1))
                    if nc >= 1 and nc <= 12 { style.grid_cols = nc }
                }
            } else {
                mut tracks := 0
                mut ti := 0
                vn := str_len(v)
                while ti < vn {
                    while ti < vn and (str_byte(v, ti) == 32 or str_byte(v, ti) == 9) { ti += 1 }
                    if ti >= vn { break }
                    tracks += 1
                    while ti < vn and str_byte(v, ti) != 32 and str_byte(v, ti) != 9 { ti += 1 }
                }
                if tracks >= 1 and tracks <= 12 { style.grid_cols = tracks }
            }
        }
        return
    }

    if p0 == 111 { // 'o': overflow*, opacity, object-fit
        if str_eq(p, "overflow") or str_eq(p, "overflow-x") or str_eq(p, "overflow-y") {
            if str_eq(v, "hidden") { style.overflow_hidden = true }
            else if str_eq(v, "auto") or str_eq(v, "scroll") { style.overflow_hidden = true; style.overflow_scroll = true }
            else if str_eq(v, "visible") { style.overflow_hidden = false; style.overflow_scroll = false }
        } else if str_eq(p, "opacity") {
            a255 := _css_parse_alpha_255(v)
            style.opacity = (a255 * 100 + 127) / 255
        } else if str_eq(p, "object-fit") {
            if str_eq(v, "cover") { style.object_fit = 1 }
            else if str_eq(v, "contain") { style.object_fit = 2 }
            else { style.object_fit = 0 }
        }
        return
    }

    if p0 == 106 { // 'j': justify-content
        if str_eq(p, "justify-content") {
            if str_eq(v, "center") { style.justify_content = 1 }
            else if str_eq(v, "flex-end") or str_eq(v, "end") { style.justify_content = 2 }
            else if str_eq(v, "space-between") { style.justify_content = 3 }
            else if str_eq(v, "space-around") { style.justify_content = 4 }
            else if str_eq(v, "space-evenly") { style.justify_content = 5 }
            else { style.justify_content = 0 }
        }
        return
    }

    if p0 == 97 { // 'a': align-items
        if str_eq(p, "align-items") {
            if str_eq(v, "center") { style.align_items = 1 }
            else if str_eq(v, "flex-start") or str_eq(v, "start") { style.align_items = 2 }
            else if str_eq(v, "flex-end") or str_eq(v, "end") { style.align_items = 3 }
            else { style.align_items = 0 }
        }
        return
    }

    if p0 == 108 { // 'l': left, line-height, letter-spacing
        if str_eq(p, "left") {
            style.pos_left = css_parse_px(v)
        } else if str_eq(p, "line-height") {
            lh := css_parse_px(v)
            if lh > 0 { style.line_height = lh }
        } else if str_eq(p, "letter-spacing") {
            style.letter_spacing = css_parse_px(v) * 10
        }
        return
    }

    if p0 == 114 { // 'r': right, row-gap
        if str_eq(p, "right") {
            style.pos_right = css_parse_px(v)
        } else if str_eq(p, "row-gap") {
            style.gap_y = css_parse_px(v)
        }
        return
    }

    if p0 == 122 { // 'z': z-index
        if str_eq(p, "z-index") {
            style.z_index = css_parse_px(v)
        }
        return
    }
}

fn css_strip_comments(css: str) -> str {
    n := str_len(css)
    if str_find(css, "/*", 0) < 0 { return css }
    out := buf_new(n + 1)
    mut i := 0
    while i < n {
        if i + 1 < n and str_byte(css, i) == 47 and str_byte(css, i + 1) == 42 {
            end_c := str_find(css, "*/", i + 2)
            if end_c < 0 { break }
            i = end_c + 2
        } else {
            buf_push(out, str_byte(css, i))
            i += 1
        }
    }
    return buf_to_owned_str(move out)
}

fn css_parse_inline(mut style: ComputedStyle, inline_str: str) {
    clean := css_strip_comments(inline_str)
    n := str_len(clean)
    if n == 0 { return }

    mut cur := 0
    while cur < n {
        mut semi := str_find_byte(clean, 59, cur) // ';'
        if semi < 0 { semi = n }
        decl := str_slice(clean, cur, semi)
        
        colon := str_find_byte(decl, 58, 0) // ':'
        if colon >= 0 {
            prop := str_slice(decl, 0, colon)
            val := str_slice(decl, colon + 1, str_len(decl))
            css_apply_property(mut style, prop, val)
        }

        cur = semi + 1
    }
}

struct Stylesheet {
    css_text: str
    rules: IntBuf
    rule_count: i64
    vars: IntBuf       // 4 ints per CSS custom property: [name_st, name_len, val_st, val_len]
    var_count: i64
    viewport_w: i64
}

fn css_stylesheet_free(move sheet: Stylesheet) {
    buf_free(move sheet.rules)
    buf_free(move sheet.vars)
}

fn _css_lookup_var(sheet: Stylesheet, vname: str) -> str {
    vn := str_len(vname)
    if vn == 0 or sheet.var_count <= 0 { return "" }
    mut i := sheet.var_count - 1
    while i >= 0 {
        b := i * 4
        nl := ibuf_get(sheet.vars, b + 1)
        if nl == vn {
            ns := ibuf_get(sheet.vars, b)
            if str_eq(str_slice(sheet.css_text, ns, ns + nl), vname) {
                vs := ibuf_get(sheet.vars, b + 2)
                vl := ibuf_get(sheet.vars, b + 3)
                return str_trim(str_slice(sheet.css_text, vs, vs + vl))
            }
        }
        i -= 1
    }
    return ""
}

// Resolves all `var(--name[, fallback])` including nested fallbacks with strict recursion cap (CWE-674 cyclic-var anti-DoS!)
fn css_resolve_var(sheet: Stylesheet, raw_val: str, depth: i64 = 0) -> str {
    if depth >= 8 { return "" }
    if str_find_byte(raw_val, 40, 0) < 0 { return raw_val }
    if str_find(raw_val, "var(", 0) < 0 { return raw_val }
    n := str_len(raw_val)
    mut out_cap := n * 2 + 128
    if out_cap < 256 { out_cap = 256 }
    if out_cap > 16384 { out_cap = 16384 }
    out := buf_new(out_cap)
    mut p := 0
    mut guard := 0
    while p < n and guard < 16 {
        guard += 1
        vp := str_find(raw_val, "var(", p)
        if vp < 0 {
            rem := str_slice(raw_val, p, n)
            if buf_len(out) + str_len(rem) <= out_cap { buf_push_str(out, rem) }
            break
        }
        if vp > p {
            pre := str_slice(raw_val, p, vp)
            if buf_len(out) + str_len(pre) <= out_cap { buf_push_str(out, pre) }
        }
        rp := _css_find_matching_rparen(raw_val, vp + 3)
        if rp <= vp + 4 {
            tail := str_slice(raw_val, vp, n)
            if buf_len(out) + str_len(tail) <= out_cap { buf_push_str(out, tail) }
            break
        }
        inner := str_slice(raw_val, vp + 4, rp)
        comma := _css_find_top_comma(inner, 0)
        vname := str_trim(if comma >= 0 { str_slice(inner, 0, comma) } else { inner })
        fallback_raw := if comma >= 0 { str_trim(str_slice(inner, comma + 1, str_len(inner))) } else { "" }
        mut resolved := _css_lookup_var(sheet, vname)
        if str_len(resolved) > 0 {
            if str_find(resolved, "var(", 0) >= 0 {
                resolved = css_resolve_var(sheet, resolved, depth + 1)
            }
            if buf_len(out) + str_len(resolved) <= out_cap { buf_push_str(out, resolved) }
        } else if str_len(fallback_raw) > 0 {
            fb := if str_find(fallback_raw, "var(", 0) >= 0 { css_resolve_var(sheet, fallback_raw, depth + 1) } else { fallback_raw }
            if buf_len(out) + str_len(fb) <= out_cap { buf_push_str(out, fb) }
        }
        p = rp + 1
    }
    return buf_to_owned_str(move out)
}

fn css_parse_inline_with_vars(mut style: ComputedStyle, inline_str: str, sheet: Stylesheet) {
    clean := if str_find_byte(inline_str, 47, 0) >= 0 { css_strip_comments(inline_str) } else { inline_str }
    n := str_len(clean)
    if n == 0 { return }
    mut cur := 0
    while cur < n {
        mut semi := str_find_byte(clean, 59, cur)
        if semi < 0 { semi = n }
        if semi > cur {
            decl := str_slice(clean, cur, semi)
            colon := str_find_byte(decl, 58, 0)
            if colon > 0 {
                prop := str_slice(decl, 0, colon)
                val_raw := str_slice(decl, colon + 1, str_len(decl))
                val := if sheet.var_count > 0 { css_resolve_var(sheet, val_raw) } else { val_raw }
                css_apply_property(mut style, prop, val)
            }
        }
        cur = semi + 1
    }
}

fn _css_parse_media_bound(header: str, key: str) -> i64 {
    idx := str_find(header, key, 0)
    if idx < 0 { return -1 }
    col := str_find_byte(header, 58, idx) // ':'
    if col < 0 { return -1 }
    mut p := col + 1
    hn := str_len(header)
    while p < hn and (str_byte(header, p) == 32 or str_byte(header, p) == 9) { p += 1 }
    mut end := p
    while end < hn and str_byte(header, end) != 41 and str_byte(header, end) != 32 and str_byte(header, end) != 123 { end += 1 }
    val_str := str_slice(header, p, end)
    px := css_parse_px(val_str)
    return px
}

fn css_parse_stylesheet(css: str) -> Stylesheet {
    clean := if str_find_byte(css, 47, 0) >= 0 { css_strip_comments(css) } else { css }
    n := str_len(clean)
    rb := ibuf_new(6144)
    vb := ibuf_new(1024)
    mut count := 0
    mut vcount := 0
    mut p := 0

    while p < n and count < 1024 {
        while p < n and (str_byte(clean, p) == 32 or str_byte(clean, p) == 9 or str_byte(clean, p) == 10 or str_byte(clean, p) == 13) { p += 1 }
        if p >= n { break }

        // Fast `@` at-rule dispatch: `@media`, `@keyframes`, `@supports`, `@layer`, `@import`, `@charset`
        if str_byte(clean, p) == 64 {
            if p + 6 < n and str_eq(str_slice(clean, p, p + 6), "@media") {
                media_open := str_find_byte(clean, 123, p) // '{'
                if media_open < 0 { break }
                media_header := str_slice(clean, p, media_open)
                mut min_w := _css_parse_media_bound(media_header, "min-width")
                if min_w < 0 { min_w = 0 }
                mut max_w := _css_parse_media_bound(media_header, "max-width")
                if max_w < 0 { max_w = 999999 }

                mut depth := 1
                mut k := media_open + 1
                while k < n and depth > 0 {
                    b := str_byte(clean, k)
                    if b == 123 { depth += 1 }
                    else if b == 125 { depth -= 1 }
                    k += 1
                }
                media_close := k - 1

                mut mp := media_open + 1
                while mp < media_close and count < 1024 {
                    while mp < media_close and (str_byte(clean, mp) == 32 or str_byte(clean, mp) == 9 or str_byte(clean, mp) == 10 or str_byte(clean, mp) == 13) { mp += 1 }
                    if mp >= media_close { break }
                    in_open := str_find_byte(clean, 123, mp)
                    if in_open < 0 or in_open >= media_close { break }
                    in_close := str_find_byte(clean, 125, in_open + 1)
                    if in_close < 0 or in_close > media_close { break }

                    ibuf_push(rb, mp)
                    ibuf_push(rb, in_open - mp)
                    ibuf_push(rb, in_open + 1)
                    ibuf_push(rb, in_close - in_open - 1)
                    ibuf_push(rb, min_w)
                    ibuf_push(rb, max_w)
                    count += 1
                    mp = in_close + 1
                }
                p = media_close + 1
                continue
            }
            // Other at-rules (`@keyframes`, `@supports`, `@layer`, `@font-face`, `@import`): skip cleanly without corrupting subsequent rules!
            semi_at := str_find_byte(clean, 59, p)
            open_at := str_find_byte(clean, 123, p)
            if semi_at >= 0 and (open_at < 0 or semi_at < open_at) {
                p = semi_at + 1
                continue
            }
            if open_at >= 0 {
                mut depth := 1
                mut k := open_at + 1
                while k < n and depth > 0 {
                    b := str_byte(clean, k)
                    if b == 123 { depth += 1 }
                    else if b == 125 { depth -= 1 }
                    k += 1
                }
                p = k
                continue
            }
            break
        }

        brace_open := str_find_byte(clean, 123, p)
        if brace_open < 0 { break }

        brace_close := str_find_byte(clean, 125, brace_open + 1)
        if brace_close < 0 { break }

        sel_st := p
        sel_l := brace_open - p
        body_st := brace_open + 1
        body_l := brace_close - body_st

        // Extract CSS custom properties (`--name: value;`)
        mut vp := body_st
        body_end := brace_close
        while vp < body_end and vcount < 256 {
            mut semi := str_find_byte(clean, 59, vp)
            if semi < 0 or semi > body_end { semi = body_end }
            mut ks := vp
            while ks < semi and (str_byte(clean, ks) == 32 or str_byte(clean, ks) == 9 or str_byte(clean, ks) == 10 or str_byte(clean, ks) == 13) { ks += 1 }
            if ks + 2 < semi and str_byte(clean, ks) == 45 and str_byte(clean, ks + 1) == 45 {
                col := str_find_byte(clean, 58, ks)
                if col > ks and col < semi {
                    mut ke := col
                    while ke > ks and (str_byte(clean, ke - 1) == 32 or str_byte(clean, ke - 1) == 9) { ke -= 1 }
                    mut vs := col + 1
                    while vs < semi and (str_byte(clean, vs) == 32 or str_byte(clean, vs) == 9) { vs += 1 }
                    mut ve := semi
                    while ve > vs and (str_byte(clean, ve - 1) == 32 or str_byte(clean, ve - 1) == 9 or str_byte(clean, ve - 1) == 10 or str_byte(clean, ve - 1) == 13) { ve -= 1 }
                    if ke > ks and ve > vs {
                        ibuf_push(vb, ks); ibuf_push(vb, ke - ks)
                        ibuf_push(vb, vs); ibuf_push(vb, ve - vs)
                        vcount += 1
                    }
                }
            }
            vp = semi + 1
        }

        ibuf_push(rb, sel_st)
        ibuf_push(rb, sel_l)
        ibuf_push(rb, body_st)
        ibuf_push(rb, body_l)
        ibuf_push(rb, 0)
        ibuf_push(rb, 999999)
        count += 1

        p = brace_close + 1
    }

    return Stylesheet(css_text = clean, rules = rb, rule_count = count, vars = vb, var_count = vcount, viewport_w = 1280)
}

fn css_has_class_token(cls_list: str, target_cls: str) -> bool {
    tn := str_len(target_cls)
    ln := str_len(cls_list)
    if tn == 0 or ln == 0 { return false }
    t0 := str_byte(target_cls, 0)
    mut i := 0
    while i < ln {
        while i < ln and (str_byte(cls_list, i) == 32 or str_byte(cls_list, i) == 9 or str_byte(cls_list, i) == 10 or str_byte(cls_list, i) == 13) {
            i += 1
        }
        mut j := i
        while j < ln and str_byte(cls_list, j) != 32 and str_byte(cls_list, j) != 9 and str_byte(cls_list, j) != 10 and str_byte(cls_list, j) != 13 {
            j += 1
        }
        if j - i == tn and str_byte(cls_list, i) == t0 and str_eq(str_slice(cls_list, i, j), target_cls) {
            return true
        }
        i = j + 1
    }
    return false
}

// Matches a single compound selector like `div`, `.card`, `#id`, `div.card`, `button#go.primary`
fn _css_compound_matches(tree: DomTree, node_idx: i64, sel: str) -> bool {
    s := str_trim(sel)
    sn := str_len(s)
    if sn == 0 { return false }
    if sn == 1 and str_byte(s, 0) == 42 { return true } // '*'

    mut cached_cls := ""
    mut has_cls := false
    mut i := 0
    while i < sn {
        b := str_byte(s, i)
        if b == 35 { // #id
            mut j := i + 1
            while j < sn and str_byte(s, j) != 46 and str_byte(s, j) != 35 { j += 1 }
            if not str_eq(dom_get_id(tree, node_idx), str_slice(s, i + 1, j)) { return false }
            i = j
        } else if b == 46 { // .class
            mut j := i + 1
            while j < sn and str_byte(s, j) != 46 and str_byte(s, j) != 35 { j += 1 }
            if not has_cls {
                cached_cls = dom_get_class(tree, node_idx)
                has_cls = true
            }
            if not css_has_class_token(cached_cls, str_slice(s, i + 1, j)) { return false }
            i = j
        } else { // tag
            mut j := i
            while j < sn and str_byte(s, j) != 46 and str_byte(s, j) != 35 { j += 1 }
            if not str_eq_ignore_case(dom_get_tag(tree, node_idx), str_slice(s, i, j)) { return false }
            i = j
        }
    }
    return true
}

// Zero-alloc compound/combinator matcher with shared step budget (anti-ReDoS!)
fn _css_single_sel_rec(tree: DomTree, node_idx: i64, sel: str, depth: i64, mut budget: i64) -> bool {
    if depth > 10 or budget <= 0 { return false }
    budget -= 1
    s := str_trim(sel)
    sn := str_len(s)
    if sn == 0 { return false }

    mut last_sp := -1
    mut is_child_comb := false
    mut k := sn - 1
    while k >= 0 {
        ch := str_byte(s, k)
        if ch == 62 { // '>'
            last_sp = k
            is_child_comb = true
            break
        }
        if ch == 32 or ch == 9 {
            last_sp = k
            break
        }
        k -= 1
    }
    if last_sp < 0 {
        return _css_compound_matches(tree, node_idx, s)
    }

    right := str_trim(str_slice(s, last_sp + 1, sn))
    if str_len(right) == 0 or not _css_compound_matches(tree, node_idx, right) { return false }
    mut left := str_trim(str_slice(s, 0, last_sp))
    if not is_child_comb and str_ends_with(left, ">") {
        is_child_comb = true
        left = str_trim(str_slice(left, 0, str_len(left) - 1))
    }
    if is_child_comb {
        p_idx := dom_parent(tree, node_idx)
        if p_idx < 0 { return false }
        return _css_single_sel_rec(tree, p_idx, left, depth + 1, mut budget)
    }
    mut anc := dom_parent(tree, node_idx)
    mut steps := 0
    while anc >= 0 and steps < 24 and budget > 0 {
        if _css_single_sel_rec(tree, anc, left, depth + 1, mut budget) { return true }
        anc = dom_parent(tree, anc)
        steps += 1
    }
    return false
}

fn css_single_selector_matches(tree: DomTree, node_idx: i64, sel: str) -> bool {
    mut budget := 64
    return _css_single_sel_rec(tree, node_idx, sel, 0, mut budget)
}

fn css_selector_matches(tree: DomTree, node_idx: i64, sel: str) -> bool {
    sn := str_len(sel)
    mut p := 0
    while p < sn {
        mut comma := str_find_byte(sel, 44, p)
        if comma < 0 { comma = sn }
        part := str_slice(sel, p, comma)
        if css_single_selector_matches(tree, node_idx, part) {
            return true
        }
        p = comma + 1
    }
    return false
}

// Evaluates comma-separated selectors including per-part `:hover`, `:focus`, `:active` pseudo-classes.
// Returns: 0 = no match, 1 = matched, 2 = base selector matched a `:hover` rule (sets has_hover even when not currently hovered).
fn _css_selector_match_state(tree: DomTree, node_idx: i64, sel: str, is_hovered: bool, is_focused: bool, is_active: bool) -> i64 {
    sn := str_len(sel)
    mut p := 0
    mut saw_hover_target := false
    while p < sn {
        mut comma := str_find_byte(sel, 44, p)
        if comma < 0 { comma = sn }
        part := str_trim(str_slice(sel, p, comma))
        pn := str_len(part)
        if pn > 0 {
            if str_find_byte(part, 58, 0) >= 0 {
                if str_ends_with(part, ":hover") {
                    base_sel := str_slice(part, 0, pn - 6)
                    if css_single_selector_matches(tree, node_idx, base_sel) {
                        if is_hovered { return 1 }
                        saw_hover_target = true
                    }
                } else if str_ends_with(part, ":focus") {
                    if is_focused and css_single_selector_matches(tree, node_idx, str_slice(part, 0, pn - 6)) {
                        return 1
                    }
                } else if str_ends_with(part, ":active") {
                    if is_active and css_single_selector_matches(tree, node_idx, str_slice(part, 0, pn - 7)) {
                        return 1
                    }
                } else if css_single_selector_matches(tree, node_idx, part) {
                    return 1
                }
            } else if css_single_selector_matches(tree, node_idx, part) {
                return 1
            }
        }
        p = comma + 1
    }
    if saw_hover_target { return 2 }
    return 0
}

fn _css_compute_own_style(tree: DomTree, node_idx: i64, sheet: Stylesheet, is_hovered: bool, is_focused: bool, is_active: bool) -> ComputedStyle {
    mut style := style_default()

    tag := dom_get_tag(tree, node_idx)
    tlen := str_len(tag)
    if tlen == 0 {
        style.display = 2
        return style
    }
    // Fast first-byte tag dispatch (skips ~25 comparisons for `div`, `p`, `ul`, `li`, etc.)
    t0 := str_byte(tag, 0) | 32
    if t0 == 104 { // 'h': head, hr, h1, h2, h3
        if tlen == 4 and str_eq_ignore_case(tag, "head") { style.display = 3; return style }
        if tlen == 2 {
            t1 := str_byte(tag, 1) | 32
            if t1 == 114 { style.height = 1; style.bg_color = 0xFF272730; style.margin_y = 12 } // hr
            else if t1 == 49 { style.font_size = 24; style.font_weight = 700 } // h1
            else if t1 == 50 { style.font_size = 18; style.font_weight = 600 } // h2
            else if t1 == 51 { style.font_size = 15; style.font_weight = 600 } // h3
        }
    } else if t0 == 115 { // 's': style, script, span, strong
        if tlen == 5 and str_eq_ignore_case(tag, "style") { style.display = 3; return style }
        if tlen == 6 and str_eq_ignore_case(tag, "script") { style.display = 3; return style }
        if tlen == 4 and str_eq_ignore_case(tag, "span") { style.display = 2 }
        else if tlen == 6 and str_eq_ignore_case(tag, "strong") { style.display = 2; style.font_size = 15; style.font_weight = 600 }
    } else if t0 == 98 { // 'b': button, b
        if tlen == 1 { style.display = 2; style.font_size = 15; style.font_weight = 600 }
        else if tlen == 6 and str_eq_ignore_case(tag, "button") {
            style.cursor = 1
            style.padding_x = 24
            style.padding_y = 14
            style.border_radius = 8
            style.bg_color = 0xFF2563EB
            style.text_color = 0xFFFFFFFF
            style.has_color = true
            style.font_size = 14
            style.font_weight = 600
            style.text_align = 1
        }
    } else if t0 == 105 { // 'i': input
        if tlen == 5 and str_eq_ignore_case(tag, "input") {
            style.padding_x = 20; style.padding_y = 12; style.border_radius = 8
            style.bg_color = 0xFF0E0E12; style.border_width = 1; style.border_color = 0xFF272730
            style.text_color = 0xFFF4F4F5; style.has_color = true; style.font_size = 14; style.cursor = 2
        }
    } else if t0 == 116 { // 't': title, textarea
        if tlen == 5 and str_eq_ignore_case(tag, "title") { style.display = 3; return style }
        if tlen == 8 and str_eq_ignore_case(tag, "textarea") {
            style.padding_x = 20; style.padding_y = 12; style.border_radius = 8
            style.bg_color = 0xFF0E0E12; style.border_width = 1; style.border_color = 0xFF272730
            style.text_color = 0xFFF4F4F5; style.has_color = true; style.font_size = 14; style.cursor = 2
        }
    } else if t0 == 99 { // 'c': code, circle
        if tlen == 4 and str_eq_ignore_case(tag, "code") { style.display = 2; style.font_mono = true }
        else if tlen == 6 and str_eq_ignore_case(tag, "circle") { style.border_radius = 9999 }
    } else if t0 == 109 { // 'm': meta
        if tlen == 4 and str_eq_ignore_case(tag, "meta") { style.display = 3; return style }
    } else if t0 == 108 { // 'l': link
        if tlen == 4 and str_eq_ignore_case(tag, "link") { style.display = 3; return style }
    } else if t0 == 97 { // 'a': a
        if tlen == 1 { style.display = 2; style.cursor = 1 }
    } else if t0 == 101 { // 'e': em
        if tlen == 2 and str_eq_ignore_case(tag, "em") { style.display = 2; style.font_italic = true }
    } else if t0 == 112 { // 'p': pre
        if tlen == 3 and str_eq_ignore_case(tag, "pre") { style.font_mono = true; style.white_space = 2 }
    }

    // 2. Apply Tailwind & Bootstrap utilities from class attribute (responsive with viewport_w)
    cls_str := dom_get_class(tree, node_idx)
    if str_len(cls_str) > 0 {
        tw_apply_classes(mut style, cls_str, sheet.viewport_w)
    }

    // 3. Apply Stylesheet rules (including responsive @media boundaries and :hover/:focus/:active!)
    mut r := 0
    while r < sheet.rule_count {
        base_r := r * 6
        min_w := ibuf_get(sheet.rules, base_r + 4)
        max_w := ibuf_get(sheet.rules, base_r + 5)

        if sheet.viewport_w > 0 {
            if sheet.viewport_w < min_w or sheet.viewport_w > max_w {
                r += 1
                continue
            }
        }

        sel_st := ibuf_get(sheet.rules, base_r)
        sel_l := ibuf_get(sheet.rules, base_r + 1)
        sel_str := str_trim(str_slice(sheet.css_text, sel_st, sel_st + sel_l))
        m_res := _css_selector_match_state(tree, node_idx, sel_str, is_hovered, is_focused, is_active)
        if m_res == 1 {
            body_st := ibuf_get(sheet.rules, base_r + 2)
            body_l := ibuf_get(sheet.rules, base_r + 3)
            body_str := str_slice(sheet.css_text, body_st, body_st + body_l)
            css_parse_inline_with_vars(mut style, body_str, sheet)
            if str_contains(sel_str, ":hover") { style.has_hover = true }
        } else if m_res == 2 {
            style.has_hover = true
        }
        r += 1
    }

    // 4. Apply Tailwind `hover:*`, `focus:*`, `active:*` interactive state overrides
    if style.hover_bg != 0 or style.hover_border != 0 or style.hover_text != 0 or style.hover_shadow != 0 or style.hover_opacity >= 0 {
        style.has_hover = true
    }
    if is_hovered {
        if style.hover_bg != 0 { style.bg_color = style.hover_bg }
        if style.hover_border != 0 { style.border_color = style.hover_border }
        if style.hover_text != 0 { style.text_color = style.hover_text; style.has_color = true }
        if style.hover_shadow != 0 { style.shadow = style.hover_shadow }
        if style.hover_opacity >= 0 { style.opacity = style.hover_opacity }
    }
    if is_focused {
        if style.focus_border != 0 {
            style.border_color = style.focus_border
            if style.border_width == 0 { style.border_width = 1 }
        }
        if style.focus_bg != 0 { style.bg_color = style.focus_bg }
    }
    if is_active and style.active_bg != 0 {
        style.bg_color = style.active_bg
    }

    inline_s := dom_get_style(tree, node_idx)
    if str_len(inline_s) > 0 {
        css_parse_inline_with_vars(mut style, inline_s, sheet)
    }

    return style
}

// O(1) Top-Down Style Computation: inherits typography/color/cursor directly from already-computed parent style!
// Eliminates the 8-ancestor recomputation loop (~9x faster during layout & rendering).
fn css_compute_node_style_inherited(tree: DomTree, node_idx: i64, sheet: Stylesheet, parent: ComputedStyle, has_parent: bool, is_hovered: bool, is_focused: bool, is_active: bool) -> ComputedStyle {
    mut style := _css_compute_own_style(tree, node_idx, sheet, is_hovered, is_focused, is_active)
    if style.display == 3 { return style }
    if has_parent {
        if not style.has_color and parent.has_color { style.text_color = parent.text_color; style.has_color = true }
        if style.font_size == 0 and parent.font_size > 0 { style.font_size = parent.font_size }
        if style.font_weight == 0 and parent.font_weight > 0 { style.font_weight = parent.font_weight }
        if not style.font_mono and parent.font_mono { style.font_mono = true }
        if style.text_align == 0 and parent.text_align != 0 { style.text_align = parent.text_align }
        if style.text_transform == 0 and parent.text_transform != 0 { style.text_transform = parent.text_transform }
        if style.cursor == 0 and parent.cursor != 0 { style.cursor = parent.cursor }
        if style.white_space == 0 and parent.white_space != 0 { style.white_space = parent.white_space }
        if style.line_height == 0 and parent.line_height > 0 { style.line_height = parent.line_height }
        if style.letter_spacing == 0 and parent.letter_spacing != 0 { style.letter_spacing = parent.letter_spacing }
    }
    if not style.has_color and str_len(dom_get_tag(tree, node_idx)) == 0 {
        style.text_color = 0xFFCBD5E1
    }
    return style
}

// Full CSS Cascade + True Ancestor Inheritance (for standalone random-access queries)
fn css_compute_node_style_full(tree: DomTree, node_idx: i64, sheet: Stylesheet, is_hovered: bool, is_focused: bool, is_active: bool) -> ComputedStyle {
    mut style := _css_compute_own_style(tree, node_idx, sheet, is_hovered, is_focused, is_active)
    if style.display == 3 { return style }

    mut need_color := not style.has_color
    mut need_fs := style.font_size == 0
    mut need_fw := style.font_weight == 0
    mut need_mono := not style.font_mono
    mut need_align := style.text_align == 0
    mut need_xform := style.text_transform == 0
    mut need_cursor := style.cursor == 0
    mut need_ws := style.white_space == 0

    mut anc := dom_parent(tree, node_idx)
    mut hops := 0
    while anc >= 0 and hops < 8 and (need_color or need_fs or need_fw or need_mono or need_align or need_xform or need_cursor or need_ws) {
        ast := _css_compute_own_style(tree, anc, sheet, false, false, false)
        if need_color and ast.has_color { style.text_color = ast.text_color; style.has_color = true; need_color = false }
        if need_fs and ast.font_size > 0 { style.font_size = ast.font_size; need_fs = false }
        if need_fw and ast.font_weight > 0 { style.font_weight = ast.font_weight; need_fw = false }
        if need_mono and ast.font_mono { style.font_mono = true; need_mono = false }
        if need_align and ast.text_align != 0 { style.text_align = ast.text_align; need_align = false }
        if need_xform and ast.text_transform != 0 { style.text_transform = ast.text_transform; need_xform = false }
        if need_cursor and ast.cursor != 0 { style.cursor = ast.cursor; need_cursor = false }
        if need_ws and ast.white_space != 0 { style.white_space = ast.white_space; need_ws = false }
        anc = dom_parent(tree, anc)
        hops += 1
    }

    if not style.has_color and str_len(dom_get_tag(tree, node_idx)) == 0 {
        style.text_color = 0xFFCBD5E1
    }
    return style
}

fn css_compute_node_style_state(tree: DomTree, node_idx: i64, sheet: Stylesheet, is_hovered: bool) -> ComputedStyle {
    return css_compute_node_style_full(tree, node_idx, sheet, is_hovered, false, false)
}

fn css_compute_node_style(tree: DomTree, node_idx: i64, sheet: Stylesheet) -> ComputedStyle {
    return css_compute_node_style_full(tree, node_idx, sheet, false, false, false)
}
