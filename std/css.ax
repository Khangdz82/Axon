// Axon Standard Library: Native CSS Parser & Style Engine (`std/css.ax`)
// Pure native zero-CEF CSS3 parser, selector matching, color decoders & cascade solver.

use std::os
use std::str
use std::html
use std::ui_tailwind

struct ComputedStyle {
    display: i64        // 0: block, 1: flex, 2: inline, 3: none, 4: grid
    flex_direction: i64 // 0: row, 1: column
    justify_content: i64// 0: flex-start, 1: center, 2: flex-end, 3: space-between, 4: space-around
    align_items: i64    // 0: stretch, 1: center, 2: flex-start, 3: flex-end
    gap: i64
    width: i64          // -1: auto, -2: flex-1, -3: w-auto, <= -1000: pct
    height: i64         // -1: auto, -100: h-full/h-screen
    padding_x: i64
    padding_y: i64
    margin_x: i64
    margin_y: i64
    bg_color: i64       // 32-bit ARGB: (a << 24) | (r << 16) | (g << 8) | b
    text_color: i64     // 32-bit ARGB
    border_width: i64
    border_color: i64
    border_radius: i64
    font_size: i64      // logical px; 0 = derive from element tag
    font_weight: i64    // 0 = derive from element tag, else 400..700
    text_align: i64     // 0 left, 1 center, 2 right
    grad_dir: i64       // 0 none, 1 to-r, 2 to-b, 3 to-br
    grad_from: i64      // ARGB start stop
    grad_to: i64        // ARGB end stop
    shadow: i64         // 0 none, 1 sm, 2 md, 3 lg, 4 xl, 5 2xl
    opacity: i64        // 0..100
    hover_bg: i64       // ARGB override on :hover
    hover_border: i64   // ARGB override on :hover
    hover_text: i64     // ARGB override on :hover
    margin_auto: bool   // mx-auto / margin: auto horizontal centering
    max_width: i64      // > 0 clamps box width
    grid_cols: i64      // > 0 when display == 4 (CSS Grid columns)
    flex_wrap: bool     // flex-wrap: wrap
    flex_grow: i64      // flex: 1 / flex-grow
    font_mono: bool     // monospace font family
    overflow_hidden: bool // overflow: hidden
    overflow_scroll: bool // overflow-y: auto / scroll (independent per-container scroll)
    position: i64       // 0: static/relative, 1: absolute, 2: fixed
    pos_top: i64        // -999999 = unset
    pos_left: i64       // -999999 = unset
    pos_right: i64      // -999999 = unset
    pos_bottom: i64     // -999999 = unset
    text_transform: i64 // 0: none, 1: uppercase, 2: lowercase
    border_sides: i64   // 0 = all 4 sides (default), else bitmask: 1=top, 2=right, 4=bottom, 8=left
    margin_top_auto: bool
    margin_bottom_auto: bool
    margin_left_auto: bool
    margin_right_auto: bool
    min_width: i64
    min_height: i64
    max_height: i64
    flex_shrink: i64    // 1 default, 0 = shrink-0
    cursor: i64         // 0 default, 1 pointer, 2 text
    line_height: i64    // 0 auto, else px
    white_space: i64    // 0 normal, 1 nowrap, 2 pre
    text_decoration: i64 // 0 none, 1 underline, 2 line-through
    font_italic: bool
    focus_border: i64
    focus_bg: i64
    active_bg: i64
    grad_via: i64
    z_index: i64
    has_color: bool
}

fn style_default() -> ComputedStyle {
    return ComputedStyle(
        display = 0,         // block
        flex_direction = 0,  // row
        justify_content = 0, // flex-start
        align_items = 0,     // stretch
        gap = 0,
        width = -1,
        height = -1,
        padding_x = 0,
        padding_y = 0,
        margin_x = 0,
        margin_y = 0,
        bg_color = 0,        // transparent
        text_color = 0xFFFFFFFF, // white
        border_width = 0,
        border_color = 0,
        border_radius = 0,
        font_size = 0,
        font_weight = 0,
        text_align = 0,
        grad_dir = 0,
        grad_from = 0,
        grad_to = 0,
        shadow = 0,
        opacity = 100,
        hover_bg = 0,
        hover_border = 0,
        hover_text = 0,
        margin_auto = false,
        max_width = 0,
        grid_cols = 0,
        flex_wrap = false,
        flex_grow = 0,
        font_mono = false,
        overflow_hidden = false,
        overflow_scroll = false,
        position = 0,
        pos_top = -999999,
        pos_left = -999999,
        pos_right = -999999,
        pos_bottom = -999999,
        text_transform = 0,
        border_sides = 0,
        margin_top_auto = false,
        margin_bottom_auto = false,
        margin_left_auto = false,
        margin_right_auto = false,
        min_width = 0,
        min_height = 0,
        max_height = 0,
        flex_shrink = 1,
        cursor = 0,
        line_height = 0,
        white_space = 0,
        text_decoration = 0,
        font_italic = false,
        focus_border = 0,
        focus_bg = 0,
        active_bg = 0,
        grad_via = 0,
        z_index = 0,
        has_color = false
    )
}

fn css_hex_digit(ch: i64) -> i64 {
    if ch >= 48 and ch <= 57 { return ch - 48 }
    if ch >= 97 and ch <= 102 { return ch - 97 + 10 }
    if ch >= 65 and ch <= 70 { return ch - 65 + 10 }
    return 0
}

fn css_parse_color(val: str) -> i64 {
    s := str_trim(val)
    n := str_len(s)
    if n == 0 or str_eq(s, "transparent") { return 0 }

    if str_byte(s, 0) == 35 { // '#'
        if n == 4 { // #RGB
            r := css_hex_digit(str_byte(s, 1)) * 17
            g := css_hex_digit(str_byte(s, 2)) * 17
            b := css_hex_digit(str_byte(s, 3)) * 17
            return (0xFF << 24) | (r << 16) | (g << 8) | b
        }
        if n == 7 { // #RRGGBB
            r := (css_hex_digit(str_byte(s, 1)) << 4) | css_hex_digit(str_byte(s, 2))
            g := (css_hex_digit(str_byte(s, 3)) << 4) | css_hex_digit(str_byte(s, 4))
            b := (css_hex_digit(str_byte(s, 5)) << 4) | css_hex_digit(str_byte(s, 6))
            return (0xFF << 24) | (r << 16) | (g << 8) | b
        }
        if n == 9 { // #RRGGBBAA
            r := (css_hex_digit(str_byte(s, 1)) << 4) | css_hex_digit(str_byte(s, 2))
            g := (css_hex_digit(str_byte(s, 3)) << 4) | css_hex_digit(str_byte(s, 4))
            b := (css_hex_digit(str_byte(s, 5)) << 4) | css_hex_digit(str_byte(s, 6))
            a := (css_hex_digit(str_byte(s, 7)) << 4) | css_hex_digit(str_byte(s, 8))
            return (a << 24) | (r << 16) | (g << 8) | b
        }
    }

    if str_starts_with(s, "rgb(") or str_starts_with(s, "rgba(") {
        lp := str_find_byte(s, 40, 0)
        rp := str_find_byte(s, 41, lp + 1)
        if lp >= 0 and rp > lp {
            inner := str_slice(s, lp + 1, rp)
            c1 := str_find_byte(inner, 44, 0)
            c2 := if c1 >= 0 { str_find_byte(inner, 44, c1 + 1) } else { -1 }
            if c1 >= 0 and c2 > c1 {
                mut r := css_parse_px(str_slice(inner, 0, c1))
                mut g := css_parse_px(str_slice(inner, c1 + 1, c2))
                c3 := str_find_byte(inner, 44, c2 + 1)
                mut b := if c3 > c2 { css_parse_px(str_slice(inner, c2 + 1, c3)) } else { css_parse_px(str_slice(inner, c2 + 1, str_len(inner))) }
                mut a := 255
                if c3 > c2 {
                    astr := str_trim(str_slice(inner, c3 + 1, str_len(inner)))
                    if str_eq(astr, "0") or str_eq(astr, "0.0") { a = 0 }
                    else if str_starts_with(astr, "0.") and str_len(astr) >= 3 {
                        d1 := str_byte(astr, 2) - 48
                        d2 := if str_len(astr) >= 4 { str_byte(astr, 3) - 48 } else { 0 }
                        if d1 >= 0 and d1 <= 9 {
                            pct := d1 * 10 + (if d2 >= 0 and d2 <= 9 { d2 } else { 0 })
                            a = (pct * 255) / 100
                        }
                    } else if str_eq(astr, "1") or str_eq(astr, "1.0") { a = 255 }
                }
                if r < 0 { r = 0 } else if r > 255 { r = 255 }
                if g < 0 { g = 0 } else if g > 255 { g = 255 }
                if b < 0 { b = 0 } else if b > 255 { b = 255 }
                return (a << 24) | (r << 16) | (g << 8) | b
            }
        }
    }

    if str_eq(s, "black") { return 0xFF000000 }
    if str_eq(s, "white") { return 0xFFFFFFFF }
    if str_eq(s, "red") { return 0xFFFF0000 }
    if str_eq(s, "green") { return 0xFF00FF00 }
    if str_eq(s, "blue") { return 0xFF0000FF }
    if str_eq(s, "gray") or str_eq(s, "grey") { return 0xFF808080 }
    if str_eq(s, "yellow") { return 0xFFFFFF00 }
    if str_eq(s, "orange") { return 0xFFFFA500 }
    if str_eq(s, "purple") { return 0xFF800080 }
    if str_eq(s, "cyan") or str_eq(s, "aqua") { return 0xFF00FFFF }
    if str_eq(s, "pink") { return 0xFFFFC0CB }
    if str_eq(s, "teal") { return 0xFF008080 }
    if str_eq(s, "indigo") { return 0xFF4B0082 }
    if str_eq(s, "silver") { return 0xFFC0C0C0 }
    if str_eq(s, "navy") { return 0xFF000080 }
    if str_eq(s, "slate-900") { return 0xFF0F172A }
    if str_eq(s, "slate-800") { return 0xFF1E293B }
    if str_eq(s, "blue-500") { return 0xFF3B82F6 }

    return 0xFFFFFFFF
}

fn css_parse_px(val: str) -> i64 {
    s := str_trim(val)
    if str_eq(s, "auto") { return -1 }
    if str_eq(s, "100%") { return -1 }
    if str_eq(s, "0") { return 0 }
    
    mut n := str_len(s)
    if n == 0 { return 0 }
    mut is_pct := false
    mut is_rem := false
    if str_ends_with(s, "%") {
        n -= 1
        is_pct = true
    } else if str_ends_with(s, "px") {
        n -= 2
    } else if str_ends_with(s, "rem") {
        n -= 3
        is_rem = true
    } else if str_ends_with(s, "em") {
        n -= 2
        is_rem = true
    }
    mut v := 0
    mut frac := 0
    mut i := 0
    mut neg := false
    if i < n and str_byte(s, i) == 45 {
        neg = true
        i += 1
    } else if i < n and str_byte(s, i) == 43 {
        i += 1
    }
    while i < n {
        ch := str_byte(s, i)
        if ch >= 48 and ch <= 57 {
            if v < 100000000 { // Prevent i64 overflow DoS under --shield
                v = v * 10 + (ch - 48)
            }
        } else if ch == 46 and is_rem and i + 1 < n {
            d := str_byte(s, i + 1) - 48
            if d >= 0 and d <= 9 { frac = (d * 16) / 10 }
            break
        } else {
            break
        }
        i += 1
    }
    if is_pct {
        if neg or v <= 0 { return 0 }
        if v >= 100 { return -1 }
        return 0 - (1000 + v)
    }
    if is_rem { v = v * 16 + frac }
    if v > 100000 { v = 100000 }
    if neg {
        // Clamp negative px to > -1000 so it never collides with percentage sentinels `<= -1000`
        if v > 999 { v = 999 }
        return 0 - v
    }
    return v
}

fn css_apply_property(mut style: ComputedStyle, prop_name: str, prop_val: str) {
    p := str_trim(prop_name)
    v := str_trim(prop_val)

    if str_eq(p, "display") {
        if str_eq(v, "flex") { style.display = 1 }
        else if str_eq(v, "inline") or str_eq(v, "inline-block") { style.display = 2 }
        else if str_eq(v, "none") { style.display = 3 }
        else if str_eq(v, "grid") { style.display = 4; if style.grid_cols <= 0 { style.grid_cols = 1 } }
        else { style.display = 0 }
    } else if str_eq(p, "grid-template-columns") {
        if str_starts_with(v, "repeat(") {
            c1 := str_find_byte(v, 44, 7)
            if c1 > 7 {
                nc := css_parse_px(str_slice(v, 7, c1))
                if nc >= 1 and nc <= 12 { style.grid_cols = nc }
            }
        } else {
            mut tracks := 0
            mut ti := 0
            vn := str_len(v)
            while ti < vn {
                while ti < vn and (str_byte(v, ti) == 32 or str_byte(v, ti) == 9) { ti += 1 }
                if ti >= vn { break }
                tracks += 1
                while ti < vn and str_byte(v, ti) != 32 and str_byte(v, ti) != 9 { ti += 1 }
            }
            if tracks >= 1 and tracks <= 12 { style.grid_cols = tracks }
        }
    } else if str_eq(p, "flex-direction") {
        if str_eq(v, "column") { style.flex_direction = 1 }
        else { style.flex_direction = 0 }
    } else if str_eq(p, "flex-wrap") {
        style.flex_wrap = str_eq(v, "wrap")
    } else if str_eq(p, "flex") or str_eq(p, "flex-grow") {
        fg := css_parse_px(v)
        if fg > 0 { style.flex_grow = fg; if style.width == -1 { style.width = -2 } }
    } else if str_eq(p, "overflow") or str_eq(p, "overflow-x") or str_eq(p, "overflow-y") {
        if str_eq(v, "hidden") { style.overflow_hidden = true }
        else if str_eq(v, "auto") or str_eq(v, "scroll") { style.overflow_hidden = true; style.overflow_scroll = true }
    } else if str_eq(p, "font-family") {
        if str_contains(v, "mono") or str_contains(v, "Consolas") or str_contains(v, "Courier") or str_contains(v, "JetBrains") {
            style.font_mono = true
        }
    } else if str_eq(p, "position") {
        if str_eq(v, "absolute") { style.position = 1 }
        else if str_eq(v, "fixed") { style.position = 2 }
        else { style.position = 0 }
    } else if str_eq(p, "top") {
        style.pos_top = css_parse_px(v)
    } else if str_eq(p, "left") {
        style.pos_left = css_parse_px(v)
    } else if str_eq(p, "right") {
        style.pos_right = css_parse_px(v)
    } else if str_eq(p, "bottom") {
        style.pos_bottom = css_parse_px(v)
    } else if str_eq(p, "justify-content") {
        if str_eq(v, "center") { style.justify_content = 1 }
        else if str_eq(v, "flex-end") { style.justify_content = 2 }
        else if str_eq(v, "space-between") { style.justify_content = 3 }
        else if str_eq(v, "space-around") { style.justify_content = 4 }
        else { style.justify_content = 0 }
    } else if str_eq(p, "align-items") {
        if str_eq(v, "center") { style.align_items = 1 }
        else if str_eq(v, "flex-start") { style.align_items = 2 }
        else if str_eq(v, "flex-end") { style.align_items = 3 }
        else { style.align_items = 0 }
    } else if str_eq(p, "gap") {
        style.gap = css_parse_px(v)
    } else if str_eq(p, "width") {
        style.width = css_parse_px(v)
    } else if str_eq(p, "height") {
        if str_eq(v, "100%") or str_eq(v, "100vh") { style.height = -100 }
        else { style.height = css_parse_px(v) }
    } else if str_eq(p, "max-width") {
        mw := css_parse_px(v)
        if mw > 0 { style.max_width = mw }
    } else if str_eq(p, "padding") {
        sp := str_find_byte(v, 32, 0)
        if sp > 0 {
            py := css_parse_px(str_slice(v, 0, sp))
            px := css_parse_px(str_slice(v, sp + 1, str_len(v)))
            style.padding_y = py * 2
            style.padding_x = px * 2
        } else {
            px := css_parse_px(v)
            style.padding_x = px * 2
            style.padding_y = px * 2
        }
    } else if str_eq(p, "padding-left") or str_eq(p, "padding-right") {
        style.padding_x = css_parse_px(v) * 2
    } else if str_eq(p, "padding-top") or str_eq(p, "padding-bottom") {
        style.padding_y = css_parse_px(v) * 2
    } else if str_eq(p, "margin") {
        if str_contains(v, "auto") { style.margin_auto = true }
        sp := str_find_byte(v, 32, 0)
        if sp > 0 {
            my := css_parse_px(str_slice(v, 0, sp))
            mx := css_parse_px(str_slice(v, sp + 1, str_len(v)))
            if my >= 0 { style.margin_y = my * 2 }
            if mx >= 0 { style.margin_x = mx * 2 }
        } else {
            px := css_parse_px(v)
            if px >= 0 { style.margin_x = px * 2; style.margin_y = px * 2 }
        }
    } else if str_eq(p, "margin-left") or str_eq(p, "margin-right") {
        if str_eq(v, "auto") { style.margin_auto = true }
        else { style.margin_x = css_parse_px(v) * 2 }
    } else if str_eq(p, "margin-top") or str_eq(p, "margin-bottom") {
        style.margin_y = css_parse_px(v) * 2
    } else if str_eq(p, "background") or str_eq(p, "background-color") {
        if str_starts_with(v, "linear-gradient(") {
            lp := str_find_byte(v, 40, 0)
            rp := str_find_byte(v, 41, lp + 1)
            if lp >= 0 and rp > lp {
                inner := str_slice(v, lp + 1, rp)
                mut dir := 2
                if str_contains(inner, "to right") or str_contains(inner, "90deg") { dir = 1 }
                else if str_contains(inner, "135deg") or str_contains(inner, "bottom right") { dir = 3 }
                c1 := str_find_byte(inner, 44, 0)
                c2 := if c1 >= 0 { str_find_byte(inner, 44, c1 + 1) } else { -1 }
                if c1 >= 0 and c2 > c1 {
                    style.grad_dir = dir
                    style.grad_from = css_parse_color(str_slice(inner, c1 + 1, c2))
                    style.grad_to = css_parse_color(str_slice(inner, c2 + 1, str_len(inner)))
                } else if c1 >= 0 {
                    style.grad_dir = dir
                    style.grad_from = css_parse_color(str_slice(inner, 0, c1))
                    style.grad_to = css_parse_color(str_slice(inner, c1 + 1, str_len(inner)))
                }
            }
        } else {
            style.bg_color = css_parse_color(v)
        }
    } else if str_eq(p, "box-shadow") {
        if str_eq(v, "none") { style.shadow = 0 }
        else { style.shadow = 3 }
    } else if str_eq(p, "opacity") {
        if str_eq(v, "0") { style.opacity = 0 }
        else if str_eq(v, "1") { style.opacity = 100 }
        else if str_starts_with(v, "0.") and str_len(v) >= 3 {
            d := str_byte(v, 2) - 48
            if d >= 0 and d <= 9 { style.opacity = d * 10 }
        }
    } else if str_eq(p, "color") {
        style.text_color = css_parse_color(v)
        style.has_color = true
    } else if str_eq(p, "min-width") {
        mw := css_parse_px(v)
        if mw > 0 { style.min_width = mw }
    } else if str_eq(p, "min-height") {
        mh := css_parse_px(v)
        if mh > 0 { style.min_height = mh }
    } else if str_eq(p, "max-height") {
        mh := css_parse_px(v)
        if mh > 0 { style.max_height = mh }
    } else if str_eq(p, "flex-shrink") {
        style.flex_shrink = css_parse_px(v)
    } else if str_eq(p, "cursor") {
        if str_eq(v, "pointer") { style.cursor = 1 }
        else if str_eq(v, "text") { style.cursor = 2 }
        else { style.cursor = 0 }
    } else if str_eq(p, "line-height") {
        lh := css_parse_px(v)
        if lh > 0 { style.line_height = lh }
    } else if str_eq(p, "white-space") {
        if str_eq(v, "nowrap") { style.white_space = 1 }
        else if str_eq(v, "pre") or str_eq(v, "pre-wrap") { style.white_space = 2 }
        else { style.white_space = 0 }
    } else if str_eq(p, "font-style") {
        style.font_italic = str_eq(v, "italic")
    } else if str_eq(p, "text-decoration") {
        if str_contains(v, "underline") { style.text_decoration = 1 }
        else if str_contains(v, "line-through") { style.text_decoration = 2 }
        else { style.text_decoration = 0 }
    } else if str_eq(p, "z-index") {
        style.z_index = css_parse_px(v)
    } else if str_eq(p, "border-top") or str_eq(p, "border-right") or str_eq(p, "border-bottom") or str_eq(p, "border-left") {
        mut side_bit := 8
        if str_eq(p, "border-top") { side_bit = 1 }
        else if str_eq(p, "border-right") { side_bit = 2 }
        else if str_eq(p, "border-bottom") { side_bit = 4 }
        if str_eq(v, "none") or str_eq(v, "0") {
            style.border_sides = style.border_sides & (15 ^ side_bit)
        } else {
            style.border_sides = style.border_sides | side_bit
            mut bi := 0
            bn := str_len(v)
            while bi < bn {
                while bi < bn and (str_byte(v, bi) == 32 or str_byte(v, bi) == 9) { bi += 1 }
                mut bj := bi
                while bj < bn and str_byte(v, bj) != 32 and str_byte(v, bj) != 9 { bj += 1 }
                if bj > bi {
                    tok := str_slice(v, bi, bj)
                    ch0 := str_byte(tok, 0)
                    if ch0 >= 48 and ch0 <= 57 {
                        style.border_width = css_parse_px(tok)
                    } else if not str_eq(tok, "solid") and not str_eq(tok, "dashed") and not str_eq(tok, "dotted") {
                        style.border_color = css_parse_color(tok)
                    }
                }
                bi = bj + 1
            }
            if style.border_width == 0 { style.border_width = 1 }
        }
    } else if str_eq(p, "border") {
        if str_eq(v, "none") or str_eq(v, "0") {
            style.border_width = 0
        } else {
            mut bi := 0
            bn := str_len(v)
            while bi < bn {
                while bi < bn and (str_byte(v, bi) == 32 or str_byte(v, bi) == 9) { bi += 1 }
                mut bj := bi
                while bj < bn and str_byte(v, bj) != 32 and str_byte(v, bj) != 9 { bj += 1 }
                if bj > bi {
                    tok := str_slice(v, bi, bj)
                    ch0 := str_byte(tok, 0)
                    if ch0 >= 48 and ch0 <= 57 {
                        style.border_width = css_parse_px(tok)
                    } else if not str_eq(tok, "solid") and not str_eq(tok, "dashed") and not str_eq(tok, "dotted") {
                        style.border_color = css_parse_color(tok)
                    }
                }
                bi = bj + 1
            }
        }
    } else if str_eq(p, "border-width") {
        style.border_width = css_parse_px(v)
    } else if str_eq(p, "border-color") {
        style.border_color = css_parse_color(v)
    } else if str_eq(p, "border-radius") {
        style.border_radius = css_parse_px(v)
    } else if str_eq(p, "font-size") {
        fs := css_parse_px(v)
        if fs > 0 { style.font_size = fs }
    } else if str_eq(p, "font-weight") {
        if str_eq(v, "normal") or str_eq(v, "lighter") { style.font_weight = 400 }
        else if str_eq(v, "bold") or str_eq(v, "bolder") { style.font_weight = 700 }
        else {
            w := css_parse_px(v)
            if w >= 100 and w <= 900 { style.font_weight = w }
        }
    } else if str_eq(p, "text-align") {
        if str_eq(v, "center") { style.text_align = 1 }
        else if str_eq(v, "right") or str_eq(v, "end") { style.text_align = 2 }
        else { style.text_align = 0 }
    } else if str_eq(p, "text-transform") {
        if str_eq(v, "uppercase") { style.text_transform = 1 }
        else if str_eq(v, "lowercase") { style.text_transform = 2 }
        else { style.text_transform = 0 }
    }
}

fn css_strip_comments(css: str) -> str {
    n := str_len(css)
    if str_find(css, "/*", 0) < 0 { return css }
    out := buf_new(n + 1)
    mut i := 0
    while i < n {
        if i + 1 < n and str_byte(css, i) == 47 and str_byte(css, i + 1) == 42 {
            end_c := str_find(css, "*/", i + 2)
            if end_c < 0 { break }
            i = end_c + 2
        } else {
            buf_push(out, str_byte(css, i))
            i += 1
        }
    }
    return buf_to_owned_str(move out)
}

fn css_parse_inline(mut style: ComputedStyle, inline_str: str) {
    clean := css_strip_comments(inline_str)
    n := str_len(clean)
    if n == 0 { return }

    mut cur := 0
    while cur < n {
        mut semi := str_find_byte(clean, 59, cur) // ';'
        if semi < 0 { semi = n }
        decl := str_slice(clean, cur, semi)
        
        colon := str_find_byte(decl, 58, 0) // ':'
        if colon >= 0 {
            prop := str_slice(decl, 0, colon)
            val := str_slice(decl, colon + 1, str_len(decl))
            css_apply_property(mut style, prop, val)
        }

        cur = semi + 1
    }
}

struct Stylesheet {
    css_text: str
    rules: IntBuf
    rule_count: i64
    vars: IntBuf       // 4 ints per CSS custom property: [name_st, name_len, val_st, val_len]
    var_count: i64
    viewport_w: i64
}

fn _css_lookup_var(sheet: Stylesheet, vname: str) -> str {
    mut i := sheet.var_count - 1
    while i >= 0 {
        b := i * 4
        ns := ibuf_get(sheet.vars, b)
        nl := ibuf_get(sheet.vars, b + 1)
        if nl == str_len(vname) and str_eq(str_slice(sheet.css_text, ns, ns + nl), vname) {
            vs := ibuf_get(sheet.vars, b + 2)
            vl := ibuf_get(sheet.vars, b + 3)
            return str_trim(str_slice(sheet.css_text, vs, vs + vl))
        }
        i -= 1
    }
    return ""
}

// Resolves all `var(--name[, fallback])` occurrences anywhere inside a CSS property value (bounds-safe!)
fn css_resolve_var(sheet: Stylesheet, raw_val: str) -> str {
    if str_find(raw_val, "var(", 0) < 0 { return raw_val }
    n := str_len(raw_val)
    mut out_cap := n * 2 + 256
    if out_cap < 4096 { out_cap = 4096 }
    if out_cap > 16384 { out_cap = 16384 }
    out := buf_new(out_cap)
    mut p := 0
    mut guard := 0
    while p < n and guard < 16 {
        guard += 1
        vp := str_find(raw_val, "var(", p)
        if vp < 0 {
            rem := str_slice(raw_val, p, n)
            if buf_len(out) + str_len(rem) <= out_cap { buf_push_str(out, rem) }
            break
        }
        if vp > p {
            pre := str_slice(raw_val, p, vp)
            if buf_len(out) + str_len(pre) <= out_cap { buf_push_str(out, pre) }
        }
        rp := str_find_byte(raw_val, 41, vp + 4)
        if rp <= vp + 4 {
            tail := str_slice(raw_val, vp, n)
            if buf_len(out) + str_len(tail) <= out_cap { buf_push_str(out, tail) }
            break
        }
        inner := str_slice(raw_val, vp + 4, rp)
        comma := str_find_byte(inner, 44, 0)
        vname := str_trim(if comma >= 0 { str_slice(inner, 0, comma) } else { inner })
        fallback := if comma >= 0 { str_trim(str_slice(inner, comma + 1, str_len(inner))) } else { "" }
        resolved := _css_lookup_var(sheet, vname)
        if str_len(resolved) > 0 {
            if buf_len(out) + str_len(resolved) <= out_cap { buf_push_str(out, resolved) }
        } else if str_len(fallback) > 0 {
            if buf_len(out) + str_len(fallback) <= out_cap { buf_push_str(out, fallback) }
        }
        p = rp + 1
    }
    return buf_to_owned_str(move out)
}

fn css_parse_inline_with_vars(mut style: ComputedStyle, inline_str: str, sheet: Stylesheet) {
    clean := css_strip_comments(inline_str)
    n := str_len(clean)
    if n == 0 { return }
    mut cur := 0
    while cur < n {
        mut semi := str_find_byte(clean, 59, cur)
        if semi < 0 { semi = n }
        decl := str_slice(clean, cur, semi)
        colon := str_find_byte(decl, 58, 0)
        if colon >= 0 {
            prop := str_slice(decl, 0, colon)
            val := css_resolve_var(sheet, str_slice(decl, colon + 1, str_len(decl)))
            css_apply_property(mut style, prop, val)
        }
        cur = semi + 1
    }
}

fn _css_parse_media_bound(header: str, key: str) -> i64 {
    idx := str_find(header, key, 0)
    if idx < 0 { return -1 }
    col := str_find_byte(header, 58, idx) // ':'
    if col < 0 { return -1 }
    mut p := col + 1
    hn := str_len(header)
    while p < hn and (str_byte(header, p) == 32 or str_byte(header, p) == 9) { p += 1 }
    mut end := p
    while end < hn and str_byte(header, end) != 41 and str_byte(header, end) != 32 and str_byte(header, end) != 123 { end += 1 }
    val_str := str_slice(header, p, end)
    px := css_parse_px(val_str)
    return px
}

fn css_parse_stylesheet(css: str) -> Stylesheet {
    clean := css_strip_comments(css)
    n := str_len(clean)
    rb := ibuf_new(3072)
    vb := ibuf_new(512)
    mut count := 0
    mut vcount := 0
    mut p := 0

    while p < n and count < 512 {
        while p < n and (str_byte(clean, p) == 32 or str_byte(clean, p) == 9 or str_byte(clean, p) == 10 or str_byte(clean, p) == 13) { p += 1 }
        if p >= n { break }

        // --- Responsive CSS @media queries: @media (min-width: Xpx) / (max-width: Ypx) ---
        if p + 6 < n and str_starts_with(str_slice(clean, p, n), "@media") {
            media_open := str_find_byte(clean, 123, p) // '{'
            if media_open < 0 { break }
            media_header := str_slice(clean, p, media_open)
            mut min_w := _css_parse_media_bound(media_header, "min-width")
            if min_w < 0 { min_w = 0 }
            mut max_w := _css_parse_media_bound(media_header, "max-width")
            if max_w < 0 { max_w = 999999 }

            // Find matching closing brace for the outer @media block
            mut depth := 1
            mut k := media_open + 1
            while k < n and depth > 0 {
                b := str_byte(clean, k)
                if b == 123 { depth += 1 }
                else if b == 125 { depth -= 1 }
                k += 1
            }
            media_close := k - 1

            // Parse inner rules inside @media block
            mut mp := media_open + 1
            while mp < media_close and count < 512 {
                while mp < media_close and (str_byte(clean, mp) == 32 or str_byte(clean, mp) == 9 or str_byte(clean, mp) == 10 or str_byte(clean, mp) == 13) { mp += 1 }
                if mp >= media_close { break }
                in_open := str_find_byte(clean, 123, mp)
                if in_open < 0 or in_open >= media_close { break }
                in_close := str_find_byte(clean, 125, in_open + 1)
                if in_close < 0 or in_close > media_close { break }

                ibuf_push(rb, mp)
                ibuf_push(rb, in_open - mp)
                ibuf_push(rb, in_open + 1)
                ibuf_push(rb, in_close - in_open - 1)
                ibuf_push(rb, min_w)
                ibuf_push(rb, max_w)
                count += 1
                mp = in_close + 1
            }
            p = media_close + 1
            continue
        }

        brace_open := str_find_byte(clean, 123, p)
        if brace_open < 0 { break }

        brace_close := str_find_byte(clean, 125, brace_open + 1)
        if brace_close < 0 { break }

        sel_st := p
        sel_l := brace_open - p
        body_st := brace_open + 1
        body_l := brace_close - body_st

        // Extract CSS custom properties (`--name: value;`) from `:root` or any rule block
        mut vp := body_st
        body_end := brace_close
        while vp < body_end and vcount < 128 {
            mut semi := str_find_byte(clean, 59, vp)
            if semi < 0 or semi > body_end { semi = body_end }
            mut ks := vp
            while ks < semi and (str_byte(clean, ks) == 32 or str_byte(clean, ks) == 9 or str_byte(clean, ks) == 10 or str_byte(clean, ks) == 13) { ks += 1 }
            if ks + 2 < semi and str_byte(clean, ks) == 45 and str_byte(clean, ks + 1) == 45 {
                col := str_find_byte(clean, 58, ks)
                if col > ks and col < semi {
                    mut ke := col
                    while ke > ks and (str_byte(clean, ke - 1) == 32 or str_byte(clean, ke - 1) == 9) { ke -= 1 }
                    mut vs := col + 1
                    while vs < semi and (str_byte(clean, vs) == 32 or str_byte(clean, vs) == 9) { vs += 1 }
                    mut ve := semi
                    while ve > vs and (str_byte(clean, ve - 1) == 32 or str_byte(clean, ve - 1) == 9 or str_byte(clean, ve - 1) == 10 or str_byte(clean, ve - 1) == 13) { ve -= 1 }
                    if ke > ks and ve > vs {
                        ibuf_push(vb, ks); ibuf_push(vb, ke - ks)
                        ibuf_push(vb, vs); ibuf_push(vb, ve - vs)
                        vcount += 1
                    }
                }
            }
            vp = semi + 1
        }

        ibuf_push(rb, sel_st)
        ibuf_push(rb, sel_l)
        ibuf_push(rb, body_st)
        ibuf_push(rb, body_l)
        ibuf_push(rb, 0)
        ibuf_push(rb, 999999)
        count += 1

        p = brace_close + 1
    }

    return Stylesheet(css_text = clean, rules = rb, rule_count = count, vars = vb, var_count = vcount, viewport_w = 1280)
}

fn css_has_class_token(cls_list: str, target_cls: str) -> bool {
    tn := str_len(target_cls)
    ln := str_len(cls_list)
    if tn == 0 or ln == 0 { return false }
    mut i := 0
    while i < ln {
        while i < ln and (str_byte(cls_list, i) == 32 or str_byte(cls_list, i) == 9 or str_byte(cls_list, i) == 10 or str_byte(cls_list, i) == 13) {
            i += 1
        }
        mut j := i
        while j < ln and str_byte(cls_list, j) != 32 and str_byte(cls_list, j) != 9 and str_byte(cls_list, j) != 10 and str_byte(cls_list, j) != 13 {
            j += 1
        }
        if j - i == tn and str_eq(str_slice(cls_list, i, j), target_cls) {
            return true
        }
        i = j + 1
    }
    return false
}

// Matches a single compound selector like `div`, `.card`, `#id`, `div.card`, `button#go.primary`
fn _css_compound_matches(tree: DomTree, node_idx: i64, sel: str) -> bool {
    s := str_trim(sel)
    sn := str_len(s)
    if sn == 0 { return false }
    if str_eq(s, "*") { return true }

    mut i := 0
    while i < sn {
        b := str_byte(s, i)
        if b == 35 { // #id
            mut j := i + 1
            while j < sn and str_byte(s, j) != 46 and str_byte(s, j) != 35 { j += 1 }
            if not str_eq(dom_get_id(tree, node_idx), str_slice(s, i + 1, j)) { return false }
            i = j
        } else if b == 46 { // .class
            mut j := i + 1
            while j < sn and str_byte(s, j) != 46 and str_byte(s, j) != 35 { j += 1 }
            if not css_has_class_token(dom_get_class(tree, node_idx), str_slice(s, i + 1, j)) { return false }
            i = j
        } else { // tag
            mut j := i
            while j < sn and str_byte(s, j) != 46 and str_byte(s, j) != 35 { j += 1 }
            if not str_eq_ignore_case(dom_get_tag(tree, node_idx), str_slice(s, i, j)) { return false }
            i = j
        }
    }
    return true
}

// Supports compound selectors (`div.card`), direct child (`>`), and descendant combinators with shared step budget (anti-ReDoS!)
fn _css_single_sel_rec(tree: DomTree, node_idx: i64, sel: str, depth: i64, budget: IntBuf) -> bool {
    if depth > 10 { return false }
    rem := ibuf_get(budget, 0)
    if rem <= 0 { return false }
    ibuf_set(budget, 0, rem - 1)
    s := str_trim(sel)
    sn := str_len(s)
    if sn == 0 { return false }

    mut last_sp := -1
    mut is_child_comb := false
    mut k := sn - 1
    while k >= 0 {
        ch := str_byte(s, k)
        if ch == 62 { // '>'
            last_sp = k
            is_child_comb = true
            break
        }
        if ch == 32 or ch == 9 {
            last_sp = k
            break
        }
        k -= 1
    }
    if last_sp < 0 {
        return _css_compound_matches(tree, node_idx, s)
    }

    right := str_trim(str_slice(s, last_sp + 1, sn))
    if str_len(right) == 0 or not _css_compound_matches(tree, node_idx, right) { return false }
    mut left := str_trim(str_slice(s, 0, last_sp))
    if not is_child_comb and str_ends_with(left, ">") {
        is_child_comb = true
        left = str_trim(str_slice(left, 0, str_len(left) - 1))
    }
    if is_child_comb {
        p_idx := dom_parent(tree, node_idx)
        if p_idx < 0 { return false }
        return _css_single_sel_rec(tree, p_idx, left, depth + 1, budget)
    }
    mut anc := dom_parent(tree, node_idx)
    mut steps := 0
    while anc >= 0 and steps < 24 and ibuf_get(budget, 0) > 0 {
        if _css_single_sel_rec(tree, anc, left, depth + 1, budget) { return true }
        anc = dom_parent(tree, anc)
        steps += 1
    }
    return false
}

fn css_single_selector_matches(tree: DomTree, node_idx: i64, sel: str) -> bool {
    budget := ibuf_new(2)
    ibuf_push(budget, 64)
    res := _css_single_sel_rec(tree, node_idx, sel, 0, budget)
    buf_free(move budget)
    return res
}

fn css_selector_matches(tree: DomTree, node_idx: i64, sel: str) -> bool {
    sn := str_len(sel)
    mut p := 0
    while p < sn {
        mut comma := str_find_byte(sel, 44, p)
        if comma < 0 { comma = sn }
        part := str_slice(sel, p, comma)
        if css_single_selector_matches(tree, node_idx, part) {
            return true
        }
        p = comma + 1
    }
    return false
}

fn _css_compute_own_style(tree: DomTree, node_idx: i64, sheet: Stylesheet, is_hovered: bool, is_focused: bool, is_active: bool) -> ComputedStyle {
    mut style := style_default()

    tag := dom_get_tag(tree, node_idx)
    if str_len(tag) == 0 {
        style.display = 2
        return style
    }
    if str_eq_ignore_case(tag, "head") or str_eq_ignore_case(tag, "title") or str_eq_ignore_case(tag, "meta") or str_eq_ignore_case(tag, "link") or str_eq_ignore_case(tag, "style") or str_eq_ignore_case(tag, "script") {
        style.display = 3
        return style
    }
    if str_eq_ignore_case(tag, "span") or str_eq_ignore_case(tag, "strong") or str_eq_ignore_case(tag, "b") or str_eq_ignore_case(tag, "em") or str_eq_ignore_case(tag, "code") or str_eq_ignore_case(tag, "a") {
        style.display = 2
    }
    if str_eq_ignore_case(tag, "code") or str_eq_ignore_case(tag, "pre") {
        style.font_mono = true
        if str_eq_ignore_case(tag, "pre") { style.white_space = 2 }
    }
    if str_eq_ignore_case(tag, "button") or str_eq_ignore_case(tag, "a") {
        style.cursor = 1
    }
    if str_eq_ignore_case(tag, "button") {
        style.padding_x = 24
        style.padding_y = 14
        style.border_radius = 8
        style.bg_color = 0xFF2563EB
        style.text_color = 0xFFFFFFFF
        style.has_color = true
        style.font_size = 14
        style.font_weight = 600
        style.text_align = 1
    } else if str_eq_ignore_case(tag, "input") or str_eq_ignore_case(tag, "textarea") {
        style.padding_x = 20
        style.padding_y = 12
        style.border_radius = 8
        style.bg_color = 0xFF0E0E12
        style.border_width = 1
        style.border_color = 0xFF272730
        style.text_color = 0xFFF4F4F5
        style.has_color = true
        style.font_size = 14
        style.cursor = 2
    } else if str_eq_ignore_case(tag, "hr") {
        style.height = 1
        style.bg_color = 0xFF272730
        style.margin_y = 12
    } else if str_eq_ignore_case(tag, "h1") {
        style.font_size = 24
        style.font_weight = 700
    } else if str_eq_ignore_case(tag, "h2") {
        style.font_size = 18
        style.font_weight = 600
    } else if str_eq_ignore_case(tag, "h3") or str_eq_ignore_case(tag, "strong") or str_eq_ignore_case(tag, "b") {
        style.font_size = 15
        style.font_weight = 600
    } else if str_eq_ignore_case(tag, "circle") {
        style.border_radius = 9999
    }

    // 2. Apply Tailwind & Bootstrap utilities from class attribute (responsive with viewport_w)
    cls_str := dom_get_class(tree, node_idx)
    if str_len(cls_str) > 0 {
        tw_apply_classes(mut style, cls_str, sheet.viewport_w)
    }

    // 3. Apply Stylesheet rules (including responsive @media boundaries and :hover/:focus/:active!)
    mut r := 0
    while r < sheet.rule_count {
        sel_st := ibuf_get(sheet.rules, r * 6)
        sel_l := ibuf_get(sheet.rules, r * 6 + 1)
        body_st := ibuf_get(sheet.rules, r * 6 + 2)
        body_l := ibuf_get(sheet.rules, r * 6 + 3)
        min_w := ibuf_get(sheet.rules, r * 6 + 4)
        max_w := ibuf_get(sheet.rules, r * 6 + 5)

        if sheet.viewport_w > 0 {
            if sheet.viewport_w < min_w or sheet.viewport_w > max_w {
                r += 1
                continue
            }
        }

        sel_str := str_trim(str_slice(sheet.css_text, sel_st, sel_st + sel_l))
        if str_ends_with(sel_str, ":hover") {
            if is_hovered {
                base_sel := str_slice(sel_str, 0, str_len(sel_str) - 6)
                if css_selector_matches(tree, node_idx, base_sel) {
                    body_str := str_slice(sheet.css_text, body_st, body_st + body_l)
                    css_parse_inline_with_vars(mut style, body_str, sheet)
                }
            }
        } else if str_ends_with(sel_str, ":focus") {
            if is_focused {
                base_sel := str_slice(sel_str, 0, str_len(sel_str) - 6)
                if css_selector_matches(tree, node_idx, base_sel) {
                    body_str := str_slice(sheet.css_text, body_st, body_st + body_l)
                    css_parse_inline_with_vars(mut style, body_str, sheet)
                }
            }
        } else if str_ends_with(sel_str, ":active") {
            if is_active {
                base_sel := str_slice(sel_str, 0, str_len(sel_str) - 7)
                if css_selector_matches(tree, node_idx, base_sel) {
                    body_str := str_slice(sheet.css_text, body_st, body_st + body_l)
                    css_parse_inline_with_vars(mut style, body_str, sheet)
                }
            }
        } else if css_selector_matches(tree, node_idx, sel_str) {
            body_str := str_slice(sheet.css_text, body_st, body_st + body_l)
            css_parse_inline_with_vars(mut style, body_str, sheet)
        }
        r += 1
    }

    // 4. Apply Tailwind `hover:*`, `focus:*`, `active:*` interactive state overrides
    if is_hovered {
        if style.hover_bg != 0 { style.bg_color = style.hover_bg }
        if style.hover_border != 0 { style.border_color = style.hover_border }
        if style.hover_text != 0 { style.text_color = style.hover_text; style.has_color = true }
    }
    if is_focused {
        if style.focus_border != 0 {
            style.border_color = style.focus_border
            if style.border_width == 0 { style.border_width = 1 }
        }
        if style.focus_bg != 0 { style.bg_color = style.focus_bg }
    }
    if is_active and style.active_bg != 0 {
        style.bg_color = style.active_bg
    }

    inline_s := dom_get_style(tree, node_idx)
    if str_len(inline_s) > 0 {
        css_parse_inline_with_vars(mut style, inline_s, sheet)
    }

    return style
}

// Full CSS Cascade + True Ancestor Inheritance (color, font-size, font-weight, font-mono, text-align, text-transform, cursor, white-space)
fn css_compute_node_style_full(tree: DomTree, node_idx: i64, sheet: Stylesheet, is_hovered: bool, is_focused: bool, is_active: bool) -> ComputedStyle {
    mut style := _css_compute_own_style(tree, node_idx, sheet, is_hovered, is_focused, is_active)
    if style.display == 3 { return style }

    // Inherit unspecified typography/color/cursor properties from nearest defining ancestor (up to 8 levels)
    mut need_color := not style.has_color
    mut need_fs := style.font_size == 0
    mut need_fw := style.font_weight == 0
    mut need_mono := not style.font_mono
    mut need_align := style.text_align == 0
    mut need_xform := style.text_transform == 0
    mut need_cursor := style.cursor == 0
    mut need_ws := style.white_space == 0

    mut anc := dom_parent(tree, node_idx)
    mut hops := 0
    while anc >= 0 and hops < 8 and (need_color or need_fs or need_fw or need_mono or need_align or need_xform or need_cursor or need_ws) {
        ast := _css_compute_own_style(tree, anc, sheet, false, false, false)
        if need_color and ast.has_color { style.text_color = ast.text_color; style.has_color = true; need_color = false }
        if need_fs and ast.font_size > 0 { style.font_size = ast.font_size; need_fs = false }
        if need_fw and ast.font_weight > 0 { style.font_weight = ast.font_weight; need_fw = false }
        if need_mono and ast.font_mono { style.font_mono = true; need_mono = false }
        if need_align and ast.text_align != 0 { style.text_align = ast.text_align; need_align = false }
        if need_xform and ast.text_transform != 0 { style.text_transform = ast.text_transform; need_xform = false }
        if need_cursor and ast.cursor != 0 { style.cursor = ast.cursor; need_cursor = false }
        if need_ws and ast.white_space != 0 { style.white_space = ast.white_space; need_ws = false }
        anc = dom_parent(tree, anc)
        hops += 1
    }

    if not style.has_color and str_len(dom_get_tag(tree, node_idx)) == 0 {
        style.text_color = 0xFFCBD5E1
    }
    return style
}

fn css_compute_node_style_state(tree: DomTree, node_idx: i64, sheet: Stylesheet, is_hovered: bool) -> ComputedStyle {
    return css_compute_node_style_full(tree, node_idx, sheet, is_hovered, false, false)
}

fn css_compute_node_style(tree: DomTree, node_idx: i64, sheet: Stylesheet) -> ComputedStyle {
    return css_compute_node_style_full(tree, node_idx, sheet, false, false, false)
}
