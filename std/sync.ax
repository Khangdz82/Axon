// Axon Production Synchronization & Concurrency Primitives (`std/sync.ax`)
// 100% Pure Axon: hardware `LOCK CMPXCHG`, `LOCK XADD`, TSO acquire/release, and `PAUSE`.
// Provides `AtomicI64`, `SpinLock`, `RwLock`, `WaitGroup`, and bounded thread-safe `MpmcChan`.

// --- 1. AtomicI64 (cache-line padded to avoid false sharing) ---
struct AtomicI64 {
    ptr: i64
}

fn atomic_i64_new(init: i64) -> AtomicI64 {
    p := unsafe { mem_alloc_aligned(64) }
    atomic_store_i64(p, 0, init)
    return AtomicI64(p)
}

fn atomic_i64_load(a: AtomicI64) -> i64 {
    return atomic_load_i64(a.ptr, 0)
}

fn atomic_i64_store(a: AtomicI64, val: i64) {
    atomic_store_i64(a.ptr, 0, val)
}

fn atomic_i64_add(a: AtomicI64, delta: i64) -> i64 {
    return atomic_add_i64(a.ptr, 0, delta)
}

fn atomic_i64_sub(a: AtomicI64, delta: i64) -> i64 {
    return atomic_add_i64(a.ptr, 0, 0 - delta)
}

fn atomic_i64_cas(a: AtomicI64, expected: i64, desired: i64) -> bool {
    return atomic_cas_i64(a.ptr, 0, expected, desired) == expected
}

fn atomic_i64_free(move a: AtomicI64) {
    if a.ptr != 0 {
        unsafe { mem_free_aligned(a.ptr) }
    }
}

// --- 2. SpinLock (TTAS + hardware PAUSE backoff) ---
struct SpinLock {
    ptr: i64
}

fn spinlock_new() -> SpinLock {
    p := unsafe { mem_alloc_aligned(64) }
    atomic_store_i64(p, 0, 0)
    return SpinLock(p)
}

fn spinlock_try_lock(m: SpinLock) -> bool {
    return atomic_cas_i64(m.ptr, 0, 0, 1) == 0
}

fn spinlock_lock(m: SpinLock) {
    mut spins := 0
    while true {
        if atomic_load_i64(m.ptr, 0) == 0 {
            if atomic_cas_i64(m.ptr, 0, 0, 1) == 0 {
                return
            }
        }
        cpu_pause()
        spins += 1
        if spins >= 1024 {
            sleep_ms(0)
            spins = 0
        }
    }
}

fn spinlock_unlock(m: SpinLock) {
    atomic_store_rel_i64(m.ptr, 0, 0)
}

fn spinlock_free(move m: SpinLock) {
    if m.ptr != 0 {
        unsafe { mem_free_aligned(m.ptr) }
    }
}

// --- 3. RwLock (state: 0=free, >0=reader count, -1=exclusive writer) ---
struct RwLock {
    ptr: i64
}

fn rwlock_new() -> RwLock {
    p := unsafe { mem_alloc_aligned(64) }
    atomic_store_i64(p, 0, 0)
    return RwLock(p)
}

fn rwlock_read_lock(rw: RwLock) {
    while true {
        st := atomic_load_i64(rw.ptr, 0)
        if st >= 0 {
            if atomic_cas_i64(rw.ptr, 0, st, st + 1) == st {
                return
            }
        }
        cpu_pause()
    }
}

fn rwlock_read_unlock(rw: RwLock) {
    _ := atomic_add_i64(rw.ptr, 0, -1)
}

fn rwlock_write_lock(rw: RwLock) {
    while true {
        if atomic_load_i64(rw.ptr, 0) == 0 {
            if atomic_cas_i64(rw.ptr, 0, 0, -1) == 0 {
                return
            }
        }
        cpu_pause()
    }
}

fn rwlock_write_unlock(rw: RwLock) {
    atomic_store_rel_i64(rw.ptr, 0, 0)
}

fn rwlock_free(move rw: RwLock) {
    if rw.ptr != 0 {
        unsafe { mem_free_aligned(rw.ptr) }
    }
}

// --- 4. WaitGroup (Go-style task barrier) ---
struct WaitGroup {
    ptr: i64
}

fn wg_new() -> WaitGroup {
    p := unsafe { mem_alloc_aligned(64) }
    atomic_store_i64(p, 0, 0)
    return WaitGroup(p)
}

fn wg_add(wg: WaitGroup, delta: i64) {
    _ := atomic_add_i64(wg.ptr, 0, delta)
}

fn wg_done(wg: WaitGroup) {
    _ := atomic_add_i64(wg.ptr, 0, -1)
}

fn wg_count(wg: WaitGroup) -> i64 {
    return atomic_load_i64(wg.ptr, 0)
}

fn wg_wait(wg: WaitGroup) {
    mut spins := 0
    while atomic_load_i64(wg.ptr, 0) > 0 {
        cpu_pause()
        spins += 1
        if spins >= 1024 {
            sleep_ms(0)
            spins = 0
        }
    }
}

fn wg_free(move wg: WaitGroup) {
    if wg.ptr != 0 {
        unsafe { mem_free_aligned(wg.ptr) }
    }
}

// --- 5. MpmcChan (Thread-safe bounded Go-style i64 channel) ---
// Header layout (`meta` 64B): [0]=lock, [1]=head, [2]=tail, [3]=count, [4]=cap, [5]=closed
struct MpmcChan {
    meta: i64
    data: i64
}

fn chan_new(cap: i64) -> MpmcChan {
    mut c := cap
    if c < 1 { c = 1 }
    meta := unsafe { mem_alloc_aligned(64) }
    data := unsafe { mem_alloc_aligned(c * 8 + 64) }
    atomic_store_i64(meta, 0, 0)
    atomic_store_i64(meta, 1, 0)
    atomic_store_i64(meta, 2, 0)
    atomic_store_i64(meta, 3, 0)
    atomic_store_i64(meta, 4, c)
    atomic_store_i64(meta, 5, 0)
    return MpmcChan(meta, data)
}

fn chan_lock_meta(meta: i64) {
    while atomic_cas_i64(meta, 0, 0, 1) != 0 {
        cpu_pause()
    }
}

fn chan_unlock_meta(meta: i64) {
    atomic_store_rel_i64(meta, 0, 0)
}

fn chan_try_send(ch: MpmcChan, val: i64) -> bool {
    chan_lock_meta(ch.meta)
    closed := atomic_load_i64(ch.meta, 5)
    cnt := atomic_load_i64(ch.meta, 3)
    cap := atomic_load_i64(ch.meta, 4)
    if closed != 0 or cnt >= cap {
        chan_unlock_meta(ch.meta)
        return false
    }
    tail := atomic_load_i64(ch.meta, 2)
    unsafe { ptr_write_i64(ch.data, tail, val) }
    mut next_tail := tail + 1
    if next_tail >= cap { next_tail = 0 }
    atomic_store_rel_i64(ch.meta, 2, next_tail)
    atomic_store_rel_i64(ch.meta, 3, cnt + 1)
    chan_unlock_meta(ch.meta)
    return true
}

fn chan_try_recv(ch: MpmcChan) -> i64 ! i64 {
    chan_lock_meta(ch.meta)
    cnt := atomic_load_i64(ch.meta, 3)
    if cnt <= 0 {
        closed := atomic_load_i64(ch.meta, 5)
        chan_unlock_meta(ch.meta)
        if closed != 0 { return err(-2) }
        return err(-1)
    }
    head := atomic_load_i64(ch.meta, 1)
    cap := atomic_load_i64(ch.meta, 4)
    val := unsafe { ptr_read_i64(ch.data, head) }
    mut next_head := head + 1
    if next_head >= cap { next_head = 0 }
    atomic_store_rel_i64(ch.meta, 1, next_head)
    atomic_store_rel_i64(ch.meta, 3, cnt - 1)
    chan_unlock_meta(ch.meta)
    return ok(val)
}

fn chan_len(ch: MpmcChan) -> i64 {
    return atomic_load_i64(ch.meta, 3)
}

fn chan_close(ch: MpmcChan) {
    atomic_store_i64(ch.meta, 5, 1)
}

fn chan_is_closed(ch: MpmcChan) -> bool {
    return atomic_load_i64(ch.meta, 5) != 0
}

fn chan_free(move ch: MpmcChan) {
    if ch.data != 0 { unsafe { mem_free_aligned(ch.data) } }
    if ch.meta != 0 { unsafe { mem_free_aligned(ch.meta) } }
}
