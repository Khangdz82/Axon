// Axon Standard Library: Colorless Concurrency & Chase-Lev Work-Stealing
struct FiberTask {
    task_id: i32,
    fn_ptr: i32,
    ctx_ptr: i32,
    status: i32,
}

struct WorkStealingDeque {
    top: i32,
    bottom: i32,
    capacity: i32,
    mask: i32,
}

struct FiberChannel {
    head: i32,
    tail: i32,
    capacity: i32,
}

fn deque_create(cap: i32) -> WorkStealingDeque {
    let mask = cap - 1;
    return WorkStealingDeque(0, 0, cap, mask);
}

fn deque_push(mut q: WorkStealingDeque, task_id: i32) -> i32 {
    let b = q.bottom;
    q.bottom = b + 1;
    return 1;
}

fn deque_pop(mut q: WorkStealingDeque) -> i32 {
    let b = q.bottom - 1;
    q.bottom = b;
    let t = q.top;
    if t <= b {
        return b;
    }
    q.bottom = t;
    return -1;
}

fn deque_steal(mut q: WorkStealingDeque) -> i32 {
    let t = q.top;
    let b = q.bottom;
    if t < b {
        q.top = t + 1;
        return t;
    }
    return -1;
}
