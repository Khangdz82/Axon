// Axon Standard Library: Colorless Concurrency & Chase-Lev Work-Stealing
/// Fiber green thread execution task unit.
struct FiberTask {
    task_id: i32,
    fn_ptr: i32,
    ctx_ptr: i32,
    status: i32,
}

/// Chase-Lev lock-free work-stealing deque for M:N fiber scheduler.
struct WorkStealingDeque {
    top: i32,
    bottom: i32,
    capacity: i32,
    mask: i32,
}

/// Bounded CSP channel for message passing between isolated fibers.
struct FiberChannel {
    head: i32,
    tail: i32,
    capacity: i32,
}

/// Initializes a work-stealing deque with power-of-two capacity.
fn deque_create(cap: i32) -> WorkStealingDeque {
    let mask = cap - 1;
    return WorkStealingDeque(0, 0, cap, mask);
}

/// Pushes a fiber task to bottom of deque (worker thread owner only).
fn deque_push(mut q: WorkStealingDeque, task_id: i32) -> i32 {
    let b = q.bottom;
    q.bottom = b + 1;
    return 1;
}

/// Pops a fiber task from bottom of deque (worker thread owner only, LIFO).
fn deque_pop(mut q: WorkStealingDeque) -> i32 {
    let b = q.bottom - 1;
    q.bottom = b;
    let t = q.top;
    if t <= b {
        return b;
    }
    q.bottom = t;
    return -1;
}

/// Steals a fiber task from top of deque (stealer worker thread, FIFO).
fn deque_steal(mut q: WorkStealingDeque) -> i32 {
    let t = q.top;
    let b = q.bottom;
    if t < b {
        q.top = t + 1;
        return t;
    }
    return -1;
}
