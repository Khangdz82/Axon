// Axon v7.0 3D Game Engine SIMD Math & FrameArena Library (`std/math3d.ax`)
// Hardware SSE/AVX `vec3`, `vec4`, `quat`, `mat4` value types + 1-cycle O(1) `FrameArena` bump allocator.

struct FrameArena {
    base_ptr: i64
    cap_bytes: i64
    state_ptr: i64
}

fn frame_arena_new(cap_bytes: i64) -> FrameArena {
    unsafe {
    mut cap := cap_bytes
    if cap < 4096 {
        cap = 4096
    }
    base := mem_alloc_aligned(cap)
    st := mem_alloc_aligned(64)
    ptr_write_i64(st, 0, 0)
    return FrameArena(base_ptr = base, cap_bytes = cap, state_ptr = st)
    }
}

@no_alloc
fn frame_arena_used(a: FrameArena) -> i64 {
    unsafe {
    return ptr_read_i64(a.state_ptr, 0)
    }
}

// 64-byte cache/SIMD-aligned bump allocation inside `FrameArena` (0 OS syscalls, `@no_alloc`).
@no_alloc
fn frame_arena_alloc(a: FrameArena, size_bytes: i64) -> i64 {
    unsafe {
    if a.state_ptr == 0 or size_bytes <= 0 {
        return 0
    }
    cur := ptr_read_i64(a.state_ptr, 0)
    aligned_sz := (size_bytes + 63) & (0 - 64)
    if aligned_sz <= 0 {
        return 0
    }
    next_off := cur + aligned_sz
    if next_off < cur or next_off > a.cap_bytes {
        return 0
    }
    ptr_write_i64(a.state_ptr, 0, next_off)
    return a.base_ptr + cur
    }
}

// Reclaims 100% of per-frame temporary allocations in a single `MOV [state], 0` instruction!
@no_alloc
fn frame_arena_reset(a: FrameArena) {
    unsafe {
    ptr_write_i64(a.state_ptr, 0, 0)
    }
}

fn frame_arena_free(move a: FrameArena) {
    unsafe {
    if a.base_ptr != 0 {
        mem_free_aligned(a.base_ptr)
    }
    if a.state_ptr != 0 {
        mem_free_aligned(a.state_ptr)
    }
    }
}

struct Transform3D {
    pos: vec3
    rot: quat
    scale: vec3
}

@no_alloc
fn transform3d_identity() -> Transform3D {
    return Transform3D(
        pos = vec3_new(0.0, 0.0, 0.0),
        rot = quat_id(),
        scale = vec3_new(1.0, 1.0, 1.0)
    )
}

@no_alloc
fn transform3d_matrix(t: Transform3D) -> mat4 {
    return mat4_trs(t.pos, t.rot, t.scale)
}

@no_alloc
fn lerp_vec3(a: vec3, b: vec3, t: f64) -> vec3 {
    inv := 1.0 - t
    return (a * inv) + (b * t)
}

@no_alloc
fn transform_point(m: mat4, p: vec3) -> vec3 {
    v4 := vec4_new(p.x, p.y, p.z, 1.0)
    r4 := mat4_mul_vec4(m, v4)
    return vec3_new(r4.x, r4.y, r4.z)
}
