// Axon v1.0.0 Portable Integer, Fixed-Point & Geometry Math (`std/math.ax`)
// Collision-free with `std::ai_math` and compiler builtins (`sqrt_f64`, `abs_f64`).
// Works natively (`win-x64`, `linux-x64`, `macos-arm64`) and on `--target wasm32`.

fn min_i64(a: i64, b: i64) -> i64 {
    if a < b { return a }
    return b
}

fn max_i64(a: i64, b: i64) -> i64 {
    if a > b { return a }
    return b
}

fn clamp_i64(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}

fn abs_i64(x: i64) -> i64 {
    if x < 0 { return 0 -% x }
    return x
}

fn sign_i64(x: i64) -> i64 {
    if x > 0 { return 1 }
    if x < 0 { return -1 }
    return 0
}

fn gcd(a_in: i64, b_in: i64) -> i64 {
    mut a := a_in
    mut b := b_in
    if a < 0 { a = 0 -% a }
    if b < 0 { b = 0 -% b }
    while b != 0 {
        // Unsigned remainder avoids INT64_MIN edge traps when inputs are positive
        t := b
        b = a % b
        if b < 0 { b = 0 -% b }
        a = t
    }
    if a < 0 { return 0 }
    return a
}

fn lcm(a: i64, b: i64) -> i64 ! i64 {
    if a == 0 or b == 0 { return ok(0) }
    aa := abs_i64(a)
    bb := abs_i64(b)
    if aa < 0 or bb < 0 { return err(400) }
    g := gcd(aa, bb)
    if g <= 0 { return err(400) }
    q := aa / g
    // Overflow check before multiplying q * bb
    if bb > (9223372036854775807 / q) { return err(413) }
    return ok(q * bb)
}

fn pow_i64(base_in: i64, exp_in: i64) -> i64 {
    if exp_in < 0 { return 0 }
    if exp_in == 0 { return 1 }
    mut res := 1
    mut base := base_in
    mut exp := exp_in
    while exp > 0 {
        if (exp & 1) != 0 {
            res = res *% base
        }
        exp = exp >> 1
        if exp > 0 {
            base = base *% base
        }
    }
    return res
}

fn pow_mod_i64(base_in: i64, exp_in: i64, mod_in: i64) -> i64 ! i64 {
    if mod_in <= 0 or exp_in < 0 { return err(400) }
    if mod_in == 1 { return ok(0) }
    mut b := base_in % mod_in
    if b < 0 { b += mod_in }
    mut res := 1
    mut exp := exp_in
    while exp > 0 {
        if (exp & 1) != 0 {
            // Safe modular mul when intermediate product fits < 2^63; guard >= 2^31
            if res > 0 and b > (9223372036854775807 / res) {
                // Russian peasant modular multiply avoids i64 signed overflow
                mut ma := res
                mut mb := b
                mut mp := 0
                while mb > 0 {
                    if (mb & 1) != 0 {
                        mp += ma
                        if mp >= mod_in { mp -= mod_in }
                    }
                    mb = mb >> 1
                    if mb > 0 {
                        ma += ma
                        if ma >= mod_in { ma -= mod_in }
                    }
                }
                res = mp
            } else {
                res = (res * b) % mod_in
            }
        }
        exp = exp >> 1
        if exp > 0 {
            if b > 0 and b > (9223372036854775807 / b) {
                mut ma := b
                mut mb := b
                mut mp := 0
                while mb > 0 {
                    if (mb & 1) != 0 {
                        mp += ma
                        if mp >= mod_in { mp -= mod_in }
                    }
                    mb = mb >> 1
                    if mb > 0 {
                        ma += ma
                        if ma >= mod_in { ma -= mod_in }
                    }
                }
                b = mp
            } else {
                b = (b * b) % mod_in
            }
        }
    }
    return ok(res)
}

fn isqrt_i64(n: i64) -> i64 {
    if n <= 0 { return 0 }
    if n == 1 { return 1 }
    mut lo := 1
    mut hi := 3037000499 // floor(sqrt(INT64_MAX))
    if n < hi { hi = n }
    mut ans := 1
    while lo <= hi {
        mid := lo + ((hi - lo) >> 1)
        q := n / mid
        if mid <= q {
            ans = mid
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return ans
}

fn ceil_div_i64(num: i64, den: i64) -> i64 ! i64 {
    if den <= 0 or num < 0 { return err(400) }
    if num == 0 { return ok(0) }
    return ok(((num - 1) / den) + 1)
}

fn is_pow2_i64(x: i64) -> bool {
    return x > 0 and (x & (x - 1)) == 0
}

fn next_pow2_i64(x: i64) -> i64 ! i64 {
    if x <= 1 { return ok(1) }
    if x > 4611686018427387904 { return err(413) }
    mut p := 1
    while p < x {
        p = p << 1
    }
    return ok(p)
}

fn math_trunc(x: f64) -> f64 {
    if x >= 4503599627370496.0 or x <= -4503599627370496.0 { return x }
    if x != x { return x }
    ti := x as i64
    return ti as f64
}

fn math_floor(x: f64) -> f64 {
    if x >= 4503599627370496.0 or x <= -4503599627370496.0 { return x }
    if x != x { return x }
    ti := x as i64
    t := ti as f64
    if x < t { return t - 1.0 }
    return t
}

fn math_ceil(x: f64) -> f64 {
    if x >= 4503599627370496.0 or x <= -4503599627370496.0 { return x }
    if x != x { return x }
    ti := x as i64
    t := ti as f64
    if x > t { return t + 1.0 }
    return t
}

fn math_round(x: f64) -> f64 {
    if x >= 4503599627370496.0 or x <= -4503599627370496.0 { return x }
    if x != x { return x }
    if x >= 0.0 { return math_floor(x + 0.5) }
    return math_ceil(x - 0.5)
}

fn math_fract(x: f64) -> f64 {
    return x - math_floor(x)
}

fn math_lerp(a: f64, b: f64, t: f64) -> f64 {
    return a + (b - a) * t
}

fn math_inv_lerp(a: f64, b: f64, val: f64) -> f64 {
    if a == b { return 0.0 }
    return (val - a) / (b - a)
}

fn math_remap(in_lo: f64, in_hi: f64, out_lo: f64, out_hi: f64, val: f64) -> f64 {
    t := math_inv_lerp(in_lo, in_hi, val)
    return math_lerp(out_lo, out_hi, t)
}

fn math_deg_to_rad(deg: f64) -> f64 {
    return deg * 0.017453292519943295
}

fn math_rad_to_deg(rad: f64) -> f64 {
    return rad * 57.29577951308232
}

fn math_hypot(dx: f64, dy: f64) -> f64 {
    ax := abs_f64(dx)
    ay := abs_f64(dy)
    mut big := ax
    mut small := ay
    if ay > ax { big = ay; small = ax }
    if big == 0.0 { return 0.0 }
    r := small / big
    return big * sqrt_f64(1.0 + r * r)
}

// High-accuracy minimax rational/polynomial atan(x) for |x| <= 1, reduced for |x| > 1
fn math_atan_unit(z: f64) -> f64 {
    // 7-term odd polynomial after half-angle identity around pi/6
    mut neg := false
    mut a := z
    if a < 0.0 { neg = true; a = 0.0 - a }
    mut step := 0
    if a > 0.2679491924311227 { // tan(15 deg)
        // tan(theta - pi/6) = (sqrt(3)*a - 1) / (sqrt(3) + a)
        a = (1.7320508075688772 * a - 1.0) / (1.7320508075688772 + a)
        step = 1
    }
    a2 := a * a
    mut r := a * (1.0 - a2 * (0.3333333333333333 - a2 * (0.2 - a2 * (0.14285714285714285 - a2 * 0.1111111111111111))))
    if step == 1 { r += 0.5235987755982989 } // pi/6
    if neg { return 0.0 - r }
    return r
}

fn math_atan(x: f64) -> f64 {
    if x > 1.0 { return 1.5707963267948966 - math_atan_unit(1.0 / x) }
    if x < -1.0 { return -1.5707963267948966 - math_atan_unit(1.0 / x) }
    return math_atan_unit(x)
}

fn math_atan2(y: f64, x: f64) -> f64 {
    if x > 0.0 { return math_atan(y / x) }
    if x < 0.0 {
        if y >= 0.0 { return math_atan(y / x) + 3.141592653589793 }
        return math_atan(y / x) - 3.141592653589793
    }
    if y > 0.0 { return 1.5707963267948966 }
    if y < 0.0 { return -1.5707963267948966 }
    return 0.0
}

fn math_approx_eq(a: f64, b: f64, eps: f64 = 0.000001) -> bool {
    return abs_f64(a - b) <= eps
}
