// Axon Production OS, Environment, Filesystem & Process Utilities (`std/sys.ax`)
// Provides real cross-platform OS calls via native FFI (`kernel32.dll` / `libc`)
// so AI agents never need Python/C helper scripts for env vars, cwd, mkdir, delete, or exec capture.

use std::ffi

fn _sys_kernel() -> i64 {
    return ffi_open("kernel32.dll", "libc.so.6", "libSystem.B.dylib")
}

fn sys_pid() -> i64 {
    k := _sys_kernel()
    if k == 0 { return 0 }
    f := ffi_sym2(k, "GetCurrentProcessId", "getpid")
    return ffi_call0(f) & 0xFFFFFFFF
}

fn sys_env_get(name: str) -> str {
    k := _sys_kernel()
    if k == 0 { return "" }
    f_win := ffi_sym(k, "GetEnvironmentVariableA")
    cname := ffi_cstr(name)
    if f_win != 0 {
        buf := ffi_alloc(4096)
        n := ffi_call3(f_win, cname, buf, 4095) & 0xFFFFFFFF
        mut res := ""
        if n > 0 and n < 4096 {
            res = ffi_read_cstr(buf, n)
        }
        ffi_free(buf)
        ffi_free(cname)
        return res
    }
    f_unix := ffi_sym(k, "getenv")
    p := ffi_call1(f_unix, cname)
    ffi_free(cname)
    if p == 0 { return "" }
    return ffi_read_cstr(p, 4096)
}

fn sys_env_set(name: str, val: str) -> bool {
    k := _sys_kernel()
    if k == 0 { return false }
    cname := ffi_cstr(name)
    cval := ffi_cstr(val)
    f_win := ffi_sym(k, "SetEnvironmentVariableA")
    mut ok_s := false
    if f_win != 0 {
        ok_s = (ffi_call2(f_win, cname, cval) & 0xFFFFFFFF) != 0
    } else {
        f_unix := ffi_sym(k, "setenv")
        ok_s = ffi_sext32(ffi_call3(f_unix, cname, cval, 1)) == 0
    }
    ffi_free(cname)
    ffi_free(cval)
    return ok_s
}

fn sys_cwd() -> str {
    k := _sys_kernel()
    if k == 0 { return "" }
    buf := ffi_alloc(4096)
    f_win := ffi_sym(k, "GetCurrentDirectoryA")
    mut out := ""
    if f_win != 0 {
        n := ffi_call2(f_win, 4095, buf) & 0xFFFFFFFF
        if n > 0 and n < 4096 { out = ffi_read_cstr(buf, n) }
    } else {
        f_unix := ffi_sym(k, "getcwd")
        if ffi_call2(f_unix, buf, 4095) != 0 { out = ffi_read_cstr(buf, 4095) }
    }
    ffi_free(buf)
    return out
}

fn _sys_has_nul(s: str) -> bool {
    n := str_len(s)
    mut i := 0
    while i < n {
        if str_byte(s, i) == 0 { return true }
        i += 1
    }
    return false
}

fn sys_fs_exists(path: str) -> bool {
    if str_len(path) == 0 or _sys_has_nul(path) { return false }
    k := _sys_kernel()
    if k == 0 { return false }
    cp := ffi_cstr(path)
    f_win := ffi_sym(k, "GetFileAttributesA")
    mut ex := false
    if f_win != 0 {
        attr := ffi_call1(f_win, cp) & 0xFFFFFFFF
        ex = attr != 0xFFFFFFFF
    } else {
        f_acc := ffi_sym(k, "access")
        ex = ffi_sext32(ffi_call2(f_acc, cp, 0)) == 0
    }
    ffi_free(cp)
    return ex
}

fn sys_fs_mkdir(path: str) -> bool {
    if str_len(path) == 0 or _sys_has_nul(path) { return false }
    k := _sys_kernel()
    if k == 0 { return false }
    cp := ffi_cstr(path)
    f_win := ffi_sym(k, "CreateDirectoryA")
    mut ok_m := false
    if f_win != 0 {
        ok_m = (ffi_call2(f_win, cp, 0) & 0xFFFFFFFF) != 0
    } else {
        f_mk := ffi_sym(k, "mkdir")
        ok_m = ffi_sext32(ffi_call2(f_mk, cp, 493)) == 0
    }
    ffi_free(cp)
    return ok_m
}

fn sys_fs_remove(path: str) -> bool {
    if str_len(path) == 0 or _sys_has_nul(path) { return false }
    k := _sys_kernel()
    if k == 0 { return false }
    cp := ffi_cstr(path)
    f_win := ffi_sym(k, "DeleteFileA")
    mut ok_d := false
    if f_win != 0 {
        ok_d = (ffi_call1(f_win, cp) & 0xFFFFFFFF) != 0
    } else {
        f_un := ffi_sym(k, "unlink")
        ok_d = ffi_sext32(ffi_call1(f_un, cp)) == 0
    }
    ffi_free(cp)
    return ok_d
}

fn sys_fs_size(path: str) -> i64 {
    if str_len(path) == 0 or _sys_has_nul(path) { return -1 }
    b := fs_read_file(path) or return -1
    n := buf_len(b)
    buf_free(move b)
    return n
}

fn sys_exec_capture(cmd: str) -> str {
    if str_len(cmd) == 0 or _sys_has_nul(cmd) { return "" }
    // Unpredictable per-invocation temp file (CWE-377) prevents clobbering & symlink races
    nonce := (clock_ns() ^ cpu_rdtsc()) & 0x7FFFFFFF
    tmp_path := f".axon_exec_{sys_pid()}_{nonce}.tmp"
    full := f"{cmd} > {tmp_path} 2>&1"
    _ := os_exec(full)
    b := fs_read_file(tmp_path) or buf_new(0)
    _ := sys_fs_remove(tmp_path)
    return buf_to_owned_str(move b)
}
