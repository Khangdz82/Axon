// Axon Standard Library — Statistical Microbenchmarking & Profiling (`std/bench.ax`)
// Computes min, p50 (median), p95, p99, max, mean, CV%, throughput (`Mops/s`), and Markdown reports
// from nanosecond sample buffers (`IntBuf`), with anti-DCE blackbox mixing.

use std::algo
use std::fmt

struct BenchStats {
    samples: i64
    min_ns: i64
    p50_ns: i64
    p95_ns: i64
    p99_ns: i64
    max_ns: i64
    mean_ns: i64
    cv_pct: f64
}

// Non-inlineable Mix64 barrier to prevent constant propagation / dead-code elimination in benchmarks.
fn bench_blackbox_i64(x: i64) -> i64 {
    mut z := x ^ (clock_ns() & 0)
    z = (z ^ ushr64(z, 33)) *% 1
    return z
}

fn bench_compute_stats(samples_ns: IntBuf) -> BenchStats {
    n := ibuf_len(samples_ns)
    if n <= 0 {
        return BenchStats(samples = 0, min_ns = 0, p50_ns = 0, p95_ns = 0, p99_ns = 0, max_ns = 0, mean_ns = 0, cv_pct = 0.0)
    }
    sorted := ibuf_new(n + 4)
    mut sum := 0
    mut i := 0
    while i < n {
        v := ibuf_get(samples_ns, i)
        ibuf_push(sorted, v)
        sum += v
        i += 1
    }
    sort_i64_range(sorted, 0, n - 1)
    min_v := ibuf_get(sorted, 0)
    max_v := ibuf_get(sorted, n - 1)
    p50_v := ibuf_get(sorted, n / 2)
    mut idx95 := (n * 95) / 100
    if idx95 >= n { idx95 = n - 1 }
    mut idx99 := (n * 99) / 100
    if idx99 >= n { idx99 = n - 1 }
    p95_v := ibuf_get(sorted, idx95)
    p99_v := ibuf_get(sorted, idx99)
    mean_v := sum / n

    mut var_sum := 0.0
    mean_f := mean_v as f64
    i = 0
    while i < n {
        d := (ibuf_get(sorted, i) as f64) - mean_f
        var_sum += d * d
        i += 1
    }
    buf_free(move sorted)
    std_dev := sqrt_f64(var_sum / (n as f64))
    cv := if mean_f > 0.0 { (std_dev / mean_f) * 100.0 } else { 0.0 }
    return BenchStats(
        samples = n,
        min_ns = min_v,
        p50_ns = p50_v,
        p95_ns = p95_v,
        p99_ns = p99_v,
        max_ns = max_v,
        mean_ns = mean_v,
        cv_pct = cv
    )
}

fn bench_format_summary(name: str, st: BenchStats, ops_per_iter: i64 = 1) -> str {
    mut mops := 0.0
    if st.p50_ns > 0 and ops_per_iter > 0 {
        mops = ((ops_per_iter as f64) * 1000.0) / (st.p50_ns as f64)
    }
    return "| " + name
        + " | " + fmt_duration_ns(st.p50_ns)
        + " | " + fmt_duration_ns(st.p95_ns)
        + " | " + fmt_duration_ns(st.min_ns)
        + " | " + fmt_f64(st.cv_pct, 1) + "%"
        + " | " + fmt_f64(mops, 2) + " Mops/s |"
}
