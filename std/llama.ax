// Axon LLaMA.cpp & llama-cpp-python Reimplementation (`std/llama.ax`)
// 100% Pure Axon: Zero C++, Zero Python, Zero libllama.so / llama.dll, Zero-GC (@no_alloc).
// Implements:
//   - GGUF Model Header & Metadata Parser
//   - Rotary Positional Embeddings (RoPE) with Frequency Precomputation
//   - Zero-Allocation RMSNorm (Root Mean Square Normalization)
//   - SwiGLU Fused Feed-Forward Activation (`silu(gate) * up`)
//   - Grouped-Query Attention (GQA) with Non-Contiguous KV Caching
//   - Production Sampler: Temperature, Top-K, Top-P (Nucleus), Greedy Argmax

use std::numpy
use std::quant
use std::ai_math
use std::os

// --- 1. GGUF File Format Header ---

struct LlamaGgufHeader {
    valid: bool
    version: i64
    tensor_count: i64
    kv_count: i64
}

fn llama_read_u32_le(raw: ByteBuf, off: i64) -> i64 {
    b0 := buf_get(raw, off)
    b1 := buf_get(raw, off + 1)
    b2 := buf_get(raw, off + 2)
    b3 := buf_get(raw, off + 3)
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

fn llama_read_u64_le(raw: ByteBuf, off: i64) -> i64 {
    lo := llama_read_u32_le(raw, off)
    hi := llama_read_u32_le(raw, off + 4)
    return lo | (hi << 32)
}

fn llama_parse_gguf_header(raw: ByteBuf) -> LlamaGgufHeader {
    if buf_len(raw) < 24 {
        return LlamaGgufHeader(valid = false, version = 0, tensor_count = 0, kv_count = 0)
    }
    // "GGUF" magic = 0x46554747 in little-endian
    magic := llama_read_u32_le(raw, 0)
    if magic != 0x46554747 {
        return LlamaGgufHeader(valid = false, version = 0, tensor_count = 0, kv_count = 0)
    }
    ver := llama_read_u32_le(raw, 4)
    tc := llama_read_u64_le(raw, 8)
    kvc := llama_read_u64_le(raw, 16)
    return LlamaGgufHeader(valid = true, version = ver, tensor_count = tc, kv_count = kvc)
}

// --- 2. Transformer Architectures: RMSNorm, RoPE & SwiGLU ---

// RMSNorm: out[i] = (x[i] / sqrt(mean(x^2) + eps)) * weight[i]
@no_alloc
fn llama_rmsnorm(x_ptr: i64, weight_ptr: i64, out_ptr: i64, dim: i64, eps: f64 = 0.00001) {
    if dim <= 0 { return }
    avx_rmsnorm_f32(x_ptr, weight_ptr, out_ptr, dim, eps)
}

// Rotary Position Embedding (RoPE) for Attention Query and Key
// Rotates pairs of elements: [x0, x1] -> [x0*cos - x1*sin, x0*sin + x1*cos]
@no_alloc
fn llama_apply_rope(vec_ptr: i64, pos: i64, head_dim: i64, theta_base: f64 = 10000.0) {
    if head_dim <= 0 or theta_base <= 1.0 { return }
    ln_theta := log2_f64(theta_base) * 0.6931471805599453
    mut i := 0
    while i + 1 < head_dim {
        // Exact continuous inverse frequency: 1.0 / (theta_base ^ (i / head_dim))
        exp_val := (i as f64) / (head_dim as f64)
        freq := exp_f64((0.0 - exp_val) * ln_theta)
        angle := (pos as f64) * freq
        cos_theta := cos_f64(angle)
        sin_theta := sin_f64(angle)

        x0 := ptr_read_f32(vec_ptr, i)
        x1 := ptr_read_f32(vec_ptr, i + 1)

        rot_x0 := x0 * cos_theta - x1 * sin_theta
        rot_x1 := x0 * sin_theta + x1 * cos_theta

        ptr_write_f32(vec_ptr, i, rot_x0)
        ptr_write_f32(vec_ptr, i + 1, rot_x1)
        i += 2
    }
}

// SwiGLU Fused Feed-Forward Activation: out = silu(gate) * up
@no_alloc
fn llama_swiglu(gate_ptr: i64, up_ptr: i64, out_ptr: i64, dim: i64) {
    if dim <= 0 { return }
    avx_swiglu_f32(gate_ptr, up_ptr, out_ptr, dim)
}

// --- 3. Key-Value Cache for Fast Auto-Regressive Decoding ---

struct LlamaKvCache {
    k_mem: i64   // [max_seq_len x num_kv_heads x head_dim] in f32
    v_mem: i64   // [max_seq_len x num_kv_heads x head_dim] in f32
    max_seq_len: i64
    kv_dim: i64
    cur_pos: i64
}

fn llama_kv_cache_new(max_seq: i64, num_kv_heads: i64, head_dim: i64) -> LlamaKvCache {
    dim := num_kv_heads * head_dim
    total_floats := max_seq * dim
    k_ptr := mem_alloc_aligned(total_floats * 4 + 64)
    v_ptr := mem_alloc_aligned(total_floats * 4 + 64)
    
    mut i := 0
    while i < total_floats {
        ptr_write_f32(k_ptr, i, 0.0)
        ptr_write_f32(v_ptr, i, 0.0)
        i += 1
    }

    return LlamaKvCache(
        k_mem = k_ptr,
        v_mem = v_ptr,
        max_seq_len = max_seq,
        kv_dim = dim,
        cur_pos = 0
    )
}

@no_alloc
fn llama_kv_store(mut cache: LlamaKvCache, pos: i64, k_in_ptr: i64, v_in_ptr: i64) {
    if pos < 0 or pos >= cache.max_seq_len { return }
    off := pos * cache.kv_dim
    mut i := 0
    while i < cache.kv_dim {
        kv := ptr_read_f32(k_in_ptr, i)
        vv := ptr_read_f32(v_in_ptr, i)
        ptr_write_f32(cache.k_mem, off + i, kv)
        ptr_write_f32(cache.v_mem, off + i, vv)
        i += 1
    }
    if (pos + 1) > cache.cur_pos {
        cache.cur_pos = pos + 1
    }
}

// --- 4. Production Sampling Engine ---

// Greedy Argmax Sampling
@no_alloc
fn llama_sample_greedy(logits_ptr: i64, vocab_size: i64) -> i64 {
    if vocab_size <= 0 { return 0 }
    mut max_val := ptr_read_f32(logits_ptr, 0)
    mut max_token := 0
    mut i := 1
    while i < vocab_size {
        v := ptr_read_f32(logits_ptr, i)
        if v > max_val {
            max_val = v
            max_token = i
        }
        i += 1
    }
    return max_token
}

// Temperature-Scaled Softmax Sampling with Sorted Top-P (Nucleus) Filtering
fn llama_sample_top_p(logits_ptr: i64, vocab_size: i64, temperature: f64 = 0.7, top_p: f64 = 0.9, rng_seed: f64 = 0.42) -> i64 {
    if vocab_size <= 0 { return 0 }
    if temperature <= 0.001 {
        return llama_sample_greedy(logits_ptr, vocab_size)
    }

    inv_temp := 1.0 / temperature

    // 1. Max logit
    mut max_l := ptr_read_f32(logits_ptr, 0)
    mut i := 1
    while i < vocab_size {
        v := ptr_read_f32(logits_ptr, i)
        if v > max_l { max_l = v }
        i += 1
    }

    // 2. Softmax normalization sum + index buffer for descending logit heapsort
    idx_ptr := mem_alloc_aligned(vocab_size * 8 + 64)
    mut sum_exp := 0.0
    i = 0
    while i < vocab_size {
        ptr_write_i64(idx_ptr, i, i)
        v := (ptr_read_f32(logits_ptr, i) - max_l) * inv_temp
        sum_exp = sum_exp + exp_f64(v)
        i += 1
    }

    // 3. Build min-heap by logit so extracting top yields descending logit order (for Nucleus Top-P)
    // Using bottom-up max-heap on negative score (i.e. min at root -> sort ascending on extract -> descending order!)
    // Actually: build min-heap directly so heap-sort places SMALLEST at back and LARGEST first?
    // Even simpler: build max-heap? Popping max K times until cum >= top_p stops early in O(K log V)!
    // YES! O(V + K log V) partial heapsort with early exit once nucleus >= top_p!
    mut start := (vocab_size / 2) - 1
    while start >= 0 {
        mut root := start
        while root * 2 + 1 < vocab_size {
            mut child := root * 2 + 1
            if child + 1 < vocab_size {
                ri := ptr_read_i64(idx_ptr, child)
                rj := ptr_read_i64(idx_ptr, child + 1)
                if ptr_read_f32(logits_ptr, rj) > ptr_read_f32(logits_ptr, ri) {
                    child = child + 1
                }
            }
            r_id := ptr_read_i64(idx_ptr, root)
            c_id := ptr_read_i64(idx_ptr, child)
            if ptr_read_f32(logits_ptr, c_id) > ptr_read_f32(logits_ptr, r_id) {
                ptr_write_i64(idx_ptr, root, c_id)
                ptr_write_i64(idx_ptr, child, r_id)
                root = child
            } else {
                break
            }
        }
        start -= 1
    }

    // Extract top elements into a nucleus list stored in tail of idx_ptr or separate buffer until cum >= top_p
    mut clamped_p := top_p
    if clamped_p <= 0.0 { clamped_p = 0.0001 }
    if clamped_p > 1.0 { clamped_p = 1.0 }

    nuc_idx := mem_alloc_aligned(vocab_size * 8 + 64)
    mut heap_n := vocab_size
    mut nuc_len := 0
    mut nuc_mass := 0.0

    while heap_n > 0 {
        best_tok := ptr_read_i64(idx_ptr, 0)
        ptr_write_i64(nuc_idx, nuc_len, best_tok)
        nuc_len += 1
        p_best := exp_f64((ptr_read_f32(logits_ptr, best_tok) - max_l) * inv_temp) / sum_exp
        nuc_mass = nuc_mass + p_best

        heap_n -= 1
        if heap_n > 0 {
            last_tok := ptr_read_i64(idx_ptr, heap_n)
            ptr_write_i64(idx_ptr, 0, last_tok)
            mut root := 0
            while root * 2 + 1 < heap_n {
                mut child := root * 2 + 1
                if child + 1 < heap_n {
                    ri := ptr_read_i64(idx_ptr, child)
                    rj := ptr_read_i64(idx_ptr, child + 1)
                    if ptr_read_f32(logits_ptr, rj) > ptr_read_f32(logits_ptr, ri) {
                        child = child + 1
                    }
                }
                r_id := ptr_read_i64(idx_ptr, root)
                c_id := ptr_read_i64(idx_ptr, child)
                if ptr_read_f32(logits_ptr, c_id) > ptr_read_f32(logits_ptr, r_id) {
                    ptr_write_i64(idx_ptr, root, c_id)
                    ptr_write_i64(idx_ptr, child, r_id)
                    root = child
                } else {
                    break
                }
            }
        }

        if nuc_mass >= clamped_p {
            break
        }
    }

    // 4. Sample uniformly inside the truncated nucleus [0, nuc_mass)
    mut u := rng_seed
    if u < 0.0 { u = 0.0 }
    if u > 0.999999 { u = 0.999999 }
    target_cum := nuc_mass * u

    mut cum := 0.0
    mut chosen := ptr_read_i64(nuc_idx, 0)
    mut k := 0
    while k < nuc_len {
        tok := ptr_read_i64(nuc_idx, k)
        p_tok := exp_f64((ptr_read_f32(logits_ptr, tok) - max_l) * inv_temp) / sum_exp
        cum = cum + p_tok
        if cum >= target_cum {
            chosen = tok
            break
        }
        k += 1
    }

    mem_free_aligned(idx_ptr)
    mem_free_aligned(nuc_idx)
    return chosen
}

fn llama_kv_cache_free(move cache: LlamaKvCache) {
    if cache.k_mem != 0 {
        mem_free_aligned(cache.k_mem)
    }
    if cache.v_mem != 0 {
        mem_free_aligned(cache.v_mem)
    }
}
