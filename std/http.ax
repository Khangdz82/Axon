// Axon v1.0.0 Production HTTP/1.1 Parser, Router, Security Headers & SSE (`std/http.ax`)
// Enforces CRLF header-injection & NUL-byte (CWE-93/CWE-113/CWE-158) sanitization on all headers.

use std::os
use std::str

struct HttpRequest {
    method: str
    path: str
    query: str
    version: str
    body: str
    content_len: i64
}

fn http_is_safe_header_val(v: str) -> bool {
    n := str_len(v)
    mut i := 0
    while i < n {
        b := str_byte(v, i)
        if b == 0 or b == 10 or b == 13 or (b < 32 and b != 9) or b == 127 {
            return false
        }
        i += 1
    }
    return true
}

fn http_is_valid_hdr_name(name: str) -> bool {
    n := str_len(name)
    if n <= 0 {
        return false
    }
    mut i := 0
    while i < n {
        b := str_byte(name, i)
        if b <= 32 or b >= 127 or b == 58 {
            return false
        }
        i += 1
    }
    return true
}

fn http_is_safe_path(p: str) -> bool {
    n := str_len(p)
    if n <= 0 {
        return false
    }
    if n == 1 and str_byte(p, 0) == 42 {
        return true // OPTIONS *
    }
    // RFC 7230 origin-form: must start with single '/', reject '//' UNC & ':' drive paths
    if str_byte(p, 0) != 47 {
        return false
    }
    if n >= 2 and str_byte(p, 1) == 47 {
        return false
    }
    mut i := 0
    while i < n {
        b := str_byte(p, i)
        if b < 32 or b == 127 or b == 92 or b == 58 {
            return false
        }
        if b == 46 and i + 1 < n and str_byte(p, i + 1) == 46 {
            prev_sep := i == 0 or str_byte(p, i - 1) == 47
            next_sep := i + 2 == n or str_byte(p, i + 2) == 47
            if prev_sep or next_sep {
                return false
            }
        }
        if b == 37 and i + 2 < n {
            h := str_byte(p, i + 1)
            l := str_byte(p, i + 2)
            if h == 48 and (l == 48 or l == 65 or l == 97 or l == 68 or l == 100) {
                return false
            }
            if h == 53 and (l == 67 or l == 99) {
                return false
            }
            if h == 50 and (l == 69 or l == 101 or l == 70 or l == 102 or l == 53) {
                return false // %2e, %2f, %25 (encoded '.', '/', double-encoding)
            }
        }
        i += 1
    }
    return true
}

fn http_are_safe_extra_headers(ex: str) -> bool {
    n := str_len(ex)
    if n <= 0 {
        return false
    }
    mut pos := 0
    while pos < n {
        nl := str_find_byte(ex, 10, pos)
        mut line_end := nl
        if line_end < 0 {
            line_end = n
        } else {
            if line_end <= pos or str_byte(ex, line_end - 1) != 13 {
                return false
            }
            line_end -= 1
        }
        if line_end > pos {
            line := str_slice(ex, pos, line_end)
            colon := str_find_byte(line, 58, 0)
            if colon <= 0 {
                return false
            }
            hname := str_slice(line, 0, colon)
            if not http_is_valid_hdr_name(hname) {
                return false
            }
            if str_eq_ignore_case(hname, "Transfer-Encoding") or str_eq_ignore_case(hname, "Content-Length") {
                return false
            }
            if not http_is_safe_header_val(str_slice(line, colon + 1, str_len(line))) {
                return false
            }
        } else if nl < 0 {
            break
        } else {
            // Blank CRLF line inside extra_headers would terminate header section early (response splitting!)
            return false
        }
        if nl < 0 {
            break
        }
        pos = nl + 1
    }
    return true
}

fn http_status_reason(code: i64) -> str {
    if code == 200 { return "OK" }
    if code == 201 { return "Created" }
    if code == 204 { return "No Content" }
    if code == 301 { return "Moved Permanently" }
    if code == 302 { return "Found" }
    if code == 400 { return "Bad Request" }
    if code == 401 { return "Unauthorized" }
    if code == 403 { return "Forbidden" }
    if code == 404 { return "Not Found" }
    if code == 405 { return "Method Not Allowed" }
    if code == 413 { return "Payload Too Large" }
    if code == 422 { return "Unprocessable Entity" }
    if code == 429 { return "Too Many Requests" }
    if code == 500 { return "Internal Server Error" }
    if code == 502 { return "Bad Gateway" }
    if code == 503 { return "Service Unavailable" }
    return "OK"
}

fn http_mime_type(path: str) -> str {
    if str_ends_with(path, ".html") or str_ends_with(path, ".htm") { return "text/html; charset=utf-8" }
    if str_ends_with(path, ".json") { return "application/json; charset=utf-8" }
    if str_ends_with(path, ".js") or str_ends_with(path, ".mjs") { return "application/javascript; charset=utf-8" }
    if str_ends_with(path, ".css") { return "text/css; charset=utf-8" }
    if str_ends_with(path, ".svg") { return "image/svg+xml" }
    if str_ends_with(path, ".png") { return "image/png" }
    if str_ends_with(path, ".jpg") or str_ends_with(path, ".jpeg") { return "image/jpeg" }
    if str_ends_with(path, ".webp") { return "image/webp" }
    if str_ends_with(path, ".wasm") { return "application/wasm" }
    if str_ends_with(path, ".txt") or str_ends_with(path, ".md") { return "text/plain; charset=utf-8" }
    if str_ends_with(path, ".csv") { return "text/csv; charset=utf-8" }
    return "application/octet-stream"
}

fn http_find_header_end(raw: str) -> i64 {
    crlf := str_find(raw, "\r\n\r\n", 0)
    lf2 := str_find(raw, "\n\n", 0)
    if crlf >= 0 and lf2 >= 0 and lf2 < crlf {
        return lf2
    }
    if crlf >= 0 {
        return crlf
    }
    return lf2
}

fn http_get_header(raw: str, name: str) -> str ! i64 {
    n := str_len(raw)
    mut hdr_end := http_find_header_end(raw)
    if hdr_end < 0 {
        hdr_end = n
    }
    first_nl := str_find_byte(raw, 10, 0)
    if first_nl < 0 or first_nl >= hdr_end {
        return err(404)
    }
    mut line_start := first_nl + 1
    while line_start < hdr_end {
        mut line_end := str_find_byte(raw, 10, line_start)
        if line_end < 0 or line_end > hdr_end {
            line_end = hdr_end
        }
        mut trimmed_end := line_end
        if trimmed_end > line_start and str_byte(raw, trimmed_end - 1) == 13 {
            trimmed_end -= 1
        }
        line := str_slice(raw, line_start, trimmed_end)
        colon := str_find_byte(line, 58, 0)
        if colon > 0 {
            hname := str_slice(line, 0, colon)
            if http_is_valid_hdr_name(hname) and str_eq_ignore_case(hname, name) {
                return ok(str_trim(str_slice(line, colon + 1, str_len(line))))
            }
        }
        line_start = line_end + 1
    }
    return err(404)
}

fn http_parse_request(raw: str) -> HttpRequest ! i64 {
    n := str_len(raw)
    if n <= 0 {
        return err(400)
    }
    hdr_end := str_find(raw, "\r\n\r\n", 0)
    if hdr_end <= 0 {
        return err(400)
    }
    lf2 := str_find(raw, "\n\n", 0)
    if lf2 >= 0 and lf2 < hdr_end {
        return err(400)
    }
    body_start := hdr_end + 4
    uses_crlf := true
    mut line_end := str_find_byte(raw, 10, 0)
    if line_end < 0 or line_end > hdr_end {
        line_end = hdr_end
    }
    mut req_end := line_end
    if uses_crlf and line_end < hdr_end {
        if req_end <= 0 or str_byte(raw, req_end - 1) != 13 { return err(400) }
        req_end -= 1
    } else if req_end > 0 and str_byte(raw, req_end - 1) == 13 {
        req_end -= 1
    }
    req_line := str_slice(raw, 0, req_end)
    sp1 := str_find_byte(req_line, 32, 0)
    if sp1 <= 0 {
        return err(400)
    }
    sp2 := str_find_byte(req_line, 32, sp1 + 1)
    if sp2 <= sp1 + 1 {
        return err(400)
    }
    method := str_slice(req_line, 0, sp1)
    target := str_slice(req_line, sp1 + 1, sp2)
    version := str_slice(req_line, sp2 + 1, str_len(req_line))
    // Strictly validate HTTP method token (1..16 uppercase ASCII) and exact HTTP/1.0 or HTTP/1.1 version
    mlen := str_len(method)
    if mlen <= 0 or mlen > 16 { return err(400) }
    mut mi := 0
    while mi < mlen {
        mb := str_byte(method, mi)
        if mb < 65 or mb > 90 { return err(400) }
        mi += 1
    }
    if not str_eq(version, "HTTP/1.1") and not str_eq(version, "HTTP/1.0") {
        return err(400)
    }

    mut path := target
    mut query := ""
    qpos := str_find_byte(target, 63, 0) // '?'
    if qpos >= 0 {
        path = str_slice(target, 0, qpos)
        query = str_slice(target, qpos + 1, str_len(target))
    }

    // Reject path control bytes, NUL smuggling, or `%00`/`%0a`/`%0d` encoded splitting
    if not http_is_safe_path(path) or not http_is_safe_header_val(query) {
        return err(400)
    }

    // Single-pass header security audit: block duplicate Content-Length, Transfer-Encoding smuggling,
    // obs-fold continuation, bare CR/LF desync, blank lines, header flood (>128), NUL bytes, and invalid syntax.
    mut cl_cnt := 0
    mut cl_str := ""
    mut hdr_cnt := 0
    if line_end < hdr_end {
        mut hpos := line_end + 1
        while hpos < hdr_end {
            hdr_cnt += 1
            if hdr_cnt > 128 { return err(400) }
            mut hnl := str_find_byte(raw, 10, hpos)
            mut at_hdr_end := false
            if hnl < 0 or hnl > hdr_end {
                hnl = hdr_end
                at_hdr_end = true
            }
            mut hend := hnl
            if uses_crlf {
                if not at_hdr_end {
                    if hend <= hpos or str_byte(raw, hend - 1) != 13 { return err(400) }
                    hend -= 1
                }
            } else if hend > hpos and str_byte(raw, hend - 1) == 13 {
                hend -= 1
            }
            if hend > hpos {
                fb := str_byte(raw, hpos)
                if fb == 32 or fb == 9 {
                    return err(400)
                }
                hline := str_slice(raw, hpos, hend)
                hcol := str_find_byte(hline, 58, 0)
                if hcol <= 0 {
                    return err(400)
                }
                hname := str_slice(hline, 0, hcol)
                hval := str_slice(hline, hcol + 1, str_len(hline))
                if not http_is_valid_hdr_name(hname) or not http_is_safe_header_val(hval) {
                    return err(400)
                }
                if str_eq_ignore_case(hname, "Transfer-Encoding") {
                    return err(400)
                }
                if str_eq_ignore_case(hname, "Content-Length") {
                    cl_cnt += 1
                    if cl_cnt > 1 {
                        return err(400)
                    }
                    cl_str = str_trim(hval)
                }
            } else {
                // Reject blank `\r\n` or empty line inside header block (HTTP request smuggling)
                return err(400)
            }
            hpos = hnl + 1
        }
    }

    mut clen := n - body_start
    if cl_cnt == 1 {
        cl_len := str_len(cl_str)
        if cl_len <= 0 or cl_len > 12 { return err(400) }
        mut ci := 0
        mut parsed_cl := 0
        while ci < cl_len {
            cb := str_byte(cl_str, ci)
            if cb < 48 or cb > 57 { return err(400) }
            parsed_cl = parsed_cl * 10 + (cb - 48)
            ci += 1
        }
        if parsed_cl < 0 or parsed_cl > n - body_start {
            return err(400)
        }
        clen = parsed_cl
    }
    body := str_slice(raw, body_start, body_start + clen)
    return ok(HttpRequest(method, path, query, version, body, clen))
}

fn http_query_param(query: str, key: str) -> str ! i64 {
    qlen := str_len(query)
    if qlen == 0 or str_len(key) == 0 {
        return err(404)
    }
    mut cur := 0
    while cur <= qlen {
        mut amp := str_find_byte(query, 38, cur) // '&'
        if amp < 0 {
            amp = qlen
        }
        pair := str_slice(query, cur, amp)
        eq := str_find_byte(pair, 61, 0) // '='
        if eq >= 0 {
            raw_k := str_slice(pair, 0, eq)
            dec_k := url_decode(raw_k) or raw_k
            if str_eq(dec_k, key) {
                raw_v := str_slice(pair, eq + 1, str_len(pair))
                dec_v := url_decode(raw_v) or raw_v
                return ok(dec_v)
            }
        }
        if amp >= qlen {
            break
        }
        cur = amp + 1
    }
    return err(404)
}

fn http_route_match(pattern: str, req_path: str) -> bool {
    pn := str_len(pattern)
    rn := str_len(req_path)
    mut pi := 0
    mut ri := 0
    while true {
        mut pe := str_find_byte(pattern, 47, pi)
        if pe < 0 { pe = pn }
        mut re := str_find_byte(req_path, 47, ri)
        if re < 0 { re = rn }
        plen := pe - pi
        rlen := re - ri
        if plen > 0 and str_byte(pattern, pi) == 58 { // ':param'
            if rlen <= 0 {
                return false
            }
        } else {
            if plen != rlen or not str_eq(str_slice(pattern, pi, pe), str_slice(req_path, ri, re)) {
                return false
            }
        }
        p_at_end := pe >= pn
        r_at_end := re >= rn
        if p_at_end != r_at_end {
            return false
        }
        if p_at_end {
            return true
        }
        pi = pe + 1
        ri = re + 1
    }
    return false
}

fn http_route_param(pattern: str, req_path: str, param_name: str) -> str ! i64 {
    pn := str_len(pattern)
    rn := str_len(req_path)
    mut pi := 0
    mut ri := 0
    mut found := false
    mut found_val := ""
    while true {
        mut pe := str_find_byte(pattern, 47, pi)
        if pe < 0 { pe = pn }
        mut re := str_find_byte(req_path, 47, ri)
        if re < 0 { re = rn }
        plen := pe - pi
        rlen := re - ri
        if plen > 0 and str_byte(pattern, pi) == 58 {
            if rlen <= 0 {
                return err(404)
            }
            if not found and plen > 1 and str_eq(str_slice(pattern, pi + 1, pe), param_name) {
                found = true
                found_val = str_slice(req_path, ri, re)
            }
        } else {
            if plen != rlen or not str_eq(str_slice(pattern, pi, pe), str_slice(req_path, ri, re)) {
                return err(404)
            }
        }
        p_at_end := pe >= pn
        r_at_end := re >= rn
        if p_at_end != r_at_end {
            return err(404)
        }
        if p_at_end {
            if found {
                return ok(found_val)
            }
            return err(404)
        }
        pi = pe + 1
        ri = re + 1
    }
    return err(404)
}

fn http_build_response(status_code: i64, content_type: str, body: str, extra_headers: str = "") -> str {
    reason := http_status_reason(status_code)
    mut safe_ct := content_type
    if not http_is_safe_header_val(safe_ct) or str_len(safe_ct) == 0 {
        safe_ct = "application/octet-stream"
    }
    blen := str_len(body)
    sec := "X-Content-Type-Options: nosniff\r\nX-Frame-Options: DENY\r\nReferrer-Policy: no-referrer\r\n"
    mut ex := ""
    if http_are_safe_extra_headers(extra_headers) {
        ex = extra_headers
    }
    total_cap := 160 + str_len(reason) + str_len(safe_ct) + str_len(sec) + str_len(ex) + blen
    out := buf_new(total_cap)
    buf_push_str(out, "HTTP/1.1 ")
    buf_append_i64(out, status_code)
    buf_push(out, 32)
    buf_push_str(out, reason)
    buf_push_str(out, "\r\nContent-Type: ")
    buf_push_str(out, safe_ct)
    buf_push_str(out, "\r\nContent-Length: ")
    buf_append_i64(out, blen)
    buf_push_str(out, "\r\nConnection: keep-alive\r\n")
    buf_push_str(out, sec)
    if str_len(ex) > 0 {
        buf_push_str(out, ex)
        if not str_ends_with(ex, "\n") {
            buf_push_str(out, "\r\n")
        }
    }
    buf_push_str(out, "\r\n")
    if blen > 0 {
        buf_push_str(out, body)
    }
    return buf_to_owned_str(move out)
}

fn http_json_response(status_code: i64, json_body: str) -> str {
    return http_build_response(status_code, "application/json; charset=utf-8", json_body, "")
}

// Formats an SSE event frame for low-latency LLM streaming / realtime feeds
fn http_sse_event(event_name: str, data: str, event_id: str = "") -> str {
    b := buf_new(str_len(event_name) + str_len(data) + str_len(event_id) + 32)
    if str_len(event_id) > 0 and http_is_safe_header_val(event_id) {
        buf_push_str(b, "id: ")
        buf_push_str(b, event_id)
        buf_push(b, 10)
    }
    if str_len(event_name) > 0 and http_is_safe_header_val(event_name) {
        buf_push_str(b, "event: ")
        buf_push_str(b, event_name)
        buf_push(b, 10)
    }
    buf_push_str(b, "data: ")
    // Sanitize newlines inside single-line data frame to prevent frame smuggling
    clean_data := str_replace(str_replace(data, "\r", ""), "\n", " ")
    buf_push_str(b, clean_data)
    buf_push(b, 10)
    buf_push(b, 10)
    return buf_to_owned_str(move b)
}
