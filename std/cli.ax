// Axon v1.0.0 Native CLI Parsing Helpers (`std/cli.ax`)
// Extends `std::data` (`cli_has_flag`, `cli_get_opt`) with typed integer & positional helpers cleanly.
// Native targets (`win-x64`, `linux-x64`, `macos-arm64`).

use std::os
use std::str
use std::data

fn cli_get_i64(flag: str, default_val: i64 = 0) -> i64 {
    raw := cli_get_opt(flag, "")
    if str_len(raw) == 0 { return default_val }
    return parse_i64(raw) or default_val
}

fn cli_require_opt(flag: str) -> str ! i64 {
    val := cli_get_opt(flag, "")
    if str_len(val) == 0 { return err(404) }
    return ok(val)
}

fn cli_pos_count() -> i64 {
    argc := args_count()
    mut cnt := 0
    mut i := 1
    while i < argc {
        a := args_get(i)
        if str_starts_with(a, "-") {
            if str_find_byte(a, 61, 0) < 0 and i + 1 < argc {
                next := args_get(i + 1)
                if not str_starts_with(next, "-") { i += 1 }
            }
        } else {
            cnt += 1
        }
        i += 1
    }
    return cnt
}

fn cli_pos_get(pos_idx: i64, default_val: str = "") -> str {
    if pos_idx < 0 { return default_val }
    argc := args_count()
    mut cur := 0
    mut i := 1
    while i < argc {
        a := args_get(i)
        if str_starts_with(a, "-") {
            if str_find_byte(a, 61, 0) < 0 and i + 1 < argc {
                next := args_get(i + 1)
                if not str_starts_with(next, "-") { i += 1 }
            }
        } else {
            if cur == pos_idx { return a }
            cur += 1
        }
        i += 1
    }
    return default_val
}
