// Axon Standard Library: Core Primitives & Deterministic Math
/// 4-element 32-bit floating point vector for SIMD vector arithmetic.
struct Vec4f {
    x: f32,
    y: f32,
    z: f32,
    w: f32,
}

/// 8-element 32-bit floating point vector for AVX2 / AVX-512 register saturation.
struct Vec8f {
    v0: f32,
    v1: f32,
    v2: f32,
    v3: f32,
    v4: f32,
    v5: f32,
    v6: f32,
    v7: f32,
}

/// Computes component-wise addition of two Vec4f vectors.
fn vec4_add(a: Vec4f, b: Vec4f) -> Vec4f {
    return Vec4f(a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w);
}

/// Computes fused multiply-add (a * b + c) without intermediate rounding.
fn vec4_fma(a: Vec4f, b: Vec4f, c: Vec4f) -> Vec4f {
    return Vec4f(a.x * b.x + c.x, a.y * b.y + c.y, a.z * b.z + c.z, a.w * b.w + c.w);
}

/// Clamps an integer value within the inclusive range [min_v, max_v].
fn clamp_i64(val: i64, min_v: i64, max_v: i64) -> i64 {
    if val < min_v {
        return min_v;
    }
    if val > max_v {
        return max_v;
    }
    return val;
}

/// Performs deterministic wrapping addition for 64-bit unsigned integers.
fn wrap_add_u64(a: i64, b: i64) -> i64 {
    return a +% b;
}

/// Performs deterministic saturating addition preventing overflow UB.
fn sat_add_u64(a: i64, b: i64) -> i64 {
    return a +! b;
}
