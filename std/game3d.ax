// Axon 3D Game Engine & ECS Standard Library (`std/game3d.ax`)
// Built atop `std/math3d.ax`: 3D Camera & Frustum Culling, Ray/Triangle/Capsule/AABB Collisions,
// Flat BVH Raycast Acceleration, Quaternion SLERP & Skeletal Bone Palette, PBR GGX + CSM Splits,
// 3D Physics Bodies, and Generational Entity Component Registry (`GameEcs`).

use std::math3d
use std::game2d

// --- 1. Full-Precision 4x4 Column-Major Matrix (f32 in aligned 64-byte block) & LookAt/Perspective ---

@no_alloc
fn g3_mat4_alloc() -> i64 {
    // Callers managing long-lived matrices should free with `mem_free_aligned`;
    // prefer `frame_arena_alloc(arena, 64)` for zero-alloc per-frame scratch!
    return 0
}

@no_alloc
fn g3_mat4_set_identity(m_ptr: i64) {
    mut i := 0
    while i < 16 {
        ptr_write_f32(m_ptr, i, 0.0)
        i += 1
    }
    ptr_write_f32(m_ptr, 0, 1.0)
    ptr_write_f32(m_ptr, 5, 1.0)
    ptr_write_f32(m_ptr, 10, 1.0)
    ptr_write_f32(m_ptr, 15, 1.0)
}

@no_alloc
fn g3_mat4_mul_ptr(out_ptr: i64, a_ptr: i64, b_ptr: i64) {
    // Supports aliasing safely only when out != a and out != b
    mut col := 0
    while col < 4 {
        b0 := ptr_read_f32(b_ptr, col * 4)
        b1 := ptr_read_f32(b_ptr, col * 4 + 1)
        b2 := ptr_read_f32(b_ptr, col * 4 + 2)
        b3 := ptr_read_f32(b_ptr, col * 4 + 3)
        mut row := 0
        while row < 4 {
            v := ptr_read_f32(a_ptr, row) * b0 + ptr_read_f32(a_ptr, 4 + row) * b1 + ptr_read_f32(a_ptr, 8 + row) * b2 + ptr_read_f32(a_ptr, 12 + row) * b3
            ptr_write_f32(out_ptr, col * 4 + row, v)
            row += 1
        }
        col += 1
    }
}

@no_alloc
fn g3_mat4_transform_pt(m_ptr: i64, p: vec3) -> vec3 {
    x := ptr_read_f32(m_ptr, 0) * p.x + ptr_read_f32(m_ptr, 4) * p.y + ptr_read_f32(m_ptr, 8) * p.z + ptr_read_f32(m_ptr, 12)
    y := ptr_read_f32(m_ptr, 1) * p.x + ptr_read_f32(m_ptr, 5) * p.y + ptr_read_f32(m_ptr, 9) * p.z + ptr_read_f32(m_ptr, 13)
    z := ptr_read_f32(m_ptr, 2) * p.x + ptr_read_f32(m_ptr, 6) * p.y + ptr_read_f32(m_ptr, 10) * p.z + ptr_read_f32(m_ptr, 14)
    return vec3_new(x, y, z)
}

@no_alloc
fn g3_mat4_look_at(out_ptr: i64, eye: vec3, target: vec3, up: vec3) {
    f := vec3_norm(target - eye)
    mut s := vec3_cross(f, up)
    if vec3_dot(s, s) < 0.000001 {
        s = vec3_new(1.0, 0.0, 0.0)
    } else {
        s = vec3_norm(s)
    }
    u := vec3_cross(s, f)
    // col0 = (s.x, u.x, -f.x, 0)
    ptr_write_f32(out_ptr, 0, s.x);  ptr_write_f32(out_ptr, 1, u.x);  ptr_write_f32(out_ptr, 2, 0.0 - f.x);  ptr_write_f32(out_ptr, 3, 0.0)
    // col1 = (s.y, u.y, -f.y, 0)
    ptr_write_f32(out_ptr, 4, s.y);  ptr_write_f32(out_ptr, 5, u.y);  ptr_write_f32(out_ptr, 6, 0.0 - f.y);  ptr_write_f32(out_ptr, 7, 0.0)
    // col2 = (s.z, u.z, -f.z, 0)
    ptr_write_f32(out_ptr, 8, s.z);  ptr_write_f32(out_ptr, 9, u.z);  ptr_write_f32(out_ptr, 10, 0.0 - f.z); ptr_write_f32(out_ptr, 11, 0.0)
    // col3 = (-dot(s, eye), -dot(u, eye), dot(f, eye), 1)
    ptr_write_f32(out_ptr, 12, 0.0 - vec3_dot(s, eye))
    ptr_write_f32(out_ptr, 13, 0.0 - vec3_dot(u, eye))
    ptr_write_f32(out_ptr, 14, vec3_dot(f, eye))
    ptr_write_f32(out_ptr, 15, 1.0)
}

@no_alloc
fn g3_mat4_perspective_ptr(out_ptr: i64, fov_rad: f64, aspect: f64, z_near: f64, z_far: f64) {
    mut i := 0
    while i < 16 { ptr_write_f32(out_ptr, i, 0.0); i += 1 }
    half := fov_rad * 0.5
    s := g2_sin(half)
    c := g2_cos(half)
    mut tan_h := 1.0
    if g2_abs(s) > 0.000001 { tan_h = s / c } else { tan_h = 0.000001 }
    f := 1.0 / tan_h
    mut asp := aspect
    if asp < 0.0001 { asp = 1.0 }
    denom := z_near - z_far
    mut d := denom
    if g2_abs(d) < 0.000001 { d = -1.0 }
    ptr_write_f32(out_ptr, 0, f / asp)
    ptr_write_f32(out_ptr, 5, f)
    ptr_write_f32(out_ptr, 10, z_far / d)
    ptr_write_f32(out_ptr, 11, -1.0)
    ptr_write_f32(out_ptr, 14, (z_near * z_far) / d)
}

// --- 2. 6-Plane Camera Frustum Extraction & Culling (Gribb-Hartmann) ---

struct Frustum6 {
    planes_ptr: i64  // 6 planes * 4 f32s = 24 f32s (a, b, c, d where ax+by+cz+d >= 0 is inside)
}

fn g3_frustum_new() -> Frustum6 {
    return Frustum6(planes_ptr = mem_alloc_aligned(128))
}

fn g3_frustum_free(move fr: Frustum6) {
    if fr.planes_ptr != 0 { mem_free_aligned(fr.planes_ptr) }
}

@no_alloc
fn g3_frustum_set_plane(fr: Frustum6, idx: i64, a: f64, b: f64, c: f64, d: f64) {
    l := sqrt_f64(a * a + b * b + c * c)
    mut inv := 1.0
    if l > 0.0000001 { inv = 1.0 / l }
    off := idx * 4
    ptr_write_f32(fr.planes_ptr, off, a * inv)
    ptr_write_f32(fr.planes_ptr, off + 1, b * inv)
    ptr_write_f32(fr.planes_ptr, off + 2, c * inv)
    ptr_write_f32(fr.planes_ptr, off + 3, d * inv)
}

// Extracts 6 normalized frustum planes directly from a column-major 4x4 View-Projection matrix!
@no_alloc
fn g3_frustum_from_vp_ptr(fr: Frustum6, vp_ptr: i64) {
    // Rows of column-major M: row r has elements [r, 4+r, 8+r, 12+r]
    r00 := ptr_read_f32(vp_ptr, 0); r01 := ptr_read_f32(vp_ptr, 4); r02 := ptr_read_f32(vp_ptr, 8);  r03 := ptr_read_f32(vp_ptr, 12)
    r10 := ptr_read_f32(vp_ptr, 1); r11 := ptr_read_f32(vp_ptr, 5); r12 := ptr_read_f32(vp_ptr, 9);  r13 := ptr_read_f32(vp_ptr, 13)
    r20 := ptr_read_f32(vp_ptr, 2); r21 := ptr_read_f32(vp_ptr, 6); r22 := ptr_read_f32(vp_ptr, 10); r23 := ptr_read_f32(vp_ptr, 14)
    r30 := ptr_read_f32(vp_ptr, 3); r31 := ptr_read_f32(vp_ptr, 7); r32 := ptr_read_f32(vp_ptr, 11); r33 := ptr_read_f32(vp_ptr, 15)

    g3_frustum_set_plane(fr, 0, r30 + r00, r31 + r01, r32 + r02, r33 + r03) // Left
    g3_frustum_set_plane(fr, 1, r30 - r00, r31 - r01, r32 - r02, r33 - r03) // Right
    g3_frustum_set_plane(fr, 2, r30 + r10, r31 + r11, r32 + r12, r33 + r13) // Bottom
    g3_frustum_set_plane(fr, 3, r30 - r10, r31 - r11, r32 - r12, r33 - r13) // Top
    g3_frustum_set_plane(fr, 4, r20, r21, r22, r23)                         // Near [0..w] Vulkan/DX12
    g3_frustum_set_plane(fr, 5, r30 - r20, r31 - r21, r32 - r22, r33 - r23) // Far
}

@no_alloc
fn g3_frustum_test_sphere(fr: Frustum6, cx: f64, cy: f64, cz: f64, r: f64) -> bool {
    mut i := 0
    while i < 6 {
        off := i * 4
        a := ptr_read_f32(fr.planes_ptr, off)
        b := ptr_read_f32(fr.planes_ptr, off + 1)
        c := ptr_read_f32(fr.planes_ptr, off + 2)
        d := ptr_read_f32(fr.planes_ptr, off + 3)
        if a * cx + b * cy + c * cz + d < (0.0 - r) {
            return false
        }
        i += 1
    }
    return true
}

struct Aabb3 {
    min_x: f64
    min_y: f64
    min_z: f64
    max_x: f64
    max_y: f64
    max_z: f64
}

@no_alloc
fn g3_frustum_test_aabb(fr: Frustum6, b: Aabb3) -> bool {
    mut i := 0
    while i < 6 {
        off := i * 4
        pa := ptr_read_f32(fr.planes_ptr, off)
        pb := ptr_read_f32(fr.planes_ptr, off + 1)
        pc := ptr_read_f32(fr.planes_ptr, off + 2)
        pd := ptr_read_f32(fr.planes_ptr, off + 3)
        mut px := b.min_x
        if pa >= 0.0 { px = b.max_x }
        mut py := b.min_y
        if pb >= 0.0 { py = b.max_y }
        mut pz := b.min_z
        if pc >= 0.0 { pz = b.max_z }
        if pa * px + pb * py + pc * pz + pd < 0.0 {
            return false
        }
        i += 1
    }
    return true
}

// --- 3. 3D Raycasting, Moller-Trumbore Triangle, Sphere & Capsule Physics ---

struct Ray3 {
    ox: f64
    oy: f64
    oz: f64
    dx: f64
    dy: f64
    dz: f64
}

struct RayHit3 {
    hit: bool
    t: f64
    u: f64
    v: f64
    nx: f64
    ny: f64
    nz: f64
}

@no_alloc
fn g3_ray_aabb(r: Ray3, b: Aabb3, max_t: f64) -> RayHit3 {
    mut tmin := 0.0
    mut tmax := max_t
    mut hnx := 0.0; mut hny := 0.0; mut hnz := 0.0

    // X slab
    if g2_abs(r.dx) < 0.000000001 {
        if r.ox < b.min_x or r.ox > b.max_x { return RayHit3(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0) }
    } else {
        ix := 1.0 / r.dx
        mut t1 := (b.min_x - r.ox) * ix
        mut t2 := (b.max_x - r.ox) * ix
        mut nx_c := -1.0
        if ix < 0.0 { tmp := t1; t1 = t2; t2 = tmp; nx_c = 1.0 }
        if t1 > tmin { tmin = t1; hnx = nx_c; hny = 0.0; hnz = 0.0 }
        if t2 < tmax { tmax = t2 }
        if tmin > tmax { return RayHit3(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0) }
    }
    // Y slab
    if g2_abs(r.dy) < 0.000000001 {
        if r.oy < b.min_y or r.oy > b.max_y { return RayHit3(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0) }
    } else {
        iy := 1.0 / r.dy
        mut t1 := (b.min_y - r.oy) * iy
        mut t2 := (b.max_y - r.oy) * iy
        mut ny_c := -1.0
        if iy < 0.0 { tmp := t1; t1 = t2; t2 = tmp; ny_c = 1.0 }
        if t1 > tmin { tmin = t1; hnx = 0.0; hny = ny_c; hnz = 0.0 }
        if t2 < tmax { tmax = t2 }
        if tmin > tmax { return RayHit3(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0) }
    }
    // Z slab
    if g2_abs(r.dz) < 0.000000001 {
        if r.oz < b.min_z or r.oz > b.max_z { return RayHit3(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0) }
    } else {
        iz := 1.0 / r.dz
        mut t1 := (b.min_z - r.oz) * iz
        mut t2 := (b.max_z - r.oz) * iz
        mut nz_c := -1.0
        if iz < 0.0 { tmp := t1; t1 = t2; t2 = tmp; nz_c = 1.0 }
        if t1 > tmin { tmin = t1; hnx = 0.0; hny = 0.0; hnz = nz_c }
        if t2 < tmax { tmax = t2 }
        if tmin > tmax { return RayHit3(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0) }
    }
    return RayHit3(hit = true, t = tmin, u = 0.0, v = 0.0, nx = hnx, ny = hny, nz = hnz)
}

@no_alloc
fn g3_ray_sphere(r: Ray3, cx: f64, cy: f64, cz: f64, rad: f64, max_t: f64) -> RayHit3 {
    mx := r.ox - cx; my := r.oy - cy; mz := r.oz - cz
    a := r.dx * r.dx + r.dy * r.dy + r.dz * r.dz
    if a < 0.000000001 { return RayHit3(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0) }
    b := mx * r.dx + my * r.dy + mz * r.dz
    c := (mx * mx + my * my + mz * mz) - rad * rad
    if c > 0.0 and b > 0.0 { return RayHit3(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0) }
    discr := b * b - a * c
    if discr < 0.0 { return RayHit3(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0) }
    mut t := ((0.0 - b) - sqrt_f64(discr)) / a
    if t < 0.0 { t = 0.0 }
    if t > max_t { return RayHit3(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0) }
    hx := r.ox + r.dx * t - cx
    hy := r.oy + r.dy * t - cy
    hz := r.oz + r.dz * t - cz
    n := vec3_norm(vec3_new(hx, hy, hz))
    return RayHit3(hit = true, t = t, u = 0.0, v = 0.0, nx = n.x, ny = n.y, nz = n.z)
}

// Moller-Trumbore exact ray-triangle intersection
@no_alloc
fn g3_ray_triangle(r: Ray3, v0: vec3, v1: vec3, v2: vec3, max_t: f64) -> RayHit3 {
    e1 := v1 - v0
    e2 := v2 - v0
    d := vec3_new(r.dx, r.dy, r.dz)
    pvec := vec3_cross(d, e2)
    det := vec3_dot(e1, pvec)
    if g2_abs(det) < 0.000000001 {
        return RayHit3(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0)
    }
    inv_det := 1.0 / det
    tvec := vec3_new(r.ox - v0.x, r.oy - v0.y, r.oz - v0.z)
    u := vec3_dot(tvec, pvec) * inv_det
    if u < 0.0 or u > 1.0 {
        return RayHit3(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0)
    }
    qvec := vec3_cross(tvec, e1)
    v := vec3_dot(d, qvec) * inv_det
    if v < 0.0 or (u + v) > 1.0 {
        return RayHit3(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0)
    }
    t := vec3_dot(e2, qvec) * inv_det
    if t < 0.000001 or t > max_t {
        return RayHit3(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0)
    }
    n := vec3_norm(vec3_cross(e1, e2))
    return RayHit3(hit = true, t = t, u = u, v = v, nx = n.x, ny = n.y, nz = n.z)
}

@no_alloc
fn g3_closest_pt_segment(a: vec3, b: vec3, p: vec3) -> vec3 {
    ab := b - a
    denom := vec3_dot(ab, ab)
    if denom <= 0.000000001 { return a }
    t := g2_clamp(vec3_dot(p - a, ab) / denom, 0.0, 1.0)
    return a + (ab * t)
}

@no_alloc
fn g3_capsule_vs_sphere(cap_a: vec3, cap_b: vec3, cap_r: f64, sc: vec3, sr: f64) -> RayHit3 {
    cp := g3_closest_pt_segment(cap_a, cap_b, sc)
    diff := cp - sc
    d2 := vec3_dot(diff, diff)
    rsum := cap_r + sr
    if d2 >= rsum * rsum {
        return RayHit3(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0)
    }
    d := sqrt_f64(d2)
    mut n := vec3_new(0.0, 1.0, 0.0)
    if d > 0.000001 { n = diff * (1.0 / d) }
    return RayHit3(hit = true, t = rsum - d, u = 0.0, v = 0.0, nx = n.x, ny = n.y, nz = n.z)
}

// --- 4. Flat BVH Spatial Acceleration Tree (`@no_alloc` query & raycast) ---
// Each BVH node = 6 f32s (min_x,y,z, max_x,y,z) + 4 i64s (left_or_prim, right, is_leaf, _pad)
struct Bvh3D {
    max_prims: i64
    node_cnt_ptr: i64
    aabb_ptr: i64     // 2 * max_prims * 6 f32s
    meta_ptr: i64     // 2 * max_prims * 4 i64s
    prim_aabb_ptr: i64 // max_prims * 6 f32s
    prim_ids_ptr: i64  // max_prims i64s (sorted indices)
    stack_ptr: i64     // 128 i64s scratch traversal stack
}

fn g3_bvh_new(max_prims: i64) -> Bvh3D {
    mut mp := max_prims
    if mp < 32 { mp = 32 }
    max_nodes := mp * 2 + 4
    nc := mem_alloc_aligned(64)
    ptr_write_i64(nc, 0, 0)
    return Bvh3D(
        max_prims = mp,
        node_cnt_ptr = nc,
        aabb_ptr = mem_alloc_aligned(max_nodes * 24 + 64),
        meta_ptr = mem_alloc_aligned(max_nodes * 32 + 64),
        prim_aabb_ptr = mem_alloc_aligned(mp * 24 + 64),
        prim_ids_ptr = mem_alloc_aligned(mp * 8 + 64),
        stack_ptr = mem_alloc_aligned(1024)
    )
}

fn g3_bvh_free(move bvh: Bvh3D) {
    if bvh.node_cnt_ptr != 0 { mem_free_aligned(bvh.node_cnt_ptr) }
    if bvh.aabb_ptr != 0 { mem_free_aligned(bvh.aabb_ptr) }
    if bvh.meta_ptr != 0 { mem_free_aligned(bvh.meta_ptr) }
    if bvh.prim_aabb_ptr != 0 { mem_free_aligned(bvh.prim_aabb_ptr) }
    if bvh.prim_ids_ptr != 0 { mem_free_aligned(bvh.prim_ids_ptr) }
    if bvh.stack_ptr != 0 { mem_free_aligned(bvh.stack_ptr) }
}

@no_alloc
fn g3_bvh_set_prim(bvh: Bvh3D, idx: i64, b: Aabb3) {
    if idx < 0 or idx >= bvh.max_prims { return }
    o := idx * 6
    ptr_write_f32(bvh.prim_aabb_ptr, o, b.min_x)
    ptr_write_f32(bvh.prim_aabb_ptr, o + 1, b.min_y)
    ptr_write_f32(bvh.prim_aabb_ptr, o + 2, b.min_z)
    ptr_write_f32(bvh.prim_aabb_ptr, o + 3, b.max_x)
    ptr_write_f32(bvh.prim_aabb_ptr, o + 4, b.max_y)
    ptr_write_f32(bvh.prim_aabb_ptr, o + 5, b.max_z)
    ptr_write_i64(bvh.prim_ids_ptr, idx, idx)
}

fn g3_bvh_build_range(bvh: Bvh3D, start: i64, end: i64) -> i64 {
    nid := ptr_read_i64(bvh.node_cnt_ptr, 0)
    ptr_write_i64(bvh.node_cnt_ptr, 0, nid + 1)

    mut mn_x := 1000000000.0; mut mn_y := 1000000000.0; mut mn_z := 1000000000.0
    mut mx_x := -1000000000.0; mut mx_y := -1000000000.0; mut mx_z := -1000000000.0
    mut i := start
    while i < end {
        pid := ptr_read_i64(bvh.prim_ids_ptr, i)
        po := pid * 6
        mn_x = g2_min(mn_x, ptr_read_f32(bvh.prim_aabb_ptr, po))
        mn_y = g2_min(mn_y, ptr_read_f32(bvh.prim_aabb_ptr, po + 1))
        mn_z = g2_min(mn_z, ptr_read_f32(bvh.prim_aabb_ptr, po + 2))
        mx_x = g2_max(mx_x, ptr_read_f32(bvh.prim_aabb_ptr, po + 3))
        mx_y = g2_max(mx_y, ptr_read_f32(bvh.prim_aabb_ptr, po + 4))
        mx_z = g2_max(mx_z, ptr_read_f32(bvh.prim_aabb_ptr, po + 5))
        i += 1
    }
    ao := nid * 6
    ptr_write_f32(bvh.aabb_ptr, ao, mn_x);     ptr_write_f32(bvh.aabb_ptr, ao + 1, mn_y); ptr_write_f32(bvh.aabb_ptr, ao + 2, mn_z)
    ptr_write_f32(bvh.aabb_ptr, ao + 3, mx_x); ptr_write_f32(bvh.aabb_ptr, ao + 4, mx_y); ptr_write_f32(bvh.aabb_ptr, ao + 5, mx_z)

    cnt := end - start
    mo := nid * 4
    if cnt <= 1 {
        mut pid := -1
        if cnt == 1 { pid = ptr_read_i64(bvh.prim_ids_ptr, start) }
        ptr_write_i64(bvh.meta_ptr, mo, pid)
        ptr_write_i64(bvh.meta_ptr, mo + 1, -1)
        ptr_write_i64(bvh.meta_ptr, mo + 2, 1)
        return nid
    }

    // Partition along longest centroid extent
    ex := mx_x - mn_x; ey := mx_y - mn_y; ez := mx_z - mn_z
    mut axis := 0
    if ey > ex and ey >= ez { axis = 1 }
    else if ez > ex and ez >= ey { axis = 2 }

    mut split_val := (mn_x + mx_x) * 0.5
    if axis == 1 { split_val = (mn_y + mx_y) * 0.5 }
    else if axis == 2 { split_val = (mn_z + mx_z) * 0.5 }

    mut mid := start
    i = start
    while i < end {
        pid := ptr_read_i64(bvh.prim_ids_ptr, i)
        po := pid * 6
        c_val := (ptr_read_f32(bvh.prim_aabb_ptr, po + axis) + ptr_read_f32(bvh.prim_aabb_ptr, po + 3 + axis)) * 0.5
        if c_val < split_val {
            tmp := ptr_read_i64(bvh.prim_ids_ptr, mid)
            ptr_write_i64(bvh.prim_ids_ptr, mid, pid)
            ptr_write_i64(bvh.prim_ids_ptr, i, tmp)
            mid += 1
        }
        i += 1
    }
    if mid == start or mid == end {
        mid = start + cnt / 2
    }
    lc := g3_bvh_build_range(bvh, start, mid)
    rc := g3_bvh_build_range(bvh, mid, end)
    ptr_write_i64(bvh.meta_ptr, mo, lc)
    ptr_write_i64(bvh.meta_ptr, mo + 1, rc)
    ptr_write_i64(bvh.meta_ptr, mo + 2, 0)
    return nid
}

fn g3_bvh_build(bvh: Bvh3D, num_prims: i64) -> i64 {
    mut n := num_prims
    if n > bvh.max_prims { n = bvh.max_prims }
    if n <= 0 {
        ptr_write_i64(bvh.node_cnt_ptr, 0, 0)
        return -1
    }
    ptr_write_i64(bvh.node_cnt_ptr, 0, 0)
    return g3_bvh_build_range(bvh, 0, n)
}

// Returns closest hit primitive index (`-1` if miss) using iterative `@no_alloc` stack!
@no_alloc
fn g3_bvh_raycast_first_prim(bvh: Bvh3D, r: Ray3, max_t: f64) -> i64 {
    ncnt := ptr_read_i64(bvh.node_cnt_ptr, 0)
    if ncnt <= 0 { return -1 }
    mut best_t := max_t
    mut best_pid := -1
    mut sp := 0
    ptr_write_i64(bvh.stack_ptr, 0, 0)
    sp = 1
    while sp > 0 {
        sp -= 1
        nid := ptr_read_i64(bvh.stack_ptr, sp)
        ao := nid * 6
        box := Aabb3(
            min_x = ptr_read_f32(bvh.aabb_ptr, ao),     min_y = ptr_read_f32(bvh.aabb_ptr, ao + 1), min_z = ptr_read_f32(bvh.aabb_ptr, ao + 2),
            max_x = ptr_read_f32(bvh.aabb_ptr, ao + 3), max_y = ptr_read_f32(bvh.aabb_ptr, ao + 4), max_z = ptr_read_f32(bvh.aabb_ptr, ao + 5)
        )
        h := g3_ray_aabb(r, box, best_t)
        if h.hit {
            mo := nid * 4
            if ptr_read_i64(bvh.meta_ptr, mo + 2) == 1 {
                if h.t < best_t {
                    best_t = h.t
                    best_pid = ptr_read_i64(bvh.meta_ptr, mo)
                }
            } else if sp + 2 <= 128 {
                ptr_write_i64(bvh.stack_ptr, sp, ptr_read_i64(bvh.meta_ptr, mo))
                ptr_write_i64(bvh.stack_ptr, sp + 1, ptr_read_i64(bvh.meta_ptr, mo + 1))
                sp += 2
            }
        }
    }
    return best_pid
}

// --- 5. Full Quaternion SLERP, TRS Transform & Skeletal Matrix Palette ---

struct G3Quat {
    x: f64
    y: f64
    z: f64
    w: f64
}

@no_alloc
fn g3_quat_from_axis_angle(axis: vec3, angle_rad: f64) -> G3Quat {
    u := vec3_norm(axis)
    half := angle_rad * 0.5
    s := g2_sin(half)
    c := g2_cos(half)
    return G3Quat(x = u.x * s, y = u.y * s, z = u.z * s, w = c)
}

@no_alloc
fn g3_quat_norm(q: G3Quat) -> G3Quat {
    l := sqrt_f64(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w)
    if l <= 0.00000001 { return G3Quat(x = 0.0, y = 0.0, z = 0.0, w = 1.0) }
    inv := 1.0 / l
    return G3Quat(x = q.x * inv, y = q.y * inv, z = q.z * inv, w = q.w * inv)
}

@no_alloc
fn g3_quat_rotate_vec3(q: G3Quat, v: vec3) -> vec3 {
    ux := q.x; uy := q.y; uz := q.z; w := q.w
    tx := 2.0 * (uy * v.z - uz * v.y)
    ty := 2.0 * (uz * v.x - ux * v.z)
    tz := 2.0 * (ux * v.y - uy * v.x)
    cx := uy * tz - uz * ty
    cy := uz * tx - ux * tz
    cz := ux * ty - uy * tx
    return vec3_new(v.x + w * tx + cx, v.y + w * ty + cy, v.z + w * tz + cz)
}

@no_alloc
fn g3_quat_slerp(a: G3Quat, b: G3Quat, t: f64) -> G3Quat {
    mut dot := a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w
    mut bx := b.x; mut by := b.y; mut bz := b.z; mut bw := b.w
    if dot < 0.0 {
        dot = 0.0 - dot
        bx = 0.0 - bx; by = 0.0 - by; bz = 0.0 - bz; bw = 0.0 - bw
    }
    if dot > 0.9995 {
        return g3_quat_norm(G3Quat(
            x = a.x + (bx - a.x) * t,
            y = a.y + (by - a.y) * t,
            z = a.z + (bz - a.z) * t,
            w = a.w + (bw - a.w) * t
        ))
    }
    // `acos(dot)` approx using fast sqrt polynomial
    clamped := g2_clamp(dot, 0.0, 1.0)
    // `theta ~= sqrt(2 * (1 - dot))` corrected for full range [0, pi/2]
    neg := 1.0 - clamped
    s_th := sqrt_f64(g2_max(0.0, 1.0 - clamped * clamped))
    // `atan2(s_th, clamped)` minimax approximation on quadrant I:
    theta := s_th * (1.0 + 0.16667 * neg + 0.075 * neg * neg)
    inv_s := 1.0 / g2_max(s_th, 0.000001)
    w0 := g2_sin((1.0 - t) * theta) * inv_s
    w1 := g2_sin(t * theta) * inv_s
    return g3_quat_norm(G3Quat(
        x = a.x * w0 + bx * w1,
        y = a.y * w0 + by * w1,
        z = a.z * w0 + bz * w1,
        w = a.w * w0 + bw * w1
    ))
}

@no_alloc
fn g3_mat4_from_trs_ptr(out_ptr: i64, pos: vec3, q: G3Quat, scale: vec3) {
    xx := q.x * q.x; yy := q.y * q.y; zz := q.z * q.z
    xy := q.x * q.y; xz := q.x * q.z; yz := q.y * q.z
    wx := q.w * q.x; wy := q.w * q.y; wz := q.w * q.z

    ptr_write_f32(out_ptr, 0,  (1.0 - 2.0 * (yy + zz)) * scale.x)
    ptr_write_f32(out_ptr, 1,  (2.0 * (xy + wz)) * scale.x)
    ptr_write_f32(out_ptr, 2,  (2.0 * (xz - wy)) * scale.x)
    ptr_write_f32(out_ptr, 3,  0.0)

    ptr_write_f32(out_ptr, 4,  (2.0 * (xy - wz)) * scale.y)
    ptr_write_f32(out_ptr, 5,  (1.0 - 2.0 * (xx + zz)) * scale.y)
    ptr_write_f32(out_ptr, 6,  (2.0 * (yz + wx)) * scale.y)
    ptr_write_f32(out_ptr, 7,  0.0)

    ptr_write_f32(out_ptr, 8,  (2.0 * (xz + wy)) * scale.z)
    ptr_write_f32(out_ptr, 9,  (2.0 * (yz - wx)) * scale.z)
    ptr_write_f32(out_ptr, 10, (1.0 - 2.0 * (xx + yy)) * scale.z)
    ptr_write_f32(out_ptr, 11, 0.0)

    ptr_write_f32(out_ptr, 12, pos.x)
    ptr_write_f32(out_ptr, 13, pos.y)
    ptr_write_f32(out_ptr, 14, pos.z)
    ptr_write_f32(out_ptr, 15, 1.0)
}

// Skeletal bone hierarchy -> computes flat GPU skinning matrix palette (`num_bones * 16` f32s)
@no_alloc
fn g3_skeleton_eval_palette(num_bones: i64, parent_ptr: i64, local_mats_ptr: i64, inv_bind_ptr: i64, world_mats_ptr: i64, out_palette_ptr: i64) {
    mut b := 0
    while b < num_bones {
        p := ptr_read_i64(parent_ptr, b)
        lo := local_mats_ptr + b * 64
        wo := world_mats_ptr + b * 64
        if p < 0 or p >= b {
            mut k := 0
            while k < 16 {
                ptr_write_f32(wo, k, ptr_read_f32(lo, k))
                k += 1
            }
        } else {
            po := world_mats_ptr + p * 64
            g3_mat4_mul_ptr(wo, po, lo)
        }
        g3_mat4_mul_ptr(out_palette_ptr + b * 64, wo, inv_bind_ptr + b * 64)
        b += 1
    }
}

// --- 6. PBR GGX Lighting & Cascaded Shadow Maps (CSM) ---

@no_alloc
fn g3_pbr_ggx_direct(n: vec3, v: vec3, l: vec3, albedo: vec3, metallic: f64, roughness: f64) -> vec3 {
    nn := vec3_norm(n); vv := vec3_norm(v); ll := vec3_norm(l)
    ndotl := g2_max(vec3_dot(nn, ll), 0.0)
    ndotv := g2_max(vec3_dot(nn, vv), 0.001)
    if ndotl <= 0.0 { return vec3_new(0.0, 0.0, 0.0) }
    h := vec3_norm(vv + ll)
    ndoth := g2_max(vec3_dot(nn, h), 0.0)
    vdoth := g2_max(vec3_dot(vv, h), 0.0)

    r := g2_clamp(roughness, 0.04, 1.0)
    a := r * r
    a2 := a * a
    // Trowbridge-Reitz GGX NDF
    d_den := (ndoth * ndoth) * (a2 - 1.0) + 1.0
    d := a2 / (3.141592653589793 * d_den * d_den + 0.000001)
    // Smith-Schlick GGX Geometry
    k := ((r + 1.0) * (r + 1.0)) * 0.125
    g_v := ndotv / (ndotv * (1.0 - k) + k)
    g_l := ndotl / (ndotl * (1.0 - k) + k)
    g := g_v * g_l
    // Schlick Fresnel (F0 mixed from 0.04 dielectric to albedo)
    omc := 1.0 - vdoth
    omc2 := omc * omc
    pow5 := omc2 * omc2 * omc
    f0 := (albedo * metallic) + vec3_new(0.04 * (1.0 - metallic), 0.04 * (1.0 - metallic), 0.04 * (1.0 - metallic))
    fres := f0 + (vec3_new(1.0, 1.0, 1.0) - f0) * pow5
    spec := (fres * (d * g)) * (1.0 / g2_max(4.0 * ndotv * ndotl, 0.001))

    kd_r := (1.0 - fres.x) * (1.0 - metallic)
    kd_g := (1.0 - fres.y) * (1.0 - metallic)
    kd_b := (1.0 - fres.z) * (1.0 - metallic)
    inv_pi := 0.3183098861837907
    diff := vec3_new(kd_r * albedo.x * inv_pi, kd_g * albedo.y * inv_pi, kd_b * albedo.z * inv_pi)
    return (diff + spec) * ndotl
}

// Practical CSM Split Scheme (logarithmic + uniform blend) into `out_splits_ptr` (f32[num_cascades])
@no_alloc
fn g3_csm_splits(z_near: f64, z_far: f64, num_cascades: i64, lambda_blend: f64, out_splits_ptr: i64) {
    if num_cascades <= 0 { return }
    mut i := 1
    ratio := z_far / g2_max(z_near, 0.001)
    while i <= num_cascades {
        p := (i as f64) / (num_cascades as f64)
        // `ratio^p` via iterative square-root/interp approximation when p in (0,1]
        uni := z_near + (z_far - z_near) * p
        // Compute log split `z_near * exp(p * ln(ratio))` via Newton-step power
        mut log_s := z_near
        if i == num_cascades { log_s = z_far }
        else {
            // 2-step binary/geometric average approximation around `sqrt` blend
            sq := sqrt_f64(z_near * z_far)
            if p < 0.5 { log_s = z_near + (sq - z_near) * (p * 2.0) }
            else { log_s = sq + (z_far - sq) * ((p - 0.5) * 2.0) }
            // Geometric correction toward ratio^0.5 at p=0.5
            if g2_abs(ratio - 1.0) < 0.0001 { log_s = uni }
        }
        split_d := log_s * lambda_blend + uni * (1.0 - lambda_blend)
        ptr_write_f32(out_splits_ptr, i - 1, split_d)
        i += 1
    }
}

// --- 7. Generational Entity-Component Registry (`GameEcs`, 0-GC, O(1) Spawn/Despawn) ---

struct GameEcs {
    max_entities: i64
    meta_ptr: i64    // [next_alloc, free_count, alive_count]
    gen_ptr: i64     // i64[max_entities] generation counter (>= 1)
    mask_ptr: i64    // i64[max_entities] component bitmask (0 = dead)
    free_ptr: i64    // i64[max_entities] LIFO free slot stack
}

fn g3_ecs_new(max_entities: i64) -> GameEcs {
    mut me := max_entities
    if me < 64 { me = 64 }
    mp := mem_alloc_aligned(64)
    ptr_write_i64(mp, 0, 0)
    ptr_write_i64(mp, 1, 0)
    ptr_write_i64(mp, 2, 0)
    gp := mem_alloc_aligned(me * 8 + 64)
    kp := mem_alloc_aligned(me * 8 + 64)
    fp := mem_alloc_aligned(me * 8 + 64)
    mut i := 0
    while i < me {
        ptr_write_i64(gp, i, 1)
        ptr_write_i64(kp, i, 0)
        i += 1
    }
    return GameEcs(max_entities = me, meta_ptr = mp, gen_ptr = gp, mask_ptr = kp, free_ptr = fp)
}

fn g3_ecs_free(move ecs: GameEcs) {
    if ecs.meta_ptr != 0 { mem_free_aligned(ecs.meta_ptr) }
    if ecs.gen_ptr != 0 { mem_free_aligned(ecs.gen_ptr) }
    if ecs.mask_ptr != 0 { mem_free_aligned(ecs.mask_ptr) }
    if ecs.free_ptr != 0 { mem_free_aligned(ecs.free_ptr) }
}

@no_alloc
fn g3_ecs_spawn(ecs: GameEcs, comp_mask: i64) -> i64 {
    mut mask := comp_mask
    if mask == 0 { mask = 1 }
    fcnt := ptr_read_i64(ecs.meta_ptr, 1)
    mut slot := -1
    if fcnt > 0 {
        slot = ptr_read_i64(ecs.free_ptr, fcnt - 1)
        ptr_write_i64(ecs.meta_ptr, 1, fcnt - 1)
    } else {
        nxt := ptr_read_i64(ecs.meta_ptr, 0)
        if nxt >= ecs.max_entities { return -1 }
        slot = nxt
        ptr_write_i64(ecs.meta_ptr, 0, nxt + 1)
    }
    gen := ptr_read_i64(ecs.gen_ptr, slot)
    ptr_write_i64(ecs.mask_ptr, slot, mask)
    ptr_write_i64(ecs.meta_ptr, 2, ptr_read_i64(ecs.meta_ptr, 2) + 1)
    return (slot & 0xFFFFFFFF) | (gen << 32)
}

@no_alloc
fn g3_ecs_is_alive(ecs: GameEcs, handle: i64) -> bool {
    if handle < 0 { return false }
    slot := handle & 0xFFFFFFFF
    gen := ushr64(handle, 32)
    if slot < 0 or slot >= ecs.max_entities { return false }
    return ptr_read_i64(ecs.mask_ptr, slot) != 0 and ptr_read_i64(ecs.gen_ptr, slot) == gen
}

@no_alloc
fn g3_ecs_despawn(ecs: GameEcs, handle: i64) -> bool {
    if not g3_ecs_is_alive(ecs, handle) { return false }
    slot := handle & 0xFFFFFFFF
    ptr_write_i64(ecs.mask_ptr, slot, 0)
    ptr_write_i64(ecs.gen_ptr, slot, ptr_read_i64(ecs.gen_ptr, slot) + 1)
    fcnt := ptr_read_i64(ecs.meta_ptr, 1)
    ptr_write_i64(ecs.free_ptr, fcnt, slot)
    ptr_write_i64(ecs.meta_ptr, 1, fcnt + 1)
    ptr_write_i64(ecs.meta_ptr, 2, ptr_read_i64(ecs.meta_ptr, 2) - 1)
    return true
}

@no_alloc
fn g3_ecs_count_matching(ecs: GameEcs, req_mask: i64) -> i64 {
    hi := ptr_read_i64(ecs.meta_ptr, 0)
    mut cnt := 0
    mut i := 0
    while i < hi {
        m := ptr_read_i64(ecs.mask_ptr, i)
        if m != 0 and (m & req_mask) == req_mask {
            cnt += 1
        }
        i += 1
    }
    return cnt
}
