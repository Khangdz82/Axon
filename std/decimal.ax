// Axon v7.0 Exact Fixed-Point Financial & HFT Decimal Library (`std/decimal.ax`)
// Native `dec` 64-bit scaled integers (scale = 10_000) eliminate IEEE-754 rounding drift:
// `0.10d + 0.20d == 0.30d` in 1 CPU cycle (`ADD RAX, RCX` + hardware `JO` overflow guard).

@no_alloc
fn dec_abs(x: dec) -> dec {
    if x < 0.00d {
        return 0.00d - x
    }
    return x
}

@no_alloc
fn dec_min(a: dec, b: dec) -> dec {
    if a < b {
        return a
    }
    return b
}

@no_alloc
fn dec_max(a: dec, b: dec) -> dec {
    if a > b {
        return a
    }
    return b
}

// IEEE-754 / GAAP Banker's Rounding (`round_half_even`) to exact cents (`0.01d`).
// Ties (`0.0050d`) round to the nearest even cent (`1.2250d -> 1.22d`, `1.2350d -> 1.24d`).
@no_alloc
fn round_half_even(val: dec) -> dec {
    mut neg := false
    mut v := val
    if v < 0.00d {
        neg = true
        v = 0.00d - v
    }
    cents_trunc := (v / 100) * 100
    rem := v - cents_trunc
    mut rounded := cents_trunc
    if rem > 0.0050d {
        rounded = cents_trunc + 0.01d
    } else if rem == 0.0050d {
        even_check := (cents_trunc / 200) * 200
        if cents_trunc != even_check {
            rounded = cents_trunc + 0.01d
        }
    }
    if neg {
        return 0.00d - rounded
    }
    return rounded
}

@no_alloc
fn checked_dec_add(a: dec, b: dec) -> dec ! i64 {
    limit := 1000000000.00d * 900000
    neg_limit := 0.00d - limit
    if b > 0.00d and a > (limit - b) {
        return err(701)
    }
    if b < 0.00d and a < (neg_limit - b) {
        return err(701)
    }
    return ok(a + b)
}

@no_alloc
fn checked_dec_sub(a: dec, b: dec) -> dec ! i64 {
    limit := 1000000000.00d * 900000
    neg_limit := 0.00d - limit
    if b < 0.00d and a > (limit + b) {
        return err(702)
    }
    if b > 0.00d and a < (neg_limit + b) {
        return err(702)
    }
    return ok(a - b)
}

@no_alloc
fn checked_dec_mul(a: dec, b: dec) -> dec ! i64 {
    aa := dec_abs(a)
    bb := dec_abs(b)
    safe_factor := 300000.00d
    if aa > safe_factor and bb > safe_factor {
        return err(703)
    }
    return ok(a * b)
}

@no_alloc
fn apply_tax(subtotal: dec, rate_pct: dec = 0.08d) -> dec {
    return subtotal + (subtotal * rate_pct)
}

@no_alloc
fn apply_discount(price: dec, discount_pct: dec) -> dec {
    cut := price * discount_pct
    if cut >= price {
        return 0.00d
    }
    return price - cut
}

@no_alloc
fn compound_periods(principal: dec, rate_per_period: dec, periods: i64) -> dec {
    mut balance := principal
    mut i := 0
    while i < periods {
        balance = balance + (balance * rate_per_period)
        i += 1
    }
    return balance
}

@no_alloc
fn split_exact_cents(total: dec, ways: i64) -> (dec, dec) {
    if ways <= 0 {
        return (0.00d, total)
    }
    share := total / ways
    remainder := total - (share * ways)
    return (share, remainder)
}
