// Axon Production AI Agent Evaluation & Regression Gate Library (`std/ai_eval.ax`)
// 100% Pure Axon, Zero-GC, Zero Python:
//   1. Built-in Deterministic Graders (Exact, Contains-All, Not-Contains, Regex, JSON Field, Numeric Tolerance, Tool Sequence)
//   2. Full Eval Benchmark Tracker (`EvalBenchmark`) with P50 / P95 / Max Latency, Token & Cost Accounting
//   3. Pass@k Estimator (`eval_pass_at_k_pct`) & CI Regression Gate (`eval_check_regression`)
//   4. GitHub-Flavored Markdown Table & JSONL Exporters (`eval_export_markdown`, `eval_export_jsonl`)

use std::str
use std::json
use std::regex
use std::ai_harness

// ==================== 1. DETERMINISTIC GRADERS ====================

fn grade_exact(actual: str, expected: str) -> bool {
    return str_eq(str_trim(actual), str_trim(expected))
}

fn grade_exact_ci(actual: str, expected: str) -> bool {
    return str_eq(str_to_lower(str_trim(actual)), str_to_lower(str_trim(expected)))
}

// Verifies `actual` contains EVERY comma-separated needle in `needles_csv`
fn grade_contains_all(actual: str, needles_csv: str) -> bool {
    n := str_len(needles_csv)
    mut p := 0
    while p < n {
        mut c := str_find_byte(needles_csv, 44, p)
        if c < 0 { c = n }
        tok := str_trim(str_slice(needles_csv, p, c))
        if str_len(tok) > 0 and not str_contains(actual, tok) {
            return false
        }
        p = c + 1
    }
    return true
}

// Verifies `actual` contains NONE of the comma-separated forbidden tokens
fn grade_not_contains(actual: str, forbidden_csv: str) -> bool {
    n := str_len(forbidden_csv)
    mut p := 0
    while p < n {
        mut c := str_find_byte(forbidden_csv, 44, p)
        if c < 0 { c = n }
        tok := str_trim(str_slice(forbidden_csv, p, c))
        if str_len(tok) > 0 and str_contains(actual, tok) {
            return false
        }
        p = c + 1
    }
    return true
}

fn grade_regex(actual: str, pattern: str) -> bool {
    return regex_is_match(pattern, actual)
}

fn grade_json_str_eq(json_str: str, key: str, expected: str) -> bool {
    got := json_get_str(json_str, key) or return false
    return str_eq(got, expected)
}

fn grade_json_i64_eq(json_str: str, key: str, expected: i64) -> bool {
    got := json_get_i64(json_str, key) or return false
    return got == expected
}

fn grade_numeric_within(actual: f64, expected: f64, tol: f64) -> bool {
    diff := abs_f64(actual - expected)
    return diff <= tol
}

// Verifies that `actual_trace_csv` (e.g. `"read_file,edit_file,run_safe_cmd"`) executed all
// `required_seq_csv` tools in relative order and ZERO tools from `forbidden_csv`.
fn grade_tool_sequence(actual_trace_csv: str, required_seq_csv: str, forbidden_csv: str = "") -> bool {
    if str_len(forbidden_csv) > 0 and not grade_not_contains(actual_trace_csv, forbidden_csv) {
        return false
    }
    n := str_len(required_seq_csv)
    mut pos_in_trace := 0
    mut p := 0
    while p < n {
        mut c := str_find_byte(required_seq_csv, 44, p)
        if c < 0 { c = n }
        req := str_trim(str_slice(required_seq_csv, p, c))
        if str_len(req) > 0 {
            found := str_find(actual_trace_csv, req, pos_in_trace)
            if found < 0 { return false }
            pos_in_trace = found + str_len(req)
        }
        p = c + 1
    }
    return true
}

// ==================== 2. FULL EVAL BENCHMARK & PERCENTILE STATS ====================

struct EvalBenchmark {
    suite_name: str
    task_names: ByteBuf
    // 8 ints per task: [name_off, name_len, passed(0/1), score_pct, latency_us, in_toks, out_toks, cost_micros]
    records: IntBuf
    latencies: IntBuf // sorted ascending for O(1) P50/P95/Max
    count: i64
    max_tasks: i64
}

fn eval_bench_new(suite_name: str, max_tasks: i64 = 256) -> EvalBenchmark {
    mut mt := max_tasks
    if mt < 16 { mt = 16 }
    if mt > 4096 { mt = 4096 }
    return EvalBenchmark(
        suite_name = suite_name,
        task_names = buf_new(16384),
        records = ibuf_new(mt * 8 + 16),
        latencies = ibuf_new(mt + 16),
        count = 0,
        max_tasks = mt
    )
}

fn eval_bench_free(move b: EvalBenchmark) {
    buf_free(move b.task_names)
    buf_free(move b.records)
    buf_free(move b.latencies)
}

fn _eval_insert_sorted(arr: IntBuf, val: i64) {
    n := ibuf_len(arr)
    ibuf_push(arr, val)
    mut i := n
    while i > 0 and ibuf_get(arr, i - 1) > val {
        ibuf_set(arr, i, ibuf_get(arr, i - 1))
        i -= 1
    }
    ibuf_set(arr, i, val)
}

fn eval_bench_add(mut b: EvalBenchmark, task_name: str, passed: bool, score_pct: i64, latency_us: i64, in_toks: i64, out_toks: i64, cost_micros: i64) -> bool {
    if b.count >= b.max_tasks { return false }
    nl := str_len(task_name)
    if buf_len(b.task_names) + nl + 8 > 16384 { return false }
    no := buf_len(b.task_names)
    buf_push_str(b.task_names, task_name)
    mut sc := score_pct
    if sc < 0 { sc = 0 } else if sc > 100 { sc = 100 }
    lat := if latency_us > 0 { latency_us } else { 0 }

    ibuf_push(b.records, no)
    ibuf_push(b.records, nl)
    ibuf_push(b.records, if passed { 1 } else { 0 })
    ibuf_push(b.records, sc)
    ibuf_push(b.records, lat)
    ibuf_push(b.records, if in_toks > 0 { in_toks } else { 0 })
    ibuf_push(b.records, if out_toks > 0 { out_toks } else { 0 })
    ibuf_push(b.records, if cost_micros > 0 { cost_micros } else { 0 })
    _eval_insert_sorted(b.latencies, lat)
    b.count += 1
    return true
}

fn eval_bench_pass_count(b: EvalBenchmark) -> i64 {
    mut p := 0
    mut i := 0
    while i < b.count {
        if ibuf_get(b.records, i * 8 + 2) != 0 { p += 1 }
        i += 1
    }
    return p
}

fn eval_bench_pass_rate_pct(b: EvalBenchmark) -> i64 {
    if b.count <= 0 { return 0 }
    return (eval_bench_pass_count(b) * 100) / b.count
}

fn eval_bench_avg_score_pct(b: EvalBenchmark) -> i64 {
    if b.count <= 0 { return 0 }
    mut sum := 0
    mut i := 0
    while i < b.count {
        sum += ibuf_get(b.records, i * 8 + 3)
        i += 1
    }
    return sum / b.count
}

// Returns nearest-rank latency percentile in microseconds (`pct` in `1..100`, e.g. 50 for P50, 95 for P95)
fn eval_bench_percentile_us(b: EvalBenchmark, pct: i64) -> i64 {
    n := ibuf_len(b.latencies)
    if n <= 0 { return 0 }
    mut idx := ((pct * n + 99) / 100) - 1
    if idx < 0 { idx = 0 }
    if idx >= n { idx = n - 1 }
    return ibuf_get(b.latencies, idx)
}

fn eval_bench_total_cost_micros(b: EvalBenchmark) -> i64 {
    mut sum := 0
    mut i := 0
    while i < b.count {
        sum += ibuf_get(b.records, i * 8 + 7)
        i += 1
    }
    return sum
}

// Exact unbiased pass@k percentage (Chen et al. 2021): `1 - C(n - c, k) / C(n, k)` in [0..100]
fn eval_pass_at_k_pct(n_samples: i64, n_correct: i64, k: i64) -> i64 {
    if n_samples <= 0 or k <= 0 or n_correct <= 0 { return 0 }
    if n_samples - n_correct < k { return 100 }
    mut fail_prob := 1.0
    mut i := 0
    while i < k {
        num := (n_samples - n_correct - i) as f64
        den := (n_samples - i) as f64
        fail_prob = fail_prob * (num / den)
        i += 1
    }
    pct := ((1.0 - fail_prob) * 100.0 + 0.5) as i64
    if pct < 0 { return 0 }
    if pct > 100 { return 100 }
    return pct
}

// ==================== 3. CI REGRESSION GATE & EXPORTERS ====================

// Returns `true` if benchmark meets minimum pass rate, P95 latency cap, and total cost cap
fn eval_check_regression(b: EvalBenchmark, min_pass_pct: i64, max_p95_us: i64, max_cost_micros: i64) -> bool {
    if eval_bench_pass_rate_pct(b) < min_pass_pct { return false }
    if max_p95_us > 0 and eval_bench_percentile_us(b, 95) > max_p95_us { return false }
    if max_cost_micros > 0 and eval_bench_total_cost_micros(b) > max_cost_micros { return false }
    return true
}

fn eval_export_markdown(b: EvalBenchmark) -> str {
    out := buf_new(32768)
    pass_c := eval_bench_pass_count(b)
    rate := eval_bench_pass_rate_pct(b)
    p50_ms := eval_bench_percentile_us(b, 50) / 1000
    p95_ms := eval_bench_percentile_us(b, 95) / 1000
    cost := eval_bench_total_cost_micros(b)

    buf_push_str(out, f"### Eval Report: {b.suite_name}\n")
    buf_push_str(out, f"- **Pass Rate:** {pass_c}/{b.count} ({rate}%) | **Avg Score:** {eval_bench_avg_score_pct(b)}%\n")
    buf_push_str(out, f"- **Latency:** P50 = {p50_ms} ms, P95 = {p95_ms} ms | **Total Cost:** {cost} micros\n\n")
    buf_push_str(out, "| Task | Result | Score | Latency (ms) | In/Out Tokens |\n")
    buf_push_str(out, "|---|---|---|---|---|\n")
    mut i := 0
    while i < b.count {
        r := i * 8
        tname := buf_slice_str(b.task_names, ibuf_get(b.records, r), ibuf_get(b.records, r) + ibuf_get(b.records, r + 1))
        ok_s := if ibuf_get(b.records, r + 2) != 0 { "PASS" } else { "FAIL" }
        sc := ibuf_get(b.records, r + 3)
        lms := ibuf_get(b.records, r + 4) / 1000
        it := ibuf_get(b.records, r + 5)
        ot := ibuf_get(b.records, r + 6)
        row := f"| {tname} | {ok_s} | {sc}% | {lms} | {it}/{ot} |\n"
        if buf_len(out) + str_len(row) < 32700 { buf_push_str(out, row) }
        i += 1
    }
    return buf_to_owned_str(move out)
}

fn eval_export_jsonl(b: EvalBenchmark) -> str {
    out := buf_new(32768)
    mut i := 0
    while i < b.count {
        r := i * 8
        tname := buf_slice_str(b.task_names, ibuf_get(b.records, r), ibuf_get(b.records, r) + ibuf_get(b.records, r + 1))
        ok_s := if ibuf_get(b.records, r + 2) != 0 { "true" } else { "false" }
        sc := ibuf_get(b.records, r + 3)
        lat := ibuf_get(b.records, r + 4)
        it := ibuf_get(b.records, r + 5)
        ot := ibuf_get(b.records, r + 6)
        cm := ibuf_get(b.records, r + 7)
        if buf_len(out) + str_len(tname) * 2 + 160 >= 32700 { break }
        buf_push_str(out, "{\"task\":\"")
        harness_push_json_escaped(out, tname)
        buf_push_str(out, f"\",\"passed\":{ok_s},\"score\":{sc},\"latency_us\":{lat},\"in_tokens\":{it},\"out_tokens\":{ot},\"cost_micros\":{cm}}\n")
        i += 1
    }
    return buf_to_owned_str(move out)
}
