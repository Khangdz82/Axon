// Axon Production Cross-Platform Native GUI & Desktop Backend (`std/gui.ax`)
// Connects Axon's zero-dependency `std::ui` (HTML5/CSS/Tailwind/Flexbox/Signals/Canvas)
// directly to real OS native windows, high-FPS pixel blitting, mouse/keyboard input,
// clipboard, message boxes, and native file dialogs:
//   - Windows: Win32 `user32.dll` + `gdi32.dll` (`CreateWindowExA`, `StretchDIBits`, `PeekMessageA`, Clipboard, `comdlg32.dll`)
//   - Linux:   `libSDL2-2.0.so.0` / `libX11.so.6` dynamic FFI
//   - macOS:   `libSDL2.dylib` dynamic FFI

use std::ffi
use std::ui
use std::ui_render

struct GuiWindow {
    backend: i64 // 1 = Win32, 2 = SDL2 (Linux/macOS), 3 = X11
    hwnd: i64
    aux1: i64    // SDL_Renderer / X11 Display
    aux2: i64    // SDL_Texture / X11 GC
    width: i64
    height: i64
    mouse_x: i64
    mouse_y: i64
    mouse_down: bool
    key_escape: bool
    is_open: bool
    user32: i64
    gdi32: i64
    sdl2: i64
    last_char: i64
    scroll_delta: i64
    needs_redraw: bool
    char_queue: IntBuf
    char_count: i64
    clicked_down: bool
    clicked_up: bool
    ctrl_v: bool
    ctrl_c: bool
    cur_cursor: i64
    // Cached hot Win32 function pointers + persistent 64B scratch (0 GetProcAddress & 0 malloc per poll!)
    msg_buf: i64
    f_isw: i64
    f_peek: i64
    f_tr: i64
    f_disp: i64
    f_val: i64
    f_gks: i64
    f_rect: i64
    f_cp: i64
    f_sc: i64
    f_mw: i64
    f_lcur: i64
    f_scur: i64
    hbr_bg: i64
    hico: i64
    dpi_changed: bool
}

fn _gui_utf8_to_utf16(k32: i64, s: str) -> i64 {
    mut n := str_len(s)
    if n > 65536 { n = 65536 } // Security (CWE-400): cap UTF-16 conversion buffer
    f_mb := if k32 != 0 { ffi_sym(k32, "MultiByteToWideChar") } else { 0 }
    if f_mb == 0 or n == 0 { return ffi_wstr(s) }
    cs := ffi_cstr(s)
    if cs == 0 { return 0 }
    wcap := n + 4
    wbuf := ffi_alloc(wcap * 2 + 8)
    if wbuf == 0 { ffi_free(cs); return 0 }
    _ := ffi_call6(f_mb, 65001, 0, cs, n, wbuf, wcap)
    ffi_free(cs)
    return wbuf
}

// Synthesizes a crisp 32x32 32-bit BGRA native Axon desktop icon (rounded gradient badge + geometric 'A')
// Eliminates blank/globe window & taskbar icons with zero external .ico asset dependencies!
fn gui_build_axon_icon_bgra(accent_rgb: i64 = 0xD97757) -> ByteBuf {
    sz := 32
    b := buf_new(sz * sz * 4 + 16)
    r0 := (accent_rgb >> 16) & 255
    g0 := (accent_rgb >> 8) & 255
    b0 := accent_rgb & 255
    mut y := 0
    while y < sz {
        mut x := 0
        while x < sz {
            // Rounded square SDF (radius 7px inside 1..30)
            mut dx := 0
            mut dy := 0
            if x < 8 { dx = 8 - x } else if x > 23 { dx = x - 23 }
            if y < 8 { dy = 8 - y } else if y > 23 { dy = y - 23 }
            d2 := dx * dx + dy * dy
            if x < 1 or x > 30 or y < 1 or y > 30 or d2 > 49 {
                buf_push_u32(b, 0)
            } else {
                // Subtle diagonal gradient across badge
                grad := (x + y) - 32
                mut cr := r0 - grad / 2
                mut cg := g0 - grad / 2
                mut cb := b0 - grad / 3
                if cr < 20 { cr = 20 } else if cr > 255 { cr = 255 }
                if cg < 20 { cg = 20 } else if cg > 255 { cg = 255 }
                if cb < 20 { cb = 20 } else if cb > 255 { cb = 255 }

                // Crisp geometric white 'A' glyph centered in 32x32 badge
                mut is_a := false
                if y >= 7 and y <= 24 {
                    half_span := ((y - 7) * 7) / 17
                    left_edge := 15 - half_span
                    right_edge := 16 + half_span
                    if (x >= left_edge and x <= left_edge + 2) or (x >= right_edge - 2 and x <= right_edge) {
                        is_a = true
                    }
                    if y >= 17 and y <= 19 and x >= left_edge and x <= right_edge {
                        is_a = true
                    }
                }
                mut a := 255
                if d2 > 38 { a = 190 } // soft anti-aliased corner pixel
                if is_a {
                    buf_push_u32(b, (255 << 24) | (255 << 16) | (255 << 8) | 255)
                } else {
                    buf_push_u32(b, (a << 24) | (cr << 16) | (cg << 8) | cb)
                }
            }
            x += 1
        }
        y += 1
    }
    return b
}

fn _gui_create_hicon_bgra(u32: i64, g32: i64, w: i64, h: i64, pixels: ByteBuf) -> i64 {
    if u32 == 0 or g32 == 0 or w <= 0 or h <= 0 or w > 256 or h > 256 { return 0 }
    if buf_len(pixels) < w * h * 4 { return 0 }
    f_cbm  := ffi_sym(g32, "CreateBitmap")
    f_delo := ffi_sym(g32, "DeleteObject")
    f_ci   := ffi_sym(u32, "CreateIconIndirect")
    if f_cbm == 0 or f_ci == 0 { return 0 }
    px_ptr := unsafe { (pixels as i64) + 16 }
    hbm_col := ffi_call5(f_cbm, w, h, 1, 32, px_ptr)
    mask_bytes := ((w + 15) / 16) * 2 * h + 16
    mask_buf := ffi_alloc(mask_bytes)
    if mask_buf == 0 {
        if hbm_col != 0 and f_delo != 0 { _ := ffi_call1(f_delo, hbm_col) }
        return 0
    }
    hbm_msk := ffi_call5(f_cbm, w, h, 1, 1, mask_buf)
    ffi_free(mask_buf)
    mut hico := 0
    if hbm_col != 0 and hbm_msk != 0 {
        ii := ffi_alloc(32)
        if ii != 0 {
            ffi_write_u32_le(ii, 0, 1)
            ffi_write_i64(ii, 2, hbm_msk)
            ffi_write_i64(ii, 3, hbm_col)
            hico = ffi_call1(f_ci, ii)
            ffi_free(ii)
        }
    }
    if hbm_col != 0 and f_delo != 0 { _ := ffi_call1(f_delo, hbm_col) }
    if hbm_msk != 0 and f_delo != 0 { _ := ffi_call1(f_delo, hbm_msk) }
    return hico
}

fn _gui_win32_open(title: str, w_in: i64, h_in: i64, visible: bool) -> GuiWindow ! i64 {
    // Security (CWE-190 / CWE-400): clamp native window geometry to safe display bounds
    mut w := w_in
    mut h := h_in
    if w < 64 { w = 64 } else if w > 16384 { w = 16384 }
    if h < 64 { h = 64 } else if h > 16384 { h = 16384 }
    u32 := ffi_open_one("user32.dll")
    g32 := ffi_open_one("gdi32.dll")
    k32 := ffi_open_one("kernel32.dll")
    if u32 == 0 or g32 == 0 { return err(-600) }

    // Enable Per-Monitor DPI Awareness v2 (-4) + Shcore Per-Monitor fallback so Windows never blurry-upscales the GUI!
    if visible {
        mut dpi_ok := false
        f_dpic := ffi_sym(u32, "SetProcessDpiAwarenessContext")
        if f_dpic != 0 {
            dpi_ok = (ffi_call1(f_dpic, -4) & 0xFFFFFFFF) != 0
        }
        if not dpi_ok {
            shc := ffi_open_one("shcore.dll")
            if shc != 0 {
                f_sda := ffi_sym(shc, "SetProcessDpiAwareness")
                if f_sda != 0 {
                    dpi_ok = (ffi_call1(f_sda, 2) & 0xFFFFFFFF) == 0
                }
            }
        }
        if not dpi_ok {
            f_dpi := ffi_sym(u32, "SetProcessDPIAware")
            if f_dpi != 0 { _ := ffi_call0(f_dpi) }
        }
    }

    f_mod   := ffi_sym(k32, "GetModuleHandleW")
    f_reg   := ffi_sym(u32, "RegisterClassExW")
    f_def   := ffi_sym(u32, "DefWindowProcW")
    f_cw    := ffi_sym(u32, "CreateWindowExW")
    f_show  := ffi_sym(u32, "ShowWindow")
    f_upd   := ffi_sym(u32, "UpdateWindow")
    f_cur   := ffi_sym(u32, "LoadCursorW")
    f_brush := ffi_sym(g32, "CreateSolidBrush")
    if f_cw == 0 or f_def == 0 { return err(-601) }

    hinst := ffi_call1(f_mod, 0)
    hbr   := if f_brush != 0 { ffi_call1(f_brush, 0x000B0909) } else { 0 } // Obsidian dark #09090B
    wcname := ffi_wstr("AxonPhotonGuiClass")
    wtitle := _gui_utf8_to_utf16(k32, title)

    // Register WNDCLASSEXW (80 bytes on Win64) with hCursor = 0 so DefWindowProcW never resets IDC_HAND/IDC_IBEAM!
    wc := ffi_alloc(96)
    ffi_write_u32_le(wc, 0, 80)        // cbSize = 80
    ffi_write_u32_le(wc, 4, 0x0023)    // CS_HREDRAW | CS_VREDRAW | CS_OWNDC
    ffi_write_i64(wc, 1, f_def)        // lpfnWndProc at offset 8
    ffi_write_i64(wc, 3, hinst)        // hInstance at offset 24
    ffi_write_i64(wc, 5, 0)            // hCursor = 0 (managed explicitly by gui_set_cursor -> zero flicker!)
    ffi_write_i64(wc, 6, hbr)          // hbrBackground at offset 48 (zero white flash!)
    ffi_write_i64(wc, 8, wcname)       // lpszClassName at offset 64
    _ := ffi_call1(f_reg, wc)
    ffi_free(wc)

    // CreateWindowExW(...)
    mut style := 0x00CF0000 // WS_OVERLAPPEDWINDOW
    if visible { style = style | 0x10000000 } // WS_VISIBLE
    args := ibuf_new(16)
    ibuf_push(args, 0)
    ibuf_push(args, wcname)
    ibuf_push(args, wtitle)
    ibuf_push(args, style)
    ibuf_push(args, 0x80000000) // CW_USEDEFAULT
    ibuf_push(args, 0x80000000)
    ibuf_push(args, w)
    ibuf_push(args, h)
    ibuf_push(args, 0)
    ibuf_push(args, 0)
    ibuf_push(args, hinst)
    ibuf_push(args, 0)
    hwnd := ffi_call_arr(f_cw, 12, args)
    buf_free(move args)
    ffi_free(wcname)
    ffi_free(wtitle)
    if hwnd == 0 {
        if hbr != 0 {
            f_delo := ffi_sym(g32, "DeleteObject")
            if f_delo != 0 { _ := ffi_call1(f_delo, hbr) }
        }
        return err(-602)
    }

    mut hico_def := 0
    if visible {
        // Attach native Axon rounded app icon immediately (0 blank/globe icon in titlebar & taskbar!)
        ico_px := gui_build_axon_icon_bgra(0xD97757)
        hico_def = _gui_create_hicon_bgra(u32, g32, 32, 32, ico_px)
        buf_free(move ico_px)
        if hico_def != 0 {
            f_sm := ffi_sym(u32, "SendMessageW")
            if f_sm != 0 {
                _ := ffi_call4(f_sm, hwnd, 0x0080, 0, hico_def) // ICON_SMALL
                _ := ffi_call4(f_sm, hwnd, 0x0080, 1, hico_def) // ICON_BIG
            }
        }
        // Enable native Windows 10/11 Dark Title Bar + Win11 Rounded Corners
        dwm := ffi_open_one("dwmapi.dll")
        if dwm != 0 {
            f_dwm := ffi_sym(dwm, "DwmSetWindowAttribute")
            if f_dwm != 0 {
                dark_box := ffi_alloc(20)
                ffi_write_u32_le(dark_box, 0, 1)
                _ := ffi_call4(f_dwm, hwnd, 20, dark_box, 4)
                _ := ffi_call4(f_dwm, hwnd, 19, dark_box, 4)
                ffi_write_u32_le(dark_box, 4, 0x00110E0E) // DWMWA_CAPTION_COLOR = #0E0E11
                _ := ffi_call4(f_dwm, hwnd, 35, dark_box + 4, 4)
                ffi_write_u32_le(dark_box, 8, 0x001F1B1B) // DWMWA_BORDER_COLOR = #1B1B1F
                _ := ffi_call4(f_dwm, hwnd, 34, dark_box + 8, 4)
                ffi_write_u32_le(dark_box, 12, 2) // DWMWA_WINDOW_CORNER_PREFERENCE = DWMWCP_ROUND
                _ := ffi_call4(f_dwm, hwnd, 33, dark_box + 12, 4)
                ffi_free(dark_box)
            }
        }
        _ := ffi_call2(f_show, hwnd, 5) // SW_SHOW
        _ := ffi_call1(f_upd, hwnd)
    }
    return ok(GuiWindow(
        backend = 1, hwnd = hwnd, aux1 = 0, aux2 = 0,
        width = w, height = h, mouse_x = 0, mouse_y = 0,
        mouse_down = false, key_escape = false, is_open = true,
        user32 = u32, gdi32 = g32, sdl2 = 0,
        last_char = 0, scroll_delta = 0, needs_redraw = true,
        char_queue = ibuf_new(64), char_count = 0,
        clicked_down = false, clicked_up = false,
        ctrl_v = false, ctrl_c = false, cur_cursor = -1,
        msg_buf = ffi_alloc(64),
        f_isw = ffi_sym(u32, "IsWindow"),
        f_peek = ffi_sym(u32, "PeekMessageW"),
        f_tr = ffi_sym(u32, "TranslateMessage"),
        f_disp = ffi_sym(u32, "DispatchMessageW"),
        f_val = ffi_sym(u32, "ValidateRect"),
        f_gks = ffi_sym(u32, "GetKeyState"),
        f_rect = ffi_sym(u32, "GetClientRect"),
        f_cp = ffi_sym(u32, "GetCursorPos"),
        f_sc = ffi_sym(u32, "ScreenToClient"),
        f_mw = ffi_sym(u32, "MsgWaitForMultipleObjects"),
        f_lcur = f_cur,
        f_scur = ffi_sym(u32, "SetCursor"),
        hbr_bg = hbr,
        hico = hico_def,
        dpi_changed = false
    ))
}

fn _gui_sdl2_open(title: str, w: i64, h: i64, visible: bool) -> GuiWindow ! i64 {
    sdl := ffi_open("SDL2.dll", "libSDL2-2.0.so.0", "libSDL2.dylib")
    if sdl == 0 { return err(-610) }
    f_init := ffi_sym(sdl, "SDL_Init")
    f_cw   := ffi_sym(sdl, "SDL_CreateWindow")
    f_cr   := ffi_sym(sdl, "SDL_CreateRenderer")
    f_ct   := ffi_sym(sdl, "SDL_CreateTexture")
    if f_cw == 0 { return err(-611) }
    _ := ffi_call1(f_init, 0x20) // SDL_INIT_VIDEO
    ct := ffi_cstr(title)
    // SDL_WINDOW_SHOWN (4) | SDL_WINDOW_RESIZABLE (32) | SDL_WINDOW_ALLOW_HIGHDPI (8192)
    mut fl := 4 | 32 | 8192
    if not visible { fl = 8 | 32 | 8192 }
    win := ffi_call6(f_cw, ct, 0x1FFF0000, 0x1FFF0000, w, h, fl)
    ffi_free(ct)
    if win == 0 { return err(-612) }
    ren := ffi_call3(f_cr, win, -1, 6) // SDL_RENDERER_ACCELERATED (2) | SDL_RENDERER_PRESENTVSYNC (4)
    // SDL_PIXELFORMAT_ARGB8888 = 0x16362004, SDL_TEXTUREACCESS_STREAMING = 1
    tex := ffi_call5(f_ct, ren, 0x16362004, 1, w, h)
    return ok(GuiWindow(
        backend = 2, hwnd = win, aux1 = ren, aux2 = tex,
        width = w, height = h, mouse_x = 0, mouse_y = 0,
        mouse_down = false, key_escape = false, is_open = true,
        user32 = 0, gdi32 = 0, sdl2 = sdl,
        last_char = 0, scroll_delta = 0, needs_redraw = true,
        char_queue = ibuf_new(64), char_count = 0,
        clicked_down = false, clicked_up = false,
        ctrl_v = false, ctrl_c = false, cur_cursor = -1,
        msg_buf = ffi_alloc(64),
        f_isw = 0, f_peek = ffi_sym(sdl, "SDL_PollEvent"), f_tr = 0, f_disp = 0,
        f_val = 0, f_gks = 0, f_rect = 0, f_cp = 0, f_sc = 0,
        f_mw = ffi_sym(sdl, "SDL_WaitEventTimeout"), f_lcur = 0, f_scur = 0,
        hbr_bg = 0, hico = 0, dpi_changed = false
    ))
}

// Open a native OS window (auto-selects Win32 on Windows, SDL2 on Linux/macOS)
fn gui_open(title: str, w: i64, h: i64, visible: bool = true) -> GuiWindow ! i64 {
    if ffi_open_one("user32.dll") != 0 {
        return _gui_win32_open(title, w, h, visible)
    }
    return _gui_sdl2_open(title, w, h, visible)
}

fn gui_get_dpi(win: GuiWindow) -> i64 {
    if win.backend == 1 and win.user32 != 0 and win.hwnd != 0 {
        f := ffi_sym(win.user32, "GetDpiForWindow")
        if f != 0 {
            d := ffi_call1(f, win.hwnd) & 0xFFFFFFFF
            if d >= 72 and d <= 480 { return d }
        }
    }
    return 96
}

fn gui_set_title(win: GuiWindow, title: str) {
    if not win.is_open { return }
    if win.backend == 1 {
        k32 := ffi_open_one("kernel32.dll")
        wt := _gui_utf8_to_utf16(k32, title)
        f := ffi_sym(win.user32, "SetWindowTextW")
        _ := ffi_call2(f, win.hwnd, wt)
        ffi_free(wt)
    } else if win.backend == 2 {
        ct := ffi_cstr(title)
        f := ffi_sym(win.sdl2, "SDL_SetWindowTitle")
        _ := ffi_call2(f, win.hwnd, ct)
        ffi_free(ct)
    }
}

// Configure native Windows 10/11 Dark/Light titlebar, caption/border color, and Win11 Mica backdrop
fn gui_set_window_theme(win: GuiWindow, dark: bool, caption_bgr: i64 = 0x00110E0E, border_bgr: i64 = 0x001F1B1B, mica: bool = false) {
    if not win.is_open or win.backend != 1 or win.hwnd == 0 { return }
    dwm := ffi_open_one("dwmapi.dll")
    if dwm == 0 { return }
    f_dwm := ffi_sym(dwm, "DwmSetWindowAttribute")
    if f_dwm == 0 { return }
    box := ffi_alloc(24)
    ffi_write_u32_le(box, 0, if dark { 1 } else { 0 })
    _ := ffi_call4(f_dwm, win.hwnd, 20, box, 4)
    _ := ffi_call4(f_dwm, win.hwnd, 19, box, 4)
    ffi_write_u32_le(box, 4, caption_bgr & 0x00FFFFFF)
    _ := ffi_call4(f_dwm, win.hwnd, 35, box + 4, 4)
    ffi_write_u32_le(box, 8, border_bgr & 0x00FFFFFF)
    _ := ffi_call4(f_dwm, win.hwnd, 34, box + 8, 4)
    if mica {
        ffi_write_u32_le(box, 12, 2) // DWMSBT_MAINWINDOW (Mica)
        _ := ffi_call4(f_dwm, win.hwnd, 38, box + 12, 4)
    }
    ffi_free(box)
}

// Event-driven OS kernel sleep (true 0.00% idle CPU): wakes in <0.1ms on mouse, keyboard, paint, or resize
fn gui_wait_event(win: GuiWindow, timeout_ms: i64 = 250) {
    if not win.is_open { return }
    if win.backend == 1 and win.f_mw != 0 {
        _ := ffi_call5(win.f_mw, 0, 0, 0, timeout_ms, 0x04FF) // QS_ALLINPUT
        return
    }
    if win.backend == 2 and win.f_mw != 0 {
        _ := ffi_call2(win.f_mw, 0, timeout_ms) // SDL_WaitEventTimeout(NULL, timeout_ms)
        return
    }
    sleep_ms(16)
}

// Set native Win32 window & taskbar icon from 32-bit BGRA pixel buffer (zero external .ico file)
fn gui_set_icon_bgra(win: GuiWindow, w: i64, h: i64, pixels: ByteBuf) {
    if not win.is_open or win.backend != 1 or w <= 0 or h <= 0 or w > 1024 or h > 1024 { return }
    if buf_len(pixels) < w * h * 4 { return }
    f_cbm  := ffi_sym(win.gdi32, "CreateBitmap")
    f_delo := ffi_sym(win.gdi32, "DeleteObject")
    f_ci   := ffi_sym(win.user32, "CreateIconIndirect")
    f_sm   := ffi_sym(win.user32, "SendMessageW")
    if f_cbm == 0 or f_ci == 0 or f_sm == 0 { return }

    px_ptr := unsafe { (pixels as i64) + 16 }
    hbm_col := ffi_call5(f_cbm, w, h, 1, 32, px_ptr)
    // Win32 1bpp mask requires 16-bit word-aligned scanlines: ((w + 15) / 16) * 2 bytes/row
    mask_bytes := ((w + 15) / 16) * 2 * h + 16
    mask_buf := ffi_alloc(mask_bytes)
    if mask_buf == 0 {
        if hbm_col != 0 { _ := ffi_call1(f_delo, hbm_col) }
        return
    }
    hbm_msk := ffi_call5(f_cbm, w, h, 1, 1, mask_buf)
    ffi_free(mask_buf)
    if hbm_col != 0 and hbm_msk != 0 {
        ii := ffi_alloc(32)
        ffi_write_u32_le(ii, 0, 1) // fIcon = TRUE
        ffi_write_i64(ii, 2, hbm_msk) // offset 16: hbmMask
        ffi_write_i64(ii, 3, hbm_col) // offset 24: hbmColor
        hico := ffi_call1(f_ci, ii)
        ffi_free(ii)
        if hico != 0 {
            _ := ffi_call4(f_sm, win.hwnd, 0x0080, 0, hico) // ICON_SMALL
            _ := ffi_call4(f_sm, win.hwnd, 0x0080, 1, hico) // ICON_BIG
        }
    }
    if hbm_col != 0 { _ := ffi_call1(f_delo, hbm_col) }
    if hbm_msk != 0 { _ := ffi_call1(f_delo, hbm_msk) }
}

// Switch native OS mouse cursor (0=arrow, 1=hand, 2=ibeam, 3=not-allowed, 4=grab, 5=ew-resize, 6=ns-resize, 7=crosshair)
fn _gui_apply_cursor(win: GuiWindow, kind: i64) {
    if win.backend != 1 or win.f_lcur == 0 or win.f_scur == 0 { return }
    mut idc := 32512 // IDC_ARROW
    if kind == 1 { idc = 32649 }      // IDC_HAND
    else if kind == 2 { idc = 32513 } // IDC_IBEAM
    else if kind == 3 { idc = 32648 } // IDC_NO
    else if kind == 4 { idc = 32646 } // IDC_SIZEALL
    else if kind == 5 { idc = 32644 } // IDC_SIZEWE
    else if kind == 6 { idc = 32645 } // IDC_SIZENS
    else if kind == 7 { idc = 32515 } // IDC_CROSS
    hc := ffi_call2(win.f_lcur, 0, idc)
    if hc != 0 { _ := ffi_call1(win.f_scur, hc) }
}

fn gui_set_cursor(mut win: GuiWindow, kind: i64) {
    if win.backend != 1 or kind == win.cur_cursor { return }
    _gui_apply_cursor(win, kind)
    win.cur_cursor = kind
}

fn gui_poll_events(mut win: GuiWindow) -> bool {
    win.last_char = 0
    win.char_count = 0
    win.scroll_delta = 0
    win.needs_redraw = false
    win.clicked_down = false
    win.clicked_up = false
    win.ctrl_v = false
    win.ctrl_c = false
    win.key_escape = false
    win.dpi_changed = false
    if not win.is_open { return false }
    if win.backend == 1 {
        if win.f_isw == 0 or (ffi_call1(win.f_isw, win.hwnd) & 0xFFFFFFFF) == 0 {
            win.is_open = false
            return false
        }
        buf := win.msg_buf
        if buf == 0 { return win.is_open }
        mut guard := 0
        while guard < 128 {
            guard += 1
            // Drain ALL thread messages (hwnd = 0) so hidden IME/D2D/OLE thread messages never spin MsgWaitForMultipleObjects!
            got := ffi_call5(win.f_peek, buf, 0, 0, 0, 1) & 0xFFFFFFFF // PM_REMOVE
            if got == 0 { break }
            mhwnd := ffi_read_i64(buf, 0)
            mcode := ffi_read_u32_le(buf, 8)
            if mcode == 0x0012 { // WM_QUIT
                win.is_open = false
                break
            }
            if mhwnd == win.hwnd {
                if mcode == 0x0010 or mcode == 0x0002 { // WM_CLOSE / WM_DESTROY
                    win.is_open = false
                    break
                }
                if mcode == 0x000F { // WM_PAINT
                    win.needs_redraw = true
                    if win.f_val != 0 { _ := ffi_call2(win.f_val, win.hwnd, 0) }
                    continue
                }
                if mcode == 0x0014 { // WM_ERASEBKGND: suppress DefWindowProcW flash during live resize!
                    continue
                }
                if mcode == 0x0020 { // WM_SETCURSOR: keep active custom cursor without arrow flicker!
                    lparam_lo := ffi_read_i64(buf, 3) & 0xFFFF
                    if lparam_lo == 1 { // HTCLIENT
                        _gui_apply_cursor(win, if win.cur_cursor >= 0 { win.cur_cursor } else { 0 })
                        continue
                    }
                }
                if mcode == 0x02E0 { // WM_DPICHANGED
                    win.dpi_changed = true
                    win.needs_redraw = true
                } else if mcode == 0x0005 or mcode == 0x0006 or mcode == 0x0007 { // WM_SIZE/ACTIVATE/SETFOCUS
                    win.needs_redraw = true
                } else if mcode == 0x0201 { // WM_LBUTTONDOWN
                    win.mouse_down = true
                    win.clicked_down = true
                    win.needs_redraw = true
                } else if mcode == 0x0202 { // WM_LBUTTONUP
                    win.mouse_down = false
                    win.clicked_up = true
                    win.needs_redraw = true
                } else if mcode == 0x0100 { // WM_KEYDOWN (focused window only!)
                    vk := ffi_read_i64(buf, 2) & 0xFFFF
                    if vk == 0x1B { // VK_ESCAPE
                        win.key_escape = true
                    } else if win.f_gks != 0 and ((ffi_call1(win.f_gks, 0x11) & 0x8000) != 0) { // VK_CONTROL held
                        if vk == 0x56 { win.ctrl_v = true }      // Ctrl+V
                        else if vk == 0x43 { win.ctrl_c = true } // Ctrl+C
                    }
                } else if mcode == 0x0102 { // WM_CHAR (full UTF-16 queue for IME/Vietnamese fast typing)
                    ch := ffi_read_i64(buf, 2) & 0xFFFF
                    if ch > 0 and ch != 3 and ch != 22 {
                        win.last_char = ch
                        if win.char_count < 64 {
                            if win.char_count < ibuf_len(win.char_queue) {
                                ibuf_set(win.char_queue, win.char_count, ch)
                            } else {
                                ibuf_push(win.char_queue, ch)
                            }
                            win.char_count += 1
                        }
                    }
                } else if mcode == 0x020A { // WM_MOUSEWHEEL (signed 16-bit HIWORD)
                    raw_d := (ffi_read_i64(buf, 2) >> 16) & 0xFFFF
                    delta := if raw_d >= 32768 { raw_d - 65536 } else { raw_d }
                    win.scroll_delta += delta
                }
            }
            _ := ffi_call1(win.f_tr, buf)
            _ := ffi_call1(win.f_disp, buf)
        }

        // Reuse persistent 64B scratch buffer for client rect + cursor coords (0 malloc, 0 GetProcAddress!)
        if win.f_rect != 0 {
            _ := ffi_call2(win.f_rect, win.hwnd, buf)
            cw := ffi_sext32(ffi_read_u32_le(buf, 8))
            ch := ffi_sext32(ffi_read_u32_le(buf, 12))
            if cw > 100 and ch > 100 {
                win.width = cw
                win.height = ch
            }
        }

        if win.f_cp != 0 and win.f_sc != 0 {
            _ := ffi_call1(win.f_cp, buf)
            _ := ffi_call2(win.f_sc, win.hwnd, buf)
            win.mouse_x = ffi_sext32(ffi_read_u32_le(buf, 0))
            win.mouse_y = ffi_sext32(ffi_read_u32_le(buf, 4))
        }
        return win.is_open
    }
    if win.backend == 2 {
        ev := win.msg_buf
        if ev == 0 or win.f_peek == 0 { return win.is_open }
        while (ffi_call1(win.f_peek, ev) & 0xFFFFFFFF) != 0 {
            et := ffi_read_u32_le(ev, 0)
            if et == 0x100 { win.is_open = false } // SDL_QUIT
            else if et == 0x400 { // SDL_MOUSEMOTION
                win.mouse_x = ffi_sext32(ffi_read_u32_le(ev, 20))
                win.mouse_y = ffi_sext32(ffi_read_u32_le(ev, 24))
            } else if et == 0x401 { // SDL_MOUSEBUTTONDOWN
                win.mouse_down = true; win.clicked_down = true; win.needs_redraw = true
            } else if et == 0x402 { // SDL_MOUSEBUTTONUP
                win.mouse_down = false; win.clicked_up = true; win.needs_redraw = true
            } else if et == 0x403 { // SDL_MOUSEWHEEL
                win.scroll_delta += ffi_sext32(ffi_read_u32_le(ev, 20)) * 120
            }
        }
        return win.is_open
    }
    return false
}

// Blit an Axon `Canvas` (`std::ui_render`) directly into the native OS window surface at 60+ FPS!
fn gui_present_canvas(win: GuiWindow, canvas: Canvas) -> bool {
    if not win.is_open { return false }
    w := canvas.width
    h := canvas.height
    if w <= 0 or h <= 0 { return false }
    npix := w * h
    if buf_len(canvas.pixels) < npix * 4 { return false }

    if win.backend == 1 {
        f_gdc := ffi_sym(win.user32, "GetDC")
        f_rdc := ffi_sym(win.user32, "ReleaseDC")
        f_sdib := ffi_sym(win.gdi32, "StretchDIBits")
        hdc := ffi_call1(f_gdc, win.hwnd)
        if hdc == 0 { return false }

        // Canvas pixels are already stored in native little-endian BGRA (`[B, G, R, A]`), matching Win32 BI_RGB DIB!
        // Zero-alloc direct pointer blit (100x faster than per-pixel FFI copy & fixes R/B channel swap).
        px_ptr := unsafe { (canvas.pixels as i64) + 16 }
        bmi := ffi_alloc(64)
        ffi_write_u32_le(bmi, 0, 40)       // biSize = 40
        ffi_write_u32_le(bmi, 4, w)        // biWidth
        ffi_write_u32_le(bmi, 8, (0 - h) & 0xFFFFFFFF) // negative = top-down DIB
        ffi_write_u16_le(bmi, 12, 1)       // biPlanes = 1
        ffi_write_u16_le(bmi, 14, 32)      // biBitCount = 32
        ffi_write_u32_le(bmi, 16, 0)       // BI_RGB

        args := ibuf_new(16)
        ibuf_push(args, hdc)
        ibuf_push(args, 0); ibuf_push(args, 0); ibuf_push(args, win.width); ibuf_push(args, win.height)
        ibuf_push(args, 0); ibuf_push(args, 0); ibuf_push(args, w); ibuf_push(args, h)
        ibuf_push(args, px_ptr)
        ibuf_push(args, bmi)
        ibuf_push(args, 0)          // DIB_RGB_COLORS
        ibuf_push(args, 0x00CC0020) // SRCCOPY
        drawn := ffi_sext32(ffi_call_arr(f_sdib, 13, args))
        buf_free(move args)
        ffi_free(bmi)
        _ := ffi_call2(f_rdc, win.hwnd, hdc)
        return drawn >= 0
    }
    if win.backend == 2 {
        f_ut := ffi_sym(win.sdl2, "SDL_UpdateTexture")
        f_rc := ffi_sym(win.sdl2, "SDL_RenderCopy")
        f_rp := ffi_sym(win.sdl2, "SDL_RenderPresent")
        px := ffi_bytes_to_ptr(canvas.pixels)
        _ := ffi_call4(f_ut, win.aux2, 0, px, w * 4)
        _ := ffi_call4(f_rc, win.aux1, win.aux2, 0, 0)
        _ := ffi_call1(f_rp, win.aux1)
        ffi_free(px)
        return true
    }
    return false
}

fn gui_close(mut win: GuiWindow) {
    if win.msg_buf != 0 {
        ffi_free(win.msg_buf)
        win.msg_buf = 0
    }
    if win.backend == 1 {
        if win.is_open and win.hwnd != 0 {
            f := ffi_sym(win.user32, "DestroyWindow")
            _ := ffi_call1(f, win.hwnd)
        }
        if win.hbr_bg != 0 and win.gdi32 != 0 {
            f_delo := ffi_sym(win.gdi32, "DeleteObject")
            if f_delo != 0 { _ := ffi_call1(f_delo, win.hbr_bg) }
            win.hbr_bg = 0
        }
        if win.hico != 0 and win.user32 != 0 {
            f_di := ffi_sym(win.user32, "DestroyIcon")
            if f_di != 0 { _ := ffi_call1(f_di, win.hico) }
            win.hico = 0
        }
    } else if win.backend == 2 and win.is_open {
        if win.aux2 != 0 {
            f_dt := ffi_sym(win.sdl2, "SDL_DestroyTexture")
            if f_dt != 0 { _ := ffi_call1(f_dt, win.aux2) }
            win.aux2 = 0
        }
        if win.aux1 != 0 {
            f_dr := ffi_sym(win.sdl2, "SDL_DestroyRenderer")
            if f_dr != 0 { _ := ffi_call1(f_dr, win.aux1) }
            win.aux1 = 0
        }
        if win.hwnd != 0 {
            f_dw := ffi_sym(win.sdl2, "SDL_DestroyWindow")
            _ := ffi_call1(f_dw, win.hwnd)
        }
    }
    win.is_open = false
}

// Win32 HFONT cache. GDI font creation costs ~40-80us per call; caching by
// (size, weight) keeps steady-state frames free of object churn.
struct GuiFontCache {
    entries: IntBuf // triples: [size, weight, hfont]
    count: i64
}

fn gui_font_cache_new() -> GuiFontCache {
    return GuiFontCache(entries = ibuf_new(96), count = 0)
}

fn _gui_font_index(c: GuiFontCache, size: i64, weight: i64) -> i64 {
    mut i := 0
    while i < c.count {
        if ibuf_get(c.entries, i * 3) == size and ibuf_get(c.entries, i * 3 + 1) == weight { return i }
        i += 1
    }
    return -1
}

fn _gui_create_font(gdi: i64, face: str, size: i64, weight: i64) -> i64 {
    f_cfont := ffi_sym(gdi, "CreateFontA")
    if f_cfont == 0 { return 0 }
    c_face := ffi_cstr(face)
    args := ibuf_new(16)
    ibuf_push(args, 0 - size); ibuf_push(args, 0); ibuf_push(args, 0); ibuf_push(args, 0)
    ibuf_push(args, weight); ibuf_push(args, 0); ibuf_push(args, 0); ibuf_push(args, 0)
    ibuf_push(args, 1); ibuf_push(args, 0); ibuf_push(args, 0); ibuf_push(args, 5) // CLEARTYPE_QUALITY
    ibuf_push(args, 0); ibuf_push(args, c_face)
    h := ffi_call_arr(f_cfont, 14, args)
    buf_free(move args)
    ffi_free(c_face)
    return h
}

fn gui_font_cache_get(mut c: GuiFontCache, gdi: i64, face: str, size: i64, weight: i64) -> i64 {
    mut sz := size
    if sz < 8 { sz = 8 }
    if sz > 96 { sz = 96 }
    mut w := weight
    if w < 100 or w > 900 { w = 400 }
    idx := _gui_font_index(c, sz, w)
    if idx >= 0 { return ibuf_get(c.entries, idx * 3 + 2) }
    h := _gui_create_font(gdi, face, sz, w)
    if h == 0 { return 0 }
    if c.count < 32 {
        ibuf_push(c.entries, sz)
        ibuf_push(c.entries, w)
        ibuf_push(c.entries, h)
        c.count += 1
    } else {
        // Evict slot 0 cleanly to avoid GDI leak or IntBuf OOB
        f_delo := ffi_sym(gdi, "DeleteObject")
        old_h := ibuf_get(c.entries, 2)
        if f_delo != 0 and old_h != 0 { _ := ffi_call1(f_delo, old_h) }
        ibuf_set(c.entries, 0, sz)
        ibuf_set(c.entries, 1, w)
        ibuf_set(c.entries, 2, h)
    }
    return h
}

fn gui_font_cache_free(move c: GuiFontCache, gdi: i64) {
    f_delo := ffi_sym(gdi, "DeleteObject")
    if f_delo != 0 {
        mut i := 0
        while i < c.count {
            _ := ffi_call1(f_delo, ibuf_get(c.entries, i * 3 + 2))
            i += 1
        }
    }
    buf_free(move c.entries)
}

// ==============================================================================
// AXON PHOTON-D2D ENGINE: Hardware Direct2D + DirectWrite Native HTML/CSS/Tailwind
// Zero Browser, Zero WebView, Zero Blur, 0.00% Idle CPU, Persistent Backbuffer!
// ==============================================================================

struct PhotonD2D {
    ok: bool
    d2d_fac: i64
    dw_fac: i64
    rt: i64
    brush: i64
    mem_dc: i64
    hbm: i64
    old_bm: i64
    bb_w: i64
    bb_h: i64
    tf_entries: IntBuf // [size, weight, h_align, v_align, wrap, ptr] * count
    tf_count: i64
    k32: i64
    f_mb2w: i64
    f_gdc: i64
    f_rdc: i64
    f_cdc: i64
    f_cbm: i64
    f_sel: i64
    f_delo: i64
    f_deldc: i64
    f_bkit: i64
    scratch: i64
    out_box: i64
    wbuf: i64
    wcap: i64
    dpi: i64
    gdiplus: i64
    gdip_tok: i64
    img_entries: IntBuf
    img_count: i64
    color_lut: IntBuf  // 256-entry precomputed u8 -> IEEE-754 f32 LUT (O(1) color upload!)
    blt_args: IntBuf   // persistent 9-arg BitBlt buffer (0 allocs/frame!)
    aa_mode: i64       // cached D2D1_ANTIALIAS_MODE (-1 unset, 0 PER_PRIMITIVE, 1 ALIASED)
}

fn _p2d_vt(obj: i64, idx: i64) -> i64 {
    return ffi_read_i64(ffi_read_i64(obj, 0), idx)
}

fn _p2d_f32_ratio(num: i64, den: i64) -> i64 {
    if num == 0 or den == 0 { return 0 }
    mut s := 0
    mut a := num
    mut b := den
    if a == (1 << 63) { s = 0x80000000; a = (1 << 62); b = if b > 1 or b < -1 { b / 2 } else { b } }
    else if a < 0 { s = 0x80000000; a = 0 - a }
    if b == (1 << 63) { s = s ^ 0x80000000; b = (1 << 62); a = a / 2 }
    else if b < 0 { s = s ^ 0x80000000; b = 0 - b }
    if a <= 0 or b <= 0 { return 0 }
    mut exp := 127
    while a < b and exp > 1 and a <= (1 << 61) { a *= 2; exp -= 1 }
    while b <= (1 << 61) and a >= b * 2 and exp < 254 { b *= 2; exp += 1 }
    while a >= (1 << 39) or b >= (1 << 39) {
        a = a >> 1
        b = b >> 1
    }
    if b <= 0 { return s | (254 << 23) }
    mant := (((a - b) << 23) + (b / 2)) / b
    if mant >= 0x800000 {
        exp += 1
        if exp > 254 { exp = 254 }
        return s | (exp << 23)
    }
    if exp < 1 { return 0 }
    if exp > 254 { exp = 254 }
    return s | ((exp & 0xFF) << 23) | (mant & 0x7FFFFF)
}

fn _p2d_f32(v: i64) -> i64 {
    return _p2d_f32_ratio(v, 1)
}

fn _p2d_apply_opacity(argb: i64, op_pct: i64) -> i64 {
    if op_pct >= 100 { return argb }
    if op_pct <= 0 { return argb & 0x00FFFFFF }
    a := (((argb >> 24) & 0xFF) * op_pct) / 100
    return (a << 24) | (argb & 0x00FFFFFF)
}

fn _p2d_write_color_lut(lut: IntBuf, buf: i64, argb: i64) {
    a := (argb >> 24) & 0xFF
    r := (argb >> 16) & 0xFF
    g := (argb >> 8) & 0xFF
    b := argb & 0xFF
    ffi_write_u32_le(buf, 0, ibuf_get(lut, r))
    ffi_write_u32_le(buf, 4, ibuf_get(lut, g))
    ffi_write_u32_le(buf, 8, ibuf_get(lut, b))
    ffi_write_u32_le(buf, 12, ibuf_get(lut, a))
}

fn _p2d_write_color(buf: i64, argb: i64) {
    a := (argb >> 24) & 0xFF
    r := (argb >> 16) & 0xFF
    g := (argb >> 8) & 0xFF
    b := argb & 0xFF
    ffi_write_u32_le(buf, 0, _p2d_f32_ratio(r, 255))
    ffi_write_u32_le(buf, 4, _p2d_f32_ratio(g, 255))
    ffi_write_u32_le(buf, 8, _p2d_f32_ratio(b, 255))
    ffi_write_u32_le(buf, 12, _p2d_f32_ratio(a, 255))
}

fn _p2d_set_aa(mut d2d: PhotonD2D, mode: i64) {
    if d2d.aa_mode == mode { return }
    _ := ffi_call2(_p2d_vt(d2d.rt, 32), d2d.rt, mode)
    d2d.aa_mode = mode
}

fn _p2d_write_rect(buf: i64, x: i64, y: i64, w: i64, h: i64) {
    ffi_write_u32_le(buf, 0, _p2d_f32(x))
    ffi_write_u32_le(buf, 4, _p2d_f32(y))
    ffi_write_u32_le(buf, 8, _p2d_f32(x + w))
    ffi_write_u32_le(buf, 12, _p2d_f32(y + h))
}

fn _p2d_write_rrect(buf: i64, x: i64, y: i64, w: i64, h: i64, rad: i64) {
    _p2d_write_rect(buf, x, y, w, h)
    rf := _p2d_f32(rad)
    ffi_write_u32_le(buf, 16, rf)
    ffi_write_u32_le(buf, 20, rf)
}

fn photon_d2d_init(win: GuiWindow) -> PhotonD2D {
    k32 := ffi_open_one("kernel32.dll")
    clut := ibuf_new(256)
    mut ci := 0
    while ci < 256 {
        ibuf_push(clut, _p2d_f32_ratio(ci, 255))
        ci += 1
    }
    bargs := ibuf_new(12)
    mut bi := 0
    while bi < 9 {
        ibuf_push(bargs, 0)
        bi += 1
    }
    mut d2d := PhotonD2D(
        ok = false, d2d_fac = 0, dw_fac = 0, rt = 0, brush = 0,
        mem_dc = 0, hbm = 0, old_bm = 0, bb_w = 0, bb_h = 0,
        tf_entries = ibuf_new(768), tf_count = 0,
        k32 = k32,
        f_mb2w = if k32 != 0 { ffi_sym(k32, "MultiByteToWideChar") } else { 0 },
        f_gdc = ffi_sym(win.user32, "GetDC"),
        f_rdc = ffi_sym(win.user32, "ReleaseDC"),
        f_cdc = ffi_sym(win.gdi32, "CreateCompatibleDC"),
        f_cbm = ffi_sym(win.gdi32, "CreateCompatibleBitmap"),
        f_sel = ffi_sym(win.gdi32, "SelectObject"),
        f_delo = ffi_sym(win.gdi32, "DeleteObject"),
        f_deldc = ffi_sym(win.gdi32, "DeleteDC"),
        f_bkit = ffi_sym(win.gdi32, "BitBlt"),
        scratch = ffi_alloc(512),
        out_box = ffi_alloc(16),
        wbuf = ffi_alloc(16384),
        wcap = 8188,
        dpi = gui_get_dpi(win),
        gdiplus = 0,
        gdip_tok = 0,
        img_entries = ibuf_new(256),
        img_count = 0,
        color_lut = clut,
        blt_args = bargs,
        aa_mode = -1
    )
    if win.backend != 1 or d2d.scratch == 0 or d2d.out_box == 0 or d2d.wbuf == 0 { return d2d }
    lib_d2d := ffi_open_one("d2d1.dll")
    lib_dw  := ffi_open_one("dwrite.dll")
    if lib_d2d == 0 or lib_dw == 0 { return d2d }
    f_d2d := ffi_sym(lib_d2d, "D2D1CreateFactory")
    f_dw  := ffi_sym(lib_dw, "DWriteCreateFactory")
    if f_d2d == 0 or f_dw == 0 { return d2d }

    iid_d2d := ffi_alloc(16)
    ffi_write_u32_le(iid_d2d, 0, 0x06152247); ffi_write_u16_le(iid_d2d, 4, 0x6f50); ffi_write_u16_le(iid_d2d, 6, 0x465a)
    ffi_write_u8(iid_d2d, 8, 0x92); ffi_write_u8(iid_d2d, 9, 0x45); ffi_write_u8(iid_d2d, 10, 0x11); ffi_write_u8(iid_d2d, 11, 0x8b)
    ffi_write_u8(iid_d2d, 12, 0xfd); ffi_write_u8(iid_d2d, 13, 0x3b); ffi_write_u8(iid_d2d, 14, 0x60); ffi_write_u8(iid_d2d, 15, 0x07)

    iid_dw := ffi_alloc(16)
    ffi_write_u32_le(iid_dw, 0, 0xb859ee5a); ffi_write_u16_le(iid_dw, 4, 0xd838); ffi_write_u16_le(iid_dw, 6, 0x4b5b)
    ffi_write_u8(iid_dw, 8, 0xa2); ffi_write_u8(iid_dw, 9, 0xe8); ffi_write_u8(iid_dw, 10, 0x1a); ffi_write_u8(iid_dw, 11, 0xdc)
    ffi_write_u8(iid_dw, 12, 0x7d); ffi_write_u8(iid_dw, 13, 0x93); ffi_write_u8(iid_dw, 14, 0xdb); ffi_write_u8(iid_dw, 15, 0x48)

    hr1 := ffi_call4(f_d2d, 0, iid_d2d, 0, d2d.out_box) & 0xFFFFFFFF
    d2d.d2d_fac = ffi_read_i64(d2d.out_box, 0)
    hr2 := ffi_call3(f_dw, 0, iid_dw, d2d.out_box) & 0xFFFFFFFF
    d2d.dw_fac = ffi_read_i64(d2d.out_box, 0)
    ffi_free(iid_d2d); ffi_free(iid_dw)
    if hr1 != 0 or hr2 != 0 or d2d.d2d_fac == 0 or d2d.dw_fac == 0 { return d2d }

    props := d2d.scratch
    ffi_write_u32_le(props, 0, 0)
    ffi_write_u32_le(props, 4, 87) // DXGI_FORMAT_B8G8R8A8_UNORM
    ffi_write_u32_le(props, 8, 3)  // D2D1_ALPHA_MODE_IGNORE
    // Native Per-Monitor DPI (96 / 120 / 144 / 192): Direct2D + DirectWrite render at full physical resolution (0 blur!)
    ffi_write_u32_le(props, 12, _p2d_f32(d2d.dpi))
    ffi_write_u32_le(props, 16, _p2d_f32(d2d.dpi))
    ffi_write_u32_le(props, 20, 0)
    ffi_write_u32_le(props, 24, 0)
    hr3 := ffi_call3(_p2d_vt(d2d.d2d_fac, 16), d2d.d2d_fac, props, d2d.out_box) & 0xFFFFFFFF
    d2d.rt = ffi_read_i64(d2d.out_box, 0)
    if hr3 != 0 or d2d.rt == 0 { return d2d }

    // D2D1_TEXT_ANTIALIAS_MODE_CLEARTYPE (1): 3x horizontal LCD subpixel sharpness identical to Chrome/Edge!
    _ := ffi_call2(_p2d_vt(d2d.rt, 34), d2d.rt, 1)

    _p2d_write_color(d2d.scratch, 0xFFFFFFFF)
    hr4 := ffi_call4(_p2d_vt(d2d.rt, 8), d2d.rt, d2d.scratch, 0, d2d.out_box) & 0xFFFFFFFF
    d2d.brush = ffi_read_i64(d2d.out_box, 0)
    if hr4 != 0 or d2d.brush == 0 { return d2d }

    d2d.ok = true
    return d2d
}

fn photon_d2d_free(move d2d: PhotonD2D) {
    if d2d.mem_dc != 0 {
        if d2d.old_bm != 0 { _ := ffi_call2(d2d.f_sel, d2d.mem_dc, d2d.old_bm) }
        if d2d.hbm != 0 { _ := ffi_call1(d2d.f_delo, d2d.hbm) }
        _ := ffi_call1(d2d.f_deldc, d2d.mem_dc)
    }
    mut i := 0
    while i < d2d.tf_count {
        tf := ibuf_get(d2d.tf_entries, i * 6 + 5)
        if tf != 0 { _ := ffi_call1(_p2d_vt(tf, 2), tf) }
        i += 1
    }
    buf_free(move d2d.tf_entries)
    i = 0
    while i < d2d.img_count {
        bmp := ibuf_get(d2d.img_entries, i * 4 + 1)
        if bmp != 0 { _ := ffi_call1(_p2d_vt(bmp, 2), bmp) }
        i += 1
    }
    buf_free(move d2d.img_entries)
    buf_free(move d2d.color_lut)
    buf_free(move d2d.blt_args)
    if d2d.gdip_tok != 0 and d2d.gdiplus != 0 {
        f_sd := ffi_sym(d2d.gdiplus, "GdiplusShutdown")
        if f_sd != 0 { _ := ffi_call1(f_sd, d2d.gdip_tok) }
    }
    if d2d.brush != 0 { _ := ffi_call1(_p2d_vt(d2d.brush, 2), d2d.brush) }
    if d2d.rt != 0 { _ := ffi_call1(_p2d_vt(d2d.rt, 2), d2d.rt) }
    if d2d.dw_fac != 0 { _ := ffi_call1(_p2d_vt(d2d.dw_fac, 2), d2d.dw_fac) }
    if d2d.d2d_fac != 0 { _ := ffi_call1(_p2d_vt(d2d.d2d_fac, 2), d2d.d2d_fac) }
    ffi_free(d2d.scratch); ffi_free(d2d.out_box); ffi_free(d2d.wbuf)
}

fn _p2d_ensure_bb(mut d2d: PhotonD2D, hdc: i64, w: i64, h: i64) -> bool {
    if d2d.mem_dc != 0 and d2d.hbm != 0 and d2d.bb_w == w and d2d.bb_h == h {
        return true
    }
    if d2d.mem_dc != 0 {
        if d2d.old_bm != 0 { _ := ffi_call2(d2d.f_sel, d2d.mem_dc, d2d.old_bm) }
        if d2d.hbm != 0 { _ := ffi_call1(d2d.f_delo, d2d.hbm) }
        _ := ffi_call1(d2d.f_deldc, d2d.mem_dc)
        d2d.mem_dc = 0; d2d.hbm = 0; d2d.old_bm = 0
    }
    d2d.mem_dc = ffi_call1(d2d.f_cdc, hdc)
    if d2d.mem_dc == 0 { return false }
    d2d.hbm = ffi_call3(d2d.f_cbm, hdc, w, h)
    if d2d.hbm == 0 { _ := ffi_call1(d2d.f_deldc, d2d.mem_dc); d2d.mem_dc = 0; return false }
    d2d.old_bm = ffi_call2(d2d.f_sel, d2d.mem_dc, d2d.hbm)
    d2d.bb_w = w; d2d.bb_h = h

    rc := d2d.scratch + 128
    ffi_write_u32_le(rc, 0, 0); ffi_write_u32_le(rc, 4, 0)
    ffi_write_u32_le(rc, 8, w); ffi_write_u32_le(rc, 12, h)
    return (ffi_call3(_p2d_vt(d2d.rt, 57), d2d.rt, d2d.mem_dc, rc) & 0xFFFFFFFF) == 0
}

fn _p2d_get_text_format(mut d2d: PhotonD2D, sz_in: i64, weight_in: i64, h_align: i64, v_align: i64, wrap: i64, is_mono: bool = false, is_italic: bool = false, ellipsis: bool = false) -> i64 {
    mut sz := sz_in
    if sz < 8 { sz = 8 } else if sz > 96 { sz = 96 }
    mut w := weight_in
    if w < 100 or w > 900 { w = 400 }
    wrap_key := wrap | (if is_mono { 4 } else { 0 }) | (if is_italic { 8 } else { 0 }) | (if ellipsis { 16 } else { 0 })
    mut i := 0
    while i < d2d.tf_count {
        b := i * 6
        if ibuf_get(d2d.tf_entries, b) == sz and ibuf_get(d2d.tf_entries, b + 1) == w and ibuf_get(d2d.tf_entries, b + 2) == h_align and ibuf_get(d2d.tf_entries, b + 3) == v_align and ibuf_get(d2d.tf_entries, b + 4) == wrap_key {
            return ibuf_get(d2d.tf_entries, b + 5)
        }
        i += 1
    }
    w_face := ffi_wstr(if is_mono { "Consolas" } else { "Segoe UI" })
    w_loc := ffi_wstr("en-US")
    fstyle := if is_italic { 2 } else { 0 } // DWRITE_FONT_STYLE_ITALIC = 2
    args := ibuf_new(12)
    ibuf_push(args, d2d.dw_fac); ibuf_push(args, w_face); ibuf_push(args, 0); ibuf_push(args, w)
    ibuf_push(args, fstyle); ibuf_push(args, 5); ibuf_push(args, _p2d_f32(sz)); ibuf_push(args, w_loc); ibuf_push(args, d2d.out_box)
    hr := ffi_call_arr(_p2d_vt(d2d.dw_fac, 15), 9, args) & 0xFFFFFFFF
    buf_free(move args)
    ffi_free(w_face); ffi_free(w_loc)
    if hr != 0 { return 0 }
    tf := ffi_read_i64(d2d.out_box, 0)
    if tf != 0 {
        _ := ffi_call2(_p2d_vt(tf, 3), tf, h_align)
        _ := ffi_call2(_p2d_vt(tf, 4), tf, v_align)
        _ := ffi_call2(_p2d_vt(tf, 5), tf, wrap)
        if ellipsis {
            // Native DirectWrite Ellipsis Trimming (`text-overflow: ellipsis` / Tailwind `truncate`!)
            hr_es := ffi_call3(_p2d_vt(d2d.dw_fac, 20), d2d.dw_fac, tf, d2d.out_box) & 0xFFFFFFFF
            sign := if hr_es == 0 { ffi_read_i64(d2d.out_box, 0) } else { 0 }
            trim_opt := d2d.scratch + 384
            ffi_write_u32_le(trim_opt, 0, 1) // DWRITE_TRIMMING_GRANULARITY_CHARACTER
            ffi_write_u32_le(trim_opt, 4, 0)
            ffi_write_u32_le(trim_opt, 8, 0)
            _ := ffi_call3(_p2d_vt(tf, 9), tf, trim_opt, sign)
            if sign != 0 { _ := ffi_call1(_p2d_vt(sign, 2), sign) }
        }
        if d2d.tf_count < 126 {
            ibuf_push(d2d.tf_entries, sz); ibuf_push(d2d.tf_entries, w)
            ibuf_push(d2d.tf_entries, h_align); ibuf_push(d2d.tf_entries, v_align)
            ibuf_push(d2d.tf_entries, wrap_key); ibuf_push(d2d.tf_entries, tf)
            d2d.tf_count += 1
        } else {
            old_tf := ibuf_get(d2d.tf_entries, 5)
            if old_tf != 0 { _ := ffi_call1(_p2d_vt(old_tf, 2), old_tf) }
            ibuf_set(d2d.tf_entries, 0, sz); ibuf_set(d2d.tf_entries, 1, w)
            ibuf_set(d2d.tf_entries, 2, h_align); ibuf_set(d2d.tf_entries, 3, v_align)
            ibuf_set(d2d.tf_entries, 4, wrap_key); ibuf_set(d2d.tf_entries, 5, tf)
        }
    }
    return tf
}

fn _p2d_fill_rrect(mut d2d: PhotonD2D, x: i64, y: i64, w: i64, h: i64, rad: i64, argb: i64) {
    if w <= 0 or h <= 0 or ((argb >> 24) & 0xFF) == 0 { return }
    _p2d_set_aa(mut d2d, if rad == 0 { 1 } else { 0 })
    _p2d_write_color_lut(d2d.color_lut, d2d.scratch, argb)
    _ := ffi_call2(_p2d_vt(d2d.brush, 8), d2d.brush, d2d.scratch)
    rr := d2d.scratch + 32
    _p2d_write_rrect(rr, x, y, w, h, rad)
    _ := ffi_call3(_p2d_vt(d2d.rt, 19), d2d.rt, rr, d2d.brush)
}

// Hardware anti-aliased hollow rounded border/ring (100% pointer ABI via D2D GeometryGroup ALTERNATE fill!)
// Renders crisp rounded borders on glass/transparent surfaces & focus rings with zero XMM float ABI issues!
fn _p2d_stroke_rrect(mut d2d: PhotonD2D, x: i64, y: i64, w: i64, h: i64, rad_in: i64, bw_in: i64, argb: i64) {
    if w <= 0 or h <= 0 or bw_in <= 0 or ((argb >> 24) & 0xFF) == 0 { return }
    mut bw := bw_in
    if bw > 256 { bw = 256 }
    mut rad := rad_in
    if rad < 0 { rad = 0 } else if rad > 8192 { rad = 8192 }
    if rad <= 0 {
        _p2d_fill_rrect(mut d2d, x, y, w, bw, 0, argb)
        _p2d_fill_rrect(mut d2d, x, y + h - bw, w, bw, 0, argb)
        _p2d_fill_rrect(mut d2d, x, y + bw, bw, h - bw * 2, 0, argb)
        _p2d_fill_rrect(mut d2d, x + w - bw, y + bw, bw, h - bw * 2, 0, argb)
        return
    }
    iw := w - bw * 2
    ih := h - bw * 2
    if iw <= 0 or ih <= 0 {
        _p2d_fill_rrect(mut d2d, x, y, w, h, rad, argb)
        return
    }
    mut irad := rad - bw
    if irad < 0 { irad = 0 }
    rr_out := d2d.scratch + 32
    rr_in  := d2d.scratch + 64
    _p2d_write_rrect(rr_out, x, y, w, h, rad)
    _p2d_write_rrect(rr_in, x + bw, y + bw, iw, ih, irad)

    hr1 := ffi_call3(_p2d_vt(d2d.d2d_fac, 6), d2d.d2d_fac, rr_out, d2d.out_box) & 0xFFFFFFFF
    if hr1 != 0 { return }
    g_out := ffi_read_i64(d2d.out_box, 0)
    hr2 := ffi_call3(_p2d_vt(d2d.d2d_fac, 6), d2d.d2d_fac, rr_in, d2d.out_box) & 0xFFFFFFFF
    if hr2 != 0 { _ := ffi_call1(_p2d_vt(g_out, 2), g_out); return }
    g_in := ffi_read_i64(d2d.out_box, 0)

    g_arr := d2d.scratch + 384
    ffi_write_i64(g_arr, 0, g_out)
    ffi_write_i64(g_arr, 1, g_in)
    // ID2D1Factory::CreateGeometryGroup(D2D1_FILL_MODE_ALTERNATE=0, geoms, 2, &group) -> slot 8
    hr3 := ffi_call5(_p2d_vt(d2d.d2d_fac, 8), d2d.d2d_fac, 0, g_arr, 2, d2d.out_box) & 0xFFFFFFFF
    if hr3 == 0 {
        grp := ffi_read_i64(d2d.out_box, 0)
        _p2d_set_aa(mut d2d, 0)
        _p2d_write_color_lut(d2d.color_lut, d2d.scratch, argb)
        _ := ffi_call2(_p2d_vt(d2d.brush, 8), d2d.brush, d2d.scratch)
        _ := ffi_call4(_p2d_vt(d2d.rt, 23), d2d.rt, grp, d2d.brush, 0) // FillGeometry
        _ := ffi_call1(_p2d_vt(grp, 2), grp)
    }
    _ := ffi_call1(_p2d_vt(g_in, 2), g_in)
    _ := ffi_call1(_p2d_vt(g_out, 2), g_out)
}

// Helper to create Linear (dir 1..8) or Radial (dir 9) Gradient Brush (caller must Release)
fn _p2d_create_grad_brush(d2d: PhotonD2D, x: i64, y: i64, w: i64, h: i64, dir: i64, c_from: i64, c_to: i64, c_via: i64 = 0) -> i64 {
    stops := d2d.scratch + 160
    mut stop_cnt := 2
    ffi_write_u32_le(stops, 0, 0) // 0.0f
    _p2d_write_color_lut(d2d.color_lut, stops + 4, c_from)
    if c_via != 0 {
        ffi_write_u32_le(stops, 20, 0x3F000000) // 0.5f exact IEEE-754!
        _p2d_write_color_lut(d2d.color_lut, stops + 24, c_via)
        ffi_write_u32_le(stops, 40, 0x3F800000) // 1.0f exact IEEE-754!
        _p2d_write_color_lut(d2d.color_lut, stops + 44, c_to)
        stop_cnt = 3
    } else {
        ffi_write_u32_le(stops, 20, 0x3F800000) // 1.0f
        _p2d_write_color_lut(d2d.color_lut, stops + 24, c_to)
    }

    hr_s := ffi_call6(_p2d_vt(d2d.rt, 9), d2d.rt, stops, stop_cnt, 0, 0, d2d.out_box) & 0xFFFFFFFF
    if hr_s != 0 { return 0 }
    scoll := ffi_read_i64(d2d.out_box, 0)
    gp := d2d.scratch + 240
    mut hr_g := 1
    if dir == 9 {
        // D2D1_RADIAL_GRADIENT_BRUSH_PROPERTIES: center(cx,cy), offset(0,0), radiusX(w/2), radiusY(h/2)
        ffi_write_u32_le(gp, 0, _p2d_f32(x + w / 2))
        ffi_write_u32_le(gp, 4, _p2d_f32(y + h / 2))
        ffi_write_u32_le(gp, 8, 0)
        ffi_write_u32_le(gp, 12, 0)
        ffi_write_u32_le(gp, 16, _p2d_f32(if w > 1 { w / 2 } else { 1 }))
        ffi_write_u32_le(gp, 20, _p2d_f32(if h > 1 { h / 2 } else { 1 }))
        hr_g = ffi_call5(_p2d_vt(d2d.rt, 11), d2d.rt, gp, 0, scoll, d2d.out_box) & 0xFFFFFFFF
    } else {
        // Full 8-direction linear gradients: 1=r, 2=b, 3=br, 4=l, 5=t, 6=tr, 7=tl, 8=bl
        mut sx := x; mut sy := y; mut ex := x + w; mut ey := y + h
        if dir == 1 { ey = y }                       // to-r
        else if dir == 2 { ex = x }                  // to-b
        else if dir == 4 { sx = x + w; ex = x; ey = y } // to-l
        else if dir == 5 { sy = y + h; ex = x; ey = y } // to-t
        else if dir == 6 { sy = y + h; ey = y }      // to-tr
        else if dir == 7 { sx = x + w; sy = y + h; ex = x; ey = y } // to-tl
        else if dir == 8 { sx = x + w; ex = x }      // to-bl
        ffi_write_u32_le(gp, 0, _p2d_f32(sx))
        ffi_write_u32_le(gp, 4, _p2d_f32(sy))
        ffi_write_u32_le(gp, 8, _p2d_f32(ex))
        ffi_write_u32_le(gp, 12, _p2d_f32(ey))
        hr_g = ffi_call5(_p2d_vt(d2d.rt, 10), d2d.rt, gp, 0, scoll, d2d.out_box) & 0xFFFFFFFF
    }
    _ := ffi_call1(_p2d_vt(scoll, 2), scoll)
    if hr_g != 0 { return 0 }
    return ffi_read_i64(d2d.out_box, 0)
}

fn _p2d_fill_grad_rrect(mut d2d: PhotonD2D, x: i64, y: i64, w: i64, h: i64, rad: i64, dir: i64, c_from: i64, c_to: i64, c_via: i64 = 0) {
    if w <= 0 or h <= 0 { return }
    gb := _p2d_create_grad_brush(d2d, x, y, w, h, dir, c_from, c_to, c_via)
    if gb == 0 { _p2d_fill_rrect(mut d2d, x, y, w, h, rad, c_from); return }
    _p2d_set_aa(mut d2d, if rad == 0 { 1 } else { 0 })
    rr := d2d.scratch + 32
    _p2d_write_rrect(rr, x, y, w, h, rad)
    _ := ffi_call3(_p2d_vt(d2d.rt, 19), d2d.rt, rr, gb)
    _ := ffi_call1(_p2d_vt(gb, 2), gb)
}

fn _p2d_cache_neg_img(mut d2d: PhotonD2D, ph: i64) {
    if d2d.img_count < 60 {
        ibuf_push(d2d.img_entries, ph)
        ibuf_push(d2d.img_entries, 0)
        ibuf_push(d2d.img_entries, 0)
        ibuf_push(d2d.img_entries, 0)
        d2d.img_count += 1
    }
}

// Hardware Direct2D Vector Icon Renderer for `<svg data-icon="...">` / `<icon>` (zero external icon fonts!)
fn _p2d_fill_circle(mut d2d: PhotonD2D, cx: i64, cy: i64, r: i64, argb: i64) {
    if r <= 0 or ((argb >> 24) & 0xFF) == 0 { return }
    _p2d_set_aa(mut d2d, 0)
    _p2d_write_color_lut(d2d.color_lut, d2d.scratch, argb)
    _ := ffi_call2(_p2d_vt(d2d.brush, 8), d2d.brush, d2d.scratch)
    el := d2d.scratch + 32
    ffi_write_u32_le(el, 0, _p2d_f32(cx))
    ffi_write_u32_le(el, 4, _p2d_f32(cy))
    ffi_write_u32_le(el, 8, _p2d_f32(r))
    ffi_write_u32_le(el, 12, _p2d_f32(r))
    _ := ffi_call3(_p2d_vt(d2d.rt, 21), d2d.rt, el, d2d.brush) // FillEllipse
}

fn _p2d_draw_svg_icon(mut d2d: PhotonD2D, name: str, x: i64, y: i64, w: i64, h: i64, col: i64) {
    sz := if w < h { w } else { h }
    if sz < 6 { return }
    ox := x + (w - sz) / 2
    oy := y + (h - sz) / 2
    cx := ox + sz / 2
    cy := oy + sz / 2
    r := sz / 2 - 2
    if str_eq(name, "moon") or str_eq(name, "theme") {
        _p2d_stroke_rrect(mut d2d, ox + 2, oy + 2, sz - 4, sz - 4, r, 2, col)
        _p2d_fill_rrect(mut d2d, cx, oy + 3, sz / 2 - 3, sz - 6, r - 1, col)
    } else if str_eq(name, "gear") or str_eq(name, "settings") {
        _p2d_stroke_rrect(mut d2d, ox + 3, oy + 3, sz - 6, sz - 6, r - 1, 2, col)
        _p2d_fill_circle(mut d2d, cx, cy, 2, col)
        _p2d_fill_rrect(mut d2d, cx - 1, oy + 1, 2, 3, 1, col)
        _p2d_fill_rrect(mut d2d, cx - 1, oy + sz - 4, 2, 3, 1, col)
        _p2d_fill_rrect(mut d2d, ox + 1, cy - 1, 3, 2, 1, col)
        _p2d_fill_rrect(mut d2d, ox + sz - 4, cy - 1, 3, 2, 1, col)
    } else if str_eq(name, "plus") {
        _p2d_fill_rrect(mut d2d, cx - 1, oy + 3, 2, sz - 6, 1, col)
        _p2d_fill_rrect(mut d2d, ox + 3, cy - 1, sz - 6, 2, 1, col)
    } else if str_eq(name, "sidebar") or str_eq(name, "collapse") {
        _p2d_stroke_rrect(mut d2d, ox + 2, oy + 3, sz - 4, sz - 6, 3, 1, col)
        _p2d_fill_rrect(mut d2d, ox + 6, oy + 3, 1, sz - 6, 0, col)
    } else if str_eq(name, "search") {
        _p2d_stroke_rrect(mut d2d, ox + 2, oy + 2, sz - 6, sz - 6, (sz - 6) / 2, 2, col)
        _p2d_fill_rrect(mut d2d, ox + sz - 5, oy + sz - 5, 4, 2, 1, col)
    } else if str_eq(name, "artifacts") or str_eq(name, "layers") {
        _p2d_stroke_rrect(mut d2d, ox + 2, oy + 2, sz - 5, sz - 5, 3, 1, col)
        _p2d_fill_rrect(mut d2d, ox + 5, oy + 6, sz - 10, 2, 1, col)
        _p2d_fill_rrect(mut d2d, ox + 5, oy + 10, sz - 12, 2, 1, col)
    } else if str_eq(name, "send") {
        _p2d_fill_rrect(mut d2d, ox + 3, cy - 1, sz - 6, 2, 1, col)
        _p2d_fill_rrect(mut d2d, ox + sz - 5, oy + 4, 2, cy - oy - 3, 1, col)
        _p2d_fill_rrect(mut d2d, ox + 3, cy - 3, 2, 6, 1, col)
    } else if str_eq(name, "shield") {
        _p2d_stroke_rrect(mut d2d, ox + 3, oy + 2, sz - 6, sz - 4, 4, 2, col)
        _p2d_fill_rrect(mut d2d, cx - 1, oy + 6, 2, sz - 12, 1, col)
    } else if str_eq(name, "terminal") {
        _p2d_stroke_rrect(mut d2d, ox + 2, oy + 3, sz - 4, sz - 6, 3, 1, col)
        _p2d_fill_rrect(mut d2d, ox + 5, cy - 2, 3, 2, 0, col)
        _p2d_fill_rrect(mut d2d, ox + 9, cy + 1, 4, 2, 0, col)
    } else {
        // Default crisp rounded emblem dot
        _p2d_fill_circle(mut d2d, cx, cy, if r > 2 { r - 1 } else { 2 }, col)
    }
}

fn _p2d_is_reserved_img_path(path: str) -> bool {
    if str_contains(path, "..") { return true }
    n := str_len(path)
    mut st := 0
    while st < n {
        mut en := st
        while en < n and str_byte(path, en) != 47 and str_byte(path, en) != 92 { en += 1 }
        seg := str_slice(path, st, en)
        dot := str_find_byte(seg, 46, 0)
        base := if dot >= 0 { str_slice(seg, 0, dot) } else { seg }
        bl := str_len(base)
        if bl == 3 and (str_eq_ignore_case(base, "CON") or str_eq_ignore_case(base, "PRN") or str_eq_ignore_case(base, "AUX") or str_eq_ignore_case(base, "NUL")) {
            return true
        }
        if bl == 4 {
            b3 := str_byte(base, 3)
            if b3 >= 49 and b3 <= 57 {
                pr := str_slice(base, 0, 3)
                if str_eq_ignore_case(pr, "COM") or str_eq_ignore_case(pr, "LPT") { return true }
            }
        }
        st = en + 1
    }
    return false
}

// Native PNG/JPG/BMP/GIF/ICO image loader via Windows `gdiplus.dll` -> cached `ID2D1Bitmap` (with negative-caching & CWE-22 guard!)
fn _p2d_find_or_load_img(mut d2d: PhotonD2D, path: str) -> i64 {
    pn := str_len(path)
    if pn == 0 or pn > 512 or not d2d.ok { return -1 }
    if pn >= 2 and (str_byte(path, 0) == 92 or str_byte(path, 0) == 47) and (str_byte(path, 1) == 92 or str_byte(path, 1) == 47) {
        return -1
    }
    if _p2d_is_reserved_img_path(path) { return -1 }
    mut pi := 0
    while pi < pn {
        if str_byte(path, pi) == 0 { return -1 }
        pi += 1
    }
    ph := fnv1a_64(path)
    mut i := 0
    while i < d2d.img_count {
        if ibuf_get(d2d.img_entries, i * 4) == ph {
            return if ibuf_get(d2d.img_entries, i * 4 + 1) != 0 { i } else { -1 }
        }
        i += 1
    }
    if d2d.img_count >= 60 { return -1 }

    if d2d.gdiplus == 0 {
        d2d.gdiplus = ffi_open_one("gdiplus.dll")
        if d2d.gdiplus == 0 { _p2d_cache_neg_img(mut d2d, ph); return -1 }
        f_st := ffi_sym(d2d.gdiplus, "GdiplusStartup")
        if f_st == 0 { _p2d_cache_neg_img(mut d2d, ph); return -1 }
        si := ffi_alloc(32)
        ffi_write_u32_le(si, 0, 1) // GdiplusVersion = 1
        tok_box := ffi_alloc(16)
        st := ffi_call3(f_st, tok_box, si, 0) & 0xFFFFFFFF
        d2d.gdip_tok = ffi_read_i64(tok_box, 0)
        ffi_free(tok_box); ffi_free(si)
        if st != 0 { d2d.gdiplus = 0; _p2d_cache_neg_img(mut d2d, ph); return -1 }
    }

    f_load := ffi_sym(d2d.gdiplus, "GdipCreateBitmapFromFile")
    f_gw   := ffi_sym(d2d.gdiplus, "GdipGetImageWidth")
    f_gh   := ffi_sym(d2d.gdiplus, "GdipGetImageHeight")
    f_lock := ffi_sym(d2d.gdiplus, "GdipBitmapLockBits")
    f_unlk := ffi_sym(d2d.gdiplus, "GdipBitmapUnlockBits")
    f_disp := ffi_sym(d2d.gdiplus, "GdipDisposeImage")
    if f_load == 0 or f_lock == 0 or f_disp == 0 { _p2d_cache_neg_img(mut d2d, ph); return -1 }

    wpath := _gui_utf8_to_utf16(d2d.k32, path)
    gp_box := ffi_alloc(16)
    st_l := ffi_call2(f_load, wpath, gp_box) & 0xFFFFFFFF
    gp_bmp := ffi_read_i64(gp_box, 0)
    ffi_free(gp_box); ffi_free(wpath)
    if st_l != 0 or gp_bmp == 0 { _p2d_cache_neg_img(mut d2d, ph); return -1 }

    wh_box := ffi_alloc(16)
    _ := ffi_call2(f_gw, gp_bmp, wh_box)
    _ := ffi_call2(f_gh, gp_bmp, wh_box + 8)
    iw := ffi_read_u32_le(wh_box, 0)
    ih := ffi_read_u32_le(wh_box, 8)
    ffi_free(wh_box)
    if iw <= 0 or ih <= 0 or iw > 8192 or ih > 8192 {
        _ := ffi_call1(f_disp, gp_bmp)
        _p2d_cache_neg_img(mut d2d, ph)
        return -1
    }

    rc := ffi_alloc(16)
    ffi_write_u32_le(rc, 0, 0); ffi_write_u32_le(rc, 4, 0)
    ffi_write_u32_le(rc, 8, iw); ffi_write_u32_le(rc, 12, ih)
    bdata := ffi_alloc(48)
    st_lk := ffi_call5(f_lock, gp_bmp, rc, 1, 0x000E200B, bdata) & 0xFFFFFFFF
    ffi_free(rc)
    mut d2d_bmp := 0
    if st_lk == 0 {
        stride := ffi_sext32(ffi_read_u32_le(bdata, 8))
        scan0  := ffi_read_i64(bdata, 2)
        if scan0 != 0 and stride > 0 {
            bprops := d2d.scratch + 280
            ffi_write_u32_le(bprops, 0, 87) // DXGI_FORMAT_B8G8R8A8_UNORM
            ffi_write_u32_le(bprops, 4, 1)  // D2D1_ALPHA_MODE_PREMULTIPLIED
            ffi_write_u32_le(bprops, 8, _p2d_f32(96))
            ffi_write_u32_le(bprops, 12, _p2d_f32(96))
            sz_u := (iw & 0xFFFFFFFF) | ((ih & 0xFFFFFFFF) << 32)
            hr_b := ffi_call6(_p2d_vt(d2d.rt, 4), d2d.rt, sz_u, scan0, stride, bprops, d2d.out_box) & 0xFFFFFFFF
            if hr_b == 0 { d2d_bmp = ffi_read_i64(d2d.out_box, 0) }
        }
        _ := ffi_call2(f_unlk, gp_bmp, bdata)
    }
    ffi_free(bdata)
    _ := ffi_call1(f_disp, gp_bmp)
    if d2d_bmp == 0 { _p2d_cache_neg_img(mut d2d, ph); return -1 }

    slot := d2d.img_count
    ibuf_push(d2d.img_entries, ph)
    ibuf_push(d2d.img_entries, d2d_bmp)
    ibuf_push(d2d.img_entries, iw)
    ibuf_push(d2d.img_entries, ih)
    d2d.img_count += 1
    return slot
}

fn _p2d_draw_img_rrect(mut d2d: PhotonD2D, path: str, x: i64, y: i64, w: i64, h: i64, rad: i64, obj_fit: i64 = 0) {
    if w <= 0 or h <= 0 { return }
    slot := _p2d_find_or_load_img(mut d2d, path)
    if slot < 0 { return }
    bmp := ibuf_get(d2d.img_entries, slot * 4 + 1)
    iw  := ibuf_get(d2d.img_entries, slot * 4 + 2)
    ih  := ibuf_get(d2d.img_entries, slot * 4 + 3)
    if bmp == 0 or iw <= 0 or ih <= 0 { return }

    // CreateBitmapBrush is ID2D1RenderTarget vtable slot 7!
    hr_bb := ffi_call5(_p2d_vt(d2d.rt, 7), d2d.rt, bmp, 0, 0, d2d.out_box) & 0xFFFFFFFF
    if hr_bb != 0 { return }
    bbrush := ffi_read_i64(d2d.out_box, 0)
    if bbrush == 0 { return }

    // Support CSS `object-fit`: 0 = fill, 1 = cover, 2 = contain
    mut sx_num := w; mut sx_den := iw
    mut sy_num := h; mut sy_den := ih
    mut tx := x; mut ty := y
    if obj_fit == 1 { // cover: max(w/iw, h/ih)
        if w * ih >= h * iw {
            sy_num = w; sy_den = iw
            scaled_h := (ih * w) / iw
            ty = y + (h - scaled_h) / 2
        } else {
            sx_num = h; sx_den = ih
            scaled_w := (iw * h) / ih
            tx = x + (w - scaled_w) / 2
        }
    } else if obj_fit == 2 { // contain: min(w/iw, h/ih)
        if w * ih <= h * iw {
            sy_num = w; sy_den = iw
            scaled_h := (ih * w) / iw
            ty = y + (h - scaled_h) / 2
        } else {
            sx_num = h; sx_den = ih
            scaled_w := (iw * h) / ih
            tx = x + (w - scaled_w) / 2
        }
    }
    mat := d2d.scratch + 240
    ffi_write_u32_le(mat, 0, _p2d_f32_ratio(sx_num, sx_den))
    ffi_write_u32_le(mat, 4, 0)
    ffi_write_u32_le(mat, 8, 0)
    ffi_write_u32_le(mat, 12, _p2d_f32_ratio(sy_num, sy_den))
    ffi_write_u32_le(mat, 16, _p2d_f32(tx))
    ffi_write_u32_le(mat, 20, _p2d_f32(ty))
    _ := ffi_call2(_p2d_vt(bbrush, 4), bbrush, mat) // ID2D1Brush::SetTransform

    _p2d_set_aa(mut d2d, if rad == 0 { 1 } else { 0 })
    rr := d2d.scratch + 32
    _p2d_write_rrect(rr, x, y, w, h, rad)
    _ := ffi_call3(_p2d_vt(d2d.rt, 19), d2d.rt, rr, bbrush)
    _ := ffi_call1(_p2d_vt(bbrush, 2), bbrush)
}

fn _p2d_capitalize(s: str) -> str {
    n := str_len(s)
    if n == 0 { return s }
    out := buf_new(n + 1)
    mut cap_next := true
    mut i := 0
    while i < n {
        b := str_byte(s, i)
        if b == 32 or b == 9 or b == 10 or b == 45 {
            cap_next = true
            buf_push(out, b)
        } else if cap_next and b >= 97 and b <= 122 {
            buf_push(out, b - 32)
            cap_next = false
        } else {
            buf_push(out, b)
            cap_next = false
        }
        i += 1
    }
    return buf_to_owned_str(move out)
}

fn _p2d_is_node_or_ancestor(tree: DomTree, node_idx: i64, target_idx: i64) -> bool {
    if target_idx < 0 or node_idx < 0 { return false }
    mut cur := target_idx
    mut hops := 0
    while cur >= 0 and hops < 64 {
        if cur == node_idx { return true }
        cur = dom_parent(tree, cur)
        hops += 1
    }
    return false
}

fn _p2d_paint_node(mut d2d: PhotonD2D, app: UiApp, node_idx: i64, hovered_node: i64, active_node: i64, acc_scroll_y: i64, dip_w: i64, dip_h: i64, p_style: ComputedStyle, has_p: bool, depth: i64 = 0) {
    if depth >= 64 or node_idx < 0 or node_idx >= app.tree.count { return }
    bw := layout_get_w(app.layout, node_idx)
    bh := layout_get_h(app.layout, node_idx)
    if bw <= 0 and bh <= 0 { return }
    bx := layout_get_x(app.layout, node_idx)
    raw_by := layout_get_y(app.layout, node_idx)

    is_hov := _p2d_is_node_or_ancestor(app.tree, node_idx, hovered_node)
    is_foc := (node_idx == app.focused_idx)
    is_act := _p2d_is_node_or_ancestor(app.tree, node_idx, active_node)
    style := css_compute_node_style_inherited(app.tree, node_idx, app.sheet, p_style, has_p, is_hov, is_foc, is_act)
    if style.display == 3 or style.opacity <= 0 { return }

    by := if style.position == 2 { raw_by } else { raw_by - acc_scroll_y }
    vis := bw > 0 and bh > 0 and bx + bw >= 0 and bx <= dip_w and by + bh >= 0 and by <= dip_h

    // Early-out entire offscreen clipped subtree (huge speedup on long scrollable lists!)
    if not vis and (style.overflow_hidden or style.overflow_scroll) {
        return
    }

    tag := dom_get_tag(app.tree, node_idx)

    if vis {
        mut rad := style.border_radius
        if rad > bw / 2 { rad = bw / 2 }
        if rad > bh / 2 { rad = bh / 2 }
        if rad < 0 { rad = 0 }

        // 1. 5-layer Feathered Web-Grade Elevation & Colored Glow Shadow (`shadow-sm..2xl` + `shadow-<color>`)
        if style.shadow > 0 and (style.bg_color != 0 or style.grad_dir > 0 or style.glass_blur > 0) {
            sh := style.shadow
            sc_rgb := if style.shadow_color != 0 { style.shadow_color & 0x00FFFFFF } else { 0x000000 }
            sc_mul := if style.shadow_color != 0 { ((style.shadow_color >> 24) & 0xFF) } else { 255 }
            a1 := (7 * sc_mul) / 255
            a2 := (13 * sc_mul) / 255
            a3 := (22 * sc_mul) / 255
            a4 := (32 * sc_mul) / 255
            _p2d_fill_rrect(mut d2d, bx - sh * 3, by + sh * 3 + 3, bw + sh * 6, bh + sh * 3, rad + sh * 2 + 2, (a1 << 24) | sc_rgb)
            _p2d_fill_rrect(mut d2d, bx - sh * 2, by + sh * 2 + 2, bw + sh * 4, bh + sh * 2, rad + sh + 2, (a2 << 24) | sc_rgb)
            _p2d_fill_rrect(mut d2d, bx - sh, by + sh + 1, bw + sh * 2, bh + sh, rad + sh, (a3 << 24) | sc_rgb)
            _p2d_fill_rrect(mut d2d, bx, by + (sh + 1) / 2, bw, bh + sh / 2 + 1, rad + 1, (a4 << 24) | sc_rgb)
        }

        // 2. Focus Glow + Separate Outer Accent Ring (`ring-*` / `ring-offset-*`)
        if is_foc {
            glow_col := if style.focus_border != 0 { (style.focus_border & 0x00FFFFFF) | 0x3C000000 } else { 0x3C3B82F6 }
            _p2d_stroke_rrect(mut d2d, bx - 3, by - 3, bw + 6, bh + 6, rad + 3, 3, glow_col)
        } else if style.ring_width > 0 and style.ring_color != 0 and (style.border_width > 0 and style.border_color != style.ring_color) {
            ro := style.ring_offset
            rw := style.ring_width
            r_col := _p2d_apply_opacity(style.ring_color, style.opacity)
            _p2d_stroke_rrect(mut d2d, bx - ro - rw, by - ro - rw, bw + (ro + rw) * 2, bh + (ro + rw) * 2, rad + ro + rw, rw, r_col)
        }

        has_bd := (style.border_width > 0 and style.border_color != 0) or is_foc
        has_grad := style.grad_dir > 0 and (not style.bg_clip_text) and (style.grad_from != 0 or style.grad_to != 0)
        has_bg := style.bg_color != 0
        bd_w := if is_foc { 1 } else { (if has_bd { style.border_width } else { 0 }) }
        eff_bd_col := if is_foc { (if style.focus_border != 0 { style.focus_border } else { 0xFF3B82F6 }) } else { style.border_color }
        per_side := (not is_foc) and style.border_sides != 0

        mut ix := bx
        mut iy := by
        mut iw := bw
        mut ih := bh
        mut irad := rad

        // Opaque/gradient box with uniform border: crisp outer-inner rrect (zero half-pixel seam!)
        if has_bd and not per_side and (has_grad or (has_bg and ((style.bg_color >> 24) & 0xFF) >= 235)) {
            bd_col := _p2d_apply_opacity(eff_bd_col, style.opacity)
            _p2d_fill_rrect(mut d2d, bx, by, bw, bh, rad, bd_col)
            ix = bx + bd_w
            iy = by + bd_w
            iw = bw - bd_w * 2
            ih = bh - bd_w * 2
            irad = rad - bd_w
            if irad < 0 { irad = 0 }
        }

        // Frosted Glassmorphism (`backdrop-blur-*`) atmospheric base veil
        if style.glass_blur > 0 {
            veil_a := 10 + style.glass_blur * 4
            _p2d_fill_rrect(mut d2d, ix, iy, iw, ih, irad, (veil_a << 24) | 0xFFFFFF)
        }

        if has_grad {
            cf := _p2d_apply_opacity(if style.grad_from != 0 { style.grad_from } else { style.bg_color }, style.opacity)
            ct := _p2d_apply_opacity(if style.grad_to != 0 { style.grad_to } else { cf }, style.opacity)
            cv := if style.grad_via != 0 { _p2d_apply_opacity(style.grad_via, style.opacity) } else { 0 }
            _p2d_fill_grad_rrect(mut d2d, ix, iy, iw, ih, irad, style.grad_dir, cf, ct, cv)
        } else if has_bg {
            bg_col := _p2d_apply_opacity(style.bg_color, style.opacity)
            _p2d_fill_rrect(mut d2d, ix, iy, iw, ih, irad, bg_col)
        }

        // Frosted Glassmorphism specular top-edge sheen (macOS / Tailwind glass card polish!)
        if style.glass_blur > 0 and iw > 8 and ih > 8 {
            _p2d_fill_rrect(mut d2d, ix + irad, iy, iw - irad * 2, 1, 0, 0x2AFFFFFF)
        }

        // Per-side borders OR crisp hardware anti-aliased rounded borders on glass/transparent boxes!
        if has_bd and (per_side or (not has_grad and (not has_bg or ((style.bg_color >> 24) & 0xFF) < 235))) {
            bd_col := _p2d_apply_opacity(eff_bd_col, style.opacity)
            if per_side {
                sides := style.border_sides
                if (sides & 1) != 0 { _p2d_fill_rrect(mut d2d, bx, by, bw, bd_w, 0, bd_col) }              // Top
                if (sides & 4) != 0 { _p2d_fill_rrect(mut d2d, bx, by + bh - bd_w, bw, bd_w, 0, bd_col) } // Bottom
                if (sides & 8) != 0 { _p2d_fill_rrect(mut d2d, bx, by, bd_w, bh, 0, bd_col) }              // Left
                if (sides & 2) != 0 { _p2d_fill_rrect(mut d2d, bx + bw - bd_w, by, bd_w, bh, 0, bd_col) } // Right
            } else {
                _p2d_stroke_rrect(mut d2d, bx, by, bw, bh, rad, bd_w, bd_col)
            }
        }

        // 3. Native `<img src="...">` Bitmap, `<svg data-icon="...">` Vector Icon, OR DirectWrite ClearType Typography
        if str_eq_ignore_case(tag, "img") {
            src_path := dom_get_text(app.tree, node_idx)
            if str_len(src_path) > 0 {
                _p2d_draw_img_rrect(mut d2d, src_path, ix, iy, iw, ih, irad, style.object_fit)
            }
        } else if str_eq_ignore_case(tag, "svg") or str_eq_ignore_case(tag, "icon") {
            iname := dom_get_text(app.tree, node_idx)
            if str_len(iname) > 0 {
                ic_col := _p2d_apply_opacity(style.text_color, style.opacity)
                _p2d_draw_svg_icon(mut d2d, iname, ix, iy, iw, ih, ic_col)
            }
        } else {
            mut raw_txt := dom_get_text(app.tree, node_idx)
            mut is_placeholder := false
            if str_len(raw_txt) == 0 and (str_eq_ignore_case(tag, "input") or str_eq_ignore_case(tag, "textarea")) {
                ph := dom_get_placeholder(app.tree, node_idx)
                if str_len(ph) > 0 and not is_foc {
                    raw_txt = ph
                    is_placeholder = true
                }
            }
            if not is_placeholder and str_len(raw_txt) > 0 {
                if style.text_transform == 1 { raw_txt = str_to_upper(raw_txt) }
                else if style.text_transform == 2 { raw_txt = str_to_lower(raw_txt) }
                else if style.text_transform == 3 { raw_txt = _p2d_capitalize(raw_txt) }
            }
            tlen := str_len(raw_txt)
            mut fz := style.font_size
            if fz <= 0 { fz = 14 }
            is_single := style.white_space == 1 or str_eq_ignore_case(tag, "button") or str_eq_ignore_case(tag, "input")
            pad_l := if style.padding_x > 0 { style_pad_left(style) } else { (if style.display == 2 { 2 } else { 0 }) }
            pad_r := if style.padding_x > 0 { style_pad_right(style) } else { (if style.display == 2 { 2 } else { 0 }) }
            pad_t := if is_single { 0 } else { style_pad_top(style) }
            pad_b := if is_single { 0 } else { style_pad_bottom(style) }
            tx := bx + pad_l
            ty := by + pad_t
            mut tw := bw - pad_l - pad_r
            mut th := bh - pad_t - pad_b
            if tw < 4 { tw = bw }
            if th < 4 { th = bh }

            if tlen > 0 and d2d.f_mb2w != 0 {
                mut fw := style.font_weight
                if fw <= 0 { fw = 400 }

                mut ha := 0
                if style.text_align == 1 { ha = 2 }
                else if style.text_align == 2 { ha = 1 }

                va := if is_single { 2 } else { 0 }
                wrap := if is_single { 1 } else { 0 }

                tf := _p2d_get_text_format(mut d2d, fz, fw, ha, va, wrap, style.font_mono, style.font_italic, style.text_ellipsis)
                if tf != 0 {
                    ctxt := ffi_cstr(raw_txt)
                    wlen := ffi_sext32(ffi_call6(d2d.f_mb2w, 65001, 0, ctxt, tlen, d2d.wbuf, d2d.wcap))
                    ffi_free(ctxt)
                    if wlen > 0 {
                        rc := d2d.scratch + 32
                        _p2d_write_rect(rc, tx, ty, tw, th)
                        // Support Tailwind `bg-clip-text text-transparent bg-gradient-to-* from-* to-*`!
                        if style.bg_clip_text and style.grad_dir > 0 and (style.grad_from != 0 or style.grad_to != 0) {
                            cf := _p2d_apply_opacity(if style.grad_from != 0 { style.grad_from } else { 0xFF60A5FA }, style.opacity)
                            ct := _p2d_apply_opacity(if style.grad_to != 0 { style.grad_to } else { cf }, style.opacity)
                            cv := if style.grad_via != 0 { _p2d_apply_opacity(style.grad_via, style.opacity) } else { 0 }
                            tgb := _p2d_create_grad_brush(d2d, tx, ty, tw, th, style.grad_dir, cf, ct, cv)
                            if tgb != 0 {
                                _ := ffi_call8(_p2d_vt(d2d.rt, 27), d2d.rt, d2d.wbuf, wlen, tf, rc, tgb, 6, 0)
                                _ := ffi_call1(_p2d_vt(tgb, 2), tgb)
                            }
                        } else {
                            base_tc := if is_placeholder { 0xFF64748B } else { style.text_color }
                            tc := _p2d_apply_opacity(base_tc, style.opacity)
                            _p2d_write_color_lut(d2d.color_lut, d2d.scratch, tc)
                            _ := ffi_call2(_p2d_vt(d2d.brush, 8), d2d.brush, d2d.scratch)
                            _ := ffi_call8(_p2d_vt(d2d.rt, 27), d2d.rt, d2d.wbuf, wlen, tf, rc, d2d.brush, 6, 0)

                            if style.text_decoration == 1 or style.text_decoration == 2 {
                                mut lw := layout_estimate_text_width(raw_txt, fz)
                                if lw > tw { lw = tw }
                                mut lx := tx
                                if style.text_align == 1 { lx = tx + (tw - lw) / 2 }
                                else if style.text_align == 2 { lx = tx + tw - lw }
                                ly := if style.text_decoration == 1 { ty + fz + 2 } else { ty + (fz * 55) / 100 }
                                _p2d_fill_rrect(mut d2d, lx, ly, lw, 1, 0, tc)
                            }
                        }
                    }
                }
            }
            // Crisp 2px vertical bar caret for focused <input>/<textarea> (never shifts centered text!)
            if is_foc {
                mut cx := tx + layout_estimate_text_width(raw_txt, fz) + 2
                if cx > bx + bw - 6 { cx = bx + bw - 6 }
                cy := if is_single { by + (bh - fz - 2) / 2 } else { ty + 2 }
                caret_col := if style.focus_border != 0 { style.focus_border } else { 0xFF60A5FA }
                _p2d_fill_rrect(mut d2d, cx, cy, 2, fz + 2, 1, caret_col)
            }
        }
    }

    // 4. Recursively paint children with hardware Direct2D clip (rounded PushLayer when rad > 0!) & per-container scroll offset
    fc := dom_first_child(app.tree, node_idx)
    if fc >= 0 {
        do_clip := (style.overflow_hidden or style.overflow_scroll) and bw > 0 and bh > 0
        mut used_rclip := false
        mut rclip_layer := 0
        mut rclip_geom := 0
        if do_clip {
            mut c_rad := style.border_radius
            if c_rad > bw / 2 { c_rad = bw / 2 }
            if c_rad > bh / 2 { c_rad = bh / 2 }
            if c_rad > 2 {
                rr_c := d2d.scratch + 32
                _p2d_write_rrect(rr_c, bx, by, bw, bh, c_rad)
                hr_g := ffi_call3(_p2d_vt(d2d.d2d_fac, 6), d2d.d2d_fac, rr_c, d2d.out_box) & 0xFFFFFFFF
                if hr_g == 0 {
                    rclip_geom = ffi_read_i64(d2d.out_box, 0)
                    hr_l := ffi_call3(_p2d_vt(d2d.rt, 13), d2d.rt, 0, d2d.out_box) & 0xFFFFFFFF // CreateLayer
                    if hr_l == 0 {
                        rclip_layer = ffi_read_i64(d2d.out_box, 0)
                        lp := d2d.scratch + 400 // D2D1_LAYER_PARAMETERS (72 bytes, fits inside 512B scratch!)
                        _p2d_write_rect(lp, bx, by, bw, bh)
                        ffi_write_i64(lp, 2, rclip_geom)       // offset 16: geometricMask
                        ffi_write_u32_le(lp, 24, 0)            // maskAntialiasMode = PER_PRIMITIVE
                        ffi_write_u32_le(lp, 28, 0x3F800000)   // maskTransform._11 = 1.0f
                        ffi_write_u32_le(lp, 32, 0)
                        ffi_write_u32_le(lp, 36, 0)
                        ffi_write_u32_le(lp, 40, 0x3F800000)   // maskTransform._22 = 1.0f
                        ffi_write_u32_le(lp, 44, 0)
                        ffi_write_u32_le(lp, 48, 0)
                        ffi_write_u32_le(lp, 52, 0x3F800000)   // opacity = 1.0f
                        ffi_write_i64(lp, 7, 0)                // offset 56: opacityBrush = NULL
                        ffi_write_u32_le(lp, 64, 1)            // D2D1_LAYER_OPTIONS_INITIALIZE_FOR_CLEARTYPE
                        _ := ffi_call3(_p2d_vt(d2d.rt, 40), d2d.rt, lp, rclip_layer) // PushLayer
                        used_rclip = true
                    }
                }
            }
            if not used_rclip {
                crc := d2d.scratch + 64
                _p2d_write_rect(crc, bx, by, bw, bh)
                _ := ffi_call3(_p2d_vt(d2d.rt, 45), d2d.rt, crc, 1) // PushAxisAlignedClip
            }
        }
        own_scroll := if style.overflow_scroll { ui_node_scroll_y(app, node_idx) } else { 0 }
        child_scroll := if style.position == 2 { own_scroll } else { acc_scroll_y + own_scroll }

        mut ch := fc
        while ch >= 0 {
            _p2d_paint_node(mut d2d, app, ch, hovered_node, active_node, child_scroll, dip_w, dip_h, style, true, depth + 1)
            ch = dom_next_sibling(app.tree, ch)
        }

        // Sleek 5px native translucent scrollbar thumb when scrollable content overflows container
        if style.overflow_scroll and vis {
            content_h := ui_node_content_height(app, node_idx)
            if content_h > bh and bh > 20 {
                mut thumb_h := (bh * bh) / content_h
                if thumb_h < 24 { thumb_h = 24 }
                max_s := content_h - bh
                thumb_y := by + ((bh - thumb_h) * own_scroll) / max_s
                sb_col := if is_hov { 0xBB94A3B8 } else { 0x6671717A }
                _p2d_fill_rrect(mut d2d, bx + bw - 7, thumb_y, 5, thumb_h, 2, sb_col)
            }
        }
        if do_clip {
            if used_rclip {
                _ := ffi_call1(_p2d_vt(d2d.rt, 41), d2d.rt) // PopLayer
            } else {
                _ := ffi_call1(_p2d_vt(d2d.rt, 46), d2d.rt) // PopAxisAlignedClip
            }
            if rclip_layer != 0 { _ := ffi_call1(_p2d_vt(rclip_layer, 2), rclip_layer) }
            if rclip_geom != 0 { _ := ffi_call1(_p2d_vt(rclip_geom, 2), rclip_geom) }
        }
    }
}

// Hardware Direct2D + DirectWrite Presenter for ALL `std::ui` HTML5/CSS3/Tailwind/JS apps!
fn photon_d2d_present(win: GuiWindow, mut app: UiApp, mut d2d: PhotonD2D, hovered_node: i64 = -1, active_node: i64 = -1) -> bool {
    if not win.is_open or not d2d.ok { return false }
    if not app.is_ready {
        parsed := html_parse(app.html_src) or dom_tree_new(app.html_src)
        dom_tree_free(move app.tree)
        app.tree = parsed
        _ui_relayout(mut app)
        app.is_ready = true
    }

    w := win.width
    h := win.height
    if w <= 0 or h <= 0 { return false }

    hdc := ffi_call1(d2d.f_gdc, win.hwnd)
    if hdc == 0 { return false }
    if not _p2d_ensure_bb(mut d2d, hdc, w, h) {
        _ := ffi_call2(d2d.f_rdc, win.hwnd, hdc)
        return false
    }

    _ := ffi_call1(_p2d_vt(d2d.rt, 48), d2d.rt) // BeginDraw
    d2d.aa_mode = -1
    _p2d_write_color_lut(d2d.color_lut, d2d.scratch, 0xFF09090B)
    _ := ffi_call2(_p2d_vt(d2d.rt, 47), d2d.rt, d2d.scratch)

    dip_w := (w * 96) / d2d.dpi
    dip_h := (h * 96) / d2d.dpi
    root_p := style_default()
    mut r := app.tree.root_idx
    while r >= 0 {
        _p2d_paint_node(mut d2d, app, r, hovered_node, active_node, app.scroll_y, dip_w, dip_h, root_p, false, 0)
        r = dom_next_sibling(app.tree, r)
    }

    _ := ffi_call3(_p2d_vt(d2d.rt, 49), d2d.rt, 0, 0) // EndDraw

    // Zero-alloc persistent BitBlt arguments buffer!
    ibuf_set(d2d.blt_args, 0, hdc); ibuf_set(d2d.blt_args, 1, 0); ibuf_set(d2d.blt_args, 2, 0)
    ibuf_set(d2d.blt_args, 3, w); ibuf_set(d2d.blt_args, 4, h)
    ibuf_set(d2d.blt_args, 5, d2d.mem_dc); ibuf_set(d2d.blt_args, 6, 0); ibuf_set(d2d.blt_args, 7, 0)
    ibuf_set(d2d.blt_args, 8, 0x00CC0020)
    _ := ffi_call_arr(d2d.f_bkit, 9, d2d.blt_args)

    _ := ffi_call2(d2d.f_rdc, win.hwnd, hdc)
    return true
}

fn _gui_color_to_colorref(argb: i64) -> i64 {
    r := (argb >> 16) & 0xFF
    g := (argb >> 8) & 0xFF
    b := argb & 0xFF
    return r | (g << 8) | (b << 16)
}

// Axon PhotonUI Native Engine: Automatically selects Hardware Direct2D + DirectWrite on Windows
// (razor-sharp HTML5/CSS3/Tailwind/JS, 0 blur) with GDI/SDL2 fallback.
fn gui_present_photon_ui(win: GuiWindow, mut app: UiApp) -> bool {
    if win.backend == 1 {
        mut d2d := photon_d2d_init(win)
        if d2d.ok {
            ok_p := photon_d2d_present(win, mut app, mut d2d, -1)
            photon_d2d_free(move d2d)
            return ok_p
        }
        photon_d2d_free(move d2d)
    }
    mut fonts := gui_font_cache_new()
    ok_present := gui_present_photon_ui_cached(win, mut app, mut fonts)
    gui_font_cache_free(move fonts, win.gdi32)
    return ok_present
}

fn gui_present_photon_ui_cached(win: GuiWindow, mut app: UiApp, mut fonts: GuiFontCache) -> bool {
    if not win.is_open { return false }
    if not app.is_ready {
        parsed := html_parse(app.html_src) or dom_tree_new(app.html_src)
        app.tree = parsed
        app.layout = layout_compute(app.tree, app.sheet, app.width, app.height)
        app.is_ready = true
    }

    w := app.canvas.width
    h := app.canvas.height
    if w <= 0 or h <= 0 or buf_len(app.canvas.pixels) < w * h * 4 { return false }

    if win.backend != 1 {
        canv := ui_render(mut app)
        return gui_present_canvas(win, canv)
    }

    // 1. Hardware ERMS paint all rounded cards, surfaces & borders in ~0.1 ms
    canvas_clear(app.canvas, 0xFF0F172A)
    canvas_paint_dom_boxes(app.canvas, app.tree, app.sheet, app.layout)

    // 2. Double-buffer onto GDI backbuffer + draw crisp ClearType Segoe UI typography
    f_gdc   := ffi_sym(win.user32, "GetDC")
    f_rdc   := ffi_sym(win.user32, "ReleaseDC")
    f_dtxtw := ffi_sym(win.user32, "DrawTextW")
    k32     := ffi_open_one("kernel32.dll")
    f_mb2w  := if k32 != 0 { ffi_sym(k32, "MultiByteToWideChar") } else { 0 }
    f_cdc   := ffi_sym(win.gdi32, "CreateCompatibleDC")
    f_cbm   := ffi_sym(win.gdi32, "CreateCompatibleBitmap")
    f_sel   := ffi_sym(win.gdi32, "SelectObject")
    f_delo  := ffi_sym(win.gdi32, "DeleteObject")
    f_deldc := ffi_sym(win.gdi32, "DeleteDC")
    f_sdib  := ffi_sym(win.gdi32, "StretchDIBits")
    f_bkit  := ffi_sym(win.gdi32, "BitBlt")
    f_bk    := ffi_sym(win.gdi32, "SetBkMode")
    f_tcol  := ffi_sym(win.gdi32, "SetTextColor")

    hdc := ffi_call1(f_gdc, win.hwnd)
    if hdc == 0 { return false }
    mem_dc := ffi_call1(f_cdc, hdc)
    hbm := ffi_call3(f_cbm, hdc, w, h)
    old_bm := ffi_call2(f_sel, mem_dc, hbm)

    px_ptr := unsafe { (app.canvas.pixels as i64) + 16 }
    bmi := ffi_alloc(64)
    ffi_write_u32_le(bmi, 0, 40)
    ffi_write_u32_le(bmi, 4, w)
    ffi_write_u32_le(bmi, 8, (0 - h) & 0xFFFFFFFF)
    ffi_write_u16_le(bmi, 12, 1)
    ffi_write_u16_le(bmi, 14, 32)
    ffi_write_u32_le(bmi, 16, 0)

    args := ibuf_new(16)
    ibuf_push(args, mem_dc)
    ibuf_push(args, 0); ibuf_push(args, 0); ibuf_push(args, w); ibuf_push(args, h)
    ibuf_push(args, 0); ibuf_push(args, 0); ibuf_push(args, w); ibuf_push(args, h)
    ibuf_push(args, px_ptr)
    ibuf_push(args, bmi)
    ibuf_push(args, 0)
    ibuf_push(args, 0x00CC0020)
    _ := ffi_call_arr(f_sdib, 13, args)
    buf_free(move args)
    ffi_free(bmi)

    // GDI negative logical height already tracks the window DPI, so CSS px stays
    // comparable to a browser's CSS px without double scaling.
    face := "Segoe UI"
    hfont_reg := gui_font_cache_get(mut fonts, win.gdi32, face, 14, 400)

    _ := ffi_call2(f_bk, mem_dc, 1) // TRANSPARENT
    old_font := ffi_call2(f_sel, mem_dc, hfont_reg)
    rc_box := ffi_alloc(32)

    mut i := 0
    while i < app.tree.count {
        bx := layout_get_x(app.layout, i)
        by := layout_get_y(app.layout, i)
        bw := layout_get_w(app.layout, i)
        bh := layout_get_h(app.layout, i)
        if bw > 0 and bh > 0 {
            txt := dom_get_text(app.tree, i)
            tlen := str_len(txt)
            if tlen > 0 {
                style := css_compute_node_style(app.tree, i, app.sheet)

                // CSS font-size wins; otherwise derive from semantic tag.
                mut logical := style.font_size
                if logical <= 0 { logical = 14 }
                mut weight := style.font_weight
                if weight <= 0 { weight = 400 }
                mut fh := gui_font_cache_get(mut fonts, win.gdi32, face, logical, weight)
                if fh == 0 { fh = hfont_reg }
                _ := ffi_call2(f_sel, mem_dc, fh)

                _ := ffi_call2(f_tcol, mem_dc, _gui_color_to_colorref(style.text_color))

                pad_x := if style.display == 2 { 2 } else { style.padding_x / 2 + 4 }
                pad_y := if style.display == 2 { 0 } else { style.padding_y / 2 + 2 }
                ffi_write_u32_le(rc_box, 0, bx + pad_x)
                ffi_write_u32_le(rc_box, 4, by + pad_y)
                ffi_write_u32_le(rc_box, 8, bx + bw - pad_x)
                ffi_write_u32_le(rc_box, 12, by + bh - pad_y)

                // DT_NOPREFIX (0x800) + word-break for body text; alignment from CSS
                mut dflags := 0x0810 // DT_WORDBREAK | DT_NOPREFIX
                if style.text_align == 1 { dflags = dflags | 0x0001 }        // DT_CENTER
                else if style.text_align == 2 { dflags = dflags | 0x0002 }   // DT_RIGHT
                if weight >= 600 or style.font_size > 18 or style.text_align == 1 {
                    ffi_write_u32_le(rc_box, 4, by)
                    ffi_write_u32_le(rc_box, 12, by + bh)
                    dflags = dflags | 0x0004 | 0x0020 // DT_VCENTER | DT_SINGLELINE
                }

                ctxt := ffi_cstr(txt)
                if f_dtxtw != 0 and f_mb2w != 0 {
                    wcap := tlen + 4
                    wbuf := ffi_alloc(wcap * 2 + 8)
                    wlen := ffi_sext32(ffi_call6(f_mb2w, 65001, 0, ctxt, tlen, wbuf, wcap))
                    if wlen > 0 {
                        _ := ffi_call5(f_dtxtw, mem_dc, wbuf, wlen, rc_box, dflags)
                    }
                    ffi_free(wbuf)
                }
                ffi_free(ctxt)
            }
        }
        i += 1
    }

    // 3. Atomic double-buffer BitBlt to screen (zero flicker!)
    bargs := ibuf_new(12)
    ibuf_push(bargs, hdc); ibuf_push(bargs, 0); ibuf_push(bargs, 0)
    ibuf_push(bargs, win.width); ibuf_push(bargs, win.height)
    ibuf_push(bargs, mem_dc); ibuf_push(bargs, 0); ibuf_push(bargs, 0)
    ibuf_push(bargs, 0x00CC0020)
    _ := ffi_call_arr(f_bkit, 9, bargs)
    buf_free(move bargs)

    ffi_free(rc_box)
    _ := ffi_call2(f_sel, mem_dc, old_font)
    _ := ffi_call2(f_sel, mem_dc, old_bm)
    _ := ffi_call1(f_delo, hbm)
    _ := ffi_call1(f_deldc, mem_dc)
    _ := ffi_call2(f_rdc, win.hwnd, hdc)
    return true
}

// Helper: checks if node or any ancestor has `:hover` styles or scrollable scrollbar highlight
fn _gui_chain_has_hover(app: UiApp, node_idx: i64) -> bool {
    mut cur := node_idx
    mut hops := 0
    while cur >= 0 and hops < 16 {
        st := css_compute_node_style(app.tree, cur, app.sheet)
        if st.has_hover or st.overflow_scroll { return true }
        cur = dom_parent(app.tree, cur)
        hops += 1
    }
    return false
}

// 1-line production desktop app runner for `std::ui` (`UiApp`)
// Pure Axon Photon-D2D Engine: Hardware Direct2D + DirectWrite, 0.00% idle CPU, live resize, `:hover`/`:active`/`:focus`, native cursors & IME/Clipboard!
fn gui_run_ui_app(mut app: UiApp, max_frames: i64 = 0, visible: bool = true) -> i64 {
    mut win := gui_open(app.title, app.width, app.height, visible) or return -1
    mut d2d := photon_d2d_init(win)
    mut frames := 0
    mut prev_hover := -1
    mut prev_hover_reactive := false
    mut prev_mx := -999999
    mut prev_my := -999999
    mut hovered := -1
    mut active_node := -1
    mut dirty := true
    mut trimmed := false
    app.sheet.viewport_w = app.width

    while gui_poll_events(mut win) {
        if win.needs_redraw { dirty = true }

        // Handle live Per-Monitor DPI changes cleanly when dragging between screens
        if win.dpi_changed and d2d.ok {
            new_dpi := gui_get_dpi(win)
            if new_dpi != d2d.dpi {
                photon_d2d_free(move d2d)
                d2d = photon_d2d_init(win)
                dirty = true
            }
        }

        dpi := if d2d.ok and d2d.dpi > 0 { d2d.dpi } else { 96 }
        dip_w := (win.width * 96) / dpi
        dip_h := (win.height * 96) / dpi
        mx := (win.mouse_x * 96) / dpi
        my := (win.mouse_y * 96) / dpi

        mut layout_changed := false
        // Live responsive Flexbox/Grid reflow on window resize in CSS DIPs (zero LayoutTree leak!)
        if dip_w > 100 and dip_h > 100 and (dip_w != app.width or dip_h != app.height) {
            app.width = dip_w
            app.height = dip_h
            app.sheet.viewport_w = app.width
            if app.is_ready {
                _ui_relayout(mut app)
            }
            dirty = true
            layout_changed = true
        }

        // Smooth per-container (or viewport) mouse-wheel scrolling
        if win.scroll_delta != 0 {
            if ui_scroll_at(mut app, mx, my, 0 - (win.scroll_delta / 3)) {
                dirty = true
                layout_changed = true
            }
        }

        // Clipboard shortcuts (Ctrl+V paste / Ctrl+C copy) in focused <input>/<textarea>
        if win.ctrl_v and app.focused_idx >= 0 {
            clip := gui_clipboard_get()
            if str_len(clip) > 0 and ui_handle_paste(mut app, clip) { dirty = true }
        }
        if win.ctrl_c and app.focused_idx >= 0 {
            cur_val := dom_get_text(app.tree, app.focused_idx)
            if str_len(cur_val) > 0 { _ := gui_clipboard_set(cur_val) }
        }

        // Drain full UTF-16/IME character queue (zero dropped keystrokes on fast typing!)
        if win.char_count > 0 {
            mut ci := 0
            while ci < win.char_count {
                if ui_handle_char(mut app, ibuf_get(win.char_queue, ci)) { dirty = true }
                ci += 1
            }
        } else if win.last_char != 0 {
            if ui_handle_char(mut app, win.last_char) { dirty = true }
        }

        // Only run hit-test when mouse actually moved, clicked, scrolled, or layout changed!
        if app.is_ready and (mx != prev_mx or my != prev_my or win.clicked_down or layout_changed) {
            prev_mx = mx
            prev_my = my
            hovered = ui_hit_test(app, mx, my)
            if hovered != prev_hover {
                new_hover_reactive := if hovered >= 0 { _gui_chain_has_hover(app, hovered) } else { false }
                if prev_hover_reactive or new_hover_reactive {
                    dirty = true
                }
                prev_hover = hovered
                prev_hover_reactive = new_hover_reactive
                mut cur_kind := 0
                if hovered >= 0 {
                    htag := dom_get_tag(app.tree, hovered)
                    hst := css_compute_node_style(app.tree, hovered, app.sheet)
                    if hst.cursor != 0 {
                        cur_kind = hst.cursor
                    } else if str_eq_ignore_case(htag, "input") or str_eq_ignore_case(htag, "textarea") {
                        cur_kind = 2
                    } else if str_eq_ignore_case(htag, "button") or str_eq_ignore_case(htag, "a") or str_len(dom_get_onclick(app.tree, hovered)) > 0 {
                        cur_kind = 1
                    }
                }
                gui_set_cursor(mut win, cur_kind)
            }
        }

        if win.clicked_down {
            active_node = hovered
            _ := ui_dispatch_click_node(mut app, hovered)
            dirty = true
        }
        if win.clicked_up and active_node >= 0 {
            active_node = -1
            dirty = true
        }

        // On Photon-D2D, check dirty signals WITHOUT allocating/painting unused 4 MB CPU Canvas!
        if not dirty {
            if d2d.ok {
                if signal_consume_dirty(mut app.signals) > 0 { dirty = true }
            } else if ui_patch_signals(mut app) > 0 {
                dirty = true
            }
        }

        if dirty {
            if d2d.ok {
                _ := photon_d2d_present(win, mut app, mut d2d, hovered, active_node)
            } else {
                _ui_ensure_canvas(mut app)
                _ := gui_present_photon_ui(win, mut app)
            }
            dirty = false
        }

        frames += 1
        if max_frames > 0 and frames >= max_frames { break }
        if win.key_escape { break }
        if max_frames == 0 {
            // Trim OS working set ONCE after initial render settles to keep RSS ultra-low without page-fault churn
            if not trimmed and frames >= 2 and d2d.k32 != 0 {
                f_cur := ffi_sym(d2d.k32, "GetCurrentProcess")
                f_ws  := ffi_sym(d2d.k32, "SetProcessWorkingSetSize")
                if f_cur != 0 and f_ws != 0 { _ := ffi_call3(f_ws, ffi_call0(f_cur), -1, -1) }
                trimmed = true
            }
            gui_wait_event(win, 5000)
        } else {
            sleep_ms(4)
        }
    }
    photon_d2d_free(move d2d)
    gui_close(mut win)
    return frames
}

// Native OS Unicode MessageBox (`flags`: 0 = OK, 1 = OK/Cancel, 4 = Yes/No)
fn gui_msgbox(title: str, text: str, flags: i64 = 0) -> i64 {
    u32 := ffi_open_one("user32.dll")
    k32 := ffi_open_one("kernel32.dll")
    if u32 == 0 { return 0 }
    fw := ffi_sym(u32, "MessageBoxW")
    if fw != 0 {
        wt := _gui_utf8_to_utf16(k32, title)
        wm := _gui_utf8_to_utf16(k32, text)
        r := ffi_sext32(ffi_call4(fw, 0, wm, wt, flags))
        ffi_free(wt); ffi_free(wm)
        return r
    }
    f := ffi_sym(u32, "MessageBoxA")
    ct := ffi_cstr(title); cm := ffi_cstr(text)
    r := ffi_sext32(ffi_call4(f, 0, cm, ct, flags))
    ffi_free(ct); ffi_free(cm)
    return r
}

// Native OS Unicode UTF-8 <-> UTF-16 Clipboard (Win32 `CF_UNICODETEXT = 13`)
fn gui_clipboard_set(text: str) -> bool {
    u32 := ffi_open_one("user32.dll")
    k32 := ffi_open_one("kernel32.dll")
    if u32 == 0 or k32 == 0 { return false }
    f_open := ffi_sym(u32, "OpenClipboard")
    f_emp  := ffi_sym(u32, "EmptyClipboard")
    f_set  := ffi_sym(u32, "SetClipboardData")
    f_cls  := ffi_sym(u32, "CloseClipboard")
    f_ga   := ffi_sym(k32, "GlobalAlloc")
    f_gf   := ffi_sym(k32, "GlobalFree")
    f_gl   := ffi_sym(k32, "GlobalLock")
    f_gu   := ffi_sym(k32, "GlobalUnlock")
    f_mb   := ffi_sym(k32, "MultiByteToWideChar")
    if (ffi_call1(f_open, 0) & 0xFFFFFFFF) == 0 { return false }
    _ := ffi_call0(f_emp)
    n := str_len(text)
    mut ok_set := false
    if f_mb != 0 and n > 0 {
        cs := ffi_cstr(text)
        wcap := n + 4
        hmem := ffi_call2(f_ga, 0x0042, wcap * 2) // GMEM_MOVEABLE | GMEM_ZEROINIT
        if hmem != 0 {
            p := ffi_call1(f_gl, hmem)
            if p != 0 {
                _ := ffi_call6(f_mb, 65001, 0, cs, n, p, wcap - 1)
                _ := ffi_call1(f_gu, hmem)
                ok_set = ffi_call2(f_set, 13, hmem) != 0 // CF_UNICODETEXT
            }
            if not ok_set and f_gf != 0 { _ := ffi_call1(f_gf, hmem) }
        }
        ffi_free(cs)
        _ := ffi_call0(f_cls)
        return ok_set
    }
    hmem := ffi_call2(f_ga, 0x0002, n + 1)
    if hmem != 0 {
        p := ffi_call1(f_gl, hmem)
        if p != 0 {
            mut i := 0
            while i < n { ffi_write_u8(p, i, str_byte(text, i)); i += 1 }
            ffi_write_u8(p, n, 0)
            _ := ffi_call1(f_gu, hmem)
            ok_set = ffi_call2(f_set, 1, hmem) != 0
        }
        if not ok_set and f_gf != 0 { _ := ffi_call1(f_gf, hmem) }
    }
    _ := ffi_call0(f_cls)
    return ok_set
}

fn gui_clipboard_get() -> str {
    u32 := ffi_open_one("user32.dll")
    k32 := ffi_open_one("kernel32.dll")
    if u32 == 0 or k32 == 0 { return "" }
    f_open := ffi_sym(u32, "OpenClipboard")
    f_get  := ffi_sym(u32, "GetClipboardData")
    f_cls  := ffi_sym(u32, "CloseClipboard")
    f_gl   := ffi_sym(k32, "GlobalLock")
    f_gu   := ffi_sym(k32, "GlobalUnlock")
    f_wc   := ffi_sym(k32, "WideCharToMultiByte")
    if (ffi_call1(f_open, 0) & 0xFFFFFFFF) == 0 { return "" }
    mut out := ""
    hmem_u := ffi_call1(f_get, 13) // CF_UNICODETEXT
    if hmem_u != 0 and f_wc != 0 {
        pw := ffi_call1(f_gl, hmem_u)
        if pw != 0 {
            utf8_buf := ffi_alloc(65536)
            args := ibuf_new(8)
            ibuf_push(args, 65001); ibuf_push(args, 0); ibuf_push(args, pw); ibuf_push(args, -1)
            ibuf_push(args, utf8_buf); ibuf_push(args, 65535); ibuf_push(args, 0); ibuf_push(args, 0)
            _ := ffi_call_arr(f_wc, 8, args)
            buf_free(move args)
            out = ffi_read_cstr(utf8_buf, 65535)
            ffi_free(utf8_buf)
            _ := ffi_call1(f_gu, hmem_u)
        }
    } else {
        hmem := ffi_call1(f_get, 1) // CF_TEXT fallback
        if hmem != 0 {
            p := ffi_call1(f_gl, hmem)
            if p != 0 {
                out = ffi_read_cstr(p, 65536)
                _ := ffi_call1(f_gu, hmem)
            }
        }
    }
    _ := ffi_call0(f_cls)
    return out
}

// Native OS Open File Dialog (`comdlg32.dll` `GetOpenFileNameA`)
fn gui_file_open_dialog(title: str = "Open File") -> str {
    cd := ffi_open_one("comdlg32.dll")
    if cd == 0 { return "" }
    f_ofn := ffi_sym(cd, "GetOpenFileNameA")
    if f_ofn == 0 { return "" }
    ofn := ffi_alloc(160)   // sizeof(OPENFILENAMEA) = 152 on x64
    fbuf := ffi_alloc(1024)
    ct := ffi_cstr(title)
    ffi_write_u32_le(ofn, 0, 152)  // lStructSize
    ffi_write_i64(ofn, 6, fbuf)    // lpstrFile = offset 48 on Win64
    ffi_write_u32_le(ofn, 56, 1023) // nMaxFile = offset 56
    ffi_write_i64(ofn, 11, ct)     // lpstrTitle = offset 88
    ffi_write_u32_le(ofn, 96, 0x00081800) // Flags = offset 96 (OFN_EXPLORER | FILEMUSTEXIST | PATHMUSTEXIST)
    ok_d := (ffi_call1(f_ofn, ofn) & 0xFFFFFFFF) != 0
    mut path := ""
    if ok_d { path = ffi_read_cstr(fbuf, 1024) }
    ffi_free(ct); ffi_free(fbuf); ffi_free(ofn)
    return path
}
