// Axon Production Cross-Platform Native GUI & Desktop Backend (`std/gui.ax`)
// Connects Axon's zero-dependency `std::ui` (HTML5/CSS/Tailwind/Flexbox/Signals/Canvas)
// directly to real OS native windows, high-FPS pixel blitting, mouse/keyboard input,
// clipboard, message boxes, and native file dialogs:
//   - Windows: Win32 `user32.dll` + `gdi32.dll` (`CreateWindowExA`, `StretchDIBits`, `PeekMessageA`, Clipboard, `comdlg32.dll`)
//   - Linux:   `libSDL2-2.0.so.0` / `libX11.so.6` dynamic FFI
//   - macOS:   `libSDL2.dylib` dynamic FFI

use std::ffi
use std::ui
use std::ui_render

struct GuiWindow {
    backend: i64 // 1 = Win32, 2 = SDL2 (Linux/macOS), 3 = X11
    hwnd: i64
    aux1: i64    // SDL_Renderer / X11 Display
    aux2: i64    // SDL_Texture / X11 GC
    width: i64
    height: i64
    mouse_x: i64
    mouse_y: i64
    mouse_down: bool
    key_escape: bool
    is_open: bool
    user32: i64
    gdi32: i64
    sdl2: i64
    last_char: i64
    scroll_delta: i64
    needs_redraw: bool
}

fn _gui_utf8_to_utf16(k32: i64, s: str) -> i64 {
    n := str_len(s)
    f_mb := if k32 != 0 { ffi_sym(k32, "MultiByteToWideChar") } else { 0 }
    if f_mb == 0 or n == 0 { return ffi_wstr(s) }
    cs := ffi_cstr(s)
    wcap := n + 4
    wbuf := ffi_alloc(wcap * 2 + 8)
    _ := ffi_call6(f_mb, 65001, 0, cs, n, wbuf, wcap)
    ffi_free(cs)
    return wbuf
}

fn _gui_win32_open(title: str, w: i64, h: i64, visible: bool) -> GuiWindow ! i64 {
    u32 := ffi_open_one("user32.dll")
    g32 := ffi_open_one("gdi32.dll")
    k32 := ffi_open_one("kernel32.dll")
    if u32 == 0 or g32 == 0 { return err(-600) }

    // Enable Per-Monitor DPI Awareness v2 (-4) + Shcore Per-Monitor fallback so Windows never blurry-upscales the GUI!
    if visible {
        mut dpi_ok := false
        f_dpic := ffi_sym(u32, "SetProcessDpiAwarenessContext")
        if f_dpic != 0 {
            dpi_ok = (ffi_call1(f_dpic, -4) & 0xFFFFFFFF) != 0
        }
        if not dpi_ok {
            shc := ffi_open_one("shcore.dll")
            if shc != 0 {
                f_sda := ffi_sym(shc, "SetProcessDpiAwareness")
                if f_sda != 0 {
                    dpi_ok = (ffi_call1(f_sda, 2) & 0xFFFFFFFF) == 0
                }
            }
        }
        if not dpi_ok {
            f_dpi := ffi_sym(u32, "SetProcessDPIAware")
            if f_dpi != 0 { _ := ffi_call0(f_dpi) }
        }
    }

    f_mod   := ffi_sym(k32, "GetModuleHandleW")
    f_reg   := ffi_sym(u32, "RegisterClassExW")
    f_def   := ffi_sym(u32, "DefWindowProcW")
    f_cw    := ffi_sym(u32, "CreateWindowExW")
    f_show  := ffi_sym(u32, "ShowWindow")
    f_upd   := ffi_sym(u32, "UpdateWindow")
    f_cur   := ffi_sym(u32, "LoadCursorW")
    f_brush := ffi_sym(g32, "CreateSolidBrush")
    if f_cw == 0 or f_def == 0 { return err(-601) }

    hinst := ffi_call1(f_mod, 0)
    hcur  := if f_cur != 0 { ffi_call2(f_cur, 0, 32512) } else { 0 } // IDC_ARROW
    hbr   := if f_brush != 0 { ffi_call1(f_brush, 0x000B0909) } else { 0 } // Obsidian dark #09090B
    wcname := ffi_wstr("AxonPhotonGuiClass")
    wtitle := _gui_utf8_to_utf16(k32, title)

    // Register WNDCLASSEXW (80 bytes on Win64) with Unicode DefWindowProcW so IME/Vietnamese WM_CHAR works!
    wc := ffi_alloc(96)
    ffi_write_u32_le(wc, 0, 80)        // cbSize = 80
    ffi_write_u32_le(wc, 4, 0x0023)    // CS_HREDRAW | CS_VREDRAW | CS_OWNDC
    ffi_write_i64(wc, 1, f_def)        // lpfnWndProc at offset 8
    ffi_write_i64(wc, 3, hinst)        // hInstance at offset 24
    ffi_write_i64(wc, 5, hcur)         // hCursor at offset 40
    ffi_write_i64(wc, 6, hbr)          // hbrBackground at offset 48 (zero white flash!)
    ffi_write_i64(wc, 8, wcname)       // lpszClassName at offset 64
    _ := ffi_call1(f_reg, wc)
    ffi_free(wc)

    // CreateWindowExW(...)
    mut style := 0x00CF0000 // WS_OVERLAPPEDWINDOW
    if visible { style = style | 0x10000000 } // WS_VISIBLE
    args := ibuf_new(16)
    ibuf_push(args, 0)
    ibuf_push(args, wcname)
    ibuf_push(args, wtitle)
    ibuf_push(args, style)
    ibuf_push(args, 0x80000000) // CW_USEDEFAULT
    ibuf_push(args, 0x80000000)
    ibuf_push(args, w)
    ibuf_push(args, h)
    ibuf_push(args, 0)
    ibuf_push(args, 0)
    ibuf_push(args, hinst)
    ibuf_push(args, 0)
    hwnd := ffi_call_arr(f_cw, 12, args)
    buf_free(move args)
    ffi_free(wcname)
    ffi_free(wtitle)
    if hwnd == 0 { return err(-602) }

    if visible {
        // Enable native Windows 10/11 Dark Title Bar (DWMWA_USE_IMMERSIVE_DARK_MODE = 20 and legacy 19)
        dwm := ffi_open_one("dwmapi.dll")
        if dwm != 0 {
            f_dwm := ffi_sym(dwm, "DwmSetWindowAttribute")
            if f_dwm != 0 {
                dark_box := ffi_alloc(16)
                ffi_write_u32_le(dark_box, 0, 1)
                _ := ffi_call4(f_dwm, hwnd, 20, dark_box, 4)
                _ := ffi_call4(f_dwm, hwnd, 19, dark_box, 4)
                ffi_write_u32_le(dark_box, 4, 0x00110E0E) // DWMWA_CAPTION_COLOR = #0E0E11
                _ := ffi_call4(f_dwm, hwnd, 35, dark_box + 4, 4)
                ffi_write_u32_le(dark_box, 8, 0x001F1B1B) // DWMWA_BORDER_COLOR = #1B1B1F
                _ := ffi_call4(f_dwm, hwnd, 34, dark_box + 8, 4)
                ffi_free(dark_box)
            }
        }
        _ := ffi_call2(f_show, hwnd, 5) // SW_SHOW
        _ := ffi_call1(f_upd, hwnd)
    }
    return ok(GuiWindow(
        backend = 1, hwnd = hwnd, aux1 = 0, aux2 = 0,
        width = w, height = h, mouse_x = 0, mouse_y = 0,
        mouse_down = false, key_escape = false, is_open = true,
        user32 = u32, gdi32 = g32, sdl2 = 0,
        last_char = 0, scroll_delta = 0, needs_redraw = true
    ))
}

fn _gui_sdl2_open(title: str, w: i64, h: i64, visible: bool) -> GuiWindow ! i64 {
    sdl := ffi_open("SDL2.dll", "libSDL2-2.0.so.0", "libSDL2.dylib")
    if sdl == 0 { return err(-610) }
    f_init := ffi_sym(sdl, "SDL_Init")
    f_cw   := ffi_sym(sdl, "SDL_CreateWindow")
    f_cr   := ffi_sym(sdl, "SDL_CreateRenderer")
    f_ct   := ffi_sym(sdl, "SDL_CreateTexture")
    if f_cw == 0 { return err(-611) }
    _ := ffi_call1(f_init, 0x20) // SDL_INIT_VIDEO
    ct := ffi_cstr(title)
    mut fl := 4 // SDL_WINDOW_SHOWN
    if not visible { fl = 8 } // SDL_WINDOW_HIDDEN
    win := ffi_call6(f_cw, ct, 0x1FFF0000, 0x1FFF0000, w, h, fl)
    ffi_free(ct)
    if win == 0 { return err(-612) }
    ren := ffi_call3(f_cr, win, -1, 2) // SDL_RENDERER_ACCELERATED
    // SDL_PIXELFORMAT_ARGB8888 = 0x16362004, SDL_TEXTUREACCESS_STREAMING = 1
    tex := ffi_call5(f_ct, ren, 0x16362004, 1, w, h)
    return ok(GuiWindow(
        backend = 2, hwnd = win, aux1 = ren, aux2 = tex,
        width = w, height = h, mouse_x = 0, mouse_y = 0,
        mouse_down = false, key_escape = false, is_open = true,
        user32 = 0, gdi32 = 0, sdl2 = sdl,
        last_char = 0, scroll_delta = 0, needs_redraw = true
    ))
}

// Open a native OS window (auto-selects Win32 on Windows, SDL2 on Linux/macOS)
fn gui_open(title: str, w: i64, h: i64, visible: bool = true) -> GuiWindow ! i64 {
    if ffi_open_one("user32.dll") != 0 {
        return _gui_win32_open(title, w, h, visible)
    }
    return _gui_sdl2_open(title, w, h, visible)
}

fn gui_get_dpi(win: GuiWindow) -> i64 {
    if win.backend == 1 and win.user32 != 0 and win.hwnd != 0 {
        f := ffi_sym(win.user32, "GetDpiForWindow")
        if f != 0 {
            d := ffi_call1(f, win.hwnd) & 0xFFFFFFFF
            if d >= 72 and d <= 480 { return d }
        }
    }
    return 96
}

fn gui_set_title(win: GuiWindow, title: str) {
    if not win.is_open { return }
    if win.backend == 1 {
        k32 := ffi_open_one("kernel32.dll")
        wt := _gui_utf8_to_utf16(k32, title)
        f := ffi_sym(win.user32, "SetWindowTextW")
        _ := ffi_call2(f, win.hwnd, wt)
        ffi_free(wt)
    } else if win.backend == 2 {
        ct := ffi_cstr(title)
        f := ffi_sym(win.sdl2, "SDL_SetWindowTitle")
        _ := ffi_call2(f, win.hwnd, ct)
        ffi_free(ct)
    }
}

// Event-driven OS kernel sleep (0.00% idle CPU): wakes immediately on mouse, keyboard, paint, or resize
fn gui_wait_event(win: GuiWindow, timeout_ms: i64 = 250) {
    if not win.is_open { return }
    if win.backend == 1 and win.user32 != 0 {
        f_mw := ffi_sym(win.user32, "MsgWaitForMultipleObjects")
        if f_mw != 0 {
            _ := ffi_call5(f_mw, 0, 0, 0, timeout_ms, 0x04FF) // QS_ALLINPUT
            return
        }
    }
    sleep_ms(16)
}

// Set native Win32 window & taskbar icon from 32-bit BGRA pixel buffer (zero external .ico file)
fn gui_set_icon_bgra(win: GuiWindow, w: i64, h: i64, pixels: ByteBuf) {
    if not win.is_open or win.backend != 1 or w <= 0 or h <= 0 { return }
    if buf_len(pixels) < w * h * 4 { return }
    f_cbm  := ffi_sym(win.gdi32, "CreateBitmap")
    f_delo := ffi_sym(win.gdi32, "DeleteObject")
    f_ci   := ffi_sym(win.user32, "CreateIconIndirect")
    f_sm   := ffi_sym(win.user32, "SendMessageW")
    if f_cbm == 0 or f_ci == 0 or f_sm == 0 { return }

    px_ptr := unsafe { (pixels as i64) + 16 }
    hbm_col := ffi_call5(f_cbm, w, h, 1, 32, px_ptr)
    mask_buf := ffi_alloc((w * h) / 8 + 32)
    hbm_msk := ffi_call5(f_cbm, w, h, 1, 1, mask_buf)
    ffi_free(mask_buf)
    if hbm_col != 0 and hbm_msk != 0 {
        ii := ffi_alloc(32)
        ffi_write_u32_le(ii, 0, 1) // fIcon = TRUE
        ffi_write_i64(ii, 2, hbm_msk) // offset 16: hbmMask
        ffi_write_i64(ii, 3, hbm_col) // offset 24: hbmColor
        hico := ffi_call1(f_ci, ii)
        ffi_free(ii)
        if hico != 0 {
            _ := ffi_call4(f_sm, win.hwnd, 0x0080, 0, hico) // ICON_SMALL
            _ := ffi_call4(f_sm, win.hwnd, 0x0080, 1, hico) // ICON_BIG
        }
    }
    if hbm_col != 0 { _ := ffi_call1(f_delo, hbm_col) }
    if hbm_msk != 0 { _ := ffi_call1(f_delo, hbm_msk) }
}

fn gui_poll_events(mut win: GuiWindow) -> bool {
    win.last_char = 0
    win.scroll_delta = 0
    win.needs_redraw = false
    if not win.is_open { return false }
    if win.backend == 1 {
        f_isw  := ffi_sym(win.user32, "IsWindow")
        if (ffi_call1(f_isw, win.hwnd) & 0xFFFFFFFF) == 0 {
            win.is_open = false
            return false
        }
        f_peek := ffi_sym(win.user32, "PeekMessageW")
        f_tr   := ffi_sym(win.user32, "TranslateMessage")
        f_disp := ffi_sym(win.user32, "DispatchMessageW")
        f_val  := ffi_sym(win.user32, "ValidateRect")
        buf := ffi_alloc(64)
        mut guard := 0
        while guard < 64 {
            guard += 1
            got := ffi_call5(f_peek, buf, win.hwnd, 0, 0, 1) & 0xFFFFFFFF // PM_REMOVE
            if got == 0 { break }
            mcode := ffi_read_u32_le(buf, 8)
            if mcode == 0x0012 or mcode == 0x0010 or mcode == 0x0002 { // WM_QUIT/WM_CLOSE/WM_DESTROY
                win.is_open = false
                break
            }
            if mcode == 0x000F { // WM_PAINT
                win.needs_redraw = true
                if f_val != 0 { _ := ffi_call2(f_val, win.hwnd, 0) }
                continue
            }
            if mcode == 0x0005 or mcode == 0x0006 or mcode == 0x0007 or mcode == 0x02E0 { // WM_SIZE/ACTIVATE/SETFOCUS/DPICHANGED
                win.needs_redraw = true
            } else if mcode == 0x0102 { // WM_CHAR
                ch := ffi_read_i64(buf, 2) & 0xFFFF
                if ch > 0 { win.last_char = ch }
            } else if mcode == 0x020A { // WM_MOUSEWHEEL (signed 16-bit HIWORD)
                raw_d := (ffi_read_i64(buf, 2) >> 16) & 0xFFFF
                delta := if raw_d >= 32768 { raw_d - 65536 } else { raw_d }
                win.scroll_delta += delta
            }
            _ := ffi_call1(f_tr, buf)
            _ := ffi_call1(f_disp, buf)
        }

        // Reuse single 64B scratch buffer for client rect + cursor coords (zero extra heap churn)
        f_rect := ffi_sym(win.user32, "GetClientRect")
        if f_rect != 0 {
            _ := ffi_call2(f_rect, win.hwnd, buf)
            cw := ffi_sext32(ffi_read_u32_le(buf, 8))
            ch := ffi_sext32(ffi_read_u32_le(buf, 12))
            if cw > 100 and ch > 100 {
                win.width = cw
                win.height = ch
            }
        }

        f_cp := ffi_sym(win.user32, "GetCursorPos")
        f_sc := ffi_sym(win.user32, "ScreenToClient")
        f_ks := ffi_sym(win.user32, "GetAsyncKeyState")
        _ := ffi_call1(f_cp, buf)
        _ := ffi_call2(f_sc, win.hwnd, buf)
        win.mouse_x = ffi_sext32(ffi_read_u32_le(buf, 0))
        win.mouse_y = ffi_sext32(ffi_read_u32_le(buf, 4))
        ffi_free(buf)
        win.mouse_down = (ffi_call1(f_ks, 0x01) & 0x8000) != 0
        win.key_escape = (ffi_call1(f_ks, 0x1B) & 0x8000) != 0
        return win.is_open
    }
    if win.backend == 2 {
        f_pe := ffi_sym(win.sdl2, "SDL_PollEvent")
        ev := ffi_alloc(64)
        while (ffi_call1(f_pe, ev) & 0xFFFFFFFF) != 0 {
            et := ffi_read_u32_le(ev, 0)
            if et == 0x100 { win.is_open = false } // SDL_QUIT
        }
        ffi_free(ev)
        return win.is_open
    }
    return false
}

// Blit an Axon `Canvas` (`std::ui_render`) directly into the native OS window surface at 60+ FPS!
fn gui_present_canvas(win: GuiWindow, canvas: Canvas) -> bool {
    if not win.is_open { return false }
    w := canvas.width
    h := canvas.height
    if w <= 0 or h <= 0 { return false }
    npix := w * h
    if buf_len(canvas.pixels) < npix * 4 { return false }

    if win.backend == 1 {
        f_gdc := ffi_sym(win.user32, "GetDC")
        f_rdc := ffi_sym(win.user32, "ReleaseDC")
        f_sdib := ffi_sym(win.gdi32, "StretchDIBits")
        hdc := ffi_call1(f_gdc, win.hwnd)
        if hdc == 0 { return false }

        // Canvas pixels are already stored in native little-endian BGRA (`[B, G, R, A]`), matching Win32 BI_RGB DIB!
        // Zero-alloc direct pointer blit (100x faster than per-pixel FFI copy & fixes R/B channel swap).
        px_ptr := unsafe { (canvas.pixels as i64) + 16 }
        bmi := ffi_alloc(64)
        ffi_write_u32_le(bmi, 0, 40)       // biSize = 40
        ffi_write_u32_le(bmi, 4, w)        // biWidth
        ffi_write_u32_le(bmi, 8, (0 - h) & 0xFFFFFFFF) // negative = top-down DIB
        ffi_write_u16_le(bmi, 12, 1)       // biPlanes = 1
        ffi_write_u16_le(bmi, 14, 32)      // biBitCount = 32
        ffi_write_u32_le(bmi, 16, 0)       // BI_RGB

        args := ibuf_new(16)
        ibuf_push(args, hdc)
        ibuf_push(args, 0); ibuf_push(args, 0); ibuf_push(args, win.width); ibuf_push(args, win.height)
        ibuf_push(args, 0); ibuf_push(args, 0); ibuf_push(args, w); ibuf_push(args, h)
        ibuf_push(args, px_ptr)
        ibuf_push(args, bmi)
        ibuf_push(args, 0)          // DIB_RGB_COLORS
        ibuf_push(args, 0x00CC0020) // SRCCOPY
        drawn := ffi_sext32(ffi_call_arr(f_sdib, 13, args))
        buf_free(move args)
        ffi_free(bmi)
        _ := ffi_call2(f_rdc, win.hwnd, hdc)
        return drawn >= 0
    }
    if win.backend == 2 {
        f_ut := ffi_sym(win.sdl2, "SDL_UpdateTexture")
        f_rc := ffi_sym(win.sdl2, "SDL_RenderCopy")
        f_rp := ffi_sym(win.sdl2, "SDL_RenderPresent")
        px := ffi_bytes_to_ptr(canvas.pixels)
        _ := ffi_call4(f_ut, win.aux2, 0, px, w * 4)
        _ := ffi_call4(f_rc, win.aux1, win.aux2, 0, 0)
        _ := ffi_call1(f_rp, win.aux1)
        ffi_free(px)
        return true
    }
    return false
}

fn gui_close(mut win: GuiWindow) {
    if not win.is_open { return }
    if win.backend == 1 and win.hwnd != 0 {
        f := ffi_sym(win.user32, "DestroyWindow")
        _ := ffi_call1(f, win.hwnd)
    } else if win.backend == 2 and win.hwnd != 0 {
        f_dw := ffi_sym(win.sdl2, "SDL_DestroyWindow")
        _ := ffi_call1(f_dw, win.hwnd)
    }
    win.is_open = false
}

// Win32 HFONT cache. GDI font creation costs ~40-80us per call; caching by
// (size, weight) keeps steady-state frames free of object churn.
struct GuiFontCache {
    entries: IntBuf // triples: [size, weight, hfont]
    count: i64
}

fn gui_font_cache_new() -> GuiFontCache {
    return GuiFontCache(entries = ibuf_new(24), count = 0)
}

fn _gui_font_index(c: GuiFontCache, size: i64, weight: i64) -> i64 {
    mut i := 0
    while i < c.count {
        if ibuf_get(c.entries, i * 3) == size and ibuf_get(c.entries, i * 3 + 1) == weight { return i }
        i += 1
    }
    return -1
}

fn _gui_create_font(gdi: i64, face: str, size: i64, weight: i64) -> i64 {
    f_cfont := ffi_sym(gdi, "CreateFontA")
    if f_cfont == 0 { return 0 }
    c_face := ffi_cstr(face)
    args := ibuf_new(16)
    ibuf_push(args, 0 - size); ibuf_push(args, 0); ibuf_push(args, 0); ibuf_push(args, 0)
    ibuf_push(args, weight); ibuf_push(args, 0); ibuf_push(args, 0); ibuf_push(args, 0)
    ibuf_push(args, 1); ibuf_push(args, 0); ibuf_push(args, 0); ibuf_push(args, 5) // CLEARTYPE_QUALITY
    ibuf_push(args, 0); ibuf_push(args, c_face)
    h := ffi_call_arr(f_cfont, 14, args)
    buf_free(move args)
    ffi_free(c_face)
    return h
}

fn gui_font_cache_get(mut c: GuiFontCache, gdi: i64, face: str, size: i64, weight: i64) -> i64 {
    mut sz := size
    if sz < 8 { sz = 8 }
    if sz > 96 { sz = 96 }
    mut w := weight
    if w < 100 or w > 900 { w = 400 }
    idx := _gui_font_index(c, sz, w)
    if idx >= 0 { return ibuf_get(c.entries, idx * 3 + 2) }
    h := _gui_create_font(gdi, face, sz, w)
    if h == 0 { return 0 }
    ibuf_push(c.entries, sz)
    ibuf_push(c.entries, w)
    ibuf_push(c.entries, h)
    c.count += 1
    return h
}

fn gui_font_cache_free(move c: GuiFontCache, gdi: i64) {
    f_delo := ffi_sym(gdi, "DeleteObject")
    if f_delo != 0 {
        mut i := 0
        while i < c.count {
            _ := ffi_call1(f_delo, ibuf_get(c.entries, i * 3 + 2))
            i += 1
        }
    }
    buf_free(move c.entries)
}

// ==============================================================================
// AXON PHOTON-D2D ENGINE: Hardware Direct2D + DirectWrite Native HTML/CSS/Tailwind
// Zero Browser, Zero WebView, Zero Blur, 0.00% Idle CPU, Persistent Backbuffer!
// ==============================================================================

struct PhotonD2D {
    ok: bool
    d2d_fac: i64
    dw_fac: i64
    rt: i64
    brush: i64
    mem_dc: i64
    hbm: i64
    old_bm: i64
    bb_w: i64
    bb_h: i64
    tf_entries: IntBuf // [size, weight, h_align, v_align, wrap, ptr] * count
    tf_count: i64
    k32: i64
    f_mb2w: i64
    f_gdc: i64
    f_rdc: i64
    f_cdc: i64
    f_cbm: i64
    f_sel: i64
    f_delo: i64
    f_deldc: i64
    f_bkit: i64
    scratch: i64
    out_box: i64
    wbuf: i64
    wcap: i64
    dpi: i64
    gdiplus: i64
    gdip_tok: i64
    img_entries: IntBuf
    img_count: i64
}

fn _p2d_vt(obj: i64, idx: i64) -> i64 {
    return ffi_read_i64(ffi_read_i64(obj, 0), idx)
}

fn _p2d_f32_ratio(num: i64, den: i64) -> i64 {
    if num == 0 or den == 0 { return 0 }
    mut s := 0
    mut a := num
    mut b := den
    if a < 0 { s = 0x80000000; a = -a }
    if b < 0 { s = s ^ 0x80000000; b = -b }
    mut exp := 127
    while a < b { a *= 2; exp -= 1 }
    while a >= b * 2 { b *= 2; exp += 1 }
    mant := (((a - b) << 23) + (b / 2)) / b
    if mant >= 0x800000 { return s | ((exp + 1) << 23) }
    return s | ((exp & 0xFF) << 23) | (mant & 0x7FFFFF)
}

fn _p2d_f32(v: i64) -> i64 {
    return _p2d_f32_ratio(v, 1)
}

fn _p2d_apply_opacity(argb: i64, op_pct: i64) -> i64 {
    if op_pct >= 100 { return argb }
    if op_pct <= 0 { return argb & 0x00FFFFFF }
    a := (((argb >> 24) & 0xFF) * op_pct) / 100
    return (a << 24) | (argb & 0x00FFFFFF)
}

fn _p2d_write_color(buf: i64, argb: i64) {
    a := (argb >> 24) & 0xFF
    r := (argb >> 16) & 0xFF
    g := (argb >> 8) & 0xFF
    b := argb & 0xFF
    ffi_write_u32_le(buf, 0, _p2d_f32_ratio(r, 255))
    ffi_write_u32_le(buf, 4, _p2d_f32_ratio(g, 255))
    ffi_write_u32_le(buf, 8, _p2d_f32_ratio(b, 255))
    ffi_write_u32_le(buf, 12, _p2d_f32_ratio(a, 255))
}

fn _p2d_write_rect(buf: i64, x: i64, y: i64, w: i64, h: i64) {
    ffi_write_u32_le(buf, 0, _p2d_f32(x))
    ffi_write_u32_le(buf, 4, _p2d_f32(y))
    ffi_write_u32_le(buf, 8, _p2d_f32(x + w))
    ffi_write_u32_le(buf, 12, _p2d_f32(y + h))
}

fn _p2d_write_rrect(buf: i64, x: i64, y: i64, w: i64, h: i64, rad: i64) {
    _p2d_write_rect(buf, x, y, w, h)
    rf := _p2d_f32(rad)
    ffi_write_u32_le(buf, 16, rf)
    ffi_write_u32_le(buf, 20, rf)
}

fn photon_d2d_init(win: GuiWindow) -> PhotonD2D {
    k32 := ffi_open_one("kernel32.dll")
    mut d2d := PhotonD2D(
        ok = false, d2d_fac = 0, dw_fac = 0, rt = 0, brush = 0,
        mem_dc = 0, hbm = 0, old_bm = 0, bb_w = 0, bb_h = 0,
        tf_entries = ibuf_new(192), tf_count = 0,
        k32 = k32,
        f_mb2w = if k32 != 0 { ffi_sym(k32, "MultiByteToWideChar") } else { 0 },
        f_gdc = ffi_sym(win.user32, "GetDC"),
        f_rdc = ffi_sym(win.user32, "ReleaseDC"),
        f_cdc = ffi_sym(win.gdi32, "CreateCompatibleDC"),
        f_cbm = ffi_sym(win.gdi32, "CreateCompatibleBitmap"),
        f_sel = ffi_sym(win.gdi32, "SelectObject"),
        f_delo = ffi_sym(win.gdi32, "DeleteObject"),
        f_deldc = ffi_sym(win.gdi32, "DeleteDC"),
        f_bkit = ffi_sym(win.gdi32, "BitBlt"),
        scratch = ffi_alloc(384),
        out_box = ffi_alloc(16),
        wbuf = ffi_alloc(16384),
        wcap = 8188,
        dpi = gui_get_dpi(win),
        gdiplus = 0,
        gdip_tok = 0,
        img_entries = ibuf_new(128),
        img_count = 0
    )
    if win.backend != 1 { return d2d }
    lib_d2d := ffi_open_one("d2d1.dll")
    lib_dw  := ffi_open_one("dwrite.dll")
    if lib_d2d == 0 or lib_dw == 0 { return d2d }
    f_d2d := ffi_sym(lib_d2d, "D2D1CreateFactory")
    f_dw  := ffi_sym(lib_dw, "DWriteCreateFactory")
    if f_d2d == 0 or f_dw == 0 { return d2d }

    iid_d2d := ffi_alloc(16)
    ffi_write_u32_le(iid_d2d, 0, 0x06152247); ffi_write_u16_le(iid_d2d, 4, 0x6f50); ffi_write_u16_le(iid_d2d, 6, 0x465a)
    ffi_write_u8(iid_d2d, 8, 0x92); ffi_write_u8(iid_d2d, 9, 0x45); ffi_write_u8(iid_d2d, 10, 0x11); ffi_write_u8(iid_d2d, 11, 0x8b)
    ffi_write_u8(iid_d2d, 12, 0xfd); ffi_write_u8(iid_d2d, 13, 0x3b); ffi_write_u8(iid_d2d, 14, 0x60); ffi_write_u8(iid_d2d, 15, 0x07)

    iid_dw := ffi_alloc(16)
    ffi_write_u32_le(iid_dw, 0, 0xb859ee5a); ffi_write_u16_le(iid_dw, 4, 0xd838); ffi_write_u16_le(iid_dw, 6, 0x4b5b)
    ffi_write_u8(iid_dw, 8, 0xa2); ffi_write_u8(iid_dw, 9, 0xe8); ffi_write_u8(iid_dw, 10, 0x1a); ffi_write_u8(iid_dw, 11, 0xdc)
    ffi_write_u8(iid_dw, 12, 0x7d); ffi_write_u8(iid_dw, 13, 0x93); ffi_write_u8(iid_dw, 14, 0xdb); ffi_write_u8(iid_dw, 15, 0x48)

    hr1 := ffi_call4(f_d2d, 0, iid_d2d, 0, d2d.out_box) & 0xFFFFFFFF
    d2d.d2d_fac = ffi_read_i64(d2d.out_box, 0)
    hr2 := ffi_call3(f_dw, 0, iid_dw, d2d.out_box) & 0xFFFFFFFF
    d2d.dw_fac = ffi_read_i64(d2d.out_box, 0)
    ffi_free(iid_d2d); ffi_free(iid_dw)
    if hr1 != 0 or hr2 != 0 or d2d.d2d_fac == 0 or d2d.dw_fac == 0 { return d2d }

    props := d2d.scratch
    ffi_write_u32_le(props, 0, 0)
    ffi_write_u32_le(props, 4, 87) // DXGI_FORMAT_B8G8R8A8_UNORM
    ffi_write_u32_le(props, 8, 3)  // D2D1_ALPHA_MODE_IGNORE
    // Native Per-Monitor DPI (96 / 120 / 144 / 192): Direct2D + DirectWrite render at full physical resolution (0 blur!)
    ffi_write_u32_le(props, 12, _p2d_f32(d2d.dpi))
    ffi_write_u32_le(props, 16, _p2d_f32(d2d.dpi))
    ffi_write_u32_le(props, 20, 0)
    ffi_write_u32_le(props, 24, 0)
    hr3 := ffi_call3(_p2d_vt(d2d.d2d_fac, 16), d2d.d2d_fac, props, d2d.out_box) & 0xFFFFFFFF
    d2d.rt = ffi_read_i64(d2d.out_box, 0)
    if hr3 != 0 or d2d.rt == 0 { return d2d }

    // D2D1_TEXT_ANTIALIAS_MODE_CLEARTYPE (1): 3x horizontal LCD subpixel sharpness identical to Chrome/Edge!
    _ := ffi_call2(_p2d_vt(d2d.rt, 34), d2d.rt, 1)

    _p2d_write_color(d2d.scratch, 0xFFFFFFFF)
    hr4 := ffi_call4(_p2d_vt(d2d.rt, 8), d2d.rt, d2d.scratch, 0, d2d.out_box) & 0xFFFFFFFF
    d2d.brush = ffi_read_i64(d2d.out_box, 0)
    if hr4 != 0 or d2d.brush == 0 { return d2d }

    d2d.ok = true
    return d2d
}

fn photon_d2d_free(move d2d: PhotonD2D) {
    if d2d.mem_dc != 0 {
        if d2d.old_bm != 0 { _ := ffi_call2(d2d.f_sel, d2d.mem_dc, d2d.old_bm) }
        if d2d.hbm != 0 { _ := ffi_call1(d2d.f_delo, d2d.hbm) }
        _ := ffi_call1(d2d.f_deldc, d2d.mem_dc)
    }
    mut i := 0
    while i < d2d.tf_count {
        tf := ibuf_get(d2d.tf_entries, i * 6 + 5)
        if tf != 0 { _ := ffi_call1(_p2d_vt(tf, 2), tf) }
        i += 1
    }
    buf_free(move d2d.tf_entries)
    i = 0
    while i < d2d.img_count {
        bmp := ibuf_get(d2d.img_entries, i * 4 + 1)
        if bmp != 0 { _ := ffi_call1(_p2d_vt(bmp, 2), bmp) }
        i += 1
    }
    buf_free(move d2d.img_entries)
    if d2d.gdip_tok != 0 and d2d.gdiplus != 0 {
        f_sd := ffi_sym(d2d.gdiplus, "GdiplusShutdown")
        if f_sd != 0 { _ := ffi_call1(f_sd, d2d.gdip_tok) }
    }
    if d2d.brush != 0 { _ := ffi_call1(_p2d_vt(d2d.brush, 2), d2d.brush) }
    if d2d.rt != 0 { _ := ffi_call1(_p2d_vt(d2d.rt, 2), d2d.rt) }
    if d2d.dw_fac != 0 { _ := ffi_call1(_p2d_vt(d2d.dw_fac, 2), d2d.dw_fac) }
    if d2d.d2d_fac != 0 { _ := ffi_call1(_p2d_vt(d2d.d2d_fac, 2), d2d.d2d_fac) }
    ffi_free(d2d.scratch); ffi_free(d2d.out_box); ffi_free(d2d.wbuf)
}

fn _p2d_ensure_bb(mut d2d: PhotonD2D, hdc: i64, w: i64, h: i64) -> bool {
    if d2d.mem_dc != 0 and d2d.hbm != 0 and d2d.bb_w == w and d2d.bb_h == h {
        return true
    }
    if d2d.mem_dc != 0 {
        if d2d.old_bm != 0 { _ := ffi_call2(d2d.f_sel, d2d.mem_dc, d2d.old_bm) }
        if d2d.hbm != 0 { _ := ffi_call1(d2d.f_delo, d2d.hbm) }
        _ := ffi_call1(d2d.f_deldc, d2d.mem_dc)
        d2d.mem_dc = 0; d2d.hbm = 0; d2d.old_bm = 0
    }
    d2d.mem_dc = ffi_call1(d2d.f_cdc, hdc)
    if d2d.mem_dc == 0 { return false }
    d2d.hbm = ffi_call3(d2d.f_cbm, hdc, w, h)
    if d2d.hbm == 0 { _ := ffi_call1(d2d.f_deldc, d2d.mem_dc); d2d.mem_dc = 0; return false }
    d2d.old_bm = ffi_call2(d2d.f_sel, d2d.mem_dc, d2d.hbm)
    d2d.bb_w = w; d2d.bb_h = h

    rc := d2d.scratch + 128
    ffi_write_u32_le(rc, 0, 0); ffi_write_u32_le(rc, 4, 0)
    ffi_write_u32_le(rc, 8, w); ffi_write_u32_le(rc, 12, h)
    return (ffi_call3(_p2d_vt(d2d.rt, 57), d2d.rt, d2d.mem_dc, rc) & 0xFFFFFFFF) == 0
}

fn _p2d_get_text_format(mut d2d: PhotonD2D, sz_in: i64, weight_in: i64, h_align: i64, v_align: i64, wrap: i64, is_mono: bool = false) -> i64 {
    mut sz := sz_in
    if sz < 8 { sz = 8 } else if sz > 96 { sz = 96 }
    mut w := weight_in
    if w < 100 or w > 900 { w = 400 }
    wrap_key := wrap | (if is_mono { 4 } else { 0 })
    mut i := 0
    while i < d2d.tf_count {
        b := i * 6
        if ibuf_get(d2d.tf_entries, b) == sz and ibuf_get(d2d.tf_entries, b + 1) == w and ibuf_get(d2d.tf_entries, b + 2) == h_align and ibuf_get(d2d.tf_entries, b + 3) == v_align and ibuf_get(d2d.tf_entries, b + 4) == wrap_key {
            return ibuf_get(d2d.tf_entries, b + 5)
        }
        i += 1
    }
    w_face := ffi_wstr(if is_mono { "Consolas" } else { "Segoe UI Variable Text" })
    w_loc := ffi_wstr("en-US")
    args := ibuf_new(12)
    ibuf_push(args, d2d.dw_fac); ibuf_push(args, w_face); ibuf_push(args, 0); ibuf_push(args, w)
    ibuf_push(args, 0); ibuf_push(args, 5); ibuf_push(args, _p2d_f32(sz)); ibuf_push(args, w_loc); ibuf_push(args, d2d.out_box)
    hr := ffi_call_arr(_p2d_vt(d2d.dw_fac, 15), 9, args) & 0xFFFFFFFF
    buf_free(move args)
    ffi_free(w_face); ffi_free(w_loc)
    if hr != 0 { return 0 }
    tf := ffi_read_i64(d2d.out_box, 0)
    if tf != 0 {
        _ := ffi_call2(_p2d_vt(tf, 3), tf, h_align)
        _ := ffi_call2(_p2d_vt(tf, 4), tf, v_align)
        _ := ffi_call2(_p2d_vt(tf, 5), tf, wrap)
        if d2d.tf_count < 30 {
            ibuf_push(d2d.tf_entries, sz); ibuf_push(d2d.tf_entries, w)
            ibuf_push(d2d.tf_entries, h_align); ibuf_push(d2d.tf_entries, v_align)
            ibuf_push(d2d.tf_entries, wrap_key); ibuf_push(d2d.tf_entries, tf)
            d2d.tf_count += 1
        }
    }
    return tf
}

fn _p2d_fill_rrect(d2d: PhotonD2D, x: i64, y: i64, w: i64, h: i64, rad: i64, argb: i64) {
    if w <= 0 or h <= 0 or ((argb >> 24) & 0xFF) == 0 { return }
    // Sharp aliased edges for 0-radius 1px hairlines, per-primitive AA for rounded corners (0 blur!)
    _ := ffi_call2(_p2d_vt(d2d.rt, 32), d2d.rt, if rad == 0 { 1 } else { 0 })
    _p2d_write_color(d2d.scratch, argb)
    _ := ffi_call2(_p2d_vt(d2d.brush, 8), d2d.brush, d2d.scratch)
    rr := d2d.scratch + 32
    _p2d_write_rrect(rr, x, y, w, h, rad)
    _ := ffi_call3(_p2d_vt(d2d.rt, 19), d2d.rt, rr, d2d.brush)
}

fn _p2d_fill_grad_rrect(d2d: PhotonD2D, x: i64, y: i64, w: i64, h: i64, rad: i64, dir: i64, c_from: i64, c_to: i64) {
    if w <= 0 or h <= 0 { return }
    stops := d2d.scratch + 160
    ffi_write_u32_le(stops, 0, _p2d_f32_ratio(0, 1))
    _p2d_write_color(stops + 4, c_from)
    ffi_write_u32_le(stops, 20, _p2d_f32_ratio(1, 1))
    _p2d_write_color(stops + 24, c_to)

    hr_s := ffi_call6(_p2d_vt(d2d.rt, 9), d2d.rt, stops, 2, 0, 0, d2d.out_box) & 0xFFFFFFFF
    if hr_s != 0 { _p2d_fill_rrect(d2d, x, y, w, h, rad, c_from); return }
    scoll := ffi_read_i64(d2d.out_box, 0)
    gp := d2d.scratch + 240
    ffi_write_u32_le(gp, 0, _p2d_f32(x))
    ffi_write_u32_le(gp, 4, _p2d_f32(y))
    ex := if dir == 2 { x } else { x + w }
    ey := if dir == 1 { y } else { y + h }
    ffi_write_u32_le(gp, 8, _p2d_f32(ex))
    ffi_write_u32_le(gp, 12, _p2d_f32(ey))

    hr_g := ffi_call5(_p2d_vt(d2d.rt, 10), d2d.rt, gp, 0, scoll, d2d.out_box) & 0xFFFFFFFF
    _ := ffi_call1(_p2d_vt(scoll, 2), scoll)
    if hr_g != 0 { _p2d_fill_rrect(d2d, x, y, w, h, rad, c_from); return }
    gb := ffi_read_i64(d2d.out_box, 0)
    rr := d2d.scratch + 32
    _p2d_write_rrect(rr, x, y, w, h, rad)
    _ := ffi_call3(_p2d_vt(d2d.rt, 19), d2d.rt, rr, gb)
    _ := ffi_call1(_p2d_vt(gb, 2), gb)
}

// Native PNG/JPG/BMP/GIF/ICO image loader via Windows `gdiplus.dll` -> cached `ID2D1Bitmap` (0 external deps!)
fn _p2d_find_or_load_img(mut d2d: PhotonD2D, path: str) -> i64 {
    if str_len(path) == 0 or not d2d.ok { return -1 }
    ph := fnv1a_64(path)
    mut i := 0
    while i < d2d.img_count {
        if ibuf_get(d2d.img_entries, i * 4) == ph { return i }
        i += 1
    }
    if d2d.img_count >= 32 { return -1 }

    if d2d.gdiplus == 0 {
        d2d.gdiplus = ffi_open_one("gdiplus.dll")
        if d2d.gdiplus == 0 { return -1 }
        f_st := ffi_sym(d2d.gdiplus, "GdiplusStartup")
        if f_st == 0 { return -1 }
        si := ffi_alloc(32)
        ffi_write_u32_le(si, 0, 1) // GdiplusVersion = 1
        tok_box := ffi_alloc(16)
        st := ffi_call3(f_st, tok_box, si, 0) & 0xFFFFFFFF
        d2d.gdip_tok = ffi_read_i64(tok_box, 0)
        ffi_free(tok_box); ffi_free(si)
        if st != 0 { return -1 }
    }

    f_load := ffi_sym(d2d.gdiplus, "GdipCreateBitmapFromFile")
    f_gw   := ffi_sym(d2d.gdiplus, "GdipGetImageWidth")
    f_gh   := ffi_sym(d2d.gdiplus, "GdipGetImageHeight")
    f_lock := ffi_sym(d2d.gdiplus, "GdipBitmapLockBits")
    f_unlk := ffi_sym(d2d.gdiplus, "GdipBitmapUnlockBits")
    f_disp := ffi_sym(d2d.gdiplus, "GdipDisposeImage")
    if f_load == 0 or f_lock == 0 or f_disp == 0 { return -1 }

    wpath := _gui_utf8_to_utf16(d2d.k32, path)
    gp_box := ffi_alloc(16)
    st_l := ffi_call2(f_load, wpath, gp_box) & 0xFFFFFFFF
    gp_bmp := ffi_read_i64(gp_box, 0)
    ffi_free(gp_box); ffi_free(wpath)
    if st_l != 0 or gp_bmp == 0 { return -1 }

    wh_box := ffi_alloc(16)
    _ := ffi_call2(f_gw, gp_bmp, wh_box)
    _ := ffi_call2(f_gh, gp_bmp, wh_box + 8)
    iw := ffi_read_u32_le(wh_box, 0)
    ih := ffi_read_u32_le(wh_box, 8)
    ffi_free(wh_box)
    if iw <= 0 or ih <= 0 or iw > 8192 or ih > 8192 {
        _ := ffi_call1(f_disp, gp_bmp)
        return -1
    }

    // Lock into 32bpp Premultiplied ARGB (`0x000E200B`) matching Direct2D `B8G8R8A8_UNORM` + `PREMULTIPLIED`
    rc := ffi_alloc(16)
    ffi_write_u32_le(rc, 0, 0); ffi_write_u32_le(rc, 4, 0)
    ffi_write_u32_le(rc, 8, iw); ffi_write_u32_le(rc, 12, ih)
    bdata := ffi_alloc(48) // sizeof(BitmapData) = 32 on x64: [0]=W, [4]=H, [8]=Stride, [12]=PixelFormat, [16]=Scan0
    st_lk := ffi_call5(f_lock, gp_bmp, rc, 1, 0x000E200B, bdata) & 0xFFFFFFFF
    ffi_free(rc)
    mut d2d_bmp := 0
    if st_lk == 0 {
        stride := ffi_sext32(ffi_read_u32_le(bdata, 8))
        scan0  := ffi_read_i64(bdata, 2) // offset 16
        if scan0 != 0 and stride > 0 {
            bprops := d2d.scratch + 280
            ffi_write_u32_le(bprops, 0, 87) // DXGI_FORMAT_B8G8R8A8_UNORM
            ffi_write_u32_le(bprops, 4, 1)  // D2D1_ALPHA_MODE_PREMULTIPLIED
            ffi_write_u32_le(bprops, 8, _p2d_f32(96))
            ffi_write_u32_le(bprops, 12, _p2d_f32(96))
            sz_u := (iw & 0xFFFFFFFF) | ((ih & 0xFFFFFFFF) << 32)
            hr_b := ffi_call6(_p2d_vt(d2d.rt, 4), d2d.rt, sz_u, scan0, stride, bprops, d2d.out_box) & 0xFFFFFFFF
            if hr_b == 0 { d2d_bmp = ffi_read_i64(d2d.out_box, 0) }
        }
        _ := ffi_call2(f_unlk, gp_bmp, bdata)
    }
    ffi_free(bdata)
    _ := ffi_call1(f_disp, gp_bmp)
    if d2d_bmp == 0 { return -1 }

    slot := d2d.img_count
    ibuf_push(d2d.img_entries, ph)
    ibuf_push(d2d.img_entries, d2d_bmp)
    ibuf_push(d2d.img_entries, iw)
    ibuf_push(d2d.img_entries, ih)
    d2d.img_count += 1
    return slot
}

fn _p2d_draw_img_rrect(mut d2d: PhotonD2D, path: str, x: i64, y: i64, w: i64, h: i64, rad: i64) {
    if w <= 0 or h <= 0 { return }
    slot := _p2d_find_or_load_img(mut d2d, path)
    if slot < 0 { return }
    bmp := ibuf_get(d2d.img_entries, slot * 4 + 1)
    iw  := ibuf_get(d2d.img_entries, slot * 4 + 2)
    ih  := ibuf_get(d2d.img_entries, slot * 4 + 3)
    if bmp == 0 or iw <= 0 or ih <= 0 { return }

    // CreateBitmapBrush (vtable slot 11): 100% pointer ABI + supports rounded corners (`rounded-full` avatars!)
    hr_bb := ffi_call5(_p2d_vt(d2d.rt, 11), d2d.rt, bmp, 0, 0, d2d.out_box) & 0xFFFFFFFF
    if hr_bb != 0 { return }
    bbrush := ffi_read_i64(d2d.out_box, 0)
    if bbrush == 0 { return }

    // D2D1_MATRIX_3X2_F: [sx, 0, 0, sy, tx, ty] -> maps image (0..iw, 0..ih) to (x..x+w, y..y+h)
    mat := d2d.scratch + 240
    ffi_write_u32_le(mat, 0, _p2d_f32_ratio(w, iw))
    ffi_write_u32_le(mat, 4, 0)
    ffi_write_u32_le(mat, 8, 0)
    ffi_write_u32_le(mat, 12, _p2d_f32_ratio(h, ih))
    ffi_write_u32_le(mat, 16, _p2d_f32(x))
    ffi_write_u32_le(mat, 20, _p2d_f32(y))
    _ := ffi_call2(_p2d_vt(bbrush, 4), bbrush, mat) // ID2D1Brush::SetTransform

    _ := ffi_call2(_p2d_vt(d2d.rt, 32), d2d.rt, if rad == 0 { 1 } else { 0 })
    rr := d2d.scratch + 32
    _p2d_write_rrect(rr, x, y, w, h, rad)
    _ := ffi_call3(_p2d_vt(d2d.rt, 19), d2d.rt, rr, bbrush)
    _ := ffi_call1(_p2d_vt(bbrush, 2), bbrush)
}

fn _p2d_paint_node(mut d2d: PhotonD2D, app: UiApp, node_idx: i64, hovered_node: i64, acc_scroll_y: i64, dip_h: i64) {
    if node_idx < 0 or node_idx >= app.tree.count { return }
    bx := layout_get_x(app.layout, node_idx)
    raw_by := layout_get_y(app.layout, node_idx)
    bw := layout_get_w(app.layout, node_idx)
    bh := layout_get_h(app.layout, node_idx)
    style := css_compute_node_style_state(app.tree, node_idx, app.sheet, node_idx == hovered_node)
    if style.display == 3 or style.opacity <= 0 { return }

    by := if style.position == 2 { raw_by } else { raw_by - acc_scroll_y }
    vis := bw > 0 and bh > 0 and by + bh >= 0 and by <= dip_h
    tag := dom_get_tag(app.tree, node_idx)

    if vis {
        mut rad := style.border_radius
        if rad > bw / 2 { rad = bw / 2 }
        if rad > bh / 2 { rad = bh / 2 }
        if rad < 0 { rad = 0 }

        // 1. Soft multi-layer Drop Shadow (`shadow-sm..2xl`, CSS `box-shadow`)
        if style.shadow > 0 and (style.bg_color != 0 or style.grad_dir > 0) {
            sh := style.shadow
            _p2d_fill_rrect(d2d, bx - sh, by + sh * 2, bw + sh * 2, bh + sh, rad + sh, 0x16000000)
            _p2d_fill_rrect(d2d, bx, by + sh, bw, bh + sh / 2 + 1, rad + 1, 0x26000000)
        }

        // 2. Border + Background / Linear Gradient + Focus Ring (zero half-pixel blur!)
        is_focused := (node_idx == app.focused_idx)
        has_bd := (style.border_width > 0 and style.border_color != 0) or is_focused
        has_grad := style.grad_dir > 0 and (style.grad_from != 0 or style.grad_to != 0)
        has_bg := style.bg_color != 0
        bd_w := if is_focused { 2 } else { (if has_bd { style.border_width } else { 0 }) }
        eff_bd_col := if is_focused { 0xFF3B82F6 } else { style.border_color }

        if has_bd and (has_grad or has_bg) {
            bd_col := _p2d_apply_opacity(eff_bd_col, style.opacity)
            _p2d_fill_rrect(d2d, bx, by, bw, bh, rad, bd_col)
        }

        ix := bx + bd_w
        iy := by + bd_w
        iw := bw - bd_w * 2
        ih := bh - bd_w * 2
        mut irad := rad - bd_w
        if irad < 0 { irad = 0 }

        if has_grad {
            cf := _p2d_apply_opacity(if style.grad_from != 0 { style.grad_from } else { style.bg_color }, style.opacity)
            ct := _p2d_apply_opacity(if style.grad_to != 0 { style.grad_to } else { cf }, style.opacity)
            _p2d_fill_grad_rrect(d2d, ix, iy, iw, ih, irad, style.grad_dir, cf, ct)
        } else if has_bg {
            bg_col := _p2d_apply_opacity(style.bg_color, style.opacity)
            _p2d_fill_rrect(d2d, ix, iy, iw, ih, irad, bg_col)
        } else if has_bd {
            bd_col := _p2d_apply_opacity(eff_bd_col, style.opacity)
            _p2d_fill_rrect(d2d, bx, by, bw, bd_w, 0, bd_col)
            _p2d_fill_rrect(d2d, bx, by + bh - bd_w, bw, bd_w, 0, bd_col)
            _p2d_fill_rrect(d2d, bx, by, bd_w, bh, 0, bd_col)
            _p2d_fill_rrect(d2d, bx + bw - bd_w, by, bd_w, bh, 0, bd_col)
        }

        // 3. Native `<img src="...">` Bitmap Rendering OR DirectWrite ClearType Typography
        if str_eq_ignore_case(tag, "img") {
            src_path := dom_get_text(app.tree, node_idx)
            if str_len(src_path) > 0 {
                _p2d_draw_img_rrect(mut d2d, src_path, ix, iy, iw, ih, irad)
            }
        } else {
            raw_txt := dom_get_text(app.tree, node_idx)
            txt := if is_focused { raw_txt + "|" } else { raw_txt }
            tlen := str_len(txt)
            if tlen > 0 and d2d.f_mb2w != 0 {
                mut fz := style.font_size
                if fz <= 0 { fz = 14 }
                mut fw := style.font_weight
                if fw <= 0 { fw = 400 }

                mut ha := 0
                if style.text_align == 1 { ha = 2 }
                else if style.text_align == 2 { ha = 1 }

                is_single := str_eq_ignore_case(tag, "button") or str_eq_ignore_case(tag, "input")
                va := if is_single { 2 } else { 0 }
                wrap := if is_single { 1 } else { 0 }

                tf := _p2d_get_text_format(mut d2d, fz, fw, ha, va, wrap, style.font_mono)
                if tf != 0 {
                    ctxt := ffi_cstr(txt)
                    wlen := ffi_sext32(ffi_call6(d2d.f_mb2w, 65001, 0, ctxt, tlen, d2d.wbuf, d2d.wcap))
                    ffi_free(ctxt)
                    if wlen > 0 {
                        pad_x := if style.padding_x > 0 { style.padding_x / 2 } else { (if style.display == 2 { 2 } else { 0 }) }
                        pad_y := if is_single { 0 } else { style.padding_y / 2 }
                        tx := bx + pad_x
                        ty := by + pad_y
                        mut tw := bw - pad_x * 2
                        mut th := bh - pad_y * 2
                        if tw < 4 { tw = bw }
                        if th < 4 { th = bh }

                        tc := _p2d_apply_opacity(style.text_color, style.opacity)
                        _p2d_write_color(d2d.scratch, tc)
                        _ := ffi_call2(_p2d_vt(d2d.brush, 8), d2d.brush, d2d.scratch)
                        rc := d2d.scratch + 32
                        _p2d_write_rect(rc, tx, ty, tw, th)
                        _ := ffi_call8(_p2d_vt(d2d.rt, 27), d2d.rt, d2d.wbuf, wlen, tf, rc, d2d.brush, 6, 0)
                    }
                }
            }
        }
    }

    // 4. Recursively paint children with hardware Direct2D clip & per-container scroll offset
    fc := dom_first_child(app.tree, node_idx)
    if fc >= 0 {
        do_clip := (style.overflow_hidden or style.overflow_scroll) and bw > 0 and bh > 0
        if do_clip {
            crc := d2d.scratch + 64
            _p2d_write_rect(crc, bx, by, bw, bh)
            _ := ffi_call3(_p2d_vt(d2d.rt, 45), d2d.rt, crc, 1) // PushAxisAlignedClip (ALIASED)
        }
        own_scroll := if style.overflow_scroll { ui_node_scroll_y(app, node_idx) } else { 0 }
        child_scroll := if style.position == 2 { own_scroll } else { acc_scroll_y + own_scroll }

        mut ch := fc
        while ch >= 0 {
            _p2d_paint_node(mut d2d, app, ch, hovered_node, child_scroll, dip_h)
            ch = dom_next_sibling(app.tree, ch)
        }

        // Sleek 4px native scrollbar thumb when scrollable content overflows container
        if style.overflow_scroll and vis {
            content_h := ui_node_content_height(app, node_idx)
            if content_h > bh and bh > 20 {
                mut thumb_h := (bh * bh) / content_h
                if thumb_h < 20 { thumb_h = 20 }
                max_s := content_h - bh
                thumb_y := by + ((bh - thumb_h) * own_scroll) / max_s
                _p2d_fill_rrect(d2d, bx + bw - 6, thumb_y, 4, thumb_h, 2, 0x8871717A)
            }
        }
        if do_clip {
            _ := ffi_call1(_p2d_vt(d2d.rt, 46), d2d.rt) // PopAxisAlignedClip
        }
    }
}

// Hardware Direct2D + DirectWrite Presenter for ALL `std::ui` HTML5/CSS3/Tailwind/JS apps!
fn photon_d2d_present(win: GuiWindow, mut app: UiApp, mut d2d: PhotonD2D, hovered_node: i64 = -1) -> bool {
    if not win.is_open or not d2d.ok { return false }
    if not app.is_ready {
        parsed := html_parse(app.html_src) or dom_tree_new(app.html_src)
        app.tree = parsed
        app.layout = layout_compute(app.tree, app.sheet, app.width, app.height)
        app.is_ready = true
    }

    w := win.width
    h := win.height
    if w <= 0 or h <= 0 { return false }

    hdc := ffi_call1(d2d.f_gdc, win.hwnd)
    if hdc == 0 { return false }
    if not _p2d_ensure_bb(mut d2d, hdc, w, h) {
        _ := ffi_call2(d2d.f_rdc, win.hwnd, hdc)
        return false
    }

    _ := ffi_call1(_p2d_vt(d2d.rt, 48), d2d.rt) // BeginDraw
    // Default clean dark slate/obsidian backdrop (overridden by root/body CSS bg!)
    _p2d_write_color(d2d.scratch, 0xFF09090B)
    _ := ffi_call2(_p2d_vt(d2d.rt, 47), d2d.rt, d2d.scratch)

    dip_h := (h * 96) / d2d.dpi
    if app.tree.root_idx >= 0 {
        _p2d_paint_node(mut d2d, app, app.tree.root_idx, hovered_node, app.scroll_y, dip_h)
    }

    _ := ffi_call3(_p2d_vt(d2d.rt, 49), d2d.rt, 0, 0) // EndDraw

    bargs := ibuf_new(12)
    ibuf_push(bargs, hdc); ibuf_push(bargs, 0); ibuf_push(bargs, 0)
    ibuf_push(bargs, w); ibuf_push(bargs, h)
    ibuf_push(bargs, d2d.mem_dc); ibuf_push(bargs, 0); ibuf_push(bargs, 0)
    ibuf_push(bargs, 0x00CC0020)
    _ := ffi_call_arr(d2d.f_bkit, 9, bargs)
    buf_free(move bargs)

    _ := ffi_call2(d2d.f_rdc, win.hwnd, hdc)
    return true
}

fn _gui_color_to_colorref(argb: i64) -> i64 {
    r := (argb >> 16) & 0xFF
    g := (argb >> 8) & 0xFF
    b := argb & 0xFF
    return r | (g << 8) | (b << 16)
}

// Axon PhotonUI Native Engine: Automatically selects Hardware Direct2D + DirectWrite on Windows
// (razor-sharp HTML5/CSS3/Tailwind/JS, 0 blur) with GDI/SDL2 fallback.
fn gui_present_photon_ui(win: GuiWindow, mut app: UiApp) -> bool {
    if win.backend == 1 {
        mut d2d := photon_d2d_init(win)
        if d2d.ok {
            ok_p := photon_d2d_present(win, mut app, mut d2d, -1)
            photon_d2d_free(move d2d)
            return ok_p
        }
        photon_d2d_free(move d2d)
    }
    mut fonts := gui_font_cache_new()
    ok_present := gui_present_photon_ui_cached(win, mut app, mut fonts)
    gui_font_cache_free(move fonts, win.gdi32)
    return ok_present
}

fn gui_present_photon_ui_cached(win: GuiWindow, mut app: UiApp, mut fonts: GuiFontCache) -> bool {
    if not win.is_open { return false }
    if not app.is_ready {
        parsed := html_parse(app.html_src) or dom_tree_new(app.html_src)
        app.tree = parsed
        app.layout = layout_compute(app.tree, app.sheet, app.width, app.height)
        app.is_ready = true
    }

    w := app.canvas.width
    h := app.canvas.height
    if w <= 0 or h <= 0 or buf_len(app.canvas.pixels) < w * h * 4 { return false }

    if win.backend != 1 {
        canv := ui_render(mut app)
        return gui_present_canvas(win, canv)
    }

    // 1. Hardware ERMS paint all rounded cards, surfaces & borders in ~0.1 ms
    canvas_clear(app.canvas, 0xFF0F172A)
    canvas_paint_dom_boxes(app.canvas, app.tree, app.sheet, app.layout)

    // 2. Double-buffer onto GDI backbuffer + draw crisp ClearType Segoe UI typography
    f_gdc   := ffi_sym(win.user32, "GetDC")
    f_rdc   := ffi_sym(win.user32, "ReleaseDC")
    f_dtxtw := ffi_sym(win.user32, "DrawTextW")
    k32     := ffi_open_one("kernel32.dll")
    f_mb2w  := if k32 != 0 { ffi_sym(k32, "MultiByteToWideChar") } else { 0 }
    f_cdc   := ffi_sym(win.gdi32, "CreateCompatibleDC")
    f_cbm   := ffi_sym(win.gdi32, "CreateCompatibleBitmap")
    f_sel   := ffi_sym(win.gdi32, "SelectObject")
    f_delo  := ffi_sym(win.gdi32, "DeleteObject")
    f_deldc := ffi_sym(win.gdi32, "DeleteDC")
    f_sdib  := ffi_sym(win.gdi32, "StretchDIBits")
    f_bkit  := ffi_sym(win.gdi32, "BitBlt")
    f_bk    := ffi_sym(win.gdi32, "SetBkMode")
    f_tcol  := ffi_sym(win.gdi32, "SetTextColor")

    hdc := ffi_call1(f_gdc, win.hwnd)
    if hdc == 0 { return false }
    mem_dc := ffi_call1(f_cdc, hdc)
    hbm := ffi_call3(f_cbm, hdc, w, h)
    old_bm := ffi_call2(f_sel, mem_dc, hbm)

    px_ptr := unsafe { (app.canvas.pixels as i64) + 16 }
    bmi := ffi_alloc(64)
    ffi_write_u32_le(bmi, 0, 40)
    ffi_write_u32_le(bmi, 4, w)
    ffi_write_u32_le(bmi, 8, (0 - h) & 0xFFFFFFFF)
    ffi_write_u16_le(bmi, 12, 1)
    ffi_write_u16_le(bmi, 14, 32)
    ffi_write_u32_le(bmi, 16, 0)

    args := ibuf_new(16)
    ibuf_push(args, mem_dc)
    ibuf_push(args, 0); ibuf_push(args, 0); ibuf_push(args, w); ibuf_push(args, h)
    ibuf_push(args, 0); ibuf_push(args, 0); ibuf_push(args, w); ibuf_push(args, h)
    ibuf_push(args, px_ptr)
    ibuf_push(args, bmi)
    ibuf_push(args, 0)
    ibuf_push(args, 0x00CC0020)
    _ := ffi_call_arr(f_sdib, 13, args)
    buf_free(move args)
    ffi_free(bmi)

    // GDI negative logical height already tracks the window DPI, so CSS px stays
    // comparable to a browser's CSS px without double scaling.
    face := "Segoe UI"
    hfont_reg := gui_font_cache_get(mut fonts, win.gdi32, face, 14, 400)

    _ := ffi_call2(f_bk, mem_dc, 1) // TRANSPARENT
    old_font := ffi_call2(f_sel, mem_dc, hfont_reg)
    rc_box := ffi_alloc(32)

    mut i := 0
    while i < app.tree.count {
        bx := layout_get_x(app.layout, i)
        by := layout_get_y(app.layout, i)
        bw := layout_get_w(app.layout, i)
        bh := layout_get_h(app.layout, i)
        if bw > 0 and bh > 0 {
            txt := dom_get_text(app.tree, i)
            tlen := str_len(txt)
            if tlen > 0 {
                style := css_compute_node_style(app.tree, i, app.sheet)

                // CSS font-size wins; otherwise derive from semantic tag.
                mut logical := style.font_size
                if logical <= 0 { logical = 14 }
                mut weight := style.font_weight
                if weight <= 0 { weight = 400 }
                mut fh := gui_font_cache_get(mut fonts, win.gdi32, face, logical, weight)
                if fh == 0 { fh = hfont_reg }
                _ := ffi_call2(f_sel, mem_dc, fh)

                _ := ffi_call2(f_tcol, mem_dc, _gui_color_to_colorref(style.text_color))

                pad_x := if style.display == 2 { 2 } else { style.padding_x / 2 + 4 }
                pad_y := if style.display == 2 { 0 } else { style.padding_y / 2 + 2 }
                ffi_write_u32_le(rc_box, 0, bx + pad_x)
                ffi_write_u32_le(rc_box, 4, by + pad_y)
                ffi_write_u32_le(rc_box, 8, bx + bw - pad_x)
                ffi_write_u32_le(rc_box, 12, by + bh - pad_y)

                // DT_NOPREFIX (0x800) + word-break for body text; alignment from CSS
                mut dflags := 0x0810 // DT_WORDBREAK | DT_NOPREFIX
                if style.text_align == 1 { dflags = dflags | 0x0001 }        // DT_CENTER
                else if style.text_align == 2 { dflags = dflags | 0x0002 }   // DT_RIGHT
                if weight >= 600 or style.font_size > 18 or style.text_align == 1 {
                    ffi_write_u32_le(rc_box, 4, by)
                    ffi_write_u32_le(rc_box, 12, by + bh)
                    dflags = dflags | 0x0004 | 0x0020 // DT_VCENTER | DT_SINGLELINE
                }

                ctxt := ffi_cstr(txt)
                if f_dtxtw != 0 and f_mb2w != 0 {
                    wcap := tlen + 4
                    wbuf := ffi_alloc(wcap * 2 + 8)
                    wlen := ffi_sext32(ffi_call6(f_mb2w, 65001, 0, ctxt, tlen, wbuf, wcap))
                    if wlen > 0 {
                        _ := ffi_call5(f_dtxtw, mem_dc, wbuf, wlen, rc_box, dflags)
                    }
                    ffi_free(wbuf)
                }
                ffi_free(ctxt)
            }
        }
        i += 1
    }

    // 3. Atomic double-buffer BitBlt to screen (zero flicker!)
    bargs := ibuf_new(12)
    ibuf_push(bargs, hdc); ibuf_push(bargs, 0); ibuf_push(bargs, 0)
    ibuf_push(bargs, win.width); ibuf_push(bargs, win.height)
    ibuf_push(bargs, mem_dc); ibuf_push(bargs, 0); ibuf_push(bargs, 0)
    ibuf_push(bargs, 0x00CC0020)
    _ := ffi_call_arr(f_bkit, 9, bargs)
    buf_free(move bargs)

    ffi_free(rc_box)
    _ := ffi_call2(f_sel, mem_dc, old_font)
    _ := ffi_call2(f_sel, mem_dc, old_bm)
    _ := ffi_call1(f_delo, hbm)
    _ := ffi_call1(f_deldc, mem_dc)
    _ := ffi_call2(f_rdc, win.hwnd, hdc)
    return true
}

// 1-line production desktop app runner for `std::ui` (`UiApp`)
// Pure Axon Photon-D2D Engine: Hardware Direct2D + DirectWrite, 0.00% idle CPU, live resize & `:hover`!
fn gui_run_ui_app(mut app: UiApp, max_frames: i64 = 0, visible: bool = true) -> i64 {
    mut win := gui_open(app.title, app.width, app.height, visible) or return -1
    mut d2d := photon_d2d_init(win)
    mut frames := 0
    mut prev_down := false
    mut prev_hover := -1
    mut dirty := true
    mut trimmed := false

    while gui_poll_events(mut win) {
        if win.needs_redraw { dirty = true }

        dpi := if d2d.ok and d2d.dpi > 0 { d2d.dpi } else { 96 }
        dip_w := (win.width * 96) / dpi
        dip_h := (win.height * 96) / dpi
        mx := (win.mouse_x * 96) / dpi
        my := (win.mouse_y * 96) / dpi

        // Live responsive Flexbox/Grid reflow on window resize in CSS DIPs
        if dip_w > 100 and dip_h > 100 and (dip_w != app.width or dip_h != app.height) {
            app.width = dip_w
            app.height = dip_h
            if app.is_ready {
                app.layout = layout_compute(app.tree, app.sheet, app.width, app.height)
            }
            dirty = true
        }

        // Smooth per-container (or viewport) mouse-wheel scrolling
        if win.scroll_delta != 0 {
            if ui_scroll_at(mut app, mx, my, 0 - (win.scroll_delta / 3)) { dirty = true }
        }

        // Live Unicode / Vietnamese keyboard input into focused <input>/<textarea>
        if win.last_char != 0 {
            if ui_handle_char(mut app, win.last_char) { dirty = true }
        }

        // Hover-node dirty check (zero redraws when cursor moves within same element!)
        hovered := if app.is_ready { ui_hit_test(app, mx, my) } else { -1 }
        if hovered != prev_hover {
            prev_hover = hovered
            dirty = true
        }

        if win.mouse_down and not prev_down {
            _ := ui_click(mut app, mx, my)
            dirty = true
        }
        prev_down = win.mouse_down

        if not dirty and ui_patch_signals(mut app) > 0 {
            dirty = true
        }

        if dirty {
            if d2d.ok {
                _ := photon_d2d_present(win, mut app, mut d2d, hovered)
            } else {
                _ := gui_present_photon_ui(win, mut app)
            }
            dirty = false
            if not trimmed and d2d.k32 != 0 {
                f_cur := ffi_sym(d2d.k32, "GetCurrentProcess")
                f_ws  := ffi_sym(d2d.k32, "SetProcessWorkingSetSize")
                if f_cur != 0 and f_ws != 0 { _ := ffi_call3(f_ws, ffi_call0(f_cur), -1, -1) }
                trimmed = true
            }
        }

        frames += 1
        if max_frames > 0 and frames >= max_frames { break }
        if win.key_escape { break }
        if max_frames == 0 {
            gui_wait_event(win, 250)
        } else {
            sleep_ms(4)
        }
    }
    photon_d2d_free(move d2d)
    gui_close(mut win)
    return frames
}

// Native OS Unicode MessageBox (`flags`: 0 = OK, 1 = OK/Cancel, 4 = Yes/No)
fn gui_msgbox(title: str, text: str, flags: i64 = 0) -> i64 {
    u32 := ffi_open_one("user32.dll")
    k32 := ffi_open_one("kernel32.dll")
    if u32 == 0 { return 0 }
    fw := ffi_sym(u32, "MessageBoxW")
    if fw != 0 {
        wt := _gui_utf8_to_utf16(k32, title)
        wm := _gui_utf8_to_utf16(k32, text)
        r := ffi_sext32(ffi_call4(fw, 0, wm, wt, flags))
        ffi_free(wt); ffi_free(wm)
        return r
    }
    f := ffi_sym(u32, "MessageBoxA")
    ct := ffi_cstr(title); cm := ffi_cstr(text)
    r := ffi_sext32(ffi_call4(f, 0, cm, ct, flags))
    ffi_free(ct); ffi_free(cm)
    return r
}

// Native OS Unicode UTF-8 <-> UTF-16 Clipboard (Win32 `CF_UNICODETEXT = 13`)
fn gui_clipboard_set(text: str) -> bool {
    u32 := ffi_open_one("user32.dll")
    k32 := ffi_open_one("kernel32.dll")
    if u32 == 0 or k32 == 0 { return false }
    f_open := ffi_sym(u32, "OpenClipboard")
    f_emp  := ffi_sym(u32, "EmptyClipboard")
    f_set  := ffi_sym(u32, "SetClipboardData")
    f_cls  := ffi_sym(u32, "CloseClipboard")
    f_ga   := ffi_sym(k32, "GlobalAlloc")
    f_gl   := ffi_sym(k32, "GlobalLock")
    f_gu   := ffi_sym(k32, "GlobalUnlock")
    f_mb   := ffi_sym(k32, "MultiByteToWideChar")
    if (ffi_call1(f_open, 0) & 0xFFFFFFFF) == 0 { return false }
    _ := ffi_call0(f_emp)
    n := str_len(text)
    if f_mb != 0 and n > 0 {
        cs := ffi_cstr(text)
        wcap := n + 4
        hmem := ffi_call2(f_ga, 0x0042, wcap * 2) // GMEM_MOVEABLE | GMEM_ZEROINIT
        if hmem != 0 {
            p := ffi_call1(f_gl, hmem)
            if p != 0 {
                _ := ffi_call6(f_mb, 65001, 0, cs, n, p, wcap - 1)
                _ := ffi_call1(f_gu, hmem)
                _ := ffi_call2(f_set, 13, hmem) // CF_UNICODETEXT
            }
        }
        ffi_free(cs)
        _ := ffi_call0(f_cls)
        return hmem != 0
    }
    hmem := ffi_call2(f_ga, 0x0002, n + 1)
    if hmem != 0 {
        p := ffi_call1(f_gl, hmem)
        if p != 0 {
            mut i := 0
            while i < n { ffi_write_u8(p, i, str_byte(text, i)); i += 1 }
            ffi_write_u8(p, n, 0)
            _ := ffi_call1(f_gu, hmem)
            _ := ffi_call2(f_set, 1, hmem)
        }
    }
    _ := ffi_call0(f_cls)
    return hmem != 0
}

fn gui_clipboard_get() -> str {
    u32 := ffi_open_one("user32.dll")
    k32 := ffi_open_one("kernel32.dll")
    if u32 == 0 or k32 == 0 { return "" }
    f_open := ffi_sym(u32, "OpenClipboard")
    f_get  := ffi_sym(u32, "GetClipboardData")
    f_cls  := ffi_sym(u32, "CloseClipboard")
    f_gl   := ffi_sym(k32, "GlobalLock")
    f_gu   := ffi_sym(k32, "GlobalUnlock")
    f_wc   := ffi_sym(k32, "WideCharToMultiByte")
    if (ffi_call1(f_open, 0) & 0xFFFFFFFF) == 0 { return "" }
    mut out := ""
    hmem_u := ffi_call1(f_get, 13) // CF_UNICODETEXT
    if hmem_u != 0 and f_wc != 0 {
        pw := ffi_call1(f_gl, hmem_u)
        if pw != 0 {
            utf8_buf := ffi_alloc(65536)
            args := ibuf_new(8)
            ibuf_push(args, 65001); ibuf_push(args, 0); ibuf_push(args, pw); ibuf_push(args, -1)
            ibuf_push(args, utf8_buf); ibuf_push(args, 65535); ibuf_push(args, 0); ibuf_push(args, 0)
            _ := ffi_call_arr(f_wc, 8, args)
            buf_free(move args)
            out = ffi_read_cstr(utf8_buf, 65535)
            ffi_free(utf8_buf)
            _ := ffi_call1(f_gu, hmem_u)
        }
    } else {
        hmem := ffi_call1(f_get, 1) // CF_TEXT fallback
        if hmem != 0 {
            p := ffi_call1(f_gl, hmem)
            if p != 0 {
                out = ffi_read_cstr(p, 65536)
                _ := ffi_call1(f_gu, hmem)
            }
        }
    }
    _ := ffi_call0(f_cls)
    return out
}

// Native OS Open File Dialog (`comdlg32.dll` `GetOpenFileNameA`)
fn gui_file_open_dialog(title: str = "Open File") -> str {
    cd := ffi_open_one("comdlg32.dll")
    if cd == 0 { return "" }
    f_ofn := ffi_sym(cd, "GetOpenFileNameA")
    if f_ofn == 0 { return "" }
    ofn := ffi_alloc(160)   // sizeof(OPENFILENAMEA) = 152 on x64
    fbuf := ffi_alloc(1024)
    ct := ffi_cstr(title)
    ffi_write_u32_le(ofn, 0, 152)  // lStructSize
    ffi_write_i64(ofn, 6, fbuf)    // lpstrFile = offset 48 on Win64
    ffi_write_u32_le(ofn, 56, 1023) // nMaxFile = offset 56
    ffi_write_i64(ofn, 11, ct)     // lpstrTitle = offset 88
    ffi_write_u32_le(ofn, 96, 0x00081800) // Flags = offset 96 (OFN_EXPLORER | FILEMUSTEXIST | PATHMUSTEXIST)
    ok_d := (ffi_call1(f_ofn, ofn) & 0xFFFFFFFF) != 0
    mut path := ""
    if ok_d { path = ffi_read_cstr(fbuf, 1024) }
    ffi_free(ct); ffi_free(fbuf); ffi_free(ofn)
    return path
}
