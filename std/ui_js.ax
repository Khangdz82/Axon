// Axon Standard Library: Native DOM Scripting & JS Event Dispatcher (`std/ui_js.ax`)
// High-speed zero-CEF JavaScript-like reactivity: DOM manipulation, class toggling,
// reactive state store, and HTML `onclick` event dispatching.

use std::os
use std::str
use std::html
use std::collections

// 1. DOM Document Manipulation (JS-like `document.getElementById`)
fn document_get_element_by_id(tree: DomTree, id: str) -> i64 {
    return dom_find_by_id(tree, id)
}

fn document_set_inner_text(mut tree: DomTree, id: str, text: str) -> bool {
    idx := dom_find_by_id(tree, id)
    if idx < 0 { return false }
    // Security (CWE-400): cap DOM text mutation size to 65536 bytes
    safe_t := if str_len(text) > 65536 { str_slice(text, 0, 65536) } else { text }
    dom_set_text(mut tree, idx, safe_t)
    return true
}

fn document_get_inner_text(tree: DomTree, id: str) -> str {
    idx := dom_find_by_id(tree, id)
    if idx < 0 { return "" }
    return dom_get_text(tree, idx)
}

fn js_has_class_token(cls_list: str, cls_name: str) -> bool {
    tn := str_len(cls_name)
    ln := str_len(cls_list)
    if tn == 0 or ln == 0 { return false }
    mut i := 0
    while i < ln {
        while i < ln and (str_byte(cls_list, i) == 32 or str_byte(cls_list, i) == 9 or str_byte(cls_list, i) == 10 or str_byte(cls_list, i) == 13) {
            i += 1
        }
        mut j := i
        while j < ln and str_byte(cls_list, j) != 32 and str_byte(cls_list, j) != 9 and str_byte(cls_list, j) != 10 and str_byte(cls_list, j) != 13 {
            j += 1
        }
        if j - i == tn and str_eq(str_slice(cls_list, i, j), cls_name) {
            return true
        }
        i = j + 1
    }
    return false
}

fn document_add_class(mut tree: DomTree, id: str, cls_to_add: str) -> bool {
    idx := dom_find_by_id(tree, id)
    if idx < 0 { return false }
    add_clean := str_trim(cls_to_add)
    if str_len(add_clean) == 0 { return true }
    cur_cls := dom_get_class(tree, idx)
    if js_has_class_token(cur_cls, add_clean) {
        return true // Already has class
    }
    cur_trim := str_trim(cur_cls)
    new_cls := if str_len(cur_trim) == 0 { add_clean } else { cur_trim + " " + add_clean }
    dom_set_class(mut tree, idx, new_cls)
    return true
}

fn document_remove_class(mut tree: DomTree, id: str, cls_to_remove: str) -> bool {
    idx := dom_find_by_id(tree, id)
    if idx < 0 { return false }
    rem_clean := str_trim(cls_to_remove)
    if str_len(rem_clean) == 0 { return true }
    cur_cls := dom_get_class(tree, idx)
    ln := str_len(cur_cls)
    out := buf_new(ln + 4)
    mut i := 0
    mut any := false
    while i < ln {
        while i < ln and (str_byte(cur_cls, i) == 32 or str_byte(cur_cls, i) == 9 or str_byte(cur_cls, i) == 10 or str_byte(cur_cls, i) == 13) {
            i += 1
        }
        mut j := i
        while j < ln and str_byte(cur_cls, j) != 32 and str_byte(cur_cls, j) != 9 and str_byte(cur_cls, j) != 10 and str_byte(cur_cls, j) != 13 {
            j += 1
        }
        if j > i {
            tok := str_slice(cur_cls, i, j)
            if not str_eq(tok, rem_clean) {
                if any { buf_push(out, 32) }
                buf_push_str(out, tok)
                any = true
            }
        }
        i = j + 1
    }
    new_cls := buf_to_owned_str(move out)
    dom_set_class(mut tree, idx, new_cls)
    return true
}

fn document_toggle_class(mut tree: DomTree, id: str, cls_name: str) -> bool {
    idx := dom_find_by_id(tree, id)
    if idx < 0 { return false }
    cur_cls := dom_get_class(tree, idx)
    if js_has_class_token(cur_cls, str_trim(cls_name)) {
        return document_remove_class(mut tree, id, cls_name)
    } else {
        return document_add_class(mut tree, id, cls_name)
    }
}

fn document_set_style(mut tree: DomTree, id: str, style_str: str) -> bool {
    idx := dom_find_by_id(tree, id)
    if idx < 0 { return false }
    dom_set_style(mut tree, idx, style_str)
    return true
}

// 2. Reactive State Store & Script Function Registry (backed by fast FNV-1a Map)
struct JsStateStore {
    map: IntBuf
    fn_names: ByteBuf
    fn_bodies: ByteBuf
    fn_params: ByteBuf
    fn_meta: IntBuf  // 6 ints per fn: [name_off, name_len, body_off, body_len, param_off, param_len]
    fn_count: i64
    str_pool: ByteBuf
    str_meta: IntBuf // slot 0 = count; then 4 ints per entry: [khash, off, len (-1 = deleted), cap]
}

fn js_state_free(move store: JsStateStore) {
    buf_free(move store.map)
    buf_free(move store.fn_names)
    buf_free(move store.fn_bodies)
    buf_free(move store.fn_params)
    buf_free(move store.fn_meta)
    buf_free(move store.str_pool)
    buf_free(move store.str_meta)
}

fn js_state_new() -> JsStateStore {
    sm := ibuf_new(1040) // slot 0 + up to 256 string vars * 4
    ibuf_push(sm, 0)
    return JsStateStore(
        map = map_new(128),
        fn_names = buf_new(2048),
        fn_bodies = buf_new(32768),
        fn_params = buf_new(1024),
        fn_meta = ibuf_new(768),
        fn_count = 0,
        str_pool = buf_new(32768),
        str_meta = sm
    )
}

fn js_register_fn_params(mut store: JsStateStore, name: str, params: str, body: str) {
    nl := str_len(name)
    bl := str_len(body)
    pl := str_len(params)
    if nl <= 0 or bl <= 0 or store.fn_count >= 128 { return }
    if buf_len(store.fn_names) + nl >= 2040 or buf_len(store.fn_bodies) + bl >= 32760 or buf_len(store.fn_params) + pl >= 1020 { return }
    no := buf_len(store.fn_names)
    bo := buf_len(store.fn_bodies)
    po := buf_len(store.fn_params)
    buf_push_str(store.fn_names, name)
    buf_push_str(store.fn_bodies, body)
    if pl > 0 { buf_push_str(store.fn_params, params) }
    ibuf_push(store.fn_meta, no); ibuf_push(store.fn_meta, nl)
    ibuf_push(store.fn_meta, bo); ibuf_push(store.fn_meta, bl)
    ibuf_push(store.fn_meta, po); ibuf_push(store.fn_meta, pl)
    store.fn_count += 1
}

fn js_register_fn(mut store: JsStateStore, name: str, body: str) {
    js_register_fn_params(mut store, name, "", body)
}

fn _js_find_fn_idx(store: JsStateStore, name: str) -> i64 {
    nl := str_len(name)
    mut i := store.fn_count - 1
    while i >= 0 {
        b := i * 6
        if ibuf_get(store.fn_meta, b + 1) == nl {
            no := ibuf_get(store.fn_meta, b)
            if str_eq(buf_slice_str(store.fn_names, no, no + nl), name) {
                return i
            }
        }
        i -= 1
    }
    return -1
}

fn js_find_fn_body(store: JsStateStore, name: str) -> str {
    idx := _js_find_fn_idx(store, name)
    if idx < 0 { return "" }
    b := idx * 6
    bo := ibuf_get(store.fn_meta, b + 2)
    bl := ibuf_get(store.fn_meta, b + 3)
    return buf_slice_str(store.fn_bodies, bo, bo + bl)
}

fn js_find_fn_params(store: JsStateStore, name: str) -> str {
    idx := _js_find_fn_idx(store, name)
    if idx < 0 { return "" }
    b := idx * 6
    po := ibuf_get(store.fn_meta, b + 4)
    pl := ibuf_get(store.fn_meta, b + 5)
    if pl <= 0 { return "" }
    return buf_slice_str(store.fn_params, po, po + pl)
}

fn js_state_set_str(store: JsStateStore, key: str, val: str) {
    kh := fnv1a_64(key)
    vl := str_len(val)
    cnt := ibuf_get(store.str_meta, 0)
    mut i := 0
    while i < cnt {
        b := 1 + i * 4
        if ibuf_get(store.str_meta, b) == kh {
            old_off := ibuf_get(store.str_meta, b + 1)
            old_cap := ibuf_get(store.str_meta, b + 3)
            // Reuse existing slot in-place up to its allocated capacity (prevents pool exhaustion on shrink/grow!)
            if vl <= old_cap {
                mut k := 0
                while k < vl {
                    buf_set(store.str_pool, old_off + k, str_byte(val, k))
                    k += 1
                }
                ibuf_set(store.str_meta, b + 2, vl)
                return
            }
            if buf_len(store.str_pool) + vl >= 32700 { return }
            off := buf_len(store.str_pool)
            if vl > 0 { buf_push_str(store.str_pool, val) }
            ibuf_set(store.str_meta, b + 1, off)
            ibuf_set(store.str_meta, b + 2, vl)
            ibuf_set(store.str_meta, b + 3, vl)
            return
        }
        i += 1
    }
    if cnt >= 256 or buf_len(store.str_pool) + vl >= 32700 { return }
    off := buf_len(store.str_pool)
    if vl > 0 { buf_push_str(store.str_pool, val) }
    ibuf_push(store.str_meta, kh)
    ibuf_push(store.str_meta, off)
    ibuf_push(store.str_meta, vl)
    ibuf_push(store.str_meta, vl)
    ibuf_set(store.str_meta, 0, cnt + 1)
}

fn js_state_has_str(store: JsStateStore, key: str) -> bool {
    kh := fnv1a_64(key)
    cnt := ibuf_get(store.str_meta, 0)
    mut i := 0
    while i < cnt {
        b := 1 + i * 4
        if ibuf_get(store.str_meta, b) == kh {
            return ibuf_get(store.str_meta, b + 2) >= 0
        }
        i += 1
    }
    return false
}

fn js_state_get_str(store: JsStateStore, key: str) -> str {
    kh := fnv1a_64(key)
    cnt := ibuf_get(store.str_meta, 0)
    mut i := 0
    while i < cnt {
        b := 1 + i * 4
        if ibuf_get(store.str_meta, b) == kh {
            vl := ibuf_get(store.str_meta, b + 2)
            if vl <= 0 { return "" }
            off := ibuf_get(store.str_meta, b + 1)
            return buf_slice_str(store.str_pool, off, off + vl)
        }
        i += 1
    }
    return ""
}

fn _js_clear_str(store: JsStateStore, kh: i64) {
    cnt := ibuf_get(store.str_meta, 0)
    mut i := 0
    while i < cnt {
        b := 1 + i * 4
        if ibuf_get(store.str_meta, b) == kh {
            ibuf_set(store.str_meta, b + 2, -1)
            return
        }
        i += 1
    }
}

fn js_state_set(store: JsStateStore, key: str, val: i64) {
    k_hash := fnv1a_64(key)
    _js_clear_str(store, k_hash)
    map_put(store.map, k_hash, val)
}

fn js_state_get(store: JsStateStore, key: str, default_val: i64 = 0) -> i64 {
    k_hash := fnv1a_64(key)
    return map_get(store.map, k_hash, default_val)
}

fn js_state_inc(store: JsStateStore, key: str, step: i64 = 1) -> i64 {
    cur := js_state_get(store, key, 0)
    new_val := cur +% step
    js_state_set(store, key, new_val)
    return new_val
}

// 3. Embedded JavaScript Lexing, Expressions, Control Flow & DOM Dispatcher
fn _js_is_ws(b: i64) -> bool {
    return b == 32 or b == 9 or b == 10 or b == 13
}

fn _js_is_ident_char(b: i64) -> bool {
    return (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 95 or b == 36
}

fn _js_skip_ws_comments(s: str, pos_in: i64) -> i64 {
    n := str_len(s)
    mut p := pos_in
    while p < n {
        b := str_byte(s, p)
        if _js_is_ws(b) {
            p += 1
        } else if p + 1 < n and b == 47 and str_byte(s, p + 1) == 47 {
            nl := str_find_byte(s, 10, p + 2)
            p = if nl >= 0 { nl + 1 } else { n }
        } else if p + 1 < n and b == 47 and str_byte(s, p + 1) == 42 {
            ce := str_find(s, "*/", p + 2)
            p = if ce >= 0 { ce + 2 } else { n }
        } else {
            break
        }
    }
    return p
}

// Finds matching closing delimiter (`)` or `}`) respecting quotes, escapes, and comments
fn _js_find_matching(s: str, open_pos: i64, open_ch: i64, close_ch: i64) -> i64 {
    n := str_len(s)
    if open_pos < 0 or open_pos >= n or str_byte(s, open_pos) != open_ch { return -1 }
    mut depth := 1
    mut in_q := 0
    mut i := open_pos + 1
    while i < n and depth > 0 {
        b := str_byte(s, i)
        if in_q != 0 {
            if b == 92 and i + 1 < n { i += 2; continue }
            if b == in_q { in_q = 0 }
        } else {
            if b == 39 or b == 34 or b == 96 { in_q = b }
            else if i + 1 < n and b == 47 and str_byte(s, i + 1) == 47 {
                nl := str_find_byte(s, 10, i + 2)
                i = if nl >= 0 { nl + 1 } else { n }
                continue
            } else if i + 1 < n and b == 47 and str_byte(s, i + 1) == 42 {
                ce := str_find(s, "*/", i + 2)
                i = if ce >= 0 { ce + 2 } else { n }
                continue
            } else if b == open_ch { depth += 1 }
            else if b == close_ch {
                depth -= 1
                if depth == 0 { return i }
            }
        }
        i += 1
    }
    return -1
}

fn _js_unescape_quoted(s: str, q_start: i64, q_end: i64) -> str {
    out := buf_new(q_end - q_start + 8)
    mut i := q_start
    while i < q_end {
        b := str_byte(s, i)
        if b == 92 and i + 1 < q_end {
            nx := str_byte(s, i + 1)
            if nx == 110 { buf_push(out, 10) }
            else if nx == 116 { buf_push(out, 9) }
            else if nx == 114 { buf_push(out, 13) }
            else { buf_push(out, nx) }
            i += 2
        } else {
            buf_push(out, b)
            i += 1
        }
    }
    return buf_to_owned_str(move out)
}

fn _js_extract_quoted(s: str, start: i64) -> str {
    n := str_len(s)
    mut q1 := -1
    mut qc := 0
    mut i := start
    while i < n {
        b := str_byte(s, i)
        if b == 39 or b == 34 or b == 96 {
            q1 = i; qc = b; break
        }
        i += 1
    }
    if q1 < 0 { return "" }
    mut q2 := q1 + 1
    while q2 < n {
        b := str_byte(s, q2)
        if b == 92 and q2 + 1 < n { q2 += 2; continue }
        if b == qc { break }
        q2 += 1
    }
    if q2 >= n { return "" }
    return _js_unescape_quoted(s, q1 + 1, q2)
}

// Finds top-level binary operator (outside quotes, comments, and parens); `right_to_left` handles left-associative ops
fn _js_find_top_op(e: str, op: str, right_to_left: bool) -> i64 {
    n := str_len(e)
    ol := str_len(op)
    if ol == 0 or n < ol { return -1 }
    mut in_q := 0
    mut paren := 0
    mut found := -1
    mut i := 0
    while i <= n - ol {
        b := str_byte(e, i)
        if in_q != 0 {
            if b == 92 and i + 1 < n { i += 2; continue }
            if b == in_q { in_q = 0 }
        } else {
            if b == 39 or b == 34 or b == 96 { in_q = b }
            else if i + 1 < n and b == 47 and str_byte(e, i + 1) == 47 {
                nl := str_find_byte(e, 10, i + 2)
                i = if nl >= 0 { nl + 1 } else { n }
                continue
            } else if i + 1 < n and b == 47 and str_byte(e, i + 1) == 42 {
                ce := str_find(e, "*/", i + 2)
                i = if ce >= 0 { ce + 2 } else { n }
                continue
            } else if b == 40 { paren += 1 }
            else if b == 41 { if paren > 0 { paren -= 1 } }
            else if paren == 0 and str_eq(str_slice(e, i, i + ol), op) {
                // Avoid matching `=` inside `==`/`!=`/`<=`/`>=`, `+` inside `++`, or unary `+`/`-` after an operator
                mut ok_m := true
                if ol == 1 and (b == 61 or b == 60 or b == 62) {
                    if i + 1 < n and str_byte(e, i + 1) == 61 { ok_m = false }
                    if i > 0 and (str_byte(e, i - 1) == 61 or str_byte(e, i - 1) == 33 or str_byte(e, i - 1) == 60 or str_byte(e, i - 1) == 62) { ok_m = false }
                } else if ol == 2 and (str_eq(op, "==") or str_eq(op, "!=")) {
                    if i + 2 < n and str_byte(e, i + 2) == 61 { ok_m = false }
                    if i > 0 and str_byte(e, i - 1) == 61 { ok_m = false }
                } else if ol == 1 and (b == 43 or b == 45) {
                    if i == 0 { ok_m = false }
                    if i + 1 < n and str_byte(e, i + 1) == b { ok_m = false }
                    if i > 0 and str_byte(e, i - 1) == b { ok_m = false }
                    if ok_m {
                        mut pk := i - 1
                        while pk >= 0 and _js_is_ws(str_byte(e, pk)) { pk -= 1 }
                        if pk < 0 {
                            ok_m = false
                        } else {
                            pb := str_byte(e, pk)
                            if pb == 43 or pb == 45 or pb == 42 or pb == 47 or pb == 37 or pb == 61 or pb == 33 or pb == 60 or pb == 62 or pb == 38 or pb == 124 or pb == 40 or pb == 44 {
                                ok_m = false
                            }
                        }
                    }
                }
                if ok_m {
                    if not right_to_left { return i }
                    found = i
                }
            }
        }
        i += 1
    }
    return found
}

fn _js_strip_outer_parens(raw: str) -> str {
    mut e := str_trim(raw)
    while str_len(e) >= 2 and str_byte(e, 0) == 40 {
        m := _js_find_matching(e, 0, 40, 41)
        if m == str_len(e) - 1 {
            e = str_trim(str_slice(e, 1, m))
        } else {
            break
        }
    }
    return e
}

// Evaluates DOM read expressions (`document.getElementById('id').innerText`, `document.querySelector('.cls').value`, `.checked`, `.classList.contains('c')`, `#id.innerText`)
fn _js_try_dom_read(tree: DomTree, expr: str) -> (bool, bool, str) {
    e := str_trim(expr)
    mut idx := -1
    mut rest_pos := -1
    if str_starts_with(e, "document.getElementById(") {
        elem_id := _js_extract_quoted(e, 24)
        idx = dom_find_by_id(tree, elem_id)
        rest_pos = _js_find_matching(e, 23, 40, 41)
    } else if str_starts_with(e, "document.querySelector(") {
        sel := _js_extract_quoted(e, 23)
        idx = dom_query_selector(tree, sel)
        rest_pos = _js_find_matching(e, 22, 40, 41)
    } else if str_len(e) > 2 and str_byte(e, 0) == 35 {
        dot := str_find_byte(e, 46, 1)
        if dot > 1 {
            idx = dom_find_by_id(tree, str_slice(e, 1, dot))
            rest_pos = dot - 1
        }
    }
    if rest_pos < 0 { return (false, false, "") }
    tail := str_trim(str_slice(e, rest_pos + 1, str_len(e)))
    if str_eq(tail, ".innerText") or str_eq(tail, ".textContent") or str_eq(tail, ".value") {
        return (true, true, if idx >= 0 { dom_get_text(tree, idx) } else { "" })
    }
    if str_eq(tail, ".checked") {
        is_c := idx >= 0 and str_eq(dom_get_text(tree, idx), "1")
        return (true, false, if is_c { "1" } else { "0" })
    }
    if str_eq(tail, ".className") {
        return (true, true, if idx >= 0 { dom_get_class(tree, idx) } else { "" })
    }
    if str_starts_with(tail, ".classList.contains(") {
        cls := _js_extract_quoted(tail, 20)
        has := if idx >= 0 { js_has_class_token(dom_get_class(tree, idx), cls) } else { false }
        return (true, false, if has { "1" } else { "0" })
    }
    return (false, false, "")
}

fn _js_expr_is_string(tree: DomTree, store: JsStateStore, raw: str, depth: i64 = 0) -> bool {
    if depth >= 16 { return false }
    e := _js_strip_outer_parens(raw)
    n := str_len(e)
    if n == 0 { return false }
    b0 := str_byte(e, 0)
    if b0 == 39 or b0 == 34 or b0 == 96 { return true }
    (dom_ok, dom_is_str, _) := _js_try_dom_read(tree, e)
    if dom_ok { return dom_is_str }
    p_plus := _js_find_top_op(e, "+", true)
    if p_plus > 0 {
        return _js_expr_is_string(tree, store, str_slice(e, 0, p_plus), depth + 1) or _js_expr_is_string(tree, store, str_slice(e, p_plus + 1, n), depth + 1)
    }
    if js_state_has_str(store, e) { return true }
    return false
}

fn _js_eval_num(tree: DomTree, store: JsStateStore, raw: str, depth: i64 = 0) -> i64 {
    if depth >= 16 { return 0 }
    e := _js_strip_outer_parens(raw)
    n := str_len(e)
    if n == 0 { return 0 }
    if str_eq(e, "true") { return 1 }
    if str_eq(e, "false") or str_eq(e, "null") or str_eq(e, "undefined") { return 0 }

    // Delegate comparison & logical expressions to `_js_eval_bool` before arithmetic/unary ops
    if _js_find_top_op(e, "||", true) > 0 or _js_find_top_op(e, "&&", true) > 0 or _js_find_top_op(e, "==", false) > 0 or _js_find_top_op(e, "!=", false) > 0 or _js_find_top_op(e, "<", false) > 0 or _js_find_top_op(e, ">", false) > 0 {
        return if _js_eval_bool(tree, store, e, depth + 1) { 1 } else { 0 }
    }

    // Binary + / -
    p_add := _js_find_top_op(e, "+", true)
    p_sub := _js_find_top_op(e, "-", true)
    if p_add > 0 or p_sub > 0 {
        if p_add > p_sub {
            return _js_eval_num(tree, store, str_slice(e, 0, p_add), depth + 1) +% _js_eval_num(tree, store, str_slice(e, p_add + 1, n), depth + 1)
        } else {
            return _js_eval_num(tree, store, str_slice(e, 0, p_sub), depth + 1) -% _js_eval_num(tree, store, str_slice(e, p_sub + 1, n), depth + 1)
        }
    }
    // Binary * / %
    p_mul := _js_find_top_op(e, "*", true)
    p_div := _js_find_top_op(e, "/", true)
    p_mod := _js_find_top_op(e, "%", true)
    mut mpos := p_mul
    mut mop := 1
    if p_div > mpos { mpos = p_div; mop = 2 }
    if p_mod > mpos { mpos = p_mod; mop = 3 }
    if mpos > 0 {
        lv := _js_eval_num(tree, store, str_slice(e, 0, mpos), depth + 1)
        rv := _js_eval_num(tree, store, str_slice(e, mpos + 1, n), depth + 1)
        if mop == 1 { return lv *% rv }
        if rv == 0 or (lv == (1 << 63) and rv == -1) { return 0 }
        if mop == 2 { return lv / rv }
        return lv % rv
    }
    // Unary minus / plus / logical not
    if str_byte(e, 0) == 45 and n > 1 {
        return 0 -% _js_eval_num(tree, store, str_slice(e, 1, n), depth + 1)
    }
    if str_byte(e, 0) == 43 and n > 1 {
        return _js_eval_num(tree, store, str_slice(e, 1, n), depth + 1)
    }
    if str_byte(e, 0) == 33 and n > 1 {
        return if _js_eval_bool(tree, store, str_slice(e, 1, n), depth + 1) { 0 } else { 1 }
    }
    // `.length` property
    if str_ends_with(e, ".length") and n > 7 {
        base_s := _js_eval_str_dom(tree, store, str_slice(e, 0, n - 7), depth + 1)
        return str_len(base_s)
    }
    // DOM read
    (dom_ok, _, dom_val) := _js_try_dom_read(tree, e)
    if dom_ok {
        return parse_i64(str_trim(dom_val)) or 0
    }
    // Literal number
    b0 := str_byte(e, 0)
    if b0 >= 48 and b0 <= 57 {
        return parse_i64(e) or 0
    }
    if b0 == 39 or b0 == 34 {
        return parse_i64(_js_extract_quoted(e, 0)) or 0
    }
    if js_state_has_str(store, e) {
        return parse_i64(str_trim(js_state_get_str(store, e))) or 0
    }
    return js_state_get(store, e, 0)
}

fn _js_eval_str_dom(tree: DomTree, store: JsStateStore, raw_expr: str, depth: i64 = 0) -> str {
    if depth >= 16 { return "" }
    e := _js_strip_outer_parens(raw_expr)
    n := str_len(e)
    if n == 0 { return "" }

    // Top-level `+` (string concatenation or numeric addition)
    p_plus := _js_find_top_op(e, "+", true)
    if p_plus > 0 {
        lhs := str_slice(e, 0, p_plus)
        rhs := str_slice(e, p_plus + 1, n)
        if _js_expr_is_string(tree, store, lhs) or _js_expr_is_string(tree, store, rhs) {
            return _js_eval_str_dom(tree, store, lhs, depth + 1) + _js_eval_str_dom(tree, store, rhs, depth + 1)
        }
        v := _js_eval_num(tree, store, e, depth + 1)
        return f"{v}"
    }

    b0 := str_byte(e, 0)
    if (b0 == 39 or b0 == 34) and n >= 2 and str_byte(e, n - 1) == b0 {
        return _js_unescape_quoted(e, 1, n - 1)
    }
    // Built-in HTML escaper: `escapeHtml(expr)` for CWE-79 safe innerHTML template interpolation
    if n > 12 and str_starts_with(e, "escapeHtml(") and str_byte(e, n - 1) == 41 {
        raw_s := _js_eval_str_dom(tree, store, str_slice(e, 11, n - 1), depth + 1)
        rn := str_len(raw_s)
        if rn == 0 { return "" }
        eb := buf_new(rn * 6 + 16)
        mut ei := 0
        while ei < rn {
            ch := str_byte(raw_s, ei)
            if ch == 60 { buf_push_str(eb, "&lt;") }
            else if ch == 62 { buf_push_str(eb, "&gt;") }
            else if ch == 38 { buf_push_str(eb, "&amp;") }
            else if ch == 34 { buf_push_str(eb, "&quot;") }
            else if ch == 39 { buf_push_str(eb, "&#39;") }
            else { buf_push(eb, ch) }
            ei += 1
        }
        return buf_to_owned_str(move eb)
    }

    // JS Template Literal interpolation: `Hello ${name}, total=${a + b}`!
    if b0 == 96 and n >= 2 and str_byte(e, n - 1) == 96 {
        inner := _js_unescape_quoted(e, 1, n - 1)
        if str_find(inner, "${", 0) < 0 { return inner }
        in_len := str_len(inner)
        out := buf_new(65544)
        mut k := 0
        while k < in_len {
            if k + 2 < in_len and str_byte(inner, k) == 36 and str_byte(inner, k + 1) == 123 {
                rb := _js_find_matching(inner, k + 1, 123, 125)
                if rb > k + 1 {
                    sub_val := _js_eval_str_dom(tree, store, str_slice(inner, k + 2, rb), depth + 1)
                    if buf_len(out) + str_len(sub_val) <= 65536 {
                        buf_push_str(out, sub_val)
                    }
                    k = rb + 1
                    continue
                }
            }
            if buf_len(out) < 65536 { buf_push(out, str_byte(inner, k)) }
            k += 1
        }
        return buf_to_owned_str(move out)
    }

    (dom_ok, _, dom_val) := _js_try_dom_read(tree, e)
    if dom_ok { return dom_val }

    if str_eq(e, "true") { return "true" }
    if str_eq(e, "false") { return "false" }

    if js_state_has_str(store, e) {
        return js_state_get_str(store, e)
    }

    v := _js_eval_num(tree, store, e, depth + 1)
    return f"{v}"
}

// Backwards-compatible helper used by direct callers
fn _js_eval_str_expr(store: JsStateStore, raw_expr: str) -> str {
    empty_t := dom_tree_new("")
    res := _js_eval_str_dom(empty_t, store, raw_expr, 0)
    dom_tree_free(move empty_t)
    return res
}

fn _js_eval_bool(tree: DomTree, store: JsStateStore, raw: str, depth: i64 = 0) -> bool {
    if depth >= 16 { return false }
    e := _js_strip_outer_parens(raw)
    n := str_len(e)
    if n == 0 { return false }
    if str_eq(e, "true") { return true }
    if str_eq(e, "false") or str_eq(e, "0") or str_eq(e, "null") or str_eq(e, "undefined") { return false }

    p_or := _js_find_top_op(e, "||", true)
    if p_or > 0 {
        return _js_eval_bool(tree, store, str_slice(e, 0, p_or), depth + 1) or _js_eval_bool(tree, store, str_slice(e, p_or + 2, n), depth + 1)
    }
    p_and := _js_find_top_op(e, "&&", true)
    if p_and > 0 {
        return _js_eval_bool(tree, store, str_slice(e, 0, p_and), depth + 1) and _js_eval_bool(tree, store, str_slice(e, p_and + 2, n), depth + 1)
    }

    // Equality & relational operators (lower precedence than unary `!`!)
    p_seq := _js_find_top_op(e, "===", false)
    if p_seq > 0 {
        l := str_slice(e, 0, p_seq); r := str_slice(e, p_seq + 3, n)
        if _js_expr_is_string(tree, store, l) or _js_expr_is_string(tree, store, r) {
            return str_eq(_js_eval_str_dom(tree, store, l, depth + 1), _js_eval_str_dom(tree, store, r, depth + 1))
        }
        return _js_eval_num(tree, store, l, depth + 1) == _js_eval_num(tree, store, r, depth + 1)
    }
    p_sne := _js_find_top_op(e, "!==", false)
    if p_sne > 0 {
        l := str_slice(e, 0, p_sne); r := str_slice(e, p_sne + 3, n)
        if _js_expr_is_string(tree, store, l) or _js_expr_is_string(tree, store, r) {
            return not str_eq(_js_eval_str_dom(tree, store, l, depth + 1), _js_eval_str_dom(tree, store, r, depth + 1))
        }
        return _js_eval_num(tree, store, l, depth + 1) != _js_eval_num(tree, store, r, depth + 1)
    }
    p_eq := _js_find_top_op(e, "==", false)
    if p_eq > 0 {
        l := str_slice(e, 0, p_eq); r := str_slice(e, p_eq + 2, n)
        if _js_expr_is_string(tree, store, l) or _js_expr_is_string(tree, store, r) {
            return str_eq(_js_eval_str_dom(tree, store, l, depth + 1), _js_eval_str_dom(tree, store, r, depth + 1))
        }
        return _js_eval_num(tree, store, l, depth + 1) == _js_eval_num(tree, store, r, depth + 1)
    }
    p_ne := _js_find_top_op(e, "!=", false)
    if p_ne > 0 {
        l := str_slice(e, 0, p_ne); r := str_slice(e, p_ne + 2, n)
        if _js_expr_is_string(tree, store, l) or _js_expr_is_string(tree, store, r) {
            return not str_eq(_js_eval_str_dom(tree, store, l, depth + 1), _js_eval_str_dom(tree, store, r, depth + 1))
        }
        return _js_eval_num(tree, store, l, depth + 1) != _js_eval_num(tree, store, r, depth + 1)
    }
    p_le := _js_find_top_op(e, "<=", false)
    if p_le > 0 { return _js_eval_num(tree, store, str_slice(e, 0, p_le), depth + 1) <= _js_eval_num(tree, store, str_slice(e, p_le + 2, n), depth + 1) }
    p_ge := _js_find_top_op(e, ">=", false)
    if p_ge > 0 { return _js_eval_num(tree, store, str_slice(e, 0, p_ge), depth + 1) >= _js_eval_num(tree, store, str_slice(e, p_ge + 2, n), depth + 1) }
    p_lt := _js_find_top_op(e, "<", false)
    if p_lt > 0 { return _js_eval_num(tree, store, str_slice(e, 0, p_lt), depth + 1) < _js_eval_num(tree, store, str_slice(e, p_lt + 1, n), depth + 1) }
    p_gt := _js_find_top_op(e, ">", false)
    if p_gt > 0 { return _js_eval_num(tree, store, str_slice(e, 0, p_gt), depth + 1) > _js_eval_num(tree, store, str_slice(e, p_gt + 1, n), depth + 1) }

    // Unary logical `!` (binds tighter than `==`/`!=`/`<`/`>`)
    if str_byte(e, 0) == 33 and (n < 2 or str_byte(e, 1) != 61) {
        return not _js_eval_bool(tree, store, str_slice(e, 1, n), depth + 1)
    }

    (dom_ok, dom_is_str, dom_val) := _js_try_dom_read(tree, e)
    if dom_ok {
        if dom_is_str { return str_len(dom_val) > 0 }
        return str_eq(dom_val, "1")
    }
    if _js_expr_is_string(tree, store, e) {
        return str_len(_js_eval_str_dom(tree, store, e, depth + 1)) > 0
    }
    return _js_eval_num(tree, store, e, depth + 1) != 0
}

fn _js_is_safe_css_val(val: str) -> bool {
    n := str_len(val)
    if n > 256 { return false }
    mut i := 0
    while i < n {
        b := str_byte(val, i)
        if b == 59 or b == 123 or b == 125 or b == 10 or b == 13 or b == 0 { return false }
        i += 1
    }
    low := str_to_lower(val)
    if str_contains(low, "javascript:") or str_contains(low, "vbscript:") or str_contains(low, "expression(") or str_contains(low, "url(") {
        return false
    }
    return true
}

// Native In-Process JS <-> Axon Zero-IPC Command Bridge (16-slot FIFO inside JsStateStore, < 1 us latency!)
fn js_push_invoke(store: JsStateStore, cmd: str, arg: str) {
    if str_len(cmd) == 0 { return }
    head := js_state_get(store, "__ax_q_head", 0)
    tail := js_state_get(store, "__ax_q_tail", 0)
    if tail - head >= 16 { return } // Bounded anti-DoS queue
    slot := tail % 16
    js_state_set_str(store, f"__ax_qc_{slot}", cmd)
    js_state_set_str(store, f"__ax_qa_{slot}", arg)
    js_state_set(store, "__ax_q_tail", tail + 1)
}

fn js_has_invoke(store: JsStateStore) -> bool {
    return js_state_get(store, "__ax_q_tail", 0) > js_state_get(store, "__ax_q_head", 0)
}

fn js_peek_invoke_cmd(store: JsStateStore) -> str {
    head := js_state_get(store, "__ax_q_head", 0)
    tail := js_state_get(store, "__ax_q_tail", 0)
    if tail <= head { return "" }
    return js_state_get_str(store, f"__ax_qc_{head % 16}")
}

fn js_peek_invoke_arg(store: JsStateStore) -> str {
    head := js_state_get(store, "__ax_q_head", 0)
    tail := js_state_get(store, "__ax_q_tail", 0)
    if tail <= head { return "" }
    return js_state_get_str(store, f"__ax_qa_{head % 16}")
}

fn js_consume_invoke(store: JsStateStore) {
    head := js_state_get(store, "__ax_q_head", 0)
    tail := js_state_get(store, "__ax_q_tail", 0)
    if tail > head { js_state_set(store, "__ax_q_head", head + 1) }
}

fn document_set_inner_html_idx(mut tree: DomTree, idx: i64, html_frag: str) -> bool {
    if idx < 0 or idx >= tree.count { return false }
    safe_h := if str_len(html_frag) > 65536 { str_slice(html_frag, 0, 65536) } else { html_frag }
    dom_clear_children(mut tree, idx)
    if str_find_byte(safe_h, 60, 0) >= 0 {
        _ := dom_parse_fragment_into(mut tree, idx, safe_h)
    } else {
        dom_set_text(mut tree, idx, safe_h)
    }
    return true
}

fn document_append_inner_html_idx(mut tree: DomTree, idx: i64, html_frag: str) -> bool {
    if idx < 0 or idx >= tree.count { return false }
    safe_h := if str_len(html_frag) > 65536 { str_slice(html_frag, 0, 65536) } else { html_frag }
    if str_find_byte(safe_h, 60, 0) >= 0 {
        _ := dom_parse_fragment_into(mut tree, idx, safe_h)
    } else {
        cur_t := dom_get_text(tree, idx)
        combined := cur_t + safe_h
        dom_set_text(mut tree, idx, if str_len(combined) > 65536 { str_slice(combined, 0, 65536) } else { combined })
    }
    return true
}

fn document_set_inner_html(mut tree: DomTree, id: str, html_frag: str) -> bool {
    idx := dom_find_by_id(tree, id)
    return document_set_inner_html_idx(mut tree, idx, html_frag)
}

fn document_append_inner_html(mut tree: DomTree, id: str, html_frag: str) -> bool {
    idx := dom_find_by_id(tree, id)
    return document_append_inner_html_idx(mut tree, idx, html_frag)
}

fn _js_set_class_idx(mut tree: DomTree, idx: i64, mode: i64, cls_name: str) -> bool {
    // mode: 0=add, 1=remove, 2=toggle
    if idx < 0 or idx >= tree.count { return false }
    clean := str_trim(cls_name)
    if str_len(clean) == 0 { return true }
    cur_cls := dom_get_class(tree, idx)
    has := js_has_class_token(cur_cls, clean)
    do_add := (mode == 0) or (mode == 2 and not has)
    if do_add {
        if has { return true }
        ct := str_trim(cur_cls)
        dom_set_class(mut tree, idx, if str_len(ct) == 0 { clean } else { ct + " " + clean })
        return true
    }
    if not has { return true }
    ln := str_len(cur_cls)
    out := buf_new(ln + 4)
    mut i := 0
    mut any := false
    while i < ln {
        while i < ln and _js_is_ws(str_byte(cur_cls, i)) { i += 1 }
        mut j := i
        while j < ln and not _js_is_ws(str_byte(cur_cls, j)) { j += 1 }
        if j > i {
            tok := str_slice(cur_cls, i, j)
            if not str_eq(tok, clean) {
                if any { buf_push(out, 32) }
                buf_push_str(out, tok)
                any = true
            }
        }
        i = j + 1
    }
    dom_set_class(mut tree, idx, buf_to_owned_str(move out))
    return true
}

fn _js_apply_member_op_idx(mut tree: DomTree, store: JsStateStore, idx: i64, act: str, from_pos: i64) -> bool {
    if idx < 0 or idx >= tree.count { return false }
    mut p := from_pos
    n := str_len(act)
    if p < n and str_byte(act, p) == 41 { p += 1 }
    while p < n and _js_is_ws(str_byte(act, p)) { p += 1 }
    tail := str_slice(act, p, n)

    if str_starts_with(tail, ".remove(") {
        return dom_remove_node(mut tree, idx)
    }

    if str_starts_with(tail, ".checked") {
        eq := str_find_byte(tail, 61, 8)
        if eq >= 8 {
            bv := _js_eval_bool(tree, store, str_slice(tail, eq + 1, str_len(tail)), 0)
            dom_set_text(mut tree, idx, if bv { "1" } else { "0" })
            return true
        }
    }

    if str_starts_with(tail, ".innerHTML") {
        eq := str_find_byte(tail, 61, 0)
        if eq >= 0 {
            val := _js_eval_str_dom(tree, store, str_slice(tail, eq + 1, str_len(tail)), 0)
            if eq > 0 and str_byte(tail, eq - 1) == 43 {
                return document_append_inner_html_idx(mut tree, idx, val)
            }
            return document_set_inner_html_idx(mut tree, idx, val)
        }
    }

    if str_starts_with(tail, ".innerText") or str_starts_with(tail, ".textContent") or str_starts_with(tail, ".value") {
        eq := str_find_byte(tail, 61, 0)
        if eq >= 0 {
            val := _js_eval_str_dom(tree, store, str_slice(tail, eq + 1, str_len(tail)), 0)
            if eq > 0 and str_byte(tail, eq - 1) == 43 { // '+=' append!
                cur_t := dom_get_text(tree, idx)
                comb := cur_t + val
                dom_set_text(mut tree, idx, if str_len(comb) > 65536 { str_slice(comb, 0, 65536) } else { comb })
                return true
            }
            dom_set_text(mut tree, idx, if str_len(val) > 65536 { str_slice(val, 0, 65536) } else { val })
            return true
        }
    }

    if str_starts_with(tail, ".classList.toggle(") {
        cls := _js_extract_quoted(tail, 18)
        if str_len(cls) > 0 { return _js_set_class_idx(mut tree, idx, 2, cls) }
    }
    if str_starts_with(tail, ".classList.add(") {
        cls := _js_extract_quoted(tail, 15)
        if str_len(cls) > 0 { return _js_set_class_idx(mut tree, idx, 0, cls) }
    }
    if str_starts_with(tail, ".classList.remove(") {
        cls := _js_extract_quoted(tail, 18)
        if str_len(cls) > 0 { return _js_set_class_idx(mut tree, idx, 1, cls) }
    }

    if str_starts_with(tail, ".style.") {
        eq := str_find_byte(tail, 61, 7)
        if eq > 7 {
            raw_prop := str_trim(str_slice(tail, 7, eq))
            val := _js_eval_str_dom(tree, store, str_slice(tail, eq + 1, str_len(tail)), 0)
            if not _js_is_safe_css_val(val) { return false }
            mut css_p := raw_prop
            if str_eq(raw_prop, "backgroundColor") { css_p = "background-color" }
            else if str_eq(raw_prop, "borderColor") { css_p = "border-color" }
            else if str_eq(raw_prop, "fontSize") { css_p = "font-size" }
            else if str_eq(raw_prop, "borderRadius") { css_p = "border-radius" }
            else if str_eq(raw_prop, "fontWeight") { css_p = "font-weight" }
            else if str_eq(raw_prop, "textAlign") { css_p = "text-align" }
            else if str_eq(raw_prop, "boxShadow") { css_p = "box-shadow" }
            else if str_eq(raw_prop, "zIndex") { css_p = "z-index" }
            else if str_eq(raw_prop, "lineHeight") { css_p = "line-height" }
            else if str_eq(raw_prop, "minWidth") { css_p = "min-width" }
            else if str_eq(raw_prop, "maxWidth") { css_p = "max-width" }
            else if str_eq(raw_prop, "minHeight") { css_p = "min-height" }
            else if str_eq(raw_prop, "maxHeight") { css_p = "max-height" }
            else if str_eq(raw_prop, "backdropFilter") { css_p = "backdrop-filter" }
            if str_len(css_p) > 0 and _js_is_safe_css_val(css_p) {
                cur_s := dom_get_style(tree, idx)
                // Deduplicate existing property so repeated `.style.color = ...` never grows unboundedly!
                cn := str_len(cur_s)
                if cn == 0 {
                    dom_set_style(mut tree, idx, css_p + ": " + val)
                } else {
                    out := buf_new(cn + str_len(css_p) + str_len(val) + 16)
                    mut sp := 0
                    mut any_s := false
                    while sp < cn {
                        mut semi := str_find_byte(cur_s, 59, sp)
                        if semi < 0 { semi = cn }
                        decl := str_trim(str_slice(cur_s, sp, semi))
                        col := str_find_byte(decl, 58, 0)
                        if col > 0 {
                            dp := str_trim(str_slice(decl, 0, col))
                            if not str_eq(dp, css_p) {
                                if any_s { buf_push_str(out, "; ") }
                                buf_push_str(out, decl)
                                any_s = true
                            }
                        }
                        sp = semi + 1
                    }
                    if any_s { buf_push_str(out, "; ") }
                    buf_push_str(out, css_p)
                    buf_push_str(out, ": ")
                    buf_push_str(out, val)
                    dom_set_style(mut tree, idx, buf_to_owned_str(move out))
                }
                return true
            }
        }
    }
    return false
}

fn _js_apply_member_op(mut tree: DomTree, store: JsStateStore, elem_id: str, act: str, from_pos: i64) -> bool {
    idx := dom_find_by_id(tree, elem_id)
    return _js_apply_member_op_idx(mut tree, store, idx, act, from_pos)
}

fn _js_bind_call_args(tree: DomTree, store: JsStateStore, param_list: str, arg_list: str) {
    pn := str_len(param_list)
    an := str_len(arg_list)
    if pn == 0 { return }
    mut pi := 0
    mut ai := 0
    while pi < pn {
        mut pj := pi
        while pj < pn and str_byte(param_list, pj) != 44 { pj += 1 }
        pname := str_trim(str_slice(param_list, pi, pj))
        pi = pj + 1

        mut aj := ai
        mut in_q := 0
        mut par := 0
        while aj < an {
            b := str_byte(arg_list, aj)
            if in_q != 0 {
                if b == 92 and aj + 1 < an { aj += 2; continue }
                if b == in_q { in_q = 0 }
            } else {
                if b == 39 or b == 34 or b == 96 { in_q = b }
                else if b == 40 { par += 1 }
                else if b == 41 { if par > 0 { par -= 1 } }
                else if b == 44 and par == 0 { break }
            }
            aj += 1
        }
        aexpr := if ai < an { str_trim(str_slice(arg_list, ai, aj)) } else { "" }
        ai = aj + 1

        if str_len(pname) > 0 {
            if _js_expr_is_string(tree, store, aexpr) {
                js_state_set_str(store, pname, _js_eval_str_dom(tree, store, aexpr, 0))
            } else {
                js_state_set(store, pname, _js_eval_num(tree, store, aexpr, 0))
            }
        }
    }
}

fn _js_eval_single_fuel(mut tree: DomTree, store: JsStateStore, action_str: str, depth: i64, fuel: IntBuf) -> bool {
    if depth >= 16 or ibuf_get(fuel, 0) <= 0 { return false }
    act := str_trim(action_str)
    n := str_len(act)
    if n == 0 { return false }
    if str_starts_with(act, "//") or str_eq(act, "return") or str_starts_with(act, "return ") { return false }

    // --- Native In-Process Axon Bridge: `axon.invoke('cmd', payload)` / `window.axonInvoke('cmd', payload)` ---
    if str_starts_with(act, "axon.invoke(") or str_starts_with(act, "window.axonInvoke(") {
        base_p := if str_starts_with(act, "axon.invoke(") { 12 } else { 18 }
        rp := _js_find_matching(act, base_p - 1, 40, 41)
        if rp > base_p {
            inner := str_slice(act, base_p, rp)
            comma := _js_find_top_op(inner, ",", false)
            if comma > 0 {
                cmd_s := _js_eval_str_dom(tree, store, str_slice(inner, 0, comma), 0)
                arg_s := _js_eval_str_dom(tree, store, str_slice(inner, comma + 1, str_len(inner)), 0)
                js_push_invoke(store, cmd_s, arg_s)
            } else {
                cmd_s := _js_eval_str_dom(tree, store, inner, 0)
                js_push_invoke(store, cmd_s, "")
            }
            return true
        }
    }

    // --- Standard JS: document.getElementById('id')... or document.querySelector('sel')... ---
    if str_starts_with(act, "document.getElementById(") {
        elem_id := _js_extract_quoted(act, 24)
        rp := _js_find_matching(act, 23, 40, 41)
        if str_len(elem_id) > 0 and rp > 24 {
            return _js_apply_member_op(mut tree, store, elem_id, act, rp)
        }
    }
    if str_starts_with(act, "document.querySelectorAll(") {
        sel := _js_extract_quoted(act, 26)
        rp := _js_find_matching(act, 25, 40, 41)
        if str_len(sel) > 0 and rp > 26 {
            rest := str_trim(str_slice(act, rp + 1, n))
            if str_starts_with(rest, ".forEach(") {
                fp := _js_find_matching(rest, 8, 40, 41)
                if fp > 9 {
                    cb := str_trim(str_slice(rest, 9, fp))
                    arr_pos := str_find(cb, "=>", 0)
                    if arr_pos > 0 {
                        param_n := str_trim(str_slice(cb, 0, arr_pos))
                        body_c := str_trim(str_slice(cb, arr_pos + 2, str_len(cb)))
                        // Support `el => el.classList.add(...)` / `el => el.style.color = ...` / `el => el.remove()`
                        if str_starts_with(body_c, param_n + ".") {
                            dot_p := str_len(param_n)
                            matches := dom_query_selector_all(tree, sel)
                            mn := ibuf_len(matches)
                            mut mi := 0
                            mut any_m := false
                            while mi < mn and ibuf_get(fuel, 0) > 0 {
                                ibuf_set(fuel, 0, ibuf_get(fuel, 0) - 1)
                                if _js_apply_member_op_idx(mut tree, store, ibuf_get(matches, mi), body_c, dot_p) { any_m = true }
                                mi += 1
                            }
                            buf_free(move matches)
                            return any_m
                        }
                    }
                }
            }
        }
    }
    if str_starts_with(act, "document.querySelector(") {
        sel := _js_extract_quoted(act, 23)
        rp := _js_find_matching(act, 22, 40, 41)
        if str_len(sel) > 0 and rp > 23 {
            idx := dom_query_selector(tree, sel)
            return _js_apply_member_op_idx(mut tree, store, idx, act, rp)
        }
    }

    // --- Modern QuerySelector / jQuery shorthand: #id.innerText = '...' or #id.classList.* ---
    if str_byte(act, 0) == 35 { // '#'
        dot := str_find_byte(act, 46, 1) // '.'
        if dot > 1 {
            elem_id := str_slice(act, 1, dot)
            return _js_apply_member_op(mut tree, store, elem_id, act, dot)
        }
    }

    // --- JS Variables & Expressions: `let x = ...`, `const x = ...`, `x++`, `x--`, `x += expr`, `x -= expr`, `x = expr` ---
    mut vsrc := act
    mut is_decl := false
    if str_starts_with(vsrc, "let ") or str_starts_with(vsrc, "var ") {
        vsrc = str_trim(str_slice(vsrc, 4, str_len(vsrc)))
        is_decl = true
    } else if str_starts_with(vsrc, "const ") {
        vsrc = str_trim(str_slice(vsrc, 6, str_len(vsrc)))
        is_decl = true
    }
    vn := str_len(vsrc)
    if vn > 2 and str_ends_with(vsrc, "++") {
        vname := str_trim(str_slice(vsrc, 0, vn - 2))
        _ := js_state_inc(store, vname, 1)
        return true
    }
    if vn > 2 and str_ends_with(vsrc, "--") {
        vname := str_trim(str_slice(vsrc, 0, vn - 2))
        _ := js_state_inc(store, vname, -1)
        return true
    }
    p_peq := _js_find_top_op(vsrc, "+=", false)
    if p_peq > 0 {
        vname := str_trim(str_slice(vsrc, 0, p_peq))
        rhs_s := str_trim(str_slice(vsrc, p_peq + 2, vn))
        if js_state_has_str(store, vname) or _js_expr_is_string(tree, store, rhs_s) {
            cur_s := if js_state_has_str(store, vname) { js_state_get_str(store, vname) } else { f"{js_state_get(store, vname, 0)}" }
            js_state_set_str(store, vname, cur_s + _js_eval_str_dom(tree, store, rhs_s, 0))
        } else {
            _ := js_state_inc(store, vname, _js_eval_num(tree, store, rhs_s, 0))
        }
        return true
    }
    p_meq := _js_find_top_op(vsrc, "-=", false)
    if p_meq > 0 {
        vname := str_trim(str_slice(vsrc, 0, p_meq))
        rhs := _js_eval_num(tree, store, str_slice(vsrc, p_meq + 2, vn), 0)
        _ := js_state_inc(store, vname, 0 -% rhs)
        return true
    }
    p_eq := _js_find_top_op(vsrc, "=", false)
    if p_eq > 0 {
        lhs := str_trim(str_slice(vsrc, 0, p_eq))
        if is_decl or (str_find_byte(lhs, 40, 0) < 0 and str_find_byte(lhs, 46, 0) < 0 and str_find_byte(lhs, 58, 0) < 0) {
            rhs_s := str_trim(str_slice(vsrc, p_eq + 1, vn))
            if _js_expr_is_string(tree, store, rhs_s) {
                js_state_set_str(store, lhs, _js_eval_str_dom(tree, store, rhs_s, 0))
            } else {
                js_state_set(store, lhs, _js_eval_num(tree, store, rhs_s, 0))
            }
            return true
        }
    }

    // --- JS Function Call with Arguments (shares global anti-DoS `fuel` across recursion!) ---
    lp := str_find_byte(act, 40, 0)
    if lp > 0 and str_ends_with(act, ")") and _js_find_matching(act, lp, 40, 41) == n - 1 {
        fname := str_trim(str_slice(act, 0, lp))
        if str_find_byte(fname, 46, 0) < 0 and str_find_byte(fname, 32, 0) < 0 {
            body := js_find_fn_body(store, fname)
            if str_len(body) > 0 {
                params := js_find_fn_params(store, fname)
                args_str := str_slice(act, lp + 1, n - 1)
                _js_bind_call_args(tree, store, params, args_str)
                return _js_eval_stmts_fuel(mut tree, store, body, depth + 1, fuel)
            }
        }
    }

    // --- Declarative: toggle:id:class ---
    if str_starts_with(act, "toggle:") {
        sub := str_slice(act, 7, n)
        colon := str_find_byte(sub, 58, 0)
        if colon >= 0 {
            target_id := str_slice(sub, 0, colon)
            cls_name := str_slice(sub, colon + 1, str_len(sub))
            return document_toggle_class(mut tree, target_id, cls_name)
        } else {
            return document_toggle_class(mut tree, sub, "hidden")
        }
    }

    // --- Declarative: set_text:id:val ---
    if str_starts_with(act, "set_text:") {
        sub := str_slice(act, 9, n)
        colon := str_find_byte(sub, 58, 0)
        if colon >= 0 {
            target_id := str_slice(sub, 0, colon)
            val := str_slice(sub, colon + 1, str_len(sub))
            return document_set_inner_text(mut tree, target_id, val)
        }
    }

    // --- Declarative: increment:key:target_elem:prefix ---
    if str_starts_with(act, "increment:") {
        sub := str_slice(act, 10, n)
        colon1 := str_find_byte(sub, 58, 0)
        if colon1 >= 0 {
            key := str_slice(sub, 0, colon1)
            rem := str_slice(sub, colon1 + 1, str_len(sub))
            colon2 := str_find_byte(rem, 58, 0)
            target_id := if colon2 >= 0 { str_slice(rem, 0, colon2) } else { rem }
            prefix := if colon2 >= 0 { str_slice(rem, colon2 + 1, str_len(rem)) } else { "" }

            new_val := js_state_inc(store, key, 1)
            mut new_text := f"{new_val}"
            if str_len(prefix) > 0 {
                if str_ends_with(prefix, ":") {
                    new_text = f"{prefix} {new_val}"
                } else {
                    new_text = f"{prefix}{new_val}"
                }
            }
            return document_set_inner_text(mut tree, target_id, new_text)
        }
    }

    return false
}

fn _js_find_stmt_end(src: str, start: i64) -> i64 {
    n := str_len(src)
    mut st_end := start
    mut in_q := 0
    mut par := 0
    while st_end < n {
        b := str_byte(src, st_end)
        if in_q != 0 {
            if b == 92 and st_end + 1 < n { st_end += 2; continue }
            if b == in_q { in_q = 0 }
        } else {
            if b == 39 or b == 34 or b == 96 { in_q = b }
            else if st_end + 1 < n and b == 47 and str_byte(src, st_end + 1) == 47 {
                // Line comment terminates statement cleanly before `//` (caller advances past `\n`!)
                return st_end
            } else if st_end + 1 < n and b == 47 and str_byte(src, st_end + 1) == 42 {
                ce := str_find(src, "*/", st_end + 2)
                st_end = if ce >= 0 { ce + 2 } else { n }
                continue
            } else if b == 40 { par += 1 }
            else if b == 41 { if par > 0 { par -= 1 } }
            else if par == 0 and (b == 59 or b == 10) { return st_end }
        }
        st_end += 1
    }
    return st_end
}

fn _js_advance_after_stmt(src: str, st_end: i64) -> i64 {
    n := str_len(src)
    if st_end >= n { return n }
    if st_end + 1 < n and str_byte(src, st_end) == 47 and str_byte(src, st_end + 1) == 47 {
        nl := str_find_byte(src, 10, st_end + 2)
        return if nl >= 0 { nl + 1 } else { n }
    }
    return st_end + 1
}

// Executes a block of JS statements with full `if / else if / else`, `while`, shared anti-DoS fuel, quotes & comments
fn _js_eval_stmts_fuel(mut tree: DomTree, store: JsStateStore, action_str: str, depth: i64, fuel: IntBuf) -> bool {
    n := str_len(action_str)
    if n == 0 or depth >= 16 or ibuf_get(fuel, 0) <= 0 { return false }
    mut any_mut := false
    mut p := 0
    while p < n {
        rem_f := ibuf_get(fuel, 0)
        if rem_f <= 0 { break }
        ibuf_set(fuel, 0, rem_f - 1)
        p = _js_skip_ws_comments(action_str, p)
        if p >= n { break }

        // --- `if (cond) { ... } [else if (cond) { ... }]* [else { ... }]` ---
        if p + 2 <= n and str_eq(str_slice(action_str, p, p + 2), "if") and (p + 2 == n or not _js_is_ident_char(str_byte(action_str, p + 2))) {
            mut cur := p
            mut taken := false
            mut loop_ok := true
            while loop_ok and cur < n {
                cur = _js_skip_ws_comments(action_str, cur)
                if cur + 2 <= n and str_eq(str_slice(action_str, cur, cur + 2), "if") {
                    lp := _js_skip_ws_comments(action_str, cur + 2)
                    rp := _js_find_matching(action_str, lp, 40, 41)
                    if rp <= lp { break }
                    cond_s := str_slice(action_str, lp + 1, rp)
                    lb := _js_skip_ws_comments(action_str, rp + 1)
                    rb := _js_find_matching(action_str, lb, 123, 125)
                    if rb <= lb { break }
                    if not taken and _js_eval_bool(tree, store, cond_s, 0) {
                        if _js_eval_stmts_fuel(mut tree, store, str_slice(action_str, lb + 1, rb), depth + 1, fuel) { any_mut = true }
                        taken = true
                    }
                    cur = _js_skip_ws_comments(action_str, rb + 1)
                    if cur + 4 <= n and str_eq(str_slice(action_str, cur, cur + 4), "else") and (cur + 4 == n or not _js_is_ident_char(str_byte(action_str, cur + 4))) {
                        cur = _js_skip_ws_comments(action_str, cur + 4)
                        if cur + 2 <= n and str_eq(str_slice(action_str, cur, cur + 2), "if") and (cur + 2 == n or not _js_is_ident_char(str_byte(action_str, cur + 2))) {
                            continue
                        }
                        rb2 := _js_find_matching(action_str, cur, 123, 125)
                        if rb2 > cur {
                            if not taken {
                                if _js_eval_stmts_fuel(mut tree, store, str_slice(action_str, cur + 1, rb2), depth + 1, fuel) { any_mut = true }
                            }
                            cur = rb2 + 1
                        }
                    }
                    loop_ok = false
                } else {
                    loop_ok = false
                }
            }
            if cur > p { p = cur; continue }
        }

        // --- `for (init; cond; step) { ... }` (bounded by shared global anti-DoS `fuel`!) ---
        if p + 3 <= n and str_eq(str_slice(action_str, p, p + 3), "for") and (p + 3 == n or not _js_is_ident_char(str_byte(action_str, p + 3))) {
            lp := _js_skip_ws_comments(action_str, p + 3)
            rp := _js_find_matching(action_str, lp, 40, 41)
            lb := if rp > lp { _js_skip_ws_comments(action_str, rp + 1) } else { -1 }
            rb := if lb > rp { _js_find_matching(action_str, lb, 123, 125) } else { -1 }
            if rb > lb {
                hdr := str_slice(action_str, lp + 1, rp)
                s1 := str_find_byte(hdr, 59, 0)
                s2 := if s1 >= 0 { str_find_byte(hdr, 59, s1 + 1) } else { -1 }
                if s1 >= 0 and s2 > s1 {
                    init_s := str_trim(str_slice(hdr, 0, s1))
                    cond_s := str_trim(str_slice(hdr, s1 + 1, s2))
                    step_s := str_trim(str_slice(hdr, s2 + 1, str_len(hdr)))
                    body_s := str_slice(action_str, lb + 1, rb)
                    if str_len(init_s) > 0 { _ := _js_eval_single_fuel(mut tree, store, init_s, depth + 1, fuel) }
                    while ibuf_get(fuel, 0) > 0 and (str_len(cond_s) == 0 or _js_eval_bool(tree, store, cond_s, 0)) {
                        ibuf_set(fuel, 0, ibuf_get(fuel, 0) - 1)
                        if _js_eval_stmts_fuel(mut tree, store, body_s, depth + 1, fuel) { any_mut = true }
                        if str_len(step_s) > 0 and ibuf_get(fuel, 0) > 0 {
                            _ := _js_eval_single_fuel(mut tree, store, step_s, depth + 1, fuel)
                        }
                    }
                    p = rb + 1
                    continue
                }
            }
        }

        // --- `while (cond) { ... }` (bounded by shared global `fuel` against nested `while(1)` DoS!) ---
        if p + 5 <= n and str_eq(str_slice(action_str, p, p + 5), "while") and (p + 5 == n or not _js_is_ident_char(str_byte(action_str, p + 5))) {
            lp := _js_skip_ws_comments(action_str, p + 5)
            rp := _js_find_matching(action_str, lp, 40, 41)
            lb := if rp > lp { _js_skip_ws_comments(action_str, rp + 1) } else { -1 }
            rb := if lb > rp { _js_find_matching(action_str, lb, 123, 125) } else { -1 }
            if rb > lb {
                cond_s := str_slice(action_str, lp + 1, rp)
                body_s := str_slice(action_str, lb + 1, rb)
                while ibuf_get(fuel, 0) > 0 and _js_eval_bool(tree, store, cond_s, 0) {
                    ibuf_set(fuel, 0, ibuf_get(fuel, 0) - 1)
                    if _js_eval_stmts_fuel(mut tree, store, body_s, depth + 1, fuel) { any_mut = true }
                }
                p = rb + 1
                continue
            }
        }

        // --- Single statement up to quote-, comment-, and paren-aware `;` or `\n` ---
        st_end := _js_find_stmt_end(action_str, p)
        stmt := str_trim(str_slice(action_str, p, st_end))
        if str_eq(stmt, "return") or str_starts_with(stmt, "return ") {
            return any_mut
        }
        if str_len(stmt) > 0 {
            if _js_eval_single_fuel(mut tree, store, stmt, depth, fuel) { any_mut = true }
        }
        p = _js_advance_after_stmt(action_str, st_end)
    }
    return any_mut
}

fn _js_eval_stmts(mut tree: DomTree, store: JsStateStore, action_str: str, depth: i64) -> bool {
    fuel := ibuf_new(2)
    ibuf_push(fuel, 10000)
    res := _js_eval_stmts_fuel(mut tree, store, action_str, depth, fuel)
    buf_free(move fuel)
    return res
}

fn js_eval_action(mut tree: DomTree, store: JsStateStore, action_str: str) -> bool {
    return _js_eval_stmts(mut tree, store, action_str, 0)
}

// Parses `<script>` blocks: registers `function name(params) { ... }` (quote-aware!) and executes top-level JS statements
fn js_eval_script(mut tree: DomTree, mut store: JsStateStore, script: str) -> bool {
    n := str_len(script)
    if n == 0 { return false }
    fuel := ibuf_new(2)
    ibuf_push(fuel, 10000)
    mut any_mut := false
    mut p := 0
    while p < n and ibuf_get(fuel, 0) > 0 {
        p = _js_skip_ws_comments(script, p)
        if p >= n { break }
        if p + 9 <= n and str_eq(str_slice(script, p, p + 9), "function ") {
            lp := str_find_byte(script, 40, p + 9)
            rp := if lp > p + 9 { _js_find_matching(script, lp, 40, 41) } else { -1 }
            lb := if rp > lp { _js_skip_ws_comments(script, rp + 1) } else { -1 }
            rb := if lb > rp { _js_find_matching(script, lb, 123, 125) } else { -1 }
            if rb > lb {
                fname := str_trim(str_slice(script, p + 9, lp))
                fparams := str_trim(str_slice(script, lp + 1, rp))
                fbody := str_slice(script, lb + 1, rb)
                js_register_fn_params(mut store, fname, fparams, fbody)
                p = rb + 1
                continue
            }
        }
        // Top-level `if`, `for`, or `while` block or single statement
        mut kw_len := 0
        if p + 2 <= n and str_eq(str_slice(script, p, p + 2), "if") and (p + 2 == n or not _js_is_ident_char(str_byte(script, p + 2))) { kw_len = 2 }
        else if p + 3 <= n and str_eq(str_slice(script, p, p + 3), "for") and (p + 3 == n or not _js_is_ident_char(str_byte(script, p + 3))) { kw_len = 3 }
        else if p + 5 <= n and str_eq(str_slice(script, p, p + 5), "while") and (p + 5 == n or not _js_is_ident_char(str_byte(script, p + 5))) { kw_len = 5 }
        if kw_len > 0 {
            lp_cand := _js_skip_ws_comments(script, p + kw_len)
            lp := if lp_cand < n and str_byte(script, lp_cand) == 40 { lp_cand } else { -1 }
            rp := if lp > p { _js_find_matching(script, lp, 40, 41) } else { -1 }
            lb := if rp > lp { _js_skip_ws_comments(script, rp + 1) } else { -1 }
            mut rb := if lb > rp { _js_find_matching(script, lb, 123, 125) } else { -1 }
            if rb > lb {
                mut cur := rb + 1
                while cur < n {
                    nx := _js_skip_ws_comments(script, cur)
                    if nx + 4 <= n and str_eq(str_slice(script, nx, nx + 4), "else") and (nx + 4 == n or not _js_is_ident_char(str_byte(script, nx + 4))) {
                        nx2 := _js_skip_ws_comments(script, nx + 4)
                        if nx2 + 2 <= n and str_eq(str_slice(script, nx2, nx2 + 2), "if") {
                            lp2 := _js_skip_ws_comments(script, nx2 + 2)
                            rp2 := _js_find_matching(script, lp2, 40, 41)
                            lb2 := if rp2 > lp2 { _js_skip_ws_comments(script, rp2 + 1) } else { -1 }
                            rb2 := if lb2 > rp2 { _js_find_matching(script, lb2, 123, 125) } else { -1 }
                            if rb2 > lb2 { cur = rb2 + 1; continue }
                        } else if nx2 < n and str_byte(script, nx2) == 123 {
                            rb2 := _js_find_matching(script, nx2, 123, 125)
                            if rb2 > nx2 { cur = rb2 + 1 }
                        }
                    }
                    break
                }
                if _js_eval_stmts_fuel(mut tree, store, str_slice(script, p, cur), 0, fuel) { any_mut = true }
                p = cur
                continue
            }
        }
        st_end := _js_find_stmt_end(script, p)
        if st_end > p {
            ibuf_set(fuel, 0, ibuf_get(fuel, 0) - 1)
            if _js_eval_single_fuel(mut tree, store, str_slice(script, p, st_end), 0, fuel) {
                any_mut = true
            }
        }
        p = _js_advance_after_stmt(script, st_end)
    }
    buf_free(move fuel)
    return any_mut
}
