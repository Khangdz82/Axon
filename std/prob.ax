// Axon Standard Library — Probability Distributions, Special Functions & Exact P-Values (`std/prob.ax`)
// 100% Pure Axon, Zero-CRT `libm`, Perceus 0-GC.
// Implements Lanczos `lgamma`, Lentz continued-fraction `gammainc` & `betainc`, Acklam+Halley `norm_ppf`,
// and `PDF`/`PMF`/`CDF`/`PPF` + Marsaglia-Tsang/Box-Muller `ProbRng` sampling for 8 core distributions.

use std::numeric

struct ProbRng {
    state: i64
    inc: i64
}

// ============================================================================
// 1. Special Mathematical Functions (`lgamma`, `tgamma`, `beta`, `erf`, `gammainc`, `betainc`)
// ============================================================================

// Lanczos approximation (`g = 7`, `n = 9`) for `ln(Gamma(z))` (`z > 0`), accurate to `< 2e-15`.
fn prob_lgamma(z: f64) -> f64 {
    if z <= 0.0 { return 0.0 }
    if z < 0.5 {
        // Euler reflection: Gamma(z) * Gamma(1 - z) = pi / sin(pi * z)
        sp := num_sin(num_pi() * z)
        if num_abs(sp) <= num_pow2_int(-996) { return 709.0 }
        return num_ln(num_pi() / num_abs(sp)) - prob_lgamma(1.0 - z)
    }
    zm1 := z - 1.0
    mut x := 0.99999999999980993
    x += 676.5203681218851 / (zm1 + 1.0)
    x -= 1259.1392167224028 / (zm1 + 2.0)
    x += 771.32342877765313 / (zm1 + 3.0)
    x -= 176.61502916214059 / (zm1 + 4.0)
    x += 12.507343278686905 / (zm1 + 5.0)
    x -= 0.13857109526572012 / (zm1 + 6.0)
    x += 0.0000099843695780195716 / (zm1 + 7.0)
    x += 0.00000015056327351493116 / (zm1 + 8.0)
    t := zm1 + 7.5
    // 0.5 * ln(2 * pi) = 0.91893853320467274178
    return 0.91893853320467274178 + (zm1 + 0.5) * num_ln(t) - t + num_ln(x)
}

fn prob_tgamma(z: f64) -> f64 {
    if z <= 0.0 {
        zi := num_round(z)
        if num_abs(z - zi) <= 0.00000000000001 { return 0.0 }
        sp := num_sin(num_pi() * z)
        return num_pi() / (sp * prob_tgamma(1.0 - z))
    }
    return num_exp(prob_lgamma(z))
}

fn prob_lbeta(a: f64, b: f64) -> f64 {
    if a <= 0.0 or b <= 0.0 { return 0.0 }
    return prob_lgamma(a) + prob_lgamma(b) - prob_lgamma(a + b)
}

fn prob_beta(a: f64, b: f64) -> f64 {
    if a <= 0.0 or b <= 0.0 { return 0.0 }
    return num_exp(prob_lbeta(a, b))
}

fn prob_gammainc_series(a: f64, x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    mut ap := a
    mut term := 1.0 / a
    mut sum := term
    mut n := 0
    while n < 256 {
        ap += 1.0
        term = term * x / ap
        sum += term
        if num_abs(term) < num_abs(sum) * 0.000000000000001 { break }
        n += 1
    }
    log_pref := a * num_ln(x) - x - prob_lgamma(a)
    if log_pref < -705.0 { return 0.0 }
    return sum * num_exp(log_pref)
}

fn prob_gammainc_cf(a: f64, x: f64) -> f64 {
    tiny := 0.000000000000000000000000000001
    mut b := x + 1.0 - a
    mut c := 1.0 / tiny
    mut d := 1.0 / (if num_abs(b) < tiny { tiny } else { b })
    mut h := d
    mut i := 1
    while i <= 256 {
        an := 0.0 - (i as f64) * ((i as f64) - a)
        b += 2.0
        d = an * d + b
        if num_abs(d) < tiny { d = tiny }
        c = b + an / c
        if num_abs(c) < tiny { c = tiny }
        d = 1.0 / d
        del := d * c
        h = h * del
        if num_abs(del - 1.0) < 0.000000000000001 { break }
        i += 1
    }
    log_pref := a * num_ln(x) - x - prob_lgamma(a)
    if log_pref < -705.0 { return 0.0 }
    return num_exp(log_pref) * h
}

// Regularized lower incomplete gamma `P(a, x) = (1 / Gamma(a)) * int_0^x t^(a-1) e^-t dt`
fn prob_gammainc_lower(a: f64, x: f64) -> f64 {
    if a <= 0.0 or x <= 0.0 { return 0.0 }
    if x < a + 1.0 {
        res := prob_gammainc_series(a, x)
        if res > 1.0 { return 1.0 }
        return res
    }
    q := prob_gammainc_cf(a, x)
    res := 1.0 - q
    if res < 0.0 { return 0.0 }
    if res > 1.0 { return 1.0 }
    return res
}

// Regularized upper incomplete gamma `Q(a, x) = 1 - P(a, x)` (critical for exact Chi-Square p-values!)
fn prob_gammainc_upper(a: f64, x: f64) -> f64 {
    if a <= 0.0 { return 0.0 }
    if x <= 0.0 { return 1.0 }
    if x < a + 1.0 {
        res := 1.0 - prob_gammainc_series(a, x)
        if res < 0.0 { return 0.0 }
        return res
    }
    res := prob_gammainc_cf(a, x)
    if res > 1.0 { return 1.0 }
    return res
}

fn prob_erf(x: f64) -> f64 {
    if x == 0.0 { return 0.0 }
    val := prob_gammainc_lower(0.5, x * x)
    if x < 0.0 { return 0.0 - val }
    return val
}

fn prob_erfc(x: f64) -> f64 {
    if x >= 0.0 { return prob_gammainc_upper(0.5, x * x) }
    return 2.0 - prob_gammainc_upper(0.5, x * x)
}

fn prob_betainc_cf(a: f64, b: f64, x: f64) -> f64 {
    tiny := 0.000000000000000000000000000001
    qab := a + b
    qap := a + 1.0
    qam := a - 1.0
    mut c := 1.0
    mut d := 1.0 - qab * x / qap
    if num_abs(d) < tiny { d = tiny }
    d = 1.0 / d
    mut h := d
    mut m := 1
    while m <= 256 {
        mf := m as f64
        m2 := 2.0 * mf
        aa1 := mf * (b - mf) * x / ((qam + m2) * (a + m2))
        d = 1.0 + aa1 * d
        if num_abs(d) < tiny { d = tiny }
        c = 1.0 + aa1 / c
        if num_abs(c) < tiny { c = tiny }
        d = 1.0 / d
        h = h * d * c
        aa2 := (0.0 - (a + mf) * (qab + mf) * x) / ((a + m2) * (qap + m2))
        d = 1.0 + aa2 * d
        if num_abs(d) < tiny { d = tiny }
        c = 1.0 + aa2 / c
        if num_abs(c) < tiny { c = tiny }
        d = 1.0 / d
        del := d * c
        h = h * del
        if num_abs(del - 1.0) < 0.000000000000001 { break }
        m += 1
    }
    return h
}

// Regularized incomplete beta `I_x(a, b)` via modified Lentz CF (~1e-14 accuracy).
fn prob_betainc(a: f64, b: f64, x: f64) -> f64 {
    if a <= 0.0 or b <= 0.0 { return 0.0 }
    if x <= 0.0 { return 0.0 }
    if x >= 1.0 { return 1.0 }
    log_bt := prob_lgamma(a + b) - prob_lgamma(a) - prob_lgamma(b) + a * num_ln(x) + b * num_ln(1.0 - x)
    bt := if log_bt < -705.0 { 0.0 } else { num_exp(log_bt) }
    if x < (a + 1.0) / (a + b + 2.0) {
        return bt * prob_betainc_cf(a, b, x) / a
    }
    return 1.0 - bt * prob_betainc_cf(b, a, 1.0 - x) / b
}

// ============================================================================
// 2. Continuous & Discrete Distributions (`Normal`, `StudentT`, `Chi2`, `FDist`, `Gamma`, `Beta`, `Poisson`, `Binomial`)
// ============================================================================

fn norm_pdf(x: f64, mu: f64 = 0.0, sigma: f64 = 1.0) -> f64 {
    if sigma <= 0.0 { return 0.0 }
    z := (x - mu) / sigma
    // 1 / sqrt(2 * pi) = 0.39894228040143267794
    return (0.39894228040143267794 / sigma) * num_exp(-0.5 * z * z)
}

fn norm_cdf(x: f64, mu: f64 = 0.0, sigma: f64 = 1.0) -> f64 {
    if sigma <= 0.0 { return 0.0 }
    z := (x - mu) / (sigma * 1.4142135623730950488)
    if z >= 0.0 {
        return 0.5 * (1.0 + prob_erf(z))
    }
    return 0.5 * prob_erfc(0.0 - z)
}

// Peter Acklam's inverse normal quantile + 1 Halley refinement step (~1e-15 accuracy).
fn norm_ppf(p: f64, mu: f64 = 0.0, sigma: f64 = 1.0) -> f64 {
    if sigma <= 0.0 { return mu }
    if p <= 0.0 { return mu - 38.0 * sigma }
    if p >= 1.0 { return mu + 38.0 * sigma }
    if p == 0.5 { return mu }
    p_low := 0.02425
    p_high := 1.0 - p_low
    mut z := 0.0
    if p < p_low {
        q := sqrt_f64(-2.0 * num_ln(p))
        num := (((((-0.007784894002430293 * q - 0.3223964580411365) * q - 2.400758277161838) * q - 2.549732539343734) * q + 4.374664141464968) * q + 2.938163982698783)
        den := ((((0.007784695709041462 * q + 0.3224671290700398) * q + 2.445134137142996) * q + 3.754408661907416) * q + 1.0)
        z = num / den
    } else if p <= p_high {
        q := p - 0.5
        r := q * q
        num := (((((-39.69683028665376 * r + 220.9460984245205) * r - 275.9285104469687) * r + 138.3577518672690) * r - 30.66479806614716) * r + 2.506628277459239) * q
        den := (((((-54.47609879822406 * r + 161.5858368580409) * r - 155.6989798598866) * r + 66.80131188771972) * r - 13.28068155288572) * r + 1.0)
        z = num / den
    } else {
        q := sqrt_f64(-2.0 * num_ln(1.0 - p))
        num := (((((-0.007784894002430293 * q - 0.3223964580411365) * q - 2.400758277161838) * q - 2.549732539343734) * q + 4.374664141464968) * q + 2.938163982698783)
        den := ((((0.007784695709041462 * q + 0.3224671290700398) * q + 2.445134137142996) * q + 3.754408661907416) * q + 1.0)
        z = 0.0 - (num / den)
    }
    // Halley polish step
    err_v := norm_cdf(z, 0.0, 1.0) - p
    pdf_v := norm_pdf(z, 0.0, 1.0)
    if pdf_v > 0.000000000000000000000000000001 {
        u := err_v / pdf_v
        z = z - u / (1.0 + 0.5 * z * u)
    }
    return mu + sigma * z
}

fn student_t_pdf(t: f64, df: f64) -> f64 {
    if df <= 0.0 { return 0.0 }
    log_c := prob_lgamma(0.5 * (df + 1.0)) - 0.5 * num_ln(df * num_pi()) - prob_lgamma(0.5 * df)
    return num_exp(log_c - 0.5 * (df + 1.0) * num_ln(1.0 + (t * t) / df))
}

fn student_t_cdf(t: f64, df: f64) -> f64 {
    if df <= 0.0 { return 0.0 }
    if t == 0.0 { return 0.5 }
    x := df / (df + t * t)
    ib := prob_betainc(0.5 * df, 0.5, x)
    if t > 0.0 { return 1.0 - 0.5 * ib }
    return 0.5 * ib
}

fn student_t_ppf(p: f64, df: f64) -> f64 {
    if df <= 0.0 or p <= 0.0 or p >= 1.0 { return 0.0 }
    if p == 0.5 { return 0.0 }
    // Cornish-Fisher initial guess + Newton-Raphson polish
    z := norm_ppf(p, 0.0, 1.0)
    z3 := z * z * z
    mut x := z + (z3 + z) / (4.0 * df)
    mut it := 0
    while it < 16 {
        fx := student_t_cdf(x, df) - p
        if num_abs(fx) < 0.0000000000001 { break }
        dfx := student_t_pdf(x, df)
        if dfx <= 0.000000000000000000000000000001 { break }
        x = x - fx / dfx
        it += 1
    }
    return x
}

fn chi2_pdf(x: f64, df: f64) -> f64 {
    if x <= 0.0 or df <= 0.0 { return 0.0 }
    k2 := 0.5 * df
    return num_exp((k2 - 1.0) * num_ln(x) - 0.5 * x - k2 * 0.6931471805599453 - prob_lgamma(k2))
}

fn chi2_cdf(x: f64, df: f64) -> f64 {
    if x <= 0.0 or df <= 0.0 { return 0.0 }
    return prob_gammainc_lower(0.5 * df, 0.5 * x)
}

fn chi2_sf(x: f64, df: f64) -> f64 {
    if df <= 0.0 { return 0.0 }
    if x <= 0.0 { return 1.0 }
    return prob_gammainc_upper(0.5 * df, 0.5 * x)
}

fn chi2_ppf(p: f64, df: f64) -> f64 {
    if df <= 0.0 or p <= 0.0 or p >= 1.0 { return 0.0 }
    // Wilson-Hilferty approximation + Newton polish
    z := norm_ppf(p, 0.0, 1.0)
    term := 1.0 - 2.0 / (9.0 * df) + z * sqrt_f64(2.0 / (9.0 * df))
    mut x := if term > 0.05 { df * term * term * term } else { 0.5 * df }
    mut it := 0
    while it < 20 {
        fx := chi2_cdf(x, df) - p
        if num_abs(fx) < 0.0000000000001 { break }
        dfx := chi2_pdf(x, df)
        if dfx <= 0.000000000000000000000000000001 { break }
        nx := x - fx / dfx
        x = if nx > 0.000000000001 { nx } else { 0.5 * x }
        it += 1
    }
    return x
}

fn fdist_pdf(x: f64, d1: f64, d2: f64) -> f64 {
    if x <= 0.0 or d1 <= 0.0 or d2 <= 0.0 { return 0.0 }
    h1 := 0.5 * d1
    h2 := 0.5 * d2
    log_num := h1 * num_ln(d1) + h2 * num_ln(d2) + (h1 - 1.0) * num_ln(x)
    log_den := (h1 + h2) * num_ln(d1 * x + d2) + prob_lbeta(h1, h2)
    return num_exp(log_num - log_den)
}

fn fdist_cdf(x: f64, d1: f64, d2: f64) -> f64 {
    if x <= 0.0 or d1 <= 0.0 or d2 <= 0.0 { return 0.0 }
    u := (d1 * x) / (d1 * x + d2)
    return prob_betainc(0.5 * d1, 0.5 * d2, u)
}

fn fdist_sf(x: f64, d1: f64, d2: f64) -> f64 {
    if d1 <= 0.0 or d2 <= 0.0 { return 0.0 }
    if x <= 0.0 { return 1.0 }
    u := d2 / (d1 * x + d2)
    return prob_betainc(0.5 * d2, 0.5 * d1, u)
}

fn gamma_pdf(x: f64, shape_k: f64, scale_theta: f64 = 1.0) -> f64 {
    if x <= 0.0 or shape_k <= 0.0 or scale_theta <= 0.0 { return 0.0 }
    return num_exp((shape_k - 1.0) * num_ln(x) - (x / scale_theta) - shape_k * num_ln(scale_theta) - prob_lgamma(shape_k))
}

fn gamma_cdf(x: f64, shape_k: f64, scale_theta: f64 = 1.0) -> f64 {
    if x <= 0.0 or shape_k <= 0.0 or scale_theta <= 0.0 { return 0.0 }
    return prob_gammainc_lower(shape_k, x / scale_theta)
}

fn beta_pdf(x: f64, a: f64, b: f64) -> f64 {
    if x <= 0.0 or x >= 1.0 or a <= 0.0 or b <= 0.0 { return 0.0 }
    return num_exp((a - 1.0) * num_ln(x) + (b - 1.0) * num_ln(1.0 - x) - prob_lbeta(a, b))
}

fn beta_cdf(x: f64, a: f64, b: f64) -> f64 {
    return prob_betainc(a, b, x)
}

fn poisson_pmf(k: i64, lam: f64) -> f64 {
    if k < 0 or lam < 0.0 { return 0.0 }
    if lam == 0.0 { return if k == 0 { 1.0 } else { 0.0 } }
    kf := k as f64
    return num_exp(kf * num_ln(lam) - lam - prob_lgamma(kf + 1.0))
}

fn poisson_cdf(k: i64, lam: f64) -> f64 {
    if k < 0 or lam < 0.0 { return 0.0 }
    if lam == 0.0 { return 1.0 }
    return prob_gammainc_upper((k + 1) as f64, lam)
}

fn binomial_pmf(k: i64, n: i64, p: f64) -> f64 {
    if k < 0 or k > n or n < 0 or p < 0.0 or p > 1.0 { return 0.0 }
    if p == 0.0 { return if k == 0 { 1.0 } else { 0.0 } }
    if p == 1.0 { return if k == n { 1.0 } else { 0.0 } }
    nf := n as f64
    kf := k as f64
    log_comb := prob_lgamma(nf + 1.0) - prob_lgamma(kf + 1.0) - prob_lgamma(nf - kf + 1.0)
    return num_exp(log_comb + kf * num_ln(p) + (nf - kf) * num_ln(1.0 - p))
}

fn binomial_cdf(k: i64, n: i64, p: f64) -> f64 {
    if k < 0 or n < 0 or p < 0.0 or p > 1.0 { return 0.0 }
    if k >= n { return 1.0 }
    if p <= 0.0 { return 1.0 }
    if p >= 1.0 { return 0.0 }
    return prob_betainc((n - k) as f64, (k + 1) as f64, 1.0 - p)
}

// ============================================================================
// 3. Deterministic Statistical PRNG (`ProbRng`: SplitMix64/PCG64-style + Samplers)
// ============================================================================

fn prob_rng_new(seed: i64) -> ProbRng {
    mut s := seed *% 6364136223846793005 +% 1442695040888963407
    if s == 0 { s = -7046029254386353131 }
    return ProbRng(s, 1442695040888963407)
}

fn prob_rng_next_i64(mut rng: ProbRng) -> i64 {
    rng.state = rng.state *% 6364136223846793005 +% rng.inc
    mut z := rng.state
    z = (z ^ ((z >> 30) & 35184372088831)) *% -4658895280553007687
    z = (z ^ ((z >> 27) & 137438953471)) *% -7723592293110705685
    z = z ^ ((z >> 31) & 4294967295)
    return z & 9007199254740991 // 53-bit positive integer in `[0, 2^53)`
}

// Uniform sample in `(0, 1)` (strictly open so `num_ln` never sees `0.0`).
fn prob_rng_uniform(mut rng: ProbRng) -> f64 {
    u53 := prob_rng_next_i64(mut rng)
    return ((u53 as f64) + 0.5) * (1.0 / 9007199254740992.0)
}

fn prob_sample_normal(mut rng: ProbRng, mu: f64 = 0.0, sigma: f64 = 1.0) -> f64 {
    u1 := prob_rng_uniform(mut rng)
    u2 := prob_rng_uniform(mut rng)
    r := sqrt_f64(-2.0 * num_ln(u1))
    z := r * num_cos(num_two_pi() * u2)
    return mu + sigma * z
}

// Marsaglia & Tsang (2000) exact Gamma sampler for all `shape_k > 0`.
fn prob_sample_gamma(mut rng: ProbRng, shape_k: f64, scale_theta: f64 = 1.0) -> f64 {
    if shape_k <= 0.0 or scale_theta <= 0.0 { return 0.0 }
    if shape_k < 1.0 {
        g1 := prob_sample_gamma(mut rng, shape_k + 1.0, 1.0)
        u := prob_rng_uniform(mut rng)
        return scale_theta * g1 * num_pow(u, 1.0 / shape_k)
    }
    d := shape_k - (1.0 / 3.0)
    c := 1.0 / sqrt_f64(9.0 * d)
    while true {
        x := prob_sample_normal(mut rng, 0.0, 1.0)
        v0 := 1.0 + c * x
        if v0 > 0.0 {
            v := v0 * v0 * v0
            u := prob_rng_uniform(mut rng)
            x2 := x * x
            if u < 1.0 - 0.0331 * x2 * x2 {
                return scale_theta * d * v
            }
            if num_ln(u) < 0.5 * x2 + d * (1.0 - v + num_ln(v)) {
                return scale_theta * d * v
            }
        }
    }
    return 0.0
}

fn prob_sample_beta(mut rng: ProbRng, a: f64, b: f64) -> f64 {
    ga := prob_sample_gamma(mut rng, a, 1.0)
    gb := prob_sample_gamma(mut rng, b, 1.0)
    if ga + gb <= 0.0 { return 0.5 }
    return ga / (ga + gb)
}

fn prob_sample_chi2(mut rng: ProbRng, df: f64) -> f64 {
    return prob_sample_gamma(mut rng, 0.5 * df, 2.0)
}

fn prob_sample_student_t(mut rng: ProbRng, df: f64) -> f64 {
    if df <= 0.0 { return 0.0 }
    z := prob_sample_normal(mut rng, 0.0, 1.0)
    v := prob_sample_chi2(mut rng, df)
    return z / sqrt_f64(v / df)
}

fn prob_sample_poisson(mut rng: ProbRng, lam: f64) -> i64 {
    if lam <= 0.0 { return 0 }
    if lam < 30.0 {
        l_bound := num_exp(0.0 - lam)
        mut k := 0
        mut p := 1.0
        while true {
            k += 1
            p = p * prob_rng_uniform(mut rng)
            if p <= l_bound { return k - 1 }
        }
    }
    // Normal approximation for large `lam >= 30`
    g := num_round(prob_sample_normal(mut rng, lam, sqrt_f64(lam))) as i64
    if g < 0 { return 0 }
    return g
}
