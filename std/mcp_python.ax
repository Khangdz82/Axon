    dvec_free(move idx.mod_pkg_idx)
    svec_free(move idx.mod_qname)
    svec_free(move idx.mod_file_path)
    dvec_free(move idx.mod_is_pkg)
    dvec_free(move idx.mod_is_stub)
    svec_free(move idx.mod_doc)
    svec_free(move idx.mod_all_csv)
    svec_free(move idx.mod_version)
    svec_free(move idx.mod_src)
    dvec_free(move idx.mod_line_count)
    smap_free(move idx.mod_qname_map)
    dvec_free(move idx.imp_mod_idx)
    svec_free(move idx.imp_module)
    svec_free(move idx.imp_symbol)
    svec_free(move idx.imp_alias)
    dvec_free(move idx.imp_line)
    dvec_free(move idx.imp_is_rel)
    dvec_free(move idx.var_mod_idx)
    dvec_free(move idx.var_cls_idx)
    svec_free(move idx.var_name)
    svec_free(move idx.var_type)
    svec_free(move idx.var_default)
    svec_free(move idx.var_doc)
    dvec_free(move idx.var_line)
    dvec_free(move idx.cls_mod_idx)
    svec_free(move idx.cls_name)
    svec_free(move idx.cls_qname)
    svec_free(move idx.cls_bases)
    svec_free(move idx.cls_decorators)
    svec_free(move idx.cls_kind)
    svec_free(move idx.cls_doc)
    dvec_free(move idx.cls_start_line)
    dvec_free(move idx.cls_end_line)
    smap_free(move idx.cls_qname_map)
    dvec_free(move idx.fn_mod_idx)
    dvec_free(move idx.fn_cls_idx)
    svec_free(move idx.fn_name)
    svec_free(move idx.fn_qname)
    svec_free(move idx.fn_sig_str)
    svec_free(move idx.fn_ret_type)
    svec_free(move idx.fn_decorators)
    dvec_free(move idx.fn_flags)
    svec_free(move idx.fn_doc)
    svec_free(move idx.fn_doc_summary)
    svec_free(move idx.fn_doc_returns)
    svec_free(move idx.fn_doc_raises)
    dvec_free(move idx.fn_start_line)
    dvec_free(move idx.fn_end_line)
    dvec_free(move idx.fn_dec_start_line)
    dvec_free(move idx.fn_param_start)
    dvec_free(move idx.fn_param_count)
    smap_free(move idx.fn_qname_map)
    svec_free(move idx.prm_name)
    svec_free(move idx.prm_type)
    svec_free(move idx.prm_default)
    dvec_free(move idx.prm_has_default)
    dvec_free(move idx.prm_kind)
    svec_free(move idx.prm_doc)
}

// ==================== 2. PYTHON LEXICAL & STRING UTILITIES ====================

fn _py_is_ident_start(b: i64) -> bool {
    return (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95
}

fn _py_is_ident_char(b: i64) -> bool {
    return _py_is_ident_start(b) or (b >= 48 and b <= 57)
}

fn _py_is_ws(b: i64) -> bool {
    return b == 32 or b == 9
}

fn _py_count_indent(s: str, start: i64, end: i64) -> i64 {
    mut col := 0
    mut i := start
    while i < end {
        b := str_byte(s, i)
        if b == 32 { col += 1; i += 1 }
        else if b == 9 { col += 4; i += 1 }
        else { break }
    }
    return col
}

fn _py_skip_ws(s: str, start: i64, end: i64) -> i64 {
    mut i := start
    while i < end and _py_is_ws(str_byte(s, i)) { i += 1 }
    return i
}

fn _py_match_kw_at(s: str, pos: i64, end: i64, kw: str) -> bool {
    kl := str_len(kw)
    if pos + kl > end { return false }
    if not str_eq(str_slice(s, pos, pos + kl), kw) { return false }
    if pos + kl < end and _py_is_ident_char(str_byte(s, pos + kl)) { return false }
    return true
}

fn _py_is_str_prefix_char(b: i64) -> bool {
    return b == 114 or b == 82 or b == 102 or b == 70 or b == 98 or b == 66 or b == 117 or b == 85
}

// Checks if `pos` starts a Python string literal (optional `r`/`f`/`b`/`u` 1-2 char prefix + quote).
// Returns `(quote_byte, is_triple, open_end_pos)` or `(0, false, pos)`.
fn _py_check_string_open(s: str, pos: i64, end: i64) -> (i64, bool, i64) {
    mut i := pos
    mut pref := 0
    while i < end and pref < 2 and _py_is_str_prefix_char(str_byte(s, i)) {
        i += 1
        pref += 1
    }
    if i >= end { return (0, false, pos) }
    q := str_byte(s, i)
    if q != 34 and q != 39 { return (0, false, pos) }
    if i + 2 < end and str_byte(s, i + 1) == q and str_byte(s, i + 2) == q {
        return (q, true, i + 3)
    }
    return (q, false, i + 1)
}

// Scans from `open_end` until closing string quote, returns `(closed_end_pos, closed_flag)`.
fn _py_scan_string_body(s: str, open_end: i64, end: i64, q: i64, is_triple: bool) -> (i64, bool) {
    mut i := open_end
    while i < end {
        b := str_byte(s, i)
        if b == 92 { // '\'
            i += 2
            continue
        }
        if b == q {
            if is_triple {
                if i + 2 < end and str_byte(s, i + 1) == q and str_byte(s, i + 2) == q {
                    return (i + 3, true)
                }
            } else {
                return (i + 1, true)
            }
        }
        i += 1
    }
    return (end, false)
}

fn _py_split_line_at(src: str, ranges: IntBuf, li: i64) -> str {
    ln := str_split_at(src, ranges, li)
    ll := str_len(ln)
    if ll > 0 and str_byte(ln, ll - 1) == 13 { return str_slice(ln, 0, ll - 1) }
    return ln
}

// Implements Python `inspect.cleandoc` algorithm on raw string body (inside quotes).
fn py_cleandoc(raw: str) -> str {
    n := str_len(raw)
    if n == 0 { return "" }
    ranges := str_split_ranges(raw, 10)
    rc := str_split_count(ranges)
    mut min_margin := 1000000
    mut li := 1
    while li < rc {
        ln := _py_split_line_at(raw, ranges, li)
        trimmed := str_trim(ln)
        if str_len(trimmed) > 0 {
            ind := _py_count_indent(ln, 0, str_len(ln))
            if ind < min_margin { min_margin = ind }
        }
        li += 1
    }
    if min_margin >= 1000000 { min_margin = 0 }

    mut out_lines := svec_new(rc + 2, n + 32)
    li = 0
    while li < rc {
        ln := _py_split_line_at(raw, ranges, li)
        if li == 0 {
            svec_push(mut out_lines, str_trim(ln))
        } else {
            mut rm := 0
            mut p := 0
            while p < str_len(ln) and rm < min_margin {
                b := str_byte(ln, p)
                if b == 32 { rm += 1; p += 1 }
                else if b == 9 { rm += 4; p += 1 }
                else { break }
            }
            svec_push(mut out_lines, str_trim_right(str_slice(ln, p, str_len(ln))))
        }
        li += 1
    }
    buf_free(move ranges)

    mut first := 0
    total := svec_len(out_lines)
    while first < total and str_len(svec_get(out_lines, first)) == 0 { first += 1 }
    mut last := total - 1
    while last >= first and str_len(svec_get(out_lines, last)) == 0 { last -= 1 }
    mut out := mbuf_new(n + 16)
    mut k := first
    while k <= last {
        if k > first { mbuf_push(mut out, 10) }
        mbuf_push_str(mut out, svec_get(out_lines, k))
        k += 1
    }
    svec_free(move out_lines)
    return mbuf_finish(move out)
}

fn _py_unquote_literal(raw_lit: str) -> str {
    t := str_trim(raw_lit)
    n := str_len(t)
    (q, is_tr, open_end) := _py_check_string_open(t, 0, n)
    if q == 0 { return t }
    qlen := if is_tr { 3 } else { 1 }
    if n < open_end + qlen { return t }
    inner := str_slice(t, open_end, n - qlen)
    return if is_tr { py_cleandoc(inner) } else { inner }
}

// Strips trailing `# comment` outside strings.
fn _py_strip_inline_comment(s: str) -> str {
    n := str_len(s)
    mut i := 0
    while i < n {
        (q, is_tr, oend) := _py_check_string_open(s, i, n)
        if q != 0 {
            (cend, _) := _py_scan_string_body(s, oend, n, q, is_tr)
            i = cend
            continue
        }
        if str_byte(s, i) == 35 { // '#'
            return str_trim_right(str_slice(s, 0, i))
        }
        i += 1
    }
    return str_trim_right(s)
}

// Splits Python parameter list by `,` at bracket depth `0`, respecting strings and unparenthesized `lambda a, b: ...` defaults.
fn _py_split_params(s: str) -> StrVec {
    mut out := svec_new(8, 256)
    n := str_len(s)
    mut i := 0
    mut start := 0
    mut depth := 0
    mut in_lambda_args := false
    while i < n {
        (q, is_tr, oend) := _py_check_string_open(s, i, n)
        if q != 0 {
            (cend, _) := _py_scan_string_body(s, oend, n, q, is_tr)
            i = cend
            continue
        }
        b := str_byte(s, i)
        if b == 40 or b == 91 or b == 123 { depth += 1 }
        else if (b == 41 or b == 93 or b == 125) and depth > 0 { depth -= 1 }
        else if depth == 0 {
            if not in_lambda_args and _py_match_kw_at(s, i, n, "lambda") and (i == 0 or not _py_is_ident_char(str_byte(s, i - 1))) {
                in_lambda_args = true
                i += 6
                continue
            }
            if in_lambda_args and b == 58 { // ':' closes lambda parameter list
                in_lambda_args = false
            } else if not in_lambda_args and b == 44 {
                item := str_trim(str_slice(s, start, i))
                if str_len(item) > 0 { svec_push(mut out, item) }
                start = i + 1
            }
        }
        i += 1
    }
    tail := str_trim(str_slice(s, start, n))
    if str_len(tail) > 0 { svec_push(mut out, tail) }
    return out
}
fn _py_split_top_level(s: str, sep_byte: i64) -> StrVec {
    mut out := svec_new(8, 256)
    n := str_len(s)
    mut i := 0
    mut start := 0
    mut depth := 0
    while i < n {
        (q, is_tr, oend) := _py_check_string_open(s, i, n)
        if q != 0 {
            (cend, _) := _py_scan_string_body(s, oend, n, q, is_tr)
            i = cend
            continue
        }
        b := str_byte(s, i)
        if b == 40 or b == 91 or b == 123 { depth += 1 }
        else if (b == 41 or b == 93 or b == 125) and depth > 0 { depth -= 1 }
        else if depth == 0 and b == sep_byte {
            item := str_trim(str_slice(s, start, i))
            if str_len(item) > 0 { svec_push(mut out, item) }
            start = i + 1
        }
        i += 1
    }
    tail := str_trim(str_slice(s, start, n))
    if str_len(tail) > 0 { svec_push(mut out, tail) }
    return out
}

// Finds first occurrence of `target_byte` at bracket depth `0` outside Python strings.
fn _py_find_top_level_byte(s: str, target_byte: i64, start_pos: i64 = 0) -> i64 {
    n := str_len(s)
    mut i := start_pos
    mut depth := 0
    while i < n {
        (q, is_tr, oend) := _py_check_string_open(s, i, n)
        if q != 0 {
            (cend, _) := _py_scan_string_body(s, oend, n, q, is_tr)
            i = cend
            continue
        }
        b := str_byte(s, i)
        if b == 40 or b == 91 or b == 123 { depth += 1 }
        else if (b == 41 or b == 93 or b == 125) and depth > 0 { depth -= 1 }
        else if depth == 0 and b == target_byte { return i }
        i += 1
    }
    return -1
}

// ==================== 3. DOCSTRING PARSER (GOOGLE / NUMPY / SPHINX) ====================

struct PyParsedDoc {
    summary: str
    returns_doc: str
    raises_doc: str
    param_docs: StrMap
}

fn _py_parsed_doc_free(move d: PyParsedDoc) {
    smap_free(move d.param_docs)
}

fn _py_google_section_kind(line: str) -> str {
    t := str_trim(line)
    if str_eq(t, "Args:") or str_eq(t, "Arguments:") or str_eq(t, "Parameters:") or str_eq(t, "Keyword Args:") or str_eq(t, "Attributes:") {
        return "args"
    }
    if str_eq(t, "Returns:") or str_eq(t, "Return:") or str_eq(t, "Yields:") {
        return "returns"
    }
    if str_eq(t, "Raises:") or str_eq(t, "Exceptions:") {
        return "raises"
    }
    if str_eq(t, "Examples:") or str_eq(t, "Example:") or str_eq(t, "Notes:") or str_eq(t, "Note:") {
        return "other"
    }
    return ""
}

fn _py_is_numpy_underline(line: str) -> bool {
    t := str_trim(line)
    n := str_len(t)
    if n < 3 { return false }
    mut i := 0
    while i < n {
        b := str_byte(t, i)
        if b != 45 and b != 61 { return false } // '-' or '='
        i += 1
    }
    return true
}

fn _py_parse_docstring(doc: str) -> PyParsedDoc {
    mut pdocs := smap_new(16)
    if str_len(doc) == 0 {
        return PyParsedDoc(summary = "", returns_doc = "", raises_doc = "", param_docs = pdocs)
    }
    ranges := str_split_ranges(doc, 10)
    rc := str_split_count(ranges)
    mut sum_b := mbuf_new(256)
    mut ret_b := mbuf_new(256)
    mut raise_b := mbuf_new(256)
    mut in_summary := true
    mut mode := "" // "", "args", "returns", "raises", "other", "np_args", "np_returns", "np_raises"
    mut cur_param := ""
    mut cur_pbuf := mbuf_new(256)
    mut arg_base_ind := -1

    mut li := 0
    while li < rc {
        raw_l := str_split_at(doc, ranges, li)
        tr := str_trim(raw_l)
        ind := _py_count_indent(raw_l, 0, str_len(raw_l))

        // Detect NumPy underline section header on next line
        if li + 1 < rc and str_len(tr) > 0 {
            next_l := str_split_at(doc, ranges, li + 1)
            if _py_is_numpy_underline(next_l) {
                if str_len(cur_param) > 0 {
                    smap_set_str(mut pdocs, cur_param, str_trim(mbuf_as_str(cur_pbuf)))
                    mbuf_free(move cur_pbuf); cur_pbuf = mbuf_new(128); cur_param = ""
                }
                in_summary = false
                arg_base_ind = -1
                if str_eq(tr, "Parameters") or str_eq(tr, "Other Parameters") or str_eq(tr, "Attributes") {
                    mode = "np_args"
                } else if str_eq(tr, "Returns") or str_eq(tr, "Yields") {
                    mode = "np_returns"
                } else if str_eq(tr, "Raises") {
                    mode = "np_raises"
                } else {
                    mode = "other"
                }
                li += 2
                continue
            }
        }

        // Detect Google section header
        gkind := _py_google_section_kind(tr)
        if str_len(gkind) > 0 and ind == 0 {
            if str_len(cur_param) > 0 {
                smap_set_str(mut pdocs, cur_param, str_trim(mbuf_as_str(cur_pbuf)))
                mbuf_free(move cur_pbuf); cur_pbuf = mbuf_new(128); cur_param = ""
            }
            in_summary = false
            mode = gkind
            arg_base_ind = -1
            li += 1
            continue
        }

        // Detect Sphinx / reST directives `:param x:`, `:returns:`, `:raises E:`
        if str_starts_with(tr, ":param ") or str_starts_with(tr, ":parameter ") or str_starts_with(tr, ":arg ") {
            in_summary = false
            col2 := str_find_byte(tr, 58, 1)
            if col2 > 1 {
                hdr := str_trim(str_slice(tr, 1, col2))
                sp := str_find_byte(hdr, 32, 0)
                if sp > 0 {
                    if str_len(cur_param) > 0 {
                        smap_set_str(mut pdocs, cur_param, str_trim(mbuf_as_str(cur_pbuf)))
                        mbuf_free(move cur_pbuf); cur_pbuf = mbuf_new(128)
                    }
                    mut pname := str_trim(str_slice(hdr, sp + 1, str_len(hdr)))
                    // Handle `:param type name:` or `:param name:`
                    sp2 := str_find_byte(pname, 32, 0)
                    if sp2 > 0 { pname = str_trim(str_slice(pname, sp2 + 1, str_len(pname))) }
                    cur_param = str_replace(pname, "*", "")
                    mode = "sphinx_arg"
                    mbuf_push_str(mut cur_pbuf, str_trim(str_slice(tr, col2 + 1, str_len(tr))))
                    li += 1
                    continue
                }
            }
        } else if str_starts_with(tr, ":return:") or str_starts_with(tr, ":returns:") {
            in_summary = false
            if str_len(cur_param) > 0 {
                smap_set_str(mut pdocs, cur_param, str_trim(mbuf_as_str(cur_pbuf)))
                mbuf_free(move cur_pbuf); cur_pbuf = mbuf_new(128); cur_param = ""
            }
            col2 := str_find_byte(tr, 58, 1)
            if mbuf_len(ret_b) > 0 { mbuf_push(mut ret_b, 32) }
            mbuf_push_str(mut ret_b, str_trim(str_slice(tr, col2 + 1, str_len(tr))))
            mode = "returns"
            li += 1
            continue
        } else if str_starts_with(tr, ":raises ") {
            in_summary = false
            if str_len(cur_param) > 0 {
                smap_set_str(mut pdocs, cur_param, str_trim(mbuf_as_str(cur_pbuf)))
                mbuf_free(move cur_pbuf); cur_pbuf = mbuf_new(128); cur_param = ""
            }
            if mbuf_len(raise_b) > 0 { mbuf_push_str(mut raise_b, "; ") }
            mbuf_push_str(mut raise_b, tr)
            mode = "raises"
            li += 1
            continue
        } else if str_starts_with(tr, ":type ") or str_starts_with(tr, ":rtype:") {
            li += 1
            continue
        }

        if in_summary {
            if str_len(tr) == 0 {
                if mbuf_len(sum_b) > 0 { in_summary = false }
            } else {
                if mbuf_len(sum_b) > 0 { mbuf_push(mut sum_b, 32) }
                mbuf_push_str(mut sum_b, tr)
            }
        } else if str_eq(mode, "args") {
            if str_len(tr) > 0 {
                if arg_base_ind < 0 { arg_base_ind = ind }
                col := str_find_byte(tr, 58, 0)
                if ind <= arg_base_ind and col > 0 {
                    if str_len(cur_param) > 0 {
                        smap_set_str(mut pdocs, cur_param, str_trim(mbuf_as_str(cur_pbuf)))
                        mbuf_free(move cur_pbuf); cur_pbuf = mbuf_new(128)
                    }
                    mut head := str_trim(str_slice(tr, 0, col))
                    paren := str_find_byte(head, 40, 0)
                    if paren > 0 { head = str_trim(str_slice(head, 0, paren)) }
                    cur_param = str_replace(head, "*", "")
                    mbuf_push_str(mut cur_pbuf, str_trim(str_slice(tr, col + 1, str_len(tr))))
                } else if str_len(cur_param) > 0 {
                    if mbuf_len(cur_pbuf) > 0 { mbuf_push(mut cur_pbuf, 32) }
                    mbuf_push_str(mut cur_pbuf, tr)
                }
            }
        } else if str_eq(mode, "np_args") {
            if str_len(tr) > 0 {
                if arg_base_ind < 0 { arg_base_ind = ind }
                col := str_find_byte(tr, 58, 0)
                if ind <= arg_base_ind and (col > 0 or _py_is_ident_start(str_byte(tr, 0))) {
                    if str_len(cur_param) > 0 {
                        smap_set_str(mut pdocs, cur_param, str_trim(mbuf_as_str(cur_pbuf)))
                        mbuf_free(move cur_pbuf); cur_pbuf = mbuf_new(128)
                    }
                    head := if col > 0 { str_trim(str_slice(tr, 0, col)) } else { tr }
                    cur_param = str_replace(head, "*", "")
                } else if str_len(cur_param) > 0 {
                    if mbuf_len(cur_pbuf) > 0 { mbuf_push(mut cur_pbuf, 32) }
                    mbuf_push_str(mut cur_pbuf, tr)
                }
            }
        } else if str_eq(mode, "sphinx_arg") and str_len(tr) > 0 and ind > 0 and str_len(cur_param) > 0 {
            if mbuf_len(cur_pbuf) > 0 { mbuf_push(mut cur_pbuf, 32) }
            mbuf_push_str(mut cur_pbuf, tr)
        } else if str_eq(mode, "returns") or str_eq(mode, "np_returns") {
            if str_len(tr) > 0 {
                if mbuf_len(ret_b) > 0 { mbuf_push(mut ret_b, 32) }
                mbuf_push_str(mut ret_b, tr)
            }
        } else if str_eq(mode, "raises") or str_eq(mode, "np_raises") {
            if str_len(tr) > 0 {
                if mbuf_len(raise_b) > 0 { mbuf_push(mut raise_b, 32) }
                mbuf_push_str(mut raise_b, tr)
            }
        }
        li += 1
    }
    if str_len(cur_param) > 0 {
        smap_set_str(mut pdocs, cur_param, str_trim(mbuf_as_str(cur_pbuf)))
    }
    mbuf_free(move cur_pbuf)
    buf_free(move ranges)
    return PyParsedDoc(
        summary = mbuf_finish(move sum_b),
        returns_doc = mbuf_finish(move ret_b),
        raises_doc = mbuf_finish(move raise_b),
        param_docs = pdocs
    )
}

// ==================== 4. PYTHON TYPE HINT -> JSON SCHEMA COMPILER ====================

fn _py_strip_outer_type_args(t: str, prefix: str) -> str {
    plen := str_len(prefix)
    tlen := str_len(t)
    if tlen > plen + 2 and str_starts_with(t, prefix) and str_byte(t, plen) == 91 and str_byte(t, tlen - 1) == 93 {
        return str_trim(str_slice(t, plen + 1, tlen - 1))
    }
    return ""
}

fn _py_strip_typing_ns(t: str) -> str {
    mut s := str_trim(t)
    if str_starts_with(s, "typing.") { s = str_slice(s, 7, str_len(s)) }
    else if str_starts_with(s, "typing_extensions.") { s = str_slice(s, 18, str_len(s)) }
    else if str_starts_with(s, "collections.abc.") { s = str_slice(s, 16, str_len(s)) }
    return str_trim(s)
}

fn _py_extract_kw_str(expr: str, kw: str) -> str {
    pat := kw + "="
    mut pos := str_find(expr, pat, 0)
    if pos < 0 {
        pat2 := kw + " ="
        pos = str_find(expr, pat2, 0)
        if pos < 0 { return "" }
        pos += str_len(pat2)
    } else {
        pos += str_len(pat)
    }
    n := str_len(expr)
    pos = _py_skip_ws(expr, pos, n);
    (q, is_tr, oend) := _py_check_string_open(expr, pos, n)
    if q == 0 { return "" }
    (cend, closed) := _py_scan_string_body(expr, oend, n, q, is_tr)
    if not closed { return "" }
    return _py_unquote_literal(str_slice(expr, pos, cend))
}

fn _py_extract_kw_num(expr: str, kw: str) -> str {
    pat := kw + "="
    mut pos := str_find(expr, pat, 0)
    if pos < 0 { return "" }
    pos += str_len(pat)
    n := str_len(expr)
    pos = _py_skip_ws(expr, pos, n)
    mut end := pos
    while end < n {
        b := str_byte(expr, end)
        if (b >= 48 and b <= 57) or b == 45 or b == 46 { end += 1 } else { break }
    }
    if end <= pos { return "" }
    return str_slice(expr, pos, end)
}

fn _py_literal_item_to_json(lit: str) -> str {
    t := str_trim(lit)
    if str_eq(t, "True") { return "true" }
    if str_eq(t, "False") { return "false" }
    if str_eq(t, "None") { return "null" }
    (q, _, _) := _py_check_string_open(t, 0, str_len(t))
    if q != 0 {
        mut mb := mbuf_new(str_len(t) + 8)
        mbuf_push_json_str(mut mb, _py_unquote_literal(t))
        return mbuf_finish(move mb)
    }
    return t
}

fn _py_find_class_by_name(idx: PyLibIndex, name: str) -> i64 {
    direct := smap_get_i64(idx.cls_qname_map, name, -1)
    if direct >= 0 { return direct }
    cnt := svec_len(idx.cls_name)
    mut i := 0
    while i < cnt {
        if str_eq(svec_get(idx.cls_name, i), name) { return i }
        i += 1
    }
    return -1
}

fn py_type_to_json_schema_indexed(idx: PyLibIndex, type_str: str, desc: str = "", default_val: str = "", has_default: bool = false, depth: i64 = 0) -> str {
    if depth > 8 { return "{}" }
    mut raw := _py_strip_typing_ns(type_str)
    if str_len(raw) >= 2 {
        (q, _, _) := _py_check_string_open(raw, 0, str_len(raw))
        if q != 0 { raw = _py_strip_typing_ns(_py_unquote_literal(raw)) }
    }

    // 1. Unwrap `Annotated[Inner, Field(description=..., ge=..., ...)]`
    ann_inner := _py_strip_outer_type_args(raw, "Annotated")
    mut extra_props := mbuf_new(128)
    mut eff_desc := desc
    mut eff_type := raw
    if str_len(ann_inner) > 0 {
        parts := _py_split_top_level(ann_inner, 44)
        if svec_len(parts) >= 1 {
            eff_type = _py_strip_typing_ns(svec_get(parts, 0))
            mut pi := 1
            while pi < svec_len(parts) {
                meta_s := svec_get(parts, pi)
                if str_len(eff_desc) == 0 {
                    fdesc := _py_extract_kw_str(meta_s, "description")
                    if str_len(fdesc) > 0 { eff_desc = fdesc }
                    else {
                        (mq, _, _) := _py_check_string_open(meta_s, 0, str_len(meta_s))
                        if mq != 0 { eff_desc = _py_unquote_literal(meta_s) }
                    }
                }
                ge_v := _py_extract_kw_num(meta_s, "ge")
                if str_len(ge_v) > 0 { mbuf_push_str(mut extra_props, f",\"minimum\":{ge_v}") }
                le_v := _py_extract_kw_num(meta_s, "le")
                if str_len(le_v) > 0 { mbuf_push_str(mut extra_props, f",\"maximum\":{le_v}") }
                gt_v := _py_extract_kw_num(meta_s, "gt")
                if str_len(gt_v) > 0 { mbuf_push_str(mut extra_props, f",\"exclusiveMinimum\":{gt_v}") }
                lt_v := _py_extract_kw_num(meta_s, "lt")
                if str_len(lt_v) > 0 { mbuf_push_str(mut extra_props, f",\"exclusiveMaximum\":{lt_v}") }
                minl := _py_extract_kw_num(meta_s, "min_length")
                if str_len(minl) > 0 { mbuf_push_str(mut extra_props, f",\"minLength\":{minl}") }
                maxl := _py_extract_kw_num(meta_s, "max_length")
                if str_len(maxl) > 0 { mbuf_push_str(mut extra_props, f",\"maxLength\":{maxl}") }
                pat := _py_extract_kw_str(meta_s, "pattern")
                if str_len(pat) > 0 {
                    mbuf_push_str(mut extra_props, ",\"pattern\":")
                    mbuf_push_json_str(mut extra_props, pat)
                }
                pi += 1
            }
        }
        svec_free(move parts)
    }

    // 2. Build base JSON Schema body (without outer `{}` closing yet if possible, or wrap safely)
    mut core := mbuf_new(256)
    mut is_open_obj := true

    // Check PEP 604 `A | B` union
    pipe_parts := _py_split_top_level(eff_type, 124)
    if svec_len(pipe_parts) > 1 {
        mbuf_push_str(mut core, "\"anyOf\":[")
        mut ui := 0
        while ui < svec_len(pipe_parts) {
            if ui > 0 { mbuf_push(mut core, 44) }
            mbuf_push_str(mut core, py_type_to_json_schema_indexed(idx, svec_get(pipe_parts, ui), "", "", false, depth + 1))
            ui += 1
        }
        mbuf_push(mut core, 93)
        svec_free(move pipe_parts)
    } else {
        svec_free(move pipe_parts)
        opt_inner := _py_strip_outer_type_args(eff_type, "Optional")
        union_inner := _py_strip_outer_type_args(eff_type, "Union")
        lit_inner := _py_strip_outer_type_args(eff_type, "Literal")
        mut list_inner := _py_strip_outer_type_args(eff_type, "list")
        if str_len(list_inner) == 0 { list_inner = _py_strip_outer_type_args(eff_type, "List") }
        if str_len(list_inner) == 0 { list_inner = _py_strip_outer_type_args(eff_type, "Sequence") }
        if str_len(list_inner) == 0 { list_inner = _py_strip_outer_type_args(eff_type, "Iterable") }
        mut set_inner := _py_strip_outer_type_args(eff_type, "set")
        if str_len(set_inner) == 0 { set_inner = _py_strip_outer_type_args(eff_type, "Set") }
        if str_len(set_inner) == 0 { set_inner = _py_strip_outer_type_args(eff_type, "frozenset") }
        mut dict_inner := _py_strip_outer_type_args(eff_type, "dict")
        if str_len(dict_inner) == 0 { dict_inner = _py_strip_outer_type_args(eff_type, "Dict") }
        if str_len(dict_inner) == 0 { dict_inner = _py_strip_outer_type_args(eff_type, "Mapping") }
        mut tup_inner := _py_strip_outer_type_args(eff_type, "tuple")
        if str_len(tup_inner) == 0 { tup_inner = _py_strip_outer_type_args(eff_type, "Tuple") }

        if str_len(opt_inner) > 0 {
            mbuf_push_str(mut core, "\"anyOf\":[")
            mbuf_push_str(mut core, py_type_to_json_schema_indexed(idx, opt_inner, "", "", false, depth + 1))
            mbuf_push_str(mut core, ",{\"type\":\"null\"}]")
        } else if str_len(union_inner) > 0 {
            uparts := _py_split_top_level(union_inner, 44)
            mbuf_push_str(mut core, "\"anyOf\":[")
            mut ui := 0
            while ui < svec_len(uparts) {
                if ui > 0 { mbuf_push(mut core, 44) }
                mbuf_push_str(mut core, py_type_to_json_schema_indexed(idx, svec_get(uparts, ui), "", "", false, depth + 1))
                ui += 1
            }
            mbuf_push(mut core, 93)
            svec_free(move uparts)
        } else if str_len(lit_inner) > 0 {
            lparts := _py_split_top_level(lit_inner, 44)
            mbuf_push_str(mut core, "\"enum\":[")
            mut li := 0
            while li < svec_len(lparts) {
                if li > 0 { mbuf_push(mut core, 44) }
                mbuf_push_str(mut core, _py_literal_item_to_json(svec_get(lparts, li)))
                li += 1
            }
            mbuf_push(mut core, 93)
            svec_free(move lparts)
        } else if str_len(list_inner) > 0 {
            mbuf_push_str(mut core, "\"type\":\"array\",\"items\":")
            mbuf_push_str(mut core, py_type_to_json_schema_indexed(idx, list_inner, "", "", false, depth + 1))
        } else if str_len(set_inner) > 0 {
            mbuf_push_str(mut core, "\"type\":\"array\",\"uniqueItems\":true,\"items\":")
            mbuf_push_str(mut core, py_type_to_json_schema_indexed(idx, set_inner, "", "", false, depth + 1))
        } else if str_len(dict_inner) > 0 {
            dparts := _py_split_top_level(dict_inner, 44)
            mbuf_push_str(mut core, "\"type\":\"object\"")
            if svec_len(dparts) >= 2 {
                mbuf_push_str(mut core, ",\"additionalProperties\":")
                mbuf_push_str(mut core, py_type_to_json_schema_indexed(idx, svec_get(dparts, 1), "", "", false, depth + 1))
            }
            svec_free(move dparts)
        } else if str_len(tup_inner) > 0 {
            tparts := _py_split_top_level(tup_inner, 44)
            tcnt := svec_len(tparts)
            if tcnt == 2 and str_eq(svec_get(tparts, 1), "...") {
                mbuf_push_str(mut core, "\"type\":\"array\",\"items\":")
                mbuf_push_str(mut core, py_type_to_json_schema_indexed(idx, svec_get(tparts, 0), "", "", false, depth + 1))
            } else {
                mbuf_push_str(mut core, "\"type\":\"array\",\"prefixItems\":[")
                mut ti := 0
                while ti < tcnt {
                    if ti > 0 { mbuf_push(mut core, 44) }
                    mbuf_push_str(mut core, py_type_to_json_schema_indexed(idx, svec_get(tparts, ti), "", "", false, depth + 1))
                    ti += 1
                }
                mbuf_push_str(mut core, f"],\"minItems\":{tcnt},\"maxItems\":{tcnt}")
            }
            svec_free(move tparts)
        } else if str_eq(eff_type, "str") {
            mbuf_push_str(mut core, "\"type\":\"string\"")
        } else if str_eq(eff_type, "int") {
            mbuf_push_str(mut core, "\"type\":\"integer\"")
        } else if str_eq(eff_type, "float") {
            mbuf_push_str(mut core, "\"type\":\"number\"")
        } else if str_eq(eff_type, "bool") {
            mbuf_push_str(mut core, "\"type\":\"boolean\"")
        } else if str_eq(eff_type, "bytes") or str_eq(eff_type, "bytearray") {
            mbuf_push_str(mut core, "\"type\":\"string\",\"format\":\"byte\"")
        } else if str_eq(eff_type, "None") or str_eq(eff_type, "NoneType") {
            mbuf_push_str(mut core, "\"type\":\"null\"")
        } else if str_eq(eff_type, "list") or str_eq(eff_type, "List") {
            mbuf_push_str(mut core, "\"type\":\"array\"")
        } else if str_eq(eff_type, "dict") or str_eq(eff_type, "Dict") {
            mbuf_push_str(mut core, "\"type\":\"object\"")
        } else if str_eq(eff_type, "Path") or str_eq(eff_type, "PurePath") or str_eq(eff_type, "pathlib.Path") {
            mbuf_push_str(mut core, "\"type\":\"string\",\"format\":\"path\"")
        } else if str_eq(eff_type, "UUID") or str_eq(eff_type, "uuid.UUID") {
            mbuf_push_str(mut core, "\"type\":\"string\",\"format\":\"uuid\"")
        } else if str_eq(eff_type, "datetime") or str_eq(eff_type, "datetime.datetime") {
            mbuf_push_str(mut core, "\"type\":\"string\",\"format\":\"date-time\"")
        } else if str_eq(eff_type, "date") or str_eq(eff_type, "datetime.date") {
            mbuf_push_str(mut core, "\"type\":\"string\",\"format\":\"date\"")
        } else if str_eq(eff_type, "Any") or str_eq(eff_type, "object") or str_len(eff_type) == 0 {
            is_open_obj = true
        } else {
            // Look up known class (`Enum`, `dataclass`, `pydantic_model`, `typed_dict`) in `idx`
            cidx := _py_find_class_by_name(idx, eff_type)
            if cidx >= 0 {
                ckind := svec_get(idx.cls_kind, cidx)
                vcnt := svec_len(idx.var_name)
                if str_eq(ckind, "enum") {
                    mbuf_push_str(mut core, "\"enum\":[")
                    mut vi := 0
                    mut ecnt := 0
                    while vi < vcnt {
                        if dvec_get(idx.var_cls_idx, vi, -1) == cidx {
                            if ecnt > 0 { mbuf_push(mut core, 44) }
                            dv := svec_get(idx.var_default, vi)
                            if str_len(dv) > 0 {
                                mbuf_push_str(mut core, _py_literal_item_to_json(dv))
                            } else {
                                mbuf_push_json_str(mut core, svec_get(idx.var_name, vi))
                            }
                            ecnt += 1
                        }
                        vi += 1
                    }
                    mbuf_push(mut core, 93)
                } else if str_eq(ckind, "dataclass") or str_eq(ckind, "pydantic_model") or str_eq(ckind, "typed_dict") {
                    mbuf_push_str(mut core, "\"type\":\"object\",\"properties\":{")
                    mut req_b := mbuf_new(128)
                    mut req_n := 0
                    mut p_n := 0
                    mut vi := 0
                    while vi < vcnt {
                        if dvec_get(idx.var_cls_idx, vi, -1) == cidx {
                            vname := svec_get(idx.var_name, vi)
                            vtype := svec_get(idx.var_type, vi)
                            vdef := svec_get(idx.var_default, vi)
                            vdoc := svec_get(idx.var_doc, vi)
                            has_d := str_len(vdef) > 0 and not str_contains(vdef, "Field(")
                            if p_n > 0 { mbuf_push(mut core, 44) }
                            mbuf_push_json_str(mut core, vname)
                            mbuf_push(mut core, 58)
                            mbuf_push_str(mut core, py_type_to_json_schema_indexed(idx, vtype, vdoc, vdef, has_d, depth + 1))
                            p_n += 1
                            if str_len(vdef) == 0 {
                                if req_n > 0 { mbuf_push(mut req_b, 44) }
                                mbuf_push_json_str(mut req_b, vname)
                                req_n += 1
                            }
                        }
                        vi += 1
                    }
                    mbuf_push(mut core, 125)
                    if req_n > 0 {
                        mbuf_push_str(mut core, ",\"required\":[")
                        mbuf_push_str(mut core, mbuf_as_str(req_b))
                        mbuf_push(mut core, 93)
                    }
                    mbuf_free(move req_b)
                } else {
                    mbuf_push_str(mut core, "\"type\":\"object\",\"title\":")
                    mbuf_push_json_str(mut core, svec_get(idx.cls_name, cidx))
                }
            } else {
                mbuf_push_str(mut core, "\"type\":\"object\"")
            }
        }
    }

    _ := is_open_obj
    mut out := mbuf_new(mbuf_len(core) + str_len(eff_desc) + mbuf_len(extra_props) + 96)
    mbuf_push(mut out, 123)
    mut has_any := false
    if mbuf_len(core) > 0 {
        mbuf_push_str(mut out, mbuf_as_str(core))
        has_any = true
    }
    if str_len(eff_desc) > 0 {
        if has_any { mbuf_push(mut out, 44) }
        mbuf_push_str(mut out, "\"description\":")
        mbuf_push_json_str(mut out, eff_desc)
        has_any = true
    }
    if has_default and str_len(default_val) > 0 {
        dv := str_trim(default_val)
        mut jdef := ""
        if str_eq(dv, "None") { jdef = "null" }
        else if str_eq(dv, "True") { jdef = "true" }
        else if str_eq(dv, "False") { jdef = "false" }
        else {
            (dq, _, _) := _py_check_string_open(dv, 0, str_len(dv))
            if dq != 0 {
                jdef = "\"" + mcp_json_escape(_py_unquote_literal(dv)) + "\""
            } else {
                _num := parse_i64(dv) or -999999999999
                if _num != -999999999999 or str_eq(dv, "0") { jdef = dv }
            }
        }
        if str_len(jdef) > 0 {
            if has_any { mbuf_push(mut out, 44) }
            mbuf_push_str(mut out, "\"default\":")
            mbuf_push_str(mut out, jdef)
            has_any = true
        }
    }
    ep := mbuf_as_str(extra_props)
    if str_len(ep) > 0 {
        if has_any {
            mbuf_push_str(mut out, ep)
        } else if str_byte(ep, 0) == 44 {
            mbuf_push_str(mut out, str_slice(ep, 1, str_len(ep)))
        }
    }
    mbuf_push(mut out, 125)
    mbuf_free(move core)
    mbuf_free(move extra_props)
    return mbuf_finish(move out)
}

fn py_type_to_json_schema(type_str: str, desc: str = "", default_val: str = "", has_default: bool = false) -> str {
    mut dummy := py_index_new()
    res := py_type_to_json_schema_indexed(dummy, type_str, desc, default_val, has_default, 0)
    py_index_free(move dummy)
    return res
}

fn py_func_to_mcp_schema(idx: PyLibIndex, fn_idx: i64) -> str {
    if fn_idx < 0 or fn_idx >= svec_len(idx.fn_name) {
        return "{\"type\":\"object\",\"properties\":{}}"
    }
    mut sc := mcp_schema_new(false)
    pstart := dvec_get(idx.fn_param_start, fn_idx, 0)
    pcnt := dvec_get(idx.fn_param_count, fn_idx, 0)
    is_m := (dvec_get(idx.fn_flags, fn_idx, 0) & py_flag_method()) != 0
    mut i := 0
    while i < pcnt {
        pi := pstart + i
        pname := svec_get(idx.prm_name, pi)
        ptype := svec_get(idx.prm_type, pi)
        pdef := svec_get(idx.prm_default, pi)
        has_def := dvec_get(idx.prm_has_default, pi, 0) != 0
        pkind := dvec_get(idx.prm_kind, pi, py_param_pos_or_kw())
        pdoc := svec_get(idx.prm_doc, pi)
        // Skip `self`, `cls`, MCP `Context` params, `*args`, `**kwargs`
        is_self := i == 0 and is_m and (str_eq(pname, "self") or str_eq(pname, "cls"))
        is_ctx := str_eq(ptype, "Context") or str_ends_with(ptype, ".Context") or str_starts_with(ptype, "Context[")
        is_var := pkind == py_param_var_pos() or pkind == py_param_var_kw()
        if not is_self and not is_ctx and not is_var {
            pschema := py_type_to_json_schema_indexed(idx, ptype, pdoc, pdef, has_def, 0)
            mcp_schema_add_prop_raw(mut sc, pname, pschema, not has_def)
        }
        i += 1
    }
    return mcp_schema_finish(move sc)
}

// ==================== 5. DEEP PYTHON SOURCE & STUB PARSER ====================

fn _py_add_package_entry(mut idx: PyLibIndex, name: str, version: str, summary: str, author: str, license_s: str, req_py: str, req_dist: str, root: str) -> i64 {
    existing := smap_get_i64(idx.pkg_map, name, -1)
    if existing >= 0 { return existing }
    pidx := svec_len(idx.pkg_names)
    svec_push(mut idx.pkg_names, name)
    svec_push(mut idx.pkg_versions, version)
    svec_push(mut idx.pkg_summaries, summary)
    svec_push(mut idx.pkg_authors, author)
    svec_push(mut idx.pkg_licenses, license_s)
    svec_push(mut idx.pkg_requires_python, req_py)
    svec_push(mut idx.pkg_requires_dist, req_dist)
    svec_push(mut idx.pkg_roots, root)
    smap_set_i64(mut idx.pkg_map, name, pidx)
    return pidx
}

fn _py_parse_func_signature_and_add(mut idx: PyLibIndex, mod_idx: i64, cls_idx: i64, mod_qname: str, cls_qname: str, header: str, dec_text: str, doc_raw: str, start_line: i64, dec_start_line: i64, is_async: bool) -> i64 {
    hl := str_len(header)
    open_p := str_find_byte(header, 40, 0)
    if open_p < 0 { return -1 }
    // Extract function name right after `def `
    def_pos := str_find(header, "def ", 0)
    if def_pos < 0 or def_pos >= open_p { return -1 }
    fname := str_trim(str_slice(header, def_pos + 4, open_p))
    if str_len(fname) == 0 { return -1 }

    // Find matching `)`
    mut depth := 0
    mut close_p := -1
    mut i := open_p
    while i < hl {
        (q, is_tr, oend) := _py_check_string_open(header, i, hl)
        if q != 0 {
            (cend, _) := _py_scan_string_body(header, oend, hl, q, is_tr)
            i = cend
            continue
        }
        b := str_byte(header, i)
        if b == 40 or b == 91 or b == 123 { depth += 1 }
        else if b == 41 or b == 93 or b == 125 {
            depth -= 1
            if depth == 0 and b == 41 { close_p = i; break }
        }
        i += 1
    }
    if close_p < 0 { return -1 }
    params_raw := str_trim(str_slice(header, open_p + 1, close_p))

    // Return type between `->` and first top-level `:` (supports single-line `def f() -> int: return 1`)
    mut ret_type := ""
    mut tail := str_trim(str_slice(header, close_p + 1, hl))
    tail_col := _py_find_top_level_byte(tail, 58, 0)
    if tail_col >= 0 { tail = str_trim(str_slice(tail, 0, tail_col)) }
    if str_starts_with(tail, "->") { ret_type = str_trim(str_slice(tail, 2, str_len(tail))) }

    // Parse docstring sections
    mut pdoc := _py_parse_docstring(doc_raw)

    // Parse parameter list
    pstart := svec_len(idx.prm_name)
    mut pcnt := 0
    mut kw_only := false
    mut sig_b := mbuf_new(str_len(params_raw) + 64)
    mbuf_push(mut sig_b, 40)

    if str_len(params_raw) > 0 {
        pparts := _py_split_params(params_raw)
        cnt := svec_len(pparts)
        mut pi := 0
        while pi < cnt {
            tok := svec_get(pparts, pi)
            if pi > 0 { mbuf_push_str(mut sig_b, ", ") }
            mbuf_push_str(mut sig_b, tok)
            if str_eq(tok, "/") {
                // Mark all prior params in this fn as POS_ONLY
                mut back := 0
                while back < pcnt {
                    dvec_set(mut idx.prm_kind, pstart + back, py_param_pos_only())
                    back += 1
                }
                pi += 1
                continue
            }
            if str_eq(tok, "*") {
                kw_only = true
                pi += 1
                continue
            }
            mut pkind := if kw_only { py_param_kw_only() } else { py_param_pos_or_kw() }
            mut work := tok
            if str_starts_with(work, "**") {
                pkind = py_param_var_kw()
                work = str_trim(str_slice(work, 2, str_len(work)))
            } else if str_starts_with(work, "*") {
                pkind = py_param_var_pos()
                work = str_trim(str_slice(work, 1, str_len(work)))
            }
            col := _py_find_top_level_byte(work, 58, 0)
            eq := _py_find_top_level_byte(work, 61, 0)
            mut pname := work
            mut ptype := ""
            mut pdef := ""
            mut has_def := false
            if col >= 0 and (eq < 0 or col < eq) {
                pname = str_trim(str_slice(work, 0, col))
                if eq > col {
                    ptype = str_trim(str_slice(work, col + 1, eq))
                    pdef = str_trim(str_slice(work, eq + 1, str_len(work)))
                    has_def = true
                } else {
                    ptype = str_trim(str_slice(work, col + 1, str_len(work)))
                }
            } else if eq >= 0 {
                pname = str_trim(str_slice(work, 0, eq))
                pdef = str_trim(str_slice(work, eq + 1, str_len(work)))
                has_def = true
            }
            param_doc_str := "" + smap_get_str(pdoc.param_docs, pname, "")
            svec_push(mut idx.prm_name, pname)
            svec_push(mut idx.prm_type, ptype)
            svec_push(mut idx.prm_default, pdef)
            dvec_push(mut idx.prm_has_default, if has_def { 1 } else { 0 })
            dvec_push(mut idx.prm_kind, pkind)
            svec_push(mut idx.prm_doc, param_doc_str)
            pcnt += 1
            pi += 1
        }
        svec_free(move pparts)
    }
    mbuf_push(mut sig_b, 41)
    if str_len(ret_type) > 0 {
        mbuf_push_str(mut sig_b, " -> ")
        mbuf_push_str(mut sig_b, ret_type)
    }

    // Flags from modifiers & decorators
    mut flags := 0
    if is_async { flags = flags | py_flag_async() }
    if cls_idx >= 0 { flags = flags | py_flag_method() }
    if str_contains(dec_text, "@classmethod") { flags = flags | py_flag_classmethod() }
    if str_contains(dec_text, "@staticmethod") { flags = flags | py_flag_staticmethod() }
    if str_contains(dec_text, "@property") or str_contains(dec_text, "@cached_property") { flags = flags | py_flag_property() }
    if str_contains(dec_text, "@overload") { flags = flags | py_flag_overload() }
    if str_contains(dec_text, "@abstractmethod") { flags = flags | py_flag_abstractmethod() }
    if str_contains(dec_text, ".tool") or str_starts_with(dec_text, "@tool") or str_contains(dec_text, "\n@tool") {
        flags = flags | py_flag_mcp_tool()
    }
    if str_contains(dec_text, ".resource") or str_starts_with(dec_text, "@resource") {
        flags = flags | py_flag_mcp_resource()
    }
    if str_contains(dec_text, ".prompt") or str_starts_with(dec_text, "@prompt") {
        flags = flags | py_flag_mcp_prompt()
    }
    is_dunder := str_len(fname) >= 4 and str_starts_with(fname, "__") and str_ends_with(fname, "__")
    if is_dunder { flags = flags | py_flag_dunder() }
    else if str_starts_with(fname, "_") { flags = flags | py_flag_private() }

    qname := if cls_idx >= 0 { cls_qname + "." + fname } else { mod_qname + "." + fname }
    fidx := svec_len(idx.fn_name)
    dvec_push(mut idx.fn_mod_idx, mod_idx)
    dvec_push(mut idx.fn_cls_idx, cls_idx)
    svec_push(mut idx.fn_name, fname)
    svec_push(mut idx.fn_qname, qname)
    svec_push(mut idx.fn_sig_str, mbuf_finish(move sig_b))
    svec_push(mut idx.fn_ret_type, ret_type)
    svec_push(mut idx.fn_decorators, dec_text)
    dvec_push(mut idx.fn_flags, flags)
    svec_push(mut idx.fn_doc, doc_raw)
    svec_push(mut idx.fn_doc_summary, pdoc.summary)
    svec_push(mut idx.fn_doc_returns, pdoc.returns_doc)
    svec_push(mut idx.fn_doc_raises, pdoc.raises_doc)
    dvec_push(mut idx.fn_start_line, start_line)
    dvec_push(mut idx.fn_end_line, start_line)
    dvec_push(mut idx.fn_dec_start_line, dec_start_line)
    dvec_push(mut idx.fn_param_start, pstart)
    dvec_push(mut idx.fn_param_count, pcnt)
    if not smap_has(idx.fn_qname_map, qname) {
        smap_set_i64(mut idx.fn_qname_map, qname, fidx)
    }
    _py_parsed_doc_free(move pdoc)
    return fidx
}

fn _py_update_lex_state(line: str, cur_triple: i64, cur_depth: i64) -> (i64, i64) {
    n := str_len(line)
    mut tri := cur_triple
    mut dep := cur_depth
    mut i := 0
    while i < n {
        if tri != 0 {
            if str_byte(line, i) == 92 { i += 2; continue }
            if i + 2 < n and str_byte(line, i) == tri and str_byte(line, i + 1) == tri and str_byte(line, i + 2) == tri {
                tri = 0
                i += 3
                continue
            }
            i += 1
            continue
        }
        b := str_byte(line, i)
        if b == 35 { break } // '#' comment outside strings
        (q, is_tr, oend) := _py_check_string_open(line, i, n)
        if q != 0 {
            (cend, closed) := _py_scan_string_body(line, oend, n, q, is_tr)
            if not closed and is_tr {
                tri = q
                break
            }
            i = cend
            continue
        }
        if b == 40 or b == 91 or b == 123 { dep += 1 }
        else if (b == 41 or b == 93 or b == 125) and dep > 0 { dep -= 1 }
        i += 1
    }
    return (tri, dep)
}

fn _py_line_ends_backslash(line: str) -> bool {
    tr := str_trim_right(line)
    n := str_len(tr)
    if n == 0 { return false }
    return str_byte(tr, n - 1) == 92
}

// Collects logical statement starting at `start_li` until `paren_depth == 0`, `in_triple == 0`, and no trailing `\`.
// Returns `(joined_text, end_li_exclusive, end_triple, end_depth)`.
fn _py_collect_stmt(src: str, ranges: IntBuf, rc: i64, start_li: i64, init_triple: i64, init_depth: i64) -> (str, i64, i64, i64) {
    mut mb := mbuf_new(256)
    mut li := start_li
    mut tri := init_triple
    mut dep := init_depth
    while li < rc {
        ln := _py_split_line_at(src, ranges, li)
        clean := if tri == 0 { _py_strip_inline_comment(ln) } else { ln }
        mut seg := str_trim(clean)
        cont_bs := tri == 0 and _py_line_ends_backslash(clean)
        if cont_bs and str_len(seg) > 0 {
            seg = str_trim_right(str_slice(seg, 0, str_len(seg) - 1))
        }
        if mbuf_len(mb) > 0 and str_len(seg) > 0 {
            mbuf_push(mut mb, if tri != 0 { 10 } else { 32 })
        }
        mbuf_push_str(mut mb, seg)
        (ntri, ndep) := _py_update_lex_state(ln, tri, dep)
        tri = ntri
        dep = ndep
        li += 1
        if tri == 0 and dep == 0 and not cont_bs { break }
    }
    return (mbuf_finish(move mb), li, tri, dep)
}

// Peeks immediate docstring right after `start_li` when line is deeper than `parent_indent`.
// Returns `(doc_text, next_li_after_doc)`.
fn _py_peek_docstring(src: str, ranges: IntBuf, rc: i64, start_li: i64, parent_indent: i64) -> (str, i64) {
    mut li := start_li
    while li < rc {
        ln := _py_split_line_at(src, ranges, li)
        tr := str_trim(ln)
        if str_len(tr) == 0 or str_byte(tr, 0) == 35 {
            li += 1
            continue
        }
        ind := _py_count_indent(ln, 0, str_len(ln))
        if parent_indent >= 0 and ind <= parent_indent {
            return ("", start_li)
        }
        (q, is_tr, oend) := _py_check_string_open(tr, 0, str_len(tr))
        if q == 0 {
            return ("", start_li)
        }
        (cend, closed) := _py_scan_string_body(tr, oend, str_len(tr), q, is_tr)
        if closed {
            // Ensure nothing else follows on this line besides `# comment`
            rest := str_trim(_py_strip_inline_comment(str_slice(tr, cend, str_len(tr))))
            if str_len(rest) > 0 { return ("", start_li) }
            return (_py_unquote_literal(str_slice(tr, 0, cend)), li + 1)
        }
        if not is_tr { return ("", start_li) }
        mut body := mbuf_new(512)
        mbuf_push_str(mut body, str_slice(tr, oend, str_len(tr)))
        mut cur := li + 1
        while cur < rc {
            cln := _py_split_line_at(src, ranges, cur)
            (end_p, done_s) := _py_scan_string_body(cln, 0, str_len(cln), q, true)
            if done_s {
                qlen := 3
                if end_p >= qlen {
                    mbuf_push(mut body, 10)
                    mbuf_push_str(mut body, str_slice(cln, 0, end_p - qlen))
                }
                cur += 1
                break
            } else {
                mbuf_push(mut body, 10)
                mbuf_push_str(mut body, cln)
            }
            cur += 1
        }
        return (py_cleandoc(mbuf_finish(move body)), cur)
    }
    return ("", start_li)
}

fn _py_classify_class_kind(bases_csv: str, decorators: str) -> str {
    if str_contains(decorators, "@dataclass") or str_contains(decorators, ".dataclass") {
        return "dataclass"
    }
    if str_contains(bases_csv, "BaseModel") or str_contains(bases_csv, "BaseSettings") {
        return "pydantic_model"
    }
    if str_contains(bases_csv, "TypedDict") {
        return "typed_dict"
    }
    if str_contains(bases_csv, "Enum") or str_contains(bases_csv, "IntEnum") or str_contains(bases_csv, "StrEnum") or str_contains(bases_csv, "Flag") {
        return "enum"
    }
    if str_contains(bases_csv, "Protocol") {
        return "protocol"
    }
    if str_contains(bases_csv, "Exception") or str_contains(bases_csv, "Error") or str_contains(bases_csv, "Warning") {
        return "exception"
    }
    if str_contains(bases_csv, "ABC") {
        return "abc"
    }
    return "class"
}

fn _py_parse_class_header_and_add(mut idx: PyLibIndex, mod_idx: i64, mod_qname: str, header: str, dec_text: str, doc_raw: str, start_line: i64) -> i64 {
    mut s := str_trim(header)
    if str_starts_with(s, "class ") { s = str_trim(str_slice(s, 6, str_len(s))) }
    col_pos := _py_find_top_level_byte(s, 58, 0)
    if col_pos >= 0 { s = str_trim(str_slice(s, 0, col_pos)) }
    open_p := str_find_byte(s, 40, 0)
    mut cname := s
    mut bases := ""
    if open_p >= 0 {
        cname = str_trim(str_slice(s, 0, open_p))
        close_p := str_rfind(s, ")")
        if close_p > open_p {
            bases = str_trim(str_slice(s, open_p + 1, close_p))
        }
    }
    if str_len(cname) == 0 { return -1 }
    ckind := _py_classify_class_kind(bases, dec_text)
    qname := mod_qname + "." + cname
    cidx := svec_len(idx.cls_name)
    dvec_push(mut idx.cls_mod_idx, mod_idx)
    svec_push(mut idx.cls_name, cname)
    svec_push(mut idx.cls_qname, qname)
    svec_push(mut idx.cls_bases, bases)
    svec_push(mut idx.cls_decorators, dec_text)
    svec_push(mut idx.cls_kind, ckind)
    svec_push(mut idx.cls_doc, doc_raw)
    dvec_push(mut idx.cls_start_line, start_line)
    dvec_push(mut idx.cls_end_line, start_line)
    if not smap_has(idx.cls_qname_map, qname) {
        smap_set_i64(mut idx.cls_qname_map, qname, cidx)
    }
    return cidx
}

fn _py_parse_import_stmt(mut idx: PyLibIndex, mod_idx: i64, stmt: str, line_no: i64) {
    s := str_trim(stmt)
    if str_starts_with(s, "import ") {
        rest := str_trim(str_slice(s, 7, str_len(s)))
        items := _py_split_top_level(rest, 44)
        mut i := 0
        while i < svec_len(items) {
            it := str_trim(svec_get(items, i))
            as_pos := str_find(it, " as ", 0)
            mut mname := it
            mut alias := ""
            if as_pos > 0 {
                mname = str_trim(str_slice(it, 0, as_pos))
                alias = str_trim(str_slice(it, as_pos + 4, str_len(it)))
            }
            if str_len(mname) > 0 {
                dvec_push(mut idx.imp_mod_idx, mod_idx)
                svec_push(mut idx.imp_module, mname)
                svec_push(mut idx.imp_symbol, "*")
                svec_push(mut idx.imp_alias, alias)
                dvec_push(mut idx.imp_line, line_no)
                dvec_push(mut idx.imp_is_rel, 0)
            }
            i += 1
        }
        svec_free(move items)
        return
    }
    if str_starts_with(s, "from ") {
        imp_pos := str_find(s, " import ", 5)
        if imp_pos <= 5 { return }
        src_mod := str_trim(str_slice(s, 5, imp_pos))
        is_rel := if str_len(src_mod) > 0 and str_byte(src_mod, 0) == 46 { 1 } else { 0 }
        mut syms_part := str_trim(str_slice(s, imp_pos + 8, str_len(s)))
        slen := str_len(syms_part)
        if slen >= 2 and str_byte(syms_part, 0) == 40 and str_byte(syms_part, slen - 1) == 41 {
            syms_part = str_trim(str_slice(syms_part, 1, slen - 1))
        }
        items := _py_split_top_level(syms_part, 44)
        mut i := 0
        while i < svec_len(items) {
            it := str_trim(svec_get(items, i))
            if str_len(it) > 0 {
                as_pos := str_find(it, " as ", 0)
                mut sym := it
                mut alias := ""
                if as_pos > 0 {
                    sym = str_trim(str_slice(it, 0, as_pos))
                    alias = str_trim(str_slice(it, as_pos + 4, str_len(it)))
                }
                dvec_push(mut idx.imp_mod_idx, mod_idx)
                svec_push(mut idx.imp_module, src_mod)
                svec_push(mut idx.imp_symbol, sym)
                svec_push(mut idx.imp_alias, alias)
                dvec_push(mut idx.imp_line, line_no)
                dvec_push(mut idx.imp_is_rel, is_rel)
            }
            i += 1
        }
        svec_free(move items)
    }
}

fn _py_parse_all_list(stmt: str) -> str {
    eq := _py_find_top_level_byte(stmt, 61, 0)
    if eq < 0 { return "" }
    mut rhs := str_trim(str_slice(stmt, eq + 1, str_len(stmt)))
    rlen := str_len(rhs)
    if rlen < 2 { return "" }
    fb := str_byte(rhs, 0)
    lb := str_byte(rhs, rlen - 1)
    if (fb == 91 and lb == 93) or (fb == 40 and lb == 41) {
        rhs = str_trim(str_slice(rhs, 1, rlen - 1))
    }
    parts := _py_split_top_level(rhs, 44)
    mut out := mbuf_new(256)
    mut i := 0
    mut cnt := 0
    while i < svec_len(parts) {
        it := str_trim(svec_get(parts, i))
        (q, _, _) := _py_check_string_open(it, 0, str_len(it))
        if q != 0 {
            if cnt > 0 { mbuf_push(mut out, 44) }
            mbuf_push_str(mut out, _py_unquote_literal(it))
            cnt += 1
        }
        i += 1
    }
    svec_free(move parts)
    return mbuf_finish(move out)
}

fn _py_try_parse_assignment_or_field(mut idx: PyLibIndex, mod_idx: i64, cls_idx: i64, stmt: str, inline_comment: str, line_no: i64) -> bool {
    s := str_trim(stmt)
    if str_len(s) == 0 { return false }
    if not _py_is_ident_start(str_byte(s, 0)) { return false }
    // Skip control flow statements
    if _py_match_kw_at(s, 0, str_len(s), "if") or _py_match_kw_at(s, 0, str_len(s), "elif") or _py_match_kw_at(s, 0, str_len(s), "else") or _py_match_kw_at(s, 0, str_len(s), "for") or _py_match_kw_at(s, 0, str_len(s), "while") or _py_match_kw_at(s, 0, str_len(s), "try") or _py_match_kw_at(s, 0, str_len(s), "except") or _py_match_kw_at(s, 0, str_len(s), "finally") or _py_match_kw_at(s, 0, str_len(s), "with") or _py_match_kw_at(s, 0, str_len(s), "return") or _py_match_kw_at(s, 0, str_len(s), "pass") or _py_match_kw_at(s, 0, str_len(s), "raise") or _py_match_kw_at(s, 0, str_len(s), "assert") or _py_match_kw_at(s, 0, str_len(s), "del") or _py_match_kw_at(s, 0, str_len(s), "yield") or _py_match_kw_at(s, 0, str_len(s), "break") or _py_match_kw_at(s, 0, str_len(s), "continue") or _py_match_kw_at(s, 0, str_len(s), "global") or _py_match_kw_at(s, 0, str_len(s), "nonlocal") or _py_match_kw_at(s, 0, str_len(s), "async") {
        return false
    }
    col := _py_find_top_level_byte(s, 58, 0)
    eq := _py_find_top_level_byte(s, 61, 0)
    if col < 0 and eq < 0 { return false }

    mut lhs := s
    mut vtype := ""
    mut vdef := ""
    if col >= 0 and (eq < 0 or col < eq) {
        lhs = str_trim(str_slice(s, 0, col))
        if eq > col {
            vtype = str_trim(str_slice(s, col + 1, eq))
            vdef = str_trim(str_slice(s, eq + 1, str_len(s)))
        } else {
            vtype = str_trim(str_slice(s, col + 1, str_len(s)))
        }
    } else if eq > 0 {
        // Ensure not `==`, `!=`, `<=`, `>=`
        prev_b := str_byte(s, eq - 1)
        next_b := if eq + 1 < str_len(s) { str_byte(s, eq + 1) } else { 0 }
        if prev_b == 60 or prev_b == 62 or prev_b == 33 or prev_b == 61 or next_b == 61 { return false }
        lhs = str_trim(str_slice(s, 0, eq))
        vdef = str_trim(str_slice(s, eq + 1, str_len(s)))
    }
    // Validate simple identifier on LHS (skip attribute assignments `self.x = ...` or unpacking `a, b = ...`)
    mut li := 0
    lhn := str_len(lhs)
    if lhn == 0 or lhn > 128 { return false }
    while li < lhn {
        if not _py_is_ident_char(str_byte(lhs, li)) { return false }
        li += 1
    }
    mut vdoc := inline_comment
    if str_len(vdoc) == 0 and str_contains(vdef, "Field(") {
        vdoc = _py_extract_kw_str(vdef, "description")
    }
    dvec_push(mut idx.var_mod_idx, mod_idx)
    dvec_push(mut idx.var_cls_idx, cls_idx)
    svec_push(mut idx.var_name, lhs)
    svec_push(mut idx.var_type, vtype)
    svec_push(mut idx.var_default, vdef)
    svec_push(mut idx.var_doc, vdoc)
    dvec_push(mut idx.var_line, line_no)
    return true
}

fn _py_pop_scopes_above_or_eq(mut idx: PyLibIndex, mut skinds: DynIntVec, mut sidxs: DynIntVec, mut sinds: DynIntVec, cur_indent: i64, last_code_line: i64) {
    while dvec_len(skinds) > 0 {
        top := dvec_len(skinds) - 1
        tind := dvec_get(sinds, top, 0)
        if tind < cur_indent { break }
        k := dvec_pop(mut skinds, 0)
        sidx := dvec_pop(mut sidxs, -1)
        _ := dvec_pop(mut sinds, 0)
        if k == 1 and sidx >= 0 {
            st := dvec_get(idx.cls_start_line, sidx, 1)
            el := if last_code_line >= st { last_code_line } else { st }
            dvec_set(mut idx.cls_end_line, sidx, el)
        } else if k == 2 and sidx >= 0 {
            st := dvec_get(idx.fn_start_line, sidx, 1)
            el := if last_code_line >= st { last_code_line } else { st }
            dvec_set(mut idx.fn_end_line, sidx, el)
        }
    }
}

fn _py_current_enclosing_class(skinds: DynIntVec, sidxs: DynIntVec) -> (i64, bool) {
    cnt := dvec_len(skinds)
    if cnt <= 0 { return (-1, false) }
    top_k := dvec_get(skinds, cnt - 1, 0)
    if top_k == 1 {
        return (dvec_get(sidxs, cnt - 1, -1), false)
    }
    return (-1, true)
}

fn py_index_add_source(mut idx: PyLibIndex, pkg_name: str, mod_qname: str, file_path: str, src: str, is_stub: bool = false) -> i64 {
    pidx := _py_add_package_entry(mut idx, pkg_name, "", "", "", "", "", "", "<memory>")
    existing_m := smap_get_i64(idx.mod_qname_map, mod_qname, -1)
    if existing_m >= 0 { return existing_m }
    mut clean_src := src
    if str_len(clean_src) >= 3 and str_byte(clean_src, 0) == 239 and str_byte(clean_src, 1) == 187 and str_byte(clean_src, 2) == 191 {
        clean_src = str_slice(clean_src, 3, str_len(clean_src))
    }

    ranges := str_split_ranges(clean_src, 10)
    rc := str_split_count(ranges)
    mod_idx := svec_len(idx.mod_qname)
    is_pkg := if str_ends_with(file_path, "__init__.py") or str_ends_with(file_path, "__init__.pyi") or str_eq(pkg_name, mod_qname) { 1 } else { 0 }

    dvec_push(mut idx.mod_pkg_idx, pidx)
    svec_push(mut idx.mod_qname, mod_qname)
    svec_push(mut idx.mod_file_path, file_path)
    dvec_push(mut idx.mod_is_pkg, is_pkg)
    dvec_push(mut idx.mod_is_stub, if is_stub { 1 } else { 0 })
    svec_push(mut idx.mod_src, clean_src)
    dvec_push(mut idx.mod_line_count, rc)
    smap_set_i64(mut idx.mod_qname_map, mod_qname, mod_idx)

    mut mod_doc := ""
    mut mod_all := ""
    mut mod_ver := ""
    mut skinds := dvec_new(16)
    mut sidxs := dvec_new(16)
    mut sinds := dvec_new(16)
    mut dec_buf := mbuf_new(256)
    mut dec_start_line := 0
    mut in_triple := 0
    mut paren_depth := 0
    mut last_code_line := 1
    mut at_top := true
    mut li := 0

    while li < rc {
        ln := _py_split_line_at(clean_src, ranges, li)
        ll := str_len(ln)

        if in_triple != 0 {
            (ntri, ndep) := _py_update_lex_state(ln, in_triple, paren_depth)
            in_triple = ntri
            paren_depth = ndep
            last_code_line = li + 1
            li += 1
            continue
        }

        tr := str_trim(ln)
        if str_len(tr) == 0 or str_byte(tr, 0) == 35 {
            li += 1
            continue
        }

        ind := _py_count_indent(ln, 0, ll)
        if paren_depth == 0 {
            _py_pop_scopes_above_or_eq(mut idx, mut skinds, mut sidxs, mut sinds, ind, last_code_line)
        }
        last_code_line = li + 1

        if at_top {
            at_top = false;
            (dq, _, _) := _py_check_string_open(tr, 0, str_len(tr))
            if dq != 0 {
                (mdoc, next_li) := _py_peek_docstring(clean_src, ranges, rc, li, -1)
                if str_len(mdoc) > 0 {
                    mod_doc = mdoc
                    last_code_line = next_li
                    li = next_li
                    continue
                }
            }
        }

        (cur_cls_idx, inside_fn) := _py_current_enclosing_class(skinds, sidxs)
        if inside_fn or paren_depth != 0 {
            (ntri, ndep) := _py_update_lex_state(ln, in_triple, paren_depth)
            in_triple = ntri
            paren_depth = ndep
            li += 1
            continue
        }

        // Decorator
        if str_byte(tr, 0) == 64 { // '@'
            (d_stmt, next_li, ntri, ndep) := _py_collect_stmt(clean_src, ranges, rc, li, in_triple, paren_depth)
            in_triple = ntri
            paren_depth = ndep
            if dec_start_line == 0 { dec_start_line = li + 1 }
            if mbuf_len(dec_buf) > 0 { mbuf_push(mut dec_buf, 10) }
            mbuf_push_str(mut dec_buf, d_stmt)
            last_code_line = next_li
            li = next_li
            continue
        }

        // Class declaration
        if _py_match_kw_at(tr, 0, str_len(tr), "class") {
            (hdr, next_li, ntri, ndep) := _py_collect_stmt(clean_src, ranges, rc, li, in_triple, paren_depth)
            in_triple = ntri
            paren_depth = ndep;
            (cdoc, after_doc_li) := _py_peek_docstring(clean_src, ranges, rc, next_li, ind)
            dec_s := mbuf_as_str(dec_buf)
            cidx := _py_parse_class_header_and_add(mut idx, mod_idx, mod_qname, hdr, dec_s, cdoc, li + 1)
            mbuf_free(move dec_buf); dec_buf = mbuf_new(128); dec_start_line = 0
            if cidx >= 0 {
                dvec_push(mut skinds, 1)
                dvec_push(mut sidxs, cidx)
                dvec_push(mut sinds, ind)
            }
            last_code_line = after_doc_li
            li = after_doc_li
            continue
        }

        // Function / async function declaration
        tr_len := str_len(tr)
        is_async_kw := _py_match_kw_at(tr, 0, tr_len, "async")
        after_async := if is_async_kw { _py_skip_ws(tr, 5, tr_len) } else { 0 }
        is_async_def := is_async_kw and _py_match_kw_at(tr, after_async, tr_len, "def")
        is_sync_def := _py_match_kw_at(tr, 0, tr_len, "def")
        if is_async_def or is_sync_def {
            (hdr, next_li, ntri, ndep) := _py_collect_stmt(clean_src, ranges, rc, li, in_triple, paren_depth)
            in_triple = ntri
            paren_depth = ndep;
            (fdoc, after_doc_li) := _py_peek_docstring(clean_src, ranges, rc, next_li, ind)
            dec_s := mbuf_as_str(dec_buf)
            dstart := if dec_start_line > 0 { dec_start_line } else { li + 1 }
            cls_q := if cur_cls_idx >= 0 { "" + svec_get(idx.cls_qname, cur_cls_idx) } else { "" }
            fidx := _py_parse_func_signature_and_add(mut idx, mod_idx, cur_cls_idx, mod_qname, cls_q, hdr, dec_s, fdoc, li + 1, dstart, is_async_def)
            mbuf_free(move dec_buf); dec_buf = mbuf_new(128); dec_start_line = 0
            if fidx >= 0 {
                dvec_push(mut skinds, 2)
                dvec_push(mut sidxs, fidx)
                dvec_push(mut sinds, ind)
            }
            last_code_line = after_doc_li
            li = after_doc_li
            continue
        }

        // Clear unconsumed decorators
        if mbuf_len(dec_buf) > 0 {
            mbuf_free(move dec_buf); dec_buf = mbuf_new(128); dec_start_line = 0
        }

        // Imports (module-level or class-level)
        if _py_match_kw_at(tr, 0, str_len(tr), "import") or _py_match_kw_at(tr, 0, str_len(tr), "from") {
            (istmt, next_li, ntri, ndep) := _py_collect_stmt(clean_src, ranges, rc, li, in_triple, paren_depth)
            in_triple = ntri
            paren_depth = ndep
            _py_parse_import_stmt(mut idx, mod_idx, istmt, li + 1)
            last_code_line = next_li
            li = next_li
            continue
        }

        // `__all__`, `__version__`, and module constants / class fields
        mut inline_c := ""
        stripped := _py_strip_inline_comment(ln)
        if str_len(stripped) < ll {
            hash_p := str_find_byte(ln, 35, str_len(stripped))
            if hash_p >= 0 { inline_c = str_trim(str_slice(ln, hash_p + 1, ll)) }
        }
        (stmt, next_li, ntri, ndep) := _py_collect_stmt(clean_src, ranges, rc, li, in_triple, paren_depth)
        in_triple = ntri
        paren_depth = ndep
        if cur_cls_idx < 0 and str_starts_with(stmt, "__all__") and str_contains(stmt, "=") {
            mod_all = _py_parse_all_list(stmt)
        } else if cur_cls_idx < 0 and str_starts_with(stmt, "__version__") and str_contains(stmt, "=") {
            eq := str_find_byte(stmt, 61, 0)
            if eq > 0 { mod_ver = _py_unquote_literal(str_slice(stmt, eq + 1, str_len(stmt))) }
        } else {
            _ := _py_try_parse_assignment_or_field(mut idx, mod_idx, cur_cls_idx, stmt, inline_c, li + 1)
        }
        last_code_line = next_li
        li = next_li
    }

    _py_pop_scopes_above_or_eq(mut idx, mut skinds, mut sidxs, mut sinds, 0, last_code_line)
    dvec_free(move skinds)
    dvec_free(move sidxs)
    dvec_free(move sinds)
    mbuf_free(move dec_buf)
    buf_free(move ranges)

    svec_push(mut idx.mod_doc, mod_doc)
    svec_push(mut idx.mod_all_csv, mod_all)
    svec_push(mut idx.mod_version, mod_ver)
    return mod_idx
}

// ==================== 6. PACKAGE METADATA, DIRECTORY & VENV DISCOVERY ====================

fn _py_parse_dist_metadata(meta_text: str) -> (str, str, str, str, str, str, str) {
    mut pname := ""
    mut ver := ""
    mut sum := ""
    mut auth := ""
    mut lic := ""
    mut req_py := ""
    mut deps := mbuf_new(256)
    mut dep_cnt := 0
    ranges := str_split_ranges(meta_text, 10)
    rc := str_split_count(ranges)
    mut i := 0
    while i < rc {
        ln := _py_split_line_at(meta_text, ranges, i)
        if str_len(str_trim(ln)) == 0 { break } // End of RFC-822 metadata headers
        col := str_find_byte(ln, 58, 0)
        if col > 0 {
            k := str_trim(str_slice(ln, 0, col))
            v := str_trim(str_slice(ln, col + 1, str_len(ln)))
            if str_eq_ignore_case(k, "Name") { pname = v }
            else if str_eq_ignore_case(k, "Version") { ver = v }
            else if str_eq_ignore_case(k, "Summary") { sum = v }
            else if str_eq_ignore_case(k, "Author") or (str_len(auth) == 0 and str_eq_ignore_case(k, "Author-email")) { auth = v }
            else if str_eq_ignore_case(k, "License") and str_len(v) < 80 { lic = v }
            else if str_eq_ignore_case(k, "Requires-Python") { req_py = v }
            else if str_eq_ignore_case(k, "Requires-Dist") {
                if dep_cnt > 0 { mbuf_push(mut deps, 10) }
                mbuf_push_str(mut deps, v)
                dep_cnt += 1
            }
        }
        i += 1
    }
    buf_free(move ranges)
    return (pname, ver, sum, auth, lic, req_py, mbuf_finish(move deps))
}

fn _py_extract_toml_array_items(toml_text: str, key_name: str) -> str {
    pat := key_name + " = ["
    mut pos := str_find(toml_text, pat, 0)
    if pos < 0 {
        pat2 := key_name + "=["
        pos = str_find(toml_text, pat2, 0)
        if pos < 0 { return "" }
        pos += str_len(pat2)
    } else {
        pos += str_len(pat)
    }
    n := str_len(toml_text)
    mut out := mbuf_new(256)
    mut cnt := 0
    mut i := pos
    while i < n {
        b := str_byte(toml_text, i)
        if b == 93 { break } // ']'
        if b == 34 or b == 39 {
            q := b
            i += 1
            s0 := i
            while i < n and str_byte(toml_text, i) != q { i += 1 }
            item := str_trim(str_slice(toml_text, s0, i))
            if str_len(item) > 0 {
                if cnt > 0 { mbuf_push(mut out, 10) }
                mbuf_push_str(mut out, item)
                cnt += 1
            }
        }
        i += 1
    }
    return mbuf_finish(move out)
}

fn _py_is_skipped_dir(name: str) -> bool {
    if str_eq(name, "__pycache__") or str_eq(name, ".git") or str_eq(name, ".hg") or str_eq(name, ".svn") { return true }
    if str_eq(name, ".venv") or str_eq(name, "venv") or str_eq(name, "node_modules") { return true }
    if str_eq(name, ".mypy_cache") or str_eq(name, ".pytest_cache") or str_eq(name, ".ruff_cache") { return true }
    if str_ends_with(name, ".egg-info") or str_ends_with(name, ".dist-info") { return true }
    return false
}

fn _py_normalize_pkg_ident(name: str) -> str {
    return str_to_lower(str_replace(str_replace(name, "-", "_"), ".", "_"))
}

fn _py_register_dir_metadata(mut idx: PyLibIndex, dir_path: str, pkg_hint: str) -> str {
    mut resolved_pkg := pkg_hint
    // 1. Check `pyproject.toml` in `dir_path` or parent
    pyp := path_join(dir_path, "pyproject.toml")
    if fs_is_file(pyp) {
        txt := fs_read_text(pyp) or ""
        if str_len(txt) > 0 {
            mut td := toml_parse(txt)
            mut pname := toml_get_str(td, "project", "name", "")
            mut pver := toml_get_str(td, "project", "version", "")
            mut pdesc := toml_get_str(td, "project", "description", "")
            req_py := toml_get_str(td, "project", "requires-python", "")
            lic := toml_get_str(td, "project", "license", "")
            if str_len(pname) == 0 { pname = toml_get_str(td, "tool.poetry", "name", "") }
            if str_len(pver) == 0 { pver = toml_get_str(td, "tool.poetry", "version", "") }
            if str_len(pdesc) == 0 { pdesc = toml_get_str(td, "tool.poetry", "description", "") }
            toml_free(move td)
            deps := _py_extract_toml_array_items(txt, "dependencies")
            if str_len(resolved_pkg) == 0 and str_len(pname) > 0 { resolved_pkg = pname }
            if str_len(pname) > 0 {
                _ := _py_add_package_entry(mut idx, pname, pver, pdesc, "", lic, req_py, deps, path_normalize(dir_path))
            }
        }
    }
    // 2. Check sibling `*.dist-info/METADATA` if parent directory exists
    parent := path_dirname(path_normalize(dir_path))
    base := path_basename(path_normalize(dir_path))
    if str_len(resolved_pkg) == 0 { resolved_pkg = base }
    if str_len(parent) > 0 and fs_is_dir(parent) {
        entries := fs_list_dir(parent)
        norm_target := _py_normalize_pkg_ident(resolved_pkg)
        mut ei := 0
        while ei < svec_len(entries) {
            en := svec_get(entries, ei)
            if str_ends_with(en, ".dist-info") and str_len(en) > 10 {
                stem_d := str_slice(en, 0, str_len(en) - 10)
                dash := str_find_byte(stem_d, 45, 0)
                // Advance to `-<digit>` version separator if package name itself contains hyphens
                mut ver_dash := dash
                mut scan_p := 0
                while scan_p < str_len(stem_d) - 1 {
                    if str_byte(stem_d, scan_p) == 45 and str_byte(stem_d, scan_p + 1) >= 48 and str_byte(stem_d, scan_p + 1) <= 57 {
                        ver_dash = scan_p
                        break
                    }
                    scan_p += 1
                }
                dist_part := if ver_dash > 0 { str_slice(stem_d, 0, ver_dash) } else { stem_d }
                norm_en := _py_normalize_pkg_ident(dist_part)
                if str_eq(norm_en, norm_target) {
                    mpath := path_join(path_join(parent, en), "METADATA")
                    if fs_is_file(mpath) {
                        mtxt := fs_read_text(mpath) or ""
                        if str_len(mtxt) > 0 {
                            (pn, pv, ps, pa, pl, rpy, rds) := _py_parse_dist_metadata(mtxt)
                            if str_len(pn) > 0 {
                                entry_name := if str_len(pkg_hint) > 0 { pkg_hint } else { pn }
                                _ := _py_add_package_entry(mut idx, entry_name, pv, ps, pa, pl, rpy, rds, path_normalize(dir_path))
                                if str_len(pkg_hint) == 0 { resolved_pkg = pn }
                            }
                        }
                    }
                }
            }
            ei += 1
        }
        svec_free(move entries)
    }
    return resolved_pkg
}

fn _py_derive_mod_qname(cur_mod: str, pkg_name: str, stem: str) -> str {
    if str_eq(stem, "__init__") {
        if str_len(cur_mod) > 0 { return cur_mod }
        return pkg_name
    }
    if str_len(cur_mod) > 0 { return cur_mod + "." + stem }
    return stem
}

fn _py_has_win_reserved_seg(p: str) -> bool {
    n := str_len(p)
    mut s := 0
    while s <= n {
        mut e := s
        while e < n and str_byte(p, e) != 47 and str_byte(p, e) != 92 { e += 1 }
        if e > s {
            mut stem_end := s
            while stem_end < e and str_byte(p, stem_end) != 46 { stem_end += 1 }
            seg := str_slice(p, s, stem_end)
            if str_eq_ignore_case(seg, "CON") or str_eq_ignore_case(seg, "PRN") or str_eq_ignore_case(seg, "AUX") or str_eq_ignore_case(seg, "NUL") {
                return true
            }
            if str_len(seg) == 4 {
                b3 := str_byte(seg, 3)
                p3 := str_slice(seg, 0, 3)
                if b3 >= 49 and b3 <= 57 and (str_eq_ignore_case(p3, "COM") or str_eq_ignore_case(p3, "LPT")) {
                    return true
                }
            }
        }
        s = e + 1
    }
    return false
}

fn _py_is_safe_fs_input(p: str) -> bool {
    n := str_len(p)
    if n == 0 or n > 4096 { return false }
    if str_contains(p, "..") { return false }
    // Block UNC network shares (`\\host\share`, `//host/share`) to prevent NTLM leaks on Windows
    if n >= 2 and ((str_byte(p, 0) == 92 and str_byte(p, 1) == 92) or (str_byte(p, 0) == 47 and str_byte(p, 1) == 47)) {
        return false
    }
    mut i := 0
    while i < n {
        b := str_byte(p, i)
        if b == 0 or b < 32 { return false }
        i += 1
    }
    return not _py_has_win_reserved_seg(p)
}

fn _py_is_safe_pkg_ident(pkg: str) -> bool {
    n := str_len(pkg)
    if n == 0 or n > 128 or str_contains(pkg, "..") { return false }
    mut i := 0
    while i < n {
        b := str_byte(pkg, i)
        alnum := (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or (b >= 48 and b <= 57)
        ok_c := alnum or b == 95 or b == 45 or b == 46
        if not ok_c { return false }
        i += 1
    }
    return not _py_has_win_reserved_seg(pkg)
}

// Recursively indexes a `.py`/`.pyi` file or Python package directory (up to `max_files`, depth 12).
// Rejects path traversal segments (`..`), UNC paths, and NUL/control bytes. Returns count of files indexed.
fn py_index_add_dir(mut idx: PyLibIndex, root_path: str, pkg_name_hint: str = "", max_files: i64 = 1500) -> i64 {
    if not _py_is_safe_fs_input(root_path) { return 0 }
    norm_root := path_normalize(root_path)

    // Single `.py` / `.pyi` file mode
    if fs_is_file(norm_root) {
        ext := path_ext(norm_root)
        if not str_eq(ext, ".py") and not str_eq(ext, ".pyi") { return 0 }
        src := fs_read_text(norm_root) or return 0
        if str_len(src) > 4194304 { return 0 }
        stem := path_stem(norm_root)
        pkg := if str_len(pkg_name_hint) > 0 { pkg_name_hint } else { stem }
        _ := _py_add_package_entry(mut idx, pkg, "", "", "", "", "", "", norm_root)
        mod_q := if str_eq(stem, "__init__") or str_len(pkg_name_hint) == 0 or str_eq(pkg_name_hint, stem) {
            stem
        } else {
            pkg + "." + stem
        }
        _ := py_index_add_source(mut idx, pkg, mod_q, norm_root, src, str_eq(ext, ".pyi"))
        return 1
    }
    if not fs_is_dir(norm_root) { return 0 }

    // Detect `src/<pkg>` layout if `pyproject.toml` exists and `src/` holds the package
    mut scan_root := norm_root
    mut pkg_name := _py_register_dir_metadata(mut idx, norm_root, pkg_name_hint)
    has_init_here := fs_is_file(path_join(norm_root, "__init__.py")) or fs_is_file(path_join(norm_root, "__init__.pyi"))
    if not has_init_here and fs_is_dir(path_join(norm_root, "src")) {
        src_dir := path_join(norm_root, "src")
        sub_entries := fs_list_dir(src_dir)
        mut si := 0
        while si < svec_len(sub_entries) {
            cand := path_join(src_dir, svec_get(sub_entries, si))
            if fs_is_dir(cand) and fs_is_file(path_join(cand, "__init__.py")) {
                scan_root = cand
                if str_len(pkg_name_hint) == 0 { pkg_name = svec_get(sub_entries, si) }
                break
            }
            si += 1
        }
        svec_free(move sub_entries)
    }
    if str_len(pkg_name) == 0 { pkg_name = path_basename(scan_root) }
    _ := _py_add_package_entry(mut idx, pkg_name, "", "", "", "", "", "", scan_root)

    is_pkg_root := fs_is_file(path_join(scan_root, "__init__.py")) or fs_is_file(path_join(scan_root, "__init__.pyi"))
    mut q_dirs := svec_new(32, 1024)
    mut q_mods := svec_new(32, 1024)
    mut q_depth := dvec_new(32)
    svec_push(mut q_dirs, scan_root)
    svec_push(mut q_mods, if is_pkg_root { pkg_name } else { "" })
    dvec_push(mut q_depth, 0)

    mut qi := 0
    mut indexed_cnt := 0
    while qi < svec_len(q_dirs) and indexed_cnt < max_files {
        cur_dir := "" + svec_get(q_dirs, qi)
        cur_mod := "" + svec_get(q_mods, qi)
        cur_dep := dvec_get(q_depth, qi, 0)
        qi += 1
        if cur_dep > 12 { continue }

        items := fs_list_dir(cur_dir)
        icnt := svec_len(items)
        // Pass 1: index `.py` files first, then `.pyi` if `.py` not present
        mut ii := 0
        while ii < icnt and indexed_cnt < max_files {
            name := svec_get(items, ii)
            if not _py_is_skipped_dir(name) {
                full := path_join(cur_dir, name)
                if fs_is_dir(full) {
                    sub_mod := if str_len(cur_mod) > 0 { cur_mod + "." + name } else { name }
                    svec_push(mut q_dirs, full)
                    svec_push(mut q_mods, sub_mod)
                    dvec_push(mut q_depth, cur_dep + 1)
                } else if str_ends_with(name, ".py") {
                    stem := path_stem(name)
                    mod_q := _py_derive_mod_qname(cur_mod, pkg_name, stem)
                    sz := sys_fs_size(full)
                    if sz > 0 and sz <= 4194304 {
                        src := fs_read_text(full) or ""
                        if str_len(src) > 0 {
                            _ := py_index_add_source(mut idx, pkg_name, mod_q, full, src, false)
                            indexed_cnt += 1
                        }
                    }
                }
            }
            ii += 1
        }
        // Pass 2: index `.pyi` stubs when corresponding `.py` was not indexed
        ii = 0
        while ii < icnt and indexed_cnt < max_files {
            name := svec_get(items, ii)
            if str_ends_with(name, ".pyi") {
                full := path_join(cur_dir, name)
                stem := path_stem(name)
                mod_q := _py_derive_mod_qname(cur_mod, pkg_name, stem)
                if not smap_has(idx.mod_qname_map, mod_q) {
                    sz := sys_fs_size(full)
                    if sz > 0 and sz <= 4194304 {
                        src := fs_read_text(full) or ""
                        if str_len(src) > 0 {
                            _ := py_index_add_source(mut idx, pkg_name, mod_q, full, src, true)
                            indexed_cnt += 1
                        }
                    }
                }
            }
            ii += 1
        }
        svec_free(move items)
    }

    svec_free(move q_dirs)
    svec_free(move q_mods)
    dvec_free(move q_depth)
    return indexed_cnt
}

fn _py_collect_env_site_dirs() -> StrVec {
    mut out := svec_new(16, 1024)
    venv := sys_env_get("VIRTUAL_ENV")
    if str_len(venv) > 0 {
        wsp := path_join(path_join(venv, "Lib"), "site-packages")
        if fs_is_dir(wsp) { svec_push(mut out, wsp) }
        ulib := path_join(venv, "lib")
        if fs_is_dir(ulib) {
            ents := fs_list_dir(ulib)
            mut i := 0
            while i < svec_len(ents) {
                en := svec_get(ents, i)
                if str_starts_with(en, "python") {
                    sp := path_join(path_join(ulib, en), "site-packages")
                    if fs_is_dir(sp) { svec_push(mut out, sp) }
                }
                i += 1
            }
            svec_free(move ents)
        }
    }
    conda := sys_env_get("CONDA_PREFIX")
    if str_len(conda) > 0 {
        csp := path_join(path_join(conda, "Lib"), "site-packages")
        if fs_is_dir(csp) { svec_push(mut out, csp) }
    }
    cwd := sys_cwd()
    if str_len(cwd) > 0 {
        c1 := path_join(path_join(path_join(cwd, ".venv"), "Lib"), "site-packages")
        if fs_is_dir(c1) { svec_push(mut out, c1) }
        c2 := path_join(path_join(path_join(cwd, "venv"), "Lib"), "site-packages")
        if fs_is_dir(c2) { svec_push(mut out, c2) }
    }
    local_app := sys_env_get("LOCALAPPDATA")
    if str_len(local_app) > 0 {
        py_root := path_join(path_join(local_app, "Programs"), "Python")
        if fs_is_dir(py_root) {
            ents := fs_list_dir(py_root)
            mut i := 0
            while i < svec_len(ents) {
                en := svec_get(ents, i)
                sp := path_join(path_join(path_join(py_root, en), "Lib"), "site-packages")
                if fs_is_dir(sp) { svec_push(mut out, sp) }
                i += 1
            }
            svec_free(move ents)
        }
    }
    pypath := sys_env_get("PYTHONPATH")
    if str_len(pypath) > 0 {
        // Split on ';' (Windows) cleanly
        ranges := str_split_ranges(pypath, 59)
        mut i := 0
        while i < str_split_count(ranges) {
            seg := str_trim(str_split_at(pypath, ranges, i))
            if str_len(seg) > 0 and fs_is_dir(seg) { svec_push(mut out, seg) }
            i += 1
        }
        buf_free(move ranges)
    }
    return out
}

fn py_index_add_venv_package(mut idx: PyLibIndex, pkg_name: str, max_files: i64 = 1200) -> i64 {
    if not _py_is_safe_pkg_ident(pkg_name) { return 0 }
    dirs := _py_collect_env_site_dirs()
    mut total := 0
    mut i := 0
    while i < svec_len(dirs) {
        sp := svec_get(dirs, i)
        cand_dir := path_join(sp, pkg_name)
        cand_py := path_join(sp, pkg_name + ".py")
        if fs_is_dir(cand_dir) {
            total += py_index_add_dir(mut idx, cand_dir, pkg_name, max_files)
            break
        } else if fs_is_file(cand_py) {
            total += py_index_add_dir(mut idx, cand_py, pkg_name, max_files)
            break
        }
        i += 1
    }
    svec_free(move dirs)
    return total
}

fn py_index_discover_env(mut idx: PyLibIndex, max_packages: i64 = 24, max_files_per_pkg: i64 = 300) -> i64 {
    dirs := _py_collect_env_site_dirs()
    mut pkg_cnt := 0
    mut di := 0
    while di < svec_len(dirs) and pkg_cnt < max_packages {
        sp := svec_get(dirs, di)
        ents := fs_list_dir(sp)
        mut ei := 0
        while ei < svec_len(ents) and pkg_cnt < max_packages {
            en := svec_get(ents, ei)
            if not _py_is_skipped_dir(en) and not str_eq(en, "pip") and not str_eq(en, "setuptools") and not str_eq(en, "wheel") and not str_starts_with(en, "_") {
                full := path_join(sp, en)
                if fs_is_dir(full) and fs_is_file(path_join(full, "__init__.py")) {
                    added := py_index_add_dir(mut idx, full, en, max_files_per_pkg)
                    if added > 0 { pkg_cnt += 1 }
                }
            }
            ei += 1
        }
        svec_free(move ents)
        di += 1
    }
    svec_free(move dirs)
    return pkg_cnt
}

// ==================== 7. DEEP QUERY, SOURCE, HIERARCHY & REFERENCE APIS ====================

fn _py_fn_kind_label(flags: i64) -> str {
    if (flags & py_flag_mcp_tool()) != 0 { return "mcp_tool" }
    if (flags & py_flag_mcp_resource()) != 0 { return "mcp_resource" }
    if (flags & py_flag_mcp_prompt()) != 0 { return "mcp_prompt" }
    if (flags & py_flag_property()) != 0 { return "property" }
    if (flags & py_flag_classmethod()) != 0 { return "classmethod" }
    if (flags & py_flag_staticmethod()) != 0 { return "staticmethod" }
    if (flags & py_flag_method()) != 0 { return "method" }
    return "function"
}

fn _py_param_kind_label(pk: i64) -> str {
    if pk == py_param_pos_only() { return "POSITIONAL_ONLY" }
    if pk == py_param_var_pos() { return "VAR_POSITIONAL" }
    if pk == py_param_kw_only() { return "KEYWORD_ONLY" }
    if pk == py_param_var_kw() { return "VAR_KEYWORD" }
    return "POSITIONAL_OR_KEYWORD"
}

fn py_get_source_lines(idx: PyLibIndex, mod_or_path: str, start_line: i64 = 1, end_line: i64 = 200, numbered: bool = true) -> str ! i64 {
    mut midx := smap_get_i64(idx.mod_qname_map, mod_or_path, -1)
    if midx < 0 {
        mc := svec_len(idx.mod_file_path)
        mut i := 0
        while i < mc {
            if str_eq(svec_get(idx.mod_file_path, i), mod_or_path) { midx = i; break }
            i += 1
        }
    }
    if midx < 0 { return err(404) }
    src := svec_get(idx.mod_src, midx)
    total_lines := dvec_get(idx.mod_line_count, midx, 0)
    mut s := start_line
    mut e := end_line
    if s < 1 { s = 1 }
    if e < s { e = s }
    if e > total_lines { e = total_lines }
    if e - s > 500 { e = s + 500 }

    ranges := str_split_ranges(src, 10)
    mut out := mbuf_new(2048)
    mut lno := s
    while lno <= e {
        ln := _py_split_line_at(src, ranges, lno - 1)
        if numbered {
            mbuf_push_str(mut out, f"{lno}: ")
        }
        mbuf_push_str(mut out, ln)
        if lno < e { mbuf_push(mut out, 10) }
        lno += 1
    }
    buf_free(move ranges)
    return ok(mbuf_finish(move out))
}

fn py_list_packages_json(idx: PyLibIndex, filter_q: str = "") -> str {
    qlow := str_to_lower(str_trim(filter_q))
    pcnt := svec_len(idx.pkg_names)
    mcnt := svec_len(idx.mod_qname)
    ccnt := svec_len(idx.cls_name)
    fcnt := svec_len(idx.fn_name)
    mut out := mbuf_new(1024)
    mbuf_push_str(mut out, "{\"packages\":[")
    mut printed := 0
    mut pi := 0
    while pi < pcnt {
        pname := svec_get(idx.pkg_names, pi)
        if str_len(qlow) == 0 or str_contains(str_to_lower(pname), qlow) {
            mut mods_n := 0
            mut cls_n := 0
            mut fns_n := 0
            mut mi := 0
            while mi < mcnt {
                if dvec_get(idx.mod_pkg_idx, mi, -1) == pi { mods_n += 1 }
                mi += 1
            }
            mut ci := 0
            while ci < ccnt {
                cm := dvec_get(idx.cls_mod_idx, ci, -1)
                if cm >= 0 and dvec_get(idx.mod_pkg_idx, cm, -1) == pi { cls_n += 1 }
                ci += 1
            }
            mut fi := 0
            while fi < fcnt {
                fm := dvec_get(idx.fn_mod_idx, fi, -1)
                if fm >= 0 and dvec_get(idx.mod_pkg_idx, fm, -1) == pi { fns_n += 1 }
                fi += 1
            }
            if printed > 0 { mbuf_push(mut out, 44) }
            mbuf_push_str(mut out, "{\"name\":")
            mbuf_push_json_str(mut out, pname)
            mbuf_push_str(mut out, ",\"version\":")
            mbuf_push_json_str(mut out, svec_get(idx.pkg_versions, pi))
            mbuf_push_str(mut out, ",\"summary\":")
            mbuf_push_json_str(mut out, svec_get(idx.pkg_summaries, pi))
            mbuf_push_str(mut out, ",\"root\":")
            mbuf_push_json_str(mut out, svec_get(idx.pkg_roots, pi))
            mbuf_push_str(mut out, f",\"moduleCount\":{mods_n},\"classCount\":{cls_n},\"functionCount\":{fns_n}}}")
            printed += 1
        }
        pi += 1
    }
    mbuf_push_str(mut out, f"],\"total\":{printed}}}")
    return mbuf_finish(move out)
}

fn py_list_modules_json(idx: PyLibIndex, pkg_name: str, include_private: bool = false) -> str {
    pidx := smap_get_i64(idx.pkg_map, pkg_name, -1)
    mcnt := svec_len(idx.mod_qname)
    mut out := mbuf_new(2048)
    mbuf_push_str(mut out, "{\"package\":")
    mbuf_push_json_str(mut out, pkg_name)
    mbuf_push_str(mut out, ",\"modules\":[")
    mut printed := 0
    mut mi := 0
    while mi < mcnt {
        if pidx < 0 or dvec_get(idx.mod_pkg_idx, mi, -1) == pidx {
            mq := svec_get(idx.mod_qname, mi)
            is_priv := str_contains(mq, "._")
            if include_private or not is_priv {
                if printed > 0 { mbuf_push(mut out, 44) }
                mbuf_push_str(mut out, "{\"module\":")
                mbuf_push_json_str(mut out, mq)
                mbuf_push_str(mut out, ",\"path\":")
                mbuf_push_json_str(mut out, svec_get(idx.mod_file_path, mi))
                mbuf_push_str(mut out, ",\"isPackage\":")
                mbuf_push_str(mut out, if dvec_get(idx.mod_is_pkg, mi, 0) != 0 { "true" } else { "false" })
                mbuf_push_str(mut out, ",\"isStub\":")
                mbuf_push_str(mut out, if dvec_get(idx.mod_is_stub, mi, 0) != 0 { "true" } else { "false" })
                mbuf_push_str(mut out, f",\"lines\":{dvec_get(idx.mod_line_count, mi, 0)}")
                mdoc := svec_get(idx.mod_doc, mi)
                if str_len(mdoc) > 0 {
                    mbuf_push_str(mut out, ",\"doc\":")
                    mbuf_push_json_str(mut out, mdoc)
                }
                mall := svec_get(idx.mod_all_csv, mi)
                if str_len(mall) > 0 {
                    mbuf_push_str(mut out, ",\"all\":")
                    mbuf_push_json_str(mut out, mall)
                }
                mbuf_push(mut out, 125)
                printed += 1
            }
        }
        mi += 1
    }
    mbuf_push_str(mut out, f"],\"total\":{printed}}}")
    return mbuf_finish(move out)
}

fn py_inspect_module_json(idx: PyLibIndex, mod_qname: str, include_private: bool = false) -> str {
    midx := smap_get_i64(idx.mod_qname_map, mod_qname, -1)
    if midx < 0 {
        return "{\"error\":\"Module not found\"}"
    }
    pidx := dvec_get(idx.mod_pkg_idx, midx, -1)
    pname := if pidx >= 0 { svec_get(idx.pkg_names, pidx) } else { "" }
    mut out := mbuf_new(4096)
    mbuf_push_str(mut out, "{\"module\":")
    mbuf_push_json_str(mut out, mod_qname)
    mbuf_push_str(mut out, ",\"package\":")
    mbuf_push_json_str(mut out, pname)
    mbuf_push_str(mut out, ",\"path\":")
    mbuf_push_json_str(mut out, svec_get(idx.mod_file_path, midx))
    mbuf_push_str(mut out, ",\"version\":")
    mbuf_push_json_str(mut out, svec_get(idx.mod_version, midx))
    mbuf_push_str(mut out, ",\"lines\":")
    mbuf_push_i64(mut out, dvec_get(idx.mod_line_count, midx, 0))
    mbuf_push_str(mut out, ",\"doc\":")
    mbuf_push_json_str(mut out, svec_get(idx.mod_doc, midx))
    mbuf_push_str(mut out, ",\"exports\":")
    mbuf_push_json_str(mut out, svec_get(idx.mod_all_csv, midx))

    // Imports
    mbuf_push_str(mut out, ",\"imports\":[")
    mut imp_n := 0
    mut ii := 0
    while ii < dvec_len(idx.imp_mod_idx) {
        if dvec_get(idx.imp_mod_idx, ii, -1) == midx {
            if imp_n > 0 { mbuf_push(mut out, 44) }
            mbuf_push_str(mut out, "{\"module\":")
            mbuf_push_json_str(mut out, svec_get(idx.imp_module, ii))
            mbuf_push_str(mut out, ",\"symbol\":")
            mbuf_push_json_str(mut out, svec_get(idx.imp_symbol, ii))
            al := svec_get(idx.imp_alias, ii)
            if str_len(al) > 0 {
                mbuf_push_str(mut out, ",\"alias\":")
                mbuf_push_json_str(mut out, al)
            }
            mbuf_push_str(mut out, f",\"line\":{dvec_get(idx.imp_line, ii, 0)}}}")
            imp_n += 1
        }
        ii += 1
    }
    mbuf_push(mut out, 93)

    // Module-level constants & type aliases
    mbuf_push_str(mut out, ",\"constants\":[")
    mut vn := 0
    mut vi := 0
    while vi < svec_len(idx.var_name) {
        if dvec_get(idx.var_mod_idx, vi, -1) == midx and dvec_get(idx.var_cls_idx, vi, -1) < 0 {
            vname := svec_get(idx.var_name, vi)
            if include_private or not str_starts_with(vname, "_") {
                if vn > 0 { mbuf_push(mut out, 44) }
                mbuf_push_str(mut out, "{\"name\":")
                mbuf_push_json_str(mut out, vname)
                mbuf_push_str(mut out, ",\"type\":")
                mbuf_push_json_str(mut out, svec_get(idx.var_type, vi))
                mbuf_push_str(mut out, ",\"value\":")
                mbuf_push_json_str(mut out, svec_get(idx.var_default, vi))
                mbuf_push_str(mut out, f",\"line\":{dvec_get(idx.var_line, vi, 0)}}}")
                vn += 1
            }
        }
        vi += 1
    }
    mbuf_push(mut out, 93)

    // Classes
    mbuf_push_str(mut out, ",\"classes\":[")
    mut cn := 0
    mut ci := 0
    while ci < svec_len(idx.cls_name) {
        if dvec_get(idx.cls_mod_idx, ci, -1) == midx {
            cname := svec_get(idx.cls_name, ci)
            if include_private or not str_starts_with(cname, "_") {
                if cn > 0 { mbuf_push(mut out, 44) }
                mbuf_push_str(mut out, "{\"name\":")
                mbuf_push_json_str(mut out, cname)
                mbuf_push_str(mut out, ",\"qname\":")
                mbuf_push_json_str(mut out, svec_get(idx.cls_qname, ci))
                mbuf_push_str(mut out, ",\"kind\":")
                mbuf_push_json_str(mut out, svec_get(idx.cls_kind, ci))
                mbuf_push_str(mut out, ",\"bases\":")
                mbuf_push_json_str(mut out, svec_get(idx.cls_bases, ci))
                mbuf_push_str(mut out, ",\"doc\":")
                mbuf_push_json_str(mut out, svec_get(idx.cls_doc, ci))
                mbuf_push_str(mut out, f",\"startLine\":{dvec_get(idx.cls_start_line, ci, 1)},\"endLine\":{dvec_get(idx.cls_end_line, ci, 1)}}}")
                cn += 1
            }
        }
        ci += 1
    }
    mbuf_push(mut out, 93)

    // Functions & Methods
    mbuf_push_str(mut out, ",\"functions\":[")
    mut fn_n := 0
    mut fi := 0
    while fi < svec_len(idx.fn_name) {
        if dvec_get(idx.fn_mod_idx, fi, -1) == midx {
            fflags := dvec_get(idx.fn_flags, fi, 0)
            is_priv := (fflags & py_flag_private()) != 0
            if include_private or not is_priv {
                if fn_n > 0 { mbuf_push(mut out, 44) }
                mbuf_push_str(mut out, "{\"name\":")
                mbuf_push_json_str(mut out, svec_get(idx.fn_name, fi))
                mbuf_push_str(mut out, ",\"qname\":")
                mbuf_push_json_str(mut out, svec_get(idx.fn_qname, fi))
                mbuf_push_str(mut out, ",\"kind\":")
                mbuf_push_json_str(mut out, _py_fn_kind_label(fflags))
                mbuf_push_str(mut out, ",\"isAsync\":")
                mbuf_push_str(mut out, if (fflags & py_flag_async()) != 0 { "true" } else { "false" })
                mbuf_push_str(mut out, ",\"signature\":")
                mbuf_push_json_str(mut out, svec_get(idx.fn_sig_str, fi))
                mbuf_push_str(mut out, ",\"summary\":")
                mbuf_push_json_str(mut out, svec_get(idx.fn_doc_summary, fi))
                mbuf_push_str(mut out, f",\"startLine\":{dvec_get(idx.fn_start_line, fi, 1)},\"endLine\":{dvec_get(idx.fn_end_line, fi, 1)}}}")
                fn_n += 1
            }
        }
        fi += 1
    }
    mbuf_push_str(mut out, "]}")
    return mbuf_finish(move out)
}

fn _py_resolve_rel_import(cur_mod: str, is_pkg: bool, imp_mod: str) -> str {
    n := str_len(imp_mod)
    mut dots := 0
    while dots < n and str_byte(imp_mod, dots) == 46 { dots += 1 }
    if dots == 0 { return imp_mod }
    // Base package parts for relative import
    mut base_mod := cur_mod
    mut up := if is_pkg { dots - 1 } else { dots }
    while up > 0 {
        ldot := str_rfind(base_mod, ".")
        if ldot < 0 { base_mod = ""; break }
        base_mod = str_slice(base_mod, 0, ldot)
        up -= 1
    }
    tail := str_slice(imp_mod, dots, n)
    if str_len(base_mod) == 0 { return tail }
    if str_len(tail) == 0 { return base_mod }
    return base_mod + "." + tail
}

fn _py_resolve_reexport(idx: PyLibIndex, qname: str) -> str {
    ldot := str_rfind(qname, ".")
    if ldot <= 0 { return qname }
    mod_q := str_slice(qname, 0, ldot)
    sym := str_slice(qname, ldot + 1, str_len(qname))
    midx := smap_get_i64(idx.mod_qname_map, mod_q, -1)
    if midx < 0 { return qname }
    is_pkg := dvec_get(idx.mod_is_pkg, midx, 0) != 0
    mut ii := 0
    while ii < dvec_len(idx.imp_mod_idx) {
        if dvec_get(idx.imp_mod_idx, ii, -1) == midx {
            isym := svec_get(idx.imp_symbol, ii)
            ial := svec_get(idx.imp_alias, ii)
            if str_eq(ial, sym) or (str_len(ial) == 0 and str_eq(isym, sym)) {
                raw_target_mod := svec_get(idx.imp_module, ii)
                res_mod := _py_resolve_rel_import(mod_q, is_pkg, raw_target_mod)
                return res_mod + "." + isym
            }
        }
        ii += 1
    }
    return qname
}

fn py_get_symbol_json(idx: PyLibIndex, symbol_or_qname: str, include_source: bool = true) -> str {
    resolved_q := _py_resolve_reexport(idx, symbol_or_qname)
    // 1. Check exact / short function match
    mut fidx := smap_get_i64(idx.fn_qname_map, symbol_or_qname, -1)
    if fidx < 0 and not str_eq(resolved_q, symbol_or_qname) {
        fidx = smap_get_i64(idx.fn_qname_map, resolved_q, -1)
    }
    if fidx < 0 {
        mut fi := 0
        while fi < svec_len(idx.fn_name) {
            if str_eq(svec_get(idx.fn_name, fi), symbol_or_qname) { fidx = fi; break }
            fi += 1
        }
    }
    if fidx >= 0 {
        midx := dvec_get(idx.fn_mod_idx, fidx, 0)
        fflags := dvec_get(idx.fn_flags, fidx, 0)
        sl := dvec_get(idx.fn_dec_start_line, fidx, dvec_get(idx.fn_start_line, fidx, 1))
        el := dvec_get(idx.fn_end_line, fidx, sl)
        mpath := svec_get(idx.mod_file_path, midx)
        mq := svec_get(idx.mod_qname, midx)
        mut out := mbuf_new(2048)
        mbuf_push_str(mut out, "{\"kind\":")
        mbuf_push_json_str(mut out, _py_fn_kind_label(fflags))
        mbuf_push_str(mut out, ",\"name\":")
        mbuf_push_json_str(mut out, svec_get(idx.fn_name, fidx))
        mbuf_push_str(mut out, ",\"qname\":")
        mbuf_push_json_str(mut out, svec_get(idx.fn_qname, fidx))
        mbuf_push_str(mut out, ",\"module\":")
        mbuf_push_json_str(mut out, mq)
        mbuf_push_str(mut out, ",\"file\":")
        mbuf_push_json_str(mut out, mpath)
        mbuf_push_str(mut out, f",\"startLine\":{sl},\"endLine\":{el}")
        mbuf_push_str(mut out, ",\"isAsync\":")
        mbuf_push_str(mut out, if (fflags & py_flag_async()) != 0 { "true" } else { "false" })
        mbuf_push_str(mut out, ",\"signature\":")
        mbuf_push_json_str(mut out, svec_get(idx.fn_sig_str, fidx))
        mbuf_push_str(mut out, ",\"returnType\":")
        mbuf_push_json_str(mut out, svec_get(idx.fn_ret_type, fidx))
        mbuf_push_str(mut out, ",\"decorators\":")
        mbuf_push_json_str(mut out, svec_get(idx.fn_decorators, fidx))
        mbuf_push_str(mut out, ",\"doc\":")
        mbuf_push_json_str(mut out, svec_get(idx.fn_doc, fidx))
        mbuf_push_str(mut out, ",\"summary\":")
        mbuf_push_json_str(mut out, svec_get(idx.fn_doc_summary, fidx))
        mbuf_push_str(mut out, ",\"returnsDoc\":")
        mbuf_push_json_str(mut out, svec_get(idx.fn_doc_returns, fidx))
        mbuf_push_str(mut out, ",\"raisesDoc\":")
        mbuf_push_json_str(mut out, svec_get(idx.fn_doc_raises, fidx))

        // Parameters array
        mbuf_push_str(mut out, ",\"parameters\":[")
        pstart := dvec_get(idx.fn_param_start, fidx, 0)
        pcnt := dvec_get(idx.fn_param_count, fidx, 0)
        mut pi := 0
        while pi < pcnt {
            p := pstart + pi
            if pi > 0 { mbuf_push(mut out, 44) }
            mbuf_push_str(mut out, "{\"name\":")
            mbuf_push_json_str(mut out, svec_get(idx.prm_name, p))
            mbuf_push_str(mut out, ",\"type\":")
            mbuf_push_json_str(mut out, svec_get(idx.prm_type, p))
            mbuf_push_str(mut out, ",\"default\":")
            mbuf_push_json_str(mut out, svec_get(idx.prm_default, p))
            mbuf_push_str(mut out, ",\"hasDefault\":")
            mbuf_push_str(mut out, if dvec_get(idx.prm_has_default, p, 0) != 0 { "true" } else { "false" })
            mbuf_push_str(mut out, ",\"kind\":")
            mbuf_push_json_str(mut out, _py_param_kind_label(dvec_get(idx.prm_kind, p, 1)))
            mbuf_push_str(mut out, ",\"doc\":")
            mbuf_push_json_str(mut out, svec_get(idx.prm_doc, p))
            mbuf_push(mut out, 125)
            pi += 1
        }
        mbuf_push(mut out, 93)
        mbuf_push_str(mut out, ",\"inputSchema\":")
        mbuf_push_str(mut out, py_func_to_mcp_schema(idx, fidx))
        ret_t := svec_get(idx.fn_ret_type, fidx)
        if str_len(ret_t) > 0 and not str_eq(ret_t, "None") {
            mbuf_push_str(mut out, ",\"outputSchema\":")
            mbuf_push_str(mut out, py_type_to_json_schema_indexed(idx, ret_t, svec_get(idx.fn_doc_returns, fidx), "", false, 0))
        }
        if include_source {
            src_txt := py_get_source_lines(idx, mq, sl, el, true) or ""
            mbuf_push_str(mut out, ",\"source\":")
            mbuf_push_json_str(mut out, src_txt)
        }
        mbuf_push(mut out, 125)
        return mbuf_finish(move out)
    }

    // 2. Check class match
    mut cidx := _py_find_class_by_name(idx, symbol_or_qname)
    if cidx < 0 and not str_eq(resolved_q, symbol_or_qname) {
        cidx = _py_find_class_by_name(idx, resolved_q)
    }
    if cidx >= 0 {
        midx := dvec_get(idx.cls_mod_idx, cidx, 0)
        sl := dvec_get(idx.cls_start_line, cidx, 1)
        el := dvec_get(idx.cls_end_line, cidx, sl)
        mq := svec_get(idx.mod_qname, midx)
        mut out := mbuf_new(2048)
        mbuf_push_str(mut out, "{\"kind\":")
        mbuf_push_json_str(mut out, svec_get(idx.cls_kind, cidx))
        mbuf_push_str(mut out, ",\"name\":")
        mbuf_push_json_str(mut out, svec_get(idx.cls_name, cidx))
        mbuf_push_str(mut out, ",\"qname\":")
        mbuf_push_json_str(mut out, svec_get(idx.cls_qname, cidx))
        mbuf_push_str(mut out, ",\"module\":")
        mbuf_push_json_str(mut out, mq)
        mbuf_push_str(mut out, ",\"bases\":")
        mbuf_push_json_str(mut out, svec_get(idx.cls_bases, cidx))
        mbuf_push_str(mut out, ",\"decorators\":")
        mbuf_push_json_str(mut out, svec_get(idx.cls_decorators, cidx))
        mbuf_push_str(mut out, ",\"doc\":")
        mbuf_push_json_str(mut out, svec_get(idx.cls_doc, cidx))
        mbuf_push_str(mut out, f",\"startLine\":{sl},\"endLine\":{el}")
        mbuf_push_str(mut out, ",\"fields\":[")
        mut fn_v := 0
        mut vi := 0
        while vi < svec_len(idx.var_name) {
            if dvec_get(idx.var_cls_idx, vi, -1) == cidx {
                if fn_v > 0 { mbuf_push(mut out, 44) }
                mbuf_push_str(mut out, "{\"name\":")
                mbuf_push_json_str(mut out, svec_get(idx.var_name, vi))
                mbuf_push_str(mut out, ",\"type\":")
                mbuf_push_json_str(mut out, svec_get(idx.var_type, vi))
                mbuf_push_str(mut out, ",\"default\":")
                mbuf_push_json_str(mut out, svec_get(idx.var_default, vi))
                mbuf_push_str(mut out, ",\"doc\":")
                mbuf_push_json_str(mut out, svec_get(idx.var_doc, vi))
                mbuf_push(mut out, 125)
                fn_v += 1
            }
            vi += 1
        }
        mbuf_push_str(mut out, "],\"methods\":[")
        mut mn := 0
        mut fi := 0
        while fi < svec_len(idx.fn_name) {
            if dvec_get(idx.fn_cls_idx, fi, -1) == cidx {
                if mn > 0 { mbuf_push(mut out, 44) }
                mbuf_push_str(mut out, "{\"name\":")
                mbuf_push_json_str(mut out, svec_get(idx.fn_name, fi))
                mbuf_push_str(mut out, ",\"qname\":")
                mbuf_push_json_str(mut out, svec_get(idx.fn_qname, fi))
                mbuf_push_str(mut out, ",\"signature\":")
                mbuf_push_json_str(mut out, svec_get(idx.fn_sig_str, fi))
                mbuf_push_str(mut out, ",\"summary\":")
                mbuf_push_json_str(mut out, svec_get(idx.fn_doc_summary, fi))
                mbuf_push(mut out, 125)
                mn += 1
            }
            fi += 1
        }
        mbuf_push(mut out, 93)
        if include_source {
            src_txt := py_get_source_lines(idx, mq, sl, el, true) or ""
            mbuf_push_str(mut out, ",\"source\":")
            mbuf_push_json_str(mut out, src_txt)
        }
        mbuf_push(mut out, 125)
        return mbuf_finish(move out)
    }

    // 3. Check module match
    if smap_has(idx.mod_qname_map, symbol_or_qname) {
        return py_inspect_module_json(idx, symbol_or_qname, true)
    }
    return "{\"error\":\"Symbol not found\"}"
}

fn py_search_symbols_json(idx: PyLibIndex, query: str, pkg_filter: str = "", kind_filter: str = "all", limit: i64 = 25) -> str {
    q := str_trim(query)
    qlow := str_to_lower(q)
    mut lim := limit
    if lim < 1 { lim = 1 }
    if lim > 200 { lim = 200 }
    pidx_filter := if str_len(pkg_filter) > 0 { smap_get_i64(idx.pkg_map, pkg_filter, -999) } else { -1 }

    // Collect `(score, is_class(1/0), item_idx)`
    mut cand_scores := dvec_new(64)
    mut cand_kinds := dvec_new(64)
    mut cand_idxs := dvec_new(64)

    // Score classes
    if str_eq(kind_filter, "all") or str_eq(kind_filter, "class") or str_eq(kind_filter, "dataclass") or str_eq(kind_filter, "pydantic_model") or str_eq(kind_filter, "enum") or str_eq(kind_filter, "typed_dict") {
        mut ci := 0
        while ci < svec_len(idx.cls_name) {
            midx := dvec_get(idx.cls_mod_idx, ci, -1)
            if pidx_filter == -1 or (midx >= 0 and dvec_get(idx.mod_pkg_idx, midx, -1) == pidx_filter) {
                ck := svec_get(idx.cls_kind, ci)
                if str_eq(kind_filter, "all") or str_eq(kind_filter, "class") or str_eq(kind_filter, ck) {
                    nm := svec_get(idx.cls_name, ci)
                    qn := svec_get(idx.cls_qname, ci)
                    nlow := str_to_lower(nm)
                    qnl := str_to_lower(qn)
                    mut sc := 0
                    if str_len(qlow) == 0 { sc = 10 }
                    else if str_eq(nm, q) { sc = 100 }
                    else if str_eq(nlow, qlow) { sc = 90 }
                    else if str_eq(qnl, qlow) { sc = 85 }
                    else if str_starts_with(nlow, qlow) { sc = 70 }
                    else if str_contains(nlow, qlow) { sc = 55 }
                    else if str_contains(qnl, qlow) { sc = 40 }
                    else if str_contains(str_to_lower(svec_get(idx.cls_doc, ci)), qlow) { sc = 20 }
                    if sc > 0 {
                        dvec_push(mut cand_scores, sc)
                        dvec_push(mut cand_kinds, 1)
                        dvec_push(mut cand_idxs, ci)
                    }
                }
            }
            ci += 1
        }
    }

    // Score functions & methods
    if not str_eq(kind_filter, "class") and not str_eq(kind_filter, "dataclass") and not str_eq(kind_filter, "pydantic_model") and not str_eq(kind_filter, "enum") {
        mut fi := 0
        while fi < svec_len(idx.fn_name) {
            midx := dvec_get(idx.fn_mod_idx, fi, -1)
            if pidx_filter == -1 or (midx >= 0 and dvec_get(idx.mod_pkg_idx, midx, -1) == pidx_filter) {
                fflags := dvec_get(idx.fn_flags, fi, 0)
                klabel := _py_fn_kind_label(fflags)
                ok_k := str_eq(kind_filter, "all") or str_eq(kind_filter, klabel) or (str_eq(kind_filter, "async") and (fflags & py_flag_async()) != 0) or (str_eq(kind_filter, "function") and (fflags & py_flag_method()) == 0)
                if ok_k {
                    nm := svec_get(idx.fn_name, fi)
                    qn := svec_get(idx.fn_qname, fi)
                    nlow := str_to_lower(nm)
                    qnl := str_to_lower(qn)
                    mut sc := 0
                    if str_len(qlow) == 0 { sc = 10 }
                    else if str_eq(nm, q) { sc = 100 }
                    else if str_eq(nlow, qlow) { sc = 90 }
                    else if str_eq(qnl, qlow) { sc = 85 }
                    else if str_starts_with(nlow, qlow) { sc = 70 }
                    else if str_contains(nlow, qlow) { sc = 55 }
                    else if str_contains(qnl, qlow) { sc = 40 }
                    else if str_contains(str_to_lower(svec_get(idx.fn_sig_str, fi)), qlow) { sc = 30 }
                    else if str_contains(str_to_lower(svec_get(idx.fn_doc, fi)), qlow) { sc = 20 }
                    if sc > 0 {
                        dvec_push(mut cand_scores, sc)
                        dvec_push(mut cand_kinds, 2)
                        dvec_push(mut cand_idxs, fi)
                    }
                }
            }
            fi += 1
        }
    }

    // Selection top-K (clean & fast for typical symbol counts)
    total := dvec_len(cand_scores)
    mut used := dvec_new(total + 4)
    mut ui := 0
    while ui < total { dvec_push(mut used, 0); ui += 1 }

    mut out := mbuf_new(2048)
    mbuf_push_str(mut out, "{\"query\":")
    mbuf_push_json_str(mut out, q)
    mbuf_push_str(mut out, ",\"results\":[")
    mut picked := 0
    while picked < lim and picked < total {
        mut best_pos := -1
        mut best_sc := -1
        mut j := 0
        while j < total {
            if dvec_get(used, j, 0) == 0 {
                sc := dvec_get(cand_scores, j, 0)
                if sc > best_sc { best_sc = sc; best_pos = j }
            }
            j += 1
        }
        if best_pos < 0 { break }
        dvec_set(mut used, best_pos, 1)
        ck := dvec_get(cand_kinds, best_pos, 0)
        cidx := dvec_get(cand_idxs, best_pos, 0)
        if picked > 0 { mbuf_push(mut out, 44) }
        if ck == 1 {
            midx := dvec_get(idx.cls_mod_idx, cidx, 0)
            mbuf_push_str(mut out, "{\"kind\":")
            mbuf_push_json_str(mut out, svec_get(idx.cls_kind, cidx))
            mbuf_push_str(mut out, ",\"name\":")
            mbuf_push_json_str(mut out, svec_get(idx.cls_name, cidx))
            mbuf_push_str(mut out, ",\"qname\":")
            mbuf_push_json_str(mut out, svec_get(idx.cls_qname, cidx))
            mbuf_push_str(mut out, ",\"module\":")
            mbuf_push_json_str(mut out, svec_get(idx.mod_qname, midx))
            mbuf_push_str(mut out, ",\"bases\":")
            mbuf_push_json_str(mut out, svec_get(idx.cls_bases, cidx))
            mbuf_push_str(mut out, f",\"line\":{dvec_get(idx.cls_start_line, cidx, 1)},\"score\":{best_sc}}}")
        } else {
            midx := dvec_get(idx.fn_mod_idx, cidx, 0)
            fflags := dvec_get(idx.fn_flags, cidx, 0)
            mbuf_push_str(mut out, "{\"kind\":")
            mbuf_push_json_str(mut out, _py_fn_kind_label(fflags))
            mbuf_push_str(mut out, ",\"name\":")
            mbuf_push_json_str(mut out, svec_get(idx.fn_name, cidx))
            mbuf_push_str(mut out, ",\"qname\":")
            mbuf_push_json_str(mut out, svec_get(idx.fn_qname, cidx))
            mbuf_push_str(mut out, ",\"module\":")
            mbuf_push_json_str(mut out, svec_get(idx.mod_qname, midx))
            mbuf_push_str(mut out, ",\"signature\":")
            mbuf_push_json_str(mut out, svec_get(idx.fn_sig_str, cidx))
            mbuf_push_str(mut out, ",\"summary\":")
            mbuf_push_json_str(mut out, svec_get(idx.fn_doc_summary, cidx))
            mbuf_push_str(mut out, f",\"line\":{dvec_get(idx.fn_start_line, cidx, 1)},\"score\":{best_sc}}}")
        }
        picked += 1
    }
    mbuf_push_str(mut out, f"],\"totalMatches\":{total},\"returned\":{picked}}}")
    dvec_free(move used)
    dvec_free(move cand_scores)
    dvec_free(move cand_kinds)
    dvec_free(move cand_idxs)
    return mbuf_finish(move out)
}

fn py_get_class_hierarchy_json(idx: PyLibIndex, class_name: str) -> str {
    mut cidx := _py_find_class_by_name(idx, class_name)
    if cidx < 0 {
        rq := _py_resolve_reexport(idx, class_name)
        if not str_eq(rq, class_name) { cidx = _py_find_class_by_name(idx, rq) }
    }
    if cidx < 0 { return "{\"error\":\"Class not found\"}" }
    mut out := mbuf_new(2048)
    mbuf_push_str(mut out, "{\"class\":")
    mbuf_push_json_str(mut out, svec_get(idx.cls_qname, cidx))
    mbuf_push_str(mut out, ",\"kind\":")
    mbuf_push_json_str(mut out, svec_get(idx.cls_kind, cidx))
    mbuf_push_str(mut out, ",\"basesRaw\":")
    mbuf_push_json_str(mut out, svec_get(idx.cls_bases, cidx))
    mbuf_push_str(mut out, ",\"resolvedBases\":[")

    bases_raw := svec_get(idx.cls_bases, cidx)
    mut bparts := _py_split_top_level(bases_raw, 44)
    mut b_n := 0
    mut bi := 0
    while bi < svec_len(bparts) {
        b_item := str_trim(svec_get(bparts, bi))
        if str_len(b_item) > 0 and not str_contains(b_item, "=") {
            mut b_short := b_item
            br := str_find_byte(b_short, 91, 0)
            if br > 0 { b_short = str_trim(str_slice(b_short, 0, br)) }
            b_idx := _py_find_class_by_name(idx, b_short)
            if b_n > 0 { mbuf_push(mut out, 44) }
            mbuf_push_str(mut out, "{\"name\":")
            mbuf_push_json_str(mut out, b_item)
            mbuf_push_str(mut out, ",\"indexed\":")
            mbuf_push_str(mut out, if b_idx >= 0 { "true" } else { "false" })
            if b_idx >= 0 {
                mbuf_push_str(mut out, ",\"qname\":")
                mbuf_push_json_str(mut out, svec_get(idx.cls_qname, b_idx))
                mbuf_push_str(mut out, ",\"methods\":[")
                mut bm_n := 0
                mut fi := 0
                while fi < svec_len(idx.fn_name) {
                    if dvec_get(idx.fn_cls_idx, fi, -1) == b_idx {
                        if bm_n > 0 { mbuf_push(mut out, 44) }
                        mbuf_push_json_str(mut out, svec_get(idx.fn_name, fi))
                        bm_n += 1
                    }
                    fi += 1
                }
                mbuf_push(mut out, 93)
            }
            mbuf_push(mut out, 125)
            b_n += 1
        }
        bi += 1
    }
    svec_free(move bparts)

    // Subclasses in index
    cname := svec_get(idx.cls_name, cidx)
    mbuf_push_str(mut out, "],\"subclasses\":[")
    mut sub_n := 0
    mut sci := 0
    while sci < svec_len(idx.cls_name) {
        if sci != cidx and str_contains(svec_get(idx.cls_bases, sci), cname) {
            if sub_n > 0 { mbuf_push(mut out, 44) }
            mbuf_push_json_str(mut out, svec_get(idx.cls_qname, sci))
            sub_n += 1
        }
        sci += 1
    }

    // Own fields & methods
    mbuf_push_str(mut out, "],\"ownFields\":[")
    mut fl_n := 0
    mut vi := 0
    while vi < svec_len(idx.var_name) {
        if dvec_get(idx.var_cls_idx, vi, -1) == cidx {
            if fl_n > 0 { mbuf_push(mut out, 44) }
            mbuf_push_str(mut out, "{\"name\":")
            mbuf_push_json_str(mut out, svec_get(idx.var_name, vi))
            mbuf_push_str(mut out, ",\"type\":")
            mbuf_push_json_str(mut out, svec_get(idx.var_type, vi))
            mbuf_push(mut out, 125)
            fl_n += 1
        }
        vi += 1
    }
    mbuf_push_str(mut out, "],\"ownMethods\":[")
    mut om_n := 0
    mut fi := 0
    while fi < svec_len(idx.fn_name) {
        if dvec_get(idx.fn_cls_idx, fi, -1) == cidx {
            if om_n > 0 { mbuf_push(mut out, 44) }
            mbuf_push_str(mut out, "{\"name\":")
            mbuf_push_json_str(mut out, svec_get(idx.fn_name, fi))
            mbuf_push_str(mut out, ",\"signature\":")
            mbuf_push_json_str(mut out, svec_get(idx.fn_sig_str, fi))
            mbuf_push(mut out, 125)
            om_n += 1
        }
        fi += 1
    }
    mbuf_push_str(mut out, "]}")
    return mbuf_finish(move out)
}

fn _py_contains_ident_token(line: str, sym: str) -> bool {
    sn := str_len(sym)
    ln := str_len(line)
    if sn == 0 or ln < sn { return false }
    mut pos := 0
    while pos <= ln - sn {
        hit := str_find(line, sym, pos)
        if hit < 0 { return false }
        left_ok := hit == 0 or not _py_is_ident_char(str_byte(line, hit - 1))
        right_ok := hit + sn == ln or not _py_is_ident_char(str_byte(line, hit + sn))
        if left_ok and right_ok { return true }
        pos = hit + 1
    }
    return false
}

fn py_find_references_json(idx: PyLibIndex, symbol_name: str, pkg_filter: str = "", limit: i64 = 50) -> str {
    sym := str_trim(symbol_name)
    mut lim := limit
    if lim < 1 { lim = 1 }
    if lim > 200 { lim = 200 }
    pidx_filter := if str_len(pkg_filter) > 0 { smap_get_i64(idx.pkg_map, pkg_filter, -999) } else { -1 }

    mut out := mbuf_new(2048)
    mbuf_push_str(mut out, "{\"symbol\":")
    mbuf_push_json_str(mut out, sym)
    mbuf_push_str(mut out, ",\"references\":[")
    mut hits := 0
    mut mi := 0
    while mi < svec_len(idx.mod_qname) and hits < lim {
        if pidx_filter == -1 or dvec_get(idx.mod_pkg_idx, mi, -1) == pidx_filter {
            mq := svec_get(idx.mod_qname, mi)
            src := svec_get(idx.mod_src, mi)
            if str_contains(src, sym) {
                ranges := str_split_ranges(src, 10)
                rc := str_split_count(ranges)
                mut li := 0
                while li < rc and hits < lim {
                    ln := _py_split_line_at(src, ranges, li)
                    if _py_contains_ident_token(ln, sym) {
                        tr := str_trim(ln)
                        mut rkind := "usage"
                        if str_starts_with(tr, "import ") or str_starts_with(tr, "from ") { rkind = "import" }
                        else if str_starts_with(tr, "class ") { rkind = "inherit_or_def" }
                        else if str_starts_with(tr, "@") { rkind = "decorator" }
                        else if str_starts_with(tr, "def ") or str_starts_with(tr, "async def ") { rkind = "signature" }
                        if hits > 0 { mbuf_push(mut out, 44) }
                        mbuf_push_str(mut out, "{\"module\":")
                        mbuf_push_json_str(mut out, mq)
                        mbuf_push_str(mut out, f",\"line\":{li + 1},\"kind\":")
                        mbuf_push_json_str(mut out, rkind)
                        mbuf_push_str(mut out, ",\"snippet\":")
                        mbuf_push_json_str(mut out, tr)
                        mbuf_push(mut out, 125)
                        hits += 1
                    }
                    li += 1
                }
                buf_free(move ranges)
            }
        }
        mi += 1
    }
    mbuf_push_str(mut out, f"],\"count\":{hits}}}")
    return mbuf_finish(move out)
}

// ==================== 8. FASTMCP EXTRACTOR & AXON MCP STUB GENERATOR ====================

fn _py_target_matches(idx: PyLibIndex, mod_idx: i64, target: str) -> bool {
    if str_len(target) == 0 { return true }
    mq := svec_get(idx.mod_qname, mod_idx)
    if str_eq(mq, target) { return true }
    pidx := dvec_get(idx.mod_pkg_idx, mod_idx, -1)
    if pidx >= 0 and str_eq(svec_get(idx.pkg_names, pidx), target) { return true }
    return str_starts_with(mq, target + ".")
}

fn _py_extract_dec_arg_pos0(dec_line: str) -> str {
    op := str_find_byte(dec_line, 40, 0)
    if op < 0 { return "" }
    n := str_len(dec_line)
    p := _py_skip_ws(dec_line, op + 1, n);
    (q, is_tr, oend) := _py_check_string_open(dec_line, p, n)
    if q == 0 { return "" }
    (cend, closed) := _py_scan_string_body(dec_line, oend, n, q, is_tr)
    if not closed { return "" }
    return _py_unquote_literal(str_slice(dec_line, p, cend))
}

fn py_extract_mcp_definitions_json(idx: PyLibIndex, target_pkg_or_mod: str, only_decorated: bool = false) -> str {
    mut tools_b := mbuf_new(2048)
    mut res_b := mbuf_new(512)
    mut prm_b := mbuf_new(512)
    mut tc := 0
    mut rc := 0
    mut pc := 0

    mut fi := 0
    while fi < svec_len(idx.fn_name) {
        midx := dvec_get(idx.fn_mod_idx, fi, -1)
        if midx >= 0 and _py_target_matches(idx, midx, target_pkg_or_mod) {
            fflags := dvec_get(idx.fn_flags, fi, 0)
            decs := svec_get(idx.fn_decorators, fi)
            fname := svec_get(idx.fn_name, fi)
            mut doc_s := svec_get(idx.fn_doc_summary, fi)
            if str_len(doc_s) == 0 { doc_s = f"Python function {svec_get(idx.fn_qname, fi)}" }

            if (fflags & py_flag_mcp_resource()) != 0 {
                mut uri := _py_extract_kw_str(decs, "uri")
                if str_len(uri) == 0 { uri = _py_extract_dec_arg_pos0(decs) }
                if str_len(uri) == 0 { uri = f"py://{fname}" }
                mut rname := _py_extract_kw_str(decs, "name")
                if str_len(rname) == 0 { rname = fname }
                mut rdesc := _py_extract_kw_str(decs, "description")
                if str_len(rdesc) == 0 { rdesc = doc_s }
                mime := _py_extract_kw_str(decs, "mime_type")
                if rc > 0 { mbuf_push(mut res_b, 44) }
                mbuf_push_str(mut res_b, "{\"uriTemplate\":")
                mbuf_push_json_str(mut res_b, uri)
                mbuf_push_str(mut res_b, ",\"name\":")
                mbuf_push_json_str(mut res_b, rname)
                mbuf_push_str(mut res_b, ",\"description\":")
                mbuf_push_json_str(mut res_b, rdesc)
                mbuf_push_str(mut res_b, ",\"mimeType\":")
                mbuf_push_json_str(mut res_b, if str_len(mime) > 0 { mime } else { "text/plain" })
                mbuf_push(mut res_b, 125)
                rc += 1
            } else if (fflags & py_flag_mcp_prompt()) != 0 {
                mut pname := _py_extract_kw_str(decs, "name")
                if str_len(pname) == 0 { pname = fname }
                mut pdesc := _py_extract_kw_str(decs, "description")
                if str_len(pdesc) == 0 { pdesc = doc_s }
                if pc > 0 { mbuf_push(mut prm_b, 44) }
                mbuf_push_str(mut prm_b, "{\"name\":")
                mbuf_push_json_str(mut prm_b, pname)
                mbuf_push_str(mut prm_b, ",\"description\":")
                mbuf_push_json_str(mut prm_b, pdesc)
                mbuf_push_str(mut prm_b, ",\"arguments\":[")
                pstart := dvec_get(idx.fn_param_start, fi, 0)
                pcnt := dvec_get(idx.fn_param_count, fi, 0)
                mut pi := 0
                mut printed_a := 0
                while pi < pcnt {
                    ap_name := svec_get(idx.prm_name, pstart + pi)
                    ap_doc := svec_get(idx.prm_doc, pstart + pi)
                    ap_req := dvec_get(idx.prm_has_default, pstart + pi, 0) == 0
                    if printed_a > 0 { mbuf_push(mut prm_b, 44) }
                    mbuf_push_str(mut prm_b, mcp_prompt_arg_def(ap_name, ap_doc, ap_req))
                    printed_a += 1
                    pi += 1
                }
                mbuf_push_str(mut prm_b, "]}")
                pc += 1
            } else {
                is_mcp_t := (fflags & py_flag_mcp_tool()) != 0
                is_pub_fn := (fflags & (py_flag_private() | py_flag_dunder() | py_flag_method())) == 0
                if is_mcp_t or (not only_decorated and is_pub_fn) {
                    mut tname := _py_extract_kw_str(decs, "name")
                    if str_len(tname) == 0 { tname = fname }
                    mut tdesc := _py_extract_kw_str(decs, "description")
                    if str_len(tdesc) == 0 { tdesc = doc_s }
                    if tc > 0 { mbuf_push(mut tools_b, 44) }
                    mbuf_push_str(mut tools_b, "{\"name\":")
                    mbuf_push_json_str(mut tools_b, tname)
                    mbuf_push_str(mut tools_b, ",\"description\":")
                    mbuf_push_json_str(mut tools_b, tdesc)
                    mbuf_push_str(mut tools_b, ",\"pythonQname\":")
                    mbuf_push_json_str(mut tools_b, svec_get(idx.fn_qname, fi))
                    mbuf_push_str(mut tools_b, ",\"decoratedTool\":")
                    mbuf_push_str(mut tools_b, if is_mcp_t { "true" } else { "false" })
                    mbuf_push_str(mut tools_b, ",\"inputSchema\":")
                    mbuf_push_str(mut tools_b, py_func_to_mcp_schema(idx, fi))
                    ret_t := svec_get(idx.fn_ret_type, fi)
                    if str_len(ret_t) > 0 and not str_eq(ret_t, "None") {
                        mbuf_push_str(mut tools_b, ",\"outputSchema\":")
                        mbuf_push_str(mut tools_b, py_type_to_json_schema_indexed(idx, ret_t, svec_get(idx.fn_doc_returns, fi), "", false, 0))
                    }
                    mbuf_push(mut tools_b, 125)
                    tc += 1
                }
            }
        }
        fi += 1
    }

    mut out := mbuf_new(mbuf_len(tools_b) + mbuf_len(res_b) + mbuf_len(prm_b) + 256)
    mbuf_push_str(mut out, "{\"target\":")
    mbuf_push_json_str(mut out, target_pkg_or_mod)
    mbuf_push_str(mut out, ",\"tools\":[")
    mbuf_push_str(mut out, mbuf_as_str(tools_b))
    mbuf_push_str(mut out, "],\"resources\":[")
    mbuf_push_str(mut out, mbuf_as_str(res_b))
    mbuf_push_str(mut out, "],\"prompts\":[")
    mbuf_push_str(mut out, mbuf_as_str(prm_b))
    mbuf_push_str(mut out, "]}")
    mbuf_free(move tools_b)
    mbuf_free(move res_b)
    mbuf_free(move prm_b)
    return mbuf_finish(move out)
}

fn _py_push_axon_str_escaped(mut out: McpBuf, s: str) {
    n := str_len(s)
    mut i := 0
    while i < n {
        b := str_byte(s, i)
        if b == 34 { mbuf_push_str(mut out, "\\\"") }
        else if b == 92 { mbuf_push_str(mut out, "\\\\") }
        else if b == 10 { mbuf_push_str(mut out, "\\n") }
        else if b == 13 { mbuf_push_str(mut out, "\\r") }
        else if b == 9 { mbuf_push_str(mut out, "\\t") }
        else if b < 32 { mbuf_push(mut out, 32) }
        else { mbuf_push(mut out, b) }
        i += 1
    }
}

fn py_generate_axon_mcp_stub(idx: PyLibIndex, target_pkg_or_mod: str, only_decorated: bool = false) -> str {
    mut out := mbuf_new(4096)
    mbuf_push_str(mut out, "// Auto-generated Pure Axon MCP Server from Python source\nuse std::str\nuse std::mcp\n\nfn main() -> i32 {\n")
    mbuf_push_str(mut out, "    mut srv := mcp_server_new(\"")
    _py_push_axon_str_escaped(mut out, target_pkg_or_mod)
    mbuf_push_str(mut out, "-mcp\", \"1.0.0\", \"Auto-generated from Python library source\")\n")

    mut fi := 0
    while fi < svec_len(idx.fn_name) {
        midx := dvec_get(idx.fn_mod_idx, fi, -1)
        if midx >= 0 and _py_target_matches(idx, midx, target_pkg_or_mod) {
            fflags := dvec_get(idx.fn_flags, fi, 0)
            is_mcp_t := (fflags & py_flag_mcp_tool()) != 0
            is_pub := (fflags & (py_flag_private() | py_flag_dunder() | py_flag_method())) == 0
            if is_mcp_t or (not only_decorated and is_pub) {
                fname := svec_get(idx.fn_name, fi)
                decs := svec_get(idx.fn_decorators, fi)
                mut tname := _py_extract_kw_str(decs, "name")
                if str_len(tname) == 0 { tname = fname }
                mut tdesc := _py_extract_kw_str(decs, "description")
                if str_len(tdesc) == 0 { tdesc = svec_get(idx.fn_doc_summary, fi) }
                if str_len(tdesc) == 0 { tdesc = svec_get(idx.fn_qname, fi) }
                schema := py_func_to_mcp_schema(idx, fi)
                mbuf_push_str(mut out, "    _ := mcp_add_tool(mut srv, \"")
                _py_push_axon_str_escaped(mut out, tname)
                mbuf_push_str(mut out, "\", \"")
                _py_push_axon_str_escaped(mut out, tdesc)
                mbuf_push_str(mut out, "\", \"")
                _py_push_axon_str_escaped(mut out, schema)
                mbuf_push_str(mut out, "\")\n")
            }
        }
        fi += 1
    }

    mbuf_push_str(mut out, "\n    line_buf := buf_new(1048576)\n")
    mbuf_push_str(mut out, "    while true {\n")
    mbuf_push_str(mut out, "        raw := mcp_stdio_read_next(line_buf) or \"\"\n")
    mbuf_push_str(mut out, "        if str_len(raw) == 0 { break }\n")
    mbuf_push_str(mut out, "        req := mcp_parse_request(raw)\n")
    mbuf_push_str(mut out, "        (handled, reply) := mcp_handle_builtin(mut srv, req)\n")
    mbuf_push_str(mut out, "        if handled {\n")
    mbuf_push_str(mut out, "            mcp_stdio_send(reply)\n")
    mbuf_push_str(mut out, "        } else if str_eq(req.method, \"tools/call\") {\n")
    mbuf_push_str(mut out, "            mcp_stdio_send(mcp_ok_resp(req.raw_id, mcp_tool_ok_text(f\"Called {req.tool_name} args={req.args_json}\")))\n")
    mbuf_push_str(mut out, "        }\n")
    mbuf_push_str(mut out, "    }\n")
    mbuf_push_str(mut out, "    buf_free(move line_buf)\n")
    mbuf_push_str(mut out, "    mcp_server_free(move srv)\n")
    mbuf_push_str(mut out, "    return 0\n}\n")
    return mbuf_finish(move out)
}

// ==================== 9. TURNKEY `PyMcpServer` (PYTHON-SOURCE MCP SERVER) ====================

struct PyMcpServer {
    srv: McpServer
    idx: PyLibIndex
    http: McpHttpState
}

fn _py_register_builtin_mcp_surface(mut srv: McpServer) {
    ro := mcp_tool_annotations_json(true, false, true, false)

    mut s1 := mcp_schema_new(false)
    mcp_schema_add_str(mut s1, "filter", "Optional substring filter on package name", false, "", false)
    _ := mcp_add_tool_ex(mut srv, "py_list_packages", "List Python Packages", "List indexed Python libraries/packages with versions, summaries, roots, and symbol counts.", mcp_schema_finish(move s1), "", ro)

    mut s2 := mcp_schema_new(false)
    mcp_schema_add_str(mut s2, "package", "Python package name (empty to list all)", true, "", false)
    mcp_schema_add_bool(mut s2, "include_private", "Include private _modules", false, false, true)
    _ := mcp_add_tool_ex(mut srv, "py_list_modules", "List Python Modules", "List all .py/.pyi modules and subpackages in an indexed Python library.", mcp_schema_finish(move s2), "", ro)

    mut s3 := mcp_schema_new(false)
    mcp_schema_add_str(mut s3, "module", "Dotted Python module name (e.g. 'mypkg.client')", true, "", false)
    mcp_schema_add_bool(mut s3, "include_private", "Include private _symbols", false, false, true)
    _ := mcp_add_tool_ex(mut srv, "py_inspect_module", "Inspect Python Module", "Inspect imports, exports (__all__), constants, classes, and functions of a Python module.", mcp_schema_finish(move s3), "", ro)

    mut s4 := mcp_schema_new(false)
    mcp_schema_add_str(mut s4, "query", "Symbol name, qualified name, signature, or docstring query", true, "", false)
    mcp_schema_add_str(mut s4, "package", "Optional package filter", false, "", false)
    mcp_schema_add_str(mut s4, "kind", "Filter kind: all, class, function, method, async, dataclass, pydantic_model, enum, mcp_tool", false, "all", true)
    mcp_schema_add_int(mut s4, "limit", "Maximum results (1..200)", false, 25, true, 1, 200, true)
    _ := mcp_add_tool_ex(mut srv, "py_search_symbols", "Search Python Symbols", "Search classes, functions, methods, Pydantic models, dataclasses, and docstrings across indexed Python libraries.", mcp_schema_finish(move s4), "", ro)

    mut s5 := mcp_schema_new(false)
    mcp_schema_add_str(mut s5, "symbol", "Qualified or short Python symbol name (e.g. 'pkg.mod.Class.method')", true, "", false)
    mcp_schema_add_bool(mut s5, "include_source", "Include line-numbered source slice", false, true, true)
    _ := mcp_add_tool_ex(mut srv, "py_get_symbol", "Inspect Python Symbol", "Get full inspect.signature, type hints, parsed Google/NumPy/Sphinx docstring, JSON Schema, and exact source of a Python symbol.", mcp_schema_finish(move s5), "", ro)

    mut s6 := mcp_schema_new(false)
    mcp_schema_add_str(mut s6, "module", "Dotted module name or indexed file path", true, "", false)
    mcp_schema_add_int(mut s6, "start_line", "1-based start line", false, 1, true, 1, 1000000, true)
    mcp_schema_add_int(mut s6, "end_line", "1-based end line", false, 200, true, 1, 1000000, true)
    mcp_schema_add_bool(mut s6, "numbered", "Prefix each line with line number", false, true, true)
    _ := mcp_add_tool_ex(mut srv, "py_get_source", "Read Python Source", "Read line-numbered source code lines from an indexed Python library module.", mcp_schema_finish(move s6), "", ro)

    mut s7 := mcp_schema_new(false)
    mcp_schema_add_str(mut s7, "class_name", "Qualified or short Python class name", true, "", false)
    _ := mcp_add_tool_ex(mut srv, "py_get_class_hierarchy", "Inspect Class Hierarchy", "Resolve base classes, subclasses, typed fields, and methods of a Python class.", mcp_schema_finish(move s7), "", ro)

    mut s8 := mcp_schema_new(false)
    mcp_schema_add_str(mut s8, "symbol", "Python identifier to trace across indexed files", true, "", false)
    mcp_schema_add_str(mut s8, "package", "Optional package filter", false, "", false)
    mcp_schema_add_int(mut s8, "limit", "Maximum references (1..200)", false, 50, true, 1, 200, true)
    _ := mcp_add_tool_ex(mut srv, "py_find_references", "Find Python References", "Find imports, inheritance, decorators, type annotations, and call sites referencing a symbol.", mcp_schema_finish(move s8), "", ro)

    mut s9 := mcp_schema_new(false)
    mcp_schema_add_str(mut s9, "target", "Python package or module name", true, "", false)
    mcp_schema_add_bool(mut s9, "only_decorated", "Only include @mcp.tool / @mcp.resource / @mcp.prompt functions", false, false, true)
    _ := mcp_add_tool_ex(mut srv, "py_generate_mcp_manifest", "Generate MCP Manifest", "Extract @mcp.tool/@mcp.resource/@mcp.prompt definitions or synthesize MCP schemas for public Python APIs.", mcp_schema_finish(move s9), "", ro)

    mut s10 := mcp_schema_new(false)
    mcp_schema_add_str(mut s10, "target", "Python package or module name", true, "", false)
    mcp_schema_add_bool(mut s10, "only_decorated", "Only include @mcp.tool decorated functions", false, false, true)
    _ := mcp_add_tool_ex(mut srv, "py_generate_axon_stub", "Generate Axon MCP Stub", "Generate ready-to-compile pure Axon std::mcp server code wrapping an inspected Python module.", mcp_schema_finish(move s10), "", ro)

    // Resources & URI templates
    _ := mcp_add_resource(mut srv, "pylib://packages", "python_packages", "JSON list of all indexed Python packages", "application/json", "{\"packages\":[]}", false)
    _ := mcp_add_resource_template(mut srv, "pylib://{package}/metadata", "python_package_metadata", "Package METADATA, dependencies, and module list", "application/json")
    _ := mcp_add_resource_template(mut srv, "pylib://{package}/modules", "python_package_modules", "List modules in a Python package", "application/json")
    _ := mcp_add_resource_template(mut srv, "pylib://{package}/module/{module}", "python_module_source", "Full source code of a Python module", "text/x-python")
    _ := mcp_add_resource_template(mut srv, "pylib://{package}/symbol/{symbol}", "python_symbol_info", "Detailed inspection JSON and source for a Python symbol", "application/json")

    // Prompts
    a_sym := "[" + mcp_prompt_arg_def("symbol", "Qualified or short Python symbol name", true) + "]"
    _ := mcp_add_prompt(mut srv, "explain_python_api", "Explain a Python API with exact signature, parsed docstrings, and source code", a_sym)

    a_mod := "[" + mcp_prompt_arg_def("module", "Python package or module name", true) + "]"
    _ := mcp_add_prompt(mut srv, "generate_mcp_wrapper", "Generate an MCP tool wrapper from an inspected Python module", a_mod)

    a_pkg := "[" + mcp_prompt_arg_def("package", "Python package name", true) + "]"
    _ := mcp_add_prompt(mut srv, "trace_python_dependencies", "Analyze package dependencies and module imports", a_pkg)
}

fn py_mcp_server_new(server_name: str = "axon-pylib-mcp", version: str = "1.0.0") -> PyMcpServer {
    mut srv := mcp_server_new(server_name, version, "Pure Axon MCP server for deep Python library source inspection, AST/signature/docstring analysis, JSON Schema synthesis, and MCP stub generation.")
    _py_register_builtin_mcp_surface(mut srv)
    return PyMcpServer(srv = srv, idx = py_index_new(), http = mcp_http_state_new())
}

fn py_mcp_server_free(move pm: PyMcpServer) {
    mcp_server_free(move pm.srv)
    py_index_free(move pm.idx)
    mcp_http_state_free(move pm.http)
}

fn py_mcp_add_source(mut pm: PyMcpServer, pkg_name: str, mod_qname: str, file_path: str, src: str, is_stub: bool = false) -> i64 {
    return py_index_add_source(mut pm.idx, pkg_name, mod_qname, file_path, src, is_stub)
}

fn py_mcp_add_dir(mut pm: PyMcpServer, root_path: str, pkg_name_hint: str = "", max_files: i64 = 1500) -> i64 {
    return py_index_add_dir(mut pm.idx, root_path, pkg_name_hint, max_files)
}

fn py_mcp_add_venv_package(mut pm: PyMcpServer, pkg_name: str, max_files: i64 = 1200) -> i64 {
    return py_index_add_venv_package(mut pm.idx, pkg_name, max_files)
}

fn py_mcp_discover_env(mut pm: PyMcpServer, max_packages: i64 = 24, max_files_per_pkg: i64 = 300) -> i64 {
    return py_index_discover_env(mut pm.idx, max_packages, max_files_per_pkg)
}

fn _py_mcp_dispatch_tool(pm: PyMcpServer, req: McpRequest) -> str {
    t := req.tool_name
    a := req.args_json
    mut out_json := ""
    mut is_plain_text := false
    mut is_err := false

    if str_eq(t, "py_list_packages") {
        out_json = py_list_packages_json(pm.idx, mcp_json_get_str(a, "filter", ""))
    } else if str_eq(t, "py_list_modules") {
        pkg := mcp_json_get_str(a, "package", "")
        inc := mcp_json_get_bool(a, "include_private", false)
        out_json = py_list_modules_json(pm.idx, pkg, inc)
    } else if str_eq(t, "py_inspect_module") {
        m := mcp_json_get_str(a, "module", "")
        if str_len(m) == 0 { return mcp_err_resp(req.raw_id, mcp_err_invalid_params(), "Missing required parameter: module") }
        inc := mcp_json_get_bool(a, "include_private", false)
        out_json = py_inspect_module_json(pm.idx, m, inc)
    } else if str_eq(t, "py_search_symbols") {
        q := mcp_json_get_str(a, "query", "")
        pkg := mcp_json_get_str(a, "package", "")
        knd := mcp_json_get_str(a, "kind", "all")
        lim := mcp_json_get_i64(a, "limit", 25)
        out_json = py_search_symbols_json(pm.idx, q, pkg, knd, lim)
    } else if str_eq(t, "py_get_symbol") {
        sym := mcp_json_get_str(a, "symbol", "")
        if str_len(sym) == 0 { return mcp_err_resp(req.raw_id, mcp_err_invalid_params(), "Missing required parameter: symbol") }
        inc_src := mcp_json_get_bool(a, "include_source", true)
        out_json = py_get_symbol_json(pm.idx, sym, inc_src)
        if str_starts_with(out_json, "{\"error\":") { is_err = true }
    } else if str_eq(t, "py_get_source") {
        m := mcp_json_get_str(a, "module", "")
        if str_len(m) == 0 { return mcp_err_resp(req.raw_id, mcp_err_invalid_params(), "Missing required parameter: module") }
        sl := mcp_json_get_i64(a, "start_line", 1)
        el := mcp_json_get_i64(a, "end_line", 200)
        num := mcp_json_get_bool(a, "numbered", true)
        txt := py_get_source_lines(pm.idx, m, sl, el, num) or ""
        // Check if module existed
        if str_len(txt) == 0 and not smap_has(pm.idx.mod_qname_map, m) {
            return mcp_ok_resp(req.raw_id, mcp_tool_err_text(f"Module not found: {m}"))
        }
        is_plain_text = true
        out_json = txt
    } else if str_eq(t, "py_get_class_hierarchy") {
        cn := mcp_json_get_str(a, "class_name", "")
        if str_len(cn) == 0 { return mcp_err_resp(req.raw_id, mcp_err_invalid_params(), "Missing required parameter: class_name") }
        out_json = py_get_class_hierarchy_json(pm.idx, cn)
        if str_starts_with(out_json, "{\"error\":") { is_err = true }
    } else if str_eq(t, "py_find_references") {
        sym := mcp_json_get_str(a, "symbol", "")
        if str_len(sym) == 0 { return mcp_err_resp(req.raw_id, mcp_err_invalid_params(), "Missing required parameter: symbol") }
        pkg := mcp_json_get_str(a, "package", "")
        lim := mcp_json_get_i64(a, "limit", 50)
        out_json = py_find_references_json(pm.idx, sym, pkg, lim)
    } else if str_eq(t, "py_generate_mcp_manifest") {
        tgt := mcp_json_get_str(a, "target", "")
        if str_len(tgt) == 0 { return mcp_err_resp(req.raw_id, mcp_err_invalid_params(), "Missing required parameter: target") }
        only_d := mcp_json_get_bool(a, "only_decorated", false)
        out_json = py_extract_mcp_definitions_json(pm.idx, tgt, only_d)
    } else if str_eq(t, "py_generate_axon_stub") {
        tgt := mcp_json_get_str(a, "target", "")
        if str_len(tgt) == 0 { return mcp_err_resp(req.raw_id, mcp_err_invalid_params(), "Missing required parameter: target") }
        only_d := mcp_json_get_bool(a, "only_decorated", false)
        is_plain_text = true
        out_json = py_generate_axon_mcp_stub(pm.idx, tgt, only_d)
    } else {
        return mcp_err_resp(req.raw_id, mcp_err_invalid_params(), f"Unknown tool: {t}")
    }

    if is_plain_text {
        return mcp_ok_resp(req.raw_id, if is_err { mcp_tool_err_text(out_json) } else { mcp_tool_ok_text(out_json) })
    }
    if is_err {
        return mcp_ok_resp(req.raw_id, mcp_tool_err_text(out_json))
    }
    return mcp_ok_resp(req.raw_id, mcp_tool_ok_json(out_json, out_json))
}

fn _py_mcp_dispatch_resource(pm: PyMcpServer, req: McpRequest) -> str {
    uri := req.resource_uri
    if str_eq(uri, "pylib://packages") {
        return mcp_ok_resp(req.raw_id, mcp_resource_text_result(uri, "application/json", py_list_packages_json(pm.idx, "")))
    }
    if mcp_uri_match("pylib://{package}/metadata", uri) {
        pkg := mcp_uri_param("pylib://{package}/metadata", uri, "package", "")
        pidx := smap_get_i64(pm.idx.pkg_map, pkg, -1)
        if pidx < 0 { return mcp_err_resp(req.raw_id, mcp_err_resource_not_found(), f"Package not found: {pkg}") }
        mut out := mbuf_new(512)
        mbuf_push_str(mut out, "{\"name\":")
        mbuf_push_json_str(mut out, svec_get(pm.idx.pkg_names, pidx))
        mbuf_push_str(mut out, ",\"version\":")
        mbuf_push_json_str(mut out, svec_get(pm.idx.pkg_versions, pidx))
        mbuf_push_str(mut out, ",\"summary\":")
        mbuf_push_json_str(mut out, svec_get(pm.idx.pkg_summaries, pidx))
        mbuf_push_str(mut out, ",\"author\":")
        mbuf_push_json_str(mut out, svec_get(pm.idx.pkg_authors, pidx))
        mbuf_push_str(mut out, ",\"license\":")
        mbuf_push_json_str(mut out, svec_get(pm.idx.pkg_licenses, pidx))
        mbuf_push_str(mut out, ",\"requiresPython\":")
        mbuf_push_json_str(mut out, svec_get(pm.idx.pkg_requires_python, pidx))
        mbuf_push_str(mut out, ",\"dependencies\":")
        mbuf_push_json_str(mut out, svec_get(pm.idx.pkg_requires_dist, pidx))
        mbuf_push_str(mut out, ",\"root\":")
        mbuf_push_json_str(mut out, svec_get(pm.idx.pkg_roots, pidx))
        mbuf_push(mut out, 125)
        return mcp_ok_resp(req.raw_id, mcp_resource_text_result(uri, "application/json", mbuf_finish(move out)))
    }
    if mcp_uri_match("pylib://{package}/modules", uri) {
        pkg := mcp_uri_param("pylib://{package}/modules", uri, "package", "")
        return mcp_ok_resp(req.raw_id, mcp_resource_text_result(uri, "application/json", py_list_modules_json(pm.idx, pkg, false)))
    }
    if mcp_uri_match("pylib://{package}/module/{module}", uri) {
        mod_q := mcp_uri_param("pylib://{package}/module/{module}", uri, "module", "")
        midx := smap_get_i64(pm.idx.mod_qname_map, mod_q, -1)
        if midx < 0 { return mcp_err_resp(req.raw_id, mcp_err_resource_not_found(), f"Module not found: {mod_q}") }
        return mcp_ok_resp(req.raw_id, mcp_resource_text_result(uri, "text/x-python", svec_get(pm.idx.mod_src, midx)))
    }
    if mcp_uri_match("pylib://{package}/symbol/{symbol}", uri) {
        sym := mcp_uri_param("pylib://{package}/symbol/{symbol}", uri, "symbol", "")
        info := py_get_symbol_json(pm.idx, sym, true)
        if str_starts_with(info, "{\"error\":") {
            return mcp_err_resp(req.raw_id, mcp_err_resource_not_found(), f"Symbol not found: {sym}")
        }
        return mcp_ok_resp(req.raw_id, mcp_resource_text_result(uri, "application/json", info))
    }
    return mcp_err_resp(req.raw_id, mcp_err_resource_not_found(), f"Resource not found: {uri}")
}

fn _py_mcp_dispatch_prompt(pm: PyMcpServer, req: McpRequest) -> str {
    pname := req.prompt_name
    a := req.args_json
    if str_eq(pname, "explain_python_api") {
        sym := mcp_json_get_str(a, "symbol", "")
        info := py_get_symbol_json(pm.idx, sym, true)
        msg := mcp_prompt_msg_text("user", f"Explain the Python API `{sym}` thoroughly (parameters, return type, edge cases, usage example) based on this extracted AST/signature/docstring/source:\n\n{info}")
        return mcp_ok_resp(req.raw_id, mcp_prompt_result(f"Explain Python API {sym}", "[" + msg + "]"))
    }
    if str_eq(pname, "generate_mcp_wrapper") {
        mod_n := mcp_json_get_str(a, "module", "")
        man := py_extract_mcp_definitions_json(pm.idx, mod_n, false)
        msg := mcp_prompt_msg_text("user", f"Design an MCP wrapper for Python module `{mod_n}` using these extracted tool schemas and docstrings:\n\n{man}")
        return mcp_ok_resp(req.raw_id, mcp_prompt_result(f"Generate MCP wrapper for {mod_n}", "[" + msg + "]"))
    }
    if str_eq(pname, "trace_python_dependencies") {
        pkg := mcp_json_get_str(a, "package", "")
        mods := py_list_modules_json(pm.idx, pkg, true)
        msg := mcp_prompt_msg_text("user", f"Analyze internal module dependencies and public exports for Python package `{pkg}`:\n\n{mods}")
        return mcp_ok_resp(req.raw_id, mcp_prompt_result(f"Trace dependencies of {pkg}", "[" + msg + "]"))
    }
    return mcp_err_resp(req.raw_id, mcp_err_invalid_params(), f"Unknown prompt: {pname}")
}

fn _py_mcp_handle_single(mut pm: PyMcpServer, raw_json: str) -> str {
    req := mcp_parse_request(raw_json)
    (handled, reply) := mcp_handle_builtin(mut pm.srv, req)
    if handled { return reply }
    if str_eq(req.method, "tools/call") { return _py_mcp_dispatch_tool(pm, req) }
    if str_eq(req.method, "resources/read") { return _py_mcp_dispatch_resource(pm, req) }
    if str_eq(req.method, "prompts/get") { return _py_mcp_dispatch_prompt(pm, req) }
    return mcp_err_resp(req.raw_id, mcp_err_method_not_found(), f"Unsupported method: {req.method}")
}

// Processes a single JSON-RPC request OR JSON-RPC batch `[...]` and returns response JSON (or `""` for notifications).
fn py_mcp_handle_line(mut pm: PyMcpServer, raw_json: str) -> str {
    mut t := str_trim(raw_json)
    if str_len(t) >= 3 and str_byte(t, 0) == 239 and str_byte(t, 1) == 187 and str_byte(t, 2) == 191 {
        t = str_trim(str_slice(t, 3, str_len(t)))
    }
    if str_len(t) == 0 { return "" }
    if mcp_is_batch_json(t) {
        items := mcp_json_array_items(t)
        cnt := svec_len(items)
        if cnt == 0 {
            svec_free(move items)
            return mcp_err_resp("null", mcp_err_invalid_request(), "Empty JSON-RPC batch")
        }
        if cnt > 64 {
            svec_free(move items)
            return mcp_err_resp("null", mcp_err_invalid_request(), "JSON-RPC batch size limit (64) exceeded")
        }
        mut out := mbuf_new(1024)
        mbuf_push(mut out, 91)
        mut emitted := 0
        mut i := 0
        while i < cnt {
            rep := _py_mcp_handle_single(mut pm, svec_get(items, i))
            if str_len(rep) > 0 {
                if emitted > 0 { mbuf_push(mut out, 44) }
                mbuf_push_str(mut out, rep)
                emitted += 1
            }
            i += 1
        }
        svec_free(move items)
        mbuf_push(mut out, 93)
        if emitted == 0 {
            mbuf_free(move out)
            return ""
        }
        return mbuf_finish(move out)
    }
    if str_byte(t, 0) != 123 {
        return mcp_err_resp("null", mcp_err_parse(), "Malformed JSON-RPC payload")
    }
    return _py_mcp_handle_single(mut pm, t)
}

fn py_mcp_handle_http(mut pm: PyMcpServer, raw_http_req: str) -> str {
    (pre_done, pre_resp) := mcp_http_preflight_check(raw_http_req)
    if pre_done { return pre_resp }
    req := http_parse_request(raw_http_req) or return http_json_response(400, "{\"error\":\"bad HTTP request\"}")

    mut sid := http_get_header(raw_http_req, "Mcp-Session-Id") or ""
    if str_len(sid) > 128 or (str_len(sid) > 0 and not http_is_safe_header_val(sid)) {
        return http_json_response(400, "{\"error\":\"invalid session id\"}")
    }
    if str_len(sid) == 0 { sid = mcp_http_new_session(mut pm.http) }

    if str_eq(req.method, "GET") and str_eq(req.path, "/sse") {
        return mcp_http_sse_init_resp(f"/messages?sessionId={sid}", sid)
    }
    if str_eq(req.method, "DELETE") and str_eq(req.path, "/mcp") {
        _ := smap_remove(mut pm.http.sessions, sid)
        return mcp_http_json_resp(200, "{\"closed\":true}", "")
    }
    if str_eq(req.method, "POST") and (str_eq(req.path, "/mcp") or str_eq(req.path, "/messages")) {
        reply := py_mcp_handle_line(mut pm, req.body)
        if str_len(reply) == 0 {
            return mcp_http_json_resp(202, "{\"accepted\":true}", sid)
        }
        return mcp_http_json_resp(200, reply, sid)
    }
    return http_json_response(404, "{\"error\":\"route not found\"}")
}

fn py_mcp_serve_stdio(mut pm: PyMcpServer) -> i32 {
    line_buf := buf_new(1048576)
    while true {
        raw := mcp_stdio_read_next(line_buf) or ""
        if str_len(raw) == 0 { break }
        reply := py_mcp_handle_line(mut pm, raw)
        mcp_stdio_send(reply)
    }
    buf_free(move line_buf)
    return 0
}

fn _py_accept_or_none(ln: TcpListener) -> (bool, TcpStream) {
    s := tcp_accept(ln) or return (false, TcpStream(fd = -1, api = ln.api))
    return (true, s)
}

fn py_mcp_serve_http(mut pm: PyMcpServer, bind_ip: str = "127.0.0.1", port: i64 = 8765, max_requests: i64 = 0) -> i32 {
    ln := tcp_listen(bind_ip, port, 128) or return 1
    mut served := 0
    while max_requests <= 0 or served < max_requests {
        (ok_acc, sock) := _py_accept_or_none(ln)
        if not ok_acc { break }
        raw_req := mcp_http_recv_request(sock, 4194304) or ""
        if str_len(raw_req) > 0 {
            raw_resp := py_mcp_handle_http(mut pm, raw_req)
            _ := tcp_send_str(sock, raw_resp) or 0
        } else {
            _ := tcp_send_str(sock, http_json_response(400, "{\"error\":\"empty or oversized request\"}")) or 0
        }
        tcp_close(sock)
        served += 1
    }
    tcp_listener_close(ln)
    return 0
}
