        pkg_versions = svec_new(8, 128),
        pkg_summaries = svec_new(8, 512),
        pkg_authors = svec_new(8, 256),
        pkg_licenses = svec_new(8, 128),
        pkg_requires_python = svec_new(8, 128),
        pkg_requires_dist = svec_new(8, 512),
        pkg_roots = svec_new(8, 512),
        pkg_mod_head = dvec_new(16),
        pkg_mod_tail = dvec_new(16),
        pkg_map = smap_new(16),
        mod_pkg_idx = dvec_new(64),
        mod_next_pkg = dvec_new(64),
        mod_qname = svec_new(64, 2048),
        mod_file_path = svec_new(64, 4096),
        mod_is_pkg = dvec_new(64),
        mod_is_stub = dvec_new(64),
        mod_doc = svec_new(64, 4096),
        mod_all_csv = svec_new(64, 1024),
        mod_version = svec_new(64, 256),
        mod_src = svec_new(64, 16384),
        mod_line_count = dvec_new(64),
        mod_qname_map = smap_new(128),
        mod_bloom = dvec_new(512),
        mod_imp_head = dvec_new(64),
        mod_imp_tail = dvec_new(64),
        mod_var_head = dvec_new(64),
        mod_var_tail = dvec_new(64),
        mod_cls_head = dvec_new(64),
        mod_cls_tail = dvec_new(64),
        mod_fn_head = dvec_new(64),
        mod_fn_tail = dvec_new(64),
        imp_mod_idx = dvec_new(128),
        imp_next_mod = dvec_new(128),
        imp_module = svec_new(128, 2048),
        imp_symbol = svec_new(128, 2048),
        imp_alias = svec_new(128, 512),
        imp_line = dvec_new(128),
        imp_is_rel = dvec_new(128),
        var_mod_idx = dvec_new(128),
        var_cls_idx = dvec_new(128),
        var_next_mod = dvec_new(128),
        var_next_cls = dvec_new(128),
        var_name = svec_new(128, 2048),
        var_type = svec_new(128, 2048),
        var_default = svec_new(128, 2048),
        var_doc = svec_new(128, 1024),
        var_line = dvec_new(128),
