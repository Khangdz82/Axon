    fn_next_cls: DynIntVec
    fn_name: StrVec
    fn_qname: StrVec
    fn_sig_str: StrVec
    fn_ret_type: StrVec
    fn_decorators: StrVec
    fn_flags: DynIntVec
    fn_doc: StrVec
    fn_doc_summary: StrVec
    fn_doc_returns: StrVec
    fn_doc_raises: StrVec
    fn_start_line: DynIntVec
    fn_end_line: DynIntVec
    fn_dec_start_line: DynIntVec
    fn_param_start: DynIntVec
    fn_param_count: DynIntVec
    fn_sig64: DynIntVec
    fn_doc_sig64: DynIntVec
    fn_qname_map: StrMap
    fn_short_map: StrMap
    // Parameters
    prm_name: StrVec
    prm_type: StrVec
    prm_default: StrVec
    prm_has_default: DynIntVec
