    // Modules
    mod_pkg_idx: DynIntVec
    mod_next_pkg: DynIntVec
    mod_qname: StrVec
    mod_file_path: StrVec
    mod_is_pkg: DynIntVec
    mod_is_stub: DynIntVec
    mod_doc: StrVec
    mod_all_csv: StrVec
    mod_version: StrVec
    mod_src: StrVec
    mod_line_count: DynIntVec
    mod_qname_map: StrMap
    mod_bloom: DynIntVec
