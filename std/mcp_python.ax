// Axon Standard Library — Deep Python Library Source Reader & MCP Generator (`std/mcp_python.ax`)
// 100% Pure Axon, Zero-GC Perceus ownership, Zero Python runtime dependency.
//
// Deep Python library introspection (`ast` + `inspect` + `pydoc` + `importlib.metadata` + `FastMCP` parity):
//   1. Package & Environment Discovery (`site-packages`, `VIRTUAL_ENV`, `CONDA_PREFIX`, `.dist-info/METADATA`, `pyproject.toml`)
//   2. Indentation- & Lexer-Aware `.py` / `.pyi` Source Parser (multiline strings, brackets, decorators, `__all__`, imports, fields)
//   3. Deep Signature Parser (`/` pos-only, `*` kw-only, `*args`, `**kwargs`, nested generics, defaults)
//   4. Docstring Parser (Google `Args:`/`Returns:`/`Raises:`, NumPy `Parameters\n---`, Sphinx `:param x:`/`:return:`)
//   5. Python Type Hint -> JSON Schema Draft 2020-12 Compiler (`Annotated`, `Field`, `Literal`, `Union`/`|`, `Optional`, `Enum`, `dataclass`, `BaseModel`)
//   6. FastMCP / MCP Decorator Extractor (`@mcp.tool`, `@mcp.resource`, `@mcp.prompt`) & Axon MCP Stub Generator
//   7. Turnkey `PyMcpServer` (10 MCP Tools, 5 Resource Templates, 3 Prompts over Stdio & Streamable HTTP/SSE)

use std::os
use std::str
use std::ds
use std::fs
use std::path
use std::sys
use std::toml
use std::http
use std::net
use std::ffi
use std::mcp

// Flag bitmasks for `PyLibIndex.fn_flags`
fn py_flag_async() -> i64 { return 1 }
fn py_flag_method() -> i64 { return 2 }
fn py_flag_classmethod() -> i64 { return 4 }
fn py_flag_staticmethod() -> i64 { return 8 }
fn py_flag_property() -> i64 { return 16 }
fn py_flag_overload() -> i64 { return 32 }
fn py_flag_abstractmethod() -> i64 { return 64 }
fn py_flag_mcp_tool() -> i64 { return 128 }
fn py_flag_mcp_resource() -> i64 { return 256 }
fn py_flag_mcp_prompt() -> i64 { return 512 }
fn py_flag_private() -> i64 { return 1024 }
fn py_flag_dunder() -> i64 { return 2048 }

// Parameter kinds matching Python `inspect.Parameter`
fn py_param_pos_only() -> i64 { return 0 }
fn py_param_pos_or_kw() -> i64 { return 1 }
fn py_param_var_pos() -> i64 { return 2 }
fn py_param_kw_only() -> i64 { return 3 }
fn py_param_var_kw() -> i64 { return 4 }

// ==================== 1. PYTHON INDEX DATA MODEL ====================

