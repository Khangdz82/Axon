    // Classes
    cls_mod_idx: DynIntVec
    cls_next_mod: DynIntVec
    cls_name: StrVec
    cls_qname: StrVec
    cls_bases: StrVec
    cls_decorators: StrVec
    cls_kind: StrVec
    cls_doc: StrVec
    cls_start_line: DynIntVec
    cls_end_line: DynIntVec
    cls_var_head: DynIntVec
    cls_var_tail: DynIntVec
    cls_fn_head: DynIntVec
    cls_fn_tail: DynIntVec
    cls_sig64: DynIntVec
    cls_doc_sig64: DynIntVec
    cls_qname_map: StrMap
