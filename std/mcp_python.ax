        cls_next_mod = dvec_new(64),
        cls_name = svec_new(64, 1024),
        cls_qname = svec_new(64, 2048),
        cls_bases = svec_new(64, 1024),
        cls_decorators = svec_new(64, 1024),
        cls_kind = svec_new(64, 512),
        cls_doc = svec_new(64, 4096),
        cls_start_line = dvec_new(64),
        cls_end_line = dvec_new(64),
        cls_var_head = dvec_new(64),
        cls_var_tail = dvec_new(64),
        cls_fn_head = dvec_new(64),
        cls_fn_tail = dvec_new(64),
        cls_sig64 = dvec_new(64),
        cls_doc_sig64 = dvec_new(64),
        cls_qname_map = smap_new(128),
        cls_short_map = smap_new(128),
        fn_mod_idx = dvec_new(128),
        fn_cls_idx = dvec_new(128),
        fn_next_mod = dvec_new(128),
        fn_next_cls = dvec_new(128),
        fn_name = svec_new(128, 2048),
        fn_qname = svec_new(128, 4096),
        fn_sig_str = svec_new(128, 4096),
        fn_ret_type = svec_new(128, 1024),
        fn_decorators = svec_new(128, 2048),
        fn_flags = dvec_new(128),
        fn_doc = svec_new(128, 8192),
        fn_doc_summary = svec_new(128, 2048),
        fn_doc_returns = svec_new(128, 1024),
        fn_doc_raises = svec_new(128, 1024),
        fn_start_line = dvec_new(128),
        fn_end_line = dvec_new(128),
        fn_dec_start_line = dvec_new(128),
        fn_param_start = dvec_new(128),
