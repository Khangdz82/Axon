// Axon Standard Kernel & Hardware Ring Subsystem (`std/kernel.ax`)
// 100% Pure Axon: Zero CRT, Zero External Dependencies, Zero-GC (@no_alloc).
// Complete Ring 0 (Supervisor) to Ring 3 (User Mode) x86_64 Hardware OS Architecture:
//   - Privilege Rings: Ring 0 (Kernel), Ring 1 (Drivers), Ring 2 (Services), Ring 3 (User)
//   - Global Descriptor Table (GDT) & Task State Segment (TSS 64-bit RSP0)
//   - Interrupt Descriptor Table (IDT 256 Gates: Ring 0 Interrupt Gate vs Ring 3 Trap/Syscall Gate)
//   - 4-Level Paging Virtual Memory Manager (PML4, PDPT, PD, PT with Ring 0 / Ring 3 U/S protection)
//   - Model Specific Registers (MSRs: IA32_EFER, IA32_STAR, IA32_LSTAR, IA32_FMASK, FS/GS Base)
//   - Ring Transitions: Ring 0 -> Ring 3 (IRETQ / SYSRETQ), Ring 3 -> Ring 0 (SYSCALL / Interrupt)
//   - Hardware Port I/O (8, 16, 32-bit) & COM1 (0x3F8) Serial UART Kernel Console

use std::os

// --- 1. Privilege Rings & Architecture Constants ---

fn ring_kernel() -> i64    { return 0 } // Ring 0: Supervisor / Kernel Mode
fn ring_drivers() -> i64   { return 1 } // Ring 1: Hardware Device Drivers
fn ring_services() -> i64  { return 2 } // Ring 2: Microkernel / OS Services
fn ring_user() -> i64      { return 3 } // Ring 3: Sandboxed User Applications

// Standard 64-bit GDT Segment Selectors (SYSRETQ / IRETQ Intel SDM compliant order:
//   IA32_STAR[63:48] = 0x0010 -> SYSRETQ loads SS = (0x10+8)|3 = 0x1B, CS = (0x10+16)|3 = 0x23)
fn gdt_sel_null() -> i64      { return 0x00 }
fn gdt_sel_kernel_cs() -> i64 { return 0x08 } // Ring 0 64-bit Code (Index 1)
fn gdt_sel_kernel_ds() -> i64 { return 0x10 } // Ring 0 64-bit Data (Index 2)
fn gdt_sel_user_ds() -> i64   { return 0x1B } // Ring 3 64-bit Data (Index 3 = 0x18 | RPL 3)
fn gdt_sel_user_cs() -> i64   { return 0x23 } // Ring 3 64-bit Code (Index 4 = 0x20 | RPL 3)
fn gdt_sel_tss() -> i64       { return 0x28 } // TSS 64-bit Descriptor (Index 5, 16 bytes)

// Model Specific Registers (MSRs)
fn msr_efer() -> i64      { return -1073741696 } // 0xC0000080: Extended Feature Enable (SCE, LME, LMA, NXE)
fn msr_star() -> i64      { return -1073741695 } // 0xC0000081: SYSCALL Target CS/SS Selectors
fn msr_lstar() -> i64     { return -1073741694 } // 0xC0000082: SYSCALL Target RIP
fn msr_cstar() -> i64     { return -1073741693 } // 0xC0000083: Compatibility SYSCALL Target RIP
fn msr_fmask() -> i64     { return -1073741692 } // 0xC0000084: SYSCALL RFLAGS Mask
fn msr_fs_base() -> i64   { return -1073741568 } // 0xC0000100: User Thread-Local Storage (TLS)
fn msr_gs_base() -> i64   { return -1073741567 } // 0xC0000101: Active GS Base
fn msr_kernel_gs() -> i64 { return -1073741566 } // 0xC0000102: Kernel GS Base (swapped by SWAPGS)

// Paging Flags (Ring 0 Supervisor vs Ring 3 User Protection)
fn page_present() -> i64  { return 0x01 } // Bit 0: Page is present in physical memory
fn page_writable() -> i64 { return 0x02 } // Bit 1: Page is Read/Write (0 = Read-Only)
fn page_user() -> i64     { return 0x04 } // Bit 2: User Mode (Ring 3 accessible; 0 = Ring 0 Supervisor only)
fn page_pwt() -> i64      { return 0x08 } // Bit 3: Page Write-Through
fn page_pcd() -> i64      { return 0x10 } // Bit 4: Cache Disable
fn page_accessed() -> i64 { return 0x20 } // Bit 5: Accessed
fn page_dirty() -> i64    { return 0x40 } // Bit 6: Dirty (written to)
fn page_huge() -> i64     { return 0x80 } // Bit 7: 2 MB / 1 GB Large Page
fn page_global() -> i64   { return 0x100 } // Bit 8: Global translation across CR3 switches
fn page_nx() -> i64       { return 1 << 63 } // Bit 63: No-Execute (XD/NXE)

// --- 2. Low-Level Ring 0 CPU Control & Hardware Instructions ---

@no_alloc
fn k_cli() { unsafe { cpu_cli() } }

@no_alloc
fn k_sti() { unsafe { cpu_sti() } }

@no_alloc
fn k_hlt() { unsafe { cpu_hlt() } }

@no_alloc
fn k_pause() { cpu_pause() }

@no_alloc
fn k_wbinvd() { unsafe { cpu_wbinvd() } }

@no_alloc
fn k_swapgs() { unsafe { cpu_swapgs() } }

@no_alloc
fn k_invlpg(vaddr: i64) { unsafe { cpu_invlpg(vaddr) } }

@no_alloc
fn k_read_cr0() -> i64 { unsafe { return read_cr0() } }

@no_alloc
fn k_write_cr0(v: i64) { unsafe { write_cr0(v) } }

@no_alloc
fn k_read_cr2() -> i64 { unsafe { return read_cr2() } }

@no_alloc
fn k_write_cr2(v: i64) { unsafe { write_cr2(v) } }

@no_alloc
fn k_read_cr3() -> i64 { unsafe { return read_cr3() } }

@no_alloc
fn k_write_cr3(v: i64) { unsafe { write_cr3(v) } }

@no_alloc
fn k_read_cr4() -> i64 { unsafe { return read_cr4() } }

@no_alloc
fn k_write_cr4(v: i64) { unsafe { write_cr4(v) } }

@no_alloc
fn k_rdmsr(msr: i64) -> i64 { unsafe { return rdmsr(msr) } }

@no_alloc
fn k_wrmsr(msr: i64, val: i64) { unsafe { wrmsr(msr, val) } }

@no_alloc
fn k_rdtsc() -> i64 { return cpu_rdtsc() }

// Hardware Port I/O
@no_alloc
fn k_out8(port: i64, val: i64) { unsafe { port_out_u8(port, val) } }

@no_alloc
fn k_in8(port: i64) -> i64 { unsafe { return port_in_u8(port) } }

@no_alloc
fn k_out16(port: i64, val: i64) { unsafe { port_out_u16(port, val) } }

