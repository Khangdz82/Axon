// Axon Deep Security Testing Library — Metamorphic Security Oracle Engine (`std/sec_meta.ax`)
// 100% Pure Axon, Zero-GC, `--shield` Safe.
// Solves the security Test Oracle Problem with 0% false positives via Metamorphic Relations (MRs):
// If a security filter REJECTS a canonical hostile input `X`, every semantically equivalent obfuscated
// re-encoding `T(X)` MUST ALSO be rejected. Any `(X -> REJECT, T(X) -> ALLOW)` pair proves a real bypass!

use std::str
use std::ds
use std::sec_corpus

// Returns `true` when a Metamorphic Security Bypass is proven (`base` rejected, equivalent `variant` allowed!).
fn meta_is_bypass(base_rejected: bool, variant_rejected: bool) -> bool {
    return base_rejected and (not variant_rejected)
}

// --- 1. URL / SSRF Equivalence Transformations (CWE-918 / CWE-436) ---

// Generates semantically equivalent obfuscated URL variants for an internal target (`127.0.0.1`,
// `169.254.169.254`, `localhost`, or arbitrary host) to automatically hunt SSRF guard bypasses.
fn meta_url_variants(base_host: str, path: str = "/") -> StrVec {
    mut sv := svec_new(32, 2048)
    svec_push(mut sv, "http://" + base_host + path)
    svec_push(mut sv, "HTTP://" + str_to_upper(base_host) + path)
    svec_push(mut sv, "https://" + base_host + ":443" + path)
    svec_push(mut sv, "http://" + base_host + "." + path)
    svec_push(mut sv, "http://public.example.com@" + base_host + path)
    svec_push(mut sv, "http://a@public.example.com@" + base_host + path)
    svec_push(mut sv, "http://" + base_host + "\\@public.example.com" + path)
    svec_push(mut sv, "http://" + base_host + "#@public.example.com")
    svec_push(mut sv, "http://" + base_host + "?@public.example.com")

    lo := str_to_lower(base_host)
    if str_eq(lo, "127.0.0.1") or str_eq(lo, "localhost") {
        svec_push(mut sv, "http://127.1" + path)
        svec_push(mut sv, "http://2130706433" + path)
        svec_push(mut sv, "http://0x7f000001" + path)
        svec_push(mut sv, "http://0x7f.0x0.0x0.0x1" + path)
        svec_push(mut sv, "http://0177.0.0.1" + path)
        svec_push(mut sv, "http://[::1]" + path)
        svec_push(mut sv, "http://[0:0:0:0:0:0:0:1]" + path)
        svec_push(mut sv, "http://[::ffff:127.0.0.1]" + path)
        svec_push(mut sv, "http://[::ffff:7f00:1]" + path)
        svec_push(mut sv, "http://sub.localhost" + path)
        svec_push(mut sv, "http://localhost." + path)
    } else if str_eq(lo, "169.254.169.254") {
        svec_push(mut sv, "http://2852039166" + path)
        svec_push(mut sv, "http://0xa9fea9fe" + path)
        svec_push(mut sv, "http://0251.0376.0251.0376" + path)
        svec_push(mut sv, "http://[::ffff:169.254.169.254]" + path)
        svec_push(mut sv, "http://[::ffff:a9fe:a9fe]" + path)
        svec_push(mut sv, "http://[fe90::1]" + path)
    } else if str_eq(lo, "192.168.1.1") {
        svec_push(mut sv, "http://3232235777" + path)
        svec_push(mut sv, "http://0xc0a80101" + path)
        svec_push(mut sv, "http://[::ffff:192.168.1.1]" + path)
        svec_push(mut sv, "http://[::ffff:c0a8:101]" + path)
    }
    return sv
}

// --- 2. Path Traversal Equivalence Transformations (CWE-22 / CWE-158) ---

fn meta_path_variants(target_file: str = "etc/passwd") -> StrVec {
    mut sv := svec_new(24, 1024)
    svec_push(mut sv, "../" + target_file)
    svec_push(mut sv, "..\\..\\" + target_file)
    svec_push(mut sv, "a/../../" + target_file)
    svec_push(mut sv, "a/./../../" + target_file)
    svec_push(mut sv, "....//....//" + target_file)
    svec_push(mut sv, "/" + target_file)
    svec_push(mut sv, "//" + target_file)
    svec_push(mut sv, "\\" + target_file)
    svec_push(mut sv, "\\\\evil\\share\\" + target_file)
    svec_push(mut sv, "C:/" + target_file)
    svec_push(mut sv, "%2e%2e%2f" + target_file)
    svec_push(mut sv, "%252e%252e%252f" + target_file)
    svec_push(mut sv, ".." + _corpus_bytes2(0xC0, 0xAF) + target_file)
    svec_push(mut sv, _corpus_with_nul("../" + target_file, ".png"))
    return sv
}

// --- 3. HTTP/1.1 Framing & Request Smuggling Equivalences (CWE-444) ---

fn meta_http_variants(method: str = "POST", path: str = "/admin") -> StrVec {
    mut sv := svec_new(16, 1024)
    // Canonical malformed/smuggling forms across line endings, header case, whitespace & duplicates
    svec_push(mut sv, f"{method} {path} HTTP/1.1\nHost: a\n\n")
    svec_push(mut sv, f"{method} {path} HTTP/1.1\r\nHost: a\n\n")
    svec_push(mut sv, f"{method} {path} HTTP/1.1\nHost: a\r\n\r\n")
    svec_push(mut sv, f"{method} {path} HTTP/1.1\r\nHost : a\r\n\r\n")
    svec_push(mut sv, f"{method} {path} HTTP/1.1\r\nHost: a\r\n folded: 1\r\n\r\n")
    svec_push(mut sv, f"{method} {path} HTTP/1.1\r\nHost: a\r\nContent-Length: 4\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n")
    svec_push(mut sv, f"{method} {path} HTTP/1.1\r\nHost: a\r\ntRaNsFeR-eNcOdInG: chunked\r\n\r\n0\r\n\r\n")
    svec_push(mut sv, f"{method} {path} HTTP/1.1\r\nHost: a\r\nContent-Length: 2\r\nContent-Length: 5\r\n\r\nhello")
    svec_push(mut sv, f"{method} {path} HTTP/0.9\r\n\r\n")
    return sv
}

// --- 4. JSON / JWT Claim & Auth Semantic Variants (CWE-613 / CWE-347) ---

// Generates hostile temporal/type-confused JWT JSON payloads around `claim_key` (e.g., `"exp"` or `"nbf"`).
fn meta_jwt_claim_variants(claim_key: str = "exp") -> StrVec {
    mut sv := svec_new(16, 1024)
    svec_push(mut sv, f"{{\"sub\":\"admin\",\"{claim_key}\":1}}")
    svec_push(mut sv, f"{{\"sub\":\"admin\",\"{claim_key}\":0}}")
    svec_push(mut sv, f"{{\"sub\":\"admin\",\"{claim_key}\":-1}}")
    svec_push(mut sv, f"{{\"sub\":\"admin\",\"{claim_key}\":-999999}}")
    svec_push(mut sv, f"{{\"sub\":\"admin\",\"{claim_key}\":\"1\"}}")
    svec_push(mut sv, f"{{\"sub\":\"admin\",\"{claim_key}\":null}}")
    svec_push(mut sv, f"{{\"sub\":\"admin\",\"{claim_key}\":2000000000,\"{claim_key}\":1}}")
    svec_push(mut sv, f"{{\"sub\":\"admin\",\"{claim_key}\":1,\"{claim_key}\":2000000000}}")
    svec_push(mut sv, f"{{ \"sub\" : \"admin\" , \"{claim_key}\" : -1 }}")
    return sv
}
