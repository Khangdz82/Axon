// Axon Standard Library: Terminal Colors, ANSI TrueColor & CLI UX (`std/terminal.ax`)
// Pure native ANSI escape sequences, 24-bit RGB TrueColor, styles, progress bars & box frames.

use std::os
use std::str

fn term_esc() -> str {
    b := buf_new(2)
    buf_push(b, 27) // 0x1B
    return buf_to_owned_str(move b)
}

fn term_reset() -> str { return term_esc() + "[0m" }
fn term_bold(s: str) -> str { return term_esc() + "[1m" + s + term_esc() + "[22m" }
fn term_dim(s: str) -> str { return term_esc() + "[2m" + s + term_esc() + "[22m" }
fn term_italic(s: str) -> str { return term_esc() + "[3m" + s + term_esc() + "[23m" }
fn term_underline(s: str) -> str { return term_esc() + "[4m" + s + term_esc() + "[24m" }
fn term_inverse(s: str) -> str { return term_esc() + "[7m" + s + term_esc() + "[27m" }

// Standard 16-Color ANSI Foreground
fn term_black(s: str) -> str { return term_esc() + "[30m" + s + term_esc() + "[39m" }
fn term_red(s: str) -> str { return term_esc() + "[31m" + s + term_esc() + "[39m" }
fn term_green(s: str) -> str { return term_esc() + "[32m" + s + term_esc() + "[39m" }
fn term_yellow(s: str) -> str { return term_esc() + "[33m" + s + term_esc() + "[39m" }
fn term_blue(s: str) -> str { return term_esc() + "[34m" + s + term_esc() + "[39m" }
fn term_magenta(s: str) -> str { return term_esc() + "[35m" + s + term_esc() + "[39m" }
fn term_cyan(s: str) -> str { return term_esc() + "[36m" + s + term_esc() + "[39m" }
fn term_white(s: str) -> str { return term_esc() + "[37m" + s + term_esc() + "[39m" }
fn term_gray(s: str) -> str { return term_esc() + "[90m" + s + term_esc() + "[39m" }

// 24-bit TrueColor RGB Foreground
fn term_rgb(r: i64, g: i64, b_col: i64, text: str) -> str {
    cr := r & 255
    cg := g & 255
    cb := b_col & 255
    return term_esc() + f"[38;2;{cr};{cg};{cb}m" + text + term_esc() + "[39m"
}

// 24-bit TrueColor RGB Background
fn term_bg_rgb(r: i64, g: i64, b_col: i64, text: str) -> str {
    cr := r & 255
    cg := g & 255
    cb := b_col & 255
    return term_esc() + f"[48;2;{cr};{cg};{cb}m" + text + term_esc() + "[49m"
}

fn term_badge(label: str, bg_r: i64, bg_g: i64, bg_b: i64, fg_r: i64 = 255, fg_g: i64 = 255, fg_b: i64 = 255) -> str {
    colored_text := term_rgb(fg_r, fg_g, fg_b, f" {label} ")
    return term_bg_rgb(bg_r, bg_g, bg_b, term_bold(colored_text))
}

// Progress Bar: [██████████░░░░░░░░░░] 50%
fn term_progress_bar(current: i64, total: i64, bar_width: i64 = 20) -> str {
    if total <= 0 { return "[]" }
    mut cur := current
    if cur < 0 { cur = 0 }
    if cur > total { cur = total }

    filled_len := (cur * bar_width) / total
    pct := (cur * 100) / total

    b := buf_new(bar_width * 4 + 32)
    buf_push(b, 91) // '['
    mut i := 0
    while i < filled_len {
        buf_push_str(b, "#")
        i += 1
    }
    while i < bar_width {
        buf_push_str(b, "-")
        i += 1
    }
    buf_push(b, 93) // ']'
    buf_push_str(b, f" {pct}%")

    return buf_to_owned_str(move b)
}

fn term_clear_screen() -> str { return term_esc() + "[2J" + term_esc() + "[H" }
fn term_cursor_hide() -> str { return term_esc() + "[?25l" }
fn term_cursor_show() -> str { return term_esc() + "[?25h" }
