// Axon Standard Library: C# LINQ + C++ `<algorithm>` & `<numeric>` Zero-GC Engine (`std/linq.ax`)
// 100% Pure Axon: Memory-Driven Contiguous Buffer Pipelines for Beginners, Engineers & AI Agents.
// Combines C# `System.Linq` ergonomics (`linq_range`, `linq_sum`, `linq_filter_range`, `linq_take`,
// `linq_skip`, `linq_zip_add`, `linq_dot`) with C++ STL `<algorithm>`/`<numeric>` `@no_alloc`
// in-place transforms (`algo_sort_asc`, `algo_lower_bound`, `algo_prefix_sum_inplace`, `algo_unique_sorted`).

// --- 1. Fluent Sequence Generators ---

fn linq_range(start: i64, count: i64, step: i64 = 1) -> IntBuf {
    mut n := count
    if n < 0 { n = 0 }
    out := ibuf_new(n + 4)
    mut cur := start
    mut i := 0
    while i < n {
        ibuf_push(out, cur)
        cur += step
        i += 1
    }
    return out
}

fn linq_repeat(val: i64, count: i64) -> IntBuf {
    mut n := count
    if n < 0 { n = 0 }
    out := ibuf_new(n + 4)
    mut i := 0
    while i < n {
        ibuf_push(out, val)
        i += 1
    }
    return out
}

// --- 2. C# LINQ `@no_alloc` Scalar Reductions & Predicates ---

@no_alloc
fn linq_sum(b: IntBuf) -> i64 {
    n := ibuf_len(b)
    mut acc := 0
    mut i := 0
    while i < n {
        acc += ibuf_get(b, i)
        i += 1
    }
    return acc
}

@no_alloc
fn linq_min(b: IntBuf) -> i64 {
    n := ibuf_len(b)
    if n <= 0 { return 0 }
    mut m := ibuf_get(b, 0)
    mut i := 1
    while i < n {
        v := ibuf_get(b, i)
        if v < m { m = v }
        i += 1
    }
    return m
}

@no_alloc
fn linq_max(b: IntBuf) -> i64 {
    n := ibuf_len(b)
    if n <= 0 { return 0 }
    mut m := ibuf_get(b, 0)
    mut i := 1
    while i < n {
        v := ibuf_get(b, i)
        if v > m { m = v }
        i += 1
    }
    return m
}

@no_alloc
fn linq_mean_f64(b: IntBuf) -> f64 {
    n := ibuf_len(b)
    if n <= 0 { return 0.0 }
    return (linq_sum(b) as f64) / (n as f64)
}

@no_alloc
fn linq_dot(a: IntBuf, b: IntBuf) -> i64 {
    na := ibuf_len(a)
    nb := ibuf_len(b)
    limit := if na < nb { na } else { nb }
    mut acc := 0
    mut i := 0
    while i < limit {
        acc += ibuf_get(a, i) * ibuf_get(b, i)
        i += 1
    }
    return acc
}

@no_alloc
fn linq_count_range(b: IntBuf, lo: i64, hi: i64) -> i64 {
    n := ibuf_len(b)
    mut cnt := 0
    mut i := 0
    while i < n {
        v := ibuf_get(b, i)
        if v >= lo and v <= hi { cnt += 1 }
        i += 1
    }
    return cnt
}

@no_alloc
fn linq_any_gt(b: IntBuf, thresh: i64) -> bool {
    n := ibuf_len(b)
    mut i := 0
    while i < n {
        if ibuf_get(b, i) > thresh { return true }
        i += 1
    }
    return false
}

@no_alloc
fn linq_all_ge(b: IntBuf, thresh: i64) -> bool {
    n := ibuf_len(b)
    mut i := 0
    while i < n {
        if ibuf_get(b, i) < thresh { return false }
        i += 1
    }
    return true
}

@no_alloc
fn linq_contains(b: IntBuf, target: i64) -> bool {
    n := ibuf_len(b)
    mut i := 0
    while i < n {
        if ibuf_get(b, i) == target { return true }
        i += 1
    }
    return false
}

// --- 3. C# LINQ Slicing, Filtering & Zipping ---

fn linq_take(b: IntBuf, count: i64) -> IntBuf {
    n := ibuf_len(b)
    mut k := count
    if k < 0 { k = 0 }
    if k > n { k = n }
    out := ibuf_new(k + 4)
    mut i := 0
    while i < k {
        ibuf_push(out, ibuf_get(b, i))
        i += 1
    }
    return out
}

fn linq_skip(b: IntBuf, skip_n: i64) -> IntBuf {
    n := ibuf_len(b)
    mut s := skip_n
    if s < 0 { s = 0 }
    if s > n { s = n }
    out := ibuf_new((n - s) + 4)
    mut i := s
    while i < n {
        ibuf_push(out, ibuf_get(b, i))
        i += 1
    }
    return out
}

fn linq_filter_range(b: IntBuf, lo: i64, hi: i64) -> IntBuf {
    n := ibuf_len(b)
    out := ibuf_new(n + 4)
    mut i := 0
    while i < n {
        v := ibuf_get(b, i)
        if v >= lo and v <= hi {
            ibuf_push(out, v)
        }
        i += 1
    }
    return out
}

fn linq_zip_add(a: IntBuf, b: IntBuf) -> IntBuf {
    na := ibuf_len(a)
    nb := ibuf_len(b)
    limit := if na < nb { na } else { nb }
    out := ibuf_new(limit + 4)
    mut i := 0
    while i < limit {
        ibuf_push(out, ibuf_get(a, i) + ibuf_get(b, i))
        i += 1
    }
    return out
}

// --- 4. C++ `<algorithm>` & `<numeric>` Zero-Alloc In-Place Contiguous Transforms ---

// In-place Shell-Knuth / Insertion Hybrid Sort (`@no_alloc`, O(N log^2 N) worst-case, 0 stack/heap alloc!)
@no_alloc
fn algo_sort_asc(b: IntBuf) {
    n := ibuf_len(b)
    if n <= 1 { return }
    mut gap := 1
    while gap < n / 3 {
        gap = gap * 3 + 1
    }
    while gap >= 1 {
        mut i := gap
        while i < n {
            key := ibuf_get(b, i)
            mut j := i
            while j >= gap and ibuf_get(b, j - gap) > key {
                ibuf_set(b, j, ibuf_get(b, j - gap))
                j -= gap
            }
            ibuf_set(b, j, key)
            i += 1
        }
        gap = gap / 3
    }
}

@no_alloc
fn algo_sort_desc(b: IntBuf) {
    algo_sort_asc(b)
    algo_reverse(b)
}

@no_alloc
fn algo_reverse(b: IntBuf) {
    mut lo := 0
    mut hi := ibuf_len(b) - 1
    while lo < hi {
        tmp := ibuf_get(b, lo)
        ibuf_set(b, lo, ibuf_get(b, hi))
        ibuf_set(b, hi, tmp)
        lo += 1
        hi -= 1
    }
}

// C++ `std::lower_bound` on sorted `IntBuf`: first index `i` where `b[i] >= target` (or `len(b)`)
@no_alloc
fn algo_lower_bound(b: IntBuf, target: i64) -> i64 {
    mut lo := 0
    mut hi := ibuf_len(b)
    while lo < hi {
        mid := lo + (hi - lo) / 2
        if ibuf_get(b, mid) < target {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo
}

// C++ `std::upper_bound` on sorted `IntBuf`: first index `i` where `b[i] > target` (or `len(b)`)
@no_alloc
fn algo_upper_bound(b: IntBuf, target: i64) -> i64 {
    mut lo := 0
    mut hi := ibuf_len(b)
    while lo < hi {
        mid := lo + (hi - lo) / 2
        if ibuf_get(b, mid) <= target {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo
}

// C++ `std::unique` in-place deduplication on sorted `IntBuf`; returns unique element count
@no_alloc
fn algo_unique_sorted(b: IntBuf) -> i64 {
    n := ibuf_len(b)
    if n <= 1 { return n }
    mut write_idx := 1
    mut read_idx := 1
    mut prev := ibuf_get(b, 0)
    while read_idx < n {
        cur := ibuf_get(b, read_idx)
        if cur != prev {
            ibuf_set(b, write_idx, cur)
            write_idx += 1
            prev = cur
        }
        read_idx += 1
    }
    return write_idx
}

// C++ `std::inclusive_scan` in-place prefix sum (`b[i] = sum(b[0..i])`)
@no_alloc
fn algo_prefix_sum_inplace(b: IntBuf) {
    n := ibuf_len(b)
    mut acc := 0
    mut i := 0
    while i < n {
        acc += ibuf_get(b, i)
        ibuf_set(b, i, acc)
        i += 1
    }
}

// C++ `std::adjacent_difference` in-place discrete derivative (`b[i] = b[i] - b[i-1]`)
@no_alloc
fn algo_adjacent_diff_inplace(b: IntBuf) {
    n := ibuf_len(b)
    if n <= 1 { return }
    mut i := n - 1
    while i >= 1 {
        ibuf_set(b, i, ibuf_get(b, i) - ibuf_get(b, i - 1))
        i -= 1
    }
}

@no_alloc
fn algo_clamp_inplace(b: IntBuf, lo: i64, hi: i64) {
    n := ibuf_len(b)
    mut i := 0
    while i < n {
        v := ibuf_get(b, i)
        if v < lo { ibuf_set(b, i, lo) }
        else if v > hi { ibuf_set(b, i, hi) }
        i += 1
    }
}
