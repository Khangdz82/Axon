// Axon Standard Civil Calendar, Timestamp & ISO-8601 Date/Time Library (`std/datetime.ax`)
// Uses Howard Hinnant's O(1) civil-from-days / days-from-civil algorithms (zero lookup tables, zero GC).

use std::str

struct DateTime {
    year: i64
    month: i64
    day: i64
    hour: i64
    minute: i64
    second: i64
    unix_sec: i64
}

@no_alloc
fn dt_is_leap_year(year: i64) -> bool {
    return (year % 4 == 0) and ((year % 100 != 0) or (year % 400 == 0))
}

@no_alloc
fn dt_days_in_month(year: i64, month: i64) -> i64 {
    if month == 2 {
        if dt_is_leap_year(year) { return 29 }
        return 28
    }
    if month == 4 or month == 6 or month == 9 or month == 11 { return 30 }
    return 31
}

// Howard Hinnant O(1) days-since-1970-01-01 from (year, month, day)
@no_alloc
fn dt_days_from_civil(y_in: i64, m: i64, d: i64) -> i64 {
    mut y := y_in
    if m <= 2 { y -= 1 }
    era := if y >= 0 { y / 400 } else { (y - 399) / 400 }
    yoe := y - era * 400
    mp := if m > 2 { m - 3 } else { m + 9 }
    doy := (153 * mp + 2) / 5 + d - 1
    doe := yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

// Howard Hinnant O(1) civil (year, month, day) from days-since-1970-01-01
@no_alloc
fn dt_from_unix(unix_sec: i64) -> DateTime {
    mut days := unix_sec / 86400
    mut rem := unix_sec % 86400
    if rem < 0 {
        rem += 86400
        days -= 1
    }
    hr := rem / 3600
    rem = rem % 3600
    mn := rem / 60
    sc := rem % 60

    z := days + 719468
    era := if z >= 0 { z / 146097 } else { (z - 146096) / 146097 }
    doe := z - era * 146097
    yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    mut y := yoe + era * 400
    doy := doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp := (5 * doy + 2) / 153
    d := doy - (153 * mp + 2) / 5 + 1
    m := if mp < 10 { mp + 3 } else { mp - 9 }
    if m <= 2 { y += 1 }

    return DateTime(year = y, month = m, day = d, hour = hr, minute = mn, second = sc, unix_sec = unix_sec)
}

@no_alloc
fn dt_to_unix(year: i64, month: i64, day: i64, hour: i64 = 0, minute: i64 = 0, second: i64 = 0) -> i64 {
    days := dt_days_from_civil(year, month, day)
    return days * 86400 + hour * 3600 + minute * 60 + second
}

// Day of week: 0 = Sunday .. 6 = Saturday
@no_alloc
fn dt_day_of_week(unix_sec: i64) -> i64 {
    days := unix_sec / 86400
    mut w := (days + 4) % 7
    if w < 0 { w += 7 }
    return w
}

@no_alloc
fn dt_add_seconds(dt: DateTime, delta_sec: i64) -> DateTime {
    return dt_from_unix(dt.unix_sec + delta_sec)
}

@no_alloc
fn dt_add_days(dt: DateTime, delta_days: i64) -> DateTime {
    return dt_from_unix(dt.unix_sec + delta_days * 86400)
}

fn _dt_pad2(v: i64) -> str {
    if v < 10 { return f"0{v}" }
    return f"{v}"
}

fn dt_format_iso8601(dt: DateTime) -> str {
    return f"{dt.year}-" + _dt_pad2(dt.month) + "-" + _dt_pad2(dt.day) +
           "T" + _dt_pad2(dt.hour) + ":" + _dt_pad2(dt.minute) + ":" + _dt_pad2(dt.second) + "Z"
}

@no_alloc
fn _dt_slice_int(s: str, off: i64, len: i64) -> i64 {
    mut acc := 0
    mut i := 0
    while i < len {
        ch := str_byte(s, off + i)
        if ch < 48 or ch > 57 { return -1 }
        acc = acc * 10 + (ch - 48)
        i += 1
    }
    return acc
}

// Parses "YYYY-MM-DDTHH:MM:SSZ" or "YYYY-MM-DD HH:MM:SS"
@no_alloc
fn dt_parse_iso8601(s: str) -> DateTime {
    if str_len(s) < 19 { return dt_from_unix(0) }
    yr := _dt_slice_int(s, 0, 4)
    mo := _dt_slice_int(s, 5, 2)
    dy := _dt_slice_int(s, 8, 2)
    hr := _dt_slice_int(s, 11, 2)
    mn := _dt_slice_int(s, 14, 2)
    sc := _dt_slice_int(s, 17, 2)
    if yr < 0 or mo < 1 or mo > 12 or dy < 1 or dy > 31 { return dt_from_unix(0) }
    ts := dt_to_unix(yr, mo, dy, hr, mn, sc)
    return DateTime(year = yr, month = mo, day = dy, hour = hr, minute = mn, second = sc, unix_sec = ts)
}
