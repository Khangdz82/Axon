// Axon Standard Library — Directed/Weighted Graph Algorithms (`std/graph.ax`)
// Cache-friendly forward-star adjacency list (`head` + `[to, weight, next]`) supporting
// BFS shortest hops, Binary-Heap Dijkstra shortest paths, and Kahn's cycle-detecting Topological Sort.

use std::algo
use std::ds

struct Graph {
    n_verts: i64
    n_edges: i64
    edge_cap: i64
    head: IntBuf
    edges: IntBuf // stride 3: `[to, weight, next_edge]`
}

fn graph_new(n_verts: i64, est_edges: i64 = 64) -> Graph {
    mut nv := n_verts
    if nv < 0 { nv = 0 }
    mut ec := est_edges
    if ec < 16 { ec = 16 }
    hd := ibuf_new(nv + 4)
    mut i := 0
    while i < nv { ibuf_push(hd, -1); i += 1 }
    return Graph(
        n_verts = nv,
        n_edges = 0,
        edge_cap = ec,
        head = hd,
        edges = ibuf_new(ec * 3)
    )
}

fn graph_free(move g: Graph) {
    buf_free(move g.head)
    buf_free(move g.edges)
}

fn graph_add_edge(mut g: Graph, u: i64, v: i64, weight: i64 = 1) {
    if u < 0 or u >= g.n_verts or v < 0 or v >= g.n_verts { return }
    if g.n_edges >= g.edge_cap {
        nec := g.edge_cap * 2
        ne := ibuf_new(nec * 3)
        mut i := 0
        while i < g.n_edges * 3 {
            ibuf_push(ne, ibuf_get(g.edges, i))
            i += 1
        }
        buf_free(move g.edges)
        g.edges = ne
        g.edge_cap = nec
    }
    eidx := g.n_edges
    ibuf_push(g.edges, v)
    ibuf_push(g.edges, weight)
    ibuf_push(g.edges, ibuf_get(g.head, u))
    ibuf_set(g.head, u, eidx)
    g.n_edges = eidx + 1
}

fn graph_add_undirected(mut g: Graph, u: i64, v: i64, weight: i64 = 1) {
    graph_add_edge(mut g, u, v, weight)
    graph_add_edge(mut g, v, u, weight)
}

// Unweighted BFS shortest hop distances from `src` (`-1` if unreachable).
fn graph_bfs(g: Graph, src: i64) -> IntBuf {
    dist := ibuf_new(g.n_verts + 4)
    mut i := 0
    while i < g.n_verts { ibuf_push(dist, -1); i += 1 }
    if src < 0 or src >= g.n_verts { return dist }

    mut q := deque_new(g.n_verts + 8)
    ibuf_set(dist, src, 0)
    deque_push_back(mut q, src)
    while deque_len(q) > 0 {
        u := deque_pop_front(mut q)
        du := ibuf_get(dist, u)
        mut e := ibuf_get(g.head, u)
        while e >= 0 {
            b := e * 3
            v := ibuf_get(g.edges, b)
            if ibuf_get(dist, v) < 0 {
                ibuf_set(dist, v, du + 1)
                deque_push_back(mut q, v)
            }
            e = ibuf_get(g.edges, b + 2)
        }
    }
    deque_free(move q)
    return dist
}

// Non-negative weighted Dijkstra shortest distances from `src` (`0x3FFFFFFFFFFFFFFF` if unreachable).
fn graph_dijkstra(g: Graph, src: i64) -> IntBuf {
    inf := 0x3FFFFFFFFFFFFFFF
    dist := ibuf_new(g.n_verts + 4)
    mut i := 0
    while i < g.n_verts { ibuf_push(dist, inf); i += 1 }
    if src < 0 or src >= g.n_verts { return dist }

    pq := heap_kv_new(g.n_edges + 16)
    ibuf_set(dist, src, 0)
    heap_push_kv_min(pq, 0, src)
    while heap_kv_len(pq) > 0 {
        (d, u) := heap_pop_kv_min(pq)
        if d <= ibuf_get(dist, u) {
            mut e := ibuf_get(g.head, u)
            while e >= 0 {
                b := e * 3
                v := ibuf_get(g.edges, b)
                w := ibuf_get(g.edges, b + 1)
                if w >= 0 {
                    nd := d + w
                    if nd < ibuf_get(dist, v) {
                        ibuf_set(dist, v, nd)
                        heap_push_kv_min(pq, nd, v)
                    }
                }
                e = ibuf_get(g.edges, b + 2)
            }
        }
    }
    buf_free(move pq)
    return dist
}

// Kahn's topological sort -> returns `ok(order)` of length `g.n_verts`, or `err(-1)` if graph contains a cycle!
fn graph_toposort(g: Graph) -> IntBuf ! i64 {
    indeg := ibuf_new(g.n_verts + 4)
    mut i := 0
    while i < g.n_verts { ibuf_push(indeg, 0); i += 1 }
    mut e := 0
    while e < g.n_edges {
        v := ibuf_get(g.edges, e * 3)
        ibuf_set(indeg, v, ibuf_get(indeg, v) + 1)
        e += 1
    }
    mut q := deque_new(g.n_verts + 8)
    i = 0
    while i < g.n_verts {
        if ibuf_get(indeg, i) == 0 { deque_push_back(mut q, i) }
        i += 1
    }
    order := ibuf_new(g.n_verts + 4)
    while deque_len(q) > 0 {
        u := deque_pop_front(mut q)
        ibuf_push(order, u)
        mut ei := ibuf_get(g.head, u)
        while ei >= 0 {
            b := ei * 3
            v := ibuf_get(g.edges, b)
            nd := ibuf_get(indeg, v) - 1
            ibuf_set(indeg, v, nd)
            if nd == 0 { deque_push_back(mut q, v) }
            ei = ibuf_get(g.edges, b + 2)
        }
    }
    deque_free(move q)
    buf_free(move indeg)
    if ibuf_len(order) != g.n_verts {
        buf_free(move order)
        return err(-1)
    }
    return ok(order)
}
