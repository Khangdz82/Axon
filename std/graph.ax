// Axon Standard Library — Directed/Weighted Graph Algorithms (`std/graph.ax`)
// Cache-friendly forward-star adjacency list (`head` + `[to, weight, next]`) supporting
// compact 32-bit storage (4B/vert + 12B/edge, auto-widening to 64-bit if weights/verts exceed i32),
// BFS shortest hops, Dial + 4-ary Heap Dijkstra shortest paths, and Kahn's cycle-detecting Topological Sort.

use std::algo
use std::ds

@inline
fn _r32(p: i64, i: i64) -> i64 {
    unsafe {
        q := ptr_read_i64(p, i >> 1)
        v := if (i & 1) == 0 { q } else { ushr64(q, 32) }
        return (v << 32) >> 32
    }
}

@inline
fn _w32(p: i64, i: i64, val: i64) {
    unsafe {
        qi := i >> 1
        q := ptr_read_i64(p, qi)
        if (i & 1) == 0 {
            ptr_write_i64(p, qi, (q & (-4294967296)) | (val & 0xFFFFFFFF))
        } else {
            ptr_write_i64(p, qi, (q & 0xFFFFFFFF) | ((val & 0xFFFFFFFF) << 32))
        }
    }
}

struct Graph {
    n_verts: i64
    n_edges: i64
    edge_cap: i64
    wide: i64
    head: IntBuf
    edges: IntBuf // compact (wide==0): 1xi64 packed (to:u16 | weight:u16<<16 | next:i32<<32); wide==1: 3xi64 [to, weight, next]
}

fn graph_new(n_verts: i64, est_edges: i64 = 64) -> Graph {
    mut nv := n_verts
    if nv < 0 { nv = 0 }
    mut ec := est_edges
    if ec < 16 { ec = 16 }
    wide := if nv > 65535 { 1 } else { 0 }
    if wide == 0 {
        hd := ibuf_new(((nv + 1) >> 1) + 4)
        ed := ibuf_new(ec + 4)
        unsafe {
            ptr_write_i64(hd as i64, 0, (nv + 1) >> 1)
            if nv > 0 { mem_set((hd as i64) + 16, 255, nv * 4) }
        }
        return Graph(n_verts = nv, n_edges = 0, edge_cap = ec, wide = 0, head = hd, edges = ed)
    }
    hd := ibuf_new(nv + 4)
    unsafe {
        ptr_write_i64(hd as i64, 0, nv)
        if nv > 0 { mem_set((hd as i64) + 16, 255, nv * 8) }
    }
    return Graph(
        n_verts = nv,
        n_edges = 0,
        edge_cap = ec,
        wide = 1,
        head = hd,
        edges = ibuf_new(ec * 3)
    )
}

fn graph_free(move g: Graph) {
    buf_free(move g.head)
    buf_free(move g.edges)
}

fn _graph_widen(mut g: Graph) {
    if g.wide != 0 { return }
    nv := g.n_verts
    ne := g.n_edges
    nhd := ibuf_new(nv + 4)
    ned := ibuf_new(g.edge_cap * 3 + 4)
    unsafe {
        ohp := (g.head as i64) + 16
        nhp := (nhd as i64) + 16
        ptr_write_i64(nhd as i64, 0, nv)
        mut i := 0
        while i < nv { ptr_write_i64(nhp, i, _r32(ohp, i)); i += 1 }
        oep := (g.edges as i64) + 16
        nep := (ned as i64) + 16
        ptr_write_i64(ned as i64, 0, ne * 3)
        mut e := 0
        while e < ne {
            pk := ptr_read_i64(oep, e)
            b := e + (e << 1)
            ptr_write_i64(nep, b, pk & 0xFFFF)
            ptr_write_i64(nep, b + 1, ushr64(pk, 16) & 0xFFFF)
            ptr_write_i64(nep, b + 2, pk >> 32)
            e += 1
        }
    }
    buf_free(move g.head)
    buf_free(move g.edges)
    g.head = nhd
    g.edges = ned
    g.wide = 1
}

fn graph_add_edge(mut g: Graph, u: i64, v: i64, weight: i64 = 1) {
    if u < 0 or u >= g.n_verts or v < 0 or v >= g.n_verts { return }
    if g.wide == 0 and (weight < 0 or weight > 65535 or g.n_edges >= 1000000000) {
        _graph_widen(mut g)
    }
    if g.wide == 0 {
        if g.n_edges >= g.edge_cap {
            nec := g.edge_cap * 2
            ne := ibuf_new(nec + 4)
            unsafe {
                mem_copy((ne as i64) + 16, (g.edges as i64) + 16, g.n_edges * 8)
            }
            buf_free(move g.edges)
            g.edges = ne
            g.edge_cap = nec
        }
        eidx := g.n_edges
        unsafe {
            hp := (g.head as i64) + 16
            ep := (g.edges as i64) + 16
            prev := _r32(hp, u)
            ptr_write_i64(ep, eidx, v | (weight << 16) | ((prev & 0xFFFFFFFF) << 32))
            _w32(hp, u, eidx)
        }
        g.n_edges = eidx + 1
        return
    }
    if g.n_edges >= g.edge_cap {
        nec := g.edge_cap * 2
        ne := ibuf_new(nec * 3)
        unsafe {
            ptr_write_i64(ne as i64, 0, g.n_edges * 3)
            mem_copy((ne as i64) + 16, (g.edges as i64) + 16, g.n_edges * 24)
        }
        buf_free(move g.edges)
        g.edges = ne
        g.edge_cap = nec
    }
    eidx := g.n_edges
    ibuf_push(g.edges, v)
    ibuf_push(g.edges, weight)
    ibuf_push(g.edges, ibuf_get(g.head, u))
    ibuf_set(g.head, u, eidx)
    g.n_edges = eidx + 1
}

fn graph_add_undirected(mut g: Graph, u: i64, v: i64, weight: i64 = 1) {
    graph_add_edge(mut g, u, v, weight)
    graph_add_edge(mut g, v, u, weight)
}

// Unweighted BFS shortest hop distances from `src` (`-1` if unreachable).
fn graph_bfs(g: Graph, src: i64) -> IntBuf {
    nv := g.n_verts
    dist := ibuf_new(nv + 4)
    if nv <= 0 { return dist }
    unsafe {
        dp := (dist as i64) + 16
        ptr_write_i64(dist as i64, 0, nv)
        mem_set(dp, 255, nv * 8)
        if src < 0 or src >= nv { return dist }
        q := mem_alloc_aligned(nv * 8 + 64)
        if q != 0 {
            hp := (g.head as i64) + 16
            ep := (g.edges as i64) + 16
            ptr_write_i64(dp, src, 0)
            ptr_write_i64(q, 0, src)
            mut qh := 0; mut qt := 1
            if g.wide == 0 {
                while qh < qt {
                    u := ptr_read_i64(q, qh); qh += 1
                    nd := ptr_read_i64(dp, u) + 1
                    mut e := _r32(hp, u)
                    while e >= 0 {
                        pk := ptr_read_i64(ep, e)
                        v := pk & 0xFFFF
                        if ptr_read_i64(dp, v) < 0 {
                            ptr_write_i64(dp, v, nd)
                            ptr_write_i64(q, qt, v); qt += 1
                        }
                        e = pk >> 32
                    }
                }
            } else {
                while qh < qt {
                    u := ptr_read_i64(q, qh); qh += 1
                    nd := ptr_read_i64(dp, u) + 1
                    mut e := ptr_read_i64(hp, u)
                    while e >= 0 {
                        b := e + (e << 1)
                        v := ptr_read_i64(ep, b)
                        if ptr_read_i64(dp, v) < 0 {
                            ptr_write_i64(dp, v, nd)
                            ptr_write_i64(q, qt, v); qt += 1
                        }
                        e = ptr_read_i64(ep, b + 2)
                    }
                }
            }
            mem_free_aligned(q)
            return dist
        }
    }
    return dist
}

// Call-free 4-ary cache-line Dijkstra core (promotes all 10 GPRs with zero stack spills!)
// Returns `0` on success, `1` if heap capacity exceeded (caller grows heap), or `-1` on dist overflow.
fn _dijkstra_4ary_core(nv: i64, src: i64, dp: i64, hp: i64, ep: i64, heap: i64, hcap: i64, is_wide: i64) -> i64 {
    unsafe {
        mut hsz := 1
        ptr_write_i64(heap, 0, src)
        while hsz > 0 {
            top := ptr_read_i64(heap, 0)
            hsz -= 1
            if hsz > 0 {
                last := ptr_read_i64(heap, hsz)
                mut idx := 0
                while true {
                    c0 := (idx << 2) + 1
                    if c0 >= hsz { break }
                    mut best_c := c0
                    mut best_v := ptr_read_i64(heap, c0)
                    if c0 + 3 < hsz {
                        v1 := ptr_read_i64(heap, c0 + 1)
                        mut v2 := ptr_read_i64(heap, c0 + 2)
                        v3 := ptr_read_i64(heap, c0 + 3)
                        if v1 < best_v { best_v = v1; best_c = c0 + 1 }
                        mut b23 := c0 + 2
                        if v3 < v2 { v2 = v3; b23 = c0 + 3 }
                        if v2 < best_v { best_v = v2; best_c = b23 }
                    } else {
                        c1 := c0 + 1
                        if c1 < hsz {
                            v1 := ptr_read_i64(heap, c1)
                            if v1 < best_v { best_v = v1; best_c = c1 }
                            c2 := c0 + 2
                            if c2 < hsz {
                                v2 := ptr_read_i64(heap, c2)
                                if v2 < best_v { best_v = v2; best_c = c2 }
                            }
                        }
                    }
                    if last <= best_v { break }
                    ptr_write_i64(heap, idx, best_v)
                    idx = best_c
                }
                ptr_write_i64(heap, idx, last)
            }
            d := ushr64(top, 20)
            u := top & 0xFFFFF
            if d <= ptr_read_i64(dp, u) {
                mut e := if is_wide == 0 { _r32(hp, u) } else { ptr_read_i64(hp, u) }
                while e >= 0 {
                    mut v := 0
                    mut w := 0
                    mut nxt := -1
                    if is_wide == 0 {
                        pk := ptr_read_i64(ep, e)
                        v = pk & 0xFFFF
                        w = ushr64(pk, 16) & 0xFFFF
                        nxt = pk >> 32
                    } else {
                        b := e + (e << 1)
                        v = ptr_read_i64(ep, b)
                        w = ptr_read_i64(ep, b + 1)
                        nxt = ptr_read_i64(ep, b + 2)
                    }
                    if w >= 0 {
                        nd := d + w
                        if nd < ptr_read_i64(dp, v) {
                            if nd >= 0x40000000000 { return -1 }
                            ptr_write_i64(dp, v, nd)
                            if hsz >= hcap { return 1 }
                            entry := (nd << 20) | v
                            mut pi := hsz
                            hsz += 1
                            while pi > 0 {
                                par := ushr64(pi - 1, 2)
                                pv := ptr_read_i64(heap, par)
                                if pv <= entry { break }
                                ptr_write_i64(heap, pi, pv)
                                pi = par
                            }
                            ptr_write_i64(heap, pi, entry)
                        }
                    }
                    e = nxt
                }
            }
        }
        return 0
    }
}

// Non-negative weighted Dijkstra shortest distances from `src` (`0x3FFFFFFFFFFFFFFF` if unreachable).
// Fastpath 1: Compact L1D-resident u32 Dial's O(V + E) circular 512-bucket queue for bounded weights `0 <= w < 512`.
// Fastpath 2: Call-free 10-GPR 4-ary cache-line heap with packed `(dist << 20) | node` entries for `n_verts <= 1048576`.
fn graph_dijkstra(g: Graph, src: i64) -> IntBuf {
    inf := 0x3FFFFFFFFFFFFFFF
    nv := g.n_verts
    dist := ibuf_new(nv + 4)
    if nv <= 0 or src < 0 or src >= nv {
        mut i := 0
        while i < nv { ibuf_push(dist, inf); i += 1 }
        return dist
    }
    if nv <= 1048576 {
        unsafe {
            dp := (dist as i64) + 16
            ptr_write_i64(dist as i64, 0, nv)
            hp := (g.head as i64) + 16
            ep := (g.edges as i64) + 16
            mut hcap := if nv <= 8192 { nv + (nv >> 1) + (nv >> 3) + 256 } else { 65535 }
            if hcap > g.n_edges + nv + 256 { hcap = g.n_edges + nv + 256 }
            if hcap < 128 { hcap = 128 }
            mut try_dial := true
            mut try_128 := true
            mut attempt := 0
            while attempt < 4 {
                if try_dial {
                    use_c32 := g.wide == 0 and nv <= 65535 and hcap <= 65535
                    use_u32 := g.wide != 0 and nv <= 65535 and hcap <= 65535
                    if use_c32 {
                        bh_bytes := if try_128 { 512 } else { 2048 }
                        dist_bytes := (nv * 4 + 63) & (-64)
                        buf_sz := bh_bytes + dist_bytes + hcap * 4 + 64
                        buf := mem_alloc_raw(buf_sz)
                        if buf == 0 { break }
                        pool := buf + bh_bytes + dist_bytes
                        flags := if try_128 { (1 << 62) | (1 << 61) | (1 << 60) } else { (1 << 62) | (1 << 61) }
                        ptr_write_i64(pool, 0, hcap | (nv << 32) | flags)
                        rc := avx_dijkstra_dial(src, dp, hp, ep, buf, pool)
                        mem_free_aligned(buf)
                        if rc == 0 { return dist }
                        if rc == 3 {
                            try_128 = false
                            attempt += 1
                        } else if rc == 2 {
                            try_dial = false
                        } else {
                            if hcap < 65535 { hcap = 65535 } else { hcap = hcap * 4 }
                            attempt += 1
                        }
                    } else if g.wide == 0 {
                        // Large compact graph (>65535 verts/hcap): fall straight to 4-ary heap
                        try_dial = false
                    } else {
                        mem_set(dp, 0x3F, nv * 8)
                        ptr_write_i64(dp, src, 0)
                        buf_sz := if use_u32 { 2048 + hcap * 4 + 64 } else { 4096 + hcap * 8 + 64 }
                        buf := mem_alloc_raw(buf_sz)
                        if buf == 0 { break }
                        if not use_u32 { mem_set(buf, 0, 4096) }
                        pool := buf + (if use_u32 { 2048 } else { 4096 })
                        ptr_write_i64(pool, 0, if use_u32 { hcap | (1 << 62) } else { hcap })
                        rc := avx_dijkstra_dial(src, dp, hp, ep, buf, pool)
                        mem_free_aligned(buf)
                        if rc == 0 { return dist }
                        if rc == 2 {
                            try_dial = false
                        } else {
                            hcap = hcap * 4
                            attempt += 1
                        }
                    }
                } else {
                    mem_set(dp, 0x3F, nv * 8)
                    ptr_write_i64(dp, src, 0)
                    heap := mem_alloc_raw(hcap * 8 + 64)
                    if heap == 0 { break }
                    rc := _dijkstra_4ary_core(nv, src, dp, hp, ep, heap, hcap, g.wide)
                    mem_free_aligned(heap)
                    if rc == 0 { return dist }
                    if rc < 0 { break }
                    hcap = hcap * 4
                    attempt += 1
                }
            }
            ibuf_truncate(dist, 0)
        }
    }
    mut i := 0
    while i < nv { ibuf_push(dist, inf); i += 1 }
    pq := heap_kv_new(g.n_edges + 16)
    ibuf_set(dist, src, 0)
    heap_push_kv_min(pq, 0, src)
    while heap_kv_len(pq) > 0 {
        (d, u) := heap_pop_kv_min(pq)
        if d <= ibuf_get(dist, u) {
            unsafe {
                hp := (g.head as i64) + 16
                ep := (g.edges as i64) + 16
                mut e := if g.wide == 0 { _r32(hp, u) } else { ptr_read_i64(hp, u) }
                while e >= 0 {
                    mut v := 0
                    mut w := 0
                    mut nxt := -1
                    if g.wide == 0 {
                        pk := ptr_read_i64(ep, e)
                        v = pk & 0xFFFF
                        w = ushr64(pk, 16) & 0xFFFF
                        nxt = pk >> 32
                    } else {
                        b := e * 3
                        v = ptr_read_i64(ep, b)
                        w = ptr_read_i64(ep, b + 1)
                        nxt = ptr_read_i64(ep, b + 2)
                    }
                    if w >= 0 {
                        nd := d + w
                        if nd < ibuf_get(dist, v) {
                            ibuf_set(dist, v, nd)
                            heap_push_kv_min(pq, nd, v)
                        }
                    }
                    e = nxt
                }
            }
        }
    }
    buf_free(move pq)
    return dist
}

// Kahn's topological sort -> returns `ok(order)` of length `g.n_verts`, or `err(-1)` if graph contains a cycle!
fn graph_toposort(g: Graph) -> IntBuf ! i64 {
    nv := g.n_verts
    ne := g.n_edges
    order := ibuf_new(nv + 4)
    if nv <= 0 { return ok(order) }
    unsafe {
        indeg := mem_alloc_aligned(nv * 8 + 64)
        if indeg == 0 { buf_free(move order); return err(-1) }
        mem_set(indeg, 0, nv * 8)
        op := (order as i64) + 16
        hp := (g.head as i64) + 16
        ep := (g.edges as i64) + 16
        mut e := 0
        if g.wide == 0 {
            while e < ne {
                v := ptr_read_i64(ep, e) & 0xFFFF
                ptr_write_i64(indeg, v, ptr_read_i64(indeg, v) + 1)
                e += 1
            }
        } else {
            while e < ne {
                v := ptr_read_i64(ep, e + (e << 1))
                ptr_write_i64(indeg, v, ptr_read_i64(indeg, v) + 1)
                e += 1
            }
        }
        mut qh := 0; mut qt := 0; mut i := 0
        while i < nv {
            if ptr_read_i64(indeg, i) == 0 { ptr_write_i64(op, qt, i); qt += 1 }
            i += 1
        }
        if g.wide == 0 {
            while qh < qt {
                u := ptr_read_i64(op, qh); qh += 1
                mut ei := _r32(hp, u)
                while ei >= 0 {
                    pk := ptr_read_i64(ep, ei)
                    v := pk & 0xFFFF
                    nd := ptr_read_i64(indeg, v) - 1
                    ptr_write_i64(indeg, v, nd)
                    if nd == 0 { ptr_write_i64(op, qt, v); qt += 1 }
                    ei = pk >> 32
                }
            }
        } else {
            while qh < qt {
                u := ptr_read_i64(op, qh); qh += 1
                mut ei := ptr_read_i64(hp, u)
                while ei >= 0 {
                    b := ei + (ei << 1)
                    v := ptr_read_i64(ep, b)
                    nd := ptr_read_i64(indeg, v) - 1
                    ptr_write_i64(indeg, v, nd)
                    if nd == 0 { ptr_write_i64(op, qt, v); qt += 1 }
                    ei = ptr_read_i64(ep, b + 2)
                }
            }
        }
        mem_free_aligned(indeg)
        ptr_write_i64(order as i64, 0, qt)
        if qt != nv { buf_free(move order); return err(-1) }
    }
    return ok(order)
}
