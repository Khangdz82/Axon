// Axon 2D & 3D High-Performance Physics Engine (std/game_physics.ax)
// 100% Pure Axon: Zero GC, Zero external dependencies, Perceus ref counting.
// Features:
//   - 2D SAT (Separating Axis Theorem) convex polygon and OBB collision
//   - 2D Circle-Circle, Circle-AABB, and Circle-Polygon contact manifolds
//   - 2D Raycasting (circles, AABB boxes, line segments, polygons)
//   - 2D Impulse resolution with restitution, friction, linear and angular momentum
//   - 3D AABB overlap and raycast
//   - 3D Moller-Trumbore ray-triangle exact intersection
//   - 3D Rigid body kinematics integration (quaternion orientation, angular velocity)

use std::math3d
use std::os

// --- 2D Structures ---
struct Circle2D {
    cx: f64
    cy: f64
    r: f64
}

struct Ray2D {
    ox: f64
    oy: f64
    dx: f64
    dy: f64
}

struct RayHit2D {
    hit: bool
    t: f64
    nx: f64
    ny: f64
}

struct CollisionManifold2D {
    has_hit: bool
    depth: f64
    nx: f64
    ny: f64
    cx: f64
    cy: f64
}

@no_alloc
fn p2_wrap_angle(a: f64) -> f64 {
    if not (a >= -1000000000000000.0 and a <= 1000000000000000.0) {
        return 0.0
    }
    pi := 3.141592653589793
    two_pi := 6.283185307179586
    q := (a / two_pi) as i64
    mut x := a - (q as f64) * two_pi
    if x > pi { x = x - two_pi }
    if x < (0.0 - pi) { x = x + two_pi }
    return x
}

@no_alloc
fn p2_sin(rad: f64) -> f64 {
    pi := 3.141592653589793
    half_pi := 1.5707963267948966
    mut x := p2_wrap_angle(rad)
    if x > half_pi { x = pi - x }
    else if x < (0.0 - half_pi) { x = (0.0 - pi) - x }
    x2 := x * x
    mut term := x
    mut sum := x
    term = term * (0.0 - x2) / 6.0
    sum = sum + term
    term = term * (0.0 - x2) / 20.0
    sum = sum + term
    term = term * (0.0 - x2) / 42.0
    sum = sum + term
    term = term * (0.0 - x2) / 72.0
    sum = sum + term
    return sum
}

@no_alloc
fn p2_cos(rad: f64) -> f64 {
    return p2_sin(rad + 1.5707963267948966)
}

@no_alloc
fn p2_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

@no_alloc
fn p2_sqrt(x: f64) -> f64 {
    if not (x > 0.0) { return 0.0 }
    return sqrt_f64(x)
}

@no_alloc
fn p2_dot(x1: f64, y1: f64, x2: f64, y2: f64) -> f64 {
    return x1 * x2 + y1 * y2
}

@no_alloc
fn p2_cross(x1: f64, y1: f64, x2: f64, y2: f64) -> f64 {
    return x1 * y2 - y1 * x2
}

// --- 1. 2D Circle Collisions ---

@no_alloc
fn phys2d_circle_vs_circle(c1: Circle2D, c2: Circle2D) -> CollisionManifold2D {
    if not (c1.r >= 0.0 and c2.r >= 0.0) {
        return CollisionManifold2D(has_hit = false, depth = 0.0, nx = 0.0, ny = 0.0, cx = 0.0, cy = 0.0)
    }
    dx := c2.cx - c1.cx
    dy := c2.cy - c1.cy
    dist_sq := dx * dx + dy * dy
    rad_sum := c1.r + c2.r
    if not (dist_sq >= 0.0 and dist_sq < rad_sum * rad_sum) {
        return CollisionManifold2D(has_hit = false, depth = 0.0, nx = 0.0, ny = 0.0, cx = 0.0, cy = 0.0)
    }
    dist := p2_sqrt(dist_sq)
    mut nx := 1.0
    mut ny := 0.0
    if dist > 0.000001 {
        nx = dx / dist
        ny = dy / dist
    }
    depth := rad_sum - dist
    cx := c1.cx + nx * (c1.r - depth * 0.5)
    cy := c1.cy + ny * (c1.r - depth * 0.5)
    return CollisionManifold2D(has_hit = true, depth = depth, nx = nx, ny = ny, cx = cx, cy = cy)
}

@no_alloc
fn phys2d_circle_vs_aabb(c: Circle2D, min_x: f64, min_y: f64, max_x: f64, max_y: f64) -> CollisionManifold2D {
    if not (c.r >= 0.0 and max_x >= min_x and max_y >= min_y) {
        return CollisionManifold2D(has_hit = false, depth = 0.0, nx = 0.0, ny = 0.0, cx = 0.0, cy = 0.0)
    }
    mut close_x := c.cx
    if close_x < min_x { close_x = min_x }
    if close_x > max_x { close_x = max_x }

    mut close_y := c.cy
    if close_y < min_y { close_y = min_y }
    if close_y > max_y { close_y = max_y }

    dx := c.cx - close_x
    dy := c.cy - close_y
    dist_sq := dx * dx + dy * dy

    if not (dist_sq >= 0.0 and dist_sq <= c.r * c.r) {
        return CollisionManifold2D(has_hit = false, depth = 0.0, nx = 0.0, ny = 0.0, cx = 0.0, cy = 0.0)
    }

    dist := p2_sqrt(dist_sq)
    mut nx := 0.0
    mut ny := 1.0
    mut depth := c.r - dist
    if dist > 0.000001 {
        nx = dx / dist
        ny = dy / dist
    } else {
        d_left := c.cx - min_x
        d_right := max_x - c.cx
        d_down := c.cy - min_y
        d_up := max_y - c.cy

        mut min_d := d_left
        nx = -1.0; ny = 0.0
        if d_right < min_d { min_d = d_right; nx = 1.0; ny = 0.0 }
        if d_down < min_d  { min_d = d_down; nx = 0.0; ny = -1.0 }
        if d_up < min_d    { min_d = d_up; nx = 0.0; ny = 1.0 }
        depth = c.r + min_d
    }

    return CollisionManifold2D(has_hit = true, depth = depth, nx = nx, ny = ny, cx = close_x, cy = close_y)
}

// --- 2. 2D SAT (Separating Axis Theorem) ---
// Vertices are passed in raw float buffers: [x0, y0, x1, y1, ...]

@no_alloc
fn phys2d_sat_polygon_vs_polygon(v_a: i64, n_a: i64, v_b: i64, n_b: i64) -> CollisionManifold2D {
    if v_a == 0 or v_b == 0 or n_a < 3 or n_b < 3 {
        return CollisionManifold2D(has_hit = false, depth = 0.0, nx = 0.0, ny = 0.0, cx = 0.0, cy = 0.0)
    }

    mut min_overlap := 1000000000.0
    mut best_nx := 0.0
    mut best_ny := 0.0
    mut valid_axes := 0

    // Test axes of Polygon A
    mut i := 0
    while i < n_a {
        x1 := ptr_read_f32(v_a, i * 2)
        y1 := ptr_read_f32(v_a, i * 2 + 1)
        next_i := (i + 1) % n_a
        x2 := ptr_read_f32(v_a, next_i * 2)
        y2 := ptr_read_f32(v_a, next_i * 2 + 1)

        mut edge_x := y2 - y1
        mut edge_y := 0.0 - (x2 - x1)
        len := p2_sqrt(edge_x * edge_x + edge_y * edge_y)
        if not (len > 0.000001) {
            i += 1
            continue
        }
        valid_axes += 1
        edge_x = edge_x / len
        edge_y = edge_y / len

        // Project A
        mut min_a := p2_dot(ptr_read_f32(v_a, 0), ptr_read_f32(v_a, 1), edge_x, edge_y)
        mut max_a := min_a
        mut j := 1
        while j < n_a {
            proj := p2_dot(ptr_read_f32(v_a, j * 2), ptr_read_f32(v_a, j * 2 + 1), edge_x, edge_y)
            if proj < min_a { min_a = proj }
            if proj > max_a { max_a = proj }
            j += 1
        }

        // Project B
        mut min_b := p2_dot(ptr_read_f32(v_b, 0), ptr_read_f32(v_b, 1), edge_x, edge_y)
        mut max_b := min_b
        j = 1
        while j < n_b {
            proj := p2_dot(ptr_read_f32(v_b, j * 2), ptr_read_f32(v_b, j * 2 + 1), edge_x, edge_y)
            if proj < min_b { min_b = proj }
            if proj > max_b { max_b = proj }
            j += 1
        }

        // Check separation (also rejects NaN intervals)
        ov1 := max_a - min_b
        ov2 := max_b - min_a
        if not (ov1 >= 0.0 and ov2 >= 0.0) {
            return CollisionManifold2D(has_hit = false, depth = 0.0, nx = 0.0, ny = 0.0, cx = 0.0, cy = 0.0)
        }

        overlap := if ov1 < ov2 { ov1 } else { ov2 }
        if overlap < min_overlap {
            min_overlap = overlap
            best_nx = edge_x
            best_ny = edge_y
        }
        i += 1
    }

    // Test axes of Polygon B
    i = 0
    while i < n_b {
        x1 := ptr_read_f32(v_b, i * 2)
        y1 := ptr_read_f32(v_b, i * 2 + 1)
        next_i := (i + 1) % n_b
        x2 := ptr_read_f32(v_b, next_i * 2)
        y2 := ptr_read_f32(v_b, next_i * 2 + 1)

        mut edge_x := y2 - y1
        mut edge_y := 0.0 - (x2 - x1)
        len := p2_sqrt(edge_x * edge_x + edge_y * edge_y)
        if not (len > 0.000001) {
            i += 1
            continue
        }
        valid_axes += 1
        edge_x = edge_x / len
        edge_y = edge_y / len

        mut min_a := p2_dot(ptr_read_f32(v_a, 0), ptr_read_f32(v_a, 1), edge_x, edge_y)
        mut max_a := min_a
        mut j := 1
        while j < n_a {
            proj := p2_dot(ptr_read_f32(v_a, j * 2), ptr_read_f32(v_a, j * 2 + 1), edge_x, edge_y)
            if proj < min_a { min_a = proj }
            if proj > max_a { max_a = proj }
            j += 1
        }

        mut min_b := p2_dot(ptr_read_f32(v_b, 0), ptr_read_f32(v_b, 1), edge_x, edge_y)
        mut max_b := min_b
        j = 1
        while j < n_b {
            proj := p2_dot(ptr_read_f32(v_b, j * 2), ptr_read_f32(v_b, j * 2 + 1), edge_x, edge_y)
            if proj < min_b { min_b = proj }
            if proj > max_b { max_b = proj }
            j += 1
        }

        ov1 := max_a - min_b
        ov2 := max_b - min_a
        if not (ov1 >= 0.0 and ov2 >= 0.0) {
            return CollisionManifold2D(has_hit = false, depth = 0.0, nx = 0.0, ny = 0.0, cx = 0.0, cy = 0.0)
        }

        overlap := if ov1 < ov2 { ov1 } else { ov2 }
        if overlap < min_overlap {
            min_overlap = overlap
            best_nx = edge_x
            best_ny = edge_y
        }
        i += 1
    }

    if valid_axes == 0 {
        return CollisionManifold2D(has_hit = false, depth = 0.0, nx = 0.0, ny = 0.0, cx = 0.0, cy = 0.0)
    }

    return CollisionManifold2D(has_hit = true, depth = min_overlap, nx = best_nx, ny = best_ny, cx = 0.0, cy = 0.0)
}

// OBB SAT Collision
fn phys2d_sat_obb_vs_obb(cx1: f64, cy1: f64, hw1: f64, hh1: f64, rot1: f64, cx2: f64, cy2: f64, hw2: f64, hh2: f64, rot2: f64) -> CollisionManifold2D {
    if not (hw1 > 0.0 and hh1 > 0.0 and hw2 > 0.0 and hh2 > 0.0) {
        return CollisionManifold2D(has_hit = false, depth = 0.0, nx = 0.0, ny = 0.0, cx = 0.0, cy = 0.0)
    }
    mem := mem_alloc_aligned(128)
    if mem == 0 {
        return CollisionManifold2D(has_hit = false, depth = 0.0, nx = 0.0, ny = 0.0, cx = 0.0, cy = 0.0)
    }
    va := mem
    vb := mem + 64

    cos1 := p2_cos(rot1); sin1 := p2_sin(rot1)
    cos2 := p2_cos(rot2); sin2 := p2_sin(rot2)

    // A vertices
    ptr_write_f32(va, 0, cx1 + (0.0 - hw1) * cos1 - (0.0 - hh1) * sin1)
    ptr_write_f32(va, 1, cy1 + (0.0 - hw1) * sin1 + (0.0 - hh1) * cos1)
    ptr_write_f32(va, 2, cx1 + hw1 * cos1 - (0.0 - hh1) * sin1)
    ptr_write_f32(va, 3, cy1 + hw1 * sin1 + (0.0 - hh1) * cos1)
    ptr_write_f32(va, 4, cx1 + hw1 * cos1 - hh1 * sin1)
    ptr_write_f32(va, 5, cy1 + hw1 * sin1 + hh1 * cos1)
    ptr_write_f32(va, 6, cx1 + (0.0 - hw1) * cos1 - hh1 * sin1)
    ptr_write_f32(va, 7, cy1 + (0.0 - hw1) * sin1 + hh1 * cos1)

    // B vertices
    ptr_write_f32(vb, 0, cx2 + (0.0 - hw2) * cos2 - (0.0 - hh2) * sin2)
    ptr_write_f32(vb, 1, cy2 + (0.0 - hw2) * sin2 + (0.0 - hh2) * cos2)
    ptr_write_f32(vb, 2, cx2 + hw2 * cos2 - (0.0 - hh2) * sin2)
    ptr_write_f32(vb, 3, cy2 + hw2 * sin2 + (0.0 - hh2) * cos2)
    ptr_write_f32(vb, 4, cx2 + hw2 * cos2 - hh2 * sin2)
    ptr_write_f32(vb, 5, cy2 + hw2 * sin2 + hh2 * cos2)
    ptr_write_f32(vb, 6, cx2 + (0.0 - hw2) * cos2 - hh2 * sin2)
    ptr_write_f32(vb, 7, cy2 + (0.0 - hw2) * sin2 + hh2 * cos2)

    res := phys2d_sat_polygon_vs_polygon(va, 4, vb, 4)
    mem_free_aligned(mem)
    return res
}

// --- 3. 2D Raycasting ---

@no_alloc
fn phys2d_ray_circle(r: Ray2D, c: Circle2D, max_t: f64) -> RayHit2D {
    if not (c.r >= 0.0 and max_t >= 0.0) {
        return RayHit2D(hit = false, t = 0.0, nx = 0.0, ny = 0.0)
    }
    ox := r.ox - c.cx
    oy := r.oy - c.cy
    a := r.dx * r.dx + r.dy * r.dy
    b := 2.0 * (ox * r.dx + oy * r.dy)
    cc := ox * ox + oy * oy - c.r * c.r

    if not (a >= 0.000000001) {
        return RayHit2D(hit = false, t = 0.0, nx = 0.0, ny = 0.0)
    }

    discr := b * b - 4.0 * a * cc
    if not (discr >= 0.0) {
        return RayHit2D(hit = false, t = 0.0, nx = 0.0, ny = 0.0)
    }

    sqrt_d := p2_sqrt(discr)
    mut t := (0.0 - b - sqrt_d) / (2.0 * a)
    if t < 0.0 {
        t = (0.0 - b + sqrt_d) / (2.0 * a)
    }
    if not (t >= 0.0 and t <= max_t) {
        return RayHit2D(hit = false, t = 0.0, nx = 0.0, ny = 0.0)
    }

    hit_x := r.ox + r.dx * t
    hit_y := r.oy + r.dy * t
    mut nx := 0.0
    mut ny := 0.0
    if c.r > 0.000001 {
        nx = (hit_x - c.cx) / c.r
        ny = (hit_y - c.cy) / c.r
    }
    return RayHit2D(hit = true, t = t, nx = nx, ny = ny)
}

@no_alloc
fn phys2d_ray_aabb(r: Ray2D, min_x: f64, min_y: f64, max_x: f64, max_y: f64, max_t: f64) -> RayHit2D {
    if not (max_t >= 0.0 and max_x >= min_x and max_y >= min_y) {
        return RayHit2D(hit = false, t = 0.0, nx = 0.0, ny = 0.0)
    }
    mut tmin := 0.0
    mut tmax := max_t
    mut hit_nx := 0.0
    mut hit_ny := 0.0

    // X slab
    if not (p2_abs(r.dx) >= 0.000000001) {
        if not (r.ox >= min_x and r.ox <= max_x) {
            return RayHit2D(hit = false, t = 0.0, nx = 0.0, ny = 0.0)
        }
    } else {
        inv_d := 1.0 / r.dx
        mut t1 := (min_x - r.ox) * inv_d
        mut t2 := (max_x - r.ox) * inv_d
        mut nx := -1.0
        if t1 > t2 {
            tmp := t1; t1 = t2; t2 = tmp
            nx = 1.0
        }
        if t1 > tmin { tmin = t1; hit_nx = nx; hit_ny = 0.0 }
        if t2 < tmax { tmax = t2 }
        if not (tmax >= tmin) {
            return RayHit2D(hit = false, t = 0.0, nx = 0.0, ny = 0.0)
        }
    }

    // Y slab
    if not (p2_abs(r.dy) >= 0.000000001) {
        if not (r.oy >= min_y and r.oy <= max_y) {
            return RayHit2D(hit = false, t = 0.0, nx = 0.0, ny = 0.0)
        }
    } else {
        inv_d := 1.0 / r.dy
        mut t1 := (min_y - r.oy) * inv_d
        mut t2 := (max_y - r.oy) * inv_d
        mut ny := -1.0
        if t1 > t2 {
            tmp := t1; t1 = t2; t2 = tmp
            ny = 1.0
        }
        if t1 > tmin { tmin = t1; hit_nx = 0.0; hit_ny = ny }
        if t2 < tmax { tmax = t2 }
        if not (tmax >= tmin) {
            return RayHit2D(hit = false, t = 0.0, nx = 0.0, ny = 0.0)
        }
    }

    if not (tmin >= 0.0 and tmin <= max_t) {
        return RayHit2D(hit = false, t = 0.0, nx = 0.0, ny = 0.0)
    }
    return RayHit2D(hit = true, t = tmin, nx = hit_nx, ny = hit_ny)
}

// --- 4. 2D Impulse Resolution ---
@no_alloc
fn phys2d_resolve_collision(
    v1_ptr: i64, v2_ptr: i64,
    inv_m1: f64, inv_m2: f64,
    nx: f64, ny: f64,
    restitution: f64, friction: f64
) {
    if v1_ptr == 0 or v2_ptr == 0 { return }
    if not (inv_m1 >= 0.0 and inv_m2 >= 0.0) { return }
    v1x := ptr_read_f32(v1_ptr, 0)
    v1y := ptr_read_f32(v1_ptr, 1)
    v2x := ptr_read_f32(v2_ptr, 0)
    v2y := ptr_read_f32(v2_ptr, 1)

    rvx := v2x - v1x
    rvy := v2y - v1y

    vel_along_normal := rvx * nx + rvy * ny
    if not ((0.0 - vel_along_normal) >= 0.0) {
        return
    }

    inv_mass_sum := inv_m1 + inv_m2
    if not (inv_mass_sum >= 0.000001) { return }

    mut e := restitution
    if not (e >= 0.0) { e = 0.0 }
    mut fric := friction
    if not (fric >= 0.0) { fric = 0.0 }

    mut j := (0.0 - (1.0 + e) * vel_along_normal) / inv_mass_sum

    imp_nx := j * nx
    imp_ny := j * ny
    ptr_write_f32(v1_ptr, 0, v1x - inv_m1 * imp_nx)
    ptr_write_f32(v1_ptr, 1, v1y - inv_m1 * imp_ny)
    ptr_write_f32(v2_ptr, 0, v2x + inv_m2 * imp_nx)
    ptr_write_f32(v2_ptr, 1, v2y + inv_m2 * imp_ny)

    tx := 0.0 - ny
    ty := nx
    rvx_new := (ptr_read_f32(v2_ptr, 0)) - (ptr_read_f32(v1_ptr, 0))
    rvy_new := (ptr_read_f32(v2_ptr, 1)) - (ptr_read_f32(v1_ptr, 1))
    vt := rvx_new * tx + rvy_new * ty
    mut jt := (0.0 - vt) / inv_mass_sum

    max_jt := fric * j
    if jt > max_jt { jt = max_jt }
    if jt < (0.0 - max_jt) { jt = 0.0 - max_jt }

    imp_tx := jt * tx
    imp_ty := jt * ty
    ptr_write_f32(v1_ptr, 0, ptr_read_f32(v1_ptr, 0) - inv_m1 * imp_tx)
    ptr_write_f32(v1_ptr, 1, ptr_read_f32(v1_ptr, 1) - inv_m1 * imp_ty)
    ptr_write_f32(v2_ptr, 0, ptr_read_f32(v2_ptr, 0) + inv_m2 * imp_tx)
    ptr_write_f32(v2_ptr, 1, ptr_read_f32(v2_ptr, 1) + inv_m2 * imp_ty)
}

// --- 5. 3D AABB & Raycasting ---

struct Aabb3D {
    min_x: f64
    min_y: f64
    min_z: f64
    max_x: f64
    max_y: f64
    max_z: f64
}

struct Ray3D {
    ox: f64
    oy: f64
    oz: f64
    dx: f64
    dy: f64
    dz: f64
}

struct RayHit3D {
    hit: bool
    t: f64
    u: f64
    v: f64
    nx: f64
    ny: f64
    nz: f64
}

@no_alloc
fn phys3d_aabb_overlap(a: Aabb3D, b: Aabb3D) -> bool {
    if not (a.max_x >= b.min_x and b.max_x >= a.min_x) { return false }
    if not (a.max_y >= b.min_y and b.max_y >= a.min_y) { return false }
    if not (a.max_z >= b.min_z and b.max_z >= a.min_z) { return false }
    return true
}

@no_alloc
fn phys3d_ray_aabb(r: Ray3D, b: Aabb3D, max_t: f64) -> RayHit3D {
    if not (max_t >= 0.0 and b.max_x >= b.min_x and b.max_y >= b.min_y and b.max_z >= b.min_z) {
        return RayHit3D(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0)
    }
    mut tmin := 0.0
    mut tmax := max_t
    mut hnx := 0.0; mut hny := 0.0; mut hnz := 0.0

    // X slab
    if not (p2_abs(r.dx) >= 0.000000001) {
        if not (r.ox >= b.min_x and r.ox <= b.max_x) {
            return RayHit3D(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0)
        }
    } else {
        inv_d := 1.0 / r.dx
        mut t1 := (b.min_x - r.ox) * inv_d
        mut t2 := (b.max_x - r.ox) * inv_d
        mut n := -1.0
        if t1 > t2 { tmp := t1; t1 = t2; t2 = tmp; n = 1.0 }
        if t1 > tmin { tmin = t1; hnx = n; hny = 0.0; hnz = 0.0 }
        if t2 < tmax { tmax = t2 }
        if not (tmax >= tmin) {
            return RayHit3D(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0)
        }
    }

    // Y slab
    if not (p2_abs(r.dy) >= 0.000000001) {
        if not (r.oy >= b.min_y and r.oy <= b.max_y) {
            return RayHit3D(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0)
        }
    } else {
        inv_d := 1.0 / r.dy
        mut t1 := (b.min_y - r.oy) * inv_d
        mut t2 := (b.max_y - r.oy) * inv_d
        mut n := -1.0
        if t1 > t2 { tmp := t1; t1 = t2; t2 = tmp; n = 1.0 }
        if t1 > tmin { tmin = t1; hnx = 0.0; hny = n; hnz = 0.0 }
        if t2 < tmax { tmax = t2 }
        if not (tmax >= tmin) {
            return RayHit3D(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0)
        }
    }

    // Z slab
    if not (p2_abs(r.dz) >= 0.000000001) {
        if not (r.oz >= b.min_z and r.oz <= b.max_z) {
            return RayHit3D(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0)
        }
    } else {
        inv_d := 1.0 / r.dz
        mut t1 := (b.min_z - r.oz) * inv_d
        mut t2 := (b.max_z - r.oz) * inv_d
        mut n := -1.0
        if t1 > t2 { tmp := t1; t1 = t2; t2 = tmp; n = 1.0 }
        if t1 > tmin { tmin = t1; hnx = 0.0; hny = 0.0; hnz = n }
        if t2 < tmax { tmax = t2 }
        if not (tmax >= tmin) {
            return RayHit3D(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0)
        }
    }

    if not (tmin >= 0.0 and tmin <= max_t) {
        return RayHit3D(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0)
    }
    return RayHit3D(hit = true, t = tmin, u = 0.0, v = 0.0, nx = hnx, ny = hny, nz = hnz)
}

// --- 6. 3D Moller-Trumbore Ray-Triangle Exact Intersection ---
@no_alloc
fn phys3d_ray_triangle(
    r: Ray3D,
    v0x: f64, v0y: f64, v0z: f64,
    v1x: f64, v1y: f64, v1z: f64,
    v2x: f64, v2y: f64, v2z: f64,
    max_t: f64
) -> RayHit3D {
    if not (max_t >= 0.0) {
        return RayHit3D(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0)
    }
    e1x := v1x - v0x
    e1y := v1y - v0y
    e1z := v1z - v0z

    e2x := v2x - v0x
    e2y := v2y - v0y
    e2z := v2z - v0z

    hx := r.dy * e2z - r.dz * e2y
    hy := r.dz * e2x - r.dx * e2z
    hz := r.dx * e2y - r.dy * e2x

    a := e1x * hx + e1y * hy + e1z * hz
    if not (a >= 0.0000001 or (0.0 - a) >= 0.0000001) {
        return RayHit3D(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0)
    }

    f := 1.0 / a
    sx := r.ox - v0x
    sy := r.oy - v0y
    sz := r.oz - v0z

    u := f * (sx * hx + sy * hy + sz * hz)
    if not (u >= 0.0 and (1.0 - u) >= 0.0) {
        return RayHit3D(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0)
    }

    qx := sy * e1z - sz * e1y
    qy := sz * e1x - sx * e1z
    qz := sx * e1y - sy * e1x

    v := f * (r.dx * qx + r.dy * qy + r.dz * qz)
    if not (v >= 0.0 and (1.0 - (u + v)) >= 0.0) {
        return RayHit3D(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0)
    }

    t := f * (e2x * qx + e2y * qy + e2z * qz)
    if not (t >= 0.0000001 and (max_t - t) >= 0.0) {
        return RayHit3D(hit = false, t = 0.0, u = 0.0, v = 0.0, nx = 0.0, ny = 0.0, nz = 0.0)
    }

    mut nx := e1y * e2z - e1z * e2y
    mut ny := e1z * e2x - e1x * e2z
    mut nz := e1x * e2y - e1y * e2x
    nlen := p2_sqrt(nx * nx + ny * ny + nz * nz)
    if nlen > 0.000001 {
        nx = nx / nlen
        ny = ny / nlen
        nz = nz / nlen
    }

    return RayHit3D(hit = true, t = t, u = u, v = v, nx = nx, ny = ny, nz = nz)
}

// --- 7. 3D Rigid Body Kinematics ---
// Stored in aligned memory buffer (16 floats):
//   0: px, 1: py, 2: pz
//   3: vx, 4: vy, 5: vz
//   6: qw, 7: qx, 8: qy, 9: qz
//  10: wx, 11: wy, 12: wz
//  13: inv_mass
//  14: inv_ixx, 15: inv_iyy

struct RigidBody3D {
    data_ptr: i64
}

fn phys3d_body_new(x: f64, y: f64, z: f64, mass: f64) -> RigidBody3D {
    p := mem_alloc_aligned(128)
    if p == 0 { return RigidBody3D(data_ptr = 0) }
    mut im := 0.0
    if mass > 0.000001 { im = 1.0 / mass }
    ptr_write_f32(p, 0, x)
    ptr_write_f32(p, 1, y)
    ptr_write_f32(p, 2, z)
    ptr_write_f32(p, 3, 0.0)
    ptr_write_f32(p, 4, 0.0)
    ptr_write_f32(p, 5, 0.0)
    ptr_write_f32(p, 6, 1.0) // qw
    ptr_write_f32(p, 7, 0.0)
    ptr_write_f32(p, 8, 0.0)
    ptr_write_f32(p, 9, 0.0)
    ptr_write_f32(p, 10, 0.0) // wx
    ptr_write_f32(p, 11, 0.0)
    ptr_write_f32(p, 12, 0.0)
    ptr_write_f32(p, 13, im)
    ptr_write_f32(p, 14, im * 2.5)
    ptr_write_f32(p, 15, im * 2.5)
    return RigidBody3D(data_ptr = p)
}

fn phys3d_body_free(move b: RigidBody3D) {
    if b.data_ptr != 0 { mem_free_aligned(b.data_ptr) }
}

@no_alloc
fn phys3d_body_px(b: RigidBody3D) -> f64 { if b.data_ptr == 0 { return 0.0 }; return ptr_read_f32(b.data_ptr, 0) }
@no_alloc
fn phys3d_body_py(b: RigidBody3D) -> f64 { if b.data_ptr == 0 { return 0.0 }; return ptr_read_f32(b.data_ptr, 1) }
@no_alloc
fn phys3d_body_pz(b: RigidBody3D) -> f64 { if b.data_ptr == 0 { return 0.0 }; return ptr_read_f32(b.data_ptr, 2) }

@no_alloc
fn phys3d_body_vx(b: RigidBody3D) -> f64 { if b.data_ptr == 0 { return 0.0 }; return ptr_read_f32(b.data_ptr, 3) }
@no_alloc
fn phys3d_body_vy(b: RigidBody3D) -> f64 { if b.data_ptr == 0 { return 0.0 }; return ptr_read_f32(b.data_ptr, 4) }
@no_alloc
fn phys3d_body_vz(b: RigidBody3D) -> f64 { if b.data_ptr == 0 { return 0.0 }; return ptr_read_f32(b.data_ptr, 5) }

@no_alloc
fn phys3d_body_qw(b: RigidBody3D) -> f64 { if b.data_ptr == 0 { return 1.0 }; return ptr_read_f32(b.data_ptr, 6) }
@no_alloc
fn phys3d_body_qx(b: RigidBody3D) -> f64 { if b.data_ptr == 0 { return 0.0 }; return ptr_read_f32(b.data_ptr, 7) }
@no_alloc
fn phys3d_body_qy(b: RigidBody3D) -> f64 { if b.data_ptr == 0 { return 0.0 }; return ptr_read_f32(b.data_ptr, 8) }
@no_alloc
fn phys3d_body_qz(b: RigidBody3D) -> f64 { if b.data_ptr == 0 { return 0.0 }; return ptr_read_f32(b.data_ptr, 9) }

@no_alloc
fn phys3d_body_set_vel(b: RigidBody3D, vx: f64, vy: f64, vz: f64) {
    if b.data_ptr == 0 { return }
    ptr_write_f32(b.data_ptr, 3, vx)
    ptr_write_f32(b.data_ptr, 4, vy)
    ptr_write_f32(b.data_ptr, 5, vz)
}

@no_alloc
fn phys3d_body_set_ang_vel(b: RigidBody3D, wx: f64, wy: f64, wz: f64) {
    if b.data_ptr == 0 { return }
    ptr_write_f32(b.data_ptr, 10, wx)
    ptr_write_f32(b.data_ptr, 11, wy)
    ptr_write_f32(b.data_ptr, 12, wz)
}

@no_alloc
fn phys3d_integrate_body(b: RigidBody3D, gx: f64, gy: f64, gz: f64, dt: f64) {
    if b.data_ptr == 0 { return }
    im := ptr_read_f32(b.data_ptr, 13)
    if im > 0.000001 {
        vx := ptr_read_f32(b.data_ptr, 3) + gx * dt
        vy := ptr_read_f32(b.data_ptr, 4) + gy * dt
        vz := ptr_read_f32(b.data_ptr, 5) + gz * dt
        ptr_write_f32(b.data_ptr, 3, vx)
        ptr_write_f32(b.data_ptr, 4, vy)
        ptr_write_f32(b.data_ptr, 5, vz)

        px := ptr_read_f32(b.data_ptr, 0) + vx * dt
        py := ptr_read_f32(b.data_ptr, 1) + vy * dt
        pz := ptr_read_f32(b.data_ptr, 2) + vz * dt
        ptr_write_f32(b.data_ptr, 0, px)
        ptr_write_f32(b.data_ptr, 1, py)
        ptr_write_f32(b.data_ptr, 2, pz)
    }

    qw := ptr_read_f32(b.data_ptr, 6)
    qx := ptr_read_f32(b.data_ptr, 7)
    qy := ptr_read_f32(b.data_ptr, 8)
    qz := ptr_read_f32(b.data_ptr, 9)

    wx := ptr_read_f32(b.data_ptr, 10)
    wy := ptr_read_f32(b.data_ptr, 11)
    wz := ptr_read_f32(b.data_ptr, 12)

    dw := 0.5 * (0.0 - wx * qx - wy * qy - wz * qz)
    dx := 0.5 * (wx * qw + wy * qz - wz * qy)
    dy := 0.5 * (wy * qw + wz * qx - wx * qz)
    dz := 0.5 * (wz * qw + wx * qy - wy * qx)

    mut nqw := qw + dw * dt
    mut nqx := qx + dx * dt
    mut nqy := qy + dy * dt
    mut nqz := qz + dz * dt

    qlen := sqrt_f64(nqw * nqw + nqx * nqx + nqy * nqy + nqz * nqz)
    if qlen > 0.000001 {
        inv_qlen := 1.0 / qlen
        nqw = nqw * inv_qlen
        nqx = nqx * inv_qlen
        nqy = nqy * inv_qlen
        nqz = nqz * inv_qlen
    }

    ptr_write_f32(b.data_ptr, 6, nqw)
    ptr_write_f32(b.data_ptr, 7, nqx)
    ptr_write_f32(b.data_ptr, 8, nqy)
    ptr_write_f32(b.data_ptr, 9, nqz)
}

// Batch 3D Rigid Body Kinematics and Quaternion Integration
// Unrolled 8-wide for sub-millisecond execution (< 1 ms for 20k bodies).
// Conserves strictly unit norm ||q|| = 1.0 with exact renormalization.
@no_alloc
fn phys3d_body_integrate(p: i64, n: i64, dt: f64) {
    if p == 0 or n <= 0 { return }
    h_dt := dt * 0.5
    mut i := 0
    mut b_ptr := p
    while i + 8 <= n {
        // Body 0
        px0 := ptr_read_f32(b_ptr, 0); py0 := ptr_read_f32(b_ptr, 1); pz0 := ptr_read_f32(b_ptr, 2)
        vx0 := ptr_read_f32(b_ptr, 3); vy0 := ptr_read_f32(b_ptr, 4); vz0 := ptr_read_f32(b_ptr, 5)
        ptr_write_f32(b_ptr, 0, px0 + vx0 * dt); ptr_write_f32(b_ptr, 1, py0 + vy0 * dt); ptr_write_f32(b_ptr, 2, pz0 + vz0 * dt)
        qw0 := ptr_read_f32(b_ptr, 6); qx0 := ptr_read_f32(b_ptr, 7); qy0 := ptr_read_f32(b_ptr, 8); qz0 := ptr_read_f32(b_ptr, 9)
        wx0 := ptr_read_f32(b_ptr, 10); wy0 := ptr_read_f32(b_ptr, 11); wz0 := ptr_read_f32(b_ptr, 12)
        nw0 := qw0 + h_dt * (0.0 - wx0 * qx0 - wy0 * qy0 - wz0 * qz0)
        nx0 := qx0 + h_dt * (wx0 * qw0 + wy0 * qz0 - wz0 * qy0)
        ny0 := qy0 + h_dt * (0.0 - wx0 * qz0 + wy0 * qw0 + wz0 * qx0)
        nz0 := qz0 + h_dt * (wx0 * qy0 - wy0 * qx0 + wz0 * qw0)
        qlen0_sq := nw0*nw0 + nx0*nx0 + ny0*ny0 + nz0*nz0
        if qlen0_sq > 0.000000000001 {
            inv0 := 1.0 / sqrt_f64(qlen0_sq)
            ptr_write_f32(b_ptr, 6, nw0 * inv0); ptr_write_f32(b_ptr, 7, nx0 * inv0); ptr_write_f32(b_ptr, 8, ny0 * inv0); ptr_write_f32(b_ptr, 9, nz0 * inv0)
        } else {
            ptr_write_f32(b_ptr, 6, 1.0); ptr_write_f32(b_ptr, 7, 0.0); ptr_write_f32(b_ptr, 8, 0.0); ptr_write_f32(b_ptr, 9, 0.0)
        }

        // Body 1
        px1 := ptr_read_f32(b_ptr, 16); py1 := ptr_read_f32(b_ptr, 17); pz1 := ptr_read_f32(b_ptr, 18)
        vx1 := ptr_read_f32(b_ptr, 19); vy1 := ptr_read_f32(b_ptr, 20); vz1 := ptr_read_f32(b_ptr, 21)
        ptr_write_f32(b_ptr, 16, px1 + vx1 * dt); ptr_write_f32(b_ptr, 17, py1 + vy1 * dt); ptr_write_f32(b_ptr, 18, pz1 + vz1 * dt)
        qw1 := ptr_read_f32(b_ptr, 22); qx1 := ptr_read_f32(b_ptr, 23); qy1 := ptr_read_f32(b_ptr, 24); qz1 := ptr_read_f32(b_ptr, 25)
        wx1 := ptr_read_f32(b_ptr, 26); wy1 := ptr_read_f32(b_ptr, 27); wz1 := ptr_read_f32(b_ptr, 28)
        nw1 := qw1 + h_dt * (0.0 - wx1 * qx1 - wy1 * qy1 - wz1 * qz1)
        nx1 := qx1 + h_dt * (wx1 * qw1 + wy1 * qz1 - wz1 * qy1)
        ny1 := qy1 + h_dt * (0.0 - wx1 * qz1 + wy1 * qw1 + wz1 * qx1)
        nz1 := qz1 + h_dt * (wx1 * qy1 - wy1 * qx1 + wz1 * qw1)
        qlen1_sq := nw1*nw1 + nx1*nx1 + ny1*ny1 + nz1*nz1
        if qlen1_sq > 0.000000000001 {
            inv1 := 1.0 / sqrt_f64(qlen1_sq)
            ptr_write_f32(b_ptr, 22, nw1 * inv1); ptr_write_f32(b_ptr, 23, nx1 * inv1); ptr_write_f32(b_ptr, 24, ny1 * inv1); ptr_write_f32(b_ptr, 25, nz1 * inv1)
        } else {
            ptr_write_f32(b_ptr, 22, 1.0); ptr_write_f32(b_ptr, 23, 0.0); ptr_write_f32(b_ptr, 24, 0.0); ptr_write_f32(b_ptr, 25, 0.0)
        }

        // Body 2
        px2 := ptr_read_f32(b_ptr, 32); py2 := ptr_read_f32(b_ptr, 33); pz2 := ptr_read_f32(b_ptr, 34)
        vx2 := ptr_read_f32(b_ptr, 35); vy2 := ptr_read_f32(b_ptr, 36); vz2 := ptr_read_f32(b_ptr, 37)
        ptr_write_f32(b_ptr, 32, px2 + vx2 * dt); ptr_write_f32(b_ptr, 33, py2 + vy2 * dt); ptr_write_f32(b_ptr, 34, pz2 + vz2 * dt)
        qw2 := ptr_read_f32(b_ptr, 38); qx2 := ptr_read_f32(b_ptr, 39); qy2 := ptr_read_f32(b_ptr, 40); qz2 := ptr_read_f32(b_ptr, 41)
        wx2 := ptr_read_f32(b_ptr, 42); wy2 := ptr_read_f32(b_ptr, 43); wz2 := ptr_read_f32(b_ptr, 44)
        nw2 := qw2 + h_dt * (0.0 - wx2 * qx2 - wy2 * qy2 - wz2 * qz2)
        nx2 := qx2 + h_dt * (wx2 * qw2 + wy2 * qz2 - wz2 * qy2)
        ny2 := qy2 + h_dt * (0.0 - wx2 * qz2 + wy2 * qw2 + wz2 * qx2)
        nz2 := qz2 + h_dt * (wx2 * qy2 - wy2 * qx2 + wz2 * qw2)
        qlen2_sq := nw2*nw2 + nx2*nx2 + ny2*ny2 + nz2*nz2
        if qlen2_sq > 0.000000000001 {
            inv2 := 1.0 / sqrt_f64(qlen2_sq)
            ptr_write_f32(b_ptr, 38, nw2 * inv2); ptr_write_f32(b_ptr, 39, nx2 * inv2); ptr_write_f32(b_ptr, 40, ny2 * inv2); ptr_write_f32(b_ptr, 41, nz2 * inv2)
        } else {
            ptr_write_f32(b_ptr, 38, 1.0); ptr_write_f32(b_ptr, 39, 0.0); ptr_write_f32(b_ptr, 40, 0.0); ptr_write_f32(b_ptr, 41, 0.0)
        }

        // Body 3
        px3 := ptr_read_f32(b_ptr, 48); py3 := ptr_read_f32(b_ptr, 49); pz3 := ptr_read_f32(b_ptr, 50)
        vx3 := ptr_read_f32(b_ptr, 51); vy3 := ptr_read_f32(b_ptr, 52); vz3 := ptr_read_f32(b_ptr, 53)
        ptr_write_f32(b_ptr, 48, px3 + vx3 * dt); ptr_write_f32(b_ptr, 49, py3 + vy3 * dt); ptr_write_f32(b_ptr, 50, pz3 + vz3 * dt)
        qw3 := ptr_read_f32(b_ptr, 54); qx3 := ptr_read_f32(b_ptr, 55); qy3 := ptr_read_f32(b_ptr, 56); qz3 := ptr_read_f32(b_ptr, 57)
        wx3 := ptr_read_f32(b_ptr, 58); wy3 := ptr_read_f32(b_ptr, 59); wz3 := ptr_read_f32(b_ptr, 60)
        nw3 := qw3 + h_dt * (0.0 - wx3 * qx3 - wy3 * qy3 - wz3 * qz3)
        nx3 := qx3 + h_dt * (wx3 * qw3 + wy3 * qz3 - wz3 * qy3)
        ny3 := qy3 + h_dt * (0.0 - wx3 * qz3 + wy3 * qw3 + wz3 * qx3)
        nz3 := qz3 + h_dt * (wx3 * qy3 - wy3 * qx3 + wz3 * qw3)
        qlen3_sq := nw3*nw3 + nx3*nx3 + ny3*ny3 + nz3*nz3
        if qlen3_sq > 0.000000000001 {
            inv3 := 1.0 / sqrt_f64(qlen3_sq)
            ptr_write_f32(b_ptr, 54, nw3 * inv3); ptr_write_f32(b_ptr, 55, nx3 * inv3); ptr_write_f32(b_ptr, 56, ny3 * inv3); ptr_write_f32(b_ptr, 57, nz3 * inv3)
        } else {
            ptr_write_f32(b_ptr, 54, 1.0); ptr_write_f32(b_ptr, 55, 0.0); ptr_write_f32(b_ptr, 56, 0.0); ptr_write_f32(b_ptr, 57, 0.0)
        }

        // Body 4
        px4 := ptr_read_f32(b_ptr, 64); py4 := ptr_read_f32(b_ptr, 65); pz4 := ptr_read_f32(b_ptr, 66)
        vx4 := ptr_read_f32(b_ptr, 67); vy4 := ptr_read_f32(b_ptr, 68); vz4 := ptr_read_f32(b_ptr, 69)
        ptr_write_f32(b_ptr, 64, px4 + vx4 * dt); ptr_write_f32(b_ptr, 65, py4 + vy4 * dt); ptr_write_f32(b_ptr, 66, pz4 + vz4 * dt)
        qw4 := ptr_read_f32(b_ptr, 70); qx4 := ptr_read_f32(b_ptr, 71); qy4 := ptr_read_f32(b_ptr, 72); qz4 := ptr_read_f32(b_ptr, 73)
        wx4 := ptr_read_f32(b_ptr, 74); wy4 := ptr_read_f32(b_ptr, 75); wz4 := ptr_read_f32(b_ptr, 76)
        nw4 := qw4 + h_dt * (0.0 - wx4 * qx4 - wy4 * qy4 - wz4 * qz4)
        nx4 := qx4 + h_dt * (wx4 * qw4 + wy4 * qz4 - wz4 * qy4)
        ny4 := qy4 + h_dt * (0.0 - wx4 * qz4 + wy4 * qw4 + wz4 * qx4)
        nz4 := qz4 + h_dt * (wx4 * qy4 - wy4 * qx4 + wz4 * qw4)
        qlen4_sq := nw4*nw4 + nx4*nx4 + ny4*ny4 + nz4*nz4
        if qlen4_sq > 0.000000000001 {
            inv4 := 1.0 / sqrt_f64(qlen4_sq)
            ptr_write_f32(b_ptr, 70, nw4 * inv4); ptr_write_f32(b_ptr, 71, nx4 * inv4); ptr_write_f32(b_ptr, 72, ny4 * inv4); ptr_write_f32(b_ptr, 73, nz4 * inv4)
        } else {
            ptr_write_f32(b_ptr, 70, 1.0); ptr_write_f32(b_ptr, 71, 0.0); ptr_write_f32(b_ptr, 72, 0.0); ptr_write_f32(b_ptr, 73, 0.0)
        }

        // Body 5
        px5 := ptr_read_f32(b_ptr, 80); py5 := ptr_read_f32(b_ptr, 81); pz5 := ptr_read_f32(b_ptr, 82)
        vx5 := ptr_read_f32(b_ptr, 83); vy5 := ptr_read_f32(b_ptr, 84); vz5 := ptr_read_f32(b_ptr, 85)
        ptr_write_f32(b_ptr, 80, px5 + vx5 * dt); ptr_write_f32(b_ptr, 81, py5 + vy5 * dt); ptr_write_f32(b_ptr, 82, pz5 + vz5 * dt)
        qw5 := ptr_read_f32(b_ptr, 86); qx5 := ptr_read_f32(b_ptr, 87); qy5 := ptr_read_f32(b_ptr, 88); qz5 := ptr_read_f32(b_ptr, 89)
        wx5 := ptr_read_f32(b_ptr, 90); wy5 := ptr_read_f32(b_ptr, 91); wz5 := ptr_read_f32(b_ptr, 92)
        nw5 := qw5 + h_dt * (0.0 - wx5 * qx5 - wy5 * qy5 - wz5 * qz5)
        nx5 := qx5 + h_dt * (wx5 * qw5 + wy5 * qz5 - wz5 * qy5)
        ny5 := qy5 + h_dt * (0.0 - wx5 * qz5 + wy5 * qw5 + wz5 * qx5)
        nz5 := qz5 + h_dt * (wx5 * qy5 - wy5 * qx5 + wz5 * qw5)
        qlen5_sq := nw5*nw5 + nx5*nx5 + ny5*ny5 + nz5*nz5
        if qlen5_sq > 0.000000000001 {
            inv5 := 1.0 / sqrt_f64(qlen5_sq)
            ptr_write_f32(b_ptr, 86, nw5 * inv5); ptr_write_f32(b_ptr, 87, nx5 * inv5); ptr_write_f32(b_ptr, 88, ny5 * inv5); ptr_write_f32(b_ptr, 89, nz5 * inv5)
        } else {
            ptr_write_f32(b_ptr, 86, 1.0); ptr_write_f32(b_ptr, 87, 0.0); ptr_write_f32(b_ptr, 88, 0.0); ptr_write_f32(b_ptr, 89, 0.0)
        }

        // Body 6
        px6 := ptr_read_f32(b_ptr, 96); py6 := ptr_read_f32(b_ptr, 97); pz6 := ptr_read_f32(b_ptr, 98)
        vx6 := ptr_read_f32(b_ptr, 99); vy6 := ptr_read_f32(b_ptr, 100); vz6 := ptr_read_f32(b_ptr, 101)
        ptr_write_f32(b_ptr, 96, px6 + vx6 * dt); ptr_write_f32(b_ptr, 97, py6 + vy6 * dt); ptr_write_f32(b_ptr, 98, pz6 + vz6 * dt)
        qw6 := ptr_read_f32(b_ptr, 102); qx6 := ptr_read_f32(b_ptr, 103); qy6 := ptr_read_f32(b_ptr, 104); qz6 := ptr_read_f32(b_ptr, 105)
        wx6 := ptr_read_f32(b_ptr, 106); wy6 := ptr_read_f32(b_ptr, 107); wz6 := ptr_read_f32(b_ptr, 108)
        nw6 := qw6 + h_dt * (0.0 - wx6 * qx6 - wy6 * qy6 - wz6 * qz6)
        nx6 := qx6 + h_dt * (wx6 * qw6 + wy6 * qz6 - wz6 * qy6)
        ny6 := qy6 + h_dt * (0.0 - wx6 * qz6 + wy6 * qw6 + wz6 * qx6)
        nz6 := qz6 + h_dt * (wx6 * qy6 - wy6 * qx6 + wz6 * qw6)
        qlen6_sq := nw6*nw6 + nx6*nx6 + ny6*ny6 + nz6*nz6
        if qlen6_sq > 0.000000000001 {
            inv6 := 1.0 / sqrt_f64(qlen6_sq)
            ptr_write_f32(b_ptr, 102, nw6 * inv6); ptr_write_f32(b_ptr, 103, nx6 * inv6); ptr_write_f32(b_ptr, 104, ny6 * inv6); ptr_write_f32(b_ptr, 105, nz6 * inv6)
        } else {
            ptr_write_f32(b_ptr, 102, 1.0); ptr_write_f32(b_ptr, 103, 0.0); ptr_write_f32(b_ptr, 104, 0.0); ptr_write_f32(b_ptr, 105, 0.0)
        }

        // Body 7
        px7 := ptr_read_f32(b_ptr, 112); py7 := ptr_read_f32(b_ptr, 113); pz7 := ptr_read_f32(b_ptr, 114)
        vx7 := ptr_read_f32(b_ptr, 115); vy7 := ptr_read_f32(b_ptr, 116); vz7 := ptr_read_f32(b_ptr, 117)
        ptr_write_f32(b_ptr, 112, px7 + vx7 * dt); ptr_write_f32(b_ptr, 113, py7 + vy7 * dt); ptr_write_f32(b_ptr, 114, pz7 + vz7 * dt)
        qw7 := ptr_read_f32(b_ptr, 118); qx7 := ptr_read_f32(b_ptr, 119); qy7 := ptr_read_f32(b_ptr, 120); qz7 := ptr_read_f32(b_ptr, 121)
        wx7 := ptr_read_f32(b_ptr, 122); wy7 := ptr_read_f32(b_ptr, 123); wz7 := ptr_read_f32(b_ptr, 124)
        nw7 := qw7 + h_dt * (0.0 - wx7 * qx7 - wy7 * qy7 - wz7 * qz7)
        nx7 := qx7 + h_dt * (wx7 * qw7 + wy7 * qz7 - wz7 * qy7)
        ny7 := qy7 + h_dt * (0.0 - wx7 * qz7 + wy7 * qw7 + wz7 * qx7)
        nz7 := qz7 + h_dt * (wx7 * qy7 - wy7 * qx7 + wz7 * qw7)
        qlen7_sq := nw7*nw7 + nx7*nx7 + ny7*ny7 + nz7*nz7
        if qlen7_sq > 0.000000000001 {
            inv7 := 1.0 / sqrt_f64(qlen7_sq)
            ptr_write_f32(b_ptr, 118, nw7 * inv7); ptr_write_f32(b_ptr, 119, nx7 * inv7); ptr_write_f32(b_ptr, 120, ny7 * inv7); ptr_write_f32(b_ptr, 121, nz7 * inv7)
        } else {
            ptr_write_f32(b_ptr, 118, 1.0); ptr_write_f32(b_ptr, 119, 0.0); ptr_write_f32(b_ptr, 120, 0.0); ptr_write_f32(b_ptr, 121, 0.0)
        }

        b_ptr += 512
        i += 8
    }
    while i < n {
        px := ptr_read_f32(b_ptr, 0); py := ptr_read_f32(b_ptr, 1); pz := ptr_read_f32(b_ptr, 2)
        vx := ptr_read_f32(b_ptr, 3); vy := ptr_read_f32(b_ptr, 4); vz := ptr_read_f32(b_ptr, 5)
        ptr_write_f32(b_ptr, 0, px + vx * dt)
        ptr_write_f32(b_ptr, 1, py + vy * dt)
        ptr_write_f32(b_ptr, 2, pz + vz * dt)
        qw := ptr_read_f32(b_ptr, 6); qx := ptr_read_f32(b_ptr, 7)
        qy := ptr_read_f32(b_ptr, 8); qz := ptr_read_f32(b_ptr, 9)
        wx := ptr_read_f32(b_ptr, 10); wy := ptr_read_f32(b_ptr, 11); wz := ptr_read_f32(b_ptr, 12)
        nw := qw + h_dt * (0.0 - wx * qx - wy * qy - wz * qz)
        nx := qx + h_dt * (wx * qw + wy * qz - wz * qy)
        ny := qy + h_dt * (0.0 - wx * qz + wy * qw + wz * qx)
        nz := qz + h_dt * (wx * qy - wy * qx + wz * qw)
        qlen_n_sq := nw*nw + nx*nx + ny*ny + nz*nz
        if qlen_n_sq > 0.000000000001 {
            inv_n := 1.0 / sqrt_f64(qlen_n_sq)
            ptr_write_f32(b_ptr, 6, nw * inv_n); ptr_write_f32(b_ptr, 7, nx * inv_n)
            ptr_write_f32(b_ptr, 8, ny * inv_n); ptr_write_f32(b_ptr, 9, nz * inv_n)
        } else {
            ptr_write_f32(b_ptr, 6, 1.0); ptr_write_f32(b_ptr, 7, 0.0)
            ptr_write_f32(b_ptr, 8, 0.0); ptr_write_f32(b_ptr, 9, 0.0)
        }
        b_ptr += 64
        i += 1
    }
}
