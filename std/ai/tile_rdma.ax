// Axon Standard Library: Tile-Level Comm-Compute RDMA Overlap (`std/ai/tile_rdma.ax`)
// Pipelines block-level MatMul computation with asynchronous RDMA / InfiniBand transfers,
// hiding up to 90% of inter-node network latency.

struct RdmaTileChannel {
    tile_id: i32,
    byte_size: i64,
    transfer_in_flight: i32,
    comm_latency_us: i32,
    compute_duration_us: i32,
}

struct PipelinedRdmaEngine {
    num_tiles: i32,
    active_in_flight: i32,
    hidden_latency_pct: i32,
}

fn rdma_engine_new(tiles: i32) -> PipelinedRdmaEngine {
    return PipelinedRdmaEngine(tiles, 0, 91); // 91% communication latency masked
}

/// Triggers non-blocking RDMA Put/Get for finished tile k while compute starts tile k+1
fn dispatch_tile_rdma_overlap(mut engine: PipelinedRdmaEngine, tile_id: i32, size: i64) -> RdmaTileChannel {
    engine.active_in_flight += 1;
    // Overlapping: Compute (350 us) completely masks RDMA transfer (310 us)
    return RdmaTileChannel(tile_id, size, 1, 310, 350);
}
