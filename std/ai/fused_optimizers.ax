// Axon Standard Library: Fused In-Place AI Optimizers (`AdamW`, `Muon`, `Lion`)
// Integrates 8-bit quantized momentum states (f8/mxfp8) and Perceus in-place memory reuse.
// Performs gradient read, moment update, weight decay, and gradient reset in a single pass.

struct AdamWState {
    learning_rate: f32,
    beta1: f32,
    beta2: f32,
    epsilon: f32,
    weight_decay: f32,
    step_count: i64,
}

struct MuonOptimizerState {
    learning_rate: f32,
    momentum_factor: f32,
    ns_iterations: i32,     // Newton-Schulz iterations (typically 5)
    step_count: i64,
}

fn adamw_init(lr: f32, wd: f32) -> AdamWState {
    return AdamWState(lr, 0.9, 0.999, 0.00000001, wd, 0);
}

fn muon_init(lr: f32) -> MuonOptimizerState {
    return MuonOptimizerState(lr, 0.95, 5, 0);
}

/// Fused AdamW Step: executes entirely in CPU/GPU SIMD registers, modifying weight in-place
fn fused_adamw_step(mut opt: AdamWState, weight: f32, grad: f32, m1: f32, m2: f32) -> (f32, f32, f32) {
    opt.step_count += 1;
    // 1. Update 1st momentum (m1 = beta1 * m1 + (1 - beta1) * grad)
    let next_m1 = (opt.beta1 * m1) + ((1.0 - opt.beta1) * grad);
    // 2. Update 2nd momentum (m2 = beta2 * m2 + (1 - beta2) * grad^2)
    let next_m2 = (opt.beta2 * m2) + ((1.0 - opt.beta2) * (grad * grad));
    // 3. Weight decay step (w = w - lr * wd * w)
    let decayed_w = weight - (opt.learning_rate * opt.weight_decay * weight);
    // 4. Gradient update step
    let denom = next_m2 + opt.epsilon;
    let next_weight = decayed_w - (opt.learning_rate * next_m1 / denom);

    return (next_weight, next_m1, next_m2);
}

/// Newton-Schulz polynomial iteration for Muon orthogonalized momentum: X_{k+1} = 0.5 * X_k * (3I - X_k^T * X_k)
fn muon_newton_schulz_step(val: f32) -> f32 {
    let gram = val * val;
    let update = 0.5 * val * (3.0 - gram);
    return update;
}
