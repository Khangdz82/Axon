// Axon ONNX Runtime Implementation (`std/onnx.ax`)
// 100% Pure Axon: Zero C++, Zero Python, Zero onnxruntime.dll.
// Implements:
//   - Computational Graph Representation (Nodes, Edges, Initializers)
//   - Core ONNX Operator Set: Gemm (with optional bias), MatMul, Add, Relu, Softmax, LayerNorm, Clip
//   - High-Performance `OnnxSession` API with owned intermediate cleanup

use std::numpy
use std::ai_math
use std::collections
use std::os

// ONNX Op Types
fn onnx_op_gemm() -> i64      { return 1 }
fn onnx_op_matmul() -> i64    { return 2 }
fn onnx_op_add() -> i64       { return 3 }
fn onnx_op_relu() -> i64      { return 4 }
fn onnx_op_softmax() -> i64   { return 5 }
fn onnx_op_layernorm() -> i64 { return 6 }
fn onnx_op_clip() -> i64      { return 7 }

struct OnnxNode {
    op_type: i64
    in_a_slot: i64
    in_b_slot: i64
    out_slot: i64
}

struct OnnxSession {
    nodes_buf: IntBuf     // 4 i64s per node: [op_type, in_a, in_b, out]
    node_count: i64
    tensors_ptr: i64      // 5 i64s per slot: [data_ptr, rows, cols, size, owned_flag]
    max_slots: i64
}

fn onnx_session_new(max_tensors: i64 = 64) -> OnnxSession {
    unsafe {
    mut cap := max_tensors
    if cap < 16 { cap = 16 }
    pool := mem_alloc_aligned(cap * 40 + 64)
    mut i := 0
    while i < cap {
        ptr_write_i64(pool, i * 5, 0)
        ptr_write_i64(pool, i * 5 + 1, 0)
        ptr_write_i64(pool, i * 5 + 2, 0)
        ptr_write_i64(pool, i * 5 + 3, 0)
        ptr_write_i64(pool, i * 5 + 4, 0)
        i += 1
    }

    return OnnxSession(
        nodes_buf = ibuf_new(128),
        node_count = 0,
        tensors_ptr = pool,
        max_slots = cap
    )
    }
}

@no_alloc
fn onnx_free_slot_if_owned(sess: OnnxSession, slot: i64) {
    unsafe {
    if slot < 0 or slot >= sess.max_slots { return }
    owned := ptr_read_i64(sess.tensors_ptr, slot * 5 + 4)
    dp := ptr_read_i64(sess.tensors_ptr, slot * 5)
    if owned == 1 and dp != 0 {
        mem_free_aligned(dp)
    }
    ptr_write_i64(sess.tensors_ptr, slot * 5, 0)
    ptr_write_i64(sess.tensors_ptr, slot * 5 + 4, 0)
    }
}

// Bind an externally owned NdArray into a session tensor slot
@no_alloc
fn onnx_set_tensor_slot(sess: OnnxSession, slot: i64, arr: NdArray) {
    unsafe {
    if slot < 0 or slot >= sess.max_slots { return }
    onnx_free_slot_if_owned(sess, slot)
    ptr_write_i64(sess.tensors_ptr, slot * 5, arr.data_ptr)
    ptr_write_i64(sess.tensors_ptr, slot * 5 + 1, arr.rows)
    ptr_write_i64(sess.tensors_ptr, slot * 5 + 2, arr.cols)
    ptr_write_i64(sess.tensors_ptr, slot * 5 + 3, arr.size)
    ptr_write_i64(sess.tensors_ptr, slot * 5 + 4, 0) // caller-owned
    }
}

@no_alloc
fn onnx_set_owned_slot(sess: OnnxSession, slot: i64, arr: NdArray) {
    unsafe {
    if slot < 0 or slot >= sess.max_slots { return }
    onnx_free_slot_if_owned(sess, slot)
    ptr_write_i64(sess.tensors_ptr, slot * 5, arr.data_ptr)
    ptr_write_i64(sess.tensors_ptr, slot * 5 + 1, arr.rows)
    ptr_write_i64(sess.tensors_ptr, slot * 5 + 2, arr.cols)
    ptr_write_i64(sess.tensors_ptr, slot * 5 + 3, arr.size)
    ptr_write_i64(sess.tensors_ptr, slot * 5 + 4, 1) // session-owned
    }
}

// Retrieve an NdArray view from a session tensor slot
@no_alloc
fn onnx_get_tensor_slot(sess: OnnxSession, slot: i64) -> NdArray {
    unsafe {
    if slot < 0 or slot >= sess.max_slots {
        return NdArray(data_ptr = 0, rows = 0, cols = 0, size = 0)
    }
    dp := ptr_read_i64(sess.tensors_ptr, slot * 5)
    r := ptr_read_i64(sess.tensors_ptr, slot * 5 + 1)
    c := ptr_read_i64(sess.tensors_ptr, slot * 5 + 2)
    s := ptr_read_i64(sess.tensors_ptr, slot * 5 + 3)
    return NdArray(data_ptr = dp, rows = r, cols = c, size = s)
    }
}

// Add computational node to ONNX execution graph
fn onnx_add_node(mut sess: OnnxSession, op_type: i64, in_a: i64, in_b: i64, out_slot: i64) {
    if sess.node_count >= 32 { return }
    ibuf_push(sess.nodes_buf, op_type)
    ibuf_push(sess.nodes_buf, in_a)
    ibuf_push(sess.nodes_buf, in_b)
    ibuf_push(sess.nodes_buf, out_slot)
    sess.node_count = sess.node_count + 1
}

// Execute the full ONNX graph inference pass
fn onnx_session_run(mut sess: OnnxSession, input_slot: i64, input_arr: NdArray, output_slot: i64) -> NdArray {
    unsafe {
    onnx_set_tensor_slot(sess, input_slot, input_arr)

    mut ni := 0
    while ni < sess.node_count {
        base := ni * 4
        op := ibuf_get(sess.nodes_buf, base)
        in_a := ibuf_get(sess.nodes_buf, base + 1)
        in_b := ibuf_get(sess.nodes_buf, base + 2)
        out_s := ibuf_get(sess.nodes_buf, base + 3)

        arr_a := onnx_get_tensor_slot(sess, in_a)

        if op == onnx_op_matmul() {
            arr_b := onnx_get_tensor_slot(sess, in_b)
            c := np_matmul(arr_a, arr_b)
            onnx_set_owned_slot(sess, out_s, c)
        } else if op == onnx_op_add() {
            arr_b := onnx_get_tensor_slot(sess, in_b)
            c := np_add(arr_a, arr_b)
            onnx_set_owned_slot(sess, out_s, c)
        } else if op == onnx_op_gemm() {
            // Gemm: Y = A * B (+ optional pre-bound bias initializer in out_s)
            arr_b := onnx_get_tensor_slot(sess, in_b)
            c := np_matmul(arr_a, arr_b)
            bias := onnx_get_tensor_slot(sess, out_s)
            out_owned := if out_s >= 0 and out_s < sess.max_slots { ptr_read_i64(sess.tensors_ptr, out_s * 5 + 4) } else { 1 }
            if out_owned == 0 and bias.data_ptr != 0 {
                if bias.size == c.size {
                    mut k := 0
                    while k < c.size {
                        ptr_write_f32(c.data_ptr, k, ptr_read_f32(c.data_ptr, k) + ptr_read_f32(bias.data_ptr, k))
                        k += 1
                    }
                } else if bias.rows == 1 and bias.cols == c.cols {
                    mut r := 0
                    while r < c.rows {
                        mut col := 0
                        while col < c.cols {
                            v := np_get(c, r, col) + np_get(bias, 0, col)
                            np_set(c, r, col, v)
                            col += 1
                        }
                        r += 1
                    }
                }
            }
            onnx_set_owned_slot(sess, out_s, c)
        } else if op == onnx_op_relu() {
            if arr_a.data_ptr == 0 or arr_a.rows <= 0 or arr_a.cols <= 0 { ni += 1; continue }
            out_arr := np_zeros(arr_a.rows, arr_a.cols)
            mut i := 0
            while i < arr_a.size {
                v := ptr_read_f32(arr_a.data_ptr, i)
                val := if v > 0.0 { v } else { 0.0 }
                ptr_write_f32(out_arr.data_ptr, i, val)
                i += 1
            }
            onnx_set_owned_slot(sess, out_s, out_arr)
        } else if op == onnx_op_softmax() {
            if arr_a.data_ptr == 0 or arr_a.rows <= 0 or arr_a.cols <= 0 { ni += 1; continue }
            out_arr := np_zeros(arr_a.rows, arr_a.cols)
            mut r := 0
            while r < arr_a.rows {
                row_base := r * arr_a.cols
                mut max_v := ptr_read_f32(arr_a.data_ptr, row_base)
                mut c := 1
                while c < arr_a.cols {
                    v := ptr_read_f32(arr_a.data_ptr, row_base + c)
                    if v > max_v { max_v = v }
                    c += 1
                }
                mut sum_exp := 0.0
                c = 0
                while c < arr_a.cols {
                    v := ptr_read_f32(arr_a.data_ptr, row_base + c)
                    sum_exp = sum_exp + exp_f64(v - max_v)
                    c += 1
                }
                c = 0
                while c < arr_a.cols {
                    v := ptr_read_f32(arr_a.data_ptr, row_base + c)
                    sm := exp_f64(v - max_v) / sum_exp
                    ptr_write_f32(out_arr.data_ptr, row_base + c, sm)
                    c += 1
                }
                r += 1
            }
            onnx_set_owned_slot(sess, out_s, out_arr)
        } else if op == onnx_op_layernorm() {
            if arr_a.data_ptr == 0 or arr_a.rows <= 0 or arr_a.cols <= 0 { ni += 1; continue }
            out_arr := np_zeros(arr_a.rows, arr_a.cols)
            eps := 0.00001
            mut r := 0
            while r < arr_a.rows {
                row_base := r * arr_a.cols
                mut sum := 0.0
                mut c := 0
                while c < arr_a.cols {
                    sum = sum + ptr_read_f32(arr_a.data_ptr, row_base + c)
                    c += 1
                }
                mean := sum / (arr_a.cols as f64)

                mut sum_sq := 0.0
                c = 0
                while c < arr_a.cols {
                    diff := ptr_read_f32(arr_a.data_ptr, row_base + c) - mean
                    sum_sq = sum_sq + diff * diff
                    c += 1
                }
                variance := sum_sq / (arr_a.cols as f64)
                inv_std := 1.0 / sqrt_f64(variance + eps)

                c = 0
                while c < arr_a.cols {
                    diff := ptr_read_f32(arr_a.data_ptr, row_base + c) - mean
                    ptr_write_f32(out_arr.data_ptr, row_base + c, diff * inv_std)
                    c += 1
                }
                r += 1
            }
            onnx_set_owned_slot(sess, out_s, out_arr)
        } else if op == onnx_op_clip() {
            if arr_a.data_ptr == 0 or arr_a.rows <= 0 or arr_a.cols <= 0 { ni += 1; continue }
            mut min_c := 0.0
            mut max_c := 6.0
            if in_b >= 0 {
                bounds := onnx_get_tensor_slot(sess, in_b)
                if bounds.data_ptr != 0 and bounds.size >= 2 {
                    min_c = ptr_read_f32(bounds.data_ptr, 0)
                    max_c = ptr_read_f32(bounds.data_ptr, 1)
                }
            }
            out_arr := np_zeros(arr_a.rows, arr_a.cols)
            mut i := 0
            while i < arr_a.size {
                mut v := ptr_read_f32(arr_a.data_ptr, i)
                if v < min_c { v = min_c }
                if v > max_c { v = max_c }
                ptr_write_f32(out_arr.data_ptr, i, v)
                i += 1
            }
            onnx_set_owned_slot(sess, out_s, out_arr)
        }

        ni += 1
    }

    return onnx_get_tensor_slot(sess, output_slot)
    }
}

fn onnx_session_free(move sess: OnnxSession) {
    unsafe {
    if sess.tensors_ptr != 0 {
        mut s := 0
        while s < sess.max_slots {
            onnx_free_slot_if_owned(sess, s)
            s += 1
        }
        mem_free_aligned(sess.tensors_ptr)
    }
    buf_free(move sess.nodes_buf)
    }
}
