// Axon Scikit-Learn Machine Learning Toolkit (`std/sklearn.ax`)
// 100% Pure Axon: Zero Python, Zero SciPy, Zero External Dependencies, Zero-GC.
// Implements:
//   - LinearRegression (Batch Gradient Descent Fit/Predict)
//   - LogisticRegression (Binary Classification with Sigmoid & BCE)
//   - KMeans Clustering (Lloyd's Iterative Centroid Convergence)
//   - Preprocessing: StandardScaler (Z-Score Normalization: (x - mean)/std)
//   - Classification Metrics: Accuracy Score

use std::numpy
use std::ai_math
use std::os

// --- 1. Linear Regression ---

struct LinearRegression {
    weights: NdArray // [features x 1]
    bias: f64
    n_features: i64
}

fn sklearn_linear_regression_new(n_features: i64) -> LinearRegression {
    return LinearRegression(
        weights = np_zeros(n_features, 1),
        bias = 0.0,
        n_features = n_features
    )
}

// Fit using Batch Gradient Descent
fn sklearn_linear_regression_fit(
    mut model: LinearRegression,
    x: NdArray, // [samples x features]
    y: NdArray, // [samples x 1]
    lr: f64 = 0.01,
    epochs: i64 = 100
) {
    n_samples := x.rows
    if n_samples <= 0 or model.n_features <= 0 or x.cols < model.n_features { return }
    inv_n := 1.0 / (n_samples as f64)
    grads := np_zeros(model.n_features, 1)

    mut ep := 0
    while ep < epochs {
        mut j := 0
        while j < model.n_features {
            np_set_1d(grads, j, 0.0)
            j += 1
        }
        mut sum_bias_grad := 0.0

        mut i := 0
        while i < n_samples {
            // y_hat = dot(x[i], w) + b
            mut y_hat := model.bias
            j = 0
            while j < model.n_features {
                y_hat = y_hat + np_get(x, i, j) * np_get_1d(model.weights, j)
                j += 1
            }
            err_val := y_hat - np_get_1d(y, i)
            sum_bias_grad = sum_bias_grad + err_val
            j = 0
            while j < model.n_features {
                cur_g := np_get_1d(grads, j)
                np_set_1d(grads, j, cur_g + err_val * np_get(x, i, j))
                j += 1
            }
            i += 1
        }

        // Apply simultaneous batch parameter update
        mut f := 0
        while f < model.n_features {
            old_w := np_get_1d(model.weights, f)
            np_set_1d(model.weights, f, old_w - lr * inv_n * np_get_1d(grads, f))
            f += 1
        }
        model.bias = model.bias - lr * inv_n * sum_bias_grad
        ep += 1
    }
    np_free(move grads)
}

fn sklearn_linear_regression_free(move model: LinearRegression) {
    np_free(move model.weights)
}

// Predict target values for test set X
fn sklearn_linear_regression_predict(model: LinearRegression, x: NdArray) -> NdArray {
    preds := np_zeros(x.rows, 1)
    mut i := 0
    while i < x.rows {
        mut y_hat := model.bias
        mut j := 0
        while j < model.n_features {
            y_hat = y_hat + np_get(x, i, j) * np_get_1d(model.weights, j)
            j += 1
        }
        np_set_1d(preds, i, y_hat)
        i += 1
    }
    return preds
}

// --- 2. Logistic Regression (Binary Classification) ---

struct LogisticRegression {
    weights: NdArray // [features x 1]
    bias: f64
    n_features: i64
}

fn sklearn_logistic_regression_new(n_features: i64) -> LogisticRegression {
    return LogisticRegression(
        weights = np_zeros(n_features, 1),
        bias = 0.0,
        n_features = n_features
    )
}

@no_alloc
fn sklearn_sigmoid(z: f64) -> f64 {
    if z < -40.0 { return 0.0 }
    if z > 40.0  { return 1.0 }
    return 1.0 / (1.0 + exp_f64(0.0 - z))
}

fn sklearn_logistic_regression_fit(
    mut model: LogisticRegression,
    x: NdArray,
    y: NdArray,
    lr: f64 = 0.05,
    epochs: i64 = 100
) {
    n_samples := x.rows
    if n_samples <= 0 or model.n_features <= 0 or x.cols < model.n_features { return }
    inv_n := 1.0 / (n_samples as f64)
    grads := np_zeros(model.n_features, 1)

    mut ep := 0
    while ep < epochs {
        mut j := 0
        while j < model.n_features {
            np_set_1d(grads, j, 0.0)
            j += 1
        }
        mut sum_bias_grad := 0.0

        mut i := 0
        while i < n_samples {
            mut z := model.bias
            j = 0
            while j < model.n_features {
                z = z + np_get(x, i, j) * np_get_1d(model.weights, j)
                j += 1
            }
            pred_prob := sklearn_sigmoid(z)
            err_val := pred_prob - np_get_1d(y, i)
            sum_bias_grad = sum_bias_grad + err_val
            j = 0
            while j < model.n_features {
                cur_g := np_get_1d(grads, j)
                np_set_1d(grads, j, cur_g + err_val * np_get(x, i, j))
                j += 1
            }
            i += 1
        }

        mut f := 0
        while f < model.n_features {
            old_w := np_get_1d(model.weights, f)
            np_set_1d(model.weights, f, old_w - lr * inv_n * np_get_1d(grads, f))
            f += 1
        }
        model.bias = model.bias - lr * inv_n * sum_bias_grad
        ep += 1
    }
    np_free(move grads)
}

fn sklearn_logistic_regression_free(move model: LogisticRegression) {
    np_free(move model.weights)
}

// Predict probabilities [0.0 .. 1.0]
fn sklearn_logistic_predict_proba(model: LogisticRegression, x: NdArray) -> NdArray {
    probs := np_zeros(x.rows, 1)
    mut i := 0
    while i < x.rows {
        mut z := model.bias
        mut j := 0
        while j < model.n_features {
            z = z + np_get(x, i, j) * np_get_1d(model.weights, j)
            j += 1
        }
        np_set_1d(probs, i, sklearn_sigmoid(z))
        i += 1
    }
    return probs
}

// Predict binary class label (0 or 1) using 0.5 decision threshold
fn sklearn_logistic_predict(model: LogisticRegression, x: NdArray) -> NdArray {
    preds := np_zeros(x.rows, 1)
    probs := sklearn_logistic_predict_proba(model, x)
    mut i := 0
    while i < x.rows {
        p := np_get_1d(probs, i)
        np_set_1d(preds, i, if p >= 0.5 { 1.0 } else { 0.0 })
        i += 1
    }
    np_free(move probs)
    return preds
}

// --- 3. K-Means Clustering ---

struct KMeans {
    k: i64
    n_features: i64
    centroids: NdArray // [k x n_features]
}

fn sklearn_kmeans_new(k: i64, n_features: i64) -> KMeans {
    return KMeans(k = k, n_features = n_features, centroids = np_zeros(k, n_features))
}

// Fit centroids on X dataset
fn sklearn_kmeans_fit(mut km: KMeans, x: NdArray, max_iters: i64 = 50) {
    unsafe {
    if km.k <= 0 or km.k > 65536 or km.n_features <= 0 or x.rows < km.k or x.data_ptr == 0 or km.centroids.data_ptr == 0 { return }
    
    // Initialize centroids to first K samples
    mut ki := 0
    while ki < km.k {
        mut f := 0
        while f < km.n_features {
            v := np_get(x, ki, f)
            np_set(km.centroids, ki, f, v)
            f += 1
        }
        ki += 1
    }

    // Iterative clustering
    counts := mem_alloc_aligned(km.k * 8 + 64)
    new_centers := np_zeros(km.k, km.n_features)
    if counts == 0 or new_centers.data_ptr == 0 {
        if counts != 0 { mem_free_aligned(counts) }
        np_free(move new_centers)
        return
    }

    mut iter := 0
    while iter < max_iters {
        // Reset accumulators
        ki = 0
        while ki < km.k {
            ptr_write_i64(counts, ki, 0)
            mut f := 0
            while f < km.n_features {
                np_set(new_centers, ki, f, 0.0)
                f += 1
            }
            ki += 1
        }

        // Assign each sample to nearest centroid
        mut i := 0
        while i < x.rows {
            mut min_dist := 999999999999.0
            mut best_k := 0
            ki = 0
            while ki < km.k {
                mut d := 0.0
                mut f := 0
                while f < km.n_features {
                    diff := np_get(x, i, f) - np_get(km.centroids, ki, f)
                    d = d + diff * diff
                    f += 1
                }
                if d < min_dist {
                    min_dist = d
                    best_k = ki
                }
                ki += 1
            }

            // Accumulate
            c_cnt := ptr_read_i64(counts, best_k)
            ptr_write_i64(counts, best_k, c_cnt + 1)
            mut f := 0
            while f < km.n_features {
                old_sum := np_get(new_centers, best_k, f)
                np_set(new_centers, best_k, f, old_sum + np_get(x, i, f))
                f += 1
            }
            i += 1
        }

        // Recompute centroids as mean of assigned points
        ki = 0
        while ki < km.k {
            cnt := ptr_read_i64(counts, ki)
            if cnt > 0 {
                inv_c := 1.0 / (cnt as f64)
                mut f := 0
                while f < km.n_features {
                    mean_val := np_get(new_centers, ki, f) * inv_c
                    np_set(km.centroids, ki, f, mean_val)
                    f += 1
                }
            }
            ki += 1
        }
        iter += 1
    }

    mem_free_aligned(counts)
    np_free(move new_centers)
    }
}

fn sklearn_kmeans_free(move km: KMeans) {
    np_free(move km.centroids)
}

// Predict cluster index [0..k-1] for samples
fn sklearn_kmeans_predict(km: KMeans, x: NdArray) -> IntBuf {
    labels := ibuf_new(x.rows)
    mut i := 0
    while i < x.rows {
        mut min_dist := 999999999999.0
        mut best_k := 0
        mut ki := 0
        while ki < km.k {
            mut d := 0.0
            mut f := 0
            while f < km.n_features {
                diff := np_get(x, i, f) - np_get(km.centroids, ki, f)
                d = d + diff * diff
                f += 1
            }
            if d < min_dist {
                min_dist = d
                best_k = ki
            }
            ki += 1
        }
        ibuf_push(labels, best_k)
        i += 1
    }
    return labels
}

// --- 4. Preprocessing: StandardScaler ---

struct StandardScaler {
    mean: NdArray
    std: NdArray
    n_features: i64
}

fn sklearn_standard_scaler_fit(x: NdArray) -> StandardScaler {
    if x.cols <= 0 {
        return StandardScaler(mean = np_zeros(0, 0), std = np_zeros(0, 0), n_features = 0)
    }
    m := np_zeros(1, x.cols)
    s := np_zeros(1, x.cols)
    if x.rows <= 0 {
        mut ci := 0
        while ci < x.cols {
            np_set_1d(s, ci, 1.0)
            ci += 1
        }
        return StandardScaler(mean = m, std = s, n_features = x.cols)
    }
    n := x.rows as f64

    mut c := 0
    while c < x.cols {
        // Mean
        mut sum := 0.0
        mut r := 0
        while r < x.rows {
            sum = sum + np_get(x, r, c)
            r += 1
        }
        mean_c := sum / n
        np_set_1d(m, c, mean_c)

        // Variance & Std
        mut sum_sq := 0.0
        r = 0
        while r < x.rows {
            diff := np_get(x, r, c) - mean_c
            sum_sq = sum_sq + diff * diff
            r += 1
        }
        var_c := sum_sq / n
        mut std_c := sqrt_f64(var_c)
        if std_c < 0.000000001 {
            std_c = 1.0
        }
        np_set_1d(s, c, std_c)
        c += 1
    }

    return StandardScaler(mean = m, std = s, n_features = x.cols)
}

fn sklearn_standard_scaler_free(move scaler: StandardScaler) {
    np_free(move scaler.mean)
    np_free(move scaler.std)
}

fn sklearn_standard_scaler_transform(scaler: StandardScaler, x: NdArray) -> NdArray {
    out := np_zeros(x.rows, x.cols)
    mut r := 0
    while r < x.rows {
        mut c := 0
        while c < x.cols {
            v := np_get(x, r, c)
            mean_c := np_get_1d(scaler.mean, c)
            std_c := np_get_1d(scaler.std, c)
            np_set(out, r, c, (v - mean_c) / std_c)
            c += 1
        }
        r += 1
    }
    return out
}

// --- 5. Classification Metrics ---

@no_alloc
fn sklearn_accuracy_score(y_true: NdArray, y_pred: NdArray) -> f64 {
    limit := if y_true.size < y_pred.size { y_true.size } else { y_pred.size }
    if limit == 0 { return 0.0 }
    mut correct := 0
    mut i := 0
    while i < limit {
        yt := np_get_1d(y_true, i) as i64
        yp := np_get_1d(y_pred, i) as i64
        if yt == yp {
            correct += 1
        }
        i += 1
    }
    return (correct as f64) / (limit as f64)
}
