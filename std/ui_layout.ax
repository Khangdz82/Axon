// Axon Standard Library: Native Flexbox & Box Layout Engine (`std/ui_layout.ax`)
// Pure native zero-CEF layout solver: Computes exact bounding boxes (x, y, w, h)
// for DOM elements according to CSS display, flex-direction, justify-content,
// align-items, gap, padding, and margin.

use std::os
use std::str
use std::html
use std::css

// Layout box per node: [x, y, w, h] (4 integers per node)
struct LayoutTree {
    boxes: IntBuf // node_idx * 4 -> [x, y, w, h]
    count: i64
}

fn layout_tree_new(cap_nodes: i64) -> LayoutTree {
    mut b := ibuf_new(cap_nodes * 4 + 16)
    mut i := 0
    total_slots := cap_nodes * 4
    while i < total_slots {
        ibuf_push(b, 0)
        i += 1
    }
    return LayoutTree(boxes = b, count = cap_nodes)
}

fn layout_get_x(lt: LayoutTree, node_idx: i64) -> i64 {
    if node_idx < 0 or node_idx >= lt.count { return 0 }
    return ibuf_get(lt.boxes, node_idx * 4)
}

fn layout_get_y(lt: LayoutTree, node_idx: i64) -> i64 {
    if node_idx < 0 or node_idx >= lt.count { return 0 }
    return ibuf_get(lt.boxes, node_idx * 4 + 1)
}

fn layout_get_w(lt: LayoutTree, node_idx: i64) -> i64 {
    if node_idx < 0 or node_idx >= lt.count { return 0 }
    return ibuf_get(lt.boxes, node_idx * 4 + 2)
}

fn layout_get_h(lt: LayoutTree, node_idx: i64) -> i64 {
    if node_idx < 0 or node_idx >= lt.count { return 0 }
    return ibuf_get(lt.boxes, node_idx * 4 + 3)
}

fn layout_set_box(lt: LayoutTree, node_idx: i64, x: i64, y: i64, w: i64, h: i64) {
    if node_idx < 0 or node_idx >= lt.count { return }
    base := node_idx * 4
    ibuf_set(lt.boxes, base, x)
    ibuf_set(lt.boxes, base + 1, y)
    ibuf_set(lt.boxes, base + 2, w)
    ibuf_set(lt.boxes, base + 3, h)
}

fn layout_shift_subtree(tree: DomTree, lt: LayoutTree, node_idx: i64, dx: i64, dy: i64) {
    if node_idx < 0 or node_idx >= lt.count { return }
    if dx == 0 and dy == 0 { return }
    base := node_idx * 4
    ibuf_set(lt.boxes, base, ibuf_get(lt.boxes, base) + dx)
    ibuf_set(lt.boxes, base + 1, ibuf_get(lt.boxes, base + 1) + dy)
    mut ch := dom_first_child(tree, node_idx)
    while ch >= 0 {
        layout_shift_subtree(tree, lt, ch, dx, dy)
        ch = dom_next_sibling(tree, ch)
    }
}

// Estimates text content width based on character count and font size
fn layout_estimate_text_width(text: str, font_size: i64 = 14) -> i64 {
    n := str_len(text)
    if n == 0 { return 0 }
    char_w := (font_size * 62) / 100
    return n * char_w
}

// Estimates total width of an inline node including its <span>/<strong> inline children
fn layout_estimate_inline_tree_w(tree: DomTree, sheet: Stylesheet, node_idx: i64, font_size: i64 = 14) -> i64 {
    mut w := layout_estimate_text_width(dom_get_text(tree, node_idx), font_size)
    mut ch := dom_first_child(tree, node_idx)
    while ch >= 0 {
        cs := css_compute_node_style(tree, ch, sheet)
        if cs.display == 2 {
            w += layout_estimate_text_width(dom_get_text(tree, ch), 14) + 6
        }
        ch = dom_next_sibling(tree, ch)
    }
    return w
}

// Solves layout recursively using pre-computed style (avoids redundant CSS/Tailwind parsing per child!)
fn layout_solve_node_styled(tree: DomTree, sheet: Stylesheet, lt: LayoutTree, node_idx: i64, style: ComputedStyle, avail_x: i64, avail_y: i64, avail_w: i64, avail_h: i64) {
    if node_idx < 0 or node_idx >= tree.count { return }
    if style.display == 3 { // display: none
        layout_set_box(lt, node_idx, 0, 0, 0, 0)
        return
    }

    mut box_w := style.width
    mut box_h := style.height

    pad_w := style.padding_x
    pad_h := style.padding_y
    margin_x := style.margin_x / 2
    margin_y := style.margin_y / 2

    mut pos_x := avail_x + margin_x
    pos_y := avail_y + margin_y

    if box_h == -100 {
        box_h = avail_h - style.margin_y
        if box_h < 0 { box_h = 0 }
    }

    if box_w < 0 {
        if box_w == -3 {
            efz := if style.font_size > 0 { style.font_size } else { 14 }
            tlen_w := layout_estimate_text_width(dom_get_text(tree, node_idx), efz) + pad_w + 16
            box_w = if tlen_w < avail_w - style.margin_x { tlen_w } else { avail_w - style.margin_x }
        } else {
            box_w = avail_w - style.margin_x
        }
        if box_w < 0 { box_w = 0 }
    }
    if style.max_width > 0 and box_w > style.max_width {
        box_w = style.max_width
    }
    if style.margin_auto and avail_w > box_w {
        pos_x = avail_x + (avail_w - box_w) / 2
    }

    txt := dom_get_text(tree, node_idx)
    node_tag := dom_get_tag(tree, node_idx)
    txt_scale := if str_eq_ignore_case(node_tag, "h1") { 2 } else { 1 }
    mut txt_line_h := if txt_scale == 2 { 34 } else { 22 }
    if style.font_size > 0 {
        txt_line_h = (style.font_size * 3) / 2
        if txt_line_h < style.font_size + 6 { txt_line_h = style.font_size + 6 }
    }
    if box_h < 0 and str_len(txt) > 0 {
        efz := if style.font_size > 0 { style.font_size } else { (if txt_scale == 2 { 24 } else { 14 }) }
        est_tw := layout_estimate_text_width(txt, efz)
        mut inner_w := box_w - pad_w
        if inner_w < 60 { inner_w = 60 }
        mut n_lines := (est_tw + inner_w - 1) / inner_w
        if n_lines < 1 { n_lines = 1 }
        if style.display == 2 or str_eq_ignore_case(node_tag, "button") or str_eq_ignore_case(node_tag, "input") { n_lines = 1 }
        mut min_th := txt_line_h * n_lines + pad_h
        if str_eq_ignore_case(node_tag, "button") or str_eq_ignore_case(node_tag, "input") or str_eq_ignore_case(node_tag, "h1") {
            if min_th < 34 + pad_h { min_th = 34 + pad_h }
        } else if str_eq_ignore_case(node_tag, "h2") {
            if min_th < 26 + pad_h { min_th = 26 + pad_h }
        }
        box_h = min_th
    }

    fc := dom_first_child(tree, node_idx)
    if fc >= 0 {
        content_x := pos_x + pad_w / 2
        content_y := pos_y + pad_h / 2
        mut content_w := box_w - pad_w
        if content_w < 0 { content_w = 0 }
        gap := style.gap

        // --- Native CSS Grid (`display: grid` / Tailwind `grid grid-cols-N`) ---
        if style.display == 4 {
            mut cols := style.grid_cols
            if cols <= 0 { cols = 1 }
            mut cell_w := (content_w - gap * (cols - 1)) / cols
            if cell_w < 1 { cell_w = 1 }

            mut cur_y := content_y
            mut col_i := 0
            mut row_h := 0
            mut row_start_node := fc
            mut cur_g := fc
            while cur_g >= 0 {
                gs := css_compute_node_style(tree, cur_g, sheet)
                if gs.display == 3 {
                    layout_set_box(lt, cur_g, 0, 0, 0, 0)
                    cur_g = dom_next_sibling(tree, cur_g)
                    continue
                }
                cx := content_x + col_i * (cell_w + gap)
                layout_solve_node_styled(tree, sheet, lt, cur_g, gs, cx, cur_y, cell_w, avail_h)
                gh := layout_get_h(lt, cur_g) + gs.margin_y
                if gh > row_h { row_h = gh }
                col_i += 1
                nxt_g := dom_next_sibling(tree, cur_g)
                if col_i >= cols or nxt_g < 0 {
                    // Equalize row item heights (CSS Grid default `align-items: stretch`)
                    mut eq := row_start_node
                    while eq >= 0 {
                        if layout_get_w(lt, eq) > 0 and layout_get_h(lt, eq) < row_h {
                            layout_set_box(lt, eq, layout_get_x(lt, eq), layout_get_y(lt, eq), layout_get_w(lt, eq), row_h)
                        }
                        if eq == cur_g { break }
                        eq = dom_next_sibling(tree, eq)
                    }
                    cur_y += row_h
                    if nxt_g >= 0 { cur_y += gap }
                    col_i = 0
                    row_h = 0
                    row_start_node = nxt_g
                }
                cur_g = nxt_g
            }
            if box_h < 0 {
                box_h = (cur_y - content_y) + pad_h
                if box_h < 32 + pad_h { box_h = 32 + pad_h }
            }
            layout_set_box(lt, node_idx, pos_x, pos_y, box_w, box_h)
            return
        }

        // Block containers and flex-direction: column stack vertically; flex-row / inline lay out horizontally
        first_c_style := css_compute_node_style(tree, fc, sheet)
        has_inline_flow := first_c_style.display == 2
        is_col := (not has_inline_flow) and ((style.display == 0) or (style.display == 1 and style.flex_direction == 1))

        // Pre-pass for flex-row: measure fixed, percentage (`<= -1000`), and auto children
        mut flex_grow_count := 0
        mut fixed_row_w := 0
        mut pct_total := 0
        mut row_vis := 0
        if not is_col {
            mut rc := fc
            while rc >= 0 {
                rs := css_compute_node_style(tree, rc, sheet)
                if rs.display != 3 {
                    if rs.width <= -1000 {
                        pct_total += (0 - rs.width - 1000)
                        fixed_row_w += rs.margin_x
                    } else if rs.width == -2 {
                        flex_grow_count += 1
                    } else if rs.width > 0 {
                        fixed_row_w += rs.width + rs.margin_x
                    } else if rs.display != 2 and dom_first_child(tree, rc) >= 0 {
                        rfc := dom_first_child(tree, rc)
                        rfc_s := css_compute_node_style(tree, rfc, sheet)
                        if rfc_s.display == 2 {
                            rtag := dom_get_tag(tree, rc)
                            rfz := if str_eq_ignore_case(rtag, "h1") { 20 } else { 14 }
                            mut est_i := layout_estimate_inline_tree_w(tree, sheet, rc, rfz) + rs.padding_x + 16
                            if est_i > content_w { est_i = content_w }
                            fixed_row_w += est_i + rs.margin_x
                        } else {
                            flex_grow_count += 1
                        }
                    } else {
                        rt := dom_get_text(tree, rc)
                        rfz := if rs.font_size > 0 { rs.font_size } else { 14 }
                        mut est := if str_len(rt) > 0 { layout_estimate_text_width(rt, rfz) + rs.padding_x + 20 } else { 80 }
                        if est > content_w { est = content_w }
                        fixed_row_w += est + rs.margin_x
                    }
                    if row_vis > 0 { fixed_row_w += gap }
                    row_vis += 1
                }
                rc = dom_next_sibling(tree, rc)
            }
        }
        mut pct_base_w := content_w - fixed_row_w
        if pct_base_w < 0 { pct_base_w = 0 }
        mut rem_row_w := pct_base_w - (pct_base_w * pct_total) / 100
        if rem_row_w < 0 { rem_row_w = 0 }
        mut flex_each_w := if flex_grow_count > 0 { rem_row_w / flex_grow_count } else { content_w }
        if flex_each_w < 80 and content_w >= 80 { flex_each_w = 80 }

        mut cur_child := fc
        mut cursor_x := content_x
        mut cursor_y := content_y
        mut total_main := 0
        if str_len(txt) > 0 {
            if has_inline_flow {
                step_t := layout_estimate_text_width(txt, if style.font_size > 0 { style.font_size } else { 14 }) + 4
                cursor_x += step_t
                total_main += step_t
            } else {
                cursor_y += txt_line_h
                total_main += txt_line_h
            }
        }
        mut max_child_w := 0
        mut max_child_h := 0
        mut vis_count := 0
        mut line_item_count := 0
        mut line_max_h := 0
        mut wrapped_total_h := 0

        while cur_child >= 0 {
            c_style := css_compute_node_style(tree, cur_child, sheet)
            if c_style.display == 3 {
                layout_set_box(lt, cur_child, 0, 0, 0, 0)
                cur_child = dom_next_sibling(tree, cur_child)
                continue
            }

            mut cw := c_style.width
            mut ch := c_style.height
            c_tag := dom_get_tag(tree, cur_child)
            c_txt := dom_get_text(tree, cur_child)
            c_fz := if c_style.font_size > 0 { c_style.font_size } else { (if str_eq_ignore_case(c_tag, "h1") { 24 } else { 14 }) }

            if cw <= -1000 {
                pct := 0 - cw - 1000
                cw = (pct_base_w * pct) / 100
                if cw < 60 and content_w >= 60 { cw = 60 }
            } else if cw < 0 {
                if not is_col {
                    if c_style.display == 2 {
                        cw = layout_estimate_text_width(c_txt, c_fz) + c_style.padding_x + 10
                    } else if cw == -2 and not style.flex_wrap {
                        cw = flex_each_w - c_style.margin_x
                        if cw < 0 { cw = 0 }
                    } else if dom_first_child(tree, cur_child) >= 0 {
                        cfc := dom_first_child(tree, cur_child)
                        cfc_s := css_compute_node_style(tree, cfc, sheet)
                        if cfc_s.display == 2 {
                            cw = layout_estimate_inline_tree_w(tree, sheet, cur_child, c_fz) + c_style.padding_x + 16
                        } else {
                            cw = flex_each_w - c_style.margin_x
                            if cw < 0 { cw = 0 }
                        }
                    } else if str_len(c_txt) > 0 {
                        cw = layout_estimate_text_width(c_txt, c_fz) + c_style.padding_x + 20
                    } else {
                        cw = 80
                    }
                } else if str_eq_ignore_case(c_tag, "button") and str_len(c_txt) > 0 {
                    cw = layout_estimate_text_width(c_txt, c_fz) + c_style.padding_x + 16
                } else {
                    cw = content_w - c_style.margin_x
                    if cw < 0 { cw = 0 }
                }
            }

            // Compute wrapped height for leaf nodes using resolved `cw` & `c_fz`, or stretch on flex-row!
            if ch < 0 and ch != -100 and dom_first_child(tree, cur_child) < 0 {
                c_lh := (c_fz * 3) / 2
                if str_eq_ignore_case(c_tag, "button") or str_eq_ignore_case(c_tag, "input") {
                    ch = (if c_lh > 24 { c_lh } else { 24 }) + c_style.padding_y + 8
                } else if str_eq_ignore_case(c_tag, "h1") {
                    ch = (if c_lh > 34 { c_lh } else { 34 }) + c_style.padding_y
                } else if str_eq_ignore_case(c_tag, "h2") {
                    ch = (if c_lh > 26 { c_lh } else { 26 }) + c_style.padding_y
                } else if c_style.display == 2 {
                    ch = c_lh + c_style.padding_y
                } else {
                    mut c_inner_w := cw - c_style.padding_x
                    if c_inner_w < 60 { c_inner_w = 60 }
                    mut clines := (layout_estimate_text_width(c_txt, c_fz) + c_inner_w - 1) / c_inner_w
                    if clines < 1 { clines = 1 }
                    ch = c_lh * clines + c_style.padding_y
                }
            } else if not is_col and style.display == 1 and style.align_items == 0 and box_h > 0 and ch < 0 and not style.flex_wrap {
                // CSS Flexbox default `align-items: stretch` on fixed/h-screen flex-row containers!
                ch = box_h - pad_h - c_style.margin_y
                if ch < 0 { ch = 0 }
            }

            // Flexbox `flex-wrap: wrap` line break when next item overflows content_w
            if not is_col and style.flex_wrap and line_item_count > 0 {
                need_w := gap + cw + c_style.margin_x
                if cursor_x + need_w > content_x + content_w {
                    wrapped_total_h += line_max_h + gap
                    cursor_y += line_max_h + gap
                    cursor_x = content_x
                    line_max_h = 0
                    line_item_count = 0
                }
            }

            if is_col {
                if vis_count > 0 {
                    cursor_y += gap
                    total_main += gap
                }
            } else {
                if line_item_count > 0 {
                    cursor_x += gap
                    total_main += gap
                }
            }

            child_avail_w := cw + c_style.margin_x
            child_avail_h := if ch >= 0 { ch + c_style.margin_y } else { avail_h }
            layout_solve_node_styled(tree, sheet, lt, cur_child, c_style, cursor_x, cursor_y, child_avail_w, child_avail_h)
            if not is_col and style.display == 1 and style.align_items == 0 and box_h > 0 and c_style.height < 0 and not style.flex_wrap {
                stretch_h := box_h - pad_h - c_style.margin_y
                if stretch_h > layout_get_h(lt, cur_child) {
                    layout_set_box(lt, cur_child, layout_get_x(lt, cur_child), layout_get_y(lt, cur_child), layout_get_w(lt, cur_child), stretch_h)
                }
            }

            actual_w := layout_get_w(lt, cur_child)
            actual_h := layout_get_h(lt, cur_child)
            if actual_w + c_style.margin_x > max_child_w { max_child_w = actual_w + c_style.margin_x }
            if actual_h + c_style.margin_y > max_child_h { max_child_h = actual_h + c_style.margin_y }
            if actual_h + c_style.margin_y > line_max_h { line_max_h = actual_h + c_style.margin_y }

            if is_col {
                step := actual_h + c_style.margin_y
                cursor_y += step
                total_main += step
            } else {
                step := actual_w + c_style.margin_x
                cursor_x += step
                total_main += step
                line_item_count += 1
            }
            vis_count += 1
            cur_child = dom_next_sibling(tree, cur_child)
        }

        // Vertical `flex-1` / `flex-grow` distribution inside fixed-height `flex-col` containers!
        if is_col and style.display == 1 and box_h > 0 and vis_count > 0 {
            col_content_h := box_h - pad_h
            extra_v := col_content_h - total_main
            if extra_v > 0 {
                mut grow_cnt := 0
                mut gc := fc
                while gc >= 0 {
                    gs := css_compute_node_style(tree, gc, sheet)
                    if gs.display != 3 and gs.flex_grow > 0 { grow_cnt += 1 }
                    gc = dom_next_sibling(tree, gc)
                }
                if grow_cnt > 0 {
                    add_each := extra_v / grow_cnt
                    mut cum_dy := 0
                    gc = fc
                    while gc >= 0 {
                        gs := css_compute_node_style(tree, gc, sheet)
                        if gs.display != 3 {
                            if cum_dy > 0 {
                                layout_shift_subtree(tree, lt, gc, 0, cum_dy)
                            }
                            if gs.flex_grow > 0 {
                                layout_set_box(lt, gc, layout_get_x(lt, gc), layout_get_y(lt, gc), layout_get_w(lt, gc), layout_get_h(lt, gc) + add_each)
                                cum_dy += add_each
                            }
                        }
                        gc = dom_next_sibling(tree, gc)
                    }
                    total_main = col_content_h
                }
            }
        }

        if box_h < 0 {
            if vis_count == 0 {
                box_h = 32 + pad_h
            } else if is_col {
                box_h = total_main + pad_h
            } else if style.flex_wrap {
                box_h = wrapped_total_h + line_max_h + pad_h
            } else {
                box_h = max_child_h + pad_h
            }
        }

        mut content_h := box_h - pad_h
        if content_h < 0 { content_h = 0 }

        // Apply flex alignment (justify-content / align-items) when container is flex
        if style.display == 1 and vis_count > 0 and (style.justify_content != 0 or style.align_items != 0) {
            content_main := if is_col { content_h } else { content_w }
            content_cross := if is_col { content_w } else { content_h }
            rem := content_main - total_main

            mut k := 0
            mut ch_node := fc
            while ch_node >= 0 {
                cw_cur := layout_get_w(lt, ch_node)
                ch_cur := layout_get_h(lt, ch_node)
                if cw_cur > 0 or ch_cur > 0 {
                    mut main_shift := 0
                    if rem > 0 {
                        if style.justify_content == 1 { main_shift = rem / 2 }
                        else if style.justify_content == 2 { main_shift = rem }
                        else if style.justify_content == 3 and vis_count > 1 { main_shift = (rem * k) / (vis_count - 1) }
                        else if style.justify_content == 4 {
                            slot := rem / vis_count
                            main_shift = (slot / 2) + k * slot
                        }
                    }

                    mut cross_shift := 0
                    child_cross := if is_col { cw_cur } else { ch_cur }
                    cross_rem := content_cross - child_cross
                    if cross_rem > 0 {
                        if style.align_items == 1 { cross_shift = cross_rem / 2 }
                        else if style.align_items == 3 { cross_shift = cross_rem }
                    }

                    if is_col {
                        layout_shift_subtree(tree, lt, ch_node, cross_shift, main_shift)
                    } else {
                        layout_shift_subtree(tree, lt, ch_node, main_shift, cross_shift)
                    }
                    k += 1
                }
                ch_node = dom_next_sibling(tree, ch_node)
            }
        }
    } else {
        if box_h < 0 { box_h = 32 + pad_h }
    }

    layout_set_box(lt, node_idx, pos_x, pos_y, box_w, box_h)
}

fn layout_solve_node(tree: DomTree, sheet: Stylesheet, lt: LayoutTree, node_idx: i64, avail_x: i64, avail_y: i64, avail_w: i64, avail_h: i64) {
    if node_idx < 0 or node_idx >= tree.count { return }
    style := css_compute_node_style(tree, node_idx, sheet)
    layout_solve_node_styled(tree, sheet, lt, node_idx, style, avail_x, avail_y, avail_w, avail_h)
}

fn layout_compute(tree: DomTree, sheet: Stylesheet, window_w: i64, window_h: i64) -> LayoutTree {
    lt := layout_tree_new(tree.count)
    if tree.root_idx >= 0 {
        layout_solve_node(tree, sheet, lt, tree.root_idx, 0, 0, window_w, window_h)
    }
    return lt
}
