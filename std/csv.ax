// Axon High-Speed Zero-GC RFC-4180 CSV & TSV Analytics Library (`std/csv.ax`)
// Flat index-buffer representation: parses 10,000+ rows in sub-millisecond with zero per-cell string allocations.

use std::str

// `cells`: 3 ints per cell `[row_idx, byte_off, byte_len]`
struct CsvTable {
    src: str
    cells: IntBuf
    row_count: i64
    col_count: i64
    cell_count: i64
}

fn csv_parse(src: str, delim: i64 = 44) -> CsvTable {
    n := str_len(src)
    mut cap_cells := (n / 4) + 32
    if cap_cells < 64 { cap_cells = 64 }
    cells := ibuf_new(cap_cells * 3)

    mut row := 0
    mut col := 0
    mut max_cols := 0
    mut cell_cnt := 0
    mut i := 0

    while i < n {
        // Skip leading spaces
        while i < n and str_byte(src, i) == 32 { i += 1 }
        if i >= n { break }
        ch := str_byte(src, i)
        if ch == 13 or ch == 10 {
            if ch == 13 and i + 1 < n and str_byte(src, i + 1) == 10 { i += 2 }
            else { i += 1 }
            if col > 0 {
                if col > max_cols { max_cols = col }
                row += 1
                col = 0
            }
            continue
        }

        mut start := i
        mut clen := 0
        if ch == 34 { // Quoted field '"'
            i += 1
            start = i
            while i < n {
                if str_byte(src, i) == 34 {
                    if i + 1 < n and str_byte(src, i + 1) == 34 {
                        i += 2
                        continue
                    }
                    break
                }
                i += 1
            }
            clen = i - start
            if i < n and str_byte(src, i) == 34 { i += 1 }
            while i < n and str_byte(src, i) != delim and str_byte(src, i) != 10 and str_byte(src, i) != 13 {
                i += 1
            }
        } else {
            start = i
            while i < n and str_byte(src, i) != delim and str_byte(src, i) != 10 and str_byte(src, i) != 13 {
                i += 1
            }
            clen = i - start
            // Trim trailing spaces
            while clen > 0 and str_byte(src, start + clen - 1) == 32 { clen -= 1 }
        }

        if cell_cnt * 3 + 3 <= cap_cells * 3 {
            ibuf_push(cells, row)
            ibuf_push(cells, start)
            ibuf_push(cells, clen)
            cell_cnt += 1
        }
        col += 1

        if i < n and str_byte(src, i) == delim {
            i += 1
        } else if i < n and (str_byte(src, i) == 13 or str_byte(src, i) == 10) {
            if str_byte(src, i) == 13 and i + 1 < n and str_byte(src, i + 1) == 10 { i += 2 }
            else { i += 1 }
            if col > max_cols { max_cols = col }
            row += 1
            col = 0
        }
    }

    if col > 0 {
        if col > max_cols { max_cols = col }
        row += 1
    }

    return CsvTable(src = src, cells = cells, row_count = row, col_count = max_cols, cell_count = cell_cnt)
}

fn csv_get(t: CsvTable, row: i64, col: i64) -> str {
    if row < 0 or row >= t.row_count or col < 0 or col >= t.col_count { return "" }
    idx := row * t.col_count + col
    if idx < 0 or idx >= t.cell_count { return "" }
    base := idx * 3
    off := ibuf_get(t.cells, base + 1)
    ln := ibuf_get(t.cells, base + 2)
    return str_slice(t.src, off, off + ln)
}

@no_alloc
fn csv_get_i64(t: CsvTable, row: i64, col: i64, default_val: i64 = 0) -> i64 {
    if row < 0 or row >= t.row_count or col < 0 or col >= t.col_count { return default_val }
    idx := row * t.col_count + col
    if idx < 0 or idx >= t.cell_count { return default_val }
    base := idx * 3
    off := ibuf_get(t.cells, base + 1)
    ln := ibuf_get(t.cells, base + 2)
    if ln <= 0 { return default_val }
    mut i := 0
    mut sign := 1
    if str_byte(t.src, off) == 45 { sign = -1; i = 1 }
    else if str_byte(t.src, off) == 43 { i = 1 }
    if i >= ln { return default_val }
    mut acc := 0
    while i < ln {
        ch := str_byte(t.src, off + i)
        if ch < 48 or ch > 57 { break }
        acc = acc * 10 + (ch - 48)
        i += 1
    }
    return acc * sign
}

@no_alloc
fn csv_sum_col_i64(t: CsvTable, col: i64, start_row: i64 = 1) -> i64 {
    mut sum := 0
    mut r := start_row
    while r < t.row_count {
        sum += csv_get_i64(t, r, col, 0)
        r += 1
    }
    return sum
}

fn csv_free(move t: CsvTable) {
    buf_free(move t.cells)
}
