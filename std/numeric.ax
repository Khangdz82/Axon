// ============================================================================
// 1. IEEE-754 Double-Precision Elementary Transcendentals (Zero-CRT `libm`)
// ============================================================================

fn num_pi() -> f64 { return 3.14159265358979323846 }
fn num_two_pi() -> f64 { return 6.28318530717958647692 }
fn num_half_pi() -> f64 { return 1.57079632679489661923 }

fn num_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn num_floor(x: f64) -> f64 {
    i := x as i64
    fi := i as f64
    if fi > x { return (i - 1) as f64 }
    return fi
}

fn num_ceil(x: f64) -> f64 {
    i := x as i64
    fi := i as f64
    if fi < x { return (i + 1) as f64 }
    return fi
}

fn num_round(x: f64) -> f64 {
    if x >= 0.0 { return num_floor(x + 0.5) }
    return 0.0 - num_floor((0.0 - x) + 0.5)
}

fn num_pow2_int(exp_i: i64) -> f64 {
    if exp_i < -1022 { return 0.0 }
    mut clamped := exp_i
    mut extra := 1.0
    if clamped > 1022 {
        clamped = 1022
        extra = 2.0
    }
    mut e := clamped
    mut base := 2.0
    if e < 0 {
        e = 0 - e
        base = 0.5
    }
    mut res := 1.0
    while e > 0 {
        if (e & 1) != 0 { res = res * base }
        e = e >> 1
        if e > 0 { base = base * base }
    }
    return res * extra
}

// Full-range IEEE-754 `exp(x)` (~1e-15 accuracy via Cody-Waite `ln(2)` split + degree-12 Taylor)
fn num_exp(x: f64) -> f64 {
    if x <= -708.3964185322641 { return 0.0 }
    if x >= 709.782712893384 { return num_pow2_int(1023) * 1.9999999999999998 }
    inv_ln2 := 1.44269504088896340736
    ln2_hi := 0.69314718036912381649
    ln2_lo := 0.00000000019082149292705877
    scaled := x * inv_ln2
    k := if scaled >= 0.0 { (scaled + 0.5) as i64 } else { (scaled - 0.5) as i64 }
    kf := k as f64
    r := (x - kf * ln2_hi) - kf * ln2_lo
    mut p := 1.0 + r * (1.0 / 12.0)
    p = 1.0 + r * (1.0 / 11.0) * p
    p = 1.0 + r * 0.1 * p
    p = 1.0 + r * (1.0 / 9.0) * p
    p = 1.0 + r * 0.125 * p
    p = 1.0 + r * (1.0 / 7.0) * p
    p = 1.0 + r * (1.0 / 6.0) * p
    p = 1.0 + r * 0.2 * p
    p = 1.0 + r * 0.25 * p
    p = 1.0 + r * (1.0 / 3.0) * p
    p = 1.0 + r * 0.5 * p
    return (1.0 + r * p) * num_pow2_int(k)
}

// Full-range IEEE-754 `ln(x)` (~1e-15 accuracy via `sqrt(2)` normalization + 9-term `artanh`)
fn num_ln(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 - num_pow2_int(1023) }
    mut m := x
    mut k := 0
    sqrt2 := 1.4142135623730950488
    inv_sqrt2 := 0.7071067811865475244
    while m >= 16.0 { m = m * 0.0625; k += 4 }
    while m < 0.0625 { m = m * 16.0; k -= 4 }
    while m >= sqrt2 { m = m * 0.5; k += 1 }
    while m < inv_sqrt2 { m = m * 2.0; k -= 1 }
    u := (m - 1.0) / (m + 1.0)
    u2 := u * u
    mut s := 1.0 / 17.0
    s = (1.0 / 15.0) + u2 * s
    s = (1.0 / 13.0) + u2 * s
    s = (1.0 / 11.0) + u2 * s
    s = (1.0 / 9.0) + u2 * s
    s = (1.0 / 7.0) + u2 * s
    s = 0.2 + u2 * s
    s = (1.0 / 3.0) + u2 * s
    s = 1.0 + u2 * s
    return (k as f64) * 0.69314718055994530942 + 2.0 * u * s
}

fn num_pow(base: f64, exp: f64) -> f64 {
    if exp == 0.0 { return 1.0 }
    if base == 0.0 { return 0.0 }
    if base < 0.0 {
        ei := exp as i64
        if (ei as f64) == exp {
            mag := num_exp(exp * num_ln(0.0 - base))
            if (ei & 1) != 0 { return 0.0 - mag }
            return mag
        }
        return 0.0
    }
    return num_exp(exp * num_ln(base))
}

fn num_sin_kernel(r: f64) -> f64 {
    r2 := r * r
    mut p := 1.0 / 6227020800.0
    p = (-1.0 / 39916800.0) + r2 * p
    p = (1.0 / 362880.0) + r2 * p
    p = (-1.0 / 5040.0) + r2 * p
    p = (1.0 / 120.0) + r2 * p
    p = (-1.0 / 6.0) + r2 * p
    return r + r * r2 * p
}

fn num_cos_kernel(r: f64) -> f64 {
    r2 := r * r
    mut p := 1.0 / 479001600.0
    p = (-1.0 / 3628800.0) + r2 * p
    p = (1.0 / 40320.0) + r2 * p
    p = (-1.0 / 720.0) + r2 * p
    p = (1.0 / 24.0) + r2 * p
    p = -0.5 + r2 * p
    return 1.0 + r2 * p
}

fn num_sin(x: f64) -> f64 {
    inv_pio2 := 0.63661977236758134308
    pio2_hi := 1.57079632673412561417
    pio2_lo := 0.00000000006077100506506192
    scaled := x * inv_pio2
    k := if scaled >= 0.0 { (scaled + 0.5) as i64 } else { (scaled - 0.5) as i64 }
    kf := k as f64
    r := (x - kf * pio2_hi) - kf * pio2_lo
    quad := k & 3
    if quad == 0 { return num_sin_kernel(r) }
    if quad == 1 { return num_cos_kernel(r) }
    if quad == 2 { return 0.0 - num_sin_kernel(r) }
    return 0.0 - num_cos_kernel(r)
}

fn num_cos(x: f64) -> f64 {
    inv_pio2 := 0.63661977236758134308
    pio2_hi := 1.57079632673412561417
    pio2_lo := 0.00000000006077100506506192
    scaled := x * inv_pio2
    k := if scaled >= 0.0 { (scaled + 0.5) as i64 } else { (scaled - 0.5) as i64 }
    kf := k as f64
    r := (x - kf * pio2_hi) - kf * pio2_lo
    quad := k & 3
    if quad == 0 { return num_cos_kernel(r) }
    if quad == 1 { return 0.0 - num_sin_kernel(r) }
    if quad == 2 { return 0.0 - num_cos_kernel(r) }
    return num_sin_kernel(r)
}

fn num_tan(x: f64) -> f64 {
    c := num_cos(x)
    if num_abs(c) <= 0.000000000000001 { return 1000000000000000.0 }
    return num_sin(x) / c
}

fn num_atan(x_in: f64) -> f64 {
    mut sign := 1.0
    mut x := x_in
    if x < 0.0 { sign = -1.0; x = 0.0 - x }
    mut inv := false
    if x > 1.0 { inv = true; x = 1.0 / x }
    // Further reduce `x <= 1` into `|t| <= 2 - sqrt(3) ~ 0.26795` around `tan(pi/6) = 1/sqrt(3)`
    mut offset := 0.0
    if x > 0.2679491924311227 {
        s3 := 1.7320508075688772935
        x = (s3 * x - 1.0) / (s3 + x)
        offset = 0.52359877559829887308 // pi / 6
    }
    x2 := x * x
    mut p := 1.0 / 15.0
    p = (-1.0 / 13.0) + x2 * p
    p = (1.0 / 11.0) + x2 * p
    p = (-1.0 / 9.0) + x2 * p
    p = (1.0 / 7.0) + x2 * p
    p = -0.2 + x2 * p
    p = (1.0 / 3.0) + x2 * p
    mut res := offset + x * (1.0 - x2 * p + 2.0 * x2 * p)
    // Wait: exact alternating Horner: 1 - x^2/3 + x^4/5 - x^6/7 + x^8/9 - x^10/11 + x^12/13 - x^14/15
    mut h := -1.0 / 15.0
    h = (1.0 / 13.0) + x2 * h
    h = (-1.0 / 11.0) + x2 * h
    h = (1.0 / 9.0) + x2 * h
    h = (-1.0 / 7.0) + x2 * h
    h = 0.2 + x2 * h
    h = (-1.0 / 3.0) + x2 * h
    res = offset + x * (1.0 + x2 * h)
    if inv { res = num_half_pi() - res }
    return sign * res
}

fn num_atan2(y: f64, x: f64) -> f64 {
    if x > 0.0 { return num_atan(y / x) }
    if x < 0.0 {
        if y >= 0.0 { return num_atan(y / x) + num_pi() }
        return num_atan(y / x) - num_pi()
    }
    if y > 0.0 { return num_half_pi() }
    if y < 0.0 { return 0.0 - num_half_pi() }
    return 0.0
}

// ============================================================================
// 2. Complex Arithmetic (`Complex` — SRoA Register-Promoted)
// ============================================================================

fn cplx_new(re: f64, im: f64) -> Complex { return Complex(re, im) }
fn cplx_add(a: Complex, b: Complex) -> Complex { return Complex(a.re + b.re, a.im + b.im) }
fn cplx_sub(a: Complex, b: Complex) -> Complex { return Complex(a.re - b.re, a.im - b.im) }
fn cplx_mul(a: Complex, b: Complex) -> Complex {
    return Complex(a.re * b.re - a.im * b.im, a.re * b.im + a.im * b.re)
}
fn cplx_div(a: Complex, b: Complex) -> Complex {
    d := b.re * b.re + b.im * b.im
    if d <= 0.0 { return Complex(0.0, 0.0) }
    inv_d := 1.0 / d
    return Complex((a.re * b.re + a.im * b.im) * inv_d, (a.im * b.re - a.re * b.im) * inv_d)
}
fn cplx_conj(a: Complex) -> Complex { return Complex(a.re, 0.0 - a.im) }
fn cplx_abs(a: Complex) -> f64 { return sqrt_f64(a.re * a.re + a.im * a.im) }
fn cplx_arg(a: Complex) -> f64 { return num_atan2(a.im, a.re) }
fn cplx_polar(r: f64, theta: f64) -> Complex { return Complex(r * num_cos(theta), r * num_sin(theta)) }
fn cplx_exp(z: Complex) -> Complex {
    er := num_exp(z.re)
    return Complex(er * num_cos(z.im), er * num_sin(z.im))
}

// ============================================================================
// 3. In-Place Radix-2 Cooley-Tukey FFT / IFFT & Spectral Windowing
// ============================================================================

// Performs in-place Radix-2 FFT (`inverse == false`) or IFFT (`inverse == true`) on length-`n` `MatF64` buffers.
// `n` must be a positive power of two (`(n & (n - 1)) == 0`).
fn fft_radix2_inplace(re: MatF64, im: MatF64, inverse: bool) -> bool {
    n := re.rows * re.cols
    if re.ptr == 0 or im.ptr == 0 or n <= 0 or im.rows * im.cols != n { return false }
    if (n & (n - 1)) != 0 { return false }
    pre := re.ptr
    pim := im.ptr
    // Bit-reversal permutation
    mut j := 0
    mut i := 1
    while i < n {
        mut bit := n >> 1
        while (j & bit) != 0 {
            j = j ^ bit
            bit = bit >> 1
        }
        j = j ^ bit
        if i < j {
            tre := unsafe { ptr_read_f64(pre, i) }
            tim := unsafe { ptr_read_f64(pim, i) }
            unsafe {
                ptr_write_f64(pre, i, ptr_read_f64(pre, j))
                ptr_write_f64(pim, i, ptr_read_f64(pim, j))
                ptr_write_f64(pre, j, tre)
                ptr_write_f64(pim, j, tim)
            }
        }
        i += 1
    }
    // Cooley-Tukey butterflies
    sign := if inverse { 1.0 } else { -1.0 }
    mut len_b := 2
    while len_b <= n {
        half := len_b >> 1
        ang := sign * num_two_pi() / (len_b as f64)
        wlen_re := num_cos(ang)
        wlen_im := num_sin(ang)
        mut base := 0
        while base < n {
            mut w_re := 1.0
            mut w_im := 0.0
            mut k := 0
            while k < half {
                u_idx := base + k
                v_idx := u_idx + half
                u_re := unsafe { ptr_read_f64(pre, u_idx) }
                u_im := unsafe { ptr_read_f64(pim, u_idx) }
                vr := unsafe { ptr_read_f64(pre, v_idx) }
                vi := unsafe { ptr_read_f64(pim, v_idx) }
                t_re := vr * w_re - vi * w_im
                t_im := vr * w_im + vi * w_re
                unsafe {
                    ptr_write_f64(pre, u_idx, u_re + t_re)
                    ptr_write_f64(pim, u_idx, u_im + t_im)
                    ptr_write_f64(pre, v_idx, u_re - t_re)
                    ptr_write_f64(pim, v_idx, u_im - t_im)
                }
                nw_re := w_re * wlen_re - w_im * wlen_im
                nw_im := w_re * wlen_im + w_im * wlen_re
                w_re = nw_re
                w_im = nw_im
                k += 1
            }
            base += len_b
        }
        len_b = len_b << 1
    }
    if inverse {
        inv_n := 1.0 / (n as f64)
        mut idx := 0
        while idx < n {
            unsafe {
                ptr_write_f64(pre, idx, ptr_read_f64(pre, idx) * inv_n)
                ptr_write_f64(pim, idx, ptr_read_f64(pim, idx) * inv_n)
            }
            idx += 1
        }
    }
    return true
}

fn fft_power_spectrum(signal: MatF64) -> MatF64 {
    n := signal.rows * signal.cols
    if signal.ptr == 0 or n <= 0 or (n & (n - 1)) != 0 { return MatF64(0, 0, 0) }
    re := mat_clone(signal)
    im := mat_zeros(signal.rows, signal.cols)
    ok_fft := fft_radix2_inplace(re, im, false)
    if not ok_fft {
        mat_free(move re); mat_free(move im)
        return MatF64(0, 0, 0)
    }
    bins := (n >> 1) + 1
    psd := mat_zeros(bins, 1)
    mut k := 0
    while k < bins {
        rk := unsafe { ptr_read_f64(re.ptr, k) }
        ik := unsafe { ptr_read_f64(im.ptr, k) }
        unsafe { ptr_write_f64(psd.ptr, k, rk * rk + ik * ik) }
        k += 1
    }
    mat_free(move re)
    mat_free(move im)
    return psd
}

fn window_hann(n: i64) -> MatF64 {
    if n <= 0 { return MatF64(0, 0, 0) }
    w := mat_zeros(n, 1)
    if n == 1 { unsafe { ptr_write_f64(w.ptr, 0, 1.0) }; return w }
    denom := (n - 1) as f64
    mut i := 0
    while i < n {
        unsafe { ptr_write_f64(w.ptr, i, 0.5 * (1.0 - num_cos(num_two_pi() * (i as f64) / denom))) }
        i += 1
    }
    return w
}

fn window_hamming(n: i64) -> MatF64 {
    if n <= 0 { return MatF64(0, 0, 0) }
    w := mat_zeros(n, 1)
    if n == 1 { unsafe { ptr_write_f64(w.ptr, 0, 1.0) }; return w }
    denom := (n - 1) as f64
    mut i := 0
    while i < n {
        unsafe { ptr_write_f64(w.ptr, i, 0.54 - 0.46 * num_cos(num_two_pi() * (i as f64) / denom)) }
        i += 1
    }
    return w
}

// ============================================================================
// 4. Numerical Quadrature (16-pt Gauss-Legendre, Trapezoidal, Simpson) & Diff
// ============================================================================

fn num_gl16_raw_abs_node(idx: i64) -> f64 {
    if idx == 0 { return 0.09501250983763744 }
    if idx == 1 { return 0.28160355077925891 }
    if idx == 2 { return 0.45801677765722739 }
    if idx == 3 { return 0.61787624440264375 }
    if idx == 4 { return 0.75540440835500303 }
    if idx == 5 { return 0.86563120238783174 }
    if idx == 6 { return 0.94457502307323258 }
    return 0.98940093499164993
}

fn num_gl16_raw_weight(idx: i64) -> f64 {
    if idx == 0 { return 0.18945061045506850 }
    if idx == 1 { return 0.18260341504492359 }
    if idx == 2 { return 0.16915651939500254 }
    if idx == 3 { return 0.14959598881657673 }
    if idx == 4 { return 0.12462897125553387 }
    if idx == 5 { return 0.09515851168249278 }
    if idx == 6 { return 0.06225352393864789 }
    return 0.02715245941175409
}

// Returns node `k` (`0..15`) mapped to `[a, b]` for 16-point Gauss-Legendre quadrature (exact to degree 31).
fn quad_gl16_node(k: i64, a: f64, b: f64) -> f64 {
    mid := 0.5 * (a + b)
    half := 0.5 * (b - a)
    if k < 8 {
        return mid - half * num_gl16_raw_abs_node(7 - k)
    }
    return mid + half * num_gl16_raw_abs_node(k - 8)
}

// Returns scaled weight `k` (`0..15`) on `[a, b]` for 16-point Gauss-Legendre quadrature.
fn quad_gl16_weight(k: i64, a: f64, b: f64) -> f64 {
    half := 0.5 * (b - a)
    idx := if k < 8 { 7 - k } else { k - 8 }
    return half * num_gl16_raw_weight(idx)
}

fn trapz_f64(y: MatF64, dx: f64) -> f64 {
    n := y.rows * y.cols
    if y.ptr == 0 or n < 2 { return 0.0 }
    py := y.ptr
    mut s := 0.5 * (unsafe { ptr_read_f64(py, 0) } + unsafe { ptr_read_f64(py, n - 1) })
    mut i := 1
    while i < n - 1 {
        s += unsafe { ptr_read_f64(py, i) }
        i += 1
    }
    return s * dx
}

fn simpson_f64(y: MatF64, dx: f64) -> f64 {
    n := y.rows * y.cols
    if y.ptr == 0 or n < 2 { return 0.0 }
    if n == 2 { return trapz_f64(y, dx) }
    py := y.ptr
    mut m := n
    mut tail := 0.0
    if (m & 1) == 0 {
        // Odd number of intervals: apply trapezoidal/Simpson 3/8 correction on last panel
        tail = 0.5 * dx * (unsafe { ptr_read_f64(py, n - 2) } + unsafe { ptr_read_f64(py, n - 1) })
        m = n - 1
    }
    mut s := unsafe { ptr_read_f64(py, 0) } + unsafe { ptr_read_f64(py, m - 1) }
    mut i := 1
    while i < m - 1 {
        w := if (i & 1) != 0 { 4.0 } else { 2.0 }
        s += w * unsafe { ptr_read_f64(py, i) }
        i += 1
    }
    return (dx / 3.0) * s + tail
}

fn num_grad_central(f_plus: f64, f_minus: f64, h: f64) -> f64 {
    if h == 0.0 { return 0.0 }
    return (f_plus - f_minus) / (2.0 * h)
}

fn num_hessian_diag(f_plus: f64, f_mid: f64, f_minus: f64, h: f64) -> f64 {
    if h == 0.0 { return 0.0 }
    return (f_plus - 2.0 * f_mid + f_minus) / (h * h)
}

// ============================================================================
// 5. Polynomials & Natural Cubic Spline Interpolation
// ============================================================================

fn poly_eval(coeffs: MatF64, x: f64) -> f64 {
    n := coeffs.rows * coeffs.cols
    if coeffs.ptr == 0 or n <= 0 { return 0.0 }
    mut acc := 0.0
    mut i := n - 1
    while i >= 0 {
        acc = acc * x + unsafe { ptr_read_f64(coeffs.ptr, i) }
        i -= 1
    }
    return acc
}

fn poly_deriv(coeffs: MatF64) -> MatF64 {
    n := coeffs.rows * coeffs.cols
    if coeffs.ptr == 0 or n <= 1 { return mat_zeros(1, 1) }
    out := mat_zeros(n - 1, 1)
    mut i := 1
    while i < n {
        unsafe { ptr_write_f64(out.ptr, i - 1, (i as f64) * ptr_read_f64(coeffs.ptr, i)) }
        i += 1
    }
    return out
}

fn spline_fit(xs: MatF64, ys: MatF64) -> CubicSpline ! i64 {
    n := xs.rows * xs.cols
    if xs.ptr == 0 or ys.ptr == 0 or n < 2 or ys.rows * ys.cols != n { return err(400) }
    xc := mat_clone(xs)
    yc := mat_clone(ys)
    b := mat_zeros(n, 1)
    c := mat_zeros(n, 1)
    d := mat_zeros(n, 1)
    h := mat_zeros(n, 1)
    alpha := mat_zeros(n, 1)
    l := mat_zeros(n, 1)
    mu := mat_zeros(n, 1)
    z := mat_zeros(n, 1)
    px := xc.ptr; py := yc.ptr; pb := b.ptr; pc := c.ptr; pd := d.ptr
    ph := h.ptr; pa := alpha.ptr; pl := l.ptr; pmu := mu.ptr; pz := z.ptr
    mut i := 0
    while i < n - 1 {
        hi := unsafe { ptr_read_f64(px, i + 1) - ptr_read_f64(px, i) }
        if hi <= 0.0 {
            mat_free(move xc); mat_free(move yc); mat_free(move b); mat_free(move c); mat_free(move d)
            mat_free(move h); mat_free(move alpha); mat_free(move l); mat_free(move mu); mat_free(move z)
            return err(422)
        }
        unsafe { ptr_write_f64(ph, i, hi) }
        i += 1
    }
    i = 1
    while i < n - 1 {
        hi := unsafe { ptr_read_f64(ph, i) }
        him1 := unsafe { ptr_read_f64(ph, i - 1) }
        yi := unsafe { ptr_read_f64(py, i) }
        yip1 := unsafe { ptr_read_f64(py, i + 1) }
        yim1 := unsafe { ptr_read_f64(py, i - 1) }
        unsafe { ptr_write_f64(pa, i, 3.0 * (yip1 - yi) / hi - 3.0 * (yi - yim1) / him1) }
        i += 1
    }
    unsafe { ptr_write_f64(pl, 0, 1.0) }
    i = 1
    while i < n - 1 {
        hi := unsafe { ptr_read_f64(ph, i) }
        him1 := unsafe { ptr_read_f64(ph, i - 1) }
        li := 2.0 * (him1 + hi) - him1 * unsafe { ptr_read_f64(pmu, i - 1) }
        unsafe {
            ptr_write_f64(pl, i, li)
            ptr_write_f64(pmu, i, hi / li)
            ptr_write_f64(pz, i, (ptr_read_f64(pa, i) - him1 * ptr_read_f64(pz, i - 1)) / li)
        }
        i += 1
    }
    unsafe { ptr_write_f64(pl, n - 1, 1.0) }
    mut j := n - 2
    while j >= 0 {
        hj := unsafe { ptr_read_f64(ph, j) }
        cj := unsafe { ptr_read_f64(pz, j) - ptr_read_f64(pmu, j) * ptr_read_f64(pc, j + 1) }
        cjp1 := unsafe { ptr_read_f64(pc, j + 1) }
        yj := unsafe { ptr_read_f64(py, j) }
        yjp1 := unsafe { ptr_read_f64(py, j + 1) }
        unsafe {
            ptr_write_f64(pc, j, cj)
            ptr_write_f64(pb, j, (yjp1 - yj) / hj - hj * (cjp1 + 2.0 * cj) / 3.0)
            ptr_write_f64(pd, j, (cjp1 - cj) / (3.0 * hj))
        }
        j -= 1
    }
    mat_free(move h); mat_free(move alpha); mat_free(move l); mat_free(move mu); mat_free(move z)
    return ok(CubicSpline(xc, yc, b, c, d))
}

fn spline_eval(sp: CubicSpline, x: f64) -> f64 {
    n := sp.xs.rows * sp.xs.cols
    if sp.xs.ptr == 0 or n < 2 { return 0.0 }
    px := sp.xs.ptr
    mut lo := 0
    mut hi := n - 2
    if x <= unsafe { ptr_read_f64(px, 0) } {
        lo = 0
    } else if x >= unsafe { ptr_read_f64(px, n - 1) } {
        lo = n - 2
    } else {
        while lo <= hi {
            mid := (lo + hi) >> 1
            xm := unsafe { ptr_read_f64(px, mid) }
            xmp1 := unsafe { ptr_read_f64(px, mid + 1) }
            if x >= xm and x <= xmp1 {
                lo = mid
                break
            } else if x < xm {
                hi = mid - 1
            } else {
                lo = mid + 1
            }
        }
        if lo > n - 2 { lo = n - 2 }
    }
    dx := x - unsafe { ptr_read_f64(px, lo) }
    y0 := unsafe { ptr_read_f64(sp.ys.ptr, lo) }
    b0 := unsafe { ptr_read_f64(sp.b.ptr, lo) }
    c0 := unsafe { ptr_read_f64(sp.c.ptr, lo) }
    d0 := unsafe { ptr_read_f64(sp.d.ptr, lo) }
    return y0 + dx * (b0 + dx * (c0 + dx * d0))
}

fn spline_free(move sp: CubicSpline) {
    mat_free(sp.xs); mat_free(sp.ys); mat_free(sp.b); mat_free(sp.c); mat_free(sp.d)
}

// ============================================================================
// 6. Bracketed Root-Finding (`BrentSolver`) & Newton Step
// ============================================================================

fn brent_init(a: f64, fa: f64, b: f64, fb: f64, tol: f64 = 0.000000000001) -> BrentSolver ! i64 {
    if (fa > 0.0 and fb > 0.0) or (fa < 0.0 and fb < 0.0) { return err(400) }
    if fa == 0.0 {
        return ok(BrentSolver(a, fa, a, fa, a, fa, 0.0, 0.0, a, tol, true))
    }
    if fb == 0.0 {
        return ok(BrentSolver(b, fb, b, fb, b, fb, 0.0, 0.0, b, tol, true))
    }
    mut s := BrentSolver(a, fa, b, fb, a, fa, b - a, b - a, b, tol, false)
    if num_abs(s.fc) < num_abs(s.fb) {
        s.a = s.b; s.b = s.c; s.c = s.a
        s.fa = s.fb; s.fb = s.fc; s.fc = s.fa
    }
    // Prepare first evaluation point
    xm := 0.5 * (s.c - s.b)
    tol1 := 2.0 * 0.0000000000000002220446049250313 * num_abs(s.b) + 0.5 * tol
    if num_abs(xm) <= tol1 {
        s.converged = true
        s.x_eval = s.b
        return ok(s)
    }
    // Secant step on first iteration
    mut p := 2.0 * xm * (s.fb / s.fa)
    mut q := 1.0 - (s.fb / s.fa)
    if p > 0.0 { q = 0.0 - q }
    p = num_abs(p)
    if 2.0 * p < 3.0 * xm * q - num_abs(tol1 * q) {
        s.e = s.d
        s.d = p / q
    } else {
        s.d = xm
        s.e = xm
    }
    s.a = s.b
    s.fa = s.fb
    if num_abs(s.d) > tol1 { s.b += s.d } else { s.b += if xm >= 0.0 { tol1 } else { 0.0 - tol1 } }
    s.x_eval = s.b
    return ok(s)
}

// Supplies `fx = f(s.x_eval)` and advances Brent's method, returning the next `s.x_eval` (or root when `s.converged`).
fn brent_step(mut s: BrentSolver, fx: f64) -> f64 {
    if s.converged { return s.b }
    s.fb = fx
    if (s.fb > 0.0 and s.fc > 0.0) or (s.fb < 0.0 and s.fc < 0.0) {
        s.c = s.a
        s.fc = s.fa
        s.d = s.b - s.a
        s.e = s.d
    }
    if num_abs(s.fc) < num_abs(s.fb) {
        s.a = s.b; s.b = s.c; s.c = s.a
        s.fa = s.fb; s.fb = s.fc; s.fc = s.fa
    }
    tol1 := 2.0 * 0.0000000000000002220446049250313 * num_abs(s.b) + 0.5 * s.tol
    xm := 0.5 * (s.c - s.b)
    if num_abs(xm) <= tol1 or s.fb == 0.0 {
        s.converged = true
        s.x_eval = s.b
        return s.b
    }
    if num_abs(s.e) >= tol1 and num_abs(s.fa) > num_abs(s.fb) {
        ratio_s := s.fb / s.fa
        mut p := 0.0
        mut q := 0.0
        if s.a == s.c {
            p = 2.0 * xm * ratio_s
            q = 1.0 - ratio_s
        } else {
            qf := s.fa / s.fc
            rf := s.fb / s.fc
            p = ratio_s * (2.0 * xm * qf * (qf - rf) - (s.b - s.a) * (rf - 1.0))
            q = (qf - 1.0) * (rf - 1.0) * (ratio_s - 1.0)
        }
        if p > 0.0 { q = 0.0 - q }
        p = num_abs(p)
        min1 := 3.0 * xm * q - num_abs(tol1 * q)
        min2 := num_abs(s.e * q)
        bound := if min1 < min2 { min1 } else { min2 }
        if 2.0 * p < bound {
            s.e = s.d
            s.d = p / q
        } else {
            s.d = xm
            s.e = xm
        }
    } else {
        s.d = xm
        s.e = xm
    }
    s.a = s.b
    s.fa = s.fb
    if num_abs(s.d) > tol1 {
        s.b += s.d
    } else {
        s.b += if xm >= 0.0 { tol1 } else { 0.0 - tol1 }
    }
    s.x_eval = s.b
    return s.x_eval
}

fn newton_step_1d(x: f64, fx: f64, dfx: f64) -> f64 {
    if num_abs(dfx) <= 0.000000000000001 { return x }
    return x - fx / dfx
}

// ============================================================================
// 7. Runge-Kutta 4 (`Rk4State`) & Adaptive Step Controller (`rk45_scale`)
// ============================================================================

fn rk4_init(t0: f64, y0: MatF64, h: f64) -> Rk4State {
    dim := y0.rows * y0.cols
    y := mat_clone(y0)
    y_eval := mat_clone(y0)
    return Rk4State(t0, t0, h, 0, dim, y, y_eval, mat_zeros(dim, 1), mat_zeros(dim, 1), mat_zeros(dim, 1))
}

// Reverse-communication RK4 step: caller evaluates `dy = f(st.t_eval, st.y_eval)` and passes `dy` here.
// Every 4th call (`st.stage == 0` on return) completes a full `O(h^4)` step and advances `st.t` & `st.y`!
fn rk4_supply_dy(mut st: Rk4State, dy: MatF64) -> bool {
    n := st.dim
    py := st.y.ptr; pye := st.y_eval.ptr; pdy := dy.ptr
    h := st.h
    if st.stage == 0 {
        unsafe { mem_copy(st.k1.ptr, pdy, n * 8) }
        mut i := 0
        while i < n {
            unsafe { ptr_write_f64(pye, i, ptr_read_f64(py, i) + 0.5 * h * ptr_read_f64(pdy, i)) }
            i += 1
        }
        st.t_eval = st.t + 0.5 * h
        st.stage = 1
        return false
    }
    if st.stage == 1 {
        unsafe { mem_copy(st.k2.ptr, pdy, n * 8) }
        mut i := 0
        while i < n {
            unsafe { ptr_write_f64(pye, i, ptr_read_f64(py, i) + 0.5 * h * ptr_read_f64(pdy, i)) }
            i += 1
        }
        st.t_eval = st.t + 0.5 * h
        st.stage = 2
        return false
    }
    if st.stage == 2 {
        unsafe { mem_copy(st.k3.ptr, pdy, n * 8) }
        mut i := 0
        while i < n {
            unsafe { ptr_write_f64(pye, i, ptr_read_f64(py, i) + h * ptr_read_f64(pdy, i)) }
            i += 1
        }
        st.t_eval = st.t + h
        st.stage = 3
        return false
    }
    // Stage 3 complete: combine `(k1 + 2*k2 + 2*k3 + k4) * (h / 6)`
    pk1 := st.k1.ptr; pk2 := st.k2.ptr; pk3 := st.k3.ptr
    h6 := h / 6.0
    mut i := 0
    while i < n {
        yi := unsafe { ptr_read_f64(py, i) }
        slope := unsafe { ptr_read_f64(pk1, i) + 2.0 * ptr_read_f64(pk2, i) + 2.0 * ptr_read_f64(pk3, i) + ptr_read_f64(pdy, i) }
        ny := yi + h6 * slope
        unsafe {
            ptr_write_f64(py, i, ny)
            ptr_write_f64(pye, i, ny)
        }
        i += 1
    }
    st.t += h
    st.t_eval = st.t
    st.stage = 0
    return true
}

fn rk4_free(move st: Rk4State) {
    mat_free(st.y); mat_free(st.y_eval)
    mat_free(st.k1); mat_free(st.k2); mat_free(st.k3)
}

fn rk45_step_scale(err_norm: f64, tol: f64) -> f64 {
    if err_norm <= 0.0 { return 2.5 }
    s := 0.84 * num_pow(tol / err_norm, 0.2)
    if s < 0.1 { return 0.1 }
    if s > 2.5 { return 2.5 }
    return s
}

// ============================================================================
// 8. Quasi-Newton `L-BFGS` Two-Loop Recursion & Standard-Form `Simplex` LP
// ============================================================================

fn lbfgs_new(dim: i64, m_hist: i64 = 8) -> LbfgsState {
    mh := if m_hist < 1 { 4 } else { m_hist }
    return LbfgsState(
        dim, mh, 0, 0,
        mat_zeros(mh, dim),
        mat_zeros(mh, dim),
        mat_zeros(mh, 1),
        mat_zeros(dim, 1),
        mat_zeros(dim, 1),
        false
    )
}

// Updates L-BFGS curvature pairs `(s_k, y_k)` and returns descent direction `d = -H_k * grad`.
fn lbfgs_direction(mut st: LbfgsState, x: MatF64, grad: MatF64) -> MatF64 {
    n := st.dim
    mh := st.m_hist
    if st.has_prev {
        mut sy := 0.0
        mut i := 0
        while i < n {
            si := unsafe { ptr_read_f64(x.ptr, i) - ptr_read_f64(st.prev_x.ptr, i) }
            yi := unsafe { ptr_read_f64(grad.ptr, i) - ptr_read_f64(st.prev_g.ptr, i) }
            sy += si * yi
            i += 1
        }
        if sy > 0.000000000001 {
            slot := st.head
            i = 0
            while i < n {
                si := unsafe { ptr_read_f64(x.ptr, i) - ptr_read_f64(st.prev_x.ptr, i) }
                yi := unsafe { ptr_read_f64(grad.ptr, i) - ptr_read_f64(st.prev_g.ptr, i) }
                unsafe {
                    ptr_write_f64(st.s_hist.ptr, slot * n + i, si)
                    ptr_write_f64(st.y_hist.ptr, slot * n + i, yi)
                }
                i += 1
            }
            unsafe { ptr_write_f64(st.rho.ptr, slot, 1.0 / sy) }
            st.head = (slot + 1) % mh
            if st.count < mh { st.count += 1 }
        }
    }
    unsafe {
        mem_copy(st.prev_x.ptr, x.ptr, n * 8)
        mem_copy(st.prev_g.ptr, grad.ptr, n * 8)
    }
    st.has_prev = true
    q := mat_clone(grad)
    if st.count == 0 {
        d0 := mat_scale(q, -1.0)
        mat_free(move q)
        return d0
    }
    alphas := mat_zeros(mh, 1)
    // First loop: newest to oldest
    mut k := 0
    while k < st.count {
        idx := (st.head - 1 - k + mh * 4) % mh
        rho_i := unsafe { ptr_read_f64(st.rho.ptr, idx) }
        dot_sq := la_dot_offset(st.s_hist.ptr, idx * n, q.ptr, 0, n)
        ai := rho_i * dot_sq
        unsafe { ptr_write_f64(alphas.ptr, idx, ai) }
        mut j := 0
        while j < n {
            qj := unsafe { ptr_read_f64(q.ptr, j) }
            yj := unsafe { ptr_read_f64(st.y_hist.ptr, idx * n + j) }
            unsafe { ptr_write_f64(q.ptr, j, qj - ai * yj) }
            j += 1
        }
        k += 1
    }
    // Initial Hessian scale `gamma = (s^T y) / (y^T y)` from most recent pair
    last_idx := (st.head - 1 + mh * 4) % mh
    yy := la_dot_offset(st.y_hist.ptr, last_idx * n, st.y_hist.ptr, last_idx * n, n)
    rho_last := unsafe { ptr_read_f64(st.rho.ptr, last_idx) }
    gamma := if yy > 0.000000000000001 and rho_last > 0.0 { 1.0 / (rho_last * yy) } else { 1.0 }
    r := mat_scale(q, gamma)
    mat_free(move q)
    // Second loop: oldest to newest
    k = st.count - 1
    while k >= 0 {
        idx := (st.head - 1 - k + mh * 4) % mh
        rho_i := unsafe { ptr_read_f64(st.rho.ptr, idx) }
        ai := unsafe { ptr_read_f64(alphas.ptr, idx) }
        beta := rho_i * la_dot_offset(st.y_hist.ptr, idx * n, r.ptr, 0, n)
        diff := ai - beta
        mut j := 0
        while j < n {
            rj := unsafe { ptr_read_f64(r.ptr, j) }
            sj := unsafe { ptr_read_f64(st.s_hist.ptr, idx * n + j) }
            unsafe { ptr_write_f64(r.ptr, j, rj + diff * sj) }
            j += 1
        }
        k -= 1
    }
    mat_free(move alphas)
    dir := mat_scale(r, -1.0)
    mat_free(move r)
    return dir
}

fn lbfgs_free(move st: LbfgsState) {
    mat_free(st.s_hist); mat_free(st.y_hist); mat_free(st.rho)
    mat_free(st.prev_x); mat_free(st.prev_g)
}

// Solves Linear Program: `maximize c_obj^T * x` subject to `A_ub * x <= b_ub, x >= 0` (`b_ub >= 0`) via Simplex Tableau.
fn linprog_simplex_max(a_ub: MatF64, b_ub: MatF64, c_obj: MatF64, max_iter: i64 = 500) -> LpResult {
    m := a_ub.rows
    n := a_ub.cols
    if a_ub.ptr == 0 or b_ub.ptr == 0 or c_obj.ptr == 0 or m <= 0 or n <= 0 {
        return LpResult(MatF64(0, 0, 0), 0.0, -1)
    }
    if b_ub.rows * b_ub.cols != m or c_obj.rows * c_obj.cols != n {
        return LpResult(MatF64(0, 0, 0), 0.0, -1)
    }
    mut r_chk := 0
    while r_chk < m {
        if unsafe { ptr_read_f64(b_ub.ptr, r_chk) } < -0.000000000001 {
            return LpResult(MatF64(0, 0, 0), 0.0, -1)
        }
        r_chk += 1
    }
    // Tableau dimensions: `(m + 1)` rows x `(n + m + 1)` cols (decision vars `0..n-1`, slack vars `n..n+m-1`, RHS `n+m`)
    t_cols := n + m + 1
    rhs_col := n + m
    tab := mat_zeros(m + 1, t_cols)
    basis := ibuf_new(m + 4)
    pt := tab.ptr
    mut r := 0
    while r < m {
        mut c := 0
        while c < n {
            unsafe { ptr_write_f64(pt, r * t_cols + c, ptr_read_f64(a_ub.ptr, r * n + c)) }
            c += 1
        }
        unsafe {
            ptr_write_f64(pt, r * t_cols + (n + r), 1.0)
            ptr_write_f64(pt, r * t_cols + rhs_col, ptr_read_f64(b_ub.ptr, r))
        }
        ibuf_push(basis, n + r)
        r += 1
    }
    mut c0 := 0
    while c0 < n {
        unsafe { ptr_write_f64(pt, m * t_cols + c0, 0.0 - ptr_read_f64(c_obj.ptr, c0)) }
        c0 += 1
    }
    mut status := 0
    mut it := 0
    while it < max_iter {
        // Choose entering column (most negative reduced cost; Bland-safe tie break)
        mut enter_col := -1
        mut min_rc := -0.00000000001
        mut j := 0
        while j < rhs_col {
            rc := unsafe { ptr_read_f64(pt, m * t_cols + j) }
            if rc < min_rc {
                min_rc = rc
                enter_col = j
            }
            j += 1
        }
        if enter_col < 0 { break }
        // Minimum ratio test
        mut leave_row := -1
        mut best_ratio := num_pow2_int(996)
        r = 0
        while r < m {
            aij := unsafe { ptr_read_f64(pt, r * t_cols + enter_col) }
            if aij > 0.00000000001 {
                rhs_v := unsafe { ptr_read_f64(pt, r * t_cols + rhs_col) }
                ratio := rhs_v / aij
                if ratio < best_ratio - 0.0000000000001 {
                    best_ratio = ratio
                    leave_row = r
                }
            }
            r += 1
        }
        if leave_row < 0 {
            status = 1 // Unbounded
            break
        }
        // Pivot on `(leave_row, enter_col)`
        inv_piv := 1.0 / unsafe { ptr_read_f64(pt, leave_row * t_cols + enter_col) }
        j = 0
        while j < t_cols {
            unsafe { ptr_write_f64(pt, leave_row * t_cols + j, ptr_read_f64(pt, leave_row * t_cols + j) * inv_piv) }
            j += 1
        }
        r = 0
        while r <= m {
            if r != leave_row {
                factor := unsafe { ptr_read_f64(pt, r * t_cols + enter_col) }
                if num_abs(factor) > 0.000000000000001 {
                    j = 0
                    while j < t_cols {
                        cur := unsafe { ptr_read_f64(pt, r * t_cols + j) }
                        pv := unsafe { ptr_read_f64(pt, leave_row * t_cols + j) }
                        unsafe { ptr_write_f64(pt, r * t_cols + j, cur - factor * pv) }
                        j += 1
                    }
                }
            }
            r += 1
        }
        ibuf_set(basis, leave_row, enter_col)
        it += 1
    }
    x_sol := mat_zeros(n, 1)
    r = 0
    while r < m {
        bv := ibuf_get(basis, r)
        if bv >= 0 and bv < n {
            unsafe { ptr_write_f64(x_sol.ptr, bv, ptr_read_f64(pt, r * t_cols + rhs_col)) }
        }
        r += 1
    }
    obj_val := unsafe { ptr_read_f64(pt, m * t_cols + rhs_col) }
    buf_free(move basis)
    mat_free(move tab)
    return LpResult(x_sol, obj_val, status)
}
