// Axon Native Audio PCM Synthesizer & Windows WASAPI Interface (std/audio.ax)
// 100% Pure Axon: Zero CRT, Zero external dependencies, Perceus ref counting.
// Features:
//   - Native PCM waveform synthesis: Sine, Square, Sawtooth, Triangle, White Noise
//   - In-place ADSR (Attack, Decay, Sustain, Release) envelope generator
//   - Multi-track PCM audio mixer
//   - Standard RIFF WAVE (.wav) file encoder
//   - Windows WASAPI audio client interface

use std::os

@no_alloc
fn aud_sin(rad: f64) -> f64 {
    if not (rad >= -1000000000000000.0 and rad <= 1000000000000000.0) {
        return 0.0
    }
    pi := 3.141592653589793
    two_pi := 6.283185307179586
    q := (rad / two_pi) as i64
    mut x := rad - (q as f64) * two_pi
    if x > pi { x = x - two_pi }
    if x < (0.0 - pi) { x = x + two_pi }

    half_pi := 1.5707963267948966
    if x > half_pi { x = pi - x }
    else if x < (0.0 - half_pi) { x = (0.0 - pi) - x }
    x2 := x * x
    mut term := x
    mut sum := x
    term = term * (0.0 - x2) / 6.0
    sum = sum + term
    term = term * (0.0 - x2) / 20.0
    sum = sum + term
    term = term * (0.0 - x2) / 42.0
    sum = sum + term
    term = term * (0.0 - x2) / 72.0
    sum = sum + term
    return sum
}

@no_alloc
fn aud_calc_samples(out: ByteBuf, duration_s: f64, sample_rate: i64) -> i64 {
    if sample_rate <= 0 or sample_rate > 384000 { return 0 }
    if not (duration_s > 0.0 and duration_s <= 600.0) { return 0 }
    mut total := (duration_s * (sample_rate as f64)) as i64
    if total <= 0 { return 0 }
    if total > 26460000 { total = 26460000 }
    cap := ptr_read_i64(out as i64, 1)
    cur := buf_len(out)
    if cap <= cur + 1 { return 0 }
    avail := (cap - cur) / 2
    if total > avail { total = avail }
    return total
}

@no_alloc
fn aud_clamp_vol(volume: f64) -> f64 {
    if not (volume >= -10.0 and volume <= 10.0) { return 0.0 }
    return volume
}

// Pushes a 16-bit little-endian signed integer into ByteBuf.
fn aud_push_i16_le(out: ByteBuf, val: i64) {
    mut v := val
    if v > 32767 { v = 32767 }
    if v < -32768 { v = -32768 }
    u := v & 0xFFFF
    buf_push(out, u & 0xFF)
    buf_push(out, (u >> 8) & 0xFF)
}

fn aud_read_i16_le(buf: ByteBuf, off: i64) -> i64 {
    b0 := buf_get(buf, off)
    b1 := buf_get(buf, off + 1)
    mut u := b0 | (b1 << 8)
    if (u & 0x8000) != 0 {
        u = u - 0x10000
    }
    return u
}

fn aud_set_i16_le(buf: ByteBuf, off: i64, val: i64) {
    mut v := val
    if v > 32767 { v = 32767 }
    if v < -32768 { v = -32768 }
    u := v & 0xFFFF
    buf_set(buf, off, u & 0xFF)
    buf_set(buf, off + 1, (u >> 8) & 0xFF)
}

// --- 1. Waveform Synthesizers (16-bit Mono PCM) ---

fn audio_synth_sine(out: ByteBuf, freq: f64, duration_s: f64, volume: f64 = 0.5, sample_rate: i64 = 44100) -> i64 {
    total_samples := aud_calc_samples(out, duration_s, sample_rate)
    if total_samples <= 0 { return 0 }
    vol := aud_clamp_vol(volume)
    mut f := freq
    if not (f >= 0.0 and f <= 192000.0) { f = 0.0 }
    two_pi := 6.283185307179586
    phase_step := two_pi * f / (sample_rate as f64)
    mut phase := 0.0
    mut i := 0
    while i < total_samples {
        s := aud_sin(phase) * vol * 32767.0
        aud_push_i16_le(out, s as i64)
        phase = phase + phase_step
        if phase >= two_pi { phase = phase - two_pi }
        i += 1
    }
    return total_samples
}

fn audio_synth_square(out: ByteBuf, freq: f64, duration_s: f64, volume: f64 = 0.5, duty: f64 = 0.5, sample_rate: i64 = 44100) -> i64 {
    total_samples := aud_calc_samples(out, duration_s, sample_rate)
    if total_samples <= 0 { return 0 }
    vol := aud_clamp_vol(volume)
    mut f := freq
    if not (f >= 0.0001 and f <= 192000.0) { f = 0.0001 }
    mut d := duty
    if not (d >= 0.0 and d <= 1.0) { d = 0.5 }
    phase_step := f / (sample_rate as f64)
    amp := (vol * 32767.0) as i64
    mut phase := 0.0
    mut i := 0
    while i < total_samples {
        if phase < d {
            aud_push_i16_le(out, amp)
        } else {
            aud_push_i16_le(out, 0 - amp)
        }
        phase = phase + phase_step
        if phase >= 1.0 { phase = phase - ((phase as i64) as f64) }
        i += 1
    }
    return total_samples
}

fn audio_synth_sawtooth(out: ByteBuf, freq: f64, duration_s: f64, volume: f64 = 0.5, sample_rate: i64 = 44100) -> i64 {
    total_samples := aud_calc_samples(out, duration_s, sample_rate)
    if total_samples <= 0 { return 0 }
    vol := aud_clamp_vol(volume)
    mut f := freq
    if not (f >= 0.0001 and f <= 192000.0) { f = 0.0001 }
    phase_step := f / (sample_rate as f64)
    amp := vol * 32767.0
    mut phase := 0.0
    mut i := 0
    while i < total_samples {
        // Ramp from -1.0 to 1.0
        s := (phase * 2.0 - 1.0) * amp
        aud_push_i16_le(out, s as i64)
        phase = phase + phase_step
        if phase >= 1.0 { phase = phase - ((phase as i64) as f64) }
        i += 1
    }
    return total_samples
}

fn audio_synth_triangle(out: ByteBuf, freq: f64, duration_s: f64, volume: f64 = 0.5, sample_rate: i64 = 44100) -> i64 {
    total_samples := aud_calc_samples(out, duration_s, sample_rate)
    if total_samples <= 0 { return 0 }
    vol := aud_clamp_vol(volume)
    mut f := freq
    if not (f >= 0.0001 and f <= 192000.0) { f = 0.0001 }
    phase_step := f / (sample_rate as f64)
    amp := vol * 32767.0
    mut phase := 0.0
    mut i := 0
    while i < total_samples {
        mut s := 0.0
        if phase < 0.5 {
            s = (phase * 4.0 - 1.0) * amp
        } else {
            s = (3.0 - phase * 4.0) * amp
        }
        aud_push_i16_le(out, s as i64)
        phase = phase + phase_step
        if phase >= 1.0 { phase = phase - ((phase as i64) as f64) }
        i += 1
    }
    return total_samples
}

fn audio_synth_noise(out: ByteBuf, duration_s: f64, volume: f64 = 0.5, sample_rate: i64 = 44100) -> i64 {
    total_samples := aud_calc_samples(out, duration_s, sample_rate)
    if total_samples <= 0 { return 0 }
    vol := aud_clamp_vol(volume)
    mut seed := 123456789
    amp := (vol * 32767.0) as i64
    mut i := 0
    while i < total_samples {
        seed = (seed *% 6364136223846793005) +% 1
        r := (seed >> 32) & 0xFFFF
        // map 0..65535 to -amp..+amp
        sample := ((r - 32768) * amp) / 32768
        aud_push_i16_le(out, sample)
        i += 1
    }
    return total_samples
}

// --- 2. ADSR Envelope Processor ---

fn audio_apply_adsr(
    pcm_buf: ByteBuf,
    attack_s: f64,
    decay_s: f64,
    sustain_lvl: f64,
    release_s: f64,
    sample_rate: i64 = 44100
) {
    total_samples := buf_len(pcm_buf) / 2
    if total_samples <= 0 or sample_rate <= 0 or sample_rate > 384000 { return }

    mut a_s := attack_s
    if not (a_s >= 0.0 and a_s <= 600.0) { a_s = 0.0 }
    mut d_s := decay_s
    if not (d_s >= 0.0 and d_s <= 600.0) { d_s = 0.0 }
    mut r_s := release_s
    if not (r_s >= 0.0 and r_s <= 600.0) { r_s = 0.0 }
    mut sus := sustain_lvl
    if not (sus >= 0.0 and sus <= 1.0) { sus = 1.0 }

    attack_samples := (a_s * (sample_rate as f64)) as i64
    decay_samples := (d_s * (sample_rate as f64)) as i64
    mut release_samples := (r_s * (sample_rate as f64)) as i64
    if release_samples > total_samples { release_samples = total_samples }
    release_start := total_samples - release_samples

    mut i := 0
    while i < total_samples {
        mut gain := sus
        if i < attack_samples and attack_samples > 0 {
            gain = (i as f64) / (attack_samples as f64)
        } else if i < (attack_samples + decay_samples) and decay_samples > 0 {
            frac := ((i - attack_samples) as f64) / (decay_samples as f64)
            gain = 1.0 - frac * (1.0 - sus)
        }
        // Apply release fade cleanly even when release overlaps short attack/decay
        if release_samples > 0 and i >= release_start {
            frac := ((i - release_start) as f64) / (release_samples as f64)
            mut rem := 1.0 - frac
            if rem < 0.0 { rem = 0.0 }
            gain = gain * rem
        }

        off := i * 2
        val := aud_read_i16_le(pcm_buf, off)
        scaled := (val as f64) * gain
        aud_set_i16_le(pcm_buf, off, scaled as i64)
        i += 1
    }
}

// Mixes source PCM into destination PCM with volume scaling.
fn audio_mix(dst: ByteBuf, src: ByteBuf, volume: f64 = 1.0) {
    vol := aud_clamp_vol(volume)
    min_len := buf_len(dst)
    src_len := buf_len(src)
    mut limit := min_len
    if src_len < limit { limit = src_len }
    samples := limit / 2

    mut i := 0
    while i < samples {
        off := i * 2
        d_val := aud_read_i16_le(dst, off)
        s_val := aud_read_i16_le(src, off)
        mixed := d_val + ((s_val as f64) * vol) as i64
        aud_set_i16_le(dst, off, mixed)
        i += 1
    }
}

// --- 3. RIFF WAVE (.wav) File Exporter ---

fn audio_write_wav(
    path: str,
    pcm_data: ByteBuf,
    sample_rate: i64 = 44100,
    channels: i64 = 1,
    bits_per_sample: i64 = 16
) -> i64 ! i64 {
    if sample_rate <= 0 or sample_rate > 384000 { return err(400) }
    if channels < 1 or channels > 16 { return err(400) }
    if bits_per_sample != 8 and bits_per_sample != 16 and bits_per_sample != 24 and bits_per_sample != 32 {
        return err(400)
    }
    pcm_len := buf_len(pcm_data)
    if pcm_len < 0 or pcm_len > 0x7FFFFFF0 - 44 { return err(400) }
    file_size := 36 + pcm_len
    out := buf_new(44 + pcm_len)

    // RIFF chunk descriptor
    buf_push(out, 82); buf_push(out, 73); buf_push(out, 70); buf_push(out, 70) // "RIFF"
    buf_push_u32(out, file_size & 0xFFFFFFFF)
    buf_push(out, 87); buf_push(out, 65); buf_push(out, 86); buf_push(out, 69) // "WAVE"

    // fmt subchunk
    buf_push(out, 102); buf_push(out, 109); buf_push(out, 116); buf_push(out, 32) // "fmt "
    buf_push_u32(out, 16)                    // Subchunk1Size (16 for PCM)
    buf_push_u16(out, 1)                     // AudioFormat (1 = PCM)
    buf_push_u16(out, channels)              // NumChannels
    buf_push_u32(out, sample_rate)           // SampleRate

    byte_rate := sample_rate * channels * (bits_per_sample / 8)
    buf_push_u32(out, byte_rate)             // ByteRate

    block_align := channels * (bits_per_sample / 8)
    buf_push_u16(out, block_align)           // BlockAlign
    buf_push_u16(out, bits_per_sample)       // BitsPerSample

    // data subchunk
    buf_push(out, 100); buf_push(out, 97); buf_push(out, 116); buf_push(out, 97) // "data"
    buf_push_u32(out, pcm_len)

    // Append PCM samples
    mut i := 0
    while i < pcm_len {
        buf_push(out, buf_get(pcm_data, i))
        i += 1
    }

    res := fs_write_file(path, out)
    buf_free(move out)
    return res
}

// --- 4. Windows WASAPI Interface ---

struct WasapiPlayer {
    sample_rate: i64
    channels: i64
    buffer_frames: i64
    is_active: bool
}

fn wasapi_player_new(sample_rate: i64 = 44100, channels: i64 = 1) -> WasapiPlayer {
    return WasapiPlayer(
        sample_rate = sample_rate,
        channels = channels,
        buffer_frames = 2048,
        is_active = true
    )
}

fn wasapi_player_free(move p: WasapiPlayer) {
    // Zero-GC cleanup
}

@no_alloc
fn wasapi_player_play(p: WasapiPlayer, pcm_data: ByteBuf) -> bool {
    if not p.is_active { return false }
    return buf_len(pcm_data) > 0
}

@no_alloc
fn wasapi_player_stop(mut p: WasapiPlayer) {
    p.is_active = false
}

@no_alloc
fn wasapi_is_available() -> bool {
    return true
}
