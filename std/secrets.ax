// Axon Standard Library — Cryptographically Secure Randomness (`std/secrets.ax`)
// 100% Pure Axon replacement for Python's `secrets` and `os.urandom`:
//   - Windows: CNG `bcrypt.dll` -> `BCryptGenRandom(NULL, buf, n, BCRYPT_USE_SYSTEM_PREFERRED_RNG)`
//   - Linux:   `libc.so.6` -> `getrandom(buf, n, 0)`
//   - macOS:   `libSystem.B.dylib` -> `arc4random_buf(buf, n)`
// Fail-closed (CWE-338): NEVER falls back to timestamps or non-crypto PRNGs.

use std::ffi
use std::str
use std::crypto
use std::encoding

fn _secrets_fill_raw(ptr: i64, nbytes: i64) -> bool {
    if ptr == 0 or nbytes <= 0 or nbytes > 1048576 { return false }
    // 1. Windows CNG BCryptGenRandom
    bc := ffi_open_one("bcrypt.dll")
    if bc != 0 {
        f_gen := ffi_sym(bc, "BCryptGenRandom")
        if f_gen != 0 {
            // BCRYPT_USE_SYSTEM_PREFERRED_RNG = 0x00000002; NTSTATUS 0 == STATUS_SUCCESS
            st := ffi_sext32(ffi_call4(f_gen, 0, ptr, nbytes, 2))
            return st == 0
        }
    }
    // 2. Linux libc getrandom / macOS arc4random_buf
    lc := ffi_open("", "libc.so.6", "libSystem.B.dylib")
    if lc != 0 {
        f_arc := ffi_sym(lc, "arc4random_buf")
        if f_arc != 0 {
            _ := ffi_call2(f_arc, ptr, nbytes)
            return true
        }
        f_gr := ffi_sym(lc, "getrandom")
        if f_gr != 0 {
            mut got := 0
            while got < nbytes {
                rc := ffi_call3(f_gr, ptr + got, nbytes - got, 0)
                if rc <= 0 { return false }
                got += rc
            }
            return true
        }
    }
    return false
}

// Equivalent to Python `os.urandom(nbytes)` / `secrets.token_bytes(nbytes)`
fn secrets_urandom(nbytes: i64) -> ByteBuf ! i64 {
    if nbytes < 0 or nbytes > 1048576 { return err(400) }
    if nbytes == 0 { return ok(buf_new(0)) }
    raw := ffi_alloc(nbytes)
    if raw == 0 { return err(500) }
    if not _secrets_fill_raw(raw, nbytes) {
        ffi_free(raw)
        return err(503)
    }
    out := ffi_read_bytes(raw, nbytes)
    unsafe { mem_set(raw, 0, nbytes) } // zeroize raw buffer before freeing
    ffi_free(raw)
    return ok(out)
}

// Cryptographically secure 64-bit random integer
fn secrets_rand_u64() -> i64 ! i64 {
    raw := ffi_alloc(8)
    if raw == 0 { return err(500) }
    if not _secrets_fill_raw(raw, 8) {
        ffi_free(raw)
        return err(503)
    }
    v := ffi_read_i64(raw, 0)
    unsafe { mem_set(raw, 0, 8) }
    ffi_free(raw)
    return ok(v)
}

// Unbiased cryptographically secure integer in `[0, upper_bound)` (Python `secrets.randbelow`)
fn secrets_randbelow(upper_bound: i64) -> i64 ! i64 {
    if upper_bound <= 0 { return err(400) }
    if upper_bound == 1 { return ok(0) }
    // Rejection sample in positive 63-bit space [0, 2^63 - 1]
    max63 := 9223372036854775807
    limit := max63 - (max63 % upper_bound)
    mut tries := 0
    while tries < 128 {
        r := secrets_rand_u64() or return
        u := r & 0x7FFFFFFFFFFFFFFF
        if u < limit {
            return ok(u % upper_bound)
        }
        tries += 1
    }
    return err(503)
}

// Equivalent to Python `secrets.token_hex(nbytes)` -> `2 * nbytes` lowercase hex chars
fn secrets_token_hex(nbytes: i64 = 32) -> str ! i64 {
    if nbytes <= 0 or nbytes > 65536 { return err(400) }
    raw := secrets_urandom(nbytes) or return
    out := buf_new(nbytes * 2 + 4)
    mut i := 0
    while i < nbytes {
        b := buf_get(raw, i)
        hi := (b >> 4) & 15
        lo := b & 15
        buf_push(out, if hi < 10 { 48 + hi } else { 87 + hi })
        buf_push(out, if lo < 10 { 48 + lo } else { 87 + lo })
        i += 1
    }
    buf_free(move raw)
    return ok(buf_to_owned_str(move out))
}

// Equivalent to Python `secrets.token_urlsafe(nbytes)` (RFC-4648 Base64URL, no padding)
fn secrets_token_urlsafe(nbytes: i64 = 32) -> str ! i64 {
    if nbytes <= 0 or nbytes > 65536 { return err(400) }
    raw := secrets_urandom(nbytes) or return
    s := buf_to_owned_str(move raw)
    return ok(base64url_encode(s))
}

// Constant-time string comparison (Python `secrets.compare_digest` / `hmac.compare_digest`)
fn secrets_compare_digest(a: str, b: str) -> bool {
    return ct_eq_str(a, b)
}
