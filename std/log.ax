// Axon v1.0.0 CWE-117 Anti-Injection Structured Logger (`std/log.ax`)
// Neutralizes CRLF log forging, NUL truncation, and ANSI ESC (0x1B) terminal hijacking.
// Works natively (`win-x64`, `linux-x64`, `macos-arm64`) and on `--target wasm32`.

use std::os
use std::str

fn log_sanitize(s: str) -> str {
    n := str_len(s)
    mut needs := false
    mut i := 0
    while i < n {
        c := str_byte(s, i)
        if c < 32 or c == 127 {
            needs = true
            break
        }
        i += 1
    }
    if not needs { return s }
    out := buf_new(n * 2 + 8)
    i = 0
    while i < n {
        c := str_byte(s, i)
        if c == 10 { buf_push_str(out, "\\n") }
        else if c == 13 { buf_push_str(out, "\\r") }
        else if c == 9 { buf_push_str(out, "\\t") }
        else if c < 32 or c == 127 { buf_push(out, 63) } // '?' for control / ESC / DEL
        else { buf_push(out, c) }
        i += 1
    }
    return buf_to_owned_str(move out)
}

fn log_format(level: str, tag: str, msg: str) -> str {
    sl := log_sanitize(level)
    st := log_sanitize(tag)
    sm := log_sanitize(msg)
    out := buf_new(str_len(sl) + str_len(st) + str_len(sm) + 16)
    buf_push(out, 91) // '['
    buf_push_str(out, sl)
    buf_push_str(out, "] [")
    buf_push_str(out, st)
    buf_push_str(out, "] ")
    buf_push_str(out, sm)
    return buf_to_owned_str(move out)
}

fn log_kv(level: str, tag: str, key: str, val: str) -> str {
    sl := log_sanitize(level)
    st := log_sanitize(tag)
    sk := log_sanitize(key)
    sv := log_sanitize(val)
    out := buf_new(str_len(sl) + str_len(st) + str_len(sk) + str_len(sv) + 20)
    buf_push(out, 91)
    buf_push_str(out, sl)
    buf_push_str(out, "] [")
    buf_push_str(out, st)
    buf_push_str(out, "] ")
    buf_push_str(out, sk)
    buf_push(out, 61) // '='
    buf_push_str(out, sv)
    return buf_to_owned_str(move out)
}

fn log_info(tag: str, msg: str) {
    println(log_format("INFO", tag, msg))
}

fn log_warn(tag: str, msg: str) {
    println(log_format("WARN", tag, msg))
}

fn log_error(tag: str, msg: str) {
    println(log_format("ERROR", tag, msg))
}
