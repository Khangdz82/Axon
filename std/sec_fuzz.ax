// Axon Deep Security Testing Library — Bug Hunter v2.0 Engine (`std/sec_fuzz.ax`)
// 100% Pure Axon, Zero-GC, Perceus-Safe Pull-Iterator Engine, `--shield` Safe.
// Technological Breakthroughs:
//   1. REDQUEEN / CmpLog Input-to-State (I2S) Solver (`fuzz_cmplog_i64`, `fuzz_cmplog_str`) + Auto-Dictionary:
//      cracks 64-bit magic numbers & exact protocol tokens in O(1) iterations instead of 2^64!
//   2. MOpt Adaptive Multi-Armed Bandit Mutator Scheduler + O(1) Hash-Set Corpus Dedup (`DynMap`):
//      dynamically shifts mutation budget toward highest-yield mutators on the current target.
//   3. AFLFast-style 64 KB hit-bucketed coverage bitmap + sparse O(touched) per-iter reset + 14 mutators + splice.
//   4. Structure-Aware Adversarial Grammar Synthesizers (`gram_url`, `gram_http_req`, `gram_json`, `gram_binary_frame`).
//   5. Stateful Operation-Sequence Fuzzer (`SecSeqFuzzer`) + Zeller `ddmin` Sequence Minimizer (`ShrinkSeq`).
//   6. Deterministic Property Generators (`SecGen`), Zeller `ddmin` String Minimizer (`ShrinkStr`), & `ShrinkI64`.

use std::os
use std::str
use std::ds
use std::rand
use std::sec_corpus

// --- 0. Internal Bit/Byte Helpers (Wrapping-Safe for `--shield`) ---

fn _fz_u64_mod(r: Rng, bound: i64) -> i64 {
    if bound <= 1 { return 0 }
    u := rng_next_u64(r) & 0x7FFFFFFFFFFFFFFF
    return u % bound
}

fn _fz_bucket_bit(hits: i64) -> i64 {
    if hits <= 0 { return 0 }
    if hits == 1 { return 1 }
    if hits == 2 { return 2 }
    if hits == 3 { return 4 }
    if hits <= 7 { return 8 }
    if hits <= 15 { return 16 }
    if hits <= 31 { return 32 }
    if hits <= 127 { return 64 }
    return 128
}

fn _fz_interesting_u8(idx: i64) -> i64 {
    k := idx % 9
    if k == 0 { return 0 }
    if k == 1 { return 1 }
    if k == 2 { return 16 }
    if k == 3 { return 32 }
    if k == 4 { return 64 }
    if k == 5 { return 100 }
    if k == 6 { return 127 }
    if k == 7 { return 128 }
    return 255
}

fn _fz_interesting_u16(idx: i64) -> i64 {
    k := idx % 8
    if k == 0 { return 0 }
    if k == 1 { return 128 }
    if k == 2 { return 255 }
    if k == 3 { return 256 }
    if k == 4 { return 512 }
    if k == 5 { return 32767 }
    if k == 6 { return 32768 }
    return 65535
}

fn _fz_interesting_u32(idx: i64) -> i64 {
    k := idx % 7
    if k == 0 { return 0 }
    if k == 1 { return 65535 }
    if k == 2 { return 65536 }
    if k == 3 { return 100663045 }
    if k == 4 { return 2147483647 }
    if k == 5 { return 2147483648 }
    return 4294967295
}

fn _fz_str_to_buf(s: str, extra_cap: i64 = 64) -> ByteBuf {
    n := str_len(s)
    mut c := n + extra_cap
    if c < 64 { c = 64 }
    b := buf_new(c)
    if n > 0 { buf_push_str(b, s) }
    return b
}

fn _fz_copy_buf(src: ByteBuf, extra_cap: i64 = 64) -> ByteBuf {
    n := buf_len(src)
    mut c := n + extra_cap
    if c < 64 { c = 64 }
    out := buf_new(c)
    if n > 0 {
        buf_push_str(out, buf_slice_str(src, 0, n))
    }
    return out
}

fn _fz_encode_int_bytes(val: i64, width: i64, big_endian: bool) -> str {
    b := buf_new(16)
    mut i := 0
    while i < width {
        sh := if big_endian { (width - 1 - i) * 8 } else { i * 8 }
        buf_push(b, ushr64(val, sh) & 255)
        i += 1
    }
    return buf_to_owned_str(move b)
}

// --- 1. AFL++ / libFuzzer 14-Mutator Engine + MOpt Adaptive Bandit + Splice ---

fn _fz_pick_adaptive_op(r: Rng, op_tries: IntBuf, op_wins: IntBuf) -> i64 {
    // 20% uniform exploration, 80% Thompson/yield-weighted exploitation across 14 mutators
    if _fz_u64_mod(r, 5) == 0 {
        return _fz_u64_mod(r, 14)
    }
    mut total_w := 0
    mut i := 0
    while i < 14 {
        tr := ibuf_get(op_tries, i)
        wn := ibuf_get(op_wins, i)
        w := 5 + ((wn * 100) / (if tr > 0 { tr } else { 1 }))
        total_w += w
        i += 1
    }
    if total_w <= 0 { return _fz_u64_mod(r, 14) }
    mut roll := _fz_u64_mod(r, total_w)
    i = 0
    while i < 14 {
        tr := ibuf_get(op_tries, i)
        wn := ibuf_get(op_wins, i)
        w := 5 + ((wn * 100) / (if tr > 0 { tr } else { 1 }))
        if roll < w { return i }
        roll -= w
        i += 1
    }
    return 0
}

fn _fz_apply_single_mutator(r: Rng, move cur_in: ByteBuf, op: i64, dict: StrVec, limit: i64) -> ByteBuf {
    mut cur := cur_in
    n := buf_len(cur)
    if op == 0 and n > 0 {
        // 1-bit flip
        pos := _fz_u64_mod(r, n)
        bit := 1 << _fz_u64_mod(r, 8)
        buf_set(cur, pos, buf_get(cur, pos) ^ bit)
    } else if op == 1 and n > 0 {
        // 2-bit or 4-bit flip
        pos := _fz_u64_mod(r, n)
        mask := if _fz_u64_mod(r, 2) == 0 { 3 << _fz_u64_mod(r, 7) } else { 15 << _fz_u64_mod(r, 5) }
        buf_set(cur, pos, (buf_get(cur, pos) ^ mask) & 255)
    } else if op == 2 and n > 0 {
        // Byte flip (1, 2, or 4 bytes)
        w := 1 << _fz_u64_mod(r, 3)
        pos := _fz_u64_mod(r, n)
        mut j := 0
        while j < w and pos + j < n {
            buf_set(cur, pos + j, buf_get(cur, pos + j) ^ 255)
            j += 1
        }
    } else if op == 3 and n > 0 {
        // u8 arithmetic +-1..35
        pos := _fz_u64_mod(r, n)
        delta := 1 + _fz_u64_mod(r, 35)
        v := buf_get(cur, pos)
        nv := if _fz_u64_mod(r, 2) == 0 { (v + delta) & 255 } else { (v - delta + 256) & 255 }
        buf_set(cur, pos, nv)
    } else if op == 4 and n >= 2 {
        // u16 arithmetic (LE or BE)
        pos := _fz_u64_mod(r, n - 1)
        delta := 1 + _fz_u64_mod(r, 35)
        be := _fz_u64_mod(r, 2) == 1
        mut v := if be { (buf_get(cur, pos) << 8) | buf_get(cur, pos + 1) } else { buf_get(cur, pos) | (buf_get(cur, pos + 1) << 8) }
        v = if _fz_u64_mod(r, 2) == 0 { (v + delta) & 65535 } else { (v - delta + 65536) & 65535 }
        if be {
            buf_set(cur, pos, (v >> 8) & 255)
            buf_set(cur, pos + 1, v & 255)
        } else {
            buf_set(cur, pos, v & 255)
            buf_set(cur, pos + 1, (v >> 8) & 255)
        }
    } else if op == 5 and n >= 4 {
        // u32 interesting value overwrite (LE or BE)
        pos := _fz_u64_mod(r, n - 3)
        iv := _fz_interesting_u32(_fz_u64_mod(r, 7))
        if _fz_u64_mod(r, 2) == 0 {
            buf_set(cur, pos, iv & 255)
            buf_set(cur, pos + 1, (iv >> 8) & 255)
            buf_set(cur, pos + 2, (iv >> 16) & 255)
            buf_set(cur, pos + 3, (iv >> 24) & 255)
        } else {
            buf_set(cur, pos, (iv >> 24) & 255)
            buf_set(cur, pos + 1, (iv >> 16) & 255)
            buf_set(cur, pos + 2, (iv >> 8) & 255)
            buf_set(cur, pos + 3, iv & 255)
        }
    } else if op == 6 and n > 0 {
        // Interesting u8 or u16 overwrite
        pos := _fz_u64_mod(r, n)
        if n >= 2 and pos + 1 < n and _fz_u64_mod(r, 2) == 1 {
            iv16 := _fz_interesting_u16(_fz_u64_mod(r, 8))
            buf_set(cur, pos, iv16 & 255)
            buf_set(cur, pos + 1, (iv16 >> 8) & 255)
        } else {
            buf_set(cur, pos, _fz_interesting_u8(_fz_u64_mod(r, 9)))
        }
    } else if op == 7 and n > 0 {
        // Random single byte overwrite (half printable ASCII, half full 0..255)
        pos := _fz_u64_mod(r, n)
        bv := if _fz_u64_mod(r, 2) == 0 { 32 + _fz_u64_mod(r, 95) } else { _fz_u64_mod(r, 256) }
        buf_set(cur, pos, bv)
    } else if op == 8 and n > 1 {
        // Block delete (removes 1..min(32, n-1) bytes)
        mut del_len := 1 + _fz_u64_mod(r, if n < 32 { n - 1 } else { 32 })
        if del_len >= n { del_len = n - 1 }
        pos := _fz_u64_mod(r, n - del_len + 1)
        nb := buf_new(limit + 64)
        if pos > 0 { buf_push_str(nb, buf_slice_str(cur, 0, pos)) }
        if pos + del_len < n { buf_push_str(nb, buf_slice_str(cur, pos + del_len, n)) }
        buf_free(move cur)
        cur = nb
    } else if op == 9 and n > 0 and n < limit {
        // Block duplicate / repeat (catches buffer growth & quadratic parser bugs)
        src_pos := _fz_u64_mod(r, n)
        mut blk_len := 1 + _fz_u64_mod(r, if n - src_pos < 24 { n - src_pos } else { 24 })
        reps := 1 + _fz_u64_mod(r, 4)
        dst_pos := _fz_u64_mod(r, n + 1)
        blk := buf_slice_str(cur, src_pos, src_pos + blk_len)
        nb := buf_new(limit + 64)
        if dst_pos > 0 { buf_push_str(nb, buf_slice_str(cur, 0, dst_pos)) }
        mut ri := 0
        while ri < reps and buf_len(nb) + blk_len <= limit {
            buf_push_str(nb, blk)
            ri += 1
        }
        if dst_pos < n {
            rem := limit - buf_len(nb)
            if rem > 0 {
                take := if n - dst_pos < rem { n - dst_pos } else { rem }
                buf_push_str(nb, buf_slice_str(cur, dst_pos, dst_pos + take))
            }
        }
        buf_free(move cur)
        cur = nb
    } else if op == 10 and n < limit {
        // Insert random bytes (1..16 bytes)
        ins_len := 1 + _fz_u64_mod(r, 16)
        pos := if n > 0 { _fz_u64_mod(r, n + 1) } else { 0 }
        nb := buf_new(limit + 64)
        if pos > 0 { buf_push_str(nb, buf_slice_str(cur, 0, pos)) }
        mut j := 0
        while j < ins_len and buf_len(nb) < limit {
            bv := if _fz_u64_mod(r, 3) != 0 { 32 + _fz_u64_mod(r, 95) } else { _fz_u64_mod(r, 256) }
            buf_push(nb, bv)
            j += 1
        }
        if pos < n {
            rem := limit - buf_len(nb)
            if rem > 0 {
                take := if n - pos < rem { n - pos } else { rem }
                buf_push_str(nb, buf_slice_str(cur, pos, pos + take))
            }
        }
        buf_free(move cur)
        cur = nb
    } else if op == 11 and n >= 2 {
        // Byte swap (2 random positions)
        p1 := _fz_u64_mod(r, n)
        p2 := _fz_u64_mod(r, n)
        t := buf_get(cur, p1)
        buf_set(cur, p1, buf_get(cur, p2))
        buf_set(cur, p2, t)
    } else if (op == 12 or op == 13) and svec_len(dict) > 0 {
        // Dictionary token insert (op==12) or overwrite (op==13)
        tok := svec_get(dict, _fz_u64_mod(r, svec_len(dict)))
        tlen := str_len(tok)
        if tlen > 0 {
            if op == 13 and n >= tlen {
                pos := _fz_u64_mod(r, n - tlen + 1)
                mut j := 0
                while j < tlen {
                    buf_set(cur, pos + j, str_byte(tok, j))
                    j += 1
                }
            } else if n + tlen <= limit {
                pos := if n > 0 { _fz_u64_mod(r, n + 1) } else { 0 }
                nb := buf_new(limit + 64)
                if pos > 0 { buf_push_str(nb, buf_slice_str(cur, 0, pos)) }
                buf_push_str(nb, tok)
                if pos < n { buf_push_str(nb, buf_slice_str(cur, pos, n)) }
                buf_free(move cur)
                cur = nb
            }
        }
    } else if n == 0 {
        buf_push(cur, _fz_interesting_u8(_fz_u64_mod(r, 9)))
    }
    return cur
}

// Applies 1..havoc_rounds stacked mutations returning a new owned ByteBuf.
fn fuzz_mutate_bytes(r: Rng, src: ByteBuf, dict: StrVec, max_len: i64 = 1024, havoc_rounds: i64 = 4) -> ByteBuf {
    mut limit := max_len
    if limit < 16 { limit = 16 }
    if limit > 65536 { limit = 65536 }
    mut cur := _fz_copy_buf(src, limit + 64)
    mut rounds := havoc_rounds
    if rounds < 1 { rounds = 1 }
    if rounds > 16 { rounds = 16 }
    actual_rounds := 1 + _fz_u64_mod(r, rounds)
    mut step := 0
    while step < actual_rounds {
        op := _fz_u64_mod(r, 14)
        cur = _fz_apply_single_mutator(r, move cur, op, dict, limit)
        step += 1
    }
    return cur
}

// Cross-over splice: joins prefix of `a` with suffix of `b` (capped at `max_len`).
fn fuzz_splice_bytes(r: Rng, a: ByteBuf, b: ByteBuf, max_len: i64 = 1024) -> ByteBuf {
    la := buf_len(a)
    lb := buf_len(b)
    mut limit := max_len
    if limit < 16 { limit = 16 }
    out := buf_new(limit + 64)
    if la == 0 and lb == 0 { return out }
    cut_a := if la > 0 { _fz_u64_mod(r, la + 1) } else { 0 }
    cut_b := if lb > 0 { _fz_u64_mod(r, lb) } else { 0 }
    mut take_a := cut_a
    if take_a > limit { take_a = limit }
    if take_a > 0 { buf_push_str(out, buf_slice_str(a, 0, take_a)) }
    rem := limit - buf_len(out)
    if rem > 0 and cut_b < lb {
        mut take_b := lb - cut_b
        if take_b > rem { take_b = rem }
        buf_push_str(out, buf_slice_str(b, cut_b, cut_b + take_b))
    }
    return out
}

// --- 2. Greybox Coverage-Guided Fuzzer + REDQUEEN I2S CmpLog + MOpt Bandit (`SecFuzzer`) ---

struct SecFuzzer {
    rng: Rng
    corpus: StrVec
    corpus_hashes: DynMap   // O(1) FNV-1a dedup map!
    energy: DynIntVec
    dict: StrVec
    dict_hashes: DynMap     // O(1) Auto-Dictionary dedup map!
    bitmap: ByteBuf         // 65536B global AFL hit-bucket coverage bitmap
    run_counts: ByteBuf     // 65536B per-iteration hit counters (sparsely cleared via `touched`)
    touched: DynIntVec      // indices touched in current iteration -> O(k) reset!
    op_tries: IntBuf        // MOpt adaptive bandit trials per mutator (14 slots)
    op_wins: IntBuf         // MOpt adaptive bandit coverage wins per mutator (14 slots)
    i2s_queue: StrVec       // REDQUEEN priority queue of Input-to-State replacement candidates
    i2s_head: i64           // read cursor into `i2s_queue`
    cur_input: ByteBuf
    seed_init: i64
    iter: i64
    max_iters: i64
    max_len: i64
    max_corpus: i64
    det_idx: i64
    unique_bits: i64
    last_op: i64
    i2s_queued_total: i64
    i2s_applied: i64
    min_dist: i64           // Directed Greybox Fuzzing (LibAFLGo): best observed distance to SAST sink
    cur_dist: i64           // Distance observed during current iteration
    new_cov: bool
    start_ns: i64
}

fn fuzz_new(seed: i64 = 1337, max_iters: i64 = 4096, max_len: i64 = 1024) -> SecFuzzer {
    mut mi := max_iters
    if mi < 1 { mi = 1 }
    mut ml := max_len
    if ml < 16 { ml = 16 }
    if ml > 65536 { ml = 65536 }
    bm := buf_new(65536)
    rc := buf_new(65536)
    mut i := 0
    while i < 65536 {
        buf_push(bm, 0)
        buf_push(rc, 0)
        i += 1
    }
    ot := ibuf_new(16)
    ow := ibuf_new(16)
    i = 0
    while i < 16 {
        ibuf_push(ot, 2)
        ibuf_push(ow, 1)
        i += 1
    }
    return SecFuzzer(
        rng = rng_new(seed),
        corpus = svec_new(64, 8192),
        corpus_hashes = dmap_new(128),
        energy = dvec_new(64),
        dict = svec_new(64, 2048),
        dict_hashes = dmap_new(128),
        bitmap = bm,
        run_counts = rc,
        touched = dvec_new(64),
        op_tries = ot,
        op_wins = ow,
        i2s_queue = svec_new(64, 4096),
        i2s_head = 0,
        cur_input = buf_new(ml + 64),
        seed_init = seed,
        iter = 0,
        max_iters = mi,
        max_len = ml,
        max_corpus = 512,
        det_idx = 0,
        unique_bits = 0,
        last_op = -1,
        i2s_queued_total = 0,
        i2s_applied = 0,
        min_dist = 999999,
        cur_dist = 999999,
        new_cov = false,
        start_ns = clock_ns()
    )
}

fn fuzz_free(move fz: SecFuzzer) {
    rng_free(move fz.rng)
    svec_free(move fz.corpus)
    dmap_free(move fz.corpus_hashes)
    dvec_free(move fz.energy)
    svec_free(move fz.dict)
    dmap_free(move fz.dict_hashes)
    buf_free(move fz.bitmap)
    buf_free(move fz.run_counts)
    dvec_free(move fz.touched)
    buf_free(move fz.op_tries)
    buf_free(move fz.op_wins)
    svec_free(move fz.i2s_queue)
    buf_free(move fz.cur_input)
}

fn _fz_add_corpus_dedup(mut fz: SecFuzzer, s: str, init_energy: i64) -> bool {
    if svec_len(fz.corpus) >= fz.max_corpus { return false }
    h := fnv1a_64(s) ^ (str_len(s) *% 0x9E3779B97F4A7C15)
    if dmap_contains(fz.corpus_hashes, h) { return false }
    dmap_put(mut fz.corpus_hashes, h, 1)
    svec_push(mut fz.corpus, s)
    dvec_push(mut fz.energy, init_energy)
    return true
}

fn fuzz_add_seed(mut fz: SecFuzzer, seed_str: str) {
    _ := _fz_add_corpus_dedup(mut fz, seed_str, 8)
}

fn fuzz_add_corpus(mut fz: SecFuzzer, sv: StrVec) {
    n := svec_len(sv)
    mut i := 0
    while i < n and svec_len(fz.corpus) < fz.max_corpus {
        _ := _fz_add_corpus_dedup(mut fz, svec_get(sv, i), 8)
        i += 1
    }
}

fn fuzz_add_dict(mut fz: SecFuzzer, token: str) {
    if str_len(token) <= 0 or svec_len(fz.dict) >= 512 { return }
    h := fnv1a_64(token) ^ (str_len(token) *% 0xBF58476D1CE4E5B9)
    if dmap_contains(fz.dict_hashes, h) { return }
    dmap_put(mut fz.dict_hashes, h, 1)
    svec_push(mut fz.dict, token)
}

fn fuzz_load_default_dict(mut fz: SecFuzzer) {
    d := corpus_parser_dict()
    n := svec_len(d)
    mut i := 0
    while i < n {
        fuzz_add_dict(mut fz, svec_get(d, i))
        i += 1
    }
    svec_free(move d)
}

fn _fz_queue_i2s(mut fz: SecFuzzer, cand: str) {
    // Cap queued I2S backlog to prevent unbounded memory growth
    if (svec_len(fz.i2s_queue) - fz.i2s_head) >= 64 { return }
    if str_len(cand) > fz.max_len { return }
    svec_push(mut fz.i2s_queue, cand)
    fz.i2s_queued_total = fz.i2s_queued_total + 1
}

fn _fz_try_replace_pattern(mut fz: SecFuzzer, cur_s: str, pat: str, rep: str) -> bool {
    plen := str_len(pat)
    if plen <= 0 or str_len(cur_s) < plen { return false }
    pos := str_find(cur_s, pat, 0)
    if pos < 0 { return false }
    nb := buf_new(str_len(cur_s) + str_len(rep) + 16)
    if pos > 0 { buf_push_str(nb, str_slice(cur_s, 0, pos)) }
    buf_push_str(nb, rep)
    if pos + plen < str_len(cur_s) {
        buf_push_str(nb, str_slice(cur_s, pos + plen, str_len(cur_s)))
    }
    cand := buf_to_owned_str(move nb)
    _fz_queue_i2s(mut fz, cand)
    return true
}

// REDQUEEN / CmpLog Integer Input-to-State (I2S) Hook:
// Log any target comparison `lhs == rhs` (e.g., magic header, version, checksum, length).
// Automatically locates `lhs` inside `cur_input` (8B/4B/2B LE & BE or ASCII decimal),
// queues immediate exact replacement with `rhs`, and promotes `rhs` into Auto-Dictionary!
fn fuzz_cmplog_i64(mut fz: SecFuzzer, lhs: i64, rhs: i64) {
    if lhs == rhs { return }
    cur_s := buf_slice_str(fz.cur_input, 0, buf_len(fz.cur_input))
    mut matched := false

    // 1. Try 8-byte LE and BE binary representation
    if str_len(cur_s) >= 8 {
        if _fz_try_replace_pattern(mut fz, cur_s, _fz_encode_int_bytes(lhs, 8, false), _fz_encode_int_bytes(rhs, 8, false)) { matched = true }
        if _fz_try_replace_pattern(mut fz, cur_s, _fz_encode_int_bytes(lhs, 8, true), _fz_encode_int_bytes(rhs, 8, true)) { matched = true }
        fuzz_add_dict(mut fz, _fz_encode_int_bytes(rhs, 8, false))
    }
    // 2. Try 4-byte LE and BE when values fit 32-bit
    if (not matched) and str_len(cur_s) >= 4 {
        if _fz_try_replace_pattern(mut fz, cur_s, _fz_encode_int_bytes(lhs, 4, false), _fz_encode_int_bytes(rhs, 4, false)) { matched = true }
        if _fz_try_replace_pattern(mut fz, cur_s, _fz_encode_int_bytes(lhs, 4, true), _fz_encode_int_bytes(rhs, 4, true)) { matched = true }
        fuzz_add_dict(mut fz, _fz_encode_int_bytes(rhs, 4, false))
    }
    // 3. Try 2-byte LE and BE
    if (not matched) and str_len(cur_s) >= 2 and lhs >= -32768 and lhs <= 65535 and rhs >= -32768 and rhs <= 65535 {
        if _fz_try_replace_pattern(mut fz, cur_s, _fz_encode_int_bytes(lhs, 2, false), _fz_encode_int_bytes(rhs, 2, false)) { matched = true }
        if _fz_try_replace_pattern(mut fz, cur_s, _fz_encode_int_bytes(lhs, 2, true), _fz_encode_int_bytes(rhs, 2, true)) { matched = true }
    }
    // 4. Try ASCII decimal integer representation (for JSON/HTTP/URL/CLI numeric fields!)
    s_lhs := str_from_i64(lhs)
    s_rhs := str_from_i64(rhs)
    if _fz_try_replace_pattern(mut fz, cur_s, s_lhs, s_rhs) {
        matched = true
    }
    fuzz_add_dict(mut fz, s_rhs)
}

// REDQUEEN / CmpLog String Input-to-State (I2S) Hook:
// Log any target string comparison `str_eq(lhs, rhs)` (e.g., command name, header, scheme, keyword).
// Automatically replaces `lhs` inside `cur_input` with `rhs` AND promotes `rhs` to Auto-Dictionary!
fn fuzz_cmplog_str(mut fz: SecFuzzer, lhs: str, rhs: str) {
    if str_eq(lhs, rhs) or str_len(rhs) == 0 { return }
    fuzz_add_dict(mut fz, rhs)
    cur_s := buf_slice_str(fz.cur_input, 0, buf_len(fz.cur_input))
    if str_len(lhs) > 0 {
        if _fz_try_replace_pattern(mut fz, cur_s, lhs, rhs) {
            return
        }
    }
    // Fallback: if `lhs` was empty or transformed, queue `rhs` verbatim and `cur_s + rhs`
    _fz_queue_i2s(mut fz, rhs)
}

// Comparison operator IDs for Inequality / Linear-Arithmetic CmpLog (`fuzz_cmplog_range`)
fn CMP_EQ() -> i64 { return 0 }
fn CMP_LT() -> i64 { return 1 }
fn CMP_LE() -> i64 { return 2 }
fn CMP_GT() -> i64 { return 3 }
fn CMP_GE() -> i64 { return 4 }

// Extended REDQUEEN / Concolic Range & Linear-Arithmetic CmpLog Hook:
// Solves `==`, `<`, `<=`, `>`, `>=` and linear offsets (`input + C == rhs`) in O(1) iterations!
fn fuzz_cmplog_range(mut fz: SecFuzzer, lhs: i64, rhs: i64, op: i64 = 0) {
    if op == 0 {
        fuzz_cmplog_i64(mut fz, lhs, rhs)
        return
    }
    if op == 1 or op == 2 {
        // Need lhs < rhs (or <=): inject rhs - 1 and rhs
        if lhs >= rhs {
            fuzz_cmplog_i64(mut fz, lhs, rhs -% 1)
            fuzz_cmplog_i64(mut fz, lhs, rhs)
        }
    } else {
        // Need lhs > rhs (or >=): inject rhs + 1 and rhs
        if lhs <= rhs {
            fuzz_cmplog_i64(mut fz, lhs, rhs +% 1)
            fuzz_cmplog_i64(mut fz, lhs, rhs)
        }
    }
}

// XOR-Involution CmpLog Solver: cracks unknown-key XOR magic checks `(raw_input ^ K) == target_rhs` in 1 step!
fn fuzz_cmplog_xor(mut fz: SecFuzzer, raw_input_word: i64, xored_lhs: i64, target_rhs: i64) {
    if xored_lhs == target_rhs { return }
    solved := raw_input_word ^ (xored_lhs ^ target_rhs)
    fuzz_cmplog_i64(mut fz, raw_input_word, solved)
}

// Directed Greybox Fuzzing (LibAFLGo simulated-annealing distance hook):
// Call with smaller `dist` as execution gets closer to a SAST-flagged target line (`dist == 0` = sink reached!).
fn fuzz_report_distance(mut fz: SecFuzzer, dist: i64) -> bool {
    if dist < 0 { return false }
    if dist < fz.cur_dist { fz.cur_dist = dist }
    if dist < fz.min_dist {
        fz.min_dist = dist
        fz.new_cov = true
        return true
    }
    return false
}

fn fuzz_min_distance(fz: SecFuzzer) -> i64 { return fz.min_dist }

fn _fz_reset_run_counts(mut fz: SecFuzzer) {
    tn := dvec_len(fz.touched)
    mut i := 0
    while i < tn {
        idx := dvec_get(fz.touched, i, 0)
        buf_set(fz.run_counts, idx, 0)
        i += 1
    }
    dvec_clear(mut fz.touched)
}

// Records a greybox branch/edge transition `prev_loc -> cur_loc` into the 64 KB AFL bitmap.
fn fuzz_trace_edge(mut fz: SecFuzzer, prev_loc: i64, cur_loc: i64) -> bool {
    idx := (ushr64(prev_loc, 1) ^ cur_loc) & 65535
    prev_hits := buf_get(fz.run_counts, idx)
    if prev_hits == 0 {
        dvec_push(mut fz.touched, idx)
    }
    mut next_hits := prev_hits + 1
    if next_hits > 255 { next_hits = 255 }
    buf_set(fz.run_counts, idx, next_hits)
    bit := _fz_bucket_bit(next_hits)
    old_mask := buf_get(fz.bitmap, idx)
    if (old_mask & bit) == 0 {
        buf_set(fz.bitmap, idx, old_mask | bit)
        fz.unique_bits = fz.unique_bits + 1
        fz.new_cov = true
        return true
    }
    return false
}

fn fuzz_record_feature(mut fz: SecFuzzer, feature_hash: i64) -> bool {
    mixed := (feature_hash ^ ushr64(feature_hash, 17)) *% 0xBF58476D1CE4E5B9
    return fuzz_trace_edge(mut fz, ushr64(mixed, 16), mixed)
}

fn fuzz_feedback_i64(mut fz: SecFuzzer, outcome_code: i64) -> bool {
    return fuzz_record_feature(mut fz, outcome_code *% 0x9E3779B97F4A7C15)
}

fn fuzz_feedback_str(mut fz: SecFuzzer, out: str) -> bool {
    n := str_len(out)
    mut lb := 0
    if n > 0 { lb = 1 }
    if n >= 8 { lb = 2 }
    if n >= 32 { lb = 3 }
    if n >= 128 { lb = 4 }
    if n >= 512 { lb = 5 }
    pref_len := if n < 32 { n } else { 32 }
    h := fnv1a_64(str_slice(out, 0, pref_len)) ^ (lb *% 0x9E3779B97F4A7C15)
    return fuzz_record_feature(mut fz, h)
}

fn _fz_pick_parent_idx(mut fz: SecFuzzer) -> i64 {
    cn := svec_len(fz.corpus)
    if cn <= 1 { return 0 }
    mut best := _fz_u64_mod(fz.rng, cn)
    mut best_e := dvec_get(fz.energy, best, 1)
    mut k := 0
    while k < 3 {
        cand := _fz_u64_mod(fz.rng, cn)
        ce := dvec_get(fz.energy, cand, 1)
        if ce > best_e {
            best = cand
            best_e = ce
        }
        k += 1
    }
    if best_e > 1 {
        _ := dvec_set(mut fz.energy, best, best_e - 1)
    }
    return best
}

// Advances the fuzzer to the next test input:
// Priority 1: Promote previous input to O(1)-deduped corpus & reward MOpt bandit if new coverage found.
// Priority 2: Drain REDQUEEN I2S candidates immediately (cracks magic values in O(1) steps!).
// Priority 3: Replay initial seeds deterministically.
// Priority 4: Energy-weighted parent + optional crossover splice + MOpt adaptive havoc mutation.
fn fuzz_next(mut fz: SecFuzzer) -> bool {
    if fz.iter > 0 and fz.new_cov {
        prev_s := buf_slice_str(fz.cur_input, 0, buf_len(fz.cur_input))
        // Simulated-annealing directed energy boost: closer to target sink -> dramatically higher energy!
        mut boost := 14
        if fz.cur_dist < 999999 {
            // Cooling factor increases exploitation as campaign progresses
            cool := 1 + ((fz.iter * 3) / (if fz.max_iters > 0 { fz.max_iters } else { 1 }))
            boost = (16 + (32 / (fz.cur_dist + 1))) * cool
        }
        _ := _fz_add_corpus_dedup(mut fz, prev_s, boost)
        if fz.last_op >= 0 and fz.last_op < 14 {
            ibuf_set(fz.op_wins, fz.last_op, ibuf_get(fz.op_wins, fz.last_op) + 4)
        }
        fz.new_cov = false
    }
    fz.cur_dist = 999999
    _fz_reset_run_counts(mut fz)

    if fz.iter >= fz.max_iters {
        return false
    }

    // Priority 2: Drain REDQUEEN I2S replacement queue immediately!
    if fz.i2s_head < svec_len(fz.i2s_queue) {
        s := svec_get(fz.i2s_queue, fz.i2s_head)
        fz.i2s_head = fz.i2s_head + 1
        // Compact queue periodically when fully drained
        if fz.i2s_head >= svec_len(fz.i2s_queue) and fz.i2s_head >= 128 {
            svec_free(move fz.i2s_queue)
            fz.i2s_queue = svec_new(64, 4096)
            fz.i2s_head = 0
        }
        nb := _fz_str_to_buf(s, 64)
        buf_free(move fz.cur_input)
        fz.cur_input = nb
        fz.last_op = -1
        fz.i2s_applied = fz.i2s_applied + 1
        fz.iter = fz.iter + 1
        return true
    }

    if svec_len(fz.corpus) == 0 {
        fuzz_add_seed(mut fz, "")
        fuzz_add_seed(mut fz, "a")
    }

    // Priority 3: Deterministic replay of initial seeds
    if fz.det_idx < svec_len(fz.corpus) and fz.iter == fz.det_idx {
        s := svec_get(fz.corpus, fz.det_idx)
        nb := _fz_str_to_buf(s, 64)
        buf_free(move fz.cur_input)
        fz.cur_input = nb
        fz.det_idx = fz.det_idx + 1
        fz.last_op = -1
        fz.iter = fz.iter + 1
        return true
    }

    // Priority 4: Energy-weighted parent + crossover splice + MOpt Adaptive Bandit Havoc
    cn := svec_len(fz.corpus)
    pidx := _fz_pick_parent_idx(mut fz)
    mut cur := _fz_str_to_buf(svec_get(fz.corpus, pidx), fz.max_len + 64)
    if cn >= 2 and _fz_u64_mod(fz.rng, 5) == 0 {
        pidx2 := _fz_u64_mod(fz.rng, cn)
        pbuf2 := _fz_str_to_buf(svec_get(fz.corpus, pidx2), 64)
        spliced := fuzz_splice_bytes(fz.rng, cur, pbuf2, fz.max_len)
        buf_free(move pbuf2)
        buf_free(move cur)
        cur = spliced
    }
    rounds := 1 + _fz_u64_mod(fz.rng, 5)
    mut last_used := 0
    mut step := 0
    while step < rounds {
        op := _fz_pick_adaptive_op(fz.rng, fz.op_tries, fz.op_wins)
        ibuf_set(fz.op_tries, op, ibuf_get(fz.op_tries, op) + 1)
        cur = _fz_apply_single_mutator(fz.rng, move cur, op, fz.dict, fz.max_len)
        last_used = op
        step += 1
    }
    buf_free(move fz.cur_input)
    fz.cur_input = cur
    fz.last_op = last_used
    fz.iter = fz.iter + 1
    return true
}

fn fuzz_cur_str(fz: SecFuzzer) -> str      { return buf_slice_str(fz.cur_input, 0, buf_len(fz.cur_input)) }
fn fuzz_cur_len(fz: SecFuzzer) -> i64      { return buf_len(fz.cur_input) }
fn fuzz_iters(fz: SecFuzzer) -> i64        { return fz.iter }
fn fuzz_corpus_len(fz: SecFuzzer) -> i64   { return svec_len(fz.corpus) }
fn fuzz_unique_features(fz: SecFuzzer) -> i64 { return fz.unique_bits }
fn fuzz_i2s_applied(fz: SecFuzzer) -> i64  { return fz.i2s_applied }

fn fuzz_execs_per_sec(fz: SecFuzzer) -> i64 {
    dt := clock_ns() - fz.start_ns
    if dt <= 0 { return 0 }
    return (fz.iter * 1000000000) / dt
}

// --- 3. Deterministic Edge-Biased Property-Based Generators (`SecGen`) ---

fn GEN_STR_ASCII() -> i64   { return 0 }
fn GEN_STR_IDENT() -> i64   { return 1 }
fn GEN_STR_HOSTILE() -> i64 { return 2 }
fn GEN_STR_BINARY() -> i64  { return 3 }

struct SecGen {
    rng: Rng
    i64_edges: IntBuf
    f64_edges: IntBuf
    seed_init: i64
}

fn gen_new(seed: i64 = 42) -> SecGen {
    return SecGen(
        rng = rng_new(seed),
        i64_edges = corpus_i64_boundaries(),
        f64_edges = corpus_f64_edge_bits(),
        seed_init = seed
    )
}

fn gen_free(move g: SecGen) {
    rng_free(move g.rng)
    buf_free(move g.i64_edges)
    buf_free(move g.f64_edges)
}

fn gen_i64(g: SecGen) -> i64 {
    if _fz_u64_mod(g.rng, 4) == 0 {
        return ibuf_get(g.i64_edges, _fz_u64_mod(g.rng, ibuf_len(g.i64_edges)))
    }
    return rng_next_u64(g.rng)
}

fn gen_i64_range(g: SecGen, lo: i64, hi_incl: i64) -> i64 {
    if hi_incl <= lo { return lo }
    pick := _fz_u64_mod(g.rng, 10)
    if pick == 0 { return lo }
    if pick == 1 { return hi_incl }
    if pick == 2 and lo <= 0 and hi_incl >= 0 { return 0 }
    span := hi_incl -% lo
    if span <= 0 or span >= 9223372036854775806 { return lo }
    return lo +% _fz_u64_mod(g.rng, span + 1)
}

fn gen_f64_edge(g: SecGen) -> f64 {
    if _fz_u64_mod(g.rng, 10) < 3 {
        bits := ibuf_get(g.f64_edges, _fz_u64_mod(g.rng, ibuf_len(g.f64_edges)))
        return sec_f64_from_bits(bits)
    }
    return (rng_f64(g.rng) - 0.5) * 2000000.0
}

fn gen_str(g: SecGen, max_len: i64 = 64, mode: i64 = 0) -> str {
    mut ml := max_len
    if ml < 0 { ml = 0 }
    if ml > 8192 { ml = 8192 }
    ln := _fz_u64_mod(g.rng, ml + 1)
    if ln == 0 { return "" }
    b := buf_new(ln + 8)
    mut i := 0
    while i < ln {
        if mode == 1 {
            k := _fz_u64_mod(g.rng, if i == 0 { 53 } else { 63 })
            if k < 26 { buf_push(b, 65 + k) }
            else if k < 52 { buf_push(b, 97 + (k - 26)) }
            else if k == 52 { buf_push(b, 95) }
            else { buf_push(b, 48 + (k - 53)) }
        } else if mode == 2 {
            sel := _fz_u64_mod(g.rng, 12)
            if sel == 0 { buf_push(b, 0) }
            else if sel == 1 { buf_push(b, 39) }
            else if sel == 2 { buf_push(b, 34) }
            else if sel == 3 { buf_push(b, 92) }
            else if sel == 4 { buf_push(b, 47) }
            else if sel == 5 { buf_push(b, 46) }
            else if sel == 6 { buf_push(b, 10) }
            else if sel == 7 { buf_push(b, 13) }
            else if sel == 8 { buf_push(b, 128 + _fz_u64_mod(g.rng, 128)) }
            else { buf_push(b, 32 + _fz_u64_mod(g.rng, 95)) }
        } else if mode == 3 {
            buf_push(b, _fz_u64_mod(g.rng, 256))
        } else {
            buf_push(b, 32 + _fz_u64_mod(g.rng, 95))
        }
        i += 1
    }
    return buf_to_owned_str(move b)
}

// --- 4. Structure-Aware Adversarial Grammar Synthesizers (Nautilus-lite) ---
// Generates syntactically valid outer framing carrying hostile inner payloads so fuzzing
// flies straight past parser syntax gates into deep SSRF/Auth/Smuggling/Binary logic!

fn gram_url(g: SecGen) -> str {
    sc_k := _fz_u64_mod(g.rng, 6)
    mut scheme := "ws"
    if sc_k == 0 { scheme = "http" }
    else if sc_k == 1 { scheme = "https" }
    else if sc_k == 2 { scheme = "HTTP" }
    else if sc_k == 3 { scheme = "file" }
    else if sc_k == 4 { scheme = "gopher" }

    ui_k := _fz_u64_mod(g.rng, 5)
    mut userinfo := "public.com@"
    if ui_k == 0 { userinfo = "" }
    else if ui_k == 1 { userinfo = "user:pass@" }
    else if ui_k == 2 { userinfo = "a@ok.com@" }
    else if ui_k == 3 { userinfo = "127.0.0.1\\@" }

    h_k := _fz_u64_mod(g.rng, 12)
    mut host := "192.168.1.1"
    if h_k == 0 { host = "example.com" }
    else if h_k == 1 { host = "127.0.0.1" }
    else if h_k == 2 { host = "localhost" }
    else if h_k == 3 { host = "[::1]" }
    else if h_k == 4 { host = "[0:0:0:0:0:0:0:1]" }
    else if h_k == 5 { host = "[::ffff:7f00:1]" }
    else if h_k == 6 { host = "[::ffff:a9fe:a9fe]" }
    else if h_k == 7 { host = "[fe90::1]" }
    else if h_k == 8 { host = "0177.0.0.1" }
    else if h_k == 9 { host = "2130706433" }
    else if h_k == 10 { host = "169.254.169.254" }

    p_k := _fz_u64_mod(g.rng, 5)
    mut port_s := ":-1"
    if p_k == 0 { port_s = "" }
    else if p_k == 1 { port_s = ":80" }
    else if p_k == 2 { port_s = ":443" }
    else if p_k == 3 { port_s = ":65536" }

    path_k := _fz_u64_mod(g.rng, 4)
    mut path_s := "#@example.com"
    if path_k == 0 { path_s = "/" }
    else if path_k == 1 { path_s = "/api/v1?x=1" }
    else if path_k == 2 { path_s = "/../../etc/passwd" }

    return scheme + "://" + userinfo + host + port_s + path_s
}

fn gram_http_req(g: SecGen) -> str {
    mk := _fz_u64_mod(g.rng, 5)
    mut meth := "G3T"
    if mk == 0 { meth = "GET" }
    else if mk == 1 { meth = "POST" }
    else if mk == 2 { meth = "PUT" }
    else if mk == 3 { meth = "DELETE" }

    pk := _fz_u64_mod(g.rng, 4)
    mut path := "//evil/share"
    if pk == 0 { path = "/api/v1" }
    else if pk == 1 { path = "/../secret" }
    else if pk == 2 { path = "/a?x=%00" }

    vk := _fz_u64_mod(g.rng, 3)
    mut ver := "HTTP/0.9"
    if vk == 0 { ver = "HTTP/1.1" }
    else if vk == 1 { ver = "HTTP/1.0" }

    eol := if _fz_u64_mod(g.rng, 4) == 0 { "\n" } else { "\r\n" }
    hk := _fz_u64_mod(g.rng, 5)
    mut extra := " folded: x" + eol
    if hk == 0 { extra = "" }
    else if hk == 1 { extra = "Content-Length: 4" + eol + "Transfer-Encoding: chunked" + eol }
    else if hk == 2 { extra = "Content-Length: 2" + eol + "Content-Length: 5" + eol }
    else if hk == 3 { extra = "Host : evil" + eol }

    return meth + " " + path + " " + ver + eol + "Host: example.com" + eol + extra + eol + "body"
}

fn gram_json(g: SecGen, max_depth: i64 = 3) -> str {
    mut d := max_depth
    if d < 1 { d = 1 }
    if d > 8 { d = 8 }
    b := buf_new(512)
    buf_push_str(b, "{")
    fields := 1 + _fz_u64_mod(g.rng, 4)
    mut i := 0
    while i < fields {
        if i > 0 { buf_push_str(b, ",") }
        kk := _fz_u64_mod(g.rng, 5)
        mut key := "val"
        if kk == 0 { key = "sub" }
        else if kk == 1 { key = "exp" }
        else if kk == 2 { key = "nbf" }
        else if kk == 3 { key = "alg" }
        buf_push_str(b, "\"" + key + "\":")
        vk := _fz_u64_mod(g.rng, 6)
        if vk == 0 {
            buf_push_str(b, str_from_i64(gen_i64(g)))
        } else if vk == 1 {
            buf_push_str(b, "-1")
        } else if vk == 2 {
            buf_push_str(b, "99999999999999999999999999999")
        } else if vk == 3 {
            buf_push_str(b, "\"admin\"")
        } else if vk == 4 {
            buf_push_str(b, "null")
        } else {
            buf_push_str(b, corpus_gen_nested("{\"x\":", "}", "1", d))
        }
        i += 1
    }
    buf_push_str(b, "}")
    return buf_to_owned_str(move b)
}

// Synthesizes a structured binary frame `[magic(4B LE) | flags(2B LE) | len(4B LE) | payload]`
// with deliberate boundary length mismatches to catch integer overflows & OOB reads in binary decoders.
fn gram_binary_frame(g: SecGen, magic_u32: i64 = 0x46554747, max_payload: i64 = 128) -> ByteBuf {
    pay_len := _fz_u64_mod(g.rng, if max_payload > 0 { max_payload } else { 16 })
    b := buf_new(pay_len + 32)
    mg := if _fz_u64_mod(g.rng, 5) == 0 { gen_i64(g) } else { magic_u32 }
    buf_push(b, mg & 255); buf_push(b, (mg >> 8) & 255); buf_push(b, (mg >> 16) & 255); buf_push(b, (mg >> 24) & 255)
    fl := _fz_u64_mod(g.rng, 65536)
    buf_push(b, fl & 255); buf_push(b, (fl >> 8) & 255)
    lk := _fz_u64_mod(g.rng, 6)
    mut enc_len := pay_len + 65536
    if lk == 0 { enc_len = pay_len }
    else if lk == 1 { enc_len = pay_len + 1 }
    else if lk == 2 { enc_len = 0 }
    else if lk == 3 { enc_len = 0x7FFFFFFF }
    else if lk == 4 { enc_len = 0xFFFFFFFF }
    buf_push(b, enc_len & 255); buf_push(b, (enc_len >> 8) & 255); buf_push(b, (enc_len >> 16) & 255); buf_push(b, (enc_len >> 24) & 255)
    mut i := 0
    while i < pay_len {
        buf_push(b, _fz_u64_mod(g.rng, 256))
        i += 1
    }
    return b
}

// --- 5. Stateful Operation-Sequence Fuzzer (`SecSeqFuzzer`) & Sequence `ddmin` Minimizer (`ShrinkSeq`) ---
// Discovers multi-step state corruption, tombstone, compaction, UAF, and model-divergence bugs
// and minimizes long failing sequences down to the exact minimal 2-4 operations!

struct SecSeqFuzzer {
    rng: Rng
    cur_ops: IntBuf         // stride 3: [op_id, arg1, arg2]
    num_ops: i64
    max_seq_len: i64
    arg_max: i64
    iter: i64
    max_iters: i64
    bitmap: ByteBuf         // 64KB state-transition coverage bitmap
    unique_states: i64
}

fn seq_fuzz_new(seed: i64 = 31337, num_ops: i64 = 6, max_seq_len: i64 = 32, arg_max: i64 = 16, max_iters: i64 = 2000) -> SecSeqFuzzer {
    mut no := if num_ops < 1 { 1 } else { num_ops }
    mut ml := if max_seq_len < 2 { 2 } else { max_seq_len }
    if ml > 256 { ml = 256 }
    mut am := if arg_max < 1 { 1 } else { arg_max }
    bm := buf_new(65536)
    mut i := 0
    while i < 65536 { buf_push(bm, 0); i += 1 }
    return SecSeqFuzzer(
        rng = rng_new(seed),
        cur_ops = ibuf_new(ml * 3 + 16),
        num_ops = no,
        max_seq_len = ml,
        arg_max = am,
        iter = 0,
        max_iters = if max_iters < 1 { 1 } else { max_iters },
        bitmap = bm,
        unique_states = 0
    )
}

fn seq_fuzz_free(move sf: SecSeqFuzzer) {
    rng_free(move sf.rng)
    buf_free(move sf.cur_ops)
    buf_free(move sf.bitmap)
}

fn _seq_rand_arg(r: Rng, arg_max: i64) -> i64 {
    k := _fz_u64_mod(r, 8)
    if k == 0 { return 0 }
    if k == 1 { return arg_max - 1 }
    return _fz_u64_mod(r, arg_max)
}

fn seq_fuzz_next(mut sf: SecSeqFuzzer) -> bool {
    if sf.iter >= sf.max_iters { return false }
    ln := 1 + _fz_u64_mod(sf.rng, sf.max_seq_len)
    nb := ibuf_new(ln * 3 + 8)
    mut i := 0
    while i < ln {
        ibuf_push(nb, _fz_u64_mod(sf.rng, sf.num_ops))
        ibuf_push(nb, _seq_rand_arg(sf.rng, sf.arg_max))
        ibuf_push(nb, _seq_rand_arg(sf.rng, sf.arg_max))
        i += 1
    }
    buf_free(move sf.cur_ops)
    sf.cur_ops = nb
    sf.iter = sf.iter + 1
    return true
}

fn seq_fuzz_trace(mut sf: SecSeqFuzzer, state_hash: i64) -> bool {
    idx := ((state_hash ^ ushr64(state_hash, 16)) *% 0x9E3779B97F4A7C15) & 65535
    if buf_get(sf.bitmap, idx) == 0 {
        buf_set(sf.bitmap, idx, 1)
        sf.unique_states = sf.unique_states + 1
        return true
    }
    return false
}

fn seq_fuzz_len(sf: SecSeqFuzzer) -> i64 { return ibuf_len(sf.cur_ops) / 3 }
fn seq_fuzz_op(sf: SecSeqFuzzer, idx: i64) -> i64   { return ibuf_get(sf.cur_ops, idx * 3) }
fn seq_fuzz_arg1(sf: SecSeqFuzzer, idx: i64) -> i64 { return ibuf_get(sf.cur_ops, idx * 3 + 1) }
fn seq_fuzz_arg2(sf: SecSeqFuzzer, idx: i64) -> i64 { return ibuf_get(sf.cur_ops, idx * 3 + 2) }

fn seq_fuzz_clone_ops(sf: SecSeqFuzzer) -> IntBuf {
    n := ibuf_len(sf.cur_ops)
    out := ibuf_new(n + 8)
    mut i := 0
    while i < n { ibuf_push(out, ibuf_get(sf.cur_ops, i)); i += 1 }
    return out
}

// Zeller `ddmin` Minimizer over operation sequences (`IntBuf` stride 3: `[op, arg1, arg2]`).
struct ShrinkSeq {
    best: IntBuf
    cand: IntBuf
    gran: i64
    chunk_idx: i64
    steps: i64
    max_steps: i64
    done: bool
}

fn shrink_seq_new(failing_ops: IntBuf, max_steps: i64 = 256) -> ShrinkSeq {
    n := ibuf_len(failing_ops)
    b := ibuf_new(n + 8)
    mut i := 0
    while i < n { ibuf_push(b, ibuf_get(failing_ops, i)); i += 1 }
    return ShrinkSeq(
        best = b,
        cand = ibuf_new(n + 8),
        gran = 2,
        chunk_idx = 0,
        steps = 0,
        max_steps = if max_steps < 16 { 16 } else { max_steps },
        done = (n / 3) <= 1
    )
}

fn shrink_seq_free(move sh: ShrinkSeq) {
    buf_free(move sh.best)
    buf_free(move sh.cand)
}

fn shrink_seq_next(mut sh: ShrinkSeq) -> bool {
    n_ops := ibuf_len(sh.best) / 3
    if sh.done or sh.steps >= sh.max_steps or n_ops <= 1 {
        sh.done = true
        return false
    }
    if sh.gran > n_ops { sh.gran = n_ops }
    if sh.chunk_idx >= sh.gran {
        if sh.gran >= n_ops {
            sh.done = true
            return false
        }
        sh.gran = sh.gran * 2
        if sh.gran > n_ops { sh.gran = n_ops }
        sh.chunk_idx = 0
    }
    start := (sh.chunk_idx * n_ops) / sh.gran
    mut stop := ((sh.chunk_idx + 1) * n_ops) / sh.gran
    if stop <= start { stop = start + 1 }
    if stop > n_ops { stop = n_ops }
    nb := ibuf_new(n_ops * 3 + 8)
    mut i := 0
    while i < n_ops {
        if i < start or i >= stop {
            ibuf_push(nb, ibuf_get(sh.best, i * 3))
            ibuf_push(nb, ibuf_get(sh.best, i * 3 + 1))
            ibuf_push(nb, ibuf_get(sh.best, i * 3 + 2))
        }
        i += 1
    }
    buf_free(move sh.cand)
    sh.cand = nb
    sh.steps = sh.steps + 1
    return true
}

fn shrink_seq_cand_len(sh: ShrinkSeq) -> i64 { return ibuf_len(sh.cand) / 3 }
fn shrink_seq_cand_op(sh: ShrinkSeq, idx: i64) -> i64   { return ibuf_get(sh.cand, idx * 3) }
fn shrink_seq_cand_arg1(sh: ShrinkSeq, idx: i64) -> i64 { return ibuf_get(sh.cand, idx * 3 + 1) }
fn shrink_seq_cand_arg2(sh: ShrinkSeq, idx: i64) -> i64 { return ibuf_get(sh.cand, idx * 3 + 2) }

fn shrink_seq_report(mut sh: ShrinkSeq, still_fails: bool) {
    if still_fails {
        n := ibuf_len(sh.cand)
        nb := ibuf_new(n + 8)
        mut i := 0
        while i < n { ibuf_push(nb, ibuf_get(sh.cand, i)); i += 1 }
        buf_free(move sh.best)
        sh.best = nb
        n_ops := n / 3
        if n_ops <= 1 {
            sh.done = true
            return
        }
        if sh.gran > 2 { sh.gran = sh.gran - 1 }
        if sh.gran > n_ops { sh.gran = n_ops }
        if sh.chunk_idx >= sh.gran { sh.chunk_idx = 0 }
    } else {
        sh.chunk_idx = sh.chunk_idx + 1
    }
}

fn shrink_seq_result_len(sh: ShrinkSeq) -> i64 { return ibuf_len(sh.best) / 3 }

fn seq_format_repro(ops: IntBuf) -> str {
    n_ops := ibuf_len(ops) / 3
    b := buf_new(n_ops * 32 + 32)
    buf_push_str(b, "[")
    mut i := 0
    while i < n_ops {
        if i > 0 { buf_push_str(b, ", ") }
        buf_push_str(b, f"op{ibuf_get(ops, i * 3)}({ibuf_get(ops, i * 3 + 1)},{ibuf_get(ops, i * 3 + 2)})")
        i += 1
    }
    buf_push_str(b, "]")
    return buf_to_owned_str(move b)
}

// --- 6. Zeller Delta-Debugging (`ddmin`) String Minimizer & Binary-Search `i64` Minimizer ---

struct ShrinkStr {
    best: ByteBuf
    cand: ByteBuf
    phase: i64
    gran: i64
    chunk_idx: i64
    byte_idx: i64
    steps: i64
    max_steps: i64
}

fn shrink_str_new(failing_input: str, max_steps: i64 = 512) -> ShrinkStr {
    n := str_len(failing_input)
    return ShrinkStr(
        best = _fz_str_to_buf(failing_input, 16),
        cand = buf_new(n + 16),
        phase = if n <= 0 { 2 } else { 0 },
        gran = 2,
        chunk_idx = 0,
        byte_idx = 0,
        steps = 0,
        max_steps = if max_steps < 16 { 16 } else { max_steps }
    )
}

fn shrink_str_free(move sh: ShrinkStr) {
    buf_free(move sh.best)
    buf_free(move sh.cand)
}

fn shrink_str_next(mut sh: ShrinkStr) -> bool {
    if sh.phase >= 2 or sh.steps >= sh.max_steps {
        sh.phase = 2
        return false
    }
    n := buf_len(sh.best)
    if n <= 0 {
        sh.phase = 2
        return false
    }

    if sh.phase == 0 {
        if sh.gran > n { sh.gran = n }
        if n == 1 {
            if sh.chunk_idx == 0 {
                nb := buf_new(8)
                buf_free(move sh.cand)
                sh.cand = nb
                sh.steps = sh.steps + 1
                return true
            }
            sh.phase = 1
            sh.byte_idx = 0
        } else {
            if sh.chunk_idx >= sh.gran {
                if sh.gran >= n {
                    sh.phase = 1
                    sh.byte_idx = 0
                } else {
                    sh.gran = sh.gran * 2
                    if sh.gran > n { sh.gran = n }
                    sh.chunk_idx = 0
                }
            }
            if sh.phase == 0 {
                start := (sh.chunk_idx * n) / sh.gran
                mut stop := ((sh.chunk_idx + 1) * n) / sh.gran
                if stop <= start { stop = start + 1 }
                if stop > n { stop = n }
                nb := buf_new(n + 8)
                if start > 0 { buf_push_str(nb, buf_slice_str(sh.best, 0, start)) }
                if stop < n { buf_push_str(nb, buf_slice_str(sh.best, stop, n)) }
                buf_free(move sh.cand)
                sh.cand = nb
                sh.steps = sh.steps + 1
                return true
            }
        }
    }

    if sh.phase == 1 {
        while sh.byte_idx < n {
            b := buf_get(sh.best, sh.byte_idx)
            if b != 97 {
                nb := _fz_copy_buf(sh.best, 8)
                buf_set(nb, sh.byte_idx, 97)
                buf_free(move sh.cand)
                sh.cand = nb
                sh.steps = sh.steps + 1
                return true
            }
            sh.byte_idx = sh.byte_idx + 1
        }
        sh.phase = 2
        return false
    }
    return false
}

fn shrink_str_candidate(sh: ShrinkStr) -> str {
    return buf_slice_str(sh.cand, 0, buf_len(sh.cand))
}

fn shrink_str_report(mut sh: ShrinkStr, still_fails: bool) {
    if sh.phase == 0 {
        if still_fails {
            nb := _fz_copy_buf(sh.cand, 8)
            buf_free(move sh.best)
            sh.best = nb
            if buf_len(sh.best) == 0 {
                sh.phase = 2
                return
            }
            if sh.gran > 2 { sh.gran = sh.gran - 1 }
            if sh.gran > buf_len(sh.best) { sh.gran = buf_len(sh.best) }
            if sh.chunk_idx >= sh.gran { sh.chunk_idx = 0 }
        } else {
            sh.chunk_idx = sh.chunk_idx + 1
        }
    } else if sh.phase == 1 {
        if still_fails {
            nb := _fz_copy_buf(sh.cand, 8)
            buf_free(move sh.best)
            sh.best = nb
        }
        sh.byte_idx = sh.byte_idx + 1
    }
}

fn shrink_str_result(sh: ShrinkStr) -> str {
    return buf_slice_str(sh.best, 0, buf_len(sh.best))
}

struct ShrinkI64 {
    best: i64
    cand: i64
    lo: i64
    hi: i64
    stage: i64
    steps: i64
}

fn shrink_i64_new(failing_val: i64) -> ShrinkI64 {
    return ShrinkI64(
        best = failing_val,
        cand = failing_val,
        lo = 0,
        hi = failing_val,
        stage = if failing_val == 0 { 3 } else { 0 },
        steps = 0
    )
}

fn shrink_i64_next(mut sh: ShrinkI64) -> bool {
    if sh.stage >= 3 or sh.steps >= 128 {
        sh.stage = 3
        return false
    }
    if sh.stage == 0 {
        sh.cand = 0
        sh.steps = sh.steps + 1
        return true
    }
    if sh.stage == 1 {
        if sh.best < 0 and sh.best != (1 << 63) {
            sh.cand = 0 - sh.best
            sh.steps = sh.steps + 1
            return true
        }
        sh.stage = 2
        sh.lo = 0
        sh.hi = sh.best
    }
    if sh.stage == 2 {
        diff := sh.hi -% sh.lo
        if diff == 0 or diff == 1 or diff == -1 {
            sh.stage = 3
            return false
        }
        mid := sh.lo +% (diff / 2)
        if mid == sh.lo or mid == sh.hi {
            sh.stage = 3
            return false
        }
        sh.cand = mid
        sh.steps = sh.steps + 1
        return true
    }
    return false
}

fn shrink_i64_candidate(sh: ShrinkI64) -> i64 { return sh.cand }

fn shrink_i64_report(mut sh: ShrinkI64, still_fails: bool) {
    if sh.stage == 0 {
        if still_fails {
            sh.best = 0
            sh.stage = 3
        } else {
            sh.stage = 1
        }
    } else if sh.stage == 1 {
        if still_fails { sh.best = sh.cand }
        sh.lo = 0
        sh.hi = sh.best
        sh.stage = 2
    } else if sh.stage == 2 {
        if still_fails {
            sh.best = sh.cand
            sh.hi = sh.cand
        } else {
            sh.lo = sh.cand
        }
    }
}

fn shrink_i64_result(sh: ShrinkI64) -> i64 { return sh.best }

// --- 7. Human & Agent-Ready Reproducer Formatting ---

fn sec_escape_str(s: str, max_preview: i64 = 128) -> str {
    n := str_len(s)
    lim := if n < max_preview { n } else { max_preview }
    b := buf_new(lim * 4 + 32)
    mut i := 0
    while i < lim {
        ch := str_byte(s, i)
        if ch == 10 { buf_push_str(b, "\\n") }
        else if ch == 13 { buf_push_str(b, "\\r") }
        else if ch == 9 { buf_push_str(b, "\\t") }
        else if ch == 34 { buf_push_str(b, "\\\"") }
        else if ch == 92 { buf_push_str(b, "\\\\") }
        else if ch >= 32 and ch <= 126 { buf_push(b, ch) }
        else {
            buf_push_str(b, "\\x")
            buf_push(b, hex_nibble_char((ch >> 4) & 15))
            buf_push(b, hex_nibble_char(ch & 15))
        }
        i += 1
    }
    if n > lim { buf_push_str(b, "...(truncated)") }
    return buf_to_owned_str(move b)
}

fn sec_format_repro(seed: i64, payload: str) -> str {
    n := str_len(payload)
    hex_lim := if n < 64 { n } else { 64 }
    hx := str_to_hex(str_slice(payload, 0, hex_lim))
    esc := sec_escape_str(payload, 96)
    return f"seed={seed} len={n} escaped=\"{esc}\" hex={hx}"
}
