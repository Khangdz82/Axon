// Axon Standard Library: True Zero-GIL OS Multithreading & Blocking Queues (`std/threading.ax`)
// 100% Pure Axon replacement for Python's `threading` + `queue` modules.
// Zero GIL, zero GC, OS kernel wait primitives (Win32 SRWLOCK/CONDITION_VARIABLE/TLS + POSIX pthread).
// Automatically activates Axon's slab allocator spinlock (`mt_enable`) before spawning any OS thread.

use std::ffi
use std::os

struct ThreadApi {
    lib: i64
    is_win: bool
    fn_create: i64
    fn_join: i64
    fn_close: i64
    fn_detach: i64
    fn_self: i64
    fn_yield: i64
    fn_mu_init: i64
    fn_mu_destroy: i64
    fn_mu_lock: i64
    fn_mu_trylock: i64
    fn_mu_unlock: i64
    fn_cv_init: i64
    fn_cv_destroy: i64
    fn_cv_wait: i64
    fn_cv_timedwait: i64
    fn_cv_signal: i64
    fn_cv_broadcast: i64
    fn_tls_alloc: i64
    fn_tls_get: i64
    fn_tls_set: i64
    fn_tls_free: i64
    fn_clock_gettime: i64
}

fn thread_init() -> ThreadApi ! i64 {
    unsafe { mt_enable() }
    mut lib := ffi_open_one("kernel32.dll")
    mut is_win := lib != 0
    if is_win {
        api := ThreadApi(
            lib = lib,
            is_win = true,
            fn_create = ffi_sym(lib, "CreateThread"),
            fn_join = ffi_sym(lib, "WaitForSingleObject"),
            fn_close = ffi_sym(lib, "CloseHandle"),
            fn_detach = 0,
            fn_self = ffi_sym(lib, "GetCurrentThreadId"),
            fn_yield = ffi_sym(lib, "SwitchToThread"),
            fn_mu_init = ffi_sym(lib, "InitializeSRWLock"),
            fn_mu_destroy = 0,
            fn_mu_lock = ffi_sym(lib, "AcquireSRWLockExclusive"),
            fn_mu_trylock = ffi_sym(lib, "TryAcquireSRWLockExclusive"),
            fn_mu_unlock = ffi_sym(lib, "ReleaseSRWLockExclusive"),
            fn_cv_init = ffi_sym(lib, "InitializeConditionVariable"),
            fn_cv_destroy = 0,
            fn_cv_wait = ffi_sym(lib, "SleepConditionVariableSRW"),
            fn_cv_timedwait = ffi_sym(lib, "SleepConditionVariableSRW"),
            fn_cv_signal = ffi_sym(lib, "WakeConditionVariable"),
            fn_cv_broadcast = ffi_sym(lib, "WakeAllConditionVariable"),
            fn_tls_alloc = ffi_sym(lib, "TlsAlloc"),
            fn_tls_get = ffi_sym(lib, "TlsGetValue"),
            fn_tls_set = ffi_sym(lib, "TlsSetValue"),
            fn_tls_free = ffi_sym(lib, "TlsFree"),
            fn_clock_gettime = 0
        )
        if api.fn_create == 0 or api.fn_mu_lock == 0 or api.fn_cv_wait == 0 {
            return err(-1)
        }
        return ok(api)
    }

    lib = ffi_open("", "libpthread.so.0", "libSystem.B.dylib")
    if lib == 0 { lib = ffi_open("", "libc.so.6", "libSystem.B.dylib") }
    if lib == 0 { return err(-1) }
    mut libc := ffi_open("", "libc.so.6", "libSystem.B.dylib")
    if libc == 0 { libc = lib }
    api := ThreadApi(
        lib = lib,
        is_win = false,
        fn_create = ffi_sym(lib, "pthread_create"),
        fn_join = ffi_sym(lib, "pthread_join"),
        fn_close = 0,
        fn_detach = ffi_sym(lib, "pthread_detach"),
        fn_self = ffi_sym(lib, "pthread_self"),
        fn_yield = ffi_sym(libc, "sched_yield"),
        fn_mu_init = ffi_sym(lib, "pthread_mutex_init"),
        fn_mu_destroy = ffi_sym(lib, "pthread_mutex_destroy"),
        fn_mu_lock = ffi_sym(lib, "pthread_mutex_lock"),
        fn_mu_trylock = ffi_sym(lib, "pthread_mutex_trylock"),
        fn_mu_unlock = ffi_sym(lib, "pthread_mutex_unlock"),
        fn_cv_init = ffi_sym(lib, "pthread_cond_init"),
        fn_cv_destroy = ffi_sym(lib, "pthread_cond_destroy"),
        fn_cv_wait = ffi_sym(lib, "pthread_cond_wait"),
        fn_cv_timedwait = ffi_sym(lib, "pthread_cond_timedwait"),
        fn_cv_signal = ffi_sym(lib, "pthread_cond_signal"),
        fn_cv_broadcast = ffi_sym(lib, "pthread_cond_broadcast"),
        fn_tls_alloc = ffi_sym(lib, "pthread_key_create"),
        fn_tls_get = ffi_sym(lib, "pthread_getspecific"),
        fn_tls_set = ffi_sym(lib, "pthread_setspecific"),
        fn_tls_free = ffi_sym(lib, "pthread_key_delete"),
        fn_clock_gettime = ffi_sym(libc, "clock_gettime")
    )
    if api.fn_create == 0 or api.fn_mu_lock == 0 or api.fn_cv_wait == 0 {
        return err(-2)
    }
    return ok(api)
}

fn thread_cpu_count() -> i64 {
    n := cpu_threads()
    if n < 1 { return 1 }
    return n
}

fn thread_current_id() -> i64 {
    api := thread_init() or return 0
    if api.fn_self == 0 { return 0 }
    if api.is_win { return ffi_call0(api.fn_self) & 0xFFFFFFFF }
    return ffi_call0(api.fn_self)
}

fn thread_yield() {
    api := thread_init() or return
    if api.fn_yield != 0 {
        _ := ffi_call0(api.fn_yield)
    }
}

// --- 1. OS Thread (`threading.Thread`) ---
// `ctx` layout (64B aligned): [0]=fn_addr, [1]=user_arg, [2]=ret_val, [3]=done_flag
struct Thread {
    handle: i64
    ctx: i64
    tid: i64
    joined: i64
    api: ThreadApi
}

fn thread_spawn(fn_ptr: i64, arg: i64) -> Thread ! i64 {
    if fn_ptr == 0 { return err(-1) }
    api := thread_init() or return
    ctx := ffi_alloc(64)
    if ctx == 0 { return err(-3) }
    ffi_write_i64(ctx, 0, fn_ptr)
    ffi_write_i64(ctx, 1, arg)
    ffi_write_i64(ctx, 2, 0)
    ffi_write_i64(ctx, 3, 0)
    tramp := unsafe { thread_trampoline_addr() }
    if tramp == 0 {
        ffi_free(ctx)
        return err(-4)
    }

    if api.is_win {
        tid_box := ffi_alloc(16)
        if tid_box == 0 {
            ffi_free(ctx)
            return err(-3)
        }
        h := ffi_call6(api.fn_create, 0, 0, tramp, ctx, 0, tid_box)
        tid := ffi_read_u32_le(tid_box, 0)
        ffi_free(tid_box)
        if h == 0 {
            ffi_free(ctx)
            return err(-5)
        }
        return ok(Thread(handle = h, ctx = ctx, tid = tid, joined = 0, api = api))
    }

    pth_box := ffi_alloc(16)
    if pth_box == 0 {
        ffi_free(ctx)
        return err(-3)
    }
    rc := ffi_sext32(ffi_call4(api.fn_create, pth_box, 0, tramp, ctx))
    pth := ffi_read_i64(pth_box, 0)
    ffi_free(pth_box)
    if rc != 0 {
        ffi_free(ctx)
        return err(-5)
    }
    return ok(Thread(handle = pth, ctx = ctx, tid = pth, joined = 0, api = api))
}

fn thread_ident(t: Thread) -> i64 {
    return t.tid
}

fn thread_is_alive(t: Thread) -> bool {
    if t.joined != 0 or t.ctx == 0 { return false }
    return unsafe { atomic_load_i64(t.ctx, 3) } == 0
}

fn thread_join(mut t: Thread) -> i64 ! i64 {
    if t.joined != 0 or t.ctx == 0 { return err(-2) }
    if t.api.is_win {
        wr := ffi_call2(t.api.fn_join, t.handle, 0xFFFFFFFF) & 0xFFFFFFFF
        _ := ffi_call1(t.api.fn_close, t.handle)
        if wr != 0 {
            ffi_free(t.ctx)
            t.ctx = 0
            t.joined = 1
            return err(-6)
        }
    } else {
        rc := ffi_sext32(ffi_call2(t.api.fn_join, t.handle, 0))
        if rc != 0 {
            ffi_free(t.ctx)
            t.ctx = 0
            t.joined = 1
            return err(-6)
        }
    }
    ret := ffi_read_i64(t.ctx, 2)
    ffi_free(t.ctx)
    t.ctx = 0
    t.joined = 1
    return ok(ret)
}

fn thread_join_timeout(mut t: Thread, timeout_ms: i64) -> i64 ! i64 {
    if t.joined != 0 or t.ctx == 0 { return err(-2) }
    if timeout_ms < 0 { return thread_join(mut t) }
    if t.api.is_win {
        wr := ffi_call2(t.api.fn_join, t.handle, timeout_ms) & 0xFFFFFFFF
        if wr == 258 { return err(-110) }
        _ := ffi_call1(t.api.fn_close, t.handle)
        if wr != 0 {
            ffi_free(t.ctx)
            t.ctx = 0
            t.joined = 1
            return err(-6)
        }
        ret := ffi_read_i64(t.ctx, 2)
        ffi_free(t.ctx)
        t.ctx = 0
        t.joined = 1
        return ok(ret)
    }

    // POSIX timed wait on atomic done_flag, then reclaim via pthread_join
    deadline_ns := clock_ns() + timeout_ms * 1000000
    mut spins := 0
    while unsafe { atomic_load_i64(t.ctx, 3) } == 0 {
        if clock_ns() >= deadline_ns { return err(-110) }
        if spins < 256 {
            cpu_pause()
            spins += 1
        } else {
            sleep_ms(1)
        }
    }
    return thread_join(mut t)
}

// --- 2. OS Kernel Mutex (`threading.Lock`) ---
struct Mutex {
    ptr: i64
    api: ThreadApi
}

fn mutex_new() -> Mutex ! i64 {
    api := thread_init() or return
    p := ffi_alloc(64)
    if p == 0 { return err(-3) }
    if api.is_win {
        if api.fn_mu_init != 0 { _ := ffi_call1(api.fn_mu_init, p) }
    } else {
        rc := ffi_sext32(ffi_call2(api.fn_mu_init, p, 0))
        if rc != 0 { ffi_free(p); return err(-7) }
    }
    return ok(Mutex(ptr = p, api = api))
}

fn mutex_lock(m: Mutex) {
    if m.ptr == 0 { return }
    _ := ffi_call1(m.api.fn_mu_lock, m.ptr)
}

fn mutex_try_lock(m: Mutex) -> bool {
    if m.ptr == 0 or m.api.fn_mu_trylock == 0 { return false }
    rc := ffi_call1(m.api.fn_mu_trylock, m.ptr)
    if m.api.is_win { return (rc & 255) != 0 }
    return ffi_sext32(rc) == 0
}

fn mutex_unlock(m: Mutex) {
    if m.ptr == 0 { return }
    _ := ffi_call1(m.api.fn_mu_unlock, m.ptr)
}

fn mutex_free(move m: Mutex) {
    if m.ptr != 0 {
        if not m.api.is_win and m.api.fn_mu_destroy != 0 {
            _ := ffi_call1(m.api.fn_mu_destroy, m.ptr)
        }
        ffi_free(m.ptr)
    }
}

// --- 3. Reentrant Lock (`threading.RLock`) ---
// `state` (64B): [0]=owner_tid, [1]=recursion_depth
struct RLock {
    mu: Mutex
    state: i64
}

fn rlock_new() -> RLock ! i64 {
    mu := mutex_new() or return
    st := ffi_alloc(64)
    if st == 0 {
        mutex_free(move mu)
        return err(-3)
    }
    return ok(RLock(mu = mu, state = st))
}

fn rlock_acquire(r: RLock) {
    if r.state == 0 { return }
    tid := thread_current_id()
    if unsafe { atomic_load_i64(r.state, 0) } == tid {
        cur := ffi_read_i64(r.state, 1)
        ffi_write_i64(r.state, 1, cur + 1)
        return
    }
    mutex_lock(r.mu)
    unsafe { atomic_store_i64(r.state, 0, tid) }
    ffi_write_i64(r.state, 1, 1)
}

fn rlock_try_acquire(r: RLock) -> bool {
    if r.state == 0 { return false }
    tid := thread_current_id()
    if unsafe { atomic_load_i64(r.state, 0) } == tid {
        cur := ffi_read_i64(r.state, 1)
        ffi_write_i64(r.state, 1, cur + 1)
        return true
    }
    if not mutex_try_lock(r.mu) { return false }
    unsafe { atomic_store_i64(r.state, 0, tid) }
    ffi_write_i64(r.state, 1, 1)
    return true
}

fn rlock_release(r: RLock) -> bool {
    if r.state == 0 { return false }
    tid := thread_current_id()
    if unsafe { atomic_load_i64(r.state, 0) } != tid { return false }
    cur := ffi_read_i64(r.state, 1) - 1
    ffi_write_i64(r.state, 1, cur)
    if cur <= 0 {
        unsafe { atomic_store_rel_i64(r.state, 0, 0) }
        mutex_unlock(r.mu)
    }
    return true
}

fn rlock_free(move r: RLock) {
    if r.state != 0 { ffi_free(r.state) }
    mutex_free(move r.mu)
}

// --- 4. OS Condition Variable (`threading.Condition`) ---
struct CondVar {
    ptr: i64
    api: ThreadApi
}

fn cond_new() -> CondVar ! i64 {
    api := thread_init() or return
    p := ffi_alloc(64)
    if p == 0 { return err(-3) }
    if api.is_win {
        if api.fn_cv_init != 0 { _ := ffi_call1(api.fn_cv_init, p) }
    } else {
        rc := ffi_sext32(ffi_call2(api.fn_cv_init, p, 0))
        if rc != 0 { ffi_free(p); return err(-8) }
    }
    return ok(CondVar(ptr = p, api = api))
}

fn cond_wait(cv: CondVar, mu: Mutex) -> bool {
    if cv.ptr == 0 or mu.ptr == 0 { return false }
    if cv.api.is_win {
        return ffi_sext32(ffi_call4(cv.api.fn_cv_wait, cv.ptr, mu.ptr, 0xFFFFFFFF, 0)) != 0
    }
    return ffi_sext32(ffi_call2(cv.api.fn_cv_wait, cv.ptr, mu.ptr)) == 0
}

// Returns `true` if signalled (or spurious wake), `false` on timeout.
fn cond_wait_timeout(cv: CondVar, mu: Mutex, timeout_ms: i64) -> bool {
    if cv.ptr == 0 or mu.ptr == 0 { return false }
    if timeout_ms < 0 { return cond_wait(cv, mu) }
    if cv.api.is_win {
        return ffi_sext32(ffi_call4(cv.api.fn_cv_timedwait, cv.ptr, mu.ptr, timeout_ms, 0)) != 0
    }
    if cv.api.fn_clock_gettime == 0 { return false }
    ts := ffi_alloc(16)
    if ts == 0 { return false }
    // CLOCK_REALTIME = 0 on Linux & macOS
    _ := ffi_call2(cv.api.fn_clock_gettime, 0, ts)
    sec := ffi_read_i64(ts, 0)
    nsec := ffi_read_i64(ts, 1) + (timeout_ms % 1000) * 1000000
    add_sec := (timeout_ms / 1000) + (nsec / 1000000000)
    ffi_write_i64(ts, 0, sec + add_sec)
    ffi_write_i64(ts, 1, nsec % 1000000000)
    rc := ffi_sext32(ffi_call3(cv.api.fn_cv_timedwait, cv.ptr, mu.ptr, ts))
    ffi_free(ts)
    return rc == 0
}

fn cond_notify(cv: CondVar) {
    if cv.ptr == 0 { return }
    _ := ffi_call1(cv.api.fn_cv_signal, cv.ptr)
}

fn cond_notify_all(cv: CondVar) {
    if cv.ptr == 0 { return }
    _ := ffi_call1(cv.api.fn_cv_broadcast, cv.ptr)
}

fn cond_free(move cv: CondVar) {
    if cv.ptr != 0 {
        if not cv.api.is_win and cv.api.fn_cv_destroy != 0 {
            _ := ffi_call1(cv.api.fn_cv_destroy, cv.ptr)
        }
        ffi_free(cv.ptr)
    }
}

// --- 5. Event (`threading.Event`) ---
struct Event {
    mu: Mutex
    cv: CondVar
    state: i64
}

fn event_new() -> Event ! i64 {
    mu := mutex_new() or return
    cv := cond_new() or return
    st := ffi_alloc(64)
    if st == 0 {
        cond_free(move cv)
        mutex_free(move mu)
        return err(-3)
    }
    return ok(Event(mu = mu, cv = cv, state = st))
}

fn event_is_set(e: Event) -> bool {
    if e.state == 0 { return false }
    return unsafe { atomic_load_i64(e.state, 0) } != 0
}

fn event_set(e: Event) {
    if e.state == 0 { return }
    mutex_lock(e.mu)
    unsafe { atomic_store_rel_i64(e.state, 0, 1) }
    cond_notify_all(e.cv)
    mutex_unlock(e.mu)
}

fn event_clear(e: Event) {
    if e.state == 0 { return }
    mutex_lock(e.mu)
    unsafe { atomic_store_rel_i64(e.state, 0, 0) }
    mutex_unlock(e.mu)
}

fn event_wait(e: Event, timeout_ms: i64 = -1) -> bool {
    if e.state == 0 { return false }
    if unsafe { atomic_load_i64(e.state, 0) } != 0 { return true }
    mutex_lock(e.mu)
    if timeout_ms < 0 {
        while unsafe { atomic_load_i64(e.state, 0) } == 0 {
            _ := cond_wait(e.cv, e.mu)
        }
        mutex_unlock(e.mu)
        return true
    }
    deadline := clock_ns() + timeout_ms * 1000000
    while unsafe { atomic_load_i64(e.state, 0) } == 0 {
        rem_ns := deadline - clock_ns()
        if rem_ns <= 0 {
            mutex_unlock(e.mu)
            return false
        }
        mut rem_ms := (rem_ns + 999999) / 1000000
        if rem_ms < 1 { rem_ms = 1 }
        _ := cond_wait_timeout(e.cv, e.mu, rem_ms)
    }
    mutex_unlock(e.mu)
    return true
}

fn event_free(move e: Event) {
    if e.state != 0 { ffi_free(e.state) }
    cond_free(move e.cv)
    mutex_free(move e.mu)
}

// --- 6. Semaphore & BoundedSemaphore (`threading.Semaphore` / `BoundedSemaphore`) ---
// `state` (64B): [0]=count, [1]=max_val (-1 = unbounded)
struct Semaphore {
    mu: Mutex
    cv: CondVar
    state: i64
}

fn _sem_create(initial: i64, max_val: i64) -> Semaphore ! i64 {
    if initial < 0 { return err(-1) }
    mu := mutex_new() or return
    cv := cond_new() or return
    st := ffi_alloc(64)
    if st == 0 {
        cond_free(move cv)
        mutex_free(move mu)
        return err(-3)
    }
    ffi_write_i64(st, 0, initial)
    ffi_write_i64(st, 1, max_val)
    return ok(Semaphore(mu = mu, cv = cv, state = st))
}

fn sem_new(initial: i64 = 1) -> Semaphore ! i64 {
    return _sem_create(initial, -1)
}

fn bounded_sem_new(initial: i64 = 1) -> Semaphore ! i64 {
    return _sem_create(initial, initial)
}

fn sem_acquire(s: Semaphore, timeout_ms: i64 = -1) -> bool {
    if s.state == 0 { return false }
    mutex_lock(s.mu)
    if timeout_ms < 0 {
        while ffi_read_i64(s.state, 0) <= 0 {
            _ := cond_wait(s.cv, s.mu)
        }
        ffi_write_i64(s.state, 0, ffi_read_i64(s.state, 0) - 1)
        mutex_unlock(s.mu)
        return true
    }
    deadline := clock_ns() + timeout_ms * 1000000
    while ffi_read_i64(s.state, 0) <= 0 {
        rem_ns := deadline - clock_ns()
        if rem_ns <= 0 {
            mutex_unlock(s.mu)
            return false
        }
        mut rem_ms := (rem_ns + 999999) / 1000000
        if rem_ms < 1 { rem_ms = 1 }
        _ := cond_wait_timeout(s.cv, s.mu, rem_ms)
    }
    ffi_write_i64(s.state, 0, ffi_read_i64(s.state, 0) - 1)
    mutex_unlock(s.mu)
    return true
}

fn sem_try_acquire(s: Semaphore) -> bool {
    if s.state == 0 { return false }
    mutex_lock(s.mu)
    cur := ffi_read_i64(s.state, 0)
    if cur <= 0 {
        mutex_unlock(s.mu)
        return false
    }
    ffi_write_i64(s.state, 0, cur - 1)
    mutex_unlock(s.mu)
    return true
}

fn sem_release(s: Semaphore) -> bool {
    if s.state == 0 { return false }
    mutex_lock(s.mu)
    cur := ffi_read_i64(s.state, 0)
    max_v := ffi_read_i64(s.state, 1)
    if max_v >= 0 and cur >= max_v {
        mutex_unlock(s.mu)
        return false
    }
    ffi_write_i64(s.state, 0, cur + 1)
    cond_notify(s.cv)
    mutex_unlock(s.mu)
    return true
}

fn sem_free(move s: Semaphore) {
    if s.state != 0 { ffi_free(s.state) }
    cond_free(move s.cv)
    mutex_free(move s.mu)
}

// --- 7. Barrier (`threading.Barrier`) ---
// `state` (64B): [0]=parties, [1]=arrived, [2]=generation, [3]=broken
struct Barrier {
    mu: Mutex
    cv: CondVar
    state: i64
}

fn barrier_new(parties: i64) -> Barrier ! i64 {
    if parties <= 0 { return err(-1) }
    mu := mutex_new() or return
    cv := cond_new() or return
    st := ffi_alloc(64)
    if st == 0 {
        cond_free(move cv)
        mutex_free(move mu)
        return err(-3)
    }
    ffi_write_i64(st, 0, parties)
    ffi_write_i64(st, 1, 0)
    ffi_write_i64(st, 2, 0)
    ffi_write_i64(st, 3, 0)
    return ok(Barrier(mu = mu, cv = cv, state = st))
}

// Returns arrival index `0 .. parties - 1` on success, or `err(-9)` if broken.
fn barrier_wait(b: Barrier) -> i64 ! i64 {
    if b.state == 0 { return err(-1) }
    mutex_lock(b.mu)
    if ffi_read_i64(b.state, 3) != 0 {
        mutex_unlock(b.mu)
        return err(-9)
    }
    gen := ffi_read_i64(b.state, 2)
    parties := ffi_read_i64(b.state, 0)
    idx := ffi_read_i64(b.state, 1)
    ffi_write_i64(b.state, 1, idx + 1)
    if idx + 1 >= parties {
        ffi_write_i64(b.state, 1, 0)
        ffi_write_i64(b.state, 2, gen + 1)
        cond_notify_all(b.cv)
        mutex_unlock(b.mu)
        return ok(idx)
    }
    while ffi_read_i64(b.state, 2) == gen and ffi_read_i64(b.state, 3) == 0 {
        _ := cond_wait(b.cv, b.mu)
    }
    broken := ffi_read_i64(b.state, 3)
    mutex_unlock(b.mu)
    if broken != 0 { return err(-9) }
    return ok(idx)
}

fn barrier_abort(b: Barrier) {
    if b.state == 0 { return }
    mutex_lock(b.mu)
    ffi_write_i64(b.state, 3, 1)
    cond_notify_all(b.cv)
    mutex_unlock(b.mu)
}

fn barrier_reset(b: Barrier) {
    if b.state == 0 { return }
    mutex_lock(b.mu)
    ffi_write_i64(b.state, 1, 0)
    ffi_write_i64(b.state, 2, ffi_read_i64(b.state, 2) + 1)
    ffi_write_i64(b.state, 3, 0)
    cond_notify_all(b.cv)
    mutex_unlock(b.mu)
}

fn barrier_free(move b: Barrier) {
    if b.state != 0 { ffi_free(b.state) }
    cond_free(move b.cv)
    mutex_free(move b.mu)
}

// --- 8. Thread-Local Storage (`threading.local`) ---
struct ThreadLocal {
    slot: i64
    api: ThreadApi
}

fn tls_new() -> ThreadLocal ! i64 {
    api := thread_init() or return
    if api.is_win {
        s := ffi_call0(api.fn_tls_alloc) & 0xFFFFFFFF
        if s == 0xFFFFFFFF { return err(-10) }
        return ok(ThreadLocal(slot = s, api = api))
    }
    kbox := ffi_alloc(16)
    if kbox == 0 { return err(-3) }
    rc := ffi_sext32(ffi_call2(api.fn_tls_alloc, kbox, 0))
    k := ffi_read_u32_le(kbox, 0)
    ffi_free(kbox)
    if rc != 0 { return err(-10) }
    return ok(ThreadLocal(slot = k, api = api))
}

fn tls_get(tl: ThreadLocal) -> i64 {
    if tl.api.fn_tls_get == 0 { return 0 }
    return ffi_call1(tl.api.fn_tls_get, tl.slot)
}

fn tls_set(tl: ThreadLocal, val: i64) -> bool {
    if tl.api.fn_tls_set == 0 { return false }
    rc := ffi_sext32(ffi_call2(tl.api.fn_tls_set, tl.slot, val))
    if tl.api.is_win { return rc != 0 }
    return rc == 0
}

fn tls_free(move tl: ThreadLocal) {
    if tl.api.fn_tls_free != 0 {
        _ := ffi_call1(tl.api.fn_tls_free, tl.slot)
    }
}

// --- 9. Blocking Multi-Producer Multi-Consumer Queue (`queue.Queue`) ---
// `meta` (128B): [0]=head, [1]=tail, [2]=count, [3]=cap, [4]=max_size(0=unbounded),
//                [5]=unfinished_tasks, [6]=closed, [7]=data_ptr
struct ThreadQueue {
    mu: Mutex
    not_empty: CondVar
    not_full: CondVar
    all_done: CondVar
    meta: i64
}

fn tqueue_new(maxsize: i64 = 0) -> ThreadQueue ! i64 {
    mu := mutex_new() or return
    ne := cond_new() or return
    nf := cond_new() or return
    ad := cond_new() or return
    meta := ffi_alloc(128)
    mut init_cap := maxsize
    if init_cap <= 0 { init_cap = 64 }
    if init_cap > 16777216 { init_cap = 16777216 }
    data := ffi_alloc(init_cap * 8 + 64)
    if meta == 0 or data == 0 {
        if meta != 0 { ffi_free(meta) }
        if data != 0 { ffi_free(data) }
        cond_free(move ad)
        cond_free(move nf)
        cond_free(move ne)
        mutex_free(move mu)
        return err(-3)
    }
    ffi_write_i64(meta, 0, 0)
    ffi_write_i64(meta, 1, 0)
    ffi_write_i64(meta, 2, 0)
    ffi_write_i64(meta, 3, init_cap)
    ffi_write_i64(meta, 4, maxsize)
    ffi_write_i64(meta, 5, 0)
    ffi_write_i64(meta, 6, 0)
    ffi_write_i64(meta, 7, data)
    return ok(ThreadQueue(mu = mu, not_empty = ne, not_full = nf, all_done = ad, meta = meta))
}

fn _tqueue_grow_locked(meta: i64) -> bool {
    old_cap := ffi_read_i64(meta, 3)
    if old_cap >= 16777216 { return false }
    mut new_cap := old_cap * 2
    if new_cap > 16777216 { new_cap = 16777216 }
    new_data := ffi_alloc(new_cap * 8 + 64)
    if new_data == 0 { return false }
    old_data := ffi_read_i64(meta, 7)
    head := ffi_read_i64(meta, 0)
    cnt := ffi_read_i64(meta, 2)
    mut i := 0
    while i < cnt {
        idx := (head + i) % old_cap
        ffi_write_i64(new_data, i, ffi_read_i64(old_data, idx))
        i += 1
    }
    ffi_free(old_data)
    ffi_write_i64(meta, 0, 0)
    ffi_write_i64(meta, 1, cnt)
    ffi_write_i64(meta, 3, new_cap)
    ffi_write_i64(meta, 7, new_data)
    return true
}

fn tqueue_put(q: ThreadQueue, item: i64, timeout_ms: i64 = -1) -> bool {
    if q.meta == 0 { return false }
    mutex_lock(q.mu)
    maxsize := ffi_read_i64(q.meta, 4)
    if maxsize > 0 {
        if timeout_ms < 0 {
            while ffi_read_i64(q.meta, 2) >= maxsize and ffi_read_i64(q.meta, 6) == 0 {
                _ := cond_wait(q.not_full, q.mu)
            }
        } else {
            deadline := clock_ns() + timeout_ms * 1000000
            while ffi_read_i64(q.meta, 2) >= maxsize and ffi_read_i64(q.meta, 6) == 0 {
                rem_ns := deadline - clock_ns()
                if rem_ns <= 0 {
                    mutex_unlock(q.mu)
                    return false
                }
                mut rem_ms := (rem_ns + 999999) / 1000000
                if rem_ms < 1 { rem_ms = 1 }
                _ := cond_wait_timeout(q.not_full, q.mu, rem_ms)
            }
        }
    }
    if ffi_read_i64(q.meta, 6) != 0 {
        mutex_unlock(q.mu)
        return false
    }
    cnt := ffi_read_i64(q.meta, 2)
    cap := ffi_read_i64(q.meta, 3)
    if cnt >= cap {
        if not _tqueue_grow_locked(q.meta) {
            mutex_unlock(q.mu)
            return false
        }
    }
    data := ffi_read_i64(q.meta, 7)
    cap2 := ffi_read_i64(q.meta, 3)
    tail := ffi_read_i64(q.meta, 1)
    ffi_write_i64(data, tail, item)
    mut ntail := tail + 1
    if ntail >= cap2 { ntail = 0 }
    ffi_write_i64(q.meta, 1, ntail)
    ffi_write_i64(q.meta, 2, cnt + 1)
    ffi_write_i64(q.meta, 5, ffi_read_i64(q.meta, 5) + 1)
    cond_notify(q.not_empty)
    mutex_unlock(q.mu)
    return true
}

fn tqueue_put_nowait(q: ThreadQueue, item: i64) -> bool {
    return tqueue_put(q, item, 0)
}

fn tqueue_get(q: ThreadQueue, timeout_ms: i64 = -1) -> i64 ! i64 {
    if q.meta == 0 { return err(-1) }
    mutex_lock(q.mu)
    if timeout_ms < 0 {
        while ffi_read_i64(q.meta, 2) <= 0 and ffi_read_i64(q.meta, 6) == 0 {
            _ := cond_wait(q.not_empty, q.mu)
        }
    } else {
        deadline := clock_ns() + timeout_ms * 1000000
        while ffi_read_i64(q.meta, 2) <= 0 and ffi_read_i64(q.meta, 6) == 0 {
            rem_ns := deadline - clock_ns()
            if rem_ns <= 0 {
                mutex_unlock(q.mu)
                return err(-110)
            }
            mut rem_ms := (rem_ns + 999999) / 1000000
            if rem_ms < 1 { rem_ms = 1 }
            _ := cond_wait_timeout(q.not_empty, q.mu, rem_ms)
        }
    }
    cnt := ffi_read_i64(q.meta, 2)
    if cnt <= 0 {
        mutex_unlock(q.mu)
        return err(-2)
    }
    data := ffi_read_i64(q.meta, 7)
    cap := ffi_read_i64(q.meta, 3)
    head := ffi_read_i64(q.meta, 0)
    val := ffi_read_i64(data, head)
    mut nhead := head + 1
    if nhead >= cap { nhead = 0 }
    ffi_write_i64(q.meta, 0, nhead)
    ffi_write_i64(q.meta, 2, cnt - 1)
    cond_notify(q.not_full)
    mutex_unlock(q.mu)
    return ok(val)
}

fn tqueue_get_nowait(q: ThreadQueue) -> i64 ! i64 {
    return tqueue_get(q, 0)
}

fn tqueue_task_done(q: ThreadQueue) {
    if q.meta == 0 { return }
    mutex_lock(q.mu)
    cur := ffi_read_i64(q.meta, 5) - 1
    if cur <= 0 {
        ffi_write_i64(q.meta, 5, 0)
        cond_notify_all(q.all_done)
    } else {
        ffi_write_i64(q.meta, 5, cur)
    }
    mutex_unlock(q.mu)
}

fn tqueue_join(q: ThreadQueue) {
    if q.meta == 0 { return }
    mutex_lock(q.mu)
    while ffi_read_i64(q.meta, 5) > 0 {
        _ := cond_wait(q.all_done, q.mu)
    }
    mutex_unlock(q.mu)
}

fn tqueue_qsize(q: ThreadQueue) -> i64 {
    if q.meta == 0 { return 0 }
    mutex_lock(q.mu)
    sz := ffi_read_i64(q.meta, 2)
    mutex_unlock(q.mu)
    return sz
}

fn tqueue_empty(q: ThreadQueue) -> bool {
    return tqueue_qsize(q) == 0
}

fn tqueue_full(q: ThreadQueue) -> bool {
    if q.meta == 0 { return false }
    mutex_lock(q.mu)
    ms := ffi_read_i64(q.meta, 4)
    sz := ffi_read_i64(q.meta, 2)
    mutex_unlock(q.mu)
    return ms > 0 and sz >= ms
}

fn tqueue_close(q: ThreadQueue) {
    if q.meta == 0 { return }
    mutex_lock(q.mu)
    ffi_write_i64(q.meta, 6, 1)
    cond_notify_all(q.not_empty)
    cond_notify_all(q.not_full)
    cond_notify_all(q.all_done)
    mutex_unlock(q.mu)
}

fn tqueue_free(move q: ThreadQueue) {
    if q.meta != 0 {
        data := ffi_read_i64(q.meta, 7)
        if data != 0 { ffi_free(data) }
        ffi_free(q.meta)
    }
    cond_free(move q.all_done)
    cond_free(move q.not_full)
    cond_free(move q.not_empty)
    mutex_free(move q.mu)
}
