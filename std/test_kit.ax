// Axon v0.9.1 Production Assertions & Microbenchmark Harness (`std/test_kit.ax`)
// Reference-backed counters (zero copy overhead on assert calls) + nanosecond timing helpers.

struct TestSuite {
    name: str
    stats: IntBuf // [0]=passed, [1]=failed
}

fn suite_new(name: str) -> TestSuite {
    st := ibuf_new(4)
    ibuf_push(st, 0)
    ibuf_push(st, 0)
    return TestSuite(name, st)
}

fn assert_true(s: TestSuite, cond: bool, label: str) {
    if cond {
        ibuf_set(s.stats, 0, ibuf_get(s.stats, 0) + 1)
    } else {
        ibuf_set(s.stats, 1, ibuf_get(s.stats, 1) + 1)
        println(f"[FAIL] [{s.name}] {label}")
    }
}

fn assert_eq_i64(s: TestSuite, got: i64, expected: i64, label: str) {
    if got == expected {
        ibuf_set(s.stats, 0, ibuf_get(s.stats, 0) + 1)
    } else {
        ibuf_set(s.stats, 1, ibuf_get(s.stats, 1) + 1)
        println(f"[FAIL] [{s.name}] {label}: expected {expected}, got {got}")
    }
}

fn assert_eq_str(s: TestSuite, got: str, expected: str, label: str) {
    if str_eq(got, expected) {
        ibuf_set(s.stats, 0, ibuf_get(s.stats, 0) + 1)
    } else {
        ibuf_set(s.stats, 1, ibuf_get(s.stats, 1) + 1)
        println(f"[FAIL] [{s.name}] {label}: expected \"{expected}\", got \"{got}\"")
    }
}

fn assert_near_f64(s: TestSuite, got: f64, expected: f64, eps: f64, label: str) {
    mut diff := got - expected
    if diff < 0.0 {
        diff = 0.0 - diff
    }
    if diff <= eps {
        ibuf_set(s.stats, 0, ibuf_get(s.stats, 0) + 1)
    } else {
        ibuf_set(s.stats, 1, ibuf_get(s.stats, 1) + 1)
        println(f"[FAIL] [{s.name}] {label}: float delta exceeded eps")
    }
}

fn suite_finish(move s: TestSuite) -> i64 {
    p := ibuf_get(s.stats, 0)
    f := ibuf_get(s.stats, 1)
    buf_free(move s.stats)
    if f == 0 {
        println(f"[SUITE OK] {s.name}: {p}/{p} assertions passed")
        return 0
    }
    println(f"[SUITE FAIL] {s.name}: {f} failed, {p} passed")
    return 1
}

fn bench_start() -> i64 {
    return clock_ns()
}

fn bench_elapsed_us(t0: i64) -> i64 {
    return (clock_ns() - t0) / 1000
}
