// Axon v1.0.0 Production String, Encoding & URL Utilities (`std/str.ax`)
// Zero-GC byte/slice operations backed by explicit-lifetime `ByteBuf` / `IntBuf` helpers.

use std::os

// Materializes a builder `ByteBuf` into a standalone NUL-terminated heap `str` and frees the builder.
fn buf_to_owned_str(move b: ByteBuf) -> str {
    n := buf_len(b)
    if n <= 0 {
        buf_free(move b)
        return ""
    }
    out := "" + buf_slice_str(b, 0, n)
    buf_free(move b)
    return out
}

fn str_cmp(a: str, b: str) -> i64 {
    la := str_len(a)
    lb := str_len(b)
    mut n := la
    if lb < n {
        n = lb
    }
    mut i := 0
    while i < n {
        ba := str_byte(a, i)
        bb := str_byte(b, i)
        if ba != bb {
            return ba - bb
        }
        i += 1
    }
    return la - lb
}

fn str_find(hay: str, needle: str, start: i64 = 0) -> i64 {
    hlen := str_len(hay)
    nlen := str_len(needle)
    mut s := start
    if s < 0 {
        s = 0
    }
    if nlen == 0 {
        if s <= hlen {
            return s
        }
        return -1
    }
    if nlen > hlen or s > hlen - nlen {
        return -1
    }
    first := str_byte(needle, 0)
    limit := hlen - nlen
    mut i := s
    if nlen == 1 {
        while i + 4 <= limit + 1 {
            if str_byte(hay, i) == first { return i }
            if str_byte(hay, i + 1) == first { return i + 1 }
            if str_byte(hay, i + 2) == first { return i + 2 }
            if str_byte(hay, i + 3) == first { return i + 3 }
            i += 4
        }
        while i <= limit {
            if str_byte(hay, i) == first { return i }
            i += 1
        }
        return -1
    }
    last := str_byte(needle, nlen - 1)
    last_off := nlen - 1
    while i <= limit {
        if str_byte(hay, i) == first and str_byte(hay, i + last_off) == last {
            mut j := 1
            while j < last_off {
                if str_byte(hay, i + j) != str_byte(needle, j) {
                    break
                }
                j += 1
            }
            if j == last_off {
                return i
            }
        }
        i += 1
    }
    return -1
}

fn str_rfind(hay: str, needle: str) -> i64 {
    hlen := str_len(hay)
    nlen := str_len(needle)
    if nlen == 0 {
        return hlen
    }
    if nlen > hlen {
        return -1
    }
    first := str_byte(needle, 0)
    mut i := hlen - nlen
    while i >= 0 {
        if str_byte(hay, i) == first {
            mut j := 1
            while j < nlen {
                if str_byte(hay, i + j) != str_byte(needle, j) {
                    break
                }
                j += 1
            }
            if j == nlen {
                return i
            }
        }
        i -= 1
    }
    return -1
}

fn str_contains(hay: str, needle: str) -> bool {
    return str_find(hay, needle, 0) >= 0
}

fn is_ascii_ws(b: i64) -> bool {
    return b == 32 or b == 9 or b == 10 or b == 13
}

fn str_trim_left(s: str) -> str {
    n := str_len(s)
    mut i := 0
    while i < n and is_ascii_ws(str_byte(s, i)) {
        i += 1
    }
    return str_slice(s, i, n)
}

fn str_trim_right(s: str) -> str {
    n := str_len(s)
    mut j := n
    while j > 0 and is_ascii_ws(str_byte(s, j - 1)) {
        j -= 1
    }
    return str_slice(s, 0, j)
}

fn str_trim(s: str) -> str {
    n := str_len(s)
    mut i := 0
    while i < n and is_ascii_ws(str_byte(s, i)) {
        i += 1
    }
    mut j := n
    while j > i and is_ascii_ws(str_byte(s, j - 1)) {
        j -= 1
    }
    return str_slice(s, i, j)
}

fn str_to_lower(s: str) -> str {
    n := str_len(s)
    b := buf_new(n + 1)
    mut i := 0
    while i < n {
        mut ch := str_byte(s, i)
        if ch >= 65 and ch <= 90 {
            ch += 32
        }
        buf_push(b, ch)
        i += 1
    }
    out := buf_to_owned_str(move b)
    return out
}

fn str_to_upper(s: str) -> str {
    n := str_len(s)
    b := buf_new(n + 1)
    mut i := 0
    while i < n {
        mut ch := str_byte(s, i)
        if ch >= 97 and ch <= 122 {
            ch -= 32
        }
        buf_push(b, ch)
        i += 1
    }
    return buf_to_owned_str(move b)
}

fn str_eq_ignore_case(a: str, b: str) -> bool {
    n := str_len(a)
    if n != str_len(b) {
        return false
    }
    mut i := 0
    while i < n {
        mut ca := str_byte(a, i)
        mut cb := str_byte(b, i)
        if ca >= 65 and ca <= 90 { ca += 32 }
        if cb >= 65 and cb <= 90 { cb += 32 }
        if ca != cb {
            return false
        }
        i += 1
    }
    return true
}

fn str_repeat(s: str, count: i64) -> str {
    if count <= 0 {
        return ""
    }
    slen := str_len(s)
    if slen == 0 {
        return ""
    }
    if count > 0x3FFFFFF0 / slen {
        return ""
    }
    total := slen * count
    b := buf_new(total + 1)
    mut i := 0
    while i < count {
        buf_push_str(b, s)
        i += 1
    }
    return buf_to_owned_str(move b)
}

fn str_replace(s: str, old_pat: str, new_pat: str) -> str {
    slen := str_len(s)
    olen := str_len(old_pat)
    nlen := str_len(new_pat)
    if olen == 0 {
        return s
    }
    // Pass 1: count matches so exact single output allocation is guaranteed safe
    mut hits := 0
    mut pos := 0
    while pos <= slen - olen {
        p := str_find(s, old_pat, pos)
        if p < 0 {
            break
        }
        hits += 1
        pos = p + olen
    }
    if hits == 0 {
        return s
    }
    delta := nlen - olen
    if delta > 0 and hits > (0x3FFFFFF0 - slen) / delta {
        return s
    }
    out_len := slen + hits * delta
    b := buf_new(out_len + 1)
    mut cur := 0
    while cur < slen {
        p := str_find(s, old_pat, cur)
        if p < 0 {
            buf_push_str(b, str_slice(s, cur, slen))
            break
        }
        if p > cur {
            buf_push_str(b, str_slice(s, cur, p))
        }
        if nlen > 0 {
            buf_push_str(b, new_pat)
        }
        cur = p + olen
    }
    return buf_to_owned_str(move b)
}

// Zero-copy split index builder: returns flat `[start0, end0, start1, end1, ...]` pairs.
fn str_split_ranges(s: str, delim_byte: i64) -> IntBuf {
    n := str_len(s)
    ranges := ibuf_new(n * 2 + 4)
    mut start := 0
    mut i := 0
    while i < n {
        if str_byte(s, i) == delim_byte {
            ibuf_push(ranges, start)
            ibuf_push(ranges, i)
            start = i + 1
        }
        i += 1
    }
    ibuf_push(ranges, start)
    ibuf_push(ranges, n)
    return ranges
}

fn str_split_count(ranges: IntBuf) -> i64 {
    return ibuf_len(ranges) / 2
}

fn str_split_at(s: str, ranges: IntBuf, idx: i64) -> str {
    cnt := ibuf_len(ranges) / 2
    if idx < 0 or idx >= cnt {
        return ""
    }
    st := ibuf_get(ranges, idx * 2)
    en := ibuf_get(ranges, idx * 2 + 1)
    return str_slice(s, st, en)
}

fn str_from_i64(val: i64) -> str {
    b := buf_new(32)
    buf_append_i64(b, val)
    return buf_to_owned_str(move b)
}

fn hex_nibble_char(v: i64) -> i64 {
    if v < 10 {
        return 48 + v
    }
    return 87 + v
}

fn hex_decode_nibble(ch: i64) -> i64 {
    if ch >= 48 and ch <= 57 { return ch - 48 }
    if ch >= 65 and ch <= 70 { return ch - 55 }
    if ch >= 97 and ch <= 102 { return ch - 87 }
    return -1
}

fn str_to_hex(s: str) -> str {
    n := str_len(s)
    b := buf_new(n * 2 + 1)
    mut i := 0
    while i < n {
        v := str_byte(s, i)
        buf_push(b, hex_nibble_char((v >> 4) & 15))
        buf_push(b, hex_nibble_char(v & 15))
        i += 1
    }
    return buf_to_owned_str(move b)
}

fn str_from_hex(hex_str: str) -> str ! i64 {
    n := str_len(hex_str)
    if (n & 1) != 0 {
        return err(400)
    }
    b := buf_new(n / 2 + 1)
    mut i := 0
    while i < n {
        hi := hex_decode_nibble(str_byte(hex_str, i))
        lo := hex_decode_nibble(str_byte(hex_str, i + 1))
        if hi < 0 or lo < 0 {
            buf_free(move b)
            return err(400)
        }
        buf_push(b, (hi << 4) | lo)
        i += 2
    }
    return ok(buf_to_owned_str(move b))
}

fn b64_enc_char(v: i64) -> i64 {
    if v < 26 { return 65 + v }
    if v < 52 { return 97 + (v - 26) }
    if v < 62 { return 48 + (v - 52) }
    if v == 62 { return 43 }
    return 47
}

fn b64_dec_val(ch: i64) -> i64 {
    if ch >= 65 and ch <= 90 { return ch - 65 }
    if ch >= 97 and ch <= 122 { return 26 + (ch - 97) }
    if ch >= 48 and ch <= 57 { return 52 + (ch - 48) }
    if ch == 43 { return 62 }
    if ch == 47 { return 63 }
    return -1
}

fn base64_encode(data: str) -> str {
    n := str_len(data)
    if n == 0 {
        return ""
    }
    out_cap := ((n + 2) / 3) * 4 + 1
    b := buf_new(out_cap)
    mut i := 0
    while i < n {
        b0 := str_byte(data, i)
        mut b1 := 0
        mut b2 := 0
        mut rem := n - i
        if rem > 1 { b1 = str_byte(data, i + 1) }
        if rem > 2 { b2 = str_byte(data, i + 2) }
        triple := (b0 << 16) | (b1 << 8) | b2
        buf_push(b, b64_enc_char((triple >> 18) & 63))
        buf_push(b, b64_enc_char((triple >> 12) & 63))
        if rem > 1 {
            buf_push(b, b64_enc_char((triple >> 6) & 63))
        } else {
            buf_push(b, 61)
        }
        if rem > 2 {
            buf_push(b, b64_enc_char(triple & 63))
        } else {
            buf_push(b, 61)
        }
        i += 3
    }
    return buf_to_owned_str(move b)
}

fn base64_decode(b64: str) -> str ! i64 {
    n := str_len(b64)
    if n == 0 {
        return ok("")
    }
    if (n & 3) != 0 {
        return err(400)
    }
    b := buf_new((n / 4) * 3 + 1)
    mut i := 0
    while i < n {
        c0 := str_byte(b64, i)
        c1 := str_byte(b64, i + 1)
        c2 := str_byte(b64, i + 2)
        c3 := str_byte(b64, i + 3)
        v0 := b64_dec_val(c0)
        v1 := b64_dec_val(c1)
        if v0 < 0 or v1 < 0 {
            buf_free(move b)
            return err(400)
        }
        mut v2 := 0
        mut v3 := 0
        pad2 := c2 == 61
        pad3 := c3 == 61
        if pad2 and not pad3 {
            buf_free(move b)
            return err(400)
        }
        if not pad2 {
            v2 = b64_dec_val(c2)
            if v2 < 0 {
                buf_free(move b)
                return err(400)
            }
        }
        if not pad3 {
            v3 = b64_dec_val(c3)
            if v3 < 0 {
                buf_free(move b)
                return err(400)
            }
        }
        if (pad2 or pad3) and i + 4 < n {
            buf_free(move b)
            return err(400)
        }
        triple := (v0 << 18) | (v1 << 12) | (v2 << 6) | v3
        buf_push(b, (triple >> 16) & 255)
        if not pad2 {
            buf_push(b, (triple >> 8) & 255)
        }
        if not pad3 {
            buf_push(b, triple & 255)
        }
        i += 4
    }
    return ok(buf_to_owned_str(move b))
}

fn is_url_unreserved(c: i64) -> bool {
    if c >= 65 and c <= 90 { return true }
    if c >= 97 and c <= 122 { return true }
    if c >= 48 and c <= 57 { return true }
    return c == 45 or c == 95 or c == 46 or c == 126
}

fn url_encode(s: str) -> str {
    n := str_len(s)
    b := buf_new(n * 3 + 1)
    mut i := 0
    while i < n {
        c := str_byte(s, i)
        if is_url_unreserved(c) {
            buf_push(b, c)
        } else {
            buf_push(b, 37) // '%'
            mut hi := (c >> 4) & 15
            mut lo := c & 15
            if hi < 10 { buf_push(b, 48 + hi) } else { buf_push(b, 55 + hi) }
            if lo < 10 { buf_push(b, 48 + lo) } else { buf_push(b, 55 + lo) }
        }
        i += 1
    }
    return buf_to_owned_str(move b)
}

fn url_decode(s: str) -> str ! i64 {
    n := str_len(s)
    mut needs_decode := false
    mut si := 0
    while si < n {
        c := str_byte(s, si)
        if c == 0 {
            return err(400)
        }
        if c == 43 or c == 37 {
            needs_decode = true
            break
        }
        si += 1
    }
    if not needs_decode {
        return ok(s)
    }
    b := buf_new(n + 1)
    mut i := 0
    while i < n {
        c := str_byte(s, i)
        if c == 0 {
            buf_free(move b)
            return err(400)
        } else if c == 43 { // '+'
            buf_push(b, 32)
            i += 1
        } else if c == 37 { // '%'
            if i + 2 >= n {
                buf_free(move b)
                return err(400)
            }
            hi := hex_decode_nibble(str_byte(s, i + 1))
            lo := hex_decode_nibble(str_byte(s, i + 2))
            if hi < 0 or lo < 0 {
                buf_free(move b)
                return err(400)
            }
            dec_b := (hi << 4) | lo
            if dec_b == 0 {
                buf_free(move b)
                return err(400)
            }
            buf_push(b, dec_b)
            i += 3
        } else {
            buf_push(b, c)
            i += 1
        }
    }
    return ok(buf_to_owned_str(move b))
}
