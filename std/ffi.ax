// Axon Production C-ABI FFI Toolkit (`std/ffi.ax`)
// Cross-platform dynamic library loader (`dll_load`/`dll_sym`/`c_call_v`),
// C-string marshaling, endian-safe struct memory accessors, and 0..13 argument C-ABI callers.
// Enables binding ANY C library (OpenSSL, libpq, libmysql, SQLite, Win32, X11, SDL2, Vulkan, FFmpeg)
// directly in 100% pure Axon with zero glue C code.

use std::str

fn ffi_sext32(v: i64) -> i64 {
    lo := v & 0xFFFFFFFF
    if (lo & 0x80000000) != 0 {
        return lo | -4294967296
    }
    return lo
}

fn ffi_open(win_name: str, linux_name: str, mac_name: str) -> i64 {
    unsafe {
        if str_len(win_name) > 0 {
            h := dll_load(win_name)
            if h != 0 { return h }
        }
        if str_len(linux_name) > 0 {
            h := dll_load(linux_name)
            if h != 0 { return h }
        }
        if str_len(mac_name) > 0 {
            h := dll_load(mac_name)
            if h != 0 { return h }
        }
        return 0
    }
}

fn ffi_open_one(lib_name: str) -> i64 {
    if str_len(lib_name) == 0 { return 0 }
    return unsafe { dll_load(lib_name) }
}

fn ffi_sym(lib: i64, name: str) -> i64 {
    if lib == 0 or str_len(name) == 0 { return 0 }
    return unsafe { dll_sym(lib, name) }
}

fn ffi_sym2(lib: i64, primary: str, fallback: str) -> i64 {
    if lib == 0 { return 0 }
    p := ffi_sym(lib, primary)
    if p != 0 { return p }
    return ffi_sym(lib, fallback)
}

fn ffi_close(lib: i64) {
    if lib != 0 {
        unsafe { _ := dll_close(lib) }
    }
}

fn ffi_alloc(nbytes: i64) -> i64 {
    if nbytes <= 0 or nbytes > 1073741824 { return 0 }
    unsafe {
        p := mem_alloc_aligned(nbytes + 16)
        if p != 0 { mem_set(p, 0, nbytes) }
        return p
    }
}

fn ffi_free(ptr: i64) {
    if ptr != 0 {
        unsafe { mem_free_aligned(ptr) }
    }
}

// Allocate NUL-terminated C string (`char*`) from Axon `str` (caller frees with `ffi_free`)
fn ffi_cstr(s: str) -> i64 {
    n := str_len(s)
    unsafe {
        p := mem_alloc_aligned(n + 8)
        if p == 0 { return 0 }
        mut i := 0
        while i < n {
            ptr_write_u8(p, i, str_byte(s, i))
            i += 1
        }
        ptr_write_u8(p, n, 0)
        return p
    }
}

// Allocate NUL-terminated UTF-16LE wide string (`wchar_t*`) for Win32/WinHTTP APIs
fn ffi_wstr(s: str) -> i64 {
    n := str_len(s)
    if n < 0 or n > 33554432 { return 0 }
    unsafe {
        p := mem_alloc_aligned((n + 2) * 2 + 8)
        if p == 0 { return 0 }
        mut i := 0
        while i < n {
            ptr_write_u8(p, i * 2, str_byte(s, i))
            ptr_write_u8(p, i * 2 + 1, 0)
            i += 1
        }
        ptr_write_u8(p, n * 2, 0)
        ptr_write_u8(p, n * 2 + 1, 0)
        return p
    }
}

// Read NUL-terminated C string (`char*`) safely up to `max_len` bytes into an Axon `str`
fn ffi_read_cstr(ptr: i64, max_len: i64 = 65536) -> str {
    if ptr == 0 or max_len <= 0 { return "" }
    unsafe {
        mut n := 0
        while n < max_len {
            if ptr_read_u8(ptr, n) == 0 { break }
            n += 1
        }
        b := buf_new(n + 4)
        mut i := 0
        while i < n {
            buf_push(b, ptr_read_u8(ptr, i))
            i += 1
        }
        return buf_to_owned_str(move b)
    }
}

// Copy `n` raw bytes from `ptr` into a new `ByteBuf`
fn ffi_read_bytes(ptr: i64, n: i64) -> ByteBuf {
    if ptr == 0 or n <= 0 or n > 67108864 { return buf_new(0) }
    out := buf_new(n + 8)
    unsafe {
        mut i := 0
        while i < n {
            buf_push(out, ptr_read_u8(ptr, i))
            i += 1
        }
    }
    return out
}

// Copy `ByteBuf` contents into a newly allocated raw C buffer (caller frees with `ffi_free`)
fn ffi_bytes_to_ptr(b: ByteBuf) -> i64 {
    n := buf_len(b)
    unsafe {
        p := mem_alloc_aligned(n + 16)
        if p == 0 { return 0 }
        mut i := 0
        while i < n {
            ptr_write_u8(p, i, buf_get(b, i))
            i += 1
        }
        ptr_write_u8(p, n, 0)
        return p
    }
}

// Raw byte/int memory helpers (little-endian & big-endian)
fn ffi_read_u8(ptr: i64, off: i64) -> i64 {
    if ptr == 0 { return 0 }
    return unsafe { ptr_read_u8(ptr, off) }
}

fn ffi_write_u8(ptr: i64, off: i64, v: i64) {
    if ptr == 0 { return }
    unsafe { ptr_write_u8(ptr, off, v & 255) }
}

fn ffi_write_u16_le(ptr: i64, off: i64, v: i64) {
    if ptr == 0 { return }
    unsafe {
        ptr_write_u8(ptr, off, v & 255)
        ptr_write_u8(ptr, off + 1, (v >> 8) & 255)
    }
}

fn ffi_write_u16_be(ptr: i64, off: i64, v: i64) {
    if ptr == 0 { return }
    unsafe {
        ptr_write_u8(ptr, off, (v >> 8) & 255)
        ptr_write_u8(ptr, off + 1, v & 255)
    }
}

fn ffi_read_u16_le(ptr: i64, off: i64) -> i64 {
    if ptr == 0 { return 0 }
    unsafe { return ptr_read_u8(ptr, off) | (ptr_read_u8(ptr, off + 1) << 8) }
}

fn ffi_read_u16_be(ptr: i64, off: i64) -> i64 {
    if ptr == 0 { return 0 }
    unsafe { return (ptr_read_u8(ptr, off) << 8) | ptr_read_u8(ptr, off + 1) }
}

fn ffi_write_u32_le(ptr: i64, off: i64, v: i64) {
    if ptr == 0 { return }
    unsafe {
        ptr_write_u8(ptr, off, v & 255)
        ptr_write_u8(ptr, off + 1, (v >> 8) & 255)
        ptr_write_u8(ptr, off + 2, (v >> 16) & 255)
        ptr_write_u8(ptr, off + 3, (v >> 24) & 255)
    }
}

fn ffi_write_u32_be(ptr: i64, off: i64, v: i64) {
    if ptr == 0 { return }
    unsafe {
        ptr_write_u8(ptr, off, (v >> 24) & 255)
        ptr_write_u8(ptr, off + 1, (v >> 16) & 255)
        ptr_write_u8(ptr, off + 2, (v >> 8) & 255)
        ptr_write_u8(ptr, off + 3, v & 255)
    }
}

fn ffi_read_u32_le(ptr: i64, off: i64) -> i64 {
    if ptr == 0 { return 0 }
    unsafe {
        return ptr_read_u8(ptr, off) | (ptr_read_u8(ptr, off + 1) << 8) | (ptr_read_u8(ptr, off + 2) << 16) | (ptr_read_u8(ptr, off + 3) << 24)
    }
}

fn ffi_read_u32_be(ptr: i64, off: i64) -> i64 {
    if ptr == 0 { return 0 }
    unsafe {
        return (ptr_read_u8(ptr, off) << 24) | (ptr_read_u8(ptr, off + 1) << 16) | (ptr_read_u8(ptr, off + 2) << 8) | ptr_read_u8(ptr, off + 3)
    }
}

fn ffi_read_i64(ptr: i64, idx: i64) -> i64 {
    if ptr == 0 { return 0 }
    return unsafe { ptr_read_i64(ptr, idx) }
}

fn ffi_write_i64(ptr: i64, idx: i64, v: i64) {
    if ptr == 0 { return }
    unsafe { ptr_write_i64(ptr, idx, v) }
}

// Ergonomic C-ABI callers (`0..13` integer/pointer arguments)
fn ffi_call0(f: i64) -> i64 {
    if f == 0 { return 0 }
    return unsafe { c_call_v(f, 0, 0) }
}

fn ffi_call1(f: i64, a0: i64) -> i64 {
    if f == 0 { return 0 }
    unsafe {
        av := mem_alloc_aligned(16)
        if av == 0 { return 0 }
        ptr_write_i64(av, 0, a0)
        r := c_call_v(f, 1, av)
        mem_free_aligned(av)
        return r
    }
}

fn ffi_call2(f: i64, a0: i64, a1: i64) -> i64 {
    if f == 0 { return 0 }
    unsafe {
        av := mem_alloc_aligned(24)
        if av == 0 { return 0 }
        ptr_write_i64(av, 0, a0); ptr_write_i64(av, 1, a1)
        r := c_call_v(f, 2, av)
        mem_free_aligned(av)
        return r
    }
}

fn ffi_call3(f: i64, a0: i64, a1: i64, a2: i64) -> i64 {
    if f == 0 { return 0 }
    unsafe {
        av := mem_alloc_aligned(32)
        if av == 0 { return 0 }
        ptr_write_i64(av, 0, a0); ptr_write_i64(av, 1, a1); ptr_write_i64(av, 2, a2)
        r := c_call_v(f, 3, av)
        mem_free_aligned(av)
        return r
    }
}

fn ffi_call4(f: i64, a0: i64, a1: i64, a2: i64, a3: i64) -> i64 {
    if f == 0 { return 0 }
    unsafe {
        av := mem_alloc_aligned(40)
        if av == 0 { return 0 }
        ptr_write_i64(av, 0, a0); ptr_write_i64(av, 1, a1); ptr_write_i64(av, 2, a2); ptr_write_i64(av, 3, a3)
        r := c_call_v(f, 4, av)
        mem_free_aligned(av)
        return r
    }
}

fn ffi_call5(f: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64) -> i64 {
    if f == 0 { return 0 }
    unsafe {
        av := mem_alloc_aligned(48)
        if av == 0 { return 0 }
        ptr_write_i64(av, 0, a0); ptr_write_i64(av, 1, a1); ptr_write_i64(av, 2, a2); ptr_write_i64(av, 3, a3); ptr_write_i64(av, 4, a4)
        r := c_call_v(f, 5, av)
        mem_free_aligned(av)
        return r
    }
}

fn ffi_call6(f: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64 {
    if f == 0 { return 0 }
    unsafe {
        av := mem_alloc_aligned(56)
        if av == 0 { return 0 }
        ptr_write_i64(av, 0, a0); ptr_write_i64(av, 1, a1); ptr_write_i64(av, 2, a2)
        ptr_write_i64(av, 3, a3); ptr_write_i64(av, 4, a4); ptr_write_i64(av, 5, a5)
        r := c_call_v(f, 6, av)
        mem_free_aligned(av)
        return r
    }
}

fn ffi_call7(f: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64) -> i64 {
    if f == 0 { return 0 }
    unsafe {
        av := mem_alloc_aligned(64)
        if av == 0 { return 0 }
        ptr_write_i64(av, 0, a0); ptr_write_i64(av, 1, a1); ptr_write_i64(av, 2, a2); ptr_write_i64(av, 3, a3)
        ptr_write_i64(av, 4, a4); ptr_write_i64(av, 5, a5); ptr_write_i64(av, 6, a6)
        r := c_call_v(f, 7, av)
        mem_free_aligned(av)
        return r
    }
}

fn ffi_call8(f: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64) -> i64 {
    if f == 0 { return 0 }
    unsafe {
        av := mem_alloc_aligned(72)
        if av == 0 { return 0 }
        ptr_write_i64(av, 0, a0); ptr_write_i64(av, 1, a1); ptr_write_i64(av, 2, a2); ptr_write_i64(av, 3, a3)
        ptr_write_i64(av, 4, a4); ptr_write_i64(av, 5, a5); ptr_write_i64(av, 6, a6); ptr_write_i64(av, 7, a7)
        r := c_call_v(f, 8, av)
        mem_free_aligned(av)
        return r
    }
}

fn ffi_call_arr(f: i64, argc: i64, args: IntBuf) -> i64 {
    if f == 0 or argc < 0 or argc > 16 { return 0 }
    unsafe {
        av := mem_alloc_aligned((argc + 2) * 8)
        if av == 0 { return 0 }
        mut i := 0
        while i < argc {
            v := if i < ibuf_len(args) { ibuf_get(args, i) } else { 0 }
            ptr_write_i64(av, i, v)
            i += 1
        }
        r := c_call_v(f, argc, av)
        mem_free_aligned(av)
        return r
    }
}
