// Axon Standard Library: C ABI FFI Interop
/// Safe C-string view pointing to null-terminated ASCII/UTF-8 buffer.
struct CString {
    ptr: i64,
    len: i32,
}

/// Raw OS kernel resource handle (HANDLE on Win32, int fd on POSIX).
struct NativeHandle {
    raw: i64,
    kind: i32,
}

/// Wraps raw pointer and length into a CString view.
fn cstring_new(ptr: i64, len: i32) -> CString {
    return CString(ptr, len);
}

/// Validates whether the given OS handle is non-null and valid.
fn handle_is_valid(h: NativeHandle) -> i32 {
    if h.raw == 0 {
        return 0;
    }
    return 1;
}
