// Axon Beginner-Friendly Ergonomic Starter Kit (`std/prelude.ax`)
// 1-line utilities for math, string parsing, human-readable formatting, file I/O, and high-precision timing.

use std::os
use std::str

@no_alloc
fn abs_i64(x: i64) -> i64 {
    if x < 0 { return 0 - x }
    return x
}

@no_alloc
fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

@no_alloc
fn min_i64(a: i64, b: i64) -> i64 {
    if a < b { return a }
    return b
}

@no_alloc
fn max_i64(a: i64, b: i64) -> i64 {
    if a > b { return a }
    return b
}

@no_alloc
fn clamp_i64(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}

@no_alloc
fn clamp_f64(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}

@no_alloc
fn lerp_f64(a: f64, b: f64, t: f64) -> f64 {
    return a + (b - a) * t
}

@no_alloc
fn parse_int_or(s: str, default_val: i64 = 0) -> i64 {
    n := str_len(s)
    if n == 0 { return default_val }
    mut i := 0
    while i < n and (str_byte(s, i) == 32 or str_byte(s, i) == 9) { i += 1 }
    if i >= n { return default_val }
    mut sign := 1
    if str_byte(s, i) == 45 {
        sign = -1
        i += 1
    } else if str_byte(s, i) == 43 {
        i += 1
    }
    if i >= n { return default_val }
    mut acc := 0
    mut digits := 0
    while i < n {
        ch := str_byte(s, i)
        if ch < 48 or ch > 57 { break }
        acc = acc * 10 + (ch - 48)
        digits += 1
        i += 1
    }
    if digits == 0 { return default_val }
    return acc * sign
}

@no_alloc
fn fnv1a_hash_str(s: str) -> i64 {
    n := str_len(s)
    mut h := 0xCBF29CE484222325
    mut i := 0
    while i < n {
        h = (h ^ (str_byte(s, i) & 255)) *% 0x100000001B3
        i += 1
    }
    return h & 0x7FFFFFFFFFFFFFFF
}

fn format_bytes(bytes: i64) -> str {
    if bytes < 1024 { return f"{bytes} B" }
    if bytes < 1048576 { return f"{bytes / 1024} KB" }
    if bytes < 1073741824 { return f"{bytes / 1048576} MB" }
    return f"{bytes / 1073741824} GB"
}

fn format_duration_us(us: i64) -> str {
    if us < 1000 { return f"{us} us" }
    if us < 1000000 { return f"{us / 1000} ms" }
    return f"{us / 1000000} s"
}

fn read_text_or(path: str, fallback: str = "") -> str {
    b := fs_read_file(path) or return fallback
    return buf_to_owned_str(move b)
}

fn write_text(path: str, content: str) -> bool {
    n := str_len(content)
    b := buf_new(n + 16)
    buf_push_str(b, content)
    w := fs_write_file(path, b) or -1
    buf_free(move b)
    return w >= 0
}

@no_alloc
fn stopwatch_ns() -> i64 {
    return clock_ns()
}

@no_alloc
fn elapsed_ms(t0_ns: i64) -> f64 {
    return (clock_ns() - t0_ns) as f64 / 1000000.0
}
