// Axon Standard Library: Memory & Perceus Runtime
/// Linear bump arena allocator for scoped zero-allocation lifetimes.
struct Arena {
    capacity: i32,
    offset: i32,
    allocated_bytes: i32,
}

/// Token proving eligibility for Perceus FBIP in-place memory slot reuse.
struct ReuseToken {
    slot_id: i32,
    byte_size: i32,
    is_active: i32,
}

/// Small-string optimized string type with zero heap allocation for len <= 23.
struct SsoString {
    len: i32,
    is_heap: i32,
    hash: i32,
}

/// Creates a new bump allocator arena with specified byte capacity.
fn arena_create(cap: i32) -> Arena {
    return Arena(cap, 0, 0);
}

/// Allocates 64-byte aligned memory chunk from arena. Returns offset or 0 if full.
fn arena_alloc(mut a: Arena, size: i32) -> i32 {
    let aligned_size = size +% 63;
    let next_off = a.offset + aligned_size;
    if next_off > a.capacity {
        return 0;
    }
    let ptr = a.offset;
    a.offset = next_off;
    a.allocated_bytes += size;
    return ptr;
}

/// Resets arena offset to 0, recycling all memory instantaneously without syscalls.
fn arena_reset(mut a: Arena) {
    a.offset = 0;
    a.allocated_bytes = 0;
}

/// Consumes an active reuse token, recycling its backing buffer slot.
fn reuse_token_consume(mut tok: ReuseToken) -> i32 {
    if tok.is_active == 0 {
        return 0;
    }
    tok.is_active = 0;
    return tok.slot_id;
}
