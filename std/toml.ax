// Axon Standard TOML, INI & `.env` Configuration Parser (`std/toml.ax`)
// Zero-allocation slice-indexed key-value & section configuration reader.

use std::str

// `entries`: 4 ints per entry `[sec_off, sec_len, key_off, key_len, val_off, val_len]` -> 6 ints per entry
struct TomlDoc {
    src: str
    entries: IntBuf
    count: i64
}

fn toml_parse(src: str) -> TomlDoc {
    n := str_len(src)
    entries := ibuf_new(1024 * 6)
    mut cnt := 0
    mut sec_off := 0
    mut sec_len := 0
    mut i := 0

    while i < n {
        // Skip whitespace and empty lines
        while i < n and (str_byte(src, i) == 32 or str_byte(src, i) == 9 or str_byte(src, i) == 13 or str_byte(src, i) == 10) {
            i += 1
        }
        if i >= n { break }
        ch := str_byte(src, i)

        // Comment '#' or ';'
        if ch == 35 or ch == 59 {
            while i < n and str_byte(src, i) != 10 { i += 1 }
            continue
        }

        // Section header `[section]`
        if ch == 91 {
            i += 1
            sec_off = i
            while i < n and str_byte(src, i) != 93 and str_byte(src, i) != 10 and str_byte(src, i) != 13 {
                i += 1
            }
            sec_len = i - sec_off
            while i < n and str_byte(src, i) != 10 { i += 1 }
            continue
        }

        // Optional `export ` prefix for `.env` compatibility
        if i + 7 < n and str_byte(src, i) == 101 and str_byte(src, i + 1) == 120 and str_byte(src, i + 2) == 112 and str_byte(src, i + 6) == 32 {
            i += 7
            while i < n and str_byte(src, i) == 32 { i += 1 }
        }

        // Key
        k_off := i
        while i < n and str_byte(src, i) != 61 and str_byte(src, i) != 32 and str_byte(src, i) != 9 and str_byte(src, i) != 10 and str_byte(src, i) != 13 {
            i += 1
        }
        k_len := i - k_off
        while i < n and (str_byte(src, i) == 32 or str_byte(src, i) == 9) { i += 1 }
        if i >= n or str_byte(src, i) != 61 {
            while i < n and str_byte(src, i) != 10 { i += 1 }
            continue
        }
        i += 1 // skip '='
        while i < n and (str_byte(src, i) == 32 or str_byte(src, i) == 9) { i += 1 }

        mut v_off := i
        mut v_len := 0
        if i < n and (str_byte(src, i) == 34 or str_byte(src, i) == 39) {
            q := str_byte(src, i)
            i += 1
            v_off = i
            while i < n and str_byte(src, i) != q and str_byte(src, i) != 10 and str_byte(src, i) != 13 {
                i += 1
            }
            v_len = i - v_off
            if i < n and str_byte(src, i) == q { i += 1 }
        } else {
            v_off = i
            while i < n and str_byte(src, i) != 10 and str_byte(src, i) != 13 and str_byte(src, i) != 35 {
                i += 1
            }
            v_len = i - v_off
            while v_len > 0 and (str_byte(src, v_off + v_len - 1) == 32 or str_byte(src, v_off + v_len - 1) == 9) {
                v_len -= 1
            }
        }

        if k_len > 0 and cnt < 1024 {
            ibuf_push(entries, sec_off)
            ibuf_push(entries, sec_len)
            ibuf_push(entries, k_off)
            ibuf_push(entries, k_len)
            ibuf_push(entries, v_off)
            ibuf_push(entries, v_len)
            cnt += 1
        }
        while i < n and str_byte(src, i) != 10 { i += 1 }
    }

    return TomlDoc(src = src, entries = entries, count = cnt)
}

@no_alloc
fn _toml_slice_eq(src: str, off: i64, ln: i64, target: str) -> bool {
    if ln != str_len(target) { return false }
    mut i := 0
    while i < ln {
        if str_byte(src, off + i) != str_byte(target, i) { return false }
        i += 1
    }
    return true
}

@no_alloc
fn _toml_find_idx(doc: TomlDoc, section: str, key: str) -> i64 {
    mut i := 0
    while i < doc.count {
        base := i * 6
        so := ibuf_get(doc.entries, base)
        sl := ibuf_get(doc.entries, base + 1)
        ko := ibuf_get(doc.entries, base + 2)
        kl := ibuf_get(doc.entries, base + 3)
        if _toml_slice_eq(doc.src, so, sl, section) and _toml_slice_eq(doc.src, ko, kl, key) {
            return i
        }
        i += 1
    }
    return -1
}

fn toml_get_str(doc: TomlDoc, section: str, key: str, default_val: str = "") -> str {
    idx := _toml_find_idx(doc, section, key)
    if idx < 0 { return default_val }
    base := idx * 6
    vo := ibuf_get(doc.entries, base + 4)
    vl := ibuf_get(doc.entries, base + 5)
    return str_slice(doc.src, vo, vo + vl)
}

@no_alloc
fn toml_get_i64(doc: TomlDoc, section: str, key: str, default_val: i64 = 0) -> i64 {
    idx := _toml_find_idx(doc, section, key)
    if idx < 0 { return default_val }
    base := idx * 6
    vo := ibuf_get(doc.entries, base + 4)
    vl := ibuf_get(doc.entries, base + 5)
    if vl <= 0 { return default_val }
    mut i := 0
    mut sign := 1
    if str_byte(doc.src, vo) == 45 { sign = -1; i = 1 }
    if i >= vl { return default_val }
    mut acc := 0
    while i < vl {
        ch := str_byte(doc.src, vo + i)
        if ch == 95 { i += 1; continue } // TOML '_' numeric separator
        if ch < 48 or ch > 57 { break }
        acc = acc * 10 + (ch - 48)
        i += 1
    }
    return acc * sign
}

@no_alloc
fn toml_get_bool(doc: TomlDoc, section: str, key: str, default_val: bool = false) -> bool {
    idx := _toml_find_idx(doc, section, key)
    if idx < 0 { return default_val }
    base := idx * 6
    vo := ibuf_get(doc.entries, base + 4)
    vl := ibuf_get(doc.entries, base + 5)
    if _toml_slice_eq(doc.src, vo, vl, "true") or _toml_slice_eq(doc.src, vo, vl, "1") { return true }
    if _toml_slice_eq(doc.src, vo, vl, "false") or _toml_slice_eq(doc.src, vo, vl, "0") { return false }
    return default_val
}

fn toml_free(move doc: TomlDoc) {
    buf_free(move doc.entries)
}
