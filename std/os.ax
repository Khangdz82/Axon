// Axon v6.0 Core String, Formatting & OS Utilities (`std/os.ax`)
// Zero-allocation string hashing, strict integer parsing (`i64 ! i64`), and `ByteBuf` formatters.

fn fnv1a_64(s: str) -> i64 {
    n := str_len(s)
    mut h := -3750763034362895579
    mut i := 0
    while i < n {
        h = (h ^ str_byte(s, i)) *% 1099511628211
        i += 1
    }
    return h
}

fn str_starts_with(s: str, prefix: str) -> bool {
    plen := str_len(prefix)
    if str_len(s) < plen {
        return false
    }
    return str_eq(str_slice(s, 0, plen), prefix)
}

fn str_ends_with(s: str, suffix: str) -> bool {
    slen := str_len(s)
    suflen := str_len(suffix)
    if slen < suflen {
        return false
    }
    return str_eq(str_slice(s, slen - suflen, slen), suffix)
}

fn str_find_byte(s: str, target: i64, start_idx: i64 = 0) -> i64 {
    n := str_len(s)
    mut i := start_idx
    if i < 0 { i = 0 }
    while i < n {
        if str_byte(s, i) == target {
            return i
        }
        i += 1
    }
    return -1
}

fn parse_i64(s: str) -> i64 ! i64 {
    n := str_len(s)
    mut i := 0
    while i < n {
        b := str_byte(s, i)
        if b == 32 or b == 9 or b == 10 or b == 13 {
            i += 1
        } else {
            break
        }
    }
    if i >= n {
        return err(400)
    }
    mut neg := false
    b0 := str_byte(s, i)
    if b0 == 45 {
        neg = true
        i += 1
    } else if b0 == 43 {
        i += 1
    }
    if i >= n {
        return err(400)
    }
    mut acc := 0
    mut digits := 0
    while i < n {
        d := str_byte(s, i)
        if d >= 48 and d <= 57 {
            acc = acc *% 10 +% (d - 48)
            digits += 1
            i += 1
        } else if d == 32 or d == 9 or d == 10 or d == 13 {
            break
        } else {
            return err(400)
        }
    }
    if digits == 0 {
        return err(400)
    }
    if neg {
        return ok(0 -% acc)
    }
    return ok(acc)
}

fn buf_append_i64(b: ByteBuf, val: i64) {
    if val == 0 {
        buf_push(b, 48)
        return
    }
    if val == (1 << 63) {
        buf_push_str(b, "-9223372036854775808")
        return
    }
    mut v := val
    if v < 0 {
        buf_push(b, 45)
        v = 0 - v
    }
    start_pos := buf_len(b)
    while v > 0 {
        digit := v % 10
        buf_push(b, 48 + digit)
        v = v / 10
    }
    mut lo := start_pos
    mut hi := buf_len(b) - 1
    while lo < hi {
        bl := buf_get(b, lo)
        bh := buf_get(b, hi)
        buf_set(b, lo, bh)
        buf_set(b, hi, bl)
        lo += 1
        hi -= 1
    }
}
