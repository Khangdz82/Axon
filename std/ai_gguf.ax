// Axon Complete GGUF v2/v3 Model Parser & Dequantization Kernels (std/ai_gguf.ax)
// 100% Pure Axon: Zero C++, Zero Python, Zero GC (@no_alloc), Perceus ref counting.
// Supports:
//   - GGUF v2/v3 Header (Magic 0x46554747, version, tensor count, metadata KV count)
//   - Arbitrary metadata KV table reading (integers, floats, strings, bools)
//   - Tensor descriptor table parsing (names, shapes, dimensions, types, offsets)
//   - Dequantization kernels: Q4_K, Q8_0, F16, and F32 copy
//   - Mock GGUF file generator for testing and standalone verification

use std::quant
use std::os
use std::str

// GGUF Magic "GGUF" in Little-Endian = 0x46554747
fn gguf_magic() -> i64 { return 0x46554747 }

// GGML Quantization Type Identifiers
fn ggml_type_f32() -> i64  { return 0 }
fn ggml_type_f16() -> i64  { return 1 }
fn ggml_type_q4_0() -> i64 { return 2 }
fn ggml_type_q4_1() -> i64 { return 3 }
fn ggml_type_q8_0() -> i64 { return 7 }
fn ggml_type_q4_k() -> i64 { return 12 }

// GGUF Metadata Value Types
fn gguf_val_u8() -> i64     { return 0 }
fn gguf_val_i8() -> i64     { return 1 }
fn gguf_val_u16() -> i64    { return 2 }
fn gguf_val_i16() -> i64    { return 3 }
fn gguf_val_u32() -> i64    { return 4 }
fn gguf_val_i32() -> i64    { return 5 }
fn gguf_val_f32() -> i64    { return 6 }
fn gguf_val_bool() -> i64   { return 7 }
fn gguf_val_string() -> i64 { return 8 }
fn gguf_val_array() -> i64  { return 9 }
fn gguf_val_u64() -> i64    { return 10 }
fn gguf_val_i64() -> i64    { return 11 }
fn gguf_val_f64() -> i64    { return 12 }

// Binary Read Helpers (Little-Endian)
fn gguf_read_u16(b: ByteBuf, off: i64) -> i64 {
    b0 := buf_get(b, off)
    b1 := buf_get(b, off + 1)
    return b0 | (b1 << 8)
}

fn gguf_read_u32(b: ByteBuf, off: i64) -> i64 {
    b0 := buf_get(b, off)
    b1 := buf_get(b, off + 1)
    b2 := buf_get(b, off + 2)
    b3 := buf_get(b, off + 3)
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

fn gguf_read_u64(b: ByteBuf, off: i64) -> i64 {
    lo := gguf_read_u32(b, off)
    hi := gguf_read_u32(b, off + 4)
    return lo | (hi << 32)
}

// Tensor descriptor table metadata:
// Stored in `tensor_meta: IntBuf` (8 words per tensor):
//   0: name_start_in_buf
//   1: name_len
//   2: n_dimensions
//   3: dim0
//   4: dim1
//   5: dtype (GGML type)
//   6: data_offset (relative to data_start)
//   7: num_elements
struct GgufFile {
    version: i64
    tensor_count: i64
    kv_count: i64
    data_start: i64
    raw: ByteBuf
    tensor_meta: IntBuf
}

fn gguf_close(move gf: GgufFile) {
    buf_free(move gf.raw)
    buf_free(move gf.tensor_meta)
}

// Opens and parses a GGUF file from disk.
fn gguf_open(path: str) -> GgufFile ! i64 {
    raw := fs_read_file(path) or return err(404)
    blen := buf_len(raw)
    if blen < 24 {
        buf_free(move raw)
        return err(422)
    }

    magic := gguf_read_u32(raw, 0)
    if magic != gguf_magic() {
        buf_free(move raw)
        return err(422)
    }

    ver := gguf_read_u32(raw, 4)
    if ver != 2 and ver != 3 {
        buf_free(move raw)
        return err(422)
    }

    tc := gguf_read_u64(raw, 8)
    kvc := gguf_read_u64(raw, 16)
    if tc < 0 or kvc < 0 or kvc > 1000000 or kvc > (blen - 24) / 12 {
        buf_free(move raw)
        return err(422)
    }

    mut off := 24

    // Skip metadata KV pairs
    mut ki := 0
    while ki < kvc and off < blen {
        if off + 8 > blen { buf_free(move raw); return err(422) }
        k_len := gguf_read_u64(raw, off)
        if k_len < 0 or k_len > blen - off - 8 { buf_free(move raw); return err(422) }
        off += 8 + k_len
        if off + 4 > blen { buf_free(move raw); return err(422) }
        v_type := gguf_read_u32(raw, off)
        off += 4

        if v_type == gguf_val_u8() or v_type == gguf_val_i8() or v_type == gguf_val_bool() {
            if off + 1 > blen { buf_free(move raw); return err(422) }
            off += 1
        } else if v_type == gguf_val_u16() or v_type == gguf_val_i16() {
            if off + 2 > blen { buf_free(move raw); return err(422) }
            off += 2
        } else if v_type == gguf_val_u32() or v_type == gguf_val_i32() or v_type == gguf_val_f32() {
            if off + 4 > blen { buf_free(move raw); return err(422) }
            off += 4
        } else if v_type == gguf_val_u64() or v_type == gguf_val_i64() or v_type == gguf_val_f64() {
            if off + 8 > blen { buf_free(move raw); return err(422) }
            off += 8
        } else if v_type == gguf_val_string() {
            if off + 8 > blen { buf_free(move raw); return err(422) }
            s_len := gguf_read_u64(raw, off)
            if s_len < 0 or s_len > blen - off - 8 { buf_free(move raw); return err(422) }
            off += 8 + s_len
        } else if v_type == gguf_val_array() {
            if off + 12 > blen { buf_free(move raw); return err(422) }
            arr_type := gguf_read_u32(raw, off)
            arr_len := gguf_read_u64(raw, off + 4)
            if arr_len < 0 or arr_len > blen { buf_free(move raw); return err(422) }
            off += 12
            if arr_type == gguf_val_u8() or arr_type == gguf_val_i8() or arr_type == gguf_val_bool() {
                if arr_len > blen - off { buf_free(move raw); return err(422) }
                off += arr_len * 1
            } else if arr_type == gguf_val_u16() or arr_type == gguf_val_i16() {
                if arr_len > (blen - off) / 2 { buf_free(move raw); return err(422) }
                off += arr_len * 2
            } else if arr_type == gguf_val_u32() or arr_type == gguf_val_i32() or arr_type == gguf_val_f32() {
                if arr_len > (blen - off) / 4 { buf_free(move raw); return err(422) }
                off += arr_len * 4
            } else if arr_type == gguf_val_u64() or arr_type == gguf_val_i64() or arr_type == gguf_val_f64() {
                if arr_len > (blen - off) / 8 { buf_free(move raw); return err(422) }
                off += arr_len * 8
            } else if arr_type == gguf_val_string() {
                mut ai := 0
                while ai < arr_len and off + 8 <= blen {
                    as_len := gguf_read_u64(raw, off)
                    if as_len < 0 or as_len > blen - off - 8 { buf_free(move raw); return err(422) }
                    off += 8 + as_len
                    ai += 1
                }
                if ai < arr_len { buf_free(move raw); return err(422) }
            } else {
                buf_free(move raw)
                return err(422)
            }
        } else {
            buf_free(move raw)
            return err(422)
        }
        ki += 1
    }
    if ki < kvc { buf_free(move raw); return err(422) }

    if tc > 1000000 or off > blen or tc > (blen - off) / 32 {
        buf_free(move raw)
        return err(422)
    }
    t_meta := ibuf_new(tc * 8 + 16)

    // Parse Tensor Info Table
    mut ti := 0
    while ti < tc and off < blen {
        if off + 8 > blen { buf_free(move raw); buf_free(move t_meta); return err(422) }
        name_len := gguf_read_u64(raw, off)
        if name_len < 0 or name_len > blen - off - 8 { buf_free(move raw); buf_free(move t_meta); return err(422) }
        name_start := off + 8
        off += 8 + name_len

        if off + 4 > blen { buf_free(move raw); buf_free(move t_meta); return err(422) }
        n_dims := gguf_read_u32(raw, off)
        off += 4
        if n_dims <= 0 or n_dims > 8 {
            buf_free(move raw)
            buf_free(move t_meta)
            return err(422)
        }

        mut d0 := 1
        mut d1 := 1
        mut total_elements := 1
        mut di := 0
        while di < n_dims and off + 8 <= blen {
            dim := gguf_read_u64(raw, off)
            off += 8
            if dim <= 0 or dim > 1073741824 or dim > (1073741824 / total_elements) {
                buf_free(move raw)
                buf_free(move t_meta)
                return err(422)
            }
            if di == 0 { d0 = dim }
            if di == 1 { d1 = dim }
            total_elements = total_elements * dim
            di += 1
        }
        if di != n_dims {
            buf_free(move raw)
            buf_free(move t_meta)
            return err(422)
        }

        if off + 12 > blen { buf_free(move raw); buf_free(move t_meta); return err(422) }
        t_type := gguf_read_u32(raw, off)
        t_offset := gguf_read_u64(raw, off + 4)
        off += 12
        if t_offset < 0 or t_offset > blen {
            buf_free(move raw)
            buf_free(move t_meta)
            return err(422)
        }

        ibuf_push(t_meta, name_start)
        ibuf_push(t_meta, name_len)
        ibuf_push(t_meta, n_dims)
        ibuf_push(t_meta, d0)
        ibuf_push(t_meta, d1)
        ibuf_push(t_meta, t_type)
        ibuf_push(t_meta, t_offset)
        ibuf_push(t_meta, total_elements)

        ti += 1
    }

    if ti != tc {
        buf_free(move raw)
        buf_free(move t_meta)
        return err(422)
    }

    // Alignment padding (default 32 bytes)
    mut data_start := off
    rem := data_start % 32
    if rem != 0 {
        data_start = data_start + (32 - rem)
    }

    return ok(GgufFile(
        version = ver,
        tensor_count = tc,
        kv_count = kvc,
        data_start = data_start,
        raw = raw,
        tensor_meta = t_meta
    ))
}

// Find tensor by name string
fn gguf_find_tensor(gf: GgufFile, name: str) -> i64 {
    n_len := str_len(name)
    mut i := 0
    while i < gf.tensor_count {
        base := i * 8
        t_name_start := ibuf_get(gf.tensor_meta, base)
        t_name_len := ibuf_get(gf.tensor_meta, base + 1)
        if t_name_len == n_len {
            mut match_ok := true
            mut j := 0
            while j < n_len {
                if buf_get(gf.raw, t_name_start + j) != str_byte(name, j) {
                    match_ok = false
                    break
                }
                j += 1
            }
            if match_ok { return i }
        }
        i += 1
    }
    return -1
}

fn gguf_tensor_type(gf: GgufFile, tensor_idx: i64) -> i64 {
    if tensor_idx < 0 or tensor_idx >= gf.tensor_count { return -1 }
    return ibuf_get(gf.tensor_meta, tensor_idx * 8 + 5)
}

fn gguf_tensor_elements(gf: GgufFile, tensor_idx: i64) -> i64 {
    if tensor_idx < 0 or tensor_idx >= gf.tensor_count { return 0 }
    return ibuf_get(gf.tensor_meta, tensor_idx * 8 + 7)
}

// --- Dequantization Kernels ---

// 1. F16 -> F32 Dequantization Kernel
fn gguf_dequant_f16(raw_buf: ByteBuf, in_offset: i64, num_elements: i64, out_f32_ptr: i64) {
    if out_f32_ptr == 0 or num_elements <= 0 or in_offset < 0 { return }
    scratch := mem_alloc_aligned(16)
    if scratch == 0 { return }
    mut i := 0
    while i < num_elements {
        off := in_offset + i * 2
        u16 := buf_get(raw_buf, off) | (buf_get(raw_buf, off + 1) << 8)
        val := fp16_to_f32(scratch, u16)
        ptr_write_f32(out_f32_ptr, i, val)
        i += 1
    }
    mem_free_aligned(scratch)
}

// 2. Q8_0 -> F32 Dequantization Kernel (Block size = 32 elements, 34 bytes per block in standard GGML)
// Block layout:
//   [0..2]  d: fp16 scale
//   [2..34] 32 signed int8 quants
fn gguf_dequant_q8_0(raw_buf: ByteBuf, in_offset: i64, num_elements: i64, out_f32_ptr: i64) {
    if out_f32_ptr == 0 or num_elements <= 0 or in_offset < 0 { return }
    scratch := mem_alloc_aligned(16)
    if scratch == 0 { return }
    num_blocks := num_elements / 32
    mut b := 0
    while b < num_blocks {
        block_off := in_offset + b * 34
        scale_u16 := buf_get(raw_buf, block_off) | (buf_get(raw_buf, block_off + 1) << 8)
        delta := fp16_to_f32(scratch, scale_u16)

        out_base := b * 32
        mut j := 0
        while j < 32 {
            raw_byte := buf_get(raw_buf, block_off + 2 + j)
            signed_q := (raw_byte << 56) >> 56
            ptr_write_f32(out_f32_ptr, out_base + j, (signed_q as f64) * delta)
            j += 1
        }
        b += 1
    }
    mem_free_aligned(scratch)
}

// 3. Q4_K -> F32 Dequantization Kernel (Block size = 256 weights, 144 bytes per block)
// Layout of GGML block_q4_K (144 bytes):
//   d: fp16 (2 bytes)
//   dmin: fp16 (2 bytes)
//   scales: 12 bytes (6-bit packed scales and mins for 8 sub-blocks of 32 weights)
//   qs: 128 bytes (256 4-bit nibbles, 4 chunks of 64: 32 low nibbles + 32 high nibbles)
fn gguf_dequant_q4_k(raw_buf: ByteBuf, in_offset: i64, num_elements: i64, out_f32_ptr: i64) {
    if out_f32_ptr == 0 or num_elements <= 0 or in_offset < 0 { return }
    scratch := mem_alloc_aligned(16)
    if scratch == 0 { return }
    num_superblocks := num_elements / 256
    mut sb := 0
    while sb < num_superblocks {
        b_off := in_offset + sb * 144
        d_u16 := buf_get(raw_buf, b_off) | (buf_get(raw_buf, b_off + 1) << 8)
        dmin_u16 := buf_get(raw_buf, b_off + 2) | (buf_get(raw_buf, b_off + 3) << 8)
        d := fp16_to_f32(scratch, d_u16)
        dmin := fp16_to_f32(scratch, dmin_u16)

        sc_off := b_off + 4
        qs_off := b_off + 16
        out_sb := sb * 256

        // Standard GGML Q4_K unpacking: 4 chunks of 64 weights (2 sub-blocks of 32 each)
        mut chunk := 0
        while chunk < 4 {
            sub0 := chunk * 2
            sub1 := sub0 + 1

            mut sc0 := 0
            mut m0 := 0
            if sub0 < 4 {
                sc0 = buf_get(raw_buf, sc_off + sub0) & 63
                m0 = buf_get(raw_buf, sc_off + sub0 + 4) & 63
            } else {
                sc0 = (buf_get(raw_buf, sc_off + sub0 + 4) & 0x0F) | ((buf_get(raw_buf, sc_off + sub0 - 4) >> 6) << 4)
                m0 = (buf_get(raw_buf, sc_off + sub0 + 4) >> 4) | ((buf_get(raw_buf, sc_off + sub0) >> 6) << 4)
            }

            mut sc1 := 0
            mut m1 := 0
            if sub1 < 4 {
                sc1 = buf_get(raw_buf, sc_off + sub1) & 63
                m1 = buf_get(raw_buf, sc_off + sub1 + 4) & 63
            } else {
                sc1 = (buf_get(raw_buf, sc_off + sub1 + 4) & 0x0F) | ((buf_get(raw_buf, sc_off + sub1 - 4) >> 6) << 4)
                m1 = (buf_get(raw_buf, sc_off + sub1 + 4) >> 4) | ((buf_get(raw_buf, sc_off + sub1) >> 6) << 4)
            }

            d0 := d * (sc0 as f64)
            min0 := dmin * (m0 as f64)
            d1 := d * (sc1 as f64)
            min1 := dmin * (m1 as f64)

            c_qs := qs_off + chunk * 32
            c_out := out_sb + chunk * 64
            mut j := 0
            while j < 32 {
                byte_val := buf_get(raw_buf, c_qs + j)
                q_lo := byte_val & 0x0F
                q_hi := (byte_val >> 4) & 0x0F
                ptr_write_f32(out_f32_ptr, c_out + j,      (q_lo as f64) * d0 - min0)
                ptr_write_f32(out_f32_ptr, c_out + 32 + j, (q_hi as f64) * d1 - min1)
                j += 1
            }
            chunk += 1
        }
        sb += 1
    }
    mem_free_aligned(scratch)
}

// Universal tensor dequantization dispatcher:
// Reads tensor from GGUF file buffer and converts to float32 array at `out_f32_ptr`.
fn gguf_dequant_tensor(gf: GgufFile, tensor_idx: i64, out_f32_ptr: i64, out_cap_floats: i64 = -1) -> bool {
    if out_f32_ptr == 0 or tensor_idx < 0 or tensor_idx >= gf.tensor_count { return false }
    base := tensor_idx * 8
    dtype := ibuf_get(gf.tensor_meta, base + 5)
    rel_off := ibuf_get(gf.tensor_meta, base + 6)
    numel := ibuf_get(gf.tensor_meta, base + 7)
    if numel <= 0 or numel > 1073741824 { return false }
    if out_cap_floats >= 0 and numel > out_cap_floats { return false }

    raw_len := buf_len(gf.raw)
    if gf.data_start < 0 or gf.data_start > raw_len or rel_off < 0 or rel_off > raw_len - gf.data_start {
        return false
    }
    abs_off := gf.data_start + rel_off

    mut req_bytes := 0
    if dtype == ggml_type_f32() {
        req_bytes = numel * 4
    } else if dtype == ggml_type_f16() {
        req_bytes = numel * 2
    } else if dtype == ggml_type_q8_0() {
        if (numel % 32) != 0 { return false }
        req_bytes = (numel / 32) * 34
    } else if dtype == ggml_type_q4_k() {
        if (numel % 256) != 0 { return false }
        req_bytes = (numel / 256) * 144
    } else {
        return false
    }

    if req_bytes < 0 or req_bytes > raw_len - abs_off {
        return false
    }

    if dtype == ggml_type_f32() {
        scratch := mem_alloc_aligned(16)
        if scratch == 0 { return false }
        mut i := 0
        while i < numel {
            off := abs_off + i * 4
            bits := gguf_read_u32(gf.raw, off)
            ptr_write_i64(scratch, 0, bits)
            val := ptr_read_f32(scratch, 0)
            ptr_write_f32(out_f32_ptr, i, val)
            i += 1
        }
        mem_free_aligned(scratch)
        return true
    } else if dtype == ggml_type_f16() {
        gguf_dequant_f16(gf.raw, abs_off, numel, out_f32_ptr)
        return true
    } else if dtype == ggml_type_q8_0() {
        gguf_dequant_q8_0(gf.raw, abs_off, numel, out_f32_ptr)
        return true
    } else if dtype == ggml_type_q4_k() {
        gguf_dequant_q4_k(gf.raw, abs_off, numel, out_f32_ptr)
        return true
    }
    return false
}

// --- Mock GGUF File Generator for Testing ---
// Creates a valid GGUF v3 file containing metadata, tensor descriptors, and real quantized payload.
fn gguf_create_mock_file(path: str, tensor_name: str, tensor_type: i64, num_elements: i64) -> i64 ! i64 {
    if num_elements <= 0 or num_elements > 67108864 { return err(400) }
    mut payload_cap := num_elements * 4
    if tensor_type == ggml_type_f16() { payload_cap = num_elements * 2 }
    else if tensor_type == ggml_type_q8_0() { payload_cap = (num_elements / 32 + 1) * 34 }
    else if tensor_type == ggml_type_q4_k() { payload_cap = (num_elements / 256 + 1) * 144 }
    out := buf_new(256 + str_len(tensor_name) + payload_cap)

    // 1. Header
    buf_push_u32(out, gguf_magic()) // magic "GGUF"
    buf_push_u32(out, 3)            // version 3
    buf_push_u64(out, 1)            // tensor_count = 1
    buf_push_u64(out, 1)            // metadata_kv_count = 1

    // 2. Metadata KV (key: "general.architecture" -> "llama")
    arch_key := "general.architecture"
    buf_push_u64(out, str_len(arch_key))
    buf_push_str(out, arch_key)
    buf_push_u32(out, gguf_val_string())
    val_str := "axon-llm"
    buf_push_u64(out, str_len(val_str))
    buf_push_str(out, val_str)

    // 3. Tensor Descriptor Table
    buf_push_u64(out, str_len(tensor_name))
    buf_push_str(out, tensor_name)
    if num_elements >= 32 and (num_elements % 32) == 0 {
        buf_push_u32(out, 2)            // n_dimensions = 2
        buf_push_u64(out, 32)           // dim 0 = 32
        buf_push_u64(out, num_elements / 32) // dim 1
    } else {
        buf_push_u32(out, 1)            // n_dimensions = 1
        buf_push_u64(out, num_elements)
    }
    buf_push_u32(out, tensor_type)  // dtype
    buf_push_u64(out, 0)            // offset = 0

    // 4. Align to 32 bytes
    rem := buf_len(out) % 32
    if rem != 0 {
        pad := 32 - rem
        mut p := 0
        while p < pad {
            buf_push(out, 0)
            p += 1
        }
    }

    // 5. Payload according to type
    if tensor_type == ggml_type_f32() {
        mut i := 0
        while i < num_elements {
            buf_push_u32(out, 0x3F800000) // 1.0f in IEEE-754
            i += 1
        }
    } else if tensor_type == ggml_type_f16() {
        mut i := 0
        while i < num_elements {
            buf_push_u16(out, 0x3C00) // 1.0 in FP16
            i += 1
        }
    } else if tensor_type == ggml_type_q8_0() {
        blocks := num_elements / 32
        mut b := 0
        while b < blocks {
            buf_push_u16(out, 0x3C00) // scale d = 1.0 in FP16
            mut j := 0
            while j < 32 {
                buf_push(out, j & 0x7F) // signed int8 quants 0..31
                j += 1
            }
            b += 1
        }
    } else if tensor_type == ggml_type_q4_k() {
        blocks := num_elements / 256
        mut b := 0
        while b < blocks {
            buf_push_u16(out, 0x3C00) // d = 1.0
            buf_push_u16(out, 0x0000) // dmin = 0.0
            mut s := 0
            while s < 12 { buf_push(out, 0x11); s += 1 } // scales
            mut q := 0
            while q < 128 { buf_push(out, 0x42); q += 1 } // nibbles: 2 and 4
            b += 1
        }
    }

    wr := fs_write_file(path, out) or -1
    buf_free(move out)
    if wr < 0 { return err(500) }
    return ok(wr)
}
