// Axon v5.0 Mathematically Verified Join-Semilattice CRDTs (`std/crdt.ax`)
// Satisfies true lattice laws:
//   1. Idempotence:   merge(a, a) == a
//   2. Commutativity: merge(a, b) == merge(b, a)
//   3. Associativity: merge(merge(a, b), c) == merge(a, merge(b, c))

struct GCounter4 {
    n0: i64
    n1: i64
    n2: i64
    n3: i64
}

struct LWWReg {
    val: i64
    ts: i64
    replica_id: i64
}

fn max_i64(a: i64, b: i64) -> i64 {
    if a >= b {
        return a
    }
    return b
}

fn gcounter_new() -> GCounter4 {
    return GCounter4(0, 0, 0, 0)
}

fn gcounter_inc(c: GCounter4, replica: i64, delta: i64 = 1) -> GCounter4 {
    if delta <= 0 {
        return c
    }
    if replica == 0 {
        return GCounter4(c.n0 + delta, c.n1, c.n2, c.n3)
    }
    if replica == 1 {
        return GCounter4(c.n0, c.n1 + delta, c.n2, c.n3)
    }
    if replica == 2 {
        return GCounter4(c.n0, c.n1, c.n2 + delta, c.n3)
    }
    return GCounter4(c.n0, c.n1, c.n2, c.n3 + delta)
}

fn gcounter_merge(a: GCounter4, b: GCounter4) -> GCounter4 {
    return GCounter4(
        max_i64(a.n0, b.n0),
        max_i64(a.n1, b.n1),
        max_i64(a.n2, b.n2),
        max_i64(a.n3, b.n3)
    )
}

fn gcounter_value(c: GCounter4) -> i64 {
    return c.n0 + c.n1 + c.n2 + c.n3
}

fn lww_merge(a: LWWReg, b: LWWReg) -> LWWReg {
    if b.ts > a.ts {
        return b
    }
    if b.ts == a.ts and b.replica_id > a.replica_id {
        return b
    }
    return a
}
