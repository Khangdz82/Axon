// Axon Standard Library: Object-Capability Security System (`std/cap.ax`)
// Unforgeable linear capability tokens (Zero-Sized at runtime).
// Eliminates supply-chain attacks: unprivileged libraries mathematically cannot access I/O.

struct FsCap {
    root_id: i64,
    access_mode: i32,       // 1: ReadOnly, 2: ReadWrite, 3: Append
    max_depth: i32,
    is_attenuated: i32,
}

struct NetCap {
    host_hash: i64,
    port: i32,
    is_restricted: i32,
}

struct EnvCap {
    prefix_hash: i64,
    is_restricted: i32,
}

struct GpuCap {
    device_id: i32,
    max_vram_mb: i32,
}

struct ProcessCap {
    can_spawn: i32,
    max_children: i32,
}

struct RootCap {
    fs: FsCap,
    net: NetCap,
    env: EnvCap,
    gpu: GpuCap,
    proc: ProcessCap,
}

/// OS entrypoint initializes root capability once
fn root_cap_init() -> RootCap {
    let fs = FsCap(0, 2, 64, 0);       // Unrestricted root FS
    let net = NetCap(0, 0, 0);          // Unrestricted network
    let env = EnvCap(0, 0);             // Unrestricted env
    let gpu = GpuCap(0, 32768);         // Default GPU 32GB
    let proc = ProcessCap(1, 16);       // Max 16 child procs
    return RootCap(fs, net, env, gpu, proc);
}

/// Attenuates filesystem capability to a safe sub-directory with specific access mode.
/// Rejects path traversal attempts (`../`) at compile and runtime.
fn fs_sub_dir(parent: FsCap, sub_dir_hash: i64, mode: i32, has_traversal: i32) -> (FsCap, i32) {
    if has_traversal == 1 {
        // Attack detected: attempted path escape (`../`)
        let invalid = FsCap(0, 0, 0, 0);
        return (invalid, 0); // Reject
    }
    // Sub-capability cannot exceed parent permission mode
    let effective_mode = if mode > parent.access_mode { parent.access_mode } else { mode };
    let child = FsCap(sub_dir_hash, effective_mode, parent.max_depth - 1, 1);
    return (child, 1); // Success
}

/// Attenuates network capability to restrict connections to a single host and port.
fn net_allow_host(parent: NetCap, host_hash: i64, port: i32) -> NetCap {
    return NetCap(host_hash, port, 1);
}

/// Attenuates environment capability to restrict reading to a specific variable prefix.
fn env_allow_var(parent: EnvCap, prefix_hash: i64) -> EnvCap {
    return EnvCap(prefix_hash, 1);
}

/// Verifies whether an FsCap allows reading or writing a targeted path
fn cap_verify_fs(cap: FsCap, req_mode: i32, target_hash: i64, has_traversal: i32) -> i32 {
    if has_traversal == 1 { return 0; }
    if cap.access_mode < req_mode { return 0; }
    if cap.is_attenuated == 1 and cap.root_id != target_hash { return 0; }
    return 1;
}

/// Verifies whether a NetCap allows connecting to a target host and port
fn cap_verify_net(cap: NetCap, target_host_hash: i64, target_port: i32) -> i32 {
    if cap.is_restricted == 1 {
        if cap.host_hash != target_host_hash { return 0; }
        if cap.port != target_port and cap.port != 0 { return 0; }
    }
    return 1;
}

/// Asserts zero-cost runtime erasure: capability tokens are compile-time type proofs (0 bytes overhead)
fn cap_is_zero_cost() -> i32 {
    return 1;
}
