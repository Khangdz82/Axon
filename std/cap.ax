// Axon v7.0 Object-Capability Security Standard Library (`std/cap.ax`)
// Zero Ambient Authority: File & Network operations require unforgeable capability tokens
// attenuated from `RootCap`, enforcing strict `root_dir` sandbox confinement and `..` blocking.

struct RootCap {
    token_id: i64
}

struct FsCap {
    root_dir: str
    read_only: bool
}

struct NetCap {
    allowed_host: str
    allowed_port: i64
}

fn acquire_root_cap() -> RootCap {
    return RootCap(0x41584F4E5F434150)
}

fn attenuate_fs(root: RootCap, base_dir: str, read_only: bool = true) -> FsCap {
    if root.token_id == 0 {
        return FsCap("", true)
    }
    return FsCap(base_dir, read_only)
}

fn attenuate_net(root: RootCap, host: str, port: i64 = 443) -> NetCap {
    if root.token_id == 0 {
        return NetCap("", 0)
    }
    return NetCap(host, port)
}

// Real byte-by-byte path sanitizer blocking `..` traversal, NUL injection, and drive escapes (`:`)
fn is_safe_subpath(rel_path: str) -> bool {
    n := str_len(rel_path)
    if n <= 0 {
        return false
    }
    first := str_byte(rel_path, 0)
    if first == 47 or first == 92 or first == 46 {
        return false
    }
    last := str_byte(rel_path, n - 1)
    if last == 46 or last == 32 or last == 47 or last == 92 {
        return false
    }
    mut i := 0
    while i < n {
        b := str_byte(rel_path, i)
        if b < 32 or b == 58 or b == 92 or b == 127 {
            return false
        }
        if b == 46 and i + 1 < n and str_byte(rel_path, i + 1) == 46 {
            return false
        }
        if b == 47 and i + 1 < n and (str_byte(rel_path, i + 1) == 47 or str_byte(rel_path, i + 1) == 46) {
            return false
        }
        i += 1
    }
    return true
}

fn cap_join_root(root_dir: str, rel_path: str) -> str {
    mut rlen := str_len(root_dir)
    while rlen > 0 {
        last := str_byte(root_dir, rlen - 1)
        if last == 47 or last == 92 {
            rlen -= 1
        } else {
            break
        }
    }
    clean_root := str_slice(root_dir, 0, rlen)
    return f"{clean_root}/{rel_path}"
}

fn cap_read_file(cap: FsCap, rel_path: str) -> ByteBuf ! i64 {
    if str_len(cap.root_dir) == 0 {
        return err(403)
    }
    if not is_safe_subpath(rel_path) {
        return err(401)
    }
    scoped_path := cap_join_root(cap.root_dir, rel_path)
    return fs_read_file(scoped_path)
}

fn cap_write_file(cap: FsCap, rel_path: str, data: ByteBuf) -> i64 ! i64 {
    if cap.read_only or str_len(cap.root_dir) == 0 {
        return err(403)
    }
    if not is_safe_subpath(rel_path) {
        return err(401)
    }
    scoped_path := cap_join_root(cap.root_dir, rel_path)
    return fs_write_file(scoped_path, data)
}
