// Axon v7.0 Object-Capability Security Standard Library (`std/cap.ax`)
// Zero Ambient Authority: File & Network operations require unforgeable capability tokens
// attenuated from `RootCap`, enforcing strict `root_dir` sandbox confinement and `..` blocking.

struct RootCap {
    token_id: i64
}

struct FsCap {
    root_dir: str
    read_only: bool
}

struct NetCap {
    allowed_host: str
    allowed_port: i64
}

fn acquire_root_cap() -> RootCap {
    return RootCap(0x41584F4E5F434150)
}

fn attenuate_fs(root: RootCap, base_dir: str, read_only: bool = true) -> FsCap {
    if root.token_id == 0 {
        return FsCap("", true)
    }
    return FsCap(base_dir, read_only)
}

fn attenuate_net(root: RootCap, host: str, port: i64 = 443) -> NetCap {
    if root.token_id == 0 {
        return NetCap("", 0)
    }
    return NetCap(host, port)
}

fn _cap_ascii_upper(b: i64) -> i64 {
    if b >= 97 and b <= 122 { return b - 32 }
    return b
}

fn _cap_is_win_reserved(rel_path: str, st: i64, en: i64) -> bool {
    // Check segment base name (up to first '.') against CON, PRN, AUX, NUL, COM1..9, LPT1..9
    mut b_en := st
    while b_en < en and str_byte(rel_path, b_en) != 46 { b_en += 1 }
    bl := b_en - st
    if bl == 3 {
        c0 := _cap_ascii_upper(str_byte(rel_path, st))
        c1 := _cap_ascii_upper(str_byte(rel_path, st + 1))
        c2 := _cap_ascii_upper(str_byte(rel_path, st + 2))
        if (c0 == 67 and c1 == 79 and c2 == 78) or (c0 == 80 and c1 == 82 and c2 == 78) or
           (c0 == 65 and c1 == 85 and c2 == 88) or (c0 == 78 and c1 == 85 and c2 == 76) {
            return true
        }
    } else if bl == 4 {
        c0 := _cap_ascii_upper(str_byte(rel_path, st))
        c1 := _cap_ascii_upper(str_byte(rel_path, st + 1))
        c2 := _cap_ascii_upper(str_byte(rel_path, st + 2))
        c3 := str_byte(rel_path, st + 3)
        if c3 >= 49 and c3 <= 57 {
            if (c0 == 67 and c1 == 79 and c2 == 77) or (c0 == 76 and c1 == 80 and c2 == 84) {
                return true
            }
        }
    }
    return false
}

// Real byte-by-byte path sanitizer blocking `..` traversal, NUL injection, drive escapes (`:`),
// Windows reserved device names (CON/PRN/AUX/NUL/COM1..9/LPT1..9), and trailing dots/spaces per segment
fn is_safe_subpath(rel_path: str) -> bool {
    n := str_len(rel_path)
    if n <= 0 {
        return false
    }
    first := str_byte(rel_path, 0)
    if first == 47 or first == 92 or first == 46 {
        return false
    }
    last := str_byte(rel_path, n - 1)
    if last == 46 or last == 32 or last == 47 or last == 92 {
        return false
    }
    mut seg_start := 0
    mut i := 0
    while i < n {
        b := str_byte(rel_path, i)
        if b < 32 or b == 58 or b == 92 or b == 127 {
            return false
        }
        if b == 46 and i + 1 < n and str_byte(rel_path, i + 1) == 46 {
            return false
        }
        if b == 47 {
            if i == seg_start { return false }
            prev_b := str_byte(rel_path, i - 1)
            if prev_b == 46 or prev_b == 32 { return false }
            if _cap_is_win_reserved(rel_path, seg_start, i) { return false }
            if i + 1 < n and (str_byte(rel_path, i + 1) == 47 or str_byte(rel_path, i + 1) == 46) {
                return false
            }
            seg_start = i + 1
        }
        i += 1
    }
    if _cap_is_win_reserved(rel_path, seg_start, n) { return false }
    return true
}

fn cap_join_root(root_dir: str, rel_path: str) -> str {
    mut rlen := str_len(root_dir)
    while rlen > 0 {
        last := str_byte(root_dir, rlen - 1)
        if last == 47 or last == 92 {
            rlen -= 1
        } else {
            break
        }
    }
    clean_root := str_slice(root_dir, 0, rlen)
    return f"{clean_root}/{rel_path}"
}

fn cap_read_file(cap: FsCap, rel_path: str) -> ByteBuf ! i64 {
    if str_len(cap.root_dir) == 0 {
        return err(403)
    }
    if not is_safe_subpath(rel_path) {
        return err(401)
    }
    scoped_path := cap_join_root(cap.root_dir, rel_path)
    return fs_read_file(scoped_path)
}

fn cap_write_file(cap: FsCap, rel_path: str, data: ByteBuf) -> i64 ! i64 {
    if cap.read_only or str_len(cap.root_dir) == 0 {
        return err(403)
    }
    if not is_safe_subpath(rel_path) {
        return err(401)
    }
    scoped_path := cap_join_root(cap.root_dir, rel_path)
    return fs_write_file(scoped_path, data)
}
