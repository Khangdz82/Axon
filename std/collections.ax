// Axon Standard Library: High-Performance Collections
/// Hash table bucket entry for Robin Hood linear probing hash table.
struct HashEntry {
    key: i64,
    val: i64,
    hash: i64,
    is_occupied: i32,
}

/// Flat power-of-two open-addressing hash map with zero pointer indirection.
struct FlatHashMap {
    capacity: i32,
    count: i32,
    mask: i32,
}

/// Cache-conscious circular buffer for lockless single-producer single-consumer queues.
struct RingBuffer {
    head: i32,
    tail: i32,
    capacity: i32,
    mask: i32,
}

/// Creates a new FlatHashMap with power-of-two capacity.
fn hashmap_create(cap: i32) -> FlatHashMap {
    let mask = cap - 1;
    return FlatHashMap(cap, 0, mask);
}

/// Creates a power-of-two bounded ring buffer queue.
fn ringbuf_create(cap: i32) -> RingBuffer {
    let mask = cap - 1;
    return RingBuffer(0, 0, cap, mask);
}

/// Pushes an integer into the ring buffer. Returns 1 on success, 0 when full.
fn ringbuf_push(mut rb: RingBuffer, val: i32) -> i32 {
    let next_tail = (rb.tail + 1) % rb.capacity;
    if next_tail == rb.head {
        return 0; // Buffer full
    }
    rb.tail = next_tail;
    return 1;
}

/// Pops an element from the ring buffer. Returns 1 on success, 0 when empty.
fn ringbuf_pop(mut rb: RingBuffer) -> i32 {
    if rb.head == rb.tail {
        return 0; // Buffer empty
    }
    let next_head = (rb.head + 1) % rb.capacity;
    rb.head = next_head;
    return 1;
}
