// Axon v6.0 Standard Collections (`std/collections.ax`)
// Zero-GC Open-Addressing 64-Bit Hash Map (`IntMap`) & LIFO Stack backed by Perceus `IntBuf`.

fn hash_i64_slot(key: i64, mask: i64) -> i64 {
    mut h := key ^ ushr64(key, 30)
    h = h *% 0x517CC1B727220A95
    h = h ^ ushr64(h, 27)
    return h & mask
}

fn map_new(cap_hint: i64 = 256) -> IntBuf {
    mut cap := 16
    while cap < cap_hint {
        cap = cap << 1
    }
    total := 2 + cap * 3
    m := ibuf_new(total + 16)
    ibuf_push(m, cap - 1)
    ibuf_push(m, 0)
    mut i := 0
    total_cells := cap * 3
    while i < total_cells {
        ibuf_push(m, 0)
        i += 1
    }
    return m
}

fn map_len(m: IntBuf) -> i64 {
    return ibuf_get(m, 1)
}

fn map_put(m: IntBuf, key: i64, val: i64) -> bool {
    mask := ibuf_get(m, 0)
    cap := mask + 1
    mut idx := hash_i64_slot(key, mask)
    mut first_tomb := -1
    mut probes := 0
    while probes < cap {
        base := 2 + idx * 3
        st := ibuf_get(m, base)
        if st == 0 {
            mut target := base
            if first_tomb >= 0 {
                target = first_tomb
            }
            ibuf_set(m, target, 1)
            ibuf_set(m, target + 1, key)
            ibuf_set(m, target + 2, val)
            ibuf_set(m, 1, ibuf_get(m, 1) + 1)
            return true
        }
        if st == 1 and ibuf_get(m, base + 1) == key {
            ibuf_set(m, base + 2, val)
            return true
        }
        if st == 2 and first_tomb < 0 {
            first_tomb = base
        }
        idx = (idx + 1) & mask
        probes += 1
    }
    if first_tomb >= 0 {
        ibuf_set(m, first_tomb, 1)
        ibuf_set(m, first_tomb + 1, key)
        ibuf_set(m, first_tomb + 2, val)
        ibuf_set(m, 1, ibuf_get(m, 1) + 1)
        return true
    }
    return false
}

fn map_get(m: IntBuf, key: i64, default_val: i64 = 0) -> i64 {
    mask := ibuf_get(m, 0)
    cap := mask + 1
    mut idx := hash_i64_slot(key, mask)
    mut probes := 0
    while probes < cap {
        base := 2 + idx * 3
        st := ibuf_get(m, base)
        if st == 0 {
            return default_val
        }
        if st == 1 and ibuf_get(m, base + 1) == key {
            return ibuf_get(m, base + 2)
        }
        idx = (idx + 1) & mask
        probes += 1
    }
    return default_val
}

fn map_contains(m: IntBuf, key: i64) -> bool {
    mask := ibuf_get(m, 0)
    cap := mask + 1
    mut idx := hash_i64_slot(key, mask)
    mut probes := 0
    while probes < cap {
        base := 2 + idx * 3
        st := ibuf_get(m, base)
        if st == 0 {
            return false
        }
        if st == 1 and ibuf_get(m, base + 1) == key {
            return true
        }
        idx = (idx + 1) & mask
        probes += 1
    }
    return false
}

fn map_remove(m: IntBuf, key: i64) -> bool {
    mask := ibuf_get(m, 0)
    cap := mask + 1
    mut idx := hash_i64_slot(key, mask)
    mut probes := 0
    while probes < cap {
        base := 2 + idx * 3
        st := ibuf_get(m, base)
        if st == 0 {
            return false
        }
        if st == 1 and ibuf_get(m, base + 1) == key {
            ibuf_set(m, base, 2)
            ibuf_set(m, 1, ibuf_get(m, 1) - 1)
            return true
        }
        idx = (idx + 1) & mask
        probes += 1
    }
    return false
}

fn stack_new(cap_hint: i64 = 256) -> IntBuf {
    s := ibuf_new(cap_hint + 4)
    ibuf_push(s, 0)
    return s
}

fn stack_len(s: IntBuf) -> i64 {
    return ibuf_get(s, 0)
}

fn stack_push(s: IntBuf, val: i64) {
    top := ibuf_get(s, 0) + 1
    if top < ibuf_len(s) {
        ibuf_set(s, top, val)
    } else {
        ibuf_push(s, val)
    }
    ibuf_set(s, 0, top)
}

fn stack_pop(s: IntBuf, default_val: i64 = 0) -> i64 {
    top := ibuf_get(s, 0)
    if top <= 0 {
        return default_val
    }
    v := ibuf_get(s, top)
    ibuf_set(s, 0, top - 1)
    return v
}
