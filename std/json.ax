// Axon v6.0 Zero-Allocation JSON Scanner & Compact Builder (`std/json.ax`)
// Scans JSON fields directly in-place (`0` heap allocations on read) and writes compact JSON into `ByteBuf`.

use std::os

fn _json_swar_has_q_or_bs(w: i64) -> bool {
    m01 := 0x0101010101010101
    m80 := (0x80808080 << 32) | 0x80808080
    xq := w ^ 0x2222222222222222
    xb := w ^ 0x5C5C5C5C5C5C5C5C
    hq := (xq -% m01) & ((0 - 1) ^ xq) & m80
    hb := (xb -% m01) & ((0 - 1) ^ xb) & m80
    return ((hq | hb)) != 0
}

fn json_skip_ws(doc: str, start: i64) -> i64 {
    unsafe {
    n := str_len(doc)
    doc_p := doc as i64
    mut i := start
    if i < 0 { i = 0 }
    while i < n {
        b := ptr_read_u8(doc_p + i, 0)
        if b == 32 or b == 9 or b == 10 or b == 13 {
            i += 1
        } else {
            break
        }
    }
    return i
    }
}

fn json_is_delim(b: i64) -> bool {
    return b == 32 or b == 9 or b == 10 or b == 13 or b == 44 or b == 125 or b == 93
}

// Finds `"<key>"` followed by `:` outside string values and returns the byte index of the value start, or `-1`.
// Tracks `{}`/`[]` nesting depth so top-level keys (`depth == 1`) ALWAYS take priority over attacker-controlled nested keys!
fn json_locate_key_val(doc: str, key: str) -> i64 {
    unsafe {
    n := str_len(doc)
    klen := str_len(key)
    if klen <= 0 or n < klen + 3 {
        return -1
    }

    doc_p := doc as i64
    key_p := key as i64
    k0 := ptr_read_u8(key_p, 0)
    mut i := 0
    mut depth := 0
    mut nested_fallback := -1

    while i < n {
        ch := ptr_read_u8(doc_p + i, 0)
        if ch == 123 or ch == 91 { // '{' or '['
            depth += 1
            i += 1
            continue
        }
        if ch == 125 or ch == 93 { // '}' or ']'
            if depth > 0 { depth -= 1 }
            i += 1
            continue
        }
        if ch != 34 {
            i += 1
            continue
        }

        kstart := i + 1
        // Check if candidate matches key length and unescaped closing quote
        if kstart + klen < n and ptr_read_u8(doc_p + kstart + klen, 0) == 34 and ptr_read_u8(doc_p + kstart, 0) == k0 {
            mut match_k := true
            mut ki := 1
            while ki < klen {
                if ptr_read_u8(doc_p + kstart + ki, 0) != ptr_read_u8(key_p + ki, 0) {
                    match_k = false
                    break
                }
                ki += 1
            }
            if match_k {
                mut bs := 0
                mut bp := kstart + klen - 1
                while bp >= kstart and ptr_read_u8(doc_p + bp, 0) == 92 {
                    bs += 1
                    bp -= 1
                }
                if (bs & 1) == 0 {
                    after_q := json_skip_ws(doc, kstart + klen + 1)
                    if after_q < n and ptr_read_u8(doc_p + after_q, 0) == 58 {
                        val_pos := json_skip_ws(doc, after_q + 1)
                        if depth <= 1 {
                            return val_pos
                        } else if nested_fallback < 0 {
                            nested_fallback = val_pos
                        }
                    }
                }
            }
        }

        // Skip to closing quote of this string token (SWAR 8B/cycle + scalar tail)
        mut j := kstart
        while j + 8 <= n {
            if _json_swar_has_q_or_bs(ptr_read_i64(doc_p + j, 0)) { break }
            j += 8
        }
        while j < n {
            bj := ptr_read_u8(doc_p + j, 0)
            if bj == 92 {
                j += 2
            } else if bj == 34 {
                break
            } else {
                j += 1
            }
        }
        if j >= n {
            return nested_fallback
        }
        i = j + 1
    }
    return nested_fallback
    }
}

fn _json_hex_val(b: i64) -> i64 {
    if b >= 48 and b <= 57 { return b - 48 }
    if b >= 65 and b <= 70 { return b - 55 }
    if b >= 97 and b <= 102 { return b - 87 }
    return -1
}

fn _json_push_utf8(out: ByteBuf, cp: i64) {
    if cp < 0x80 {
        buf_push(out, cp)
    } else if cp < 0x800 {
        buf_push(out, 0xC0 | (cp >> 6))
        buf_push(out, 0x80 | (cp & 0x3F))
    } else if cp < 0x10000 {
        buf_push(out, 0xE0 | (cp >> 12))
        buf_push(out, 0x80 | ((cp >> 6) & 0x3F))
        buf_push(out, 0x80 | (cp & 0x3F))
    } else {
        buf_push(out, 0xF0 | (cp >> 18))
        buf_push(out, 0x80 | ((cp >> 12) & 0x3F))
        buf_push(out, 0x80 | ((cp >> 6) & 0x3F))
        buf_push(out, 0x80 | (cp & 0x3F))
    }
}

// RFC-8259 JSON string content unescaper (handles `\"`, `\\`, `\/`, `\b`, `\f`, `\n`, `\r`, `\t`, `\uXXXX` + UTF-16 surrogate pairs)
fn json_unescape(raw: str) -> str ! i64 {
    n := str_len(raw)
    // Fast zero-alloc check: if no backslash, return input directly
    mut has_bs := false
    mut scan := 0
    while scan < n {
        if str_byte(raw, scan) == 92 { has_bs = true; break }
        scan += 1
    }
    if not has_bs { return ok(raw) }
    out := buf_new(n + 8)
    mut i := 0
    while i < n {
        b := str_byte(raw, i)
        if b != 92 {
            buf_push(out, b)
            i += 1
            continue
        }
        if i + 1 >= n {
            buf_free(move out)
            return err(400)
        }
        e := str_byte(raw, i + 1)
        if e == 34 { buf_push(out, 34); i += 2 }
        else if e == 92 { buf_push(out, 92); i += 2 }
        else if e == 47 { buf_push(out, 47); i += 2 }
        else if e == 98 { buf_push(out, 8); i += 2 }
        else if e == 102 { buf_push(out, 12); i += 2 }
        else if e == 110 { buf_push(out, 10); i += 2 }
        else if e == 114 { buf_push(out, 13); i += 2 }
        else if e == 116 { buf_push(out, 9); i += 2 }
        else if e == 117 {
            if i + 6 > n { buf_free(move out); return err(400) }
            h0 := _json_hex_val(str_byte(raw, i + 2))
            h1 := _json_hex_val(str_byte(raw, i + 3))
            h2 := _json_hex_val(str_byte(raw, i + 4))
            h3 := _json_hex_val(str_byte(raw, i + 5))
            if h0 < 0 or h1 < 0 or h2 < 0 or h3 < 0 { buf_free(move out); return err(400) }
            mut cp := (h0 << 12) | (h1 << 8) | (h2 << 4) | h3
            i += 6
            // UTF-16 surrogate pair `\uD800..\uDBFF` followed by `\uDC00..\uDFFF`
            if cp >= 0xD800 and cp <= 0xDBFF and i + 6 <= n and str_byte(raw, i) == 92 and str_byte(raw, i + 1) == 117 {
                l0 := _json_hex_val(str_byte(raw, i + 2))
                l1 := _json_hex_val(str_byte(raw, i + 3))
                l2 := _json_hex_val(str_byte(raw, i + 4))
                l3 := _json_hex_val(str_byte(raw, i + 5))
                if l0 >= 0 and l1 >= 0 and l2 >= 0 and l3 >= 0 {
                    lo := (l0 << 12) | (l1 << 8) | (l2 << 4) | l3
                    if lo >= 0xDC00 and lo <= 0xDFFF {
                        cp = 0x10000 + (((cp - 0xD800) << 10) | (lo - 0xDC00))
                        i += 6
                    }
                }
            }
            _json_push_utf8(out, cp)
        } else {
            buf_free(move out)
            return err(400)
        }
    }
    res := "" + buf_slice_str(out, 0, buf_len(out))
    buf_free(move out)
    return ok(res)
}

fn json_get_str(doc: str, key: str) -> str ! i64 {
    unsafe {
    vpos := json_locate_key_val(doc, key)
    if vpos < 0 or vpos >= str_len(doc) {
        return err(404)
    }
    doc_p := doc as i64
    if ptr_read_u8(doc_p + vpos, 0) != 34 {
        return err(422)
    }
    n := str_len(doc)
    s_start := vpos + 1
    mut j := s_start
    mut has_esc := false
    while j + 8 <= n {
        if _json_swar_has_q_or_bs(ptr_read_i64(doc_p + j, 0)) { break }
        j += 8
    }
    while j < n {
        bj := ptr_read_u8(doc_p + j, 0)
        if bj == 92 {
            has_esc = true
            j += 2
        } else if bj == 34 {
            raw := str_slice(doc, s_start, j)
            if not has_esc { return ok(raw) }
            return json_unescape(raw)
        } else {
            j += 1
        }
    }
    return err(400)
    }
}

// Extracts raw JSON value slice (object `{...}`, array `[...]`, string `"..."`, or primitive) for `key`
fn json_get_raw(doc: str, key: str) -> str ! i64 {
    vpos := json_locate_key_val(doc, key)
    n := str_len(doc)
    if vpos < 0 or vpos >= n { return err(404) }
    b0 := str_byte(doc, vpos)
    if b0 == 34 {
        mut j := vpos + 1
        while j < n {
            c := str_byte(doc, j)
            if c == 92 { j += 2 }
            else if c == 34 { return ok(str_slice(doc, vpos, j + 1)) }
            else { j += 1 }
        }
        return err(400)
    }
    if b0 == 123 or b0 == 91 {
        mut depth := 0
        mut in_q := false
        mut j := vpos
        while j < n {
            c := str_byte(doc, j)
            if c == 92 and in_q { j += 2; continue }
            if c == 34 { in_q = not in_q }
            else if not in_q {
                if c == 123 or c == 91 { depth += 1 }
                else if c == 125 or c == 93 {
                    depth -= 1
                    if depth == 0 { return ok(str_slice(doc, vpos, j + 1)) }
                }
            }
            j += 1
        }
        return err(400)
    }
    mut j := vpos
    while j < n and not json_is_delim(str_byte(doc, j)) { j += 1 }
    if j <= vpos { return err(400) }
    return ok(str_slice(doc, vpos, j))
}

fn json_get_i64(doc: str, key: str) -> i64 ! i64 {
    unsafe {
    vpos := json_locate_key_val(doc, key)
    if vpos < 0 or vpos >= str_len(doc) {
        return err(404)
    }
    doc_p := doc as i64
    n := str_len(doc)
    mut j := vpos
    mut is_neg := false
    if ptr_read_u8(doc_p + j, 0) == 45 {
        is_neg = true
        j += 1
    }
    mut digits := 0
    // Accumulate in negative space so full signed 64-bit range [INT64_MIN, INT64_MAX]
    // parses cleanly without overflowing under `--shield`.
    mut acc := 0
    while j < n {
        d := ptr_read_u8(doc_p + j, 0)
        if d >= 48 and d <= 57 {
            dig := d - 48
            if acc < -922337203685477580 {
                return err(422)
            }
            if acc == -922337203685477580 {
                if is_neg and dig > 8 { return err(422) }
                if not is_neg and dig > 7 { return err(422) }
            }
            acc = acc * 10 - dig
            digits += 1
            j += 1
        } else {
            break
        }
    }
    if digits == 0 {
        return err(422)
    }
    if j < n and not json_is_delim(ptr_read_u8(doc_p + j, 0)) {
        return err(422)
    }
    if is_neg {
        return ok(acc)
    }
    return ok(0 - acc)
    }
}

fn json_get_bool(doc: str, key: str) -> bool ! i64 {
    unsafe {
    vpos := json_locate_key_val(doc, key)
    if vpos < 0 {
        return err(404)
    }
    doc_p := doc as i64
    n := str_len(doc)
    if vpos + 4 <= n and ptr_read_u8(doc_p + vpos, 0) == 116 and ptr_read_u8(doc_p + vpos + 1, 0) == 114 and ptr_read_u8(doc_p + vpos + 2, 0) == 117 and ptr_read_u8(doc_p + vpos + 3, 0) == 101 {
        if vpos + 4 == n or json_is_delim(ptr_read_u8(doc_p + vpos + 4, 0)) {
            return ok(true)
        }
        return err(422)
    }
    if vpos + 5 <= n and ptr_read_u8(doc_p + vpos, 0) == 102 and ptr_read_u8(doc_p + vpos + 1, 0) == 97 and ptr_read_u8(doc_p + vpos + 2, 0) == 108 and ptr_read_u8(doc_p + vpos + 3, 0) == 115 and ptr_read_u8(doc_p + vpos + 4, 0) == 101 {
        if vpos + 5 == n or json_is_delim(ptr_read_u8(doc_p + vpos + 5, 0)) {
            return ok(false)
        }
        return err(422)
    }
    return err(422)
    }
}

fn json_begin_obj(out: ByteBuf) {
    buf_push(out, 123)
}

fn json_sep_if_needed(out: ByteBuf) {
    cur := buf_len(out)
    if cur > 0 {
        last := buf_get(out, cur - 1)
        if last != 123 and last != 91 and last != 44 {
            buf_push(out, 44)
        }
    }
}

fn json_push_escaped(out: ByteBuf, s: str) {
    n := str_len(s)
    if n <= 0 { return }
    mut run_start := 0
    mut i := 0
    while i < n {
        c := str_byte(s, i)
        if c < 32 or c == 34 or c == 92 {
            if i > run_start {
                buf_push_str(out, str_slice(s, run_start, i))
            }
            if c == 34 {
                buf_push_str(out, "\\\"")
            } else if c == 92 {
                buf_push_str(out, "\\\\")
            } else if c == 8 {
                buf_push_str(out, "\\b")
            } else if c == 12 {
                buf_push_str(out, "\\f")
            } else if c == 10 {
                buf_push_str(out, "\\n")
            } else if c == 13 {
                buf_push_str(out, "\\r")
            } else if c == 9 {
                buf_push_str(out, "\\t")
            } else {
                buf_push_str(out, "\\u00")
                hi := (c >> 4) & 15
                lo := c & 15
                if hi < 10 { buf_push(out, 48 + hi) } else { buf_push(out, 87 + hi) }
                if lo < 10 { buf_push(out, 48 + lo) } else { buf_push(out, 87 + lo) }
            }
            run_start = i + 1
        }
        i += 1
    }
    if run_start == 0 {
        buf_push_str(out, s)
    } else if run_start < n {
        buf_push_str(out, str_slice(s, run_start, n))
    }
}

fn json_kv_str(out: ByteBuf, key: str, val: str) {
    json_sep_if_needed(out)
    buf_push(out, 34)
    json_push_escaped(out, key)
    buf_push_str(out, "\":\"")
    json_push_escaped(out, val)
    buf_push(out, 34)
}

fn json_kv_i64(out: ByteBuf, key: str, val: i64) {
    json_sep_if_needed(out)
    buf_push(out, 34)
    json_push_escaped(out, key)
    buf_push_str(out, "\":")
    buf_append_i64(out, val)
}

fn json_kv_bool(out: ByteBuf, key: str, val: bool) {
    json_sep_if_needed(out)
    buf_push(out, 34)
    json_push_escaped(out, key)
    buf_push_str(out, "\":")
    if val {
        buf_push_str(out, "true")
    } else {
        buf_push_str(out, "false")
    }
}

fn json_end_obj(out: ByteBuf) {
    buf_push(out, 125)
}
