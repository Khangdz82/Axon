// Axon v6.0 Zero-Allocation JSON Scanner & Compact Builder (`std/json.ax`)
// Scans JSON fields directly in-place (`0` heap allocations on read) and writes compact JSON into `ByteBuf`.

use std::os

fn json_skip_ws(doc: str, start: i64) -> i64 {
    n := str_len(doc)
    mut i := start
    while i < n {
        b := str_byte(doc, i)
        if b == 32 or b == 9 or b == 10 or b == 13 {
            i += 1
        } else {
            break
        }
    }
    return i
}

// Finds `"<key>"` followed by `:` outside string values and returns the byte index of the value start, or `-1`.
fn json_locate_key_val(doc: str, key: str) -> i64 {
    n := str_len(doc)
    klen := str_len(key)
    mut i := 0
    while i < n {
        b := str_byte(doc, i)
        if b == 34 {
            kstart := i + 1
            mut j := kstart
            while j < n {
                bj := str_byte(doc, j)
                if bj == 92 {
                    j += 2
                } else if bj == 34 {
                    break
                } else {
                    j += 1
                }
            }
            if j >= n {
                return -1
            }
            after_q := json_skip_ws(doc, j + 1)
            if after_q < n and str_byte(doc, after_q) == 58 {
                if (j - kstart) == klen and str_eq(str_slice(doc, kstart, j), key) {
                    return json_skip_ws(doc, after_q + 1)
                }
            }
            i = j + 1
        } else {
            i += 1
        }
    }
    return -1
}

fn json_get_str(doc: str, key: str) -> str ! i64 {
    vpos := json_locate_key_val(doc, key)
    if vpos < 0 or vpos >= str_len(doc) {
        return err(404)
    }
    if str_byte(doc, vpos) != 34 {
        return err(422)
    }
    n := str_len(doc)
    s_start := vpos + 1
    mut j := s_start
    while j < n {
        bj := str_byte(doc, j)
        if bj == 92 {
            j += 2
        } else if bj == 34 {
            return ok(str_slice(doc, s_start, j))
        } else {
            j += 1
        }
    }
    return err(400)
}

fn json_get_i64(doc: str, key: str) -> i64 ! i64 {
    vpos := json_locate_key_val(doc, key)
    if vpos < 0 or vpos >= str_len(doc) {
        return err(404)
    }
    n := str_len(doc)
    mut j := vpos
    if str_byte(doc, j) == 45 {
        j += 1
    }
    mut digits := 0
    while j < n {
        d := str_byte(doc, j)
        if d >= 48 and d <= 57 {
            digits += 1
            j += 1
        } else {
            break
        }
    }
    if digits == 0 {
        return err(422)
    }
    return parse_i64(str_slice(doc, vpos, j))
}

fn json_get_bool(doc: str, key: str) -> bool ! i64 {
    vpos := json_locate_key_val(doc, key)
    if vpos < 0 {
        return err(404)
    }
    n := str_len(doc)
    if vpos + 4 <= n and str_eq(str_slice(doc, vpos, vpos + 4), "true") {
        return ok(true)
    }
    if vpos + 5 <= n and str_eq(str_slice(doc, vpos, vpos + 5), "false") {
        return ok(false)
    }
    return err(422)
}

fn json_begin_obj(out: ByteBuf) {
    buf_push(out, 123)
}

fn json_sep_if_needed(out: ByteBuf) {
    cur := buf_len(out)
    if cur > 0 {
        last := buf_get(out, cur - 1)
        if last != 123 and last != 91 and last != 44 {
            buf_push(out, 44)
        }
    }
}

fn json_push_escaped(out: ByteBuf, s: str) {
    n := str_len(s)
    mut i := 0
    while i < n {
        c := str_byte(s, i)
        if c == 34 {
            buf_push_str(out, "\\\"")
        } else if c == 92 {
            buf_push_str(out, "\\\\")
        } else if c == 8 {
            buf_push_str(out, "\\b")
        } else if c == 12 {
            buf_push_str(out, "\\f")
        } else if c == 10 {
            buf_push_str(out, "\\n")
        } else if c == 13 {
            buf_push_str(out, "\\r")
        } else if c == 9 {
            buf_push_str(out, "\\t")
        } else if c < 32 {
            buf_push_str(out, "\\u00")
            hi := (c >> 4) & 15
            lo := c & 15
            if hi < 10 { buf_push(out, 48 + hi) } else { buf_push(out, 87 + hi) }
            if lo < 10 { buf_push(out, 48 + lo) } else { buf_push(out, 87 + lo) }
        } else {
            buf_push(out, c)
        }
        i += 1
    }
}

fn json_kv_str(out: ByteBuf, key: str, val: str) {
    json_sep_if_needed(out)
    buf_push(out, 34)
    json_push_escaped(out, key)
    buf_push_str(out, "\":\"")
    json_push_escaped(out, val)
    buf_push(out, 34)
}

fn json_kv_i64(out: ByteBuf, key: str, val: i64) {
    json_sep_if_needed(out)
    buf_push(out, 34)
    json_push_escaped(out, key)
    buf_push_str(out, "\":")
    buf_append_i64(out, val)
}

fn json_kv_bool(out: ByteBuf, key: str, val: bool) {
    json_sep_if_needed(out)
    buf_push(out, 34)
    json_push_escaped(out, key)
    buf_push_str(out, "\":")
    if val {
        buf_push_str(out, "true")
    } else {
        buf_push_str(out, "false")
    }
}

fn json_end_obj(out: ByteBuf) {
    buf_push(out, 125)
}
