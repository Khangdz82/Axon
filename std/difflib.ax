// Axon Standard Library — Unified Diff & Sequence Matcher (`std/difflib.ax`)
// 100% Pure Axon replacement for Python's `difflib.unified_diff` & `SequenceMatcher`:
//   - Prefix/suffix-trimmed Myers/LCS line differ with FNV-1a64 hash acceleration + exact line verification
//   - Standard git/RFC unified diff format (`---`, `+++`, `@@ -a,b +c,d @@`) with configurable context lines
//   - DoS-bounded memory (`MAX_DIFF_WINDOW = 1024` trimmed core lines) with linear fallback for huge files

use std::os
use std::str
use std::ds

fn _diff_split_lines(text: str) -> StrVec {
    mut out := svec_new(32, str_len(text) + 64)
    n := str_len(text)
    if n == 0 { return out }
    mut i := 0
    while i < n {
        mut nl := str_find_byte(text, 10, i)
        if nl < 0 { nl = n }
        mut end := nl
        if end > i and str_byte(text, end - 1) == 13 { end -= 1 }
        svec_push(mut out, str_slice(text, i, end))
        if nl >= n { break }
        i = nl + 1
    }
    return out
}

// Compute edit ops: array of pairs `[op, line_idx]` where op: 0=equal (a_idx), 1=delete (a_idx), 2=insert (b_idx)
fn _diff_compute_ops(a: StrVec, b: StrVec) -> IntBuf {
    na := svec_len(a)
    nb := svec_len(b)
    mut ops := ibuf_new((na + nb + 8) * 2)

    // 1. Trim identical prefix and suffix in O(min(na, nb))
    mut pref := 0
    while pref < na and pref < nb and str_eq(svec_get(a, pref), svec_get(b, pref)) {
        pref += 1
    }
    mut suf := 0
    while suf < (na - pref) and suf < (nb - pref) and str_eq(svec_get(a, na - 1 - suf), svec_get(b, nb - 1 - suf)) {
        suf += 1
    }

    // Emit prefix equals
    mut p := 0
    while p < pref {
        ibuf_push(ops, 0); ibuf_push(ops, p)
        p += 1
    }

    ma := na - pref - suf
    mb := nb - pref - suf

    if ma == 0 {
        mut j := 0
        while j < mb { ibuf_push(ops, 2); ibuf_push(ops, pref + j); j += 1 }
    } else if mb == 0 {
        mut i := 0
        while i < ma { ibuf_push(ops, 1); ibuf_push(ops, pref + i); i += 1 }
    } else if ma * mb <= 1048576 {
        // Exact O(ma * mb) LCS DP over hashed lines (verified exact on equality)
        ha := ibuf_new(ma + 2)
        hb := ibuf_new(mb + 2)
        mut i := 0
        while i < ma { ibuf_push(ha, fnv1a_64(svec_get(a, pref + i))); i += 1 }
        mut j := 0
        while j < mb { ibuf_push(hb, fnv1a_64(svec_get(b, pref + j))); j += 1 }

        cols := mb + 1
        dp := ibuf_new((ma + 1) * cols + 4)
        mut z := 0
        total_dp := (ma + 1) * cols
        while z < total_dp { ibuf_push(dp, 0); z += 1 }

        i = ma - 1
        while i >= 0 {
            hi := ibuf_get(ha, i)
            ai_s := svec_get(a, pref + i)
            j = mb - 1
            while j >= 0 {
                mut best := ibuf_get(dp, (i + 1) * cols + j)
                rgt := ibuf_get(dp, i * cols + (j + 1))
                if rgt > best { best = rgt }
                if hi == ibuf_get(hb, j) and str_eq(ai_s, svec_get(b, pref + j)) {
                    diag := 1 + ibuf_get(dp, (i + 1) * cols + (j + 1))
                    if diag > best { best = diag }
                }
                ibuf_set(dp, i * cols + j, best)
                j -= 1
            }
            i -= 1
        }

        // Backtrack LCS into exact ordered op list
        mut ci := 0
        mut cj := 0
        while ci < ma and cj < mb {
            if ibuf_get(ha, ci) == ibuf_get(hb, cj) and str_eq(svec_get(a, pref + ci), svec_get(b, pref + cj)) {
                ibuf_push(ops, 0); ibuf_push(ops, pref + ci)
                ci += 1; cj += 1
            } else if ibuf_get(dp, (ci + 1) * cols + cj) >= ibuf_get(dp, ci * cols + (cj + 1)) {
                ibuf_push(ops, 1); ibuf_push(ops, pref + ci)
                ci += 1
            } else {
                ibuf_push(ops, 2); ibuf_push(ops, pref + cj)
                cj += 1
            }
        }
        while ci < ma { ibuf_push(ops, 1); ibuf_push(ops, pref + ci); ci += 1 }
        while cj < mb { ibuf_push(ops, 2); ibuf_push(ops, pref + cj); cj += 1 }
        buf_free(move dp)
        buf_free(move ha)
        buf_free(move hb)
    } else {
        // Bounded O(N) fallback when changed window > 1M cells (prevents OOM/CPU DoS)
        mut i := 0
        while i < ma { ibuf_push(ops, 1); ibuf_push(ops, pref + i); i += 1 }
        mut j := 0
        while j < mb { ibuf_push(ops, 2); ibuf_push(ops, pref + j); j += 1 }
    }

    // Emit suffix equals
    mut s := 0
    while s < suf {
        ibuf_push(ops, 0); ibuf_push(ops, na - suf + s)
        s += 1
    }
    return ops
}

// Equivalent to Python `difflib.unified_diff(before, after, fromfile, tofile, n=context)`
fn diff_unified(before: str, after: str, fromfile: str = "a/file", tofile: str = "b/file", context: i64 = 3) -> str {
    if str_eq(before, after) { return "" }
    a := _diff_split_lines(before)
    b := _diff_split_lines(after)
    ops := _diff_compute_ops(a, b)
    nops := ibuf_len(ops) / 2
    ctx := if context < 0 { 0 } else { context }

    // Check if any non-equal ops exist
    mut has_change := false
    mut k := 0
    while k < nops {
        if ibuf_get(ops, k * 2) != 0 { has_change = true; break }
        k += 1
    }
    if not has_change {
        buf_free(move ops)
        svec_free(move a)
        svec_free(move b)
        return ""
    }

    mut out := svec_new(32, 1024)
    svec_push(mut out, f"--- {fromfile}")
    svec_push(mut out, f"+++ {tofile}")

    // Precompute old_line / new_line (1-based) before each op
    old_pos := ibuf_new(nops + 2)
    new_pos := ibuf_new(nops + 2)
    mut ol := 1
    mut nl := 1
    k = 0
    while k < nops {
        ibuf_push(old_pos, ol)
        ibuf_push(new_pos, nl)
        op := ibuf_get(ops, k * 2)
        if op == 0 { ol += 1; nl += 1 }
        else if op == 1 { ol += 1 }
        else { nl += 1 }
        k += 1
    }
    ibuf_push(old_pos, ol)
    ibuf_push(new_pos, nl)

    // Group changed ranges into hunks with `ctx` context lines around changes
    mut i := 0
    while i < nops {
        while i < nops and ibuf_get(ops, i * 2) == 0 { i += 1 }
        if i >= nops { break }
        mut h_start := i - ctx
        if h_start < 0 { h_start = 0 }
        mut h_end := i
        while h_end < nops {
            if ibuf_get(ops, h_end * 2) != 0 {
                h_end += 1
            } else {
                // Count consecutive equals
                mut eq_run := 0
                while h_end + eq_run < nops and ibuf_get(ops, (h_end + eq_run) * 2) == 0 {
                    eq_run += 1
                }
                if h_end + eq_run >= nops or eq_run > ctx * 2 {
                    take := if eq_run < ctx { eq_run } else { ctx }
                    h_end = h_end + take
                    break
                }
                h_end = h_end + eq_run
            }
        }
        old_s := ibuf_get(old_pos, h_start)
        new_s := ibuf_get(new_pos, h_start)
        old_c := ibuf_get(old_pos, h_end) - old_s
        new_c := ibuf_get(new_pos, h_end) - new_s
        os_disp := if old_c == 0 and old_s > 0 { old_s - 1 } else { old_s }
        ns_disp := if new_c == 0 and new_s > 0 { new_s - 1 } else { new_s }
        svec_push(mut out, f"@@ -{os_disp},{old_c} +{ns_disp},{new_c} @@")

        mut j := h_start
        while j < h_end {
            op := ibuf_get(ops, j * 2)
            idx := ibuf_get(ops, j * 2 + 1)
            if op == 0 { svec_push(mut out, " " + svec_get(a, idx)) }
            else if op == 1 { svec_push(mut out, "-" + svec_get(a, idx)) }
            else { svec_push(mut out, "+" + svec_get(b, idx)) }
            j += 1
        }
        i = h_end
    }

    buf_free(move old_pos)
    buf_free(move new_pos)
    buf_free(move ops)
    svec_free(move a)
    svec_free(move b)
    res := svec_join(out, "\n") + "\n"
    svec_free(move out)
    return res
}

// Returns `(added_lines, removed_lines)`
fn diff_stats(before: str, after: str) -> (i64, i64) {
    if str_eq(before, after) { return (0, 0) }
    a := _diff_split_lines(before)
    b := _diff_split_lines(after)
    ops := _diff_compute_ops(a, b)
    nops := ibuf_len(ops) / 2
    mut added := 0
    mut removed := 0
    mut i := 0
    while i < nops {
        op := ibuf_get(ops, i * 2)
        if op == 1 { removed += 1 }
        else if op == 2 { added += 1 }
        i += 1
    }
    buf_free(move ops)
    svec_free(move a)
    svec_free(move b)
    return (added, removed)
}

// Line-level similarity percentage `[0..100]` (`2 * matching_lines / total_lines * 100`)
fn diff_similarity_pct(before: str, after: str) -> i64 {
    if str_eq(before, after) { return 100 }
    a := _diff_split_lines(before)
    b := _diff_split_lines(after)
    total := svec_len(a) + svec_len(b)
    if total == 0 { svec_free(move a); svec_free(move b); return 100 }
    ops := _diff_compute_ops(a, b)
    nops := ibuf_len(ops) / 2
    mut matched := 0
    mut i := 0
    while i < nops {
        if ibuf_get(ops, i * 2) == 0 { matched += 1 }
        i += 1
    }
    buf_free(move ops)
    svec_free(move a)
    svec_free(move b)
    return (matched * 200) / total
}
