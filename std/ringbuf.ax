// Axon v7.0 Lock-Free Cache-Line Padded SPSC Ring Buffer (`std/ringbuf.ax`)
// Designed for sub-microsecond HFT / audio / telemetry pipelines:
//   - Head (`idx 0`, byte `0`) and Tail (`idx 8`, byte `64`) sit on separate 64-byte L1 cache lines
//     to eliminate false sharing between producer and consumer cores.
//   - `spsc_try_push`, `spsc_try_pop`, and `spsc_len` are statically verified `@no_alloc`.

struct SpscRing {
    base_ptr: i64
    mask: i64
    cap: i64
}

fn spsc_new(pow2_cap: i64) -> SpscRing {
    unsafe {
    mut want := pow2_cap
    if want > 16777216 { want = 16777216 }
    mut c := 16
    while c < want {
        c = c * 2
    }
    // 16 i64 header slots (128 bytes = two 64B cache lines) + `c` i64 payload slots
    total_bytes := (16 + c) * 8
    ptr := mem_alloc_aligned(total_bytes)
    if ptr == 0 { return SpscRing(base_ptr = 0, mask = 0, cap = 0) }
    atomic_store_i64(ptr, 0, 0) // cache line 0: head (write index) + [1]=cached_tail
    ptr_write_i64(ptr, 1, 0)
    atomic_store_i64(ptr, 8, 0) // cache line 1: tail (read index) + [9]=cached_head
    ptr_write_i64(ptr, 9, 0)
    return SpscRing(base_ptr = ptr, mask = c - 1, cap = c)
    }
}

@inline
@no_alloc
fn spsc_len(r: SpscRing) -> i64 {
    if r.base_ptr == 0 { return 0 }
    unsafe {
        h := atomic_load_i64(r.base_ptr, 0)
        t := atomic_load_i64(r.base_ptr, 8)
        return h - t
    }
}

@inline
@no_alloc
fn spsc_try_push(r: SpscRing, val: i64) -> bool {
    unsafe {
    h := ptr_read_i64(r.base_ptr, 0)
    mut t := ptr_read_i64(r.base_ptr, 1)
    if (h - t) >= r.cap {
        t = atomic_load_i64(r.base_ptr, 8)
        ptr_write_i64(r.base_ptr, 1, t)
        if (h - t) >= r.cap {
            return false
        }
    }
    ptr_write_i64(r.base_ptr, 16 + (h & r.mask), val)
    atomic_store_rel_i64(r.base_ptr, 0, h +% 1)
    return true
    }
}

@inline
@no_alloc
fn spsc_try_pop(r: SpscRing) -> i64 ! i64 {
    unsafe {
    t := ptr_read_i64(r.base_ptr, 8)
    mut h := ptr_read_i64(r.base_ptr, 9)
    if t == h {
        h = atomic_load_i64(r.base_ptr, 0)
        ptr_write_i64(r.base_ptr, 9, h)
        if t == h {
            return err(1)
        }
    }
    val := ptr_read_i64(r.base_ptr, 16 + (t & r.mask))
    atomic_store_rel_i64(r.base_ptr, 8, t +% 1)
    return ok(val)
    }
}

fn spsc_free(move r: SpscRing) {
    unsafe {
    if r.base_ptr != 0 {
        mem_free_aligned(r.base_ptr)
    }
    }
}
