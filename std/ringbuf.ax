// Axon v7.0 Lock-Free Cache-Line Padded SPSC Ring Buffer (`std/ringbuf.ax`)
// Designed for sub-microsecond HFT / audio / telemetry pipelines:
//   - Head (`idx 0`, byte `0`) and Tail (`idx 8`, byte `64`) sit on separate 64-byte L1 cache lines
//     to eliminate false sharing between producer and consumer cores.
//   - `spsc_try_push`, `spsc_try_pop`, and `spsc_len` are statically verified `@no_alloc`.

struct SpscRing {
    base_ptr: i64
    mask: i64
    cap: i64
}

fn spsc_new(pow2_cap: i64) -> SpscRing {
    unsafe {
    mut want := pow2_cap
    if want > 16777216 { want = 16777216 }
    mut c := 16
    while c < want {
        c = c * 2
    }
    // 16 i64 header slots (128 bytes = two 64B cache lines) + `c` i64 payload slots
    total_bytes := (16 + c) * 8
    ptr := mem_alloc_aligned(total_bytes)
    if ptr == 0 { return SpscRing(base_ptr = 0, mask = 0, cap = 0) }
    atomic_store_i64(ptr, 0, 0) // cache line 0: head (write index) + [1]=cached_tail
    ptr_write_i64(ptr, 1, 0)
    atomic_store_i64(ptr, 8, 0) // cache line 1: tail (read index) + [9]=cached_head
    ptr_write_i64(ptr, 9, 0)
    return SpscRing(base_ptr = ptr, mask = c - 1, cap = c)
    }
}

@inline
@no_alloc
fn spsc_len(r: SpscRing) -> i64 {
    if r.base_ptr == 0 { return 0 }
    unsafe {
        h := atomic_load_i64(r.base_ptr, 0)
        t := atomic_load_i64(r.base_ptr, 8)
        return h - t
    }
}

@inline
@no_alloc
fn spsc_try_push(r: SpscRing, val: i64) -> bool {
    unsafe {
    bp := r.base_ptr
    h := ptr_read_i64(bp, 0)
    mut t := ptr_read_i64(bp, 1)
    if (h - t) >= r.cap {
        t = atomic_load_i64(bp, 8)
        ptr_write_i64(bp, 1, t)
        if (h - t) >= r.cap {
            return false
        }
    }
    ptr_write_i64(bp, 16 + (h & r.mask), val)
    atomic_store_rel_i64(bp, 0, h +% 1)
    return true
    }
}

@inline
@no_alloc
fn spsc_try_pop(r: SpscRing) -> i64 ! i64 {
    unsafe {
    bp := r.base_ptr
    t := ptr_read_i64(bp, 8)
    mut h := ptr_read_i64(bp, 9)
    if t == h {
        h = atomic_load_i64(bp, 0)
        ptr_write_i64(bp, 9, h)
        if t == h {
            return err(1)
        }
    }
    val := ptr_read_i64(bp, 16 + (t & r.mask))
    atomic_store_rel_i64(bp, 8, t +% 1)
    return ok(val)
    }
}

@inline
@no_alloc
fn spsc_try_pop_or(r: SpscRing, default_val: i64) -> i64 {
    unsafe {
    bp := r.base_ptr
    t := ptr_read_i64(bp, 8)
    mut h := ptr_read_i64(bp, 9)
    if t == h {
        h = atomic_load_i64(bp, 0)
        ptr_write_i64(bp, 9, h)
        if t == h { return default_val }
    }
    val := ptr_read_i64(bp, 16 + (t & r.mask))
    atomic_store_rel_i64(bp, 8, t +% 1)
    return val
    }
}

@no_alloc
fn spsc_push_batch(r: SpscRing, src_ptr: i64, count: i64) -> i64 {
    unsafe {
    bp := r.base_ptr
    if bp == 0 or count <= 0 { return 0 }
    cap := r.cap
    h := ptr_read_i64(bp, 0)
    mut t := ptr_read_i64(bp, 1)
    mut free_slots := cap - (h - t)
    if free_slots < count {
        t = atomic_load_i64(bp, 8)
        ptr_write_i64(bp, 1, t)
        free_slots = cap - (h - t)
    }
    if free_slots >= count {
        pos := h & r.mask
        if pos + count <= cap {
            _ := mem_copy(bp + 128 + (pos << 3), src_ptr, count << 3)
            atomic_store_rel_i64(bp, 0, h +% count)
            return count
        }
    }
    mut n := count
    if n > free_slots { n = free_slots }
    if n <= 0 { return 0 }
    pos := h & r.mask
    first := cap - pos
    data_base := bp + 128
    if n <= first {
        _ := mem_copy(data_base + (pos << 3), src_ptr, n << 3)
    } else {
        _ := mem_copy(data_base + (pos << 3), src_ptr, first << 3)
        _ := mem_copy(data_base, src_ptr + (first << 3), (n - first) << 3)
    }
    atomic_store_rel_i64(bp, 0, h +% n)
    return n
    }
}

@no_alloc
fn spsc_pop_batch(r: SpscRing, dst_ptr: i64, count: i64) -> i64 {
    unsafe {
    bp := r.base_ptr
    if bp == 0 or count <= 0 { return 0 }
    cap := r.cap
    t := ptr_read_i64(bp, 8)
    mut h := ptr_read_i64(bp, 9)
    mut avail := h - t
    if avail < count {
        h = atomic_load_i64(bp, 0)
        ptr_write_i64(bp, 9, h)
        avail = h - t
    }
    if avail >= count {
        pos := t & r.mask
        if pos + count <= cap {
            _ := mem_copy(dst_ptr, bp + 128 + (pos << 3), count << 3)
            atomic_store_rel_i64(bp, 8, t +% count)
            return count
        }
    }
    mut n := count
    if n > avail { n = avail }
    if n <= 0 { return 0 }
    pos := t & r.mask
    first := cap - pos
    data_base := bp + 128
    if n <= first {
        _ := mem_copy(dst_ptr, data_base + (pos << 3), n << 3)
    } else {
        _ := mem_copy(dst_ptr, data_base + (pos << 3), first << 3)
        _ := mem_copy(dst_ptr + (first << 3), data_base, (n - first) << 3)
    }
    atomic_store_rel_i64(bp, 8, t +% n)
    return n
    }
}

fn spsc_free(move r: SpscRing) {
    unsafe {
    if r.base_ptr != 0 {
        mem_free_aligned(r.base_ptr)
    }
    }
}
