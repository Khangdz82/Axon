// Axon v7.0 Compile-Time Taint Sanitization Library (`std/taint.ax`)
// `tainted[str]` values cannot reach `sql_exec`, `shell_exec`, `fs_read_file`, or `fs_write_file`
// (`error[E0502]`) unless explicitly validated and unwrapped by a sanitizer returning `str ! i64`.

// Validates SQL identifier / parameter token: allows `[A-Za-z0-9_]` (non-empty, max 128 bytes).
// Rejects `'`, `"`, `;`, `--`, spaces, NUL bytes, and SQL injection payloads with `err(502)`.
fn sanitize_sql_id(input: tainted[str]) -> str ! i64 {
    raw := tainted_raw_str(input)
    n := str_len(raw)
    if n <= 0 or n > 128 {
        return err(502)
    }
    mut i := 0
    while i < n {
        b := str_byte(raw, i)
        is_alpha := (b >= 65 and b <= 90) or (b >= 97 and b <= 122)
        is_digit := b >= 48 and b <= 57
        is_under := b == 95
        if not (is_alpha or is_digit or is_under) {
            return err(502)
        }
        if i == 0 and is_digit {
            return err(502)
        }
        i += 1
    }
    return ok(trusted_str_unwrap(input))
}

// Validates safe CLI argument token: allows `[A-Za-z0-9_./:-]` without shell metacharacters
// (`;`, `&`, `|`, `` ` ``, `$`, `(`, `)`, `<`, `>`, `\n`, `\r`, `\0`, quotes, spaces).
fn sanitize_shell_arg(input: tainted[str]) -> str ! i64 {
    raw := tainted_raw_str(input)
    n := str_len(raw)
    if n <= 0 or n > 512 {
        return err(503)
    }
    mut i := 0
    while i < n {
        b := str_byte(raw, i)
        ok_alnum := (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or (b >= 48 and b <= 57)
        ok_punct := b == 95 or b == 45 or b == 46 or b == 47 or b == 58
        if not (ok_alnum or ok_punct) {
            return err(503)
        }
        i += 1
    }
    return ok(trusted_str_unwrap(input))
}

// Validates relative sandbox file subpath: rejects path traversal (`..`), leading `/` or `\`,
// Windows drive colons (`:`), and NUL bytes.
fn sanitize_subpath(input: tainted[str]) -> str ! i64 {
    raw := tainted_raw_str(input)
    n := str_len(raw)
    if n <= 0 or n > 256 {
        return err(504)
    }
    b0 := str_byte(raw, 0)
    if b0 == 47 or b0 == 92 or b0 == 46 {
        return err(504)
    }
    mut i := 0
    while i < n {
        b := str_byte(raw, i)
        if b == 0 or b == 58 or b == 92 {
            return err(504)
        }
        if b == 46 and i + 1 < n and str_byte(raw, i + 1) == 46 {
            return err(504)
        }
        ok_char := (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 95 or b == 45 or b == 46 or b == 47
        if not ok_char {
            return err(504)
        }
        i += 1
    }
    return ok(trusted_str_unwrap(input))
}
