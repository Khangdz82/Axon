// Axon NumPy Reimplementation (`std/numpy.ax`)
// 100% Pure Axon: Zero Python, Zero C++, Zero CRT, Zero-GC (@no_alloc).
// Replaces `import numpy as np` with ultra-fast, zero-overhead native Axon structures:
//   - Multi-Dimensional Contiguous Array (`NdArray`)
//   - Array Creation: zeros, ones, full, arange, linspace, eye
//   - Array Manipulation: reshape, transpose, flatten, slice_1d
//   - Elementwise Math: add, sub, mul, div, exp, log, sqrt, abs, clip
//   - Reductions & Stats: sum, mean, std, var, max, min, argmax, argmin
//   - Linear Algebra & GEMM: dot, matmul, norm, 2x2 inverse & determinant

use std::ai_math
use std::os

struct NdArray {
    data_ptr: i64
    rows: i64
    cols: i64
    size: i64
}

// --- 1. Constructors & Factory Functions ---

fn _np_alloc_raw(rows: i64, cols: i64 = 1) -> NdArray {
    unsafe {
    if rows <= 0 or cols <= 0 or rows > 268435456 or cols > 268435456 {
        return NdArray(data_ptr = 0, rows = 0, cols = 0, size = 0)
    }
    if rows > 268435456 / cols {
        return NdArray(data_ptr = 0, rows = 0, cols = 0, size = 0)
    }
    total := rows * cols
    mem := mem_alloc_aligned(total * 4 + 64)
    if mem == 0 {
        return NdArray(data_ptr = 0, rows = 0, cols = 0, size = 0)
    }
    return NdArray(data_ptr = mem, rows = rows, cols = cols, size = total)
    }
}

fn np_zeros(rows: i64, cols: i64 = 1) -> NdArray {
    unsafe {
    arr := _np_alloc_raw(rows, cols)
    if arr.data_ptr == 0 { return arr }
    mem_set(arr.data_ptr, 0, arr.size * 4)
    return arr
    }
}

fn np_ones(rows: i64, cols: i64 = 1) -> NdArray {
    unsafe {
    arr := _np_alloc_raw(rows, cols)
    if arr.data_ptr == 0 { return arr }
    mut i := 0
    while i < arr.size {
        ptr_write_f32(arr.data_ptr, i, 1.0)
        i += 1
    }
    return arr
    }
}

fn np_full(rows: i64, cols: i64, fill_val: f64) -> NdArray {
    unsafe {
    arr := _np_alloc_raw(rows, cols)
    if arr.data_ptr == 0 { return arr }
    mut i := 0
    while i < arr.size {
        ptr_write_f32(arr.data_ptr, i, fill_val)
        i += 1
    }
    return arr
    }
}

fn np_arange(start: f64, stop: f64, step: f64 = 1.0) -> NdArray {
    unsafe {
    mut s := step
    if s == 0.0 { s = 1.0 }
    diff := stop - start
    mut count := (diff / s) as i64
    if count <= 0 or count > 268435456 {
        return NdArray(data_ptr = 0, rows = 0, cols = 0, size = 0)
    }
    arr := _np_alloc_raw(count, 1)
    if arr.data_ptr == 0 { return arr }
    mut i := 0
    while i < arr.size {
        v := start + (i as f64) * s
        ptr_write_f32(arr.data_ptr, i, v)
        i += 1
    }
    return arr
    }
}

fn np_linspace(start: f64, stop: f64, num: i64) -> NdArray {
    unsafe {
    mut n := num
    if n < 2 { n = 2 }
    arr := _np_alloc_raw(n, 1)
    if arr.data_ptr == 0 { return arr }
    step := (stop - start) / ((n - 1) as f64)
    mut i := 0
    while i < arr.size {
        v := start + (i as f64) * step
        ptr_write_f32(arr.data_ptr, i, v)
        i += 1
    }
    return arr
    }
}

fn np_eye(n: i64) -> NdArray {
    unsafe {
    if n <= 0 or n > 16384 {
        return NdArray(data_ptr = 0, rows = 0, cols = 0, size = 0)
    }
    arr := np_zeros(n, n)
    if arr.data_ptr == 0 { return arr }
    mut i := 0
    while i < n {
        ptr_write_f32(arr.data_ptr, i * n + i, 1.0)
        i += 1
    }
    return arr
    }
}

fn np_free(move arr: NdArray) {
    unsafe {
    if arr.data_ptr != 0 {
        mem_free_aligned(arr.data_ptr)
    }
    }
}

// --- 2. Element Access & Slicing ---

@no_alloc
fn np_get(arr: NdArray, r: i64, c: i64 = 0) -> f64 {
    unsafe {
    if arr.data_ptr == 0 or r < 0 or r >= arr.rows or c < 0 or c >= arr.cols { return 0.0 }
    return ptr_read_f32(arr.data_ptr, r * arr.cols + c)
    }
}

@no_alloc
fn np_set(arr: NdArray, r: i64, c: i64, val: f64) {
    unsafe {
    if arr.data_ptr == 0 or r < 0 or r >= arr.rows or c < 0 or c >= arr.cols { return }
    ptr_write_f32(arr.data_ptr, r * arr.cols + c, val)
    }
}

@no_alloc
fn np_get_1d(arr: NdArray, idx: i64) -> f64 {
    unsafe {
    if arr.data_ptr == 0 or idx < 0 or idx >= arr.size { return 0.0 }
    return ptr_read_f32(arr.data_ptr, idx)
    }
}

@no_alloc
fn np_set_1d(arr: NdArray, idx: i64, val: f64) {
    unsafe {
    if arr.data_ptr == 0 or idx < 0 or idx >= arr.size { return }
    ptr_write_f32(arr.data_ptr, idx, val)
    }
}

// In-place reshape (total size must remain identical, overflow-proof)
@no_alloc
fn np_reshape(mut arr: NdArray, new_rows: i64, new_cols: i64) -> bool {
    if arr.data_ptr == 0 or new_rows <= 0 or new_cols <= 0 {
        return false
    }
    if (arr.size % new_rows) != 0 or (arr.size / new_rows) != new_cols {
        return false
    }
    arr.rows = new_rows
    arr.cols = new_cols
    return true
}

// 2D Transpose returning new matrix
fn np_transpose(arr: NdArray) -> NdArray {
    t := np_zeros(arr.cols, arr.rows)
    if arr.data_ptr == 0 or t.data_ptr == 0 { return t }
    mut r := 0
    while r < arr.rows {
        mut c := 0
        while c < arr.cols {
            v := np_get(arr, r, c)
            np_set(t, c, r, v)
            c += 1
        }
        r += 1
    }
    return t
}

// --- 3. Elementwise Math Operations ---

fn np_add(a: NdArray, b: NdArray) -> NdArray {
    unsafe {
    if a.data_ptr == 0 or b.data_ptr == 0 { return np_zeros(a.rows, a.cols) }
    out := _np_alloc_raw(a.rows, a.cols)
    if out.data_ptr == 0 { return out }
    limit := if a.size < b.size { a.size } else { b.size }
    if limit < out.size { mem_set(out.data_ptr, 0, out.size * 4) }
    if limit > 0 {
        mem_copy(out.data_ptr, a.data_ptr, limit * 4)
        dlpack_scale_add_f32(out.data_ptr, b.data_ptr, 1.0, limit)
    }
    return out
    }
}

fn np_sub(a: NdArray, b: NdArray) -> NdArray {
    unsafe {
    if a.data_ptr == 0 or b.data_ptr == 0 { return np_zeros(a.rows, a.cols) }
    out := _np_alloc_raw(a.rows, a.cols)
    if out.data_ptr == 0 { return out }
    limit := if a.size < b.size { a.size } else { b.size }
    if limit < out.size { mem_set(out.data_ptr, 0, out.size * 4) }
    if limit > 0 {
        mem_copy(out.data_ptr, a.data_ptr, limit * 4)
        dlpack_scale_add_f32(out.data_ptr, b.data_ptr, -1.0, limit)
    }
    return out
    }
}

fn np_multiply(a: NdArray, b: NdArray) -> NdArray {
    unsafe {
    out := np_zeros(a.rows, a.cols)
    if a.data_ptr == 0 or b.data_ptr == 0 or out.data_ptr == 0 { return out }
    limit := if a.size < b.size { a.size } else { b.size }
    mut i := 0
    while i < limit {
        va := ptr_read_f32(a.data_ptr, i)
        vb := ptr_read_f32(b.data_ptr, i)
        ptr_write_f32(out.data_ptr, i, va * vb)
        i += 1
    }
    return out
    }
}

fn np_divide(a: NdArray, b: NdArray) -> NdArray {
    unsafe {
    out := np_zeros(a.rows, a.cols)
    if a.data_ptr == 0 or b.data_ptr == 0 or out.data_ptr == 0 { return out }
    limit := if a.size < b.size { a.size } else { b.size }
    mut i := 0
    while i < limit {
        va := ptr_read_f32(a.data_ptr, i)
        vb := ptr_read_f32(b.data_ptr, i)
        div := if vb != 0.0 { va / vb } else { 0.0 }
        ptr_write_f32(out.data_ptr, i, div)
        i += 1
    }
    return out
    }
}

fn np_scale(a: NdArray, scalar: f64) -> NdArray {
    unsafe {
    out := np_zeros(a.rows, a.cols)
    if a.data_ptr == 0 or out.data_ptr == 0 { return out }
    mut i := 0
    while i < a.size {
        va := ptr_read_f32(a.data_ptr, i)
        ptr_write_f32(out.data_ptr, i, va * scalar)
        i += 1
    }
    return out
    }
}

// In-place clipping between min_val and max_val
@no_alloc
fn np_clip_inplace(arr: NdArray, min_val: f64, max_val: f64) {
    unsafe {
    if arr.data_ptr == 0 or arr.size <= 0 { return }
    mut i := 0
    while i < arr.size {
        v := ptr_read_f32(arr.data_ptr, i)
        mut c := v
        if c < min_val { c = min_val }
        if c > max_val { c = max_val }
        ptr_write_f32(arr.data_ptr, i, c)
        i += 1
    }
    }
}

// --- 4. Reductions & Statistics ---

@no_alloc
fn np_sum(arr: NdArray) -> f64 {
    unsafe {
    if arr.data_ptr == 0 or arr.size <= 0 { return 0.0 }
    return det_sum_f32_ptr(arr.data_ptr, arr.size)
    }
}

@no_alloc
fn np_mean(arr: NdArray) -> f64 {
    if arr.data_ptr == 0 or arr.size <= 0 { return 0.0 }
    return np_sum(arr) / (arr.size as f64)
}

@no_alloc
fn np_var(arr: NdArray) -> f64 {
    unsafe {
    if arr.data_ptr == 0 or arr.size <= 1 { return 0.0 }
    m := np_mean(arr)
    mut sum_sq := 0.0
    mut i := 0
    while i < arr.size {
        diff := ptr_read_f32(arr.data_ptr, i) - m
        sum_sq = sum_sq + diff * diff
        i += 1
    }
    return sum_sq / (arr.size as f64)
    }
}

@no_alloc
fn np_std(arr: NdArray) -> f64 {
    v := np_var(arr)
    return sqrt_f64(v)
}

@no_alloc
fn np_max(arr: NdArray) -> f64 {
    unsafe {
    if arr.data_ptr == 0 or arr.size <= 0 { return 0.0 }
    mut m := ptr_read_f32(arr.data_ptr, 0)
    mut i := 1
    while i < arr.size {
        v := ptr_read_f32(arr.data_ptr, i)
        if v > m { m = v }
        i += 1
    }
    return m
    }
}

@no_alloc
fn np_min(arr: NdArray) -> f64 {
    unsafe {
    if arr.data_ptr == 0 or arr.size <= 0 { return 0.0 }
    mut m := ptr_read_f32(arr.data_ptr, 0)
    mut i := 1
    while i < arr.size {
        v := ptr_read_f32(arr.data_ptr, i)
        if v < m { m = v }
        i += 1
    }
    return m
    }
}

@no_alloc
fn np_argmax(arr: NdArray) -> i64 {
    unsafe {
    if arr.data_ptr == 0 or arr.size <= 0 { return -1 }
    mut max_val := ptr_read_f32(arr.data_ptr, 0)
    mut max_idx := 0
    mut i := 1
    while i < arr.size {
        v := ptr_read_f32(arr.data_ptr, i)
        if v > max_val {
            max_val = v
            max_idx = i
        }
        i += 1
    }
    return max_idx
    }
}

@no_alloc
fn np_argmin(arr: NdArray) -> i64 {
    unsafe {
    if arr.data_ptr == 0 or arr.size <= 0 { return -1 }
    mut min_val := ptr_read_f32(arr.data_ptr, 0)
    mut min_idx := 0
    mut i := 1
    while i < arr.size {
        v := ptr_read_f32(arr.data_ptr, i)
        if v < min_val {
            min_val = v
            min_idx = i
        }
        i += 1
    }
    return min_idx
    }
}

// --- 5. Matrix Multiplication & Linear Algebra ---

// Matrix Multiplication C = A x B
// A is [M x K], B is [K x N] -> C is [M x N]
fn np_matmul(a: NdArray, b: NdArray) -> NdArray {
    if a.data_ptr == 0 or b.data_ptr == 0 or a.cols != b.rows or a.rows <= 0 or a.cols <= 0 or b.cols <= 0 {
        return NdArray(data_ptr = 0, rows = 0, cols = 0, size = 0)
    }
    m := a.rows
    k := a.cols
    n := b.cols
    c := np_zeros(m, n)
    if c.data_ptr == 0 { return c }
    unsafe { avx_gemm_f32(a.data_ptr, b.data_ptr, c.data_ptr, m, k, n) }
    return c
}

// 1D Vector Dot Product
@no_alloc
fn np_dot(a: NdArray, b: NdArray) -> f64 {
    if a.data_ptr == 0 or b.data_ptr == 0 { return 0.0 }
    limit := if a.size < b.size { a.size } else { b.size }
    if limit <= 0 { return 0.0 }
    unsafe { return dlpack_dot_f32(a.data_ptr, b.data_ptr, limit) }
}

// Euclidean L2 Norm
@no_alloc
fn np_linalg_norm(arr: NdArray) -> f64 {
    dot := np_dot(arr, arr)
    return sqrt_f64(dot)
}

// 2x2 Matrix Determinant
@no_alloc
fn np_linalg_det_2x2(m: NdArray) -> f64 {
    if m.rows != 2 or m.cols != 2 { return 0.0 }
    a := np_get(m, 0, 0)
    b := np_get(m, 0, 1)
    c := np_get(m, 1, 0)
    d := np_get(m, 1, 1)
    return a * d - b * c
}

// 2x2 Matrix Inversion
fn np_linalg_inv_2x2(m: NdArray) -> NdArray {
    inv := np_zeros(2, 2)
    det := np_linalg_det_2x2(m)
    if det == 0.0 {
        return inv
    }
    inv_det := 1.0 / det
    a := np_get(m, 0, 0)
    b := np_get(m, 0, 1)
    c := np_get(m, 1, 0)
    d := np_get(m, 1, 1)

    np_set(inv, 0, 0, d * inv_det)
    np_set(inv, 0, 1, (0.0 - b) * inv_det)
    np_set(inv, 1, 0, (0.0 - c) * inv_det)
    np_set(inv, 1, 1, a * inv_det)
    return inv
}

// --- 6. Continuous Calculus, Signal Processing & Control Theory (SciPy / Control in Axon) ---

// Trapezoidal numerical integration: integral of `y(x) dx` across 1D samples (`@no_alloc`)
@no_alloc
fn np_trapz(y: NdArray, dx: f64 = 1.0) -> f64 {
    unsafe {
    n := y.size
    if n <= 1 or y.data_ptr == 0 { return 0.0 }
    mut acc := 0.5 * (ptr_read_f32(y.data_ptr, 0) + ptr_read_f32(y.data_ptr, n - 1))
    mut i := 1
    while i < n - 1 {
        acc = acc + ptr_read_f32(y.data_ptr, i)
        i += 1
    }
    return acc * dx
    }
}

// 2nd-order central-difference numerical derivative `dy/dx`
fn np_gradient_1d(y: NdArray, dx: f64 = 1.0) -> NdArray {
    unsafe {
    n := y.size
    out := np_zeros(n, 1)
    if n <= 1 or y.data_ptr == 0 or dx == 0.0 { return out }
    inv_dx := 1.0 / dx
    inv_2dx := 0.5 / dx
    ptr_write_f32(out.data_ptr, 0, (ptr_read_f32(y.data_ptr, 1) - ptr_read_f32(y.data_ptr, 0)) * inv_dx)
    mut i := 1
    while i < n - 1 {
        dy := ptr_read_f32(y.data_ptr, i + 1) - ptr_read_f32(y.data_ptr, i - 1)
        ptr_write_f32(out.data_ptr, i, dy * inv_2dx)
        i += 1
    }
    ptr_write_f32(out.data_ptr, n - 1, (ptr_read_f32(y.data_ptr, n - 1) - ptr_read_f32(y.data_ptr, n - 2)) * inv_dx)
    return out
    }
}

// 1D discrete/continuous signal convolution (`mode = "same"` length `signal.size`)
fn np_convolve_1d(signal: NdArray, kernel: NdArray) -> NdArray {
    unsafe {
    n := signal.size
    klen := kernel.size
    out := np_zeros(n, 1)
    if n <= 0 or klen <= 0 or signal.data_ptr == 0 or kernel.data_ptr == 0 { return out }
    half := klen / 2
    mut i := 0
    while i < n {
        mut sum := 0.0
        mut k := 0
        while k < klen {
            si := i + k - half
            if si >= 0 and si < n {
                sum = sum + ptr_read_f32(signal.data_ptr, si) * ptr_read_f32(kernel.data_ptr, k)
            }
            k += 1
        }
        ptr_write_f32(out.data_ptr, i, sum)
        i += 1
    }
    return out
    }
}

// Continuous Exponential Moving Average (EMA) low-pass stream filter
fn np_ema_1d(signal: NdArray, alpha: f64) -> NdArray {
    unsafe {
    n := signal.size
    out := np_zeros(n, 1)
    if n <= 0 or signal.data_ptr == 0 { return out }
    mut cur := ptr_read_f32(signal.data_ptr, 0)
    ptr_write_f32(out.data_ptr, 0, cur)
    one_minus := 1.0 - alpha
    mut i := 1
    while i < n {
        cur = alpha * ptr_read_f32(signal.data_ptr, i) + one_minus * cur
        ptr_write_f32(out.data_ptr, i, cur)
        i += 1
    }
    return out
    }
}

// L2-normalized Cosine Similarity between two embedding vectors (`@no_alloc`)
@no_alloc
fn np_cosine_sim(a: NdArray, b: NdArray) -> f64 {
    na := np_linalg_norm(a)
    nb := np_linalg_norm(b)
    denom := na * nb
    if denom <= 0.000000000001 { return 0.0 }
    return np_dot(a, b) / denom
}

// 4th-order Runge-Kutta (RK4) continuous differential equation step for `dy/dt = -decay_k * y + drive_u`
@no_alloc
fn np_rk4_step_1d(y: f64, dt: f64, decay_k: f64, drive_u: f64) -> f64 {
    k1 := drive_u - decay_k * y
    y2 := y + 0.5 * dt * k1
    k2 := drive_u - decay_k * y2
    y3 := y + 0.5 * dt * k2
    k3 := drive_u - decay_k * y3
    y4 := y + dt * k3
    k4 := drive_u - decay_k * y4
    return y + (dt / 6.0) * (k1 + 2.0 * k2 + 2.0 * k3 + k4)
}

// Continuous Closed-Loop PID Controller with Integral Anti-Windup
struct PidController {
    kp: f64
    ki: f64
    kd: f64
    integral: f64
    prev_err: f64
    out_min: f64
    out_max: f64
}

@no_alloc
fn np_pid_new(kp: f64, ki: f64, kd: f64, out_min: f64 = -1000.0, out_max: f64 = 1000.0) -> PidController {
    return PidController(kp = kp, ki = ki, kd = kd, integral = 0.0, prev_err = 0.0, out_min = out_min, out_max = out_max)
}

@no_alloc
fn np_pid_step(mut pid: PidController, setpoint: f64, measured: f64, dt: f64) -> f64 {
    if dt <= 0.0 { return 0.0 }
    err_val := setpoint - measured
    mut next_int := pid.integral + err_val * dt
    if next_int > pid.out_max { next_int = pid.out_max }
    if next_int < pid.out_min { next_int = pid.out_min }
    pid.integral = next_int
    deriv := (err_val - pid.prev_err) / dt
    pid.prev_err = err_val
    mut out := pid.kp * err_val + pid.ki * next_int + pid.kd * deriv
    if out > pid.out_max { out = pid.out_max }
    if out < pid.out_min { out = pid.out_min }
    return out
}
