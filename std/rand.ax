// Axon v1.0.0 Portable Deterministic PRNG (`std/rand.ax`)
// SplitMix64 + Xoshiro128++ backed by a 32-byte ByteBuf (works natively AND on `--target wasm32`).
// Non-colliding with `std::ai_autograd` (`AiRng`). Free via `rng_free(move r)`.

struct Rng {
    st: ByteBuf
}

fn rng_read_u64(b: ByteBuf, off: i64) -> i64 {
    mut v := 0
    mut i := 7
    while i >= 0 {
        v = (v << 8) | (buf_get(b, off + i) & 255)
        i -= 1
    }
    return v
}

fn rng_write_u64(b: ByteBuf, off: i64, val: i64) {
    mut v := val
    mut i := 0
    while i < 8 {
        buf_set(b, off + i, v & 255)
        v = ushr64(v, 8)
        i += 1
    }
}

fn rng_splitmix_step(x_in: i64) -> i64 {
    mut z := x_in
    z = (z ^ ushr64(z, 30)) *% 0xBF58476D1CE4E5B9
    z = (z ^ ushr64(z, 27)) *% 0x94D049BB133111EB
    return z ^ ushr64(z, 31)
}

fn rng_new(seed_in: i64) -> Rng {
    st := buf_new(32)
    mut z := 0
    while z < 32 {
        buf_push(st, 0)
        z += 1
    }
    mut sm := seed_in
    if sm == 0 { sm = 0x9E3779B97F4A7C15 }
    sm = sm +% 0x9E3779B97F4A7C15
    s0 := rng_splitmix_step(sm)
    sm = sm +% 0x9E3779B97F4A7C15
    s1 := rng_splitmix_step(sm)
    rng_write_u64(st, 0, s0)
    rng_write_u64(st, 8, s1)
    return Rng(st = st)
}

fn rng_free(move r: Rng) {
    buf_free(move r.st)
}

fn rng_rotl64(x: i64, k: i64) -> i64 {
    return (x << k) | ushr64(x, 64 - k)
}

// Returns a pseudo-random 64-bit integer from Xoroshiro128++
fn rng_next_u64(r: Rng) -> i64 {
    s0 := rng_read_u64(r.st, 0)
    mut s1 := rng_read_u64(r.st, 8)
    result := rng_rotl64(s0 +% s1, 17) +% s0
    s1 = s1 ^ s0
    ns0 := rng_rotl64(s0, 49) ^ s1 ^ (s1 << 21)
    ns1 := rng_rotl64(s1, 28)
    rng_write_u64(r.st, 0, ns0)
    rng_write_u64(r.st, 8, ns1)
    return result
}

// Uniform integer in [lo, hi_excl)
fn rng_range(r: Rng, lo: i64, hi_excl: i64) -> i64 ! i64 {
    if hi_excl <= lo { return err(400) }
    span := hi_excl - lo
    if span <= 0 { return err(400) }
    // Rejection sampling using upper bits (mask bit 63 off -> positive 63-bit uniform)
    limit := 9223372036854775807 - (9223372036854775807 % span)
    mut u := rng_next_u64(r) & 0x7FFFFFFFFFFFFFFF
    mut tries := 0
    while u >= limit and tries < 32 {
        u = rng_next_u64(r) & 0x7FFFFFFFFFFFFFFF
        tries += 1
    }
    return ok(lo + (u % span))
}

// Uniform double in [0.0, 1.0) with full 53-bit significand precision
fn rng_f64(r: Rng) -> f64 {
    bits := ushr64(rng_next_u64(r), 11) & 0x1FFFFFFFFFFFFF
    return (bits as f64) / 9007199254740992.0
}

fn rng_bool(r: Rng, pct_true: i64 = 50) -> bool {
    if pct_true <= 0 { return false }
    if pct_true >= 100 { return true }
    v := rng_range(r, 0, 100) or 0
    return v < pct_true
}
