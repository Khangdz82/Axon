// Axon v1.0.0 Portable Monotonic Stopwatch & Time Conversions (`std/time.ax`)
// Works natively (`win-x64`, `linux-x64`, `macos-arm64`) and on `--target wasm32` (WASI clock_time_get).

struct Stopwatch {
    start_ns: i64
}

fn sw_start() -> Stopwatch {
    return Stopwatch(start_ns = clock_ns())
}

fn sw_elapsed_ns(sw: Stopwatch) -> i64 {
    d := clock_ns() - sw.start_ns
    if d < 0 { return 0 }
    return d
}

fn sw_elapsed_us(sw: Stopwatch) -> i64 {
    return sw_elapsed_ns(sw) / 1000
}

fn sw_elapsed_ms(sw: Stopwatch) -> f64 {
    return (sw_elapsed_ns(sw) as f64) / 1000000.0
}

fn sw_lap(sw: Stopwatch) -> Stopwatch {
    _unused := sw.start_ns
    return Stopwatch(start_ns = clock_ns())
}

fn ns_to_us(ns: i64) -> i64 {
    return ns / 1000
}

fn ns_to_ms(ns: i64) -> f64 {
    return (ns as f64) / 1000000.0
}

fn ns_to_sec(ns: i64) -> f64 {
    return (ns as f64) / 1000000000.0
}

fn ms_to_ns(ms: i64) -> i64 {
    return ms * 1000000
}

fn sec_to_ns(sec: i64) -> i64 {
    return sec * 1000000000
}
