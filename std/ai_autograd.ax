// Axon v7.0 AI Autograd, Activation Checkpointing, Mixed-Precision GradScaler & Optimizers (`std/ai_autograd.ax`)
// Supports:
//   - Deterministic PRNG + Kaiming / Xavier weight initialization
//   - `ParamTensor` with configurable optimizer state footprint (`AdamW` 2-buf, `Lion`/`SGD-M` 1-buf, `Adafactor` 0-buf)
//   - Arena-backed Wengert `AutogradTape` with checkpoint/rewind (`0` heap thrashing across steps)
//   - `AdamW`, `Lion` (50% optimizer RAM savings), `SGD-Nesterov`, `Adafactor-RMS` (0 optimizer RAM)
//   - Global L2 Grad Clipping, EMA weights, `GradScaler`, Cosine-Warmup & WSD LR schedulers

use std::ai_engine
use std::ai_math

// --- 1. Deterministic Fast PRNG & Weight Initializers ---

struct AiRng {
    state_ptr: i64
}

fn ai_rng_new(seed: i64) -> AiRng {
    unsafe {
    p := mem_alloc_aligned(64)
    if p == 0 { return AiRng(state_ptr = 0) }
    mut s := seed
    if s == 0 { s = 0x9E3779B97F4A7C15 }
    ptr_write_i64(p, 0, s)
    return AiRng(state_ptr = p)
    }
}

fn ai_rng_free(move r: AiRng) {
    unsafe {
    if r.state_ptr != 0 { mem_free_aligned(r.state_ptr) }
    }
}

@no_alloc
fn ai_rng_next_u64(r: AiRng) -> i64 {
    unsafe {
    mut x := ptr_read_i64(r.state_ptr, 0)
    x = x +% 0x9E3779B97F4A7C15
    ptr_write_i64(r.state_ptr, 0, x)
    mut z := x
    z = (z ^ ushr64(z, 30)) *% 0xBF58476D1CE4E5B9
    z = (z ^ ushr64(z, 27)) *% 0x94D049BB133111EB
    return z ^ ushr64(z, 31)
    }
}

@no_alloc
@nan_guard
fn ai_rng_uniform_01(r: AiRng) -> f64 {
    bits := ai_rng_next_u64(r) & 0x1FFFFFFFFFFFFF
    return (bits as f64) / 9007199254740992.0
}

@no_alloc
@nan_guard
fn ai_rng_normal(r: AiRng, std: f64) -> f64 {
    mut u1 := ai_rng_uniform_01(r)
    if u1 < 0.000000000001 { u1 = 0.000000000001 }
    u2 := ai_rng_uniform_01(r)
    mag := sqrt_f64(-2.0 * ln_f64(u1))
    z := mag * cos_f64(6.283185307179586 * u2)
    return z * std
}

@no_alloc
@nan_guard
fn init_kaiming_normal_f32(dst_ptr: i64, numel: i64, fan_in: i64, rng: AiRng) {
    unsafe {
    std := sqrt_f64(2.0 / max_f64(fan_in as f64, 1.0))
    mut i := 0
    while i < numel {
        ptr_write_f32(dst_ptr, i, ai_rng_normal(rng, std))
        i += 1
    }
    }
}

@no_alloc
@nan_guard
fn init_xavier_uniform_f32(dst_ptr: i64, numel: i64, fan_in: i64, fan_out: i64, rng: AiRng) {
    unsafe {
    limit := sqrt_f64(6.0 / max_f64((fan_in + fan_out) as f64, 1.0))
    mut i := 0
    while i < numel {
        u := ai_rng_uniform_01(rng) * 2.0 - 1.0
        ptr_write_f32(dst_ptr, i, u * limit)
        i += 1
    }
    }
}

// --- 2. Parameter Tensor (`ParamTensor`) ---

fn opt_kind_none() -> i64  { return 0 } // Adafactor-RMS / plain SGD (0 state buffers)
fn opt_kind_lion() -> i64  { return 1 } // Lion / SGD-Momentum (1 state buffer: m)
fn opt_kind_adamw() -> i64 { return 2 } // AdamW (2 state buffers: m, v)

struct ParamTensor {
    data_ptr: i64
    grad_ptr: i64
    m_ptr: i64
    v_ptr: i64
    scratch_ptr: i64
    numel: i64
    opt_kind: i64
}

fn param_new(numel: i64, opt_kind: i64 = 2) -> ParamTensor {
    unsafe {
    bytes := numel * 4 + 64
    dp := mem_alloc_aligned(bytes)
    gp := mem_alloc_aligned(bytes)
    vec_zero_f32(dp, numel)
    vec_zero_f32(gp, numel)
    mut mp := 0
    mut vp := 0
    if opt_kind >= 1 {
        mp = mem_alloc_aligned(bytes)
        vec_zero_f32(mp, numel)
    }
    if opt_kind >= 2 {
        vp = mem_alloc_aligned(bytes)
        vec_zero_f32(vp, numel)
    }
    sp := mem_alloc_aligned(64)
    if sp != 0 { ptr_write_i64(sp, 0, 0) }
    return ParamTensor(
        data_ptr = dp,
        grad_ptr = gp,
        m_ptr = mp,
        v_ptr = vp,
        scratch_ptr = sp,
        numel = numel,
        opt_kind = opt_kind
    )
    }
}

fn param_free(move p: ParamTensor) {
    unsafe {
    if p.data_ptr != 0 { mem_free_aligned(p.data_ptr) }
    if p.grad_ptr != 0 { mem_free_aligned(p.grad_ptr) }
    if p.m_ptr != 0 { mem_free_aligned(p.m_ptr) }
    if p.v_ptr != 0 { mem_free_aligned(p.v_ptr) }
    if p.scratch_ptr != 0 { mem_free_aligned(p.scratch_ptr) }
    }
}

@no_alloc
fn param_zero_grad(p: ParamTensor) {
    vec_zero_f32(p.grad_ptr, p.numel)
}

@no_alloc
fn param_bytes_used(p: ParamTensor) -> i64 {
    mut mult := 2
    if p.opt_kind == 1 { mult = 3 }
    if p.opt_kind >= 2 { mult = 4 }
    return p.numel * 4 * mult
}

// --- 3. Learning Rate Schedules (Cosine-Warmup & WSD) ---

@no_alloc
@nan_guard
fn lr_cosine_warmup(step: i64, warmup_steps: i64, total_steps: i64, max_lr: f64, min_lr: f64) -> f64 {
    if step < warmup_steps and warmup_steps > 0 {
        return max_lr * ((step + 1) as f64) / (warmup_steps as f64)
    }
    if step >= total_steps {
        return min_lr
    }
    decay_steps := max_f64((total_steps - warmup_steps) as f64, 1.0)
    progress := ((step - warmup_steps) as f64) / decay_steps
    cos_val := cos_f64(3.141592653589793 * progress)
    return min_lr + 0.5 * (max_lr - min_lr) * (1.0 + cos_val)
}

// Warmup-Stable-Decay (WSD) schedule: supports continual pretraining & instant checkpoint branching.
@no_alloc
@nan_guard
fn lr_wsd(step: i64, warmup_steps: i64, stable_steps: i64, decay_steps: i64, max_lr: f64, min_lr: f64) -> f64 {
    if step < warmup_steps and warmup_steps > 0 {
        return max_lr * ((step + 1) as f64) / (warmup_steps as f64)
    }
    if step < warmup_steps + stable_steps {
        return max_lr
    }
    decay_pos := step - (warmup_steps + stable_steps)
    if decay_pos >= decay_steps or decay_steps <= 0 {
        return min_lr
    }
    ratio := (decay_pos as f64) / (decay_steps as f64)
    return min_lr + (max_lr - min_lr) * (1.0 - ratio)
}

// --- 4. Gradient Stability, Clipping, EMA & Mixed-Precision `GradScaler` ---

@no_alloc
@nan_guard
fn grad_l2_norm_ptr(g_ptr: i64, numel: i64) -> f64 {
    unsafe { return sqrt_f64(dlpack_dot_f32(g_ptr, g_ptr, numel)) }
}

@no_alloc
@nan_guard
fn grad_clip_norm_ptr(g_ptr: i64, numel: i64, max_norm: f64) -> f64 {
    norm := grad_l2_norm_ptr(g_ptr, numel)
    if norm > max_norm and max_norm > 0.0 {
        scale := max_norm / (norm + 0.000000000001)
        vec_scale_f32(g_ptr, g_ptr, scale, numel)
    }
    return norm
}

// Checks IEEE-754 `f32` exponent bits `(bits & 0x7F800000) == 0x7F800000` without trapping.
@no_alloc
fn grad_check_finite_ptr(g_ptr: i64, numel: i64, scratch_ptr: i64) -> bool {
    unsafe {
    mut i := 0
    while i < numel {
        ptr_write_f32(scratch_ptr, 0, ptr_read_f32(g_ptr, i))
        bits := ptr_read_i64(scratch_ptr, 0) & 0xFFFFFFFF
        if (bits & 0x7F800000) == 0x7F800000 {
            return false
        }
        i += 1
    }
    return true
    }
}

@no_alloc
@nan_guard
fn ema_update_ptr(ema_ptr: i64, model_ptr: i64, numel: i64, decay: f64) {
    unsafe {
    one_minus := 1.0 - decay
    mut i := 0
    while i < numel {
        ev := ptr_read_f32(ema_ptr, i)
        mv := ptr_read_f32(model_ptr, i)
        ptr_write_f32(ema_ptr, i, decay * ev + one_minus * mv)
        i += 1
    }
    }
}

struct GradScaler {
    state_ptr: i64 // [0]=scale_f32, [1]=growth_tracker_i64, [2]=growth_interval_i64, [3]=found_inf_i64
    growth_factor: f64
    backoff_factor: f64
}

fn grad_scaler_new(init_scale: f64 = 65536.0, growth_interval: i64 = 2000) -> GradScaler {
    unsafe {
    st := mem_alloc_aligned(64)
    if st == 0 { return GradScaler(state_ptr = 0) }
    ptr_write_f32(st, 0, init_scale)
    ptr_write_i64(st, 1, 0)
    ptr_write_i64(st, 2, growth_interval)
    ptr_write_i64(st, 3, 0)
    return GradScaler(state_ptr = st, growth_factor = 2.0, backoff_factor = 0.5)
    }
}

fn grad_scaler_free(move gs: GradScaler) {
    unsafe {
    if gs.state_ptr != 0 { mem_free_aligned(gs.state_ptr) }
    }
}

@no_alloc
fn grad_scaler_get_scale(gs: GradScaler) -> f64 {
    unsafe {
    return ptr_read_f32(gs.state_ptr, 0)
    }
}

@no_alloc
@nan_guard
fn grad_scaler_unscale_and_check(gs: GradScaler, p: ParamTensor) -> bool {
    unsafe {
    sc := ptr_read_f32(gs.state_ptr, 0)
    if not grad_check_finite_ptr(p.grad_ptr, p.numel, p.scratch_ptr) {
        ptr_write_i64(gs.state_ptr, 3, 1)
        return false
    }
    inv_sc := 1.0 / max_f64(sc, 0.000001)
    vec_scale_f32(p.grad_ptr, p.grad_ptr, inv_sc, p.numel)
    return true
    }
}

@no_alloc
@nan_guard
fn grad_scaler_update(gs: GradScaler) {
    unsafe {
    found_inf := ptr_read_i64(gs.state_ptr, 3)
    mut sc := ptr_read_f32(gs.state_ptr, 0)
    if found_inf != 0 {
        sc = max_f64(sc * gs.backoff_factor, 1.0)
        ptr_write_f32(gs.state_ptr, 0, sc)
        ptr_write_i64(gs.state_ptr, 1, 0)
        ptr_write_i64(gs.state_ptr, 3, 0)
        return
    }
    tr := ptr_read_i64(gs.state_ptr, 1) + 1
    gi := ptr_read_i64(gs.state_ptr, 2)
    if tr >= gi {
        sc = min_f64(sc * gs.growth_factor, 16777216.0)
        ptr_write_f32(gs.state_ptr, 0, sc)
        ptr_write_i64(gs.state_ptr, 1, 0)
    } else {
        ptr_write_i64(gs.state_ptr, 1, tr)
    }
    }
}

// --- 5. High-Accuracy & Low-Memory Optimizers (`AdamW`, `Lion`, `SGD-Nesterov`, `Adafactor-RMS`) ---

@no_alloc
@nan_guard
fn adamw_step_ptr(w_ptr: i64, g_ptr: i64, m_ptr: i64, v_ptr: i64, numel: i64, step_num: i64, lr: f64, beta1: f64, beta2: f64, eps: f64, weight_decay: f64) {
    unsafe {
    mut st := step_num
    if st < 1 { st = 1 }
    bc1 := 1.0 - pow_f64(beta1, st as f64)
    bc2 := 1.0 - pow_f64(beta2, st as f64)
    inv_bc1 := 1.0 / max_f64(bc1, 0.000000000001)
    inv_bc2 := 1.0 / max_f64(bc2, 0.000000000001)
    one_m_b1 := 1.0 - beta1
    one_m_b2 := 1.0 - beta2
    decay_factor := 1.0 - lr * weight_decay
    mut i := 0
    while i < numel {
        w := ptr_read_f32(w_ptr, i) * decay_factor
        g := ptr_read_f32(g_ptr, i)
        m := beta1 * ptr_read_f32(m_ptr, i) + one_m_b1 * g
        v := beta2 * ptr_read_f32(v_ptr, i) + one_m_b2 * g * g
        ptr_write_f32(m_ptr, i, m)
        ptr_write_f32(v_ptr, i, v)
        m_hat := m * inv_bc1
        v_hat := v * inv_bc2
        upd := m_hat / (sqrt_f64(max_f64(v_hat, 0.0)) + eps)
        ptr_write_f32(w_ptr, i, w - lr * upd)
        i += 1
    }
    }
}

@no_alloc
@nan_guard
fn adamw_step(p: ParamTensor, step_num: i64, lr: f64, beta1: f64 = 0.9, beta2: f64 = 0.999, eps: f64 = 0.00000001, weight_decay: f64 = 0.01) {
    adamw_step_ptr(p.data_ptr, p.grad_ptr, p.m_ptr, p.v_ptr, p.numel, step_num, lr, beta1, beta2, eps, weight_decay)
}

// Google Brain `Lion` optimizer: 50% less optimizer RAM than AdamW (no `v` buffer!).
@no_alloc
@nan_guard
fn lion_step_ptr(w_ptr: i64, g_ptr: i64, m_ptr: i64, numel: i64, lr: f64, beta1: f64, beta2: f64, weight_decay: f64) {
    unsafe {
    one_m_b1 := 1.0 - beta1
    one_m_b2 := 1.0 - beta2
    decay_factor := 1.0 - lr * weight_decay
    mut i := 0
    while i < numel {
        w := ptr_read_f32(w_ptr, i) * decay_factor
        g := ptr_read_f32(g_ptr, i)
        m := ptr_read_f32(m_ptr, i)
        c := beta1 * m + one_m_b1 * g
        mut sgn := 0.0
        if c > 0.0 { sgn = 1.0 } else if c < 0.0 { sgn = -1.0 }
        ptr_write_f32(w_ptr, i, w - lr * sgn)
        ptr_write_f32(m_ptr, i, beta2 * m + one_m_b2 * g)
        i += 1
    }
    }
}

@no_alloc
@nan_guard
fn lion_step(p: ParamTensor, lr: f64, beta1: f64 = 0.9, beta2: f64 = 0.99, weight_decay: f64 = 0.01) {
    lion_step_ptr(p.data_ptr, p.grad_ptr, p.m_ptr, p.numel, lr, beta1, beta2, weight_decay)
}

@no_alloc
@nan_guard
fn sgd_nesterov_step_ptr(w_ptr: i64, g_ptr: i64, m_ptr: i64, numel: i64, lr: f64, momentum: f64, weight_decay: f64) {
    unsafe {
    mut i := 0
    while i < numel {
        w := ptr_read_f32(w_ptr, i)
        g := ptr_read_f32(g_ptr, i) + weight_decay * w
        v := momentum * ptr_read_f32(m_ptr, i) + g
        ptr_write_f32(m_ptr, i, v)
        ptr_write_f32(w_ptr, i, w - lr * (g + momentum * v))
        i += 1
    }
    }
}

// Zero-state Adafactor-style RMS-normalized step: 0 extra optimizer memory!
@no_alloc
@nan_guard
fn adafactor_rms_step_ptr(w_ptr: i64, g_ptr: i64, numel: i64, lr: f64, weight_decay: f64, eps: f64) {
    unsafe {
    if numel <= 0 { return }
    rms_g := sqrt_f64(dlpack_dot_f32(g_ptr, g_ptr, numel) / (numel as f64) + eps)
    rms_w := sqrt_f64(dlpack_dot_f32(w_ptr, w_ptr, numel) / (numel as f64) + eps)
    step_scale := lr * max_f64(rms_w, 0.01) / max_f64(rms_g, eps)
    decay := 1.0 - lr * weight_decay
    mut i := 0
    while i < numel {
        w := ptr_read_f32(w_ptr, i) * decay
        g := ptr_read_f32(g_ptr, i)
        ptr_write_f32(w_ptr, i, w - step_scale * g)
        i += 1
    }
    }
}

// --- 6. Arena-Backed Wengert `AutogradTape` with Activation Checkpointing ---

fn tape_op_add() -> i64    { return 1 }
fn tape_op_mul() -> i64    { return 2 }
fn tape_op_silu() -> i64   { return 3 }
fn tape_op_relu() -> i64   { return 4 }
fn tape_op_gelu() -> i64   { return 5 }
fn tape_op_linear() -> i64 { return 6 } // Y[m, n] = X[m, k] @ W[n, k]^T + b[n]

struct AutogradTape {
    nodes_buf: IntBuf // 11 i64 words per node: [op, a_ptr, b_ptr, out_ptr, da_ptr, db_ptr, dout_ptr, m, k, n, c_ptr]
    meta_ptr: i64     // [0]=node_count
    act_arena: VramArena
}

fn autograd_tape_new(arena_bytes: i64 = 1048576, max_nodes: i64 = 1024) -> AutogradTape {
    unsafe {
    nb := ibuf_new(max_nodes * 11)
    mut i := 0
    total := max_nodes * 11
    while i < total {
        ibuf_push(nb, 0)
        i += 1
    }
    mp := mem_alloc_aligned(64)
    if mp != 0 { ptr_write_i64(mp, 0, 0) }
    arena := vram_arena_new(arena_bytes)
    return AutogradTape(nodes_buf = nb, meta_ptr = mp, act_arena = arena)
    }
}

fn autograd_tape_free(move t: AutogradTape) {
    unsafe {
    if t.meta_ptr != 0 { mem_free_aligned(t.meta_ptr) }
    vram_arena_free(move t.act_arena)
    buf_free(move t.nodes_buf)
    }
}

@no_alloc
fn tape_node_count(t: AutogradTape) -> i64 {
    unsafe {
    return ptr_read_i64(t.meta_ptr, 0)
    }
}

// Saves `(node_count << 32) | arena_used_bytes` for activation checkpointing / micro-batch reuse.
@no_alloc
fn tape_checkpoint_mark(t: AutogradTape) -> i64 {
    unsafe {
    nc := ptr_read_i64(t.meta_ptr, 0)
    ab := vram_arena_used_bytes(t.act_arena)
    return (nc << 32) | (ab & 0xFFFFFFFF)
    }
}

@no_alloc
fn tape_rewind(t: AutogradTape, mark: i64) {
    unsafe {
    nc := ushr64(mark, 32)
    ab := mark & 0xFFFFFFFF
    ptr_write_i64(t.meta_ptr, 0, nc)
    ptr_write_i64(t.act_arena.state_ptr, 0, ab)
    }
}

@no_alloc
fn tape_reset(t: AutogradTape) {
    unsafe {
    ptr_write_i64(t.meta_ptr, 0, 0)
    vram_arena_reset(t.act_arena)
    }
}

@no_alloc
fn tape_alloc_zero_f32(t: AutogradTape, numel: i64) -> i64 {
    p := vram_arena_alloc_f32(t.act_arena, numel)
    if p != 0 {
        vec_zero_f32(p, numel)
    }
    return p
}

@no_alloc
fn tape_push_node(t: AutogradTape, op: i64, a_ptr: i64, b_ptr: i64, out_ptr: i64, da_ptr: i64, db_ptr: i64, dout_ptr: i64, m: i64, k: i64, n: i64, c_ptr: i64) -> i64 {
    unsafe {
    idx := ptr_read_i64(t.meta_ptr, 0)
    base := idx * 11
    if base + 10 >= ibuf_len(t.nodes_buf) {
        return -1
    }
    ibuf_set(t.nodes_buf, base, op)
    ibuf_set(t.nodes_buf, base + 1, a_ptr)
    ibuf_set(t.nodes_buf, base + 2, b_ptr)
    ibuf_set(t.nodes_buf, base + 3, out_ptr)
    ibuf_set(t.nodes_buf, base + 4, da_ptr)
    ibuf_set(t.nodes_buf, base + 5, db_ptr)
    ibuf_set(t.nodes_buf, base + 6, dout_ptr)
    ibuf_set(t.nodes_buf, base + 7, m)
    ibuf_set(t.nodes_buf, base + 8, k)
    ibuf_set(t.nodes_buf, base + 9, n)
    ibuf_set(t.nodes_buf, base + 10, c_ptr)
    ptr_write_i64(t.meta_ptr, 0, idx + 1)
    return idx
    }
}

@no_alloc
@nan_guard
fn tape_linear_fwd(t: AutogradTape, x_ptr: i64, dx_ptr: i64, w_param: ParamTensor, bias_ptr: i64, dbias_ptr: i64, batch: i64, in_dim: i64, out_dim: i64, out_ptr: i64, dout_ptr: i64) {
    unsafe {
    // Y[batch, out_dim] = X[batch, in_dim] @ W[out_dim, in_dim]^T + bias
    gemm_f32(x_ptr, w_param.data_ptr, out_ptr, batch, in_dim, out_dim, false, true, 1.0, 0.0)
    if bias_ptr != 0 {
        mut b := 0
        while b < batch {
            row := b * out_dim
            mut j := 0
            while j < out_dim {
                ptr_write_f32(out_ptr, row + j, ptr_read_f32(out_ptr, row + j) + ptr_read_f32(bias_ptr, j))
                j += 1
            }
            b += 1
        }
    }
    _nid := tape_push_node(t, tape_op_linear(), x_ptr, w_param.data_ptr, out_ptr, dx_ptr, w_param.grad_ptr, dout_ptr, batch, in_dim, out_dim, dbias_ptr)
    }
}

@no_alloc
@nan_guard
fn tape_silu_fwd(t: AutogradTape, x_ptr: i64, dx_ptr: i64, out_ptr: i64, dout_ptr: i64, numel: i64) {
    silu_fwd_f32(out_ptr, x_ptr, numel)
    _nid := tape_push_node(t, tape_op_silu(), x_ptr, 0, out_ptr, dx_ptr, 0, dout_ptr, numel, 0, 0, 0)
}

@no_alloc
@nan_guard
fn tape_relu_fwd(t: AutogradTape, x_ptr: i64, dx_ptr: i64, out_ptr: i64, dout_ptr: i64, numel: i64) {
    relu_fwd_f32(out_ptr, x_ptr, numel)
    _nid := tape_push_node(t, tape_op_relu(), x_ptr, 0, out_ptr, dx_ptr, 0, dout_ptr, numel, 0, 0, 0)
}

@no_alloc
@nan_guard
fn tape_gelu_fwd(t: AutogradTape, x_ptr: i64, dx_ptr: i64, out_ptr: i64, dout_ptr: i64, numel: i64) {
    gelu_fwd_f32(out_ptr, x_ptr, numel)
    _nid := tape_push_node(t, tape_op_gelu(), x_ptr, 0, out_ptr, dx_ptr, 0, dout_ptr, numel, 0, 0, 0)
}

@no_alloc
@nan_guard
fn tape_add_fwd(t: AutogradTape, a_ptr: i64, da_ptr: i64, b_ptr: i64, db_ptr: i64, out_ptr: i64, dout_ptr: i64, numel: i64) {
    vec_add_f32(out_ptr, a_ptr, b_ptr, numel)
    _nid := tape_push_node(t, tape_op_add(), a_ptr, b_ptr, out_ptr, da_ptr, db_ptr, dout_ptr, numel, 0, 0, 0)
}

// Reverse-mode automatic differentiation pass across all recorded nodes.
@no_alloc
@nan_guard
fn tape_backward(t: AutogradTape) {
    unsafe {
    mut idx := ptr_read_i64(t.meta_ptr, 0) - 1
    while idx >= 0 {
        base := idx * 11
        op := ibuf_get(t.nodes_buf, base)
        a_ptr := ibuf_get(t.nodes_buf, base + 1)
        b_ptr := ibuf_get(t.nodes_buf, base + 2)
        da_ptr := ibuf_get(t.nodes_buf, base + 4)
        db_ptr := ibuf_get(t.nodes_buf, base + 5)
        dout_ptr := ibuf_get(t.nodes_buf, base + 6)
        m := ibuf_get(t.nodes_buf, base + 7)
        k := ibuf_get(t.nodes_buf, base + 8)
        n := ibuf_get(t.nodes_buf, base + 9)
        c_ptr := ibuf_get(t.nodes_buf, base + 10)

        if op == tape_op_add() and dout_ptr != 0 {
            if da_ptr != 0 { vec_axpy_f32(da_ptr, dout_ptr, 1.0, m) }
            if db_ptr != 0 { vec_axpy_f32(db_ptr, dout_ptr, 1.0, m) }
        } else if op == tape_op_silu() and dout_ptr != 0 and da_ptr != 0 {
            // Accumulate into `da_ptr`
            mut i := 0
            while i < m {
                x := ptr_read_f32(a_ptr, i)
                s := sigmoid_f64(x)
                ds := s * (1.0 + x * (1.0 - s))
                ptr_write_f32(da_ptr, i, ptr_read_f32(da_ptr, i) + ptr_read_f32(dout_ptr, i) * ds)
                i += 1
            }
        } else if op == tape_op_relu() and dout_ptr != 0 and da_ptr != 0 {
            mut i := 0
            while i < m {
                if ptr_read_f32(a_ptr, i) > 0.0 {
                    ptr_write_f32(da_ptr, i, ptr_read_f32(da_ptr, i) + ptr_read_f32(dout_ptr, i))
                }
                i += 1
            }
        } else if op == tape_op_gelu() and dout_ptr != 0 and da_ptr != 0 {
            c := 0.7978845608028654
            mut i := 0
            while i < m {
                x := ptr_read_f32(a_ptr, i)
                x2 := x * x
                t_val := tanh_f64(c * (x + 0.044715 * x * x2))
                sech2 := 1.0 - t_val * t_val
                du := c * (1.0 + 0.134145 * x2)
                dgelu := 0.5 * (1.0 + t_val) + 0.5 * x * sech2 * du
                ptr_write_f32(da_ptr, i, ptr_read_f32(da_ptr, i) + ptr_read_f32(dout_ptr, i) * dgelu)
                i += 1
            }
        } else if op == tape_op_linear() and dout_ptr != 0 {
            // dX[m, k] += dY[m, n] @ W[n, k]
            if da_ptr != 0 {
                gemm_f32(dout_ptr, b_ptr, da_ptr, m, n, k, false, false, 1.0, 1.0)
            }
            // dW[n, k] += dY^T[n, m] @ X[m, k]
            if db_ptr != 0 {
                gemm_f32(dout_ptr, a_ptr, db_ptr, n, m, k, true, false, 1.0, 1.0)
            }
            // dbias[n] += sum_b dY[b, n]
            if c_ptr != 0 {
                mut b := 0
                while b < m {
                    row := b * n
                    mut j := 0
                    while j < n {
                        ptr_write_f32(c_ptr, j, ptr_read_f32(c_ptr, j) + ptr_read_f32(dout_ptr, row + j))
                        j += 1
                    }
                    b += 1
                }
            }
        }
        idx -= 1
    }
    }
}
