// Axon Standard Library: UUID v4 & UUID v7 RFC-4122 / RFC-9562 (`std/uuid.ax`)
// Pure native value-type implementation (PRNG-seeded via `std::rand` + timestamp v7).

use std::os
use std::str
use std::rand
use std::time
use std::ffi

struct Uuid {
    hi: i64
    lo: i64
}

fn uuid_hex_val(ch: i64) -> i64 {
    if ch >= 48 and ch <= 57 { return ch - 48 }
    if ch >= 97 and ch <= 102 { return ch - 97 + 10 }
    if ch >= 65 and ch <= 70 { return ch - 65 + 10 }
    return -1
}

fn uuid_hex_byte(nibble: i64) -> i64 {
    v := nibble & 15
    if v < 10 { return 48 + v }
    return 97 + (v - 10)
}

fn uuid_nil() -> Uuid {
    return Uuid(hi = 0, lo = 0)
}

fn uuid_is_nil(u: Uuid) -> bool {
    return u.hi == 0 and u.lo == 0
}

fn uuid_eq(a: Uuid, b: Uuid) -> bool {
    return a.hi == b.hi and a.lo == b.lo
}

fn uuid_to_str(u: Uuid) -> str {
    b := buf_new(37)
    // 36 chars: 8-4-4-4-12
    // hi has 16 hex chars (8-4-4)
    mut i := 15
    while i >= 8 {
        nibble := (u.hi >> (i * 4)) & 15
        buf_push(b, uuid_hex_byte(nibble))
        i -= 1
    }
    buf_push(b, 45) // '-'
    while i >= 4 {
        nibble := (u.hi >> (i * 4)) & 15
        buf_push(b, uuid_hex_byte(nibble))
        i -= 1
    }
    buf_push(b, 45) // '-'
    while i >= 0 {
        nibble := (u.hi >> (i * 4)) & 15
        buf_push(b, uuid_hex_byte(nibble))
        i -= 1
    }
    buf_push(b, 45) // '-'

    // lo has 16 hex chars (4-12)
    mut j := 15
    while j >= 12 {
        nibble := (u.lo >> (j * 4)) & 15
        buf_push(b, uuid_hex_byte(nibble))
        j -= 1
    }
    buf_push(b, 45) // '-'
    while j >= 0 {
        nibble := (u.lo >> (j * 4)) & 15
        buf_push(b, uuid_hex_byte(nibble))
        j -= 1
    }

    return buf_to_owned_str(move b)
}

fn uuid_is_valid(s: str) -> bool {
    if str_len(s) != 36 {
        return false
    }
    if str_byte(s, 8) != 45 or str_byte(s, 13) != 45 or str_byte(s, 18) != 45 or str_byte(s, 23) != 45 {
        return false
    }
    mut i := 0
    while i < 36 {
        if i != 8 and i != 13 and i != 18 and i != 23 {
            if uuid_hex_val(str_byte(s, i)) < 0 {
                return false
            }
        }
        i += 1
    }
    return true
}

fn uuid_parse(s: str) -> Uuid ! i64 {
    if not uuid_is_valid(s) {
        return err(400)
    }
    mut hi := 0
    mut lo := 0
    
    // Parse hi (indices 0..7, 9..12, 14..17 -> 16 hex chars)
    mut i := 0
    while i < 18 {
        if i != 8 and i != 13 {
            h := uuid_hex_val(str_byte(s, i))
            hi = (hi << 4) | h
        }
        i += 1
    }

    // Parse lo (indices 19..22, 24..35 -> 16 hex chars)
    mut j := 19
    while j < 36 {
        if j != 23 {
            h := uuid_hex_val(str_byte(s, j))
            lo = (lo << 4) | h
        }
        j += 1
    }

    return ok(Uuid(hi = hi, lo = lo))
}

fn uuid_v4_with_rng(mut r: Rng) -> Uuid {
    r1 := rng_next_u64(mut r)
    r2 := rng_next_u64(mut r)
    
    // Set version to 4: bits 12..15 of time_hi_and_version (mask 0x000000000000F000 -> 0x4000)
    mut hi := (r1 & 0xFFFFFFFFFFFF0FFF) | 0x0000000000004000
    // Set variant to RFC 4122: bits 6..7 of clock_seq_hi_and_reserved to 10 (mask 0x3FFFFFFFFFFFFFFF -> 0x8000000000000000)
    mut lo := (r2 & 0x3FFFFFFFFFFFFFFF) | 0x8000000000000000

    return Uuid(hi = hi, lo = lo)
}

// Pulls 128-bit cryptographic entropy from OS CSPRNG (`BCryptGenRandom` on Windows),
// with automatic high-res TSC + clock SplitMix fallback on non-Windows/minimal targets.
fn _uuid_os_entropy_u64(salt: i64) -> i64 {
    mut out := rng_splitmix_step(clock_ns() ^ (cpu_rdtsc() *% 0x9E3779B97F4A7C15) ^ salt)
    h := ffi_open_one("bcrypt.dll")
    if h != 0 {
        f := ffi_sym(h, "BCryptGenRandom")
        if f != 0 {
            buf := ffi_alloc(16)
            if buf != 0 {
                // NTSTATUS BCryptGenRandom(NULL, pbBuffer, 8, BCRYPT_USE_SYSTEM_PREFERRED_RNG=2)
                st := ffi_sext32(ffi_call4(f, 0, buf, 8, 2))
                if st == 0 {
                    out = ffi_read_i64(buf, 0)
                }
                ffi_free(buf)
            }
        }
        ffi_close(h)
    }
    return out
}

fn uuid_v4() -> str {
    r1 := _uuid_os_entropy_u64(0x5DEECE66D)
    r2 := _uuid_os_entropy_u64(0xBF58476D1CE4E5B9)
    hi := (r1 & 0xFFFFFFFFFFFF0FFF) | 0x0000000000004000
    lo := (r2 & 0x3FFFFFFFFFFFFFFF) | 0x8000000000000000
    return uuid_to_str(Uuid(hi = hi, lo = lo))
}

fn uuid_v7() -> str {
    now_ms := clock_ns() / 1000000
    r_lo := _uuid_os_entropy_u64(0xDECAFBAD)
    r_rand12 := _uuid_os_entropy_u64(0x94D049BB133111EB) & 0x0FFF

    // RFC 9562 UUID v7:
    // unix_ts_ms (48 bits) | ver (4 bits = 0x7) | rand_a (12 bits)
    hi := ((now_ms & 0x0000FFFFFFFFFFFF) << 16) | 0x7000 | r_rand12
    // var (2 bits = 0b10) | rand_b (62 bits)
    lo := (r_lo & 0x3FFFFFFFFFFFFFFF) | 0x8000000000000000

    return uuid_to_str(Uuid(hi = hi, lo = lo))
}
