// Axon Standard Library — Model Context Protocol (MCP) JSON-RPC 2.0 SDK & Code Mode Hub (`std/mcp.ax`)
// 100% Pure Axon replacement for Code Mode `server.py` + `mcp_hub.py` (Zero Python, Zero External Dependencies):
//   1. JSON-RPC 2.0 Protocol Framing (`mcp_build_ok`, `mcp_build_error`, `mcp_tool_text_result`, `mcp_unwrap_tool_result`)
//   2. MCP Server (`McpServer`) supporting MCP `2025-06-18` lifecycle (`initialize`, `ping`, `tools/list`, `tools/call`)
//   3. Upstream MCP Stdio Client (`McpStdioClient` via `std::subprocess`) & Streamable HTTP/SSE Client (`mcp_http_rpc`)
//   4. Cloudflare Code Mode Progressive Discovery Hub (`McpHub`):
//      - SHA-256 config+mtime+size fingerprinting + atomic disk schema cache (`<1ms` search/describe, zero cold spawns!)
//      - Keyword-ranked `mcp_hub_search` returning ultra-compact typed signatures (90%+ prompt token savings!)
//      - On-demand `mcp_hub_describe` & CSPRNG-authenticated loopback bridge token helpers

use std::str
use std::ds
use std::json
use std::json_dom
use std::crypto
use std::secrets
use std::shutil
use std::fs
use std::path
use std::subprocess
use std::fetch
use std::ai_harness

// ==================== 1. JSON-RPC 2.0 & MCP RESULT FRAMING ====================

fn mcp_norm_name(name: str) -> str {
    return str_replace(str_replace(str_replace(name, "-", "_"), ".", "_"), " ", "_")
}

fn mcp_build_ok(id_raw: str, result_json: str) -> str {
    rid := if str_len(id_raw) > 0 { id_raw } else { "null" }
    res := if str_len(result_json) > 0 { result_json } else { "{}" }
    return "{\"jsonrpc\":\"2.0\",\"id\":" + rid + ",\"result\":" + res + "}"
}

fn mcp_build_error(id_raw: str, code: i64, message: str) -> str {
    rid := if str_len(id_raw) > 0 { id_raw } else { "null" }
    eb := buf_new(str_len(message) * 6 + str_len(rid) + 96)
    buf_push_str(eb, "{\"jsonrpc\":\"2.0\",\"id\":")
    buf_push_str(eb, rid)
    buf_push_str(eb, ",\"error\":{\"code\":")
    buf_append_i64(eb, code)
    buf_push_str(eb, ",\"message\":\"")
    json_push_escaped(eb, message)
    buf_push_str(eb, "\"}}")
    return buf_to_owned_str(move eb)
}

// Formats MCP `tools/call` text result with line-aware middle truncation (slashes token bloat!)
fn mcp_tool_text_result(text: str, is_error: bool = false, max_chars: i64 = 50000) -> str {
    trunc := harness_truncate_middle(text, max_chars)
    eb := buf_new(str_len(trunc) * 6 + 96)
    buf_push_str(eb, "{\"content\":[{\"type\":\"text\",\"text\":\"")
    json_push_escaped(eb, trunc)
    buf_push_str(eb, "\"}],\"isError\":")
    buf_push_str(eb, if is_error { "true" } else { "false" })
    buf_push(eb, 125)
    return buf_to_owned_str(move eb)
}

// Unwraps an MCP `tools/call` result JSON -> returns text/structuredContent or `err(500)` if `isError: true`
fn mcp_unwrap_tool_result(result_json: str) -> str ! i64 {
    doc := jdoc_parse(result_json) or return ok(result_json)
    if jdoc_type(doc, doc.root) != JVAL_OBJECT() {
        jdoc_free(move doc)
        return ok(result_json)
    }
    err_id := jdoc_obj_get(doc, doc.root, "isError")
    is_err := err_id >= 0 and jdoc_as_bool(doc, err_id, false)
    sc_id := jdoc_obj_get(doc, doc.root, "structuredContent")
    if not is_err and sc_id >= 0 and not jdoc_is_null(doc, sc_id) {
        s := jdoc_stringify(doc, sc_id, false, 0)
        jdoc_free(move doc)
        return ok(s)
    }
    c_id := jdoc_obj_get(doc, doc.root, "content")
    if c_id >= 0 and jdoc_type(doc, c_id) == JVAL_ARRAY() {
        mut parts := svec_new(4, 256)
        mut cur := jdoc_first_child(doc, c_id)
        while cur >= 0 {
            if jdoc_type(doc, cur) == JVAL_OBJECT() {
                t_id := jdoc_obj_get(doc, cur, "type")
                if t_id >= 0 and str_eq(jdoc_as_str(doc, t_id, ""), "text") {
                    tx_id := jdoc_obj_get(doc, cur, "text")
                    if tx_id >= 0 { svec_push(mut parts, jdoc_as_str(doc, tx_id, "")) }
                }
            }
            cur = jdoc_next_sib(doc, cur)
        }
        joined := svec_join(parts, "\n")
        svec_free(move parts)
        jdoc_free(move doc)
        if is_err { return err(500) }
        return ok(joined)
    }
    jdoc_free(move doc)
    if is_err { return err(500) }
    return ok(result_json)
}

// ==================== 2. MCP SERVER (`2025-06-18` JSON-RPC 2.0) ====================

struct McpServer {
    name: str
    version: str
    instructions: str
    tools: ToolRegistry
}

fn mcp_server_new(name: str, version: str = "1.0.0", instructions: str = "") -> McpServer {
    return McpServer(
        name = name,
        version = version,
        instructions = instructions,
        tools = tool_reg_new()
    )
}

fn mcp_server_free(move srv: McpServer) {
    tool_reg_free(move srv.tools)
}

fn mcp_server_add_tool(mut srv: McpServer, name: str, description: str, input_schema_json: str) -> bool {
    return tool_reg_add(mut srv.tools, name, description, input_schema_json)
}

fn mcp_server_build_tools_list(srv: McpServer) -> str {
    est := buf_len(srv.tools.data) * 6 + srv.tools.count * 128 + 128
    out := buf_new(est)
    buf_push_str(out, "{\"tools\":[")
    mut i := 0
    while i < srv.tools.count {
        if i > 0 { buf_push(out, 44) }
        b := i * 6
        tn := buf_slice_str(srv.tools.data, ibuf_get(srv.tools.meta, b), ibuf_get(srv.tools.meta, b) + ibuf_get(srv.tools.meta, b + 1))
        td := buf_slice_str(srv.tools.data, ibuf_get(srv.tools.meta, b + 2), ibuf_get(srv.tools.meta, b + 2) + ibuf_get(srv.tools.meta, b + 3))
        ts := buf_slice_str(srv.tools.data, ibuf_get(srv.tools.meta, b + 4), ibuf_get(srv.tools.meta, b + 4) + ibuf_get(srv.tools.meta, b + 5))
        buf_push_str(out, "{\"name\":\"")
        json_push_escaped(out, tn)
        buf_push_str(out, "\",\"description\":\"")
        json_push_escaped(out, td)
        buf_push_str(out, "\",\"inputSchema\":")
        buf_push_str(out, if str_len(ts) > 0 { ts } else { "{\"type\":\"object\",\"properties\":{}}" })
        buf_push(out, 125)
        i += 1
    }
    buf_push_str(out, "]}")
    return buf_to_owned_str(move out)
}

struct McpParsedReq {
    valid: bool
    is_notification: bool
    is_tool_call: bool
    id_raw: str
    method: str
    tool_name: str
    tool_args_json: str
    auto_response: str
}

// Parses an incoming MCP JSON-RPC 2.0 line and auto-handles protocol lifecycle methods;
// for `tools/call`, sets `is_tool_call = true` with extracted `tool_name` & `tool_args_json`!
fn mcp_server_handle_line(srv: McpServer, raw_line: str) -> McpParsedReq {
    doc := jdoc_parse(raw_line) or return McpParsedReq(
        valid = false, is_notification = false, is_tool_call = false,
        id_raw = "null", method = "", tool_name = "", tool_args_json = "{}",
        auto_response = mcp_build_error("null", -32700, "Parse error")
    )
    if jdoc_type(doc, doc.root) != JVAL_OBJECT() {
        jdoc_free(move doc)
        return McpParsedReq(
            valid = false, is_notification = false, is_tool_call = false,
            id_raw = "null", method = "", tool_name = "", tool_args_json = "{}",
            auto_response = mcp_build_error("null", -32600, "Invalid Request")
        )
    }
    m_id := jdoc_obj_get(doc, doc.root, "method")
    if m_id < 0 or jdoc_type(doc, m_id) != JVAL_STR() {
        jdoc_free(move doc)
        return McpParsedReq(valid = false, is_notification = true, is_tool_call = false, id_raw = "null", method = "", tool_name = "", tool_args_json = "{}", auto_response = "")
    }
    method := jdoc_as_str(doc, m_id, "")
    id_n := jdoc_obj_get(doc, doc.root, "id")
    if id_n < 0 {
        jdoc_free(move doc)
        return McpParsedReq(valid = true, is_notification = true, is_tool_call = false, id_raw = "null", method = method, tool_name = "", tool_args_json = "{}", auto_response = "")
    }
    id_raw := jdoc_stringify(doc, id_n, false, 0)
    params_n := jdoc_obj_get(doc, doc.root, "params")

    if str_eq(method, "initialize") {
        mut proto := "2025-06-18"
        if params_n >= 0 and jdoc_type(doc, params_n) == JVAL_OBJECT() {
            pv := jdoc_obj_get(doc, params_n, "protocolVersion")
            if pv >= 0 and jdoc_type(doc, pv) == JVAL_STR() {
                proto = jdoc_as_str(doc, pv, "2025-06-18")
            }
        }
        jdoc_free(move doc)
        rb := buf_new(str_len(srv.name) * 2 + str_len(srv.version) * 2 + str_len(srv.instructions) * 6 + 256)
        buf_push_str(rb, "{\"protocolVersion\":\"")
        json_push_escaped(rb, proto)
        buf_push_str(rb, "\",\"capabilities\":{\"tools\":{\"listChanged\":false}},\"serverInfo\":{\"name\":\"")
        json_push_escaped(rb, srv.name)
        buf_push_str(rb, "\",\"version\":\"")
        json_push_escaped(rb, srv.version)
        buf_push_str(rb, "\"}")
        if str_len(srv.instructions) > 0 {
            buf_push_str(rb, ",\"instructions\":\"")
            json_push_escaped(rb, srv.instructions)
            buf_push(rb, 34)
        }
        buf_push(rb, 125)
        resp := mcp_build_ok(id_raw, buf_to_owned_str(move rb))
        return McpParsedReq(valid = true, is_notification = false, is_tool_call = false, id_raw = id_raw, method = method, tool_name = "", tool_args_json = "{}", auto_response = resp)
    }
    if str_eq(method, "ping") or str_eq(method, "logging/setLevel") {
        jdoc_free(move doc)
        return McpParsedReq(valid = true, is_notification = false, is_tool_call = false, id_raw = id_raw, method = method, tool_name = "", tool_args_json = "{}", auto_response = mcp_build_ok(id_raw, "{}"))
    }
    if str_eq(method, "tools/list") {
        jdoc_free(move doc)
        return McpParsedReq(valid = true, is_notification = false, is_tool_call = false, id_raw = id_raw, method = method, tool_name = "", tool_args_json = "{}", auto_response = mcp_build_ok(id_raw, mcp_server_build_tools_list(srv)))
    }
    if str_eq(method, "resources/list") or str_eq(method, "resources/templates/list") {
        jdoc_free(move doc)
        return McpParsedReq(valid = true, is_notification = false, is_tool_call = false, id_raw = id_raw, method = method, tool_name = "", tool_args_json = "{}", auto_response = mcp_build_ok(id_raw, "{\"resources\":[]}"))
    }
    if str_eq(method, "prompts/list") {
        jdoc_free(move doc)
        return McpParsedReq(valid = true, is_notification = false, is_tool_call = false, id_raw = id_raw, method = method, tool_name = "", tool_args_json = "{}", auto_response = mcp_build_ok(id_raw, "{\"prompts\":[]}"))
    }
    if str_eq(method, "completion/complete") {
        jdoc_free(move doc)
        return McpParsedReq(valid = true, is_notification = false, is_tool_call = false, id_raw = id_raw, method = method, tool_name = "", tool_args_json = "{}", auto_response = mcp_build_ok(id_raw, "{\"completion\":{\"values\":[]}}"))
    }
    if str_eq(method, "tools/call") {
        mut tname := ""
        mut targs := "{}"
        if params_n >= 0 and jdoc_type(doc, params_n) == JVAL_OBJECT() {
            tn_n := jdoc_obj_get(doc, params_n, "name")
            if tn_n >= 0 and jdoc_type(doc, tn_n) == JVAL_STR() { tname = jdoc_as_str(doc, tn_n, "") }
            ar_n := jdoc_obj_get(doc, params_n, "arguments")
            if ar_n >= 0 and jdoc_type(doc, ar_n) == JVAL_OBJECT() { targs = jdoc_stringify(doc, ar_n, false, 0) }
        }
        jdoc_free(move doc)
        return McpParsedReq(valid = true, is_notification = false, is_tool_call = true, id_raw = id_raw, method = method, tool_name = tname, tool_args_json = targs, auto_response = "")
    }
    jdoc_free(move doc)
    return McpParsedReq(valid = true, is_notification = false, is_tool_call = false, id_raw = id_raw, method = method, tool_name = "", tool_args_json = "{}", auto_response = mcp_build_error(id_raw, -32601, f"Method not found: {method}"))
}

// ==================== 3. UPSTREAM MCP STDIO & STREAMABLE HTTP CLIENTS ====================

struct McpStdioClient {
    proc: Subproc
    seq: i64
}

fn mcp_stdio_rpc(mut cl: McpStdioClient, method: str, params_json: str = "{}", timeout_ms: i64 = 30000) -> str ! i64 {
    cl.seq += 1
    req_id := cl.seq
    p := if str_len(params_json) > 0 { params_json } else { "{}" }
    mb := buf_new(str_len(method) * 2 + str_len(p) + 96)
    buf_push_str(mb, "{\"jsonrpc\":\"2.0\",\"id\":")
    buf_append_i64(mb, req_id)
    buf_push_str(mb, ",\"method\":\"")
    json_push_escaped(mb, method)
    buf_push_str(mb, "\",\"params\":")
    buf_push_str(mb, p)
    buf_push(mb, 125)
    line := buf_to_owned_str(move mb)
    _ := subproc_write_line(cl.proc, line) or return err(500)

    // Skip non-JSON log lines or mismatched notifications until matching `id == req_id`
    deadline := clock_ns() + timeout_ms * 1000000
    mut guard := 0
    while guard < 1024 {
        rem_ms := (deadline - clock_ns()) / 1000000
        if rem_ms <= 0 { return err(408) }
        raw := subproc_read_line(cl.proc, rem_ms, 8388608) or return
        tr := str_trim(raw)
        if str_len(tr) > 0 and str_byte(tr, 0) == 123 {
            doc := jdoc_parse(tr) or JsonDoc(nodes = ibuf_new(0), nodes_cap = 0, node_count = 0, strings = buf_new(0), str_cap = 0, root = -1)
            if doc.root >= 0 {
                id_n := jdoc_obj_get(doc, doc.root, "id")
                if id_n >= 0 and jdoc_type(doc, id_n) == JVAL_INT() and jdoc_as_i64(doc, id_n, -1) == req_id {
                    err_n := jdoc_obj_get(doc, doc.root, "error")
                    if err_n >= 0 and not jdoc_is_null(doc, err_n) {
                        jdoc_free(move doc)
                        return err(502)
                    }
                    res_n := jdoc_obj_get(doc, doc.root, "result")
                    res_s := if res_n >= 0 { jdoc_stringify(doc, res_n, false, 0) } else { "{}" }
                    jdoc_free(move doc)
                    return ok(res_s)
                }
            }
            jdoc_free(move doc)
        }
        guard += 1
    }
    return err(408)
}

fn mcp_stdio_connect(argv: StrVec, cwd: str = "", timeout_ms: i64 = 30000) -> McpStdioClient ! i64 {
    p := subproc_spawn(argv, cwd, false) or return
    mut cl := McpStdioClient(proc = p, seq = 0)
    init_params := "{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\"clientInfo\":{\"name\":\"axon-mcp-hub\",\"version\":\"1.1.1\"}}"
    _ := mcp_stdio_rpc(mut cl, "initialize", init_params, timeout_ms) or return err(502)
    _ := subproc_write_line(cl.proc, "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\",\"params\":{}}") or 0
    return ok(cl)
}

fn mcp_stdio_list_tools(mut cl: McpStdioClient, timeout_ms: i64 = 30000) -> str ! i64 {
    return mcp_stdio_rpc(mut cl, "tools/list", "{}", timeout_ms)
}

fn mcp_stdio_call_tool(mut cl: McpStdioClient, tool_name: str, args_json: str = "{}", timeout_ms: i64 = 60000) -> str ! i64 {
    a := if str_len(args_json) > 0 { args_json } else { "{}" }
    pb := buf_new(str_len(tool_name) * 2 + str_len(a) + 64)
    buf_push_str(pb, "{\"name\":\"")
    json_push_escaped(pb, tool_name)
    buf_push_str(pb, "\",\"arguments\":")
    buf_push_str(pb, a)
    buf_push(pb, 125)
    res := mcp_stdio_rpc(mut cl, "tools/call", buf_to_owned_str(move pb), timeout_ms) or return
    return mcp_unwrap_tool_result(res)
}

fn mcp_stdio_close(move cl: McpStdioClient) {
    _ := subproc_kill_tree(cl.proc)
    subproc_close(move cl.proc)
}

// Streamable HTTP / SSE MCP JSON-RPC call (`allow_private` explicit opt-in for localhost servers)
fn mcp_http_rpc(url: str, session_id: str, req_id: i64, method: str, params_json: str = "{}", extra_headers: str = "", allow_private: bool = false, timeout_ms: i64 = 30000) -> (str, str) ! i64 {
    p := if str_len(params_json) > 0 { params_json } else { "{}" }
    pb := buf_new(str_len(method) * 2 + str_len(p) + 96)
    buf_push_str(pb, "{\"jsonrpc\":\"2.0\",\"id\":")
    buf_append_i64(pb, req_id)
    buf_push_str(pb, ",\"method\":\"")
    json_push_escaped(pb, method)
    buf_push_str(pb, "\",\"params\":")
    buf_push_str(pb, p)
    buf_push(pb, 125)
    body := buf_to_owned_str(move pb)

    mut hdrs := "Accept: application/json, text/event-stream"
    if str_len(session_id) > 0 { hdrs = hdrs + "\r\nMcp-Session-Id: " + session_id }
    if str_len(extra_headers) > 0 { hdrs = hdrs + "\r\n" + extra_headers }

    resp := fetch_post_json(url, body, hdrs, timeout_ms, allow_private) or return
    if not resp.ok_flag { return err(resp.status) }
    new_sid := fetch_response_header(resp, "Mcp-Session-Id")
    sid_out := if str_len(new_sid) > 0 { new_sid } else { session_id }
    ctype := str_to_lower(fetch_response_header(resp, "Content-Type"))
    raw := str_trim(resp.body)
    json_payload := if str_contains(ctype, "text/event-stream") or str_starts_with(raw, "event:") or str_starts_with(raw, "data:") {
        sse_parse_last_data(raw)
    } else {
        raw
    }
    doc := jdoc_parse(json_payload) or return err(502)
    err_n := jdoc_obj_get(doc, doc.root, "error")
    if err_n >= 0 and not jdoc_is_null(doc, err_n) {
        jdoc_free(move doc)
        return err(502)
    }
    res_n := jdoc_obj_get(doc, doc.root, "result")
    res_s := if res_n >= 0 { jdoc_stringify(doc, res_n, false, 0) } else { "{}" }
    jdoc_free(move doc)
    return ok((res_s, sid_out))
}

// ==================== 4. CLOUDFLARE CODE MODE PROGRESSIVE DISCOVERY HUB (`McpHub`) ====================

// Deterministic SHA-256 fingerprint of server config + optional executable/script (mtime_ns, size)
fn mcp_hub_server_fingerprint(cfg_json: str, script_path: str = "") -> str {
    canon := json_canonicalize(cfg_json) or cfg_json
    mut ctx := sha256_ctx_new()
    sha256_ctx_update_str(mut ctx, canon)
    if str_len(script_path) > 0 {
        st := shutil_stat(script_path)
        if st.exists and st.is_file {
            sha256_ctx_update_str(mut ctx, f"|{script_path}:{st.mtime_ns}:{st.size}")
        }
    }
    hex := sha256_ctx_finish_hex(mut ctx)
    sha256_ctx_free(move ctx)
    return str_slice(hex, 0, 24)
}

// Stride-10 metadata per tool: [srv_o, srv_l, name_o, name_l, sig_o, sig_l, desc_o, desc_l, sch_o, sch_l]
struct McpHub {
    blob: ByteBuf
    blob_cap: i64
    meta: IntBuf
    meta_cap: i64
    tool_count: i64
    server_fps: StrMap
    cache_path: str
}

fn mcp_hub_new(cache_path: str = "") -> McpHub {
    return McpHub(
        blob = buf_new(32768),
        blob_cap = 32768,
        meta = ibuf_new(640),
        meta_cap = 64,
        tool_count = 0,
        server_fps = smap_new(32),
        cache_path = cache_path
    )
}

fn mcp_hub_free(move hub: McpHub) {
    buf_free(move hub.blob)
    buf_free(move hub.meta)
    smap_free(move hub.server_fps)
}

fn _mcp_hub_ensure(mut hub: McpHub, add_bytes: i64) -> bool {
    cur_b := buf_len(hub.blob)
    if cur_b + add_bytes + 32 > hub.blob_cap {
        mut nc := hub.blob_cap * 2
        while nc < cur_b + add_bytes + 64 and nc < 16777216 { nc = nc * 2 }
        if nc > 16777216 or cur_b + add_bytes + 32 > nc { return false }
        nb := buf_new(nc)
        if cur_b > 0 { buf_push_str(nb, buf_slice_str(hub.blob, 0, cur_b)) }
        buf_free(move hub.blob)
        hub.blob = nb
        hub.blob_cap = nc
    }
    if hub.tool_count >= hub.meta_cap {
        nm_cap := hub.meta_cap * 2
        nm := ibuf_new(nm_cap * 10)
        mut i := 0
        while i < ibuf_len(hub.meta) { ibuf_push(nm, ibuf_get(hub.meta, i)); i += 1 }
        buf_free(move hub.meta)
        hub.meta = nm
        hub.meta_cap = nm_cap
    }
    return true
}

fn _mcp_hub_push_tool(mut hub: McpHub, server: str, name: str, desc: str, schema_json: str) {
    if str_len(server) == 0 or str_len(name) == 0 { return }
    sig := harness_compact_schema_sig(name, schema_json)
    need := str_len(server) + str_len(name) + str_len(sig) + str_len(desc) + str_len(schema_json)
    if not _mcp_hub_ensure(mut hub, need) { return }

    so := buf_len(hub.blob); sl := str_len(server); buf_push_str(hub.blob, server)
    no := buf_len(hub.blob); nl := str_len(name); buf_push_str(hub.blob, name)
    go := buf_len(hub.blob); gl := str_len(sig); buf_push_str(hub.blob, sig)
    do := buf_len(hub.blob); dl := str_len(desc); if dl > 0 { buf_push_str(hub.blob, desc) }
    co := buf_len(hub.blob); cl := str_len(schema_json); if cl > 0 { buf_push_str(hub.blob, schema_json) }

    ibuf_push(hub.meta, so); ibuf_push(hub.meta, sl)
    ibuf_push(hub.meta, no); ibuf_push(hub.meta, nl)
    ibuf_push(hub.meta, go); ibuf_push(hub.meta, gl)
    ibuf_push(hub.meta, do); ibuf_push(hub.meta, dl)
    ibuf_push(hub.meta, co); ibuf_push(hub.meta, cl)
    hub.tool_count += 1
}

// Ingests an MCP `tools/list` JSON response (`{"tools":[...]}` or raw array `[...]`) for `server_name`
fn mcp_hub_register_tools_json(mut hub: McpHub, server_name: str, tools_json: str, fingerprint: str = "") -> i64 {
    doc := jdoc_parse(tools_json) or return 0
    mut arr_n := doc.root
    if jdoc_type(doc, arr_n) == JVAL_OBJECT() {
        arr_n = jdoc_obj_get(doc, arr_n, "tools")
    }
    if arr_n < 0 or jdoc_type(doc, arr_n) != JVAL_ARRAY() {
        jdoc_free(move doc)
        return 0
    }
    if str_len(fingerprint) > 0 {
        smap_set_str(mut hub.server_fps, server_name, fingerprint)
    }
    mut added := 0
    mut cur := jdoc_first_child(doc, arr_n)
    while cur >= 0 {
        if jdoc_type(doc, cur) == JVAL_OBJECT() {
            nm_n := jdoc_obj_get(doc, cur, "name")
            ds_n := jdoc_obj_get(doc, cur, "description")
            sc_n := jdoc_obj_get(doc, cur, "inputSchema")
            nm := if nm_n >= 0 { jdoc_as_str(doc, nm_n, "") } else { "" }
            ds := if ds_n >= 0 { str_trim(jdoc_as_str(doc, ds_n, "")) } else { "" }
            sc := if sc_n >= 0 { jdoc_stringify(doc, sc_n, false, 0) } else { "{\"type\":\"object\",\"properties\":{}}" }
            if str_len(nm) > 0 {
                _mcp_hub_push_tool(mut hub, server_name, nm, ds, sc)
                added += 1
            }
        }
        cur = jdoc_next_sib(doc, cur)
    }
    jdoc_free(move doc)
    return added
}

// Progressive keyword search across all cached/registered upstream MCP tools (returns ultra-compact signatures!)
fn mcp_hub_search(hub: McpHub, query: str = "", server_filter: str = "", limit: i64 = 20) -> str {
    qlow := str_to_lower(str_trim(query))
    sfilt := mcp_norm_name(str_to_lower(str_trim(server_filter)))
    mut scores := dvec_new(32)
    mut idxs := dvec_new(32)

    mut i := 0
    while i < hub.tool_count {
        b := i * 10
        srv := buf_slice_str(hub.blob, ibuf_get(hub.meta, b), ibuf_get(hub.meta, b) + ibuf_get(hub.meta, b + 1))
        if str_len(sfilt) > 0 and not str_eq(mcp_norm_name(str_to_lower(srv)), sfilt) {
            i += 1
            continue
        }
        nm := buf_slice_str(hub.blob, ibuf_get(hub.meta, b + 2), ibuf_get(hub.meta, b + 2) + ibuf_get(hub.meta, b + 3))
        sig := buf_slice_str(hub.blob, ibuf_get(hub.meta, b + 4), ibuf_get(hub.meta, b + 4) + ibuf_get(hub.meta, b + 5))
        desc := buf_slice_str(hub.blob, ibuf_get(hub.meta, b + 6), ibuf_get(hub.meta, b + 6) + ibuf_get(hub.meta, b + 7))

        mut sc := 0
        if str_len(qlow) == 0 {
            sc = 1
        } else {
            nml := str_to_lower(nm)
            sigl := str_to_lower(sig)
            descl := str_to_lower(desc)
            srvl := str_to_lower(srv)
            if str_eq(nml, qlow) { sc += 100 }
            else if str_starts_with(nml, qlow) { sc += 50 }
            else if str_contains(nml, qlow) { sc += 25 }
            if str_contains(sigl, qlow) { sc += 10 }
            if str_contains(descl, qlow) { sc += 5 }
            if str_contains(srvl, qlow) { sc += 3 }
        }
        if sc > 0 {
            dvec_push(mut scores, sc)
            dvec_push(mut idxs, i)
        }
        i += 1
    }

    nm_cnt := dvec_len(idxs)
    mut a := 1
    while a < nm_cnt {
        ks := dvec_get(scores, a, 0)
        ki := dvec_get(idxs, a, 0)
        mut j := a - 1
        while j >= 0 and dvec_get(scores, j, 0) < ks {
            _ := dvec_set(mut scores, j + 1, dvec_get(scores, j, 0))
            _ := dvec_set(mut idxs, j + 1, dvec_get(idxs, j, 0))
            j -= 1
        }
        _ := dvec_set(mut scores, j + 1, ks)
        _ := dvec_set(mut idxs, j + 1, ki)
        a += 1
    }

    mut lim := if limit > 0 { limit } else { 20 }
    if lim > nm_cnt { lim = nm_cnt }
    mut lines := svec_new(lim + 4, 1024)
    mut k := 0
    while k < lim {
        ti := dvec_get(idxs, k, 0)
        b := ti * 10
        srv := buf_slice_str(hub.blob, ibuf_get(hub.meta, b), ibuf_get(hub.meta, b) + ibuf_get(hub.meta, b + 1))
        sig := buf_slice_str(hub.blob, ibuf_get(hub.meta, b + 4), ibuf_get(hub.meta, b + 4) + ibuf_get(hub.meta, b + 5))
        desc := buf_slice_str(hub.blob, ibuf_get(hub.meta, b + 6), ibuf_get(hub.meta, b + 6) + ibuf_get(hub.meta, b + 7))
        // Keep only first line up to 140 chars to maximize token savings
        mut nl := str_find_byte(desc, 10, 0)
        if nl < 0 { nl = str_len(desc) }
        if nl > 140 { nl = 140 }
        short_d := str_slice(desc, 0, nl)
        svec_push(mut lines, f"{srv}.{sig} — {short_d}")
        k += 1
    }
    dvec_free(move scores)
    dvec_free(move idxs)
    res := svec_join(lines, "\n")
    svec_free(move lines)
    return res
}

// On-demand full documentation & JSON Schema for one upstream MCP tool
fn mcp_hub_describe(hub: McpHub, server_name: str, tool_name: str) -> str ! i64 {
    nsrv := mcp_norm_name(str_to_lower(server_name))
    ntool := mcp_norm_name(str_to_lower(tool_name))
    mut i := 0
    while i < hub.tool_count {
        b := i * 10
        srv := buf_slice_str(hub.blob, ibuf_get(hub.meta, b), ibuf_get(hub.meta, b) + ibuf_get(hub.meta, b + 1))
        nm := buf_slice_str(hub.blob, ibuf_get(hub.meta, b + 2), ibuf_get(hub.meta, b + 2) + ibuf_get(hub.meta, b + 3))
        srv_ok := str_len(nsrv) == 0 or str_eq(mcp_norm_name(str_to_lower(srv)), nsrv)
        if srv_ok and str_eq(mcp_norm_name(str_to_lower(nm)), ntool) {
            sig := buf_slice_str(hub.blob, ibuf_get(hub.meta, b + 4), ibuf_get(hub.meta, b + 4) + ibuf_get(hub.meta, b + 5))
            desc := buf_slice_str(hub.blob, ibuf_get(hub.meta, b + 6), ibuf_get(hub.meta, b + 6) + ibuf_get(hub.meta, b + 7))
            sch := buf_slice_str(hub.blob, ibuf_get(hub.meta, b + 8), ibuf_get(hub.meta, b + 8) + ibuf_get(hub.meta, b + 9))
            return ok(f"{srv}.{sig}\n  {desc}\nSchema: {sch}")
        }
        i += 1
    }
    return err(404)
}

// Atomic disk schema cache save/load (`<1ms` cold-start `mcp_hub_search` without spawning upstream servers!)
fn mcp_hub_save_cache(hub: McpHub) -> bool {
    if str_len(hub.cache_path) == 0 { return false }
    par := path_dirname(hub.cache_path)
    if str_len(par) > 0 and not str_eq(par, ".") { _ := shutil_mkdir_all(par) }
    mut items := svec_new(hub.tool_count + 4, 2048)
    mut i := 0
    while i < hub.tool_count {
        b := i * 10
        srv := buf_slice_str(hub.blob, ibuf_get(hub.meta, b), ibuf_get(hub.meta, b) + ibuf_get(hub.meta, b + 1))
        nm  := buf_slice_str(hub.blob, ibuf_get(hub.meta, b + 2), ibuf_get(hub.meta, b + 2) + ibuf_get(hub.meta, b + 3))
        desc := buf_slice_str(hub.blob, ibuf_get(hub.meta, b + 6), ibuf_get(hub.meta, b + 6) + ibuf_get(hub.meta, b + 7))
        sch := buf_slice_str(hub.blob, ibuf_get(hub.meta, b + 8), ibuf_get(hub.meta, b + 8) + ibuf_get(hub.meta, b + 9))
        fp := smap_get_str(hub.server_fps, srv, "")
        eb := buf_new((str_len(srv) + str_len(nm) + str_len(desc) + str_len(fp)) * 6 + str_len(sch) + 128)
        json_begin_obj(eb)
        json_kv_str(eb, "server", srv)
        json_kv_str(eb, "fp", fp)
        json_kv_str(eb, "name", nm)
        json_kv_str(eb, "description", desc)
        buf_push_str(eb, ",\"inputSchema\":")
        buf_push_str(eb, if str_len(sch) > 0 { sch } else { "{\"type\":\"object\",\"properties\":{}}" })
        json_end_obj(eb)
        svec_push(mut items, buf_to_owned_str(move eb))
        i += 1
    }
    payload := "[" + svec_join(items, ",") + "]"
    svec_free(move items)
    return shutil_atomic_write(hub.cache_path, payload)
}

fn mcp_hub_load_cache(mut hub: McpHub) -> i64 {
    if str_len(hub.cache_path) == 0 { return 0 }
    raw := fs_read_text(hub.cache_path) or return 0
    doc := jdoc_parse(raw) or return 0
    if jdoc_type(doc, doc.root) != JVAL_ARRAY() { jdoc_free(move doc); return 0 }
    mut loaded := 0
    mut cur := jdoc_first_child(doc, doc.root)
    while cur >= 0 {
        if jdoc_type(doc, cur) == JVAL_OBJECT() {
            s_n := jdoc_obj_get(doc, cur, "server")
            f_n := jdoc_obj_get(doc, cur, "fp")
            n_n := jdoc_obj_get(doc, cur, "name")
            d_n := jdoc_obj_get(doc, cur, "description")
            c_n := jdoc_obj_get(doc, cur, "inputSchema")
            srv := if s_n >= 0 { jdoc_as_str(doc, s_n, "") } else { "" }
            fp  := if f_n >= 0 { jdoc_as_str(doc, f_n, "") } else { "" }
            nm  := if n_n >= 0 { jdoc_as_str(doc, n_n, "") } else { "" }
            ds  := if d_n >= 0 { jdoc_as_str(doc, d_n, "") } else { "" }
            sc  := if c_n >= 0 { jdoc_stringify(doc, c_n, false, 0) } else { "{\"type\":\"object\",\"properties\":{}}" }
            if str_len(srv) > 0 and str_len(nm) > 0 {
                if str_len(fp) > 0 { smap_set_str(mut hub.server_fps, srv, fp) }
                _mcp_hub_push_tool(mut hub, srv, nm, ds, sc)
                loaded += 1
            }
        }
        cur = jdoc_next_sib(doc, cur)
    }
    jdoc_free(move doc)
    return loaded
}

// 256-bit OS CSPRNG loopback bridge token + constant-time verification
fn mcp_bridge_make_token() -> str ! i64 {
    return secrets_token_hex(32)
}

fn mcp_bridge_verify_token(expected: str, provided: str) -> bool {
    if str_len(expected) < 32 { return false }
    return secrets_compare_digest(expected, provided)
}
