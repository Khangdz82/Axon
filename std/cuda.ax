fn cuda_load_ptx(ctx: CudaCtx, ptx_src: str) -> i64 {
    unsafe {
    if ctx.tbl == 0 or ctx.argv == 0 or ctx.pbox == 0 { return 0 }
    f := ptr_read_i64(ctx.tbl, 7)
    if f == 0 { return 0 }
    cp := _cuda_cstr_alloc(ptx_src)
    if cp == 0 { return 0 }
    ptr_write_i64(ctx.pbox, 0, 0)
    ptr_write_i64(ctx.argv, 0, ctx.pbox)
    ptr_write_i64(ctx.argv, 1, cp)
    rc := c_call_v(f, 2, ctx.argv)
    mem_free_aligned(cp)
    if rc != 0 { return 0 }
    return ptr_read_i64(ctx.pbox, 0)
    }
}

