    ptr_write_i64(vals, 1, d_b)
    ptr_write_i64(vals, 2, d_c)
    ptr_write_i64(vals, 3, m)
    ptr_write_i64(vals, 4, k)
    ptr_write_i64(vals, 5, n)
    mut i := 0
    while i < 6 { ptr_write_i64(ctx.pbox, i, vals + i * 8); i += 1 }
    gx := (n + 15) / 16
    gy := (m + 15) / 16
    return cuda_launch_raw(ctx, ptr_read_i64(ctx.tbl, 17), gx, gy, 1, 16, 16, 1, 0, ctx.pbox)
    }
}

fn cuda_gemv_q8_0(ctx: CudaCtx, d_act: i64, d_q8: i64, d_out: i64, rows: i64, nblk: i64) -> i64 {
