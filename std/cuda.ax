    ptr_write_i64(vals, 2, d_out)
    ptr_write_i64(vals, 3, dim)
    ptr_write_f32(vals, 8, eps)
    mut i := 0
    while i < 5 { ptr_write_i64(ctx.pbox, i, vals + i * 8); i += 1 }
    return cuda_launch_raw(ctx, ptr_read_i64(ctx.tbl, 21), rows, 1, 1, 256, 1, 1, 0, ctx.pbox)
    }
}

