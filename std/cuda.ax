    return _cuda_get_fn(f, ctx.argv, hmod, name)
    }
}

// Launch using pre-populated `params_ptr_array` (`void**`).
fn cuda_launch_raw(ctx: CudaCtx, kfn: i64, gx: i64, gy: i64, gz: i64, bx: i64, by: i64, bz: i64, shmem: i64, params: i64) -> i64 {
    unsafe {
    if ctx.tbl == 0 or ctx.argv == 0 or kfn == 0 { return -1 }
    if gx <= 0 or gy <= 0 or gz <= 0 or bx <= 0 or by <= 0 or bz <= 0 or shmem < 0 { return -1 }
    f := ptr_read_i64(ctx.tbl, 10)
    if f == 0 { return -1 }
    ptr_write_i64(ctx.argv, 0, kfn)
    ptr_write_i64(ctx.argv, 1, gx)
    ptr_write_i64(ctx.argv, 2, gy)
    ptr_write_i64(ctx.argv, 3, gz)
    ptr_write_i64(ctx.argv, 4, bx)
    ptr_write_i64(ctx.argv, 5, by)
    ptr_write_i64(ctx.argv, 6, bz)
    ptr_write_i64(ctx.argv, 7, shmem)
    ptr_write_i64(ctx.argv, 8, 0)
    ptr_write_i64(ctx.argv, 9, params)
    ptr_write_i64(ctx.argv, 10, 0)
    return c_call_v(f, 11, ctx.argv)
    }
}

fn _cuda_pack5_u64x3_u32x2(pbox: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64) -> i64 {
    unsafe {
    vals := pbox + 64
    ptr_write_i64(vals, 0, a0)
    ptr_write_i64(vals, 1, a1)
    ptr_write_i64(vals, 2, a2)
    ptr_write_i64(vals, 3, a3)
    ptr_write_i64(vals, 4, a4)
    ptr_write_i64(pbox, 0, vals)
    ptr_write_i64(pbox, 1, vals + 8)
    ptr_write_i64(pbox, 2, vals + 16)
    ptr_write_i64(pbox, 3, vals + 24)
    ptr_write_i64(pbox, 4, vals + 32)
    return pbox
    }
}

fn cuda_gemv_f32(ctx: CudaCtx, d_w: i64, d_x: i64, d_out: i64, rows: i64, cols: i64) -> i64 {
    unsafe {
    if ctx.tbl == 0 or ctx.pbox == 0 or rows <= 0 or cols <= 0 { return -1 }
    params := _cuda_pack5_u64x3_u32x2(ctx.pbox, d_w, d_x, d_out, rows, cols)
    gx := (rows + 7) / 8
    return cuda_launch_raw(ctx, ptr_read_i64(ctx.tbl, 16), gx, 1, 1, 256, 1, 1, 0, params)
    }
}

fn cuda_gemm_f32(ctx: CudaCtx, d_a: i64, d_b: i64, d_c: i64, m: i64, k: i64, n: i64) -> i64 {
    unsafe {
    if ctx.tbl == 0 or ctx.pbox == 0 or m <= 0 or k <= 0 or n <= 0 { return -1 }
