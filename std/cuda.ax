fn cuda_rmsnorm_batch_f32(ctx: CudaCtx, d_x: i64, d_w: i64, d_out: i64, rows: i64, dim: i64, eps: f64) -> i64 {
    unsafe {
    if ctx.tbl == 0 or ctx.pbox == 0 or rows <= 0 or dim <= 0 { return -1 }
    vals := ctx.pbox + 64
    ptr_write_i64(vals, 0, d_x)
