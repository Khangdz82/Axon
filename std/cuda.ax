fn cuda_timer_start(ctx: CudaCtx) {
    unsafe {
    if ctx.tbl == 0 or ctx.argv == 0 { return }
    ev0 := ptr_read_i64(ctx.tbl, 24)
    f := ptr_read_i64(ctx.tbl, 13)
    if ev0 == 0 or f == 0 { return }
    ptr_write_i64(ctx.argv, 0, ev0)
    ptr_write_i64(ctx.argv, 1, 0)
    c_call_v(f, 2, ctx.argv)
    }
}

fn cuda_timer_stop_ms(ctx: CudaCtx) -> f64 {
    unsafe {
    if ctx.tbl == 0 or ctx.argv == 0 or ctx.pbox == 0 { return 0.0 }
    ev0 := ptr_read_i64(ctx.tbl, 24)
    ev1 := ptr_read_i64(ctx.tbl, 25)
    f_rec := ptr_read_i64(ctx.tbl, 13)
    f_sync := ptr_read_i64(ctx.tbl, 14)
    f_elap := ptr_read_i64(ctx.tbl, 15)
    if ev0 == 0 or ev1 == 0 or f_rec == 0 or f_sync == 0 or f_elap == 0 { return 0.0 }
    ptr_write_i64(ctx.argv, 0, ev1)
    ptr_write_i64(ctx.argv, 1, 0)
    c_call_v(f_rec, 2, ctx.argv)
    ptr_write_i64(ctx.argv, 0, ev1)
    c_call_v(f_sync, 1, ctx.argv)
    ptr_write_f32(ctx.pbox, 0, 0.0)
    ptr_write_i64(ctx.argv, 0, ctx.pbox)
    ptr_write_i64(ctx.argv, 1, ev0)
    ptr_write_i64(ctx.argv, 2, ev1)
    c_call_v(f_elap, 3, ctx.argv)
    return ptr_read_f32(ctx.pbox, 0)
    }
}

fn cuda_free(mut ctx: CudaCtx) {
    unsafe {
    if ctx.tbl != 0 {
        ev0 := ptr_read_i64(ctx.tbl, 24)
        ev1 := ptr_read_i64(ctx.tbl, 25)
        f_evd := ptr_read_i64(ctx.tbl, 12)
        if ev0 != 0 and f_evd != 0 { ptr_write_i64(ctx.argv, 0, ev0); c_call_v(f_evd, 1, ctx.argv) }
        if ev1 != 0 and f_evd != 0 { ptr_write_i64(ctx.argv, 0, ev1); c_call_v(f_evd, 1, ctx.argv) }
        f_mu := ptr_read_i64(ctx.tbl, 8)
        if ctx.cu_mod != 0 and f_mu != 0 { ptr_write_i64(ctx.argv, 0, ctx.cu_mod); c_call_v(f_mu, 1, ctx.argv) }
        f_cd := ptr_read_i64(ctx.tbl, 1)
        if ctx.cu_ctx != 0 and f_cd != 0 { ptr_write_i64(ctx.argv, 0, ctx.cu_ctx); c_call_v(f_cd, 1, ctx.argv) }
        nb := ptr_read_i64(ctx.tbl, 30)
        if nb != 0 { mem_free_aligned(nb) }
        mem_free_aligned(ctx.tbl)
    }
    if ctx.argv != 0 { mem_free_aligned(ctx.argv) }
    if ctx.pbox != 0 { mem_free_aligned(ctx.pbox) }
    if ctx.dll != 0 { dll_close(ctx.dll) }
    ctx.cu_ctx = 0
    ctx.cu_mod = 0
    ctx.tbl = 0
    ctx.dll = 0
    }
}
