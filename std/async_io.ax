// Axon v7.0 Native OS Async I/O Reactor & Stackless Coroutines (`std/async_io.ax`)
// Backed directly by Windows I/O Completion Ports (`CreateIoCompletionPort`,
// `PostQueuedCompletionStatus`, `GetQueuedCompletionStatus`) with zero heap task frames.

struct AsyncReactor {
    iocp_handle: i64
}

fn reactor_new() -> AsyncReactor ! i64 {
    h := iocp_create()
    if h == 0 or h == -1 {
        return err(801)
    }
    return ok(AsyncReactor(iocp_handle = h))
}

fn reactor_post(r: AsyncReactor, bytes_transferred: i64, completion_key: i64) -> bool {
    rc := iocp_post(r.iocp_handle, bytes_transferred, completion_key)
    return rc != 0
}

// Polls the OS kernel completion queue for up to `timeout_ms` milliseconds.
// Returns the `completion_key` of the completed I/O packet or `-1` on timeout.
fn reactor_poll(r: AsyncReactor, timeout_ms: i64) -> i64 {
    return iocp_wait(r.iocp_handle, timeout_ms)
}

fn reactor_close(move r: AsyncReactor) {
    if r.iocp_handle != 0 and r.iocp_handle != -1 {
        iocp_close(r.iocp_handle)
    }
}

async fn async_submit_and_wait(r: AsyncReactor, payload_bytes: i64, key: i64) -> i64 {
    ok_post := reactor_post(r, payload_bytes, key)
    if not ok_post {
        return -1
    }
    return reactor_poll(r, 1000)
}
