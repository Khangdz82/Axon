// Axon Standard Library — Arbitrary-Precision `BigInt`, Primality & Exact `Rational` (`std/bigint.ax`)
// 100% Pure Axon, Perceus 0-GC, `--shield` Overflow-Safe Base-`10^9` Limbs (`0 .. 999_999_999`).
// Because `(10^9 - 1)^2 < 10^18 < INT64_MAX`, limb products NEVER overflow signed `i64`, and decimal
// string parsing/formatting (`bi_from_str`, `bi_to_str`) runs in O(N) linear time!

use std::str

struct BigInt {
    sign: i64
    limbs: IntBuf
}

struct BigDivMod {
    quot: BigInt
    rem: BigInt
}

struct Rational {
    num: i64
    den: i64
}

fn bi_base() -> i64 { return 1000000000 }

fn bi_trim_mut(mut a: BigInt) {
    mut n := ibuf_len(a.limbs)
    while n > 0 and ibuf_get(a.limbs, n - 1) == 0 {
        n -= 1
    }
    ibuf_truncate(a.limbs, n)
    if n == 0 { a.sign = 0 }
}

fn bi_zero() -> BigInt {
    return BigInt(0, ibuf_new(8))
}

fn bi_free(move a: BigInt) {
    buf_free(a.limbs)
}

fn bi_clone(a: BigInt) -> BigInt {
    n := ibuf_len(a.limbs)
    out := ibuf_new(n + 8)
    mut i := 0
    while i < n {
        ibuf_push(out, ibuf_get(a.limbs, i))
        i += 1
    }
    return BigInt(a.sign, out)
}

fn bi_is_zero(a: BigInt) -> bool {
    return a.sign == 0 or ibuf_len(a.limbs) == 0
}

fn bi_is_even(a: BigInt) -> bool {
    if bi_is_zero(a) { return true }
    // `10^9` is even, so parity of `BigInt` equals parity of least-significant limb `limbs[0]`!
    return (ibuf_get(a.limbs, 0) & 1) == 0
}

fn bi_from_i64(val: i64) -> BigInt {
    if val == 0 { return bi_zero() }
    limbs := ibuf_new(8)
    mut sign := 1
    mut v := val
    if val < 0 {
        sign = -1
        if val == -9223372036854775807 - 1 {
            // Exact `INT64_MIN = -9_223_372_036_854_775_808`
            ibuf_push(limbs, 854775808)
            ibuf_push(limbs, 223372036)
            ibuf_push(limbs, 9)
            return BigInt(-1, limbs)
        }
        v = 0 - val
    }
    base := bi_base()
    while v > 0 {
        ibuf_push(limbs, v % base)
        v = v / base
    }
    return BigInt(sign, limbs)
}

fn bi_to_i64(a: BigInt) -> i64 {
    if bi_is_zero(a) { return 0 }
    base := bi_base()
    n := ibuf_len(a.limbs)
    mut acc := 0
    mut i := n - 1
    while i >= 0 {
        acc = acc *% base +% ibuf_get(a.limbs, i)
        i -= 1
    }
    if a.sign < 0 { return 0 -% acc }
    return acc
}

// Parses decimal string (`"12345678901234567890"`, `"-42"`, `"+99"`) in `O(N)` linear time.
fn bi_from_str(s: str) -> BigInt ! i64 {
    slen := str_len(s)
    if slen <= 0 { return err(400) }
    mut pos := 0
    while pos < slen and str_byte(s, pos) == 32 { pos += 1 }
    if pos >= slen { return err(400) }
    mut sign := 1
    c0 := str_byte(s, pos)
    if c0 == 45 {
        sign = -1
        pos += 1
    } else if c0 == 43 {
        pos += 1
    }
    mut end := slen
    while end > pos and str_byte(s, end - 1) <= 32 { end -= 1 }
    if pos >= end { return err(400) }
    mut idx := pos
    while idx < end {
        ch := str_byte(s, idx)
        if ch < 48 or ch > 57 { return err(400) }
        idx += 1
    }
    while pos < end - 1 and str_byte(s, pos) == 48 { pos += 1 }
    digits := end - pos
    cap := (digits / 9) + 8
    limbs := ibuf_new(cap)
    mut cur_end := end
    while cur_end > pos {
        start := if cur_end - 9 > pos { cur_end - 9 } else { pos }
        mut chunk := 0
        mut k := start
        while k < cur_end {
            chunk = chunk * 10 + (str_byte(s, k) - 48)
            k += 1
        }
        ibuf_push(limbs, chunk)
        cur_end = start
    }
    mut out := BigInt(sign, limbs)
    bi_trim_mut(mut out)
    return ok(out)
}

fn bi_to_str(a: BigInt) -> str {
    if bi_is_zero(a) { return "0" }
    n := ibuf_len(a.limbs)
    out := buf_new(n * 10 + 16)
    if a.sign < 0 { buf_push(out, 45) }
    // Highest limb without zero-padding
    top := ibuf_get(a.limbs, n - 1)
    top_s := str_from_i64(top)
    mut ti := 0
    tlen := str_len(top_s)
    while ti < tlen {
        buf_push(out, str_byte(top_s, ti))
        ti += 1
    }
    mut i := n - 2
    while i >= 0 {
        mut v := ibuf_get(a.limbs, i)
        d8 := v / 100000000; v = v % 100000000
        d7 := v / 10000000;  v = v % 10000000
        d6 := v / 1000000;   v = v % 1000000
        d5 := v / 100000;    v = v % 100000
        d4 := v / 10000;     v = v % 10000
        d3 := v / 1000;      v = v % 1000
        d2 := v / 100;       v = v % 100
        d1 := v / 10;        d0 := v % 10
        buf_push(out, 48 + d8); buf_push(out, 48 + d7); buf_push(out, 48 + d6)
        buf_push(out, 48 + d5); buf_push(out, 48 + d4); buf_push(out, 48 + d3)
        buf_push(out, 48 + d2); buf_push(out, 48 + d1); buf_push(out, 48 + d0)
        i -= 1
    }
    return buf_to_owned_str(move out)
}

// Compares `|a|` and `|b|`: returns `-1`, `0`, or `1`.
fn bi_cmp_abs(a: BigInt, b: BigInt) -> i64 {
    na := ibuf_len(a.limbs)
    nb := ibuf_len(b.limbs)
    if na != nb { return if na < nb { -1 } else { 1 } }
    mut i := na - 1
    while i >= 0 {
        la := ibuf_get(a.limbs, i)
        lb := ibuf_get(b.limbs, i)
        if la != lb { return if la < lb { -1 } else { 1 } }
        i -= 1
    }
    return 0
}

fn bi_cmp(a: BigInt, b: BigInt) -> i64 {
    if a.sign != b.sign { return if a.sign < b.sign { -1 } else { 1 } }
    if a.sign == 0 { return 0 }
    c := bi_cmp_abs(a, b)
    return if a.sign > 0 { c } else { 0 - c }
}

fn bi_add_abs(a: BigInt, b: BigInt, sign: i64) -> BigInt {
    na := ibuf_len(a.limbs)
    nb := ibuf_len(b.limbs)
    nmax := if na > nb { na } else { nb }
    limbs := ibuf_new(nmax + 8)
    base := bi_base()
    mut carry := 0
    mut i := 0
    while i < nmax or carry > 0 {
        va := if i < na { ibuf_get(a.limbs, i) } else { 0 }
        vb := if i < nb { ibuf_get(b.limbs, i) } else { 0 }
        s := va + vb + carry
        if s >= base {
            ibuf_push(limbs, s - base)
            carry = 1
        } else {
            ibuf_push(limbs, s)
            carry = 0
        }
        i += 1
    }
    mut out := BigInt(sign, limbs)
    bi_trim_mut(mut out)
    return out
}

// Assumes `|a| >= |b|`.
fn bi_sub_abs(a: BigInt, b: BigInt, sign: i64) -> BigInt {
    na := ibuf_len(a.limbs)
    nb := ibuf_len(b.limbs)
    limbs := ibuf_new(na + 8)
    base := bi_base()
    mut borrow := 0
    mut i := 0
    while i < na {
        va := ibuf_get(a.limbs, i)
        vb := if i < nb { ibuf_get(b.limbs, i) } else { 0 }
        mut d := va - vb - borrow
        if d < 0 {
            d += base
            borrow = 1
        } else {
            borrow = 0
        }
        ibuf_push(limbs, d)
        i += 1
    }
    mut out := BigInt(sign, limbs)
    bi_trim_mut(mut out)
    return out
}

fn bi_add(a: BigInt, b: BigInt) -> BigInt {
    if bi_is_zero(a) { return bi_clone(b) }
    if bi_is_zero(b) { return bi_clone(a) }
    if a.sign == b.sign { return bi_add_abs(a, b, a.sign) }
    c := bi_cmp_abs(a, b)
    if c == 0 { return bi_zero() }
    if c > 0 { return bi_sub_abs(a, b, a.sign) }
    return bi_sub_abs(b, a, b.sign)
}

fn bi_sub(a: BigInt, b: BigInt) -> BigInt {
    if bi_is_zero(b) { return bi_clone(a) }
    if bi_is_zero(a) {
        mut neg_b := bi_clone(b)
        neg_b.sign = 0 - neg_b.sign
        return neg_b
    }
    if a.sign != b.sign { return bi_add_abs(a, b, a.sign) }
    c := bi_cmp_abs(a, b)
    if c == 0 { return bi_zero() }
    if c > 0 { return bi_sub_abs(a, b, a.sign) }
    return bi_sub_abs(b, a, 0 - a.sign)
}

fn bi_mul_small_abs(a: BigInt, m: i64) -> BigInt {
    if bi_is_zero(a) or m == 0 { return bi_zero() }
    na := ibuf_len(a.limbs)
    limbs := ibuf_new(na + 8)
    base := bi_base()
    mut carry := 0
    mut i := 0
    while i < na {
        prod := ibuf_get(a.limbs, i) * m + carry
        ibuf_push(limbs, prod % base)
        carry = prod / base
        i += 1
    }
    while carry > 0 {
        ibuf_push(limbs, carry % base)
        carry = carry / base
    }
    mut out := BigInt(1, limbs)
    bi_trim_mut(mut out)
    return out
}

fn bi_mul(a: BigInt, b: BigInt) -> BigInt {
    if bi_is_zero(a) or bi_is_zero(b) { return bi_zero() }
    na := ibuf_len(a.limbs)
    nb := ibuf_len(b.limbs)
    ntot := na + nb
    limbs := ibuf_new(ntot + 8)
    mut z := 0
    while z < ntot { ibuf_push(limbs, 0); z += 1 }
    base := bi_base()
    mut i := 0
    while i < na {
        ai := ibuf_get(a.limbs, i)
        if ai != 0 {
            mut carry := 0
            mut j := 0
            while j < nb {
                cur := ibuf_get(limbs, i + j) + ai * ibuf_get(b.limbs, j) + carry
                ibuf_set(limbs, i + j, cur % base)
                carry = cur / base
                j += 1
            }
            mut idx := i + nb
            while carry > 0 {
                cur := ibuf_get(limbs, idx) + carry
                ibuf_set(limbs, idx, cur % base)
                carry = cur / base
                idx += 1
            }
        }
        i += 1
    }
    mut out := BigInt(a.sign * b.sign, limbs)
    bi_trim_mut(mut out)
    return out
}

// Shifts `BigInt` right by 1 bit (`floor(|a| / 2)`) in `O(N)` single pass!
fn bi_shr1_mut(mut a: BigInt) {
    n := ibuf_len(a.limbs)
    if n == 0 { return }
    base := bi_base()
    mut rem := 0
    mut i := n - 1
    while i >= 0 {
        cur := rem * base + ibuf_get(a.limbs, i)
        ibuf_set(a.limbs, i, cur >> 1)
        rem = cur & 1
        i -= 1
    }
    bi_trim_mut(mut a)
}

// Prepends limb `digit` at index `0` (`rem := rem * 10^9 + digit`).
fn bi_mul_base_add_limb(r: BigInt, digit: i64) -> BigInt {
    if bi_is_zero(r) {
        if digit == 0 { return bi_zero() }
        limbs := ibuf_new(8)
        ibuf_push(limbs, digit)
        return BigInt(1, limbs)
    }
    nr := ibuf_len(r.limbs)
    limbs := ibuf_new(nr + 8)
    ibuf_push(limbs, digit)
    mut i := 0
    while i < nr {
        ibuf_push(limbs, ibuf_get(r.limbs, i))
        i += 1
    }
    return BigInt(1, limbs)
}

// Exact Euclidean/truncated division `a = quot * b + rem` via limb-wise binary quotient estimation (`30` steps/limb).
fn bi_div_mod(a: BigInt, b: BigInt) -> BigDivMod ! i64 {
    if bi_is_zero(b) { return err(400) }
    if bi_is_zero(a) { return ok(BigDivMod(bi_zero(), bi_zero())) }
    c := bi_cmp_abs(a, b)
    if c < 0 {
        return ok(BigDivMod(bi_zero(), bi_clone(a)))
    }
    mut b_abs := bi_clone(b)
    b_abs.sign = 1
    na := ibuf_len(a.limbs)
    q_rev := ibuf_new(na + 8)
    mut rem := bi_zero()
    base := bi_base()
    mut i := na - 1
    while i >= 0 {
        next_rem := bi_mul_base_add_limb(rem, ibuf_get(a.limbs, i))
        bi_free(move rem)
        rem = next_rem
        if bi_cmp_abs(rem, b_abs) < 0 {
            ibuf_push(q_rev, 0)
        } else {
            // Binary search exact limb quotient `q_digit in [1, 999_999_999]`
            mut lo := 1
            mut hi := base - 1
            // Tight upper/lower estimate from top 1-2 limbs cuts binary search to <= 3 probes!
            nr := ibuf_len(rem.limbs)
            nb := ibuf_len(b_abs.limbs)
            if nr == nb {
                top_r := ibuf_get(rem.limbs, nr - 1)
                top_b := ibuf_get(b_abs.limbs, nb - 1)
                est_lo := top_r / (top_b + 1)
                est_hi := (top_r / top_b) + 1
                if est_lo > lo { lo = est_lo }
                if est_hi < hi { hi = est_hi }
            } else if nr == nb + 1 {
                top_r := ibuf_get(rem.limbs, nr - 1) * base + ibuf_get(rem.limbs, nr - 2)
                top_b := ibuf_get(b_abs.limbs, nb - 1)
                est_lo := top_r / (top_b + 1)
                est_hi := (top_r / top_b) + 1
                if est_lo > lo { lo = est_lo }
                if est_hi < hi { hi = est_hi }
            }
            mut best_q := lo
            while lo <= hi {
                mid := (lo + hi) >> 1
                prod := bi_mul_small_abs(b_abs, mid)
                cmp_p := bi_cmp_abs(prod, rem)
                bi_free(move prod)
                if cmp_p <= 0 {
                    best_q = mid
                    lo = mid + 1
                } else {
                    hi = mid - 1
                }
            }
            ibuf_push(q_rev, best_q)
            sub_p := bi_mul_small_abs(b_abs, best_q)
            nrem := bi_sub_abs(rem, sub_p, 1)
            bi_free(move sub_p)
            bi_free(move rem)
            rem = nrem
        }
        i -= 1
    }
    bi_free(move b_abs)
    // Reverse `q_rev` into little-endian `q_limbs`
    nq := ibuf_len(q_rev)
    q_limbs := ibuf_new(nq + 8)
    mut k := nq - 1
    while k >= 0 {
        ibuf_push(q_limbs, ibuf_get(q_rev, k))
        k -= 1
    }
    buf_free(move q_rev)
    mut quot := BigInt(a.sign * b.sign, q_limbs)
    bi_trim_mut(mut quot)
    if not bi_is_zero(rem) { rem.sign = a.sign }
    return ok(BigDivMod(quot, rem))
}

fn bi_mod_pos(a: BigInt, m: BigInt) -> BigInt {
    dm := bi_div_mod(a, m) or return bi_zero()
    bi_free(dm.quot)
    mut r := dm.rem
    if r.sign < 0 {
        nr := bi_add(r, m)
        bi_free(move r)
        return nr
    }
    return r
}

// Arbitrary-precision modular exponentiation `(base ^ exp) mod m` (`exp >= 0`, `m > 0`).
fn bi_pow_mod(base: BigInt, exp: BigInt, m: BigInt) -> BigInt ! i64 {
    if m.sign <= 0 or exp.sign < 0 { return err(400) }
    one := bi_from_i64(1)
    if bi_cmp(m, one) == 0 {
        bi_free(move one)
        return ok(bi_zero())
    }
    mut res := one
    mut b := bi_mod_pos(base, m)
    mut e := bi_clone(exp)
    while not bi_is_zero(e) {
        if not bi_is_even(e) {
            prod := bi_mul(res, b)
            nres := bi_mod_pos(prod, m)
            bi_free(move prod)
            bi_free(move res)
            res = nres
        }
        bi_shr1_mut(mut e)
        if not bi_is_zero(e) {
            sq := bi_mul(b, b)
            nb := bi_mod_pos(sq, m)
            bi_free(move sq)
            bi_free(move b)
            b = nb
        }
    }
    bi_free(move b)
    bi_free(move e)
    return ok(res)
}

fn bi_gcd(a: BigInt, b: BigInt) -> BigInt {
    mut x := bi_clone(a)
    mut y := bi_clone(b)
    if x.sign < 0 { x.sign = 1 }
    if y.sign < 0 { y.sign = 1 }
    while not bi_is_zero(y) {
        dm := bi_div_mod(x, y) or BigDivMod(bi_zero(), bi_zero())
        bi_free(dm.quot)
        bi_free(move x)
        x = y
        y = dm.rem
    }
    bi_free(move y)
    return x
}

fn bi_miller_witness(a_small: i64, d: BigInt, r: i64, n: BigInt, nm1: BigInt) -> bool {
    a_bi := bi_from_i64(a_small)
    if bi_cmp(a_bi, n) >= 0 {
        bi_free(move a_bi)
        return true
    }
    mut x := bi_pow_mod(a_bi, d, n) or bi_zero()
    bi_free(move a_bi)
    one := bi_from_i64(1)
    if bi_cmp(x, one) == 0 or bi_cmp(x, nm1) == 0 {
        bi_free(move one)
        bi_free(move x)
        return true
    }
    bi_free(move one)
    mut step := 1
    while step < r {
        sq := bi_mul(x, x)
        nx := bi_mod_pos(sq, n)
        bi_free(move sq)
        bi_free(move x)
        x = nx
        if bi_cmp(x, nm1) == 0 {
            bi_free(move x)
            return true
        }
        step += 1
    }
    bi_free(move x)
    return false
}

fn bi_miller_base(idx: i64) -> i64 {
    if idx == 0 { return 2 }
    if idx == 1 { return 3 }
    if idx == 2 { return 5 }
    if idx == 3 { return 7 }
    if idx == 4 { return 11 }
    if idx == 5 { return 13 }
    if idx == 6 { return 17 }
    if idx == 7 { return 19 }
    if idx == 8 { return 23 }
    if idx == 9 { return 29 }
    if idx == 10 { return 31 }
    return 37
}

// Miller-Rabin primality test (deterministic across all 64-bit integers + strong probable prime for arbitrary `BigInt`!).
fn bi_is_prime(n: BigInt) -> bool {
    if n.sign <= 0 { return false }
    two := bi_from_i64(2)
    cmp2 := bi_cmp(n, two)
    bi_free(move two)
    if cmp2 < 0 { return false }
    if cmp2 == 0 { return true }
    if bi_is_even(n) { return false }
    three := bi_from_i64(3)
    if bi_cmp(n, three) == 0 { bi_free(move three); return true }
    bi_free(move three)
    one := bi_from_i64(1)
    nm1 := bi_sub(n, one)
    bi_free(move one)
    mut d := bi_clone(nm1)
    mut r := 0
    while bi_is_even(d) {
        bi_shr1_mut(mut d)
        r += 1
    }
    // 12 bases deterministic up to `2^64` (Sinclair / Jiang-Deng) and `< 4^-12` error above
    mut ok_prime := true
    mut i := 0
    while i < 12 {
        if not bi_miller_witness(bi_miller_base(i), d, r, n, nm1) {
            ok_prime = false
            break
        }
        i += 1
    }
    bi_free(move d)
    bi_free(move nm1)
    return ok_prime
}

// ============================================================================
// Exact Reduced Fractions (`Rational` — SRoA Register-Promoted 2-Field Value)
// ============================================================================

fn rat_gcd_pos(a_in: i64, b_in: i64) -> i64 {
    mut a := if a_in < 0 { 0 -% a_in } else { a_in }
    mut b := if b_in < 0 { 0 -% b_in } else { b_in }
    while b != 0 {
        t := b
        b = a % b
        a = t
    }
    return if a <= 0 { 1 } else { a }
}

fn rat_new(num: i64, den: i64) -> Rational ! i64 {
    if den == 0 { return err(400) }
    if num == 0 { return ok(Rational(0, 1)) }
    mut n := num
    mut d := den
    if d < 0 { n = 0 - n; d = 0 - d }
    g := rat_gcd_pos(n, d)
    return ok(Rational(n / g, d / g))
}

fn rat_add(a: Rational, b: Rational) -> Rational {
    n := a.num * b.den + b.num * a.den
    d := a.den * b.den
    return rat_new(n, d) or Rational(0, 1)
}

fn rat_sub(a: Rational, b: Rational) -> Rational {
    n := a.num * b.den - b.num * a.den
    d := a.den * b.den
    return rat_new(n, d) or Rational(0, 1)
}

fn rat_mul(a: Rational, b: Rational) -> Rational {
    g1 := rat_gcd_pos(a.num, b.den)
    g2 := rat_gcd_pos(b.num, a.den)
    n := (a.num / g1) * (b.num / g2)
    d := (a.den / g2) * (b.den / g1)
    return rat_new(n, d) or Rational(0, 1)
}

fn rat_div(a: Rational, b: Rational) -> Rational ! i64 {
    if b.num == 0 { return err(400) }
    return rat_new(a.num * b.den, a.den * b.num)
}

fn rat_cmp(a: Rational, b: Rational) -> i64 {
    lhs := a.num * b.den
    rhs := b.num * a.den
    if lhs < rhs { return -1 }
    if lhs > rhs { return 1 }
    return 0
}

fn rat_to_f64(a: Rational) -> f64 {
    if a.den == 0 { return 0.0 }
    return (a.num as f64) / (a.den as f64)
}

fn rat_to_str(a: Rational) -> str {
    if a.den == 1 { return str_from_i64(a.num) }
    return f"{a.num}/{a.den}"
}
