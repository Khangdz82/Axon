// Axon Standard Library — Ergonomic Cross-Platform Filesystem (`std/fs.ax`)
// Safe high-level text/line I/O, recursive `fs_mkdir_all`, atomic writes, file/dir type inspection,
// and native directory listing (`FindFirstFileA`/`FindNextFileA` on Win64 + `opendir`/`readdir` on Unix).
// Rejects NUL-byte path injection (CWE-158) on every entry point.

use std::str
use std::path
use std::ffi
use std::sys
use std::ds
use std::secrets

fn _fs_safe_str(p: str) -> bool {
    n := str_len(p)
    if n == 0 or n > 4096 { return false }
    mut i := 0
    while i < n {
        if str_byte(p, i) == 0 { return false }
        i += 1
    }
    return true
}

fn fs_read_text(path: str) -> str ! i64 {
    if not _fs_safe_str(path) { return err(400) }
    b := fs_read_file(path) or return err(404)
    return ok(buf_to_owned_str(move b))
}

fn fs_write_text(path: str, content: str) -> bool {
    if not _fs_safe_str(path) { return false }
    cl := str_len(content)
    b := buf_new(cl + 16)
    if cl > 0 { buf_push_str(b, content) }
    rc := fs_write_file(path, b)
    buf_free(move b)
    return rc >= 0
}

fn fs_append_text(path: str, extra: str) -> bool {
    if not _fs_safe_str(path) { return false }
    prev := fs_read_text(path) or ""
    return fs_write_text(path, prev + extra)
}

fn fs_read_lines(path: str) -> StrVec ! i64 {
    txt := fs_read_text(path) or return err(404)
    mut out := svec_new(32, str_len(txt) + 64)
    ranges := str_split_ranges(txt, 10)
    cnt := str_split_count(ranges)
    mut i := 0
    while i < cnt {
        mut line := str_split_at(txt, ranges, i)
        ll := str_len(line)
        if ll > 0 and str_byte(line, ll - 1) == 13 {
            line = str_slice(line, 0, ll - 1)
        }
        svec_push(mut out, line)
        i += 1
    }
    buf_free(move ranges)
    return ok(out)
}

fn fs_is_dir(path: str) -> bool {
    if not _fs_safe_str(path) { return false }
    k := ffi_open("kernel32.dll", "libc.so.6", "libSystem.B.dylib")
    if k == 0 { return false }
    f_win := ffi_sym(k, "GetFileAttributesA")
    if f_win != 0 {
        cp := ffi_cstr(path)
        if cp == 0 { return false }
        attr := ffi_call1(f_win, cp) & 0xFFFFFFFF
        ffi_free(cp)
        return attr != 0xFFFFFFFF and (attr & 0x10) != 0 // FILE_ATTRIBUTE_DIRECTORY = 0x10
    }
    f_op := ffi_sym(k, "opendir")
    f_cl := ffi_sym(k, "closedir")
    if f_op == 0 or f_cl == 0 { return false }
    cp := ffi_cstr(path)
    if cp == 0 { return false }
    dp := ffi_call1(f_op, cp)
    ffi_free(cp)
    if dp == 0 { return false }
    _ := ffi_call1(f_cl, dp)
    return true
}

fn fs_is_file(path: str) -> bool {
    return sys_fs_exists(path) and not fs_is_dir(path)
}

// Recursive `mkdir -p` across forward and backslash path separators.
fn fs_mkdir_all(path: str) -> bool {
    if not _fs_safe_str(path) { return false }
    norm := path_normalize(path)
    n := str_len(norm)
    if n == 0 { return false }
    if fs_is_dir(norm) { return true }
    mut i := 1
    while i <= n {
        if i == n or path_is_sep(str_byte(norm, i)) {
            sub := str_slice(norm, 0, i)
            if str_len(sub) > 0 and not (str_len(sub) == 2 and str_byte(sub, 1) == 58) {
                if not fs_is_dir(sub) {
                    _ := sys_fs_mkdir(sub)
                }
            }
        }
        i += 1
    }
    return fs_is_dir(norm)
}

fn fs_copy(src: str, dst: str) -> bool {
    if not _fs_safe_str(src) or not _fs_safe_str(dst) { return false }
    b := fs_read_file(src) or return false
    rc := fs_write_file(dst, b)
    buf_free(move b)
    return rc >= 0
}

fn fs_move_file(src: str, dst: str) -> bool {
    if not _fs_safe_str(src) or not _fs_safe_str(dst) { return false }
    k := ffi_open("kernel32.dll", "libc.so.6", "libSystem.B.dylib")
    if k == 0 { return false }
    cs := ffi_cstr(src)
    cd := ffi_cstr(dst)
    if cs == 0 or cd == 0 {
        if cs != 0 { ffi_free(cs) }
        if cd != 0 { ffi_free(cd) }
        return false
    }
    f_win := ffi_sym(k, "MoveFileExA")
    mut ok_m := false
    if f_win != 0 {
        // MOVEFILE_REPLACE_EXISTING (1) | MOVEFILE_COPY_ALLOWED (2) = 3
        ok_m = (ffi_call3(f_win, cs, cd, 3) & 0xFFFFFFFF) != 0
    } else {
        f_ren := ffi_sym(k, "rename")
        if f_ren != 0 {
            ok_m = ffi_sext32(ffi_call2(f_ren, cs, cd)) == 0
        }
    }
    ffi_free(cs)
    ffi_free(cd)
    return ok_m
}

// Crash-safe atomic file replacement via CSPRNG-unique sibling `.tmp` + atomic UTF-16 OS rename (CWE-377 safe)
fn fs_atomic_write(path: str, content: str) -> bool {
    if not _fs_safe_str(path) { return false }
    tok := secrets_token_hex(8) or return false
    tmp := f"{path}.tmp.{sys_pid()}.{tok}"
    if not fs_write_text(tmp, content) { return false }
    if fs_move_file(tmp, path) { return true }
    _ := sys_fs_remove(tmp)
    return false
}

fn fs_temp_dir() -> str {
    t1 := sys_env_get("TEMP")
    if str_len(t1) > 0 { return t1 }
    t2 := sys_env_get("TMP")
    if str_len(t2) > 0 { return t2 }
    t3 := sys_env_get("TMPDIR")
    if str_len(t3) > 0 { return t3 }
    return "/tmp"
}

// Lists non-`.`/`..` entry names inside `dir_path` using UTF-16LE `FindFirstFileW` on Win64 + `opendir`/`readdir` on Unix.
fn fs_list_dir(dir_path: str) -> StrVec {
    mut out := svec_new(32, 512)
    if not _fs_safe_str(dir_path) { return out }
    k := ffi_open("kernel32.dll", "libc.so.6", "libSystem.B.dylib")
    if k == 0 { return out }
    f_first := ffi_sym(k, "FindFirstFileW")
    f_next := ffi_sym(k, "FindNextFileW")
    f_close := ffi_sym(k, "FindClose")
    if f_first != 0 and f_next != 0 and f_close != 0 {
        pat := path_join(dir_path, "*")
        wpat := ffi_wstr(pat)
        fdata := ffi_alloc(640) // WIN32_FIND_DATAW = 592 bytes; cFileName at offset 44
        if wpat != 0 and fdata != 0 {
            h := ffi_call2(f_first, wpat, fdata)
            if h != -1 and h != 0xFFFFFFFFFFFFFFFF {
                mut more := true
                mut guard := 0
                while more and guard < 100000 {
                    name := ffi_read_wstr(fdata + 44, 260)
                    if not str_eq(name, ".") and not str_eq(name, "..") and str_len(name) > 0 {
                        svec_push(mut out, name)
                    }
                    more = (ffi_call2(f_next, h, fdata) & 0xFFFFFFFF) != 0
                    guard += 1
                }
                _ := ffi_call1(f_close, h)
            }
        }
        if fdata != 0 { ffi_free(fdata) }
        if wpat != 0 { ffi_free(wpat) }
        return out
    }
    // Unix fallback: opendir / readdir / closedir (struct dirent d_name at offset 19 on Linux x86_64)
    f_op := ffi_sym(k, "opendir")
    f_rd := ffi_sym(k, "readdir")
    f_cl := ffi_sym(k, "closedir")
    if f_op != 0 and f_rd != 0 and f_cl != 0 {
        cp := ffi_cstr(dir_path)
        if cp != 0 {
            dp := ffi_call1(f_op, cp)
            ffi_free(cp)
            if dp != 0 {
                mut guard := 0
                while guard < 100000 {
                    ent := ffi_call1(f_rd, dp)
                    if ent == 0 { break }
                    name := ffi_read_cstr(ent + 19, 256)
                    if str_len(name) > 0 and not str_eq(name, ".") and not str_eq(name, "..") {
                        svec_push(mut out, name)
                    }
                    guard += 1
                }
                _ := ffi_call1(f_cl, dp)
            }
        }
    }
    return out
}
