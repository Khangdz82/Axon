// Axon Standard Library - Zero-Cost Monomorphized Generics (`std/vec.ax`)
// All generic types & functions monomorphize at compile time to concrete, zero-overhead
// stack/register layouts with full Perceus 0-GC FBIP and `--shield` safety.

struct Box[T] {
    value: T
}

struct Pair[A, B] {
    first: A,
    second: B
}

struct Option[T] {
    has_val: bool,
    value: T
}

fn some[T](v: T) -> Option[T] {
    return Option[T](true, v)
}

fn none_opt[T](default_val: T) -> Option[T] {
    return Option[T](false, default_val)
}

fn unwrap_or[T](opt: Option[T], fallback: T) -> T {
    if opt.has_val {
        return opt.value
    }
    return fallback
}

@inline
fn min_val[T](a: T, b: T) -> T {
    if a < b {
        return a
    }
    return b
}

@inline
fn max_val[T](a: T, b: T) -> T {
    if a > b {
        return a
    }
    return b
}

@inline
fn clamp_val[T](v: T, lo: T, hi: T) -> T {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

fn swap_pair[A, B](p: Pair[A, B]) -> Pair[B, A] {
    return Pair[B, A](p.second, p.first)
}
