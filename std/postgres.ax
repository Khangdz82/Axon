// Axon Production PostgreSQL Driver (`std/postgres.ax`)
// Dual-mode production PostgreSQL support:
//   1. 100% Pure-Axon PostgreSQL Wire Protocol v3.0 over live TCP (`std::net`):
//      StartupMessage, Cleartext/MD5 auth, Simple Query (`Q`), Parameterized Extended Query
//      (`Parse`/`Bind`/`Execute`/`Sync` - SQL-injection proof), RowDescription (`T`), DataRow (`D`),
//      CommandComplete (`C`), ErrorResponse (`E`), ReadyForQuery (`Z`), Terminate (`X`).
//   2. Native `libpq` dynamic FFI bridge (`libpq.dll` / `libpq.so.5` / `libpq.dylib`) for SSL/SCRAM/GSSAPI.

use std::ffi
use std::net
use std::crypto
use std::auth
use std::os_auth

struct PgScramState {
    client_nonce: str
    client_first_bare: str
    expected_server_sig: str
}

struct PgConn {
    sock: TcpStream
    server_pid: i64
    secret_key: i64
    tx_status: i64
    connected: bool
}

struct PgResult {
    col_count: i64
    row_count: i64
    ok_flag: bool
    cmd_tag: str
    err_msg: str
    cell_data: ByteBuf
    cell_offs: IntBuf
    cell_lens: IntBuf
    col_names: ByteBuf
    col_offs: IntBuf
    col_lens: IntBuf
}

fn _pg_push_be32(b: ByteBuf, v: i64) {
    buf_push(b, (v >> 24) & 255)
    buf_push(b, (v >> 16) & 255)
    buf_push(b, (v >> 8) & 255)
    buf_push(b, v & 255)
}

fn _pg_push_be16(b: ByteBuf, v: i64) {
    buf_push(b, (v >> 8) & 255)
    buf_push(b, v & 255)
}

fn _pg_read_be32(b: ByteBuf, off: i64) -> i64 {
    return (buf_get(b, off) << 24) | (buf_get(b, off + 1) << 16) | (buf_get(b, off + 2) << 8) | buf_get(b, off + 3)
}

fn _pg_read_be16(b: ByteBuf, off: i64) -> i64 {
    return (buf_get(b, off) << 8) | buf_get(b, off + 1)
}

fn _pg_push_cstr(b: ByteBuf, s: str) {
    n := str_len(s)
    mut i := 0
    while i < n {
        ch := str_byte(s, i)
        if ch != 0 { buf_push(b, ch) } // Strip NUL bytes to prevent startup/query parameter smuggling
        i += 1
    }
    buf_push(b, 0)
}

// Build PostgreSQL Wire v3.0 StartupMessage (`[len:4][196608:4]["user\0...\0database\0...\0\0"]`)
fn pg_encode_startup(user: str, database: str) -> ByteBuf {
    body := buf_new(str_len(user) + str_len(database) + 64)
    _pg_push_be32(body, 196608) // Protocol 3.0 (3 << 16)
    _pg_push_cstr(body, "user"); _pg_push_cstr(body, user)
    _pg_push_cstr(body, "database"); _pg_push_cstr(body, database)
    _pg_push_cstr(body, "client_encoding"); _pg_push_cstr(body, "UTF8")
    buf_push(body, 0)
    pkt := buf_new(buf_len(body) + 8)
    _pg_push_be32(pkt, buf_len(body) + 4)
    mut i := 0
    while i < buf_len(body) { buf_push(pkt, buf_get(body, i)); i += 1 }
    buf_free(move body)
    return pkt
}

// Build Simple Query message (`['Q'][len:4][sql\0]`)
fn pg_encode_query(sql: str) -> ByteBuf {
    n := str_len(sql)
    pkt := buf_new(n + 16)
    buf_push(pkt, 81) // 'Q'
    _pg_push_be32(pkt, n + 5)
    _pg_push_cstr(pkt, sql)
    return pkt
}

// Build PasswordMessage (`['p'][len:4][pass\0]`)
fn pg_encode_password(pw: str) -> ByteBuf {
    n := str_len(pw)
    pkt := buf_new(n + 16)
    buf_push(pkt, 112) // 'p'
    _pg_push_be32(pkt, n + 5)
    _pg_push_cstr(pkt, pw)
    return pkt
}

// Standard RFC 4648 Section 4 Base64 (`+`, `/`, `=`) required by PostgreSQL SCRAM-SHA-256 (`s=`, `p=`, `v=`).
fn _pg_b64_encode_bytes(data: ByteBuf) -> str {
    n := buf_len(data)
    if n <= 0 { return "" }
    alpha := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    out := buf_new(((n + 2) / 3) * 4 + 8)
    mut i := 0
    while i + 2 < n {
        b0 := buf_get(data, i) & 255
        b1 := buf_get(data, i + 1) & 255
        b2 := buf_get(data, i + 2) & 255
        v := (b0 << 16) | (b1 << 8) | b2
        buf_push(out, str_byte(alpha, (v >> 18) & 63))
        buf_push(out, str_byte(alpha, (v >> 12) & 63))
        buf_push(out, str_byte(alpha, (v >> 6) & 63))
        buf_push(out, str_byte(alpha, v & 63))
        i += 3
    }
    rem := n - i
    if rem == 1 {
        b0 := buf_get(data, i) & 255
        buf_push(out, str_byte(alpha, (b0 >> 2) & 63))
        buf_push(out, str_byte(alpha, (b0 & 3) << 4))
        buf_push(out, 61); buf_push(out, 61)
    } else if rem == 2 {
        b0 := buf_get(data, i) & 255
        b1 := buf_get(data, i + 1) & 255
        v := (b0 << 8) | b1
        buf_push(out, str_byte(alpha, (v >> 10) & 63))
        buf_push(out, str_byte(alpha, (v >> 4) & 63))
        buf_push(out, str_byte(alpha, (v & 15) << 2))
        buf_push(out, 61)
    }
    return buf_to_owned_str(move out)
}

fn _pg_b64_val(ch: i64) -> i64 {
    if ch >= 65 and ch <= 90 { return ch - 65 }
    if ch >= 97 and ch <= 122 { return ch - 97 + 26 }
    if ch >= 48 and ch <= 57 { return ch - 48 + 52 }
    if ch == 43 { return 62 }
    if ch == 47 { return 63 }
    return -1
}

fn _pg_b64_decode_bytes(s: str) -> ByteBuf ! i64 {
    n := str_len(s)
    out := buf_new((n * 3) / 4 + 8)
    mut acc := 0
    mut bits := 0
    mut i := 0
    while i < n {
        ch := str_byte(s, i)
        if ch == 61 or ch <= 32 {
            i += 1
        } else {
            v := _pg_b64_val(ch)
            if v < 0 { buf_free(move out); return err(400) }
            acc = (acc << 6) | v
            bits += 6
            if bits >= 8 {
                bits -= 8
                buf_push(out, (acc >> bits) & 255)
            }
            i += 1
        }
    }
    return ok(out)
}

fn pg_encode_sasl_initial(mechanism: str, client_first_msg: str) -> ByteBuf {
    ml := str_len(mechanism)
    cl := str_len(client_first_msg)
    pkt := buf_new(ml + cl + 24)
    buf_push(pkt, 112) // 'p'
    _pg_push_be32(pkt, 4 + ml + 1 + 4 + cl)
    _pg_push_cstr(pkt, mechanism)
    _pg_push_be32(pkt, cl)
    if cl > 0 { buf_push_str(pkt, client_first_msg) }
    return pkt
}

fn pg_encode_sasl_response(client_final_msg: str) -> ByteBuf {
    cl := str_len(client_final_msg)
    pkt := buf_new(cl + 16)
    buf_push(pkt, 112) // 'p'
    _pg_push_be32(pkt, 4 + cl)
    if cl > 0 { buf_push_str(pkt, client_final_msg) }
    return pkt
}

// Computes RFC 5802 / PostgreSQL 14-17 `SCRAM-SHA-256` `client-final-message` + expected `ServerSignature`!
fn pg_scram_compute_final(password: str, client_nonce: str, client_first_bare: str, server_first: str, out_server_sig: ByteBuf) -> str ! i64 {
    // Parse `r=<r_full>,s=<salt_b64>,i=<iters>`
    ranges := str_split_ranges(server_first, 44)
    cnt := str_split_count(ranges)
    mut r_full := ""
    mut s_b64 := ""
    mut iters := 0
    mut k := 0
    while k < cnt {
        part := str_split_at(server_first, ranges, k)
        if str_len(part) > 2 and str_byte(part, 1) == 61 {
            tag := str_byte(part, 0)
            val := str_slice(part, 2, str_len(part))
            if tag == 114 { r_full = val }
            else if tag == 115 { s_b64 = val }
            else if tag == 105 {
                mut p := 0
                while p < str_len(val) {
                    ch := str_byte(val, p)
                    if ch >= 48 and ch <= 57 { iters = iters * 10 + (ch - 48) }
                    p += 1
                }
            }
        }
        k += 1
    }
    buf_free(move ranges)
    cn_len := str_len(client_nonce)
    if str_len(r_full) <= cn_len or str_len(s_b64) == 0 or iters < 1 { return err(-306) }
    if not str_eq(str_slice(r_full, 0, cn_len), client_nonce) { return err(-307) }

    salt_b := _pg_b64_decode_bytes(s_b64) or return err(-306)
    pw_b := buf_new(str_len(password) + 8)
    if str_len(password) > 0 { buf_push_str(pw_b, password) }
    salted_pw := pbkdf2_hmac_sha256_bytes(pw_b, salt_b, iters, 32)
    buf_free(move pw_b); buf_free(move salt_b)

    ck_label := buf_new(16); buf_push_str(ck_label, "Client Key")
    client_key := hmac_sha256_raw(salted_pw, ck_label)
    buf_free(move ck_label)

    sk_words := sha256_raw_digest(client_key)
    stored_key := buf_new(36)
    mut wi := 0
    while wi < 8 {
        wv := ibuf_get(sk_words, wi)
        buf_push(stored_key, (wv >> 24) & 255); buf_push(stored_key, (wv >> 16) & 255)
        buf_push(stored_key, (wv >> 8) & 255);  buf_push(stored_key, wv & 255)
        wi += 1
    }
    buf_free(move sk_words)

    cf_no_proof := "c=biws,r=" + r_full
    auth_str := client_first_bare + "," + server_first + "," + cf_no_proof
    auth_b := buf_new(str_len(auth_str) + 8)
    buf_push_str(auth_b, auth_str)

    client_sig := hmac_sha256_raw(stored_key, auth_b)
    buf_free(move stored_key)

    proof := buf_new(36)
    mut bi := 0
    while bi < 32 {
        buf_push(proof, buf_get(client_key, bi) ^ buf_get(client_sig, bi))
        bi += 1
    }
    buf_free(move client_key); buf_free(move client_sig)
    proof_b64 := _pg_b64_encode_bytes(proof)
    buf_free(move proof)

    svk_label := buf_new(16); buf_push_str(svk_label, "Server Key")
    server_key := hmac_sha256_raw(salted_pw, svk_label)
    buf_free(move svk_label); buf_free(move salted_pw)
    server_sig := hmac_sha256_raw(server_key, auth_b)
    buf_free(move server_key); buf_free(move auth_b)
    exp_v := _pg_b64_encode_bytes(server_sig)
    buf_free(move server_sig)
    buf_truncate(out_server_sig, 0)
    buf_push_str(out_server_sig, exp_v)

    return ok(cf_no_proof + ",p=" + proof_b64)
}

// Build Parameterized Extended Query (`Parse` + `Bind` + `Describe` + `Execute` + `Sync`)
// `params_csv`: NUL-separated or newline-separated parameter values (`param_vals` / `param_offs` / `param_lens`)
fn pg_encode_extended_query(sql: str, param_buf: ByteBuf, param_offs: IntBuf, param_lens: IntBuf) -> ByteBuf {
    mut pcnt := ibuf_len(param_offs)
    if ibuf_len(param_lens) < pcnt { pcnt = ibuf_len(param_lens) }
    if pcnt > 65535 { pcnt = 65535 }
    pkt := buf_new(str_len(sql) + buf_len(param_buf) + pcnt * 8 + 128)

    // 1. Parse ('P'): stmt="", sql, 0 param oids
    buf_push(pkt, 80) // 'P'
    _pg_push_be32(pkt, 4 + 1 + str_len(sql) + 1 + 2)
    buf_push(pkt, 0) // unnamed statement
    _pg_push_cstr(pkt, sql)
    _pg_push_be16(pkt, 0)

    // 2. Bind ('B'): portal="", stmt="", 0 param formats, pcnt params, 0 result formats
    pbuf_len := buf_len(param_buf)
    mut bind_len := 4 + 1 + 1 + 2 + 2 + 2
    mut i := 0
    while i < pcnt {
        po := ibuf_get(param_offs, i)
        pl := ibuf_get(param_lens, i)
        if pl < 0 or po < 0 or po > pbuf_len or pl > pbuf_len - po {
            bind_len += 4
        } else {
            bind_len += 4 + pl
        }
        i += 1
    }
    buf_push(pkt, 66) // 'B'
    _pg_push_be32(pkt, bind_len)
    buf_push(pkt, 0); buf_push(pkt, 0)
    _pg_push_be16(pkt, 0)
    _pg_push_be16(pkt, pcnt)
    i = 0
    while i < pcnt {
        po := ibuf_get(param_offs, i)
        pl := ibuf_get(param_lens, i)
        if pl < 0 or po < 0 or po > pbuf_len or pl > pbuf_len - po {
            _pg_push_be32(pkt, -1) // SQL NULL
        } else {
            _pg_push_be32(pkt, pl)
            mut k := 0
            while k < pl { buf_push(pkt, buf_get(param_buf, po + k)); k += 1 }
        }
        i += 1
    }
    _pg_push_be16(pkt, 0)

    // 3. Describe ('D'): portal ""
    buf_push(pkt, 68); _pg_push_be32(pkt, 6); buf_push(pkt, 80); buf_push(pkt, 0)
    // 4. Execute ('E'): portal "", max_rows=0 (unlimited)
    buf_push(pkt, 69); _pg_push_be32(pkt, 9); buf_push(pkt, 0); _pg_push_be32(pkt, 0)
    // 5. Sync ('S')
    buf_push(pkt, 83); _pg_push_be32(pkt, 4)
    return pkt
}

// Read one PostgreSQL backend message (`[type:1][len:4][payload:len-4]`)
fn _pg_read_msg(sock: TcpStream, out_type: IntBuf) -> ByteBuf ! i64 {
    hdr := tcp_recv_exact(sock, 5) or return
    mtype := buf_get(hdr, 0)
    mlen := _pg_read_be32(hdr, 1)
    buf_free(move hdr)
    if ibuf_len(out_type) == 0 { ibuf_push(out_type, mtype) } else { ibuf_set(out_type, 0, mtype) }
    if mlen < 4 or mlen > 67108864 { return err(-300) }
    if mlen == 4 { return ok(buf_new(0)) }
    return tcp_recv_exact(sock, mlen - 4)
}

fn pg_connect(host: str, port: i64, user: str, password: str, database: str) -> PgConn ! i64 {
    sock := tcp_connect(host, port) or return
    _ := tcp_set_nodelay(sock, true)
    _ := tcp_set_timeout_ms(sock, 30000)
    st := pg_encode_startup(user, database)
    sr := tcp_send_bytes(sock, st) or -1
    buf_free(move st)
    if sr < 0 { tcp_close(sock); return err(-301) }

    mtype_box := ibuf_new(4)
    scram_exp_sig := buf_new(128)
    mut scram_nonce := ""
    mut scram_cfb := ""
    mut pid := 0
    mut skey := 0
    mut tx := 73 // 'I' idle
    mut authed := false
    mut guard := 0
    while guard < 128 {
        guard += 1
        payload := _pg_read_msg(sock, mtype_box) or buf_new(0)
        if ibuf_len(mtype_box) == 0 or (buf_len(payload) == 0 and ibuf_get(mtype_box, 0) == 0) {
            buf_free(move payload); buf_free(move mtype_box); buf_free(move scram_exp_sig); tcp_close(sock)
            return err(-302)
        }
        mt := ibuf_get(mtype_box, 0)
        if mt == 82 { // 'R' Authentication
            if buf_len(payload) < 4 {
                buf_free(move payload); buf_free(move mtype_box); buf_free(move scram_exp_sig); tcp_close(sock)
                return err(-303)
            }
            auth_kind := _pg_read_be32(payload, 0)
            if auth_kind == 0 {
                authed = true
            } else if auth_kind == 3 {
                // AuthenticationCleartextPassword
                pw_pkt := pg_encode_password(password)
                _ := tcp_send_bytes(sock, pw_pkt) or -1
                buf_free(move pw_pkt)
            } else if auth_kind == 10 {
                // AuthenticationSASL (`SCRAM-SHA-256`)
                rnd_b := os_csprng_bytes(18) or buf_new(0)
                scram_nonce = if buf_len(rnd_b) > 0 { _pg_b64_encode_bytes(rnd_b) } else { "axonScramNonce9988776655" }
                buf_free(move rnd_b)
                scram_cfb = "n=,r=" + scram_nonce
                init_pkt := pg_encode_sasl_initial("SCRAM-SHA-256", "n,," + scram_cfb)
                _ := tcp_send_bytes(sock, init_pkt) or -1
                buf_free(move init_pkt)
            } else if auth_kind == 11 {
                // AuthenticationSASLContinue
                sf_str := if buf_len(payload) > 4 { "" + buf_slice_str(payload, 4, buf_len(payload)) } else { "" }
                cf_msg := pg_scram_compute_final(password, scram_nonce, scram_cfb, sf_str, scram_exp_sig) or ""
                if str_len(cf_msg) == 0 {
                    buf_free(move payload); buf_free(move mtype_box); buf_free(move scram_exp_sig); tcp_close(sock)
                    return err(-306)
                }
                resp_pkt := pg_encode_sasl_response(cf_msg)
                _ := tcp_send_bytes(sock, resp_pkt) or -1
                buf_free(move resp_pkt)
            } else if auth_kind == 12 {
                // AuthenticationSASLFinal (`v=<server_sig_b64>`)
                fin_str := if buf_len(payload) > 4 { "" + buf_slice_str(payload, 4, buf_len(payload)) } else { "" }
                exp_v := "v=" + buf_slice_str(scram_exp_sig, 0, buf_len(scram_exp_sig))
                if not ct_eq_str(fin_str, exp_v) {
                    buf_free(move payload); buf_free(move mtype_box); buf_free(move scram_exp_sig); tcp_close(sock)
                    return err(-308)
                }
            } else {
                buf_free(move payload); buf_free(move mtype_box); buf_free(move scram_exp_sig); tcp_close(sock)
                return err(-303)
            }
        } else if mt == 75 { // 'K' BackendKeyData
            if buf_len(payload) >= 8 {
                pid = _pg_read_be32(payload, 0)
                skey = _pg_read_be32(payload, 4)
            }
        } else if mt == 90 { // 'Z' ReadyForQuery
            if buf_len(payload) >= 1 { tx = buf_get(payload, 0) }
            buf_free(move payload)
            break
        } else if mt == 69 { // 'E' ErrorResponse
            buf_free(move payload); buf_free(move mtype_box); buf_free(move scram_exp_sig); tcp_close(sock)
            return err(-304)
        }
        buf_free(move payload)
    }
    buf_free(move scram_exp_sig)
    buf_free(move mtype_box)
    if not authed { tcp_close(sock); return err(-305) }
    return ok(PgConn(sock = sock, server_pid = pid, secret_key = skey, tx_status = tx, connected = true))
}

fn _pg_read_query_result(sock: TcpStream) -> PgResult ! i64 {
    cell_data := buf_new(4096)
    cell_offs := ibuf_new(256)
    cell_lens := ibuf_new(256)
    col_names := buf_new(512)
    col_offs := ibuf_new(64)
    col_lens := ibuf_new(64)
    mtype_box := ibuf_new(4)
    ibuf_push(mtype_box, 0)
    mut ncols := 0
    mut nrows := 0
    mut ok_f := true
    mut cmd_tag := ""
    mut err_msg := ""

    mut guard := 0
    while guard < 100000 {
        guard += 1
        ibuf_set(mtype_box, 0, 0)
        payload := _pg_read_msg(sock, mtype_box) or buf_new(0)
        mt := ibuf_get(mtype_box, 0)
        if mt == 0 {
            buf_free(move payload); buf_free(move mtype_box)
            buf_free(move cell_data); buf_free(move cell_offs); buf_free(move cell_lens)
            buf_free(move col_names); buf_free(move col_offs); buf_free(move col_lens)
            return err(-310)
        }
        plen := buf_len(payload)
        if mt == 84 { // 'T' RowDescription
            if plen >= 2 {
                ncols = _pg_read_be16(payload, 0)
                if ncols > 64 { ncols = 64 }
                mut pos := 2
                mut ci := 0
                while ci < ncols and pos < plen and ibuf_len(col_offs) < 64 {
                    ns := pos
                    while pos < plen and buf_get(payload, pos) != 0 { pos += 1 }
                    mut nlen := pos - ns
                    rem_cn := 512 - buf_len(col_names)
                    if nlen > rem_cn { nlen = rem_cn }
                    ibuf_push(col_offs, buf_len(col_names))
                    ibuf_push(col_lens, nlen)
                    mut k := 0
                    while k < nlen { buf_push(col_names, buf_get(payload, ns + k)); k += 1 }
                    pos += 1 + 18 // NUL + 18 bytes column metadata
                    ci += 1
                }
                ncols = ibuf_len(col_offs)
            }
        } else if mt == 68 { // 'D' DataRow
            if plen >= 2 {
                mut fcnt := _pg_read_be16(payload, 0)
                if ncols > 0 and fcnt > ncols { fcnt = ncols }
                mut pos := 2
                mut ci := 0
                while ci < fcnt and pos + 4 <= plen and ibuf_len(cell_offs) < 256 {
                    flen := ffi_sext32(_pg_read_be32(payload, pos))
                    pos += 4
                    ibuf_push(cell_offs, buf_len(cell_data))
                    if flen <= 0 {
                        ibuf_push(cell_lens, 0)
                    } else {
                        mut avail := plen - pos
                        if flen < avail { avail = flen }
                        rem_cd := 4096 - buf_len(cell_data)
                        mut copy_n := avail
                        if copy_n > rem_cd { copy_n = rem_cd }
                        ibuf_push(cell_lens, copy_n)
                        mut k := 0
                        while k < copy_n {
                            buf_push(cell_data, buf_get(payload, pos + k))
                            k += 1
                        }
                        pos += avail
                    }
                    ci += 1
                }
                nrows += 1
            }
        } else if mt == 67 { // 'C' CommandComplete
            mut end := plen
            if end > 0 and buf_get(payload, end - 1) == 0 { end -= 1 }
            cmd_tag = "" + buf_slice_str(payload, 0, end)
        } else if mt == 69 { // 'E' ErrorResponse
            ok_f = false
            mut pos := 0
            while pos < plen {
                ft := buf_get(payload, pos)
                if ft == 0 { break }
                pos += 1
                vs := pos
                while pos < plen and buf_get(payload, pos) != 0 { pos += 1 }
                if ft == 77 { // 'M' message
                    err_msg = "" + buf_slice_str(payload, vs, pos)
                }
                pos += 1
            }
        } else if mt == 90 { // 'Z' ReadyForQuery
            buf_free(move payload)
            break
        }
        buf_free(move payload)
    }
    buf_free(move mtype_box)
    return ok(PgResult(
        col_count = ncols, row_count = nrows, ok_flag = ok_f,
        cmd_tag = cmd_tag, err_msg = err_msg,
        cell_data = cell_data, cell_offs = cell_offs, cell_lens = cell_lens,
        col_names = col_names, col_offs = col_offs, col_lens = col_lens
    ))
}

fn pg_query(conn: PgConn, sql: str) -> PgResult ! i64 {
    pkt := pg_encode_query(sql)
    sr := tcp_send_bytes(conn.sock, pkt) or -1
    buf_free(move pkt)
    if sr < 0 { return err(-311) }
    return _pg_read_query_result(conn.sock)
}

fn pg_result_get(res: PgResult, row: i64, col: i64) -> str {
    if row < 0 or row >= res.row_count or col < 0 or col >= res.col_count { return "" }
    idx := row * res.col_count + col
    if idx < 0 or idx >= ibuf_len(res.cell_offs) { return "" }
    off := ibuf_get(res.cell_offs, idx)
    ln := ibuf_get(res.cell_lens, idx)
    if off < 0 or ln < 0 or off + ln > buf_len(res.cell_data) { return "" }
    return buf_slice_str(res.cell_data, off, off + ln)
}

fn pg_result_col_name(res: PgResult, col: i64) -> str {
    if col < 0 or col >= res.col_count or col >= ibuf_len(res.col_offs) { return "" }
    off := ibuf_get(res.col_offs, col)
    ln := ibuf_get(res.col_lens, col)
    if off < 0 or ln < 0 or off + ln > buf_len(res.col_names) { return "" }
    return buf_slice_str(res.col_names, off, off + ln)
}

fn pg_close(conn: PgConn) {
    if conn.connected {
        pkt := buf_new(8)
        buf_push(pkt, 88); _pg_push_be32(pkt, 4) // 'X' Terminate
        _ := tcp_send_bytes(conn.sock, pkt) or 0
        buf_free(move pkt)
        tcp_close(conn.sock)
    }
}

// --- Native `libpq` Dynamic FFI Bridge (`libpq.dll` / `libpq.so.5` / `libpq.dylib`) ---
struct LibPqApi {
    lib: i64
    fn_connectdb: i64
    fn_status: i64
    fn_exec: i64
    fn_ntuples: i64
    fn_nfields: i64
    fn_getvalue: i64
    fn_clear: i64
    fn_finish: i64
    fn_errmsg: i64
}

fn libpq_load() -> LibPqApi ! i64 {
    lib := ffi_open("libpq.dll", "libpq.so.5", "libpq.dylib")
    if lib == 0 { return err(-320) }
    return ok(LibPqApi(
        lib = lib,
        fn_connectdb = ffi_sym(lib, "PQconnectdb"),
        fn_status = ffi_sym(lib, "PQstatus"),
        fn_exec = ffi_sym(lib, "PQexec"),
        fn_ntuples = ffi_sym(lib, "PQntuples"),
        fn_nfields = ffi_sym(lib, "PQnfields"),
        fn_getvalue = ffi_sym(lib, "PQgetvalue"),
        fn_clear = ffi_sym(lib, "PQclear"),
        fn_finish = ffi_sym(lib, "PQfinish"),
        fn_errmsg = ffi_sym(lib, "PQerrorMessage")
    ))
}

fn libpq_available() -> bool {
    api := libpq_load() or return false
    return api.lib != 0
}
