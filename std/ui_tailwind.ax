        return
    }

    if c0 == 108 { // 'l' -> left-*, lowercase, leading-*, line-through
        if str_eq(t, "lowercase") { style.text_transform = 2; return }
        if str_eq(t, "line-through") { style.text_decoration = 2; return }
        if str_starts_with(t, "leading-") {
            rest := str_slice(t, 8, n)
            if str_eq(rest, "none") { style.line_height = 16 }
            else if str_eq(rest, "tight") { style.line_height = 19 }
            else if str_eq(rest, "snug") { style.line_height = 21 }
            else if str_eq(rest, "normal") { style.line_height = 24 }
            else if str_eq(rest, "relaxed") { style.line_height = 26 }
            else if str_eq(rest, "loose") { style.line_height = 30 }
            else {
                lh := _tw_spacing_px(rest)
                if lh > 0 { style.line_height = lh }
            }
            return
        }
        if str_starts_with(t, "left-") {
            lp := _tw_spacing_px(str_slice(t, 5, n))
            if lp >= 0 { style.pos_left = lp }
        }
        return
    }

    if c0 == 117 { // 'u' -> uppercase, underline
        if str_eq(t, "uppercase") { style.text_transform = 1 }
        else if str_eq(t, "underline") { style.text_decoration = 1 }
        return
    }

    if c0 == 118 { // 'v' -> via-* (3-stop gradient midpoint)
        if str_starts_with(t, "via-") {
            c := _tw_color(str_slice(t, 4, n))
            if c != 0 { style.grad_via = c }
        }
        return
    }

    if c0 == 122 { // 'z' -> z-* (supports z-[100])
        if str_starts_with(t, "z-") {
            rest := str_slice(t, 2, n)
            zv := if str_len(rest) >= 3 and str_byte(rest, 0) == 91 { _tw_parse_bracket_px(rest) } else { css_parse_px(rest) }
            if zv >= 0 { style.z_index = zv }
        }
        return
    }

    if c0 == 110 { // 'n' -> normal-case, no-underline
        if str_eq(t, "normal-case") { style.text_transform = 0 }
        else if str_eq(t, "no-underline") { style.text_decoration = 0 }
        return
    }

    if c0 == 119 { // 'w' -> w-*, whitespace-*
        if str_eq(t, "whitespace-nowrap") { style.white_space = 1; return }
        if str_eq(t, "whitespace-pre") or str_eq(t, "whitespace-pre-wrap") { style.white_space = 2; return }
        if str_eq(t, "whitespace-normal") { style.white_space = 0; return }
        if str_eq(t, "w-full") or str_eq(t, "w-screen") { style.width = -1 }
        else if str_eq(t, "w-auto") or str_eq(t, "w-fit") { style.width = -3 }
        else if str_eq(t, "w-0") { style.width = 0 }
        else if str_eq(t, "w-px") { style.width = 1 }
        else if str_eq(t, "w-1/2") { style.width = -1050 }
        else if str_eq(t, "w-1/3") { style.width = -1033 }
        else if str_eq(t, "w-2/3") { style.width = -1067 }
        else if str_eq(t, "w-1/4") { style.width = -1025 }
        else if str_eq(t, "w-3/4") { style.width = -1075 }
        else if str_eq(t, "w-1/5") { style.width = -1020 }
        else if str_eq(t, "w-2/5") { style.width = -1040 }
        else if str_eq(t, "w-3/5") { style.width = -1060 }
        else if str_eq(t, "w-4/5") { style.width = -1080 }
        else if str_eq(t, "w-1/6") { style.width = -1017 }
        else if str_eq(t, "w-5/6") { style.width = -1083 }
        else if str_eq(t, "w-1/12") { style.width = -1008 }
        else if str_starts_with(t, "w-") {
            wp := _tw_spacing_px(str_slice(t, 2, n))
            if wp > 0 or wp <= -1000 { style.width = wp }
        }
        return
    }

    if c0 == 104 { // 'h' -> h-*, hidden
        if str_eq(t, "hidden") { style.display = 3 }
        else if str_eq(t, "h-full") or str_eq(t, "h-screen") { style.height = -100 }
        else if str_eq(t, "h-auto") or str_eq(t, "h-fit") { style.height = -1 }
        else if str_eq(t, "h-0") { style.height = 0 }
        else if str_eq(t, "h-px") { style.height = 1 }
        else if str_starts_with(t, "h-") {
            hp := _tw_spacing_px(str_slice(t, 2, n))
            if hp > 0 or hp <= -1000 { style.height = hp }
        }
        return
    }

    if c0 == 97 { // 'a' -> absolute, align-items-*, alert*
        if str_eq(t, "absolute") { style.position = 1 }
        else if str_eq(t, "align-items-center") { style.align_items = 1 }
        else if str_eq(t, "align-items-start") { style.align_items = 2 }
        else if str_eq(t, "align-items-end") { style.align_items = 3 }
        else if str_eq(t, "alert") {
            style.padding_x = 32; style.padding_y = 24; style.border_radius = 8; style.margin_y = 24; style.border_width = 1
        }
        else if str_eq(t, "alert-primary") { style.bg_color = 0xFF084298; style.border_color = 0xFF084298; style.text_color = 0xFFFFFFFF }
        else if str_eq(t, "alert-success") { style.bg_color = 0xFF0F5132; style.border_color = 0xFF0F5132; style.text_color = 0xFFFFFFFF }
        else if str_eq(t, "alert-danger")  { style.bg_color = 0xFF842029; style.border_color = 0xFF842029; style.text_color = 0xFFFFFFFF }
        else if str_eq(t, "alert-warning") { style.bg_color = 0xFF664D03; style.border_color = 0xFF664D03; style.text_color = 0xFFFFFFFF }
        return
    }

    if c0 == 100 { // 'd' -> d-flex, d-none, d-block, d-inline
        if str_eq(t, "d-flex") { style.display = 1 }
        else if str_eq(t, "d-none") { style.display = 3 }
        else if str_eq(t, "d-block") { style.display = 0 }
        else if str_eq(t, "d-inline") { style.display = 2 }
        return
    }
}

// Fast zero-alloc space-splitting parser for full class attribute strings (with responsive viewport_w)
fn tw_apply_classes(mut style: ComputedStyle, class_str: str, viewport_w: i64 = 1280) {
    n := str_len(class_str)
    mut i := 0
    while i < n {
        while i < n and (str_byte(class_str, i) == 32 or str_byte(class_str, i) == 9 or str_byte(class_str, i) == 10 or str_byte(class_str, i) == 13) {
            i += 1
        }
        mut j := i
        while j < n and str_byte(class_str, j) != 32 and str_byte(class_str, j) != 9 and str_byte(class_str, j) != 10 and str_byte(class_str, j) != 13 {
            j += 1
        }
        if j > i {
            tw_apply_token(mut style, str_slice(class_str, i, j), viewport_w)
        }
        i = j + 1
    }
}
