// Axon Standard Library: Tailwind CSS v3/v4 & Bootstrap 5 Native Utility Engine (`std/ui_tailwind.ax`)
// Ultra-fast O(1) prefix-dispatched Tailwind v3/v4 & Bootstrap parser:
// - Complete 22-family x 11-shade (242-color) official Tailwind palette + arbitrary `[#HEX]/opacity` & `/[0.35]`
// - Direct arithmetic O(1) spacing (`p-*`, `m-*`, `w-*`, `h-*`, `size-*`, `gap-x/y-*`, `inset-*`)
// - Full 8-direction linear gradients + radial gradients + `bg-clip-text` gradient text
// - Glassmorphism `backdrop-blur-*`, colored `shadow-*`, separate `ring-*` + `ring-offset-*`, `truncate`
// - Responsive breakpoints (`sm:/md:/lg:/xl:/2xl:/max-*`), `dark:`, `hover:*`, `focus:*`, `active:*`.

use std::os
use std::str
use std::css

fn _tw_parse_bracket_px(s: str) -> i64 {
    n := str_len(s)
    if n < 3 or str_byte(s, 0) != 91 or str_byte(s, n - 1) != 93 { return -1 } // '[...]'
    return css_parse_px(str_slice(s, 1, n - 1))
}

// O(1) arithmetic Tailwind spacing scale (`0` -> 0, `px` -> 1, `0.5` -> 2, `N` -> N*4, `N.5` -> N*4+2, `[...]` -> px/pct)
fn _tw_spacing_px(val: str) -> i64 {
    n := str_len(val)
    if n == 0 { return -1 }
    c0 := str_byte(val, 0)
    if c0 == 91 { return _tw_parse_bracket_px(val) } // '[...]'
    if n == 2 and c0 == 112 and str_byte(val, 1) == 120 { return 1 } // "px"
    if c0 < 48 or c0 > 57 { return -1 }
    mut whole := 0
    mut half := 0
    mut i := 0
    while i < n {
        ch := str_byte(val, i)
        if ch >= 48 and ch <= 57 {
            if whole < 10000 { whole = whole * 10 + (ch - 48) }
        } else if ch == 46 and i + 1 < n {
            d := str_byte(val, i + 1) - 48
            if d == 5 { half = 2 }
            else if d >= 0 and d <= 9 { half = (d * 4) / 10 }
            i += 2
            if i < n { return -1 }
            break
        } else {
            return -1
        }
        i += 1
    }
    return whole * 4 + half
}

// Maps Tailwind shade string ("50".."950") -> 0..10 in O(1)
fn _tw_shade_idx(sh: str) -> i64 {
    n := str_len(sh)
    if n == 2 {
        if str_byte(sh, 0) == 53 and str_byte(sh, 1) == 48 { return 0 } // 50
        return -1
    }
    if n != 3 { return -1 }
    d0 := str_byte(sh, 0) - 48
    d1 := str_byte(sh, 1) - 48
    d2 := str_byte(sh, 2) - 48
    if d2 != 0 { return -1 }
    if d1 == 0 and d0 >= 1 and d0 <= 9 { return d0 } // 100..900 -> 1..9
    if d0 == 9 and d1 == 5 { return 10 } // 950 -> 10
    return -1
}

fn _tw_pick11(idx: i64, c50: i64, c100: i64, c200: i64, c300: i64, c400: i64, c500: i64, c600: i64, c700: i64, c800: i64, c900: i64, c950: i64) -> i64 {
    if idx == 5 { return c500 }
    if idx == 9 { return c900 }
    if idx == 8 { return c800 }
    if idx == 4 { return c400 }
    if idx == 6 { return c600 }
    if idx == 7 { return c700 }
    if idx == 10 { return c950 }
    if idx == 3 { return c300 }
    if idx == 2 { return c200 }
    if idx == 1 { return c100 }
    if idx == 0 { return c50 }
    return 0
}

// O(1) Official Tailwind v3/v4 22-family x 11-shade Color Resolver + `[#HEX]/opacity` + `color/[0.35]`
fn _tw_color(raw: str) -> i64 {
    n := str_len(raw)
    if n == 0 { return 0 }

    // Split optional opacity modifier `/` OUTSIDE brackets (`bg-slate-900/80`, `bg-[#111827]/80`, `bg-blue-500/[0.35]`)
    mut slash := -1
    mut in_br := false
    mut si := 0
    while si < n {
        b := str_byte(raw, si)
        if b == 91 { in_br = true }
        else if b == 93 { in_br = false }
        else if b == 47 and not in_br { slash = si; break }
        si += 1
    }

    mut name := raw
    mut alpha_255 := 255
    mut has_alpha_mod := false
    if slash > 0 and slash + 1 < n {
        name = str_slice(raw, 0, slash)
        op_raw := str_slice(raw, slash + 1, n)
        on := str_len(op_raw)
        has_alpha_mod = true
        if on >= 3 and str_byte(op_raw, 0) == 91 and str_byte(op_raw, on - 1) == 93 {
            // Arbitrary opacity `/[0.35]` or `/[40%]`
            alpha_255 = _css_parse_alpha_255(str_slice(op_raw, 1, on - 1))
        } else {
            ap := css_parse_px(op_raw)
            if ap <= 0 { alpha_255 = 0 }
            else if ap >= 100 { alpha_255 = 255 }
            else { alpha_255 = (ap * 255) / 100 }
        }
    }

    nn := str_len(name)
    if nn == 0 { return 0 }

    // Arbitrary color `[#111115]`, `[rgb(...)]`, `[hsl(...)]`
    if str_byte(name, 0) == 91 and str_byte(name, nn - 1) == 93 {
        col_arb := css_parse_color(str_slice(name, 1, nn - 1))
        if col_arb == 0 { return 0 }
        if has_alpha_mod {
            return (alpha_255 << 24) | (col_arb & 0x00FFFFFF)
        }
        return col_arb
    }

    mut col := 0
    dash := str_find_byte(name, 45, 0)
    if dash < 0 {
        c0 := str_byte(name, 0)
        if c0 == 116 and str_eq(name, "transparent") { return 0 }
        if c0 == 119 and str_eq(name, "white") { col = 0xFFFFFFFF }
        else if c0 == 98 and str_eq(name, "black") { col = 0xFF000000 }
        else if c0 == 112 and str_eq(name, "primary") { col = 0xFF0D6EFD }
        else { return 0 }
    } else {
        sh := _tw_shade_idx(str_slice(name, dash + 1, nn))
        if sh < 0 { return 0 }
        fam := str_slice(name, 0, dash)
        f0 := str_byte(fam, 0)

        if f0 == 115 { // 's': slate, stone, sky
            if str_eq(fam, "slate") {
                col = _tw_pick11(sh, 0xFFF8FAFC, 0xFFF1F5F9, 0xFFE2E8F0, 0xFFCBD5E1, 0xFF94A3B8, 0xFF64748B, 0xFF475569, 0xFF334155, 0xFF1E293B, 0xFF0F172A, 0xFF020617)
            } else if str_eq(fam, "sky") {
                col = _tw_pick11(sh, 0xFFF0F9FF, 0xFFE0F2FE, 0xFFBAE6FD, 0xFF7DD3FC, 0xFF38BDF8, 0xFF0EA5E9, 0xFF0284C7, 0xFF0369A1, 0xFF075985, 0xFF0C4A6E, 0xFF082F49)
            } else if str_eq(fam, "stone") {
                col = _tw_pick11(sh, 0xFFFAFAF9, 0xFFF5F5F4, 0xFFE7E5E4, 0xFFD6D3D1, 0xFFA8A29E, 0xFF78716C, 0xFF57534E, 0xFF44403C, 0xFF292524, 0xFF1C1917, 0xFF0C0A09)
            }
        } else if f0 == 122 { // 'z': zinc
            if str_eq(fam, "zinc") {
                col = _tw_pick11(sh, 0xFFFAFAFA, 0xFFF4F4F5, 0xFFE4E4E7, 0xFFD4D4D8, 0xFFA1A1AA, 0xFF71717A, 0xFF52525B, 0xFF3F3F46, 0xFF27272A, 0xFF18181B, 0xFF09090B)
            }
        } else if f0 == 103 { // 'g': gray, green
            if str_eq(fam, "gray") {
                col = _tw_pick11(sh, 0xFFF9FAFB, 0xFFF3F4F6, 0xFFE5E7EB, 0xFFD1D5DB, 0xFF9CA3AF, 0xFF6B7280, 0xFF4B5563, 0xFF374151, 0xFF1F2937, 0xFF111827, 0xFF030712)
            } else if str_eq(fam, "green") {
                col = _tw_pick11(sh, 0xFFF0FDF4, 0xFFDCFCE7, 0xFFBBF7D0, 0xFF86EFAC, 0xFF4ADE80, 0xFF22C55E, 0xFF16A34A, 0xFF15803D, 0xFF166534, 0xFF14532D, 0xFF052E16)
            }
        } else if f0 == 110 { // 'n': neutral
            if str_eq(fam, "neutral") {
                col = _tw_pick11(sh, 0xFFFAFAFA, 0xFFF5F5F5, 0xFFE5E5E5, 0xFFD4D4D4, 0xFFA3A3A3, 0xFF737373, 0xFF525252, 0xFF404040, 0xFF262626, 0xFF171717, 0xFF0A0A0A)
            }
        } else if f0 == 98 { // 'b': blue
            if str_eq(fam, "blue") {
                col = _tw_pick11(sh, 0xFFEFF6FF, 0xFFDBEAFE, 0xFFBFDBFE, 0xFF93C5FD, 0xFF60A5FA, 0xFF3B82F6, 0xFF2563EB, 0xFF1D4ED8, 0xFF1E40AF, 0xFF1E3A8A, 0xFF172554)
            }
        } else if f0 == 101 { // 'e': emerald
            if str_eq(fam, "emerald") {
                col = _tw_pick11(sh, 0xFFECFDF5, 0xFFD1FAE5, 0xFFA7F3D0, 0xFF6EE7B7, 0xFF34D399, 0xFF10B981, 0xFF059669, 0xFF047857, 0xFF065F46, 0xFF064E3B, 0xFF022C22)
            }
        } else if f0 == 105 { // 'i': indigo
            if str_eq(fam, "indigo") {
                col = _tw_pick11(sh, 0xFFEEF2FF, 0xFFE0E7FF, 0xFFC7D2FE, 0xFFA5B4FC, 0xFF818CF8, 0xFF6366F1, 0xFF4F46E5, 0xFF4338CA, 0xFF3730A3, 0xFF312E81, 0xFF1E1B4B)
            }
        } else if f0 == 114 { // 'r': red, rose
            if str_eq(fam, "red") {
                col = _tw_pick11(sh, 0xFFFEF2F2, 0xFFFEE2E2, 0xFFFECACA, 0xFFFCA5A5, 0xFFF87171, 0xFFEF4444, 0xFFDC2626, 0xFFB91C1C, 0xFF991B1B, 0xFF7F1D1D, 0xFF450A0A)
            } else if str_eq(fam, "rose") {
                col = _tw_pick11(sh, 0xFFFFF1F2, 0xFFFFE4E6, 0xFFFECDD3, 0xFFFDA4AF, 0xFFFB7185, 0xFFF43F5E, 0xFFE11D48, 0xFFBE123C, 0xFF9F1239, 0xFF881337, 0xFF4C0519)
            }
        } else if f0 == 99 { // 'c': cyan
            if str_eq(fam, "cyan") {
                col = _tw_pick11(sh, 0xFFECFEFF, 0xFFCFFAFE, 0xFFA5F3FC, 0xFF67E8F9, 0xFF22D3EE, 0xFF06B6D4, 0xFF0891B2, 0xFF0E7490, 0xFF155E75, 0xFF164E63, 0xFF083344)
            }
        } else if f0 == 116 { // 't': teal
            if str_eq(fam, "teal") {
                col = _tw_pick11(sh, 0xFFF0FDFA, 0xFFCCFBF1, 0xFF99F6E4, 0xFF5EEAD4, 0xFF2DD4BF, 0xFF14B8A6, 0xFF0D9488, 0xFF0F766E, 0xFF115E59, 0xFF134E4A, 0xFF042F2E)
            }
        } else if f0 == 118 { // 'v': violet
            if str_eq(fam, "violet") {
                col = _tw_pick11(sh, 0xFFF5F3FF, 0xFFEDE9FE, 0xFFDDD6FE, 0xFFC4B5FD, 0xFFA78BFA, 0xFF8B5CF6, 0xFF7C3AED, 0xFF6D28D9, 0xFF5B21B6, 0xFF4C1D95, 0xFF2E1065)
            }
        } else if f0 == 112 { // 'p': purple, pink
            if str_eq(fam, "purple") {
                col = _tw_pick11(sh, 0xFFFAF5FF, 0xFFF3E8FF, 0xFFE9D5FF, 0xFFD8B4FE, 0xFFC084FC, 0xFFA855F7, 0xFF9333EA, 0xFF7E22CE, 0xFF6B21A8, 0xFF581C87, 0xFF3B0764)
            } else if str_eq(fam, "pink") {
                col = _tw_pick11(sh, 0xFFFDF2F8, 0xFFFCE7F3, 0xFFFBCFE8, 0xFFF9A8D4, 0xFFF472B6, 0xFFEC4899, 0xFFDB2777, 0xFFBE185D, 0xFF9D174D, 0xFF831843, 0xFF500724)
            }
        } else if f0 == 97 { // 'a': amber
            if str_eq(fam, "amber") {
                col = _tw_pick11(sh, 0xFFFFFBEB, 0xFFFEF3C7, 0xFFFDE68A, 0xFFFCD34D, 0xFFFBBF24, 0xFFF59E0B, 0xFFD97706, 0xFFB45309, 0xFF92400E, 0xFF78350F, 0xFF451A03)
            }
        } else if f0 == 111 { // 'o': orange
            if str_eq(fam, "orange") {
                col = _tw_pick11(sh, 0xFFFFF7ED, 0xFFFFEDD5, 0xFFFED7AA, 0xFFFDBA74, 0xFFFB923C, 0xFFF97316, 0xFFEA580C, 0xFFC2410C, 0xFF9A3412, 0xFF7C2D12, 0xFF431407)
            }
        } else if f0 == 121 { // 'y': yellow
            if str_eq(fam, "yellow") {
                col = _tw_pick11(sh, 0xFFFEFCE8, 0xFFFEF9C3, 0xFFFEF08A, 0xFFFDE047, 0xFFFACC15, 0xFFEAB308, 0xFFCA8A04, 0xFFA16207, 0xFF854D0E, 0xFF713F12, 0xFF422006)
            }
        } else if f0 == 108 { // 'l': lime
            if str_eq(fam, "lime") {
                col = _tw_pick11(sh, 0xFFF7FEE7, 0xFFECFCCB, 0xFFD9F99D, 0xFFBEF264, 0xFFA3E635, 0xFF84CC16, 0xFF65A30D, 0xFF4D7C0F, 0xFF3F6212, 0xFF365314, 0xFF1A2E05)
            }
        } else if f0 == 102 { // 'f': fuchsia
            if str_eq(fam, "fuchsia") {
                col = _tw_pick11(sh, 0xFFFDF4FF, 0xFFFAE8FF, 0xFFF5D0FE, 0xFFF0ABFC, 0xFFE879F9, 0xFFD946EF, 0xFFC026D3, 0xFFA21CAF, 0xFF86198F, 0xFF701A75, 0xFF4A044E)
            }
        }
    }

    if col == 0 { return 0 }
    if has_alpha_mod {
        return (alpha_255 << 24) | (col & 0x00FFFFFF)
    }
    return col
}

fn _tw_parse_grad_dir(suffix: str) -> i64 {
    if str_eq(suffix, "r") { return 1 }
    if str_eq(suffix, "b") { return 2 }
    if str_eq(suffix, "br") { return 3 }
    if str_eq(suffix, "l") { return 4 }
    if str_eq(suffix, "t") { return 5 }
    if str_eq(suffix, "tr") { return 6 }
    if str_eq(suffix, "tl") { return 7 }
    if str_eq(suffix, "bl") { return 8 }
    return 0
}

// Applies a single Tailwind v3/v4 or Bootstrap utility token to ComputedStyle
fn tw_apply_token(mut style: ComputedStyle, token: str, vw: i64 = 1280) {
    mut t := str_trim(token)
    mut n := str_len(t)
    if n == 0 { return }

    // O(1) fast-path: ~90% of Tailwind tokens have no `:` variant prefix -> skip all 13 prefix checks!
    if str_find_byte(t, 58, 0) >= 0 {
        eff_vw := if vw > 0 { vw } else { 1280 }
        mut pref_steps := 0
        while pref_steps < 4 {
            tn := str_len(t)
            if tn == 0 { return }
            if str_find_byte(t, 58, 0) < 0 { break }
            if str_starts_with(t, "dark:") and tn > 5 {
                t = str_slice(t, 5, tn)
                pref_steps += 1
                continue
            }
            mut req_min := -1
            mut req_max := 999999
            mut skip_len := 0
            if str_starts_with(t, "sm:") and tn > 3 { req_min = 640; skip_len = 3 }
            else if str_starts_with(t, "md:") and tn > 3 { req_min = 768; skip_len = 3 }
            else if str_starts_with(t, "lg:") and tn > 3 { req_min = 1024; skip_len = 3 }
            else if str_starts_with(t, "xl:") and tn > 3 { req_min = 1280; skip_len = 3 }
            else if str_starts_with(t, "2xl:") and tn > 4 { req_min = 1536; skip_len = 4 }
            else if str_starts_with(t, "max-sm:") and tn > 7 { req_min = 0; req_max = 639; skip_len = 7 }
            else if str_starts_with(t, "max-md:") and tn > 7 { req_min = 0; req_max = 767; skip_len = 7 }
            else if str_starts_with(t, "max-lg:") and tn > 7 { req_min = 0; req_max = 1023; skip_len = 7 }
            else if str_starts_with(t, "max-xl:") and tn > 7 { req_min = 0; req_max = 1279; skip_len = 7 }
            if skip_len > 0 {
                if eff_vw < req_min or eff_vw > req_max { return }
                t = str_slice(t, skip_len, tn)
                pref_steps += 1
                continue
            }
            break
        }
        n = str_len(t)
        if n == 0 { return }

        // Interactive `hover:*`, `focus:*`, `active:*` modifiers
        if str_starts_with(t, "hover:") and n > 6 {
            inner := str_slice(t, 6, n)
            in_n := str_len(inner)
            if str_starts_with(inner, "bg-") {
                c := _tw_color(str_slice(inner, 3, in_n))
                if c != 0 { style.hover_bg = c; style.has_hover = true }
            } else if str_starts_with(inner, "border-") {
                c := _tw_color(str_slice(inner, 7, in_n))
                if c != 0 { style.hover_border = c; style.has_hover = true }
            } else if str_starts_with(inner, "text-") {
                c := _tw_color(str_slice(inner, 5, in_n))
                if c != 0 { style.hover_text = c; style.has_hover = true }
            } else if str_starts_with(inner, "opacity-") {
                op := css_parse_px(str_slice(inner, 8, in_n))
                if op >= 0 and op <= 100 { style.hover_opacity = op; style.has_hover = true }
            } else if str_starts_with(inner, "shadow") {
                if str_eq(inner, "shadow-sm") { style.hover_shadow = 1; style.has_hover = true }
                else if str_eq(inner, "shadow") or str_eq(inner, "shadow-md") { style.hover_shadow = 2; style.has_hover = true }
                else if str_eq(inner, "shadow-lg") { style.hover_shadow = 3; style.has_hover = true }
                else if str_eq(inner, "shadow-xl") { style.hover_shadow = 4; style.has_hover = true }
                else if str_eq(inner, "shadow-2xl") { style.hover_shadow = 5; style.has_hover = true }
            }
            return
        }
        if str_starts_with(t, "focus:") and n > 6 {
            inner := str_slice(t, 6, n)
            in_n := str_len(inner)
            if str_starts_with(inner, "border-") or str_starts_with(inner, "ring-") {
                off := if str_starts_with(inner, "border-") { 7 } else { 5 }
                c := _tw_color(str_slice(inner, off, in_n))
                if c != 0 { style.focus_border = c }
            } else if str_starts_with(inner, "bg-") {
                c := _tw_color(str_slice(inner, 3, in_n))
                if c != 0 { style.focus_bg = c }
            }
            return
        }
        if str_starts_with(t, "active:") and n > 7 {
            inner := str_slice(t, 7, n)
            if str_starts_with(inner, "bg-") {
                c := _tw_color(str_slice(inner, 3, str_len(inner)))
                if c != 0 { style.active_bg = c }
            }
            return
        }
    }

    c0 := str_byte(t, 0)

    if c0 == 112 { // 'p' -> Asymmetric Padding (`p-*`, `px-*`, `py-*`, `pt-*`, `pb-*`, `pl-*`, `pr-*`)
        if str_starts_with(t, "p-") {
            px := _tw_spacing_px(str_slice(t, 2, n))
            if px >= 0 { style_set_pad_side(mut style, 0, px) }
        } else if str_starts_with(t, "px-") {
            px := _tw_spacing_px(str_slice(t, 3, n))
            if px >= 0 { style_set_pad_side(mut style, 5, px) }
        } else if str_starts_with(t, "py-") {
            px := _tw_spacing_px(str_slice(t, 3, n))
            if px >= 0 { style_set_pad_side(mut style, 6, px) }
        } else if str_starts_with(t, "pt-") {
            px := _tw_spacing_px(str_slice(t, 3, n))
            if px >= 0 { style_set_pad_side(mut style, 1, px) }
        } else if str_starts_with(t, "pb-") {
            px := _tw_spacing_px(str_slice(t, 3, n))
            if px >= 0 { style_set_pad_side(mut style, 3, px) }
        } else if str_starts_with(t, "pl-") {
            px := _tw_spacing_px(str_slice(t, 3, n))
            if px >= 0 { style_set_pad_side(mut style, 4, px) }
        } else if str_starts_with(t, "pr-") {
            px := _tw_spacing_px(str_slice(t, 3, n))
            if px >= 0 { style_set_pad_side(mut style, 2, px) }
        }
        return
    }

    if c0 == 98 { // 'b' -> bg-*, backdrop-blur-*, border*, btn*, badge, block, bottom-*
        if str_starts_with(t, "bg-gradient-to-") {
            d := _tw_parse_grad_dir(str_slice(t, 15, n))
            if d > 0 { style.grad_dir = d }
            return
        }
        if str_starts_with(t, "bg-linear-to-") {
            d := _tw_parse_grad_dir(str_slice(t, 13, n))
            if d > 0 { style.grad_dir = d }
            return
        }
        if str_eq(t, "bg-radial") { style.grad_dir = 9; return }
        if str_eq(t, "bg-clip-text") { style.bg_clip_text = true; return }
        if str_starts_with(t, "backdrop-blur") {
            if str_eq(t, "backdrop-blur-none") { style.glass_blur = 0 }
            else if str_eq(t, "backdrop-blur-xs") or str_eq(t, "backdrop-blur-sm") { style.glass_blur = 1 }
            else if str_eq(t, "backdrop-blur") or str_eq(t, "backdrop-blur-md") { style.glass_blur = 2 }
            else if str_eq(t, "backdrop-blur-lg") { style.glass_blur = 3 }
            else if str_eq(t, "backdrop-blur-xl") { style.glass_blur = 4 }
            else if str_eq(t, "backdrop-blur-2xl") or str_eq(t, "backdrop-blur-3xl") { style.glass_blur = 5 }
            return
        }
        if str_starts_with(t, "bg-") {
            rest := str_slice(t, 3, n)
            if str_eq(rest, "transparent") { style.bg_color = 0; return }
            c := _tw_color(rest)
            if c != 0 { style.bg_color = c }
            return
        }
        if str_starts_with(t, "btn") {
            if str_eq(t, "btn") {
                style.padding_x = 24; style.padding_y = 14; style.border_radius = 8; style.border_width = 1
                if style.bg_color == 0 { style.bg_color = 0xFF0D6EFD }
                if style.border_color == 0 { style.border_color = style.bg_color }
                style.text_color = 0xFFFFFFFF
            }
            else if str_eq(t, "btn-primary")   { style.bg_color = 0xFF2563EB; style.border_color = 0xFF3B82F6; style.text_color = 0xFFFFFFFF }
            else if str_eq(t, "btn-secondary") { style.bg_color = 0xFF475569; style.border_color = 0xFF64748B; style.text_color = 0xFFFFFFFF }
            else if str_eq(t, "btn-success")   { style.bg_color = 0xFF059669; style.border_color = 0xFF10B981; style.text_color = 0xFFFFFFFF }
            else if str_eq(t, "btn-danger")    { style.bg_color = 0xFFDC2626; style.border_color = 0xFFEF4444; style.text_color = 0xFFFFFFFF }
            else if str_eq(t, "btn-warning")   { style.bg_color = 0xFFF59E0B; style.border_color = 0xFFFBBF24; style.text_color = 0xFF000000 }
