// Axon Standard Library: Tailwind CSS v3/v4 & Bootstrap 5 Native Utility Engine (`std/ui_tailwind.ax`)
// High-speed zero-CEF styling: O(1) prefix-dispatched Tailwind & Bootstrap class parser with
// full palette, arbitrary `[#HEX]`/`[Npx]` values, gradients, shadows, opacity, and `hover:*`.

use std::os
use std::str
use std::css

fn _tw_parse_bracket_px(s: str) -> i64 {
    n := str_len(s)
    if n < 3 or str_byte(s, 0) != 91 or str_byte(s, n - 1) != 93 { return -1 } // '[...]'
    return css_parse_px(str_slice(s, 1, n - 1))
}

fn _tw_spacing_px(val: str) -> i64 {
    if str_len(val) == 0 { return -1 }
    if str_byte(val, 0) == 91 { return _tw_parse_bracket_px(val) }
    if str_eq(val, "0") { return 0 }
    if str_eq(val, "0.5") { return 2 }
    if str_eq(val, "1") { return 4 }
    if str_eq(val, "1.5") { return 6 }
    if str_eq(val, "2") { return 8 }
    if str_eq(val, "2.5") { return 10 }
    if str_eq(val, "3") { return 12 }
    if str_eq(val, "3.5") { return 14 }
    if str_eq(val, "4") { return 16 }
    if str_eq(val, "5") { return 20 }
    if str_eq(val, "6") { return 24 }
    if str_eq(val, "7") { return 28 }
    if str_eq(val, "8") { return 32 }
    if str_eq(val, "9") { return 36 }
    if str_eq(val, "10") { return 40 }
    if str_eq(val, "11") { return 44 }
    if str_eq(val, "12") { return 48 }
    if str_eq(val, "14") { return 56 }
    if str_eq(val, "16") { return 64 }
    if str_eq(val, "20") { return 80 }
    if str_eq(val, "24") { return 96 }
    if str_eq(val, "28") { return 112 }
    if str_eq(val, "32") { return 128 }
    if str_eq(val, "36") { return 144 }
    if str_eq(val, "40") { return 160 }
    if str_eq(val, "44") { return 176 }
    if str_eq(val, "48") { return 192 }
    if str_eq(val, "52") { return 208 }
    if str_eq(val, "56") { return 224 }
    if str_eq(val, "60") { return 240 }
    if str_eq(val, "64") { return 256 }
    if str_eq(val, "72") { return 288 }
    if str_eq(val, "80") { return 320 }
    if str_eq(val, "96") { return 384 }
    return -1
}

// Unified Tailwind color resolver (supports full palette + `[#RRGGBB]` arbitrary hex + `color/opacity`)
fn _tw_color(raw: str) -> i64 {
    n := str_len(raw)
    if n == 0 { return 0 }
    // Arbitrary hex `[#111115]`
    if str_byte(raw, 0) == 91 and str_byte(raw, n - 1) == 93 {
        return css_parse_color(str_slice(raw, 1, n - 1))
    }
    // Optional Tailwind opacity modifier `zinc-900/80`
    slash := str_find_byte(raw, 47, 0)
    mut name := raw
    mut alpha_pct := 100
    if slash > 0 and slash + 1 < n {
        name = str_slice(raw, 0, slash)
        ap := css_parse_px(str_slice(raw, slash + 1, n))
        if ap >= 0 and ap <= 100 { alpha_pct = ap }
    }

    mut col := 0
    if str_eq(name, "transparent") { return 0 }
    else if str_eq(name, "white") { col = 0xFFFFFFFF }
    else if str_eq(name, "black") { col = 0xFF000000 }
    else if str_eq(name, "primary") { col = 0xFF0D6EFD }
    // Zinc / Neutral / Gray / Slate (Modern Dark & Light UI neutrals)
    else if str_eq(name, "zinc-950") or str_eq(name, "neutral-950") { col = 0xFF09090B }
    else if str_eq(name, "zinc-900") or str_eq(name, "neutral-900") { col = 0xFF18181B }
    else if str_eq(name, "zinc-800") or str_eq(name, "neutral-800") { col = 0xFF27272A }
    else if str_eq(name, "zinc-700") or str_eq(name, "neutral-700") { col = 0xFF3F3F46 }
    else if str_eq(name, "zinc-600") or str_eq(name, "neutral-600") { col = 0xFF52525B }
    else if str_eq(name, "zinc-500") or str_eq(name, "neutral-500") { col = 0xFF71717A }
    else if str_eq(name, "zinc-400") or str_eq(name, "neutral-400") { col = 0xFFA1A1AA }
    else if str_eq(name, "zinc-300") or str_eq(name, "neutral-300") { col = 0xFFD4D4D8 }
    else if str_eq(name, "zinc-200") or str_eq(name, "neutral-200") { col = 0xFFE4E4E7 }
    else if str_eq(name, "zinc-100") or str_eq(name, "neutral-100") { col = 0xFFF4F4F5 }
    else if str_eq(name, "slate-950") { col = 0xFF020617 }
    else if str_eq(name, "slate-900") { col = 0xFF0F172A }
    else if str_eq(name, "slate-800") { col = 0xFF1E293B }
    else if str_eq(name, "slate-700") { col = 0xFF334155 }
    else if str_eq(name, "slate-600") { col = 0xFF475569 }
    else if str_eq(name, "slate-500") { col = 0xFF64748B }
    else if str_eq(name, "slate-400") { col = 0xFF94A3B8 }
    else if str_eq(name, "slate-300") { col = 0xFFCBD5E1 }
    else if str_eq(name, "slate-200") { col = 0xFFE2E8F0 }
    else if str_eq(name, "slate-100") { col = 0xFFF1F5F9 }
    else if str_eq(name, "slate-50")  { col = 0xFFF8FAFC }
    else if str_eq(name, "gray-950")  { col = 0xFF030712 }
    else if str_eq(name, "gray-900")  { col = 0xFF111827 }
    else if str_eq(name, "gray-800")  { col = 0xFF1F2937 }
    else if str_eq(name, "gray-700")  { col = 0xFF374151 }
    else if str_eq(name, "gray-600")  { col = 0xFF4B5563 }
    else if str_eq(name, "gray-500")  { col = 0xFF6B7280 }
    else if str_eq(name, "gray-400")  { col = 0xFF9CA3AF }
    else if str_eq(name, "gray-300")  { col = 0xFFD1D5DB }
    else if str_eq(name, "gray-200")  { col = 0xFFE5E7EB }
    else if str_eq(name, "gray-100")  { col = 0xFFF3F4F6 }
    // Blues, Sky, Cyan, Teal
    else if str_eq(name, "blue-950")  { col = 0xFF172554 }
    else if str_eq(name, "blue-900")  { col = 0xFF1E3A8A }
    else if str_eq(name, "blue-700")  { col = 0xFF1D4ED8 }
    else if str_eq(name, "blue-600")  { col = 0xFF2563EB }
    else if str_eq(name, "blue-500")  { col = 0xFF3B82F6 }
    else if str_eq(name, "blue-400")  { col = 0xFF60A5FA }
    else if str_eq(name, "blue-300")  { col = 0xFF93C5FD }
    else if str_eq(name, "sky-600")   { col = 0xFF0284C7 }
    else if str_eq(name, "sky-500")   { col = 0xFF0EA5E9 }
    else if str_eq(name, "sky-400")   { col = 0xFF38BDF8 }
    else if str_eq(name, "cyan-950")  { col = 0xFF083344 }
    else if str_eq(name, "cyan-600")  { col = 0xFF0891B2 }
    else if str_eq(name, "cyan-500")  { col = 0xFF06B6D4 }
    else if str_eq(name, "cyan-400")  { col = 0xFF22D3EE }
    else if str_eq(name, "cyan-300")  { col = 0xFF67E8F9 }
    else if str_eq(name, "teal-950")  { col = 0xFF042F2E }
    else if str_eq(name, "teal-900")  { col = 0xFF134E4A }
    else if str_eq(name, "teal-800")  { col = 0xFF115E59 }
    else if str_eq(name, "teal-600")  { col = 0xFF0D9488 }
    else if str_eq(name, "teal-500")  { col = 0xFF14B8A6 }
    else if str_eq(name, "teal-400")  { col = 0xFF2DD4BF }
    else if str_eq(name, "teal-300")  { col = 0xFF5EEAD4 }
    else if str_eq(name, "teal-200")  { col = 0xFF99F6E4 }
    // Emerald, Green, Indigo, Violet, Purple, Pink, Rose, Red, Amber, Orange
    else if str_eq(name, "emerald-950") { col = 0xFF022C22 }
    else if str_eq(name, "emerald-600") or str_eq(name, "green-600") { col = 0xFF059669 }
    else if str_eq(name, "emerald-500") or str_eq(name, "green-500") { col = 0xFF10B981 }
    else if str_eq(name, "emerald-400") or str_eq(name, "green-400") { col = 0xFF34D399 }
    else if str_eq(name, "indigo-950")  { col = 0xFF1E1B4B }
    else if str_eq(name, "indigo-700")  { col = 0xFF4338CA }
    else if str_eq(name, "indigo-600")  { col = 0xFF4F46E5 }
    else if str_eq(name, "indigo-500")  { col = 0xFF6366F1 }
    else if str_eq(name, "indigo-400")  { col = 0xFF818CF8 }
    else if str_eq(name, "violet-600")  { col = 0xFF7C3AED }
    else if str_eq(name, "violet-500")  { col = 0xFF8B5CF6 }
    else if str_eq(name, "violet-400")  { col = 0xFFA78BFA }
    else if str_eq(name, "purple-600")  { col = 0xFF9333EA }
    else if str_eq(name, "purple-500")  { col = 0xFFA855F7 }
    else if str_eq(name, "purple-400")  { col = 0xFFC084FC }
    else if str_eq(name, "pink-600")    { col = 0xFFDB2777 }
    else if str_eq(name, "pink-500")    { col = 0xFFEC4899 }
    else if str_eq(name, "pink-400")    { col = 0xFFF472B6 }
    else if str_eq(name, "rose-600")    { col = 0xFFE11D48 }
    else if str_eq(name, "rose-500")    { col = 0xFFF43F5E }
    else if str_eq(name, "rose-400")    { col = 0xFFFB7185 }
    else if str_eq(name, "red-950")     { col = 0xFF450A0A }
    else if str_eq(name, "red-600")     { col = 0xFFDC2626 }
    else if str_eq(name, "red-500")     { col = 0xFFEF4444 }
    else if str_eq(name, "red-400")     { col = 0xFFF87171 }
    else if str_eq(name, "orange-500")  { col = 0xFFF97316 }
    else if str_eq(name, "orange-400")  { col = 0xFFFB923C }
    else if str_eq(name, "amber-600")   { col = 0xFFD97706 }
    else if str_eq(name, "amber-500")   { col = 0xFFF59E0B }
    else if str_eq(name, "amber-400")   { col = 0xFFFBBF24 }
    else if str_eq(name, "amber-300")   { col = 0xFFFCD34D }
    else if str_eq(name, "yellow-400")  { col = 0xFFFACC15 }
    else { return 0 }

    if alpha_pct < 100 {
        a := (alpha_pct * 255) / 100
        return (a << 24) | (col & 0x00FFFFFF)
    }
    return col
}

// Applies a single Tailwind or Bootstrap utility token to ComputedStyle (O(1) first-byte dispatch!)
fn tw_apply_token(mut style: ComputedStyle, token: str) {
    t := str_trim(token)
    n := str_len(t)
    if n == 0 { return }

    // Interactive `hover:*` modifier (`hover:bg-*`, `hover:border-*`, `hover:text-*`)
    if str_starts_with(t, "hover:") and n > 6 {
        inner := str_slice(t, 6, n)
        if str_starts_with(inner, "bg-") {
            c := _tw_color(str_slice(inner, 3, str_len(inner)))
            if c != 0 { style.hover_bg = c }
        } else if str_starts_with(inner, "border-") {
            c := _tw_color(str_slice(inner, 7, str_len(inner)))
            if c != 0 { style.hover_border = c }
        } else if str_starts_with(inner, "text-") {
            c := _tw_color(str_slice(inner, 5, str_len(inner)))
            if c != 0 { style.hover_text = c }
        }
        return
    }

    c0 := str_byte(t, 0)

    if c0 == 112 { // 'p' -> Padding (`p-*`, `px-*`, `py-*`, `pt-*`, `pb-*`, `pl-*`, `pr-*`)
        if str_starts_with(t, "p-") {
            px := _tw_spacing_px(str_slice(t, 2, n))
            if px >= 0 { style.padding_x = px * 2; style.padding_y = px * 2 }
        } else if str_starts_with(t, "px-") {
            px := _tw_spacing_px(str_slice(t, 3, n))
            if px >= 0 { style.padding_x = px * 2 }
        } else if str_starts_with(t, "py-") {
            px := _tw_spacing_px(str_slice(t, 3, n))
            if px >= 0 { style.padding_y = px * 2 }
        } else if str_starts_with(t, "pt-") or str_starts_with(t, "pb-") {
            px := _tw_spacing_px(str_slice(t, 3, n))
            if px >= 0 { style.padding_y = px * 2 }
        } else if str_starts_with(t, "pl-") or str_starts_with(t, "pr-") {
            px := _tw_spacing_px(str_slice(t, 3, n))
            if px >= 0 { style.padding_x = px * 2 }
        }
        return
    }

    if c0 == 98 { // 'b' -> bg-*, border*, btn*, badge, block
        if str_starts_with(t, "bg-gradient-to-") {
            if str_eq(t, "bg-gradient-to-r") { style.grad_dir = 1 }
            else if str_eq(t, "bg-gradient-to-b") { style.grad_dir = 2 }
            else if str_eq(t, "bg-gradient-to-br") { style.grad_dir = 3 }
            return
        }
        if str_starts_with(t, "bg-") {
            rest := str_slice(t, 3, n)
            if str_eq(rest, "transparent") { style.bg_color = 0; return }
            c := _tw_color(rest)
            if c != 0 { style.bg_color = c }
            return
        }
        if str_starts_with(t, "btn") {
            if str_eq(t, "btn") {
                style.padding_x = 24; style.padding_y = 14; style.border_radius = 8; style.border_width = 1
                if style.bg_color == 0 { style.bg_color = 0xFF0D6EFD }
                if style.border_color == 0 { style.border_color = style.bg_color }
                style.text_color = 0xFFFFFFFF
            }
            else if str_eq(t, "btn-primary")   { style.bg_color = 0xFF2563EB; style.border_color = 0xFF3B82F6; style.text_color = 0xFFFFFFFF }
            else if str_eq(t, "btn-secondary") { style.bg_color = 0xFF475569; style.border_color = 0xFF64748B; style.text_color = 0xFFFFFFFF }
            else if str_eq(t, "btn-success")   { style.bg_color = 0xFF059669; style.border_color = 0xFF10B981; style.text_color = 0xFFFFFFFF }
            else if str_eq(t, "btn-danger")    { style.bg_color = 0xFFDC2626; style.border_color = 0xFFEF4444; style.text_color = 0xFFFFFFFF }
            else if str_eq(t, "btn-warning")   { style.bg_color = 0xFFF59E0B; style.border_color = 0xFFFBBF24; style.text_color = 0xFF000000 }
            else if str_eq(t, "btn-info")      { style.bg_color = 0xFF0891B2; style.border_color = 0xFF06B6D4; style.text_color = 0xFFFFFFFF }
            else if str_eq(t, "btn-dark")      { style.bg_color = 0xFF334155; style.border_color = 0xFF475569; style.text_color = 0xFFF1F5F9 }
            else if str_eq(t, "btn-light")     { style.bg_color = 0xFFF8F9FA; style.border_color = 0xFFE2E8F0; style.text_color = 0xFF0F172A }
            return
        }
        if str_starts_with(t, "border") {
            if str_eq(t, "border") { style.border_width = 1; if style.border_color == 0 { style.border_color = 0xFF272730 } }
            else if str_eq(t, "border-0") { style.border_width = 0 }
            else if str_eq(t, "border-2") { style.border_width = 2; if style.border_color == 0 { style.border_color = 0xFF272730 } }
            else if str_eq(t, "border-4") { style.border_width = 4; if style.border_color == 0 { style.border_color = 0xFF272730 } }
            else if str_starts_with(t, "border-") {
                c := _tw_color(str_slice(t, 7, n))
                if c != 0 {
                    style.border_color = c
                    if style.border_width == 0 { style.border_width = 1 }
                }
            }
            return
        }
        if str_eq(t, "badge") {
            style.padding_x = 14; style.padding_y = 6; style.border_radius = 9999
            if style.bg_color == 0 { style.bg_color = 0xFF0D6EFD }
            style.text_color = 0xFFFFFFFF
        } else if str_eq(t, "block") {
            style.display = 0
        }
        return
    }

    if c0 == 116 { // 't' -> text-*, to-*
        if str_starts_with(t, "to-") {
            c := _tw_color(str_slice(t, 3, n))
            if c != 0 { style.grad_to = c }
            return
        }
        if str_eq(t, "text-center") { style.text_align = 1; return }
        if str_eq(t, "text-right") or str_eq(t, "text-end") { style.text_align = 2; return }
        if str_eq(t, "text-left") or str_eq(t, "text-start") { style.text_align = 0; return }
        if str_eq(t, "text-xs")   { style.font_size = 12; return }
        if str_eq(t, "text-sm")   { style.font_size = 13; return }
        if str_eq(t, "text-base") { style.font_size = 15; return }
        if str_eq(t, "text-lg")   { style.font_size = 18; return }
        if str_eq(t, "text-xl")   { style.font_size = 20; return }
        if str_eq(t, "text-2xl")  { style.font_size = 24; return }
        if str_eq(t, "text-3xl")  { style.font_size = 30; return }
        if str_eq(t, "text-4xl")  { style.font_size = 36; return }
        if str_starts_with(t, "text-") {
            rest := str_slice(t, 5, n)
            if str_len(rest) > 2 and str_byte(rest, 0) == 91 and str_byte(rest, 1) != 35 {
                fs := _tw_parse_bracket_px(rest)
                if fs > 0 { style.font_size = fs; return }
            }
            c := _tw_color(rest)
            if c != 0 { style.text_color = c }
        }
        return
    }

    if c0 == 102 { // 'f' -> flex*, font-*, from-*
        if str_starts_with(t, "from-") {
            c := _tw_color(str_slice(t, 5, n))
            if c != 0 { style.grad_from = c }
            return
        }
        if str_eq(t, "font-light") { style.font_weight = 300 }
        else if str_eq(t, "font-normal") { style.font_weight = 400 }
        else if str_eq(t, "font-medium") { style.font_weight = 500 }
        else if str_eq(t, "font-semibold") { style.font_weight = 600 }
        else if str_eq(t, "font-bold") { style.font_weight = 700 }
        else if str_eq(t, "font-extrabold") { style.font_weight = 800 }
        else if str_eq(t, "font-mono") { style.font_mono = true }
        else if str_eq(t, "flex") { style.display = 1 }
        else if str_eq(t, "flex-1") or str_eq(t, "flex-grow") { style.width = -2; style.flex_grow = 1 }
        else if str_eq(t, "flex-col") or str_eq(t, "flex-column") { style.flex_direction = 1 }
        else if str_eq(t, "flex-row") { style.flex_direction = 0 }
        else if str_eq(t, "flex-wrap") { style.flex_wrap = true }
        else if str_eq(t, "flex-nowrap") { style.flex_wrap = false }
        return
    }

    if c0 == 114 { // 'r' -> rounded*
        if str_eq(t, "rounded-lg")   { style.border_radius = 8 }
        else if str_eq(t, "rounded-xl")   { style.border_radius = 12 }
        else if str_eq(t, "rounded")      { style.border_radius = 4 }
        else if str_eq(t, "rounded-md")   { style.border_radius = 6 }
        else if str_eq(t, "rounded-2xl")  { style.border_radius = 16 }
        else if str_eq(t, "rounded-3xl")  { style.border_radius = 24 }
        else if str_eq(t, "rounded-sm")   { style.border_radius = 2 }
        else if str_eq(t, "rounded-none") { style.border_radius = 0 }
        else if str_eq(t, "rounded-full") { style.border_radius = 9999 }
        else if str_starts_with(t, "rounded-[") {
            rr := _tw_parse_bracket_px(str_slice(t, 8, n))
            if rr >= 0 { style.border_radius = rr }
        }
        return
    }

    if c0 == 115 { // 's' -> shadow*, space-y-*
        if str_eq(t, "shadow-none") { style.shadow = 0 }
        else if str_eq(t, "shadow-sm") { style.shadow = 1 }
        else if str_eq(t, "shadow") or str_eq(t, "shadow-md") { style.shadow = 2 }
        else if str_eq(t, "shadow-lg") { style.shadow = 3 }
        else if str_eq(t, "shadow-xl") { style.shadow = 4 }
        else if str_eq(t, "shadow-2xl") { style.shadow = 5 }
        else if str_starts_with(t, "space-y-") or str_starts_with(t, "space-x-") {
            g := _tw_spacing_px(str_slice(t, 8, n))
            if g >= 0 { style.gap = g }
        }
        return
    }

    if c0 == 111 { // 'o' -> opacity-*, overflow-hidden
        if str_eq(t, "overflow-hidden") { style.overflow_hidden = true }
        else if str_starts_with(t, "opacity-") {
            op := css_parse_px(str_slice(t, 8, n))
            if op >= 0 and op <= 100 { style.opacity = op }
        }
        return
    }

    if c0 == 109 { // 'm' -> margin, mx-auto, max-w-*, min-h-screen
        if str_eq(t, "mx-auto") or str_eq(t, "m-auto") { style.margin_auto = true; return }
        if str_eq(t, "min-h-screen") or str_eq(t, "min-h-full") { style.height = -100; return }
        if str_starts_with(t, "max-w-") {
            rest := str_slice(t, 6, n)
            if str_eq(rest, "sm") { style.max_width = 384 }
            else if str_eq(rest, "md") { style.max_width = 448 }
            else if str_eq(rest, "lg") { style.max_width = 512 }
            else if str_eq(rest, "xl") { style.max_width = 576 }
            else if str_eq(rest, "2xl") { style.max_width = 672 }
            else if str_eq(rest, "3xl") { style.max_width = 768 }
            else if str_eq(rest, "4xl") { style.max_width = 896 }
            else if str_eq(rest, "5xl") { style.max_width = 1024 }
            else {
                mw := _tw_parse_bracket_px(rest)
                if mw > 0 { style.max_width = mw }
            }
            return
        }
        if str_starts_with(t, "m-") {
            px := _tw_spacing_px(str_slice(t, 2, n))
            if px >= 0 { style.margin_x = px * 2; style.margin_y = px * 2 }
        } else if str_starts_with(t, "mx-") or str_starts_with(t, "ml-") or str_starts_with(t, "mr-") {
            px := _tw_spacing_px(str_slice(t, 3, n))
            if px >= 0 { style.margin_x = px * 2 }
        } else if str_starts_with(t, "my-") or str_starts_with(t, "mt-") or str_starts_with(t, "mb-") {
            px := _tw_spacing_px(str_slice(t, 3, n))
            if px >= 0 { style.margin_y = px * 2 }
        }
        return
    }

    if c0 == 99 { // 'c' -> card*
        if str_eq(t, "card") {
            if style.bg_color == 0 { style.bg_color = 0xFF18181D }
            style.border_radius = 10; style.border_width = 1; style.border_color = 0xFF272730
        } else if str_eq(t, "card-body") {
            style.padding_x = 32; style.padding_y = 32
        }
        return
    }

    if c0 == 103 { // 'g' -> gap-*, grid, grid-cols-*, grow
        if str_eq(t, "grid") {
            style.display = 4
            if style.grid_cols <= 0 { style.grid_cols = 1 }
        } else if str_eq(t, "grow") {
            style.flex_grow = 1
        } else if str_starts_with(t, "grid-cols-") {
            nc := css_parse_px(str_slice(t, 10, n))
            if nc >= 1 and nc <= 12 {
                style.display = 4
                style.grid_cols = nc
            }
        } else if str_starts_with(t, "gap-") {
            g := _tw_spacing_px(str_slice(t, 4, n))
            if g >= 0 { style.gap = g }
        }
        return
    }

    if c0 == 106 { // 'j' -> justify-*
        if str_eq(t, "justify-between") or str_eq(t, "justify-content-between") { style.justify_content = 3 }
        else if str_eq(t, "justify-center") or str_eq(t, "justify-content-center") { style.justify_content = 1 }
        else if str_eq(t, "justify-start") or str_eq(t, "justify-content-start") { style.justify_content = 0 }
        else if str_eq(t, "justify-end") or str_eq(t, "justify-content-end") { style.justify_content = 2 }
        else if str_eq(t, "justify-around") or str_eq(t, "justify-content-around") { style.justify_content = 4 }
        return
    }

    if c0 == 105 { // 'i' -> items-*, inline
        if str_eq(t, "items-center") { style.align_items = 1 }
        else if str_eq(t, "items-start") { style.align_items = 2 }
        else if str_eq(t, "items-end") { style.align_items = 3 }
        else if str_eq(t, "items-stretch") { style.align_items = 0 }
        else if str_eq(t, "inline") or str_eq(t, "inline-block") { style.display = 2 }
        return
    }

    if c0 == 119 { // 'w' -> w-*
        if str_eq(t, "w-full") or str_eq(t, "w-screen") { style.width = -1 }
        else if str_eq(t, "w-auto") or str_eq(t, "w-fit") { style.width = -3 }
        else if str_eq(t, "w-1/3") { style.width = -1033 }
        else if str_eq(t, "w-2/3") { style.width = -1067 }
        else if str_eq(t, "w-1/2") { style.width = -1050 }
        else if str_eq(t, "w-1/4") { style.width = -1025 }
        else if str_eq(t, "w-3/4") { style.width = -1075 }
        else if str_starts_with(t, "w-") {
            wp := _tw_spacing_px(str_slice(t, 2, n))
            if wp > 0 { style.width = wp }
        }
        return
    }

    if c0 == 104 { // 'h' -> h-*, hidden
        if str_eq(t, "hidden") { style.display = 3 }
        else if str_eq(t, "h-full") or str_eq(t, "h-screen") { style.height = -100 }
        else if str_starts_with(t, "h-") {
            hp := _tw_spacing_px(str_slice(t, 2, n))
            if hp > 0 { style.height = hp }
        }
        return
    }

    if c0 == 97 { // 'a' -> align-items-*, alert*
        if str_eq(t, "align-items-center") { style.align_items = 1 }
        else if str_eq(t, "align-items-start") { style.align_items = 2 }
        else if str_eq(t, "align-items-end") { style.align_items = 3 }
        else if str_eq(t, "alert") {
            style.padding_x = 32; style.padding_y = 24; style.border_radius = 8; style.margin_y = 24; style.border_width = 1
        }
        else if str_eq(t, "alert-primary") { style.bg_color = 0xFF084298; style.border_color = 0xFF084298; style.text_color = 0xFFFFFFFF }
        else if str_eq(t, "alert-success") { style.bg_color = 0xFF0F5132; style.border_color = 0xFF0F5132; style.text_color = 0xFFFFFFFF }
        else if str_eq(t, "alert-danger")  { style.bg_color = 0xFF842029; style.border_color = 0xFF842029; style.text_color = 0xFFFFFFFF }
        else if str_eq(t, "alert-warning") { style.bg_color = 0xFF664D03; style.border_color = 0xFF664D03; style.text_color = 0xFFFFFFFF }
        return
    }

    if c0 == 100 { // 'd' -> d-flex, d-none, d-block, d-inline
        if str_eq(t, "d-flex") { style.display = 1 }
        else if str_eq(t, "d-none") { style.display = 3 }
        else if str_eq(t, "d-block") { style.display = 0 }
        else if str_eq(t, "d-inline") { style.display = 2 }
    }
}

// Applies all space-separated Tailwind / Bootstrap classes on a node to ComputedStyle
fn tw_apply_classes(mut style: ComputedStyle, class_str: str) {
    n := str_len(class_str)
    if n == 0 { return }

    mut cur := 0
    while cur < n {
        mut sp := str_find_byte(class_str, 32, cur)
        if sp < 0 { sp = n }
        if sp > cur {
            tw_apply_token(mut style, str_slice(class_str, cur, sp))
        }
        cur = sp + 1
    }
}
