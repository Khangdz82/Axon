// Axon Standard Library: Tailwind CSS & Bootstrap 5 Native Utility Engine (`std/ui_tailwind.ax`)
// High-speed zero-CEF styling: O(1) first-byte prefix-dispatched Tailwind & Bootstrap class parser.

use std::os
use std::str
use std::css

// Applies a single Tailwind or Bootstrap utility token to ComputedStyle (O(1) first-byte dispatch!)
fn tw_apply_token(mut style: ComputedStyle, token: str) {
    t := str_trim(token)
    n := str_len(t)
    if n == 0 { return }
    c0 := str_byte(t, 0)

    if c0 == 112 { // 'p' -> Padding (p-*, px-*, py-*)
        if str_eq(t, "p-4") { style.padding_x = 32; style.padding_y = 32 }
        else if str_eq(t, "p-6") { style.padding_x = 48; style.padding_y = 48 }
        else if str_eq(t, "p-2") { style.padding_x = 16; style.padding_y = 16 }
        else if str_eq(t, "p-3") { style.padding_x = 24; style.padding_y = 24 }
        else if str_eq(t, "p-0") { style.padding_x = 0; style.padding_y = 0 }
        else if str_eq(t, "p-1") { style.padding_x = 8; style.padding_y = 8 }
        else if str_eq(t, "p-5") { style.padding_x = 40; style.padding_y = 40 }
        else if str_eq(t, "p-8") { style.padding_x = 64; style.padding_y = 64 }
        else if str_eq(t, "px-4") { style.padding_x = 32 }
        else if str_eq(t, "px-2") { style.padding_x = 16 }
        else if str_eq(t, "px-3") { style.padding_x = 24 }
        else if str_eq(t, "px-6") { style.padding_x = 48 }
        else if str_eq(t, "px-1") { style.padding_x = 8 }
        else if str_eq(t, "px-8") { style.padding_x = 64 }
        else if str_eq(t, "py-2") { style.padding_y = 16 }
        else if str_eq(t, "py-4") { style.padding_y = 32 }
        else if str_eq(t, "py-1") { style.padding_y = 8 }
        else if str_eq(t, "py-3") { style.padding_y = 24 }
        else if str_eq(t, "py-6") { style.padding_y = 48 }
        return
    }

    if c0 == 98 { // 'b' -> bg-*, border*, btn*, badge, block
        c1 := if n > 1 { str_byte(t, 1) } else { 0 }
        if c1 == 103 { // "bg-*"
            if str_eq(t, "bg-slate-800") { style.bg_color = 0xFF1E293B }
            else if str_eq(t, "bg-slate-900") { style.bg_color = 0xFF0F172A }
            else if str_eq(t, "bg-primary")   { style.bg_color = 0xFF0D6EFD }
            else if str_eq(t, "bg-blue-600")  { style.bg_color = 0xFF2563EB }
            else if str_eq(t, "bg-blue-500")  { style.bg_color = 0xFF3B82F6 }
            else if str_eq(t, "bg-slate-950") { style.bg_color = 0xFF020617 }
            else if str_eq(t, "bg-slate-700") { style.bg_color = 0xFF334155 }
            else if str_eq(t, "bg-slate-600") { style.bg_color = 0xFF475569 }
            else if str_eq(t, "bg-zinc-900")  { style.bg_color = 0xFF18181B }
            else if str_eq(t, "bg-zinc-800")  { style.bg_color = 0xFF27272A }
            else if str_eq(t, "bg-indigo-600"){ style.bg_color = 0xFF4F46E5 }
            else if str_eq(t, "bg-purple-600"){ style.bg_color = 0xFF9333EA }
            else if str_eq(t, "bg-emerald-600") or str_eq(t, "bg-green-600") { style.bg_color = 0xFF059669 }
            else if str_eq(t, "bg-emerald-500") or str_eq(t, "bg-green-500") { style.bg_color = 0xFF10B981 }
            else if str_eq(t, "bg-red-600")   { style.bg_color = 0xFFDC2626 }
            else if str_eq(t, "bg-red-500")   { style.bg_color = 0xFFEF4444 }
            else if str_eq(t, "bg-amber-500") { style.bg_color = 0xFFF59E0B }
            else if str_eq(t, "bg-white")     { style.bg_color = 0xFFFFFFFF }
            else if str_eq(t, "bg-black")     { style.bg_color = 0xFF000000 }
            else if str_eq(t, "bg-cyan-950")  { style.bg_color = 0xFF083344 }
            else if str_eq(t, "bg-teal-950")  { style.bg_color = 0xFF042F2E }
            else if str_eq(t, "bg-teal-900")  { style.bg_color = 0xFF134E4A }
            else if str_eq(t, "bg-transparent"){ style.bg_color = 0 }
            return
        }
        if c1 == 116 { // "btn*"
            if str_eq(t, "btn") {
                style.padding_x = 24; style.padding_y = 14; style.border_radius = 6; style.border_width = 1
                if style.bg_color == 0 { style.bg_color = 0xFF0D6EFD }
                if style.border_color == 0 { style.border_color = style.bg_color }
                style.text_color = 0xFFFFFFFF
            }
            else if str_eq(t, "btn-primary")   { style.bg_color = 0xFF2563EB; style.border_color = 0xFF3B82F6; style.text_color = 0xFFFFFFFF }
            else if str_eq(t, "btn-secondary") { style.bg_color = 0xFF475569; style.border_color = 0xFF64748B; style.text_color = 0xFFFFFFFF }
            else if str_eq(t, "btn-success")   { style.bg_color = 0xFF059669; style.border_color = 0xFF10B981; style.text_color = 0xFFFFFFFF }
            else if str_eq(t, "btn-danger")    { style.bg_color = 0xFFDC2626; style.border_color = 0xFFEF4444; style.text_color = 0xFFFFFFFF }
            else if str_eq(t, "btn-warning")   { style.bg_color = 0xFFF59E0B; style.border_color = 0xFFFBBF24; style.text_color = 0xFF000000 }
            else if str_eq(t, "btn-info")      { style.bg_color = 0xFF0891B2; style.border_color = 0xFF06B6D4; style.text_color = 0xFFFFFFFF }
            else if str_eq(t, "btn-dark")      { style.bg_color = 0xFF334155; style.border_color = 0xFF475569; style.text_color = 0xFFF1F5F9 }
            else if str_eq(t, "btn-light")     { style.bg_color = 0xFFF8F9FA; style.border_color = 0xFFE2E8F0; style.text_color = 0xFF0F172A }
            return
        }
        if c1 == 111 { // "border*"
            if str_eq(t, "border")   { style.border_width = 1; if style.border_color == 0 { style.border_color = 0xFF334155 } }
            else if str_eq(t, "border-slate-700") { style.border_color = 0xFF334155 }
            else if str_eq(t, "border-slate-800") { style.border_color = 0xFF1E293B }
            else if str_eq(t, "border-slate-600") { style.border_color = 0xFF475569 }
            else if str_eq(t, "border-blue-500")  { style.border_color = 0xFF3B82F6 }
            else if str_eq(t, "border-teal-800")  { style.border_color = 0xFF115E59 }
            else if str_eq(t, "border-teal-500")  { style.border_color = 0xFF14B8A6 }
            else if str_eq(t, "border-2") { style.border_width = 2; if style.border_color == 0 { style.border_color = 0xFF334155 } }
            else if str_eq(t, "border-4") { style.border_width = 4; if style.border_color == 0 { style.border_color = 0xFF334155 } }
            else if str_eq(t, "border-0") { style.border_width = 0 }
            return
        }
        if str_eq(t, "badge") {
            style.padding_x = 12; style.padding_y = 6; style.border_radius = 4
            if style.bg_color == 0 { style.bg_color = 0xFF0D6EFD }
            style.text_color = 0xFFFFFFFF
        } else if str_eq(t, "block") {
            style.display = 0
        }
        return
    }

    if c0 == 116 { // 't' -> text-*
        if str_eq(t, "text-white")     { style.text_color = 0xFFFFFFFF }
        else if str_eq(t, "text-slate-400") { style.text_color = 0xFF94A3B8 }
        else if str_eq(t, "text-slate-500") { style.text_color = 0xFF64748B }
        else if str_eq(t, "text-blue-400")  { style.text_color = 0xFF60A5FA }
        else if str_eq(t, "text-black")     { style.text_color = 0xFF000000 }
        else if str_eq(t, "text-slate-100") { style.text_color = 0xFFF1F5F9 }
        else if str_eq(t, "text-slate-200") { style.text_color = 0xFFE2E8F0 }
        else if str_eq(t, "text-slate-300") { style.text_color = 0xFFCBD5E1 }
        else if str_eq(t, "text-teal-400")  { style.text_color = 0xFF2DD4BF }
        else if str_eq(t, "text-teal-300")  { style.text_color = 0xFF5EEAD4 }
        else if str_eq(t, "text-teal-200")  { style.text_color = 0xFF99F6E4 }
        else if str_eq(t, "text-cyan-400")  { style.text_color = 0xFF22D3EE }
        else if str_eq(t, "text-cyan-300")  { style.text_color = 0xFF67E8F9 }
        else if str_eq(t, "text-emerald-400") or str_eq(t, "text-green-400") { style.text_color = 0xFF34D399 }
        else if str_eq(t, "text-red-400")   { style.text_color = 0xFFF87171 }
        else if str_eq(t, "text-amber-400") { style.text_color = 0xFFFBBF24 }
        else if str_eq(t, "text-amber-300") { style.text_color = 0xFFFCD34D }
        return
    }

    if c0 == 102 { // 'f' -> flex, flex-col, flex-row, flex-1
        if str_eq(t, "flex") { style.display = 1 }
        else if str_eq(t, "flex-1") { style.width = -2 }
        else if str_eq(t, "flex-col") or str_eq(t, "flex-column") { style.flex_direction = 1 }
        else if str_eq(t, "flex-row") { style.flex_direction = 0 }
        return
    }

    if c0 == 114 { // 'r' -> rounded*
        if str_eq(t, "rounded-lg")   { style.border_radius = 8 }
        else if str_eq(t, "rounded-xl")   { style.border_radius = 12 }
        else if str_eq(t, "rounded")      { style.border_radius = 4 }
        else if str_eq(t, "rounded-md")   { style.border_radius = 6 }
        else if str_eq(t, "rounded-2xl")  { style.border_radius = 16 }
        else if str_eq(t, "rounded-sm")   { style.border_radius = 2 }
        else if str_eq(t, "rounded-none") { style.border_radius = 0 }
        else if str_eq(t, "rounded-full") { style.border_radius = 9999 }
        return
    }

    if c0 == 109 { // 'm' -> margin (m-*, my-*, mt-*, mb-*)
        if str_eq(t, "mb-4") or str_eq(t, "my-4") or str_eq(t, "mt-4") { style.margin_y = 32 }
        else if str_eq(t, "my-2") or str_eq(t, "mt-2") or str_eq(t, "mb-2") { style.margin_y = 16 }
        else if str_eq(t, "my-1") or str_eq(t, "mt-1") or str_eq(t, "mb-1") { style.margin_y = 8 }
        else if str_eq(t, "my-3") or str_eq(t, "mt-3") or str_eq(t, "mb-3") { style.margin_y = 24 }
        else if str_eq(t, "my-6") or str_eq(t, "mt-6") or str_eq(t, "mb-6") { style.margin_y = 48 }
        else if str_eq(t, "m-0") { style.margin_x = 0; style.margin_y = 0 }
        else if str_eq(t, "m-1") { style.margin_x = 8; style.margin_y = 8 }
        else if str_eq(t, "m-2") { style.margin_x = 16; style.margin_y = 16 }
        else if str_eq(t, "m-3") { style.margin_x = 24; style.margin_y = 24 }
        else if str_eq(t, "m-4") { style.margin_x = 32; style.margin_y = 32 }
        else if str_eq(t, "m-6") { style.margin_x = 48; style.margin_y = 48 }
        return
    }

    if c0 == 99 { // 'c' -> card*
        if str_eq(t, "card") {
            if style.bg_color == 0 { style.bg_color = 0xFF1E293B }
            style.border_radius = 8; style.border_width = 1; style.border_color = 0xFF334155
        } else if str_eq(t, "card-body") {
            style.padding_x = 32; style.padding_y = 32
        }
        return
    }

    if c0 == 103 { // 'g' -> gap-*
        if str_eq(t, "gap-4") { style.gap = 16 }
        else if str_eq(t, "gap-2") { style.gap = 8 }
        else if str_eq(t, "gap-3") { style.gap = 12 }
        else if str_eq(t, "gap-1") { style.gap = 4 }
        else if str_eq(t, "gap-5") { style.gap = 20 }
        else if str_eq(t, "gap-6") { style.gap = 24 }
        else if str_eq(t, "gap-8") { style.gap = 32 }
        return
    }

    if c0 == 106 { // 'j' -> justify-*
        if str_eq(t, "justify-between") or str_eq(t, "justify-content-between") { style.justify_content = 3 }
        else if str_eq(t, "justify-center") or str_eq(t, "justify-content-center") { style.justify_content = 1 }
        else if str_eq(t, "justify-start") or str_eq(t, "justify-content-start") { style.justify_content = 0 }
        else if str_eq(t, "justify-end") or str_eq(t, "justify-content-end") { style.justify_content = 2 }
        else if str_eq(t, "justify-around") or str_eq(t, "justify-content-around") { style.justify_content = 4 }
        return
    }

    if c0 == 105 { // 'i' -> items-*, inline
        if str_eq(t, "items-center") { style.align_items = 1 }
        else if str_eq(t, "items-start") { style.align_items = 2 }
        else if str_eq(t, "items-end") { style.align_items = 3 }
        else if str_eq(t, "items-stretch") { style.align_items = 0 }
        else if str_eq(t, "inline") { style.display = 2 }
        return
    }

    if c0 == 119 { // 'w' -> w-* (negative <= -1000 encodes percentage width, e.g. -1033 = 33%)
        if str_eq(t, "w-full") { style.width = -1 }
        else if str_eq(t, "w-auto") { style.width = -3 }
        else if str_eq(t, "w-1/3") { style.width = -1033 }
        else if str_eq(t, "w-2/3") { style.width = -1067 }
        else if str_eq(t, "w-1/2") { style.width = -1050 }
        else if str_eq(t, "w-1/4") { style.width = -1025 }
        else if str_eq(t, "w-3/4") { style.width = -1075 }
        else if str_eq(t, "w-32") { style.width = 128 }
        else if str_eq(t, "w-48") { style.width = 192 }
        else if str_eq(t, "w-56") { style.width = 224 }
        else if str_eq(t, "w-64") { style.width = 256 }
        else if str_eq(t, "w-72") { style.width = 288 }
        else if str_eq(t, "w-80") { style.width = 320 }
        else if str_eq(t, "w-96") { style.width = 384 }
        return
    }

    if c0 == 104 { // 'h' -> h-*, hidden
        if str_eq(t, "hidden") { style.display = 3 }
        else if str_eq(t, "h-10") { style.height = 40 }
        else if str_eq(t, "h-12") { style.height = 48 }
        else if str_eq(t, "h-16") { style.height = 64 }
        else if str_eq(t, "h-20") { style.height = 80 }
        else if str_eq(t, "h-32") { style.height = 128 }
        else if str_eq(t, "h-48") { style.height = 192 }
        else if str_eq(t, "h-64") { style.height = 256 }
        return
    }

    if c0 == 97 { // 'a' -> align-items-*, alert*
        if str_eq(t, "align-items-center") { style.align_items = 1 }
        else if str_eq(t, "align-items-start") { style.align_items = 2 }
        else if str_eq(t, "align-items-end") { style.align_items = 3 }
        else if str_eq(t, "alert") {
            style.padding_x = 32; style.padding_y = 24; style.border_radius = 6; style.margin_y = 24; style.border_width = 1
        }
        else if str_eq(t, "alert-primary") { style.bg_color = 0xFF084298; style.border_color = 0xFF084298; style.text_color = 0xFFFFFFFF }
        else if str_eq(t, "alert-success") { style.bg_color = 0xFF0F5132; style.border_color = 0xFF0F5132; style.text_color = 0xFFFFFFFF }
        else if str_eq(t, "alert-danger")  { style.bg_color = 0xFF842029; style.border_color = 0xFF842029; style.text_color = 0xFFFFFFFF }
        else if str_eq(t, "alert-warning") { style.bg_color = 0xFF664D03; style.border_color = 0xFF664D03; style.text_color = 0xFFFFFFFF }
        return
    }

    if c0 == 100 { // 'd' -> d-flex, d-none, d-block, d-inline
        if str_eq(t, "d-flex") { style.display = 1 }
        else if str_eq(t, "d-none") { style.display = 3 }
        else if str_eq(t, "d-block") { style.display = 0 }
        else if str_eq(t, "d-inline") { style.display = 2 }
    }
}

// Applies all space-separated Tailwind / Bootstrap classes on a node to ComputedStyle
fn tw_apply_classes(mut style: ComputedStyle, class_str: str) {
    n := str_len(class_str)
    if n == 0 { return }

    mut cur := 0
    while cur < n {
        mut sp := str_find_byte(class_str, 32, cur)
        if sp < 0 { sp = n }
        if sp > cur {
            tw_apply_token(mut style, str_slice(class_str, cur, sp))
        }
        cur = sp + 1
    }
}
