// Axon Standard Library — Rich Formatting, Radix, Units & Tables (`std/fmt.ax`)
// Hex/Binary/Octal formatting, exact fixed-decimal `f64`, thousands separators,
// human byte/duration formatters, string alignment/padding, and Markdown table rendering.

use std::str
use std::ds

fn fmt_hex(val: i64, upper: bool = false, min_width: i64 = 0) -> str {
    tmp := buf_new(32)
    mut u := val
    if u == 0 {
        buf_push(tmp, 48)
    } else {
        mut guard := 0
        while u != 0 and guard < 16 {
            nib := u & 15
            mut ch := 48 + nib
            if nib >= 10 {
                ch = (if upper { 65 } else { 97 }) + (nib - 10)
            }
            buf_push(tmp, ch)
            u = ushr64(u, 4)
            guard += 1
        }
    }
    n := buf_len(tmp)
    mut pad := min_width - n
    if pad < 0 { pad = 0 }
    if pad > 64 { pad = 64 }
    out := buf_new(n + pad + 4)
    mut p := 0
    while p < pad { buf_push(out, 48); p += 1 }
    mut i := n - 1
    while i >= 0 { buf_push(out, buf_get(tmp, i)); i -= 1 }
    buf_free(move tmp)
    return buf_to_owned_str(move out)
}

fn fmt_bin(val: i64, min_width: i64 = 0) -> str {
    tmp := buf_new(80)
    mut u := val
    if u == 0 {
        buf_push(tmp, 48)
    } else {
        mut guard := 0
        while u != 0 and guard < 64 {
            buf_push(tmp, 48 + (u & 1))
            u = ushr64(u, 1)
            guard += 1
        }
    }
    n := buf_len(tmp)
    mut pad := min_width - n
    if pad < 0 { pad = 0 }
    if pad > 64 { pad = 64 }
    out := buf_new(n + pad + 4)
    mut p := 0
    while p < pad { buf_push(out, 48); p += 1 }
    mut i := n - 1
    while i >= 0 { buf_push(out, buf_get(tmp, i)); i -= 1 }
    buf_free(move tmp)
    return buf_to_owned_str(move out)
}

fn fmt_oct(val: i64) -> str {
    tmp := buf_new(32)
    mut u := val
    if u == 0 {
        buf_push(tmp, 48)
    } else {
        mut guard := 0
        while u != 0 and guard < 22 {
            buf_push(tmp, 48 + (u & 7))
            u = ushr64(u, 3)
            guard += 1
        }
    }
    n := buf_len(tmp)
    out := buf_new(n + 4)
    mut i := n - 1
    while i >= 0 { buf_push(out, buf_get(tmp, i)); i -= 1 }
    buf_free(move tmp)
    return buf_to_owned_str(move out)
}

// Formats signed `i64` with `,` thousands separators (e.g., `-50000000` -> `"-50,000,000"`).
fn fmt_commas(val: i64) -> str {
    raw := str_from_i64(val)
    n := str_len(raw)
    mut start := 0
    out := buf_new(n + (n / 3) + 4)
    if n > 0 and str_byte(raw, 0) == 45 {
        buf_push(out, 45)
        start = 1
    }
    digits := n - start
    mut i := 0
    while i < digits {
        if i > 0 and ((digits - i) % 3) == 0 {
            buf_push(out, 44)
        }
        buf_push(out, str_byte(raw, start + i))
        i += 1
    }
    return buf_to_owned_str(move out)
}

// Half-to-even / half-up rounded fixed-decimal `f64` formatter (`decimals` in `0..9`).
fn fmt_f64(val: f64, decimals: i64 = 2) -> str {
    mut dec := decimals
    if dec < 0 { dec = 0 }
    if dec > 9 { dec = 9 }
    mut neg := false
    mut v := val
    if v < 0.0 {
        neg = true
        v = 0.0 - v
    }
    mut scale := 1
    mut d := 0
    while d < dec { scale = scale * 10; d += 1 }
    scaled := ((v * (scale as f64)) + 0.5) as i64
    whole := scaled / scale
    frac := scaled % scale
    out := buf_new(48)
    if neg { buf_push(out, 45) }
    buf_push_str(out, str_from_i64(whole))
    if dec > 0 {
        buf_push(out, 46)
        fs := str_from_i64(frac)
        mut pad := dec - str_len(fs)
        while pad > 0 { buf_push(out, 48); pad -= 1 }
        buf_push_str(out, fs)
    }
    return buf_to_owned_str(move out)
}

fn fmt_pad_left(s: str, width: i64, pad_byte: i64 = 32) -> str {
    n := str_len(s)
    if n >= width { return s }
    pad := width - n
    out := buf_new(width + 4)
    mut i := 0
    while i < pad { buf_push(out, pad_byte & 255); i += 1 }
    if n > 0 { buf_push_str(out, s) }
    return buf_to_owned_str(move out)
}

fn fmt_pad_right(s: str, width: i64, pad_byte: i64 = 32) -> str {
    n := str_len(s)
    if n >= width { return s }
    pad := width - n
    out := buf_new(width + 4)
    if n > 0 { buf_push_str(out, s) }
    mut i := 0
    while i < pad { buf_push(out, pad_byte & 255); i += 1 }
    return buf_to_owned_str(move out)
}

fn fmt_center(s: str, width: i64, pad_byte: i64 = 32) -> str {
    n := str_len(s)
    if n >= width { return s }
    tot := width - n
    lp := tot >> 1
    rp := tot - lp
    out := buf_new(width + 4)
    mut i := 0
    while i < lp { buf_push(out, pad_byte & 255); i += 1 }
    if n > 0 { buf_push_str(out, s) }
    i = 0
    while i < rp { buf_push(out, pad_byte & 255); i += 1 }
    return buf_to_owned_str(move out)
}

fn fmt_bytes_human(bytes: i64) -> str {
    if bytes < 1024 { return f"{bytes} B" }
    if bytes < 1048576 { return fmt_f64((bytes as f64) / 1024.0, 2) + " KB" }
    if bytes < 1073741824 { return fmt_f64((bytes as f64) / 1048576.0, 2) + " MB" }
    return fmt_f64((bytes as f64) / 1073741824.0, 2) + " GB"
}

fn fmt_duration_ns(ns: i64) -> str {
    if ns < 1000 { return f"{ns} ns" }
    if ns < 1000000 { return fmt_f64((ns as f64) / 1000.0, 2) + " us" }
    if ns < 1000000000 { return fmt_f64((ns as f64) / 1000000.0, 2) + " ms" }
    return fmt_f64((ns as f64) / 1000000000.0, 2) + " s"
}

// Renders a GitHub-Flavored Markdown table from `headers` (`cols`) and row-major `cells` (`rows * cols`).
fn fmt_markdown_table(headers: StrVec, cells: StrVec, cols: i64) -> str {
    if cols <= 0 or svec_len(headers) < cols { return "" }
    rows := svec_len(cells) / cols
    out := buf_new((rows + 2) * cols * 16 + 64)
    buf_push_str(out, "|")
    mut c := 0
    while c < cols {
        buf_push_str(out, " " + svec_get(headers, c) + " |")
        c += 1
    }
    buf_push_str(out, "\n|")
    c = 0
    while c < cols {
        buf_push_str(out, " --- |")
        c += 1
    }
    buf_push_str(out, "\n")
    mut r := 0
    while r < rows {
        buf_push_str(out, "|")
        c = 0
        while c < cols {
            buf_push_str(out, " " + svec_get(cells, r * cols + c) + " |")
            c += 1
        }
        buf_push_str(out, "\n")
        r += 1
    }
    return buf_to_owned_str(move out)
}
