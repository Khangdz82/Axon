// ==================== 1. JSON ESCAPING, TRUNCATION & MULTI-TURN CONTEXT ====================

// RFC-8259 compliant JSON string escaping (escapes all control bytes < 0x20 as \u00XX)
fn harness_push_json_escaped(out: ByteBuf, s: str) {
    json_push_escaped(out, s)
}

// Line-boundary-preserving middle truncation (keeps head context + tail stacktrace, slashes token waste!)
fn harness_truncate_middle(text: str, max_chars: i64 = 12000) -> str {
    n := str_len(text)
    if max_chars <= 0 or n <= max_chars { return text }
    if max_chars < 64 { return str_slice(text, 0, max_chars) }
    half := max_chars / 2
    mut head_end := half
    // Snap head backward to newline if within outer 25%
    mut hi := half - 1
    mut h_min := half / 2
    while hi >= h_min {
        if str_byte(text, hi) == 10 { head_end = hi; break }
        hi -= 1
    }
    mut tail_start := n - half
    mut ti := tail_start
    mut t_max := n - (half / 2)
    while ti < t_max {
        if str_byte(text, ti) == 10 { tail_start = ti + 1; break }
        ti += 1
    }
    if tail_start <= head_end { return str_slice(text, 0, max_chars) }
    omitted := tail_start - head_end
    return str_slice(text, 0, head_end) + f"\n... [truncated {omitted} chars] ...\n" + str_slice(text, tail_start, n)
}

// Role codes: 0 = system, 1 = user, 2 = assistant, 3 = tool
fn harness_role_name(role: i64) -> str {
    if role == 0 { return "system" }
    if role == 1 { return "user" }
    if role == 2 { return "assistant" }
    return "tool"
}

struct AgentContext {
    text_buf: ByteBuf
    text_cap: i64
    meta: IntBuf       // 4 ints per message: [role, off, len, est_tokens]
    meta_cap: i64
    msg_count: i64
    total_tokens: i64
    max_tokens: i64
}

fn agent_ctx_new(max_tokens: i64 = 16384) -> AgentContext {
    mut mt := max_tokens
    if mt < 16 { mt = 16 }
    if mt > 2097152 { mt = 2097152 }
    return AgentContext(
        text_buf = buf_new(16384),
        text_cap = 16384,
        meta = ibuf_new(1024),
        meta_cap = 256,
        msg_count = 0,
        total_tokens = 0,
        max_tokens = mt
    )
}

fn agent_ctx_free(move ctx: AgentContext) {
    buf_free(move ctx.text_buf)
    buf_free(move ctx.meta)
}

fn _agent_ctx_ensure_text(mut ctx: AgentContext, add_len: i64) {
    cur := buf_len(ctx.text_buf)
    if cur + add_len + 8 <= ctx.text_cap { return }
    mut nc := ctx.text_cap * 2
    while nc < cur + add_len + 16 and nc < 33554432 { nc = nc * 2 }
    if nc > 33554432 { nc = 33554432 }
    if cur + add_len + 8 > nc { return }
    nb := buf_new(nc)
    if cur > 0 { buf_push_str(nb, buf_slice_str(ctx.text_buf, 0, cur)) }
    buf_free(move ctx.text_buf)
    ctx.text_buf = nb
    ctx.text_cap = nc
}

fn _agent_ctx_ensure_meta(mut ctx: AgentContext) -> bool {
    if ctx.msg_count < ctx.meta_cap { return true }
    if ctx.meta_cap >= 16384 { return false }
    nc := ctx.meta_cap * 2
    nm := ibuf_new(nc * 4)
    cur := ibuf_len(ctx.meta)
    mut i := 0
    while i < cur { ibuf_push(nm, ibuf_get(ctx.meta, i)); i += 1 }
    buf_free(move ctx.meta)
    ctx.meta = nm
    ctx.meta_cap = nc
    return true
}

fn agent_ctx_push(mut ctx: AgentContext, role: i64, content: str) -> bool {
    if not _agent_ctx_ensure_meta(mut ctx) { return false }
    clen := str_len(content)
    if clen > 4194304 { return false }
    _agent_ctx_ensure_text(mut ctx, clen)
    if buf_len(ctx.text_buf) + clen + 4 > ctx.text_cap { return false }
    off := buf_len(ctx.text_buf)
    if clen > 0 { buf_push_str(ctx.text_buf, content) }
    toks := estimate_prompt_tokens(content) + 4
    ibuf_push(ctx.meta, role)
    ibuf_push(ctx.meta, off)
    ibuf_push(ctx.meta, clen)
    ibuf_push(ctx.meta, toks)
    ctx.msg_count += 1
    ctx.total_tokens += toks
    return true
}

fn agent_ctx_msg_role(ctx: AgentContext, idx: i64) -> i64 {
    if idx < 0 or idx >= ctx.msg_count { return -1 }
    return ibuf_get(ctx.meta, idx * 4)
}

fn agent_ctx_msg_text(ctx: AgentContext, idx: i64) -> str {
    if idx < 0 or idx >= ctx.msg_count { return "" }
    off := ibuf_get(ctx.meta, idx * 4 + 1)
    ln  := ibuf_get(ctx.meta, idx * 4 + 2)
    if off < 0 or ln < 0 or off + ln > buf_len(ctx.text_buf) { return "" }
    return buf_slice_str(ctx.text_buf, off, off + ln)
}

// Rebuilds `ctx.text_buf` compactly from live messages (eliminates dead-byte memory creep!)
fn _agent_ctx_compact_text(mut ctx: AgentContext) {
    mut live_bytes := 0
    mut i := 0
    while i < ctx.msg_count {
        live_bytes += ibuf_get(ctx.meta, i * 4 + 2)
        i += 1
    }
    mut nc := 16384
    while nc < live_bytes + 1024 { nc = nc * 2 }
    nb := buf_new(nc)
    i = 0
    while i < ctx.msg_count {
        b := i * 4
        old_off := ibuf_get(ctx.meta, b + 1)
        ln := ibuf_get(ctx.meta, b + 2)
        new_off := buf_len(nb)
        if ln > 0 { buf_push_str(nb, buf_slice_str(ctx.text_buf, old_off, old_off + ln)) }
        ibuf_set(ctx.meta, b + 1, new_off)
        i += 1
    }
    buf_free(move ctx.text_buf)
    ctx.text_buf = nb
    ctx.text_cap = nc
}

// Deterministic sliding-window compaction: preserves system prompt (idx 0), compacts text_buf, and keeps latest turns.
fn agent_ctx_prune_to_budget(mut ctx: AgentContext) -> i64 {
    if ctx.total_tokens <= ctx.max_tokens or ctx.msg_count <= 2 { return 0 }
    has_sys := ibuf_get(ctx.meta, 0) == 0
    first_drop := if has_sys { 1 } else { 0 }
    mut keep_from := first_drop
    mut toks := ctx.total_tokens
    while toks > ctx.max_tokens and keep_from < ctx.msg_count - 1 {
        toks -= ibuf_get(ctx.meta, keep_from * 4 + 3)
        keep_from += 1
    }
    dropped := keep_from - first_drop
    if dropped <= 0 { return 0 }

    new_meta := ibuf_new(ctx.meta_cap * 4)
    mut new_cnt := 0
    mut new_toks := 0
    if has_sys {
        ibuf_push(new_meta, ibuf_get(ctx.meta, 0))
        ibuf_push(new_meta, ibuf_get(ctx.meta, 1))
        ibuf_push(new_meta, ibuf_get(ctx.meta, 2))
        st := ibuf_get(ctx.meta, 3)
        ibuf_push(new_meta, st)
        new_cnt = 1
        new_toks = st
    }
    mut i := keep_from
    while i < ctx.msg_count {
        b := i * 4
        ibuf_push(new_meta, ibuf_get(ctx.meta, b))
        ibuf_push(new_meta, ibuf_get(ctx.meta, b + 1))
        ibuf_push(new_meta, ibuf_get(ctx.meta, b + 2))
        mt := ibuf_get(ctx.meta, b + 3)
        ibuf_push(new_meta, mt)
        new_cnt += 1
        new_toks += mt
        i += 1
    }
    buf_free(move ctx.meta)
    ctx.meta = new_meta
    ctx.msg_count = new_cnt
    ctx.total_tokens = new_toks
    _agent_ctx_compact_text(mut ctx)
    return dropped
}

// Token-saving compressor: compacts bulky historical `tool` outputs (`role == 3`) older than `keep_recent_msgs`
// Returns exact estimated tokens saved!
fn agent_ctx_compact_tool_outputs(mut ctx: AgentContext, keep_recent_msgs: i64 = 4, max_old_tool_chars: i64 = 240) -> i64 {
    if ctx.msg_count <= keep_recent_msgs + 1 or max_old_tool_chars < 64 { return 0 }
    cutoff := ctx.msg_count - keep_recent_msgs
    mut saved := 0
    mut new_tb := buf_new(ctx.text_cap)
    mut new_tot := 0
    mut i := 0
    while i < ctx.msg_count {
        b := i * 4
        role := ibuf_get(ctx.meta, b)
        off := ibuf_get(ctx.meta, b + 1)
        ln := ibuf_get(ctx.meta, b + 2)
        old_toks := ibuf_get(ctx.meta, b + 3)
        raw := if ln > 0 { buf_slice_str(ctx.text_buf, off, off + ln) } else { "" }
        mut text := raw
        if i > 0 and i < cutoff and role == 3 and ln > max_old_tool_chars {
            trunc := harness_truncate_middle(raw, max_old_tool_chars)
            if str_len(trunc) < ln { text = trunc }
        }
        new_off := buf_len(new_tb)
        if str_len(text) > 0 { buf_push_str(new_tb, text) }
        new_toks := estimate_prompt_tokens(text) + 4
        if new_toks < old_toks { saved += old_toks - new_toks }
        ibuf_set(ctx.meta, b + 1, new_off)
        ibuf_set(ctx.meta, b + 2, str_len(text))
        ibuf_set(ctx.meta, b + 3, new_toks)
        new_tot += new_toks
        i += 1
    }
    buf_free(move ctx.text_buf)
    ctx.text_buf = new_tb
    ctx.total_tokens = new_tot
    return saved
}

// ==================== 2. AUTO-GROWING HASH-INDEXED TOOL REGISTRY & PROGRESSIVE DISCOVERY ====================

struct ToolRegistry {
    data: ByteBuf
    data_cap: i64
    meta: IntBuf       // 6 ints per tool: [name_off, name_len, desc_off, desc_len, schema_off, schema_len]
    meta_cap: i64
    name_idx: StrMap   // O(1) name -> tool index
    count: i64
}

fn tool_reg_new() -> ToolRegistry {
    return ToolRegistry(
        data = buf_new(16384),
        data_cap = 16384,
        meta = ibuf_new(384),
        meta_cap = 64,
        name_idx = smap_new(64),
        count = 0
    )
}

fn tool_reg_free(move reg: ToolRegistry) {
    buf_free(move reg.data)
    buf_free(move reg.meta)
    smap_free(move reg.name_idx)
}

fn _tool_reg_ensure(mut reg: ToolRegistry, add_bytes: i64) -> bool {
    if reg.count >= 2048 { return false }
    cur_b := buf_len(reg.data)
    if cur_b + add_bytes + 32 > reg.data_cap {
        mut nc := reg.data_cap * 2
        while nc < cur_b + add_bytes + 64 and nc < 4194304 { nc = nc * 2 }
        if nc > 4194304 or cur_b + add_bytes + 32 > nc { return false }
        nb := buf_new(nc)
        if cur_b > 0 { buf_push_str(nb, buf_slice_str(reg.data, 0, cur_b)) }
        buf_free(move reg.data)
        reg.data = nb
        reg.data_cap = nc
    }
    if reg.count >= reg.meta_cap {
        nm_cap := reg.meta_cap * 2
        nm := ibuf_new(nm_cap * 6)
        cur_m := ibuf_len(reg.meta)
        mut i := 0
        while i < cur_m { ibuf_push(nm, ibuf_get(reg.meta, i)); i += 1 }
        buf_free(move reg.meta)
        reg.meta = nm
        reg.meta_cap = nm_cap
    }
    return true
}

fn tool_reg_add(mut reg: ToolRegistry, name: str, desc: str, params_schema_json: str) -> bool {
    if str_len(name) == 0 { return false }
    need := str_len(name) + str_len(desc) + str_len(params_schema_json)
    if not _tool_reg_ensure(mut reg, need) { return false }
    no := buf_len(reg.data); nl := str_len(name); buf_push_str(reg.data, name)
    do := buf_len(reg.data); dl := str_len(desc); buf_push_str(reg.data, desc)
    so := buf_len(reg.data); sl := str_len(params_schema_json); buf_push_str(reg.data, params_schema_json)
    idx := reg.count
    ibuf_push(reg.meta, no); ibuf_push(reg.meta, nl)
    ibuf_push(reg.meta, do); ibuf_push(reg.meta, dl)
    ibuf_push(reg.meta, so); ibuf_push(reg.meta, sl)
    smap_set_i64(mut reg.name_idx, name, idx)
    reg.count += 1
    return true
}

// O(1) hash lookup
fn tool_reg_exists(reg: ToolRegistry, name: str) -> bool {
    return smap_has(reg.name_idx, name)
}

fn tool_reg_find_idx(reg: ToolRegistry, name: str) -> i64 {
    if not smap_has(reg.name_idx, name) { return -1 }
    return smap_get_i64(reg.name_idx, name, -1)
}

// Formats a compact Python/Axon-style typed signature from a JSON Schema string (saves ~90% tokens vs raw JSON schema!)
fn harness_compact_schema_sig(tool_name: str, schema_json: str) -> str {
    doc := jdoc_parse(schema_json) or return f"{tool_name}()"
    props_id := jdoc_obj_get(doc, doc.root, "properties")
    if props_id < 0 or jdoc_type(doc, props_id) != JVAL_OBJECT() {
        jdoc_free(move doc)
        return f"{tool_name}()"
    }
    // Collect required param names
    mut req_map := smap_new(16)
    req_id := jdoc_obj_get(doc, doc.root, "required")
    if req_id >= 0 and jdoc_type(doc, req_id) == JVAL_ARRAY() {
        mut rc := jdoc_first_child(doc, req_id)
        while rc >= 0 {
            if jdoc_type(doc, rc) == JVAL_STR() {
                smap_set_i64(mut req_map, jdoc_as_str(doc, rc, ""), 1)
            }
            rc = jdoc_next_sib(doc, rc)
        }
    }
    mut req_parts := svec_new(8, 128)
    mut opt_parts := svec_new(8, 128)
    mut p := jdoc_first_child(doc, props_id)
    while p >= 0 {
        pname := jdoc_key(doc, p)
        ty_id := jdoc_obj_get(doc, p, "type")
        mut pt := "any"
        if ty_id >= 0 and jdoc_type(doc, ty_id) == JVAL_STR() {
            raw_t := jdoc_as_str(doc, ty_id, "any")
            if str_eq(raw_t, "string") { pt = "str" }
            else if str_eq(raw_t, "integer") { pt = "i64" }
            else if str_eq(raw_t, "number") { pt = "f64" }
            else if str_eq(raw_t, "boolean") { pt = "bool" }
            else if str_eq(raw_t, "array") { pt = "list" }
            else if str_eq(raw_t, "object") { pt = "dict" }
            else { pt = raw_t }
        }
        if smap_has(req_map, pname) {
            svec_push(mut req_parts, f"{pname}: {pt}")
        } else {
            svec_push(mut opt_parts, f"{pname}?: {pt}")
        }
        p = jdoc_next_sib(doc, p)
    }
    jdoc_free(move doc)
    smap_free(move req_map)
    r_s := svec_join(req_parts, ", ")
    o_s := svec_join(opt_parts, ", ")
    svec_free(move req_parts)
    svec_free(move opt_parts)
    if str_len(r_s) > 0 and str_len(o_s) > 0 { return f"{tool_name}({r_s}, {o_s})" }
    if str_len(r_s) > 0 { return f"{tool_name}({r_s})" }
    return f"{tool_name}({o_s})"
}

// Cloudflare Code Mode progressive tool discovery: compact 1-line keyword search (~15 tokens/hit instead of ~180!)
fn tool_reg_search(reg: ToolRegistry, query: str, limit: i64 = 10) -> str {
    qlow := str_to_lower(str_trim(query))
    mut lines := svec_new(16, 1024)
    mut scores := dvec_new(16)
    mut idxs := dvec_new(16)
    mut i := 0
    while i < reg.count {
        b := i * 6
        tn := buf_slice_str(reg.data, ibuf_get(reg.meta, b), ibuf_get(reg.meta, b) + ibuf_get(reg.meta, b + 1))
        td := buf_slice_str(reg.data, ibuf_get(reg.meta, b + 2), ibuf_get(reg.meta, b + 2) + ibuf_get(reg.meta, b + 3))
        ts := buf_slice_str(reg.data, ibuf_get(reg.meta, b + 4), ibuf_get(reg.meta, b + 4) + ibuf_get(reg.meta, b + 5))
        mut sc := 0
        if str_len(qlow) == 0 {
            sc = 1
        } else {
            tnl := str_to_lower(tn)
            tdl := str_to_lower(td)
            tsl := str_to_lower(ts)
            if str_eq(tnl, qlow) { sc += 100 }
            else if str_starts_with(tnl, qlow) { sc += 50 }
            else if str_contains(tnl, qlow) { sc += 25 }
            if str_contains(tdl, qlow) { sc += 10 }
            if str_contains(tsl, qlow) { sc += 5 }
        }
        if sc > 0 {
            dvec_push(mut scores, sc)
            dvec_push(mut idxs, i)
        }
        i += 1
    }
    // Sort matched indices by score descending
    nm := dvec_len(idxs)
    mut a := 1
    while a < nm {
        ks := dvec_get(scores, a, 0)
        ki := dvec_get(idxs, a, 0)
        mut j := a - 1
        while j >= 0 and dvec_get(scores, j, 0) < ks {
            _ := dvec_set(mut scores, j + 1, dvec_get(scores, j, 0))
            _ := dvec_set(mut idxs, j + 1, dvec_get(idxs, j, 0))
            j -= 1
        }
        _ := dvec_set(mut scores, j + 1, ks)
        _ := dvec_set(mut idxs, j + 1, ki)
        a += 1
    }
    mut lim := limit
    if lim <= 0 { lim = 10 }
    if lim > nm { lim = nm }
    mut k := 0
    while k < lim {
        ti := dvec_get(idxs, k, 0)
        b := ti * 6
        tn := buf_slice_str(reg.data, ibuf_get(reg.meta, b), ibuf_get(reg.meta, b) + ibuf_get(reg.meta, b + 1))
        td := buf_slice_str(reg.data, ibuf_get(reg.meta, b + 2), ibuf_get(reg.meta, b + 2) + ibuf_get(reg.meta, b + 3))
        ts := buf_slice_str(reg.data, ibuf_get(reg.meta, b + 4), ibuf_get(reg.meta, b + 4) + ibuf_get(reg.meta, b + 5))
        sig := harness_compact_schema_sig(tn, ts)
        svec_push(mut lines, f"- {sig}: {td}")
        k += 1
    }
    dvec_free(move scores)
    dvec_free(move idxs)
    res := svec_join(lines, "\n")
    svec_free(move lines)
    return res
}

// Ultra-compact full manifest of registered tools (minimal prompt token footprint)
fn tool_reg_compact_manifest(reg: ToolRegistry) -> str {
    return tool_reg_search(reg, "", reg.count)
}

// On-demand full description + schema for one tool (`mcp.describe` style)
fn tool_reg_describe(reg: ToolRegistry, name: str) -> str ! i64 {
    idx := tool_reg_find_idx(reg, name)
    if idx < 0 { return err(404) }
    b := idx * 6
    tn := buf_slice_str(reg.data, ibuf_get(reg.meta, b), ibuf_get(reg.meta, b) + ibuf_get(reg.meta, b + 1))
    td := buf_slice_str(reg.data, ibuf_get(reg.meta, b + 2), ibuf_get(reg.meta, b + 2) + ibuf_get(reg.meta, b + 3))
    ts := buf_slice_str(reg.data, ibuf_get(reg.meta, b + 4), ibuf_get(reg.meta, b + 4) + ibuf_get(reg.meta, b + 5))
    sig := harness_compact_schema_sig(tn, ts)
    return ok(f"{sig}\n  {td}\nSchema: {ts}")
}

// Registers the standard coding-agent toolset (`read_file`, `write_file`, `edit_file`, `grep`, `run_safe_cmd`)
fn tool_reg_add_coding_defaults(mut reg: ToolRegistry) {
    _ := tool_reg_add(mut reg, "read_file", "Read a file inside workspace", "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"start_line\":{\"type\":\"integer\"},\"end_line\":{\"type\":\"integer\"}},\"required\":[\"path\"]}")
    _ := tool_reg_add(mut reg, "write_file", "Write a file inside workspace", "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"}},\"required\":[\"path\",\"content\"]}")
    _ := tool_reg_add(mut reg, "edit_file", "Exact search-and-replace inside workspace file", "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"target\":{\"type\":\"string\"},\"replacement\":{\"type\":\"string\"}},\"required\":[\"path\",\"target\",\"replacement\"]}")
    _ := tool_reg_add(mut reg, "grep", "Search substring in workspace file", "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"query\":{\"type\":\"string\"}},\"required\":[\"path\",\"query\"]}")
    _ := tool_reg_add(mut reg, "run_safe_cmd", "Run allowlisted check/test/git command", "{\"type\":\"object\",\"properties\":{\"cmd\":{\"type\":\"string\"}},\"required\":[\"cmd\"]}")
}

// 2a. OpenAI / DeepSeek / Groq / OpenRouter / Ollama Chat Completions JSON (6x escape-safe capacity)
fn agent_ctx_build_chat_json(ctx: AgentContext, reg: ToolRegistry, model: str, max_out_tokens: i64 = 1024) -> str {
    est := buf_len(ctx.text_buf) * 6 + buf_len(reg.data) * 6 + str_len(model) * 6 + ctx.msg_count * 64 + reg.count * 128 + 2048
    out := buf_new(est)
    buf_push_str(out, "{\"model\":\"")
    harness_push_json_escaped(out, model)
    buf_push_str(out, "\",\"max_tokens\":")
    buf_push_str(out, f"{max_out_tokens}")
    buf_push_str(out, ",\"messages\":[")
    mut i := 0
    while i < ctx.msg_count {
        if i > 0 { buf_push(out, 44) }
        buf_push_str(out, "{\"role\":\"")
        buf_push_str(out, harness_role_name(agent_ctx_msg_role(ctx, i)))
        buf_push_str(out, "\",\"content\":\"")
        harness_push_json_escaped(out, agent_ctx_msg_text(ctx, i))
        buf_push_str(out, "\"}")
        i += 1
    }
    buf_push(out, 93)
    if reg.count > 0 {
        buf_push_str(out, ",\"tools\":[")
        mut ti := 0
        while ti < reg.count {
            if ti > 0 { buf_push(out, 44) }
            b := ti * 6
            tn := buf_slice_str(reg.data, ibuf_get(reg.meta, b), ibuf_get(reg.meta, b) + ibuf_get(reg.meta, b + 1))
            td := buf_slice_str(reg.data, ibuf_get(reg.meta, b + 2), ibuf_get(reg.meta, b + 2) + ibuf_get(reg.meta, b + 3))
            ts := buf_slice_str(reg.data, ibuf_get(reg.meta, b + 4), ibuf_get(reg.meta, b + 4) + ibuf_get(reg.meta, b + 5))
            buf_push_str(out, "{\"type\":\"function\",\"function\":{\"name\":\"")
            harness_push_json_escaped(out, tn)
            buf_push_str(out, "\",\"description\":\"")
            harness_push_json_escaped(out, td)
            buf_push_str(out, "\",\"parameters\":")
            buf_push_str(out, if str_len(ts) > 0 { ts } else { "{\"type\":\"object\",\"properties\":{}}" })
            buf_push_str(out, "}}")
            ti += 1
        }
        buf_push(out, 93)
    }
    buf_push(out, 125)
    return buf_to_owned_str(move out)
}

// 2b. Anthropic Messages API JSON
fn agent_ctx_build_anthropic_json(ctx: AgentContext, reg: ToolRegistry, model: str, max_out_tokens: i64 = 1024) -> str {
    est := buf_len(ctx.text_buf) * 6 + buf_len(reg.data) * 6 + str_len(model) * 6 + ctx.msg_count * 64 + reg.count * 128 + 2048
    out := buf_new(est)
    buf_push_str(out, "{\"model\":\"")
    harness_push_json_escaped(out, model)
    buf_push_str(out, "\",\"max_tokens\":")
    buf_push_str(out, f"{max_out_tokens}")
    if ctx.msg_count > 0 and agent_ctx_msg_role(ctx, 0) == 0 {
        buf_push_str(out, ",\"system\":\"")
        harness_push_json_escaped(out, agent_ctx_msg_text(ctx, 0))
        buf_push(out, 34)
    }
    buf_push_str(out, ",\"messages\":[")
    mut i := 0
    mut first_m := true
    while i < ctx.msg_count {
        r := agent_ctx_msg_role(ctx, i)
        if r != 0 {
            if not first_m { buf_push(out, 44) }
            first_m = false
            arole := if r == 2 { "assistant" } else { "user" }
            buf_push_str(out, "{\"role\":\"")
            buf_push_str(out, arole)
            buf_push_str(out, "\",\"content\":\"")
            harness_push_json_escaped(out, agent_ctx_msg_text(ctx, i))
            buf_push_str(out, "\"}")
        }
        i += 1
    }
    buf_push(out, 93)
    if reg.count > 0 {
        buf_push_str(out, ",\"tools\":[")
        mut ti := 0
        while ti < reg.count {
            if ti > 0 { buf_push(out, 44) }
            b := ti * 6
            tn := buf_slice_str(reg.data, ibuf_get(reg.meta, b), ibuf_get(reg.meta, b) + ibuf_get(reg.meta, b + 1))
            td := buf_slice_str(reg.data, ibuf_get(reg.meta, b + 2), ibuf_get(reg.meta, b + 2) + ibuf_get(reg.meta, b + 3))
            ts := buf_slice_str(reg.data, ibuf_get(reg.meta, b + 4), ibuf_get(reg.meta, b + 4) + ibuf_get(reg.meta, b + 5))
            buf_push_str(out, "{\"name\":\"")
            harness_push_json_escaped(out, tn)
            buf_push_str(out, "\",\"description\":\"")
            harness_push_json_escaped(out, td)
            buf_push_str(out, "\",\"input_schema\":")
            buf_push_str(out, if str_len(ts) > 0 { ts } else { "{\"type\":\"object\",\"properties\":{}}" })
            buf_push(out, 125)
            ti += 1
        }
        buf_push(out, 93)
    }
    buf_push(out, 125)
    return buf_to_owned_str(move out)
}

// 2c. Google Gemini `generateContent` JSON
fn agent_ctx_build_gemini_json(ctx: AgentContext, reg: ToolRegistry, max_out_tokens: i64 = 1024) -> str {
    est := buf_len(ctx.text_buf) * 6 + buf_len(reg.data) * 6 + ctx.msg_count * 80 + reg.count * 128 + 2048
    out := buf_new(est)
    buf_push(out, 123)
    mut need_comma := false
    if ctx.msg_count > 0 and agent_ctx_msg_role(ctx, 0) == 0 {
        buf_push_str(out, "\"systemInstruction\":{\"parts\":[{\"text\":\"")
        harness_push_json_escaped(out, agent_ctx_msg_text(ctx, 0))
        buf_push_str(out, "\"}]}")
        need_comma = true
    }
    if need_comma { buf_push(out, 44) }
    buf_push_str(out, "\"contents\":[")
    mut i := 0
    mut first_c := true
    while i < ctx.msg_count {
        r := agent_ctx_msg_role(ctx, i)
        if r != 0 {
            if not first_c { buf_push(out, 44) }
            first_c = false
            grole := if r == 2 { "model" } else { "user" }
            buf_push_str(out, "{\"role\":\"")
            buf_push_str(out, grole)
            buf_push_str(out, "\",\"parts\":[{\"text\":\"")
            harness_push_json_escaped(out, agent_ctx_msg_text(ctx, i))
            buf_push_str(out, "\"}]}")
        }
        i += 1
    }
    buf_push_str(out, "],\"generationConfig\":{\"maxOutputTokens\":")
    buf_push_str(out, f"{max_out_tokens}")
    buf_push(out, 125)
    if reg.count > 0 {
        buf_push_str(out, ",\"tools\":[{\"functionDeclarations\":[")
        mut ti := 0
        while ti < reg.count {
            if ti > 0 { buf_push(out, 44) }
            b := ti * 6
            tn := buf_slice_str(reg.data, ibuf_get(reg.meta, b), ibuf_get(reg.meta, b) + ibuf_get(reg.meta, b + 1))
            td := buf_slice_str(reg.data, ibuf_get(reg.meta, b + 2), ibuf_get(reg.meta, b + 2) + ibuf_get(reg.meta, b + 3))
            ts := buf_slice_str(reg.data, ibuf_get(reg.meta, b + 4), ibuf_get(reg.meta, b + 4) + ibuf_get(reg.meta, b + 5))
            buf_push_str(out, "{\"name\":\"")
            harness_push_json_escaped(out, tn)
            buf_push_str(out, "\",\"description\":\"")
            harness_push_json_escaped(out, td)
            buf_push_str(out, "\",\"parameters\":")
            buf_push_str(out, if str_len(ts) > 0 { ts } else { "{\"type\":\"object\",\"properties\":{}}" })
            buf_push(out, 125)
            ti += 1
        }
        buf_push_str(out, "]}]")
    }
    buf_push(out, 125)
    return buf_to_owned_str(move out)
}

// ==================== 3. STRUCTURAL JSON-DOM PARALLEL TOOL-CALL PARSER ====================

struct ToolCall {
    found: bool
    id: str
    name: str
    args_json: str
}

struct ToolCallBatch {
    buf: ByteBuf
    buf_cap: i64
    meta: IntBuf // 6 ints per call: [id_off, id_len, name_off, name_len, args_off, args_len]
    meta_cap: i64
    count: i64
}

fn tool_batch_free(move b: ToolCallBatch) {
    buf_free(move b.buf)
    buf_free(move b.meta)
}

fn tool_batch_get(batch: ToolCallBatch, idx: i64) -> ToolCall {
    if idx < 0 or idx >= batch.count {
        return ToolCall(found = false, id = "", name = "", args_json = "")
    }
    b := idx * 6
    io := ibuf_get(batch.meta, b); il := ibuf_get(batch.meta, b + 1)
    no := ibuf_get(batch.meta, b + 2); nl := ibuf_get(batch.meta, b + 3)
    ao := ibuf_get(batch.meta, b + 4); al := ibuf_get(batch.meta, b + 5)
    return ToolCall(
        found = true,
        id = buf_slice_str(batch.buf, io, io + il),
        name = buf_slice_str(batch.buf, no, no + nl),
        args_json = buf_slice_str(batch.buf, ao, ao + al)
    )
}

fn _tool_batch_push(mut batch: ToolCallBatch, id: str, name: str, args: str) {
    if batch.count >= 256 or str_len(name) == 0 { return }
    need := str_len(id) + str_len(name) + str_len(args)
    cur := buf_len(batch.buf)
    if cur + need + 32 > batch.buf_cap {
        mut nc := batch.buf_cap * 2
        while nc < cur + need + 64 and nc < 8388608 { nc = nc * 2 }
        if nc > 8388608 or cur + need + 32 > nc { return }
        nb := buf_new(nc)
        if cur > 0 { buf_push_str(nb, buf_slice_str(batch.buf, 0, cur)) }
        buf_free(move batch.buf)
        batch.buf = nb
        batch.buf_cap = nc
    }
    if batch.count >= batch.meta_cap {
        nm_cap := batch.meta_cap * 2
        nm := ibuf_new(nm_cap * 6)
        mut k := 0
        while k < ibuf_len(batch.meta) { ibuf_push(nm, ibuf_get(batch.meta, k)); k += 1 }
        buf_free(move batch.meta)
        batch.meta = nm
        batch.meta_cap = nm_cap
    }
    io := buf_len(batch.buf); il := str_len(id); if il > 0 { buf_push_str(batch.buf, id) }
    no := buf_len(batch.buf); nl := str_len(name); buf_push_str(batch.buf, name)
    ao := buf_len(batch.buf); al := str_len(args); if al > 0 { buf_push_str(batch.buf, args) }
    ibuf_push(batch.meta, io); ibuf_push(batch.meta, il)
    ibuf_push(batch.meta, no); ibuf_push(batch.meta, nl)
    ibuf_push(batch.meta, ao); ibuf_push(batch.meta, al)
    batch.count += 1
}

// Structural JSON-DOM multi-provider parser (ZERO false-triggers on prose mentioning `"tool_calls"` or `"function"`!)
// Supports OpenAI (parallel), Anthropic (parallel `tool_use`), Gemini (parallel `functionCall`), and XML `<tool>` fallback.
fn harness_parse_tool_calls_all(resp: str) -> ToolCallBatch {
    mut batch := ToolCallBatch(buf = buf_new(16384), buf_cap = 16384, meta = ibuf_new(192), meta_cap = 32, count = 0)
    trimmed := str_trim(resp)
    if str_len(trimmed) == 0 { return batch }

    // 1. Structural JSON parse (OpenAI / Anthropic / Gemini)
    if str_byte(trimmed, 0) == 123 {
        doc := jdoc_parse(trimmed) or JsonDoc(nodes = ibuf_new(0), nodes_cap = 0, node_count = 0, strings = buf_new(0), str_cap = 0, root = -1)
        if doc.root >= 0 {
            // 1a. OpenAI: `/choices/0/message/tool_calls` OR direct top-level `/tool_calls`
            mut tc_arr := jdoc_path(doc, "/choices/0/message/tool_calls")
            if tc_arr < 0 { tc_arr = jdoc_obj_get(doc, doc.root, "tool_calls") }
            if tc_arr >= 0 and jdoc_type(doc, tc_arr) == JVAL_ARRAY() {
                mut cur := jdoc_first_child(doc, tc_arr)
                while cur >= 0 {
                    if jdoc_type(doc, cur) == JVAL_OBJECT() {
                        id_n := jdoc_obj_get(doc, cur, "id")
                        cid := if id_n >= 0 and jdoc_type(doc, id_n) == JVAL_STR() { jdoc_as_str(doc, id_n, "") } else { f"call_{batch.count}" }
                        fn_n := jdoc_obj_get(doc, cur, "function")
                        if fn_n >= 0 and jdoc_type(doc, fn_n) == JVAL_OBJECT() {
                            nm_n := jdoc_obj_get(doc, fn_n, "name")
                            ar_n := jdoc_obj_get(doc, fn_n, "arguments")
                            nm := if nm_n >= 0 { jdoc_as_str(doc, nm_n, "") } else { "" }
                            mut arg_s := "{}"
                            if ar_n >= 0 {
                                if jdoc_type(doc, ar_n) == JVAL_STR() { arg_s = jdoc_as_str(doc, ar_n, "{}") }
                                else { arg_s = jdoc_stringify(doc, ar_n, false, 0) }
                            }
                            if str_len(nm) > 0 { _tool_batch_push(mut batch, cid, nm, arg_s) }
                        }
                    }
                    cur = jdoc_next_sib(doc, cur)
                }
            }

            // 1b. Anthropic: `/content` array of `{"type":"tool_use","id":...,"name":...,"input":{...}}`
            if batch.count == 0 {
                c_arr := jdoc_obj_get(doc, doc.root, "content")
                if c_arr >= 0 and jdoc_type(doc, c_arr) == JVAL_ARRAY() {
                    mut cur := jdoc_first_child(doc, c_arr)
                    while cur >= 0 {
                        if jdoc_type(doc, cur) == JVAL_OBJECT() {
                            ty_n := jdoc_obj_get(doc, cur, "type")
                            if ty_n >= 0 and str_eq(jdoc_as_str(doc, ty_n, ""), "tool_use") {
                                id_n := jdoc_obj_get(doc, cur, "id")
                                cid := if id_n >= 0 { jdoc_as_str(doc, id_n, f"toolu_{batch.count}") } else { f"toolu_{batch.count}" }
                                nm_n := jdoc_obj_get(doc, cur, "name")
                                nm := if nm_n >= 0 { jdoc_as_str(doc, nm_n, "") } else { "" }
                                in_n := jdoc_obj_get(doc, cur, "input")
                                arg_s := if in_n >= 0 { jdoc_stringify(doc, in_n, false, 0) } else { "{}" }
                                if str_len(nm) > 0 { _tool_batch_push(mut batch, cid, nm, arg_s) }
                            }
                        }
                        cur = jdoc_next_sib(doc, cur)
                    }
                }
            }

            // 1c. Gemini: `/candidates/0/content/parts` array containing `{"functionCall":{"name":...,"args":{...}}}`
            if batch.count == 0 {
                parts := jdoc_path(doc, "/candidates/0/content/parts")
                if parts >= 0 and jdoc_type(doc, parts) == JVAL_ARRAY() {
                    mut cur := jdoc_first_child(doc, parts)
                    while cur >= 0 {
                        if jdoc_type(doc, cur) == JVAL_OBJECT() {
                            fc_n := jdoc_obj_get(doc, cur, "functionCall")
                            if fc_n >= 0 and jdoc_type(doc, fc_n) == JVAL_OBJECT() {
                                nm_n := jdoc_obj_get(doc, fc_n, "name")
                                nm := if nm_n >= 0 { jdoc_as_str(doc, nm_n, "") } else { "" }
                                ar_n := jdoc_obj_get(doc, fc_n, "args")
                                arg_s := if ar_n >= 0 { jdoc_stringify(doc, ar_n, false, 0) } else { "{}" }
                                if str_len(nm) > 0 { _tool_batch_push(mut batch, f"gem_{batch.count}", nm, arg_s) }
                            }
                        }
                        cur = jdoc_next_sib(doc, cur)
                    }
                }
            }
            jdoc_free(move doc)
            return batch
        }
        jdoc_free(move doc)
    }

    // 2. Lightweight XML `<tool name="...">...</tool>` tags (for local / non-JSON models)
    n := str_len(resp)
    mut pos := 0
    while pos < n and batch.count < 64 {
        p_tag := str_find(resp, "<tool ", pos)
        if p_tag < 0 { break }
        gt := str_find_byte(resp, 62, p_tag)
        end_t := if gt > p_tag { str_find(resp, "</tool>", gt + 1) } else { -1 }
        if gt < 0 or end_t < 0 { break }
        hdr := str_slice(resp, p_tag, gt)
        p_nm := str_find(hdr, "name=", 0)
        if p_nm >= 0 {
            mut q1 := str_find_byte(hdr, 34, p_nm + 5)
            mut qc := 34
            if q1 < 0 { q1 = str_find_byte(hdr, 39, p_nm + 5); qc = 39 }
            q2 := if q1 >= 0 { str_find_byte(hdr, qc, q1 + 1) } else { -1 }
            if q2 > q1 {
                nm := str_slice(hdr, q1 + 1, q2)
                body := str_trim(str_slice(resp, gt + 1, end_t))
                _tool_batch_push(mut batch, f"xml_{batch.count}", nm, body)
            }
        }
        pos = end_t + 7
    }
    return batch
}

fn harness_parse_tool_call(resp: str) -> ToolCall {
    batch := harness_parse_tool_calls_all(resp)
    mut res := ToolCall(found = false, id = "", name = "", args_json = "")
    if batch.count > 0 {
        tc0 := tool_batch_get(batch, 0)
        res = ToolCall(
            found = tc0.found,
            id = "" + tc0.id,
            name = "" + tc0.name,
            args_json = "" + tc0.args_json
        )
    }
    tool_batch_free(move batch)
    return res
}

// ==================== 4. JAILED WORKSPACE SANDBOX, O(N) REDACTOR, CACHE & INJECTION GUARD ====================

struct HarnessSandbox {
    workspace_root: str
    read_only: bool
    max_steps: i64
    steps_used: i64
    max_tool_bytes: i64
}

fn harness_sandbox_new(workspace_root: str, read_only: bool = false, max_steps: i64 = 24, max_tool_bytes: i64 = 16384) -> HarnessSandbox {
    mut mtb := max_tool_bytes
    if mtb < 256 { mtb = 256 }
    if mtb > 1048576 { mtb = 1048576 }
    return HarnessSandbox(
        workspace_root = workspace_root,
        read_only = read_only,
        max_steps = max_steps,
        steps_used = 0,
        max_tool_bytes = mtb
    )
}

fn harness_sandbox_consume_step(mut sb: HarnessSandbox) -> bool {
    if sb.steps_used >= sb.max_steps { return false }
    sb.steps_used += 1
    return true
}

@no_alloc
fn _harness_match_at(text: str, n: i64, pos: i64, pat: str) -> bool {
    plen := str_len(pat)
    if pos + plen > n { return false }
    mut i := 0
    while i < plen {
        if str_byte(text, pos + i) != str_byte(pat, i) { return false }
        i += 1
    }
    return true
}

@no_alloc
fn _harness_is_token_ch(b: i64) -> bool {
    if b >= 48 and b <= 57 { return true }
    if b >= 65 and b <= 90 { return true }
    if b >= 97 and b <= 122 { return true }
    return b == 45 or b == 95 or b == 46 or b == 43 or b == 47 or b == 61
}

// Scans text for leaked API keys, JWTs, Bearer tokens, and PEM private keys
fn harness_contains_secret(text: str) -> bool {
    if str_contains(text, "sk-proj-") or str_contains(text, "sk-ant-") or str_contains(text, "sk-live-") or str_contains(text, "sk_live_") or str_contains(text, "rk_live_") { return true }
    if str_contains(text, "ghp_") or str_contains(text, "gho_") or str_contains(text, "github_pat_") or str_contains(text, "AIzaSy") or str_contains(text, "AKIA") or str_contains(text, "ASIA") { return true }
    if str_contains(text, "xoxb-") or str_contains(text, "xoxp-") or str_contains(text, "Bearer ") or str_contains(text, "eyJhbGci") or str_contains(text, "PRIVATE KEY-----") { return true }
    return false
}

// O(N) single-pass zero-slice secret redactor (eliminates O(N^2) blowup on huge tool outputs!)
fn harness_redact_secrets(text: str) -> str {
    if not harness_contains_secret(text) { return text }
    n := str_len(text)
    out := buf_new(n * 3 + 64)
    mut i := 0
    while i < n {
        b := str_byte(text, i)
        // Quick first-byte dispatch to avoid checking all prefixes on every byte
        if b == 45 and _harness_match_at(text, n, i, "-----BEGIN ") {
            end_hdr := str_find(text, "PRIVATE KEY-----", i)
            if end_hdr >= 0 and end_hdr - i < 64 {
                end_pem := str_find(text, "-----END ", end_hdr + 16)
                mut skip_to := n
                if end_pem >= 0 {
                    end_dash := str_find(text, "-----", end_pem + 9)
                    if end_dash >= 0 { skip_to = end_dash + 5 }
                }
                buf_push_str(out, "[REDACTED_PRIVATE_KEY]")
                i = skip_to
                continue
            }
        }
        if b == 66 and _harness_match_at(text, n, i, "Bearer ") {
            buf_push_str(out, "Bearer [REDACTED]")
            mut j := i + 7
            while j < n and (str_byte(text, j) == 32 or str_byte(text, j) == 9) { j += 1 }
            while j < n and _harness_is_token_ch(str_byte(text, j)) { j += 1 }
            i = j
            continue
        }
        mut match_len := 0
        if b == 115 { // 's'
            if _harness_match_at(text, n, i, "sk-proj-") { match_len = 8 }
            else if _harness_match_at(text, n, i, "sk-ant-") { match_len = 7 }
            else if _harness_match_at(text, n, i, "sk-live-") { match_len = 8 }
            else if _harness_match_at(text, n, i, "sk_live_") { match_len = 8 }
        } else if b == 114 and _harness_match_at(text, n, i, "rk_live_") {
            match_len = 8
        } else if b == 103 { // 'g'
            if _harness_match_at(text, n, i, "ghp_") or _harness_match_at(text, n, i, "gho_") { match_len = 4 }
            else if _harness_match_at(text, n, i, "github_pat_") { match_len = 11 }
        } else if b == 65 { // 'A'
            if _harness_match_at(text, n, i, "AIzaSy") { match_len = 6 }
            else if _harness_match_at(text, n, i, "AKIA") or _harness_match_at(text, n, i, "ASIA") { match_len = 4 }
        } else if b == 101 and _harness_match_at(text, n, i, "eyJhbGci") {
            match_len = 8
        } else if b == 120 and (_harness_match_at(text, n, i, "xoxb-") or _harness_match_at(text, n, i, "xoxp-")) {
            match_len = 5
        }

        if match_len > 0 {
            mut j := i + match_len
            while j < n and _harness_is_token_ch(str_byte(text, j)) { j += 1 }
            buf_push_str(out, "[REDACTED]")
            i = j
        } else {
            buf_push(out, b)
            i += 1
        }
    }
    return buf_to_owned_str(move out)
}

// Detects indirect prompt-injection attempts inside untrusted tool/web outputs (case-insensitive)
fn harness_detect_prompt_injection(text: str) -> bool {
    low := str_to_lower(text)
    if str_contains(low, "ignore previous instructions") or str_contains(low, "ignore all previous") { return true }
    if str_contains(low, "disregard prior instructions") or str_contains(low, "disregard all previous") { return true }
    if str_contains(low, "<|im_start|>system") or str_contains(low, "begin system prompt") { return true }
    if str_contains(low, "you are now in developer mode") or str_contains(low, "override system prompt") { return true }
    return false
}

fn _harness_jail_resolve(root: str, rel_path: str) -> str ! i64 {
    full := path_join_safe(root, rel_path) or return err(403)
    root_abs := shutil_abspath(root)
    full_abs := shutil_abspath(full)
    if shutil_path_has_symlink(root_abs, full_abs) { return err(403) }
    return ok(full)
}

// Jailed workspace file read (blocks `..`, symlinks/junctions, drive-relative `C:foo`, UNC, Windows reserved device names)
fn harness_tool_read_file(mut sb: HarnessSandbox, rel_path: str) -> str ! i64 {
    if not harness_sandbox_consume_step(mut sb) { return err(429) }
    full := _harness_jail_resolve(sb.workspace_root, rel_path) or return err(403)
    st := shutil_stat(full)
    if st.exists and st.size > 16777216 { return err(413) }
    raw := fs_read_file(full) or return err(404)
    n := buf_len(raw)
    lim := if n > sb.max_tool_bytes { sb.max_tool_bytes } else { n }
    out := "" + buf_slice_str(raw, 0, lim)
    buf_free(move raw)
    return ok(out)
}

// FIXED: reads FULL file up to 16MB BEFORE slicing 1-based inclusive `start_line..end_line` (no 16KB pre-truncation bug!)
fn harness_tool_read_lines(mut sb: HarnessSandbox, rel_path: str, start_line: i64, end_line: i64) -> str ! i64 {
    if start_line < 1 or end_line < start_line { return err(400) }
    if not harness_sandbox_consume_step(mut sb) { return err(429) }
    full := _harness_jail_resolve(sb.workspace_root, rel_path) or return err(403)
    st := shutil_stat(full)
    if st.exists and st.size > 16777216 { return err(413) }
    raw := fs_read_file(full) or return err(404)
    n := buf_len(raw)
    if n > 16777216 { buf_free(move raw); return err(413) }
    content := buf_to_owned_str(move raw)
    out := buf_new(sb.max_tool_bytes + 128)
    mut line_no := 1
    mut i := 0
    while i < n and line_no <= end_line {
        mut nl := str_find_byte(content, 10, i)
        if nl < 0 { nl = n }
        if line_no >= start_line {
            mut line_end := nl
            if line_end > i and str_byte(content, line_end - 1) == 13 { line_end -= 1 }
            lstr := f"{line_no}: " + str_slice(content, i, line_end) + "\n"
            if buf_len(out) + str_len(lstr) > sb.max_tool_bytes { break }
            buf_push_str(out, lstr)
        }
        line_no += 1
        i = nl + 1
    }
    return ok(buf_to_owned_str(move out))
}

// Jailed workspace file write (atomic write + `read_only` mode + `path_join_safe` + symlink guard)
fn harness_tool_write_file(mut sb: HarnessSandbox, rel_path: str, content: str) -> i64 ! i64 {
    if sb.read_only { return err(403) }
    if not harness_sandbox_consume_step(mut sb) { return err(429) }
    full := _harness_jail_resolve(sb.workspace_root, rel_path) or return err(403)
    if not fs_atomic_write(full, content) { return err(500) }
    return ok(str_len(content))
}

// Jailed exact search-and-replace patch
fn harness_tool_edit_file(mut sb: HarnessSandbox, rel_path: str, target: str, replacement: str) -> bool ! i64 {
    if sb.read_only { return err(403) }
    if str_len(target) == 0 { return err(400) }
    if not harness_sandbox_consume_step(mut sb) { return err(429) }
    full := _harness_jail_resolve(sb.workspace_root, rel_path) or return err(403)
    st := shutil_stat(full)
    if st.exists and st.size > 8388608 { return err(413) }
    raw := fs_read_file(full) or return err(404)
    if buf_len(raw) > 8388608 { buf_free(move raw); return err(413) }
    src := buf_to_owned_str(move raw)
    pos := str_find(src, target, 0)
    if pos < 0 { return ok(false) }
    out := buf_new(str_len(src) + str_len(replacement) + 16)
    buf_push_str(out, str_slice(src, 0, pos))
    buf_push_str(out, replacement)
    buf_push_str(out, str_slice(src, pos + str_len(target), str_len(src)))
    updated := buf_to_owned_str(move out)
    if not fs_atomic_write(full, updated) { return err(500) }
    return ok(true)
}

// Strict ambiguity-checked edit with optional unified diff (rejects 0 matches -> 404, ambiguous >1 matches -> 409)
fn harness_tool_edit_strict(mut sb: HarnessSandbox, rel_path: str, target: str, replacement: str, replace_all: bool = false, show_diff: bool = false) -> str ! i64 {
    if sb.read_only { return err(403) }
    if str_len(target) == 0 { return err(400) }
    if not harness_sandbox_consume_step(mut sb) { return err(429) }
    full := _harness_jail_resolve(sb.workspace_root, rel_path) or return err(403)
    st := shutil_stat(full)
    if st.exists and st.size > 8388608 { return err(413) }
    raw := fs_read_file(full) or return err(404)
    if buf_len(raw) > 8388608 { buf_free(move raw); return err(413) }
    src := buf_to_owned_str(move raw)
    tlen := str_len(target)
    mut count := 0
    mut p := 0
    while true {
        f := str_find(src, target, p)
        if f < 0 { break }
        count += 1
        p = f + tlen
    }
    if count == 0 { return err(404) }
    if count > 1 and not replace_all { return err(409) }
    after := str_replace(src, target, replacement)
    if not fs_atomic_write(full, after) { return err(500) }
    if show_diff {
        return ok(diff_unified(src, after, "a/" + rel_path, "b/" + rel_path, 3))
    }
    return ok(f"OK: {count} replacement(s) in {rel_path}")
}

// FIXED: greps FULL file up to 16MB (no 16KB pre-truncation bug!), capping only returned match output
fn harness_tool_grep(mut sb: HarnessSandbox, rel_path: str, query: str, max_matches: i64 = 50) -> str ! i64 {
    if str_len(query) == 0 { return err(400) }
    if not harness_sandbox_consume_step(mut sb) { return err(429) }
    full := _harness_jail_resolve(sb.workspace_root, rel_path) or return err(403)
    st := shutil_stat(full)
    if st.exists and st.size > 16777216 { return err(413) }
    raw := fs_read_file(full) or return err(404)
    n := buf_len(raw)
    if n > 16777216 { buf_free(move raw); return err(413) }
    content := buf_to_owned_str(move raw)
    out := buf_new(sb.max_tool_bytes + 128)
    mut line_no := 1
    mut matches := 0
    mut i := 0
    while i < n and matches < max_matches {
        mut nl := str_find_byte(content, 10, i)
        if nl < 0 { nl = n }
        mut line_end := nl
        if line_end > i and str_byte(content, line_end - 1) == 13 { line_end -= 1 }
        line := str_slice(content, i, line_end)
        if str_contains(line, query) {
            entry := f"{line_no}: {line}\n"
            if buf_len(out) + str_len(entry) > sb.max_tool_bytes { break }
            buf_push_str(out, entry)
            matches += 1
        }
        line_no += 1
        i = nl + 1
    }
    return ok(buf_to_owned_str(move out))
}

fn _harness_is_safe_rel_arg(tok: str) -> bool {
    n := str_len(tok)
    if n == 0 or n > 160 { return false }
    c0 := str_byte(tok, 0)
    if c0 == 45 or c0 == 47 or c0 == 46 { return false } // no leading '-', '/', '.'
    mut i := 0
    while i < n {
        b := str_byte(tok, i)
        alnum := (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122)
        if not alnum and b != 95 and b != 46 and b != 47 and b != 45 { return false }
        if b == 46 and i + 1 < n and str_byte(tok, i + 1) == 46 { return false }
        i += 1
    }
    return true
}

fn _harness_is_digits(s: str) -> bool {
    n := str_len(s)
    if n == 0 or n > 6 { return false }
    mut i := 0
    while i < n {
        b := str_byte(s, i)
        if b < 48 or b > 57 { return false }
        i += 1
    }
    return true
}

fn _harness_parse_safe_argv(cmd: str) -> StrVec ! i64 {
    c := str_trim(cmd)
    n := str_len(c)
    if n == 0 or n > 256 { return err(403) }
    mut argv := svec_new(8, 256)
    mut i := 0
    while i < n {
        while i < n and str_byte(c, i) == 32 { i += 1 }
        if i >= n { break }
        start := i
        while i < n and str_byte(c, i) != 32 {
            b := str_byte(c, i)
            alnum := (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122)
            if not alnum and b != 95 and b != 46 and b != 47 and b != 45 {
                svec_free(move argv)
                return err(403)
            }
            if b == 46 and i + 1 < n and str_byte(c, i + 1) == 46 {
                svec_free(move argv)
                return err(403)
            }
            i += 1
        }
        svec_push(mut argv, str_slice(c, start, i))
        if svec_len(argv) > 8 { svec_free(move argv); return err(403) }
    }
    argc := svec_len(argv)
    if argc < 2 { svec_free(move argv); return err(403) }
    a0 := svec_get(argv, 0)
    a1 := svec_get(argv, 1)
    mut ok_cmd := false
    if str_eq(a0, "git") and str_eq(a1, "status") {
        ok_cmd = true
        mut k := 2
        while k < argc {
            t := svec_get(argv, k)
            if not (str_eq(t, "-s") or str_eq(t, "--short") or str_eq(t, "-b") or str_eq(t, "--branch") or str_eq(t, "--porcelain")) {
                ok_cmd = false; break
            }
            k += 1
        }
    } else if str_eq(a0, "git") and str_eq(a1, "diff") {
        ok_cmd = true
        mut k := 2
        while k < argc {
            t := svec_get(argv, k)
            if str_eq(t, "--stat") or str_eq(t, "--name-only") or str_eq(t, "--staged") or str_eq(t, "--cached") or str_eq(t, "--") or _harness_is_safe_rel_arg(t) {
                k += 1
            } else {
                ok_cmd = false; break
            }
        }
    } else if str_eq(a0, "git") and str_eq(a1, "log") {
        ok_cmd = true
        mut k := 2
        while k < argc {
            t := svec_get(argv, k)
            if str_eq(t, "--oneline") or str_eq(t, "--stat") or str_eq(t, "--") or _harness_is_safe_rel_arg(t) {
                k += 1
            } else if str_eq(t, "-n") and k + 1 < argc and _harness_is_digits(svec_get(argv, k + 1)) {
                k += 2
            } else if str_len(t) >= 2 and str_byte(t, 0) == 45 and _harness_is_digits(str_slice(t, 1, str_len(t))) {
                k += 1
            } else {
                ok_cmd = false; break
            }
        }
    } else if str_eq(a0, "bin/axc.exe") and (str_eq(a1, "check") or str_eq(a1, "test")) {
        if argc == 3 and _harness_is_safe_rel_arg(svec_get(argv, 2)) {
            ok_cmd = true
        } else if argc == 4 and str_eq(a1, "check") and str_eq(svec_get(argv, 2), "--json") and _harness_is_safe_rel_arg(svec_get(argv, 3)) {
            ok_cmd = true
        }
    }
    if not ok_cmd {
        svec_free(move argv)
        return err(403)
    }
    return ok(argv)
}

// Strict allowlist validator for agent commands (strict argv allowlist, ZERO shell execution — CWE-78 + CWE-88 immune!)
fn harness_is_safe_cmd(cmd: str) -> bool {
    argv := _harness_parse_safe_argv(cmd) or return false
    svec_free(move argv)
    return true
}

fn harness_tool_run_safe_cmd(mut sb: HarnessSandbox, cmd: str) -> str ! i64 {
    argv := _harness_parse_safe_argv(cmd) or return err(403)
    if not harness_sandbox_consume_step(mut sb) {
        svec_free(move argv)
        return err(429)
    }
    res := subproc_run(argv, sb.workspace_root, "", 15000, sb.max_tool_bytes)
    svec_free(move argv)
    mut raw := res.stdout
    if str_len(res.stderr) > 0 and str_len(res.stdout) > 0 {
        raw = res.stdout + res.stderr
    } else if str_len(res.stdout) == 0 {
        raw = res.stderr
    }
    trimmed := harness_truncate_middle(raw, sb.max_tool_bytes)
    return ok(harness_redact_secrets(trimmed))
}

// ==================== 4b. HIGH-SPEED TOOL RESULT CACHE (TTL + INVALIDATION) ====================

struct ToolResultCache {
    values: StrMap
    expires_ns: StrMap
    default_ttl_ns: i64
    hits: i64
    misses: i64
}

fn tool_cache_new(default_ttl_ms: i64 = 15000) -> ToolResultCache {
    mut dms := default_ttl_ms
    if dms <= 0 { dms = 15000 }
    if dms > 86400000 { dms = 86400000 }
    ttl := dms * 1000000
    return ToolResultCache(
        values = smap_new(64),
        expires_ns = smap_new(64),
        default_ttl_ns = ttl,
        hits = 0,
        misses = 0
    )
}

fn tool_cache_free(move c: ToolResultCache) {
    smap_free(move c.values)
    smap_free(move c.expires_ns)
}

fn tool_cache_put(mut c: ToolResultCache, key: str, val: str, ttl_ms: i64 = -1) {
    mut ttl_ns := c.default_ttl_ns
    if ttl_ms > 0 {
        mut tms := ttl_ms
        if tms > 86400000 { tms = 86400000 }
        ttl_ns = tms * 1000000
    }
    smap_set_str(mut c.values, key, val)
    smap_set_i64(mut c.expires_ns, key, clock_ns() + ttl_ns)
}

fn tool_cache_get(mut c: ToolResultCache, key: str) -> str ! i64 {
    if not smap_has(c.values, key) {
        c.misses += 1
        return err(404)
    }
    exp := smap_get_i64(c.expires_ns, key, 0)
    if clock_ns() > exp {
        _ := smap_remove(mut c.values, key)
        _ := smap_remove(mut c.expires_ns, key)
        c.misses += 1
        return err(404)
    }
    c.hits += 1
    return ok("" + smap_get_str(c.values, key, ""))
}

fn tool_cache_invalidate(mut c: ToolResultCache, key: str) {
    _ := smap_remove(mut c.values, key)
    _ := smap_remove(mut c.expires_ns, key)
}

// ==================== 5. RETRY POLICY, CIRCUIT BREAKER & MULTI-PROVIDER CALLERS ====================

struct HarnessRetryPolicy {
    max_retries: i64
    base_delay_ms: i64
    max_delay_ms: i64
}

fn harness_retry_default() -> HarnessRetryPolicy {
    return HarnessRetryPolicy(max_retries = 3, base_delay_ms = 250, max_delay_ms = 4000)
}

fn harness_is_retryable_status(status: i64) -> bool {
    return status == 0 or status == 429 or status == 500 or status == 502 or status == 503 or status == 504
}

fn harness_retry_delay_ms(pol: HarnessRetryPolicy, attempt: i64) -> i64 {
    mut d := pol.base_delay_ms
    mut i := 0
    while i < attempt and d < pol.max_delay_ms {
        d = d * 2
        i += 1
    }
    if d > pol.max_delay_ms { d = pol.max_delay_ms }
    return d
}

struct HarnessCircuitBreaker {
    fail_threshold: i64
    consecutive_fails: i64
    cooldown_ns: i64
    opened_at_ns: i64
    is_open: bool
}

fn harness_cb_new(fail_threshold: i64 = 5, cooldown_ms: i64 = 30000) -> HarnessCircuitBreaker {
    mut cms := cooldown_ms
    if cms < 100 { cms = 100 }
    if cms > 86400000 { cms = 86400000 }
    return HarnessCircuitBreaker(
        fail_threshold = if fail_threshold > 0 { fail_threshold } else { 5 },
        consecutive_fails = 0,
        cooldown_ns = cms * 1000000,
        opened_at_ns = 0,
        is_open = false
    )
}

fn harness_cb_allow(mut cb: HarnessCircuitBreaker) -> bool {
    if not cb.is_open { return true }
    if clock_ns() - cb.opened_at_ns >= cb.cooldown_ns {
        cb.is_open = false
        cb.consecutive_fails = 0
        return true
    }
    return false
}

fn harness_cb_record_ok(mut cb: HarnessCircuitBreaker) {
    cb.consecutive_fails = 0
    cb.is_open = false
}

fn harness_cb_record_fail(mut cb: HarnessCircuitBreaker) {
    cb.consecutive_fails += 1
    if cb.consecutive_fails >= cb.fail_threshold {
        cb.is_open = true
        cb.opened_at_ns = clock_ns()
    }
}

struct HarnessLlmResult {
    ok_flag: bool
    status: i64
    latency_us: i64
    raw_body: str
    content: str
    tool_call: ToolCall
}

fn harness_llm_call(host: str, port: i64, api_path: str, api_key: str, json_body: str) -> HarnessLlmResult {
    // Reject CRLF/NUL injection in api_key / host / api_path (CWE-113)
    if not tls_is_safe_http_token(host) or not tls_is_safe_http_token(api_path) {
        return HarnessLlmResult(ok_flag = false, status = 400, latency_us = 0, raw_body = "invalid_host_or_path", content = "", tool_call = ToolCall(found = false, id = "", name = "", args_json = ""))
    }
    if str_len(api_key) > 0 and not http_is_safe_header_val(api_key) {
        return HarnessLlmResult(ok_flag = false, status = 400, latency_us = 0, raw_body = "invalid_api_key", content = "", tool_call = ToolCall(found = false, id = "", name = "", args_json = ""))
    }
    t0 := clock_ns()
    hdr := if str_len(api_key) > 0 {
        "Content-Type: application/json\r\nAuthorization: Bearer " + api_key
    } else {
        "Content-Type: application/json"
    }
    resp := https_request("POST", host, port, api_path, hdr, json_body) or HttpsResponse(status = 0, body = "")
    el_us := (clock_ns() - t0) / 1000
    if resp.status < 200 or resp.status >= 300 {
        return HarnessLlmResult(
            ok_flag = false, status = resp.status, latency_us = el_us,
            raw_body = resp.body, content = "",
            tool_call = ToolCall(found = false, id = "", name = "", args_json = "")
        )
    }
    tc := harness_parse_tool_call(resp.body)
    txt := ai_extract_chat_content(resp.body) or ""
    return HarnessLlmResult(
        ok_flag = true, status = resp.status, latency_us = el_us,
        raw_body = resp.body, content = txt, tool_call = tc
    )
}

// Anthropic Messages HTTPS caller (CRLF-hardened)
fn harness_llm_call_anthropic(api_key: str, json_body: str) -> HarnessLlmResult {
    if str_len(api_key) == 0 or not http_is_safe_header_val(api_key) {
        return HarnessLlmResult(ok_flag = false, status = 400, latency_us = 0, raw_body = "invalid_api_key", content = "", tool_call = ToolCall(found = false, id = "", name = "", args_json = ""))
    }
    t0 := clock_ns()
    hdr := "Content-Type: application/json\r\nanthropic-version: 2023-06-01\r\nx-api-key: " + api_key
    resp := https_request("POST", "api.anthropic.com", 443, "/v1/messages", hdr, json_body) or HttpsResponse(status = 0, body = "")
    el_us := (clock_ns() - t0) / 1000
    if resp.status < 200 or resp.status >= 300 {
        return HarnessLlmResult(ok_flag = false, status = resp.status, latency_us = el_us, raw_body = resp.body, content = "", tool_call = ToolCall(found = false, id = "", name = "", args_json = ""))
    }
    tc := harness_parse_tool_call(resp.body)
    txt := json_get_str(resp.body, "text") or ""
    return HarnessLlmResult(ok_flag = true, status = resp.status, latency_us = el_us, raw_body = resp.body, content = txt, tool_call = tc)
}

// Resilient caller with automatic exponential backoff & circuit breaker
fn harness_llm_call_resilient(host: str, port: i64, api_path: str, api_key: str, json_body: str, pol: HarnessRetryPolicy, mut cb: HarnessCircuitBreaker) -> HarnessLlmResult {
    if not harness_cb_allow(mut cb) {
        return HarnessLlmResult(ok_flag = false, status = 503, latency_us = 0, raw_body = "circuit_open", content = "", tool_call = ToolCall(found = false, id = "", name = "", args_json = ""))
    }
    mut attempt := 0
    while attempt <= pol.max_retries {
        res := harness_llm_call(host, port, api_path, api_key, json_body)
        if res.ok_flag {
            harness_cb_record_ok(mut cb)
            return res
        }
        harness_cb_record_fail(mut cb)
        if not harness_is_retryable_status(res.status) or attempt == pol.max_retries {
            return res
        }
        sleep_ms(harness_retry_delay_ms(pol, attempt))
        attempt += 1
    }
    return HarnessLlmResult(ok_flag = false, status = 0, latency_us = 0, raw_body = "", content = "", tool_call = ToolCall(found = false, id = "", name = "", args_json = ""))
}

// ==================== 6. DETERMINISTIC EVAL SUITE SUMMARY ====================

struct EvalSuite {
    name: str
    total: i64
    passed: i64
    total_latency_us: i64
    total_in_tokens: i64
    total_out_tokens: i64
    total_steps: i64
    total_cost_micros: i64
}

fn eval_suite_new(name: str) -> EvalSuite {
    return EvalSuite(
        name = name, total = 0, passed = 0,
        total_latency_us = 0, total_in_tokens = 0, total_out_tokens = 0,
        total_steps = 0, total_cost_micros = 0
    )
}

fn eval_record(mut s: EvalSuite, passed: bool, latency_us: i64, in_toks: i64, out_toks: i64, steps: i64, cost_micros: i64 = 0) {
    s.total += 1
    if passed { s.passed += 1 }
    s.total_latency_us += latency_us
    s.total_in_tokens += in_toks
    s.total_out_tokens += out_toks
    s.total_steps += steps
    s.total_cost_micros += cost_micros
}

fn eval_pass_rate_pct(s: EvalSuite) -> i64 {
    if s.total <= 0 { return 0 }
    return (s.passed * 100) / s.total
}

fn eval_avg_latency_ms(s: EvalSuite) -> i64 {
    if s.total <= 0 { return 0 }
    return (s.total_latency_us / s.total) / 1000
}

fn eval_format_report(s: EvalSuite) -> str {
    pct := eval_pass_rate_pct(s)
    avg_ms := eval_avg_latency_ms(s)
    return f"[AXON AI HARNESS EVAL: {s.name}] pass={s.passed}/{s.total} ({pct}%) | avg_latency={avg_ms}ms | tokens_in={s.total_in_tokens} tokens_out={s.total_out_tokens} | steps={s.total_steps} | cost_micros={s.total_cost_micros}"
}
