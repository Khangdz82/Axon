// Axon Standard Library: Functional Iterators & Combinators (`std/itertools.ax`)
// 100% Pure Axon replacement for Python's `itertools` + `functools` (`map`, `filter`, `accumulate`,
// `chain`, `islice`, `repeat`, `takewhile`, `dropwhile`, `unique_everseen`, `any`, `all`).
// Powered by compile-time verified `fn_addr(f)` function pointers (`fn(i64) -> i64`).

use std::ds

fn iter_range(start: i64, stop: i64, step: i64 = 1) -> IntBuf {
    if step == 0 { return ibuf_new(1) }
    mut count := 0
    if step > 0 and stop > start {
        diff := stop - start
        count = ((diff - 1) / step) + 1
    } else if step < 0 and start > stop {
        if step == -9223372036854775807 - 1 { return ibuf_new(1) }
        diff := start - stop
        pos_step := 0 - step
        count = ((diff - 1) / pos_step) + 1
    }
    if count <= 0 { return ibuf_new(1) }
    if count > 16777216 { count = 16777216 }
    out := ibuf_new(count + 4)
    mut cur := start
    mut i := 0
    while i < count {
        ibuf_push(out, cur)
        cur = cur +% step
        i += 1
    }
    return out
}

fn iter_repeat(val: i64, times: i64) -> IntBuf {
    if times <= 0 { return ibuf_new(1) }
    mut n := times
    if n > 16777216 { n = 16777216 }
    out := ibuf_new(n + 4)
    mut i := 0
    while i < n {
        ibuf_push(out, val)
        i += 1
    }
    return out
}

fn iter_chain(a: IntBuf, b: IntBuf) -> IntBuf {
    na := ibuf_len(a)
    nb := ibuf_len(b)
    out := ibuf_new(na + nb + 4)
    mut i := 0
    while i < na { ibuf_push(out, ibuf_get(a, i)); i += 1 }
    i = 0
    while i < nb { ibuf_push(out, ibuf_get(b, i)); i += 1 }
    return out
}

fn iter_slice(a: IntBuf, start: i64, stop: i64, step: i64 = 1) -> IntBuf {
    n := ibuf_len(a)
    if step <= 0 or n <= 0 { return ibuf_new(1) }
    mut s := start
    if s < 0 { s = 0 }
    mut e := stop
    if e < 0 or e > n { e = n }
    if s >= e { return ibuf_new(1) }
    mut cnt := ((e - s - 1) / step) + 1
    if cnt > 16777216 { cnt = 16777216 }
    out := ibuf_new(cnt + 4)
    mut i := s
    mut taken := 0
    while i < e and taken < cnt {
        ibuf_push(out, ibuf_get(a, i))
        taken += 1
        if e - i <= step { break }
        i += step
    }
    return out
}

fn iter_accumulate(a: IntBuf) -> IntBuf {
    n := ibuf_len(a)
    if n <= 0 { return ibuf_new(1) }
    out := ibuf_new(n + 4)
    mut acc := 0
    mut i := 0
    while i < n {
        acc = acc +% ibuf_get(a, i)
        ibuf_push(out, acc)
        i += 1
    }
    return out
}

// Preserves first-seen order in O(N) using `DynMap` (Python `more_itertools.unique_everseen`).
fn iter_unique(a: IntBuf) -> IntBuf {
    n := ibuf_len(a)
    if n <= 0 { return ibuf_new(1) }
    out := ibuf_new(n + 4)
    mut seen := dmap_new(n * 2 + 16)
    mut i := 0
    while i < n {
        v := ibuf_get(a, i)
        if not dmap_contains(seen, v) {
            dmap_put(mut seen, v, 1)
            ibuf_push(out, v)
        }
        i += 1
    }
    dmap_free(move seen)
    return out
}

fn iter_map(a: IntBuf, fn_ptr: i64) -> IntBuf {
    n := ibuf_len(a)
    if n <= 0 or fn_ptr == 0 { return ibuf_new(1) }
    out := ibuf_new(n + 4)
    mut i := 0
    while i < n {
        ibuf_push(out, unsafe { fn_call1(fn_ptr, ibuf_get(a, i)) })
        i += 1
    }
    return out
}

fn iter_filter(a: IntBuf, pred_fn: i64) -> IntBuf {
    n := ibuf_len(a)
    if n <= 0 or pred_fn == 0 { return ibuf_new(1) }
    out := ibuf_new(n + 4)
    mut i := 0
    while i < n {
        v := ibuf_get(a, i)
        if unsafe { fn_call1(pred_fn, v) } != 0 {
            ibuf_push(out, v)
        }
        i += 1
    }
    return out
}

fn iter_take_while(a: IntBuf, pred_fn: i64) -> IntBuf {
    n := ibuf_len(a)
    if n <= 0 or pred_fn == 0 { return ibuf_new(1) }
    out := ibuf_new(n + 4)
    mut i := 0
    while i < n {
        v := ibuf_get(a, i)
        if unsafe { fn_call1(pred_fn, v) } == 0 { break }
        ibuf_push(out, v)
        i += 1
    }
    return out
}

fn iter_drop_while(a: IntBuf, pred_fn: i64) -> IntBuf {
    n := ibuf_len(a)
    if n <= 0 or pred_fn == 0 { return ibuf_new(1) }
    mut i := 0
    while i < n and unsafe { fn_call1(pred_fn, ibuf_get(a, i)) } != 0 {
        i += 1
    }
    out := ibuf_new(n - i + 4)
    while i < n {
        ibuf_push(out, ibuf_get(a, i))
        i += 1
    }
    return out
}

fn iter_any(a: IntBuf, pred_fn: i64) -> bool {
    if pred_fn == 0 { return false }
    n := ibuf_len(a)
    mut i := 0
    while i < n {
        if unsafe { fn_call1(pred_fn, ibuf_get(a, i)) } != 0 { return true }
        i += 1
    }
    return false
}

fn iter_all(a: IntBuf, pred_fn: i64) -> bool {
    if pred_fn == 0 { return false }
    n := ibuf_len(a)
    mut i := 0
    while i < n {
        if unsafe { fn_call1(pred_fn, ibuf_get(a, i)) } == 0 { return false }
        i += 1
    }
    return true
}

fn iter_sum(a: IntBuf) -> i64 {
    n := ibuf_len(a)
    mut s := 0
    mut i := 0
    while i < n {
        s = s +% ibuf_get(a, i)
        i += 1
    }
    return s
}
