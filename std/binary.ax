// Axon Binary Protocol & Packed C-Struct Codec (`std/binary.ax`)
// 100% Pure Axon: bounds-checked Little-Endian / Big-Endian binary reader & writer
// for network protocols, game packets, file formats, and C-ABI struct marshaling.

fn bw_u8(b: ByteBuf, v: i64) {
    buf_push(b, v & 255)
}

fn bw_u16_le(b: ByteBuf, v: i64) {
    buf_push(b, v & 255)
    buf_push(b, ushr64(v, 8) & 255)
}

fn bw_u16_be(b: ByteBuf, v: i64) {
    buf_push(b, ushr64(v, 8) & 255)
    buf_push(b, v & 255)
}

fn bw_u32_le(b: ByteBuf, v: i64) {
    buf_push(b, v & 255)
    buf_push(b, ushr64(v, 8) & 255)
    buf_push(b, ushr64(v, 16) & 255)
    buf_push(b, ushr64(v, 24) & 255)
}

fn bw_u32_be(b: ByteBuf, v: i64) {
    buf_push(b, ushr64(v, 24) & 255)
    buf_push(b, ushr64(v, 16) & 255)
    buf_push(b, ushr64(v, 8) & 255)
    buf_push(b, v & 255)
}

fn bw_u64_le(b: ByteBuf, v: i64) {
    bw_u32_le(b, v & 0xFFFFFFFF)
    bw_u32_le(b, ushr64(v, 32) & 0xFFFFFFFF)
}

fn bw_u64_be(b: ByteBuf, v: i64) {
    bw_u32_be(b, ushr64(v, 32) & 0xFFFFFFFF)
    bw_u32_be(b, v & 0xFFFFFFFF)
}

fn bw_str_u16_le(b: ByteBuf, s: str) {
    bw_u16_le(b, str_len(s))
    buf_push_str(b, s)
}

fn br_u8(b: ByteBuf, off: i64) -> i64 ! i64 {
    if off < 0 or off + 1 > buf_len(b) { return err(-1) }
    return ok(buf_get(b, off))
}

fn br_u16_le(b: ByteBuf, off: i64) -> i64 ! i64 {
    if off < 0 or off + 2 > buf_len(b) { return err(-1) }
    return ok(buf_get(b, off) | (buf_get(b, off + 1) << 8))
}

fn br_u16_be(b: ByteBuf, off: i64) -> i64 ! i64 {
    if off < 0 or off + 2 > buf_len(b) { return err(-1) }
    return ok((buf_get(b, off) << 8) | buf_get(b, off + 1))
}

fn br_u32_le(b: ByteBuf, off: i64) -> i64 ! i64 {
    if off < 0 or off + 4 > buf_len(b) { return err(-1) }
    v := buf_get(b, off) | (buf_get(b, off + 1) << 8) | (buf_get(b, off + 2) << 16) | (buf_get(b, off + 3) << 24)
    return ok(v)
}

fn br_u32_be(b: ByteBuf, off: i64) -> i64 ! i64 {
    if off < 0 or off + 4 > buf_len(b) { return err(-1) }
    v := (buf_get(b, off) << 24) | (buf_get(b, off + 1) << 16) | (buf_get(b, off + 2) << 8) | buf_get(b, off + 3)
    return ok(v)
}

fn br_i32_le(b: ByteBuf, off: i64) -> i64 ! i64 {
    v := br_u32_le(b, off) or return err(-1)
    if (v & 0x80000000) != 0 {
        return ok(v | -4294967296)
    }
    return ok(v)
}

fn br_u64_le(b: ByteBuf, off: i64) -> i64 ! i64 {
    if off < 0 or off + 8 > buf_len(b) { return err(-1) }
    lo := br_u32_le(b, off) or return err(-1)
    hi := br_u32_le(b, off + 4) or return err(-1)
    return ok(lo | (hi << 32))
}

fn br_u64_be(b: ByteBuf, off: i64) -> i64 ! i64 {
    if off < 0 or off + 8 > buf_len(b) { return err(-1) }
    hi := br_u32_be(b, off) or return err(-1)
    lo := br_u32_be(b, off + 4) or return err(-1)
    return ok((hi << 32) | lo)
}

fn br_str_u16_le(b: ByteBuf, off: i64) -> str ! i64 {
    n := br_u16_le(b, off) or return err(-1)
    if off + 2 + n > buf_len(b) { return err(-1) }
    return ok(buf_slice_str(b, off + 2, off + 2 + n))
}
