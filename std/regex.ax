// Axon Standard Library: Production Regular Expression Engine (`std/regex.ax`)
// 100% Pure Axon replacement for Python's `re` module (Zero External Dependencies):
// Supports:
//   - Literals, '.', '\d', '\D', '\w', '\W', '\s', '\S', '\n', '\r', '\t', '\f', '\v', '\b', '\B'
//   - Character classes `[a-z]`, `[abc]`, `[^0-9]`, `[]a]` with ranges & escapes
//   - Anchors `^` and `$`
//   - Quantifiers `*`, `+`, `?`, `{m}`, `{m,}`, `{m,n}`
//   - Grouping `(...)` and `(?:...)` with nested alternation `|` and group quantifiers
//   - Case-insensitive mode `(?i)` / `regex_compile_flags(pat, true)`
//   - Compiled regex reuse (`regex_find_compiled`, `regex_is_match_compiled`), `regex_find_all`,
//     `regex_replace_all`, `regex_split`, `regex_escape`, and strict ReDoS fuel & recursion guards.

use std::os
use std::str
use std::ds

struct RegexMatch {
    start: i64
    end: i64
    len: i64
}

// Bytecode Opcodes for Regex VM:
//   1  OP_CHAR:          [1, ch]
//   2  OP_ANY:           [2]
//   3..8 OP_CLASS:       [op] (\d,\D,\w,\W,\s,\S)
//   11 OP_START:         [11] (^)
//   12 OP_END:           [12] ($)
//   13 OP_WORD_BOUND:    [13] (\b)
//   14 OP_NON_WBOUND:    [14] (\B)
//   20 OP_REP_ANY:       [20, min_r, max_r]  (max_r = -1 for unbounded)
//   30 OP_REP_CHAR:      [30, ch, min_r, max_r]
//   40 OP_REP_CLASS:     [40, cls_op, min_r, max_r]
//   60 OP_CHARSET:       [60, is_neg, min_r, max_r, item_count, lo0, hi0, ...]
//   70 OP_ALT:           [70, alt2_pc]
//   71 OP_JMP:           [71, target_pc]
//   80 OP_GROUP:         [80, body_end_pc, min_r, max_r] ... body ... [254 OP_END_GROUP]
//   254 OP_END_GROUP:    [254]
//   255 OP_MATCH:        [255]

struct Regex {
    code: IntBuf
    has_start_anchor: bool
    has_end_anchor: bool
    ignore_case: bool
}

@no_alloc
fn _rx_lower(ch: i64) -> i64 {
    if ch >= 65 and ch <= 90 { return ch + 32 }
    return ch
}

@no_alloc
fn rx_is_digit(ch: i64) -> bool {
    return ch >= 48 and ch <= 57
}

@no_alloc
fn rx_is_word(ch: i64) -> bool {
    return (ch >= 65 and ch <= 90) or (ch >= 97 and ch <= 122) or (ch >= 48 and ch <= 57) or ch == 95
}

@no_alloc
fn rx_is_space(ch: i64) -> bool {
    return ch == 32 or ch == 9 or ch == 10 or ch == 13 or ch == 12 or ch == 11
}

@no_alloc
fn rx_match_class(op: i64, ch: i64) -> bool {
    if op == 3 { return rx_is_digit(ch) }
    if op == 4 { return not rx_is_digit(ch) }
    if op == 5 { return rx_is_word(ch) }
    if op == 6 { return not rx_is_word(ch) }
    if op == 7 { return rx_is_space(ch) }
    if op == 8 { return not rx_is_space(ch) }
    return false
}

fn _rx_decode_escape_byte(esc: i64) -> i64 {
    if esc == 110 { return 10 } // \n
    if esc == 114 { return 13 } // \r
    if esc == 116 { return 9 }  // \t
    if esc == 102 { return 12 } // \f
    if esc == 118 { return 11 } // \v
    return esc
}

fn rx_class_op_for_escape(esc: i64) -> i64 {
    if esc == 100 { return 3 } // \d
    if esc == 68  { return 4 } // \D
    if esc == 119 { return 5 } // \w
    if esc == 87  { return 6 } // \W
    if esc == 115 { return 7 } // \s
    if esc == 83  { return 8 } // \S
    return 1
}

fn rx_find_close_bracket(pattern: str, start: i64, limit: i64) -> i64 {
    mut p := start
    if p < limit and str_byte(pattern, p) == 94 { p += 1 }
    if p < limit and str_byte(pattern, p) == 93 { p += 1 } // literal ']' as first char inside [...]
    while p < limit {
        b := str_byte(pattern, p)
        if b == 92 and p + 1 < limit {
            p += 2
        } else if b == 93 {
            return p
        } else {
            p += 1
        }
    }
    return -1
}

fn _rx_find_close_paren(pattern: str, start: i64, limit: i64) -> i64 {
    mut p := start
    mut depth := 1
    mut in_br := false
    while p < limit {
        b := str_byte(pattern, p)
        if b == 92 and p + 1 < limit {
            p += 2
            continue
        }
        if in_br {
            if b == 93 { in_br = false }
            p += 1
            continue
        }
        if b == 91 {
            in_br = true
            // Skip optional '^' and leading ']' inside bracket
            p += 1
            if p < limit and str_byte(pattern, p) == 94 { p += 1 }
            if p < limit and str_byte(pattern, p) == 93 { p += 1 }
            continue
        }
        if b == 40 { depth += 1 }
        else if b == 41 {
            depth -= 1
            if depth == 0 { return p }
        }
        p += 1
    }
    return -1
}

// Parse quantifier at `pos`: returns `(consumed_bytes, min_rep, max_rep)` where `max_rep = -1` means unbounded
fn _rx_parse_quant(pattern: str, pos: i64, limit: i64) -> (i64, i64, i64) {
    if pos >= limit { return (0, 1, 1) }
    qb := str_byte(pattern, pos)
    if qb == 42 { return (1, 0, -1) } // *
    if qb == 43 { return (1, 1, -1) } // +
    if qb == 63 { return (1, 0, 1) }  // ?
    if qb == 123 { // '{m}', '{m,}', '{m,n}'
        mut p := pos + 1
        mut m_val := 0
        mut m_dig := 0
        while p < limit and str_byte(pattern, p) >= 48 and str_byte(pattern, p) <= 57 {
            if m_val < 10000 { m_val = m_val * 10 + (str_byte(pattern, p) - 48) }
            m_dig += 1
            p += 1
        }
        if m_dig == 0 or p >= limit { return (0, 1, 1) }
        if str_byte(pattern, p) == 125 { // '{m}'
            if m_val > 10000 { m_val = 10000 }
            return (p + 1 - pos, m_val, m_val)
        }
        if str_byte(pattern, p) == 44 { // ','
            p += 1
            if p < limit and str_byte(pattern, p) == 125 { // '{m,}'
                if m_val > 10000 { m_val = 10000 }
                return (p + 1 - pos, m_val, -1)
            }
            mut n_val := 0
            mut n_dig := 0
            while p < limit and str_byte(pattern, p) >= 48 and str_byte(pattern, p) <= 57 {
                if n_val < 10000 { n_val = n_val * 10 + (str_byte(pattern, p) - 48) }
                n_dig += 1
                p += 1
            }
            if n_dig > 0 and p < limit and str_byte(pattern, p) == 125 {
                if n_val > 10000 { n_val = 10000 }
                if n_val < m_val { return (-1, 0, 0) }
                return (p + 1 - pos, m_val, n_val)
            }
        }
    }
    return (0, 1, 1)
}

struct RxBuild {
    code: IntBuf
    cap: i64
}

fn _rx_ensure_code(mut b: RxBuild, need: i64) {
    if ibuf_len(b.code) + need <= b.cap { return }
    mut nc := b.cap * 2
    while nc < ibuf_len(b.code) + need + 32 { nc = nc * 2 }
    nb := ibuf_new(nc)
    cur := ibuf_len(b.code)
    mut i := 0
    while i < cur { ibuf_push(nb, ibuf_get(b.code, i)); i += 1 }
    buf_free(move b.code)
    b.code = nb
    b.cap = nc
}

fn _rx_compile_expr(pattern: str, s: i64, e: i64, mut b: RxBuild, gdepth: i64) -> i64 {
    if gdepth > 32 { return -1 }
    mut branches := ibuf_new(16)
    mut bcap := 16
    mut seg_start := s
    mut k := s
    mut pdepth := 0
    mut in_br := false
    while k < e {
        ch := str_byte(pattern, k)
        if ch == 92 and k + 1 < e {
            k += 2
            continue
        }
        if in_br {
            if ch == 93 { in_br = false }
            k += 1
            continue
        }
        if ch == 91 {
            in_br = true
            k += 1
            if k < e and str_byte(pattern, k) == 94 { k += 1 }
            if k < e and str_byte(pattern, k) == 93 { k += 1 }
            continue
        }
        if ch == 40 { pdepth += 1; k += 1; continue }
        if ch == 41 {
            if pdepth <= 0 { buf_free(move branches); return -1 }
            pdepth -= 1; k += 1; continue
        }
        if ch == 124 and pdepth == 0 {
            if ibuf_len(branches) + 4 > bcap {
                nb := ibuf_new(bcap * 2)
                mut bi := 0
                while bi < ibuf_len(branches) { ibuf_push(nb, ibuf_get(branches, bi)); bi += 1 }
                buf_free(move branches)
                branches = nb
                bcap = bcap * 2
            }
            ibuf_push(branches, seg_start)
            ibuf_push(branches, k)
            seg_start = k + 1
        }
        k += 1
    }
    if pdepth != 0 or in_br {
        buf_free(move branches)
        return -1
    }
    if ibuf_len(branches) + 4 > bcap {
        nb := ibuf_new(bcap * 2)
        mut bi := 0
        while bi < ibuf_len(branches) { ibuf_push(nb, ibuf_get(branches, bi)); bi += 1 }
        buf_free(move branches)
        branches = nb
        bcap = bcap * 2
    }
    ibuf_push(branches, seg_start)
    ibuf_push(branches, e)

    num_br := ibuf_len(branches) / 2
    if num_br == 1 {
        bs := ibuf_get(branches, 0)
        be := ibuf_get(branches, 1)
        buf_free(move branches)
        return _rx_compile_seq(pattern, bs, be, mut b, gdepth)
    }

    jmp_slots := ibuf_new(num_br + 4)
    mut bi := 0
    while bi < num_br {
        bs := ibuf_get(branches, bi * 2)
        be := ibuf_get(branches, bi * 2 + 1)
        mut alt_patch := -1
        if bi < num_br - 1 {
            _rx_ensure_code(mut b, 4)
            ibuf_push(b.code, 70) // OP_ALT
            alt_patch = ibuf_len(b.code)
            ibuf_push(b.code, 0)
        }
        fl := _rx_compile_seq(pattern, bs, be, mut b, gdepth)
        if fl < 0 {
            buf_free(move jmp_slots)
            buf_free(move branches)
            return -1
        }
        if bi < num_br - 1 {
            _rx_ensure_code(mut b, 4)
            ibuf_push(b.code, 71) // OP_JMP
            ibuf_push(jmp_slots, ibuf_len(b.code))
            ibuf_push(b.code, 0)
            ibuf_set(b.code, alt_patch, ibuf_len(b.code))
        }
        bi += 1
    }
    end_pc := ibuf_len(b.code)
    mut ji := 0
    while ji < ibuf_len(jmp_slots) {
        ibuf_set(b.code, ibuf_get(jmp_slots, ji), end_pc)
        ji += 1
    }
    buf_free(move jmp_slots)
    buf_free(move branches)
    return 0
}

fn _rx_compile_seq(pattern: str, b_start: i64, b_end: i64, mut b: RxBuild, gdepth: i64) -> i64 {
    mut i := b_start
    mut flags := 0

    while i < b_end {
        ch := str_byte(pattern, i)
        if ch == 94 and i == b_start { // '^'
            flags = flags | 1
            _rx_ensure_code(mut b, 2)
            ibuf_push(b.code, 11)
            i += 1
            continue
        }
        if ch == 36 and i == b_end - 1 { // '$'
            flags = flags | 2
            _rx_ensure_code(mut b, 2)
            ibuf_push(b.code, 12)
            i += 1
            break
        }
        if ch == 40 { // '(' group
            close_p := _rx_find_close_paren(pattern, i + 1, b_end)
            if close_p < 0 { return -1 }
            mut inner_s := i + 1
            if inner_s + 1 < close_p and str_byte(pattern, inner_s) == 63 and str_byte(pattern, inner_s + 1) == 58 {
                inner_s += 2
            }
            (qlen, min_r, max_r) := _rx_parse_quant(pattern, close_p + 1, b_end)
            if qlen < 0 { return -1 }
            if qlen == 0 and min_r == 1 and max_r == 1 {
                fl := _rx_compile_expr(pattern, inner_s, close_p, mut b, gdepth + 1)
                if fl < 0 { return -1 }
            } else {
                _rx_ensure_code(mut b, 8)
                hdr_pc := ibuf_len(b.code)
                ibuf_push(b.code, 80)    // OP_GROUP
                ibuf_push(b.code, 0)     // body_end_pc placeholder
                ibuf_push(b.code, min_r)
                ibuf_push(b.code, max_r)
                fl := _rx_compile_expr(pattern, inner_s, close_p, mut b, gdepth + 1)
                if fl < 0 { return -1 }
                _rx_ensure_code(mut b, 4)
                ibuf_push(b.code, 254)   // OP_END_GROUP
                ibuf_set(b.code, hdr_pc + 1, ibuf_len(b.code))
            }
            i = close_p + 1 + qlen
            continue
        }
        if ch == 46 { // '.'
            (qlen, min_r, max_r) := _rx_parse_quant(pattern, i + 1, b_end)
            if qlen < 0 { return -1 }
            _rx_ensure_code(mut b, 6)
            if qlen == 0 {
                ibuf_push(b.code, 2)
            } else {
                ibuf_push(b.code, 20); ibuf_push(b.code, min_r); ibuf_push(b.code, max_r)
            }
            i = i + 1 + qlen
            continue
        }
        if ch == 92 { // '\'
            if i + 1 >= b_end { return -1 }
            esc := str_byte(pattern, i + 1)
            if esc == 98 {
                _rx_ensure_code(mut b, 2)
                ibuf_push(b.code, 13)
                i += 2
                continue
            }
            if esc == 66 {
                _rx_ensure_code(mut b, 2)
                ibuf_push(b.code, 14)
                i += 2
                continue
            }
            op := rx_class_op_for_escape(esc)
            (qlen, min_r, max_r) := _rx_parse_quant(pattern, i + 2, b_end)
            if qlen < 0 { return -1 }
            _rx_ensure_code(mut b, 6)
            if op == 1 {
                lit := _rx_decode_escape_byte(esc)
                if qlen == 0 {
                    ibuf_push(b.code, 1); ibuf_push(b.code, lit)
                } else {
                    ibuf_push(b.code, 30); ibuf_push(b.code, lit); ibuf_push(b.code, min_r); ibuf_push(b.code, max_r)
                }
            } else {
                if qlen == 0 {
                    ibuf_push(b.code, op)
                } else {
                    ibuf_push(b.code, 40); ibuf_push(b.code, op); ibuf_push(b.code, min_r); ibuf_push(b.code, max_r)
                }
            }
            i = i + 2 + qlen
            continue
        }
        if ch == 91 { // '['
            close_idx := rx_find_close_bracket(pattern, i + 1, b_end)
            if close_idx < 0 { return -1 }
            mut r_start := i + 1
            mut is_neg := 0
            if r_start < close_idx and str_byte(pattern, r_start) == 94 {
                is_neg = 1
                r_start += 1
            }
            if r_start >= close_idx { return -1 }
            (qlen, min_r, max_r) := _rx_parse_quant(pattern, close_idx + 1, b_end)
            if qlen < 0 { return -1 }

            _rx_ensure_code(mut b, (close_idx - r_start) * 2 + 12)
            hdr_pc := ibuf_len(b.code)
            ibuf_push(b.code, 60)     // OP_CHARSET
            ibuf_push(b.code, is_neg)
            ibuf_push(b.code, min_r)
            ibuf_push(b.code, max_r)
            ibuf_push(b.code, 0)      // item_count placeholder

            mut item_count := 0
            mut p := r_start
            while p < close_idx {
                cb := str_byte(pattern, p)
                if cb == 92 and p + 1 < close_idx {
                    esc := str_byte(pattern, p + 1)
                    cls := rx_class_op_for_escape(esc)
                    if cls != 1 {
                        ibuf_push(b.code, 0 - cls)
                        ibuf_push(b.code, 0)
                    } else {
                        lit := _rx_decode_escape_byte(esc)
                        ibuf_push(b.code, lit)
                        ibuf_push(b.code, lit)
                    }
                    item_count += 1
                    p += 2
                } else if p + 2 < close_idx and str_byte(pattern, p + 1) == 45 {
                    lo := cb
                    mut hi := str_byte(pattern, p + 2)
                    mut adv := 3
                    if hi == 92 and p + 3 < close_idx {
                        hi = _rx_decode_escape_byte(str_byte(pattern, p + 3))
                        adv = 4
                    }
                    if lo > hi { return -1 }
                    ibuf_push(b.code, lo)
                    ibuf_push(b.code, hi)
                    item_count += 1
                    p += adv
                } else {
                    ibuf_push(b.code, cb)
                    ibuf_push(b.code, cb)
                    item_count += 1
                    p += 1
                }
            }
            ibuf_set(b.code, hdr_pc + 4, item_count)
            i = close_idx + 1 + qlen
            continue
        }
        if ch == 42 or ch == 43 or ch == 63 or ch == 41 {
            return -1
        }
        (qlen, min_r, max_r) := _rx_parse_quant(pattern, i + 1, b_end)
        if qlen < 0 { return -1 }
        _rx_ensure_code(mut b, 6)
        if qlen == 0 {
            ibuf_push(b.code, 1); ibuf_push(b.code, ch)
        } else {
            ibuf_push(b.code, 30); ibuf_push(b.code, ch); ibuf_push(b.code, min_r); ibuf_push(b.code, max_r)
        }
        i = i + 1 + qlen
    }
    return flags
}

fn regex_compile_flags(pattern: str, ignore_case: bool = false) -> Regex ! i64 {
    mut pat := pattern
    mut ci := ignore_case
    if str_starts_with(pat, "(?i)") {
        ci = true
        pat = str_slice(pat, 4, str_len(pat))
    }
    n := str_len(pat)
    if n > 65536 { return err(413) }
    if n == 0 {
        code := ibuf_new(4)
        ibuf_push(code, 255)
        return ok(Regex(code = code, has_start_anchor = false, has_end_anchor = false, ignore_case = ci))
    }
    init_cap := n * 8 + 64
    mut rb := RxBuild(code = ibuf_new(init_cap), cap = init_cap)
    fl := _rx_compile_expr(pat, 0, n, mut rb, 0)
    if fl < 0 {
        buf_free(move rb.code)
        return err(400)
    }
    _rx_ensure_code(mut rb, 2)
    ibuf_push(rb.code, 255)
    return ok(Regex(
        code = rb.code,
        has_start_anchor = (fl & 1) != 0,
        has_end_anchor = (fl & 2) != 0,
        ignore_case = ci
    ))
}

fn regex_compile(pattern: str) -> Regex ! i64 {
    return regex_compile_flags(pattern, false)
}

fn regex_free(move rx: Regex) {
    buf_free(move rx.code)
}

fn rx_consume_fuel(fuel: IntBuf, cost: i64) -> bool {
    rem := ibuf_get(fuel, 0)
    if rem < cost {
        ibuf_set(fuel, 0, 0)
        return false
    }
    ibuf_set(fuel, 0, rem - cost)
    return true
}

fn rx_match_charset(code: IntBuf, pc: i64, ch: i64, ci: bool) -> bool {
    is_neg := ibuf_get(code, pc + 1)
    item_count := ibuf_get(code, pc + 4)
    tc := if ci { _rx_lower(ch) } else { ch }
    mut in_set := false
    mut k := 0
    while k < item_count {
        lo := ibuf_get(code, pc + 5 + k * 2)
        hi := ibuf_get(code, pc + 6 + k * 2)
        if lo < 0 {
            if rx_match_class(0 - lo, ch) { in_set = true; break }
        } else if ci {
            if (tc >= _rx_lower(lo) and tc <= _rx_lower(hi)) or (ch >= lo and ch <= hi) {
                in_set = true; break
            }
        } else if ch >= lo and ch <= hi {
            in_set = true; break
        }
        k += 1
    }
    if is_neg == 1 { return not in_set }
    return in_set
}

fn _rx_at_word_bound(text_p: i64, tlen: i64, tp: i64) -> bool {
    unsafe {
        left_w := tp > 0 and rx_is_word(ptr_read_u8(text_p + tp - 1, 0))
        right_w := tp < tlen and rx_is_word(ptr_read_u8(text_p + tp, 0))
        return left_w != right_w
    }
}

fn _rx_exec_group(code: IntBuf, body_pc: i64, after_pc: i64, min_r: i64, max_r: i64, reps: i64, text: str, tp: i64, fuel: IntBuf, depth: i64, ci: bool) -> i64 {
    if depth > 128 { return -2 }
    if not rx_consume_fuel(fuel, 1) { return -2 }
    // Greedy: try matching one more repetition if allowed
    if max_r < 0 or reps < max_r {
        g_len := rx_exec_vm(code, body_pc, text, tp, fuel, depth + 1, ci)
        if g_len == -2 { return -2 }
        if g_len > 0 or (g_len == 0 and reps < min_r) {
            // Prevent infinite 0-width repetition loops when `reps >= min_r`
            r_more := _rx_exec_group(code, body_pc, after_pc, min_r, max_r, reps + 1, text, tp + g_len, fuel, depth + 1, ci)
            if r_more == -2 { return -2 }
            if r_more >= 0 { return g_len + r_more }
        }
    }
    if reps >= min_r {
        return rx_exec_vm(code, after_pc, text, tp, fuel, depth + 1, ci)
    }
    return -1
}

fn rx_exec_vm(code: IntBuf, start_pc: i64, text: str, text_start: i64, fuel: IntBuf, depth: i64 = 0, ci: bool = false) -> i64 {
    unsafe {
    if depth > 128 { return -2 }
    tlen := str_len(text)
    if text_start < 0 or text_start > tlen { return -1 }
    mut pc := start_pc
    mut tp := text_start
    clen := ibuf_len(code)
    text_p := text as i64

    while pc >= 0 and pc < clen {
        if not rx_consume_fuel(fuel, 1) { return -2 }
        op := ibuf_get(code, pc)

        if op == 255 or op == 254 { // OP_MATCH or OP_END_GROUP
            return tp - text_start
        } else if op == 71 { // OP_JMP
            pc = ibuf_get(code, pc + 1)
        } else if op == 70 { // OP_ALT
            alt_pc := ibuf_get(code, pc + 1)
            r1 := rx_exec_vm(code, pc + 2, text, tp, fuel, depth + 1, ci)
            if r1 == -2 { return -2 }
            if r1 >= 0 { return (tp - text_start) + r1 }
            pc = alt_pc
        } else if op == 80 { // OP_GROUP
            after_pc := ibuf_get(code, pc + 1)
            min_r := ibuf_get(code, pc + 2)
            max_r := ibuf_get(code, pc + 3)
            rg := _rx_exec_group(code, pc + 4, after_pc, min_r, max_r, 0, text, tp, fuel, depth + 1, ci)
            if rg == -2 { return -2 }
            if rg >= 0 { return (tp - text_start) + rg }
            return -1
        } else if op == 11 { // ^
            if tp != 0 { return -1 }
            pc += 1
        } else if op == 12 { // $
            if tp != tlen { return -1 }
            pc += 1
        } else if op == 13 { // \b
            if not _rx_at_word_bound(text_p, tlen, tp) { return -1 }
            pc += 1
        } else if op == 14 { // \B
            if _rx_at_word_bound(text_p, tlen, tp) { return -1 }
            pc += 1
        } else if op == 1 { // OP_CHAR
            while pc + 1 < clen and ibuf_get(code, pc) == 1 {
                expected := ibuf_get(code, pc + 1)
                if tp >= tlen { return -1 }
                actual := ptr_read_u8(text_p + tp, 0)
                ok_c := if ci { _rx_lower(actual) == _rx_lower(expected) } else { actual == expected }
                if not ok_c { return -1 }
                tp += 1
                pc += 2
                if not rx_consume_fuel(fuel, 1) { return -2 }
            }
        } else if op == 2 { // OP_ANY
            if tp >= tlen { return -1 }
            ch := ptr_read_u8(text_p + tp, 0)
            if ch == 10 or ch == 13 { return -1 }
            tp += 1
            pc += 1
        } else if op >= 3 and op <= 8 { // OP_CLASS
            if tp >= tlen or not rx_match_class(op, ptr_read_u8(text_p + tp, 0)) { return -1 }
            tp += 1
            pc += 1
        } else if op == 20 { // OP_REP_ANY
            min_r := ibuf_get(code, pc + 1)
            max_r := ibuf_get(code, pc + 2)
            mut max_cap := tlen - tp
            if max_r >= 0 and max_r < max_cap { max_cap = max_r }
            mut count := 0
            while count < max_cap and tp + count < tlen {
                if not rx_consume_fuel(fuel, 1) { return -2 }
                ch := ptr_read_u8(text_p + tp + count, 0)
                if ch == 10 or ch == 13 { break }
                count += 1
            }
            if count < min_r { return -1 }
            mut try_cnt := count
            while try_cnt >= min_r {
                sub_res := rx_exec_vm(code, pc + 3, text, tp + try_cnt, fuel, depth + 1, ci)
                if sub_res == -2 { return -2 }
                if sub_res >= 0 { return (tp - text_start) + try_cnt + sub_res }
                try_cnt -= 1
            }
            return -1
        } else if op == 30 { // OP_REP_CHAR
            expected := ibuf_get(code, pc + 1)
            exp_low := _rx_lower(expected)
            min_r := ibuf_get(code, pc + 2)
            max_r := ibuf_get(code, pc + 3)
            mut max_cap := tlen - tp
            if max_r >= 0 and max_r < max_cap { max_cap = max_r }
            mut count := 0
            while count < max_cap and tp + count < tlen {
                actual := ptr_read_u8(text_p + tp + count, 0)
                ok_c := if ci { _rx_lower(actual) == exp_low } else { actual == expected }
                if not ok_c { break }
                if not rx_consume_fuel(fuel, 1) { return -2 }
                count += 1
            }
            if count < min_r { return -1 }
            mut try_cnt := count
            while try_cnt >= min_r {
                sub_res := rx_exec_vm(code, pc + 4, text, tp + try_cnt, fuel, depth + 1, ci)
                if sub_res == -2 { return -2 }
                if sub_res >= 0 { return (tp - text_start) + try_cnt + sub_res }
                try_cnt -= 1
            }
            return -1
        } else if op == 40 { // OP_REP_CLASS
            cls_op := ibuf_get(code, pc + 1)
            min_r := ibuf_get(code, pc + 2)
            max_r := ibuf_get(code, pc + 3)
            mut max_cap := tlen - tp
            if max_r >= 0 and max_r < max_cap { max_cap = max_r }
            mut count := 0
            while count < max_cap and tp + count < tlen and rx_match_class(cls_op, ptr_read_u8(text_p + tp + count, 0)) {
                if not rx_consume_fuel(fuel, 1) { return -2 }
                count += 1
            }
            if count < min_r { return -1 }
            mut try_cnt := count
            while try_cnt >= min_r {
                sub_res := rx_exec_vm(code, pc + 4, text, tp + try_cnt, fuel, depth + 1, ci)
                if sub_res == -2 { return -2 }
                if sub_res >= 0 { return (tp - text_start) + try_cnt + sub_res }
                try_cnt -= 1
            }
            return -1
        } else if op == 60 { // OP_CHARSET
            min_r := ibuf_get(code, pc + 2)
            max_r := ibuf_get(code, pc + 3)
            item_count := ibuf_get(code, pc + 4)
            next_pc := pc + 5 + item_count * 2
            item_cost := if item_count > 1 { item_count } else { 1 }
            if min_r == 1 and max_r == 1 {
                if not rx_consume_fuel(fuel, item_cost) { return -2 }
                if tp >= tlen or not rx_match_charset(code, pc, ptr_read_u8(text_p + tp, 0), ci) { return -1 }
                tp += 1
                pc = next_pc
            } else {
                mut max_cap := tlen - tp
                if max_r >= 0 and max_r < max_cap { max_cap = max_r }
                mut count := 0
                while count < max_cap and tp + count < tlen {
                    if not rx_consume_fuel(fuel, item_cost) { return -2 }
                    if not rx_match_charset(code, pc, ptr_read_u8(text_p + tp + count, 0), ci) { break }
                    count += 1
                }
                if count < min_r { return -1 }
                mut try_cnt := count
                while try_cnt >= min_r {
                    sub_res := rx_exec_vm(code, next_pc, text, tp + try_cnt, fuel, depth + 1, ci)
                    if sub_res == -2 { return -2 }
                    if sub_res >= 0 { return (tp - text_start) + try_cnt + sub_res }
                    try_cnt -= 1
                }
                return -1
            }
        } else {
            return -1
        }
    }
    return tp - text_start
    }
}

fn _regex_make_fuel(tlen: i64) -> IntBuf {
    fuel := ibuf_new(1)
    mut budget := tlen * 8
    if budget < 40000 { budget = 40000 }
    if budget > 2500000 { budget = 2500000 }
    ibuf_push(fuel, budget)
    return fuel
}

fn _regex_find_with_fuel(rx: Regex, text: str, start_pos: i64, fuel: IntBuf) -> RegexMatch ! i64 {
    tlen := str_len(text)
    s := if start_pos < 0 { 0 } else { start_pos }
    if s > tlen { return err(404) }
    if ibuf_get(fuel, 0) <= 0 { return err(408) }

    if rx.has_start_anchor {
        if s > 0 { return err(404) }
        matched_len := rx_exec_vm(rx.code, 0, text, 0, fuel, 0, rx.ignore_case)
        if matched_len == -2 { return err(408) }
        if matched_len >= 0 { return ok(RegexMatch(start = 0, end = matched_len, len = matched_len)) }
        return err(404)
    }

    mut i := s
    while i <= tlen {
        matched_len := rx_exec_vm(rx.code, 0, text, i, fuel, 0, rx.ignore_case)
        if matched_len == -2 { return err(408) }
        if matched_len >= 0 {
            return ok(RegexMatch(start = i, end = i + matched_len, len = matched_len))
        }
        i += 1
    }
    return err(404)
}

// High-speed compiled regex search (ZERO recompile overhead across loops/files!)
fn regex_find_compiled(rx: Regex, text: str, start_pos: i64 = 0) -> RegexMatch ! i64 {
    fuel := _regex_make_fuel(str_len(text))
    res := _regex_find_with_fuel(rx, text, start_pos, fuel)
    buf_free(move fuel)
    return res
}

fn regex_is_match_compiled(rx: Regex, text: str) -> bool {
    _ := regex_find_compiled(rx, text, 0) or return false
    return true
}

fn regex_find(pattern: str, text: str) -> RegexMatch ! i64 {
    rx := regex_compile(pattern) or return err(400)
    m := regex_find_compiled(rx, text, 0) or RegexMatch(start = -1, end = -1, len = -1)
    regex_free(move rx)
    if m.start < 0 { return err(404) }
    return ok(m)
}

fn regex_is_match(pattern: str, text: str) -> bool {
    m := regex_find(pattern, text) or return false
    _unused := m.len
    return true
}

fn regex_replace(pattern: str, text: str, replacement: str) -> str {
    m := regex_find(pattern, text) or return text
    tlen := str_len(text)
    b := buf_new(tlen + str_len(replacement) + 8)
    if m.start > 0 { buf_push_str(b, str_slice(text, 0, m.start)) }
    buf_push_str(b, replacement)
    if m.end < tlen { buf_push_str(b, str_slice(text, m.end, tlen)) }
    return buf_to_owned_str(move b)
}

// Returns flat `[start0, end0, start1, end1, ...]` for all non-overlapping matches (Python `re.finditer` / `re.findall`)
fn regex_find_all(pattern: str, text: str, max_matches: i64 = 1000) -> IntBuf {
    mut out := ibuf_new(64)
    mut cap := 64
    rx := regex_compile(pattern) or return out
    tlen := str_len(text)
    fuel := _regex_make_fuel(tlen)
    mut pos := 0
    mut cnt := 0
    while pos <= tlen and cnt < max_matches {
        m := _regex_find_with_fuel(rx, text, pos, fuel) or RegexMatch(start = -1, end = -1, len = -1)
        if m.start < 0 { break }
        if ibuf_len(out) + 2 > cap {
            nc := cap * 2
            nb := ibuf_new(nc)
            mut k := 0
            while k < ibuf_len(out) { ibuf_push(nb, ibuf_get(out, k)); k += 1 }
            buf_free(move out)
            out = nb
            cap = nc
        }
        ibuf_push(out, m.start)
        ibuf_push(out, m.end)
        cnt += 1
        pos = if m.end > m.start { m.end } else { m.end + 1 }
    }
    buf_free(move fuel)
    regex_free(move rx)
    return out
}

// Replaces all non-overlapping matches (Python `re.sub` equivalent)
fn regex_replace_all(pattern: str, text: str, replacement: str, max_repl: i64 = 10000) -> str {
    rx := regex_compile(pattern) or return text
    tlen := str_len(text)
    fuel := _regex_make_fuel(tlen)
    mut parts := svec_new(16, tlen + 64)
    mut cur := 0
    mut pos := 0
    mut cnt := 0
    while pos <= tlen and cnt < max_repl {
        m := _regex_find_with_fuel(rx, text, pos, fuel) or RegexMatch(start = -1, end = -1, len = -1)
        if m.start < 0 { break }
        if m.start > cur { svec_push(mut parts, str_slice(text, cur, m.start)) }
        if str_len(replacement) > 0 { svec_push(mut parts, replacement) }
        cur = m.end
        pos = if m.end > m.start { m.end } else { m.end + 1 }
        cnt += 1
    }
    if cur < tlen { svec_push(mut parts, str_slice(text, cur, tlen)) }
    buf_free(move fuel)
    regex_free(move rx)
    res := svec_join(parts, "")
    svec_free(move parts)
    return res
}

// Splits `text` by regex pattern (Python `re.split` equivalent)
fn regex_split(pattern: str, text: str, max_splits: i64 = 1000) -> StrVec {
    mut out := svec_new(16, str_len(text) + 32)
    rx := regex_compile(pattern) or Regex(code = ibuf_new(0), has_start_anchor = false, has_end_anchor = false, ignore_case = false)
    if ibuf_len(rx.code) == 0 {
        regex_free(move rx)
        svec_push(mut out, text)
        return out
    }
    tlen := str_len(text)
    fuel := _regex_make_fuel(tlen)
    mut cur := 0
    mut pos := 0
    mut cnt := 0
    while pos <= tlen and cnt < max_splits {
        m := _regex_find_with_fuel(rx, text, pos, fuel) or RegexMatch(start = -1, end = -1, len = -1)
        if m.start < 0 { break }
        if m.end == m.start {
            pos = m.end + 1
            continue
        }
        svec_push(mut out, str_slice(text, cur, m.start))
        cur = m.end
        pos = m.end
        cnt += 1
    }
    svec_push(mut out, str_slice(text, cur, tlen))
    buf_free(move fuel)
    regex_free(move rx)
    return out
}

// Escapes all regex metacharacters in `literal` (Python `re.escape` equivalent)
fn regex_escape(literal: str) -> str {
    n := str_len(literal)
    if n == 0 { return "" }
    out := buf_new(n * 2 + 8)
    mut i := 0
    while i < n {
        b := str_byte(literal, i)
        if b == 92 or b == 46 or b == 94 or b == 36 or b == 42 or b == 43 or b == 63 or b == 123 or b == 125 or b == 91 or b == 93 or b == 124 or b == 40 or b == 41 {
            buf_push(out, 92)
        }
        buf_push(out, b)
        i += 1
    }
    return buf_to_owned_str(move out)
}
