// Axon Standard Library: Regular Expression Engine (`std/regex.ax`)
// High-performance NFA / Backtracking Pattern Matcher in 100% Pure Axon.
// Supports: Literals, '.', '\d', '\D', '\w', '\W', '\s', '\S', '[a-z]', '[abc]', '[^0-9]',
// Anchors '^' and '$', Quantifiers '*', '+', '?', and Alternation '|', with ReDoS step budget.

use std::os
use std::str

struct RegexMatch {
    start: i64
    end: i64
    len: i64
}

// Bytecode Opcodes for Regex VM
// OP_CHAR:       [1, char_byte]
// OP_ANY:        [2]
// OP_DIGIT:      [3]
// OP_NON_DIGIT:  [4]
// OP_WORD:       [5]
// OP_NON_WORD:   [6]
// OP_SPACE:      [7]
// OP_NON_SPACE:  [8]
// OP_RANGE:      [9, min_ch, max_ch]
// OP_NEG_RANGE:  [10, min_ch, max_ch]
// OP_START:      [11] (^)
// OP_END:        [12] ($)
// OP_STAR_ANY:   [20]
// OP_PLUS_ANY:   [21]
// OP_OPT_ANY:    [22]
// OP_STAR_CHAR:  [30, ch]
// OP_PLUS_CHAR:  [31, ch]
// OP_OPT_CHAR:   [32, ch]
// OP_STAR_CLASS: [40, class_op]
// OP_PLUS_CLASS: [41, class_op]
// OP_OPT_CLASS:  [42, class_op]
// OP_CHARSET:    [60, is_neg, quant, item_count, lo0, hi0, ...]
// OP_ALT:        [70, alt2_pc]
// OP_JMP:        [71, target_pc]
// OP_MATCH:      [255]

struct Regex {
    code: IntBuf
    has_start_anchor: bool
    has_end_anchor: bool
}

fn rx_is_digit(ch: i64) -> bool {
    return ch >= 48 and ch <= 57
}

fn rx_is_word(ch: i64) -> bool {
    return (ch >= 65 and ch <= 90) or (ch >= 97 and ch <= 122) or (ch >= 48 and ch <= 57) or ch == 95
}

fn rx_is_space(ch: i64) -> bool {
    return ch == 32 or ch == 9 or ch == 10 or ch == 13
}

fn rx_match_class(op: i64, ch: i64) -> bool {
    if op == 3 { return rx_is_digit(ch) }
    if op == 4 { return not rx_is_digit(ch) }
    if op == 5 { return rx_is_word(ch) }
    if op == 6 { return not rx_is_word(ch) }
    if op == 7 { return rx_is_space(ch) }
    if op == 8 { return not rx_is_space(ch) }
    return false
}

fn rx_find_close_bracket(pattern: str, start: i64, limit: i64) -> i64 {
    mut p := start
    while p < limit {
        b := str_byte(pattern, p)
        if b == 92 and p + 1 < limit {
            p += 2
        } else if b == 93 {
            return p
        } else {
            p += 1
        }
    }
    return -1
}

fn rx_parse_quant(pattern: str, pos: i64, limit: i64) -> i64 {
    if pos < limit {
        qb := str_byte(pattern, pos)
        if qb == 42 { return 1 } // *
        if qb == 43 { return 2 } // +
        if qb == 63 { return 3 } // ?
    }
    return 0
}

fn rx_class_op_for_escape(esc: i64) -> i64 {
    if esc == 100 { return 3 } // \d
    if esc == 68  { return 4 } // \D
    if esc == 119 { return 5 } // \w
    if esc == 87  { return 6 } // \W
    if esc == 115 { return 7 } // \s
    if esc == 83  { return 8 } // \S
    return 1
}

fn rx_compile_branch(pattern: str, b_start: i64, b_end: i64, code: IntBuf) -> i64 {
    mut i := b_start
    mut flags := 0 // bit 0 = start anchor, bit 1 = end anchor

    if i < b_end and str_byte(pattern, i) == 94 { // '^'
        flags = flags | 1
        ibuf_push(code, 11) // OP_START
        i += 1
    }

    while i < b_end {
        b := str_byte(pattern, i)

        if b == 36 and i == b_end - 1 { // unescaped '$' at branch end
            flags = flags | 2
            ibuf_push(code, 12) // OP_END
            i += 1
            break
        }

        if b == 46 { // '.'
            quant := rx_parse_quant(pattern, i + 1, b_end)
            if quant == 1 {
                ibuf_push(code, 20)
                i += 2
            } else if quant == 2 {
                ibuf_push(code, 21)
                i += 2
            } else if quant == 3 {
                ibuf_push(code, 22)
                i += 2
            } else {
                ibuf_push(code, 2)
                i += 1
            }
        } else if b == 92 { // '\' escape
            if i + 1 >= b_end {
                return -1
            }
            esc := str_byte(pattern, i + 1)
            op := rx_class_op_for_escape(esc)
            quant := rx_parse_quant(pattern, i + 2, b_end)

            if op == 1 {
                if quant == 1 {
                    ibuf_push(code, 30)
                    ibuf_push(code, esc)
                    i += 3
                } else if quant == 2 {
                    ibuf_push(code, 31)
                    ibuf_push(code, esc)
                    i += 3
                } else if quant == 3 {
                    ibuf_push(code, 32)
                    ibuf_push(code, esc)
                    i += 3
                } else {
                    ibuf_push(code, 1)
                    ibuf_push(code, esc)
                    i += 2
                }
            } else {
                if quant == 1 {
                    ibuf_push(code, 40)
                    ibuf_push(code, op)
                    i += 3
                } else if quant == 2 {
                    ibuf_push(code, 41)
                    ibuf_push(code, op)
                    i += 3
                } else if quant == 3 {
                    ibuf_push(code, 42)
                    ibuf_push(code, op)
                    i += 3
                } else {
                    ibuf_push(code, op)
                    i += 2
                }
            }
        } else if b == 91 { // '[' character class
            close_idx := rx_find_close_bracket(pattern, i + 1, b_end)
            if close_idx < 0 {
                return -1
            }
            mut r_start := i + 1
            mut is_neg := 0
            if r_start < close_idx and str_byte(pattern, r_start) == 94 {
                is_neg = 1
                r_start += 1
            }
            if r_start >= close_idx {
                return -1
            }

            quant := rx_parse_quant(pattern, close_idx + 1, b_end)
            hdr_pc := ibuf_len(code)
            ibuf_push(code, 60)     // OP_CHARSET
            ibuf_push(code, is_neg)
            ibuf_push(code, quant)
            ibuf_push(code, 0)      // item_count placeholder

            mut item_count := 0
            mut p := r_start
            while p < close_idx {
                cb := str_byte(pattern, p)
                if cb == 92 and p + 1 < close_idx {
                    esc := str_byte(pattern, p + 1)
                    cls := rx_class_op_for_escape(esc)
                    if cls != 1 {
                        ibuf_push(code, 0 - cls)
                        ibuf_push(code, 0)
                    } else {
                        ibuf_push(code, esc)
                        ibuf_push(code, esc)
                    }
                    item_count += 1
                    p += 2
                } else if p + 2 < close_idx and str_byte(pattern, p + 1) == 45 {
                    lo := cb
                    hi := str_byte(pattern, p + 2)
                    if lo > hi {
                        return -1
                    }
                    ibuf_push(code, lo)
                    ibuf_push(code, hi)
                    item_count += 1
                    p += 3
                } else {
                    ibuf_push(code, cb)
                    ibuf_push(code, cb)
                    item_count += 1
                    p += 1
                }
            }
            ibuf_set(code, hdr_pc + 3, item_count)
            i = if quant > 0 { close_idx + 2 } else { close_idx + 1 }
        } else {
            quant := rx_parse_quant(pattern, i + 1, b_end)
            if quant == 1 {
                ibuf_push(code, 30)
                ibuf_push(code, b)
                i += 2
            } else if quant == 2 {
                ibuf_push(code, 31)
                ibuf_push(code, b)
                i += 2
            } else if quant == 3 {
                ibuf_push(code, 32)
                ibuf_push(code, b)
                i += 2
            } else {
                ibuf_push(code, 1)
                ibuf_push(code, b)
                i += 1
            }
        }
    }

    return flags
}

fn regex_compile(pattern: str) -> Regex ! i64 {
    n := str_len(pattern)
    if n > 65536 {
        return err(413)
    }
    if n == 0 {
        code := ibuf_new(4)
        ibuf_push(code, 255) // OP_MATCH
        return ok(Regex(code = code, has_start_anchor = false, has_end_anchor = false))
    }

    // Pre-count unescaped top-level '|' alternations to size `branches` safely
    mut pipe_cnt := 0
    mut pk := 0
    mut p_in_bracket := false
    while pk < n {
        pch := str_byte(pattern, pk)
        if pch == 92 and pk + 1 < n {
            pk += 2
        } else if pch == 91 and not p_in_bracket {
            p_in_bracket = true
            pk += 1
        } else if pch == 93 and p_in_bracket {
            p_in_bracket = false
            pk += 1
        } else if pch == 124 and not p_in_bracket {
            pipe_cnt += 1
            pk += 1
        } else {
            pk += 1
        }
    }
    if pipe_cnt > 2048 {
        return err(413)
    }

    // Split top-level '|' branches (respecting '\' escapes and '[...]' classes)
    branches := ibuf_new(pipe_cnt * 2 + 4)
    mut seg_start := 0
    mut k := 0
    mut in_bracket := false
    while k < n {
        ch := str_byte(pattern, k)
        if ch == 92 and k + 1 < n {
            k += 2
        } else if ch == 91 and not in_bracket {
            in_bracket = true
            k += 1
        } else if ch == 93 and in_bracket {
            in_bracket = false
            k += 1
        } else if ch == 124 and not in_bracket {
            ibuf_push(branches, seg_start)
            ibuf_push(branches, k)
            seg_start = k + 1
            k += 1
        } else {
            k += 1
        }
    }
    ibuf_push(branches, seg_start)
    ibuf_push(branches, n)

    num_branches := ibuf_len(branches) / 2
    code := ibuf_new(n * 8 + num_branches * 6 + 32)
    mut has_start := false
    mut has_end := false

    if num_branches == 1 {
        flags := rx_compile_branch(pattern, ibuf_get(branches, 0), ibuf_get(branches, 1), code)
        if flags < 0 {
            buf_free(move branches)
            buf_free(move code)
            return err(400)
        }
        has_start = (flags & 1) != 0
        has_end = (flags & 2) != 0
        ibuf_push(code, 255)
    } else {
        jmp_slots := ibuf_new(num_branches)
        mut bi := 0
        while bi < num_branches {
            bs := ibuf_get(branches, bi * 2)
            be := ibuf_get(branches, bi * 2 + 1)
            mut alt_patch_pc := -1
            if bi < num_branches - 1 {
                ibuf_push(code, 70) // OP_ALT
                alt_patch_pc = ibuf_len(code)
                ibuf_push(code, 0)
            }
            bflags := rx_compile_branch(pattern, bs, be, code)
            if bflags < 0 {
                buf_free(move jmp_slots)
                buf_free(move branches)
                buf_free(move code)
                return err(400)
            }
            if bi < num_branches - 1 {
                ibuf_push(code, 71) // OP_JMP
                ibuf_push(jmp_slots, ibuf_len(code))
                ibuf_push(code, 0)
                ibuf_set(code, alt_patch_pc, ibuf_len(code))
            }
            bi += 1
        }
        end_pc := ibuf_len(code)
        ibuf_push(code, 255) // OP_MATCH
        mut ji := 0
        jlen := ibuf_len(jmp_slots)
        while ji < jlen {
            ibuf_set(code, ibuf_get(jmp_slots, ji), end_pc)
            ji += 1
        }
        buf_free(move jmp_slots)
    }

    buf_free(move branches)
    return ok(Regex(code = code, has_start_anchor = has_start, has_end_anchor = has_end))
}

fn regex_free(move rx: Regex) {
    buf_free(move rx.code)
}

fn rx_consume_fuel(fuel: IntBuf, cost: i64) -> bool {
    rem := ibuf_get(fuel, 0)
    if rem < cost {
        ibuf_set(fuel, 0, 0)
        return false
    }
    ibuf_set(fuel, 0, rem - cost)
    return true
}

fn rx_match_charset(code: IntBuf, pc: i64, ch: i64) -> bool {
    is_neg := ibuf_get(code, pc + 1)
    item_count := ibuf_get(code, pc + 3)
    mut in_set := false
    mut k := 0
    while k < item_count {
        lo := ibuf_get(code, pc + 4 + k * 2)
        hi := ibuf_get(code, pc + 5 + k * 2)
        if lo < 0 {
            if rx_match_class(0 - lo, ch) {
                in_set = true
                break
            }
        } else if ch >= lo and ch <= hi {
            in_set = true
            break
        }
        k += 1
    }
    if is_neg == 1 { return not in_set }
    return in_set
}

fn rx_exec_vm(code: IntBuf, start_pc: i64, text: str, text_start: i64, fuel: IntBuf, depth: i64 = 0) -> i64 {
    unsafe {
    if depth > 128 {
        return -2
    }
    tlen := str_len(text)
    if text_start < 0 or text_start > tlen {
        return -1
    }
    mut pc := start_pc
    mut tp := text_start
    clen := ibuf_len(code)
    text_p := text as i64

    while pc >= 0 and pc < clen {
        if not rx_consume_fuel(fuel, 1) {
            return -2
        }

        op := ibuf_get(code, pc)

        if op == 255 { // OP_MATCH
            return tp - text_start
        } else if op == 71 { // OP_JMP
            pc = ibuf_get(code, pc + 1)
        } else if op == 70 { // OP_ALT
            alt_pc := ibuf_get(code, pc + 1)
            r1 := rx_exec_vm(code, pc + 2, text, tp, fuel, depth + 1)
            if r1 == -2 { return -2 }
            if r1 >= 0 { return (tp - text_start) + r1 }
            // Tail-step to alt_pc iteratively to prevent linear stack exhaustion on long a|b|c|... chains
            pc = alt_pc
        } else if op == 11 { // OP_START (^)
            if tp != 0 { return -1 }
            pc += 1
        } else if op == 12 { // OP_END ($)
            if tp != tlen { return -1 }
            pc += 1
        } else if op == 1 { // OP_CHAR (unrolled fast literal scan with fuel accounting)
            while pc + 1 < clen and ibuf_get(code, pc) == 1 {
                expected := ibuf_get(code, pc + 1)
                if tp >= tlen or ptr_read_u8(text_p + tp, 0) != expected { return -1 }
                tp += 1
                pc += 2
                if not rx_consume_fuel(fuel, 1) { return -2 }
            }
        } else if op == 2 { // OP_ANY (.)
            if tp >= tlen { return -1 }
            ch := ptr_read_u8(text_p + tp, 0)
            if ch == 10 or ch == 13 { return -1 }
            tp += 1
            pc += 1
        } else if op >= 3 and op <= 8 { // OP_CLASS
            if tp >= tlen or not rx_match_class(op, ptr_read_u8(text_p + tp, 0)) { return -1 }
            tp += 1
            pc += 1
        } else if op == 9 { // OP_RANGE
            min_c := ibuf_get(code, pc + 1)
            max_c := ibuf_get(code, pc + 2)
            if tp >= tlen { return -1 }
            ch := ptr_read_u8(text_p + tp, 0)
            if ch < min_c or ch > max_c { return -1 }
            tp += 1
            pc += 3
        } else if op == 10 { // OP_NEG_RANGE
            min_c := ibuf_get(code, pc + 1)
            max_c := ibuf_get(code, pc + 2)
            if tp >= tlen { return -1 }
            ch := ptr_read_u8(text_p + tp, 0)
            if ch >= min_c and ch <= max_c { return -1 }
            tp += 1
            pc += 3
        } else if op == 20 or op == 21 or op == 22 { // .* / .+ / .?
            min_req := if op == 21 { 1 } else { 0 }
            max_cap := if op == 22 { 1 } else { tlen - tp }
            mut count := 0
            while count < max_cap and tp + count < tlen {
                if not rx_consume_fuel(fuel, 1) { return -2 }
                ch := ptr_read_u8(text_p + tp + count, 0)
                if ch == 10 or ch == 13 { break }
                count += 1
            }
            if count < min_req { return -1 }
            mut try_cnt := count
            while try_cnt >= min_req {
                sub_res := rx_exec_vm(code, pc + 1, text, tp + try_cnt, fuel, depth + 1)
                if sub_res == -2 { return -2 }
                if sub_res >= 0 {
                    return (tp - text_start) + try_cnt + sub_res
                }
                try_cnt -= 1
            }
            return -1
        } else if op == 30 or op == 31 or op == 32 { // c* / c+ / c?
            expected := ibuf_get(code, pc + 1)
            min_req := if op == 31 { 1 } else { 0 }
            max_cap := if op == 32 { 1 } else { tlen - tp }
            mut count := 0
            while count < max_cap and tp + count < tlen and ptr_read_u8(text_p + tp + count, 0) == expected {
                if not rx_consume_fuel(fuel, 1) { return -2 }
                count += 1
            }
            if count < min_req { return -1 }
            mut try_cnt := count
            while try_cnt >= min_req {
                sub_res := rx_exec_vm(code, pc + 2, text, tp + try_cnt, fuel, depth + 1)
                if sub_res == -2 { return -2 }
                if sub_res >= 0 {
                    return (tp - text_start) + try_cnt + sub_res
                }
                try_cnt -= 1
            }
            return -1
        } else if op == 40 or op == 41 or op == 42 { // \d* / \d+ / \d?
            cls_op := ibuf_get(code, pc + 1)
            min_req := if op == 41 { 1 } else { 0 }
            max_cap := if op == 42 { 1 } else { tlen - tp }
            mut count := 0
            while count < max_cap and tp + count < tlen and rx_match_class(cls_op, ptr_read_u8(text_p + tp + count, 0)) {
                if not rx_consume_fuel(fuel, 1) { return -2 }
                count += 1
            }
            if count < min_req { return -1 }
            mut try_cnt := count
            while try_cnt >= min_req {
                sub_res := rx_exec_vm(code, pc + 2, text, tp + try_cnt, fuel, depth + 1)
                if sub_res == -2 { return -2 }
                if sub_res >= 0 {
                    return (tp - text_start) + try_cnt + sub_res
                }
                try_cnt -= 1
            }
            return -1
        } else if op >= 49 and op <= 54 { // Legacy RANGE quantifiers
            is_neg := (op == 50 or op == 52 or op == 54)
            is_plus := (op == 51 or op == 52)
            is_opt := (op == 53 or op == 54)
            min_c := ibuf_get(code, pc + 1)
            max_c := ibuf_get(code, pc + 2)
            min_req := if is_plus { 1 } else { 0 }
            max_cap := if is_opt { 1 } else { tlen - tp }
            mut count := 0
            while count < max_cap and tp + count < tlen {
                if not rx_consume_fuel(fuel, 1) { return -2 }
                ch := ptr_read_u8(text_p + tp + count, 0)
                in_range := (ch >= min_c and ch <= max_c)
                matched := if is_neg { not in_range } else { in_range }
                if not matched { break }
                count += 1
            }
            if count < min_req { return -1 }
            mut try_cnt := count
            while try_cnt >= min_req {
                sub_res := rx_exec_vm(code, pc + 3, text, tp + try_cnt, fuel, depth + 1)
                if sub_res == -2 { return -2 }
                if sub_res >= 0 {
                    return (tp - text_start) + try_cnt + sub_res
                }
                try_cnt -= 1
            }
            return -1
        } else if op == 60 { // OP_CHARSET
            quant := ibuf_get(code, pc + 2)
            item_count := ibuf_get(code, pc + 3)
            next_pc := pc + 4 + item_count * 2
            item_cost := if item_count > 1 { item_count } else { 1 }
            if quant == 0 {
                if not rx_consume_fuel(fuel, item_cost) { return -2 }
                if tp >= tlen or not rx_match_charset(code, pc, ptr_read_u8(text_p + tp, 0)) {
                    return -1
                }
                tp += 1
                pc = next_pc
            } else {
                min_req := if quant == 2 { 1 } else { 0 }
                max_cap := if quant == 3 { 1 } else { tlen - tp }
                mut count := 0
                while count < max_cap and tp + count < tlen {
                    if not rx_consume_fuel(fuel, item_cost) { return -2 }
                    if not rx_match_charset(code, pc, ptr_read_u8(text_p + tp + count, 0)) {
                        break
                    }
                    count += 1
                }
                if count < min_req { return -1 }
                mut try_cnt := count
                while try_cnt >= min_req {
                    sub_res := rx_exec_vm(code, next_pc, text, tp + try_cnt, fuel, depth + 1)
                    if sub_res == -2 { return -2 }
                    if sub_res >= 0 {
                        return (tp - text_start) + try_cnt + sub_res
                    }
                    try_cnt -= 1
                }
                return -1
            }
        } else {
            return -1
        }
    }

    return tp - text_start
    }
}

fn rx_exec_at_pc(code: IntBuf, start_pc: i64, text: str, text_start: i64) -> i64 {
    fuel := ibuf_new(1)
    mut budget := str_len(text) * 4
    if budget < 25000 { budget = 25000 }
    if budget > 2000000 { budget = 2000000 }
    ibuf_push(fuel, budget)
    res := rx_exec_vm(code, start_pc, text, text_start, fuel, 0)
    buf_free(move fuel)
    if res == -2 { return -1 }
    return res
}

fn rx_exec_at(code: IntBuf, text: str, text_start: i64) -> i64 {
    if ibuf_len(code) > 0 and ibuf_get(code, 0) == 11 and text_start != 0 {
        return -1
    }
    return rx_exec_at_pc(code, 0, text, text_start)
}

fn regex_find(pattern: str, text: str) -> RegexMatch ! i64 {
    rx := regex_compile(pattern) or return err(400)
    tlen := str_len(text)

    fuel := ibuf_new(1)
    mut budget := tlen * 4
    if budget < 25000 { budget = 25000 }
    if budget > 2000000 { budget = 2000000 }
    ibuf_push(fuel, budget)

    if rx.has_start_anchor {
        matched_len := rx_exec_vm(rx.code, 0, text, 0, fuel, 0)
        buf_free(move fuel)
        buf_free(move rx.code)
        if matched_len >= 0 {
            return ok(RegexMatch(start = 0, end = matched_len, len = matched_len))
        }
        return err(404)
    }

    mut i := 0
    while i <= tlen {
        matched_len := rx_exec_vm(rx.code, 0, text, i, fuel, 0)
        if matched_len == -2 {
            break
        }
        if matched_len >= 0 {
            buf_free(move fuel)
            buf_free(move rx.code)
            return ok(RegexMatch(start = i, end = i + matched_len, len = matched_len))
        }
        i += 1
    }

    buf_free(move fuel)
    buf_free(move rx.code)
    return err(404)
}

fn regex_is_match(pattern: str, text: str) -> bool {
    m := regex_find(pattern, text) or return false
    _unused := m.len
    return true
}

fn regex_replace(pattern: str, text: str, replacement: str) -> str {
    m := regex_find(pattern, text) or return text
    tlen := str_len(text)
    
    b := buf_new(tlen + str_len(replacement) + 8)
    if m.start > 0 {
        buf_push_str(b, str_slice(text, 0, m.start))
    }
    buf_push_str(b, replacement)
    if m.end < tlen {
        buf_push_str(b, str_slice(text, m.end, tlen))
    }
    return buf_to_owned_str(move b)
}
