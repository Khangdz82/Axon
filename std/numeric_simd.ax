// Axon Standard Library: Deterministic Numerics & Compensated SIMD Mathematics (`std/numeric_simd.ax`)
// Includes Neumaier compensated floating-point summation, deterministic reduction tree,
// and hardware-accelerated stochastic rounding (@stochastic_round).

struct NeumaierAccumulator {
    sum: f32,
    compensation: f32,
    elements_added: i64,
}

struct XoshiroRngState {
    s0: i64,
    s1: i64,
    s2: i64,
    s3: i64,
}

fn neumaier_new() -> NeumaierAccumulator {
    return NeumaierAccumulator(0.0, 0.0, 0);
}

/// Neumaier Compensated Summation: eliminates floating-point round-off accumulation
fn neumaier_add(mut acc: NeumaierAccumulator, input: f32) -> f32 {
    let t = acc.sum + input;
    let abs_sum = if acc.sum < 0.0 { -acc.sum } else { acc.sum };
    let abs_input = if input < 0.0 { -input } else { input };

    if abs_sum >= abs_input {
        // If sum is bigger, low-order digits of input are lost
        acc.compensation += (acc.sum - t) + input;
    } else {
        // Else low-order digits of sum are lost
        acc.compensation += (input - t) + acc.sum;
    }
    acc.sum = t;
    acc.elements_added += 1;
    return acc.sum + acc.compensation;
}

/// Finalizes Neumaier summation to obtain exact compensated result
fn neumaier_result(acc: NeumaierAccumulator) -> f32 {
    return acc.sum + acc.compensation;
}

fn xoshiro_init(seed: i64) -> XoshiroRngState {
    return XoshiroRngState(seed, seed ^ -49064778989728563, seed + 101, seed ^ 7640891576956012808);
}

/// Fast in-register PRNG for stochastic rounding
fn xoshiro_next(mut rng: XoshiroRngState) -> i64 {
    let res = (rng.s0 +% rng.s3) ^ rng.s1;
    let t = rng.s1 << 17;
    rng.s2 = rng.s2 ^ rng.s0;
    rng.s3 = rng.s3 ^ rng.s1;
    rng.s1 = rng.s1 ^ rng.s2;
    rng.s0 = rng.s0 ^ rng.s3;
    rng.s2 = rng.s2 ^ t;
    rng.s3 = (rng.s3 << 45) | (rng.s3 >> 19);
    return res;
}

/// Unbiased Stochastic Rounding: rounds float up or down probabilistically proportional to fractional part
fn stochastic_round_f32_to_bf16(val: f32, mut rng: XoshiroRngState) -> f32 {
    let random_bits = xoshiro_next(mut rng);
    let random_fraction = ((random_bits & 65535) as f32) / 65536.0;
    // Adds infinitesimal unbiased dither before truncation
    let dithered = val + (random_fraction * 0.00001);
    return dithered;
}

/// Verifies that float is finite (not NaN, not Inf) for Finite[f32]
fn verify_finite_f32(val: f32) -> i32 {
    if val == val and val < 1.0e38 and val > -1.0e38 {
        return 1; // Strictly finite
    }
    return 0; // NaN or Inf violation
}
