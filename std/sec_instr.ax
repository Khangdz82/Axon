// Axon Deep Security Testing Library — Zero-Edit Source-to-Source Auto-Instrumenter (`std/sec_instr.ax`)
// 100% Pure Axon, Zero-GC, Zero Compiler Changes, `--shield` Safe.
// Automatically instruments any target Axon function in memory/temp copy WITHOUT editing the original source:
//   1. Edge-Coverage Probes (`fuzz_trace_edge`) injected into every `if` / `else` / `while` / `for` branch
//   2. Automatic REDQUEEN CmpLog Hooks (`fuzz_cmplog_i64`, `fuzz_cmplog_range`, `fuzz_cmplog_str`)
//      injected before `==`, `!=`, `<`, `<=`, `>`, `>=`, and `str_eq(...)` guards
//   3. Directed Greybox Fuzzing Distance Probes (`fuzz_report_distance`) toward any SAST-flagged `target_line`

use std::os
use std::str
use std::ds
use std::fs

struct InstrResult {
    code: str
    found_fn: bool
    edges_injected: i64
    cmplogs_injected: i64
    directed_probes: i64
}

fn _ins_abs(x: i64) -> i64 {
    return if x < 0 { 0 - x } else { x }
}

fn _ins_strip_comment(line: str) -> str {
    n := str_len(line)
    mut in_str := false
    mut esc := false
    mut i := 0
    while i < n {
        b := str_byte(line, i)
        if in_str {
            if esc { esc = false }
            else if b == 92 { esc = true }
            else if b == 34 { in_str = false }
        } else {
            if b == 34 { in_str = true }
            else if b == 47 and i + 1 < n and str_byte(line, i + 1) == 47 {
                return str_slice(line, 0, i)
            }
        }
        i += 1
    }
    return line
}

fn _ins_count_braces(code: str) -> (i64, i64) {
    n := str_len(code)
    mut in_str := false
    mut esc := false
    mut opens := 0
    mut closes := 0
    mut i := 0
    while i < n {
        b := str_byte(code, i)
        if in_str {
            if esc { esc = false }
            else if b == 92 { esc = true }
            else if b == 34 { in_str = false }
        } else {
            if b == 34 { in_str = true }
            else if b == 123 { opens += 1 }
            else if b == 125 { closes += 1 }
        }
        i += 1
    }
    return (opens, closes)
}

fn _ins_leading_ws(line: str) -> str {
    n := str_len(line)
    mut i := 0
    while i < n and (str_byte(line, i) == 32 or str_byte(line, i) == 9) { i += 1 }
    return str_slice(line, 0, i)
}

// Extracts condition between `if ` and `{`, then emits CmpLog hook for simple comparisons (`==`, `!=`, `<`, `<=`, `>`, `>=`, `str_eq`).
fn _ins_make_cmplog(trim_code: str, indent: str) -> str {
    if not str_starts_with(trim_code, "if ") { return "" }
    lb := str_find_byte(trim_code, 123, 3)
    if lb <= 3 { return "" }
    cond := str_trim(str_slice(trim_code, 3, lb))
    // Skip compound boolean expressions (`and` / `or`) to preserve short-circuit safety
    if str_contains(cond, " and ") or str_contains(cond, " or ") { return "" }

    // 1. `str_eq(a, b)` or `not str_eq(a, b)`
    mut sc := cond
    if str_starts_with(sc, "not ") { sc = str_trim(str_slice(sc, 4, str_len(sc))) }
    if str_starts_with(sc, "str_eq(") and str_ends_with(sc, ")") {
        inner := str_slice(sc, 7, str_len(sc) - 1)
        // Split at top-level comma
        mut depth := 0
        mut comma := -1
        mut i := 0
        while i < str_len(inner) {
            b := str_byte(inner, i)
            if b == 40 { depth += 1 }
            else if b == 41 { depth -= 1 }
            else if b == 44 and depth == 0 { comma = i; break }
            i += 1
        }
        if comma > 0 {
            a := str_trim(str_slice(inner, 0, comma))
            b_arg := str_trim(str_slice(inner, comma + 1, str_len(inner)))
            if str_len(a) > 0 and str_len(b_arg) > 0 {
                return indent + f"fuzz_cmplog_str(mut __sec_fz, {a}, {b_arg})\n"
            }
        }
        return ""
    }

    // 2. Integer comparisons: `==`, `!=`, `<=`, `>=`, `<`, `>`
    // Skip boolean/string comparisons or float literals
    if str_contains(cond, "\"") or str_contains(cond, "true") or str_contains(cond, "false") or str_contains(cond, ".") {
        return ""
    }
    mut op_tok := ""
    mut op_code := -1
    mut op_pos := -1
    if str_find(cond, " == ", 0) > 0 { op_tok = " == "; op_code = 0; op_pos = str_find(cond, " == ", 0) }
    else if str_find(cond, " != ", 0) > 0 { op_tok = " != "; op_code = 0; op_pos = str_find(cond, " != ", 0) }
    else if str_find(cond, " <= ", 0) > 0 { op_tok = " <= "; op_code = 2; op_pos = str_find(cond, " <= ", 0) }
    else if str_find(cond, " >= ", 0) > 0 { op_tok = " >= "; op_code = 4; op_pos = str_find(cond, " >= ", 0) }
    else if str_find(cond, " < ", 0) > 0 { op_tok = " < "; op_code = 1; op_pos = str_find(cond, " < ", 0) }
    else if str_find(cond, " > ", 0) > 0 { op_tok = " > "; op_code = 3; op_pos = str_find(cond, " > ", 0) }

    if op_pos > 0 and op_code >= 0 {
        lhs := str_trim(str_slice(cond, 0, op_pos))
        rhs := str_trim(str_slice(cond, op_pos + str_len(op_tok), str_len(cond)))
        if str_len(lhs) > 0 and str_len(rhs) > 0 {
            if op_code == 0 {
                return indent + f"fuzz_cmplog_i64(mut __sec_fz, {lhs}, {rhs})\n"
            }
            return indent + f"fuzz_cmplog_range(mut __sec_fz, {lhs}, {rhs}, {op_code})\n"
        }
    }
    return ""
}

// Rewrites `target_fn` inside `src` to inject `mut __sec_fz: SecFuzzer`, edge-coverage tracing,
// automatic REDQUEEN CmpLog hooks, and optional LibAFLGo directed distance probes toward `target_line`.
fn sec_instr_source(src: str, target_fn: str, target_line: i64 = 0) -> InstrResult {
    out := buf_new(str_len(src) * 3 + 2048)
    fn_sig_needle := "fn " + target_fn + "("

    mut found := false
    mut in_target := false
    mut depth := 0
    mut edge_id := 100
    mut edges := 0
    mut cmplogs := 0
    mut dists := 0

    n := str_len(src)
    mut pos := 0
    mut line_no := 1
    while pos <= n {
        mut nl := str_find_byte(src, 10, pos)
        if nl < 0 { nl = n }
        mut end_l := nl
        if end_l > pos and str_byte(src, end_l - 1) == 13 { end_l -= 1 }
        raw_line := str_slice(src, pos, end_l)
        no_cmt := _ins_strip_comment(raw_line)
        trim_c := str_trim(no_cmt)
        indent := _ins_leading_ws(raw_line)

        if (not in_target) and (str_starts_with(trim_c, fn_sig_needle) or str_starts_with(trim_c, "unsafe " + fn_sig_needle)) {
            // Inject `mut __sec_fz: SecFuzzer` as first parameter of `target_fn`
            lp := str_find_byte(raw_line, 40, 0)
            if lp >= 0 {
                found = true
                in_target = true
                after_lp := str_trim(str_slice(raw_line, lp + 1, str_len(raw_line)))
                has_params := str_len(after_lp) > 0 and str_byte(after_lp, 0) != 41
                sep := if has_params { ", " } else { "" }
                new_hdr := str_slice(raw_line, 0, lp + 1) + "mut __sec_fz: SecFuzzer" + sep + str_slice(raw_line, lp + 1, str_len(raw_line))
                buf_push_str(out, new_hdr + "\n")
                (op, cl) := _ins_count_braces(no_cmt)
                depth = op - cl
                if op > 0 {
                    buf_push_str(out, indent + "    mut __sec_prev := 1\n")
                }
                if nl >= n { break }
                pos = nl + 1
                line_no += 1
                continue
            }
        }

        if in_target {
            // 1. Auto-CmpLog BEFORE simple `if` guards
            cmp_hook := _ins_make_cmplog(trim_c, indent)
            if str_len(cmp_hook) > 0 {
                buf_push_str(out, cmp_hook)
                cmplogs += 1
            }

            // 2. Emit original line (or split single-line `if cond { body }` into multi-line with edge probe!)
            is_branch := str_starts_with(trim_c, "if ") or str_starts_with(trim_c, "while ")
                or str_starts_with(trim_c, "for ") or str_starts_with(trim_c, "else ") or str_starts_with(trim_c, "} else")
            (op, cl) := _ins_count_braces(no_cmt)

            if is_branch and op == 1 and cl == 1 {
                // Single-line branch: `if cond { stmt }` -> inject probe right after `{`!
                lb := str_find_byte(raw_line, 123, 0)
                if lb >= 0 {
                    edge_id += 1
                    edges += 1
                    mut probe := f" _ := fuzz_trace_edge(mut __sec_fz, __sec_prev, {edge_id}); __sec_prev = {edge_id};"
                    if target_line > 0 {
                        d := _ins_abs(line_no - target_line)
                        probe = probe + f" _ := fuzz_report_distance(mut __sec_fz, {d});"
                        dists += 1
                    }
                    buf_push_str(out, str_slice(raw_line, 0, lb + 1) + probe + str_slice(raw_line, lb + 1, str_len(raw_line)) + "\n")
                } else {
                    buf_push_str(out, raw_line + "\n")
                }
            } else {
                buf_push_str(out, raw_line + "\n")
                if is_branch and op > cl {
                    // Multi-line branch opening `{` -> inject edge + directed distance probe inside block
                    edge_id += 1
                    edges += 1
                    buf_push_str(out, indent + f"    _ := fuzz_trace_edge(mut __sec_fz, __sec_prev, {edge_id}); __sec_prev = {edge_id}\n")
                    if target_line > 0 {
                        d := _ins_abs(line_no - target_line)
                        buf_push_str(out, indent + f"    _ := fuzz_report_distance(mut __sec_fz, {d})\n")
                        dists += 1
                    }
                }
            }

            depth = depth + op - cl
            if depth <= 0 {
                in_target = false
            }
        } else {
            buf_push_str(out, raw_line + "\n")
        }

        if nl >= n { break }
        pos = nl + 1
        line_no += 1
    }

    return InstrResult(
        code = buf_to_owned_str(move out),
        found_fn = found,
        edges_injected = edges,
        cmplogs_injected = cmplogs,
        directed_probes = dists
    )
}

fn sec_instr_file(file_path: str, target_fn: str, target_line: i64 = 0) -> InstrResult {
    src := fs_read_text(file_path) or return InstrResult(code = "", found_fn = false, edges_injected = 0, cmplogs_injected = 0, directed_probes = 0)
    return sec_instr_source(src, target_fn, target_line)
}
