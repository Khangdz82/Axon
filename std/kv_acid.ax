// Axon Standard Library — Zero-DLL Embedded ACID Key-Value Engine with CRC32 WAL (`std/kv_acid.ax`)
// 100% Pure Axon (`0` external C libraries!), Crash-Safe IEEE CRC-32 Write-Ahead Log (`AXKV` v1),
// Read-Your-Own-Writes Transactions (`kv_begin` / `kv_commit` / `kv_rollback`), Per-Key TTL,
// Sorted Prefix Scans (`kv_scan_prefix`), and Atomic Online Log Compaction (`kv_compact`).

use std::str
use std::encoding
use std::ds
use std::fs
use std::sys

// WAL Frame Op Codes
fn _kv_op_put() -> i64    { return 1 }
fn _kv_op_del() -> i64    { return 2 }
fn _kv_op_commit() -> i64 { return 3 }

struct KvStore {
    path: str
    live_vals: StrMap
    live_exps: StrMap
    key_log: StrVec
    in_tx: bool
    tx_ops: IntBuf
    tx_keys: StrVec
    tx_vals: StrVec
    tx_exps: IntBuf
}

fn _kv_put_u32_le(b: ByteBuf, v: i64) {
    buf_push(b, v & 255)
    buf_push(b, (v >> 8) & 255)
    buf_push(b, (v >> 16) & 255)
    buf_push(b, (v >> 24) & 255)
}

fn _kv_put_u64_le(b: ByteBuf, v: i64) {
    mut k := 0
    while k < 8 {
        buf_push(b, ushr64(v, k * 8) & 255)
        k += 1
    }
}

fn _kv_get_u32_le(b: ByteBuf, off: i64) -> i64 {
    return (buf_get(b, off) & 255)
         | ((buf_get(b, off + 1) & 255) << 8)
         | ((buf_get(b, off + 2) & 255) << 16)
         | ((buf_get(b, off + 3) & 255) << 24)
}

fn _kv_get_u64_le(b: ByteBuf, off: i64) -> i64 {
    mut acc := 0
    mut k := 0
    while k < 8 {
        acc = acc | ((buf_get(b, off + k) & 255) << (k * 8))
        k += 1
    }
    return acc
}

// Appends one CRC32-protected WAL record (`21`-byte header + `key` + `val`) into `wal_buf`.
fn _kv_encode_frame(wal_buf: ByteBuf, op: i64, exp_unix: i64, key: str, val: str) {
    kl := str_len(key)
    vl := str_len(val)
    payload := buf_new(16 + kl + vl)
    buf_push(payload, op & 255)
    _kv_put_u64_le(payload, exp_unix)
    _kv_put_u32_le(payload, kl)
    _kv_put_u32_le(payload, vl)
    if kl > 0 { buf_push_str(payload, key) }
    if vl > 0 { buf_push_str(payload, val) }
    crc := crc32_bytes(payload)
    buf_free(move payload)

    buf_push(wal_buf, op & 255)
    _kv_put_u64_le(wal_buf, exp_unix)
    _kv_put_u32_le(wal_buf, kl)
    _kv_put_u32_le(wal_buf, vl)
    _kv_put_u32_le(wal_buf, crc)
    if kl > 0 { buf_push_str(wal_buf, key) }
    if vl > 0 { buf_push_str(wal_buf, val) }
}

fn _kv_apply_mem_put(mut db: KvStore, key: str, val: str, exp_unix: i64) {
    if not smap_has(db.live_vals, key) {
        svec_push(mut db.key_log, key)
    }
    smap_set_str(mut db.live_vals, key, val)
    smap_set_i64(mut db.live_exps, key, exp_unix)
}

fn _kv_apply_mem_del(mut db: KvStore, key: str) {
    _ := smap_remove(mut db.live_vals, key)
    _ := smap_remove(mut db.live_exps, key)
}

// Opens (or creates) a persistent ACID Key-Value store at `path`, replaying & CRC32-validating all WAL frames!
// Pass `":memory:"` or `""` for a pure in-memory transactional store.
fn kv_open(path: str) -> KvStore ! i64 {
    mut db := KvStore(
        path = path,
        live_vals = smap_new(64),
        live_exps = smap_new(64),
        key_log = svec_new(32, 512),
        in_tx = false,
        tx_ops = ibuf_new(32),
        tx_keys = svec_new(16, 256),
        tx_vals = svec_new(16, 256),
        tx_exps = ibuf_new(32)
    )
    if str_len(path) == 0 or str_eq(path, ":memory:") {
        return ok(db)
    }
    if not sys_fs_exists(path) {
        hdr := buf_new(16)
        buf_push(hdr, 65); buf_push(hdr, 88); buf_push(hdr, 75); buf_push(hdr, 86) // "AXKV"
        buf_push(hdr, 1);  buf_push(hdr, 0);  buf_push(hdr, 0);  buf_push(hdr, 0)
        _ := fs_write_file(path, hdr)
        buf_free(move hdr)
        return ok(db)
    }
    raw := fs_read_file(path) or return err(500)
    blen := buf_len(raw)
    if blen < 8 or buf_get(raw, 0) != 65 or buf_get(raw, 1) != 88 or buf_get(raw, 2) != 75 or buf_get(raw, 3) != 86 {
        buf_free(move raw)
        kv_close(move db)
        return err(422)
    }
    mut off := 8
    while off + 21 <= blen {
        op := buf_get(raw, off)
        exp_u := _kv_get_u64_le(raw, off + 1)
        kl := _kv_get_u32_le(raw, off + 9)
        vl := _kv_get_u32_le(raw, off + 13)
        stored_crc := _kv_get_u32_le(raw, off + 17)
        if kl < 0 or vl < 0 or off + 21 + kl + vl > blen {
            // Torn tail frame from sudden power loss: stop replay cleanly!
            break
        }
        key_s := if kl > 0 { "" + buf_slice_str(raw, off + 21, off + 21 + kl) } else { "" }
        val_s := if vl > 0 { "" + buf_slice_str(raw, off + 21 + kl, off + 21 + kl + vl) } else { "" }

        chk := buf_new(16 + kl + vl)
        buf_push(chk, op)
        _kv_put_u64_le(chk, exp_u)
        _kv_put_u32_le(chk, kl)
        _kv_put_u32_le(chk, vl)
        if kl > 0 { buf_push_str(chk, key_s) }
        if vl > 0 { buf_push_str(chk, val_s) }
        calc_crc := crc32_bytes(chk)
        buf_free(move chk)
        if calc_crc != stored_crc {
            // Corrupted tail frame detected via IEEE CRC-32: halt replay safely!
            break
        }
        if op == 1 {
            _kv_apply_mem_put(mut db, key_s, val_s, exp_u)
        } else if op == 2 {
            _kv_apply_mem_del(mut db, key_s)
        }
        off += 21 + kl + vl
    }
    buf_free(move raw)
    return ok(db)
}

fn kv_close(move db: KvStore) {
    smap_free(db.live_vals)
    smap_free(db.live_exps)
    svec_free(db.key_log)
    buf_free(db.tx_ops)
    svec_free(db.tx_keys)
    svec_free(db.tx_vals)
    buf_free(db.tx_exps)
}

fn _kv_append_wal_disk(path: str, frames: ByteBuf) -> bool {
    if str_len(path) == 0 or str_eq(path, ":memory:") { return true }
    prev := fs_read_file(path) or buf_new(16)
    mut merged := buf_new(buf_len(prev) + buf_len(frames) + 16)
    if buf_len(prev) == 0 {
        buf_push(merged, 65); buf_push(merged, 88); buf_push(merged, 75); buf_push(merged, 86)
        buf_push(merged, 1);  buf_push(merged, 0);  buf_push(merged, 0);  buf_push(merged, 0)
    } else {
        mut i := 0
        while i < buf_len(prev) { buf_push(merged, buf_get(prev, i)); i += 1 }
    }
    buf_free(move prev)
    mut j := 0
    while j < buf_len(frames) { buf_push(merged, buf_get(frames, j)); j += 1 }
    rc := fs_write_file(path, merged)
    buf_free(move merged)
    return rc >= 0
}

fn _kv_clear_tx_buffers(mut db: KvStore) {
    ibuf_truncate(db.tx_ops, 0)
    svec_free(db.tx_keys)
    svec_free(db.tx_vals)
    db.tx_keys = svec_new(16, 256)
    db.tx_vals = svec_new(16, 256)
    ibuf_truncate(db.tx_exps, 0)
    db.in_tx = false
}

// Starts an isolated ACID transaction (all `kv_put`/`kv_del` stage in memory until `kv_commit` or `kv_rollback`).
fn kv_begin(mut db: KvStore) -> bool {
    if db.in_tx { return false }
    _kv_clear_tx_buffers(mut db)
    db.in_tx = true
    return true
}

fn kv_rollback(mut db: KvStore) -> bool {
    if not db.in_tx { return false }
    _kv_clear_tx_buffers(mut db)
    return true
}

fn kv_commit(mut db: KvStore) -> bool {
    if not db.in_tx { return false }
    n := ibuf_len(db.tx_ops)
    if n == 0 {
        _kv_clear_tx_buffers(mut db)
        return true
    }
    frames := buf_new(n * 64 + 64)
    mut i := 0
    while i < n {
        _kv_encode_frame(frames, ibuf_get(db.tx_ops, i), ibuf_get(db.tx_exps, i), svec_get(db.tx_keys, i), svec_get(db.tx_vals, i))
        i += 1
    }
    _kv_encode_frame(frames, 3, 0, "", "") // Atomic `TX_COMMIT` boundary marker
    ok_disk := _kv_append_wal_disk(db.path, frames)
    buf_free(move frames)
    if not ok_disk { return false }
    i = 0
    while i < n {
        op := ibuf_get(db.tx_ops, i)
        k := svec_get(db.tx_keys, i)
        if op == 1 {
            _kv_apply_mem_put(mut db, k, svec_get(db.tx_vals, i), ibuf_get(db.tx_exps, i))
        } else if op == 2 {
            _kv_apply_mem_del(mut db, k)
        }
        i += 1
    }
    _kv_clear_tx_buffers(mut db)
    return true
}

fn kv_put_ttl(mut db: KvStore, key: str, val: str, exp_unix: i64 = 0) -> bool {
    if str_len(key) == 0 { return false }
    if db.in_tx {
        ibuf_push(db.tx_ops, 1)
        svec_push(mut db.tx_keys, key)
        svec_push(mut db.tx_vals, val)
        ibuf_push(db.tx_exps, exp_unix)
        return true
    }
    frames := buf_new(str_len(key) + str_len(val) + 32)
    _kv_encode_frame(frames, 1, exp_unix, key, val)
    ok_d := _kv_append_wal_disk(db.path, frames)
    buf_free(move frames)
    if not ok_d { return false }
    _kv_apply_mem_put(mut db, key, val, exp_unix)
    return true
}

fn kv_put(mut db: KvStore, key: str, val: str) -> bool {
    return kv_put_ttl(mut db, key, val, 0)
}

fn kv_del(mut db: KvStore, key: str) -> bool {
    if str_len(key) == 0 { return false }
    if db.in_tx {
        ibuf_push(db.tx_ops, 2)
        svec_push(mut db.tx_keys, key)
        svec_push(mut db.tx_vals, "")
        ibuf_push(db.tx_exps, 0)
        return true
    }
    frames := buf_new(str_len(key) + 32)
    _kv_encode_frame(frames, 2, 0, key, "")
    ok_d := _kv_append_wal_disk(db.path, frames)
    buf_free(move frames)
    if not ok_d { return false }
    _kv_apply_mem_del(mut db, key)
    return true
}

// Reads key with Read-Your-Own-Writes transactional visibility and optional `now_unix` TTL enforcement!
fn kv_get(db: KvStore, key: str, now_unix: i64 = 0) -> str ! i64 {
    if db.in_tx {
        // Scan uncommitted staging log newest-to-oldest
        mut i := ibuf_len(db.tx_ops) - 1
        while i >= 0 {
            if str_eq(svec_get(db.tx_keys, i), key) {
                op := ibuf_get(db.tx_ops, i)
                if op == 2 { return err(404) }
                exp := ibuf_get(db.tx_exps, i)
                if now_unix > 0 and exp > 0 and now_unix >= exp { return err(404) }
                return ok("" + svec_get(db.tx_vals, i))
            }
            i -= 1
        }
    }
    if not smap_has(db.live_vals, key) { return err(404) }
    exp := smap_get_i64(db.live_exps, key, 0)
    if now_unix > 0 and exp > 0 and now_unix >= exp { return err(404) }
    return ok("" + smap_get_str(db.live_vals, key, ""))
}

// Returns sorted distinct live keys matching `prefix`!
fn kv_scan_prefix(db: KvStore, prefix: str, now_unix: i64 = 0) -> StrVec {
    plen := str_len(prefix)
    n := svec_len(db.key_log)
    mut seen := smap_new(64)
    mut matches := svec_new(16, 256)
    mut i := 0
    while i < n {
        k := svec_get(db.key_log, i)
        if not smap_has(seen, k) {
            smap_set_i64(mut seen, k, 1)
            if smap_has(db.live_vals, k) {
                exp := smap_get_i64(db.live_exps, k, 0)
                expired := now_unix > 0 and exp > 0 and now_unix >= exp
                if not expired and str_len(k) >= plen and (plen == 0 or str_eq(str_slice(k, 0, plen), prefix)) {
                    svec_push(mut matches, k)
                }
            }
        }
        i += 1
    }
    smap_free(move seen)
    // Lexicographical sort of matched keys via index array
    m := svec_len(matches)
    if m <= 1 { return matches }
    order := ibuf_new(m + 4)
    i = 0
    while i < m { ibuf_push(order, i); i += 1 }
    i = 0
    while i < m - 1 {
        mut best := i
        mut j := i + 1
        while j < m {
            if str_cmp(svec_get(matches, ibuf_get(order, j)), svec_get(matches, ibuf_get(order, best))) < 0 {
                best = j
            }
            j += 1
        }
        if best != i {
            tmp := ibuf_get(order, i)
            ibuf_set(order, i, ibuf_get(order, best))
            ibuf_set(order, best, tmp)
        }
        i += 1
    }
    mut sorted := svec_new(m + 4, m * 16 + 32)
    i = 0
    while i < m {
        svec_push(mut sorted, svec_get(matches, ibuf_get(order, i)))
        i += 1
    }
    buf_free(move order)
    svec_free(move matches)
    return sorted
}

// Rewrites WAL atomically (`tmp` + replace) keeping only live non-expired keys to reclaim disk space!
fn kv_compact(mut db: KvStore, now_unix: i64 = 0) -> bool {
    if db.in_tx { return false }
    if str_len(db.path) == 0 or str_eq(db.path, ":memory:") { return true }
    live_keys := kv_scan_prefix(db, "", now_unix)
    m := svec_len(live_keys)
    mut total_sz := 16
    mut si := 0
    while si < m {
        sk := svec_get(live_keys, si)
        sv := smap_get_str(db.live_vals, sk, "")
        total_sz += 24 + str_len(sk) + str_len(sv)
        si += 1
    }
    compacted := buf_new(total_sz)
    buf_push(compacted, 65); buf_push(compacted, 88); buf_push(compacted, 75); buf_push(compacted, 86)
    buf_push(compacted, 1);  buf_push(compacted, 0);  buf_push(compacted, 0);  buf_push(compacted, 0)
    mut i := 0
    while i < m {
        k := svec_get(live_keys, i)
        v := smap_get_str(db.live_vals, k, "")
        exp := smap_get_i64(db.live_exps, k, 0)
        _kv_encode_frame(compacted, 1, exp, k, v)
        i += 1
    }
    svec_free(move live_keys)
    nonce := (clock_ns() ^ cpu_rdtsc()) & 0x7FFFFFFF
    tmp_path := f"{db.path}.compact.{nonce}.tmp"
    rc := fs_write_file(tmp_path, compacted)
    buf_free(move compacted)
    if rc < 0 { return false }
    raw_new := fs_read_file(tmp_path) or return false
    rc2 := fs_write_file(db.path, raw_new)
    buf_free(move raw_new)
    _ := sys_fs_remove(tmp_path)
    return rc2 >= 0
}
