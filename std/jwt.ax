// Axon Standard Library — JWT (RFC-7519 HS256) & Password/Token Security (`std/jwt.ax`)
// Hardened against `"alg":"none"` downgrade, signature timing attacks (`ct_eq_str`),
// empty secrets, and expired/not-before claims (`exp` / `nbf`).

use std::str
use std::encoding
use std::crypto
use std::json

fn _jwt_hmac_hs256_b64u(secret: str, signing_input: str) -> str ! i64 {
    if str_len(secret) == 0 { return err(401) }
    hex_mac := hmac_sha256_str(secret, signing_input)
    raw32 := str_from_hex(hex_mac) or return err(500)
    return ok(base64url_encode(raw32))
}

fn jwt_sign_hs256(payload_json: str, secret: str) -> str ! i64 {
    if str_len(secret) == 0 or str_len(payload_json) == 0 { return err(400) }
    hdr_b64 := base64url_encode("{\"alg\":\"HS256\",\"typ\":\"JWT\"}")
    pay_b64 := base64url_encode(payload_json)
    signing_in := hdr_b64 + "." + pay_b64
    sig_b64 := _jwt_hmac_hs256_b64u(secret, signing_in) or return err(401)
    return ok(signing_in + "." + sig_b64)
}

// Verifies RFC-7519 HS256 JWT and returns the decoded JSON payload string on success.
// When `now_unix > 0`, enforces `exp > now_unix` and `nbf <= now_unix` if present in payload.
fn jwt_verify_hs256(token: str, secret: str, now_unix: i64 = 0) -> str ! i64 {
    if str_len(secret) == 0 or str_len(token) < 8 or str_len(token) > 16384 { return err(401) }
    d1 := str_find_byte(token, 46, 0)
    if d1 <= 0 { return err(401) }
    d2 := str_find_byte(token, 46, d1 + 1)
    if d2 <= d1 + 1 { return err(401) }
    if str_find_byte(token, 46, d2 + 1) >= 0 { return err(401) } // reject >3 segments

    hdr_b64 := str_slice(token, 0, d1)
    pay_b64 := str_slice(token, d1 + 1, d2)
    sig_b64 := str_slice(token, d2 + 1, str_len(token))
    if str_len(sig_b64) == 0 { return err(401) }

    // 1. Decode header FIRST and strictly require `"alg":"HS256"` (blocks `"alg":"none"` & RS256 confusion!)
    hdr_json := base64url_decode(hdr_b64) or return err(401)
    alg := json_get_str(hdr_json, "alg") or return err(401)
    if not str_eq(alg, "HS256") { return err(401) }

    // 2. Compute expected HMAC-SHA256 and compare in constant time
    signing_in := str_slice(token, 0, d2)
    exp_sig := _jwt_hmac_hs256_b64u(secret, signing_in) or return err(401)
    if not ct_eq_str(sig_b64, exp_sig) { return err(401) }

    // 3. Decode payload & enforce temporal claims (`exp` / `nbf`) without magic sentinel collisions (CWE-613)
    pay_json := base64url_decode(pay_b64) or return err(401)
    if now_unix > 0 {
        exp0 := json_get_i64(pay_json, "exp") or 0
        exp1 := json_get_i64(pay_json, "exp") or 1
        if exp0 == exp1 {
            if now_unix >= exp0 { return err(403) }
        } else if str_find(pay_json, "\"exp\"", 0) >= 0 {
            return err(401)
        }
        nbf0 := json_get_i64(pay_json, "nbf") or 0
        nbf1 := json_get_i64(pay_json, "nbf") or 1
        if nbf0 == nbf1 {
            if now_unix < nbf0 { return err(403) }
        } else if str_find(pay_json, "\"nbf\"", 0) >= 0 {
            return err(401)
        }
    }
    return ok(pay_json)
}

// Iterative salted HMAC-SHA256 password stretching (`iterations >= 1000` enforced).
fn password_hash_sha256(password: str, salt: str, iterations: i64 = 10000) -> str {
    mut iters := iterations
    if iters < 1000 { iters = 1000 }
    if iters > 1000000 { iters = 1000000 }
    mut cur := hmac_sha256_str(password, salt + ":v1")
    mut i := 1
    while i < iters {
        cur = hmac_sha256_str(password, cur)
        i += 1
    }
    return cur
}

fn password_verify_sha256(password: str, salt: str, expected_hex: str, iterations: i64 = 10000) -> bool {
    got := password_hash_sha256(password, salt, iterations)
    return ct_eq_str(got, expected_hex)
}
