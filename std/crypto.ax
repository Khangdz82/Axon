    ibuf_push(k, 0x72be5d74); ibuf_push(k, 0x80deb1fe); ibuf_push(k, 0x9bdc06a7); ibuf_push(k, 0xc19bf174)
    ibuf_push(k, 0xe49b69c1); ibuf_push(k, 0xefbe4786); ibuf_push(k, 0x0fc19dc6); ibuf_push(k, 0x240ca1cc)
    ibuf_push(k, 0x2de92c6f); ibuf_push(k, 0x4a7484aa); ibuf_push(k, 0x5cb0a9dc); ibuf_push(k, 0x76f988da)
    ibuf_push(k, 0x983e5152); ibuf_push(k, 0xa831c66d); ibuf_push(k, 0xb00327c8); ibuf_push(k, 0xbf597fc7)
    ibuf_push(k, 0xc6e00bf3); ibuf_push(k, 0xd5a79147); ibuf_push(k, 0x06ca6351); ibuf_push(k, 0x14292967)
    ibuf_push(k, 0x27b70a85); ibuf_push(k, 0x2e1b2138); ibuf_push(k, 0x4d2c6dfc); ibuf_push(k, 0x53380d13)
    ibuf_push(k, 0x650a7354); ibuf_push(k, 0x766a0abb); ibuf_push(k, 0x81c2c92e); ibuf_push(k, 0x92722c85)
    ibuf_push(k, 0xa2bfe8a1); ibuf_push(k, 0xa81a664b); ibuf_push(k, 0xc24b8b70); ibuf_push(k, 0xc76c51a3)
    ibuf_push(k, 0xd192e819); ibuf_push(k, 0xd6990624); ibuf_push(k, 0xf40e3585); ibuf_push(k, 0x106aa070)
    ibuf_push(k, 0x19a4c116); ibuf_push(k, 0x1e376c08); ibuf_push(k, 0x2748774c); ibuf_push(k, 0x34b0bcb5)
    ibuf_push(k, 0x391c0cb3); ibuf_push(k, 0x4ed8aa4a); ibuf_push(k, 0x5b9cca4f); ibuf_push(k, 0x682e6ff3)
    ibuf_push(k, 0x748f82ee); ibuf_push(k, 0x78a5636f); ibuf_push(k, 0x84c87814); ibuf_push(k, 0x8cc70208)
    ibuf_push(k, 0x90befffa); ibuf_push(k, 0xa4506ceb); ibuf_push(k, 0xbef9a3f7); ibuf_push(k, 0xc67178f2)
    return k
}

fn sha256_hex_append(out: ByteBuf, val: i64) {
    mut s := 28
    while s >= 0 {
        nib := (val >> s) & 15
        if nib < 10 {
            buf_push(out, 48 + nib)
        } else {
            buf_push(out, 87 + nib)
        }
        s -= 4
    }
}

