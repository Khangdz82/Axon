// Axon v6.0 AV-Clean White-Box Cryptography & Constant-Time Integrity Primitives (`std/crypto.ax`)
// Uses compile-time GF(2^8) dual-bijective lookup tables (`whitebox_sbox`) so secret keys
// are dissolved into structured low-entropy (< 4.2) S-Box tables rather than `.rdata` keys.

@whitebox
fn whitebox_round(state: i64, byte_in: i64) -> i64 {
    b0 := (state ^ byte_in) & 255
    b1 := ((state >> 8) ^ byte_in) & 255
    b2 := ((state >> 16) ^ b0) & 255
    b3 := ((state >> 24) ^ b1) & 255

    s0 := whitebox_sbox(0x7319A5C3, b0)
    s1 := whitebox_sbox(0x9E3779B9, b1)
    s2 := whitebox_sbox(0xBF58476D, b2)
    s3 := whitebox_sbox(0x94D049BB, b3)

    mixed := s0 | (s1 << 8) | (s2 << 16) | (s3 << 24)
    return ((state << 7) | ((state >> 25) & 127)) ^ mixed
}

@whitebox
fn whitebox_mac_str(msg: str) -> i64 {
    n := str_len(msg)
    mut acc := 0x243F6A88
    mut i := 0
    while i < n {
        ch := str_byte(msg, i)
        acc = whitebox_round(acc, ch)
        i += 1
    }
    return acc & 0x7FFFFFFF
}

fn fnv1a_str(msg: str) -> i64 {
    n := str_len(msg)
    mut h := 2166136261
    mut i := 0
    while i < n {
        b := str_byte(msg, i)
        h = (h ^ b) *% 16777619
        h = h & 0xFFFFFFFF
        i += 1
    }
    return h
}

// Constant-time 64-bit tag equality check (zero early-exit branch leakage)
@inline
fn ct_eq_i64(a: i64, b: i64) -> bool {
    diff := a ^ b
    folded := diff | (0 -% diff)
    return ushr64(folded, 63) == 0
}

@inline
fn verify_tag(expected: i64, actual: i64) -> bool {
    return ct_eq_i64(expected, actual)
}

// Constant-time byte-slice equality (iterates over `max(la, lb)` so timing never leaks secret length, CWE-208)
fn ct_eq_str(a: str, b: str) -> bool {
    la := str_len(a)
    lb := str_len(b)
    mut diff := la ^ lb
    mut n := la
    if lb > n {
        n = lb
    }
    mut i := 0
    while i < n {
        mut ba := 0
        mut bb := 0
        if i < la { ba = str_byte(a, i) }
        if i < lb { bb = str_byte(b, i) }
        diff = diff | (ba ^ bb)
        i += 1
    }
    return ct_eq_i64(diff, 0)
}

@inline
fn sha256_rotr32(x: i64, n: i64) -> i64 {
    v := x & 0xFFFFFFFF
    return (ushr64(v, n) | (v << (32 - n))) & 0xFFFFFFFF
}

fn sha256_init_k() -> IntBuf {
    k := ibuf_new(64)
    ibuf_push(k, 0x428a2f98); ibuf_push(k, 0x71374491); ibuf_push(k, 0xb5c0fbcf); ibuf_push(k, 0xe9b5dba5)
    ibuf_push(k, 0x3956c25b); ibuf_push(k, 0x59f111f1); ibuf_push(k, 0x923f82a4); ibuf_push(k, 0xab1c5ed5)
    ibuf_push(k, 0xd807aa98); ibuf_push(k, 0x12835b01); ibuf_push(k, 0x243185be); ibuf_push(k, 0x550c7dc3)
    ibuf_push(k, 0x72be5d74); ibuf_push(k, 0x80deb1fe); ibuf_push(k, 0x9bdc06a7); ibuf_push(k, 0xc19bf174)
    ibuf_push(k, 0xe49b69c1); ibuf_push(k, 0xefbe4786); ibuf_push(k, 0x0fc19dc6); ibuf_push(k, 0x240ca1cc)
    ibuf_push(k, 0x2de92c6f); ibuf_push(k, 0x4a7484aa); ibuf_push(k, 0x5cb0a9dc); ibuf_push(k, 0x76f988da)
    ibuf_push(k, 0x983e5152); ibuf_push(k, 0xa831c66d); ibuf_push(k, 0xb00327c8); ibuf_push(k, 0xbf597fc7)
    ibuf_push(k, 0xc6e00bf3); ibuf_push(k, 0xd5a79147); ibuf_push(k, 0x06ca6351); ibuf_push(k, 0x14292967)
    ibuf_push(k, 0x27b70a85); ibuf_push(k, 0x2e1b2138); ibuf_push(k, 0x4d2c6dfc); ibuf_push(k, 0x53380d13)
    ibuf_push(k, 0x650a7354); ibuf_push(k, 0x766a0abb); ibuf_push(k, 0x81c2c92e); ibuf_push(k, 0x92722c85)
    ibuf_push(k, 0xa2bfe8a1); ibuf_push(k, 0xa81a664b); ibuf_push(k, 0xc24b8b70); ibuf_push(k, 0xc76c51a3)
    ibuf_push(k, 0xd192e819); ibuf_push(k, 0xd6990624); ibuf_push(k, 0xf40e3585); ibuf_push(k, 0x106aa070)
    ibuf_push(k, 0x19a4c116); ibuf_push(k, 0x1e376c08); ibuf_push(k, 0x2748774c); ibuf_push(k, 0x34b0bcb5)
    ibuf_push(k, 0x391c0cb3); ibuf_push(k, 0x4ed8aa4a); ibuf_push(k, 0x5b9cca4f); ibuf_push(k, 0x682e6ff3)
    ibuf_push(k, 0x748f82ee); ibuf_push(k, 0x78a5636f); ibuf_push(k, 0x84c87814); ibuf_push(k, 0x8cc70208)
    ibuf_push(k, 0x90befffa); ibuf_push(k, 0xa4506ceb); ibuf_push(k, 0xbef9a3f7); ibuf_push(k, 0xc67178f2)
    return k
}

fn sha256_hex_append(out: ByteBuf, val: i64) {
    mut s := 28
    while s >= 0 {
        nib := (val >> s) & 15
        if nib < 10 {
            buf_push(out, 48 + nib)
        } else {
            buf_push(out, 87 + nib)
        }
        s -= 4
    }
}

fn _sha256_compress(h: IntBuf, k: IntBuf, w: IntBuf) {
    mut t := 16
    while t < 64 {
        w15 := ibuf_get(w, t - 15)
        w2 := ibuf_get(w, t - 2)
        s0 := ((ushr64(w15, 7) | (w15 << 25)) & 0xFFFFFFFF) ^ ((ushr64(w15, 18) | (w15 << 14)) & 0xFFFFFFFF) ^ ushr64(w15, 3)
        s1 := ((ushr64(w2, 17) | (w2 << 15)) & 0xFFFFFFFF) ^ ((ushr64(w2, 19) | (w2 << 13)) & 0xFFFFFFFF) ^ ushr64(w2, 10)
        ibuf_set(w, t, (ibuf_get(w, t - 16) +% s0 +% ibuf_get(w, t - 7) +% s1) & 0xFFFFFFFF)
        t += 1
    }

    mut a := ibuf_get(h, 0); mut b := ibuf_get(h, 1); mut c := ibuf_get(h, 2); mut d := ibuf_get(h, 3)
    mut e := ibuf_get(h, 4); mut f := ibuf_get(h, 5); mut g := ibuf_get(h, 6); mut hv := ibuf_get(h, 7)
    t = 0
    while t < 64 {
        s1 := ((ushr64(e, 6) | (e << 26)) & 0xFFFFFFFF) ^ ((ushr64(e, 11) | (e << 21)) & 0xFFFFFFFF) ^ ((ushr64(e, 25) | (e << 7)) & 0xFFFFFFFF)
        ch := g ^ (e & (f ^ g))
        temp1 := (hv +% s1 +% ch +% ibuf_get(k, t) +% ibuf_get(w, t)) & 0xFFFFFFFF
        s0 := ((ushr64(a, 2) | (a << 30)) & 0xFFFFFFFF) ^ ((ushr64(a, 13) | (a << 19)) & 0xFFFFFFFF) ^ ((ushr64(a, 22) | (a << 10)) & 0xFFFFFFFF)
        maj := (a & b) | (c & (a | b))
        temp2 := (s0 +% maj) & 0xFFFFFFFF

        hv = g; g = f; f = e; e = (d +% temp1) & 0xFFFFFFFF
        d = c; c = b; b = a; a = (temp1 +% temp2) & 0xFFFFFFFF
        t += 1
    }
    ibuf_set(h, 0, (ibuf_get(h, 0) +% a) & 0xFFFFFFFF)
    ibuf_set(h, 1, (ibuf_get(h, 1) +% b) & 0xFFFFFFFF)
    ibuf_set(h, 2, (ibuf_get(h, 2) +% c) & 0xFFFFFFFF)
    ibuf_set(h, 3, (ibuf_get(h, 3) +% d) & 0xFFFFFFFF)
    ibuf_set(h, 4, (ibuf_get(h, 4) +% e) & 0xFFFFFFFF)
    ibuf_set(h, 5, (ibuf_get(h, 5) +% f) & 0xFFFFFFFF)
    ibuf_set(h, 6, (ibuf_get(h, 6) +% g) & 0xFFFFFFFF)
    ibuf_set(h, 7, (ibuf_get(h, 7) +% hv) & 0xFFFFFFFF)
}

fn _sha256_init_h() -> IntBuf {
    h := ibuf_new(8)
    ibuf_push(h, 0x6a09e667); ibuf_push(h, 0xbb67ae85)
    ibuf_push(h, 0x3c6ef372); ibuf_push(h, 0xa54ff53a)
    ibuf_push(h, 0x510e527f); ibuf_push(h, 0x9b05688c)
    ibuf_push(h, 0x1f83d9ab); ibuf_push(h, 0x5be0cd19)
    return h
}

fn _sha256_finish_tail(tail: ByteBuf, bit_len: i64, h: IntBuf, k: IntBuf, w: IntBuf) {
    buf_push(tail, 0x80)
    mut pad_len := 64
    if buf_len(tail) > 56 { pad_len = 128 }
    while buf_len(tail) < pad_len - 8 {
        buf_push(tail, 0)
    }
    mut sh := 56
    while sh >= 0 {
        buf_push(tail, ushr64(bit_len, sh) & 255)
        sh -= 8
    }
    mut off := 0
    while off < pad_len {
        mut t := 0
        while t < 16 {
            bo := off + t * 4
            ibuf_set(w, t, (buf_get(tail, bo) << 24) | (buf_get(tail, bo + 1) << 16) | (buf_get(tail, bo + 2) << 8) | buf_get(tail, bo + 3))
            t += 1
        }
        _sha256_compress(h, k, w)
        off += 64
    }
}

fn sha256_raw_digest(data: ByteBuf) -> IntBuf {
    dlen := buf_len(data)
    h := _sha256_init_h()
    k := sha256_init_k()
    w := ibuf_new(64)
    mut wi := 0
    while wi < 64 { ibuf_push(w, 0); wi += 1 }

    mut off := 0
    while off + 64 <= dlen {
        mut t := 0
        while t < 16 {
            bo := off + t * 4
            ibuf_set(w, t, (buf_get(data, bo) << 24) | (buf_get(data, bo + 1) << 16) | (buf_get(data, bo + 2) << 8) | buf_get(data, bo + 3))
            t += 1
        }
        _sha256_compress(h, k, w)
        off += 64
    }

    tail := buf_new(128)
    while off < dlen {
        buf_push(tail, buf_get(data, off))
        off += 1
    }
    _sha256_finish_tail(tail, dlen * 8, h, k, w)
    buf_free(move tail)
    buf_free(move w)
    buf_free(move k)
    return h
}

fn _sha256_digest_to_hex(move h: IntBuf) -> str {
    out := buf_new(64)
    mut i := 0
    while i < 8 {
        sha256_hex_append(out, ibuf_get(h, i))
        i += 1
    }
    s := "" + buf_slice_str(out, 0, 64)
    buf_free(move out)
    buf_free(move h)
    return s
}

fn sha256_bytes(data: ByteBuf) -> str {
    return _sha256_digest_to_hex(sha256_raw_digest(data))
}

fn sha256_str(s: str) -> str {
    slen := str_len(s)
    h := _sha256_init_h()
    k := sha256_init_k()
    w := ibuf_new(64)
    mut wi := 0
    while wi < 64 { ibuf_push(w, 0); wi += 1 }

    mut off := 0
    while off + 64 <= slen {
        mut t := 0
        while t < 16 {
            bo := off + t * 4
            ibuf_set(w, t, (str_byte(s, bo) << 24) | (str_byte(s, bo + 1) << 16) | (str_byte(s, bo + 2) << 8) | str_byte(s, bo + 3))
            t += 1
        }
        _sha256_compress(h, k, w)
        off += 64
    }

    tail := buf_new(128)
    while off < slen {
        buf_push(tail, str_byte(s, off))
        off += 1
    }
    _sha256_finish_tail(tail, slen * 8, h, k, w)
    buf_free(move tail)
    buf_free(move w)
    buf_free(move k)
    return _sha256_digest_to_hex(move h)
}

fn _crypto_wipe_buf(b: ByteBuf) {
    n := buf_len(b)
    mut i := 0
    while i < n {
        buf_set(b, i, 0)
        i += 1
    }
}

fn hmac_sha256_str(key: str, msg: str) -> str {
    klen := str_len(key)
    kblock := buf_new(64)
    if klen > 64 {
        kb := buf_new(klen + 1)
        buf_push_str(kb, key)
        kh := sha256_raw_digest(kb)
        mut j := 0
        while j < 8 {
            v := ibuf_get(kh, j)
            buf_push(kblock, (v >> 24) & 255)
            buf_push(kblock, (v >> 16) & 255)
            buf_push(kblock, (v >> 8) & 255)
            buf_push(kblock, v & 255)
            j += 1
        }
        buf_free(move kh)
        _crypto_wipe_buf(kb)
        buf_free(move kb)
    } else {
        mut j := 0
        while j < klen {
            buf_push(kblock, str_byte(key, j))
            j += 1
        }
    }
    while buf_len(kblock) < 64 {
        buf_push(kblock, 0)
    }

    mlen := str_len(msg)
    inner := buf_new(64 + mlen + 1)
    mut i := 0
    while i < 64 {
        buf_push(inner, buf_get(kblock, i) ^ 0x36)
        i += 1
    }
    buf_push_str(inner, msg)
    ih := sha256_raw_digest(inner)
    _crypto_wipe_buf(inner)
    buf_free(move inner)

    outer := buf_new(96)
    i = 0
    while i < 64 {
        buf_push(outer, buf_get(kblock, i) ^ 0x5c)
        i += 1
    }
    i = 0
    while i < 8 {
        v := ibuf_get(ih, i)
        buf_push(outer, (v >> 24) & 255)
        buf_push(outer, (v >> 16) & 255)
        buf_push(outer, (v >> 8) & 255)
        buf_push(outer, v & 255)
        i += 1
    }
    buf_free(move ih)
    _crypto_wipe_buf(kblock)
    buf_free(move kblock)

    res := sha256_bytes(outer)
    _crypto_wipe_buf(outer)
    buf_free(move outer)
    return res
}

// Constant-time HMAC-SHA256 verification (CWE-208 safe)
fn hmac_sha256_verify(key: str, msg: str, expected_hex: str) -> bool {
    got := hmac_sha256_str(key, msg)
    return ct_eq_str(got, expected_hex)
}

// Streaming SHA-256 context (`hashlib.sha256()` equivalent) — processes arbitrary streams in 64-byte blocks
struct Sha256Ctx {
    h: IntBuf
    k: IntBuf
    w: IntBuf
    block: ByteBuf
    total_bytes: i64
}

fn sha256_ctx_new() -> Sha256Ctx {
    h := ibuf_new(8)
    ibuf_push(h, 0x6a09e667); ibuf_push(h, 0xbb67ae85)
    ibuf_push(h, 0x3c6ef372); ibuf_push(h, 0xa54ff53a)
    ibuf_push(h, 0x510e527f); ibuf_push(h, 0x9b05688c)
    ibuf_push(h, 0x1f83d9ab); ibuf_push(h, 0x5be0cd19)
    k := sha256_init_k()
    w := ibuf_new(64)
    mut wi := 0
    while wi < 64 { ibuf_push(w, 0); wi += 1 }
    blk := buf_new(64)
    return Sha256Ctx(h = h, k = k, w = w, block = blk, total_bytes = 0)
}

fn sha256_ctx_free(move ctx: Sha256Ctx) {
    buf_free(move ctx.h)
    buf_free(move ctx.k)
    buf_free(move ctx.w)
    buf_free(move ctx.block)
}

fn _sha256_compress_block(ctx: Sha256Ctx) {
    mut t := 0
    while t < 16 {
        bo := t * 4
        word := (buf_get(ctx.block, bo) << 24) | (buf_get(ctx.block, bo + 1) << 16) | (buf_get(ctx.block, bo + 2) << 8) | buf_get(ctx.block, bo + 3)
        ibuf_set(ctx.w, t, word)
        t += 1
    }
    _sha256_compress(ctx.h, ctx.k, ctx.w)
}

fn sha256_ctx_update_str(mut ctx: Sha256Ctx, s: str) {
    n := str_len(s)
    mut i := 0
    if buf_len(ctx.block) > 0 {
        while i < n and buf_len(ctx.block) < 64 {
            buf_push(ctx.block, str_byte(s, i))
            ctx.total_bytes = ctx.total_bytes +% 1
            i += 1
        }
        if buf_len(ctx.block) == 64 {
            _sha256_compress_block(ctx)
            buf_truncate(ctx.block, 0)
        }
    }
    while i + 64 <= n {
        mut t := 0
        while t < 16 {
            bo := i + t * 4
            ibuf_set(ctx.w, t, (str_byte(s, bo) << 24) | (str_byte(s, bo + 1) << 16) | (str_byte(s, bo + 2) << 8) | str_byte(s, bo + 3))
            t += 1
        }
        _sha256_compress(ctx.h, ctx.k, ctx.w)
        ctx.total_bytes = ctx.total_bytes +% 64
        i += 64
    }
    while i < n {
        buf_push(ctx.block, str_byte(s, i))
        ctx.total_bytes = ctx.total_bytes +% 1
        i += 1
    }
}

fn sha256_ctx_update_bytes(mut ctx: Sha256Ctx, data: ByteBuf, start: i64 = 0, count: i64 = -1) {
    bl := buf_len(data)
    mut s := if start < 0 { 0 } else { start }
    if s >= bl { return }
    mut end := bl
    if count >= 0 {
        rem := bl - s
        if count < rem { end = s + count }
    }
    if buf_len(ctx.block) > 0 {
        while s < end and buf_len(ctx.block) < 64 {
            buf_push(ctx.block, buf_get(data, s))
            ctx.total_bytes = ctx.total_bytes +% 1
            s += 1
        }
        if buf_len(ctx.block) == 64 {
            _sha256_compress_block(ctx)
            buf_truncate(ctx.block, 0)
        }
    }
    while s + 64 <= end {
        mut t := 0
        while t < 16 {
            bo := s + t * 4
            ibuf_set(ctx.w, t, (buf_get(data, bo) << 24) | (buf_get(data, bo + 1) << 16) | (buf_get(data, bo + 2) << 8) | buf_get(data, bo + 3))
            t += 1
        }
        _sha256_compress(ctx.h, ctx.k, ctx.w)
        ctx.total_bytes = ctx.total_bytes +% 64
        s += 64
    }
    while s < end {
        buf_push(ctx.block, buf_get(data, s))
        ctx.total_bytes = ctx.total_bytes +% 1
        s += 1
    }
}

fn sha256_ctx_finish_hex(mut ctx: Sha256Ctx) -> str {
    bit_len := ctx.total_bytes *% 8
    buf_push(ctx.block, 0x80)
    if buf_len(ctx.block) > 56 {
        while buf_len(ctx.block) < 64 { buf_push(ctx.block, 0) }
        _sha256_compress_block(ctx)
        buf_truncate(ctx.block, 0)
    }
    while buf_len(ctx.block) < 56 { buf_push(ctx.block, 0) }
    mut sh := 56
    while sh >= 0 {
        buf_push(ctx.block, ushr64(bit_len, sh) & 255)
        sh -= 8
    }
    _sha256_compress_block(ctx)
    buf_truncate(ctx.block, 0)

    out := buf_new(64)
    mut i := 0
    while i < 8 {
        sha256_hex_append(out, ibuf_get(ctx.h, i))
        i += 1
    }
    return buf_to_owned_str(move out)
}
