fn _sha256_buf_u32_be(b: ByteBuf, o: i64) -> i64 {
    return (buf_get(b, o) << 24) | (buf_get(b, o + 1) << 16) | (buf_get(b, o + 2) << 8) | buf_get(b, o + 3)
}

fn _sha256_str_u32_be(s: str, o: i64) -> i64 {
    return (str_byte(s, o) << 24) | (str_byte(s, o + 1) << 16) | (str_byte(s, o + 2) << 8) | str_byte(s, o + 3)
}

fn _sha256_compress_buf_at(h: IntBuf, data: ByteBuf, off: i64) {
    _sha256_compress_w16(h,
        _sha256_buf_u32_be(data, off), _sha256_buf_u32_be(data, off + 4), _sha256_buf_u32_be(data, off + 8), _sha256_buf_u32_be(data, off + 12),
        _sha256_buf_u32_be(data, off + 16), _sha256_buf_u32_be(data, off + 20), _sha256_buf_u32_be(data, off + 24), _sha256_buf_u32_be(data, off + 28),
        _sha256_buf_u32_be(data, off + 32), _sha256_buf_u32_be(data, off + 36), _sha256_buf_u32_be(data, off + 40), _sha256_buf_u32_be(data, off + 44),
        _sha256_buf_u32_be(data, off + 48), _sha256_buf_u32_be(data, off + 52), _sha256_buf_u32_be(data, off + 56), _sha256_buf_u32_be(data, off + 60))
}

fn _sha256_compress_str_at(h: IntBuf, s: str, off: i64) {
    _sha256_compress_w16(h,
