// Axon v7.0 LoRA, DoRA & QLoRA Parameter-Efficient Fine-Tuning Engine (`std/ai_lora.ax`)
// Features:
//   - FP32 LoRA, NF4/Q4/Q8 QLoRA (frozen quantized base + trainable FP32 adapters), and DoRA magnitude scaling
//   - Zero-alloc forward/backward kernels (`@no_alloc` + `@nan_guard`)
//   - Zero-overhead `lora_merge_into_f32` / `lora_unmerge_from_f32` for instant hot-swapping
//   - Compact `.axlora` binary checkpoint format with FNV-64 integrity checksum

use std::ai_math
use std::ai_quant
use std::ai_autograd

struct LoraAdapter {
    in_dim: i64
    out_dim: i64
    rank: i64
    alpha: f64
    scale: f64
    a: ParamTensor   // [rank, in_dim]
    b: ParamTensor   // [out_dim, rank]
    mag: ParamTensor // [out_dim] (used when DoRA is enabled, else 1-elem dummy)
    use_dora: bool
    merged_ptr: i64  // 64-byte state: [0]=is_merged (0/1)
}

fn lora_new(in_dim: i64, out_dim: i64, rank: i64, alpha: f64, rng: AiRng, opt_kind: i64 = 2, use_dora: bool = false) -> LoraAdapter {
    unsafe {
    mut r := rank
    if r < 1 { r = 1 }
    if r > 4096 { r = 4096 }
    mut ind := in_dim
    if ind < 1 { ind = 1 }
    if ind > 65536 { ind = 65536 }
    mut outd := out_dim
    if outd < 1 { outd = 1 }
    if outd > 65536 { outd = 65536 }

    a := param_new(r * ind, opt_kind)
    b := param_new(outd * r, opt_kind)
    // Kaiming init for `A`, exact 0 init for `B` so initial delta = 0
    if a.data_ptr != 0 {
        init_kaiming_normal_f32(a.data_ptr, r * ind, ind, rng)
    }
    if b.data_ptr != 0 {
        vec_zero_f32(b.data_ptr, outd * r)
    }
    mut mag_sz := 1
    if use_dora { mag_sz = outd }
    mag := param_new(mag_sz, opt_kind)
    if mag.data_ptr != 0 {
        mut i := 0
        while i < mag_sz {
            ptr_write_f32(mag.data_ptr, i, 1.0)
            i += 1
        }
    }
    mp := mem_alloc_aligned(64)
    if mp != 0 {
        ptr_write_i64(mp, 0, 0)
    }
    return LoraAdapter(
        in_dim = ind,
        out_dim = outd,
        rank = r,
        alpha = alpha,
        scale = alpha / (r as f64),
        a = a,
        b = b,
        mag = mag,
        use_dora = use_dora,
        merged_ptr = mp
    )
    }
}

fn lora_free(move l: LoraAdapter) {
    unsafe {
    param_free(move l.a)
    param_free(move l.b)
    param_free(move l.mag)
    if l.merged_ptr != 0 { mem_free_aligned(l.merged_ptr) }
    }
}

@no_alloc
fn lora_param_count(l: LoraAdapter) -> i64 {
    mut cnt := l.rank * l.in_dim + l.out_dim * l.rank
    if l.use_dora { cnt = cnt + l.out_dim }
    return cnt
}

@no_alloc
fn lora_zero_grad(l: LoraAdapter) {
    param_zero_grad(l.a)
    param_zero_grad(l.b)
    if l.use_dora { param_zero_grad(l.mag) }
}

// Forward pass for FP32 base weight `base_w_ptr[out_dim, in_dim]`.
// `hidden_buf` must have at least `batch * rank` floats (pre-allocated in `VramArena`).
@no_alloc
@nan_guard
fn lora_fwd_f32(base_w_ptr: i64, l: LoraAdapter, x_ptr: i64, out_ptr: i64, hidden_buf: i64, batch: i64) {
    unsafe {
    if batch <= 0 or x_ptr == 0 or out_ptr == 0 or hidden_buf == 0 or l.a.data_ptr == 0 or l.b.data_ptr == 0 {
        return
    }
    // Base linear: out = X @ W_base^T
    if base_w_ptr != 0 {
        gemm_f32(x_ptr, base_w_ptr, out_ptr, batch, l.in_dim, l.out_dim, false, true, 1.0, 0.0)
    } else {
        vec_zero_f32(out_ptr, batch * l.out_dim)
    }
    if l.merged_ptr != 0 and ptr_read_i64(l.merged_ptr, 0) != 0 {
        return
    }
    // Low-rank branch: H[batch, rank] = X @ A^T; out += scale * H @ B^T
    gemm_f32(x_ptr, l.a.data_ptr, hidden_buf, batch, l.in_dim, l.rank, false, true, 1.0, 0.0)
    gemm_f32(hidden_buf, l.b.data_ptr, out_ptr, batch, l.rank, l.out_dim, false, true, l.scale, 1.0)
    if l.use_dora and l.mag.data_ptr != 0 {
        mut b := 0
        while b < batch {
            row := b * l.out_dim
            mut j := 0
            while j < l.out_dim {
                m := ptr_read_f32(l.mag.data_ptr, j)
                ptr_write_f32(out_ptr, row + j, ptr_read_f32(out_ptr, row + j) * m)
                j += 1
            }
            b += 1
        }
    }
    }
}

// QLoRA Forward: runs fused NF4/Q4/Q8 quantized base matrix-multiply + trainable FP32 LoRA adapters!
@no_alloc
@nan_guard
fn qlora_fwd_f32(base_q: QuantTensor, l: LoraAdapter, x_ptr: i64, out_ptr: i64, hidden_buf: i64, batch: i64) {
    unsafe {
    if batch <= 0 or x_ptr == 0 or out_ptr == 0 or hidden_buf == 0 { return }
    if base_q.rows != l.out_dim or base_q.cols != l.in_dim { return }
    quant_matmul_f32(base_q, x_ptr, out_ptr, batch)
    gemm_f32(x_ptr, l.a.data_ptr, hidden_buf, batch, l.in_dim, l.rank, false, true, 1.0, 0.0)
    gemm_f32(hidden_buf, l.b.data_ptr, out_ptr, batch, l.rank, l.out_dim, false, true, l.scale, 1.0)
    if l.use_dora {
        mut b := 0
        while b < batch {
            row := b * l.out_dim
            mut j := 0
            while j < l.out_dim {
                m := ptr_read_f32(l.mag.data_ptr, j)
                ptr_write_f32(out_ptr, row + j, ptr_read_f32(out_ptr, row + j) * m)
                j += 1
            }
            b += 1
        }
    }
    }
}

// Exact Analytic Backward for LoRA (accumulates `l.a.grad_ptr`, `l.b.grad_ptr`, and optionally `dx_ptr`).
// `tmp_dh_buf` must hold at least `batch * rank` floats.
@no_alloc
@nan_guard
fn lora_bwd_f32(base_w_ptr: i64, l: LoraAdapter, x_ptr: i64, hidden_buf: i64, dout_ptr: i64, dx_ptr: i64, tmp_dh_buf: i64, batch: i64, propagate_dx: bool) {
    unsafe {
    if batch <= 0 or x_ptr == 0 or hidden_buf == 0 or dout_ptr == 0 or tmp_dh_buf == 0 { return }
    if l.use_dora and l.mag.data_ptr != 0 {
        mut b := 0
        while b < batch {
            row := b * l.out_dim
            mut j := 0
            while j < l.out_dim {
                m := ptr_read_f32(l.mag.data_ptr, j)
                ptr_write_f32(dout_ptr, row + j, ptr_read_f32(dout_ptr, row + j) * m)
                j += 1
            }
            b += 1
        }
    }
    // dB[out_dim, rank] += scale * dY^T @ H
    gemm_f32(dout_ptr, hidden_buf, l.b.grad_ptr, l.out_dim, batch, l.rank, true, false, l.scale, 1.0)
    // dH[batch, rank] = scale * dY @ B
    gemm_f32(dout_ptr, l.b.data_ptr, tmp_dh_buf, batch, l.out_dim, l.rank, false, false, l.scale, 0.0)
    // dA[rank, in_dim] += dH^T @ X
    gemm_f32(tmp_dh_buf, x_ptr, l.a.grad_ptr, l.rank, batch, l.in_dim, true, false, 1.0, 1.0)
    if propagate_dx and dx_ptr != 0 {
        if base_w_ptr != 0 {
            gemm_f32(dout_ptr, base_w_ptr, dx_ptr, batch, l.out_dim, l.in_dim, false, false, 1.0, 1.0)
        }
        if l.merged_ptr == 0 or ptr_read_i64(l.merged_ptr, 0) == 0 {
            gemm_f32(tmp_dh_buf, l.a.data_ptr, dx_ptr, batch, l.rank, l.in_dim, false, false, 1.0, 1.0)
        }
    }
    }
}

struct Adamw8bitState {
    q_m_ptr: i64      // 1 byte per parameter (signed int8 + 128)
    q_v_ptr: i64      // 1 byte per parameter (unsigned int8)
    scale_m_ptr: i64  // 4 bytes per block of 32 (f32 dynamic scale)
    scale_v_ptr: i64  // 4 bytes per block of 32 (f32 dynamic scale)
    scratch_m_ptr: i64 // pre-allocated 128-byte block scratch
    scratch_v_ptr: i64 // pre-allocated 128-byte block scratch
    numel: i64
    num_blocks: i64
}

fn adamw_8bit_init(numel: i64) -> Adamw8bitState {
    unsafe {
    mut safe_numel := numel
    if safe_numel < 0 { safe_numel = 0 }
    if safe_numel > 268435456 { safe_numel = 268435456 }
    mut n := safe_numel
    if n < 32 { n = 32 }
    blocks := (n + 31) / 32

    qm := mem_alloc_aligned(blocks * 32 + 64)
    qv := mem_alloc_aligned(blocks * 32 + 64)
    sm := mem_alloc_aligned(blocks * 4 + 64)
    sv := mem_alloc_aligned(blocks * 4 + 64)
    sm_scratch := mem_alloc_aligned(128)
    sv_scratch := mem_alloc_aligned(128)

    if qm == 0 or qv == 0 or sm == 0 or sv == 0 or sm_scratch == 0 or sv_scratch == 0 {
        if qm != 0 { mem_free_aligned(qm) }
        if qv != 0 { mem_free_aligned(qv) }
        if sm != 0 { mem_free_aligned(sm) }
        if sv != 0 { mem_free_aligned(sv) }
        if sm_scratch != 0 { mem_free_aligned(sm_scratch) }
        if sv_scratch != 0 { mem_free_aligned(sv_scratch) }
        return Adamw8bitState(
            q_m_ptr = 0, q_v_ptr = 0, scale_m_ptr = 0, scale_v_ptr = 0,
            scratch_m_ptr = 0, scratch_v_ptr = 0, numel = 0, num_blocks = 0
        )
    }

    mut i := 0
    while i < blocks * 32 {
        ptr_write_u8(qm, i, 128) // zero moment offset
        ptr_write_u8(qv, i, 0)   // zero variance
        i += 1
    }

    mut b := 0
    while b < blocks {
        ptr_write_f32(sm, b, 0.0001)
        ptr_write_f32(sv, b, 0.0001)
        b += 1
    }

    return Adamw8bitState(
        q_m_ptr = qm,
        q_v_ptr = qv,
        scale_m_ptr = sm,
        scale_v_ptr = sv,
        scratch_m_ptr = sm_scratch,
        scratch_v_ptr = sv_scratch,
        numel = safe_numel,
        num_blocks = blocks
    )
    }
}

fn adamw_8bit_free(move opt: Adamw8bitState) {
    unsafe {
    if opt.q_m_ptr != 0 { mem_free_aligned(opt.q_m_ptr) }
    if opt.q_v_ptr != 0 { mem_free_aligned(opt.q_v_ptr) }
    if opt.scale_m_ptr != 0 { mem_free_aligned(opt.scale_m_ptr) }
    if opt.scale_v_ptr != 0 { mem_free_aligned(opt.scale_v_ptr) }
    if opt.scratch_m_ptr != 0 { mem_free_aligned(opt.scratch_m_ptr) }
    if opt.scratch_v_ptr != 0 { mem_free_aligned(opt.scratch_v_ptr) }
    }
}

@no_alloc
@nan_guard
fn adamw_8bit_step(
    opt: Adamw8bitState,
    w_ptr: i64,
    g_ptr: i64,
    step_num: i64,
    lr: f64,
    beta1: f64 = 0.9,
    beta2: f64 = 0.999,
    eps: f64 = 0.00000001,
    weight_decay: f64 = 0.01
) {
    unsafe {
    if opt.numel <= 0 or opt.num_blocks <= 0 or w_ptr == 0 or g_ptr == 0 or opt.q_m_ptr == 0 or opt.q_v_ptr == 0 {
        return
    }
    mut st := step_num
    if st < 1 { st = 1 }
    safe_eps := max_f64(eps, 0.000000000001)
    bc1 := 1.0 - pow_f64(beta1, st as f64)
    bc2 := 1.0 - pow_f64(beta2, st as f64)
    inv_bc1 := 1.0 / max_f64(bc1, 0.000000000001)
    inv_bc2 := 1.0 / max_f64(bc2, 0.000000000001)
    one_m_b1 := 1.0 - beta1
    one_m_b2 := 1.0 - beta2
    decay_factor := 1.0 - lr * weight_decay

    // Use pre-allocated zero-alloc scratch for current block dequantized m and v
    scratch_m := opt.scratch_m_ptr
    scratch_v := opt.scratch_v_ptr

    mut b := 0
    while b < opt.num_blocks {
        scale_m := ptr_read_f32(opt.scale_m_ptr, b)
        scale_v := ptr_read_f32(opt.scale_v_ptr, b)
        block_base := b * 32

        // 1. Dequantize and compute updated moments and parameter update
        mut max_abs_m := 0.0
        mut max_v := 0.0

        mut j := 0
        while j < 32 {
            idx := block_base + j
            if idx < opt.numel {
                raw_m := (ptr_read_u8(opt.q_m_ptr, idx) as f64) - 128.0
                m_old := raw_m * scale_m
                raw_v := ptr_read_u8(opt.q_v_ptr, idx) as f64
                v_old := raw_v * scale_v

                mut g := ptr_read_f32(g_ptr, idx)
                g = clamp_f64(g, -1000000000000.0, 1000000000000.0)
                m_new := clamp_f64(beta1 * m_old + one_m_b1 * g, -1000000000000000000.0, 1000000000000000000.0)
                v_new := clamp_f64(beta2 * v_old + one_m_b2 * g * g, 0.0, 1000000000000000000000000000000.0)

                ptr_write_f32(scratch_m, j, m_new)
                ptr_write_f32(scratch_v, j, v_new)

                abs_m := if m_new < 0.0 { 0.0 - m_new } else { m_new }
                if abs_m > max_abs_m { max_abs_m = abs_m }
                if v_new > max_v { max_v = v_new }

                m_hat := m_new * inv_bc1
                v_hat := v_new * inv_bc2
                upd := m_hat / (sqrt_f64(max_f64(v_hat, 0.0)) + safe_eps)

                w := ptr_read_f32(w_ptr, idx) * decay_factor
                ptr_write_f32(w_ptr, idx, w - lr * upd)
            }
            j += 1
        }

        // 2. Dynamic block quantization scaling
        mut new_sc_m := max_abs_m / 127.0
        if new_sc_m < 0.000000001 { new_sc_m = 0.000000001 }
        mut new_sc_v := max_v / 255.0
        if new_sc_v < 0.000000001 { new_sc_v = 0.000000001 }

        ptr_write_f32(opt.scale_m_ptr, b, new_sc_m)
        ptr_write_f32(opt.scale_v_ptr, b, new_sc_v)

        inv_sc_m := 1.0 / new_sc_m
        inv_sc_v := 1.0 / new_sc_v

        // 3. Requantize to 8-bit
        j = 0
        while j < 32 {
            idx := block_base + j
            if idx < opt.numel {
                m_val := ptr_read_f32(scratch_m, j)
                v_val := ptr_read_f32(scratch_v, j)

                qm := ((m_val * inv_sc_m) as i64) + 128
                mut clamped_qm := qm
                if clamped_qm < 0 { clamped_qm = 0 }
                if clamped_qm > 255 { clamped_qm = 255 }
                ptr_write_u8(opt.q_m_ptr, idx, clamped_qm)

                qv := (v_val * inv_sc_v) as i64
                mut clamped_qv := qv
                if clamped_qv < 0 { clamped_qv = 0 }
                if clamped_qv > 255 { clamped_qv = 255 }
                ptr_write_u8(opt.q_v_ptr, idx, clamped_qv)
            }
            j += 1
        }
        b += 1
    }
    }
}

@no_alloc
@nan_guard
fn lora_step_adamw_8bit(
    l: LoraAdapter,
    opt_a: Adamw8bitState,
    opt_b: Adamw8bitState,
    step_num: i64,
    lr: f64,
    weight_decay: f64 = 0.01
) {
    if opt_a.numel != l.a.numel or opt_b.numel != l.b.numel { return }
    adamw_8bit_step(opt_a, l.a.data_ptr, l.a.grad_ptr, step_num, lr, 0.9, 0.999, 0.00000001, weight_decay)
    adamw_8bit_step(opt_b, l.b.data_ptr, l.b.grad_ptr, step_num, lr, 0.9, 0.999, 0.00000001, weight_decay)
}

@no_alloc
@nan_guard
fn lora_step_adamw(l: LoraAdapter, step_num: i64, lr: f64, weight_decay: f64 = 0.01) {
    adamw_step(l.a, step_num, lr, 0.9, 0.999, 0.00000001, weight_decay)
    adamw_step(l.b, step_num, lr, 0.9, 0.999, 0.00000001, weight_decay)
    if l.use_dora {
        adamw_step(l.mag, step_num, lr, 0.9, 0.999, 0.00000001, 0.0)
    }
}

@no_alloc
@nan_guard
fn lora_step_lion(l: LoraAdapter, lr: f64, weight_decay: f64 = 0.01) {
    lion_step(l.a, lr, 0.9, 0.99, weight_decay)
    lion_step(l.b, lr, 0.9, 0.99, weight_decay)
    if l.use_dora {
        lion_step(l.mag, lr, 0.9, 0.99, 0.0)
    }
}

@no_alloc
@nan_guard
fn lora_clip_grad(l: LoraAdapter, max_norm: f64) -> f64 {
    mut sq := 0.0
    unsafe {
        sq = dlpack_dot_f32(l.a.grad_ptr, l.a.grad_ptr, l.a.numel) + dlpack_dot_f32(l.b.grad_ptr, l.b.grad_ptr, l.b.numel)
    }
    norm := sqrt_f64(sq)
    if norm > max_norm and max_norm > 0.0 {
        sc := max_norm / (norm + 0.000000000001)
        vec_scale_f32(l.a.grad_ptr, l.a.grad_ptr, sc, l.a.numel)
        vec_scale_f32(l.b.grad_ptr, l.b.grad_ptr, sc, l.b.numel)
    }
    return norm
}

// Folds `scale * (B @ A)` directly into `base_w_ptr` for 0% inference overhead!
@no_alloc
@nan_guard
fn lora_merge_into_f32(base_w_ptr: i64, l: LoraAdapter) {
    unsafe {
    if base_w_ptr == 0 or l.merged_ptr == 0 { return }
    if ptr_read_i64(l.merged_ptr, 0) != 0 { return }
    gemm_f32(l.b.data_ptr, l.a.data_ptr, base_w_ptr, l.out_dim, l.rank, l.in_dim, false, false, l.scale, 1.0)
    ptr_write_i64(l.merged_ptr, 0, 1)
    }
}

// Reverts merged LoRA delta from `base_w_ptr` for hot-swapping adapters.
@no_alloc
@nan_guard
fn lora_unmerge_from_f32(base_w_ptr: i64, l: LoraAdapter) {
    unsafe {
    if base_w_ptr == 0 or l.merged_ptr == 0 { return }
    if ptr_read_i64(l.merged_ptr, 0) == 0 { return }
    gemm_f32(l.b.data_ptr, l.a.data_ptr, base_w_ptr, l.out_dim, l.rank, l.in_dim, false, false, 0.0 - l.scale, 1.0)
    ptr_write_i64(l.merged_ptr, 0, 0)
    }
}

// --- Compact Binary `.axlora` Checkpoint Save / Load (with Full Header+Payload FNV-64 Checksum) ---

fn fnv1a_buf_range(b: ByteBuf, start: i64, end: i64, seed: i64) -> i64 {
    mut h := seed
    mut i := start
    while i < end {
        h = (h ^ buf_get(b, i)) *% 1099511628211
        i += 1
    }
    return h
}

fn lora_is_finite_f32_bits(bits: i64) -> bool {
    return ((bits >> 23) & 0xFF) != 0xFF
}

fn lora_save_file(path: str, l: LoraAdapter) -> i64 ! i64 {
    unsafe {
    mut total_floats := l.a.numel + l.b.numel
    if l.use_dora { total_floats = total_floats + l.mag.numel }
    if total_floats <= 0 or total_floats > 268435456 { return err(400) }
    out := buf_new(64 + total_floats * 4)
    // Magic "AXLR" = 0x524C5841, version = 1
    buf_push_u32(out, 0x524C5841)
    buf_push_u32(out, 1)
    buf_push_u64(out, l.in_dim)
    buf_push_u64(out, l.out_dim)
    buf_push_u64(out, l.rank)
    buf_push_u64(out, f64_to_f32_bits(l.a.scratch_ptr, l.alpha))
    mut dora_flag := 0
    if l.use_dora { dora_flag = 1 }
    buf_push_u64(out, dora_flag)
    // Placeholder for full header[0..48] + payload[56..] integrity hash
    buf_push_u64(out, 0)
    mut i := 0
    while i < l.a.numel {
        bits := f64_to_f32_bits(l.a.scratch_ptr, ptr_read_f32(l.a.data_ptr, i))
        buf_push_u32(out, bits)
        i += 1
    }
    i = 0
    while i < l.b.numel {
        bits := f64_to_f32_bits(l.b.scratch_ptr, ptr_read_f32(l.b.data_ptr, i))
        buf_push_u32(out, bits)
        i += 1
    }
    if l.use_dora {
        i = 0
        while i < l.mag.numel {
            bits := f64_to_f32_bits(l.mag.scratch_ptr, ptr_read_f32(l.mag.data_ptr, i))
            buf_push_u32(out, bits)
            i += 1
        }
    }
    // Non-commutative sequential FNV-64 hash over entire header [0..48) and payload [56..len)
    mut hash := fnv1a_buf_range(out, 0, 48, -3750763034362895579)
    hash = fnv1a_buf_range(out, 56, buf_len(out), hash)
    buf_put_u64(out, 48, hash)
    wr := fs_write_file(path, out) or -1
    buf_free(move out)
    if wr < 0 { return err(500) }
    return ok(wr)
    }
}

fn buf_read_u32_le(b: ByteBuf, off: i64) -> i64 {
    return buf_get(b, off) | (buf_get(b, off + 1) << 8) | (buf_get(b, off + 2) << 16) | (buf_get(b, off + 3) << 24)
}

fn buf_read_u64_le(b: ByteBuf, off: i64) -> i64 {
    lo := buf_read_u32_le(b, off)
    hi := buf_read_u32_le(b, off + 4)
    return lo | (hi << 32)
}

fn lora_load_file(path: str, opt_kind: i64 = 2) -> LoraAdapter ! i64 {
    unsafe {
    raw := fs_read_file(path) or return err(404)
    raw_len := buf_len(raw)
    if raw_len < 56 {
        buf_free(move raw)
        return err(422)
    }
    magic := buf_read_u32_le(raw, 0)
    ver := buf_read_u32_le(raw, 4)
    if magic != 0x524C5841 or ver != 1 {
        buf_free(move raw)
        return err(422)
    }
    in_dim := buf_read_u64_le(raw, 8)
    out_dim := buf_read_u64_le(raw, 16)
    rank := buf_read_u64_le(raw, 24)
    alpha_bits := buf_read_u64_le(raw, 32)
    dora_flag := buf_read_u64_le(raw, 40)
    expected_hash := buf_read_u64_le(raw, 48)
    if in_dim <= 0 or out_dim <= 0 or rank <= 0 or in_dim > 65536 or out_dim > 65536 or rank > 4096 {
        buf_free(move raw)
        return err(422)
    }
    if not lora_is_finite_f32_bits(alpha_bits) {
        buf_free(move raw)
        return err(422)
    }
    mut expected_floats := rank * in_dim + out_dim * rank
    if dora_flag != 0 { expected_floats = expected_floats + out_dim }
    if expected_floats <= 0 or expected_floats > 268435456 {
        buf_free(move raw)
        return err(422)
    }
    expected_len := 56 + expected_floats * 4
    if raw_len != expected_len {
        buf_free(move raw)
        return err(422)
    }
    // Verify integrity hash & NaN/Inf freedom BEFORE allocating large adapter tensors!
    mut actual_hash := fnv1a_buf_range(raw, 0, 48, -3750763034362895579)
    actual_hash = fnv1a_buf_range(raw, 56, expected_len, actual_hash)
    if actual_hash != expected_hash {
        buf_free(move raw)
        return err(422)
    }
    mut chk_off := 56
    while chk_off < expected_len {
        if not lora_is_finite_f32_bits(buf_read_u32_le(raw, chk_off)) {
            buf_free(move raw)
            return err(422)
        }
        chk_off += 4
    }

    scr := mem_alloc_aligned(16)
    if scr == 0 {
        buf_free(move raw)
        return err(500)
    }
    alpha := f32_bits_to_f64(scr, alpha_bits)
    mem_free_aligned(scr)
    rng := ai_rng_new(1)
    adapter := lora_new(in_dim, out_dim, rank, alpha, rng, opt_kind, dora_flag != 0)
    ai_rng_free(move rng)
    if adapter.a.data_ptr == 0 or adapter.b.data_ptr == 0 or adapter.mag.data_ptr == 0 or adapter.merged_ptr == 0 {
        lora_free(move adapter)
        buf_free(move raw)
        return err(500)
    }

    mut off := 56
    mut i := 0
    while i < adapter.a.numel {
        bits := buf_read_u32_le(raw, off)
        ptr_write_f32(adapter.a.data_ptr, i, f32_bits_to_f64(adapter.a.scratch_ptr, bits))
        off += 4
        i += 1
    }
    i = 0
    while i < adapter.b.numel {
        bits := buf_read_u32_le(raw, off)
        ptr_write_f32(adapter.b.data_ptr, i, f32_bits_to_f64(adapter.b.scratch_ptr, bits))
        off += 4
        i += 1
    }
    if adapter.use_dora {
        i = 0
        while i < adapter.mag.numel {
            bits := buf_read_u32_le(raw, off)
            ptr_write_f32(adapter.mag.data_ptr, i, f32_bits_to_f64(adapter.mag.scratch_ptr, bits))
            off += 4
            i += 1
        }
    }
    buf_free(move raw)
    return ok(adapter)
    }
}
