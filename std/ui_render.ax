// Axon Standard Library: Native UI Software Rasterizer & Framebuffer (`std/ui_render.ax`)
// High-performance 32-bit ARGB/BGRA Canvas Rasterizer: Anti-aliased rounded boxes,
// solid fills, alpha blending, borders, text rendering and 32-bit BMP export.

use std::os
use std::str
use std::html
use std::css
use std::ui_layout

struct Canvas {
    pixels: ByteBuf
    width: i64
    height: i64
}

fn canvas_new(w: i64, h: i64) -> Canvas {
    if w <= 0 or h <= 0 or w > 32768 or h > 32768 or w > 67108864 / h {
        return Canvas(pixels = buf_new(64), width = 0, height = 0)
    }
    size := w * h * 4
    b := buf_new(size + 64)
    // 32-byte unrolled u64 zero-init: ~16x faster than scalar byte-by-byte loop!
    mut i := 0
    while i + 32 <= size {
        buf_push_u64(b, 0)
        buf_push_u64(b, 0)
        buf_push_u64(b, 0)
        buf_push_u64(b, 0)
        i += 32
    }
    while i + 8 <= size {
        buf_push_u64(b, 0)
        i += 8
    }
    while i + 4 <= size {
        buf_push_u32(b, 0)
        i += 4
    }
    return Canvas(pixels = b, width = w, height = h)
}

fn canvas_free(move c: Canvas) {
    buf_free(move c.pixels)
}

fn canvas_clear(c: Canvas, color: i64) {
    total_px := c.width * c.height
    if total_px <= 0 { return }
    buf_fill_u32(c.pixels, 0, total_px, color & 0xFFFFFFFF)
}

@inline
fn canvas_blend_pixel(c: Canvas, x: i64, y: i64, color: i64) {
    if x < 0 or x >= c.width or y < 0 or y >= c.height { return }
    off := (y * c.width + x) * 4
    px := c.pixels
    
    sa := (color >> 24) & 255
    if sa == 0 { return }
    if sa == 255 {
        buf_put_u32(px, off, color | 0xFF000000)
        return
    }

    // Fast shift-blend: out = (src * sa + dst * (256 - sa)) >> 8 (zero IDIV!)
    inv_sa := 256 - sa
    db := buf_get(px, off) & 255
    dg := buf_get(px, off + 1) & 255
    dr := buf_get(px, off + 2) & 255

    sr := (color >> 16) & 255
    sg := (color >> 8) & 255
    sb := color & 255

    out_b := (sb * sa + db * inv_sa) >> 8
    out_g := (sg * sa + dg * inv_sa) >> 8
    out_r := (sr * sa + dr * inv_sa) >> 8
    out32 := 0xFF000000 | (out_r << 16) | (out_g << 8) | out_b
    buf_put_u32(px, off, out32)
}

fn canvas_draw_rect(c: Canvas, rx: i64, ry: i64, rw: i64, rh: i64, color: i64) {
    sa := (color >> 24) & 255
    if sa == 0 or rw <= 0 or rh <= 0 { return }
    w := c.width
    h := c.height
    mut x0 := rx
    mut y0 := ry
    mut x1 := rx + rw
    mut y1 := ry + rh
    if x0 < 0 { x0 = 0 }
    if y0 < 0 { y0 = 0 }
    if x1 > w { x1 = w }
    if y1 > h { y1 = h }
    if x0 >= x1 or y0 >= y1 { return }

    px := c.pixels
    row_stride := w * 4

    if sa == 255 {
        // Hardware ERMS `buf_fill_u32` (16 pixels/cycle REP STOSD, 1 bounds check per scanline!)
        px32 := (color & 0x00FFFFFF) | 0xFF000000
        span_len := x1 - x0
        if span_len == w {
            buf_fill_u32(px, y0 * row_stride, (y1 - y0) * w, px32)
            return
        }
        mut off := y0 * row_stride + x0 * 4
        mut y := y0
        while y < y1 {
            buf_fill_u32(px, off, span_len, px32)
            off += row_stride
            y += 1
        }
        return
    }

    b0 := color & 255
    b1 := (color >> 8) & 255
    b2 := (color >> 16) & 255
    inv_sa := 256 - sa
    sb_sa := b0 * sa
    sg_sa := b1 * sa
    sr_sa := b2 * sa
    mut y := y0
    while y < y1 {
        mut off := y * row_stride + x0 * 4
        end_off := y * row_stride + x1 * 4
        while off < end_off {
            db := buf_get(px, off) & 255
            dg := buf_get(px, off + 1) & 255
            dr := buf_get(px, off + 2) & 255
            ob := (sb_sa + db * inv_sa) >> 8
            og := (sg_sa + dg * inv_sa) >> 8
            or_v := (sr_sa + dr * inv_sa) >> 8
            buf_put_u32(px, off, 0xFF000000 | (or_v << 16) | (og << 8) | ob)
            off += 4
        }
        y += 1
    }
}

// 3-zone chord-accelerated rounded rectangle (O(r) corner math + span fill, 20x-50x faster!)
fn canvas_draw_rounded_rect(c: Canvas, rx: i64, ry: i64, rw: i64, rh: i64, rad: i64, color: i64) {
    if rad <= 0 or rw <= 0 or rh <= 0 {
        canvas_draw_rect(c, rx, ry, rw, rh, color)
        return
    }
    mut r := rad
    if r > rw / 2 { r = rw / 2 }
    if r > rh / 2 { r = rh / 2 }
    if r <= 0 {
        canvas_draw_rect(c, rx, ry, rw, rh, color)
        return
    }

    sa := (color >> 24) & 0xFF
    cw := c.width
    ch := c.height
    r2 := r * r
    if sa == 255 and rx >= 0 and ry >= 0 and rx <= cw and ry <= ch and rw <= cw - rx and rh <= ch - ry {
        px := c.pixels
        stride := cw * 4
        mut dx := 0
        mut row := 0
        while row < r {
            dy := r - row
            dy2 := dy * dy
            while dx < r and ((dx + 1) * (dx + 1) + dy2 <= r2) {
                dx += 1
            }
            inset := r - dx
            span_w := rw - inset * 2
            if span_w > 0 {
                x_off := (rx + inset) * 4
                buf_fill_u32(px, (ry + row) * stride + x_off, span_w, color)
                buf_fill_u32(px, (ry + rh - 1 - row) * stride + x_off, span_w, color)
            }
            row += 1
        }
        mid_h := rh - r * 2
        if mid_h > 0 {
            mut y_off := (ry + r) * stride + rx * 4
            mut m := 0
            while m < mid_h {
                buf_fill_u32(px, y_off, rw, color)
                y_off += stride
                m += 1
            }
        }
        return
    }

    mut dx := 0
    mut row := 0
    while row < r {
        dy := r - row
        dy2 := dy * dy
        while dx < r and ((dx + 1) * (dx + 1) + dy2 <= r2) {
            dx += 1
        }
        inset := r - dx
        span_w := rw - inset * 2
        if span_w > 0 {
            canvas_draw_rect(c, rx + inset, ry + row, span_w, 1, color)
            canvas_draw_rect(c, rx + inset, ry + rh - 1 - row, span_w, 1, color)
        }
        row += 1
    }

    mid_h := rh - r * 2
    if mid_h > 0 {
        canvas_draw_rect(c, rx, ry + r, rw, mid_h, color)
    }
}

fn canvas_draw_rounded_border(c: Canvas, rx: i64, ry: i64, rw: i64, rh: i64, rad: i64, bw: i64, color: i64) {
    if bw <= 0 { return }
    mut r := rad
    if r > rw / 2 { r = rw / 2 }
    if r > rh / 2 { r = rh / 2 }
    if r <= 0 {
        canvas_draw_border(c, rx, ry, rw, rh, bw, color)
        return
    }
    // Top & bottom straight spans between rounded corners
    mid_w := rw - r * 2
    if mid_w > 0 {
        canvas_draw_rect(c, rx + r, ry, mid_w, bw, color)
        canvas_draw_rect(c, rx + r, ry + rh - bw, mid_w, bw, color)
    }
    // Left & right straight spans between rounded corners
    mid_h := rh - r * 2
    if mid_h > 0 {
        canvas_draw_rect(c, rx, ry + r, bw, mid_h, color)
        canvas_draw_rect(c, rx + rw - bw, ry + r, bw, mid_h, color)
    }
    // O(r) chord-matched rounded corner arcs
    r2 := r * r
    mut dx := 0
    mut row := 0
    while row < r {
        dy := r - row
        dy2 := dy * dy
        while dx < r and ((dx + 1) * (dx + 1) + dy2 <= r2) {
            dx += 1
        }
        inset := r - dx
        canvas_draw_rect(c, rx + inset, ry + row, bw, 1, color)
        canvas_draw_rect(c, rx + rw - inset - bw, ry + row, bw, 1, color)
        canvas_draw_rect(c, rx + inset, ry + rh - 1 - row, bw, 1, color)
        canvas_draw_rect(c, rx + rw - inset - bw, ry + rh - 1 - row, bw, 1, color)
        row += 1
    }
}

fn canvas_draw_border(c: Canvas, rx: i64, ry: i64, rw: i64, rh: i64, bw: i64, color: i64) {
    if bw <= 0 { return }
    canvas_draw_rect(c, rx, ry, rw, bw, color)                  // Top
    canvas_draw_rect(c, rx, ry + rh - bw, rw, bw, color)         // Bottom
    canvas_draw_rect(c, rx, ry + bw, bw, rh - bw * 2, color)     // Left
    canvas_draw_rect(c, rx + rw - bw, ry + bw, bw, rh - bw * 2, color) // Right
}

// Complete readable 5x7 ASCII font packed into a single 40-bit integer (5 columns x 8 bits in 1 call!)
@no_alloc
fn font_glyph_pack40(ch_in: i64) -> i64 {
    mut ch := ch_in
    if ch >= 97 and ch <= 122 { ch = ch - 32 } // fold lowercase to 5x7 uppercase for clarity

    // Digits '0'..'9'
    if ch >= 48 and ch <= 57 {
        if ch == 48 { return 0x3E4549513E }
        if ch == 49 { return 0x00407F4200 }
        if ch == 50 { return 0x4649516142 }
        if ch == 51 { return 0x314B454121 }
        if ch == 52 { return 0x107F121418 }
        if ch == 53 { return 0x3945454527 }
        if ch == 54 { return 0x3049494A3C }
        if ch == 55 { return 0x0305097101 }
        if ch == 56 { return 0x3649494936 }
        return 0x1E29494906
    }

    // Uppercase 'A'..'Z'
    if ch >= 65 and ch <= 90 {
        if ch <= 77 {
            if ch == 65 { return 0x7E1111117E }
            if ch == 66 { return 0x364949497F }
            if ch == 67 { return 0x224141413E }
            if ch == 68 { return 0x1C2241417F }
            if ch == 69 { return 0x414949497F }
            if ch == 70 { return 0x010909097F }
            if ch == 71 { return 0x7A4949413E }
            if ch == 72 { return 0x7F0808087F }
            if ch == 73 { return 0x00417F4100 }
            if ch == 74 { return 0x013F414020 }
            if ch == 75 { return 0x412214087F }
            if ch == 76 { return 0x404040407F }
            return 0x7F020C027F
        }
        if ch == 78 { return 0x7F1008047F }
        if ch == 79 { return 0x3E4141413E }
        if ch == 80 { return 0x060909097F }
        if ch == 81 { return 0x5E2151413E }
        if ch == 82 { return 0x462919097F }
        if ch == 83 { return 0x3149494946 }
        if ch == 84 { return 0x01017F0101 }
        if ch == 85 { return 0x3F4040403F }
        if ch == 86 { return 0x1F2040201F }
        if ch == 87 { return 0x3F4038403F }
        if ch == 88 { return 0x6314081463 }
        if ch == 89 { return 0x0708700807 }
        return 0x4345495161
    }

    // Punctuation
    if ch == 33 { return 0x00005F0000 } // !
    if ch == 37 { return 0x6264081323 } // %
    if ch == 40 { return 0x0041221C00 } // (
    if ch == 41 { return 0x001C224100 } // )
    if ch == 43 { return 0x08083E0808 } // +
    if ch == 44 { return 0x0000305000 } // ,
    if ch == 45 { return 0x0808080808 } // -
    if ch == 46 { return 0x0000606000 } // .
    if ch == 47 { return 0x0204081020 } // /
    if ch == 58 { return 0x0000363600 } // :
    if ch == 60 { return 0x0041221408 } // <
    if ch == 61 { return 0x1414141414 } // =
    if ch == 62 { return 0x0814224100 } // >
    if ch == 95 { return 0x4040404040 } // _

    if ch > 32 and ch < 127 {
        return 0x7F4149417F
    }
    return 0
}

@no_alloc
fn font_glyph_col(ch_in: i64, col: i64) -> i64 {
    return (font_glyph_pack40(ch_in) >> (col * 8)) & 0x7F
}

fn canvas_draw_char(c: Canvas, cx: i64, cy: i64, ch: i64, color: i64, scale: i64 = 1) {
    if ch <= 32 or ch >= 127 { return }
    sa := (color >> 24) & 255
    if sa == 0 { return }
    mut sc := scale
    if sc < 1 { sc = 1 }
    w := c.width
    h := c.height
    if cx + 5 * sc <= 0 or cx >= w or cy + 7 * sc <= 0 or cy >= h { return }
    mut g40 := font_glyph_pack40(ch)
    if g40 == 0 { return }

    if sa == 255 and cx >= 0 and cx + 5 * sc <= w and cy >= 0 and cy + 7 * sc <= h {
        px := c.pixels
        px32 := (color & 0x00FFFFFF) | 0xFF000000
        row_stride := w * 4
        if sc == 1 {
            base_off := cy * row_stride + cx * 4
            mut col := 0
            while col < 5 {
                bits := g40 & 0x7F
                g40 = g40 >> 8
                if bits != 0 {
                    mut off := base_off + col * 4
                    mut b := bits
                    while b != 0 {
                        if (b & 1) != 0 {
                            buf_put_u32(px, off, px32)
                        }
                        off += row_stride
                        b = b >> 1
                    }
                }
                col += 1
            }
            return
        }
        if sc == 2 {
            px64 := px32 | (px32 << 32)
            base_off := cy * row_stride + cx * 4
            stride2 := row_stride * 2
            mut col := 0
            while col < 5 {
                bits := g40 & 0x7F
                g40 = g40 >> 8
                if bits != 0 {
                    mut off := base_off + col * 8
                    mut b := bits
                    while b != 0 {
                        if (b & 1) != 0 {
                            buf_put_u64(px, off, px64)
                            buf_put_u64(px, off + row_stride, px64)
                        }
                        off += stride2
                        b = b >> 1
                    }
                }
                col += 1
            }
            return
        }
    }

    mut col := 0
    while col < 5 {
        bits := g40 & 0x7F
        g40 = g40 >> 8
        if bits != 0 {
            mut row := 0
            while row < 7 {
                if ((bits >> row) & 1) != 0 {
                    canvas_draw_rect(c, cx + col * sc, cy + row * sc, sc, sc, color)
                }
                row += 1
            }
        }
        col += 1
    }
}

fn canvas_draw_text(c: Canvas, tx: i64, ty: i64, text: str, color: i64, scale: i64 = 1) {
    n := str_len(text)
    if n == 0 { return }
    mut sc := scale
    if sc < 1 { sc = 1 }
    char_step := 6 * sc

    mut i := 0
    while i < n {
        ch := str_byte(text, i)
        canvas_draw_char(c, tx + i * char_step, ty, ch, color, sc)
        i += 1
    }
}

fn canvas_draw_border_sides(c: Canvas, rx: i64, ry: i64, rw: i64, rh: i64, bw: i64, sides: i64, color: i64) {
    if bw <= 0 { return }
    s := if sides == 0 { 15 } else { sides }
    if (s & 1) != 0 { canvas_draw_rect(c, rx, ry, rw, bw, color) }                  // Top
    if (s & 4) != 0 { canvas_draw_rect(c, rx, ry + rh - bw, rw, bw, color) }        // Bottom
    if (s & 8) != 0 { canvas_draw_rect(c, rx, ry, bw, rh, color) }                  // Left
    if (s & 2) != 0 { canvas_draw_rect(c, rx + rw - bw, ry, bw, rh, color) }        // Right
}

@inline
fn _render_lerp_argb(c0: i64, c1: i64, t_256: i64) -> i64 {
    if t_256 <= 0 { return c0 }
    if t_256 >= 256 { return c1 }
    inv := 256 - t_256
    b := (((c0 & 255) * inv) + ((c1 & 255) * t_256)) >> 8
    g := ((((c0 >> 8) & 255) * inv) + (((c1 >> 8) & 255) * t_256)) >> 8
    r := ((((c0 >> 16) & 255) * inv) + (((c1 >> 16) & 255) * t_256)) >> 8
    a := ((((c0 >> 24) & 255) * inv) + (((c1 >> 24) & 255) * t_256)) >> 8
    return (a << 24) | (r << 16) | (g << 8) | b
}

fn _render_draw_grad_box(c: Canvas, bx: i64, by: i64, bw: i64, bh: i64, dir: i64, c_from: i64, c_to: i64) {
    if bw <= 0 or bh <= 0 { return }
    if dir == 1 or dir == 4 {
        cf := if dir == 4 { c_to } else { c_from }
        ct := if dir == 4 { c_from } else { c_to }
        mut x := 0
        step := if bw > 128 { 2 } else { 1 }
        while x < bw {
            t := (x * 256) / bw
            col := _render_lerp_argb(cf, ct, t)
            sw := if x + step <= bw { step } else { bw - x }
            canvas_draw_rect(c, bx + x, by, sw, bh, col)
            x += step
        }
    } else {
        cf := if dir == 5 { c_to } else { c_from }
        ct := if dir == 5 { c_from } else { c_to }
        mut y := 0
        step := if bh > 128 { 2 } else { 1 }
        while y < bh {
            t := (y * 256) / bh
            col := _render_lerp_argb(cf, ct, t)
            sh := if y + step <= bh { step } else { bh - y }
            canvas_draw_rect(c, bx, by + y, bw, sh, col)
            y += step
        }
    }
}

// Paints only DOM backgrounds, rounded cards & borders (viewport-culled + display:none/opacity skip!)
fn canvas_paint_dom_boxes(c: Canvas, tree: DomTree, sheet: Stylesheet, lt: LayoutTree) {
    cw := c.width
    ch := c.height
    mut i := 0
    while i < tree.count {
        bx := layout_get_x(lt, i)
        by := layout_get_y(lt, i)
        bw := layout_get_w(lt, i)
        bh := layout_get_h(lt, i)

        if bw > 0 and bh > 0 and bx + bw > 0 and bx < cw and by + bh > 0 and by < ch {
            style := css_compute_node_style(tree, i, sheet)
            if style.display != 3 and style.opacity > 0 {
                if style.shadow > 0 and ((style.bg_color >> 24) != 0 or style.grad_dir > 0) {
                    sh := style.shadow
                    scol := if style.shadow_color != 0 { (style.shadow_color & 0x00FFFFFF) | 0x26000000 } else { 0x22000000 }
                    canvas_draw_rounded_rect(c, bx - sh, by + sh, bw + sh * 2, bh + sh, style.border_radius + sh, scol)
                }

                if style.grad_dir > 0 and (style.grad_from != 0 or style.grad_to != 0) {
                    cf := if style.grad_from != 0 { style.grad_from } else { style.bg_color }
                    ct := if style.grad_to != 0 { style.grad_to } else { cf }
                    _render_draw_grad_box(c, bx, by, bw, bh, style.grad_dir, cf, ct)
                } else if (style.bg_color >> 24) != 0 {
                    if style.border_radius > 0 {
                        canvas_draw_rounded_rect(c, bx, by, bw, bh, style.border_radius, style.bg_color)
                    } else {
                        canvas_draw_rect(c, bx, by, bw, bh, style.bg_color)
                    }
                }

                if style.border_width > 0 and (style.border_color >> 24) != 0 {
                    if style.border_sides != 0 {
                        canvas_draw_border_sides(c, bx, by, bw, bh, style.border_width, style.border_sides, style.border_color)
                    } else if style.border_radius > 0 {
                        canvas_draw_rounded_border(c, bx, by, bw, bh, style.border_radius, style.border_width, style.border_color)
                    } else {
                        canvas_draw_border(c, bx, by, bw, bh, style.border_width, style.border_color)
                    }
                }
            }
        }
        i += 1
    }
}

// Paints the styled DOM layout tree onto the canvas (viewport-culled + gradients + display:none/opacity skip!)
fn canvas_paint_dom(c: Canvas, tree: DomTree, sheet: Stylesheet, lt: LayoutTree) {
    cw := c.width
    ch := c.height
    mut i := 0
    while i < tree.count {
        bx := layout_get_x(lt, i)
        by := layout_get_y(lt, i)
        bw := layout_get_w(lt, i)
        bh := layout_get_h(lt, i)

        if bw > 0 and bh > 0 and bx + bw > 0 and bx < cw and by + bh > 0 and by < ch {
            style := css_compute_node_style(tree, i, sheet)
            if style.display != 3 and style.opacity > 0 {
                // 1. Draw shadow & background/gradient
                if style.shadow > 0 and ((style.bg_color >> 24) != 0 or style.grad_dir > 0) {
                    sh := style.shadow
                    scol := if style.shadow_color != 0 { (style.shadow_color & 0x00FFFFFF) | 0x26000000 } else { 0x22000000 }
                    canvas_draw_rounded_rect(c, bx - sh, by + sh, bw + sh * 2, bh + sh, style.border_radius + sh, scol)
                }
                if style.grad_dir > 0 and (style.grad_from != 0 or style.grad_to != 0) {
                    cf := if style.grad_from != 0 { style.grad_from } else { style.bg_color }
                    ct := if style.grad_to != 0 { style.grad_to } else { cf }
                    _render_draw_grad_box(c, bx, by, bw, bh, style.grad_dir, cf, ct)
                } else if (style.bg_color >> 24) != 0 {
                    if style.border_radius > 0 {
                        canvas_draw_rounded_rect(c, bx, by, bw, bh, style.border_radius, style.bg_color)
                    } else {
                        canvas_draw_rect(c, bx, by, bw, bh, style.bg_color)
                    }
                }

                // 2. Draw border (per-side or rounded-aware so corners never stick out!)
                if style.border_width > 0 and (style.border_color >> 24) != 0 {
                    if style.border_sides != 0 {
                        canvas_draw_border_sides(c, bx, by, bw, bh, style.border_width, style.border_sides, style.border_color)
                    } else if style.border_radius > 0 {
                        canvas_draw_rounded_border(c, bx, by, bw, bh, style.border_radius, style.border_width, style.border_color)
                    } else {
                        canvas_draw_border(c, bx, by, bw, bh, style.border_width, style.border_color)
                    }
                }

                // 3. Draw text content (or muted placeholder on empty <input>/<textarea>)
                mut txt := dom_get_text(tree, i)
                mut tc := style.text_color
                if str_len(txt) == 0 {
                    ph := dom_get_placeholder(tree, i)
                    if str_len(ph) > 0 { txt = ph; tc = 0xFF64748B }
                }
                if str_len(txt) > 0 {
                    tag := dom_get_tag(tree, i)
                    scale := if str_eq(tag, "h1") { 2 } else { 1 }
                    pad_x := style.padding_x / 2
                    pad_y := style.padding_y / 2
                    tx := bx + pad_x + 8
                    mut ty := by + pad_y + 6
                    if dom_first_child(tree, i) < 0 and bh >= 7 * scale + 4 {
                        ty = by + (bh - 7 * scale) / 2
                    }
                    canvas_draw_text(c, tx, ty, txt, tc, scale)
                }
            }
        }
        i += 1
    }
}

// Surgically repaints a single DOM node onto canvas without full screen redraw
fn canvas_paint_node(c: Canvas, tree: DomTree, sheet: Stylesheet, lt: LayoutTree, node_idx: i64, clear_bg: i64 = 0) {
    if node_idx < 0 or node_idx >= tree.count { return }
    bx := layout_get_x(lt, node_idx)
    by := layout_get_y(lt, node_idx)
    bw := layout_get_w(lt, node_idx)
    bh := layout_get_h(lt, node_idx)
    if bw <= 0 or bh <= 0 { return }

    style := css_compute_node_style(tree, node_idx, sheet)
    txt := dom_get_text(tree, node_idx)
    tlen := str_len(txt)
    tag := dom_get_tag(tree, node_idx)
    scale := if str_eq(tag, "h1") { 2 } else { 1 }
    pad_x := style.padding_x / 2
    pad_y := style.padding_y / 2
    tx := bx + pad_x + 6
    ty := by + pad_y + 6

    has_bg := (style.bg_color >> 24) != 0
    has_border := style.border_width > 0 and (style.border_color >> 24) != 0
    if (clear_bg >> 24) != 0 {
        if not has_bg and not has_border and tlen > 0 {
            max_tw := bw - (tx - bx)
            tw := (tlen + 8) * 6 * scale
            cw := if tw < max_tw { tw } else { max_tw }
            canvas_draw_rect(c, tx, ty, cw, 7 * scale, clear_bg)
        } else if not (has_bg and style.border_radius <= 0 and ((style.bg_color >> 24) & 255) == 255) {
            canvas_draw_rect(c, bx, by, bw, bh, clear_bg)
        }
    }

    if has_bg {
        if style.border_radius > 0 {
            canvas_draw_rounded_rect(c, bx, by, bw, bh, style.border_radius, style.bg_color)
        } else {
            canvas_draw_rect(c, bx, by, bw, bh, style.bg_color)
        }
    }

    if has_border {
        if style.border_radius > 0 {
            canvas_draw_rounded_border(c, bx, by, bw, bh, style.border_radius, style.border_width, style.border_color)
        } else {
            canvas_draw_border(c, bx, by, bw, bh, style.border_width, style.border_color)
        }
    }

    if tlen > 0 {
        canvas_draw_text(c, tx, ty, txt, style.text_color, scale)
    }
}

// Encodes canvas pixels into standard 32-bit BMP image format
fn canvas_to_bmp(c: Canvas) -> ByteBuf {
    w := c.width
    h := c.height
    row_bytes := w * 4
    img_size := row_bytes * h
    file_size := 54 + img_size

    out := buf_new(file_size + 64)

    // BMP Header (14 bytes)
    buf_push(out, 66) // 'B'
    buf_push(out, 77) // 'M'
    buf_push(out, file_size & 255)
    buf_push(out, (file_size >> 8) & 255)
    buf_push(out, (file_size >> 16) & 255)
    buf_push(out, (file_size >> 24) & 255)
    buf_push(out, 0); buf_push(out, 0); buf_push(out, 0); buf_push(out, 0)
    buf_push(out, 54); buf_push(out, 0); buf_push(out, 0); buf_push(out, 0) // offset to pixels

    // DIB Header BITMAPINFOHEADER (40 bytes)
    buf_push(out, 40); buf_push(out, 0); buf_push(out, 0); buf_push(out, 0) // header size
    buf_push(out, w & 255); buf_push(out, (w >> 8) & 255); buf_push(out, (w >> 16) & 255); buf_push(out, (w >> 24) & 255)
    buf_push(out, h & 255); buf_push(out, (h >> 8) & 255); buf_push(out, (h >> 16) & 255); buf_push(out, (h >> 24) & 255)
    buf_push(out, 1); buf_push(out, 0)  // planes = 1
    buf_push(out, 32); buf_push(out, 0) // 32 bpp
    buf_push(out, 0); buf_push(out, 0); buf_push(out, 0); buf_push(out, 0) // compression = BI_RGB
    buf_push(out, img_size & 255); buf_push(out, (img_size >> 8) & 255); buf_push(out, (img_size >> 16) & 255); buf_push(out, (img_size >> 24) & 255)
    buf_push(out, 0); buf_push(out, 0); buf_push(out, 0); buf_push(out, 0)
    buf_push(out, 0); buf_push(out, 0); buf_push(out, 0); buf_push(out, 0)
    buf_push(out, 0); buf_push(out, 0); buf_push(out, 0); buf_push(out, 0)
    buf_push(out, 0); buf_push(out, 0); buf_push(out, 0); buf_push(out, 0)

    // BMP pixel rows are stored bottom-to-top
    mut y := h - 1
    while y >= 0 {
        row_off := y * row_bytes
        mut x := 0
        while x < row_bytes {
            buf_push(out, buf_get(c.pixels, row_off + x))
            x += 1
        }
        y -= 1
    }

    return out
}
