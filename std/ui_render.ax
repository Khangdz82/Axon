// Axon Standard Library: Native UI Software Rasterizer & Framebuffer (`std/ui_render.ax`)
// High-performance 32-bit ARGB/BGRA Canvas Rasterizer: Anti-aliased rounded boxes,
// solid fills, alpha blending, borders, text rendering and 32-bit BMP export.

use std::os
use std::str
use std::html
use std::css
use std::ui_layout

struct Canvas {
    pixels: ByteBuf
    width: i64
    height: i64
}

fn canvas_new(w: i64, h: i64) -> Canvas {
    size := w * h * 4
    b := buf_new(size + 64)
    mut i := 0
    while i < size {
        buf_push(b, 0)
        i += 1
    }
    return Canvas(pixels = b, width = w, height = h)
}

fn canvas_free(move c: Canvas) {
    buf_free(move c.pixels)
}

fn canvas_clear(c: Canvas, color: i64) {
    w := c.width
    h := c.height
    total_bytes := w * h * 4
    px := c.pixels
    px32 := color & 0xFFFFFFFF
    px64 := px32 | (px32 << 32)

    mut off := 0
    limit8 := total_bytes - 7
    while off < limit8 {
        buf_put_u64(px, off, px64)
        off += 8
    }
    while off + 4 <= total_bytes {
        buf_put_u32(px, off, px32)
        off += 4
    }
}

@inline
fn canvas_blend_pixel(c: Canvas, x: i64, y: i64, color: i64) {
    if x < 0 or x >= c.width or y < 0 or y >= c.height { return }
    off := (y * c.width + x) * 4
    px := c.pixels
    
    sa := (color >> 24) & 255
    if sa == 0 { return }
    if sa == 255 {
        buf_put_u32(px, off, color | 0xFF000000)
        return
    }

    // Fast shift-blend: out = (src * sa + dst * (256 - sa)) >> 8 (zero IDIV!)
    inv_sa := 256 - sa
    db := buf_get(px, off) & 255
    dg := buf_get(px, off + 1) & 255
    dr := buf_get(px, off + 2) & 255

    sr := (color >> 16) & 255
    sg := (color >> 8) & 255
    sb := color & 255

    out_b := (sb * sa + db * inv_sa) >> 8
    out_g := (sg * sa + dg * inv_sa) >> 8
    out_r := (sr * sa + dr * inv_sa) >> 8
    out32 := 0xFF000000 | (out_r << 16) | (out_g << 8) | out_b
    buf_put_u32(px, off, out32)
}

fn canvas_draw_rect(c: Canvas, rx: i64, ry: i64, rw: i64, rh: i64, color: i64) {
    sa := (color >> 24) & 255
    if sa == 0 or rw <= 0 or rh <= 0 { return }
    w := c.width
    h := c.height
    mut x0 := rx
    mut y0 := ry
    mut x1 := rx + rw
    mut y1 := ry + rh
    if x0 < 0 { x0 = 0 }
    if y0 < 0 { y0 = 0 }
    if x1 > w { x1 = w }
    if y1 > h { y1 = h }
    if x0 >= x1 or y0 >= y1 { return }

    px := c.pixels
    row_stride := w * 4

    if sa == 255 {
        // 64-bit 2-pixel opaque span fast path: 8x fewer stores & bounds checks!
        px32 := (color & 0x00FFFFFF) | 0xFF000000
        px64 := px32 | (px32 << 32)
        mut y := y0
        while y < y1 {
            mut off := y * row_stride + x0 * 4
            end_off := y * row_stride + x1 * 4
            limit8 := end_off - 7
            while off < limit8 {
                buf_put_u64(px, off, px64)
                off += 8
            }
            if off < end_off {
                buf_put_u32(px, off, px32)
            }
            y += 1
        }
        return
    }

    b0 := color & 255
    b1 := (color >> 8) & 255
    b2 := (color >> 16) & 255
    inv_sa := 256 - sa
    sb_sa := b0 * sa
    sg_sa := b1 * sa
    sr_sa := b2 * sa
    mut y := y0
    while y < y1 {
        mut off := y * row_stride + x0 * 4
        end_off := y * row_stride + x1 * 4
        while off < end_off {
            db := buf_get(px, off) & 255
            dg := buf_get(px, off + 1) & 255
            dr := buf_get(px, off + 2) & 255
            ob := (sb_sa + db * inv_sa) >> 8
            og := (sg_sa + dg * inv_sa) >> 8
            or_v := (sr_sa + dr * inv_sa) >> 8
            buf_put_u32(px, off, 0xFF000000 | (or_v << 16) | (og << 8) | ob)
            off += 4
        }
        y += 1
    }
}

// 3-zone chord-accelerated rounded rectangle (O(r) corner math + span fill, 20x-50x faster!)
fn canvas_draw_rounded_rect(c: Canvas, rx: i64, ry: i64, rw: i64, rh: i64, rad: i64, color: i64) {
    if rad <= 0 or rw <= 0 or rh <= 0 {
        canvas_draw_rect(c, rx, ry, rw, rh, color)
        return
    }
    mut r := rad
    if r > rw / 2 { r = rw / 2 }
    if r > rh / 2 { r = rh / 2 }
    if r <= 0 {
        canvas_draw_rect(c, rx, ry, rw, rh, color)
        return
    }

    r2 := r * r
    mut row := 0
    while row < r {
        dy := r - row
        dy2 := dy * dy
        mut dx := r
        while dx > 0 and (dx * dx + dy2 > r2) {
            dx -= 1
        }
        inset := r - dx
        span_w := rw - inset * 2
        if span_w > 0 {
            canvas_draw_rect(c, rx + inset, ry + row, span_w, 1, color)
            canvas_draw_rect(c, rx + inset, ry + rh - 1 - row, span_w, 1, color)
        }
        row += 1
    }

    mid_h := rh - r * 2
    if mid_h > 0 {
        canvas_draw_rect(c, rx, ry + r, rw, mid_h, color)
    }
}

fn canvas_draw_border(c: Canvas, rx: i64, ry: i64, rw: i64, rh: i64, bw: i64, color: i64) {
    if bw <= 0 { return }
    canvas_draw_rect(c, rx, ry, rw, bw, color)                  // Top
    canvas_draw_rect(c, rx, ry + rh - bw, rw, bw, color)         // Bottom
    canvas_draw_rect(c, rx, ry + bw, bw, rh - bw * 2, color)     // Left
    canvas_draw_rect(c, rx + rw - bw, ry + bw, bw, rh - bw * 2, color) // Right
}

// Complete readable 5x7 ASCII font column masks (columns 0..4, bit 6 = top row .. bit 0 = bottom row)
fn font_pack5(c0: i64, c1: i64, c2: i64, c3: i64, c4: i64, col: i64) -> i64 {
    if col == 0 { return c0 }
    if col == 1 { return c1 }
    if col == 2 { return c2 }
    if col == 3 { return c3 }
    return c4
}

fn font_glyph_col(ch_in: i64, col: i64) -> i64 {
    mut ch := ch_in
    if ch >= 97 and ch <= 122 { ch = ch - 32 } // fold lowercase to 5x7 uppercase for clarity

    // Digits '0'..'9'
    if ch == 48 { return font_pack5(0x3E, 0x51, 0x49, 0x45, 0x3E, col) }
    if ch == 49 { return font_pack5(0x00, 0x42, 0x7F, 0x40, 0x00, col) }
    if ch == 50 { return font_pack5(0x42, 0x61, 0x51, 0x49, 0x46, col) }
    if ch == 51 { return font_pack5(0x21, 0x41, 0x45, 0x4B, 0x31, col) }
    if ch == 52 { return font_pack5(0x18, 0x14, 0x12, 0x7F, 0x10, col) }
    if ch == 53 { return font_pack5(0x27, 0x45, 0x45, 0x45, 0x39, col) }
    if ch == 54 { return font_pack5(0x3C, 0x4A, 0x49, 0x49, 0x30, col) }
    if ch == 55 { return font_pack5(0x01, 0x71, 0x09, 0x05, 0x03, col) }
    if ch == 56 { return font_pack5(0x36, 0x49, 0x49, 0x49, 0x36, col) }
    if ch == 57 { return font_pack5(0x06, 0x49, 0x49, 0x29, 0x1E, col) }

    // Uppercase 'A'..'Z'
    if ch == 65 { return font_pack5(0x7E, 0x11, 0x11, 0x11, 0x7E, col) }
    if ch == 66 { return font_pack5(0x7F, 0x49, 0x49, 0x49, 0x36, col) }
    if ch == 67 { return font_pack5(0x3E, 0x41, 0x41, 0x41, 0x22, col) }
    if ch == 68 { return font_pack5(0x7F, 0x41, 0x41, 0x22, 0x1C, col) }
    if ch == 69 { return font_pack5(0x7F, 0x49, 0x49, 0x49, 0x41, col) }
    if ch == 70 { return font_pack5(0x7F, 0x09, 0x09, 0x09, 0x01, col) }
    if ch == 71 { return font_pack5(0x3E, 0x41, 0x49, 0x49, 0x7A, col) }
    if ch == 72 { return font_pack5(0x7F, 0x08, 0x08, 0x08, 0x7F, col) }
    if ch == 73 { return font_pack5(0x00, 0x41, 0x7F, 0x41, 0x00, col) }
    if ch == 74 { return font_pack5(0x20, 0x40, 0x41, 0x3F, 0x01, col) }
    if ch == 75 { return font_pack5(0x7F, 0x08, 0x14, 0x22, 0x41, col) }
    if ch == 76 { return font_pack5(0x7F, 0x40, 0x40, 0x40, 0x40, col) }
    if ch == 77 { return font_pack5(0x7F, 0x02, 0x0C, 0x02, 0x7F, col) }
    if ch == 78 { return font_pack5(0x7F, 0x04, 0x08, 0x10, 0x7F, col) }
    if ch == 79 { return font_pack5(0x3E, 0x41, 0x41, 0x41, 0x3E, col) }
    if ch == 80 { return font_pack5(0x7F, 0x09, 0x09, 0x09, 0x06, col) }
    if ch == 81 { return font_pack5(0x3E, 0x41, 0x51, 0x21, 0x5E, col) }
    if ch == 82 { return font_pack5(0x7F, 0x09, 0x19, 0x29, 0x46, col) }
    if ch == 83 { return font_pack5(0x46, 0x49, 0x49, 0x49, 0x31, col) }
    if ch == 84 { return font_pack5(0x01, 0x01, 0x7F, 0x01, 0x01, col) }
    if ch == 85 { return font_pack5(0x3F, 0x40, 0x40, 0x40, 0x3F, col) }
    if ch == 86 { return font_pack5(0x1F, 0x20, 0x40, 0x20, 0x1F, col) }
    if ch == 87 { return font_pack5(0x3F, 0x40, 0x38, 0x40, 0x3F, col) }
    if ch == 88 { return font_pack5(0x63, 0x14, 0x08, 0x14, 0x63, col) }
    if ch == 89 { return font_pack5(0x07, 0x08, 0x70, 0x08, 0x07, col) }
    if ch == 90 { return font_pack5(0x61, 0x51, 0x49, 0x45, 0x43, col) }

    // Punctuation
    if ch == 33 { return font_pack5(0x00, 0x00, 0x5F, 0x00, 0x00, col) } // !
    if ch == 37 { return font_pack5(0x23, 0x13, 0x08, 0x64, 0x62, col) } // %
    if ch == 40 { return font_pack5(0x00, 0x1C, 0x22, 0x41, 0x00, col) } // (
    if ch == 41 { return font_pack5(0x00, 0x41, 0x22, 0x1C, 0x00, col) } // )
    if ch == 43 { return font_pack5(0x08, 0x08, 0x3E, 0x08, 0x08, col) } // +
    if ch == 44 { return font_pack5(0x00, 0x50, 0x30, 0x00, 0x00, col) } // ,
    if ch == 45 { return font_pack5(0x08, 0x08, 0x08, 0x08, 0x08, col) } // -
    if ch == 46 { return font_pack5(0x00, 0x60, 0x60, 0x00, 0x00, col) } // .
    if ch == 47 { return font_pack5(0x20, 0x10, 0x08, 0x04, 0x02, col) } // /
    if ch == 58 { return font_pack5(0x00, 0x36, 0x36, 0x00, 0x00, col) } // :
    if ch == 60 { return font_pack5(0x08, 0x14, 0x22, 0x41, 0x00, col) } // <
    if ch == 61 { return font_pack5(0x14, 0x14, 0x14, 0x14, 0x14, col) } // =
    if ch == 62 { return font_pack5(0x00, 0x41, 0x22, 0x14, 0x08, col) } // >
    if ch == 95 { return font_pack5(0x40, 0x40, 0x40, 0x40, 0x40, col) } // _

    if ch > 32 and ch < 127 {
        return font_pack5(0x7F, 0x41, 0x49, 0x41, 0x7F, col)
    }
    return 0
}

fn canvas_draw_char(c: Canvas, cx: i64, cy: i64, ch: i64, color: i64, scale: i64 = 1) {
    if ch <= 32 or ch >= 127 { return }
    sa := (color >> 24) & 255
    if sa == 0 { return }
    mut sc := scale
    if sc < 1 { sc = 1 }
    w := c.width
    h := c.height
    if cx + 5 * sc <= 0 or cx >= w or cy + 7 * sc <= 0 or cy >= h { return }

    if sc == 1 and sa == 255 and cx >= 0 and cx + 5 <= w and cy >= 0 and cy + 7 <= h {
        // Ultra-fast 1-store-per-pixel opaque 1x glyph path!
        px := c.pixels
        px32 := (color & 0x00FFFFFF) | 0xFF000000
        row_stride := w * 4
        mut col := 0
        while col < 5 {
            bits := font_glyph_col(ch, col)
            if bits != 0 {
                x_off := (cx + col) * 4
                mut row := 0
                while row < 7 {
                    if ((bits >> row) & 1) != 0 {
                        off := (cy + row) * row_stride + x_off
                        buf_put_u32(px, off, px32)
                    }
                    row += 1
                }
            }
            col += 1
        }
        return
    }

    mut col := 0
    while col < 5 {
        bits := font_glyph_col(ch, col)
        if bits != 0 {
            mut row := 0
            while row < 7 {
                if ((bits >> row) & 1) != 0 {
                    canvas_draw_rect(c, cx + col * sc, cy + row * sc, sc, sc, color)
                }
                row += 1
            }
        }
        col += 1
    }
}

fn canvas_draw_text(c: Canvas, tx: i64, ty: i64, text: str, color: i64, scale: i64 = 1) {
    n := str_len(text)
    if n == 0 { return }
    mut sc := scale
    if sc < 1 { sc = 1 }
    char_step := 6 * sc

    mut i := 0
    while i < n {
        ch := str_byte(text, i)
        canvas_draw_char(c, tx + i * char_step, ty, ch, color, sc)
        i += 1
    }
}

// Paints the styled DOM layout tree onto the canvas
fn canvas_paint_dom(c: Canvas, tree: DomTree, sheet: Stylesheet, lt: LayoutTree) {
    mut i := 0
    while i < tree.count {
        bx := layout_get_x(lt, i)
        by := layout_get_y(lt, i)
        bw := layout_get_w(lt, i)
        bh := layout_get_h(lt, i)

        if bw > 0 and bh > 0 {
            style := css_compute_node_style(tree, i, sheet)

            // 1. Draw background
            if (style.bg_color >> 24) != 0 {
                if style.border_radius > 0 {
                    canvas_draw_rounded_rect(c, bx, by, bw, bh, style.border_radius, style.bg_color)
                } else {
                    canvas_draw_rect(c, bx, by, bw, bh, style.bg_color)
                }
            }

            // 2. Draw border
            if style.border_width > 0 and (style.border_color >> 24) != 0 {
                canvas_draw_border(c, bx, by, bw, bh, style.border_width, style.border_color)
            }

            // 3. Draw text content
            txt := dom_get_text(tree, i)
            if str_len(txt) > 0 {
                tag := dom_get_tag(tree, i)
                scale := if str_eq(tag, "h1") { 2 } else { 1 }
                pad_x := style.padding_x / 2
                pad_y := style.padding_y / 2
                tx := bx + pad_x + 6
                ty := by + pad_y + 6
                canvas_draw_text(c, tx, ty, txt, style.text_color, scale)
            }
        }
        i += 1
    }
}

// Surgically repaints a single DOM node onto canvas without full screen redraw
fn canvas_paint_node(c: Canvas, tree: DomTree, sheet: Stylesheet, lt: LayoutTree, node_idx: i64, clear_bg: i64 = 0) {
    if node_idx < 0 or node_idx >= tree.count { return }
    bx := layout_get_x(lt, node_idx)
    by := layout_get_y(lt, node_idx)
    bw := layout_get_w(lt, node_idx)
    bh := layout_get_h(lt, node_idx)
    if bw <= 0 or bh <= 0 { return }

    style := css_compute_node_style(tree, node_idx, sheet)
    txt := dom_get_text(tree, node_idx)
    tlen := str_len(txt)
    tag := dom_get_tag(tree, node_idx)
    scale := if str_eq(tag, "h1") { 2 } else { 1 }
    pad_x := style.padding_x / 2
    pad_y := style.padding_y / 2
    tx := bx + pad_x + 6
    ty := by + pad_y + 6

    has_bg := (style.bg_color >> 24) != 0
    has_border := style.border_width > 0 and (style.border_color >> 24) != 0
    if (clear_bg >> 24) != 0 {
        if not has_bg and not has_border and tlen > 0 {
            max_tw := bw - (tx - bx)
            tw := (tlen + 8) * 6 * scale
            cw := if tw < max_tw { tw } else { max_tw }
            canvas_draw_rect(c, tx, ty, cw, 7 * scale, clear_bg)
        } else if not (has_bg and style.border_radius <= 0 and ((style.bg_color >> 24) & 255) == 255) {
            canvas_draw_rect(c, bx, by, bw, bh, clear_bg)
        }
    }

    if has_bg {
        if style.border_radius > 0 {
            canvas_draw_rounded_rect(c, bx, by, bw, bh, style.border_radius, style.bg_color)
        } else {
            canvas_draw_rect(c, bx, by, bw, bh, style.bg_color)
        }
    }

    if has_border {
        canvas_draw_border(c, bx, by, bw, bh, style.border_width, style.border_color)
    }

    if tlen > 0 {
        canvas_draw_text(c, tx, ty, txt, style.text_color, scale)
    }
}

// Encodes canvas pixels into standard 32-bit BMP image format
fn canvas_to_bmp(c: Canvas) -> ByteBuf {
    w := c.width
    h := c.height
    row_bytes := w * 4
    img_size := row_bytes * h
    file_size := 54 + img_size

    out := buf_new(file_size + 64)

    // BMP Header (14 bytes)
    buf_push(out, 66) // 'B'
    buf_push(out, 77) // 'M'
    buf_push(out, file_size & 255)
    buf_push(out, (file_size >> 8) & 255)
    buf_push(out, (file_size >> 16) & 255)
    buf_push(out, (file_size >> 24) & 255)
    buf_push(out, 0); buf_push(out, 0); buf_push(out, 0); buf_push(out, 0)
    buf_push(out, 54); buf_push(out, 0); buf_push(out, 0); buf_push(out, 0) // offset to pixels

    // DIB Header BITMAPINFOHEADER (40 bytes)
    buf_push(out, 40); buf_push(out, 0); buf_push(out, 0); buf_push(out, 0) // header size
    buf_push(out, w & 255); buf_push(out, (w >> 8) & 255); buf_push(out, (w >> 16) & 255); buf_push(out, (w >> 24) & 255)
    buf_push(out, h & 255); buf_push(out, (h >> 8) & 255); buf_push(out, (h >> 16) & 255); buf_push(out, (h >> 24) & 255)
    buf_push(out, 1); buf_push(out, 0)  // planes = 1
    buf_push(out, 32); buf_push(out, 0) // 32 bpp
    buf_push(out, 0); buf_push(out, 0); buf_push(out, 0); buf_push(out, 0) // compression = BI_RGB
    buf_push(out, img_size & 255); buf_push(out, (img_size >> 8) & 255); buf_push(out, (img_size >> 16) & 255); buf_push(out, (img_size >> 24) & 255)
    buf_push(out, 0); buf_push(out, 0); buf_push(out, 0); buf_push(out, 0)
    buf_push(out, 0); buf_push(out, 0); buf_push(out, 0); buf_push(out, 0)
    buf_push(out, 0); buf_push(out, 0); buf_push(out, 0); buf_push(out, 0)
    buf_push(out, 0); buf_push(out, 0); buf_push(out, 0); buf_push(out, 0)

    // BMP pixel rows are stored bottom-to-top
    mut y := h - 1
    while y >= 0 {
        row_off := y * row_bytes
        mut x := 0
        while x < row_bytes {
            buf_push(out, buf_get(c.pixels, row_off + x))
            x += 1
        }
        y -= 1
    }

    return out
}
