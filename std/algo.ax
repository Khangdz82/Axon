// Axon Standard Library — High-Speed Algorithms (`std/algo.ax`)
// Includes 8-Bit Pass-Skipping LSD Radix Sort (O(N), handles full signed i64 including INT64_MIN..MAX),
// Median-of-3 Tail-Iterative QuickSort, Binary Search, Binary Min-Heap (scalar + key/val), and Disjoint-Set (DSU).

// In-place insertion sort on raw i64 pointer `[lo..hi]` inclusive.
unsafe fn isort_raw_i64(arr: i64, lo: i64, hi: i64) {
    mut i := lo + 1
    while i <= hi {
        key := ptr_read_i64(arr, i)
        mut j := i - 1
        while j >= lo and ptr_read_i64(arr, j) > key {
            ptr_write_i64(arr, j + 1, ptr_read_i64(arr, j))
            j -= 1
        }
        ptr_write_i64(arr, j + 1, key)
        i += 1
    }
}

// Median-of-3 + tail-iterative + insertion-cutoff QuickSort on `[lo..hi]` inclusive (0 heap allocs, immune to sorted/equal O(N^2)).
unsafe fn qsort_raw_i64(arr: i64, lo_in: i64, hi_in: i64) {
    mut lo := lo_in
    mut hi := hi_in
    while hi - lo > 32 {
        mid := lo + ((hi - lo) >> 1)
        mut a := ptr_read_i64(arr, lo)
        mut b := ptr_read_i64(arr, mid)
        mut c := ptr_read_i64(arr, hi)
        if a > b { t := a; a = b; b = t }
        if b > c { t := b; b = c; c = t }
        if a > b { t := a; a = b; b = t }
        ptr_write_i64(arr, lo, a)
        ptr_write_i64(arr, mid, b)
        ptr_write_i64(arr, hi, c)
        pivot := b

        mut i := lo
        mut j := hi
        while true {
            i += 1
            while ptr_read_i64(arr, i) < pivot { i += 1 }
            j -= 1
            while ptr_read_i64(arr, j) > pivot { j -= 1 }
            if i >= j { break }
            vi := ptr_read_i64(arr, i)
            ptr_write_i64(arr, i, ptr_read_i64(arr, j))
            ptr_write_i64(arr, j, vi)
        }
        // Recurse on smaller partition, loop on larger partition -> O(log N) stack guaranteed!
        if j - lo < hi - i {
            if lo < j { qsort_raw_i64(arr, lo, j) }
            lo = i
        } else {
            if i < hi { qsort_raw_i64(arr, i, hi) }
            hi = j
        }
    }
    if lo < hi {
        isort_raw_i64(arr, lo, hi)
    }
}

// Constant-shift 8-bit LSD Radix Sort: reads from `in_ptr`, writes final sorted result into `out_ptr` (using `scratch_ptr` as ping-pong).
// Note: `in_ptr` may equal `out_ptr` (in-place) OR `in_ptr` may equal `scratch_ptr` (zero-copy from MSB scatter!).
unsafe fn _radix_lsd_sub_i64(in_ptr: i64, out_ptr: i64, scratch_ptr: i64, hist: i64, n: i64, max_pass: i64) {
    if n <= 48 {
        if in_ptr != out_ptr { mem_copy(out_ptr, in_ptr, n * 8) }
        isort_raw_i64(out_ptr, 0, n - 1)
        return
    }
    if n <= 384 {
        if in_ptr != out_ptr { mem_copy(out_ptr, in_ptr, n * 8) }
        qsort_raw_i64(out_ptr, 0, n - 1)
        return
    }
    mem_set(hist, 0, max_pass * 256 * 8)
    mut i := 0
    while i < n {
        v := ptr_read_i64(in_ptr, i)
        if max_pass > 0 { b0 := v & 255; ptr_write_i64(hist, b0, ptr_read_i64(hist, b0) + 1) }
        if max_pass > 1 { b1 := ushr64(v, 8) & 255; ptr_write_i64(hist, 256 + b1, ptr_read_i64(hist, 256 + b1) + 1) }
        if max_pass > 2 { b2 := ushr64(v, 16) & 255; ptr_write_i64(hist, 512 + b2, ptr_read_i64(hist, 512 + b2) + 1) }
        if max_pass > 3 { b3 := ushr64(v, 24) & 255; ptr_write_i64(hist, 768 + b3, ptr_read_i64(hist, 768 + b3) + 1) }
        if max_pass > 4 { b4 := ushr64(v, 32) & 255; ptr_write_i64(hist, 1024 + b4, ptr_read_i64(hist, 1024 + b4) + 1) }
        if max_pass > 5 { b5 := ushr64(v, 40) & 255; ptr_write_i64(hist, 1280 + b5, ptr_read_i64(hist, 1280 + b5) + 1) }
        if max_pass > 6 { b6 := ushr64(v, 48) & 255; ptr_write_i64(hist, 1536 + b6, ptr_read_i64(hist, 1536 + b6) + 1) }
        if max_pass > 7 { b7 := (ushr64(v, 56) ^ 128) & 255; ptr_write_i64(hist, 1792 + b7, ptr_read_i64(hist, 1792 + b7) + 1) }
        i += 1
    }
    mut src := in_ptr
    mut dst := if in_ptr == out_ptr { scratch_ptr } else { out_ptr }
    mut pass_idx := 0
    while pass_idx < max_pass {
        base := pass_idx << 8
        mut sum := 0
        mut trivial := false
        mut b := 0
        while b < 256 {
            cnt := ptr_read_i64(hist, base + b)
            if cnt == n { trivial = true; break }
            ptr_write_i64(hist, base + b, sum)
            sum += cnt
            b += 1
        }
        if not trivial {
            if pass_idx == 0 {
                i = 0; while i < n { v := ptr_read_i64(src, i); bk := v & 255; p := ptr_read_i64(hist, bk); ptr_write_i64(dst, p, v); ptr_write_i64(hist, bk, p + 1); i += 1 }
            } else if pass_idx == 1 {
                i = 0; while i < n { v := ptr_read_i64(src, i); bk := 256 + (ushr64(v, 8) & 255); p := ptr_read_i64(hist, bk); ptr_write_i64(dst, p, v); ptr_write_i64(hist, bk, p + 1); i += 1 }
            } else if pass_idx == 2 {
                i = 0; while i < n { v := ptr_read_i64(src, i); bk := 512 + (ushr64(v, 16) & 255); p := ptr_read_i64(hist, bk); ptr_write_i64(dst, p, v); ptr_write_i64(hist, bk, p + 1); i += 1 }
            } else if pass_idx == 3 {
                i = 0; while i < n { v := ptr_read_i64(src, i); bk := 768 + (ushr64(v, 24) & 255); p := ptr_read_i64(hist, bk); ptr_write_i64(dst, p, v); ptr_write_i64(hist, bk, p + 1); i += 1 }
            } else if pass_idx == 4 {
                i = 0; while i < n { v := ptr_read_i64(src, i); bk := 1024 + (ushr64(v, 32) & 255); p := ptr_read_i64(hist, bk); ptr_write_i64(dst, p, v); ptr_write_i64(hist, bk, p + 1); i += 1 }
            } else if pass_idx == 5 {
                i = 0; while i < n { v := ptr_read_i64(src, i); bk := 1280 + (ushr64(v, 40) & 255); p := ptr_read_i64(hist, bk); ptr_write_i64(dst, p, v); ptr_write_i64(hist, bk, p + 1); i += 1 }
            } else if pass_idx == 6 {
                i = 0; while i < n { v := ptr_read_i64(src, i); bk := 1536 + (ushr64(v, 48) & 255); p := ptr_read_i64(hist, bk); ptr_write_i64(dst, p, v); ptr_write_i64(hist, bk, p + 1); i += 1 }
            } else {
                i = 0; while i < n { v := ptr_read_i64(src, i); bk := 1792 + ((ushr64(v, 56) ^ 128) & 255); p := ptr_read_i64(hist, bk); ptr_write_i64(dst, p, v); ptr_write_i64(hist, bk, p + 1); i += 1 }
            }
            swp := src; src = dst; dst = swp
        }
        pass_idx += 1
    }
    if src != out_ptr {
        mem_copy(out_ptr, src, n * 8)
    }
}

// Worker 1: Parallel per-thread MSB 8-bit histogram (zero contention; each thread owns 256-slot row `tid << 8`)
fn _radix_par_hist_worker(tid: i64, nthreads: i64, pool: i64) {
    unsafe {
        arr := ptr_read_i64(pool, 4)
        n := ptr_read_i64(pool, 5)
        th_hist := ptr_read_i64(pool, 6)
        msb_pass := ptr_read_i64(pool, 7)
        nt_out := ptr_read_i64(pool, 8)
        if tid == 0 { ptr_write_i64(nt_out, 0, nthreads) }
        lo := (tid * n) / nthreads
        hi := ((tid + 1) * n) / nthreads
        row := th_hist + (tid << 11)
        mem_set(row, 0, 2048)
        mut i := lo
        if msb_pass == 7 {
            while i < hi {
                bk := (ushr64(ptr_read_i64(arr, i), 56) ^ 128) & 255
                ptr_write_i64(row, bk, ptr_read_i64(row, bk) + 1)
                i += 1
            }
        } else {
            sh := msb_pass * 8
            while i < hi {
                bk := ushr64(ptr_read_i64(arr, i), sh) & 255
                ptr_write_i64(row, bk, ptr_read_i64(row, bk) + 1)
                i += 1
            }
        }
    }
}

// Worker 2: Parallel zero-lock MSB scatter (`arr` -> `tmp`) using disjoint per-(thread, bucket) prefix offsets!
fn _radix_par_scatter_worker(tid: i64, nthreads: i64, pool: i64) {
    unsafe {
        arr := ptr_read_i64(pool, 4)
        tmp := ptr_read_i64(pool, 5)
        n := ptr_read_i64(pool, 6)
        th_hist := ptr_read_i64(pool, 7)
        msb_pass := ptr_read_i64(pool, 8)
        lo := (tid * n) / nthreads
        hi := ((tid + 1) * n) / nthreads
        row := th_hist + (tid << 11)
        mut i := lo
        if msb_pass == 7 {
            while i < hi {
                v := ptr_read_i64(arr, i)
                bk := (ushr64(v, 56) ^ 128) & 255
                pos := ptr_read_i64(row, bk)
                ptr_write_i64(tmp, pos, v)
                ptr_write_i64(row, bk, pos + 1)
                i += 1
            }
        } else {
            sh := msb_pass * 8
            while i < hi {
                v := ptr_read_i64(arr, i)
                bk := ushr64(v, sh) & 255
                pos := ptr_read_i64(row, bk)
                ptr_write_i64(tmp, pos, v)
                ptr_write_i64(row, bk, pos + 1)
                i += 1
            }
        }
    }
}

// Worker 3: Parallel L1D-resident bucket sort directly from `tmp` -> `arr` (zero initial memcpy!)
fn _radix_par_bucket_worker(tid: i64, nthreads: i64, pool: i64) {
    unsafe {
        arr := ptr_read_i64(pool, 4)
        tmp := ptr_read_i64(pool, 5)
        offs := ptr_read_i64(pool, 6)
        ends := ptr_read_i64(pool, 7)
        sub_passes := ptr_read_i64(pool, 8)
        lhist_all := ptr_read_i64(pool, 9)
        lhist := lhist_all + (tid << 14) // pre-allocated 16 KB/thread (zero malloc in worker!)
        // Round-robin bucket striping ensures 100% load balance even when keys are all-positive (buckets 0..127 empty)!
        mut bi := tid
        while bi < 256 {
            st := ptr_read_i64(offs, bi)
            en := ptr_read_i64(ends, bi)
            bn := en - st
            if bn == 1 {
                ptr_write_i64(arr, st, ptr_read_i64(tmp, st))
            } else if bn <= 512 or lhist_all == 0 {
                mem_copy(arr + st * 8, tmp + st * 8, bn * 8)
                if bn <= 48 {
                    isort_raw_i64(arr + st * 8, 0, bn - 1)
                } else {
                    qsort_raw_i64(arr + st * 8, 0, bn - 1)
                }
            } else if bn > 1 {
                _radix_lsd_sub_i64(tmp + st * 8, arr + st * 8, tmp + st * 8, lhist, bn, sub_passes)
            }
            bi += nthreads
        }
    }
}

// Ultra-fast O(N) Full-Parallel Adaptive MSB-8 + L1D-Resident Constant-Shift Radix Sort!
// For `n >= 65536`: 12-thread parallel MSB histogram -> 12-thread zero-lock scatter -> 12-thread L1D radix sort `tmp -> arr`!
// Bit-exact across all signed 64-bit integers (`INT64_MIN .. INT64_MAX`).
// Single-dispatch 6-thread MSB-8 (256 buckets) + 64B lock-free flag barrier + 64-sub-bucket local MSD + isort!
fn _radix_med_all_worker(tid: i64, nthreads: i64, pool: i64) {
    unsafe {
        nt_use := if nthreads > 16 { 16 } else { nthreads }
        if tid >= nt_use { return }
        arr := ptr_read_i64(pool, 4)
        tmp := ptr_read_i64(pool, 5)
        n := ptr_read_i64(pool, 6)
        meta := ptr_read_i64(pool, 7)
        // 256-bucket L2-resident meta (~38KB): [0..1023]=fbarr, [1024..33791]=th_hist (16*2048B),
        // [33792..35839]=offs (2048B), [35840..37887]=ends (2048B), [37888]=ok_box, [37896]=sh_box, [37904]=xor_box
        fbarr := meta
        th_hist := meta + 1024
        offs := meta + 33792
        ends := meta + 35840
        ok_box := meta + 37888
        sh := ptr_read_i64(meta + 37896, 0)
        xor_m := ptr_read_i64(meta + 37904, 0)
        lo := (tid * n) / nt_use
        hi := ((tid + 1) * n) / nt_use
        row := th_hist + (tid << 11) // 256 * 8 = 2048B per thread
        mem_set(row, 0, 2048)
        sh_xor := sh | (xor_m << 8)
        _ := avx_radix_256_pass(0, arr, tmp, row, lo, hi, sh_xor)
        if tid == 0 {
            mut t := 1
            while t < nt_use { mut sp := 0; while atomic_load_i64(fbarr, t << 3) < 1 { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }; t += 1 }
            mut sum := 0; mut non_empty := 0; mut b := 0
            while b < 256 {
                ptr_write_i64(offs, b, sum)
                t = 0; mut b_tot := 0
                while t < nt_use {
                    c_tb := ptr_read_i64(th_hist, (t << 8) + b)
                    ptr_write_i64(th_hist, (t << 8) + b, sum)
                    sum += c_tb; b_tot += c_tb; t += 1
                }
                if b_tot > 0 { non_empty += 1 }
                ptr_write_i64(ends, b, sum)
                b += 1
            }
            ptr_write_i64(ok_box, 0, if non_empty >= 8 { 1 } else { 0 })
            atomic_store_rel_i64(fbarr, 0, 1)
        } else {
            atomic_store_rel_i64(fbarr, tid << 3, 1)
            mut sp := 0; while atomic_load_i64(fbarr, 0) < 1 { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }
        }
        if ptr_read_i64(ok_box, 0) == 0 { return }
        _ := avx_radix_256_pass(1, arr, tmp, row, lo, hi, sh_xor)
        if tid == 0 {
            mut t := 1
            while t < nt_use { mut sp := 0; while atomic_load_i64(fbarr, t << 3) < 2 { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }; t += 1 }
            atomic_store_rel_i64(fbarr, 0, 2)
        } else {
            atomic_store_rel_i64(fbarr, tid << 3, 2)
            mut sp2 := 0; while atomic_load_i64(fbarr, 0) < 2 { cpu_pause(); sp2 += 1; if (sp2 & 511) == 0 { thread_yield() } }
        }
        sh2 := sh - 6
        mut bi := tid
        while bi < 256 {
            st := ptr_read_i64(offs, bi)
            en := ptr_read_i64(ends, bi)
            bn := en - st
            if bn == 1 {
                ptr_write_i64(arr, st, ptr_read_i64(tmp, st))
            } else if bn > 1 {
                if bn <= 4096 {
                    _ := avx_radix_bsort_i64(tmp + st * 8, arr + st * 8, bn, sh2)
                } else {
                    mem_copy(arr + st * 8, tmp + st * 8, bn * 8)
                    qsort_raw_i64(arr + st * 8, 0, bn - 1)
                }
            }
            bi += nt_use
        }
    }
}

unsafe fn radix_sort_raw_i64(arr: i64, n: i64) {
    if n <= 1 { return }
    if n <= 48 {
        isort_raw_i64(arr, 0, n - 1)
        return
    }
    // Zero-alloc O(N) adaptive check (TimSort-beating fastpath on sorted / reverse-sorted inputs; exits in 2 loads on random!)
    mut asc := true
    mut desc := true
    mut prev := ptr_read_i64(arr, 0)
    mut si := 1
    while si < n and (asc or desc) {
        cur := ptr_read_i64(arr, si)
        if cur < prev { asc = false }
        if cur > prev { desc = false }
        prev = cur
        si += 1
    }
    if asc { return }
    if desc {
        mut lo := 0
        mut hi := n - 1
        while lo < hi {
            vl := ptr_read_i64(arr, lo)
            ptr_write_i64(arr, lo, ptr_read_i64(arr, hi))
            ptr_write_i64(arr, hi, vl)
            lo += 1
            hi -= 1
        }
        return
    }

    // Medium-size SINGLE-DISPATCH 256-bucket MSB (sh=56, xor=128 -> 128 active buckets even on all-positive!) + L1D MSD+isort
    if n >= 24576 and n < 131072 {
        arena := mem_alloc_raw(38400 + n * 8)
        if arena != 0 {
            meta := arena
            args := arena + 38016
            tmp := arena + 38144
            mut ft := 0
            while ft < 16 { ptr_write_i64(meta, ft << 3, 0); ft += 1 }
            ptr_write_i64(meta + 37888, 0, 0)
            ptr_write_i64(meta + 37896, 0, 56)
            ptr_write_i64(meta + 37904, 0, 128)
            ptr_write_i64(args, 0, arr)
            ptr_write_i64(args, 1, tmp)
            ptr_write_i64(args, 2, n)
            ptr_write_i64(args, 3, meta)
            ptr_write_i64(args, 4, 0)
            ptr_write_i64(args, 5, 0)
            _ := ai_pool_dispatch(fn_addr(_radix_med_all_worker), args)
            ok := ptr_read_i64(meta + 37888, 0)
            mem_free_aligned(arena)
            if ok != 0 { return }
        }
    }
    if n >= 8192 and n < 24576 {
        arena := mem_alloc_aligned(n * 8 + 8192)
        if arena != 0 {
            cnt := arena
            offs := arena + 2048
            ends := arena + 4096
            args := arena + 6144
            tmp := arena + 6400
            mem_set(cnt, 0, 2048)
            mut i := 0
            lim2 := n - 1
            while i < lim2 {
                bk0 := ushr64(ptr_read_i64(arr, i), 56) ^ 128
                bk1 := ushr64(ptr_read_i64(arr, i + 1), 56) ^ 128
                ptr_write_i64(cnt, bk0, ptr_read_i64(cnt, bk0) + 1)
                ptr_write_i64(cnt, bk1, ptr_read_i64(cnt, bk1) + 1)
                i += 2
            }
            while i < n {
                bk := ushr64(ptr_read_i64(arr, i), 56) ^ 128
                ptr_write_i64(cnt, bk, ptr_read_i64(cnt, bk) + 1)
                i += 1
            }
            mut sum := 0
            mut non_empty := 0
            mut b := 0
            while b < 256 {
                c_b := ptr_read_i64(cnt, b)
                if c_b > 0 { non_empty += 1 }
                ptr_write_i64(offs, b, sum)
                ptr_write_i64(cnt, b, sum)
                sum += c_b
                ptr_write_i64(ends, b, sum)
                b += 1
            }
            if non_empty >= 16 {
                i = 0
                while i < lim2 {
                    v0 := ptr_read_i64(arr, i); v1 := ptr_read_i64(arr, i + 1)
                    bk0 := ushr64(v0, 56) ^ 128
                    p0 := ptr_read_i64(cnt, bk0); ptr_write_i64(tmp, p0, v0); ptr_write_i64(cnt, bk0, p0 + 1)
                    bk1 := ushr64(v1, 56) ^ 128
                    p1 := ptr_read_i64(cnt, bk1); ptr_write_i64(tmp, p1, v1); ptr_write_i64(cnt, bk1, p1 + 1)
                    i += 2
                }
                while i < n {
                    v := ptr_read_i64(arr, i)
                    bk := ushr64(v, 56) ^ 128
                    pos := ptr_read_i64(cnt, bk)
                    ptr_write_i64(tmp, pos, v)
                    ptr_write_i64(cnt, bk, pos + 1)
                    i += 1
                }
                ptr_write_i64(args, 0, arr)
                ptr_write_i64(args, 1, tmp)
                ptr_write_i64(args, 2, offs)
                ptr_write_i64(args, 3, ends)
                ptr_write_i64(args, 4, 7)
                ptr_write_i64(args, 5, 0)
                _ := ai_pool_dispatch(fn_addr(_radix_par_bucket_worker), args)
                mem_free_aligned(arena)
                return
            }
            mem_free_aligned(arena)
        }
    }

    if n >= 131072 {
        // Sample 512 elements to pick the highest varying byte
        mut diff_bits := 0
        v0 := ptr_read_i64(arr, 0)
        mut step := n >> 9
        if step < 1 { step = 1 }
        mut k := 0
        while k < n {
            diff_bits = diff_bits | (ptr_read_i64(arr, k) ^ v0)
            k += step
        }
        mut has_neg := (v0 < 0)
        mut has_pos := (v0 >= 0)
        if not (has_neg and has_pos) {
            mut m := 0
            while m < n {
                if ptr_read_i64(arr, m) < 0 { has_neg = true } else { has_pos = true }
                if has_neg and has_pos { break }
                m += 1
            }
        }
        mut msb_pass := 7
        if not (has_neg and has_pos) {
            msb_pass = 7
            while msb_pass > 1 and ((ushr64(diff_bits, msb_pass * 8) & 255) == 0) {
                msb_pass -= 1
            }
        }
        if msb_pass < 7 {
            top_mask := (0 - 1) << ((msb_pass + 1) * 8)
            ref_top := v0 & top_mask
            mut ok_top := true
            mut t := 0
            while t < n {
                if (ptr_read_i64(arr, t) & top_mask) != ref_top { ok_top = false; break }
                t += 1
            }
            if not ok_top { msb_pass = 7 }
        }

        // Single arena allocation for up to 16 threads:
        // th_hist (16 * 256 * 8 = 32 KB) + offs (2 KB) + ends (2 KB) + lhist_all (16 * 16 KB = 256 KB) + args/nt (128 B)
        meta := mem_alloc_aligned(300032)
        tmp := mem_alloc_aligned(n * 8 + 64)
        if meta != 0 and tmp != 0 {
            th_hist := meta
            offs := meta + 32768
            ends := meta + 34816
            lhist_all := meta + 36864
            args := meta + 299008
            nt_box := meta + 299072
            ptr_write_i64(nt_box, 0, 1)

            // Phase 1: Parallel 12-thread MSB histogram
            ptr_write_i64(args, 0, arr)
            ptr_write_i64(args, 1, n)
            ptr_write_i64(args, 2, th_hist)
            ptr_write_i64(args, 3, msb_pass)
            ptr_write_i64(args, 4, nt_box)
            ptr_write_i64(args, 5, 0)
            _ := ai_pool_dispatch(fn_addr(_radix_par_hist_worker), args)
            nt := ptr_read_i64(nt_box, 0)

            // Prefix sum across (bucket b, thread t) -> exact disjoint scatter offsets!
            mut sum := 0
            mut non_empty := 0
            mut b := 0
            while b < 256 {
                ptr_write_i64(offs, b, sum)
                mut t := 0
                mut b_tot := 0
                while t < nt {
                    c_tb := ptr_read_i64(th_hist, (t << 8) + b)
                    ptr_write_i64(th_hist, (t << 8) + b, sum)
                    sum += c_tb
                    b_tot += c_tb
                    t += 1
                }
                if b_tot > 0 { non_empty += 1 }
                ptr_write_i64(ends, b, sum)
                b += 1
            }

            if non_empty >= 4 {
                // Phase 2: Parallel 12-thread zero-lock scatter `arr -> tmp`
                ptr_write_i64(args, 0, arr)
                ptr_write_i64(args, 1, tmp)
                ptr_write_i64(args, 2, n)
                ptr_write_i64(args, 3, th_hist)
                ptr_write_i64(args, 4, msb_pass)
                ptr_write_i64(args, 5, 0)
                _ := ai_pool_dispatch(fn_addr(_radix_par_scatter_worker), args)

                // Phase 3: Parallel 12-thread L1D radix sort `tmp -> arr` (zero memcpy!)
                ptr_write_i64(args, 0, arr)
                ptr_write_i64(args, 1, tmp)
                ptr_write_i64(args, 2, offs)
                ptr_write_i64(args, 3, ends)
                ptr_write_i64(args, 4, msb_pass)
                ptr_write_i64(args, 5, lhist_all)
                _ := ai_pool_dispatch(fn_addr(_radix_par_bucket_worker), args)

                mem_free_aligned(meta)
                mem_free_aligned(tmp)
                return
            }
        }
        if meta != 0 { mem_free_aligned(meta) }
        if tmp != 0 { mem_free_aligned(tmp) }
    }

    hist := mem_alloc_aligned(2048 * 8 + 64)
    tmp := mem_alloc_aligned(n * 8 + 64)
    if hist == 0 or tmp == 0 {
        if hist != 0 { mem_free_aligned(hist) }
        if tmp != 0 { mem_free_aligned(tmp) }
        qsort_raw_i64(arr, 0, n - 1)
        return
    }
    _radix_lsd_sub_i64(arr, arr, tmp, hist, n, 8)
    mem_free_aligned(hist)
    mem_free_aligned(tmp)
}

// Safe wrapper: sorts an `IntBuf` in ascending signed order in O(N) time via LSD Radix Sort.
fn sort_i64(b: IntBuf) {
    n := ibuf_len(b)
    if n <= 1 { return }
    if n <= 64 {
        sort_i64_range(b, 0, n - 1)
        return
    }
    unsafe {
        radix_sort_raw_i64((b as i64) + 16, n)
    }
}

// Fallback safe IntBuf sort if caller prefers zero-alloc QuickSort or custom subrange `[lo..hi]` inclusive.
fn sort_i64_range(b: IntBuf, lo: i64, hi: i64) {
    n := ibuf_len(b)
    if lo < 0 or hi >= n or lo >= hi { return }
    mut i := lo + 1
    if hi - lo <= 48 {
        while i <= hi {
            key := ibuf_get(b, i)
            mut j := i - 1
            while j >= lo and ibuf_get(b, j) > key {
                ibuf_set(b, j + 1, ibuf_get(b, j))
                j -= 1
            }
            ibuf_set(b, j + 1, key)
            i += 1
        }
        return
    }
    len := hi - lo + 1
    unsafe {
        radix_sort_raw_i64((b as i64) + 16 + lo * 8, len)
    }
}

// Helper: copies IntBuf -> raw aligned buffer, sorts with radix_sort_raw_i64, copies back (100% portable, no header assumptions!)
fn ptr_from_ibuf_data_sort(b: IntBuf) {
    n := ibuf_len(b)
    if n <= 1 { return }
    sort_i64_range(b, 0, n - 1)
}

// Binary search on sorted ascending `IntBuf` -> index or `-1` if not found.
fn bsearch_i64(b: IntBuf, target: i64) -> i64 {
    mut lo := 0
    mut hi := ibuf_len(b) - 1
    while lo <= hi {
        mid := lo + ((hi - lo) >> 1)
        v := ibuf_get(b, mid)
        if v == target { return mid }
        if v < target { lo = mid + 1 }
        else          { hi = mid - 1 }
    }
    return -1
}

// First index `i` in `[0..len]` where `b[i] >= target`.
fn lower_bound_i64(b: IntBuf, target: i64) -> i64 {
    mut lo := 0
    mut hi := ibuf_len(b)
    while lo < hi {
        mid := lo + ((hi - lo) >> 1)
        if ibuf_get(b, mid) < target { lo = mid + 1 }
        else                         { hi = mid }
    }
    return lo
}

// First index `i` in `[0..len]` where `b[i] > target`.
fn upper_bound_i64(b: IntBuf, target: i64) -> i64 {
    mut lo := 0
    mut hi := ibuf_len(b)
    while lo < hi {
        mid := lo + ((hi - lo) >> 1)
        if ibuf_get(b, mid) <= target { lo = mid + 1 }
        else                          { hi = mid }
    }
    return lo
}

fn ibuf_reverse(b: IntBuf) {
    mut l := 0
    mut r := ibuf_len(b) - 1
    while l < r {
        t := ibuf_get(b, l)
        ibuf_set(b, l, ibuf_get(b, r))
        ibuf_set(b, r, t)
        l += 1
        r -= 1
    }
}

// Returns unique count `u` in a sorted `IntBuf` and compacts unique elements into `b[0..u)`.
fn ibuf_dedup_sorted(b: IntBuf) -> i64 {
    n := ibuf_len(b)
    if n <= 1 { return n }
    mut w := 1
    mut r := 1
    while r < n {
        v := ibuf_get(b, r)
        if v != ibuf_get(b, w - 1) {
            ibuf_set(b, w, v)
            w += 1
        }
        r += 1
    }
    return w
}

fn ibuf_sum(b: IntBuf) -> i64 {
    n := ibuf_len(b)
    mut s := 0
    mut i := 0
    while i < n { s += ibuf_get(b, i); i += 1 }
    return s
}

fn ibuf_min(b: IntBuf, default_val: i64 = 0) -> i64 {
    n := ibuf_len(b)
    if n <= 0 { return default_val }
    mut m := ibuf_get(b, 0)
    mut i := 1
    while i < n {
        v := ibuf_get(b, i)
        if v < m { m = v }
        i += 1
    }
    return m
}

fn ibuf_max(b: IntBuf, default_val: i64 = 0) -> i64 {
    n := ibuf_len(b)
    if n <= 0 { return default_val }
    mut m := ibuf_get(b, 0)
    mut i := 1
    while i < n {
        v := ibuf_get(b, i)
        if v > m { m = v }
        i += 1
    }
    return m
}

// --- Binary Min-Heap (`[size, e0, e1, ...]`) & Key-Value Priority Queue (`[size, k0, v0, k1, v1, ...]`) ---

fn heap_new(cap: i64 = 256) -> IntBuf {
    h := ibuf_new(cap + 4)
    ibuf_push(h, 0)
    return h
}

fn heap_len(h: IntBuf) -> i64 {
    return ibuf_get(h, 0)
}

fn heap_peek(h: IntBuf, default_val: i64 = 0) -> i64 {
    if ibuf_get(h, 0) <= 0 { return default_val }
    return ibuf_get(h, 1)
}

fn heap_push_min(h: IntBuf, val: i64) {
    sz := ibuf_get(h, 0) + 1
    if sz < ibuf_len(h) { ibuf_set(h, sz, val) }
    else                { ibuf_push(h, val) }
    ibuf_set(h, 0, sz)
    mut idx := sz
    while idx > 1 {
        p := idx >> 1
        pv := ibuf_get(h, p)
        if pv <= val { break }
        ibuf_set(h, idx, pv)
        idx = p
    }
    ibuf_set(h, idx, val)
}

fn heap_pop_min(h: IntBuf, default_val: i64 = 0) -> i64 {
    sz := ibuf_get(h, 0)
    if sz <= 0 { return default_val }
    res := ibuf_get(h, 1)
    last := ibuf_get(h, sz)
    new_sz := sz - 1
    ibuf_set(h, 0, new_sz)
    if new_sz > 0 {
        mut idx := 1
        while (idx << 1) <= new_sz {
            mut ch := idx << 1
            if ch + 1 <= new_sz and ibuf_get(h, ch + 1) < ibuf_get(h, ch) {
                ch += 1
            }
            cv := ibuf_get(h, ch)
            if last <= cv { break }
            ibuf_set(h, idx, cv)
            idx = ch
        }
        ibuf_set(h, idx, last)
    }
    return res
}

fn heap_kv_new(cap_pairs: i64 = 256) -> IntBuf {
    h := ibuf_new(cap_pairs * 2 + 4)
    ibuf_push(h, 0)
    return h
}

fn heap_kv_len(h: IntBuf) -> i64 {
    return ibuf_get(h, 0)
}

fn heap_push_kv_min(h: IntBuf, key: i64, val: i64) {
    sz := ibuf_get(h, 0) + 1
    need := 1 + sz * 2
    while ibuf_len(h) < need { ibuf_push(h, 0) }
    ibuf_set(h, 0, sz)
    mut idx := sz
    while idx > 1 {
        p := idx >> 1
        pk := ibuf_get(h, p * 2 - 1)
        if pk <= key { break }
        ibuf_set(h, idx * 2 - 1, pk)
        ibuf_set(h, idx * 2, ibuf_get(h, p * 2))
        idx = p
    }
    ibuf_set(h, idx * 2 - 1, key)
    ibuf_set(h, idx * 2, val)
}

fn heap_pop_kv_min(h: IntBuf) -> (i64, i64) {
    sz := ibuf_get(h, 0)
    if sz <= 0 { return (0, -1) }
    rk := ibuf_get(h, 1)
    rv := ibuf_get(h, 2)
    lk := ibuf_get(h, sz * 2 - 1)
    lv := ibuf_get(h, sz * 2)
    new_sz := sz - 1
    ibuf_set(h, 0, new_sz)
    if new_sz > 0 {
        mut idx := 1
        while (idx << 1) <= new_sz {
            mut ch := idx << 1
            if ch + 1 <= new_sz and ibuf_get(h, (ch + 1) * 2 - 1) < ibuf_get(h, ch * 2 - 1) {
                ch += 1
            }
            ck := ibuf_get(h, ch * 2 - 1)
            if lk <= ck { break }
            ibuf_set(h, idx * 2 - 1, ck)
            ibuf_set(h, idx * 2, ibuf_get(h, ch * 2))
            idx = ch
        }
        ibuf_set(h, idx * 2 - 1, lk)
        ibuf_set(h, idx * 2, lv)
    }
    return (rk, rv)
}

// --- Disjoint-Set Union-Find (`[n, components, parent[0..n], size[0..n]]`) ---

fn dsu_new(n: i64) -> IntBuf {
    mut cnt := n
    if cnt < 0 { cnt = 0 }
    d := ibuf_new(2 + cnt * 2 + 4)
    ibuf_push(d, cnt)
    ibuf_push(d, cnt)
    mut i := 0
    while i < cnt { ibuf_push(d, i); i += 1 }
    i = 0
    while i < cnt { ibuf_push(d, 1); i += 1 }
    return d
}

fn dsu_find(d: IntBuf, x_in: i64) -> i64 {
    n := ibuf_get(d, 0)
    if x_in < 0 or x_in >= n { return -1 }
    mut x := x_in
    while true {
        px := ibuf_get(d, 2 + x)
        if px == x { return x }
        gpx := ibuf_get(d, 2 + px)
        ibuf_set(d, 2 + x, gpx) // path halving
        x = gpx
    }
    return x
}

fn dsu_union(d: IntBuf, a: i64, b: i64) -> bool {
    mut ra := dsu_find(d, a)
    mut rb := dsu_find(d, b)
    if ra < 0 or rb < 0 or ra == rb { return false }
    n := ibuf_get(d, 0)
    sa := ibuf_get(d, 2 + n + ra)
    sb := ibuf_get(d, 2 + n + rb)
    if sa < sb { t := ra; ra = rb; rb = t }
    ibuf_set(d, 2 + rb, ra)
    ibuf_set(d, 2 + n + ra, sa + sb)
    ibuf_set(d, 1, ibuf_get(d, 1) - 1)
    return true
}

fn dsu_same(d: IntBuf, a: i64, b: i64) -> bool {
    ra := dsu_find(d, a)
    return ra >= 0 and ra == dsu_find(d, b)
}

fn dsu_components(d: IntBuf) -> i64 {
    return ibuf_get(d, 1)
}
