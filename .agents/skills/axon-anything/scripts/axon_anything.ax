// `axon-anything` v1.2.0 — 100% Pure-Axon Code Migration & Verification Harness
// Subcommands:
//   analyze <path>                Scan source file/dir, classify source languages & recommend `std::*` modules
//   gate <file.ax>                Run 3-stage verification gate (`check --json` + `test` + `-O2 --shield` build)
//   diff <oracle.txt> <file.ax>   Execute `<file.ax>` and verify exact output match against `<oracle.txt>`
//   bench <file.ax>               Compare `-O0`, `-O2`, `-O3`, and `-Os` compiled binary sizes with 0 leftover trash

use std::str
use std::cli
use std::ds
use std::fs
use std::sys
use std::fmt
use std::subprocess

fn _aa_is_safe_path_arg(p: str) -> bool {
    n := str_len(p)
    if n <= 0 or n > 512 { return false }
    if str_byte(p, 0) == 45 or str_contains(p, "..") { return false }
    mut i := 0
    while i < n {
        b := str_byte(p, i)
        if b < 32 or b == 34 or b == 36 or b == 37 or b == 38 or b == 39 or b == 40 or b == 41 or b == 59 or b == 60 or b == 62 or b == 94 or b == 96 or b == 124 or b == 127 {
            return false
        }
        i += 1
    }
    return true
}

fn _aa_exec_axc(axc: str, a1: str, a2: str, a3: str = "", a4: str = "", a5: str = "", a6: str = "") -> str {
    mut argv := svec_new(8, 256)
    svec_push(mut argv, axc)
    svec_push(mut argv, a1)
    if str_len(a2) > 0 { svec_push(mut argv, a2) }
    if str_len(a3) > 0 { svec_push(mut argv, a3) }
    if str_len(a4) > 0 { svec_push(mut argv, a4) }
    if str_len(a5) > 0 { svec_push(mut argv, a5) }
    if str_len(a6) > 0 { svec_push(mut argv, a6) }
    res := subproc_run(argv, "", "", 30000, 131072)
    svec_free(move argv)
    return res.stdout + res.stderr
}

fn _aa_find_axc() -> str {
    if sys_fs_exists("bin/axc.exe") { return "bin\\axc.exe" }
    if sys_fs_exists("bin/axc") { return "./bin/axc" }
    return "axc"
}

fn _aa_detect_lang(fname: str) -> str {
    if str_ends_with(fname, ".py") { return "Python" }
    if str_ends_with(fname, ".rs") { return "Rust" }
    if str_ends_with(fname, ".c") or str_ends_with(fname, ".h") { return "C" }
    if str_ends_with(fname, ".cpp") or str_ends_with(fname, ".cc") or str_ends_with(fname, ".hpp") { return "C++" }
    if str_ends_with(fname, ".go") { return "Go" }
    if str_ends_with(fname, ".java") { return "Java" }
    if str_ends_with(fname, ".ts") or str_ends_with(fname, ".js") { return "TypeScript/JS" }
    if str_ends_with(fname, ".ax") { return "Axon" }
    return ""
}

fn _aa_suggest_modules_for_src(src: str, mut mods: StrMap, mut mod_list: StrVec) {
    if str_find(src, "numpy") >= 0 or str_find(src, "linalg") >= 0 or str_find(src, "nalgebra") >= 0 or str_find(src, "Eigen") >= 0 {
        if not smap_has(mods, "std::linalg") { smap_set_i64(mut mods, "std::linalg", 1); svec_push(mut mod_list, "std::linalg") }
    }
    if str_find(src, "fft") >= 0 or str_find(src, "scipy.optimize") >= 0 or str_find(src, "ode") >= 0 {
        if not smap_has(mods, "std::numeric") { smap_set_i64(mut mods, "std::numeric", 1); svec_push(mut mod_list, "std::numeric") }
    }
    if str_find(src, "pandas") >= 0 or str_find(src, "polars") >= 0 or str_find(src, "read_csv") >= 0 or str_find(src, "DataFrame") >= 0 {
        if not smap_has(mods, "std::dataframe") { smap_set_i64(mut mods, "std::dataframe", 1); svec_push(mut mod_list, "std::dataframe") }
    }
    if str_find(src, "ttest") >= 0 or str_find(src, "statsmodels") >= 0 or str_find(src, "scipy.stats") >= 0 {
        if not smap_has(mods, "std::stats") { smap_set_i64(mut mods, "std::stats", 1); svec_push(mut mod_list, "std::stats") }
        if not smap_has(mods, "std::prob") { smap_set_i64(mut mods, "std::prob", 1); svec_push(mut mod_list, "std::prob") }
    }
    if str_find(src, "sklearn") >= 0 or str_find(src, "RandomForest") >= 0 or str_find(src, "KMeans") >= 0 or str_find(src, "xgboost") >= 0 {
        if not smap_has(mods, "std::ml") { smap_set_i64(mut mods, "std::ml", 1); svec_push(mut mod_list, "std::ml") }
    }
    if str_find(src, "argon2") >= 0 or str_find(src, "pbkdf2") >= 0 or str_find(src, "totp") >= 0 or str_find(src, "pyotp") >= 0 {
        if not smap_has(mods, "std::auth") { smap_set_i64(mut mods, "std::auth", 1); svec_push(mut mod_list, "std::auth") }
    }
    if str_find(src, "keyring") >= 0 or str_find(src, "CryptProtectData") >= 0 or str_find(src, "os.urandom") >= 0 {
        if not smap_has(mods, "std::os_auth") { smap_set_i64(mut mods, "std::os_auth", 1); svec_push(mut mod_list, "std::os_auth") }
    }
    if str_find(src, "redis") >= 0 {
        if not smap_has(mods, "std::redis") { smap_set_i64(mut mods, "std::redis", 1); svec_push(mut mod_list, "std::redis") }
    }
    if str_find(src, "psycopg") >= 0 or str_find(src, "postgres") >= 0 or str_find(src, "pgx") >= 0 {
        if not smap_has(mods, "std::postgres") { smap_set_i64(mut mods, "std::postgres", 1); svec_push(mut mod_list, "std::postgres") }
    }
    if str_find(src, "sqlite") >= 0 {
        if not smap_has(mods, "std::sqlite") { smap_set_i64(mut mods, "std::sqlite", 1); svec_push(mut mod_list, "std::sqlite") }
        if not smap_has(mods, "std::db_pool") { smap_set_i64(mut mods, "std::db_pool", 1); svec_push(mut mod_list, "std::db_pool") }
    }
    if str_find(src, "http") >= 0 or str_find(src, "express") >= 0 or str_find(src, "fastapi") >= 0 {
        if not smap_has(mods, "std::web") { smap_set_i64(mut mods, "std::web", 1); svec_push(mut mod_list, "std::web") }
    }
}

fn cmd_analyze(target: str) -> i32 {
    if not sys_fs_exists(target) {
        println(f"[axon-anything] Target not found: {target}")
        return 1
    }
    mut lang_counts := smap_new(16)
    mut langs := svec_new(8, 128)
    mut rec_mods := smap_new(32)
    mut mod_list := svec_new(16, 256)
    mut total_files := 0
    mut total_lines := 0

    if fs_is_file(target) {
        lg := _aa_detect_lang(target)
        if str_len(lg) > 0 {
            total_files = 1
            smap_set_i64(mut lang_counts, lg, 1)
            svec_push(mut langs, lg)
            txt := fs_read_text(target) or ""
            ranges := str_split_ranges(txt, 10)
            total_lines = str_split_count(ranges)
            buf_free(move ranges)
            _aa_suggest_modules_for_src(txt, mut rec_mods, mut mod_list)
        }
    } else {
        entries := fs_list_dir(target)
        mut i := 0
        while i < svec_len(entries) {
            fnm := svec_get(entries, i)
            full := target + "/" + fnm
            lg := _aa_detect_lang(fnm)
            if str_len(lg) > 0 and fs_is_file(full) {
                total_files += 1
                prev := smap_get_i64(lang_counts, lg, 0)
                if prev == 0 { svec_push(mut langs, lg) }
                smap_set_i64(mut lang_counts, lg, prev + 1)
                txt := fs_read_text(full) or ""
                ranges := str_split_ranges(txt, 10)
                total_lines += str_split_count(ranges)
                buf_free(move ranges)
                _aa_suggest_modules_for_src(txt, mut rec_mods, mut mod_list)
            }
            i += 1
        }
        svec_free(move entries)
    }

    println("=== axon-anything Stage 1: ANALYZE Report ===")
    println(f"Target       : {target}")
    println(f"Source Files : {total_files} ({fmt_commas(total_lines)} LOC)")
    mut k := 0
    while k < svec_len(langs) {
        lg := svec_get(langs, k)
        println(f"  - {lg}: {smap_get_i64(lang_counts, lg, 0)} file(s)")
        k += 1
    }
    if svec_len(mod_list) > 0 {
        joined := svec_join(mod_list, ", ")
        println(f"Recommended Pure-Axon Modules: {joined}")
    } else {
        println("Recommended Pure-Axon Modules: std::str, std::ds, std::fs, std::algo")
    }
    smap_free(move lang_counts); svec_free(move langs)
    smap_free(move rec_mods); svec_free(move mod_list)
    return 0
}

fn cmd_gate(ax_file: str) -> i32 {
    if not _aa_is_safe_path_arg(ax_file) {
        println("[FAIL] Invalid or unsafe file path")
        return 1
    }
    axc := _aa_find_axc()
    println(f"=== axon-anything Verification Gate: {ax_file} ===")
    chk_out := _aa_exec_axc(axc, "check", "--json", ax_file)
    if str_find(chk_out, "\"ok\":true") < 0 {
        println(f"[FAIL] Gate 1 (Static Check): {chk_out}")
        return 1
    }
    println("[PASS] Gate 1: Static Types + Perceus 0-GC + Taint/Unsafe Check")

    tmp_bin := f".axon_gate_{sys_pid()}.exe"
    _ := _aa_exec_axc(axc, "build", ax_file, "-O2", "--shield", "-o", tmp_bin)
    built := sys_fs_exists(tmp_bin)
    if built {
        sz := sys_fs_size(tmp_bin)
        _ := sys_fs_remove(tmp_bin)
        println(f"[PASS] Gate 2: Production `-O2 --shield` Build ({fmt_bytes_human(sz)}, 0 temp files left)")
        return 0
    }
    println("[FAIL] Gate 2: Production `-O2 --shield` Build failed")
    return 1
}

fn cmd_diff(oracle_path: str, ax_file: str) -> i32 {
    if not _aa_is_safe_path_arg(oracle_path) or not _aa_is_safe_path_arg(ax_file) {
        println("[FAIL] Invalid or unsafe file path")
        return 1
    }
    axc := _aa_find_axc()
    expected := str_trim(fs_read_text(oracle_path) or "")
    got_raw := _aa_exec_axc(axc, "run", ax_file)
    got := str_trim(got_raw)
    if str_eq(expected, got) {
        println(f"[PASS] Differential Gate: Output matches `{oracle_path}` bit-for-bit!")
        return 0
    }
    println(f"[FAIL] Differential Gate mismatch!\nExpected:\n{expected}\nGot:\n{got}")
    return 1
}

fn cmd_bench(ax_file: str) -> i32 {
    if not _aa_is_safe_path_arg(ax_file) {
        println("[FAIL] Invalid or unsafe file path")
        return 1
    }
    axc := _aa_find_axc()
    println(f"=== axon-anything Optimization Profile Matrix: {ax_file} ===")
    mut i := 0
    while i < 4 {
        mut flag := "-O0"
        if i == 1 { flag = "-O2" }
        else if i == 2 { flag = "-O3" }
        else if i == 3 { flag = "-Os" }
        tmp_b := f".axon_bench_{sys_pid()}_{i}.exe"
        _ := _aa_exec_axc(axc, "build", ax_file, flag, "-o", tmp_b)
        if sys_fs_exists(tmp_b) {
            sz := sys_fs_size(tmp_b)
            _ := sys_fs_remove(tmp_b)
            println(f"  Profile {flag} : {fmt_bytes_human(sz)} ({fmt_commas(sz)} B)")
        }
        i += 1
    }
    return 0
}

fn main() -> i32 {
    // Support both `axon_anything.ax subcmd arg` and `axc run axon_anything.ax -- subcmd arg`
    mut sub := cli_pos_get(0, "")
    mut arg1 := cli_pos_get(1, "")
    mut arg2 := cli_pos_get(2, "")
    if str_eq(sub, "--") {
        sub = cli_pos_get(1, "")
        arg1 = cli_pos_get(2, "")
        arg2 = cli_pos_get(3, "")
    }
    if str_eq(sub, "analyze") and str_len(arg1) > 0 { return cmd_analyze(arg1) }
    if str_eq(sub, "gate") and str_len(arg1) > 0    { return cmd_gate(arg1) }
    if str_eq(sub, "diff") and str_len(arg2) > 0    { return cmd_diff(arg1, arg2) }
    if str_eq(sub, "bench") and str_len(arg1) > 0   { return cmd_bench(arg1) }
    println("Usage: axon_anything <analyze|gate|diff|bench> <target...>")
    return 0
}
