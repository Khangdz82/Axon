// Axon v7.0 Self-Hosted Compiler - Direct C Header Parser (`@cImport`) (`compiler_ax/c_import.ax`)
// Parses C `.h` files directly into Axon AST declarations (`nk_comptime_const`, `nk_struct`, `@extern` `nk_fn`)
// with zero external Clang/libclang dependency. Supports `#define` constants, `typedef struct`, `struct`,
// and C function prototypes (including `WINAPI`, `__declspec(dllimport)`, pointers, `const char*`).

use compiler_ax::tokens_ast

fn c_is_space(b: i64) -> bool {
    return b == 32 or b == 9 or b == 13 or b == 10
}

fn c_is_alpha(b: i64) -> bool {
    if b >= 65 and b <= 90 { return true }
    if b >= 97 and b <= 122 { return true }
    return b == 95
}

fn c_is_digit(b: i64) -> bool {
    return b >= 48 and b <= 57
}

fn c_is_alnum(b: i64) -> bool {
    return c_is_alpha(b) or c_is_digit(b)
}

// Tokenize C header into lightweight token stream `ctoks` (4 words/tok: `[kind, soff, slen, ival]`):
//   0 = EOF, 1 = Ident, 2 = Int, 3 = Str, 4 = Punct (`ival` = ASCII char)
// While scanning, directly extracts `#define NAME <int/hex/str>` into `out_consts`!
fn c_lex_header_and_defines(src: ByteBuf, pool: ByteBuf, nodes: IntBuf, ctoks: IntBuf, out_consts: IntBuf, file_id: i64) {
    n := buf_len(src)
    mut i := 0
    mut line := 1
    mut at_bol := true

    while i < n {
        b := buf_get(src, i)
        if b == 10 {
            line += 1
            at_bol = true
            i += 1
        } else if b == 32 or b == 9 or b == 13 {
            i += 1
        } else if b == 47 and i + 1 < n and buf_get(src, i + 1) == 47 {
            i += 2
            while i < n and buf_get(src, i) != 10 {
                i += 1
            }
        } else if b == 47 and i + 1 < n and buf_get(src, i + 1) == 42 {
            i += 2
            while i + 1 < n {
                if buf_get(src, i) == 10 { line += 1 }
                if buf_get(src, i) == 42 and buf_get(src, i + 1) == 47 {
                    i += 2
                    break
                }
                i += 1
            }
        } else if b == 35 and at_bol {
            // Preprocessor directive `#...`
            sp := span_pack(line, 1, file_id)
            i += 1
            while i < n and (buf_get(src, i) == 32 or buf_get(src, i) == 9) { i += 1 }
            d_off := buf_len(pool)
            while i < n and c_is_alnum(buf_get(src, i)) {
                buf_push(pool, buf_get(src, i))
                i += 1
            }
            d_len := buf_len(pool) - d_off
            if pool_str_eq_lit(pool, d_off, d_len, "define") {
                while i < n and (buf_get(src, i) == 32 or buf_get(src, i) == 9) { i += 1 }
                m_off := buf_len(pool)
                while i < n and c_is_alnum(buf_get(src, i)) {
                    buf_push(pool, buf_get(src, i))
                    i += 1
                }
                m_len := buf_len(pool) - m_off
                // Only simple object-like macros (not function-like `#define FOO(x)` where `(` immediately follows)
                if m_len > 0 and (i >= n or buf_get(src, i) != 40) {
                    while i < n and (buf_get(src, i) == 32 or buf_get(src, i) == 9) { i += 1 }
                    mut wrapped_paren := false
                    if i < n and buf_get(src, i) == 40 {
                        wrapped_paren = true
                        i += 1
                        while i < n and (buf_get(src, i) == 32 or buf_get(src, i) == 9) { i += 1 }
                    }
                    mut neg := false
                    if i < n and buf_get(src, i) == 45 {
                        neg = true
                        i += 1
                    }
                    if i < n and c_is_digit(buf_get(src, i)) {
                        mut val := 0
                        if buf_get(src, i) == 48 and i + 1 < n and (buf_get(src, i + 1) == 120 or buf_get(src, i + 1) == 88) {
                            i += 2
                            while i < n {
                                hc := buf_get(src, i)
                                if hc >= 48 and hc <= 57 { val = (val << 4) | (hc - 48); i += 1 }
                                else if hc >= 65 and hc <= 70 { val = (val << 4) | (hc - 55); i += 1 }
                                else if hc >= 97 and hc <= 102 { val = (val << 4) | (hc - 87); i += 1 }
                                else { break }
                            }
                        } else {
                            while i < n and c_is_digit(buf_get(src, i)) {
                                val = val *% 10 +% (buf_get(src, i) - 48)
                                i += 1
                            }
                        }
                        // Skip C integer suffixes `U`, `L`, `ULL`
                        while i < n and (buf_get(src, i) == 85 or buf_get(src, i) == 117 or buf_get(src, i) == 76 or buf_get(src, i) == 108) {
                            i += 1
                        }
                        while i < n and (buf_get(src, i) == 32 or buf_get(src, i) == 9) { i += 1 }
                        // Optional `<< shift` inside `#define FLAG (1 << 5)`
                        if i + 1 < n and buf_get(src, i) == 60 and buf_get(src, i + 1) == 60 {
                            i += 2
                            while i < n and (buf_get(src, i) == 32 or buf_get(src, i) == 9) { i += 1 }
                            mut sh := 0
                            while i < n and c_is_digit(buf_get(src, i)) {
                                sh = sh * 10 + (buf_get(src, i) - 48)
                                i += 1
                            }
                            val = val << (sh & 63)
                        }
                        if neg { val = 0 - val }
                        if wrapped_paren {
                            while i < n and (buf_get(src, i) == 32 or buf_get(src, i) == 9) { i += 1 }
                            if i < n and buf_get(src, i) == 41 { i += 1 }
                        }
                        inid := ast_alloc(nodes, nk_int(), sp)
                        ast_set(nodes, inid, 1, val)
                        cn := ast_alloc(nodes, nk_comptime_const(), sp)
                        ast_set(nodes, cn, 1, m_off)
                        ast_set(nodes, cn, 2, m_len)
                        ast_set(nodes, cn, 3, 0)
                        ast_set(nodes, cn, 4, inid)
                        ibuf_push(out_consts, cn)
                    } else if i < n and buf_get(src, i) == 34 and not neg {
                        i += 1
                        s_off := buf_len(pool)
                        while i < n and buf_get(src, i) != 34 and buf_get(src, i) != 10 {
                            if buf_get(src, i) == 92 and i + 1 < n {
                                i += 1
                            }
                            buf_push(pool, buf_get(src, i))
                            i += 1
                        }
                        s_len := buf_len(pool) - s_off
                        if i < n and buf_get(src, i) == 34 { i += 1 }
                        snid := ast_alloc(nodes, nk_str(), sp)
                        ast_set(nodes, snid, 1, s_off)
                        ast_set(nodes, snid, 2, s_len)
                        cn2 := ast_alloc(nodes, nk_comptime_const(), sp)
                        ast_set(nodes, cn2, 1, m_off)
                        ast_set(nodes, cn2, 2, m_len)
                        ast_set(nodes, cn2, 3, 0)
                        ast_set(nodes, cn2, 4, snid)
                        ibuf_push(out_consts, cn2)
                    }
                }
            }
            // Skip rest of preprocessor line (handling `\` continuations)
            while i < n {
                if buf_get(src, i) == 92 and i + 1 < n and buf_get(src, i + 1) == 10 {
                    line += 1
                    i += 2
                } else if buf_get(src, i) == 92 and i + 2 < n and buf_get(src, i + 1) == 13 and buf_get(src, i + 2) == 10 {
                    line += 1
                    i += 3
                } else if buf_get(src, i) == 10 {
                    break
                } else {
                    i += 1
                }
            }
        } else if c_is_alpha(b) {
            at_bol = false
            soff := buf_len(pool)
            while i < n and c_is_alnum(buf_get(src, i)) {
                buf_push(pool, buf_get(src, i))
                i += 1
            }
            slen := buf_len(pool) - soff
            ibuf_push(ctoks, 1)
            ibuf_push(ctoks, soff)
            ibuf_push(ctoks, slen)
            ibuf_push(ctoks, line)
        } else if c_is_digit(b) {
            at_bol = false
            mut v := 0
            if b == 48 and i + 1 < n and (buf_get(src, i + 1) == 120 or buf_get(src, i + 1) == 88) {
                i += 2
                while i < n {
                    hc := buf_get(src, i)
                    if hc >= 48 and hc <= 57 { v = (v << 4) | (hc - 48); i += 1 }
                    else if hc >= 65 and hc <= 70 { v = (v << 4) | (hc - 55); i += 1 }
                    else if hc >= 97 and hc <= 102 { v = (v << 4) | (hc - 87); i += 1 }
                    else { break }
                }
            } else {
                while i < n and c_is_digit(buf_get(src, i)) {
                    v = v *% 10 +% (buf_get(src, i) - 48)
                    i += 1
                }
            }
            while i < n and c_is_alpha(buf_get(src, i)) { i += 1 }
            ibuf_push(ctoks, 2)
            ibuf_push(ctoks, v)
            ibuf_push(ctoks, 0)
            ibuf_push(ctoks, line)
        } else if b == 34 {
            at_bol = false
            i += 1
            soff := buf_len(pool)
            while i < n and buf_get(src, i) != 34 {
                if buf_get(src, i) == 92 and i + 1 < n { i += 1 }
                if buf_get(src, i) == 10 { line += 1 }
                buf_push(pool, buf_get(src, i))
                i += 1
            }
            slen := buf_len(pool) - soff
            if i < n { i += 1 }
            ibuf_push(ctoks, 3)
            ibuf_push(ctoks, soff)
            ibuf_push(ctoks, slen)
            ibuf_push(ctoks, line)
        } else {
            at_bol = false
            ibuf_push(ctoks, 4)
            ibuf_push(ctoks, b)
            ibuf_push(ctoks, 0)
            ibuf_push(ctoks, line)
            i += 1
        }
    }
    ibuf_push(ctoks, 0)
    ibuf_push(ctoks, 0)
    ibuf_push(ctoks, 0)
    ibuf_push(ctoks, line)
}

fn ct_kind(ctoks: IntBuf, pos: i64) -> i64 { return ibuf_get(ctoks, pos * 4) }
fn ct_a(ctoks: IntBuf, pos: i64) -> i64    { return ibuf_get(ctoks, pos * 4 + 1) }
fn ct_b(ctoks: IntBuf, pos: i64) -> i64    { return ibuf_get(ctoks, pos * 4 + 2) }
fn ct_ln(ctoks: IntBuf, pos: i64) -> i64   { return ibuf_get(ctoks, pos * 4 + 3) }

fn c_is_ignored_qualifier(pool: ByteBuf, soff: i64, slen: i64) -> bool {
    if pool_str_eq_lit(pool, soff, slen, "extern") { return true }
    if pool_str_eq_lit(pool, soff, slen, "static") { return true }
    if pool_str_eq_lit(pool, soff, slen, "inline") { return true }
    if pool_str_eq_lit(pool, soff, slen, "__inline") { return true }
    if pool_str_eq_lit(pool, soff, slen, "volatile") { return true }
    if pool_str_eq_lit(pool, soff, slen, "restrict") { return true }
    if pool_str_eq_lit(pool, soff, slen, "WINAPI") { return true }
    if pool_str_eq_lit(pool, soff, slen, "APIENTRY") { return true }
    if pool_str_eq_lit(pool, soff, slen, "CALLBACK") { return true }
    if pool_str_eq_lit(pool, soff, slen, "__stdcall") { return true }
    if pool_str_eq_lit(pool, soff, slen, "__cdecl") { return true }
    if pool_str_eq_lit(pool, soff, slen, "__fastcall") { return true }
    if pool_str_eq_lit(pool, soff, slen, "VKAPI_ATTR") { return true }
    if pool_str_eq_lit(pool, soff, slen, "VKAPI_CALL") { return true }
    if pool_str_eq_lit(pool, soff, slen, "SQLITE_API") { return true }
    if pool_str_eq_lit(pool, soff, slen, "SDLCALL") { return true }
    if pool_str_eq_lit(pool, soff, slen, "SDL_DECLSPEC") { return true }
    return false
}

fn make_ax_named_ty(pool: ByteBuf, nodes: IntBuf, lit: str, sp: i64) -> i64 {
    soff := pool_intern_str(pool, lit)
    slen := str_len(lit)
    tn := ast_alloc(nodes, nk_ty_named(), sp)
    ast_set(nodes, tn, 1, soff)
    ast_set(nodes, tn, 2, slen)
    return tn
}

// Map parsed C base type + pointer depth to an Axon AST TypeSpec node.
// `in_param`: if true, `const char*` / `char*` / `LPCSTR` maps to `str` so Axon strings pass zero-ceremony!
fn map_c_type_to_axon(pool: ByteBuf, nodes: IntBuf, base_soff: i64, base_slen: i64, ptr_depth: i64, is_const: bool, in_param: bool, sp: i64) -> i64 {
    if in_param {
        if (ptr_depth == 1 and pool_str_eq_lit(pool, base_soff, base_slen, "char") and is_const) or pool_str_eq_lit(pool, base_soff, base_slen, "LPCSTR") {
            return make_ax_named_ty(pool, nodes, "str", sp)
        }
    }
    if ptr_depth > 0 {
        return make_ax_named_ty(pool, nodes, "u64", sp)
    }
    if pool_str_eq_lit(pool, base_soff, base_slen, "void") {
        return ast_alloc(nodes, nk_ty_unit(), sp)
    }
    if pool_str_eq_lit(pool, base_soff, base_slen, "double") or pool_str_eq_lit(pool, base_soff, base_slen, "float") {
        return make_ax_named_ty(pool, nodes, "f64", sp)
    }
    if pool_str_eq_lit(pool, base_soff, base_slen, "bool") or pool_str_eq_lit(pool, base_soff, base_slen, "_Bool") {
        return make_ax_named_ty(pool, nodes, "bool", sp)
    }
    if pool_str_eq_lit(pool, base_soff, base_slen, "int") or pool_str_eq_lit(pool, base_soff, base_slen, "long") or pool_str_eq_lit(pool, base_soff, base_slen, "short") or pool_str_eq_lit(pool, base_soff, base_slen, "char") or pool_str_eq_lit(pool, base_soff, base_slen, "unsigned") or pool_str_eq_lit(pool, base_soff, base_slen, "signed") {
        return make_ax_named_ty(pool, nodes, "i64", sp)
    }
    if pool_str_eq_lit(pool, base_soff, base_slen, "size_t") or pool_str_eq_lit(pool, base_soff, base_slen, "ssize_t") or pool_str_eq_lit(pool, base_soff, base_slen, "intptr_t") or pool_str_eq_lit(pool, base_soff, base_slen, "uintptr_t") or pool_str_eq_lit(pool, base_soff, base_slen, "ptrdiff_t") {
        return make_ax_named_ty(pool, nodes, "i64", sp)
    }
    if pool_str_eq_lit(pool, base_soff, base_slen, "int8_t") or pool_str_eq_lit(pool, base_soff, base_slen, "uint8_t") or pool_str_eq_lit(pool, base_soff, base_slen, "int16_t") or pool_str_eq_lit(pool, base_soff, base_slen, "uint16_t") or pool_str_eq_lit(pool, base_soff, base_slen, "int32_t") or pool_str_eq_lit(pool, base_soff, base_slen, "uint32_t") or pool_str_eq_lit(pool, base_soff, base_slen, "int64_t") or pool_str_eq_lit(pool, base_soff, base_slen, "uint64_t") {
        return make_ax_named_ty(pool, nodes, "i64", sp)
    }
    if pool_str_eq_lit(pool, base_soff, base_slen, "DWORD") or pool_str_eq_lit(pool, base_soff, base_slen, "UINT") or pool_str_eq_lit(pool, base_soff, base_slen, "BOOL") or pool_str_eq_lit(pool, base_soff, base_slen, "LONG") or pool_str_eq_lit(pool, base_soff, base_slen, "WORD") or pool_str_eq_lit(pool, base_soff, base_slen, "BYTE") or pool_str_eq_lit(pool, base_soff, base_slen, "HRESULT") or pool_str_eq_lit(pool, base_soff, base_slen, "HANDLE") or pool_str_eq_lit(pool, base_soff, base_slen, "HWND") or pool_str_eq_lit(pool, base_soff, base_slen, "HDC") or pool_str_eq_lit(pool, base_soff, base_slen, "HMODULE") or pool_str_eq_lit(pool, base_soff, base_slen, "LPVOID") or pool_str_eq_lit(pool, base_soff, base_slen, "LPSTR") or pool_str_eq_lit(pool, base_soff, base_slen, "LPCSTR") or pool_str_eq_lit(pool, base_soff, base_slen, "WPARAM") or pool_str_eq_lit(pool, base_soff, base_slen, "LPARAM") or pool_str_eq_lit(pool, base_soff, base_slen, "LRESULT") {
        return make_ax_named_ty(pool, nodes, "i64", sp)
    }
    // User C struct type name!
    tn := ast_alloc(nodes, nk_ty_named(), sp)
    ast_set(nodes, tn, 1, base_soff)
    ast_set(nodes, tn, 2, base_slen)
    return tn
}

fn c_skip_To_semi_or_brace(ctoks: IntBuf, start_pos: i64) -> i64 {
    mut p := start_pos
    mut depth := 0
    while ct_kind(ctoks, p) != 0 {
        if ct_kind(ctoks, p) == 4 {
            ch := ct_a(ctoks, p)
            if ch == 123 { depth += 1 }
            else if ch == 125 {
                if depth <= 1 { return p + 1 }
                depth -= 1
            } else if ch == 59 and depth == 0 {
                return p + 1
            }
        }
        p += 1
    }
    return p
}

fn c_parse_struct_fields(ctoks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf, brace_pos: i64, file_id: i64, out_end: IntBuf) -> i64 {
    // `brace_pos` points right after `{`. Appends `nk_field_decl` slice to `extra`, returns `(foff << 16) | fcnt`.
    mut p := brace_pos
    flist := ibuf_new(32)
    while ct_kind(ctoks, p) != 0 {
        if ct_kind(ctoks, p) == 4 and ct_a(ctoks, p) == 125 {
            p += 1
            break
        }
        mut is_const := false
        mut base_soff := 0
        mut base_slen := 0
        mut ptr_depth := 0
        sp := span_pack(ct_ln(ctoks, p), 1, file_id)

        // Parse C field type specifiers
        while ct_kind(ctoks, p) == 1 {
            s_off := ct_a(ctoks, p)
            s_len := ct_b(ctoks, p)
            // Look ahead: if next token is `;` or `[` or `,`, this ident is the field name!
            if base_slen > 0 and ct_kind(ctoks, p + 1) == 4 and (ct_a(ctoks, p + 1) == 59 or ct_a(ctoks, p + 1) == 91 or ct_a(ctoks, p + 1) == 44) {
                break
            }
            if pool_str_eq_lit(pool, s_off, s_len, "const") {
                is_const = true
            } else if pool_str_eq_lit(pool, s_off, s_len, "struct") or c_is_ignored_qualifier(pool, s_off, s_len) {
                // skip keyword
            } else if pool_str_eq_lit(pool, s_off, s_len, "unsigned") or pool_str_eq_lit(pool, s_off, s_len, "signed") {
                if base_slen == 0 {
                    base_soff = s_off
                    base_slen = s_len
                }
            } else {
                base_soff = s_off
                base_slen = s_len
            }
            p += 1
        }
        while ct_kind(ctoks, p) == 4 and ct_a(ctoks, p) == 42 {
            ptr_depth += 1
            p += 1
        }
        if ct_kind(ctoks, p) == 1 and base_slen > 0 {
            fn_soff := ct_a(ctoks, p)
            fn_slen := ct_b(ctoks, p)
            p += 1
            // Skip optional `[N]` array suffix (treat as pointer/i64 slot or skip)
            if ct_kind(ctoks, p) == 4 and ct_a(ctoks, p) == 91 {
                while ct_kind(ctoks, p) != 0 and not (ct_kind(ctoks, p) == 4 and ct_a(ctoks, p) == 93) {
                    p += 1
                }
                if ct_kind(ctoks, p) == 4 { p += 1 }
            }
            fty := map_c_type_to_axon(pool, nodes, base_soff, base_slen, ptr_depth, is_const, false, sp)
            fd := ast_alloc(nodes, nk_field_decl(), sp)
            ast_set(nodes, fd, 1, fn_soff)
            ast_set(nodes, fd, 2, fn_slen)
            ast_set(nodes, fd, 3, fty)
            ibuf_push(flist, fd)
        }
        while ct_kind(ctoks, p) != 0 and not (ct_kind(ctoks, p) == 4 and (ct_a(ctoks, p) == 59 or ct_a(ctoks, p) == 125)) {
            p += 1
        }
        if ct_kind(ctoks, p) == 4 and ct_a(ctoks, p) == 59 {
            p += 1
        }
    }
    ibuf_set(out_end, 0, p)
    foff := ibuf_len(extra)
    fcnt := ibuf_len(flist)
    mut i := 0
    while i < fcnt {
        ibuf_push(extra, ibuf_get(flist, i))
        i += 1
    }
    buf_free(move flist)
    return (foff << 16) | fcnt
}

// Parse C `.h` buffer and append extracted structs, `@extern` functions, and `#define` constants!
fn parse_c_header_into_program(src: ByteBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf, link_soff: i64, link_slen: i64, file_id: i64, out_structs: IntBuf, out_funcs: IntBuf, out_consts: IntBuf) {
    ctoks := ibuf_new(16384)
    c_lex_header_and_defines(src, pool, nodes, ctoks, out_consts, file_id)

    mut dll_soff := link_soff
    mut dll_slen := link_slen
    if dll_slen == 0 {
        dll_soff = pool_intern_str(pool, "msvcrt.dll")
        dll_slen = 10
    }

    out_end := ibuf_new(4)
    ibuf_push(out_end, 0)

    mut p := 0
    while ct_kind(ctoks, p) != 0 {
        sp := span_pack(ct_ln(ctoks, p), 1, file_id)

        // Case 1: `extern "C" { ... }` -> step past `{` or skip `}`
        if ct_kind(ctoks, p) == 4 and (ct_a(ctoks, p) == 125 or ct_a(ctoks, p) == 59) {
            p += 1
        } else if ct_kind(ctoks, p) == 1 and pool_str_eq_lit(pool, ct_a(ctoks, p), ct_b(ctoks, p), "extern") and ct_kind(ctoks, p + 1) == 3 {
            p += 2
            if ct_kind(ctoks, p) == 4 and ct_a(ctoks, p) == 123 {
                p += 1
            }
        } else if ct_kind(ctoks, p) == 1 and pool_str_eq_lit(pool, ct_a(ctoks, p), ct_b(ctoks, p), "typedef") {
            p += 1
            if ct_kind(ctoks, p) == 1 and pool_str_eq_lit(pool, ct_a(ctoks, p), ct_b(ctoks, p), "struct") {
                p += 1
                mut tag_soff := 0
                mut tag_slen := 0
                if ct_kind(ctoks, p) == 1 {
                    tag_soff = ct_a(ctoks, p)
                    tag_slen = ct_b(ctoks, p)
                    p += 1
                }
                if ct_kind(ctoks, p) == 4 and ct_a(ctoks, p) == 123 {
                    fpk := c_parse_struct_fields(ctoks, pool, nodes, extra, p + 1, file_id, out_end)
                    p = ibuf_get(out_end, 0)
                    mut alias_soff := tag_soff
                    mut alias_slen := tag_slen
                    if ct_kind(ctoks, p) == 1 {
                        alias_soff = ct_a(ctoks, p)
                        alias_slen = ct_b(ctoks, p)
                        p += 1
                    }
                    if ct_kind(ctoks, p) == 4 and ct_a(ctoks, p) == 59 { p += 1 }
                    if alias_slen > 0 {
                        sn := ast_alloc(nodes, nk_struct(), sp)
                        ast_set(nodes, sn, 1, alias_soff)
                        ast_set(nodes, sn, 2, alias_slen)
                        ast_set(nodes, sn, 3, fpk >> 16)
                        ast_set(nodes, sn, 4, fpk & 0xFFFF)
                        ibuf_push(out_structs, sn)
                    }
                } else {
                    p = c_skip_To_semi_or_brace(ctoks, p)
                }
            } else {
                p = c_skip_To_semi_or_brace(ctoks, p)
            }
        } else if ct_kind(ctoks, p) == 1 and pool_str_eq_lit(pool, ct_a(ctoks, p), ct_b(ctoks, p), "struct") and ct_kind(ctoks, p + 1) == 1 and ct_kind(ctoks, p + 2) == 4 and ct_a(ctoks, p + 2) == 123 {
            st_soff := ct_a(ctoks, p + 1)
            st_slen := ct_b(ctoks, p + 1)
            fpk2 := c_parse_struct_fields(ctoks, pool, nodes, extra, p + 3, file_id, out_end)
            p = ibuf_get(out_end, 0)
            if ct_kind(ctoks, p) == 4 and ct_a(ctoks, p) == 59 { p += 1 }
            sn2 := ast_alloc(nodes, nk_struct(), sp)
            ast_set(nodes, sn2, 1, st_soff)
            ast_set(nodes, sn2, 2, st_slen)
            ast_set(nodes, sn2, 3, fpk2 >> 16)
            ast_set(nodes, sn2, 4, fpk2 & 0xFFFF)
            ibuf_push(out_structs, sn2)
        } else {
            // Parse C function prototype: `[qualifiers] RetType [*] func_name ( params ) ;`
            mut ret_const := false
            mut ret_soff := 0
            mut ret_slen := 0
            mut ret_ptr := 0

            while ct_kind(ctoks, p) != 0 {
                if ct_kind(ctoks, p) == 1 and pool_str_eq_lit(pool, ct_a(ctoks, p), ct_b(ctoks, p), "__declspec") and ct_kind(ctoks, p + 1) == 4 and ct_a(ctoks, p + 1) == 40 {
                    p += 2
                    while ct_kind(ctoks, p) != 0 and not (ct_kind(ctoks, p) == 4 and ct_a(ctoks, p) == 41) { p += 1 }
                    if ct_kind(ctoks, p) == 4 { p += 1 }
                } else if ct_kind(ctoks, p) == 1 {
                    s_off := ct_a(ctoks, p)
                    s_len := ct_b(ctoks, p)
                    // If followed immediately by `(`, AND we already have a return type, this ident is `func_name`!
                    if ret_slen > 0 and ct_kind(ctoks, p + 1) == 4 and ct_a(ctoks, p + 1) == 40 {
                        break
                    }
                    if pool_str_eq_lit(pool, s_off, s_len, "const") {
                        ret_const = true
                    } else if pool_str_eq_lit(pool, s_off, s_len, "struct") or c_is_ignored_qualifier(pool, s_off, s_len) {
                        // ignore
                    } else if pool_str_eq_lit(pool, s_off, s_len, "unsigned") or pool_str_eq_lit(pool, s_off, s_len, "signed") {
                        if ret_slen == 0 { ret_soff = s_off; ret_slen = s_len }
                    } else {
                        ret_soff = s_off
                        ret_slen = s_len
                    }
                    p += 1
                } else if ct_kind(ctoks, p) == 4 and ct_a(ctoks, p) == 42 {
                    ret_ptr += 1
                    p += 1
                } else {
                    break
                }
            }

            if ret_slen > 0 and ct_kind(ctoks, p) == 1 and ct_kind(ctoks, p + 1) == 4 and ct_a(ctoks, p + 1) == 40 {
                fn_soff := ct_a(ctoks, p)
                fn_slen := ct_b(ctoks, p)
                p += 2 // skip `func_name` and `(`

                plist := ibuf_new(16)
                mut p_idx := 0
                while ct_kind(ctoks, p) != 0 and not (ct_kind(ctoks, p) == 4 and ct_a(ctoks, p) == 41) {
                    // Check `(void)`
                    if p_idx == 0 and ct_kind(ctoks, p) == 1 and pool_str_eq_lit(pool, ct_a(ctoks, p), ct_b(ctoks, p), "void") and ct_kind(ctoks, p + 1) == 4 and ct_a(ctoks, p + 1) == 41 {
                        p += 1
                        break
                    }
                    // Skip C variadic `...` if present
                    if ct_kind(ctoks, p) == 4 and ct_a(ctoks, p) == 46 {
                        while ct_kind(ctoks, p) == 4 and ct_a(ctoks, p) == 46 { p += 1 }
                        break
                    }
                    mut p_const := false
                    mut p_tsoff := 0
                    mut p_tslen := 0
                    mut p_ptr := 0
                    mut p_nsoff := 0
                    mut p_nslen := 0
                    while ct_kind(ctoks, p) != 0 {
                        if ct_kind(ctoks, p) == 4 and (ct_a(ctoks, p) == 44 or ct_a(ctoks, p) == 41) {
                            break
                        }
                        if ct_kind(ctoks, p) == 4 and ct_a(ctoks, p) == 42 {
                            p_ptr += 1
                            p += 1
                        } else if ct_kind(ctoks, p) == 4 and ct_a(ctoks, p) == 91 {
                            p_ptr += 1
                            while ct_kind(ctoks, p) != 0 and not (ct_kind(ctoks, p) == 4 and ct_a(ctoks, p) == 93) { p += 1 }
                            if ct_kind(ctoks, p) == 4 { p += 1 }
                        } else if ct_kind(ctoks, p) == 1 {
                            w_off := ct_a(ctoks, p)
                            w_len := ct_b(ctoks, p)
                            // If we already have `p_tslen > 0` and next token is `,` or `)` or `[`, this ident is parameter name!
                            if p_tslen > 0 and ct_kind(ctoks, p + 1) == 4 and (ct_a(ctoks, p + 1) == 44 or ct_a(ctoks, p + 1) == 41 or ct_a(ctoks, p + 1) == 91) {
                                p_nsoff = w_off
                                p_nslen = w_len
                            } else if pool_str_eq_lit(pool, w_off, w_len, "const") {
                                p_const = true
                            } else if pool_str_eq_lit(pool, w_off, w_len, "struct") or c_is_ignored_qualifier(pool, w_off, w_len) {
                                // ignore
                            } else if pool_str_eq_lit(pool, w_off, w_len, "unsigned") or pool_str_eq_lit(pool, w_off, w_len, "signed") {
                                if p_tslen == 0 { p_tsoff = w_off; p_tslen = w_len }
                            } else {
                                p_tsoff = w_off
                                p_tslen = w_len
                            }
                            p += 1
                        } else {
                            p += 1
                        }
                    }
                    if p_tslen > 0 {
                        if p_nslen == 0 {
                            // Synthesize `arg0`, `arg1`, ... for unnamed C header parameters!
                            p_nsoff = buf_len(pool)
                            buf_push_str(pool, "arg")
                            buf_push(pool, 48 + (p_idx % 10))
                            p_nslen = 4
                        }
                        pty := map_c_type_to_axon(pool, nodes, p_tsoff, p_tslen, p_ptr, p_const, true, sp)
                        pn := ast_alloc(nodes, nk_param(), sp)
                        ast_set(nodes, pn, 1, p_nsoff)
                        ast_set(nodes, pn, 2, p_nslen)
                        ast_set(nodes, pn, 3, pmode_val())
                        ast_set(nodes, pn, 4, pty)
                        ast_set(nodes, pn, 5, 0)
                        ibuf_push(plist, pn)
                        p_idx += 1
                    }
                    if ct_kind(ctoks, p) == 4 and ct_a(ctoks, p) == 44 {
                        p += 1
                    }
                }
                if ct_kind(ctoks, p) == 4 and ct_a(ctoks, p) == 41 { p += 1 }
                // Skip inline C function body `{ ... }` if header contains static inline functions, or eat `;`
                if ct_kind(ctoks, p) == 4 and ct_a(ctoks, p) == 123 {
                    p = c_skip_To_semi_or_brace(ctoks, p)
                    buf_free(move plist)
                } else {
                    if ct_kind(ctoks, p) == 4 and ct_a(ctoks, p) == 59 { p += 1 }
                    poff := ibuf_len(extra)
                    pcnt := ibuf_len(plist)
                    mut k := 0
                    while k < pcnt {
                        ibuf_push(extra, ibuf_get(plist, k))
                        k += 1
                    }
                    buf_free(move plist)

                    // Allocate 9-word `meta_off` storing `[dll_soff, dll_slen, 0..]`
                    moff := ibuf_len(extra)
                    ibuf_push(extra, dll_soff)
                    ibuf_push(extra, dll_slen)
                    mut zm := 2
                    while zm < 9 {
                        ibuf_push(extra, 0)
                        zm += 1
                    }

                    rty_nid := map_c_type_to_axon(pool, nodes, ret_soff, ret_slen, ret_ptr, ret_const, false, sp)
                    fnid := ast_alloc(nodes, nk_fn(), sp)
                    ast_set(nodes, fnid, 1, fn_soff)
                    ast_set(nodes, fnid, 2, fn_slen)
                    ast_set(nodes, fnid, 3, poff)
                    ast_set(nodes, fnid, 4, (pcnt & 0xFFFF) | (moff << 16))
                    ast_set(nodes, fnid, 5, rty_nid)
                    ast_set(nodes, fnid, 6, fnflag_extern() << 32)
                    ibuf_push(out_funcs, fnid)
                }
            } else {
                p = c_skip_To_semi_or_brace(ctoks, p)
            }
        }
    }

    buf_free(move out_end)
    buf_free(move ctoks)
}
