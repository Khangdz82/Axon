// Axon v7.0 Self-Hosted Compiler - Recursive-Descent & Pratt Precedence Parser (`compiler_ax/parser.ax`)
// 100% Pure Axon. Uses 4-register ABI `(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf)`
// with a zero-allocation LIFO scratch stack in `extra[1..8191]` for contiguous child slices.

use compiler_ax::tokens_ast

// --- Parser State & Scratch Stack Helpers ---
// `nodes` header (`0..15`):
//   [0] = cur_tok, [1] = total_toks, [2] = err_count, [3] = err_span,
//   [4] = pending_attr_flags, [5] = impl_soff (-1 if none), [6] = impl_slen, [7] = prog_nid,
//   [8] = funcs_off, [9] = funcs_cnt, [10] = cimports_off, [11] = cimports_cnt,
//   [12] = comptime_off, [13] = comptime_cnt, [14] = pending_fn_meta_off, [15] = cur_file_id
fn parser_init(toks: IntBuf, nodes: IntBuf, extra: IntBuf) {
    if ibuf_len(nodes) == 0 {
        ast_init(nodes)
    }
    ibuf_set(nodes, 0, 0)
    ibuf_set(nodes, 1, tok_count(toks))
    ibuf_set(nodes, 2, 0)
    ibuf_set(nodes, 3, 0)
    ibuf_set(nodes, 4, 0)
    ibuf_set(nodes, 5, -1)
    ibuf_set(nodes, 6, 0)
    ibuf_set(nodes, 10, 0)
    ibuf_set(nodes, 11, 0)
    ibuf_set(nodes, 12, 0)
    ibuf_set(nodes, 13, 0)
    ibuf_set(nodes, 14, 0)

    // Initialize `extra[0..8191]` LIFO scratch stack (`extra[0]` = sp starting at 1, `extra[8191]` = recursion depth)
    if ibuf_len(extra) == 0 {
        ibuf_push(extra, 1)
        mut i := 1
        while i < 8192 {
            ibuf_push(extra, 0)
            i += 1
        }
    } else {
        ibuf_set(extra, 0, 1)
        ibuf_set(extra, 8191, 0)
    }
}

fn p_pos(nodes: IntBuf) -> i64 {
    return ibuf_get(nodes, 0)
}

fn p_peek(toks: IntBuf, nodes: IntBuf) -> i64 {
    pos := ibuf_get(nodes, 0)
    tot := ibuf_get(nodes, 1)
    if pos >= tot {
        return tk_eof()
    }
    return tok_kind(toks, pos)
}

fn p_peek_at(toks: IntBuf, nodes: IntBuf, delta: i64) -> i64 {
    pos := ibuf_get(nodes, 0) + delta
    tot := ibuf_get(nodes, 1)
    if pos >= tot {
        return tk_eof()
    }
    return tok_kind(toks, pos)
}

fn p_span(toks: IntBuf, nodes: IntBuf) -> i64 {
    pos := ibuf_get(nodes, 0)
    tot := ibuf_get(nodes, 1)
    if pos >= tot {
        if tot > 0 {
            return tok_span(toks, tot - 1)
        }
        return 1
    }
    return tok_span(toks, pos)
}

fn p_line(toks: IntBuf, nodes: IntBuf) -> i64 {
    return span_line(p_span(toks, nodes))
}

fn p_advance(nodes: IntBuf) -> i64 {
    pos := ibuf_get(nodes, 0)
    tot := ibuf_get(nodes, 1)
    if pos < tot {
        ibuf_set(nodes, 0, pos + 1)
    }
    return pos
}

fn p_eat(toks: IntBuf, nodes: IntBuf, kind: i64) -> bool {
    if p_peek(toks, nodes) == kind {
        p_advance(nodes)
        return true
    }
    return false
}

fn p_err(toks: IntBuf, nodes: IntBuf) {
    cnt := ibuf_get(nodes, 2)
    if cnt == 0 {
        ibuf_set(nodes, 3, p_span(toks, nodes))
    }
    ibuf_set(nodes, 2, cnt + 1)
}

fn p_expect(toks: IntBuf, nodes: IntBuf, kind: i64) -> i64 {
    if p_peek(toks, nodes) == kind {
        return p_advance(nodes)
    }
    p_err(toks, nodes)
    return p_advance(nodes)
}

fn p_skip_semis(toks: IntBuf, nodes: IntBuf) {
    while p_peek(toks, nodes) == tk_semi() {
        p_advance(nodes)
    }
}

// LIFO scratch helpers in `extra[1..8191]`
fn scratch_mark(extra: IntBuf) -> i64 {
    return ibuf_get(extra, 0)
}

fn scratch_push(extra: IntBuf, val: i64) {
    sp := ibuf_get(extra, 0)
    if sp >= 8190 {
        return
    }
    ibuf_set(extra, sp, val)
    ibuf_set(extra, 0, sp + 1)
}

fn p_depth_enter(toks: IntBuf, nodes: IntBuf, extra: IntBuf) -> bool {
    d := ibuf_get(extra, 8191)
    if d >= 256 {
        p_err(toks, nodes)
        while p_peek(toks, nodes) != tk_semi() and p_peek(toks, nodes) != tk_rbrace() and p_peek(toks, nodes) != tk_eof() {
            p_advance(nodes)
        }
        return false
    }
    ibuf_set(extra, 8191, d + 1)
    return true
}

fn p_depth_leave(extra: IntBuf) {
    d := ibuf_get(extra, 8191)
    if d > 0 {
        ibuf_set(extra, 8191, d - 1)
    }
}

fn scratch_commit(extra: IntBuf, mark: i64) -> i64 {
    sp := ibuf_get(extra, 0)
    out_off := ibuf_len(extra)
    mut i := mark
    while i < sp {
        ibuf_push(extra, ibuf_get(extra, i))
        i += 1
    }
    ibuf_set(extra, 0, mark)
    return out_off
}

// Allocate or fetch 9-word pending function metadata block in `extra`:
// `[0]=dll_soff, [1]=dll_slen, [2]=tile_m, [3]=tile_n, [4]=tile_k, [5]=stages, [6]=workgroup, [7]=gen_off, [8]=gen_cnt`
fn ensure_pending_fn_meta(nodes: IntBuf, extra: IntBuf) -> i64 {
    cur := ibuf_get(nodes, 14)
    if cur > 0 {
        return cur
    }
    moff := ibuf_len(extra)
    mut i := 0
    while i < 9 {
        ibuf_push(extra, 0)
        i += 1
    }
    ibuf_set(nodes, 14, moff)
    return moff
}

fn is_ident_like(k: i64) -> bool {
    return k == tk_ident() or k == tk_table()
}

// --- TypeSpec Parsing ---
fn parse_tensor_dims_into_extra(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    // Parses `[B, S, 128]` -> returns `(dims_off << 16) | dims_cnt`, each dim = 2 words `[kind, val_or_soff]`
    // If `kind == 0`: `val` is concrete integer literal; if `kind > 0`: `kind = slen`, word2 = `soff` of sym/const ident.
    p_expect(toks, nodes, tk_lbrack())
    mark := scratch_mark(extra)
    mut dcnt := 0
    while p_peek(toks, nodes) != tk_rbrack() and p_peek(toks, nodes) != tk_eof() {
        if p_peek(toks, nodes) == tk_int() {
            it := p_advance(nodes)
            scratch_push(extra, 0)
            scratch_push(extra, tok_num(toks, it))
            dcnt += 1
        } else if p_peek(toks, nodes) == tk_ident() {
            st := p_advance(nodes)
            scratch_push(extra, tok_slen(toks, st))
            scratch_push(extra, tok_soff(toks, st))
            dcnt += 1
        } else {
            p_err(toks, nodes)
            p_advance(nodes)
            break
        }
        if not p_eat(toks, nodes, tk_comma()) {
            break
        }
    }
    p_expect(toks, nodes, tk_rbrack())
    off := scratch_commit(extra, mark)
    return (off << 16) | dcnt
}

fn parse_base_type(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    sp := p_span(toks, nodes)
    if p_eat(toks, nodes, tk_amp()) {
        p_eat(toks, nodes, tk_mut())
        inner := parse_base_type(toks, pool, nodes, extra)
        nid := ast_alloc(nodes, nk_ty_ref(), sp)
        ast_set(nodes, nid, 1, inner)
        return nid
    }
    if p_eat(toks, nodes, tk_lparen()) {
        if p_eat(toks, nodes, tk_rparen()) {
            return ast_alloc(nodes, nk_ty_unit(), sp)
        }
        mark := scratch_mark(extra)
        mut cnt := 0
        while true {
            et := parse_type(toks, pool, nodes, extra)
            scratch_push(extra, et)
            cnt += 1
            if not p_eat(toks, nodes, tk_comma()) {
                break
            }
            if p_peek(toks, nodes) == tk_rparen() {
                break
            }
        }
        p_expect(toks, nodes, tk_rparen())
        if cnt == 1 {
            only := ibuf_get(extra, mark)
            ibuf_set(extra, 0, mark)
            return only
        }
        off := scratch_commit(extra, mark)
        tn := ast_alloc(nodes, nk_ty_tuple(), sp)
        ast_set(nodes, tn, 1, off)
        ast_set(nodes, tn, 2, cnt)
        return tn
    }
    if p_eat(toks, nodes, tk_table()) {
        p_expect(toks, nodes, tk_lbrack())
        etok := p_advance(nodes)
        esoff := tok_soff(toks, etok)
        eslen := tok_slen(toks, etok)
        p_expect(toks, nodes, tk_rbrack())
        tn := ast_alloc(nodes, nk_ty_table(), sp)
        ast_set(nodes, tn, 1, esoff)
        ast_set(nodes, tn, 2, eslen)
        return tn
    }
    if is_ident_like(p_peek(toks, nodes)) {
        ntok := p_advance(nodes)
        nsoff := tok_soff(toks, ntok)
        nslen := tok_slen(toks, ntok)
        if p_eat(toks, nodes, tk_lbrack()) {
            // 1. `tainted[T]` security taint wrapper
            if pool_str_eq_lit(pool, nsoff, nslen, "tainted") {
                inner_t := parse_type(toks, pool, nodes, extra)
                p_expect(toks, nodes, tk_rbrack())
                ttn := ast_alloc(nodes, nk_ty_tainted(), sp)
                ast_set(nodes, ttn, 1, inner_t)
                return ttn
            }
            // 2. `Tensor[DType, [B, S, D]]` or `ShardedTensor[DType, [D, H], tp = 8]`
            if pool_str_eq_lit(pool, nsoff, nslen, "Tensor") or pool_str_eq_lit(pool, nsoff, nslen, "ShardedTensor") {
                dt := p_expect(toks, nodes, tk_ident())
                dt_soff := tok_soff(toks, dt)
                dt_slen := tok_slen(toks, dt)
                mut d_off := 0
                mut d_cnt := 0
                mut tp_deg := 0
                if p_eat(toks, nodes, tk_comma()) {
                    if p_peek(toks, nodes) == tk_lbrack() {
                        dp := parse_tensor_dims_into_extra(toks, pool, nodes, extra)
                        d_off = dp >> 16
                        d_cnt = dp & 0xFFFF
                    }
                    if p_eat(toks, nodes, tk_comma()) {
                        if p_peek(toks, nodes) == tk_ident() and p_peek_at(toks, nodes, 1) == tk_eq() {
                            p_advance(nodes)
                            p_advance(nodes)
                        }
                        if p_peek(toks, nodes) == tk_int() {
                            tp_deg = tok_num(toks, p_advance(nodes))
                        }
                    }
                }
                p_expect(toks, nodes, tk_rbrack())
                tsn := ast_alloc(nodes, nk_ty_tensor(), sp)
                ast_set(nodes, tsn, 1, dt_soff)
                ast_set(nodes, tsn, 2, dt_slen)
                ast_set(nodes, tsn, 3, d_off)
                ast_set(nodes, tsn, 4, d_cnt)
                ast_set(nodes, tsn, 5, tp_deg)
                return tsn
            }
            // 3. Generic wrappers (`Finite[f32]`, `RingBuf[Order]`, etc.)
            mut g_inner := parse_type(toks, pool, nodes, extra)
            while p_eat(toks, nodes, tk_comma()) {
                g_inner = parse_type(toks, pool, nodes, extra)
            }
            p_expect(toks, nodes, tk_rbrack())
            if pool_str_eq_lit(pool, nsoff, nslen, "Finite") {
                return g_inner
            }
        }
        tn := ast_alloc(nodes, nk_ty_named(), sp)
        ast_set(nodes, tn, 1, nsoff)
        ast_set(nodes, tn, 2, nslen)
        return tn
    }
    p_err(toks, nodes)
    p_advance(nodes)
    return ast_alloc(nodes, nk_ty_unit(), sp)
}

fn parse_type_body(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    sp := p_span(toks, nodes)
    base := parse_base_type(toks, pool, nodes, extra)
    if p_eat(toks, nodes, tk_bang()) {
        err_t := parse_base_type(toks, pool, nodes, extra)
        rn := ast_alloc(nodes, nk_ty_result(), sp)
        ast_set(nodes, rn, 1, base)
        ast_set(nodes, rn, 2, err_t)
        return rn
    }
    if p_eat(toks, nodes, tk_where()) {
        pred := parse_expr(toks, pool, nodes, extra)
        wn := ast_alloc(nodes, nk_ty_refined(), sp)
        ast_set(nodes, wn, 1, base)
        ast_set(nodes, wn, 2, pred)
        return wn
    }
    return base
}

fn parse_type(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    if not p_depth_enter(toks, nodes, extra) {
        return 0
    }
    r := parse_type_body(toks, pool, nodes, extra)
    p_depth_leave(extra)
    return r
}

// --- Expression Parsing (Pratt Precedence + Postfix + Pipeline `|>`) ---
fn parse_call_args_into_extra(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    // Returns `(args_off << 16) | args_cnt`
    mark := scratch_mark(extra)
    mut cnt := 0
    while p_peek(toks, nodes) != tk_rparen() and p_peek(toks, nodes) != tk_eof() and ibuf_get(nodes, 2) < 8 {
        sp := p_span(toks, nodes)
        mut mode := pmode_val()
        if p_eat(toks, nodes, tk_mut()) {
            mode = pmode_mut()
        } else if p_eat(toks, nodes, tk_move()) {
            mode = pmode_move()
        } else if p_eat(toks, nodes, tk_amp()) {
            if p_eat(toks, nodes, tk_mut()) {
                mode = pmode_mut()
            }
        }

        // Named argument check: `ident = expr` (and NOT `ident == expr`)
        mut nsoff := -1
        mut nslen := 0
        if p_peek(toks, nodes) == tk_ident() and p_peek_at(toks, nodes, 1) == tk_eq() {
            ntok := p_advance(nodes)
            nsoff = tok_soff(toks, ntok)
            nslen = tok_slen(toks, ntok)
            p_advance(nodes) // consume '='
        }

        val_e := parse_expr(toks, pool, nodes, extra)
        an := ast_alloc(nodes, nk_call_arg(), sp)
        ast_set(nodes, an, 1, mode)
        ast_set(nodes, an, 2, nsoff)
        ast_set(nodes, an, 3, nslen)
        ast_set(nodes, an, 4, val_e)
        scratch_push(extra, an)
        cnt += 1

        if not p_eat(toks, nodes, tk_comma()) {
            break
        }
    }
    p_expect(toks, nodes, tk_rparen())
    off := scratch_commit(extra, mark)
    return (off << 16) | cnt
}

fn parse_primary(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    k := p_peek(toks, nodes)
    sp := p_span(toks, nodes)

    if k == tk_int() {
        t := p_advance(nodes)
        nid := ast_alloc(nodes, nk_int(), sp)
        ast_set(nodes, nid, 1, tok_num(toks, t))
        return nid
    }
    if k == tk_float() {
        t := p_advance(nodes)
        nid := ast_alloc(nodes, nk_float(), sp)
        ast_set(nodes, nid, 1, tok_num(toks, t))
        return nid
    }
    if k == tk_dec() {
        t := p_advance(nodes)
        nid := ast_alloc(nodes, nk_dec(), sp)
        ast_set(nodes, nid, 1, tok_num(toks, t))
        return nid
    }
    if k == tk_true() {
        p_advance(nodes)
        nid := ast_alloc(nodes, nk_bool(), sp)
        ast_set(nodes, nid, 1, 1)
        return nid
    }
    if k == tk_false() {
        p_advance(nodes)
        nid := ast_alloc(nodes, nk_bool(), sp)
        ast_set(nodes, nid, 1, 0)
        return nid
    }
    if k == tk_str() {
        t := p_advance(nodes)
        nid := ast_alloc(nodes, nk_str(), sp)
        ast_set(nodes, nid, 1, tok_soff(toks, t))
        ast_set(nodes, nid, 2, tok_slen(toks, t))
        return nid
    }
    if k == tk_fstr_start() {
        p_advance(nodes)
        mark := scratch_mark(extra)
        mut cnt := 0
        while p_peek(toks, nodes) != tk_fstr_end() and p_peek(toks, nodes) != tk_eof() {
            if p_peek(toks, nodes) == tk_fstr_lit() {
                lt := p_advance(nodes)
                lnid := ast_alloc(nodes, nk_str(), tok_span(toks, lt))
                ast_set(nodes, lnid, 1, tok_soff(toks, lt))
                ast_set(nodes, lnid, 2, tok_slen(toks, lt))
                scratch_push(extra, lnid)
                cnt += 1
            } else {
                sub_e := parse_expr(toks, pool, nodes, extra)
                p_eat(toks, nodes, tk_fstr_expr_end())
                scratch_push(extra, sub_e)
                cnt += 1
            }
        }
        p_expect(toks, nodes, tk_fstr_end())
        off := scratch_commit(extra, mark)
        fnid := ast_alloc(nodes, nk_fstr(), sp)
        ast_set(nodes, fnid, 1, off)
        ast_set(nodes, fnid, 2, cnt)
        return fnid
    }
    if k == tk_attr() {
        // `@secret("...")` expression!
        at := p_advance(nodes)
        asoff := tok_soff(toks, at)
        aslen := tok_slen(toks, at)
        if pool_str_eq_lit(pool, asoff, aslen, "secret") {
            p_expect(toks, nodes, tk_lparen())
            st := p_expect(toks, nodes, tk_str())
            p_expect(toks, nodes, tk_rparen())
            snid := ast_alloc(nodes, nk_secret_str(), sp)
            ast_set(nodes, snid, 1, tok_soff(toks, st))
            ast_set(nodes, snid, 2, tok_slen(toks, st))
            return snid
        }
        if pool_str_eq_lit(pool, asoff, aslen, "reactive") {
            p_expect(toks, nodes, tk_lparen())
            sub_e := parse_expr(toks, pool, nodes, extra)
            p_expect(toks, nodes, tk_rparen())
            return sub_e
        }
        p_err(toks, nodes)
        zn := ast_alloc(nodes, nk_int(), sp)
        ast_set(nodes, zn, 1, 0)
        return zn
    }
    if k == tk_comptime() {
        p_advance(nodes)
        mut inner := 0
        if p_peek(toks, nodes) == tk_lbrace() {
            inner = parse_block_with_tail(toks, pool, nodes, extra)
        } else {
            inner = parse_expr(toks, pool, nodes, extra)
        }
        cen := ast_alloc(nodes, nk_comptime_expr(), sp)
        ast_set(nodes, cen, 1, inner)
        return cen
    }
    if k == tk_move() {
        p_advance(nodes)
        it := p_expect(toks, nodes, tk_ident())
        mnid := ast_alloc(nodes, nk_move_ident(), sp)
        ast_set(nodes, mnid, 1, tok_soff(toks, it))
        ast_set(nodes, mnid, 2, tok_slen(toks, it))
        return mnid
    }
    if k == tk_spawn() {
        p_advance(nodes)
        blk := parse_block(toks, pool, nodes, extra)
        sn := ast_alloc(nodes, nk_spawn(), sp)
        ast_set(nodes, sn, 1, blk)
        return sn
    }
    if k == tk_if() {
        p_advance(nodes)
        cond := parse_expr(toks, pool, nodes, extra)
        then_b := parse_block_with_tail(toks, pool, nodes, extra)
        mut else_b := 0
        if p_eat(toks, nodes, tk_else()) {
            else_b = parse_block_with_tail(toks, pool, nodes, extra)
        }
        inid := ast_alloc(nodes, nk_if_expr(), sp)
        ast_set(nodes, inid, 1, cond)
        ast_set(nodes, inid, 2, then_b)
        ast_set(nodes, inid, 3, else_b)
        return inid
    }
    if k == tk_table() {
        // `Table[Elem]::with_capacity(cap)`
        p_advance(nodes)
        p_expect(toks, nodes, tk_lbrack())
        et := p_advance(nodes)
        esoff := tok_soff(toks, et)
        eslen := tok_slen(toks, et)
        p_expect(toks, nodes, tk_rbrack())
        p_expect(toks, nodes, tk_coloncolon())
        p_advance(nodes) // `with_capacity`
        p_expect(toks, nodes, tk_lparen())
        cap_e := parse_expr(toks, pool, nodes, extra)
        p_expect(toks, nodes, tk_rparen())
        tnid := ast_alloc(nodes, nk_table_alloc(), sp)
        ast_set(nodes, tnid, 1, esoff)
        ast_set(nodes, tnid, 2, eslen)
        ast_set(nodes, tnid, 3, cap_e)
        return tnid
    }
    if k == tk_lparen() {
        if not p_depth_enter(toks, nodes, extra) {
            return 0
        }
        p_advance(nodes)
        if p_eat(toks, nodes, tk_rparen()) {
            p_depth_leave(extra)
            un := ast_alloc(nodes, nk_int(), sp)
            ast_set(nodes, un, 1, 0)
            return un
        }
        first := parse_expr(toks, pool, nodes, extra)
        if p_eat(toks, nodes, tk_comma()) {
            mark := scratch_mark(extra)
            scratch_push(extra, first)
            mut cnt := 1
            while p_peek(toks, nodes) != tk_rparen() and p_peek(toks, nodes) != tk_eof() {
                ne := parse_expr(toks, pool, nodes, extra)
                scratch_push(extra, ne)
                cnt += 1
                if not p_eat(toks, nodes, tk_comma()) {
                    break
                }
            }
            p_expect(toks, nodes, tk_rparen())
            off := scratch_commit(extra, mark)
            tp := ast_alloc(nodes, nk_tuple(), sp)
            ast_set(nodes, tp, 1, off)
            ast_set(nodes, tp, 2, cnt)
            p_depth_leave(extra)
            return tp
        }
        p_expect(toks, nodes, tk_rparen())
        p_depth_leave(extra)
        return first
    }
    if k == tk_ident() {
        it := p_advance(nodes)
        isoff := tok_soff(toks, it)
        islen := tok_slen(toks, it)
        // Optional `Type::assoc_fn(...)` -> mangled `Type__assoc_fn(...)`
        if p_eat(toks, nodes, tk_coloncolon()) {
            mt := p_expect(toks, nodes, tk_ident())
            msoff := tok_soff(toks, mt)
            mslen := tok_slen(toks, mt)
            m_off := buf_len(pool)
            mut ci := 0
            while ci < islen {
                buf_push(pool, buf_get(pool, isoff + ci))
                ci += 1
            }
            buf_push(pool, 95)
            buf_push(pool, 95)
            mut cj := 0
            while cj < mslen {
                buf_push(pool, buf_get(pool, msoff + cj))
                cj += 1
            }
            full_len := islen + 2 + mslen
            p_expect(toks, nodes, tk_lparen())
            packed_m := parse_call_args_into_extra(toks, pool, nodes, extra)
            mcn := ast_alloc(nodes, nk_call(), sp)
            ast_set(nodes, mcn, 1, m_off)
            ast_set(nodes, mcn, 2, full_len)
            ast_set(nodes, mcn, 3, packed_m >> 16)
            ast_set(nodes, mcn, 4, packed_m & 0xFFFF)
            return mcn
        }
        if p_eat(toks, nodes, tk_lparen()) {
            packed := parse_call_args_into_extra(toks, pool, nodes, extra)
            cn := ast_alloc(nodes, nk_call(), sp)
            ast_set(nodes, cn, 1, isoff)
            ast_set(nodes, cn, 2, islen)
            ast_set(nodes, cn, 3, packed >> 16)
            ast_set(nodes, cn, 4, packed & 0xFFFF)
            return cn
        }
        idn := ast_alloc(nodes, nk_ident(), sp)
        ast_set(nodes, idn, 1, isoff)
        ast_set(nodes, idn, 2, islen)
        return idn
    }

    p_err(toks, nodes)
    p_advance(nodes)
    zn := ast_alloc(nodes, nk_int(), sp)
    ast_set(nodes, zn, 1, 0)
    return zn
}

fn parse_postfix(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    mut base := parse_primary(toks, pool, nodes, extra)
    while true {
        k := p_peek(toks, nodes)
        sp := p_span(toks, nodes)
        if k == tk_dot() {
            p_advance(nodes)
            if p_peek(toks, nodes) == tk_int() {
                it := p_advance(nodes)
                tn := ast_alloc(nodes, nk_tuple_idx(), sp)
                ast_set(nodes, tn, 1, base)
                ast_set(nodes, tn, 2, tok_num(toks, it))
                base = tn
            } else if p_eat(toks, nodes, tk_await()) {
                awn := ast_alloc(nodes, nk_await(), sp)
                ast_set(nodes, awn, 1, base)
                base = awn
            } else {
                ft := p_expect(toks, nodes, tk_ident())
                fsoff := tok_soff(toks, ft)
                fslen := tok_slen(toks, ft)
                if p_eat(toks, nodes, tk_lparen()) {
                    packed := parse_call_args_into_extra(toks, pool, nodes, extra)
                    mn := ast_alloc(nodes, nk_method_call(), sp)
                    ast_set(nodes, mn, 1, base)
                    ast_set(nodes, mn, 2, fsoff)
                    ast_set(nodes, mn, 3, fslen)
                    ast_set(nodes, mn, 4, packed >> 16)
                    ast_set(nodes, mn, 5, packed & 0xFFFF)
                    base = mn
                } else {
                    fnid := ast_alloc(nodes, nk_field(), sp)
                    ast_set(nodes, fnid, 1, base)
                    ast_set(nodes, fnid, 2, fsoff)
                    ast_set(nodes, fnid, 3, fslen)
                    base = fnid
                }
            }
        } else if k == tk_lbrack() {
            p_advance(nodes)
            idx_e := parse_expr(toks, pool, nodes, extra)
            p_expect(toks, nodes, tk_rbrack())
            ixn := ast_alloc(nodes, nk_index(), sp)
            ast_set(nodes, ixn, 1, base)
            ast_set(nodes, ixn, 2, idx_e)
            base = ixn
        } else if k == tk_question() {
            p_advance(nodes)
            qn := ast_alloc(nodes, nk_or_return(), sp)
            ast_set(nodes, qn, 1, base)
            ast_set(nodes, qn, 2, 0)
            base = qn
        } else if k == tk_as() {
            p_advance(nodes)
            ct := parse_base_type(toks, pool, nodes, extra)
            cn := ast_alloc(nodes, nk_cast(), sp)
            ast_set(nodes, cn, 1, base)
            ast_set(nodes, cn, 2, ct)
            base = cn
        } else {
            break
        }
    }
    return base
}

fn parse_unary_body(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    k := p_peek(toks, nodes)
    sp := p_span(toks, nodes)
    if k == tk_await() {
        p_advance(nodes)
        inner := parse_unary(toks, pool, nodes, extra)
        awn := ast_alloc(nodes, nk_await(), sp)
        ast_set(nodes, awn, 1, inner)
        return awn
    }
    if k == tk_minus() {
        p_advance(nodes)
        inner := parse_unary(toks, pool, nodes, extra)
        un := ast_alloc(nodes, nk_unary(), sp)
        ast_set(nodes, un, 1, uop_neg())
        ast_set(nodes, un, 2, inner)
        return un
    }
    if k == tk_not() or k == tk_bang() {
        p_advance(nodes)
        inner := parse_unary(toks, pool, nodes, extra)
        un := ast_alloc(nodes, nk_unary(), sp)
        ast_set(nodes, un, 1, uop_not())
        ast_set(nodes, un, 2, inner)
        return un
    }
    if k == tk_amp() {
        p_advance(nodes)
        p_eat(toks, nodes, tk_mut())
        return parse_unary(toks, pool, nodes, extra)
    }
    return parse_postfix(toks, pool, nodes, extra)
}

fn parse_unary(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    return parse_unary_body(toks, pool, nodes, extra)
}

fn binop_prec_and_code(tk: i64) -> i64 {
    // Returns `(prec << 8) | op_code`, or `0` if not a binary operator
    if tk == tk_star()    { return (10 << 8) | op_mul() }
    if tk == tk_slash()   { return (10 << 8) | op_div() }
    if tk == tk_percent() { return (10 << 8) | op_mod() }
    if tk == tk_wrapmul() { return (10 << 8) | op_wrap_mul() }

    if tk == tk_plus()    { return (9 << 8) | op_add() }
    if tk == tk_minus()   { return (9 << 8) | op_sub() }
    if tk == tk_wrapadd() { return (9 << 8) | op_wrap_add() }
    if tk == tk_wrapsub() { return (9 << 8) | op_wrap_sub() }

    if tk == tk_shl()     { return (8 << 8) | op_shl() }
    if tk == tk_shr()     { return (8 << 8) | op_shr() }

    if tk == tk_amp()     { return (7 << 8) | op_bit_and() }
    if tk == tk_caret()   { return (6 << 8) | op_bit_xor() }
    if tk == tk_pipe()    { return (5 << 8) | op_bit_or() }

    if tk == tk_eqeq()    { return (4 << 8) | op_eq() }
    if tk == tk_noteq()   { return (4 << 8) | op_neq() }
    if tk == tk_lt()      { return (4 << 8) | op_lt() }
    if tk == tk_lteq()    { return (4 << 8) | op_lte() }
    if tk == tk_gt()      { return (4 << 8) | op_gt() }
    if tk == tk_gteq()    { return (4 << 8) | op_gte() }

    if tk == tk_and()     { return (3 << 8) | op_and() }
    if tk == tk_or()      { return (2 << 8) | op_or() }
    if tk == tk_pipegt()  { return (1 << 8) | 99 }
    return 0
}

fn can_start_expr(tk: i64) -> bool {
    if tk == tk_int() or tk == tk_float() or tk == tk_dec() { return true }
    if tk == tk_true() or tk == tk_false() or tk == tk_str() or tk == tk_fstr_start() { return true }
    if tk == tk_ident() or tk == tk_lparen() or tk == tk_minus() or tk == tk_not() { return true }
    if tk == tk_move() or tk == tk_spawn() or tk == tk_table() or tk == tk_attr() { return true }
    if tk == tk_await() or tk == tk_comptime() { return true }
    return false
}

fn parse_prec(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    return parse_prec_lvl(toks, pool, nodes, extra)
}

fn parse_mul_div(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    mut lhs := parse_unary(toks, pool, nodes, extra)
    while true {
        info := binop_prec_and_code(p_peek(toks, nodes))
        if (info >> 8) != 10 {
            break
        }
        sp := p_span(toks, nodes)
        p_advance(nodes)
        rhs := parse_unary(toks, pool, nodes, extra)
        bn := ast_alloc(nodes, nk_binary(), sp)
        ast_set(nodes, bn, 1, info & 255)
        ast_set(nodes, bn, 2, lhs)
        ast_set(nodes, bn, 3, rhs)
        lhs = bn
    }
    return lhs
}

fn parse_add_sub(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    mut lhs := parse_mul_div(toks, pool, nodes, extra)
    while true {
        info := binop_prec_and_code(p_peek(toks, nodes))
        if (info >> 8) != 9 {
            break
        }
        sp := p_span(toks, nodes)
        p_advance(nodes)
        rhs := parse_mul_div(toks, pool, nodes, extra)
        bn := ast_alloc(nodes, nk_binary(), sp)
        ast_set(nodes, bn, 1, info & 255)
        ast_set(nodes, bn, 2, lhs)
        ast_set(nodes, bn, 3, rhs)
        lhs = bn
    }
    return lhs
}

fn parse_shift(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    mut lhs := parse_add_sub(toks, pool, nodes, extra)
    while true {
        info := binop_prec_and_code(p_peek(toks, nodes))
        if (info >> 8) != 8 {
            break
        }
        sp := p_span(toks, nodes)
        p_advance(nodes)
        rhs := parse_add_sub(toks, pool, nodes, extra)
        bn := ast_alloc(nodes, nk_binary(), sp)
        ast_set(nodes, bn, 1, info & 255)
        ast_set(nodes, bn, 2, lhs)
        ast_set(nodes, bn, 3, rhs)
        lhs = bn
    }
    return lhs
}

fn parse_bitwise(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    mut lhs := parse_shift(toks, pool, nodes, extra)
    while true {
        info := binop_prec_and_code(p_peek(toks, nodes))
        pr := info >> 8
        if pr < 5 or pr > 7 {
            break
        }
        sp := p_span(toks, nodes)
        p_advance(nodes)
        rhs := parse_shift(toks, pool, nodes, extra)
        bn := ast_alloc(nodes, nk_binary(), sp)
        ast_set(nodes, bn, 1, info & 255)
        ast_set(nodes, bn, 2, lhs)
        ast_set(nodes, bn, 3, rhs)
        lhs = bn
    }
    return lhs
}

fn parse_cmp(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    mut lhs := parse_bitwise(toks, pool, nodes, extra)
    while true {
        info := binop_prec_and_code(p_peek(toks, nodes))
        if (info >> 8) != 4 {
            break
        }
        sp := p_span(toks, nodes)
        p_advance(nodes)
        rhs := parse_bitwise(toks, pool, nodes, extra)
        bn := ast_alloc(nodes, nk_binary(), sp)
        ast_set(nodes, bn, 1, info & 255)
        ast_set(nodes, bn, 2, lhs)
        ast_set(nodes, bn, 3, rhs)
        lhs = bn
    }
    return lhs
}

fn parse_and_lvl(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    mut lhs := parse_cmp(toks, pool, nodes, extra)
    while p_peek(toks, nodes) == tk_and() {
        sp := p_span(toks, nodes)
        p_advance(nodes)
        rhs := parse_cmp(toks, pool, nodes, extra)
        bn := ast_alloc(nodes, nk_binary(), sp)
        ast_set(nodes, bn, 1, op_and())
        ast_set(nodes, bn, 2, lhs)
        ast_set(nodes, bn, 3, rhs)
        lhs = bn
    }
    return lhs
}

fn parse_or_lvl(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    mut lhs := parse_and_lvl(toks, pool, nodes, extra)
    while p_peek(toks, nodes) == tk_or() {
        sp := p_span(toks, nodes)
        ln := span_line(sp)
        p_advance(nodes)
        // Check `or return [expr]`!
        if p_eat(toks, nodes, tk_return()) {
            mut rv := 0
            rk := p_peek(toks, nodes)
            if rk != tk_rbrace() and rk != tk_semi() and can_start_expr(rk) and tok_line(toks, p_pos(nodes)) == ln {
                rv = parse_expr(toks, pool, nodes, extra)
            }
            orn := ast_alloc(nodes, nk_or_return(), sp)
            ast_set(nodes, orn, 1, lhs)
            ast_set(nodes, orn, 2, rv)
            lhs = orn
        } else {
            rhs := parse_and_lvl(toks, pool, nodes, extra)
            bn := ast_alloc(nodes, nk_binary(), sp)
            ast_set(nodes, bn, 1, op_or())
            ast_set(nodes, bn, 2, lhs)
            ast_set(nodes, bn, 3, rhs)
            lhs = bn
        }
    }
    return lhs
}

fn parse_prec_lvl(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    // Pipeline `lhs |> fn_call(a, b)` desugars directly to `fn_call(lhs, a, b)`!
    mut lhs := parse_or_lvl(toks, pool, nodes, extra)
    while p_peek(toks, nodes) == tk_pipegt() {
        sp := p_span(toks, nodes)
        p_advance(nodes)
        rhs := parse_or_lvl(toks, pool, nodes, extra)
        if ast_kind(nodes, rhs) == nk_call() {
            c_soff := ast_get(nodes, rhs, 1)
            c_slen := ast_get(nodes, rhs, 2)
            old_off := ast_get(nodes, rhs, 3)
            old_cnt := ast_get(nodes, rhs, 4)

            first_arg := ast_alloc(nodes, nk_call_arg(), sp)
            ast_set(nodes, first_arg, 1, pmode_val())
            ast_set(nodes, first_arg, 2, -1)
            ast_set(nodes, first_arg, 3, 0)
            ast_set(nodes, first_arg, 4, lhs)

            new_off := ibuf_len(extra)
            ibuf_push(extra, first_arg)
            mut j := 0
            while j < old_cnt {
                ibuf_push(extra, ibuf_get(extra, old_off + j))
                j += 1
            }
            nc := ast_alloc(nodes, nk_call(), sp)
            ast_set(nodes, nc, 1, c_soff)
            ast_set(nodes, nc, 2, c_slen)
            ast_set(nodes, nc, 3, new_off)
            ast_set(nodes, nc, 4, old_cnt + 1)
            lhs = nc
        } else if ast_kind(nodes, rhs) == nk_ident() {
            c_soff := ast_get(nodes, rhs, 1)
            c_slen := ast_get(nodes, rhs, 2)
            first_arg := ast_alloc(nodes, nk_call_arg(), sp)
            ast_set(nodes, first_arg, 1, pmode_val())
            ast_set(nodes, first_arg, 2, -1)
            ast_set(nodes, first_arg, 3, 0)
            ast_set(nodes, first_arg, 4, lhs)
            new_off := ibuf_len(extra)
            ibuf_push(extra, first_arg)
            nc := ast_alloc(nodes, nk_call(), sp)
            ast_set(nodes, nc, 1, c_soff)
            ast_set(nodes, nc, 2, c_slen)
            ast_set(nodes, nc, 3, new_off)
            ast_set(nodes, nc, 4, 1)
            lhs = nc
        }
    }
    return lhs
}

fn parse_expr(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    return parse_prec(toks, pool, nodes, extra)
}

// --- Statements & Blocks ---
fn parse_stmt(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    return parse_stmt_body(toks, pool, nodes, extra)
}

fn parse_stmt_body(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    p_skip_semis(toks, nodes)
    k := p_peek(toks, nodes)
    sp := p_span(toks, nodes)
    ln := span_line(sp)

    // 0. `comptime { ... }` or `comptime NAME [: T] := expr` inside function
    if k == tk_comptime() {
        p_advance(nodes)
        if p_peek(toks, nodes) == tk_lbrace() {
            blk := parse_block(toks, pool, nodes, extra)
            cb := ast_alloc(nodes, nk_comptime_block(), sp)
            ast_set(nodes, cb, 1, blk)
            return cb
        }
        if p_peek(toks, nodes) == tk_ident() and (p_peek_at(toks, nodes, 1) == tk_coloneq() or p_peek_at(toks, nodes, 1) == tk_colon() or p_peek_at(toks, nodes, 1) == tk_eq()) {
            ct := p_advance(nodes)
            mut cty := 0
            if p_eat(toks, nodes, tk_colon()) {
                cty = parse_type(toks, pool, nodes, extra)
            }
            if not p_eat(toks, nodes, tk_coloneq()) {
                p_expect(toks, nodes, tk_eq())
            }
            ce := parse_expr(toks, pool, nodes, extra)
            p_skip_semis(toks, nodes)
            cc := ast_alloc(nodes, nk_comptime_const(), sp)
            ast_set(nodes, cc, 1, tok_soff(toks, ct))
            ast_set(nodes, cc, 2, tok_slen(toks, ct))
            ast_set(nodes, cc, 3, cty)
            ast_set(nodes, cc, 4, ce)
            return cc
        }
        ce2 := parse_expr(toks, pool, nodes, extra)
        p_skip_semis(toks, nodes)
        cen := ast_alloc(nodes, nk_comptime_expr(), sp)
        ast_set(nodes, cen, 1, ce2)
        esn0 := ast_alloc(nodes, nk_expr_stmt(), sp)
        ast_set(nodes, esn0, 1, cen)
        return esn0
    }

    // 0.5. `@reactive [mut] x [: T] := expr` or `@reactive let [mut] x := expr`
    if k == tk_attr() {
        at := p_advance(nodes)
        asoff := tok_soff(toks, at)
        aslen := tok_slen(toks, at)
        if pool_str_eq_lit(pool, asoff, aslen, "reactive") {
            mut is_mut := 0
            if p_eat(toks, nodes, tk_let()) {
                if p_eat(toks, nodes, tk_mut()) {
                    is_mut = 1
                }
            } else if p_eat(toks, nodes, tk_mut()) {
                is_mut = 1
            }
            vt := p_expect(toks, nodes, tk_ident())
            mut vty := 0
            if p_eat(toks, nodes, tk_colon()) {
                vty = parse_type(toks, pool, nodes, extra)
            }
            if not p_eat(toks, nodes, tk_coloneq()) {
                p_expect(toks, nodes, tk_eq())
            }
            init_e := parse_expr(toks, pool, nodes, extra)
            p_skip_semis(toks, nodes)
            vd := ast_alloc(nodes, nk_var_decl(), sp)
            ast_set(nodes, vd, 1, tok_soff(toks, vt))
            ast_set(nodes, vd, 2, tok_slen(toks, vt))
            ast_set(nodes, vd, 3, is_mut | 2)
            ast_set(nodes, vd, 4, vty)
            ast_set(nodes, vd, 5, init_e)
            return vd
        }
        // Rollback token position if not `@reactive`
        ibuf_set(nodes, 0, ibuf_get(nodes, 0) - 1)
    }

    // 1. `let [mut] x [: T] = expr` or `let (a, b) = expr`
    if k == tk_let() {
        p_advance(nodes)
        is_mut := p_eat(toks, nodes, tk_mut())
        if p_eat(toks, nodes, tk_lparen()) {
            mark := scratch_mark(extra)
            mut ncnt := 0
            while p_peek(toks, nodes) != tk_rparen() and p_peek(toks, nodes) != tk_eof() {
                nt := p_expect(toks, nodes, tk_ident())
                scratch_push(extra, tok_soff(toks, nt))
                scratch_push(extra, tok_slen(toks, nt))
                ncnt += 1
                if not p_eat(toks, nodes, tk_comma()) {
                    break
                }
            }
            p_expect(toks, nodes, tk_rparen())
            if not p_eat(toks, nodes, tk_eq()) {
                p_expect(toks, nodes, tk_coloneq())
            }
            init_e := parse_expr(toks, pool, nodes, extra)
            p_skip_semis(toks, nodes)
            noff := scratch_commit(extra, mark)
            td := ast_alloc(nodes, nk_tuple_destruct(), sp)
            ast_set(nodes, td, 1, noff)
            ast_set(nodes, td, 2, ncnt)
            ast_set(nodes, td, 3, init_e)
            return td
        }
        vt := p_expect(toks, nodes, tk_ident())
        mut vty := 0
        if p_eat(toks, nodes, tk_colon()) {
            vty = parse_type(toks, pool, nodes, extra)
        }
        if not p_eat(toks, nodes, tk_eq()) {
            p_expect(toks, nodes, tk_coloneq())
        }
        init_e := parse_expr(toks, pool, nodes, extra)
        p_skip_semis(toks, nodes)
        vd := ast_alloc(nodes, nk_var_decl(), sp)
        ast_set(nodes, vd, 1, tok_soff(toks, vt))
        ast_set(nodes, vd, 2, tok_slen(toks, vt))
        if is_mut { ast_set(nodes, vd, 3, 1) } else { ast_set(nodes, vd, 3, 0) }
        ast_set(nodes, vd, 4, vty)
        ast_set(nodes, vd, 5, init_e)
        return vd
    }

    // 2. `mut x [: T] := expr` or `mut x: T = expr`
    if k == tk_mut() {
        p_advance(nodes)
        vt := p_expect(toks, nodes, tk_ident())
        mut vty := 0
        if p_eat(toks, nodes, tk_colon()) {
            vty = parse_type(toks, pool, nodes, extra)
        }
        if not p_eat(toks, nodes, tk_coloneq()) {
            p_expect(toks, nodes, tk_eq())
        }
        init_e := parse_expr(toks, pool, nodes, extra)
        p_skip_semis(toks, nodes)
        vd := ast_alloc(nodes, nk_var_decl(), sp)
        ast_set(nodes, vd, 1, tok_soff(toks, vt))
        ast_set(nodes, vd, 2, tok_slen(toks, vt))
        ast_set(nodes, vd, 3, 1)
        ast_set(nodes, vd, 4, vty)
        ast_set(nodes, vd, 5, init_e)
        return vd
    }

    // 3. Python/Go short declaration `x := expr`
    if k == tk_ident() and p_peek_at(toks, nodes, 1) == tk_coloneq() {
        vt := p_advance(nodes)
        p_advance(nodes) // consume ':='
        init_e := parse_expr(toks, pool, nodes, extra)
        p_skip_semis(toks, nodes)
        vd := ast_alloc(nodes, nk_var_decl(), sp)
        ast_set(nodes, vd, 1, tok_soff(toks, vt))
        ast_set(nodes, vd, 2, tok_slen(toks, vt))
        ast_set(nodes, vd, 3, 0)
        ast_set(nodes, vd, 4, 0)
        ast_set(nodes, vd, 5, init_e)
        return vd
    }

    // 4. `return [expr]`
    if k == tk_return() {
        p_advance(nodes)
        mut rv := 0
        rk := p_peek(toks, nodes)
        if rk != tk_rbrace() and rk != tk_semi() and rk != tk_eof() and tok_line(toks, p_pos(nodes)) == ln {
            rv = parse_expr(toks, pool, nodes, extra)
        }
        p_skip_semis(toks, nodes)
        rn := ast_alloc(nodes, nk_return(), sp)
        ast_set(nodes, rn, 1, rv)
        return rn
    }

    // 5. `break` & `continue`
    if k == tk_break() {
        p_advance(nodes)
        p_skip_semis(toks, nodes)
        return ast_alloc(nodes, nk_break(), sp)
    }
    if k == tk_continue() {
        p_advance(nodes)
        p_skip_semis(toks, nodes)
        return ast_alloc(nodes, nk_continue(), sp)
    }

    // 6. `if cond { ... } [else if ... / else { ... }]`
    if k == tk_if() {
        p_advance(nodes)
        cond := parse_expr(toks, pool, nodes, extra)
        then_b := parse_block(toks, pool, nodes, extra)
        mut else_b := 0
        if p_eat(toks, nodes, tk_else()) {
            if p_peek(toks, nodes) == tk_if() {
                sub_if := parse_stmt(toks, pool, nodes, extra)
                eb := ast_alloc(nodes, nk_block(), sp)
                eoff := ibuf_len(extra)
                ibuf_push(extra, sub_if)
                ast_set(nodes, eb, 1, eoff)
                ast_set(nodes, eb, 2, 1)
                else_b = eb
            } else {
                else_b = parse_block(toks, pool, nodes, extra)
            }
        }
        inid := ast_alloc(nodes, nk_if(), sp)
        ast_set(nodes, inid, 1, cond)
        ast_set(nodes, inid, 2, then_b)
        ast_set(nodes, inid, 3, else_b)
        return inid
    }

    // 7. `while cond { ... }`
    if k == tk_while() {
        p_advance(nodes)
        cond := parse_expr(toks, pool, nodes, extra)
        body := parse_block(toks, pool, nodes, extra)
        wn := ast_alloc(nodes, nk_while(), sp)
        ast_set(nodes, wn, 1, cond)
        ast_set(nodes, wn, 2, body)
        return wn
    }

    // 8. `for` or `par_for` loop (`v in start..end { ... }` or `item in table { ... }`)
    if k == tk_for() or k == tk_par_for() {
        is_par := k == tk_par_for()
        p_advance(nodes)
        vt := p_expect(toks, nodes, tk_ident())
        vsoff := tok_soff(toks, vt)
        vslen := tok_slen(toks, vt)
        p_expect(toks, nodes, tk_in())
        first_e := parse_expr(toks, pool, nodes, extra)
        if p_eat(toks, nodes, tk_dotdot()) {
            end_e := parse_expr(toks, pool, nodes, extra)
            body := parse_block(toks, pool, nodes, extra)
            mut rkind := nk_for_range()
            if is_par { rkind = nk_par_for_range() }
            fr := ast_alloc(nodes, rkind, sp)
            ast_set(nodes, fr, 1, vsoff)
            ast_set(nodes, fr, 2, vslen)
            ast_set(nodes, fr, 3, first_e)
            ast_set(nodes, fr, 4, end_e)
            ast_set(nodes, fr, 5, body)
            return fr
        }
        body := parse_block(toks, pool, nodes, extra)
        mut ekind := nk_for_each()
        if is_par { ekind = nk_par_for_each() }
        fe := ast_alloc(nodes, ekind, sp)
        ast_set(nodes, fe, 1, vsoff)
        ast_set(nodes, fe, 2, vslen)
        ast_set(nodes, fe, 3, first_e)
        ast_set(nodes, fe, 4, body)
        return fe
    }

    // 9. Tuple destructuring `(a, b) := expr` or Expression / Assignment
    if k == tk_lparen() and p_peek_at(toks, nodes, 1) == tk_ident() and p_peek_at(toks, nodes, 2) == tk_comma() {
        p_advance(nodes)
        mark := scratch_mark(extra)
        mut ncnt := 0
        while p_peek(toks, nodes) != tk_rparen() and p_peek(toks, nodes) != tk_eof() {
            nt := p_expect(toks, nodes, tk_ident())
            scratch_push(extra, tok_soff(toks, nt))
            scratch_push(extra, tok_slen(toks, nt))
            ncnt += 1
            if not p_eat(toks, nodes, tk_comma()) {
                break
            }
        }
        p_expect(toks, nodes, tk_rparen())
        if not p_eat(toks, nodes, tk_coloneq()) {
            p_expect(toks, nodes, tk_eq())
        }
        init_e := parse_expr(toks, pool, nodes, extra)
        p_skip_semis(toks, nodes)
        noff := scratch_commit(extra, mark)
        td := ast_alloc(nodes, nk_tuple_destruct(), sp)
        ast_set(nodes, td, 1, noff)
        ast_set(nodes, td, 2, ncnt)
        ast_set(nodes, td, 3, init_e)
        return td
    }

    lhs := parse_expr(toks, pool, nodes, extra)
    ak := p_peek(toks, nodes)
    if ak == tk_eq() or ak == tk_pluseq() or ak == tk_minuseq() or ak == tk_stareq() or ak == tk_slasheq() {
        p_advance(nodes)
        mut aop := aop_eq()
        if ak == tk_pluseq()  { aop = aop_add() }
        if ak == tk_minuseq() { aop = aop_sub() }
        if ak == tk_stareq()  { aop = aop_mul() }
        if ak == tk_slasheq() { aop = aop_div() }
        rhs := parse_expr(toks, pool, nodes, extra)
        p_skip_semis(toks, nodes)
        asn := ast_alloc(nodes, nk_assign(), sp)
        ast_set(nodes, asn, 1, aop)
        ast_set(nodes, asn, 2, lhs)
        ast_set(nodes, asn, 3, rhs)
        return asn
    }
    p_skip_semis(toks, nodes)
    esn := ast_alloc(nodes, nk_expr_stmt(), sp)
    ast_set(nodes, esn, 1, lhs)
    return esn
}

fn parse_block(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    if not p_depth_enter(toks, nodes, extra) {
        return 0
    }
    sp := p_span(toks, nodes)
    p_expect(toks, nodes, tk_lbrace())
    mark := scratch_mark(extra)
    mut cnt := 0
    while p_peek(toks, nodes) != tk_rbrace() and p_peek(toks, nodes) != tk_eof() and ibuf_get(nodes, 2) < 8 {
        p_skip_semis(toks, nodes)
        if p_peek(toks, nodes) == tk_rbrace() {
            break
        }
        st := parse_stmt(toks, pool, nodes, extra)
        scratch_push(extra, st)
        cnt += 1
    }
    p_expect(toks, nodes, tk_rbrace())
    off := scratch_commit(extra, mark)
    bn := ast_alloc(nodes, nk_block(), sp)
    ast_set(nodes, bn, 1, off)
    ast_set(nodes, bn, 2, cnt)
    p_depth_leave(extra)
    return bn
}

fn parse_block_with_tail(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    bn := parse_block(toks, pool, nodes, extra)
    off := ast_get(nodes, bn, 1)
    cnt := ast_get(nodes, bn, 2)
    if cnt > 0 {
        last_s := ibuf_get(extra, off + cnt - 1)
        if ast_kind(nodes, last_s) == nk_expr_stmt() {
            tail_e := ast_get(nodes, last_s, 1)
            ast_set(nodes, bn, 2, cnt - 1)
            ast_set(nodes, bn, 3, tail_e)
        }
    }
    return bn
}

// --- Attribute Decorator Parser (`@shield`, `@no_alloc`, `@nan_guard`, `@gpu_kernel`, `@tile`, `@extern`, `@cImport`, ...) ---
// Returns `> 0` AST node ID if `@cImport(...)` produced a standalone top-level node, else `0`.
fn parse_decorator_attr(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    sp := p_span(toks, nodes)
    at := p_advance(nodes)
    asoff := tok_soff(toks, at)
    aslen := tok_slen(toks, at)

    // 1. `@cImport("hdr.h" [, link = "lib"])`
    if pool_str_eq_lit(pool, asoff, aslen, "cImport") {
        p_expect(toks, nodes, tk_lparen())
        ht := p_expect(toks, nodes, tk_str())
        mut lsoff := 0
        mut lslen := 0
        if p_eat(toks, nodes, tk_comma()) {
            if p_peek(toks, nodes) == tk_ident() and p_peek_at(toks, nodes, 1) == tk_eq() {
                p_advance(nodes)
                p_advance(nodes)
            }
            if p_peek(toks, nodes) == tk_str() {
                lt := p_advance(nodes)
                lsoff = tok_soff(toks, lt)
                lslen = tok_slen(toks, lt)
            }
        }
        p_expect(toks, nodes, tk_rparen())
        p_skip_semis(toks, nodes)
        cin := ast_alloc(nodes, nk_cimport(), sp)
        ast_set(nodes, cin, 1, tok_soff(toks, ht))
        ast_set(nodes, cin, 2, tok_slen(toks, ht))
        ast_set(nodes, cin, 3, lsoff)
        ast_set(nodes, cin, 4, lslen)
        return cin
    }

    mut fl := ibuf_get(nodes, 4)
    if pool_str_eq_lit(pool, asoff, aslen, "shield") {
        fl = fl | fnflag_shield()
    } else if pool_str_eq_lit(pool, asoff, aslen, "whitebox") {
        fl = fl | fnflag_whitebox()
    } else if pool_str_eq_lit(pool, asoff, aslen, "no_alloc") {
        fl = fl | fnflag_no_alloc()
    } else if pool_str_eq_lit(pool, asoff, aslen, "nan_guard") {
        fl = fl | fnflag_nan_guard()
    } else if pool_str_eq_lit(pool, asoff, aslen, "gpu") or pool_str_eq_lit(pool, asoff, aslen, "gpu_kernel") {
        fl = fl | fnflag_gpu()
    } else if pool_str_eq_lit(pool, asoff, aslen, "shader") {
        fl = fl | fnflag_shader()
    } else if pool_str_eq_lit(pool, asoff, aslen, "py_export") or pool_str_eq_lit(pool, asoff, aslen, "export") {
        fl = fl | fnflag_export()
    } else if pool_str_eq_lit(pool, asoff, aslen, "frame_arena") {
        fl = fl | fnflag_frame_arena()
    } else if pool_str_eq_lit(pool, asoff, aslen, "extern") {
        fl = fl | fnflag_extern()
    } else if pool_str_eq_lit(pool, asoff, aslen, "test") {
        fl = fl | fnflag_test()
    } else if pool_str_eq_lit(pool, asoff, aslen, "comptime") {
        fl = fl | fnflag_comptime()
    } else if pool_str_eq_lit(pool, asoff, aslen, "inline") {
        fl = fl | fnflag_inline()
    } else if pool_str_eq_lit(pool, asoff, aslen, "reactive") {
        fl = fl | fnflag_reactive()
    } else if not pool_str_eq_lit(pool, asoff, aslen, "tile") and not pool_str_eq_lit(pool, asoff, aslen, "pipeline_stages") {
        // Reject unknown or misspelled decorators (e.g. `@noalloc`) instead of silently ignoring them
        ecnt := ibuf_get(nodes, 2)
        if ecnt == 0 {
            ibuf_set(nodes, 3, sp)
        }
        ibuf_set(nodes, 2, ecnt + 1)
    }

    // Parse optional decorator arguments `(...)`
    if p_eat(toks, nodes, tk_lparen()) {
        moff := ensure_pending_fn_meta(nodes, extra)
        if pool_str_eq_lit(pool, asoff, aslen, "extern") {
            if p_peek(toks, nodes) == tk_str() {
                dt := p_advance(nodes)
                ibuf_set(extra, moff, tok_soff(toks, dt))
                ibuf_set(extra, moff + 1, tok_slen(toks, dt))
            }
            while p_peek(toks, nodes) != tk_rparen() and p_peek(toks, nodes) != tk_eof() {
                p_advance(nodes)
            }
            p_eat(toks, nodes, tk_rparen())
        } else if pool_str_eq_lit(pool, asoff, aslen, "tile") {
            mut idx := 0
            while p_peek(toks, nodes) != tk_rparen() and p_peek(toks, nodes) != tk_eof() {
                mut slot_idx := 2 + idx
                if p_peek(toks, nodes) == tk_ident() and p_peek_at(toks, nodes, 1) == tk_eq() {
                    kt := p_advance(nodes)
                    p_advance(nodes)
                    if pool_str_eq_lit(pool, tok_soff(toks, kt), tok_slen(toks, kt), "m") { slot_idx = 2 }
                    if pool_str_eq_lit(pool, tok_soff(toks, kt), tok_slen(toks, kt), "n") { slot_idx = 3 }
                    if pool_str_eq_lit(pool, tok_soff(toks, kt), tok_slen(toks, kt), "k") { slot_idx = 4 }
                }
                if p_peek(toks, nodes) == tk_int() {
                    tv := tok_num(toks, p_advance(nodes))
                    if slot_idx >= 2 and slot_idx <= 4 {
                        ibuf_set(extra, moff + slot_idx, tv)
                    }
                } else {
                    p_advance(nodes)
                }
                idx += 1
                p_eat(toks, nodes, tk_comma())
            }
            p_eat(toks, nodes, tk_rparen())
        } else if pool_str_eq_lit(pool, asoff, aslen, "pipeline_stages") {
            if p_peek(toks, nodes) == tk_int() {
                ibuf_set(extra, moff + 5, tok_num(toks, p_advance(nodes)))
            }
            while p_peek(toks, nodes) != tk_rparen() and p_peek(toks, nodes) != tk_eof() {
                p_advance(nodes)
            }
            p_eat(toks, nodes, tk_rparen())
        } else {
            mut d := 1
            while d > 0 and p_peek(toks, nodes) != tk_eof() {
                if p_peek(toks, nodes) == tk_int() and ibuf_get(extra, moff + 6) == 0 {
                    ibuf_set(extra, moff + 6, tok_num(toks, p_pos(nodes)))
                }
                if p_peek(toks, nodes) == tk_lparen() { d += 1 }
                if p_peek(toks, nodes) == tk_rparen() { d -= 1 }
                p_advance(nodes)
            }
        }
    }

    ibuf_set(nodes, 4, fl)
    return 0
}

// --- Top-Level Declarations (`use`, `struct`, `interface`, `impl`, `fn`, `comptime`) ---
fn parse_fn_decl(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    sp := p_span(toks, nodes)
    mut flags := ibuf_get(nodes, 4)
    ibuf_set(nodes, 4, 0)
    mut meta_off := ibuf_get(nodes, 14)
    ibuf_set(nodes, 14, 0)
    impl_soff := ibuf_get(nodes, 5)
    impl_slen := ibuf_get(nodes, 6)

    if p_eat(toks, nodes, tk_async()) {
        flags = flags | fnflag_async()
    }
    if p_eat(toks, nodes, tk_comptime()) {
        flags = flags | fnflag_comptime()
    }

    p_expect(toks, nodes, tk_fn())
    nt := p_expect(toks, nodes, tk_ident())
    mut fn_soff := tok_soff(toks, nt)
    mut fn_slen := tok_slen(toks, nt)

    if impl_soff >= 0 {
        // Mangle `ImplType__method` in `pool`!
        m_off := buf_len(pool)
        mut c := 0
        while c < impl_slen {
            buf_push(pool, buf_get(pool, impl_soff + c))
            c += 1
        }
        buf_push(pool, 95)
        buf_push(pool, 95)
        mut d := 0
        while d < fn_slen {
            buf_push(pool, buf_get(pool, fn_soff + d))
            d += 1
        }
        fn_soff = m_off
        fn_slen = impl_slen + 2 + fn_slen
    }

    // Optional symbolic / comptime / generic parameter list: `fn name[sym B, sym S, comptime D: usize](...)`
    if p_eat(toks, nodes, tk_lbrack()) {
        if meta_off == 0 {
            meta_off = ibuf_len(extra)
            mut zi := 0
            while zi < 9 {
                ibuf_push(extra, 0)
                zi += 1
            }
        }
        gmark := scratch_mark(extra)
        mut gcnt := 0
        while p_peek(toks, nodes) != tk_rbrack() and p_peek(toks, nodes) != tk_eof() {
            mut gkind := 0 // 0=type, 1=sym, 2=comptime
            if p_eat(toks, nodes, tk_comptime()) {
                gkind = 2
            } else if p_peek(toks, nodes) == tk_ident() and p_peek_at(toks, nodes, 1) == tk_ident() {
                kw_t := p_pos(nodes)
                if pool_str_eq_lit(pool, tok_soff(toks, kw_t), tok_slen(toks, kw_t), "sym") {
                    p_advance(nodes)
                    gkind = 1
                }
            }
            gt := p_expect(toks, nodes, tk_ident())
            gsoff := tok_soff(toks, gt)
            gslen := tok_slen(toks, gt)
            mut gdef := 0
            if p_eat(toks, nodes, tk_colon()) {
                parse_type(toks, pool, nodes, extra)
            }
            if p_eat(toks, nodes, tk_eq()) {
                if p_peek(toks, nodes) == tk_int() {
                    gdef = tok_num(toks, p_advance(nodes))
                } else {
                    parse_expr(toks, pool, nodes, extra)
                }
            }
            scratch_push(extra, gkind)
            scratch_push(extra, gsoff)
            scratch_push(extra, gslen)
            scratch_push(extra, gdef)
            gcnt += 1
            if not p_eat(toks, nodes, tk_comma()) {
                break
            }
        }
        p_expect(toks, nodes, tk_rbrack())
        goff := scratch_commit(extra, gmark)
        ibuf_set(extra, meta_off + 7, goff)
        ibuf_set(extra, meta_off + 8, gcnt)
    }

    p_expect(toks, nodes, tk_lparen())
    pmark := scratch_mark(extra)
    mut pcnt := 0
    while p_peek(toks, nodes) != tk_rparen() and p_peek(toks, nodes) != tk_eof() {
        psp := p_span(toks, nodes)
        mut pm := pmode_val()
        if p_eat(toks, nodes, tk_mut()) {
            pm = pmode_mut()
        } else if p_eat(toks, nodes, tk_let()) {
            pm = pmode_val()
        } else if p_eat(toks, nodes, tk_move()) {
            pm = pmode_move()
        } else if p_eat(toks, nodes, tk_isolated()) {
            pm = pmode_isolated()
        } else if p_eat(toks, nodes, tk_amp()) {
            if p_eat(toks, nodes, tk_mut()) {
                pm = pmode_mut()
            }
        } else if p_eat(toks, nodes, tk_comptime()) {
            pm = pmode_val()
        }

        pt := p_expect(toks, nodes, tk_ident())
        psoff := tok_soff(toks, pt)
        pslen := tok_slen(toks, pt)

        // Handle bare `self` inside `impl` or `interface`!
        if pool_str_eq_lit(pool, psoff, pslen, "self") and p_peek(toks, nodes) != tk_colon() {
            mut sty_nid := 0
            if impl_soff >= 0 {
                sty_nid = ast_alloc(nodes, nk_ty_named(), psp)
                ast_set(nodes, sty_nid, 1, impl_soff)
                ast_set(nodes, sty_nid, 2, impl_slen)
            } else {
                sty_nid = ast_alloc(nodes, nk_ty_unit(), psp)
            }
            pn := ast_alloc(nodes, nk_param(), psp)
            ast_set(nodes, pn, 1, psoff)
            ast_set(nodes, pn, 2, pslen)
            ast_set(nodes, pn, 3, pm)
            ast_set(nodes, pn, 4, sty_nid)
            ast_set(nodes, pn, 5, 0)
            scratch_push(extra, pn)
            pcnt += 1
            if not p_eat(toks, nodes, tk_comma()) {
                break
            }
        } else {
            p_expect(toks, nodes, tk_colon())
            pty := parse_type(toks, pool, nodes, extra)
            mut def_e := 0
            if p_eat(toks, nodes, tk_eq()) {
                def_e = parse_expr(toks, pool, nodes, extra)
            }
            pn := ast_alloc(nodes, nk_param(), psp)
            ast_set(nodes, pn, 1, psoff)
            ast_set(nodes, pn, 2, pslen)
            ast_set(nodes, pn, 3, pm)
            ast_set(nodes, pn, 4, pty)
            ast_set(nodes, pn, 5, def_e)
            scratch_push(extra, pn)
            pcnt += 1
            if not p_eat(toks, nodes, tk_comma()) {
                break
            }
        }
    }
    p_expect(toks, nodes, tk_rparen())
    poff := scratch_commit(extra, pmark)

    mut ret_ty := 0
    if p_eat(toks, nodes, tk_arrow()) {
        ret_ty = parse_type(toks, pool, nodes, extra)
    } else {
        ret_ty = ast_alloc(nodes, nk_ty_unit(), sp)
    }

    mut body := 0
    if p_peek(toks, nodes) == tk_lbrace() {
        body = parse_block(toks, pool, nodes, extra)
    } else {
        p_skip_semis(toks, nodes)
    }

    fnid := ast_alloc(nodes, nk_fn(), sp)
    ast_set(nodes, fnid, 1, fn_soff)
    ast_set(nodes, fnid, 2, fn_slen)
    ast_set(nodes, fnid, 3, poff)
    ast_set(nodes, fnid, 4, (pcnt & 0xFFFF) | (meta_off << 16))
    ast_set(nodes, fnid, 5, ret_ty)
    ast_set(nodes, fnid, 6, body | (flags << 32))
    return fnid
}

fn parse_program_into_ast(toks: IntBuf, pool: ByteBuf, nodes: IntBuf, extra: IntBuf) -> i64 {
    uses_list := ibuf_new(1024)
    structs_list := ibuf_new(2048)
    ifaces_list := ibuf_new(512)
    funcs_list := ibuf_new(16384)
    cimports_list := ibuf_new(256)
    comptime_list := ibuf_new(512)

    while p_peek(toks, nodes) != tk_eof() and ibuf_get(nodes, 2) == 0 {
        p_skip_semis(toks, nodes)
        k := p_peek(toks, nodes)
        sp := p_span(toks, nodes)
        if k == tk_eof() {
            break
        }
        if k == tk_attr() {
            cimp_nid := parse_decorator_attr(toks, pool, nodes, extra)
            if cimp_nid > 0 {
                ibuf_push(cimports_list, cimp_nid)
            }
        } else if k == tk_use() {
            p_advance(nodes)
            smark := scratch_mark(extra)
            s0 := p_expect(toks, nodes, tk_ident())
            scratch_push(extra, tok_soff(toks, s0))
            scratch_push(extra, tok_slen(toks, s0))
            mut seg_cnt := 1
            mut s1_off := 0
            mut s1_len := 0
            while p_eat(toks, nodes, tk_coloncolon()) {
                mut sn := 0
                if p_peek(toks, nodes) == tk_comptime() or p_peek(toks, nodes) == tk_async() {
                    sn = p_advance(nodes)
                } else {
                    sn = p_expect(toks, nodes, tk_ident())
                }
                if seg_cnt == 1 {
                    s1_off = tok_soff(toks, sn)
                    s1_len = tok_slen(toks, sn)
                }
                scratch_push(extra, tok_soff(toks, sn))
                scratch_push(extra, tok_slen(toks, sn))
                seg_cnt += 1
            }
            p_skip_semis(toks, nodes)
            seg_off := scratch_commit(extra, smark)
            un := ast_alloc(nodes, nk_use(), sp)
            ast_set(nodes, un, 1, tok_soff(toks, s0))
            ast_set(nodes, un, 2, tok_slen(toks, s0))
            ast_set(nodes, un, 3, s1_off)
            ast_set(nodes, un, 4, s1_len)
            ast_set(nodes, un, 5, seg_off)
            ast_set(nodes, un, 6, seg_cnt)
            ibuf_push(uses_list, un)
        } else if k == tk_comptime() {
            if p_peek_at(toks, nodes, 1) == tk_fn() {
                fd_ct := parse_fn_decl(toks, pool, nodes, extra)
                ibuf_push(funcs_list, fd_ct)
            } else {
                p_advance(nodes)
                if p_peek(toks, nodes) == tk_lbrace() {
                    cblk := parse_block(toks, pool, nodes, extra)
                    cbn := ast_alloc(nodes, nk_comptime_block(), sp)
                    ast_set(nodes, cbn, 1, cblk)
                    ibuf_push(comptime_list, cbn)
                } else {
                    ct_id := p_expect(toks, nodes, tk_ident())
                    mut cty_nid := 0
                    if p_eat(toks, nodes, tk_colon()) {
                        cty_nid = parse_type(toks, pool, nodes, extra)
                    }
                    if not p_eat(toks, nodes, tk_coloneq()) {
                        p_expect(toks, nodes, tk_eq())
                    }
                    ce_nid := parse_expr(toks, pool, nodes, extra)
                    p_skip_semis(toks, nodes)
                    ccn := ast_alloc(nodes, nk_comptime_const(), sp)
                    ast_set(nodes, ccn, 1, tok_soff(toks, ct_id))
                    ast_set(nodes, ccn, 2, tok_slen(toks, ct_id))
                    ast_set(nodes, ccn, 3, cty_nid)
                    ast_set(nodes, ccn, 4, ce_nid)
                    ibuf_push(comptime_list, ccn)
                }
            }
        } else if k == tk_struct() {
            ibuf_set(nodes, 4, 0)
            ibuf_set(nodes, 14, 0)
            p_advance(nodes)
            st := p_expect(toks, nodes, tk_ident())
            // Optional struct generic brackets `struct Box[T]`
            if p_eat(toks, nodes, tk_lbrack()) {
                while p_peek(toks, nodes) != tk_rbrack() and p_peek(toks, nodes) != tk_eof() {
                    p_advance(nodes)
                }
                p_eat(toks, nodes, tk_rbrack())
            }
            p_expect(toks, nodes, tk_lbrace())
            fmark := scratch_mark(extra)
            mut fcnt := 0
            while p_peek(toks, nodes) != tk_rbrace() and p_peek(toks, nodes) != tk_eof() and ibuf_get(nodes, 2) == 0 {
                fsp := p_span(toks, nodes)
                if p_peek(toks, nodes) == tk_attr() {
                    fat := p_advance(nodes)
                    if not pool_str_eq_lit(pool, tok_soff(toks, fat), tok_slen(toks, fat), "reactive") {
                        p_err(toks, nodes)
                        break
                    }
                }
                ft := p_expect(toks, nodes, tk_ident())
                if not p_eat(toks, nodes, tk_colon()) {
                    // Rejects `x f32` missing colon (`syntax_error.ax`)!
                    p_err(toks, nodes)
                    break
                }
                fty := parse_type(toks, pool, nodes, extra)
                p_eat(toks, nodes, tk_comma())
                p_skip_semis(toks, nodes)
                fd := ast_alloc(nodes, nk_field_decl(), fsp)
                ast_set(nodes, fd, 1, tok_soff(toks, ft))
                ast_set(nodes, fd, 2, tok_slen(toks, ft))
                ast_set(nodes, fd, 3, fty)
                scratch_push(extra, fd)
                fcnt += 1
            }
            p_expect(toks, nodes, tk_rbrace())
            foff := scratch_commit(extra, fmark)
            sn := ast_alloc(nodes, nk_struct(), sp)
            ast_set(nodes, sn, 1, tok_soff(toks, st))
            ast_set(nodes, sn, 2, tok_slen(toks, st))
            ast_set(nodes, sn, 3, foff)
            ast_set(nodes, sn, 4, fcnt)
            ibuf_push(structs_list, sn)
        } else if k == tk_interface() {
            ibuf_set(nodes, 4, 0)
            ibuf_set(nodes, 14, 0)
            p_advance(nodes)
            it := p_expect(toks, nodes, tk_ident())
            p_expect(toks, nodes, tk_lbrace())
            mmark := scratch_mark(extra)
            mut mcnt := 0
            while p_peek(toks, nodes) != tk_rbrace() and p_peek(toks, nodes) != tk_eof() and ibuf_get(nodes, 2) == 0 {
                md := parse_fn_decl(toks, pool, nodes, extra)
                scratch_push(extra, md)
                mcnt += 1
            }
            p_expect(toks, nodes, tk_rbrace())
            moff := scratch_commit(extra, mmark)
            inid := ast_alloc(nodes, nk_interface(), sp)
            ast_set(nodes, inid, 1, tok_soff(toks, it))
            ast_set(nodes, inid, 2, tok_slen(toks, it))
            ast_set(nodes, inid, 3, moff)
            ast_set(nodes, inid, 4, mcnt)
            ibuf_push(ifaces_list, inid)
        } else if k == tk_impl() {
            ibuf_set(nodes, 4, 0)
            ibuf_set(nodes, 14, 0)
            p_advance(nodes)
            it := p_expect(toks, nodes, tk_ident())
            ibuf_set(nodes, 5, tok_soff(toks, it))
            ibuf_set(nodes, 6, tok_slen(toks, it))
            p_expect(toks, nodes, tk_lbrace())
            while p_peek(toks, nodes) != tk_rbrace() and p_peek(toks, nodes) != tk_eof() and ibuf_get(nodes, 2) == 0 {
                if p_peek(toks, nodes) == tk_attr() {
                    parse_decorator_attr(toks, pool, nodes, extra)
                } else {
                    md := parse_fn_decl(toks, pool, nodes, extra)
                    ibuf_push(funcs_list, md)
                }
            }
            p_expect(toks, nodes, tk_rbrace())
            ibuf_set(nodes, 5, -1)
            ibuf_set(nodes, 6, 0)
        } else if k == tk_fn() or k == tk_async() {
            fd := parse_fn_decl(toks, pool, nodes, extra)
            ibuf_push(funcs_list, fd)
        } else {
            p_err(toks, nodes)
            break
        }
    }

    // Commit top-level lists into `extra`
    uoff := ibuf_len(extra)
    ucnt := ibuf_len(uses_list)
    mut i := 0
    while i < ucnt {
        ibuf_push(extra, ibuf_get(uses_list, i))
        i += 1
    }

    soff := ibuf_len(extra)
    scnt := ibuf_len(structs_list)
    i = 0
    while i < scnt {
        ibuf_push(extra, ibuf_get(structs_list, i))
        i += 1
    }

    ioff := ibuf_len(extra)
    icnt := ibuf_len(ifaces_list)
    i = 0
    while i < icnt {
        ibuf_push(extra, ibuf_get(ifaces_list, i))
        i += 1
    }

    foff := ibuf_len(extra)
    fcnt := ibuf_len(funcs_list)
    i = 0
    while i < fcnt {
        ibuf_push(extra, ibuf_get(funcs_list, i))
        i += 1
    }

    cioff := ibuf_len(extra)
    cicnt := ibuf_len(cimports_list)
    i = 0
    while i < cicnt {
        ibuf_push(extra, ibuf_get(cimports_list, i))
        i += 1
    }

    ctoff := ibuf_len(extra)
    ctcnt := ibuf_len(comptime_list)
    i = 0
    while i < ctcnt {
        ibuf_push(extra, ibuf_get(comptime_list, i))
        i += 1
    }

    buf_free(move uses_list)
    buf_free(move structs_list)
    buf_free(move ifaces_list)
    buf_free(move funcs_list)
    buf_free(move cimports_list)
    buf_free(move comptime_list)

    prog := ast_alloc(nodes, nk_program(), 1)
    ast_set(nodes, prog, 1, uoff)
    ast_set(nodes, prog, 2, ucnt)
    ast_set(nodes, prog, 3, soff)
    ast_set(nodes, prog, 4, scnt)
    ast_set(nodes, prog, 5, ioff)
    ast_set(nodes, prog, 6, icnt)
    ibuf_set(nodes, 7, prog)
    ibuf_set(nodes, 8, foff)
    ibuf_set(nodes, 9, fcnt)
    ibuf_set(nodes, 10, cioff)
    ibuf_set(nodes, 11, cicnt)
    ibuf_set(nodes, 12, ctoff)
    ibuf_set(nodes, 13, ctcnt)
    return prog
}
