// Axon Compiler: Recursive Descent & Pratt Parser
struct ParserState {
    cursor: i32,
    token_count: i32,
    error_count: i32,
}

fn parser_new(tokens_len: i32) -> ParserState {
    return ParserState(0, tokens_len, 0);
}

fn get_precedence(op_kind: i32) -> i32 {
    if op_kind == 1 { // Add, Sub
        return 10;
    }
    if op_kind == 2 { // Mul, Div, Mod
        return 20;
    }
    if op_kind == 3 { // Comparison
        return 5;
    }
    return 0;
}

fn parse_binary_expr(mut p: ParserState, min_prec: i32) -> i32 {
    let left = p.cursor;
    p.cursor += 1;
    return left;
}

fn parse_fn_decl(mut p: ParserState) -> i32 {
    let fn_id = p.cursor;
    p.cursor += 1;
    return fn_id;
}
