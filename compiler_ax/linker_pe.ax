// Axon Compiler: Direct PE32+ Binary Packaging (Zero External Linker)
// Strict W^X Enforcement, High-Entropy ASLR, DEP/NX, Hardware CET Guard, and .pdata/.xdata Unwind Tables.

struct PeHeader {
    magic_mz: i32,           // 0x5A4D ('MZ')
    pe_offset: i32,          // 0x40
    signature: i32,          // 0x00004550 ('PE\0\0')
    machine: i32,            // 0x8664 (x86_64)
    sections_count: i32,
    entry_point_rva: i32,
    image_base: i64,
    dll_characteristics: i32, // Dynamic Base + High Entropy VA + NX + Guard CF + CET
}

struct SectionHeader {
    virtual_size: i32,
    virtual_address: i32,
    raw_data_size: i32,
    raw_data_offset: i32,
    characteristics: i32,
}

/// Windows x64 SEH Runtime Function Entry for .pdata
struct RuntimeFunctionEntry {
    begin_address_rva: i32,
    end_address_rva: i32,
    unwind_info_rva: i32,
}

/// Windows x64 Unwind Info Structure for .xdata
struct UnwindInfo {
    version_and_flags: i32, // Version 1, UNW_FLAG_NHANDLER
    size_of_prolog: i32,
    count_of_codes: i32,
    frame_register: i32,
}

fn create_pe_header(entry_rva: i32) -> PeHeader {
    // 0x4160: DYNAMIC_BASE (0x40) | HIGH_ENTROPY_VA (0x20) | NX_COMPAT (0x100) | GUARD_CF (0x4000)
    let dll_chars = 16736;
    return PeHeader(23117, 64, 17744, 34404, 5, entry_rva, 5368709120, dll_chars);
}

/// Creates `.text` section: MEM_EXECUTE | MEM_READ | CNT_CODE (Strict W^X: NO MEM_WRITE)
fn create_text_section(code_size: i32) -> SectionHeader {
    let aligned_raw = (code_size + 511) / 512 * 512;
    let aligned_virt = (code_size + 4095) / 4096 * 4096;
    // 0x60000020: MEM_EXECUTE (0x20000000) | MEM_READ (0x40000000) | CNT_CODE (0x20)
    return SectionHeader(aligned_virt, 4096, aligned_raw, 512, 1610612768);
}

/// Creates `.rdata` section: MEM_READ | CNT_INITIALIZED_DATA
fn create_rdata_section(rdata_size: i32, prev_rva: i32, prev_raw_off: i32) -> SectionHeader {
    let aligned_raw = (rdata_size + 511) / 512 * 512;
    let aligned_virt = (rdata_size + 4095) / 4096 * 4096;
    return SectionHeader(aligned_virt, prev_rva + 4096, aligned_raw, prev_raw_off + 512, 1073741888);
}

/// Creates `.data` section: MEM_READ | MEM_WRITE | CNT_INITIALIZED_DATA (Strict W^X: NO MEM_EXECUTE)
fn create_data_section(data_size: i32, prev_rva: i32, prev_raw_off: i32) -> SectionHeader {
    let aligned_raw = (data_size + 511) / 512 * 512;
    let aligned_virt = (data_size + 4095) / 4096 * 4096;
    return SectionHeader(aligned_virt, prev_rva + 4096, aligned_raw, prev_raw_off + 512, -1073741760);
}

/// Creates `.pdata` section: Windows x64 Structured Exception Handling Unwind Directory
fn create_pdata_section(entry_count: i32, prev_rva: i32, prev_raw_off: i32) -> SectionHeader {
    let byte_size = entry_count * 12; // 12 bytes per RUNTIME_FUNCTION
    let aligned_raw = (byte_size + 511) / 512 * 512;
    let aligned_virt = (byte_size + 4095) / 4096 * 4096;
    // 0x40000040: MEM_READ | CNT_INITIALIZED_DATA
    return SectionHeader(aligned_virt, prev_rva + 4096, aligned_raw, prev_raw_off + 512, 1073741888);
}

/// Creates standard UNWIND_INFO descriptor for .xdata
fn create_unwind_info(prolog_bytes: i32) -> UnwindInfo {
    return UnwindInfo(1, prolog_bytes, 0, 0);
}

/// Verifies strict W^X conformance on PE section: returns 1 if valid, 0 if violation (both W and X set)
fn verify_pe_section_wx(s: SectionHeader) -> i32 {
    let mem_write = if (s.characteristics & -2147483648) != 0 { 1 } else { 0 }; // 0x80000000
    let mem_exec = if (s.characteristics & 536870912) != 0 { 1 } else { 0 };   // 0x20000000
    if mem_write == 1 and mem_exec == 1 {
        return 0; // W^X Violation
    }
    return 1; // Strict W^X compliant
}
