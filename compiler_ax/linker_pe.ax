// Axon Compiler: Direct PE32+ Binary Packaging (Zero External Linker)
struct PeHeader {
    magic_mz: i32,      // 0x5A4D ('MZ')
    pe_offset: i32,     // 0x40
    signature: i32,     // 0x00004550 ('PE\0\0')
    machine: i32,       // 0x8664 (x86_64)
    sections_count: i32,
    entry_point_rva: i32,
    image_base: i64,
}

struct SectionHeader {
    virtual_size: i32,
    virtual_address: i32,
    raw_data_size: i32,
    raw_data_offset: i32,
    characteristics: i32,
}

fn create_pe_header(entry_rva: i32) -> PeHeader {
    return PeHeader(23117, 64, 17744, 34404, 3, entry_rva, 5368709120);
}

fn create_text_section(code_size: i32) -> SectionHeader {
    let aligned_raw = (code_size + 511) / 512 * 512;
    let aligned_virt = (code_size + 4095) / 4096 * 4096;
    // 0x60000020: MEM_EXECUTE | MEM_READ | CNT_CODE
    return SectionHeader(aligned_virt, 4096, aligned_raw, 512, 1610612768);
}
