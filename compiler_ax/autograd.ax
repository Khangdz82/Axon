// Axon Compiler: Compile-Time Reverse-Mode Autodiff (`@grad`)
// Emits deterministic backward pass directly in IR; uses Perceus in-place reuse (0 runtime tape/graph).

struct GradTapeNode {
    op_kind: i32, // 1: Linear, 2: MatMul, 3: GELU, 4: CrossEntropy
    in_var: i32,
    grad_var: i32,
    weight_var: i32,
}

struct AutogradFunctionContext {
    forward_ops: i32,
    backward_ops_emitted: i32,
    reused_gradient_buffers: i32,
    tape_overhead_bytes: i32, // Always 0 (static IR generation)
}

fn autograd_ctx_new() -> AutogradFunctionContext {
    return AutogradFunctionContext(0, 0, 0, 0);
}

/// Generates backward gradient calculation for vector/matrix linear transform: y = W * x
fn emit_backward_linear(mut ctx: AutogradFunctionContext) -> i32 {
    ctx.backward_ops_emitted += 2; // grad_x = W^T * grad_y; grad_W = grad_y * x^T
    ctx.reused_gradient_buffers += 1;
    return ctx.backward_ops_emitted;
}
