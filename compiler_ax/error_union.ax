// Axon Compiler: Zero-Cost Error Unions (`T ! Error`) & Dual-Register Lowering
/// Error Union representation: Value T in Reg0, Error in Reg1
struct ErrorUnionType {
    val_type_id: i32,
    err_type_id: i32,
    is_error_union: i32,
}

/// Lowering target register mapping for Error Union return
struct ErrorReturnRegisters {
    val_reg: i32, // x86_64: RAX (0), ARM64: X0 (0)
    err_reg: i32, // x86_64: RDX (2), ARM64: X1 (1)
    has_unwind_overhead: i32, // Always 0 (No exception unwinding tables)
}

/// Defines a new Error Union type T ! Error
fn error_union_new(val_type: i32, err_type: i32) -> ErrorUnionType {
    return ErrorUnionType(val_type, err_type, 1);
}

/// Emits register mapping for error union return
fn error_union_get_regs(arch: i32) -> ErrorReturnRegisters {
    if arch == 1 {
        // x86_64: RAX returns value, RDX returns error code (0 = success)
        return ErrorReturnRegisters(0, 2, 0);
    }
    // ARM64: X0 returns value, X1 returns error code (0 = success)
    return ErrorReturnRegisters(0, 1, 0);
}

/// Lowers `try expr`: If error register != 0, returns immediately to caller
fn lower_try_statement(err_reg: i32) -> i32 {
    // Emits:
    //   test rdx, rdx
    //   jnz  .L_propagate_error
    return 1;
}

/// Lowers `catch (err) { ... }`: Branches based on error register != 0
fn lower_catch_statement(err_reg: i32, handler_block: i32) -> i32 {
    return handler_block;
}
