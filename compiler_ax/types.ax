// Axon Compiler: Local Type Inference & Second-Class Reference Verifier
// Type Aliases (int, uint, float, byte), Static Trait Concepts & Linear Isolation.

struct TypeDef {
    kind: i32,
    size_bytes: i32,
    align_bytes: i32,
    is_isolated: i32,
}

struct TypeContext {
    struct_count: i32,
    fn_count: i32,
    error_count: i32,
}

fn type_ctx_new() -> TypeContext {
    return TypeContext(0, 0, 0);
}

/// Resolves ergonomic type aliases: int -> i64, uint -> u64, float -> f64, byte -> u8
fn resolve_type_alias(alias_id: i32) -> i32 {
    if alias_id == 1 { return 10; } // int -> i64
    if alias_id == 2 { return 11; } // uint -> u64
    if alias_id == 3 { return 20; } // float -> f64
    if alias_id == 4 { return 30; } // byte -> u8
    return alias_id; // Exact primitive type (i32, f32, etc.)
}

fn verify_second_class_ref(type_kind: i32, is_field: i32, is_return: i32) -> i32 {
    // Reference kind == 99
    if type_kind == 99 {
        if is_field == 1 {
            return 1; // Error: Reference inside struct forbidden
        }
        if is_return == 1 {
            return 1; // Error: Returning reference forbidden
        }
    }
    return 0; // OK
}

fn verify_linear_isolation(is_isolated: i32, is_moved: i32) -> i32 {
    if is_moved == 1 {
        return 1; // Error: Use after move
    }
    return 0; // OK
}

/// Verifies Object-Capability Security (M32):
/// Unforgeable linear capability tokens (FsCap=101, NetCap=102, EnvCap=103, GpuCap=104, ProcessCap=105)
/// Calling I/O without the corresponding linear capability token in the function signature is rejected at compile time.
fn verify_capability_token(fn_io_kind: i32, has_cap_token: i32) -> i32 {
    // fn_io_kind: 1: FS, 2: NET, 3: ENV, 4: GPU, 5: PROCESS
    if fn_io_kind > 0 and has_cap_token == 0 {
        return 1; // Compile Error: Capability missing in signature
    }
    return 0; // OK
}

/// Asserts that unforgeable capabilities cannot be instantiated via raw struct literals by user code
fn verify_capability_non_forgeable(is_user_code: i32, cap_kind: i32) -> i32 {
    if is_user_code == 1 and (cap_kind >= 101 and cap_kind <= 105) {
        return 1; // Compile Error: Cannot synthesize linear capability token directly
    }
    return 0; // OK
}

/// Audits package capability declarations (`axc audit --caps`):
/// Detects suspicious packages (e.g. pure math/parser declaring network or fs capabilities)
fn audit_package_capability_leak(pkg_category: i32, declared_caps_mask: i32) -> i32 {
    // pkg_category: 1: Math/Algorithm, 2: Parser/Text, 3: Network/Server, 4: System/CLI
    let has_net = if (declared_caps_mask & 2) != 0 { 1 } else { 0 };
    let has_fs = if (declared_caps_mask & 1) != 0 { 1 } else { 0 };
    if (pkg_category == 1 or pkg_category == 2) and (has_net == 1 or has_fs == 1) {
        return 1; // Supply-chain warning: Unexpected privilege escalation in utility package
    }
    return 0; // OK
}
