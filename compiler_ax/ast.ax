// Axon Compiler: Index-Based Flat Arena AST
struct AstNode {
    kind: i32,
    op: i32,
    child_left: i32,
    child_right: i32,
    type_id: i32,
    span_start: i32,
    span_end: i32,
}

struct AstArena {
    node_count: i32,
    capacity: i32,
}

fn arena_new(cap: i32) -> AstArena {
    return AstArena(0, cap);
}

fn alloc_node(mut arena: AstArena, kind: i32, op: i32, left: i32, right: i32) -> i32 {
    let id = arena.node_count;
    arena.node_count += 1;
    return id;
}

fn get_node_kind(node: AstNode) -> i32 {
    return node.kind;
}
