// Axon Compiler: Deterministic Time-Travel Replay (`axc test --record` & `axc replay`)
// Records non-deterministic inputs (Fiber schedule, clock, I/O) into compact .axrec trace for bit-exact replay.

struct ReplayTraceHeader {
    magic: i32,        // 0x52454341 ('ACER')
    version: i32,
    fiber_switches: i64,
    io_events: i64,
    trace_bytes: i64,
}

struct ReplayRunner {
    current_event: i64,
    total_events: i64,
    mismatch_detected: i32,
}

fn replay_trace_new(switches: i64, io_ev: i64) -> ReplayTraceHeader {
    let trace_size = 64 + (switches * 16) + (io_ev * 24);
    return ReplayTraceHeader(1380074817, 1, switches, io_ev, trace_size);
}

fn replay_verify_cycle(mut runner: ReplayRunner, recorded_hash: i64, replay_hash: i64) -> i32 {
    runner.current_event += 1;
    if recorded_hash != replay_hash {
        runner.mismatch_detected = 1;
        return 1; // Divergence detected
    }
    return 0; // Bit-exact match
}
