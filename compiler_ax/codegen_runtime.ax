                mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x7D, aoff)
            }
            mc_vex3(c, 1, 0, 1, 2, 1, 14, 1, 1, 0xB8); mc_b1(c, 0xC4)
            mc_vex3(c, 1, 0, 1, 2, 1, 14, 1, 1, 0xB8); mc_b1(c, 0xCD)
            mc_vex3(c, 1, 0, 1, 2, 1, 15, 1, 1, 0xB8); mc_b1(c, 0xD4)
            mc_vex3(c, 1, 0, 1, 2, 1, 15, 1, 1, 0xB8); mc_b1(c, 0xDD)
            ku64 += 1
        }
        mc_b4(c, 0x48, 0x83, 0xC7, 32); mc_b4(c, 0x48, 0x83, 0xC6, 32)
        mc_b4(c, 0x49, 0x83, 0xC0, 32); mc_b4(c, 0x49, 0x83, 0xC6, 32)
        mc_b4(c, 0x49, 0x83, 0xC4, 32); mc_b4(c, 0x48, 0x83, 0xC5, 32)
