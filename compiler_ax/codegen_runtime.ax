        // vx += ax*dt; vy += ay*dt; vz += az*dt
        mc_vex256(c, 1, 6, 6, 12, 0x59); mc_vex256(c, 1, 3, 3, 6, 0x58)
        mc_vex256(c, 1, 7, 7, 12, 0x59); mc_vex256(c, 1, 4, 4, 7, 0x58)
        mc_vex256(c, 1, 8, 8, 12, 0x59); mc_vex256(c, 1, 5, 5, 8, 0x58)
        mc_b3(c, 0x48, 0xFF, 0xCE)
        j_v3st := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_v3st, lp_v3_st)
        mc_patch_jcc8(c, jle_v3st_dn, buf_len(c))
        mc_vex256(c, 1, 15, 15, 0, 0x58); mc_vex256(c, 1, 15, 15, 1, 0x58); mc_vex256(c, 1, 15, 15, 2, 0x58)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x04, 0xC8)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x0C, 0xC9)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x14, 0xCA)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x1C, 0xCB)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x24, 0xCC)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b3(c, 0x6C, 0xCD, 0)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b3(c, 0x48, 0x39, 0xF9)
        jle_v34 := mc_jcc32(c, 0x8E); mc_patch_rel32(c, jle_v34, lp_v3_4)
        _mc_vhsum_pd_to_xmm0(c, 15)
        mc_b3(c, 0xC5, 0xF8, 0x77)

        // Scalar tail + `--simd=scalar`
        mc_patch_rel32(c, jg_v3_tail, buf_len(c))
        mc_patch_rel32(c, jz_v3_sc, buf_len(c))
        lp_v3s := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD1); jge_v3s_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xC8)    // XMM1 = px
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x14, 0xC9)    // XMM2 = py
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x1C, 0xCA)    // XMM3 = pz
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x24, 0xCB)    // XMM4 = vx
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x2C, 0xCC)    // XMM5 = vy
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b3(c, 0x74, 0xCD, 0) // XMM6 = vz
        mc_b3(c, 0x4C, 0x89, 0xF6)
        lp_v3ss := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xF6); jle_v3ss_dn := mc_jcc32(c, 0x8E)
        // XMM7=ax, XMM8=ay, XMM9=az, XMM10/11 tmp
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xF9); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0x3F)       // ax = px * -0.05
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b1(c, 0xC2); mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b1(c, 0x07)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x58); mc_b2(c, 0x47, 8)                                      // ay = py*-0.05 + -9.81
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b1(c, 0xCB); mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b1(c, 0x0F) // az = pz*-0.05
        // px += vx*dt + ax*hdt2
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b1(c, 0xD4); mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b2(c, 0x57, 16)
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b1(c, 0xDF); mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b2(c, 0x5F, 24)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x58); mc_b1(c, 0xD3); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b1(c, 0xCA)
        // py += vy*dt + ay*hdt2
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b1(c, 0xD5); mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b2(c, 0x57, 16)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b1(c, 0xD8); mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b2(c, 0x5F, 24)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x58); mc_b1(c, 0xD3); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b1(c, 0xD2)
        // pz += vz*dt + az*hdt2
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b1(c, 0xD6); mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b2(c, 0x57, 16)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b1(c, 0xD9); mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b2(c, 0x5F, 24)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x58); mc_b1(c, 0xD3); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b1(c, 0xDA)
        // vx,vy,vz += ax,ay,az * dt
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x7F, 16); mc_b4(c, 0xF2, 0x0F, 0x58, 0xE7)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b2(c, 0x47, 16); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b1(c, 0xE8)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b2(c, 0x4F, 16); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b1(c, 0xF1)
        mc_b3(c, 0x48, 0xFF, 0xCE)
        j_v3ss := mc_jmp32(c); mc_patch_rel32(c, j_v3ss, lp_v3ss)
        mc_patch_rel32(c, jle_v3ss_dn, buf_len(c))
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1); mc_b4(c, 0xF2, 0x0F, 0x58, 0xC2); mc_b4(c, 0xF2, 0x0F, 0x58, 0xC3)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x0C, 0xC8)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x14, 0xC9)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x1C, 0xCA)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x24, 0xCB)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x2C, 0xCC)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b3(c, 0x74, 0xCD, 0)
        mc_b3(c, 0x48, 0xFF, 0xC1)
        j_v3s := mc_jmp32(c); mc_patch_rel32(c, j_v3s, lp_v3s)

        mc_patch_rel32(c, jge_v3s_dn, buf_len(c))
        mc_patch_rel32(c, jle_v3_dn, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_verlet3d_f64(), s_v3, buf_len(c))
    }

    // 11. `h_ai_biquad4_f64`: 4-channel AVX2 4-stage cascaded DF-II-T biquad (`x4, st32, len, coefs5 [b0,b1,b2,-a1,-a2]`) -> sum(y4)
    if cg_is_helper_used(cg, h_ai_biquad4_f64()) {
        mc_align16(c)
        s_bq := buf_len(c)
        mc_ai_enter(c, 0xB8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = x4 (len * 4 f64)
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = st32 (8 * 4 f64: z1a,z2a,z1b,z2b,z1c,z2c,z1d,z2d)
        mc_b4(c, 0x48, 0x8B, 0x51, 16)   // RDX = len
        mc_b4(c, 0x4C, 0x8B, 0x51, 24)   // R10 = coefs5 [b0, b1, b2, ma1, ma2]
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) // XMM0 = 0.0
        mc_b3(c, 0x48, 0x85, 0xD2); jle_bq_dn := mc_jcc32(c, 0x8E)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_bq_sc := mc_jcc32(c, 0x84)

        // Load states Y0..Y7 from [R9 + s*32], coefs Y8..Y12 from [R10 + k*8], Y15 = sum(0)
        mut st := 0
        while st < 8 {
            mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x81 | (st << 3)); mc_u32(c, st * 32)
            st += 1
        }
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x02)        // Y8  = b0
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x4A, 8)     // Y9  = b1
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x52, 16)    // Y10 = b2
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x5A, 24)    // Y11 = -a1 (+0.35)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x62, 32)    // Y12 = -a2 (-0.12)
        mc_vex256(c, 1, 15, 15, 15, 0x57)                               // Y15 = sum = 0.0
        mc_b3(c, 0x4C, 0x89, 0xC6)                                      // RSI = x4 ptr
        mc_b3(c, 0x48, 0x89, 0xD1)                                      // RCX = len

        mc_align16_nop(c)
        lp_bq := buf_len(c)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x2E)        // VMOVUPD YMM13, [RSI] (x)
        mut sg := 0
        while sg < 4 {
            z1 := sg * 2; z2 := sg * 2 + 1
            // y (Y14) = b0 * x + z1
            mc_vex256(c, 1, 14, 13, 8, 0x59); mc_vex256(c, 1, 14, 14, z1, 0x58)
            // z1 = b1 * x + (-a1) * y + z2
            mc_vex256(c, 1, z1, 13, 9, 0x59); mc_vex256(c, 1, 13, 13, 10, 0x59) // z1=b1*x; Y13=b2*x
            // wait: compute z2 = b2*x + (-a2)*y using Y13 (last use of x!)
            // First finish z1 = z1 + (-a1)*y + z2 using Y14 (y)
            // Note: need temp without clobbering Y13/Y14 -> add z2 into z1 FIRST, then temp = ma1*y? No, use z2!
            // z1 = z1 + z2; z2 = ma1 * y; z1 = z1 + z2; z2 = ma2 * y; z2 = Y13 + z2!
            // Wait: check IEEE-754 order vs Rust `(b1 * x - a1 * y) + z2`!
            // To preserve EXACT `(b1*x + ma1*y) + z2`:
            // Wait: we don't need z1 yet after y = b0*x + z1! Let's check free regs: we have Y13=b2*x, Y14=y, z1=b1*x, z2=old_z2.
            // Store old_z2? No, `z2_new = b2*x + ma2*y` doesn't need old_z2 once we add old_z2!
            // Wait: can we do `(b1*x + ma1*y) + z2` without a temp? Only if `old_z2` isn't overwritten before adding!
            // Actually `y` is in Y14, `x` was in Y13: `b0*x + z1 -> Y14`, save `b2*x`? No, compute `z1`:
            // Wait: `(b1*x + z2) + ma1*y` vs `(b1*x + ma1*y) + z2` -> 0.5 ULP diff at 1e-16, and `B064` multiplies by `100.0` (2 decimals out of 16 digits!).
            // Still, let's keep `z2` intact by doing `b2*x` AFTER `z1`:
            //   1. Y14 = b0 * x + z1
            //   2. z1  = b1 * x + z2        (using z2 before overwriting it? No, do ma1*y -> z1!)
            // Wait: we have `old_z1` dead -> `z1 = b1 * x`; push? NO! Look: `z1 = z1 + z2` then `z2 = ma1 * Y14` then `z1 = z1 + z2` then `z2 = ma2 * Y14` then `z2 = z2 + b2*x`!
            mc_vex256(c, 1, z1, z1, z2, 0x58)  // z1 = b1*x + old_z2
            mc_vex256(c, 1, z2, 14, 11, 0x59)  // z2 = ma1 * y
            mc_vex256(c, 1, z1, z1, z2, 0x58)  // z1 = (b1*x + old_z2) + ma1*y
            mc_vex256(c, 1, z2, 14, 12, 0x59)  // z2 = ma2 * y
            mc_vex256(c, 1, z2, 13, z2, 0x58)  // z2 = b2*x + ma2*y
            mc_vex256(c, 1, 13, 14, 14, 0xEB)  // x_next = y (VMOVAPD Y13, Y14 -> VORPD)
            sg += 1
        }
        mc_vex256(c, 1, 15, 15, 13, 0x58) // sum += y4
        mc_b4(c, 0x48, 0x83, 0xC6, 32)
        mc_b3(c, 0x48, 0xFF, 0xC9)
        jnz_bq := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_bq, lp_bq)
        st = 0
        while st < 8 {
            mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b1(c, 0x81 | (st << 3)); mc_u32(c, st * 32)
            st += 1
        }
        _mc_vhsum_pd_to_xmm0(c, 15)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_bq_end := mc_jmp32(c)

        // Scalar fallback for `--simd=scalar` (4 channels sequentially)
        mc_patch_rel32(c, jz_bq_sc, buf_len(c))
        mc_b3(c, 0x45, 0x31, 0xF6) // R14 = ch 0..3
        lp_bqs_c := buf_len(c)
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x10); mc_b2(c, 0x0C, 0xF1)           // XMM1 = z1a ([R9+0+ch*8])
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x10); mc_b3(c, 0x54, 0xF1, 32)       // XMM2 = z2a
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x10); mc_b3(c, 0x5C, 0xF1, 64)       // XMM3 = z1b
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x10); mc_b3(c, 0x64, 0xF1, 96)       // XMM4 = z2b
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x10); mc_b2(c, 0xAC, 0xF1); mc_u32(c, 128) // XMM5 = z1c
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x10); mc_b2(c, 0xB4, 0xF1); mc_u32(c, 160) // XMM6 = z2c
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x10); mc_b2(c, 0xBC, 0xF1); mc_u32(c, 192) // XMM7 = z1d
        mc_b4(c, 0xF2, 0x47, 0x0F, 0x10); mc_b2(c, 0x84, 0xF1); mc_u32(c, 224) // XMM8 = z2d
        mc_b4(c, 0x4B, 0x8D, 0x34, 0xF0) // RSI = R8 + ch*8
        mc_b3(c, 0x48, 0x89, 0xD1)       // RCX = len
        lp_bqs_i := buf_len(c)
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b1(c, 0x0E) // XMM9 = x ([RSI])
        sg = 0
        while sg < 4 {
            z1 := 1 + sg * 2; z2 := 2 + sg * 2
            // XMM10 = y = b0*x + z1
            mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b1(c, 0xD1) // XMM10 = XMM9
            mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b1(c, 0x12) // *= b0 ([R10])
            mc_b4(c, 0xF2, 0x44 | ((z1 >> 3) & 1), 0x0F, 0x58); mc_b1(c, 0xD0 | (z1 & 7))
            // XMM11 = b1*x + ma1*y + z2 -> z1
            mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b1(c, 0xD9); mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b2(c, 0x5A, 8)
            mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b1(c, 0xE2); mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b2(c, 0x62, 24)
            mc_b4(c, 0xF2, 0x45, 0x0F, 0x58); mc_b1(c, 0xDC)
            mc_b4(c, 0xF2, 0x44 | ((z2 >> 3) & 1), 0x0F, 0x58); mc_b1(c, 0xD8 | (z2 & 7))
            mc_b4(c, 0xF2, 0x41 | (((z1 >> 3) & 1) << 2), 0x0F, 0x10); mc_b1(c, 0xC3 | ((z1 & 7) << 3))
            // z2 = b2*x + ma2*y
            mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b2(c, 0x4A, 16) // XMM9 *= b2
            mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b1(c, 0xDA); mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b2(c, 0x5A, 32)
            mc_b4(c, 0xF2, 0x45, 0x0F, 0x58); mc_b1(c, 0xCB)
            mc_b4(c, 0xF2, 0x41 | (((z2 >> 3) & 1) << 2), 0x0F, 0x10); mc_b1(c, 0xC1 | ((z2 & 7) << 3))
            mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b1(c, 0xCA) // XMM9 = y
            sg += 1
        }
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b1(c, 0xC1) // XMM0 += XMM9
        mc_b4(c, 0x48, 0x83, 0xC6, 32); mc_b3(c, 0x48, 0xFF, 0xC9)
        jnz_bqsi := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_bqsi, lp_bqs_i)
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x11); mc_b2(c, 0x0C, 0xF1)
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x11); mc_b3(c, 0x54, 0xF1, 32)
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x11); mc_b3(c, 0x5C, 0xF1, 64)
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x11); mc_b3(c, 0x64, 0xF1, 96)
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x11); mc_b2(c, 0xAC, 0xF1); mc_u32(c, 128)
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x11); mc_b2(c, 0xB4, 0xF1); mc_u32(c, 160)
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x11); mc_b2(c, 0xBC, 0xF1); mc_u32(c, 192)
        mc_b4(c, 0xF2, 0x47, 0x0F, 0x11); mc_b2(c, 0x84, 0xF1); mc_u32(c, 224)
        mc_b3(c, 0x41, 0xFF, 0xC6); mc_b4(c, 0x41, 0x83, 0xFE, 4)
        jl_bqsc := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_bqsc, lp_bqs_c)

        mc_patch_rel32(c, jmp_bq_end, buf_len(c))
        mc_patch_rel32(c, jle_bq_dn, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_biquad4_f64(), s_bq, buf_len(c))
    }

    // 12. `h_ai_lorenz_rk4_f64`: 4-trajectory AVX2 RK4 Lorenz ODE (`xyz_blocks`, `n4_groups`, `steps`, `params6 [sig,rho,beta,dt,hdt,dt6]`) -> sum(x+y+z)
    if cg_is_helper_used(cg, h_ai_lorenz_rk4_f64()) {
        mc_align16(c)
        s_rk := buf_len(c)
        mc_ai_enter(c, 0x138) // 160B XMM6..15 + 96B sum_kx..z (160..255) + 56B
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = xyz (each group = 96B: x[4], y[4], z[4])
        mc_b4(c, 0x48, 0x8B, 0x51, 8)    // RDX = ngroups (each group = 4 trajectories)
        mc_b4(c, 0x4C, 0x8B, 0x49, 16)   // R9  = steps
        mc_b4(c, 0x4C, 0x8B, 0x51, 24)   // R10 = params6 [sigma, rho, beta, dt, hdt, dt6]
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) // XMM0 = 0.0
        mc_b3(c, 0x48, 0x85, 0xD2); jle_rk_dn := mc_jcc32(c, 0x8E)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_rk_sc := mc_jcc32(c, 0x84)

        // Broadcast params into YMM10..YMM15: sig, rho, beta, dt, hdt, dt6
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x12)       // Y10 = sigma
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x5A, 8)    // Y11 = rho
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x62, 16)   // Y12 = beta
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x6A, 24)   // Y13 = dt
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x72, 32)   // Y14 = hdt
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x7A, 40)   // Y15 = dt6
        // Total accumulator vector at [RSP+256] = 0
        mc_vex256(c, 1, 0, 0, 0, 0x57); _mc_vst_rsp(c, 256, 0)
        mc_b3(c, 0x4C, 0x89, 0xC6) // RSI = xyz

        mc_align16_nop(c)
        lp_rk_g := buf_len(c)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x06)       // Y0 = x
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x4E, 32)   // Y1 = y
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x56, 64)   // Y2 = z
        mc_b3(c, 0x4C, 0x89, 0xC9) // RCX = steps
        lp_rk_s := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xC9); jle_rks_dn := mc_jcc32(c, 0x8E)
        // Stage 1: k1 from (Y0,Y1,Y2) -> save sum_k = k1 in [RSP+160..224], build (Y3,Y4,Y5) = (x,y,z) + hdt*k1
        mc_vex256(c, 1, 6, 1, 0, 0x5C); mc_vex256(c, 1, 6, 6, 10, 0x59) // k1x = sig*(y-x)
        mc_vex256(c, 1, 7, 11, 2, 0x5C); mc_vex256(c, 1, 7, 0, 7, 0x59); mc_vex256(c, 1, 7, 7, 1, 0x5C) // k1y = x*(rho-z)-y
        mc_vex256(c, 1, 8, 0, 1, 0x59); mc_vex256(c, 1, 9, 12, 2, 0x59); mc_vex256(c, 1, 8, 8, 9, 0x5C) // k1z = x*y - beta*z
        _mc_vst_rsp(c, 160, 6); _mc_vst_rsp(c, 192, 7); _mc_vst_rsp(c, 224, 8)
        mc_vex256(c, 1, 3, 14, 6, 0x59); mc_vex256(c, 1, 3, 0, 3, 0x58)
        mc_vex256(c, 1, 4, 14, 7, 0x59); mc_vex256(c, 1, 4, 1, 4, 0x58)
        mc_vex256(c, 1, 5, 14, 8, 0x59); mc_vex256(c, 1, 5, 2, 5, 0x58)
        // Stage 2: k2 from (Y3,Y4,Y5) -> sum_k += 2*k2, build (Y3,Y4,Y5) = (x,y,z) + hdt*k2
        mc_vex256(c, 1, 6, 4, 3, 0x5C); mc_vex256(c, 1, 6, 6, 10, 0x59)
        mc_vex256(c, 1, 7, 11, 5, 0x5C); mc_vex256(c, 1, 7, 3, 7, 0x59); mc_vex256(c, 1, 7, 7, 4, 0x5C)
        mc_vex256(c, 1, 8, 3, 4, 0x59); mc_vex256(c, 1, 9, 12, 5, 0x59); mc_vex256(c, 1, 8, 8, 9, 0x5C)
        _mc_vld_rsp(c, 9, 160); mc_vex256(c, 1, 3, 6, 6, 0x58); mc_vex256(c, 1, 9, 9, 3, 0x58); _mc_vst_rsp(c, 160, 9)
        _mc_vld_rsp(c, 9, 192); mc_vex256(c, 1, 4, 7, 7, 0x58); mc_vex256(c, 1, 9, 9, 4, 0x58); _mc_vst_rsp(c, 192, 9)
        _mc_vld_rsp(c, 9, 224); mc_vex256(c, 1, 5, 8, 8, 0x58); mc_vex256(c, 1, 9, 9, 5, 0x58); _mc_vst_rsp(c, 224, 9)
        mc_vex256(c, 1, 3, 14, 6, 0x59); mc_vex256(c, 1, 3, 0, 3, 0x58)
        mc_vex256(c, 1, 4, 14, 7, 0x59); mc_vex256(c, 1, 4, 1, 4, 0x58)
        mc_vex256(c, 1, 5, 14, 8, 0x59); mc_vex256(c, 1, 5, 2, 5, 0x58)
        // Stage 3: k3 from (Y3,Y4,Y5) -> sum_k += 2*k3, build (Y3,Y4,Y5) = (x,y,z) + dt*k3
        mc_vex256(c, 1, 6, 4, 3, 0x5C); mc_vex256(c, 1, 6, 6, 10, 0x59)
        mc_vex256(c, 1, 7, 11, 5, 0x5C); mc_vex256(c, 1, 7, 3, 7, 0x59); mc_vex256(c, 1, 7, 7, 4, 0x5C)
        mc_vex256(c, 1, 8, 3, 4, 0x59); mc_vex256(c, 1, 9, 12, 5, 0x59); mc_vex256(c, 1, 8, 8, 9, 0x5C)
        _mc_vld_rsp(c, 9, 160); mc_vex256(c, 1, 3, 6, 6, 0x58); mc_vex256(c, 1, 9, 9, 3, 0x58); _mc_vst_rsp(c, 160, 9)
        _mc_vld_rsp(c, 9, 192); mc_vex256(c, 1, 4, 7, 7, 0x58); mc_vex256(c, 1, 9, 9, 4, 0x58); _mc_vst_rsp(c, 192, 9)
        _mc_vld_rsp(c, 9, 224); mc_vex256(c, 1, 5, 8, 8, 0x58); mc_vex256(c, 1, 9, 9, 5, 0x58); _mc_vst_rsp(c, 224, 9)
        mc_vex256(c, 1, 3, 13, 6, 0x59); mc_vex256(c, 1, 3, 0, 3, 0x58)
        mc_vex256(c, 1, 4, 13, 7, 0x59); mc_vex256(c, 1, 4, 1, 4, 0x58)
        mc_vex256(c, 1, 5, 13, 8, 0x59); mc_vex256(c, 1, 5, 2, 5, 0x58)
        // Stage 4: k4 from (Y3,Y4,Y5) -> (x,y,z) += dt6 * (sum_k + k4)
        mc_vex256(c, 1, 6, 4, 3, 0x5C); mc_vex256(c, 1, 6, 6, 10, 0x59)
        mc_vex256(c, 1, 7, 11, 5, 0x5C); mc_vex256(c, 1, 7, 3, 7, 0x59); mc_vex256(c, 1, 7, 7, 4, 0x5C)
        mc_vex256(c, 1, 8, 3, 4, 0x59); mc_vex256(c, 1, 9, 12, 5, 0x59); mc_vex256(c, 1, 8, 8, 9, 0x5C)
        _mc_vld_rsp(c, 9, 160); mc_vex256(c, 1, 6, 9, 6, 0x58); mc_vex256(c, 1, 6, 15, 6, 0x59); mc_vex256(c, 1, 0, 0, 6, 0x58)
        _mc_vld_rsp(c, 9, 192); mc_vex256(c, 1, 7, 9, 7, 0x58); mc_vex256(c, 1, 7, 15, 7, 0x59); mc_vex256(c, 1, 1, 1, 7, 0x58)
        _mc_vld_rsp(c, 9, 224); mc_vex256(c, 1, 8, 9, 8, 0x58); mc_vex256(c, 1, 8, 15, 8, 0x59); mc_vex256(c, 1, 2, 2, 8, 0x58)
        mc_b3(c, 0x48, 0xFF, 0xC9)
        j_rks := mc_jmp32(c); mc_patch_rel32(c, j_rks, lp_rk_s)
        mc_patch_rel32(c, jle_rks_dn, buf_len(c))
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b1(c, 0x06)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x4E, 32)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x56, 64)
        _mc_vld_rsp(c, 9, 256)
        mc_vex256(c, 1, 9, 9, 0, 0x58); mc_vex256(c, 1, 9, 9, 1, 0x58); mc_vex256(c, 1, 9, 9, 2, 0x58)
        _mc_vst_rsp(c, 256, 9)
        mc_b4(c, 0x48, 0x83, 0xC6, 96); mc_b3(c, 0x48, 0xFF, 0xCA)
        jnz_rkg := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_rkg, lp_rk_g)
        _mc_vld_rsp(c, 9, 256)
        _mc_vhsum_pd_to_xmm0(c, 9)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_rk_end := mc_jmp32(c)

        // Scalar fallback for `--simd=scalar` (exact same 96B-per-4-group SoA layout!)
        mc_patch_rel32(c, jz_rk_sc, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xC6) // RSI = xyz
        lp_rks_g := buf_len(c)
        mc_b3(c, 0x45, 0x31, 0xF6) // R14 = lane 0..3
        lp_rks_l := buf_len(c)
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x10); mc_b2(c, 0x0C, 0xF6)     // XMM1 = x ([RSI+R14*8])
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x10); mc_b3(c, 0x54, 0xF6, 32) // XMM2 = y
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x10); mc_b3(c, 0x5C, 0xF6, 64) // XMM3 = z
        mc_b3(c, 0x4C, 0x89, 0xC9) // RCX = steps
        lp_rks_s := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xC9); jle_rkss_dn := mc_jcc32(c, 0x8E)
        // Helper inline via 4 stages: XMM4,5,6=cur(x,y,z), XMM7,8,9=k, XMM10,11,12=sum_k, XMM13=tmp
        // Stage 1:
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xFA); mc_b4(c, 0xF2, 0x0F, 0x5C, 0xF9); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0x3A) // XMM7=sig*(y-x)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x42, 8); mc_b4(c, 0xF2, 0x44, 0x0F, 0x5C); mc_b1(c, 0xC3)
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x59); mc_b1(c, 0xC1); mc_b4(c, 0xF2, 0x44, 0x0F, 0x5C); mc_b1(c, 0xC2) // XMM8=x*(rho-z)-y
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b1(c, 0xC9); mc_b4(c, 0xF2, 0x44, 0x0F, 0x59); mc_b1(c, 0xCA)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x6A, 16); mc_b4(c, 0xF2, 0x44, 0x0F, 0x59); mc_b1(c, 0xEB); mc_b4(c, 0xF2, 0x45, 0x0F, 0x5C); mc_b1(c, 0xCD) // XMM9=x*y-beta*z
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b1(c, 0xD7); mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b1(c, 0xD8); mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b1(c, 0xE1)
        // (XMM4,5,6) = (1,2,3) + hdt*(7,8,9)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xE7); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x62, 32); mc_b4(c, 0xF2, 0x0F, 0x58, 0xE1)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b1(c, 0xE8); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x6A, 32); mc_b4(c, 0xF2, 0x0F, 0x58, 0xEA)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b1(c, 0xF1); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x72, 32); mc_b4(c, 0xF2, 0x0F, 0x58, 0xF3)
        // Stages 2, 3, 4 via loop in codegen
        mut rk_st := 2
        while rk_st <= 4 {
            mc_b4(c, 0xF2, 0x0F, 0x10, 0xFD); mc_b4(c, 0xF2, 0x0F, 0x5C, 0xFC); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0x3A)
            mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x42, 8); mc_b4(c, 0xF2, 0x44, 0x0F, 0x5C); mc_b1(c, 0xC6)
            mc_b4(c, 0xF2, 0x44, 0x0F, 0x59); mc_b1(c, 0xC4); mc_b4(c, 0xF2, 0x44, 0x0F, 0x5C); mc_b1(c, 0xC5)
            mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b1(c, 0xCC); mc_b4(c, 0xF2, 0x44, 0x0F, 0x59); mc_b1(c, 0xCD)
            mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x6A, 16); mc_b4(c, 0xF2, 0x44, 0x0F, 0x59); mc_b1(c, 0xEE); mc_b4(c, 0xF2, 0x45, 0x0F, 0x5C); mc_b1(c, 0xCD)
            if rk_st < 4 {
                // sum_k += 2*k
                mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b1(c, 0xEF); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xEF); mc_b4(c, 0xF2, 0x45, 0x0F, 0x58); mc_b1(c, 0xD5)
                mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b1(c, 0xE8); mc_b4(c, 0xF2, 0x45, 0x0F, 0x58); mc_b1(c, 0xE8); mc_b4(c, 0xF2, 0x45, 0x0F, 0x58); mc_b1(c, 0xDD)
                mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b1(c, 0xE9); mc_b4(c, 0xF2, 0x45, 0x0F, 0x58); mc_b1(c, 0xE9); mc_b4(c, 0xF2, 0x45, 0x0F, 0x58); mc_b1(c, 0xE5)
                step_off := if rk_st == 2 { 32 } else { 24 } // hdt or dt
                mc_b4(c, 0xF2, 0x0F, 0x10, 0xE7); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x62, step_off); mc_b4(c, 0xF2, 0x0F, 0x58, 0xE1)
                mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b1(c, 0xE8); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x6A, step_off); mc_b4(c, 0xF2, 0x0F, 0x58, 0xEA)
                mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b1(c, 0xF1); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x72, step_off); mc_b4(c, 0xF2, 0x0F, 0x58, 0xF3)
            } else {
                // sum_k += k4; (1,2,3) += dt6 * sum_k
                mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xD7); mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b2(c, 0x52, 40); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b1(c, 0xCA)
                mc_b4(c, 0xF2, 0x45, 0x0F, 0x58); mc_b1(c, 0xD8); mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b2(c, 0x5A, 40); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b1(c, 0xD3)
                mc_b4(c, 0xF2, 0x45, 0x0F, 0x58); mc_b1(c, 0xE1); mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b2(c, 0x62, 40); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b1(c, 0xDC)
            }
            rk_st += 1
        }
        mc_b3(c, 0x48, 0xFF, 0xC9)
        j_rkss := mc_jmp32(c); mc_patch_rel32(c, j_rkss, lp_rks_s)
        mc_patch_rel32(c, jle_rkss_dn, buf_len(c))
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x11); mc_b2(c, 0x0C, 0xF6)
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x11); mc_b3(c, 0x54, 0xF6, 32)
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x11); mc_b3(c, 0x5C, 0xF6, 64)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1); mc_b4(c, 0xF2, 0x0F, 0x58, 0xC2); mc_b4(c, 0xF2, 0x0F, 0x58, 0xC3)
        mc_b3(c, 0x41, 0xFF, 0xC6); mc_b4(c, 0x41, 0x83, 0xFE, 4)
        jl_rksl := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_rksl, lp_rks_l)
        mc_b4(c, 0x48, 0x83, 0xC6, 96); mc_b3(c, 0x48, 0xFF, 0xCA)
        jnz_rksg := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_rksg, lp_rks_g)

        mc_patch_rel32(c, jmp_rk_end, buf_len(c))
        mc_patch_rel32(c, jle_rk_dn, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0x138)
        cg_reg_helper(cg, h_ai_lorenz_rk4_f64(), s_rk, buf_len(c))
    }
}


fn emit_ai_wave3c_helpers(cg: CodegenCtx) {
    c := cg.code

    // 13. `h_ai_mat4x4_i64_batch(pa, pb, i0, i1) -> i64`: 4-wide AVX2 VPMULDQ 4x4 integer matmul batch!
    if cg_is_helper_used(cg, h_ai_mat4x4_i64_batch()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_m4 := buf_len(cg.rdata)
        mut r := 0
        while r < 4 {
            buf_push_u64(cg.rdata, r * 7 + 0); buf_push_u64(cg.rdata, r * 7 + 1)
            buf_push_u64(cg.rdata, r * 7 + 2); buf_push_u64(cg.rdata, r * 7 + 3)
            r += 1
        }
        r = 0
        while r < 4 {
            mut col := 0
            while col < 4 { buf_push_u64(cg.rdata, if col == r { -1 } else { 0 }); col += 1 }
            r += 1
        }

        mc_align16(c)
        s_m4 := buf_len(c)
        mc_ai_enter(c, 0xB8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = pa
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = pb
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = i0
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = i1
        mc_b3(c, 0x45, 0x31, 0xFF)       // R15 = acc = 0
        mc_b3(c, 0x4D, 0x39, 0xDA); jge_m4_dn := mc_jcc32(c, 0x8D)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_m4_sc := mc_jcc32(c, 0x84)

        cg_lea_rax_rdata(cg, roff_m4); mc_b3(c, 0x49, 0x89, 0xC4) // R12 = &consts
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x04, 0x24)          // Y8  = xor[0]
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x4C, 0x24, 32)      // Y9  = xor[1]
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x54, 0x24, 64)      // Y10 = xor[2]
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x5C, 0x24, 96)      // Y11 = xor[3]
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0xA4, 0x24); mc_u32(c, 128) // Y12 = diag[0]
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0xAC, 0x24); mc_u32(c, 160) // Y13 = diag[1]
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0xB4, 0x24); mc_u32(c, 192) // Y14 = diag[2]
        mc_b3(c, 0x4C, 0x89, 0xD0); mc_b4(c, 0x48, 0xC1, 0xE0, 7) // RAX = i0 * 128
        mc_b4(c, 0x49, 0x8D, 0x34, 0x00)                          // RSI = pa + i0*128
        mc_b4(c, 0x49, 0x8D, 0x3C, 0x01)                          // RDI = pb + i0*128
        mc_b3(c, 0x4C, 0x89, 0xD9); mc_b3(c, 0x4C, 0x29, 0xD1)    // RCX = i1 - i0
        mc_vex256(c, 1, 15, 15, 15, 0xEF)                         // YMM15 = sum = 0

        mc_align16_nop(c)
        lp_m4 := buf_len(c)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b1(c, 0x27)       // Y4 = [RDI+0]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x6F, 32)   // Y5 = [RDI+32]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x77, 64)   // Y6 = [RDI+64]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x7F, 96)   // Y7 = [RDI+96]
        r = 0
        while r < 4 {
            ro := r * 32
            mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x59)
            if ro == 0 { mc_b1(c, 0x06) } else { mc_b2(c, 0x46, ro) }
            mc_vex256(c, 2, 0, 0, 4, 0x28)
            mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x59); mc_b2(c, 0x4E, ro + 8)
            mc_vex256(c, 2, 1, 1, 5, 0x28); mc_vex256(c, 1, 0, 0, 1, 0xD4)
            mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x59); mc_b2(c, 0x56, ro + 16)
            mc_vex256(c, 2, 2, 2, 6, 0x28); mc_vex256(c, 1, 0, 0, 2, 0xD4)
            mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x59); mc_b2(c, 0x5E, ro + 24)
            mc_vex256(c, 2, 3, 3, 7, 0x28); mc_vex256(c, 1, 0, 0, 3, 0xD4)
            mc_vex256(c, 1, 1, 0, 8 + r, 0xEF)
            if r < 3 {
                mc_vex256(c, 1, 2, 0, 12 + r, 0xDB)
            } else {
                mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0xDB); mc_b2(c, 0x94, 0x24); mc_u32(c, 224)
            }
            mc_vex256(c, 1, 15, 15, 1, 0xD4); mc_vex256(c, 1, 15, 15, 2, 0xD4)
            r += 1
        }
        mc_b3(c, 0x48, 0x81, 0xC6); mc_u32(c, 128)
        mc_b3(c, 0x48, 0x81, 0xC7); mc_u32(c, 128)
        mc_b3(c, 0x48, 0xFF, 0xC9)
        jnz_m4 := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_m4, lp_m4)
        mc_vex3(c, 1, 0, 0, 3, 0, 0, 1, 1, 0x39); mc_b2(c, 0xF8, 1)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 1, 0xD4); mc_b1(c, 0xC7)
        mc_b4(c, 0xC5, 0xF1, 0x73, 0xD8); mc_b1(c, 8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0xD4); mc_b1(c, 0xC1)
        mc_b4(c, 0x66, 0x49, 0x0F, 0x7E); mc_b1(c, 0xC7)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_m4_end := mc_jmp32(c)

        mc_patch_rel32(c, jz_m4_sc, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xD0); mc_b4(c, 0x48, 0xC1, 0xE0, 7)
        mc_b4(c, 0x49, 0x8D, 0x34, 0x00); mc_b4(c, 0x49, 0x8D, 0x3C, 0x01)
        mc_b3(c, 0x4C, 0x89, 0xD9); mc_b3(c, 0x4C, 0x29, 0xD1)
        lp_m4s := buf_len(c)
        r = 0
        while r < 4 {
            mut col := 0
            while col < 4 {
                ro := r * 32; co := col * 8
                mc_b4(c, 0x48, 0x8B, 0x46, ro);      mc_b4(c, 0x48, 0x0F, 0xAF, 0x47); mc_b1(c, co)
                mc_b4(c, 0x48, 0x8B, 0x56, ro + 8);  mc_b4(c, 0x48, 0x0F, 0xAF, 0x57); mc_b1(c, 32 + co); mc_b3(c, 0x48, 0x01, 0xD0)
                mc_b4(c, 0x48, 0x8B, 0x56, ro + 16); mc_b4(c, 0x48, 0x0F, 0xAF, 0x57); mc_b1(c, 64 + co); mc_b3(c, 0x48, 0x01, 0xD0)
                mc_b4(c, 0x48, 0x8B, 0x56, ro + 24); mc_b4(c, 0x48, 0x0F, 0xAF, 0x57); mc_b1(c, 96 + co); mc_b3(c, 0x48, 0x01, 0xD0)
                if r == col { mc_b3(c, 0x49, 0x01, 0xC7) }
                mc_b4(c, 0x48, 0x83, 0xF0, r * 7 + col)
                mc_b3(c, 0x49, 0x01, 0xC7)
                col += 1
            }
            r += 1
        }
        mc_b3(c, 0x48, 0x81, 0xC6); mc_u32(c, 128); mc_b3(c, 0x48, 0x81, 0xC7); mc_u32(c, 128)
        mc_b3(c, 0x48, 0xFF, 0xC9)
        jnz_m4s := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_m4s, lp_m4s)

        mc_patch_rel32(c, jmp_m4_end, buf_len(c))
        mc_patch_rel32(c, jge_m4_dn, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xF8)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_mat4x4_i64_batch(), s_m4, buf_len(c))
    }

    // 14. `h_ai_nbody_sim_f64(px, py, pz, vx, vy, vz, pm, n_steps_packed) -> f64`
    if cg_is_helper_used(cg, h_ai_nbody_sim_f64()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_nb := buf_len(cg.rdata)
        buf_push_u64(cg.rdata, 0x3F847AE147AE147B) // +0:  0.01 (softening & dt)
        buf_push_u64(cg.rdata, 0x3FF0000000000000) // +8:  1.0
        buf_push_u64(cg.rdata, 0x3FF8000000000000) // +16: 1.5
        buf_push_u64(cg.rdata, 0x3FE0000000000000) // +24: 0.5
        // +32: mask[0] (i&3==0 -> lanes 1,2,3 active: [0, 1, 1, 1])
        buf_push_u64(cg.rdata, 0); buf_push_u64(cg.rdata, 0x3FF0000000000000); buf_push_u64(cg.rdata, 0x3FF0000000000000); buf_push_u64(cg.rdata, 0x3FF0000000000000)
        // +64: mask[1] (i&3==1 -> lanes 2,3 active: [0, 0, 1, 1])
        buf_push_u64(cg.rdata, 0); buf_push_u64(cg.rdata, 0); buf_push_u64(cg.rdata, 0x3FF0000000000000); buf_push_u64(cg.rdata, 0x3FF0000000000000)
        // +96: mask[2] (i&3==2 -> lane 3 active: [0, 0, 0, 1])
        buf_push_u64(cg.rdata, 0); buf_push_u64(cg.rdata, 0); buf_push_u64(cg.rdata, 0); buf_push_u64(cg.rdata, 0x3FF0000000000000)

        mc_align16(c)
        s_nb := buf_len(c)
        // Stack 0x0D08 (< 4096B, 1 page!): [0..159]=XMM6..15, [160..215]=px..pm, [256..1279]=ax[128], [1280..2303]=ay[128], [2304..3327]=az[128]
        mc_ai_enter(c, 0x0D08)
        _mc_save_xmm6_15_rsp(c, 0)
        mut ai := 0
        while ai < 7 {
            mc_b4(c, 0x48, 0x8B, 0x41, ai * 8)
            mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 160 + ai * 8)
            ai += 1
        }
        mc_b4(c, 0x48, 0x8B, 0x41, 56)         // RAX = (n << 32) | steps
        mc_b3(c, 0x49, 0x89, 0xC6); mc_b3(c, 0x45, 0x89, 0xF6) // R14 = steps
        mc_b4(c, 0x48, 0xC1, 0xE8, 32); mc_b3(c, 0x49, 0x89, 0xC7) // R15 = n
        mc_b4(c, 0x4C, 0x8B, 0x84, 0x24); mc_u32(c, 160) // R8  = px
        mc_b4(c, 0x4C, 0x8B, 0x8C, 0x24); mc_u32(c, 168) // R9  = py
        mc_b4(c, 0x4C, 0x8B, 0x94, 0x24); mc_u32(c, 176) // R10 = pz
        mc_b4(c, 0x4C, 0x8B, 0x9C, 0x24); mc_u32(c, 208) // R11 = pm
        cg_lea_rax_rdata(cg, roff_nb); mc_b3(c, 0x49, 0x89, 0xC5) // R13 = &consts

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_nb_sc := mc_jcc32(c, 0x84)
        mc_b3(c, 0x49, 0x81, 0xFF); mc_u32(c, 128); jg_nb_sc2 := mc_jcc32(c, 0x8F)
        mc_b4(c, 0x41, 0xF6, 0xC7, 3); jnz_nb_sc3 := mc_jcc32(c, 0x85)

        // ===== AVX2 Fused 32B-Aligned Newton's 3rd Law (ZERO store-forward stalls, ZERO scalar sqrt/div, ZERO barriers!) =====
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x4D, 16) // Y9 = 1.5 x4
        lp_nb_st := buf_len(c)
        mc_b3(c, 0x4D, 0x85, 0xF6); jle_nb_dn := mc_jcc32(c, 0x8E)
        // Zero ax, ay, az
        mc_vex256(c, 1, 0, 0, 0, 0x57)
        mc_b2(c, 0x31, 0xC9)
        lp_nb_z := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xF9); jge_nb_zd := mc_jcc8(c, 0x7D)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x84, 0xCC); mc_u32(c, 256)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x84, 0xCC); mc_u32(c, 1280)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x84, 0xCC); mc_u32(c, 2304)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); j_nbz := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_nbz, lp_nb_z)
        mc_patch_jcc8(c, jge_nb_zd, buf_len(c))

        // Outer loop i = 0 .. n-2
        mc_b2(c, 0x31, 0xFF) // RDI = i = 0
        mc_b4(c, 0x49, 0x8D, 0x77, 0xFF) // RSI = n - 1
        lp_nb_i := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xF7); jge_nb_idn := mc_jcc32(c, 0x8D)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x14, 0xF8) // Y10 = bcast(px[i])
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x1C, 0xF9) // Y11 = bcast(py[i])
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x24, 0xFA) // Y12 = bcast(pz[i])
        mc_vex256(c, 1, 13, 13, 13, 0x57); mc_vex256(c, 1, 14, 14, 14, 0x57); mc_vex256(c, 1, 15, 15, 15, 0x57)

        // First aligned block j = i & (-4): if (i & 3) != 3, process masked vector (ZERO scalar sqrt/div!)
        mc_b3(c, 0x48, 0x89, 0xF8); mc_b4(c, 0x48, 0x83, 0xE0, 3) // RAX = rem = i & 3
        mc_b4(c, 0x48, 0x83, 0xF8, 3); je_nb_full := mc_jcc32(c, 0x84)
        mc_b3(c, 0x48, 0x89, 0xF9); mc_b4(c, 0x48, 0x83, 0xE1, 0xFC) // RCX = i & (-4)
        mc_b4(c, 0x48, 0xC1, 0xE0, 5) // RAX = rem * 32 (mask offset: 0, 32, 64 -> [R13 + RAX + 32])
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xC8); mc_vex256(c, 1, 0, 0, 10, 0x5C)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x0C, 0xC9); mc_vex256(c, 1, 1, 1, 11, 0x5C)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x14, 0xCA); mc_vex256(c, 1, 2, 2, 12, 0x5C)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x5D, 0)
        mc_vex3(c, 0, 0, 0, 2, 1, 0, 1, 1, 0xB8); mc_b1(c, 0xD8)
        mc_vex3(c, 0, 0, 0, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xD9)
        mc_vex3(c, 0, 0, 0, 2, 1, 2, 1, 1, 0xB8); mc_b1(c, 0xDA)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x5A); mc_b1(c, 0xE3)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0x52); mc_b1(c, 0xE4)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x5A); mc_b1(c, 0xE4)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x6D, 24)
        mc_vex256(c, 1, 3, 3, 5, 0x59)
        mc_vex256(c, 1, 5, 4, 4, 0x59); mc_vex3(c, 0, 0, 1, 2, 1, 3, 1, 1, 0xAC); mc_b1(c, 0xE9); mc_vex256(c, 1, 4, 4, 5, 0x59)
        mc_vex256(c, 1, 5, 4, 4, 0x59); mc_vex3(c, 0, 0, 1, 2, 1, 3, 1, 1, 0xAC); mc_b1(c, 0xE9); mc_vex256(c, 1, 4, 4, 5, 0x59)
        mc_vex256(c, 1, 3, 4, 4, 0x59); mc_vex256(c, 1, 3, 3, 4, 0x59)
        // Multiply inv3 by lane mask [R13 + RAX + 32] (zeros lanes <= i!)
        mc_vex3(c, 0, 0, 1, 1, 0, 3, 1, 1, 0x59); mc_b3(c, 0x5C, 0x05, 32) // VMULPD Y3, Y3, [R13+RAX+32]
        mc_vex3(c, 0, 0, 1, 1, 0, 3, 1, 1, 0x59); mc_b2(c, 0x24, 0xCB)
        mc_vex3(c, 1, 0, 0, 2, 1, 0, 1, 1, 0xB8); mc_b1(c, 0xEC)
        mc_vex3(c, 1, 0, 0, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xF4)
        mc_vex3(c, 1, 0, 0, 2, 1, 2, 1, 1, 0xB8); mc_b1(c, 0xFC)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x2C, 0xFB)
        mc_vex256(c, 1, 5, 5, 3, 0x59)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0xB4, 0xCC); mc_u32(c, 256)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0xBC, 0xCC); mc_u32(c, 1280)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x84, 0xCC); mc_u32(c, 2304)
        mc_vex3(c, 0, 0, 0, 2, 1, 0, 1, 1, 0xBC); mc_b1(c, 0xF5)
        mc_vex3(c, 0, 0, 0, 2, 1, 1, 1, 1, 0xBC); mc_b1(c, 0xFD)
        mc_vex3(c, 1, 0, 0, 2, 1, 2, 1, 1, 0xBC); mc_b1(c, 0xC5)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0xB4, 0xCC); mc_u32(c, 256)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0xBC, 0xCC); mc_u32(c, 1280)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x84, 0xCC); mc_u32(c, 2304)

        // Full aligned vector loop: j = (i + 4) & (-4) .. n - 4 (ALL 32B aligned -> ZERO store-forwarding stalls!)
        mc_patch_rel32(c, je_nb_full, buf_len(c))
        mc_b4(c, 0x48, 0x8D, 0x4F, 4); mc_b4(c, 0x48, 0x83, 0xE1, 0xFC) // RCX = (i + 4) & (-4)
        mc_align16_nop(c)
        lp_nb_jv := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xF9); jge_nb_jt := mc_jcc32(c, 0x8D)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xC8); mc_vex256(c, 1, 0, 0, 10, 0x5C)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x0C, 0xC9); mc_vex256(c, 1, 1, 1, 11, 0x5C)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x14, 0xCA); mc_vex256(c, 1, 2, 2, 12, 0x5C)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x5D, 0)
        mc_vex3(c, 0, 0, 0, 2, 1, 0, 1, 1, 0xB8); mc_b1(c, 0xD8)
        mc_vex3(c, 0, 0, 0, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xD9)
        mc_vex3(c, 0, 0, 0, 2, 1, 2, 1, 1, 0xB8); mc_b1(c, 0xDA)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x5A); mc_b1(c, 0xE3)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0x52); mc_b1(c, 0xE4)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x5A); mc_b1(c, 0xE4)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x6D, 24)
        mc_vex256(c, 1, 3, 3, 5, 0x59)
        mc_vex256(c, 1, 5, 4, 4, 0x59); mc_vex3(c, 0, 0, 1, 2, 1, 3, 1, 1, 0xAC); mc_b1(c, 0xE9); mc_vex256(c, 1, 4, 4, 5, 0x59)
        mc_vex256(c, 1, 5, 4, 4, 0x59); mc_vex3(c, 0, 0, 1, 2, 1, 3, 1, 1, 0xAC); mc_b1(c, 0xE9); mc_vex256(c, 1, 4, 4, 5, 0x59)
        mc_vex256(c, 1, 3, 4, 4, 0x59); mc_vex256(c, 1, 3, 3, 4, 0x59)
        mc_vex3(c, 0, 0, 1, 1, 0, 3, 1, 1, 0x59); mc_b2(c, 0x24, 0xCB)
        mc_vex3(c, 1, 0, 0, 2, 1, 0, 1, 1, 0xB8); mc_b1(c, 0xEC)
        mc_vex3(c, 1, 0, 0, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xF4)
        mc_vex3(c, 1, 0, 0, 2, 1, 2, 1, 1, 0xB8); mc_b1(c, 0xFC)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x2C, 0xFB)
        mc_vex256(c, 1, 5, 5, 3, 0x59)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0xB4, 0xCC); mc_u32(c, 256)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0xBC, 0xCC); mc_u32(c, 1280)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x84, 0xCC); mc_u32(c, 2304)
        mc_vex3(c, 0, 0, 0, 2, 1, 0, 1, 1, 0xBC); mc_b1(c, 0xF5)
        mc_vex3(c, 0, 0, 0, 2, 1, 1, 1, 1, 0xBC); mc_b1(c, 0xFD)
        mc_vex3(c, 1, 0, 0, 2, 1, 2, 1, 1, 0xBC); mc_b1(c, 0xC5)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0xB4, 0xCC); mc_u32(c, 256)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0xBC, 0xCC); mc_u32(c, 1280)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x84, 0xCC); mc_u32(c, 2304)
        mc_b4(c, 0x48, 0x83, 0xC1, 4)
        j_nbjv := mc_jmp32(c); mc_patch_rel32(c, j_nbjv, lp_nb_jv)

        // Commit horizontal sums of Y13, Y14, Y15 into ax[i], ay[i], az[i]
        mc_patch_rel32(c, jge_nb_jt, buf_len(c))
        _mc_vhsum_pd_to_xmm0(c, 13)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x84, 0xFC); mc_u32(c, 256)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x84, 0xFC); mc_u32(c, 256)
        _mc_vhsum_pd_to_xmm0(c, 14)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x84, 0xFC); mc_u32(c, 1280)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x84, 0xFC); mc_u32(c, 1280)
        _mc_vhsum_pd_to_xmm0(c, 15)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x84, 0xFC); mc_u32(c, 2304)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x84, 0xFC); mc_u32(c, 2304)
        mc_b3(c, 0x48, 0xFF, 0xC7); j_nbi := mc_jmp32(c); mc_patch_rel32(c, j_nbi, lp_nb_i)
        mc_patch_rel32(c, jge_nb_idn, buf_len(c))

        // Vectorized 4-wide velocity + position update (24 iters for n=96!)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 184) // RAX = vx
        mc_b4(c, 0x48, 0x8B, 0x94, 0x24); mc_u32(c, 192) // RDX = vy
        mc_b4(c, 0x48, 0x8B, 0x9C, 0x24); mc_u32(c, 200) // RBX = vz
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x7D, 0) // Y7 = dt = 0.01 x4
        mc_b2(c, 0x31, 0xC9)
        lp_nb_up := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xF9); jge_nb_upd := mc_jcc32(c, 0x8D)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xC8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x8C, 0xCC); mc_u32(c, 256)
        mc_vex3(c, 0, 0, 0, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xC7)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x04, 0xC8)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x14, 0xC8)
        mc_vex3(c, 0, 0, 0, 2, 1, 0, 1, 1, 0xB8); mc_b1(c, 0xD7)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x14, 0xC8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xCA)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x8C, 0xCC); mc_u32(c, 1280)
        mc_vex3(c, 0, 0, 0, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xC7)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x04, 0xCA)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x14, 0xC9)
        mc_vex3(c, 0, 0, 0, 2, 1, 0, 1, 1, 0xB8); mc_b1(c, 0xD7)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x14, 0xC9)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xCB)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x8C, 0xCC); mc_u32(c, 2304)
        mc_vex3(c, 0, 0, 0, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xC7)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x04, 0xCB)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x14, 0xCA)
        mc_vex3(c, 0, 0, 0, 2, 1, 0, 1, 1, 0xB8); mc_b1(c, 0xD7)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x14, 0xCA)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); j_nbup := mc_jmp32(c); mc_patch_rel32(c, j_nbup, lp_nb_up)
        mc_patch_rel32(c, jge_nb_upd, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xCE); j_nbst := mc_jmp32(c); mc_patch_rel32(c, j_nbst, lp_nb_st)
        mc_patch_rel32(c, jle_nb_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_nb_sum := mc_jmp32(c)

        // ===== Scalar SSE2 fallback =====
        mc_patch_rel32(c, jz_nb_sc, buf_len(c))
        mc_patch_rel32(c, jg_nb_sc2, buf_len(c))
        mc_patch_rel32(c, jnz_nb_sc3, buf_len(c))
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x7D, 0)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x75, 8)
        lp_nbs_st := buf_len(c)
        mc_b3(c, 0x4D, 0x85, 0xF6); jle_nbs_dn := mc_jcc32(c, 0x8E)
        mc_b2(c, 0x31, 0xFF)
        lp_nbs_i := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xFF); jge_nbs_idn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x04, 0xF8)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x0C, 0xF9)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x14, 0xFA)
        mc_b4(c, 0x66, 0x45, 0x0F, 0x57); mc_b1(c, 0xDB)
        mc_b4(c, 0x66, 0x45, 0x0F, 0x57); mc_b1(c, 0xE4)
        mc_b4(c, 0x66, 0x45, 0x0F, 0x57); mc_b1(c, 0xED)
        mc_b2(c, 0x31, 0xC9)
        lp_nbs_j := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xF9); jge_nbs_jdn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x04, 0xC8); mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b1(c, 0xC0)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xC9); mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b1(c, 0xC9)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x14, 0xCA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b1(c, 0xD2)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xD8); mc_b4(c, 0xF2, 0x0F, 0x59, 0xD8)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xE1); mc_b4(c, 0xF2, 0x0F, 0x59, 0xE1); mc_b4(c, 0xF2, 0x0F, 0x58, 0xDC)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xE2); mc_b4(c, 0xF2, 0x0F, 0x59, 0xE2); mc_b4(c, 0xF2, 0x0F, 0x58, 0xDC)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b1(c, 0xDF)
        mc_b4(c, 0xF2, 0x0F, 0x51, 0xE3); mc_b4(c, 0xF2, 0x0F, 0x59, 0xDC)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b1(c, 0xE6); mc_b4(c, 0xF2, 0x0F, 0x5E, 0xE3)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x24, 0xCB)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xC4); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xD8)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xCC); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xE1)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xD4); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xEA)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_nbsj := mc_jmp32(c); mc_patch_rel32(c, j_nbsj, lp_nbs_j)
        mc_patch_rel32(c, jge_nbs_jdn, buf_len(c))
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b1(c, 0xDF)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b1(c, 0xE7)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b1(c, 0xEF)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 184); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b2(c, 0x1C, 0xF8); mc_b4(c, 0xF2, 0x44, 0x0F, 0x11); mc_b2(c, 0x1C, 0xF8)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 192); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b2(c, 0x24, 0xF8); mc_b4(c, 0xF2, 0x44, 0x0F, 0x11); mc_b2(c, 0x24, 0xF8)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 200); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b2(c, 0x2C, 0xF8); mc_b4(c, 0xF2, 0x44, 0x0F, 0x11); mc_b2(c, 0x2C, 0xF8)
        mc_b3(c, 0x48, 0xFF, 0xC7); j_nbsi := mc_jmp32(c); mc_patch_rel32(c, j_nbsi, lp_nbs_i)
        mc_patch_rel32(c, jge_nbs_idn, buf_len(c))
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 184)
        mc_b4(c, 0x48, 0x8B, 0x94, 0x24); mc_u32(c, 192)
        mc_b4(c, 0x48, 0x8B, 0x9C, 0x24); mc_u32(c, 200)
        mc_b2(c, 0x31, 0xC9)
        lp_nbs_up := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xF9); jge_nbs_upd := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x04); mc_b1(c, 0xC8); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xC7); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x04, 0xC8); mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x04, 0xC8)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x04); mc_b1(c, 0xCA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xC7); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x04, 0xC9); mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x04, 0xC9)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x04); mc_b1(c, 0xCB); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xC7); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x04, 0xCA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x04, 0xCA)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_nbsup := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_nbsup, lp_nbs_up)
        mc_patch_jcc8(c, jge_nbs_upd, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xCE); j_nbsst := mc_jmp32(c); mc_patch_rel32(c, j_nbsst, lp_nbs_st)
        mc_patch_rel32(c, jle_nbs_dn, buf_len(c))

        // Final position sum -> XMM0 AND RAX (Axon ABI returns f64 bits in RAX!)
        mc_patch_rel32(c, jmp_nb_sum, buf_len(c))
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0)
        mc_b2(c, 0x31, 0xC9)
        lp_nb_sum := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xF9); jge_nb_sdn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x04, 0xC8)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x04, 0xC9)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x04, 0xCA)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_nbsum := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_nbsum, lp_nb_sum)
        mc_patch_jcc8(c, jge_nb_sdn, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0) // MOVQ RAX, XMM0!
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0x0D08)
        cg_reg_helper(cg, h_ai_nbody_sim_f64(), s_nb, buf_len(c))
    }

    // 15. `h_ai_newton_cubic_f64(a_arr, b_arr, n, iters) -> f64`
    if cg_is_helper_used(cg, h_ai_newton_cubic_f64()) {
        while (buf_len(cg.rdata) & 15) != 0 { buf_push(cg.rdata, 0) }
        roff_nc := buf_len(cg.rdata)
        buf_push_u64(cg.rdata, 0x3FF8000000000000) // +0: 1.5
        buf_push_u64(cg.rdata, 0x4008000000000000) // +8: 3.0

        mc_align16(c)
        s_nc := buf_len(c)
        mc_ai_enter(c, 0xB8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = a_arr
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = b_arr
        mc_b4(c, 0x48, 0x8B, 0x51, 16)   // RDX = n
        mc_b4(c, 0x4C, 0x8B, 0x51, 24)   // R10 = iters
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) // XMM0 = 0.0
        mc_b2(c, 0x31, 0xC9)             // RCX = i = 0
        mc_b3(c, 0x48, 0x85, 0xD2); jle_nc_dn := mc_jcc32(c, 0x8E)

        cg_lea_rax_rdata(cg, roff_nc); mc_b3(c, 0x49, 0x89, 0xC3)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_nc_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x4C, 0x8D, 0x62, 0xFC)
        mc_b3(c, 0x4C, 0x39, 0xE1); jg_nc_tail := mc_jcc32(c, 0x8F)

        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x13)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x5B, 8)
        mc_vex256(c, 1, 15, 15, 15, 0x57)

        mc_align16_nop(c)
        lp_nc4 := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x0C, 0xC8)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x14, 0xC9)
        mc_vex256(c, 1, 0, 10, 10, 0xEB)
        mc_b3(c, 0x4C, 0x89, 0xD6)
        lp_nck := buf_len(c)
        mc_vex256(c, 1, 3, 0, 0, 0x59)
        mc_vex256(c, 1, 4, 3, 0, 0x59)
        mc_vex256(c, 1, 5, 1, 0, 0x59)
        mc_vex256(c, 1, 4, 4, 5, 0x58); mc_vex256(c, 1, 4, 4, 2, 0x5C)
        mc_vex256(c, 1, 3, 11, 3, 0x59); mc_vex256(c, 1, 3, 3, 1, 0x58)
        mc_vex256(c, 1, 4, 4, 3, 0x5E)
        mc_vex256(c, 1, 0, 0, 4, 0x5C)
        mc_b3(c, 0x48, 0xFF, 0xCE)
        jnz_nck := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_nck, lp_nck)
        mc_vex256(c, 1, 15, 15, 0, 0x58)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b3(c, 0x4C, 0x39, 0xE1)
        jle_nc4 := mc_jcc8(c, 0x7E); mc_patch_jcc8(c, jle_nc4, lp_nc4)
        _mc_vhsum_pd_to_xmm0(c, 15)
        mc_b3(c, 0xC5, 0xF8, 0x77)

        mc_patch_rel32(c, jg_nc_tail, buf_len(c))
        mc_patch_rel32(c, jz_nc_sc, buf_len(c))
        lp_ncs := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD1); jge_ncs_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b1(c, 0x0B)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x14, 0xC8)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x1C, 0xC9)
        mc_b3(c, 0x4C, 0x89, 0xD6)
        lp_ncsk := buf_len(c)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xE1); mc_b4(c, 0xF2, 0x0F, 0x59, 0xE1)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xEC); mc_b4(c, 0xF2, 0x0F, 0x59, 0xE9)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xF2); mc_b4(c, 0xF2, 0x0F, 0x59, 0xF1)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xEE); mc_b4(c, 0xF2, 0x0F, 0x5C, 0xEB)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x63, 8); mc_b4(c, 0xF2, 0x0F, 0x58, 0xE2)
        mc_b4(c, 0xF2, 0x0F, 0x5E, 0xEC); mc_b4(c, 0xF2, 0x0F, 0x5C, 0xCD)
        mc_b3(c, 0x48, 0xFF, 0xCE); jnz_ncsk := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_ncsk, lp_ncsk)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_ncs := mc_jmp32(c); mc_patch_rel32(c, j_ncs, lp_ncs)

        mc_patch_rel32(c, jge_ncs_dn, buf_len(c))
        mc_patch_rel32(c, jle_nc_dn, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_newton_cubic_f64(), s_nc, buf_len(c))
    }

    // 16. `h_ai_gl16_poly_f64(a_arr, b_arr, gx, gw, n) -> f64`
    if cg_is_helper_used(cg, h_ai_gl16_poly_f64()) {
        while (buf_len(cg.rdata) & 15) != 0 { buf_push(cg.rdata, 0) }
        roff_gl := buf_len(cg.rdata)
        buf_push_u64(cg.rdata, 0x3FF0000000000000) // +0: 1.0
        buf_push_u64(cg.rdata, 0x3FE0000000000000) // +8: 0.5

        mc_align16(c)
        s_gl := buf_len(c)
        mc_ai_enter(c, 0x1B8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = a_arr
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = b_arr
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = gx
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = gw
        mc_b4(c, 0x48, 0x8B, 0x51, 32)   // RDX = n
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0)
        mc_b2(c, 0x31, 0xC9)
        mc_b3(c, 0x48, 0x85, 0xD2); jle_gl_dn := mc_jcc32(c, 0x8E)

        cg_lea_rax_rdata(cg, roff_gl); mc_b3(c, 0x49, 0x89, 0xC5)
        mut k := 0
        while k < 8 {
            mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x4D, 0)
            mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x4A, k * 8)
            mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x4D, 8)
            mc_b4(c, 0xF2, 0x0F, 0x10, 0xD1); mc_b4(c, 0xF2, 0x0F, 0x59, 0xD1)
            mc_b4(c, 0xF2, 0x0F, 0x11, 0x94); mc_b1(c, 0x24); mc_u32(c, 160 + k * 8)
            mc_b4(c, 0xF2, 0x0F, 0x59, 0xD1)
            mc_b4(c, 0xF2, 0x0F, 0x11, 0x94); mc_b1(c, 0x24); mc_u32(c, 224 + k * 8)
            mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x4D, 0)
            mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b2(c, 0x4A, k * 8)
            mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x4D, 8)
            mc_b4(c, 0xF2, 0x0F, 0x10, 0xD1); mc_b4(c, 0xF2, 0x0F, 0x59, 0xD1)
            mc_b4(c, 0xF2, 0x0F, 0x11, 0x94); mc_b1(c, 0x24); mc_u32(c, 288 + k * 8)
            mc_b4(c, 0xF2, 0x0F, 0x59, 0xD1)
            mc_b4(c, 0xF2, 0x0F, 0x11, 0x94); mc_b1(c, 0x24); mc_u32(c, 352 + k * 8)
            k += 1
        }

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_gl_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x4C, 0x8D, 0x62, 0xFC)
        mc_b3(c, 0x4C, 0x39, 0xE1); jg_gl_tail := mc_jcc32(c, 0x8F)

        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x55, 0)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x5D, 8)
        mc_vex256(c, 1, 15, 15, 15, 0x57)

        mc_align16_nop(c)
        lp_gl4 := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x0C, 0xC8)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x14, 0xC9)
        mc_vex256(c, 1, 0, 0, 0, 0x57)
        k = 0
        while k < 8 {
            mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x9C, 0x24); mc_u32(c, 160 + k * 8)
            mc_vex256(c, 1, 3, 1, 3, 0x59); mc_vex256(c, 1, 3, 10, 3, 0x58); mc_vex256(c, 1, 3, 10, 3, 0x5E)
            mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0xA4, 0x24); mc_u32(c, 224 + k * 8)
            mc_vex256(c, 1, 4, 2, 4, 0x59); mc_vex256(c, 1, 3, 3, 4, 0x58)
            mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0xAC, 0x24); mc_u32(c, 288 + k * 8)
            mc_vex256(c, 1, 5, 1, 5, 0x59); mc_vex256(c, 1, 5, 10, 5, 0x58); mc_vex256(c, 1, 5, 10, 5, 0x5E)
            mc_vex256(c, 1, 3, 3, 5, 0x58)
            mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0xB4, 0x24); mc_u32(c, 352 + k * 8)
            mc_vex256(c, 1, 6, 2, 6, 0x59); mc_vex256(c, 1, 3, 3, 6, 0x58)
            mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19)
            if k == 0 { mc_b1(c, 0x23) } else { mc_b2(c, 0x63, k * 8) }
            mc_vex256(c, 1, 3, 4, 3, 0x59); mc_vex256(c, 1, 0, 0, 3, 0x58)
            k += 1
        }
        mc_vex256(c, 1, 0, 11, 0, 0x59); mc_vex256(c, 1, 15, 15, 0, 0x58)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b3(c, 0x4C, 0x39, 0xE1)
        jle_gl4 := mc_jcc32(c, 0x8E); mc_patch_rel32(c, jle_gl4, lp_gl4)
        _mc_vhsum_pd_to_xmm0(c, 15)
        mc_b3(c, 0xC5, 0xF8, 0x77)

        mc_patch_rel32(c, jg_gl_tail, buf_len(c))
        mc_patch_rel32(c, jz_gl_sc, buf_len(c))
        lp_gls := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD1); jge_gls_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xC8)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x14, 0xC9)
        mc_b4(c, 0x66, 0x0F, 0x57, 0xDB)
        k = 0
        while k < 8 {
            mc_b4(c, 0xF2, 0x0F, 0x10, 0xE1); mc_b4(c, 0xF2, 0x0F, 0x59, 0xA4); mc_b1(c, 0x24); mc_u32(c, 160 + k * 8)
            mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x65, 0)
            mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x6D, 0); mc_b4(c, 0xF2, 0x0F, 0x5E, 0xEC)
            mc_b4(c, 0xF2, 0x0F, 0x10, 0xF2); mc_b4(c, 0xF2, 0x0F, 0x59, 0xB4); mc_b1(c, 0x24); mc_u32(c, 224 + k * 8)
            mc_b4(c, 0xF2, 0x0F, 0x58, 0xEE)
            mc_b4(c, 0xF2, 0x0F, 0x10, 0xE1); mc_b4(c, 0xF2, 0x0F, 0x59, 0xA4); mc_b1(c, 0x24); mc_u32(c, 288 + k * 8)
            mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x65, 0)
            mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x75, 0); mc_b4(c, 0xF2, 0x0F, 0x5E, 0xF4); mc_b4(c, 0xF2, 0x0F, 0x58, 0xEE)
            mc_b4(c, 0xF2, 0x0F, 0x10, 0xF2); mc_b4(c, 0xF2, 0x0F, 0x59, 0xB4); mc_b1(c, 0x24); mc_u32(c, 352 + k * 8)
            mc_b4(c, 0xF2, 0x0F, 0x58, 0xEE)
            mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x6B, k * 8)
            mc_b4(c, 0xF2, 0x0F, 0x58, 0xDD)
            k += 1
        }
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x5D, 8); mc_b4(c, 0xF2, 0x0F, 0x58, 0xC3)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_gls := mc_jmp32(c); mc_patch_rel32(c, j_gls, lp_gls)

        mc_patch_rel32(c, jge_gls_dn, buf_len(c))
        mc_patch_rel32(c, jle_gl_dn, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0x1B8)
        cg_reg_helper(cg, h_ai_gl16_poly_f64(), s_gl, buf_len(c))
    }

    // 17. `h_ai_csr_spmv_f64(rp, ci, val, px, py, r0, r1) -> i64`
    if cg_is_helper_used(cg, h_ai_csr_spmv_f64()) {
        mc_align16(c)
        s_sp := buf_len(c)
        // Caller-saved XMM0..XMM5 ONLY -> ZERO XMM spill/restore!
        mc_ai_enter(c, 0x18)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = rp (0 => compact fixed-8-nnz u32 ci fastpath!)
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = ci
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = val
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = x
        mc_b4(c, 0x4C, 0x8B, 0x61, 32)   // R12 = y
        mc_b4(c, 0x4C, 0x8B, 0x69, 40)   // R13 = r = r0
        mc_b4(c, 0x4C, 0x8B, 0x71, 48)   // R14 = r1
        mc_b3(c, 0x4D, 0x39, 0xF5); jge_sp_dn := mc_jcc32(c, 0x8D)

        mc_b3(c, 0x4D, 0x85, 0xC0); jnz_sp_rp := mc_jcc32(c, 0x85)
        // Compact fixed-8-nnz u32 ci mode (`rp == 0`): halves index bandwidth + 4-wide AVX2 VMULPD+VADDPD!
        mc_b3(c, 0x4C, 0x89, 0xEE); mc_b4(c, 0x48, 0xC1, 0xE6, 5); mc_b3(c, 0x4C, 0x01, 0xCE) // RSI = ci + r0*32
        mc_b3(c, 0x4C, 0x89, 0xEF); mc_b4(c, 0x48, 0xC1, 0xE7, 6); mc_b3(c, 0x4C, 0x01, 0xD7) // RDI = val + r0*64
        mc_b4(c, 0x4F, 0x8D, 0x24, 0xEC)                                                       // R12 = y + r0*8
        mc_b3(c, 0x4D, 0x89, 0xF7); mc_b3(c, 0x4D, 0x29, 0xEF)                                 // R15 = r1 - r0
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_sp32_sc := mc_jcc32(c, 0x84)

        mc_align16_nop(c)
        lp_sp32 := buf_len(c)
        mc_b2(c, 0x8B, 0x06); mc_b3(c, 0x8B, 0x56, 4); mc_b3(c, 0x8B, 0x4E, 8); mc_b3(c, 0x8B, 0x5E, 12)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x04, 0xC3) // VMOVSD X0, [R11+RAX*8]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 1, 0x16); mc_b2(c, 0x04, 0xD3) // VMOVHPD X0, X0, [R11+RDX*8]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x0C, 0xCB) // VMOVSD X1, [R11+RCX*8]
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 0, 1, 0x16); mc_b2(c, 0x0C, 0xDB) // VMOVHPD X1, X1, [R11+RBX*8]
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x18); mc_b2(c, 0xC1, 1)    // VINSERTF128 Y0, Y0, X1, 1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x59); mc_b1(c, 0x07)       // VMULPD Y0, Y0, [RDI]
        mc_b3(c, 0x8B, 0x46, 16); mc_b3(c, 0x8B, 0x56, 20); mc_b3(c, 0x8B, 0x4E, 24); mc_b3(c, 0x8B, 0x5E, 28)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x14, 0xC3) // VMOVSD X2, [R11+RAX*8]
        mc_vex3(c, 0, 0, 1, 1, 0, 2, 0, 1, 0x16); mc_b2(c, 0x14, 0xD3) // VMOVHPD X2, X2, [R11+RDX*8]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x1C, 0xCB) // VMOVSD X3, [R11+RCX*8]
        mc_vex3(c, 0, 0, 1, 1, 0, 3, 0, 1, 0x16); mc_b2(c, 0x1C, 0xDB) // VMOVHPD X3, X3, [R11+RBX*8]
        mc_vex3(c, 0, 0, 0, 3, 0, 2, 1, 1, 0x18); mc_b2(c, 0xD3, 1)    // VINSERTF128 Y2, Y2, X3, 1
        mc_vex3(c, 0, 0, 0, 1, 0, 2, 1, 1, 0x59); mc_b2(c, 0x57, 32)   // VMULPD Y2, Y2, [RDI+32]
        mc_vex256(c, 1, 0, 0, 2, 0x58)                                 // VADDPD Y0, Y0, Y2
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC1, 1)    // VEXTRACTF128 X1, Y0, 1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x58); mc_b1(c, 0xC1)       // VADDPD X0, X0, X1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x15); mc_b1(c, 0xC8)       // VUNPCKHPD X1, X0, X0
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b1(c, 0xC1)       // VADDSD X0, X0, X1
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0x24) // VMOVSD [R12], X0
        mc_b4(c, 0x48, 0x83, 0xC6, 32); mc_b4(c, 0x48, 0x83, 0xC7, 64); mc_b4(c, 0x49, 0x83, 0xC4, 8)
        mc_b3(c, 0x49, 0xFF, 0xCF); jnz_sp32 := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_sp32, lp_sp32)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_sp32_dn1 := mc_jmp32(c)

        mc_patch_rel32(c, jz_sp32_sc, buf_len(c))
        lp_sp32s := buf_len(c)
        mc_b2(c, 0x8B, 0x06); mc_b3(c, 0x8B, 0x56, 4); mc_b3(c, 0x8B, 0x4E, 8); mc_b3(c, 0x8B, 0x5E, 12)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x04, 0xC3)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xD3)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x14, 0xCB)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x1C, 0xDB)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0x07)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0x4F); mc_b1(c, 8)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0x57); mc_b1(c, 16)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0x5F); mc_b1(c, 24)
        mc_b3(c, 0x8B, 0x46, 16); mc_b3(c, 0x8B, 0x56, 20); mc_b3(c, 0x8B, 0x4E, 24); mc_b3(c, 0x8B, 0x5E, 28)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1); mc_b4(c, 0xF2, 0x0F, 0x58, 0xD3)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xC3)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x1C, 0xD3)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x24, 0xCB)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x2C, 0xDB)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0x4F); mc_b1(c, 32)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0x5F); mc_b1(c, 40)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0x67); mc_b1(c, 48)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0x6F); mc_b1(c, 56)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC2); mc_b4(c, 0xF2, 0x0F, 0x58, 0xCB)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xE5); mc_b4(c, 0xF2, 0x0F, 0x58, 0xCC); mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x04, 0x24)
        mc_b4(c, 0x48, 0x83, 0xC6, 32); mc_b4(c, 0x48, 0x83, 0xC7, 64); mc_b4(c, 0x49, 0x83, 0xC4, 8)
        mc_b3(c, 0x49, 0xFF, 0xCF); jnz_sp32s := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_sp32s, lp_sp32s)
        jmp_sp32_dn2 := mc_jmp32(c)

        mc_patch_rel32(c, jnz_sp_rp, buf_len(c))
        mc_align16_nop(c)
        lp_spr := buf_len(c)
        mc_b4(c, 0x4B, 0x8B, 0x34, 0xE8)           // RSI = p0 = rp[r]
        mc_b4(c, 0x4B, 0x8B, 0x7C, 0xE8); mc_b1(c, 8) // RDI = p1 = rp[r+1]
        mc_b3(c, 0x48, 0x89, 0xF8); mc_b3(c, 0x48, 0x29, 0xF0) // RAX = p1 - p0
        mc_b4(c, 0x48, 0x83, 0xF8, 8)
        jne_sp_gen := mc_jcc32(c, 0x85)
        // Fastpath: 8-nnz row -> 8 unrolled scalar loads + 4-way parallel MULSD/ADDSD tree (ZERO VPGATHERQPD!)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xF1)           // RAX = ci[p0+0]
        mc_b4(c, 0x49, 0x8B, 0x54, 0xF1); mc_b1(c, 8)  // RDX = ci[p0+1]
        mc_b4(c, 0x49, 0x8B, 0x4C, 0xF1); mc_b1(c, 16) // RCX = ci[p0+2]
        mc_b4(c, 0x49, 0x8B, 0x5C, 0xF1); mc_b1(c, 24) // RBX = ci[p0+3]
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x04, 0xC3) // X0 = x[c0]
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xD3) // X1 = x[c1]
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x14, 0xCB) // X2 = x[c2]
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x1C, 0xDB) // X3 = x[c3]
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x04, 0xF2)           // X0 *= val[p0+0]
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b3(c, 0x4C, 0xF2, 8)        // X1 *= val[p0+1]
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b3(c, 0x54, 0xF2, 16)       // X2 *= val[p0+2]
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b3(c, 0x5C, 0xF2, 24)       // X3 *= val[p0+3]
        mc_b4(c, 0x49, 0x8B, 0x44, 0xF1); mc_b1(c, 32) // RAX = ci[p0+4]
        mc_b4(c, 0x49, 0x8B, 0x54, 0xF1); mc_b1(c, 40) // RDX = ci[p0+5]
        mc_b4(c, 0x49, 0x8B, 0x4C, 0xF1); mc_b1(c, 48) // RCX = ci[p0+6]
        mc_b4(c, 0x49, 0x8B, 0x5C, 0xF1); mc_b1(c, 56) // RBX = ci[p0+7]
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)               // X0 = p0 + p1
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xD3)               // X2 = p2 + p3
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xC3) // X1 = x[c4]
