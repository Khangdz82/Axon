        mc_b4(c, 0x49, 0x8D, 0x56, 0xFF) // RDX = br - 1
        mc_b3(c, 0x48, 0x85, 0xD2); jle_bnr_dn := mc_jcc32(c, 0x8E)
        // 2-row fused sequential VPADDB: reads row r and r+1 together -> cuts 2KB L1D RMW in HALF!
        mc_align16_nop(c)
        lp_bn_r2 := buf_len(c)
        mc_b4(c, 0x48, 0x83, 0xFA, 2); jl_bn_r1 := mc_jcc32(c, 0x8C)
        mc_b4(c, 0x4A, 0x8D, 0x3C, 0x16) // RDI = RSI + cols (row r+1)
        mc_b2(c, 0x31, 0xC9) // RCX = 0
        lp_bn_c2 := buf_len(c)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x84, 0x0C); mc_u32(c, 160)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x8C, 0x0C); mc_u32(c, 192)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x94, 0x0C); mc_u32(c, 224)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x9C, 0x0C); mc_u32(c, 256)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xFC); mc_b2(c, 0x04, 0x0E)
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 1, 1, 0xFC); mc_b3(c, 0x4C, 0x0E, 32)
        mc_vex3(c, 0, 0, 0, 1, 0, 2, 1, 1, 0xFC); mc_b3(c, 0x54, 0x0E, 64)
        mc_vex3(c, 0, 0, 0, 1, 0, 3, 1, 1, 0xFC); mc_b3(c, 0x5C, 0x0E, 96)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xFC); mc_b2(c, 0x04, 0x0F)
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 1, 1, 0xFC); mc_b3(c, 0x4C, 0x0F, 32)
        mc_vex3(c, 0, 0, 0, 1, 0, 2, 1, 1, 0xFC); mc_b3(c, 0x54, 0x0F, 64)
        mc_vex3(c, 0, 0, 0, 1, 0, 3, 1, 1, 0xFC); mc_b3(c, 0x5C, 0x0F, 96)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x84, 0x0C); mc_u32(c, 160)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x8C, 0x0C); mc_u32(c, 192)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x94, 0x0C); mc_u32(c, 224)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x9C, 0x0C); mc_u32(c, 256)
        mc_b3(c, 0x48, 0x81, 0xC1); mc_u32(c, 128); mc_b3(c, 0x4C, 0x39, 0xD1)
        jl_bnc2 := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_bnc2, lp_bn_c2)
        mc_b4(c, 0x4A, 0x8D, 0x34, 0x17) // RSI = RDI + cols = RSI + 2*cols
        mc_b4(c, 0x48, 0x83, 0xEA, 2); j_bnr2 := mc_jmp32(c); mc_patch_rel32(c, j_bnr2, lp_bn_r2)
        mc_patch_rel32(c, jl_bn_r1, buf_len(c))
        mc_b3(c, 0x48, 0x85, 0xD2); jle_bnr_dn2 := mc_jcc32(c, 0x8E)
        mc_b2(c, 0x31, 0xC9)
        lp_bn_c1 := buf_len(c)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x84, 0x0C); mc_u32(c, 160)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x8C, 0x0C); mc_u32(c, 192)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x94, 0x0C); mc_u32(c, 224)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x9C, 0x0C); mc_u32(c, 256)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xFC); mc_b2(c, 0x04, 0x0E)
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 1, 1, 0xFC); mc_b3(c, 0x4C, 0x0E, 32)
        mc_vex3(c, 0, 0, 0, 1, 0, 2, 1, 1, 0xFC); mc_b3(c, 0x54, 0x0E, 64)
        mc_vex3(c, 0, 0, 0, 1, 0, 3, 1, 1, 0xFC); mc_b3(c, 0x5C, 0x0E, 96)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x84, 0x0C); mc_u32(c, 160)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x8C, 0x0C); mc_u32(c, 192)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x94, 0x0C); mc_u32(c, 224)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x9C, 0x0C); mc_u32(c, 256)
        mc_b3(c, 0x48, 0x81, 0xC1); mc_u32(c, 128); mc_b3(c, 0x4C, 0x39, 0xD1)
        jl_bnc1 := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_bnc1, lp_bn_c1)
        mc_b3(c, 0x4C, 0x01, 0xD6)
        mc_patch_rel32(c, jle_bnr_dn2, buf_len(c))
        mc_patch_rel32(c, jle_bnr_dn, buf_len(c))
