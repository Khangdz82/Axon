        mc_b4(c, 0x48, 0x83, 0xEC, 0x20)
        mc_b3(c, 0x48, 0x89, 0xCB)
        mc_b4(c, 0x4C, 0x8B, 0x61, 0x08)
        mc_b3(c, 0x49, 0xD1, 0xE4)
        mc_b3(c, 0x4D, 0x39, 0xC4)
        jae_je := mc_jcc8(c, 0x73)
        mc_b3(c, 0x4D, 0x89, 0xC4)
        mc_patch_jcc8(c, jae_je, buf_len(c))
        mc_b2(c, 0x41, 0xB9); mc_u32(c, 0x7FFFFFF0)
        mc_b3(c, 0x4D, 0x39, 0xCC)
        jbe_je := mc_jcc8(c, 0x76)
        mc_b3(c, 0x4D, 0x89, 0xCC)
        mc_patch_jcc8(c, jbe_je, buf_len(c))
        mc_b3(c, 0x4C, 0x8B, 0x2B)
        mc_b3(c, 0x4C, 0x89, 0xE1)
        mc_b4(c, 0x48, 0x83, 0xC1, 0x40)
        cg_call_fn(cg, h_alloc_mem())
        mc_b3(c, 0x48, 0x85, 0xC0); cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b4(c, 0x4C, 0x89, 0x60, 0x08)
        mc_b3(c, 0x4D, 0x89, 0xE8)
        mc_b4(c, 0x49, 0x83, 0xC0, 23)
        mc_b4(c, 0x49, 0xC1, 0xE8, 3)
        mc_b2(c, 0x31, 0xD2)
        lp_je := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xC2)
        jae_cp := mc_jcc8(c, 0x73)
        mc_b4(c, 0x4C, 0x8B, 0x0C, 0xD3)
        mc_b4(c, 0x4C, 0x89, 0x0C, 0xD0)
        mc_b3(c, 0x48, 0xFF, 0xC2)
        jmp_je := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_je, lp_je)
        mc_patch_jcc8(c, jae_cp, buf_len(c))
        mc_b3(c, 0x49, 0x89, 0xC4)
        mc_b3(c, 0x48, 0x89, 0xD9)
        cg_call_fn(cg, h_free_mem())
        mc_b3(c, 0x4C, 0x89, 0xE0)
        mc_b4(c, 0x48, 0x83, 0xC4, 0x20)
        mc_b2(c, 0x41, 0x5D); mc_b2(c, 0x41, 0x5C); mc_b1(c, 0x5B)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_jbuf_ensure(), s_je, buf_len(c))
    }

    if cg_is_helper_used(cg, h_jbuf_raw()) {
        mc_align16(c)
        s_jr := buf_len(c)
        mc_b3(c, 0x4D, 0x85, 0xC0); cg_jmp_fn(cg, 0x88, h_sec_trap())
        jnz_jr := mc_jcc8(c, 0x75)
        mc_b3(c, 0x48, 0x89, 0xC8)
        mc_b1(c, 0xC3)
        mc_patch_jcc8(c, jnz_jr, buf_len(c))
        mc_b3(c, 0x48, 0x85, 0xD2); cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b1(c, 0x53); mc_b2(c, 0x41, 0x54)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x28)
        mc_b3(c, 0x48, 0x89, 0xD3)
        mc_b3(c, 0x4D, 0x89, 0xC4)
        mc_b3(c, 0x4C, 0x89, 0xC2)
        cg_call_fn(cg, h_jbuf_ensure())
        mc_b3(c, 0x4C, 0x8B, 0x00)
        mc_b2(c, 0x31, 0xD2)
        mc_b4(c, 0x4E, 0x8D, 0x0C, 0x00)
        mc_b4(c, 0x49, 0x83, 0xC1, 16)
        lp_jr := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE2)
        jae_jr := mc_jcc8(c, 0x73)
        mc_b4(c, 0x44, 0x8A, 0x14, 0x13)
        mc_b4(c, 0x45, 0x88, 0x14, 0x11)
        mc_b3(c, 0x48, 0xFF, 0xC2)
        jmp_jr := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_jr, lp_jr)
        mc_patch_jcc8(c, jae_jr, buf_len(c))
        mc_b3(c, 0x4D, 0x01, 0xE0)
        mc_b3(c, 0x4C, 0x89, 0x00)
        mc_b4(c, 0x48, 0x83, 0xC4, 0x28)
        mc_b2(c, 0x41, 0x5C); mc_b1(c, 0x5B)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_jbuf_raw(), s_jr, buf_len(c))
    }

    if cg_is_helper_used(cg, h_jbuf_i64()) {
        mc_align16(c)
        s_ji := buf_len(c)
        mc_b1(c, 0x53)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x40)
        mc_b3(c, 0x48, 0x89, 0xD3)
        mc_b1(c, 0xBA); mc_u32(c, 24)
        cg_call_fn(cg, h_jbuf_ensure())
        mc_b3(c, 0x49, 0x89, 0xC0)
        mc_b3(c, 0x49, 0x8B, 0x08)
        mc_b3(c, 0x48, 0x89, 0xD8)
        mc_b3(c, 0x48, 0x85, 0xC0)
        jge_ji := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x41, 0xC6, 0x44, 0x08); mc_b2(c, 0x10, 45)
        mc_b3(c, 0x48, 0xFF, 0xC1)
        mc_b3(c, 0x48, 0xF7, 0xD8)
        mc_patch_jcc8(c, jge_ji, buf_len(c))
        mc_b4(c, 0x4C, 0x8D, 0x4C, 0x24); mc_b1(c, 0x3F)
        mc_b3(c, 0x4D, 0x89, 0xCA)
        mc_b3(c, 0x49, 0xC7, 0xC3); mc_u32(c, 10)
        dl_ji := buf_len(c)
        mc_b2(c, 0x31, 0xD2)
        mc_b3(c, 0x49, 0xF7, 0xF3)
        mc_b3(c, 0x80, 0xC2, 0x30)
        mc_b3(c, 0x49, 0xFF, 0xC9)
        mc_b3(c, 0x41, 0x88, 0x11)
        mc_b3(c, 0x48, 0x85, 0xC0)
        jnz_ji := mc_jcc8(c, 0x75)
        mc_patch_jcc8(c, jnz_ji, dl_ji)
        cp_ji := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD1)
        jae_ji := mc_jcc8(c, 0x73)
        mc_b3(c, 0x41, 0x8A, 0x01)
        mc_b4(c, 0x41, 0x88, 0x44, 0x08); mc_b1(c, 0x10)
        mc_b3(c, 0x48, 0xFF, 0xC1)
        mc_b3(c, 0x49, 0xFF, 0xC1)
        jmp_ji := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_ji, cp_ji)
        mc_patch_jcc8(c, jae_ji, buf_len(c))
        mc_b3(c, 0x49, 0x89, 0x08)
        mc_b3(c, 0x4C, 0x89, 0xC0)
        mc_b4(c, 0x48, 0x83, 0xC4, 0x40)
        mc_b1(c, 0x5B)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_jbuf_i64(), s_ji, buf_len(c))
    }

    if cg_is_helper_used(cg, h_jbuf_qstr()) {
        mc_align16(c)
        s_jq := buf_len(c)
        mc_b3(c, 0x4D, 0x85, 0xC0); cg_jmp_fn(cg, 0x88, h_sec_trap())
        jz_jq := mc_jcc8(c, 0x74)
        mc_b3(c, 0x48, 0x85, 0xD2); cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_patch_jcc8(c, jz_jq, buf_len(c))
        mc_b3(c, 0x49, 0x81, 0xF8); mc_u32(c, 0x3FFFFFF0); cg_jmp_fn(cg, 0x8F, h_sec_trap())
        mc_b1(c, 0x53); mc_b2(c, 0x41, 0x54)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x28)
        mc_b3(c, 0x48, 0x89, 0xD3)
        mc_b3(c, 0x4D, 0x89, 0xC4)
        mc_b3(c, 0x4C, 0x89, 0xE2)
        mc_b3(c, 0x48, 0xD1, 0xE2)
        mc_b4(c, 0x48, 0x83, 0xC2, 4)
        cg_call_fn(cg, h_jbuf_ensure())
        mc_b3(c, 0x48, 0x8B, 0x08)
        mc_b4(c, 0xC6, 0x44, 0x08, 0x10); mc_b1(c, 34)
        mc_b3(c, 0x48, 0xFF, 0xC1)
        mc_b2(c, 0x31, 0xD2)
        lp_jq := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE2)
        jae_jq := mc_jcc8(c, 0x73)
        mc_b4(c, 0x44, 0x8A, 0x0C, 0x13)
        mc_b4(c, 0x41, 0x80, 0xF9, 34); je_q1 := mc_jcc8(c, 0x74)
        mc_b4(c, 0x41, 0x80, 0xF9, 92); je_q2 := mc_jcc8(c, 0x74)
        mc_b4(c, 0x41, 0x80, 0xF9, 10); jne_qn := mc_jcc8(c, 0x75)
        mc_b3(c, 0x41, 0xB1, 110); jmp_qn := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jne_qn, buf_len(c))
        mc_b4(c, 0x41, 0x80, 0xF9, 13); jne_qr := mc_jcc8(c, 0x75)
        mc_b3(c, 0x41, 0xB1, 114); jmp_qr := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jne_qr, buf_len(c))
        mc_b4(c, 0x41, 0x80, 0xF9, 9); jne_qt := mc_jcc8(c, 0x75)
        mc_b3(c, 0x41, 0xB1, 116); jmp_qt := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jne_qt, buf_len(c))
        mc_b4(c, 0x41, 0x80, 0xF9, 32); jae_norm := mc_jcc8(c, 0x73)
        mc_b3(c, 0x41, 0xB1, 32)
        mc_patch_jcc8(c, jae_norm, buf_len(c))
        jmp_one := mc_jcc8(c, 0xEB)
        bs_pos := buf_len(c)
        mc_patch_jcc8(c, je_q1, bs_pos)
        mc_patch_jcc8(c, je_q2, bs_pos)
        mc_patch_jcc8(c, jmp_qn, bs_pos)
        mc_patch_jcc8(c, jmp_qr, bs_pos)
        mc_patch_jcc8(c, jmp_qt, bs_pos)
        mc_b4(c, 0xC6, 0x44, 0x08, 0x10); mc_b1(c, 92)
        mc_b3(c, 0x48, 0xFF, 0xC1)
        mc_patch_jcc8(c, jmp_one, buf_len(c))
        mc_b4(c, 0x44, 0x88, 0x4C, 0x08); mc_b1(c, 0x10)
        mc_b3(c, 0x48, 0xFF, 0xC1)
        mc_b3(c, 0x48, 0xFF, 0xC2)
        jmp_jq := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_jq, lp_jq)
        mc_patch_jcc8(c, jae_jq, buf_len(c))
        mc_b4(c, 0xC6, 0x44, 0x08, 0x10); mc_b1(c, 34)
        mc_b3(c, 0x48, 0xFF, 0xC1)
        mc_b3(c, 0x48, 0x89, 0x08)
        mc_b4(c, 0x48, 0x83, 0xC4, 0x28)
        mc_b2(c, 0x41, 0x5C); mc_b1(c, 0x5B)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_jbuf_qstr(), s_jq, buf_len(c))
    }

    if cg_is_helper_used(cg, h_str_concat()) {
        mc_align16(c)
        s_sc := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xD2); cg_jmp_fn(cg, 0x88, h_sec_trap())
        mc_b3(c, 0x4D, 0x85, 0xC9); cg_jmp_fn(cg, 0x88, h_sec_trap())
        mc_b3(c, 0x49, 0x89, 0xD2); mc_b3(c, 0x4D, 0x01, 0xCA); cg_jmp_fn(cg, 0x80, h_sec_trap())
        mc_b3(c, 0x49, 0x81, 0xFA); mc_u32(c, 0x7FFFFFF0); cg_jmp_fn(cg, 0x8F, h_sec_trap())
        mc_b1(c, 0x53); mc_b2(c, 0x41, 0x54); mc_b2(c, 0x41, 0x55); mc_b2(c, 0x41, 0x56)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x28)
        mc_b3(c, 0x48, 0x89, 0xCB); mc_b3(c, 0x49, 0x89, 0xD4)
        mc_b3(c, 0x4D, 0x89, 0xC5); mc_b3(c, 0x4D, 0x89, 0xCE)
        mc_b3(c, 0x4C, 0x89, 0xE1); mc_b3(c, 0x4C, 0x01, 0xF1)
        cg_call_fn(cg, h_buf_new())
        mc_b3(c, 0x48, 0x89, 0xC1); mc_b3(c, 0x48, 0x89, 0xDA); mc_b3(c, 0x4D, 0x89, 0xE0)
        cg_call_fn(cg, h_jbuf_raw())
        mc_b3(c, 0x48, 0x89, 0xC1); mc_b3(c, 0x4C, 0x89, 0xEA); mc_b3(c, 0x4D, 0x89, 0xF0)
        cg_call_fn(cg, h_jbuf_raw())
        mc_b3(c, 0x48, 0x8B, 0x10)
        mc_b4(c, 0xC6, 0x44, 0x10, 0x10); mc_b1(c, 0)
        mc_b4(c, 0x48, 0x8D, 0x40, 0x10)
        mc_b4(c, 0x48, 0x83, 0xC4, 0x28)
        mc_b2(c, 0x41, 0x5E); mc_b2(c, 0x41, 0x5D); mc_b2(c, 0x41, 0x5C); mc_b1(c, 0x5B)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_str_concat(), s_sc, buf_len(c))
    }

    if cg_is_helper_used(cg, h_pow_i64()) {
        mc_align16(c)
        s_pw := buf_len(c)
        mc_mov_rax_imm(c, 1)
        mc_b3(c, 0x48, 0x85, 0xD2)     // TEST RDX, RDX
        jz_ret := mc_jcc32(c, 0x84)    // JZ ret_1
        jg_pos := mc_jcc8(c, 0x7F)     // JG pos
        mc_b2(c, 0x31, 0xC0)           // XOR EAX, EAX (exp < 0 -> 0)
        mc_b1(c, 0xC3)                 // RET
        mc_patch_jcc8(c, jg_pos, buf_len(c))
        top_pw := buf_len(c)
        mc_b3(c, 0xF6, 0xC2, 0x01)     // TEST DL, 1
        jz_skip := mc_jcc8(c, 0x74)
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1) // IMUL RAX, RCX
        if ibuf_get(cg.state, 0) == 1 {
            cg_jmp_fn(cg, 0x80, h_sec_trap())
        }
        mc_patch_jcc8(c, jz_skip, buf_len(c))
        mc_b3(c, 0x48, 0xD1, 0xEA)     // SHR RDX, 1
        jz_done := mc_jcc8(c, 0x74)    // exit BEFORE squaring base on final bit
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xC9) // IMUL RCX, RCX
        if ibuf_get(cg.state, 0) == 1 {
            cg_jmp_fn(cg, 0x80, h_sec_trap())
        }
        jmp_pw := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_pw, top_pw)
        mc_patch_jcc8(c, jz_done, buf_len(c))
        mc_patch_rel32(c, jz_ret, buf_len(c))
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_pow_i64(), s_pw, buf_len(c))
    }

    if cg_is_helper_used(cg, h_chkstk()) {
        mc_align16(c)
        s_cs := buf_len(c)
        mc_b2(c, 0x51, 0x50)                         // PUSH RCX; PUSH RAX
        mc_b4(c, 0x48, 0x8D, 0x4C, 0x24); mc_b1(c, 24) // LEA RCX, [RSP + 24]
        lp_cs := buf_len(c)
        mc_b3(c, 0x48, 0x81, 0xE9); mc_u32(c, 0x1000) // SUB RCX, 0x1000
        mc_b2(c, 0x85, 0x09)                         // TEST [RCX], ECX
        mc_b1(c, 0x2D); mc_u32(c, 0x1000)             // SUB EAX, 0x1000
        mc_b1(c, 0x3D); mc_u32(c, 0x1000)             // CMP EAX, 0x1000
        ja_cs := mc_jcc8(c, 0x77)                     // JA lp_cs
        mc_patch_jcc8(c, ja_cs, lp_cs)
        mc_b3(c, 0x48, 0x29, 0xC1)                   // SUB RCX, RAX
        mc_b2(c, 0x85, 0x09)                         // TEST [RCX], ECX
        mc_b2(c, 0x58, 0x59)                         // POP RAX; POP RCX
        mc_b1(c, 0xC3)                               // RET
        cg_reg_helper(cg, h_chkstk(), s_cs, buf_len(c))
    }

    // 1. `h_detect_cpuid`: Runtime CPUID + OS XGETBV check -> `g_simd_tier` (`0=Scalar`, `1=AVX2+FMA3`, `2=AVX-512F`)
    //    and Win64 `GetSystemInfo` -> `g_cpu_threads` (`1..8`).
    if cg_is_helper_used(cg, h_detect_cpuid()) {
        mc_align16(c)
        s_cp := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
        mc_b1(c, 0x53) // PUSH RBX (non-volatile, clobbered by CPUID)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x58) // 16B aligned frame (`PUSH RBP` + `PUSH RBX` + `0x58` = `0x68` -> +8 ret = `0x70`)

        simd_ov := ibuf_get(cg.state, 17)
        if simd_ov >= 0 {
            mc_mov_rax_imm(c, simd_ov)
            cg_store_rax_data(cg, data_off_simd_tier())
        } else {
            mc_b3(c, 0x45, 0x31, 0xC0) // XOR R8D, R8D (`tier = 0` Scalar SSE2)
            // CPUID Leaf 1: check FMA (bit 12), OSXSAVE (bit 27), AVX (bit 28) in ECX (`0x18001000`)
            mc_b1(c, 0xB8); mc_u32(c, 1)
            mc_b2(c, 0x31, 0xC9)
            mc_b2(c, 0x0F, 0xA2) // CPUID
            mc_b2(c, 0x81, 0xE1); mc_u32(c, 0x18001000)
            mc_b2(c, 0x81, 0xF9); mc_u32(c, 0x18001000)
            jne_c1 := mc_jcc8(c, 0x75)

            // XGETBV(0): verify OS enabled XMM + YMM state (`(EAX & 6) == 6`)
            mc_b2(c, 0x31, 0xC9)
            mc_b3(c, 0x0F, 0x01, 0xD0) // XGETBV
            mc_b3(c, 0x41, 0x89, 0xC1) // MOV R9D, EAX (save XCR0)
            mc_b3(c, 0x83, 0xE0, 0x06)
            mc_b3(c, 0x83, 0xF8, 0x06)
            jne_c2 := mc_jcc8(c, 0x75)

            // CPUID Leaf 7, Subleaf 0: check AVX2 (EBX bit 5 = `0x20`) and AVX-512F (EBX bit 16 = `0x10000`)
            mc_b1(c, 0xB8); mc_u32(c, 7)
            mc_b2(c, 0x31, 0xC9)
            mc_b2(c, 0x0F, 0xA2) // CPUID
            mc_b3(c, 0xF6, 0xC3, 0x20) // TEST BL, 0x20 (AVX2)
            jz_c3 := mc_jcc8(c, 0x74)
            mc_b2(c, 0x41, 0xB8); mc_u32(c, 1) // R8D = 1 (`AVX2 + FMA3`)

            mc_b2(c, 0xF7, 0xC3); mc_u32(c, 0x00010000) // TEST EBX, 0x10000 (AVX-512F)
            jz_c4 := mc_jcc8(c, 0x74)
            mc_b3(c, 0x41, 0x81, 0xE1); mc_u32(c, 0xE6) // AND R9D, 0xE6 (XMM+YMM+ZMM OS state)
            mc_b3(c, 0x41, 0x81, 0xF9); mc_u32(c, 0xE6)
            jne_c5 := mc_jcc8(c, 0x75)
            mc_b2(c, 0x41, 0xB8); mc_u32(c, 2) // R8D = 2 (`AVX-512F EVEX`)

            mc_patch_jcc8(c, jne_c1, buf_len(c))
            mc_patch_jcc8(c, jne_c2, buf_len(c))
            mc_patch_jcc8(c, jz_c3, buf_len(c))
            mc_patch_jcc8(c, jz_c4, buf_len(c))
            mc_patch_jcc8(c, jne_c5, buf_len(c))
            mc_b3(c, 0x4C, 0x89, 0xC0) // MOV RAX, R8
            cg_store_rax_data(cg, data_off_simd_tier())
        }

        // Detect OS hardware thread count (`1..8`)
        if osm <= 1 {
            mc_b4(c, 0x48, 0x8D, 0x4C, 0x24)
            mc_b1(c, 0x20) // LEA RCX, [RSP + 0x20]
            cg_call_iat(cg, iat_get_system_info())
            mc_b4(c, 0x8B, 0x44, 0x24, 0x40) // EAX = dwNumberOfProcessors (`[RSP + 0x20 + 0x20]`)
            mc_b3(c, 0x83, 0xF8, 0x01)
            jge_t1 := mc_jcc8(c, 0x7D)
            mc_b1(c, 0xB8); mc_u32(c, 1)
            mc_patch_jcc8(c, jge_t1, buf_len(c))
            mc_b3(c, 0x83, 0xF8, 0x10)
            jle_t8 := mc_jcc8(c, 0x7E)
            mc_b1(c, 0xB8); mc_u32(c, 16)
            mc_patch_jcc8(c, jle_t8, buf_len(c))
            cg_store_rax_data(cg, data_off_cpu_threads())
        } else {
            mc_mov_rax_imm(c, 1)
            cg_store_rax_data(cg, data_off_cpu_threads())
        }

        mc_b4(c, 0x48, 0x83, 0xC4, 0x58)
        mc_b1(c, 0x5B) // POP RBX
        mc_b1(c, 0x5D) // POP RBP
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_detect_cpuid(), s_cp, buf_len(c))
    }

    // 2. `h_nan_trap(RCX = line)`: `@nan_guard` hardware IEEE-754 NaN/Inf trap -> exit 254
    if cg_is_helper_used(cg, h_nan_trap()) {
        nan_hdr := "[AXON NAN GUARD] IEEE-754 NaN/Inf trapped at line "
        nan_nl := "\n"
        nh_off := cg_intern_lit(cg, nan_hdr)
        nn_off := cg_intern_lit(cg, nan_nl)
        mc_align16(c)
        s_nt := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
        mc_b4(c, 0x48, 0x83, 0xE4, 0xF0)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x30)
        mc_b4(c, 0x48, 0x89, 0x4D, 0xF8) // save line
        cg_lea_rax_rdata(cg, nh_off)
        mc_b3(c, 0x48, 0x89, 0xC1)
        mc_b1(c, 0xBA)
        mc_u32(c, str_len(nan_hdr))
        cg_call_fn(cg, h_print_bytes())
        mc_b4(c, 0x48, 0x8B, 0x4D, 0xF8)
        cg_call_fn(cg, h_print_i64())
        cg_lea_rax_rdata(cg, nn_off)
        mc_b3(c, 0x48, 0x89, 0xC1)
        mc_b1(c, 0xBA)
        mc_u32(c, 1)
        cg_call_fn(cg, h_print_bytes())
        cg_emit_exit_imm(cg, 254)
        cg_reg_helper(cg, h_nan_trap(), s_nt, buf_len(c))
    }

    // 3. `h_par_soa_worker(RCX = tid)`: Win64 `LPTHREAD_START_ROUTINE` for Multi-Core `par_for`!
    if cg_is_helper_used(cg, h_par_soa_worker()) {
        mc_align16(c)
        s_pw := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
        mc_b2(c, 0x56, 0x57) // PUSH RSI; PUSH RDI
        // R9 = tid (RCX), R10 = .data base
        mc_b3(c, 0x49, 0x89, 0xC9) // MOV R9, RCX
        cg_lea_rax_data(cg, 0)
        mc_b3(c, 0x49, 0x89, 0xC2) // MOV R10, RAX

        // RSI = [R10 + 0x40] (src_col_ptr), RDI = [R10 + 0x48] (dst_col_ptr), R11 = [R10 + 0x58] (op_kind)
        mc_b4(c, 0x49, 0x8B, 0x72, 0x40)
        mc_b4(c, 0x49, 0x8B, 0x7A, 0x48)
        mc_b4(c, 0x4D, 0x8B, 0x5A, 0x58)
        // XMM0 = scale_f32 (`[R10 + 0x50]`)
        mc_b4(c, 0x41, 0x8B, 0x42, 0x50)
        mc_b4(c, 0x66, 0x0F, 0x6E, 0xC0) // MOVD XMM0, EAX

        // RAX = start_elem (`[R10 + 0x60 + R9*16]`), RCX = end_elem (`[R10 + 0x68 + R9*16]`)
        mc_b4(c, 0x49, 0xC1, 0xE1, 0x04) // SHL R9, 4
        mc_b3(c, 0x4D, 0x01, 0xCA)       // ADD R10, R9
        mc_b4(c, 0x49, 0x8B, 0x42, 0x60) // RAX = start_elem
        mc_b4(c, 0x49, 0x8B, 0x4A, 0x68) // RCX = end_elem
        mc_b4(c, 0x48, 0xC1, 0xE0, 0x02) // RAX = start_byte
        mc_b4(c, 0x48, 0xC1, 0xE1, 0x02) // RCX = end_byte

        // Check `g_simd_tier` >= 1 for AVX2 32B/iter loop before scalar tail
        mc_b3(c, 0x48, 0x89, 0xC2) // RDX = save RAX
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        mc_b3(c, 0x48, 0x89, 0xD0) // restore RAX = start_byte
        jz_scalar := mc_jcc8(c, 0x74)

        mc_b4(c, 0xC4, 0xE2, 0x7D, 0x18)
        mc_b1(c, 0xC0) // VBROADCASTSS YMM0, XMM0
        avx_top := buf_len(c)
        mc_b4(c, 0x48, 0x8D, 0x50, 0x20) // LEA RDX, [RAX + 32]
        mc_b3(c, 0x48, 0x39, 0xCA)       // CMP RDX, RCX
        ja_stail := mc_jcc8(c, 0x77)
        mc_b4(c, 0xC5, 0xFC, 0x10, 0x14); mc_b1(c, 0x07) // VMOVUPS YMM2, [RDI+RAX]
        mc_b4(c, 0x49, 0x83, 0xFB, 0x02) // CMP R11, 2 (mul-only?)
        je_wmul := mc_jcc8(c, 0x74)
        mc_b4(c, 0xC5, 0xFC, 0x10, 0x0C); mc_b1(c, 0x06) // VMOVUPS YMM1, [RSI+RAX]
        mc_b4(c, 0xC4, 0xE2, 0x75, 0xB8); mc_b1(c, 0xD0) // VFMADD231PS YMM2, YMM1, YMM0
        jmp_wst := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, je_wmul, buf_len(c))
        mc_b4(c, 0xC5, 0xEC, 0x59, 0xD0) // VMULPS YMM2, YMM2, YMM0
        mc_patch_jcc8(c, jmp_wst, buf_len(c))
        mc_b4(c, 0xC5, 0xFC, 0x11, 0x14); mc_b1(c, 0x07) // VMOVUPS [RDI+RAX], YMM2
        mc_b4(c, 0x48, 0x83, 0xC0, 0x20)
        jmp_avxt := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_avxt, avx_top)
        mc_patch_jcc8(c, ja_stail, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77) // VZEROUPPER

        mc_patch_jcc8(c, jz_scalar, buf_len(c))
        // Scalar SSE2 tail loop (`while RAX < RCX`)
        sc_top := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC8)
        jae_wdone := mc_jcc8(c, 0x73)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x14); mc_b1(c, 0x07) // MOVSS XMM2, [RDI+RAX]
        mc_b4(c, 0x49, 0x83, 0xFB, 0x02)
        je_smul := mc_jcc8(c, 0x74)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x0C); mc_b1(c, 0x06) // MOVSS XMM1, [RSI+RAX]
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xC8) // MULSS XMM1, XMM0
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xD1) // ADDSS XMM2, XMM1
        jmp_sst := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, je_smul, buf_len(c))
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xD0) // MULSS XMM2, XMM0
        mc_patch_jcc8(c, jmp_sst, buf_len(c))
        mc_b4(c, 0xF3, 0x0F, 0x11, 0x14); mc_b1(c, 0x07) // MOVSS [RDI+RAX], XMM2
        mc_b4(c, 0x48, 0x83, 0xC0, 0x04)
        jmp_sct := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_sct, sc_top)

        mc_patch_jcc8(c, jae_wdone, buf_len(c))
        mc_b2(c, 0x31, 0xC0) // return 0
        mc_b2(c, 0x5F, 0x5E) // POP RDI; POP RSI
        mc_b1(c, 0x5D)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_par_soa_worker(), s_pw, buf_len(c))
    }

    // 4. `h_alloc_mem(RCX = bytes) -> RAX = 64B-aligned ptr` (Win64 ProcessHeap LFH / Linux+macOS mmap / Bare-Metal bump)
    if cg_is_helper_used(cg, h_alloc_mem()) {
        mc_align16(c)
        s_am := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        mc_b3(c, 0x48, 0x85, 0xC9) // TEST RCX, RCX
        jle_zero := mc_jcc8(c, 0x7E) // <= 0 -> fail cleanly (return NULL)
        if osm <= 1 {
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5) // PUSH RBP; MOV RBP, RSP
            mc_b1(c, 0x53)                   // PUSH RBX
            mc_b4(c, 0x48, 0x83, 0xEC, 0x28) // SUB RSP, 0x28 (32 shadow + 8 align)
            mc_b3(c, 0x48, 0x89, 0xCB)       // MOV RBX, RCX
            mc_b4(c, 0x48, 0x83, 0xC3, 0x48) // ADD RBX, 72 (8 raw ptr + up to 63 align pad)
            js_ovf := mc_jcc8(c, 0x78)       // guard signed wraparound

            cg_mov_rax_data(cg, data_off_arena_ptr())
            mc_b3(c, 0x48, 0x85, 0xC0)       // TEST RAX, RAX
            jnz_heap := mc_jcc8(c, 0x75)
            cg_call_iat(cg, iat_get_process_heap())
            mc_b3(c, 0x48, 0x85, 0xC0)
            jz_hf1 := mc_jcc8(c, 0x74)
            cg_store_rax_data(cg, data_off_arena_ptr())
            mc_patch_jcc8(c, jnz_heap, buf_len(c))

            mc_b3(c, 0x48, 0x89, 0xC1)       // RCX = hHeap
            mc_b1(c, 0xBA); mc_u32(c, 8)     // EDX = HEAP_ZERO_MEMORY
            mc_b3(c, 0x49, 0x89, 0xD8)       // R8  = bytes + 72
            cg_call_iat(cg, iat_heap_alloc())
            mc_b3(c, 0x48, 0x85, 0xC0)
            jz_hf2 := mc_jcc8(c, 0x74)

            // Store raw heap ptr at `[aligned - 8]` and return 64-byte aligned pointer
            mc_b4(c, 0x48, 0x8D, 0x50, 71)   // LEA RDX, [RAX + 71]
            mc_b4(c, 0x48, 0x83, 0xE2, 0xC0) // AND RDX, -64
            mc_b4(c, 0x48, 0x89, 0x42, 0xF8) // MOV [RDX - 8], RAX
            mc_b3(c, 0x48, 0x89, 0xD0)       // MOV RAX, RDX
            mc_b4(c, 0x48, 0x83, 0xC4, 0x28)
            mc_b1(c, 0x5B)
            mc_b1(c, 0x5D)
            mc_b1(c, 0xC3)

            fail_off := buf_len(c)
            mc_patch_jcc8(c, js_ovf, fail_off)
            mc_patch_jcc8(c, jz_hf1, fail_off)
            mc_patch_jcc8(c, jz_hf2, fail_off)
            mc_b2(c, 0x31, 0xC0)
            mc_b4(c, 0x48, 0x83, 0xC4, 0x28)
            mc_b1(c, 0x5B)
            mc_b1(c, 0x5D)
            mc_b1(c, 0xC3)
        } else if osm == 2 or osm == 3 {
            mc_b2(c, 0x56, 0x57) // preserve RSI, RDI
            mc_b3(c, 0x48, 0x89, 0xCE) // RSI = size
            mc_b2(c, 0x31, 0xFF)       // RDI = NULL
            mc_b1(c, 0xBA); mc_u32(c, 3) // PROT_READ | PROT_WRITE
            mc_b3(c, 0x49, 0xC7, 0xC2)
            if osm == 2 { mc_u32(c, 0x22) } else { mc_u32(c, 0x1002) } // MAP_PRIVATE | MAP_ANON
            mc_b3(c, 0x49, 0xC7, 0xC0); mc_u32(c, 0xFFFFFFFF) // R8 = -1
            mc_b3(c, 0x45, 0x31, 0xC9) // R9 = 0
            mc_b1(c, 0xB8)
            if osm == 2 { mc_u32(c, 9) } else { mc_u32(c, 0x20000C5) } // sys_mmap
            mc_b2(c, 0x0F, 0x05)
            // Normalize Linux/macOS `-errno` (`-4095..-1`) to NULL (`0`)
            mc_b2(c, 0x48, 0x3D); mc_u32(c, 0xFFFFF000) // CMP RAX, -4096
            jb_mok := mc_jcc8(c, 0x72)
            mc_b2(c, 0x31, 0xC0) // XOR EAX, EAX
            mc_patch_jcc8(c, jb_mok, buf_len(c))
            mc_b2(c, 0x5F, 0x5E)
            mc_b1(c, 0xC3)
        } else {
            // Bare-metal / Unikernel bump allocator starting at physical 4 MB (`0x400000`)
            mc_b4(c, 0x48, 0x83, 0xC1, 0x3F)
            mc_b4(c, 0x48, 0x83, 0xE1, 0xC0) // align_up(RCX, 64)
            cg_mov_rax_data(cg, data_off_bare_heap())
            mc_b3(c, 0x48, 0x89, 0xC2) // RDX = old_off
            mc_b3(c, 0x48, 0x01, 0xC8) // RAX = old_off + aligned_size
            cg_store_rax_data(cg, data_off_bare_heap())
            mc_b3(c, 0x48, 0x8D, 0x82)
            mc_u32(c, 0x400000) // LEA RAX, [RDX + 0x400000]
            mc_b1(c, 0xC3)
        }
        mc_patch_jcc8(c, jle_zero, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_alloc_mem(), s_am, buf_len(c))
    }

    // 5. `h_free_mem(RCX = ptr)`
    if cg_is_helper_used(cg, h_free_mem()) {
        mc_align16(c)
        s_fm := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        mc_b3(c, 0x48, 0x85, 0xC9)
        jz_fm := mc_jcc8(c, 0x74)
        if osm <= 1 {
            mc_b3(c, 0xF6, 0xC1, 0x3F)       // TEST CL, 63 (verify 64B alignment before deref [RCX-8])
            jnz_bad := mc_jcc8(c, 0x75)
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b4(c, 0x48, 0x83, 0xEC, 0x20)
            mc_b4(c, 0x4C, 0x8B, 0x41, 0xF8) // R8 = raw heap ptr `[RCX - 8]`
            mc_b3(c, 0x4D, 0x85, 0xC0)
            jz_nr := mc_jcc8(c, 0x74)
            mc_b4(c, 0x48, 0xC7, 0x41, 0xF8); mc_u32(c, 0) // Zero `[RCX - 8]` to block double-free via aliases
            cg_mov_rax_data(cg, data_off_arena_ptr())
            mc_b3(c, 0x48, 0x85, 0xC0)
            jz_nh := mc_jcc8(c, 0x74)
            mc_b3(c, 0x48, 0x89, 0xC1)       // RCX = hHeap
            mc_b2(c, 0x31, 0xD2)             // EDX = 0
            cg_call_iat(cg, iat_heap_free())
            ep_fm := buf_len(c)
            mc_patch_jcc8(c, jz_nr, ep_fm)
            mc_patch_jcc8(c, jz_nh, ep_fm)
            mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
            mc_patch_jcc8(c, jnz_bad, buf_len(c))
        }
        mc_patch_jcc8(c, jz_fm, buf_len(c))
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_free_mem(), s_fm, buf_len(c))
    }

    // 6. `h_stdin_read_line(RCX = ByteBuf_ptr) -> RAX = line_len_or_minus1` (Win64 ReadFile / Unix SYS_read(0))
    if cg_is_helper_used(cg, h_stdin_read_line()) {
        mc_align16(c)
        s_rl := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
        mc_b1(c, 0x53)             // PUSH RBX
        mc_b2(c, 0x41, 0x54)       // PUSH R12
        mc_b2(c, 0x41, 0x55)       // PUSH R13
        mc_b4(c, 0x48, 0x83, 0xEC, 0x48)
        mc_b3(c, 0x48, 0x89, 0xCB) // RBX = ByteBuf ptr
        mc_b3(c, 0x48, 0x85, 0xDB)
        jz_null := mc_jcc32(c, 0x84)
        mc_b3(c, 0x48, 0xC7, 0x03); mc_u32(c, 0) // [RBX] = 0 (len = 0)
        mc_b3(c, 0x45, 0x31, 0xED) // R13 = 0 (cur_len)

        if osm <= 1 {
            mc_b1(c, 0xB9); mc_u32(c, 0xFFFFFFF6) // STD_INPUT_HANDLE (-10)
            cg_call_iat(cg, iat_get_std_handle())
            mc_b3(c, 0x49, 0x89, 0xC4) // R12 = hStdin

            rd_loop := buf_len(c)
            mc_b3(c, 0xC7, 0x45, 0xD8); mc_u32(c, 0) // [RBP-0x28] = 0 (nread)
            mc_b3(c, 0x4C, 0x89, 0xE1)               // RCX = R12
            mc_b4(c, 0x48, 0x8D, 0x55, 0xE0)         // RDX = &ch ([RBP-0x20])
            mc_b3(c, 0x41, 0xB8, 0x01); mc_b3(c, 0x00, 0x00, 0x00) // R8D = 1
            mc_b4(c, 0x4C, 0x8D, 0x4D, 0xD8)         // R9 = &nread ([RBP-0x28])
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 0x20); mc_u32(c, 0)
            cg_call_iat(cg, iat_read_file())
            mc_b2(c, 0x85, 0xC0)
            jz_eof1 := mc_jcc8(c, 0x74)
            mc_b4(c, 0x83, 0x7D, 0xD8, 0x00)
            je_eof2 := mc_jcc8(c, 0x74)

            mc_b4(c, 0x0F, 0xB6, 0x45, 0xE0) // MOVZX EAX, BYTE [RBP-0x20]
            mc_b2(c, 0x3C, 10)
            je_nl := mc_jcc8(c, 0x74)
            mc_b2(c, 0x3C, 13)
            je_cr := mc_jcc8(c, 0x74)

            mc_b4(c, 0x4C, 0x3B, 0x6B, 0x08) // CMP R13, [RBX+8]
            jae_full := mc_jcc8(c, 0x73)
            mc_b4(c, 0x48, 0x8D, 0x4B, 0x10) // LEA RCX, [RBX+16]
            mc_b3(c, 0x4C, 0x01, 0xE9)       // ADD RCX, R13
            mc_b2(c, 0x88, 0x01)             // MOV [RCX], AL
            mc_b3(c, 0x49, 0xFF, 0xC5)       // INC R13

            mc_patch_jcc8(c, je_cr, rd_loop)
            mc_patch_jcc8(c, jae_full, rd_loop)
            jmp_rd := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, jmp_rd, rd_loop)

            mc_patch_jcc8(c, jz_eof1, buf_len(c))
            mc_patch_jcc8(c, je_eof2, buf_len(c))
            mc_b3(c, 0x4D, 0x85, 0xED)
            jnz_part := mc_jcc8(c, 0x75)
            mc_b3(c, 0x48, 0xC7, 0xC0); mc_u32(c, 0xFFFFFFFF) // RAX = -1
            jmp_done1 := mc_jcc8(c, 0xEB)

            mc_patch_jcc8(c, je_nl, buf_len(c))
            mc_patch_jcc8(c, jnz_part, buf_len(c))
            mc_b3(c, 0x4C, 0x89, 0x2B) // [RBX] = R13
            mc_b3(c, 0x4C, 0x89, 0xE8) // RAX = R13
            mc_patch_jcc8(c, jmp_done1, buf_len(c))
        } else if osm == 2 or osm == 3 {
            mc_b4(c, 0x48, 0x89, 0x75, 0xD0) // save RSI
            mc_b4(c, 0x48, 0x89, 0x7D, 0xC8) // save RDI
            urd_loop := buf_len(c)
            mc_b2(c, 0x31, 0xFF)             // EDI = 0 (stdin)
            mc_b4(c, 0x48, 0x8D, 0x75, 0xE0) // RSI = &ch
            mc_b1(c, 0xBA); mc_u32(c, 1)     // EDX = 1
            mc_b1(c, 0xB8)
            if osm == 2 { mc_u32(c, 0) } else { mc_u32(c, 0x2000003) } // sys_read
            mc_b2(c, 0x0F, 0x05)
            mc_b3(c, 0x48, 0x85, 0xC0)
            jle_ueof := mc_jcc8(c, 0x7E)

            mc_b4(c, 0x0F, 0xB6, 0x45, 0xE0)
            mc_b2(c, 0x3C, 10)
            je_unl := mc_jcc8(c, 0x74)
            mc_b2(c, 0x3C, 13)
            je_ucr := mc_jcc8(c, 0x74)

            mc_b4(c, 0x4C, 0x3B, 0x6B, 0x08)
            jae_ufull := mc_jcc8(c, 0x73)
            mc_b4(c, 0x48, 0x8D, 0x4B, 0x10)
            mc_b3(c, 0x4C, 0x01, 0xE9)
            mc_b2(c, 0x88, 0x01)
            mc_b3(c, 0x49, 0xFF, 0xC5)

            mc_patch_jcc8(c, je_ucr, urd_loop)
            mc_patch_jcc8(c, jae_ufull, urd_loop)
            jmp_urd := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, jmp_urd, urd_loop)

            mc_patch_jcc8(c, jle_ueof, buf_len(c))
            mc_b3(c, 0x4D, 0x85, 0xED)
            jnz_upart := mc_jcc8(c, 0x75)
            mc_b3(c, 0x48, 0xC7, 0xC0); mc_u32(c, 0xFFFFFFFF)
            jmp_udone := mc_jcc8(c, 0xEB)

            mc_patch_jcc8(c, je_unl, buf_len(c))
            mc_patch_jcc8(c, jnz_upart, buf_len(c))
            mc_b3(c, 0x4C, 0x89, 0x2B)
            mc_b3(c, 0x4C, 0x89, 0xE8)
            mc_patch_jcc8(c, jmp_udone, buf_len(c))
            mc_b4(c, 0x48, 0x8B, 0x75, 0xD0)
            mc_b4(c, 0x48, 0x8B, 0x7D, 0xC8)
        } else {
            mc_b3(c, 0x48, 0xC7, 0xC0); mc_u32(c, 0xFFFFFFFF)
        }

        jmp_rl_end := mc_jcc8(c, 0xEB)
        mc_patch_rel32(c, jz_null, buf_len(c))
        mc_b3(c, 0x48, 0xC7, 0xC0); mc_u32(c, 0xFFFFFFFF)
        mc_patch_jcc8(c, jmp_rl_end, buf_len(c))

        mc_b4(c, 0x48, 0x83, 0xC4, 0x48)
        mc_b2(c, 0x41, 0x5D)
        mc_b2(c, 0x41, 0x5C)
        mc_b1(c, 0x5B)
        mc_b1(c, 0x5D)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_stdin_read_line(), s_rl, buf_len(c))
    }

    // 7. `h_os_exec(RCX = cmd_ptr, RDX = cmd_len) -> RAX = exit_code` (Win64 Zero-CRT CreateProcessA)
    if cg_is_helper_used(cg, h_os_exec()) {
        mc_align16(c)
        s_ox := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        if osm <= 1 {
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b3(c, 0x53, 0x56, 0x57) // PUSH RBX; PUSH RSI; PUSH RDI
            mc_b3(c, 0x48, 0x81, 0xEC); mc_u32(c, 0x528)
            mc_b3(c, 0x48, 0x89, 0xCE) // RSI = cmd_ptr
            mc_b3(c, 0x48, 0x89, 0xD3) // RBX = cmd_len
            mc_b3(c, 0x48, 0x85, 0xF6) // TEST RSI, RSI
            jz_null_cmd := mc_jcc32(c, 0x84)
            mc_b3(c, 0x48, 0x85, 0xDB) // TEST RBX, RBX
            jle_bad_len := mc_jcc32(c, 0x8E) // <= 0 -> reject empty/negative command length
            mc_b3(c, 0x48, 0x81, 0xFB); mc_u32(c, 1000)
            jle_cl := mc_jcc8(c, 0x7E)
            mc_b3(c, 0x48, 0xC7, 0xC3); mc_u32(c, 1000)
            mc_patch_jcc8(c, jle_cl, buf_len(c))

            // Zero `PROCESS_INFORMATION` (`[RSP+0x50]`) + `STARTUPINFOA` (`[RSP+0x80]`) = 22 qwords
            mc_b4(c, 0x48, 0x8D, 0x7C, 0x24); mc_b1(c, 0x50)
            mc_b1(c, 0xB9); mc_u32(c, 22)
            mc_b2(c, 0x31, 0xC0)
            mc_b3(c, 0xF3, 0x48, 0xAB)

            // Copy `cmd_ptr[0..RBX]` into mutable `[RSP + 0x100]` rejecting embedded NUL (CWE-158)
            mc_b4(c, 0x48, 0x8D, 0xBC, 0x24); mc_u32(c, 0x100)
            mc_b3(c, 0x48, 0x31, 0xC9) // XOR RCX, RCX
            ox_cp := buf_len(c)
            mc_b3(c, 0x48, 0x39, 0xD9) // CMP RCX, RBX
            ox_dn := mc_jcc8(c, 0x73) // JAE ox_done
            mc_b3(c, 0x8A, 0x04, 0x0E) // MOV AL, [RSI + RCX]
            mc_b2(c, 0x84, 0xC0)       // TEST AL, AL
            jz_nul_cmd := mc_jcc32(c, 0x84)
            mc_b3(c, 0x88, 0x04, 0x0F) // MOV [RDI + RCX], AL
            mc_b3(c, 0x48, 0xFF, 0xC1) // INC RCX
            ox_lp := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, ox_lp, ox_cp)
            mc_patch_jcc8(c, ox_dn, buf_len(c))
            mc_b4(c, 0xC6, 0x04, 0x1F, 0x00) // MOV BYTE PTR [RDI + RBX], 0

            // `STARTUPINFOA.cb = 104`
            mc_b3(c, 0xC7, 0x84, 0x24); mc_u32(c, 0x80); mc_u32(c, 104)

            // Stack args 5..10 for `CreateProcessA`
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 0x20); mc_u32(c, 1) // bInheritHandles = TRUE
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 0x28); mc_u32(c, 0)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 0x30); mc_u32(c, 0)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 0x38); mc_u32(c, 0)
            mc_b4(c, 0x48, 0x8D, 0x84, 0x24); mc_u32(c, 0x80)
            mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 0x40) // lpStartupInfo
            mc_b4(c, 0x48, 0x8D, 0x44, 0x24); mc_b1(c, 0x50)
            mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 0x48) // lpProcessInformation

            mc_b2(c, 0x31, 0xC9) // RCX = NULL
            mc_b4(c, 0x48, 0x8D, 0x94, 0x24); mc_u32(c, 0x100) // RDX = lpCommandLine
            mc_b3(c, 0x45, 0x31, 0xC0) // R8 = NULL
            mc_b3(c, 0x45, 0x31, 0xC9) // R9 = NULL
            cg_call_iat(cg, iat_create_process_a())
            mc_b2(c, 0x85, 0xC0)
            jz_fail := mc_jcc32(c, 0x84)

            // WaitForSingleObject(hProcess, INFINITE)
            mc_b4(c, 0x48, 0x8B, 0x4C, 0x24); mc_b1(c, 0x50)
            mc_b1(c, 0xBA); mc_u32(c, 0xFFFFFFFF)
            cg_call_iat(cg, iat_wait_single())

            // GetExitCodeProcess(hProcess, &exit_code)
            mc_b4(c, 0xC7, 0x44, 0x24, 0x78); mc_u32(c, 0)
            mc_b4(c, 0x48, 0x8B, 0x4C, 0x24); mc_b1(c, 0x50)
            mc_b4(c, 0x48, 0x8D, 0x54, 0x24); mc_b1(c, 0x78)
            cg_call_iat(cg, iat_get_exit_code())

            // CloseHandle(hProcess) & CloseHandle(hThread)
            mc_b4(c, 0x48, 0x8B, 0x4C, 0x24); mc_b1(c, 0x50)
            cg_call_iat(cg, iat_close_handle())
            mc_b4(c, 0x48, 0x8B, 0x4C, 0x24); mc_b1(c, 0x58)
            cg_call_iat(cg, iat_close_handle())

            mc_b4(c, 0x8B, 0x44, 0x24, 0x78) // RAX = exit_code
            jmp_ox_ok := mc_jmp32(c)

            mc_patch_rel32(c, jz_null_cmd, buf_len(c))
            mc_patch_rel32(c, jz_nul_cmd, buf_len(c))
            mc_patch_rel32(c, jle_bad_len, buf_len(c))
            mc_patch_rel32(c, jz_fail, buf_len(c))
            mc_b3(c, 0x48, 0xC7, 0xC0); mc_u32(c, 0xFFFFFFFF)
            mc_patch_rel32(c, jmp_ox_ok, buf_len(c))

            mc_b3(c, 0x48, 0x81, 0xC4); mc_u32(c, 0x528)
            mc_b3(c, 0x5F, 0x5E, 0x5B) // POP RDI; POP RSI; POP RBX
            mc_b1(c, 0x5D)
            mc_b1(c, 0xC3)
        } else {
            mc_b2(c, 0x31, 0xC0)
            mc_b1(c, 0xC3)
        }
        cg_reg_helper(cg, h_os_exec(), s_ox, buf_len(c))
    }
}

// Propagates transitive helper dependencies and emits ONLY helpers actually called by the binary.
fn emit_used_runtime_helpers(cg: CodegenCtx) {
    if cg_is_helper_used(cg, h_shield_verify()) {
        cg_mark_helper_used(cg, h_shield_trap())
    }
    if cg_is_helper_used(cg, h_args_count()) {
        cg_mark_helper_used(cg, h_args_get())
    }
    if cg_is_helper_used(cg, h_nan_trap()) {
        cg_mark_helper_used(cg, h_print_i64())
        cg_mark_helper_used(cg, h_print_bytes())
    }
    if cg_is_helper_used(cg, h_print_dec()) {
        cg_mark_helper_used(cg, h_print_i64())
        cg_mark_helper_used(cg, h_print_bytes())
    }
    if cg_is_helper_used(cg, h_print_i64()) {
        cg_mark_helper_used(cg, h_print_bytes())
    }
    if cg_is_helper_used(cg, h_pow_i64()) and ibuf_get(cg.state, 0) == 1 {
        cg_mark_helper_used(cg, h_sec_trap())
    }
    if cg_is_helper_used(cg, h_shield_trap()) {
        cg_mark_helper_used(cg, h_print_bytes())
    }
    if cg_is_helper_used(cg, h_fs_read()) and not cg_is_win64(cg) {
        cg_mark_helper_used(cg, h_alloc_mem())
    }
    if cg_is_helper_used(cg, h_ai_gemv_f32()) or cg_is_helper_used(cg, h_ai_gemm_f32()) or cg_is_helper_used(cg, h_ai_gemv_q8_0()) or cg_is_helper_used(cg, h_ai_gemv_q4_0()) or cg_is_helper_used(cg, h_ai_gemv_bitnet()) or cg_is_helper_used(cg, h_ai_gemv_bnn()) or cg_is_helper_used(cg, h_ai_l2_batch()) or cg_is_helper_used(cg, h_ai_bnn_popcnt()) {
        cg_mark_helper_used(cg, h_ai_pool_dispatch())
    }
    if cg_is_helper_used(cg, h_ai_gemv_bnn()) {
        cg_mark_helper_used(cg, h_alloc_mem())
        cg_mark_helper_used(cg, h_free_mem())
    }
    if cg_is_helper_used(cg, h_ai_pool_dispatch()) {
        cg_mark_helper_used(cg, h_alloc_mem())
        cg_mark_helper_used(cg, h_ai_pool_worker())
        cg_mark_helper_used(cg, h_sec_trap())
        cg_mark_helper_used(cg, h_print_bytes())
    }
    if cg_is_helper_used(cg, h_sec_trap()) {
        cg_mark_helper_used(cg, h_print_i64())
        cg_mark_helper_used(cg, h_print_bytes())
    }

    emit_v7_core_helpers_used(cg)

    c := cg.code
    osm := cg_os_mode(cg)

    if cg_is_helper_used(cg, h_shield_verify()) {
        poly_seed := ibuf_get(cg.state, 15)
        mc_align16(c)
        s_sv := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA) // ENDBR64 (also verified inline by every `@shield` fn!)
        mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
        mut jne_peb_dbg := 0
        mut jnz_ntgf := 0
        if osm <= 1 {
            // Layer 1: Zero-API Kernel PEB Anti-Debug (immune to `IsDebuggerPresent` IAT hooks!)
            // MOV RAX, GS:[0x60] (PEB)
            mc_b4(c, 0x65, 0x48, 0x8B, 0x04); mc_b1(c, 0x25); mc_u32(c, 0x60)
            // CMP BYTE PTR [RAX + 0x02], 0 (`PEB.BeingDebugged`)
            mc_b4(c, 0x80, 0x78, 0x02, 0x00)
            jne_peb_dbg = mc_jcc32(c, 0x85)
            // TEST DWORD PTR [RAX + 0xBC], 0x70 (`PEB.NtGlobalFlag` heap debug flags)
            mc_b2(c, 0xF7, 0x80); mc_u32(c, 0xBC); mc_u32(c, 0x70)
            jnz_ntgf = mc_jcc32(c, 0x85)
        }
        // Layer 2: RDTSC Anti-Single-Step Start Timestamp -> R11
        mc_b2(c, 0x0F, 0x31)             // RDTSC
        mc_b4(c, 0x48, 0xC1, 0xE2, 0x20) // SHL RDX, 32
        mc_b3(c, 0x48, 0x09, 0xD0)       // OR  RAX, RDX
        mc_b3(c, 0x49, 0x89, 0xC3)       // MOV R11, RAX

        // Layer 3: Polymorphic `.text` Code Integrity MAC (`0 .. s_sv`)
        mc_b3(c, 0x48, 0x8D, 0x0D)
        disp0 := 0 - (buf_len(c) + 4)
        mc_u32(c, disp0)
        mc_b1(c, 0xBA)
        ibuf_set(cg.state, 2, buf_len(c))
        mc_u32(c, 0)
        mc_b2(c, 0x48, 0xB8)
        mc_u64(c, poly_seed ^ 0xcbf29ce484222325)
        mc_b2(c, 0x49, 0xB8)
        mc_u64(c, 0x9E3779B97F4A7C15)
        mc_b2(c, 0x49, 0xBA)
        mc_u64(c, poly_seed)

        ltop := buf_len(c)
        mc_b2(c, 0x32, 0x01)
        mc_b4(c, 0x48, 0xC1, 0xC0, 0x0D)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC0)
        mc_b3(c, 0x4C, 0x01, 0xD0)
        mc_b3(c, 0x48, 0xFF, 0xC1)
        mc_b2(c, 0xFF, 0xCA)
        jnz_p := mc_jcc8(c, 0x75)
        mc_patch_jcc8(c, jnz_p, ltop)

        // RDTSC End Timestamp & Single-Step Check (preserves computed MAC in RAX via PUSH/POP!)
        mc_b1(c, 0x50)                   // PUSH RAX
        mc_b2(c, 0x0F, 0x31)             // RDTSC
        mc_b4(c, 0x48, 0xC1, 0xE2, 0x20) // SHL RDX, 32
        mc_b3(c, 0x48, 0x09, 0xD0)       // OR  RAX, RDX
        mc_b3(c, 0x4C, 0x29, 0xD8)       // SUB RAX, R11
        mc_b2(c, 0x41, 0xBB); mc_u32(c, 0x7FFFFFFF) // MOV R11D, 0x7FFFFFFF (~2.1B cycles)
        mc_b3(c, 0x4C, 0x39, 0xD8)       // CMP RAX, R11
        mc_b1(c, 0x58)                   // POP RAX (does not modify flags!)
        ja_rdtsc := mc_jcc32(c, 0x87)

        mc_b3(c, 0x48, 0x8D, 0x0D)
        dp := buf_len(c)
        mc_u32(c, 0)
        nr := buf_len(c)
        cg_add_fixup(cg.fixups, dp, nr, fx_shield())
        mc_b3(c, 0x48, 0x8B, 0x11)
        mc_b4(c, 0x48, 0x33, 0x51, 0x08)
        mc_b3(c, 0x48, 0x39, 0xD0)
        jne_trap := mc_jcc8(c, 0x75)
        mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
        mc_b1(c, 0xC3)

        trap_pos := buf_len(c)
        if jne_peb_dbg > 0 { mc_patch_rel32(c, jne_peb_dbg, trap_pos) }
        if jnz_ntgf > 0 { mc_patch_rel32(c, jnz_ntgf, trap_pos) }
        mc_patch_rel32(c, ja_rdtsc, trap_pos)
        mc_patch_jcc8(c, jne_trap, trap_pos)
        cg_call_fn(cg, h_shield_trap())
        mc_b2(c, 0x0F, 0x0B) // UD2 (un-hookable hardware kill!)
        cg_reg_helper(cg, h_shield_verify(), s_sv, buf_len(c))
    }

    if cg_is_helper_used(cg, h_print_bytes()) {
        mc_align16(c)
        s_pb := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        if osm <= 1 {
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b4(c, 0x48, 0x83, 0xEC, 0x50)
            mc_b4(c, 0x48, 0x89, 0x4D, 0xF8)
            mc_b4(c, 0x48, 0x89, 0x55, 0xF0)
            mc_b1(c, 0xB9)
            mc_u32(c, 0xFFFFFFF5)
            cg_call_iat(cg, iat_get_std_handle())
            mc_b3(c, 0x48, 0x89, 0xC1)
            mc_b4(c, 0x48, 0x8B, 0x55, 0xF8)
            mc_b4(c, 0x44, 0x8B, 0x45, 0xF0)
            mc_b4(c, 0x4C, 0x8D, 0x4D, 0xE8)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24)
            mc_b1(c, 0x20)
            mc_u32(c, 0)
            cg_call_iat(cg, iat_write_file())
            mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
            mc_b1(c, 0xC3)
        } else if osm == 2 or osm == 3 {
            mc_b2(c, 0x56, 0x57)
            mc_b3(c, 0x48, 0x89, 0xCE) // RSI = ptr (RCX)
            mc_b1(c, 0xBF); mc_u32(c, 1) // EDI = 1 (stdout), RDX already = len!
            mc_b1(c, 0xB8)
            if osm == 2 { mc_u32(c, 1) } else { mc_u32(c, 0x2000004) } // sys_write
            mc_b2(c, 0x0F, 0x05)
            mc_b2(c, 0x5F, 0x5E)
            mc_b1(c, 0xC3)
        } else {
            // Bare-metal / Unikernel `COM1 0x3F8` serial UART output
            mc_b3(c, 0x49, 0x89, 0xC8) // R8 = ptr
            mc_b3(c, 0x49, 0x89, 0xD1) // R9 = len
            mc_b3(c, 0x45, 0x31, 0xD2) // R10 = 0
            mc_b4(c, 0x66, 0xBA, 0xF8, 0x03) // MOV DX, 0x3F8
            ul := buf_len(c)
            mc_b3(c, 0x4D, 0x39, 0xCA)
            jae_u := mc_jcc8(c, 0x73)
            mc_b4(c, 0x43, 0x8A, 0x04, 0x10) // MOV AL, [R8 + R10]
            mc_b1(c, 0xEE)                   // OUT DX, AL
            mc_b3(c, 0x49, 0xFF, 0xC2)
            jmp_u := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, jmp_u, ul)
            mc_patch_jcc8(c, jae_u, buf_len(c))
            mc_b1(c, 0xC3)
        }
        cg_reg_helper(cg, h_print_bytes(), s_pb, buf_len(c))
    }

    if cg_is_helper_used(cg, h_print_i64()) {
        mc_align16(c)
        s_pi := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x50)
        mc_b4(c, 0x4C, 0x8D, 0x45, 0xF8)
        mc_b3(c, 0x4D, 0x89, 0xC1)
        mc_b3(c, 0x45, 0x31, 0xD2)
        mc_b3(c, 0x48, 0x89, 0xC8)
        mc_b3(c, 0x48, 0x85, 0xC0)
        jge_pi := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x48, 0xF7, 0xD8)
        mc_b3(c, 0x41, 0xB2, 0x01)
        mc_patch_jcc8(c, jge_pi, buf_len(c))
        mc_b3(c, 0x49, 0xC7, 0xC3)
        mc_u32(c, 10)
        dloop := buf_len(c)
        mc_b2(c, 0x31, 0xD2)
        mc_b3(c, 0x49, 0xF7, 0xF3)
        mc_b3(c, 0x80, 0xC2, 0x30)
        mc_b3(c, 0x49, 0xFF, 0xC8)
        mc_b3(c, 0x41, 0x88, 0x10)
        mc_b3(c, 0x48, 0x85, 0xC0)
        jnz_dl := mc_jcc8(c, 0x75)
        mc_patch_jcc8(c, jnz_dl, dloop)
        mc_b3(c, 0x45, 0x85, 0xD2)
        jz_sg := mc_jcc8(c, 0x74)
        mc_b3(c, 0x49, 0xFF, 0xC8)
        mc_b4(c, 0x41, 0xC6, 0x00, 45)
        mc_patch_jcc8(c, jz_sg, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xC1)
        mc_b3(c, 0x4C, 0x89, 0xCA)
        mc_b3(c, 0x4C, 0x29, 0xC2)
        cg_call_fn(cg, h_print_bytes())
        mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_print_i64(), s_pi, buf_len(c))
    }

    if cg_is_helper_used(cg, h_print_dec()) {
        mc_align16(c)
        s_pd := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x40)
        mc_b4(c, 0x48, 0x89, 0x4D, 0xF8)
        mc_b3(c, 0x48, 0x85, 0xC9)
        jge_pd := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xC6, 0x45, 0xEF, 45)
        mc_b4(c, 0x48, 0x8D, 0x4D, 0xEF)
        mc_b1(c, 0xBA)
        mc_u32(c, 1)
        cg_call_fn(cg, h_print_bytes())
        mc_b4(c, 0x48, 0x8B, 0x4D, 0xF8)
        mc_b3(c, 0x48, 0xF7, 0xD9)
        mc_b4(c, 0x48, 0x89, 0x4D, 0xF8)
        mc_patch_jcc8(c, jge_pd, buf_len(c))
        mc_b4(c, 0x48, 0x8B, 0x45, 0xF8)
        mc_b2(c, 0x31, 0xD2)
        mc_b3(c, 0x48, 0xC7, 0xC1)
        mc_u32(c, 10000)
        mc_b3(c, 0x48, 0xF7, 0xF1)
        mc_b4(c, 0x48, 0x89, 0x55, 0xF0)
        mc_b3(c, 0x48, 0x89, 0xC1)
        cg_call_fn(cg, h_print_i64())
        mc_b4(c, 0xC6, 0x45, 0xE8, 46)
        mc_b4(c, 0x48, 0x8B, 0x45, 0xF0)
        mc_b2(c, 0x31, 0xD2)
        mc_b3(c, 0x48, 0xC7, 0xC1)
        mc_u32(c, 100)
        mc_b3(c, 0x48, 0xF7, 0xF1)
        mc_b2(c, 0x31, 0xD2)
        mc_b3(c, 0x48, 0xC7, 0xC1)
        mc_u32(c, 10)
        mc_b3(c, 0x48, 0xF7, 0xF1)
        mc_b2(c, 0x04, 0x30)
        mc_b3(c, 0x80, 0xC2, 0x30)
        mc_b3(c, 0x88, 0x45, 0xE9)
        mc_b3(c, 0x88, 0x55, 0xEA)
        mc_b4(c, 0x48, 0x8D, 0x4D, 0xE8)
        mc_b1(c, 0xBA)
        mc_u32(c, 3)
        cg_call_fn(cg, h_print_bytes())
        mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_print_dec(), s_pd, buf_len(c))
    }

    if cg_is_helper_used(cg, h_clock_ns()) {
        mc_align16(c)
        s_ck := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        if osm <= 1 {
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b4(c, 0x48, 0x83, 0xEC, 0x40)
            mc_b4(c, 0x48, 0x8D, 0x4D, 0xF8)
            cg_call_iat(cg, iat_qpc())
            mc_b4(c, 0x48, 0x8D, 0x4D, 0xF0)
            cg_call_iat(cg, iat_qpf())
            mc_b4(c, 0x48, 0x8B, 0x45, 0xF8)
            mc_b3(c, 0x48, 0xC7, 0xC1)
            mc_u32(c, 1000000000)
            mc_b3(c, 0x48, 0xF7, 0xE1)
            mc_b4(c, 0x48, 0x8B, 0x4D, 0xF0)
            mc_b3(c, 0x48, 0xF7, 0xF1)
            mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
            mc_b1(c, 0xC3)
        } else if osm == 2 {
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b2(c, 0x56, 0x57)
            mc_b4(c, 0x48, 0x83, 0xEC, 0x20)
            mc_b1(c, 0xBF); mc_u32(c, 1) // CLOCK_MONOTONIC = 1
            mc_b3(c, 0x48, 0x89, 0xE6)   // RSI = RSP (&timespec)
            mc_b1(c, 0xB8); mc_u32(c, 228) // sys_clock_gettime
            mc_b2(c, 0x0F, 0x05)
            mc_b3(c, 0x48, 0x8B, 0x04); mc_b1(c, 0x24) // tv_sec
            mc_b3(c, 0x48, 0x69, 0xC0); mc_u32(c, 1000000000)
            mc_b4(c, 0x48, 0x03, 0x44, 0x24); mc_b1(c, 0x08) // + tv_nsec
            mc_b4(c, 0x48, 0x83, 0xC4, 0x20)
            mc_b2(c, 0x5F, 0x5E)
            mc_b1(c, 0x5D)
            mc_b1(c, 0xC3)
        } else {
            mc_b2(c, 0x0F, 0x31) // RDTSC
            mc_b4(c, 0x48, 0xC1, 0xE2, 0x20)
            mc_b3(c, 0x48, 0x09, 0xD0)
            mc_b1(c, 0xC3)
        }
        cg_reg_helper(cg, h_clock_ns(), s_ck, buf_len(c))
    }

    if cg_is_helper_used(cg, h_sec_trap()) {
        sec_msg := "[AXON SECURITY] Memory/Arithmetic safety violation blocked\n"
        sec_off := cg_intern_lit(cg, sec_msg)
        bt_hdr := "Stack backtrace:\n"
        bt_hdr_off := cg_intern_lit(cg, bt_hdr)
        bt_pfx := "  #"
        bt_pfx_off := cg_intern_lit(cg, bt_pfx)
        bt_sp := "  "
        bt_sp_off := cg_intern_lit(cg, bt_sp)
        bt_nl := "\n"
        bt_nl_off := cg_intern_lit(cg, bt_nl)
        symtab_roff := ibuf_get(cg.state, 22)
        mc_align16(c)
        s_t1 := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        // Capture faulting RIP (`[RSP]`) and frame pointer (`RBP`) BEFORE setting up trap frame!
        mc_b4(c, 0x4C, 0x8B, 0x2C, 0x24) // MOV R13, [RSP]
        mc_b3(c, 0x49, 0x89, 0xEE)       // MOV R14, RBP
        mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
        mc_b4(c, 0x48, 0x83, 0xE4, 0xF0)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x20)
        cg_lea_rax_rdata(cg, sec_off)
        mc_b3(c, 0x48, 0x89, 0xC1)
        mc_b1(c, 0xBA)
        mc_u32(c, str_len(sec_msg))
        cg_call_fn(cg, h_print_bytes())
        if symtab_roff > 0 {
            cg_lea_rax_rdata(cg, bt_hdr_off)
            mc_b3(c, 0x48, 0x89, 0xC1)
            mc_b1(c, 0xBA); mc_u32(c, str_len(bt_hdr))
            cg_call_fn(cg, h_print_bytes())
            // R12 = PIE runtime `.text + 0` base
            mc_b3(c, 0x4C, 0x8D, 0x25)
            mc_u32(c, 0 - (buf_len(c) + 4))
            // R15 = PIE runtime `.rdata` user base, RBX = symtab base
            cg_lea_rax_rdata(cg, 0); mc_b3(c, 0x49, 0x89, 0xC7)
            cg_lea_rax_rdata(cg, symtab_roff); mc_b3(c, 0x48, 0x89, 0xC3)
            mc_b2(c, 0x31, 0xF6) // XOR ESI, ESI (frame index = 0)
            lp_bt := buf_len(c)
            mc_b3(c, 0x4C, 0x89, 0xE8) // MOV RAX, R13
            mc_b3(c, 0x4C, 0x29, 0xE0) // SUB RAX, R12 (rel_rip)
            mc_b3(c, 0x48, 0xFF, 0xC8) // DEC RAX (point inside CALL instruction so fn_end stub matches `#0`!)
            mc_b3(c, 0x48, 0x89, 0xDF) // MOV RDI, RBX
            lp_sym := buf_len(c)
            mc_b2(c, 0x8B, 0x0F)             // MOV ECX, [RDI] (start)
            mc_b3(c, 0x8B, 0x57, 0x04)       // MOV EDX, [RDI + 4] (end)
            mc_b2(c, 0x85, 0xD2); jz_smiss := mc_jcc32(c, 0x84)
            mc_b3(c, 0x48, 0x39, 0xC8); jb_snext := mc_jcc8(c, 0x72)
            mc_b3(c, 0x48, 0x39, 0xD0); jae_snext := mc_jcc8(c, 0x73)
            // Matched function entry `[RDI]`! Print `  #<idx>  <name>\n`
            cg_lea_rax_rdata(cg, bt_pfx_off); mc_b3(c, 0x48, 0x89, 0xC1)
            mc_b1(c, 0xBA); mc_u32(c, str_len(bt_pfx))
            cg_call_fn(cg, h_print_bytes())
            mc_b3(c, 0x48, 0x89, 0xF1) // MOV RCX, RSI
            cg_call_fn(cg, h_print_i64())
            cg_lea_rax_rdata(cg, bt_sp_off); mc_b3(c, 0x48, 0x89, 0xC1)
            mc_b1(c, 0xBA); mc_u32(c, str_len(bt_sp))
            cg_call_fn(cg, h_print_bytes())
            mc_b3(c, 0x8B, 0x4F, 0x08) // MOV ECX, [RDI + 8] (name_roff)
            mc_b3(c, 0x4C, 0x01, 0xF9) // ADD RCX, R15
            mc_b3(c, 0x8B, 0x57, 0x0C) // MOV EDX, [RDI + 12] (name_len)
            cg_call_fn(cg, h_print_bytes())
            cg_lea_rax_rdata(cg, bt_nl_off); mc_b3(c, 0x48, 0x89, 0xC1)
            mc_b1(c, 0xBA); mc_u32(c, 1)
            cg_call_fn(cg, h_print_bytes())
            jmp_bt_next := mc_jmp32(c)
            sym_next_p := buf_len(c)
            mc_patch_jcc8(c, jb_snext, sym_next_p)
            mc_patch_jcc8(c, jae_snext, sym_next_p)
            mc_b4(c, 0x48, 0x83, 0xC7, 0x10) // ADD RDI, 16
            jmp_lp_sym := mc_jmp32(c)
            mc_patch_rel32(c, jmp_lp_sym, lp_sym)
            mc_patch_rel32(c, jz_smiss, buf_len(c))
            mc_b3(c, 0x48, 0x85, 0xF6); jnz_bt_done0 := mc_jcc32(c, 0x85)
            // Advance frame pointer safely
            bt_next_p := buf_len(c)
            mc_patch_rel32(c, jmp_bt_next, bt_next_p)
            mc_b3(c, 0x4D, 0x85, 0xF6); jz_bt_d1 := mc_jcc32(c, 0x84) // TEST R14, R14
            mc_b3(c, 0x49, 0xF7, 0xC6); mc_u32(c, 7); jnz_bt_d2 := mc_jcc32(c, 0x85) // TEST R14, 7
            mc_b3(c, 0x49, 0x8B, 0x06)       // MOV RAX, [R14] (next_rbp)
            mc_b3(c, 0x4C, 0x39, 0xF0); jbe_bt_d3 := mc_jcc32(c, 0x86) // CMP RAX, R14
            mc_b3(c, 0x48, 0x89, 0xC2); mc_b3(c, 0x4C, 0x29, 0xF2) // RDX = RAX - R14
            mc_b3(c, 0x48, 0x81, 0xFA); mc_u32(c, 0x100000); ja_bt_d4 := mc_jcc32(c, 0x87)
            mc_b4(c, 0x4D, 0x8B, 0x6E, 0x08) // MOV R13, [R14 + 8] (caller RIP)
            mc_b3(c, 0x49, 0x89, 0xC6)       // MOV R14, RAX
            mc_b3(c, 0x48, 0xFF, 0xC6)       // INC RSI
            mc_b4(c, 0x48, 0x83, 0xFE, 0x10) // CMP RSI, 16
            jl_bt := mc_jcc32(c, 0x8C)
            mc_patch_rel32(c, jl_bt, lp_bt)
            bt_done_p := buf_len(c)
            mc_patch_rel32(c, jnz_bt_done0, bt_done_p)
            mc_patch_rel32(c, jz_bt_d1, bt_done_p)
            mc_patch_rel32(c, jnz_bt_d2, bt_done_p)
            mc_patch_rel32(c, jbe_bt_d3, bt_done_p)
            mc_patch_rel32(c, ja_bt_d4, bt_done_p)
        }
        cg_emit_exit_imm(cg, 101)
        cg_reg_helper(cg, h_sec_trap(), s_t1, buf_len(c))
    }

    if cg_is_helper_used(cg, h_shield_trap()) {
        shd_msg := "[AXON SHIELD] Code integrity verification mismatch blocked\n"
        shd_off := cg_intern_lit(cg, shd_msg)
        mc_align16(c)
        s_t2 := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
        mc_b4(c, 0x48, 0x83, 0xE4, 0xF0)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x20)
        cg_lea_rax_rdata(cg, shd_off)
        mc_b3(c, 0x48, 0x89, 0xC1)
        mc_b1(c, 0xBA)
        mc_u32(c, str_len(shd_msg))
        cg_call_fn(cg, h_print_bytes())
        cg_emit_exit_imm(cg, 255)
        mc_b2(c, 0x0F, 0x0B) // UD2 fallback if ExitProcess is hooked!
        mc_b1(c, 0xCC)
        cg_reg_helper(cg, h_shield_trap(), s_t2, buf_len(c))
    }

    emit_io_helpers_used(cg)
}

fn emit_io_helpers_used(cg: CodegenCtx) {
    c := cg.code
    osm := cg_os_mode(cg)

    if cg_is_helper_used(cg, h_str_eq()) {
        mc_align16(c)
        s_eq := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        mc_b3(c, 0x4C, 0x39, 0xCA)
        jne_len := mc_jcc8(c, 0x75)
        mc_b2(c, 0x31, 0xC0)
        lpos := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD0)
        jae_t := mc_jcc8(c, 0x73)
        mc_b4(c, 0x44, 0x8A, 0x14, 0x01)
        mc_b4(c, 0x45, 0x3A, 0x14, 0x00)
        jne_b := mc_jcc8(c, 0x75)
        mc_b3(c, 0x48, 0xFF, 0xC0)
        jmp_l := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_l, lpos)
        r_true := buf_len(c)
        mc_b1(c, 0xB8)
        mc_u32(c, 1)
        mc_b1(c, 0xC3)
        r_false := buf_len(c)
        mc_b3(c, 0x31, 0xC0, 0xC3)
        mc_patch_jcc8(c, jae_t, r_true)
        mc_patch_jcc8(c, jne_len, r_false)
        mc_patch_jcc8(c, jne_b, r_false)
        cg_reg_helper(cg, h_str_eq(), s_eq, buf_len(c))
    }

    if cg_is_helper_used(cg, h_args_get()) {
        mc_align16(c)
        s_ag := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        if osm <= 1 {
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b4(c, 0x48, 0x83, 0xEC, 0x30)
            mc_b4(c, 0x48, 0x89, 0x4D, 0xF8)
            cg_call_iat(cg, iat_get_command_line_a())
            mc_b3(c, 0x49, 0x89, 0xC0)
            mc_b3(c, 0x45, 0x31, 0xC9)
            mc_b4(c, 0x4C, 0x8B, 0x55, 0xF8)

            next_tok := buf_len(c)
            skip_ws := buf_len(c)
            mc_b4(c, 0x41, 0x0F, 0xB6, 0x00)
            mc_b2(c, 0x3C, 32)
            je_sp := mc_jcc8(c, 0x74)
            mc_b2(c, 0x3C, 9)
            jne_wsd := mc_jcc8(c, 0x75)
            mc_patch_jcc8(c, je_sp, buf_len(c))
            mc_b3(c, 0x49, 0xFF, 0xC0)
            jmp_ws := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, jmp_ws, skip_ws)
            mc_patch_jcc8(c, jne_wsd, buf_len(c))

            mc_b2(c, 0x84, 0xC0)
            jz_done := mc_jcc32(c, 0x84)
            mc_b2(c, 0x3C, 34)
            jne_uq := mc_jcc8(c, 0x75)

            mc_b3(c, 0x49, 0xFF, 0xC0)
            mc_b3(c, 0x4C, 0x89, 0xC1)
            ql := buf_len(c)
            mc_b4(c, 0x41, 0x0F, 0xB6, 0x00)
            mc_b2(c, 0x84, 0xC0)
            jz_qe := mc_jcc8(c, 0x74)
            mc_b2(c, 0x3C, 34)
            je_qe := mc_jcc8(c, 0x74)
            mc_b3(c, 0x49, 0xFF, 0xC0)
            j_ql := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, j_ql, ql)
            mc_patch_jcc8(c, jz_qe, buf_len(c))
            mc_patch_jcc8(c, je_qe, buf_len(c))
            mc_b3(c, 0x4C, 0x89, 0xC2)
            mc_b3(c, 0x48, 0x29, 0xCA)
            mc_b2(c, 0x3C, 34)
            jne_gfq := mc_jcc8(c, 0x75)
            mc_b3(c, 0x49, 0xFF, 0xC0)
            jmp_gfq := mc_jcc8(c, 0xEB)

            mc_patch_jcc8(c, jne_uq, buf_len(c))
            mc_b3(c, 0x4C, 0x89, 0xC1)
            uql := buf_len(c)
            mc_b4(c, 0x41, 0x0F, 0xB6, 0x00)
            mc_b2(c, 0x84, 0xC0)
            jz_uqe := mc_jcc8(c, 0x74)
            mc_b2(c, 0x3C, 32)
            je_uqs := mc_jcc8(c, 0x74)
            mc_b2(c, 0x3C, 9)
            je_uqt := mc_jcc8(c, 0x74)
            mc_b3(c, 0x49, 0xFF, 0xC0)
            j_uql := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, j_uql, uql)
            mc_patch_jcc8(c, jz_uqe, buf_len(c))
            mc_patch_jcc8(c, je_uqs, buf_len(c))
            mc_patch_jcc8(c, je_uqt, buf_len(c))
            mc_b3(c, 0x4C, 0x89, 0xC2)
            mc_b3(c, 0x48, 0x29, 0xCA)

            mc_patch_jcc8(c, jne_gfq, buf_len(c))
            mc_patch_jcc8(c, jmp_gfq, buf_len(c))
            mc_b3(c, 0x4D, 0x39, 0xD1)
            je_fnd := mc_jcc8(c, 0x74)
            mc_b3(c, 0x49, 0xFF, 0xC1)
            j_nt := mc_jmp32(c)
            mc_patch_rel32(c, j_nt, next_tok)

            mc_patch_jcc8(c, je_fnd, buf_len(c))
            mc_b3(c, 0x48, 0x89, 0xC8)
            mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
            mc_b1(c, 0xC3)

            mc_patch_rel32(c, jz_done, buf_len(c))
            mc_b3(c, 0x4D, 0x85, 0xD2)
            jns_nc := mc_jcc8(c, 0x79)
            mc_b3(c, 0x4C, 0x89, 0xC8)
            mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
            mc_b1(c, 0xC3)
            mc_patch_jcc8(c, jns_nc, buf_len(c))
            mc_b4(c, 0x31, 0xC0, 0x31, 0xD2)
            mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
            mc_b1(c, 0xC3)
        } else {
            // Linux / macOS SysV `_start` stack: `[saved_rsp] = argc`, `[saved_rsp + 8 + idx*8] = argv[idx]`
            cg_mov_rax_data(cg, data_off_unix_rsp())
            mc_b3(c, 0x48, 0x85, 0xC0)
            jz_no_rsp := mc_jcc8(c, 0x74)
            mc_b3(c, 0x4C, 0x8B, 0x00) // R8 = argc
            mc_b3(c, 0x48, 0x85, 0xC9) // TEST RCX, RCX (`idx < 0` -> return `argc`)
            jns_idx := mc_jcc8(c, 0x79)
            mc_b3(c, 0x4C, 0x89, 0xC0)
            mc_b1(c, 0xC3)
            mc_patch_jcc8(c, jns_idx, buf_len(c))
            mc_b3(c, 0x4C, 0x39, 0xC1) // CMP RCX, R8
            jae_oob := mc_jcc8(c, 0x73)
            mc_b4(c, 0x48, 0x8B, 0x44, 0xC8); mc_b1(c, 0x08) // RAX = [RAX + RCX*8 + 8]
            mc_b2(c, 0x31, 0xD2)
            sl_top := buf_len(c)
            mc_b4(c, 0x80, 0x3C, 0x10, 0x00) // CMP byte [RAX + RDX], 0
            je_sld := mc_jcc8(c, 0x74)
            mc_b3(c, 0x48, 0xFF, 0xC2)
            jmp_sl := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, jmp_sl, sl_top)
            mc_patch_jcc8(c, je_sld, buf_len(c))
            mc_b1(c, 0xC3)
            mc_patch_jcc8(c, jz_no_rsp, buf_len(c))
            mc_patch_jcc8(c, jae_oob, buf_len(c))
            mc_b4(c, 0x31, 0xC0, 0x31, 0xD2)
            mc_b1(c, 0xC3)
        }
        cg_reg_helper(cg, h_args_get(), s_ag, buf_len(c))

        if cg_is_helper_used(cg, h_args_count()) {
            mc_align16(c)
            s_ac := buf_len(c)
            mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
            mc_b3(c, 0x48, 0xC7, 0xC1)
            mc_u32(c, 0xFFFFFFFF)
            j_ag := mc_jmp32(c)
            mc_patch_rel32(c, j_ag, s_ag)
            cg_reg_helper(cg, h_args_count(), s_ac, buf_len(c))
        }
    }

    emit_fs_helpers_used(cg)
}

fn emit_fs_helpers_used(cg: CodegenCtx) {
    c := cg.code
    osm := cg_os_mode(cg)

    if cg_is_helper_used(cg, h_fs_read()) {
        mc_align16(c)
        s_fr := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        if osm <= 1 {
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b3(c, 0x48, 0x81, 0xEC)
            mc_u32(c, 0x280)
            mc_b3(c, 0x48, 0x85, 0xC9) // TEST RCX, RCX
            jz_rnull := mc_jcc32(c, 0x84)
            mc_b3(c, 0x48, 0x85, 0xD2) // TEST RDX, RDX
            jle_rlen := mc_jcc32(c, 0x8E)
            mc_b3(c, 0x48, 0x81, 0xFA); mc_u32(c, 500) // CMP RDX, 500
            jae_rlen := mc_jcc32(c, 0x83) // reject path >= 500 bytes (no silent truncation)
            mc_b3(c, 0x4C, 0x8D, 0x85)
            mc_u32(c, 0 - 0x220)
            mc_b2(c, 0x31, 0xC0)
            cpl1 := buf_len(c)
            mc_b3(c, 0x48, 0x39, 0xD0)
            ja1 := mc_jcc8(c, 0x73)
            mc_b4(c, 0x44, 0x8A, 0x0C, 0x01)
            mc_b3(c, 0x45, 0x84, 0xC9) // TEST R9B, R9B (reject embedded NUL CWE-158)
            jz_rnul := mc_jcc32(c, 0x84)
            mc_b4(c, 0x45, 0x88, 0x0C, 0x00)
            mc_b3(c, 0x48, 0xFF, 0xC0)
            jcp1 := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, jcp1, cpl1)
            mc_patch_jcc8(c, ja1, buf_len(c))
            mc_b4(c, 0x41, 0xC6, 0x04, 0x00)
            mc_b1(c, 0)

            mc_b3(c, 0x4C, 0x89, 0xC1)
            mc_b1(c, 0xBA)
            mc_u32(c, 0x80000000)
            mc_b2(c, 0x41, 0xB8)
            mc_u32(c, 1)
            mc_b3(c, 0x45, 0x31, 0xC9)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24)
            mc_b1(c, 0x20)
            mc_u32(c, 3)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24)
            mc_b1(c, 0x28)
            mc_u32(c, 0x80)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24)
            mc_b1(c, 0x30)
            mc_u32(c, 0)
            cg_call_iat(cg, iat_create_file_a())

            mc_b4(c, 0x48, 0x83, 0xF8, 0xFF)
            je_er1 := mc_jcc32(c, 0x84)
            mc_b4(c, 0x48, 0x89, 0x45, 0xF8)
            mc_b3(c, 0x48, 0x89, 0xC1)
            mc_b4(c, 0x48, 0x8D, 0x55, 0xF0)
            cg_call_iat(cg, iat_get_file_size_ex())
            mc_b2(c, 0x85, 0xC0)
            jz_gsz := mc_jcc32(c, 0x84)
            mc_b4(c, 0x48, 0x8B, 0x55, 0xF0)
            mc_b3(c, 0x48, 0x85, 0xD2)
            js_fsz := mc_jcc32(c, 0x88)
            mc_b3(c, 0x48, 0x81, 0xFA); mc_u32(c, 0x7FFF0000)
            ja_fsz := mc_jcc32(c, 0x87)

            mc_b4(c, 0x48, 0x8D, 0x4A, 0x40) // LEA RCX, [RDX + 64]
            cg_call_fn(cg, h_alloc_mem())
            mc_b3(c, 0x48, 0x85, 0xC0)
            jz_va := mc_jcc32(c, 0x84)

            mc_b4(c, 0x48, 0x89, 0x45, 0xE8)
            mc_b4(c, 0x48, 0x8B, 0x55, 0xF0)
            mc_b4(c, 0x48, 0x83, 0xC2, 0x20)
            mc_b4(c, 0x48, 0x89, 0x50, 0x08)
            mc_b4(c, 0x48, 0x8B, 0x4D, 0xF8)
            mc_b4(c, 0x48, 0x8D, 0x50, 0x10)
            mc_b4(c, 0x44, 0x8B, 0x45, 0xF0)
            mc_b4(c, 0x4C, 0x8D, 0x4D, 0xE0)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24)
            mc_b1(c, 0x20)
            mc_u32(c, 0)
            mc_b4(c, 0x48, 0xC7, 0x45, 0xE0)
            mc_u32(c, 0)
            cg_call_iat(cg, iat_read_file())

            mc_b4(c, 0x48, 0x8B, 0x45, 0xE8)
            mc_b3(c, 0x8B, 0x55, 0xE0)
            mc_b3(c, 0x48, 0x89, 0x10)
            mc_b4(c, 0x48, 0x8B, 0x4D, 0xF8)
            cg_call_iat(cg, iat_close_handle())

            mc_b2(c, 0x31, 0xC0)
            mc_b4(c, 0x48, 0x8B, 0x55, 0xE8)
            mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
            mc_b1(c, 0xC3)

            mc_patch_rel32(c, jz_gsz, buf_len(c))
            mc_patch_rel32(c, js_fsz, buf_len(c))
            mc_patch_rel32(c, ja_fsz, buf_len(c))
            mc_patch_rel32(c, jz_va, buf_len(c))
            mc_b4(c, 0x48, 0x8B, 0x4D, 0xF8)
            cg_call_iat(cg, iat_close_handle())

            mc_patch_rel32(c, jz_rnull, buf_len(c))
            mc_patch_rel32(c, jz_rnul, buf_len(c))
            mc_patch_rel32(c, jle_rlen, buf_len(c))
            mc_patch_rel32(c, jae_rlen, buf_len(c))
            mc_patch_rel32(c, je_er1, buf_len(c))
            mc_b1(c, 0xB8)
            mc_u32(c, 1)
            mc_b2(c, 0x31, 0xD2)
            mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
            mc_b1(c, 0xC3)
        } else {
            // Direct Linux x86_64 `openat(257)` + `lseek(8)` + `h_alloc_mem` + `read(0)` + `close(3)`
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b2(c, 0x56, 0x57)
            mc_b3(c, 0x48, 0x81, 0xEC); mc_u32(c, 0x260)
            mc_b3(c, 0x48, 0x85, 0xC9)
            jz_lrnull := mc_jcc32(c, 0x84)
            mc_b3(c, 0x48, 0x85, 0xD2)
            jle_lrlen := mc_jcc32(c, 0x8E)
            mc_b3(c, 0x48, 0x81, 0xFA); mc_u32(c, 500)
            jae_lrlen := mc_jcc32(c, 0x83)
            mc_b3(c, 0x4C, 0x8D, 0x85); mc_u32(c, 0 - 0x220)
            mc_b2(c, 0x31, 0xC0)
            lcpl := buf_len(c)
            mc_b3(c, 0x48, 0x39, 0xD0)
            lja1 := mc_jcc8(c, 0x73)
            mc_b4(c, 0x44, 0x8A, 0x0C, 0x01)
            mc_b3(c, 0x45, 0x84, 0xC9)
            jz_lrnul := mc_jcc32(c, 0x84)
            mc_b4(c, 0x45, 0x88, 0x0C, 0x00)
            mc_b3(c, 0x48, 0xFF, 0xC0)
            ljcp := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, ljcp, lcpl)
            mc_patch_jcc8(c, lja1, buf_len(c))
            mc_b4(c, 0x41, 0xC6, 0x04, 0x00); mc_b1(c, 0)

            // sys_openat(AT_FDCWD=-100, path, O_RDONLY=0, 0)
            mc_b3(c, 0x48, 0xC7, 0xC7); mc_u32(c, 0 - 100)
            mc_b3(c, 0x4C, 0x89, 0xC6) // RSI = path
            mc_b2(c, 0x31, 0xD2)       // RDX = 0
            mc_b3(c, 0x45, 0x31, 0xD2) // R10 = 0
            mc_b1(c, 0xB8); mc_u32(c, 257)
            mc_b2(c, 0x0F, 0x05)
            mc_b3(c, 0x48, 0x85, 0xC0)
            jl_er := mc_jcc32(c, 0x8C)
            mc_b4(c, 0x48, 0x89, 0x45, 0xE8) // [RBP-0x18] = fd

            // size = sys_lseek(fd, 0, SEEK_END=2)
            mc_b3(c, 0x48, 0x89, 0xC7)
            mc_b2(c, 0x31, 0xF6)
            mc_b1(c, 0xBA); mc_u32(c, 2)
            mc_b1(c, 0xB8); mc_u32(c, 8)
            mc_b2(c, 0x0F, 0x05)
            mc_b3(c, 0x48, 0x85, 0xC0)
            jl_lsz := mc_jcc32(c, 0x8C)
            mc_b2(c, 0x48, 0x3D); mc_u32(c, 0x7FFF0000)
            ja_lsz := mc_jcc32(c, 0x87)
            mc_b4(c, 0x48, 0x89, 0x45, 0xE0) // [RBP-0x20] = size

            // sys_lseek(fd, 0, SEEK_SET=0)
            mc_b4(c, 0x48, 0x8B, 0x7D, 0xE8)
            mc_b2(c, 0x31, 0xF6)
            mc_b2(c, 0x31, 0xD2)
            mc_b1(c, 0xB8); mc_u32(c, 8)
            mc_b2(c, 0x0F, 0x05)

            // buf = h_alloc_mem(size + 64)
            mc_b4(c, 0x48, 0x8B, 0x4D, 0xE0)
            mc_b4(c, 0x48, 0x83, 0xC1, 0x40)
            cg_call_fn(cg, h_alloc_mem())
            mc_b3(c, 0x48, 0x85, 0xC0)
            jz_lva := mc_jcc32(c, 0x84)
            mc_b4(c, 0x48, 0x89, 0x45, 0xD8) // [RBP-0x28] = buf
            mc_b4(c, 0x48, 0x8B, 0x55, 0xE0)
            mc_b4(c, 0x48, 0x83, 0xC2, 0x20)
            mc_b4(c, 0x48, 0x89, 0x50, 0x08) // [buf+8] = cap

            // nread = sys_read(fd, buf+16, size)
            mc_b4(c, 0x48, 0x8B, 0x7D, 0xE8)
            mc_b4(c, 0x48, 0x8D, 0x70, 0x10)
            mc_b4(c, 0x48, 0x8B, 0x55, 0xE0)
            mc_b2(c, 0x31, 0xC0) // sys_read = 0
            mc_b2(c, 0x0F, 0x05)
            mc_b3(c, 0x48, 0x85, 0xC0)
            jge_lrd := mc_jcc8(c, 0x7D)
            mc_b2(c, 0x31, 0xC0)
            mc_patch_jcc8(c, jge_lrd, buf_len(c))
            mc_b4(c, 0x48, 0x8B, 0x55, 0xD8)
            mc_b3(c, 0x48, 0x89, 0x02) // [buf] = nread

            // sys_close(fd)
            mc_b4(c, 0x48, 0x8B, 0x7D, 0xE8)
            mc_b1(c, 0xB8); mc_u32(c, 3)
            mc_b2(c, 0x0F, 0x05)

            mc_b2(c, 0x31, 0xC0)
            mc_b4(c, 0x48, 0x8B, 0x55, 0xD8)
            mc_b3(c, 0x48, 0x81, 0xC4); mc_u32(c, 0x260)
            mc_b2(c, 0x5F, 0x5E)
            mc_b1(c, 0x5D)
            mc_b1(c, 0xC3)

            mc_patch_rel32(c, jl_lsz, buf_len(c))
            mc_patch_rel32(c, ja_lsz, buf_len(c))
            mc_patch_rel32(c, jz_lva, buf_len(c))
            mc_b4(c, 0x48, 0x8B, 0x7D, 0xE8)
            mc_b1(c, 0xB8); mc_u32(c, 3)
            mc_b2(c, 0x0F, 0x05)

            mc_patch_rel32(c, jz_lrnull, buf_len(c))
            mc_patch_rel32(c, jz_lrnul, buf_len(c))
            mc_patch_rel32(c, jle_lrlen, buf_len(c))
            mc_patch_rel32(c, jae_lrlen, buf_len(c))
            mc_patch_rel32(c, jl_er, buf_len(c))
            mc_b1(c, 0xB8); mc_u32(c, 1)
            mc_b2(c, 0x31, 0xD2)
            mc_b3(c, 0x48, 0x81, 0xC4); mc_u32(c, 0x260)
            mc_b2(c, 0x5F, 0x5E)
            mc_b1(c, 0x5D)
            mc_b1(c, 0xC3)
        }
        cg_reg_helper(cg, h_fs_read(), s_fr, buf_len(c))
    }

    if cg_is_helper_used(cg, h_fs_write()) {
        mc_align16(c)
        s_fw := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        if osm <= 1 {
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b3(c, 0x48, 0x81, 0xEC)
            mc_u32(c, 0x280)
            mc_b4(c, 0x4C, 0x89, 0x45, 0xE8)
            mc_b3(c, 0x48, 0x85, 0xC9)
            jz_wnull := mc_jcc32(c, 0x84)
            mc_b3(c, 0x4D, 0x85, 0xC0) // TEST R8, R8 (buf ptr)
            jz_wbuf := mc_jcc32(c, 0x84)
            mc_b3(c, 0x48, 0x85, 0xD2)
            jle_wlen := mc_jcc32(c, 0x8E)
            mc_b3(c, 0x48, 0x81, 0xFA); mc_u32(c, 500)
            jae_wlen := mc_jcc32(c, 0x83)
            mc_b3(c, 0x4C, 0x8D, 0x85)
            mc_u32(c, 0 - 0x220)
            mc_b2(c, 0x31, 0xC0)
            cpl2 := buf_len(c)
            mc_b3(c, 0x48, 0x39, 0xD0)
            jb1 := mc_jcc8(c, 0x73)
            mc_b4(c, 0x44, 0x8A, 0x0C, 0x01)
            mc_b3(c, 0x45, 0x84, 0xC9)
            jz_wnul := mc_jcc32(c, 0x84)
            mc_b4(c, 0x45, 0x88, 0x0C, 0x00)
            mc_b3(c, 0x48, 0xFF, 0xC0)
            jcp2 := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, jcp2, cpl2)
            mc_patch_jcc8(c, jb1, buf_len(c))
            mc_b4(c, 0x41, 0xC6, 0x04, 0x00)
            mc_b1(c, 0)

            mc_b3(c, 0x4C, 0x89, 0xC1)
            mc_b1(c, 0xBA)
            mc_u32(c, 0x40000000)
            mc_b3(c, 0x45, 0x31, 0xC0)
            mc_b3(c, 0x45, 0x31, 0xC9)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24)
            mc_b1(c, 0x20)
            mc_u32(c, 2)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24)
            mc_b1(c, 0x28)
            mc_u32(c, 0x80)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24)
            mc_b1(c, 0x30)
            mc_u32(c, 0)
            cg_call_iat(cg, iat_create_file_a())

            mc_b4(c, 0x48, 0x83, 0xF8, 0xFF)
            je_er2 := mc_jcc32(c, 0x84)
            mc_b4(c, 0x48, 0x89, 0x45, 0xF8)
            mc_b4(c, 0x4C, 0x8B, 0x55, 0xE8)
            mc_b3(c, 0x48, 0x89, 0xC1)
            mc_b4(c, 0x49, 0x8D, 0x52, 0x10)
            mc_b3(c, 0x45, 0x8B, 0x02)
            mc_b4(c, 0x4C, 0x8D, 0x4D, 0xE0)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24)
            mc_b1(c, 0x20)
            mc_u32(c, 0)
            mc_b4(c, 0x48, 0xC7, 0x45, 0xE0)
            mc_u32(c, 0)
            cg_call_iat(cg, iat_write_file())

            mc_b4(c, 0x48, 0x8B, 0x4D, 0xF8)
            cg_call_iat(cg, iat_close_handle())

            mc_b2(c, 0x31, 0xC0)
            mc_b3(c, 0x8B, 0x55, 0xE0)
            mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
            mc_b1(c, 0xC3)

            mc_patch_rel32(c, jz_wnull, buf_len(c))
            mc_patch_rel32(c, jz_wnul, buf_len(c))
            mc_patch_rel32(c, jz_wbuf, buf_len(c))
            mc_patch_rel32(c, jle_wlen, buf_len(c))
            mc_patch_rel32(c, jae_wlen, buf_len(c))
            mc_patch_rel32(c, je_er2, buf_len(c))
            mc_b1(c, 0xB8)
            mc_u32(c, 1)
            mc_b2(c, 0x31, 0xD2)
            mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
            mc_b1(c, 0xC3)
        } else {
            // Direct Linux x86_64 `openat(257, O_WRONLY|O_CREAT|O_TRUNC=0x241, 0755=493)` + `write(1)` + `close(3)`
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b2(c, 0x56, 0x57)
            mc_b3(c, 0x48, 0x81, 0xEC); mc_u32(c, 0x260)
            mc_b4(c, 0x4C, 0x89, 0x45, 0xE8) // [RBP-0x18] = buf (R8)
            mc_b3(c, 0x48, 0x85, 0xC9)
            jz_lwn := mc_jcc32(c, 0x84)
            mc_b3(c, 0x4D, 0x85, 0xC0)
            jz_lwb := mc_jcc32(c, 0x84)
            mc_b3(c, 0x48, 0x85, 0xD2)
            jle_lwl := mc_jcc32(c, 0x8E)
            mc_b3(c, 0x48, 0x81, 0xFA); mc_u32(c, 500)
            jae_lwl := mc_jcc32(c, 0x83)
            mc_b3(c, 0x4C, 0x8D, 0x85); mc_u32(c, 0 - 0x220)
            mc_b2(c, 0x31, 0xC0)
            lcpl2 := buf_len(c)
            mc_b3(c, 0x48, 0x39, 0xD0)
            ljb1 := mc_jcc8(c, 0x73)
            mc_b4(c, 0x44, 0x8A, 0x0C, 0x01)
            mc_b3(c, 0x45, 0x84, 0xC9)
            jz_lwnul := mc_jcc32(c, 0x84)
            mc_b4(c, 0x45, 0x88, 0x0C, 0x00)
            mc_b3(c, 0x48, 0xFF, 0xC0)
            ljcp2 := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, ljcp2, lcpl2)
            mc_patch_jcc8(c, ljb1, buf_len(c))
            mc_b4(c, 0x41, 0xC6, 0x04, 0x00); mc_b1(c, 0)

            mc_b3(c, 0x48, 0xC7, 0xC7); mc_u32(c, 0 - 100) // AT_FDCWD
            mc_b3(c, 0x4C, 0x89, 0xC6)
            mc_b1(c, 0xBA); mc_u32(c, 0x241)
            mc_b3(c, 0x49, 0xC7, 0xC2); mc_u32(c, 493) // 0755 executable permissions!
            mc_b1(c, 0xB8); mc_u32(c, 257)
            mc_b2(c, 0x0F, 0x05)
            mc_b3(c, 0x48, 0x85, 0xC0)
            jl_er2 := mc_jcc32(c, 0x8C)
            mc_b4(c, 0x48, 0x89, 0x45, 0xE0) // [RBP-0x20] = fd

            mc_b3(c, 0x48, 0x89, 0xC7) // EDI = fd
            mc_b4(c, 0x48, 0x8B, 0x45, 0xE8)
            mc_b4(c, 0x48, 0x8D, 0x70, 0x10) // RSI = buf + 16
            mc_b3(c, 0x48, 0x8B, 0x10)       // RDX = [buf]
            mc_b1(c, 0xB8); mc_u32(c, 1)     // sys_write
            mc_b2(c, 0x0F, 0x05)
            mc_b4(c, 0x48, 0x89, 0x45, 0xD8) // [RBP-0x28] = nwritten

            mc_b4(c, 0x48, 0x8B, 0x7D, 0xE0)
            mc_b1(c, 0xB8); mc_u32(c, 3)     // sys_close
            mc_b2(c, 0x0F, 0x05)

            mc_b2(c, 0x31, 0xC0)
            mc_b4(c, 0x48, 0x8B, 0x55, 0xD8)
            mc_b3(c, 0x48, 0x81, 0xC4); mc_u32(c, 0x260)
            mc_b2(c, 0x5F, 0x5E)
            mc_b1(c, 0x5D)
            mc_b1(c, 0xC3)

            mc_patch_rel32(c, jz_lwn, buf_len(c))
            mc_patch_rel32(c, jz_lwnul, buf_len(c))
            mc_patch_rel32(c, jz_lwb, buf_len(c))
            mc_patch_rel32(c, jle_lwl, buf_len(c))
            mc_patch_rel32(c, jae_lwl, buf_len(c))
            mc_patch_rel32(c, jl_er2, buf_len(c))
            mc_b1(c, 0xB8); mc_u32(c, 1)
            mc_b2(c, 0x31, 0xD2)
            mc_b3(c, 0x48, 0x81, 0xC4); mc_u32(c, 0x260)
            mc_b2(c, 0x5F, 0x5E)
            mc_b1(c, 0x5D)
            mc_b1(c, 0xC3)
        }
        cg_reg_helper(cg, h_fs_write(), s_fw, buf_len(c))
    }

    emit_ai_runtime_helpers(cg)
}

// ---------------------------------------------------------------------------
// High-Performance AI Runtime Helpers (VEX/AVX2+FMA3 + Persistent Thread Pool)
// IDs `10000038..10000049`
// ---------------------------------------------------------------------------

fn mc_vex2(c: ByteBuf, vreg: i64, l: i64, pp: i64, op: i64, modrm: i64) {
    b1 := 0x80 | (((vreg ^ 15) & 15) << 3) | ((l & 1) << 2) | (pp & 3)
    mc_b4(c, 0xC5, b1, op, modrm)
}

fn mc_vex3(c: ByteBuf, r_hi: i64, x_hi: i64, b_hi: i64, m: i64, w: i64, vreg: i64, l: i64, pp: i64, op: i64) {
    b1 := (((r_hi ^ 1) & 1) << 7) | (((x_hi ^ 1) & 1) << 6) | (((b_hi ^ 1) & 1) << 5) | (m & 31)
    b2 := ((w & 1) << 7) | (((vreg ^ 15) & 15) << 3) | ((l & 1) << 2) | (pp & 3)
    mc_b4(c, 0xC4, b1, b2, op)
}

fn mc_ai_enter(c: ByteBuf, stack_sz: i64) {
    mc_align16(c)
    mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
    mc_b4(c, 0x55, 0x53, 0x56, 0x57)
    mc_b2(c, 0x41, 0x54)
    mc_b2(c, 0x41, 0x55)
    mc_b2(c, 0x41, 0x56)
    mc_b2(c, 0x41, 0x57)
    mc_b3(c, 0x48, 0x81, 0xEC); mc_u32(c, stack_sz)
}

fn mc_ai_leave(c: ByteBuf, stack_sz: i64) {
    mc_b3(c, 0x48, 0x81, 0xC4); mc_u32(c, stack_sz)
    mc_b2(c, 0x41, 0x5F)
    mc_b2(c, 0x41, 0x5E)
    mc_b2(c, 0x41, 0x5D)
    mc_b2(c, 0x41, 0x5C)
    mc_b4(c, 0x5F, 0x5E, 0x5B, 0x5D)
    mc_b1(c, 0xC3)
}

// Compute equal thread shard `R14 = (total * RCX) / RDX`, `R15 = (total * (RCX + 1)) / RDX`.
// Input: `RCX = wid`, `RDX = T`, `RAX = total`. Clobbers `RAX, RDX, RBX, R9`.
fn mc_ai_row_range(c: ByteBuf) {
    mc_b3(c, 0x48, 0x89, 0xD3)       // MOV RBX, RDX (T)
    mc_b3(c, 0x49, 0x89, 0xC1)       // MOV R9, RAX (total)
    mc_b3(c, 0x48, 0xF7, 0xE1)       // MUL RCX
    mc_b3(c, 0x48, 0xF7, 0xF3)       // DIV RBX
    mc_b3(c, 0x49, 0x89, 0xC6)       // MOV R14, RAX (r0)
    mc_b4(c, 0x48, 0x8D, 0x41, 0x01) // LEA RAX, [RCX + 1]
    mc_b3(c, 0x49, 0xF7, 0xE1)       // MUL R9
    mc_b3(c, 0x48, 0xF7, 0xF3)       // DIV RBX
    mc_b3(c, 0x49, 0x89, 0xC7)       // MOV R15, RAX (r1)
}

// Horizontal sum of `YMM0` (`8 x f32`) -> scalar `XMM0[0]` (`f32`). Clobbers `XMM1`.
fn mc_avx_hsum_ymm0(c: ByteBuf) {
    mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC1, 0x01) // VEXTRACTF128 XMM1, YMM0, 1
    mc_vex2(c, 0, 0, 0, 0x58, 0xC1)                                // VADDPS XMM0, XMM0, XMM1
    mc_vex2(c, 0, 0, 0, 0x12, 0xC8)                                // VMOVHLPS XMM1, XMM0, XMM0
    mc_vex2(c, 0, 0, 0, 0x58, 0xC1)                                // VADDPS XMM0, XMM0, XMM1
    mc_vex2(c, 0, 0, 0, 0xC6, 0xC8); mc_b1(c, 0x01)                // VSHUFPS XMM1, XMM0, XMM0, 1
    mc_vex2(c, 0, 0, 2, 0x58, 0xC1)                                // VADDSS XMM0, XMM0, XMM1
}

// Emit standard batch dispatcher `pub(RCX = args_ptr)` over local `wk_off` when `work_calc` >= `min_work`.
// Expects `[args_ptr + off_a*8]` * `[args_ptr + off_b*8]` >= `min_work` -> parallel dispatch; else 1T direct call.
fn mc_ai_emit_batch_pub(cg: CodegenCtx, hid: i64, wk_off: i64, off_a: i64, off_b: i64, min_work: i64) {
    c := cg.code
    mc_align16(c)
    s_pub := buf_len(c)
    mc_ai_enter(c, 0x28)
    mc_b3(c, 0x48, 0x89, 0xCB) // MOV RBX, RCX (args_ptr)
    mc_b3(c, 0x48, 0x8B, 0x43); mc_b1(c, off_a * 8) // MOV RAX, [RBX + off_a*8]
    mc_b3(c, 0x48, 0x85, 0xC0)
    jle_done := mc_jcc32(c, 0x8E)
    if off_b >= 0 {
        mc_b4(c, 0x48, 0x0F, 0xAF, 0x43); mc_b1(c, off_b * 8) // IMUL RAX, [RBX + off_b*8]
    }
    mc_b2(c, 0x48, 0x3D); mc_u32(c, min_work)
    jge_par := mc_jcc32(c, 0x8D)
    // 1T direct fast path: wk(wid=0, T=1, args_ptr - 32)
    mc_b2(c, 0x31, 0xC9)             // XOR ECX, ECX
    mc_b1(c, 0xBA); mc_u32(c, 1)     // MOV EDX, 1
    mc_b4(c, 0x4C, 0x8D, 0x43, 0xE0) // LEA R8, [RBX - 32]
    mc_b1(c, 0xE8)
    rel_c := wk_off - (buf_len(c) + 4)
    mc_u32(c, rel_c)
    jmp_end := mc_jmp32(c)
    mc_patch_rel32(c, jge_par, buf_len(c))
    mc_b3(c, 0x48, 0x8D, 0x0D)
    rel_w := wk_off - (buf_len(c) + 4)
    mc_u32(c, rel_w)                 // LEA RCX, [RIP + wk]
    mc_b3(c, 0x48, 0x89, 0xDA)       // MOV RDX, RBX
    cg_call_fn(cg, h_ai_pool_dispatch())
    mc_patch_rel32(c, jle_done, buf_len(c))
    mc_patch_rel32(c, jmp_end, buf_len(c))
    mc_b2(c, 0x31, 0xC0)
    mc_ai_leave(c, 0x28)
    cg_reg_helper(cg, hid, s_pub, buf_len(c))
}

fn emit_ai_ffi_pool_helpers(cg: CodegenCtx) {
    c := cg.code
    osm := cg_os_mode(cg)

    // 1. `h_c_call_v(RCX = fn_ptr, RDX = argc, R8 = argv_ptr) -> RAX`
    if cg_is_helper_used(cg, h_c_call_v()) {
        mc_align16(c)
        s_cc := buf_len(c)
        if osm <= 1 {
            mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b3(c, 0x53, 0x56, 0x41); mc_b1(c, 0x54) // PUSH RBX, RSI, R12
            mc_b3(c, 0x48, 0x81, 0xEC); mc_u32(c, 0x88) // 16B aligned + 16 qwords stack
            mc_b3(c, 0x48, 0x89, 0xCB) // RBX = fn_ptr
            mc_b3(c, 0x49, 0x89, 0xD4) // R12 = argc
            mc_b3(c, 0x4C, 0x89, 0xC6) // RSI = argv
            mc_b2(c, 0x31, 0xC0)
            mc_b3(c, 0x48, 0x85, 0xDB)
            jz_cc := mc_jcc32(c, 0x84)
            mc_b4(c, 0x49, 0x83, 0xFC, 0x00)
            jle_cc0 := mc_jcc32(c, 0x8E)
            mc_b3(c, 0x48, 0x85, 0xF6)
            jz_cc2 := mc_jcc32(c, 0x84)
            // Stack args i = 4 .. min(argc, 16) - 1
            mc_b4(c, 0x49, 0x83, 0xFC, 0x04)
            jle_ccr := mc_jcc32(c, 0x8E)
            mc_b3(c, 0x4C, 0x89, 0xE1) // MOV RCX, R12
            mc_b4(c, 0x48, 0x83, 0xF9, 0x10)
            jle_c16 := mc_jcc8(c, 0x7E)
            mc_b1(c, 0xB9); mc_u32(c, 16)
            mc_patch_jcc8(c, jle_c16, buf_len(c))
            mc_b1(c, 0xB8); mc_u32(c, 4)
            lp_ccs := buf_len(c)
            mc_b4(c, 0x48, 0x8B, 0x14, 0xC6) // MOV RDX, [RSI + RAX*8]
            mc_b4(c, 0x48, 0x89, 0x14, 0xC4) // MOV [RSP + RAX*8], RDX
            mc_b3(c, 0x48, 0xFF, 0xC0)
            mc_b3(c, 0x48, 0x39, 0xC8)
            jl_ccs := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_ccs, lp_ccs)

            mc_patch_rel32(c, jle_ccr, buf_len(c))
            mc_b3(c, 0x48, 0x8B, 0x0E)                   // MOV RCX, [RSI]
            mc_b4(c, 0x49, 0x83, 0xFC, 0x01)
            jle_c1 := mc_jcc8(c, 0x7E)
            mc_b4(c, 0x48, 0x8B, 0x56, 0x08)             // MOV RDX, [RSI + 8]
            mc_patch_jcc8(c, jle_c1, buf_len(c))
            mc_b4(c, 0x49, 0x83, 0xFC, 0x02)
            jle_c2 := mc_jcc8(c, 0x7E)
            mc_b4(c, 0x4C, 0x8B, 0x46, 0x10)             // MOV R8, [RSI + 16]
            mc_patch_jcc8(c, jle_c2, buf_len(c))
            mc_b4(c, 0x49, 0x83, 0xFC, 0x03)
            jle_c3 := mc_jcc8(c, 0x7E)
            mc_b4(c, 0x4C, 0x8B, 0x4E, 0x18)             // MOV R9, [RSI + 24]
            mc_patch_jcc8(c, jle_c3, buf_len(c))

            mc_patch_rel32(c, jle_cc0, buf_len(c))
            mc_b2(c, 0xFF, 0xD3) // CALL RBX
            mc_patch_rel32(c, jz_cc, buf_len(c))
            mc_patch_rel32(c, jz_cc2, buf_len(c))
            mc_b3(c, 0x48, 0x81, 0xC4); mc_u32(c, 0x88)
            mc_b4(c, 0x41, 0x5C, 0x5E, 0x5B)
            mc_b2(c, 0x5D, 0xC3)
        } else {
            // SysV x86_64 ABI (`RDI, RSI, RDX, RCX, R8, R9` + stack args `6..15` for Linux/macOS)
            mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b3(c, 0x53, 0x41, 0x54); mc_b2(c, 0x41, 0x55) // PUSH RBX, R12, R13
            mc_b3(c, 0x48, 0x81, 0xEC); mc_u32(c, 0x68)     // 16B aligned + 12 qwords stack
            mc_b3(c, 0x48, 0x89, 0xCB) // RBX = fn_ptr (from RCX)
            mc_b3(c, 0x49, 0x89, 0xD4) // R12 = argc (from RDX)
            mc_b3(c, 0x4D, 0x89, 0xC5) // R13 = argv (from R8)
            mc_b2(c, 0x31, 0xC0)
            mc_b3(c, 0x48, 0x85, 0xDB); jz_su := mc_jcc32(c, 0x84)
            mc_b4(c, 0x49, 0x83, 0xFC, 0x00); jle_su0 := mc_jcc32(c, 0x8E)
            mc_b3(c, 0x4D, 0x85, 0xED); jz_su2 := mc_jcc32(c, 0x84)
            // Stack args i = 6 .. min(argc, 16) - 1 -> [RSP + (i-6)*8]
            mc_b4(c, 0x49, 0x83, 0xFC, 0x06); jle_sur := mc_jcc32(c, 0x8E)
            mc_b3(c, 0x4C, 0x89, 0xE1) // RCX = R12
            mc_b4(c, 0x48, 0x83, 0xF9, 0x10); jle_s16 := mc_jcc8(c, 0x7E)
            mc_b1(c, 0xB9); mc_u32(c, 16)
            mc_patch_jcc8(c, jle_s16, buf_len(c))
            mc_b1(c, 0xB8); mc_u32(c, 6)
            lp_sus := buf_len(c)
            mc_b4(c, 0x49, 0x8B, 0x54, 0xC5); mc_b1(c, 0) // MOV RDX, [R13 + RAX*8 + 0]
            mc_b4(c, 0x48, 0x89, 0x54, 0xC4); mc_b1(c, 0xD0) // MOV [RSP + RAX*8 - 48], RDX
            mc_b3(c, 0x48, 0xFF, 0xC0)
            mc_b3(c, 0x48, 0x39, 0xC8)
            jl_sus := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_sus, lp_sus)
            mc_patch_rel32(c, jle_sur, buf_len(c))
            mc_b4(c, 0x49, 0x8B, 0x7D, 0x00) // RDI = [R13 + 0]
            mc_b4(c, 0x49, 0x83, 0xFC, 0x01); jle_s1 := mc_jcc8(c, 0x7E)
            mc_b4(c, 0x49, 0x8B, 0x75, 0x08) // RSI = [R13 + 8]
            mc_patch_jcc8(c, jle_s1, buf_len(c))
            mc_b4(c, 0x49, 0x83, 0xFC, 0x02); jle_s2 := mc_jcc8(c, 0x7E)
            mc_b4(c, 0x49, 0x8B, 0x55, 0x10) // RDX = [R13 + 16]
            mc_patch_jcc8(c, jle_s2, buf_len(c))
            mc_b4(c, 0x49, 0x83, 0xFC, 0x03); jle_s3 := mc_jcc8(c, 0x7E)
            mc_b4(c, 0x49, 0x8B, 0x4D, 0x18) // RCX = [R13 + 24]
            mc_patch_jcc8(c, jle_s3, buf_len(c))
            mc_b4(c, 0x49, 0x83, 0xFC, 0x04); jle_s4 := mc_jcc8(c, 0x7E)
            mc_b4(c, 0x4D, 0x8B, 0x45, 0x20) // R8  = [R13 + 32]
            mc_patch_jcc8(c, jle_s4, buf_len(c))
            mc_b4(c, 0x49, 0x83, 0xFC, 0x05); jle_s5 := mc_jcc8(c, 0x7E)
            mc_b4(c, 0x4D, 0x8B, 0x4D, 0x28) // R9  = [R13 + 40]
            mc_patch_jcc8(c, jle_s5, buf_len(c))
            mc_patch_rel32(c, jle_su0, buf_len(c))
            mc_b2(c, 0x31, 0xC0) // AL = 0 (SysV varargs XMM count)
            mc_b2(c, 0xFF, 0xD3) // CALL RBX
            mc_patch_rel32(c, jz_su, buf_len(c))
            mc_patch_rel32(c, jz_su2, buf_len(c))
            mc_b3(c, 0x48, 0x81, 0xC4); mc_u32(c, 0x68)
            mc_b4(c, 0x41, 0x5D, 0x41, 0x5C); mc_b1(c, 0x5B)
            mc_b2(c, 0x5D, 0xC3)
        }
        cg_reg_helper(cg, h_c_call_v(), s_cc, buf_len(c))
    }

    // 2. `h_ai_pool_worker(RCX = wid)`: Win64 persistent worker loop
    if cg_is_helper_used(cg, h_ai_pool_worker()) {
        mc_align16(c)
        s_pw := buf_len(c)
        if osm <= 1 {
            mc_ai_enter(c, 0x28)
            mc_b3(c, 0x49, 0x89, 0xCD) // R13 = wid
            cg_mov_rax_data(cg, data_off_ai_pool())
            mc_b3(c, 0x49, 0x89, 0xC4) // R12 = pool
            w_top := buf_len(c)
            mc_b4(c, 0x4B, 0x8B, 0x8C, 0xEC); mc_u32(c, 128) // MOV RCX, [R12 + R13*8 + 128]
            mc_b1(c, 0xBA); mc_u32(c, 0xFFFFFFFF)             // INFINITE
            cg_call_iat(cg, iat_wait_single())
            mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 16)
            mc_b3(c, 0x48, 0x85, 0xC0)
            jnz_pw := mc_jcc32(c, 0x85)
            mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 8)  // fn_ptr
            mc_b3(c, 0x4C, 0x89, 0xE9)                     // wid
            mc_b3(c, 0x49, 0x8B, 0x14); mc_b1(c, 0x24)     // T = [R12]
            mc_b3(c, 0x4D, 0x89, 0xE0)                     // R8 = pool
            mc_b2(c, 0xFF, 0xD0)                           // CALL RAX
            mc_b4(c, 0xF0, 0x49, 0xFF, 0x44); mc_b2(c, 0x24, 24) // LOCK INC [R12 + 24]
            jmp_wt := mc_jmp32(c); mc_patch_rel32(c, jmp_wt, w_top)
            mc_patch_rel32(c, jnz_pw, buf_len(c))
            mc_b2(c, 0x31, 0xC0)
            mc_ai_leave(c, 0x28)
        } else {
            mc_b2(c, 0x31, 0xC0); mc_b1(c, 0xC3)
        }
        cg_reg_helper(cg, h_ai_pool_worker(), s_pw, buf_len(c))
    }

    // 3. `h_ai_pool_dispatch(RCX = worker_fn, RDX = args_ptr)`
    if cg_is_helper_used(cg, h_ai_pool_dispatch()) {
        mc_align16(c)
        s_pd := buf_len(c)
        mc_ai_enter(c, 0x48)
        mc_b3(c, 0x49, 0x89, 0xCE) // R14 = worker_fn
        mc_b3(c, 0x49, 0x89, 0xD7) // R15 = args_ptr
        cg_mov_rax_data(cg, data_off_ai_pool())
        mc_b3(c, 0x49, 0x89, 0xC4) // R12 = pool
        mc_b3(c, 0x4D, 0x85, 0xE4)
        jnz_init := mc_jcc32(c, 0x85)

        // Lazy init 512B persistent pool
        mc_b1(c, 0xB9); mc_u32(c, 512)
        cg_call_fn(cg, h_alloc_mem())
        mc_b3(c, 0x48, 0x85, 0xC0)
        cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b3(c, 0x49, 0x89, 0xC4) // R12 = pool
        cg_store_rax_data(cg, data_off_ai_pool())
        if osm <= 1 {
            cg_mov_rax_data(cg, data_off_cpu_threads())
            mc_b4(c, 0x48, 0x83, 0xF8, 0x01)
            jge_t1 := mc_jcc8(c, 0x7D)
            mc_b1(c, 0xB8); mc_u32(c, 1)
            mc_patch_jcc8(c, jge_t1, buf_len(c))
            mc_b4(c, 0x48, 0x83, 0xF8, 0x10)
            jle_t16 := mc_jcc8(c, 0x7E)
            mc_b1(c, 0xB8); mc_u32(c, 16)
            mc_patch_jcc8(c, jle_t16, buf_len(c))
        } else {
            mc_b1(c, 0xB8); mc_u32(c, 1)
        }
        mc_b3(c, 0x48, 0x89, 0xC3) // RBX = T
        mc_b3(c, 0x49, 0x89, 0x1C); mc_b1(c, 0x24) // [R12] = T
        mc_b4(c, 0x49, 0xC7, 0x44, 0x24); mc_b1(c, 16); mc_u32(c, 0)
        if osm <= 1 {
            mc_b4(c, 0x48, 0x83, 0xFB, 0x01)
            jle_nothr := mc_jcc32(c, 0x8E)
            mc_b2(c, 0x41, 0xBD); mc_u32(c, 1) // R13 = 1
            lp_mk := buf_len(c)
            mc_b2(c, 0x31, 0xC9); mc_b2(c, 0x31, 0xD2)
            mc_b3(c, 0x45, 0x31, 0xC0); mc_b3(c, 0x45, 0x31, 0xC9)
            cg_call_iat(cg, iat_create_event_a())
            mc_b3(c, 0x48, 0x85, 0xC0)
            jz_mk_fail1 := mc_jcc32(c, 0x84)
            mc_b4(c, 0x4B, 0x89, 0x84, 0xEC); mc_u32(c, 128) // [R12 + R13*8 + 128] = event
            mc_b2(c, 0x31, 0xC9); mc_b2(c, 0x31, 0xD2)
            cg_lea_rax_fn(cg, h_ai_pool_worker())
            mc_b3(c, 0x49, 0x89, 0xC0) // R8 = worker
            mc_b3(c, 0x4D, 0x89, 0xE9) // R9 = wid
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 0x20); mc_u32(c, 0)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 0x28); mc_u32(c, 0)
            cg_call_iat(cg, iat_create_thread())
            mc_b3(c, 0x48, 0x85, 0xC0)
            jz_mk_fail2 := mc_jcc32(c, 0x84)
            mc_b3(c, 0x49, 0xFF, 0xC5) // INC R13
            mc_b3(c, 0x49, 0x39, 0xDD) // CMP R13, RBX
            jl_mk := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_mk, lp_mk)
            jmp_mk_ok := mc_jcc8(c, 0xEB)
            mc_patch_rel32(c, jz_mk_fail1, buf_len(c))
            mc_patch_rel32(c, jz_mk_fail2, buf_len(c))
            mc_b3(c, 0x4C, 0x89, 0xEB) // MOV RBX, R13 (clamp T to actually spawned workers)
            mc_b3(c, 0x49, 0x89, 0x1C); mc_b1(c, 0x24) // [R12] = RBX
            mc_patch_jcc8(c, jmp_mk_ok, buf_len(c))
            mc_patch_rel32(c, jle_nothr, buf_len(c))
        }
        mc_b3(c, 0x4C, 0x89, 0xE0)
        cg_store_rax_data(cg, data_off_ai_pool())

        mc_patch_rel32(c, jnz_init, buf_len(c))
        // Write job args into [R12 + 32..72]
        mc_b4(c, 0x4D, 0x89, 0x74, 0x24); mc_b1(c, 8)  // [R12 + 8] = fn_ptr
        mc_b4(c, 0x49, 0xC7, 0x44, 0x24); mc_b1(c, 24); mc_u32(c, 0)
        mut ai := 0
        while ai < 6 {
            mc_b3(c, 0x49, 0x8B, 0x47); mc_b1(c, ai * 8)
            mc_b4(c, 0x49, 0x89, 0x44, 0x24); mc_b1(c, 32 + ai * 8)
            ai += 1
        }
        mc_b3(c, 0x49, 0x8B, 0x1C); mc_b1(c, 0x24) // RBX = T
        mut jle_nowk := 0
        mut jle_nowk2 := 0
        if osm <= 1 {
            mc_b4(c, 0x48, 0x83, 0xFB, 0x01)
            jle_nowk = mc_jcc32(c, 0x8E)
            mc_b2(c, 0x41, 0xBD); mc_u32(c, 1)
            lp_wk := buf_len(c)
            mc_b4(c, 0x4B, 0x8B, 0x8C, 0xEC); mc_u32(c, 128)
            cg_call_iat(cg, iat_set_event())
            mc_b3(c, 0x49, 0xFF, 0xC5)
            mc_b3(c, 0x49, 0x39, 0xDD)
            jl_wk := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_wk, lp_wk)
            mc_patch_rel32(c, jle_nowk, buf_len(c))
        }
        // Master executes shard wid=0
        mc_b2(c, 0x31, 0xC9)       // wid = 0
        mc_b3(c, 0x48, 0x89, 0xDA) // RDX = T
        mc_b3(c, 0x4D, 0x89, 0xE0) // R8 = pool
        mc_b3(c, 0x41, 0xFF, 0xD6) // CALL R14
        if osm <= 1 {
            mc_b4(c, 0x48, 0x83, 0xFB, 0x01)
            jle_nowk2 = mc_jcc32(c, 0x8E)
            mc_b4(c, 0xF0, 0x49, 0xFF, 0x44); mc_b2(c, 0x24, 24)
            lp_wait := buf_len(c)
            mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 24)
            mc_b3(c, 0x48, 0x39, 0xD8)
            jge_done := mc_jcc8(c, 0x7D)
            mc_b2(c, 0xF3, 0x90) // PAUSE
            jmp_w := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_w, lp_wait)
            mc_patch_jcc8(c, jge_done, buf_len(c))
            mc_patch_rel32(c, jle_nowk2, buf_len(c))
        }
        mc_ai_leave(c, 0x48)
        cg_reg_helper(cg, h_ai_pool_dispatch(), s_pd, buf_len(c))
    }
}

fn emit_ai_gemv_gemm_helpers(cg: CodegenCtx) {
    c := cg.code

    // 4. `h_ai_gemv_f32`: args = `[w_ptr, x_ptr, out_ptr, rows, cols]`
    if cg_is_helper_used(cg, h_ai_gemv_f32()) {
        mc_align16(c)
        s_wk := buf_len(c)
        mc_ai_enter(c, 0x28)
        mc_b3(c, 0x4D, 0x89, 0xC4) // R12 = pool
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 56) // total_rows
        mc_ai_row_range(c)         // R14 = r0, R15 = r1
        mc_b3(c, 0x4D, 0x39, 0xFE) // CMP R14, R15
        jge_gv_e := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4D, 0x8B, 0x44, 0x24); mc_b1(c, 64) // R8 = cols
        mc_b4(c, 0x49, 0x8B, 0x5C, 0x24); mc_b1(c, 40) // RBX = x_ptr
        mc_b4(c, 0x49, 0x8B, 0x6C, 0x24); mc_b1(c, 48) // RBP = out_ptr
        mc_b4(c, 0x49, 0x8B, 0x74, 0x24); mc_b1(c, 32) // RSI = w_ptr
        // R9 = row_bytes = cols * 4
        mc_b3(c, 0x4D, 0x89, 0xC1)                     // MOV R9, R8
        mc_b4(c, 0x49, 0xC1, 0xE1, 0x02)               // SHL R9, 2
        mc_b3(c, 0x4D, 0x89, 0xF5) // R13 = r0
        mc_b3(c, 0x4C, 0x89, 0xF0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC1) // RAX = r0 * row_bytes
        mc_b3(c, 0x48, 0x01, 0xC6) // RSI = w_row

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_gv_sc := mc_jcc32(c, 0x84)

        // AVX2+FMA3 2-row pair loop (`r13 + 1 < r15`)
        lp_gv2 := buf_len(c)
        mc_b4(c, 0x49, 0x8D, 0x45, 0x01) // LEA RAX, [R13 + 1]
        mc_b3(c, 0x4C, 0x39, 0xF8)       // CMP RAX, R15
        jge_gv1 := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x48, 0x89, 0xF1)       // RCX = row0 ptr
        mc_b4(c, 0x4A, 0x8D, 0x3C, 0x0E) // RDI = row0 + row_bytes (row1 ptr)
        mc_b3(c, 0x48, 0x89, 0xDA)       // RDX = x_ptr
        mc_b4(c, 0x4A, 0x8D, 0x04, 0x0A) // RAX = RDX + R9 (x_end)
        mc_vex2(c, 0, 1, 0, 0x57, 0xC0)  // VXORPS YMM0, YMM0, YMM0
        mc_vex2(c, 1, 1, 0, 0x57, 0xC9)  // VXORPS YMM1, YMM1, YMM1
        mc_vex2(c, 2, 1, 0, 0x57, 0xD2)  // VXORPS YMM2, YMM2, YMM2
        mc_vex2(c, 3, 1, 0, 0x57, 0xDB)  // VXORPS YMM3, YMM3, YMM3
        mc_b4(c, 0x48, 0x83, 0xE8, 0x40) // x_end16 = x_end - 64
        mc_b3(c, 0x48, 0x39, 0xC2)
        ja_g2_8 := mc_jcc32(c, 0x87)
        lp_g2_16 := buf_len(c)
        mc_vex2(c, 0, 1, 0, 0x10, 0x22)                          // VMOVUPS YMM4, [RDX]
        mc_vex2(c, 0, 1, 0, 0x10, 0x6A); mc_b1(c, 0x20)          // VMOVUPS YMM5, [RDX+32]
        mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0x01) // VFMADD231PS YMM0, YMM4, [RCX]
        mc_vex3(c, 0, 0, 0, 2, 0, 5, 1, 1, 0xB8); mc_b2(c, 0x49, 0x20) // VFMADD231PS YMM1, YMM5, [RCX+32]
        mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0x17) // VFMADD231PS YMM2, YMM4, [RDI]
        mc_vex3(c, 0, 0, 0, 2, 0, 5, 1, 1, 0xB8); mc_b2(c, 0x5F, 0x20) // VFMADD231PS YMM3, YMM5, [RDI+32]
        mc_b4(c, 0x48, 0x83, 0xC1, 0x40)
        mc_b4(c, 0x48, 0x83, 0xC7, 0x40)
        mc_b4(c, 0x48, 0x83, 0xC2, 0x40)
        mc_b3(c, 0x48, 0x39, 0xC2)
        jbe_g2_16 := mc_jcc8(c, 0x76); mc_patch_jcc8(c, jbe_g2_16, lp_g2_16)
        mc_patch_rel32(c, ja_g2_8, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xC0, 0x40) // RAX = x_end
        mc_vex2(c, 0, 1, 0, 0x58, 0xC1)  // VADDPS YMM0, YMM0, YMM1
        mc_vex2(c, 2, 1, 0, 0x58, 0xD3)  // VADDPS YMM2, YMM2, YMM3
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC1, 0x01)
        mc_vex2(c, 0, 0, 0, 0x58, 0xC1)
        mc_vex2(c, 0, 0, 0, 0x12, 0xC8)
        mc_vex2(c, 0, 0, 0, 0x58, 0xC1)
        mc_vex2(c, 0, 0, 0, 0xC6, 0xC8); mc_b1(c, 0x01)
        mc_vex2(c, 0, 0, 2, 0x58, 0xC1) // XMM0 = sum0 (f32)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xD1, 0x01) // VEXTRACTF128 XMM1, YMM2, 1
        mc_vex2(c, 2, 0, 0, 0x58, 0xD1) // VADDPS XMM2, XMM2, XMM1
        mc_vex2(c, 2, 0, 0, 0x12, 0xCA) // VMOVHLPS XMM1, XMM2, XMM2
        mc_vex2(c, 2, 0, 0, 0x58, 0xD1)
        mc_vex2(c, 2, 0, 0, 0xC6, 0xCA); mc_b1(c, 0x01)
        mc_vex2(c, 2, 0, 2, 0x58, 0xD1) // XMM2 = sum1 (f32)
        lp_g2_sc := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC2)
        jae_g2_st := mc_jcc8(c, 0x73)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x0A) // MOVSS XMM1, [RDX]
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x19) // MOVSS XMM3, [RCX]
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xD9) // MULSS XMM3, XMM1
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xC3) // ADDSS XMM0, XMM3
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x1F) // MOVSS XMM3, [RDI]
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xD9) // MULSS XMM3, XMM1
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xD3) // ADDSS XMM2, XMM3
        mc_b4(c, 0x48, 0x83, 0xC1, 0x04)
        mc_b4(c, 0x48, 0x83, 0xC7, 0x04)
        mc_b4(c, 0x48, 0x83, 0xC2, 0x04)
        jmp_g2sc := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_g2sc, lp_g2_sc)
        mc_patch_jcc8(c, jae_g2_st, buf_len(c))
        mc_b4(c, 0xF3, 0x42, 0x0F, 0x11); mc_b3(c, 0x44, 0xAD, 0x00) // MOVSS [RBP + R13*4], XMM0
        mc_b4(c, 0xF3, 0x42, 0x0F, 0x11); mc_b3(c, 0x54, 0xAD, 0x04) // MOVSS [RBP + R13*4 + 4], XMM2
        mc_b4(c, 0x49, 0x83, 0xC5, 0x02) // R13 += 2
        mc_b4(c, 0x4A, 0x8D, 0x34, 0x4E) // LEA RSI, [RSI + R9*2]
        jmp_gv2 := mc_jmp32(c); mc_patch_rel32(c, jmp_gv2, lp_gv2)

        // Tail 0 or 1 row AVX2 (or scalar SSE2 fallback)
        mc_patch_rel32(c, jge_gv1, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77) // VZEROUPPER (guarded: AVX2 2-row path only)
        mc_patch_rel32(c, jz_gv_sc, buf_len(c))
        lp_gv1 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xFD) // CMP R13, R15
        jge_gv1d := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x48, 0x89, 0xF1) // RCX = w_row
        mc_b3(c, 0x48, 0x89, 0xDA) // RDX = x_ptr
        mc_b4(c, 0x4A, 0x8D, 0x04, 0x0A) // RAX = x_end
        mc_b3(c, 0x0F, 0x57, 0xC0)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_g1_sc := mc_jcc8(c, 0x74)
        mc_vex2(c, 0, 1, 0, 0x57, 0xC0)
        mc_b4(c, 0x4A, 0x8D, 0x04, 0x0B) // LEA RAX, [RBX + R9] (RBX=x_ptr!)
        mc_b4(c, 0x48, 0x83, 0xE8, 0x20)
        lp_g1_8 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC2)
        ja_g1_red := mc_jcc8(c, 0x77)
        mc_vex2(c, 0, 1, 0, 0x10, 0x22)
        mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0x01)
        mc_b4(c, 0x48, 0x83, 0xC1, 0x20)
        mc_b4(c, 0x48, 0x83, 0xC2, 0x20)
        jmp_g1_8 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_g1_8, lp_g1_8)
        mc_patch_jcc8(c, ja_g1_red, buf_len(c))
        mc_avx_hsum_ymm0(c)
        mc_b3(c, 0xC5, 0xF8, 0x77) // VZEROUPPER (guarded: AVX2 1-row path only)
        mc_b4(c, 0x48, 0x83, 0xC0, 0x20)
        jmp_g1_sc := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jz_g1_sc, buf_len(c))
        mc_b4(c, 0x4A, 0x8D, 0x04, 0x0B) // LEA RAX, [RBX + R9]
        mc_patch_jcc8(c, jmp_g1_sc, buf_len(c))
        lp_g1_sc := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC2)
        jae_g1_st := mc_jcc8(c, 0x73)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x0A)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0x09)
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1)
        mc_b4(c, 0x48, 0x83, 0xC1, 0x04)
        mc_b4(c, 0x48, 0x83, 0xC2, 0x04)
        jmp_g1s := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_g1s, lp_g1_sc)
        mc_patch_jcc8(c, jae_g1_st, buf_len(c))
        mc_b4(c, 0xF3, 0x42, 0x0F, 0x11); mc_b3(c, 0x44, 0xAD, 0x00)
        mc_b3(c, 0x49, 0xFF, 0xC5)
        mc_b3(c, 0x4C, 0x01, 0xCE)
        jmp_gv1 := mc_jmp32(c); mc_patch_rel32(c, jmp_gv1, lp_gv1)
        mc_patch_rel32(c, jge_gv1d, buf_len(c))
        mc_patch_rel32(c, jge_gv_e, buf_len(c))
        mc_ai_leave(c, 0x28)
        mc_ai_emit_batch_pub(cg, h_ai_gemv_f32(), s_wk, 3, 4, 16384)
    }

    // 5. `h_ai_gemm_f32`: args = `[A, B, C, m, k, n]`
    if cg_is_helper_used(cg, h_ai_gemm_f32()) {
        mc_align16(c)
        s_wk := buf_len(c)
        // Stack locals: `[RSP+0]=k`, `[RSP+8]=n`, `[RSP+16]=B`, `[RSP+24]=b_stride(n*4)`,
        // `[RSP+32]=r0`, `[RSP+40]=a_stride(k*4)`, `[RSP+48..175]=XMM6..XMM13`
        mc_ai_enter(c, 0xB8)
        mc_b3(c, 0x4D, 0x89, 0xC4) // R12 = pool
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 56) // m
        mc_ai_row_range(c)         // R14 = r0, R15 = r1
        mc_b3(c, 0x4D, 0x39, 0xFE)
        jge_gm_e := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4C, 0x89, 0x74, 0x24); mc_b1(c, 32) // [RSP+32] = r0
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 64) // k
        mc_b4(c, 0x48, 0x89, 0x04, 0x24)               // [RSP] = k
        mc_b3(c, 0x48, 0xC1, 0xE0); mc_b1(c, 2)        // RAX = k*4
        mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 40) // [RSP+40] = a_stride
        mc_b4(c, 0x49, 0x8B, 0x4C, 0x24); mc_b1(c, 72) // n
        mc_b4(c, 0x48, 0x89, 0x4C, 0x24); mc_b1(c, 8)  // [RSP+8] = n
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 40) // B
        mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 16) // [RSP+16] = B
        mc_b3(c, 0x48, 0xC1, 0xE1); mc_b1(c, 2)        // RCX = n*4
        mc_b4(c, 0x48, 0x89, 0x4C, 0x24); mc_b1(c, 24) // [RSP+24] = b_stride

        mc_b4(c, 0x4D, 0x8B, 0x4C, 0x24); mc_b1(c, 32) // R9  = A
        mc_b4(c, 0x4D, 0x8B, 0x5C, 0x24); mc_b1(c, 48) // R11 = C
        // Check AVX2 tier
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_gm_sc := mc_jcc32(c, 0x84)

        // Preserve Win64 non-volatile XMM6..XMM13 for 4x16 FMA micro-kernel
        mut gxi := 0
        while gxi < 8 {
            xreg := 6 + gxi
            mut xr_bit := 1
            if (xreg & 8) != 0 { xr_bit = 0 }
            off_x := 48 + gxi * 16
            mc_b4(c, 0xC4, (xr_bit << 7) | 0x61, 0x7A, 0x7F)
            if off_x < 128 {
                mc_b3(c, 0x44 | ((xreg & 7) << 3), 0x24, off_x)
            } else {
                mc_b2(c, 0x84 | ((xreg & 7) << 3), 0x24); mc_u32(c, off_x)
            }
            gxi += 1
        }

        // Outer j loop by 16 (`R10 = j = 0; j + 16 <= n`)
        mc_b3(c, 0x45, 0x31, 0xD2) // XOR R10D, R10D
        lp_gm_j16 := buf_len(c)
        mc_b4(c, 0x49, 0x8D, 0x42, 0x10) // LEA RAX, [R10 + 16]
        mc_b4(c, 0x48, 0x3B, 0x44, 0x24); mc_b1(c, 8)
        jg_gm_j8 := mc_jcc32(c, 0x8F)

        // 4x16 row block `i = r0 .. r1-4` (`YMM0..YMM7` saturate dual FMA ports)
        mc_b4(c, 0x4C, 0x8B, 0x6C, 0x24); mc_b1(c, 32) // R13 = r0
        lp_gm_i4 := buf_len(c)
        mc_b4(c, 0x49, 0x8D, 0x45, 0x03) // LEA RAX, [R13 + 3]
        mc_b3(c, 0x4C, 0x39, 0xF8)
        jge_gm_i2 := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x48, 0x8B, 0x1C, 0x24)               // RBX = k
        mc_b4(c, 0x4C, 0x8B, 0x64, 0x24); mc_b1(c, 40) // R12 = a_stride (k*4)
        mc_b3(c, 0x4C, 0x89, 0xE8); mc_b4(c, 0x48, 0x0F, 0xAF, 0xC3) // i*k
        mc_b4(c, 0x49, 0x8D, 0x3C, 0x81)               // RDI = A0
        mc_b4(c, 0x4A, 0x8D, 0x34, 0x27)               // RSI = RDI + R12 (Wait: R12 uses REX.X -> 4A!)
        mc_b3(c, 0x49, 0x89, 0xF0); mc_b3(c, 0x4D, 0x01, 0xE0) // R8  = RSI + R12 (A2)
        mc_b3(c, 0x4D, 0x89, 0xC6); mc_b3(c, 0x4D, 0x01, 0xE6) // R14 = R8  + R12 (A3)
        mc_b4(c, 0x48, 0x8B, 0x54, 0x24); mc_b1(c, 16) // RDX = B
        mc_b4(c, 0x4A, 0x8D, 0x14, 0x92)               // RDX = B + j*4
        mc_b4(c, 0x48, 0x8B, 0x4C, 0x24); mc_b1(c, 24) // RCX = b_stride
        mut yz := 0
        while yz < 8 {
            mc_vex2(c, yz, 1, 0, 0x57, 0xC0 | (yz << 3) | yz)
            yz += 1
        }
        mc_b3(c, 0x48, 0x85, 0xDB)
        jle_p4_e := mc_jcc8(c, 0x7E)
        lp_p4 := buf_len(c)
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b1(c, 0x07) // VBROADCASTSS YMM8,  [RDI]
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b1(c, 0x0E) // VBROADCASTSS YMM9,  [RSI]
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x18); mc_b1(c, 0x10) // VBROADCASTSS YMM10, [R8]
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x18); mc_b1(c, 0x1E) // VBROADCASTSS YMM11, [R14]
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 0, 0x10); mc_b1(c, 0x22) // VMOVUPS YMM12, [RDX]
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 0, 0x10); mc_b2(c, 0x6A, 32) // VMOVUPS YMM13, [RDX+32]
        mc_vex3(c, 0, 0, 1, 2, 0, 8,  1, 1, 0xB8); mc_b1(c, 0xC4) // VFMADD231PS YMM0, YMM8,  YMM12
        mc_vex3(c, 0, 0, 1, 2, 0, 8,  1, 1, 0xB8); mc_b1(c, 0xCD) // VFMADD231PS YMM1, YMM8,  YMM13
        mc_vex3(c, 0, 0, 1, 2, 0, 9,  1, 1, 0xB8); mc_b1(c, 0xD4) // VFMADD231PS YMM2, YMM9,  YMM12
        mc_vex3(c, 0, 0, 1, 2, 0, 9,  1, 1, 0xB8); mc_b1(c, 0xDD) // VFMADD231PS YMM3, YMM9,  YMM13
        mc_vex3(c, 0, 0, 1, 2, 0, 10, 1, 1, 0xB8); mc_b1(c, 0xE4) // VFMADD231PS YMM4, YMM10, YMM12
        mc_vex3(c, 0, 0, 1, 2, 0, 10, 1, 1, 0xB8); mc_b1(c, 0xED) // VFMADD231PS YMM5, YMM10, YMM13
        mc_vex3(c, 0, 0, 1, 2, 0, 11, 1, 1, 0xB8); mc_b1(c, 0xF4) // VFMADD231PS YMM6, YMM11, YMM12
        mc_vex3(c, 0, 0, 1, 2, 0, 11, 1, 1, 0xB8); mc_b1(c, 0xFD) // VFMADD231PS YMM7, YMM11, YMM13
        mc_b4(c, 0x48, 0x83, 0xC7, 0x04) // ADD RDI, 4
        mc_b4(c, 0x48, 0x83, 0xC6, 0x04) // ADD RSI, 4
        mc_b4(c, 0x49, 0x83, 0xC0, 0x04) // ADD R8, 4
        mc_b4(c, 0x49, 0x83, 0xC6, 0x04) // ADD R14, 4
        mc_b3(c, 0x48, 0x01, 0xCA)       // ADD RDX, RCX
        mc_b3(c, 0x48, 0xFF, 0xCB)       // DEC RBX
        jnz_p4 := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_p4, lp_p4)
        mc_patch_jcc8(c, jle_p4_e, buf_len(c))
        // Store 4 rows x 16 cols
        mc_b4(c, 0x48, 0x8B, 0x44, 0x24); mc_b1(c, 8) // RAX = n
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC5)               // RAX = i*n
        mc_b3(c, 0x4C, 0x01, 0xD0)                     // RAX = i*n + j
        mc_b4(c, 0x49, 0x8D, 0x3C, 0x83)               // RDI = C + (i*n+j)*4
        mc_vex2(c, 0, 1, 0, 0x11, 0x07); mc_vex2(c, 0, 1, 0, 0x11, 0x4F); mc_b1(c, 0x20)
        mc_b3(c, 0x48, 0x01, 0xCF)
        mc_vex2(c, 0, 1, 0, 0x11, 0x17); mc_vex2(c, 0, 1, 0, 0x11, 0x5F); mc_b1(c, 0x20)
        mc_b3(c, 0x48, 0x01, 0xCF)
        mc_vex2(c, 0, 1, 0, 0x11, 0x27); mc_vex2(c, 0, 1, 0, 0x11, 0x6F); mc_b1(c, 0x20)
        mc_b3(c, 0x48, 0x01, 0xCF)
        mc_vex2(c, 0, 1, 0, 0x11, 0x37); mc_vex2(c, 0, 1, 0, 0x11, 0x7F); mc_b1(c, 0x20)
        mc_b4(c, 0x49, 0x83, 0xC5, 0x04) // i += 4
        jmp_i4 := mc_jmp32(c); mc_patch_rel32(c, jmp_i4, lp_gm_i4)

        // Pair i = .. r1-2 (`R13 = i`)
        mc_patch_rel32(c, jge_gm_i2, buf_len(c))
        lp_gm_i2 := buf_len(c)
        mc_b4(c, 0x49, 0x8D, 0x45, 0x01)
        mc_b3(c, 0x4C, 0x39, 0xF8)
        jge_gm_i1 := mc_jcc32(c, 0x8D)
        // Compute A0 = A + (i*k)*4 -> RDI, A1 = A0 + k*4 -> RSI
        mc_b4(c, 0x48, 0x8B, 0x1C, 0x24) // RBX = k
        mc_b3(c, 0x4C, 0x89, 0xE8); mc_b4(c, 0x48, 0x0F, 0xAF, 0xC3) // i*k
        mc_b4(c, 0x49, 0x8D, 0x3C, 0x81) // RDI = A + i*k*4
        mc_b4(c, 0x48, 0x8D, 0x34, 0x9F) // RSI = RDI + k*4
        mc_b4(c, 0x48, 0x8B, 0x54, 0x24); mc_b1(c, 16) // RDX = B
        mc_b4(c, 0x4A, 0x8D, 0x14, 0x92) // RDX = B + j*4
        mc_b4(c, 0x48, 0x8B, 0x4C, 0x24); mc_b1(c, 24) // RCX = b_stride
        mc_b3(c, 0x48, 0x85, 0xDB)       // k == 0 check
        mc_vex2(c, 0, 1, 0, 0x57, 0xC0)
        mc_vex2(c, 1, 1, 0, 0x57, 0xC9)
        mc_vex2(c, 2, 1, 0, 0x57, 0xD2)
        mc_vex2(c, 3, 1, 0, 0x57, 0xDB)
        jle_p2_e := mc_jcc8(c, 0x7E)
        lp_p2 := buf_len(c)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b1(c, 0x27) // VBROADCASTSS YMM4, [RDI]
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b1(c, 0x2E) // VBROADCASTSS YMM5, [RSI]
        mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0x02) // VFMADD231PS YMM0, YMM4, [RDX]
        mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b2(c, 0x4A, 0x20) // VFMADD231PS YMM1, YMM4, [RDX+32]
        mc_vex3(c, 0, 0, 0, 2, 0, 5, 1, 1, 0xB8); mc_b1(c, 0x12) // VFMADD231PS YMM2, YMM5, [RDX]
        mc_vex3(c, 0, 0, 0, 2, 0, 5, 1, 1, 0xB8); mc_b2(c, 0x5A, 0x20) // VFMADD231PS YMM3, YMM5, [RDX+32]
        mc_b4(c, 0x48, 0x83, 0xC7, 0x04)
        mc_b4(c, 0x48, 0x83, 0xC6, 0x04)
        mc_b3(c, 0x48, 0x01, 0xCA) // RDX += b_stride
        mc_b3(c, 0x48, 0xFF, 0xCB) // DEC RBX
        jnz_p2 := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_p2, lp_p2)
        mc_patch_jcc8(c, jle_p2_e, buf_len(c))
        // Store C[i, j..j+15] & C[i+1, j..j+15]
        mc_b4(c, 0x48, 0x8B, 0x44, 0x24); mc_b1(c, 8) // RAX = n
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC5)               // RAX = i*n
        mc_b3(c, 0x4C, 0x01, 0xD0)                     // RAX = i*n + j
        mc_b4(c, 0x49, 0x8D, 0x3C, 0x83)               // RDI = C + (i*n+j)*4
        mc_b4(c, 0x48, 0x8D, 0x34, 0x0F)               // RSI = RDI + b_stride (RCX)
        mc_vex2(c, 0, 1, 0, 0x11, 0x07)
        mc_vex2(c, 0, 1, 0, 0x11, 0x4F); mc_b1(c, 0x20)
        mc_vex2(c, 0, 1, 0, 0x11, 0x16)
        mc_vex2(c, 0, 1, 0, 0x11, 0x5E); mc_b1(c, 0x20)
        mc_b4(c, 0x49, 0x83, 0xC5, 0x02)
        jmp_i2 := mc_jmp32(c); mc_patch_rel32(c, jmp_i2, lp_gm_i2)

        // Single remaining row if r1 - r0 is odd
        mc_patch_rel32(c, jge_gm_i1, buf_len(c))
        mc_b3(c, 0x4D, 0x39, 0xFD)
        jge_gm_nextj := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x48, 0x8B, 0x1C, 0x24)
        mc_b3(c, 0x4C, 0x89, 0xE8); mc_b4(c, 0x48, 0x0F, 0xAF, 0xC3)
        mc_b4(c, 0x49, 0x8D, 0x3C, 0x81)
        mc_b4(c, 0x48, 0x8B, 0x54, 0x24); mc_b1(c, 16)
        mc_b4(c, 0x4A, 0x8D, 0x14, 0x92)
        mc_b4(c, 0x48, 0x8B, 0x4C, 0x24); mc_b1(c, 24)
        mc_vex2(c, 0, 1, 0, 0x57, 0xC0)
        mc_vex2(c, 1, 1, 0, 0x57, 0xC9)
        mc_b3(c, 0x48, 0x85, 0xDB)
        jle_p1_e := mc_jcc8(c, 0x7E)
        lp_p1 := buf_len(c)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b1(c, 0x27)
        mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0x02)
        mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b2(c, 0x4A, 0x20)
        mc_b4(c, 0x48, 0x83, 0xC7, 0x04)
        mc_b3(c, 0x48, 0x01, 0xCA)
        mc_b3(c, 0x48, 0xFF, 0xCB)
        jnz_p1 := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_p1, lp_p1)
        mc_patch_jcc8(c, jle_p1_e, buf_len(c))
        mc_b4(c, 0x48, 0x8B, 0x44, 0x24); mc_b1(c, 8)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC5)
        mc_b3(c, 0x4C, 0x01, 0xD0)
        mc_b4(c, 0x49, 0x8D, 0x3C, 0x83)
        mc_vex2(c, 0, 1, 0, 0x11, 0x07)
        mc_vex2(c, 0, 1, 0, 0x11, 0x4F); mc_b1(c, 0x20)

        mc_patch_rel32(c, jge_gm_nextj, buf_len(c))
        mc_b4(c, 0x49, 0x83, 0xC2, 0x10) // j += 16
        jmp_j16 := mc_jmp32(c); mc_patch_rel32(c, jmp_j16, lp_gm_j16)

        // Tail columns `j .. n-1` (scalar SSE2 / fallback if simd_tier==0 starting at j=0)
        mc_patch_rel32(c, jg_gm_j8, buf_len(c))
        mut grx := 0
        while grx < 8 {
            xreg := 6 + grx
            mut xr_bit := 1
            if (xreg & 8) != 0 { xr_bit = 0 }
            off_x := 48 + grx * 16
            mc_b4(c, 0xC4, (xr_bit << 7) | 0x61, 0x7A, 0x6F)
            if off_x < 128 {
                mc_b3(c, 0x44 | ((xreg & 7) << 3), 0x24, off_x)
            } else {
                mc_b2(c, 0x84 | ((xreg & 7) << 3), 0x24); mc_u32(c, off_x)
            }
            grx += 1
        }
        mc_b4(c, 0x4C, 0x8B, 0x74, 0x24); mc_b1(c, 32) // Restore R14 = r0 for tail loop
        mc_b3(c, 0xC5, 0xF8, 0x77) // VZEROUPPER (guarded: AVX2 path only)
        jmp_jtail := mc_jmp32(c)
        mc_patch_rel32(c, jz_gm_sc, buf_len(c))
        mc_b3(c, 0x45, 0x31, 0xD2) // j = 0 for scalar fallback
        mc_patch_rel32(c, jmp_jtail, buf_len(c))
        lp_gm_jt := buf_len(c)
        mc_b4(c, 0x4C, 0x3B, 0x54, 0x24); mc_b1(c, 8)
        jge_gm_all := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4D, 0x89, 0xF5) // i = r0
        lp_gm_it := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xFD)
        jge_gm_it := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x48, 0x8B, 0x1C, 0x24)
        mc_b3(c, 0x4C, 0x89, 0xE8); mc_b4(c, 0x48, 0x0F, 0xAF, 0xC3)
        mc_b4(c, 0x49, 0x8D, 0x3C, 0x81) // RDI = A[i, 0]
        mc_b4(c, 0x48, 0x8B, 0x54, 0x24); mc_b1(c, 16)
        mc_b4(c, 0x4A, 0x8D, 0x14, 0x92) // RDX = B[0, j]
        mc_b4(c, 0x48, 0x8B, 0x4C, 0x24); mc_b1(c, 24)
        mc_b3(c, 0x0F, 0x57, 0xC0)
        mc_b3(c, 0x48, 0x85, 0xDB)
        jle_pt := mc_jcc8(c, 0x7E)
        lp_pt := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x0F) // MOVSS XMM1, [RDI]
        mc_b4(c, 0xF3, 0x0F, 0x59, 0x0A) // MULSS XMM1, [RDX]
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1) // ADDSS XMM0, XMM1
        mc_b4(c, 0x48, 0x83, 0xC7, 0x04)
        mc_b3(c, 0x48, 0x01, 0xCA)
        mc_b3(c, 0x48, 0xFF, 0xCB)
        jnz_pt := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_pt, lp_pt)
        mc_patch_jcc8(c, jle_pt, buf_len(c))
        mc_b4(c, 0x48, 0x8B, 0x44, 0x24); mc_b1(c, 8)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC5)
        mc_b3(c, 0x4C, 0x01, 0xD0)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x11); mc_b2(c, 0x04, 0x83) // MOVSS [R11 + RAX*4], XMM0
        mc_b3(c, 0x49, 0xFF, 0xC5)
        jmp_it := mc_jmp32(c); mc_patch_rel32(c, jmp_it, lp_gm_it)
        mc_patch_rel32(c, jge_gm_it, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC2)
        jmp_jt := mc_jmp32(c); mc_patch_rel32(c, jmp_jt, lp_gm_jt)
        mc_patch_rel32(c, jge_gm_all, buf_len(c))
        mc_patch_rel32(c, jge_gm_e, buf_len(c))
        mc_ai_leave(c, 0xB8)
        mc_ai_emit_batch_pub(cg, h_ai_gemm_f32(), s_wk, 3, 5, 16384)
    }

    // 5b. `h_ai_bnn_popcnt`: args = `[weights, act, out, rows, words]` (2-row-tiled 4-word POPCNT + multi-core pool)
    if cg_is_helper_used(cg, h_ai_bnn_popcnt()) {
        mc_align16(c)
        s_wk := buf_len(c)
        mc_ai_enter(c, 0x28)
        mc_b3(c, 0x4D, 0x89, 0xC4)                      // R12 = pool
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 56)  // RAX = rows
        mc_ai_row_range(c)                              // R14 = r0, R15 = r1
        mc_b3(c, 0x4D, 0x39, 0xFE)
        jge_be := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4D, 0x8B, 0x5C, 0x24); mc_b1(c, 32)  // R11 = weights
        mc_b4(c, 0x4D, 0x8B, 0x44, 0x24); mc_b1(c, 40)  // R8  = act
        mc_b4(c, 0x49, 0x8B, 0x4C, 0x24); mc_b1(c, 48)  // RCX = out
        mc_b4(c, 0x4D, 0x8B, 0x54, 0x24); mc_b1(c, 64)  // R10 = words
        mc_b3(c, 0x4D, 0x85, 0xDB); jz_bw := mc_jcc32(c, 0x84)
        mc_b3(c, 0x4D, 0x85, 0xC0); jz_ba := mc_jcc32(c, 0x84)
        mc_b3(c, 0x48, 0x85, 0xC9); jz_bo := mc_jcc32(c, 0x84)
        mc_b3(c, 0x4D, 0x85, 0xD2); jle_bd := mc_jcc32(c, 0x8E)
        mc_b3(c, 0x4D, 0x89, 0xF9)                      // R9  = r1
        mc_b3(c, 0x4C, 0x89, 0xF7)                      // RDI = r0
        mc_b3(c, 0x4D, 0x89, 0xD4); mc_b4(c, 0x49, 0xC1, 0xE4, 0x03) // R12 = words * 8
        mc_b3(c, 0x48, 0x89, 0xF8); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC4) // RAX = r0 * row_bytes
        mc_b3(c, 0x49, 0x01, 0xC3)                      // R11 = weights + r0 * row_bytes
        // 2-row tiled 4-word unrolled POPCNT
        lp_b2r := buf_len(c)
        mc_b4(c, 0x48, 0x8D, 0x47, 0x01)
        mc_b3(c, 0x4C, 0x39, 0xC8)
        jge_bodd := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4D, 0x89, 0xDF); mc_b3(c, 0x4D, 0x01, 0xE7) // R15 = R11 + R12 (row1 ptr)
        mc_b2(c, 0x31, 0xDB)                            // RBX  = sum0a
        mc_b3(c, 0x45, 0x31, 0xED)                      // R13D = sum0b
        mc_b2(c, 0x31, 0xD2)                            // RDX  = sum1
        mc_b2(c, 0x31, 0xF6)                            // RSI  = w = 0
        lp_b2w := buf_len(c)
        mc_b4(c, 0x48, 0x8D, 0x46, 0x04)
        mc_b3(c, 0x4C, 0x39, 0xD0)
        jg_b2tl := mc_jcc32(c, 0x8F)
        mc_b4(c, 0x41, 0x0F, 0x18, 0x8C); mc_b1(c, 0xF3); mc_u32(c, 256) // PREFETCHT0 [R11+RSI*8+256]
        mut wi := 0
        while wi < 4 {
            off := wi * 8
            if off == 0 {
                mc_b4(c, 0x49, 0x8B, 0x04, 0xF0)
                mc_b3(c, 0x49, 0x89, 0xC6)
                mc_b4(c, 0x49, 0x33, 0x04, 0xF3)
                mc_b4(c, 0x4D, 0x33, 0x34, 0xF7)
            } else {
                mc_b4(c, 0x49, 0x8B, 0x44, 0xF0); mc_b1(c, off)
                mc_b3(c, 0x49, 0x89, 0xC6)
                mc_b4(c, 0x49, 0x33, 0x44, 0xF3); mc_b1(c, off)
                mc_b4(c, 0x4D, 0x33, 0x74, 0xF7); mc_b1(c, off)
            }
            mc_b4(c, 0xF3, 0x48, 0x0F, 0xB8); mc_b1(c, 0xC0)
            mc_b4(c, 0xF3, 0x4D, 0x0F, 0xB8); mc_b1(c, 0xF6)
            if (wi & 1) == 0 { mc_b2(c, 0x01, 0xC3) }
            else             { mc_b3(c, 0x41, 0x01, 0xC5) }
            mc_b3(c, 0x44, 0x01, 0xF2)
            wi += 1
        }
        mc_b4(c, 0x48, 0x83, 0xC6, 0x04)
        j_b2w := mc_jmp32(c); mc_patch_rel32(c, j_b2w, lp_b2w)
        mc_patch_rel32(c, jg_b2tl, buf_len(c))
        lp_b2t := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD6); jge_b2td := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xF0); mc_b3(c, 0x49, 0x89, 0xC6)
        mc_b4(c, 0x49, 0x33, 0x04, 0xF3); mc_b4(c, 0x4D, 0x33, 0x34, 0xF7)
        mc_b4(c, 0xF3, 0x48, 0x0F, 0xB8); mc_b1(c, 0xC0)
        mc_b4(c, 0xF3, 0x4D, 0x0F, 0xB8); mc_b1(c, 0xF6)
        mc_b2(c, 0x01, 0xC3); mc_b3(c, 0x44, 0x01, 0xF2)
        mc_b3(c, 0x48, 0xFF, 0xC6)
        j_b2t := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_b2t, lp_b2t)
        mc_patch_jcc8(c, jge_b2td, buf_len(c))
        mc_b3(c, 0x44, 0x01, 0xEB)                      // ADD EBX, R13D
        mc_b4(c, 0x48, 0x89, 0x1C, 0xF9)
        mc_b4(c, 0x48, 0x89, 0x54, 0xF9); mc_b1(c, 8)
        mc_b3(c, 0x4D, 0x01, 0xE3); mc_b3(c, 0x4D, 0x01, 0xE3)
        mc_b4(c, 0x48, 0x83, 0xC7, 0x02)
        j_b2r := mc_jmp32(c); mc_patch_rel32(c, j_b2r, lp_b2r)
        // Odd final row if (r1 - r0) is odd
        mc_patch_rel32(c, jge_bodd, buf_len(c))
        mc_b3(c, 0x4C, 0x39, 0xCF); jge_bdone := mc_jcc32(c, 0x8D)
        mc_b2(c, 0x31, 0xDB); mc_b2(c, 0x31, 0xF6)
        lp_b1t := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD6); jge_b1td := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xF3); mc_b4(c, 0x49, 0x33, 0x04, 0xF0)
        mc_b4(c, 0xF3, 0x48, 0x0F, 0xB8); mc_b1(c, 0xC0)
        mc_b2(c, 0x01, 0xC3); mc_b3(c, 0x48, 0xFF, 0xC6)
        j_b1t := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_b1t, lp_b1t)
        mc_patch_jcc8(c, jge_b1td, buf_len(c))
        mc_b4(c, 0x48, 0x89, 0x1C, 0xF9)
        bdone := buf_len(c)
        mc_patch_rel32(c, jge_be, bdone)
        mc_patch_rel32(c, jz_bw, bdone)
        mc_patch_rel32(c, jz_ba, bdone)
        mc_patch_rel32(c, jz_bo, bdone)
        mc_patch_rel32(c, jle_bd, bdone)
        mc_patch_rel32(c, jge_bdone, bdone)
        mc_ai_leave(c, 0x28)
        mc_ai_emit_batch_pub(cg, h_ai_bnn_popcnt(), s_wk, 3, 4, 32768)
    }
}

fn emit_ai_quant_helpers(cg: CodegenCtx) {
    c := cg.code

    // 6. `h_ai_gemv_q8_0`: single-row (`RCX < 0`: `RDX=act, R8=q8, R9=nblk -> XMM0=f64`) OR batch `args=[act, q8, out, rows, nblk]`
    if cg_is_helper_used(cg, h_ai_gemv_q8_0()) {
        mc_align16(c)
        s_wk := buf_len(c)
        mc_ai_enter(c, 0x28)
        mc_b3(c, 0x4D, 0x89, 0xC4) // R12 = pool
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 56) // rows
        mc_ai_row_range(c)         // R14 = r0, R15 = r1
        mc_b3(c, 0x4D, 0x39, 0xFE)
        jge_q8e := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x49, 0x8B, 0x6C, 0x24); mc_b1(c, 64) // RBP = nblk
        mc_b4(c, 0x49, 0x8B, 0x7C, 0x24); mc_b1(c, 32) // RDI = act
        mc_b4(c, 0x49, 0x8B, 0x5C, 0x24); mc_b1(c, 48) // RBX = out
        mc_b3(c, 0x48, 0x85, 0xDB)
        jz_q8no := mc_jcc8(c, 0x74)
        mc_b4(c, 0x4A, 0x8D, 0x1C, 0xB3) // LEA RBX, [RBX + R14*4]
        mc_patch_jcc8(c, jz_q8no, buf_len(c))
        mc_b3(c, 0x4C, 0x69, 0xCD); mc_u32(c, 36)       // IMUL R9, RBP, 36
        mc_b4(c, 0x49, 0x8B, 0x74, 0x24); mc_b1(c, 40) // RSI = q8
        mc_b3(c, 0x4C, 0x89, 0xF0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC1)
        mc_b3(c, 0x48, 0x01, 0xC6) // RSI = q8 + r0 * row_bytes
        mc_b3(c, 0x4D, 0x89, 0xF5) // R13 = r0

        lp_q8_row := buf_len(c)
        mc_b3(c, 0x48, 0x89, 0xF1) // RCX = q8_row
        mc_b3(c, 0x48, 0x89, 0xFA) // RDX = act
        mc_b3(c, 0x0F, 0x57, 0xC0) // XORPS XMM0, XMM0
        mc_b3(c, 0x48, 0x85, 0xED) // TEST RBP, RBP
        jle_q8_rstore := mc_jcc32(c, 0x8E)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_q8_sc := mc_jcc32(c, 0x84)

        mc_b3(c, 0x48, 0x89, 0xE8)       // RAX = nblk
        mc_vex2(c, 4, 1, 0, 0x57, 0xE4)  // VXORPS YMM4, YMM4, YMM4
        lp_q8_blk := buf_len(c)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x21); mc_b2(c, 0x49, 0x04) // VPMOVSXBD YMM1, [RCX+4]
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)                                // VCVTDQ2PS YMM1, YMM1
        mc_vex2(c, 0, 1, 0, 0x10, 0x12)                                // VMOVUPS YMM2, [RDX]
        mc_vex2(c, 1, 1, 0, 0x59, 0xC2)                                // VMULPS YMM0, YMM1, YMM2
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x21); mc_b2(c, 0x49, 0x0C) // VPMOVSXBD YMM1, [RCX+12]
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex2(c, 0, 1, 0, 0x10, 0x52); mc_b1(c, 0x20)                // VMOVUPS YMM2, [RDX+32]
        mc_vex3(c, 0, 0, 0, 2, 0, 1, 1, 1, 0xB8); mc_b1(c, 0xC2)       // VFMADD231PS YMM0, YMM1, YMM2
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x21); mc_b2(c, 0x49, 0x14) // VPMOVSXBD YMM1, [RCX+20]
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex2(c, 0, 1, 0, 0x10, 0x52); mc_b1(c, 0x40)                // VMOVUPS YMM2, [RDX+64]
        mc_vex3(c, 0, 0, 0, 2, 0, 1, 1, 1, 0xB8); mc_b1(c, 0xC2)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x21); mc_b2(c, 0x49, 0x1C) // VPMOVSXBD YMM1, [RCX+28]
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex2(c, 0, 1, 0, 0x10, 0x52); mc_b1(c, 0x60)                // VMOVUPS YMM2, [RDX+96]
        mc_vex3(c, 0, 0, 0, 2, 0, 1, 1, 1, 0xB8); mc_b1(c, 0xC2)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b1(c, 0x11)       // VBROADCASTSS YMM2, [RCX]
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0xB8); mc_b1(c, 0xE2)       // VFMADD231PS YMM4, YMM0, YMM2
        mc_b4(c, 0x48, 0x83, 0xC1, 36)
        mc_b3(c, 0x48, 0x81, 0xC2); mc_u32(c, 128)
        mc_b3(c, 0x48, 0xFF, 0xC8)
        jnz_q8b := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_q8b, lp_q8_blk)
        mc_vex2(c, 0, 1, 0, 0x28, 0xC4) // VMOVAPS YMM0, YMM4
        mc_avx_hsum_ymm0(c)
        mc_b3(c, 0xC5, 0xF8, 0x77)      // VZEROUPPER
        mc_b4(c, 0xF3, 0x0F, 0x5A, 0xC0) // CVTSS2SD XMM0, XMM0
        jmp_q8_st := mc_jmp32(c)

        // Scalar SSE2 fallback (`RCX=q8_row, RDX=act, RBP=nblk -> XMM0=f64`)
        mc_patch_rel32(c, jz_q8_sc, buf_len(c))
        mc_b3(c, 0x49, 0x89, 0xEA) // R10 = nblk
        lp_q8_sb := buf_len(c)
        mc_b3(c, 0x0F, 0x57, 0xC9)       // XORPS XMM1, XMM1 (f64 block sum)
        mc_b4(c, 0x4C, 0x8D, 0x59, 0x04) // R11 = RCX + 4
        mc_b2(c, 0x41, 0xB8); mc_u32(c, 32) // R8D = 32
        lp_q8_si := buf_len(c)
        mc_b4(c, 0x41, 0x0F, 0xBE, 0x03) // MOVSX EAX, BYTE [R11]
        mc_b4(c, 0xF2, 0x0F, 0x2A, 0xD0) // CVTSI2SD XMM2, EAX
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x1A) // MOVSS XMM3, [RDX]
        mc_b4(c, 0xF3, 0x0F, 0x5A, 0xDB) // CVTSS2SD XMM3, XMM3
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xD3) // MULSD XMM2, XMM3
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xCA) // ADDSD XMM1, XMM2
        mc_b3(c, 0x49, 0xFF, 0xC3)
        mc_b4(c, 0x48, 0x83, 0xC2, 0x04)
        mc_b3(c, 0x41, 0xFF, 0xC8)
        jnz_q8si := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_q8si, lp_q8_si)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x11) // MOVSS XMM2, [RCX]
        mc_b4(c, 0xF3, 0x0F, 0x5A, 0xD2) // CVTSS2SD XMM2, XMM2
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xCA) // MULSD XMM1, XMM2
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1) // ADDSD XMM0, XMM1
        mc_b4(c, 0x48, 0x83, 0xC1, 36)
        mc_b3(c, 0x49, 0xFF, 0xCA)
        jnz_q8sb := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_q8sb, lp_q8_sb)

        mc_patch_rel32(c, jmp_q8_st, buf_len(c))
        mc_patch_rel32(c, jle_q8_rstore, buf_len(c))
        mc_b3(c, 0x48, 0x85, 0xDB) // out_ptr == 0 (single-row)?
        jz_q8e := mc_jcc8(c, 0x74)
        mc_b4(c, 0xF2, 0x0F, 0x5A, 0xC8) // CVTSD2SS XMM1, XMM0
        mc_b4(c, 0xF3, 0x0F, 0x11, 0x0B) // MOVSS [RBX], XMM1
        mc_b4(c, 0x48, 0x83, 0xC3, 0x04)
        mc_b3(c, 0x4C, 0x01, 0xCE)       // RSI += R9 (row_bytes)
        mc_b3(c, 0x49, 0xFF, 0xC5)       // r13++
        mc_b3(c, 0x4D, 0x39, 0xFD)
        jl_q8r := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_q8r, lp_q8_row)
        mc_patch_jcc8(c, jz_q8e, buf_len(c))
        mc_patch_rel32(c, jge_q8e, buf_len(c))
        mc_ai_leave(c, 0x28)

        // Dual-mode entry: RCX < 0 -> single row `(RDX=act, R8=q8, R9=nblk) -> f64`; else `RCX = args_ptr`
        mc_align16(c)
        s_pub := buf_len(c)
        mc_ai_enter(c, 0x48)
        mc_b3(c, 0x48, 0x85, 0xC9)
        jns_q8b := mc_jcc32(c, 0x89)
        mc_b4(c, 0x48, 0x89, 0x54, 0x24); mc_b1(c, 0)  // act
        mc_b4(c, 0x4C, 0x89, 0x44, 0x24); mc_b1(c, 8)  // q8
        mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 16); mc_u32(c, 0) // out = 0
        mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 24); mc_u32(c, 1) // rows = 1
        mc_b4(c, 0x4C, 0x89, 0x4C, 0x24); mc_b1(c, 32) // nblk
        mc_b2(c, 0x31, 0xC9); mc_b1(c, 0xBA); mc_u32(c, 1)
        mc_b4(c, 0x4C, 0x8D, 0x44, 0x24); mc_b1(c, 0 - 32) // R8 = RSP - 32!
        mc_b1(c, 0xE8); mc_u32(c, s_wk - (buf_len(c) + 4))
        jmp_q8fin := mc_jmp32(c)

        mc_patch_rel32(c, jns_q8b, buf_len(c))
        mc_b3(c, 0x48, 0x89, 0xCB) // RBX = args_ptr
        mc_b4(c, 0x48, 0x8B, 0x43, 24) // rows
        mc_b3(c, 0x48, 0x85, 0xC0)
        jle_q8done := mc_jcc32(c, 0x8E)
        mc_b4(c, 0x48, 0x0F, 0xAF, 0x43); mc_b1(c, 32) // rows * nblk
        mc_b2(c, 0x48, 0x3D); mc_u32(c, 512)
        jge_q8p := mc_jcc8(c, 0x7D)
        mc_b2(c, 0x31, 0xC9); mc_b1(c, 0xBA); mc_u32(c, 1)
        mc_b4(c, 0x4C, 0x8D, 0x43, 0xE0)
        mc_b1(c, 0xE8); mc_u32(c, s_wk - (buf_len(c) + 4))
        jmp_q8done := mc_jmp32(c)
        mc_patch_jcc8(c, jge_q8p, buf_len(c))
        mc_b3(c, 0x48, 0x8D, 0x0D); mc_u32(c, s_wk - (buf_len(c) + 4))
        mc_b3(c, 0x48, 0x89, 0xDA)
        cg_call_fn(cg, h_ai_pool_dispatch())
        mc_patch_rel32(c, jle_q8done, buf_len(c))
        mc_patch_rel32(c, jmp_q8done, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_patch_rel32(c, jmp_q8fin, buf_len(c))
        mc_ai_leave(c, 0x48)
        cg_reg_helper(cg, h_ai_gemv_q8_0(), s_pub, buf_len(c))
    }

    // 7. `h_ai_gemv_q4_0`: single-row (`RCX < 0`) OR batch `args=[act, q4, out, rows, nblk]` (20B blocks)
    if cg_is_helper_used(cg, h_ai_gemv_q4_0()) {
        mc_align16(c)
        s_wk := buf_len(c)
        // [RSP+0..15] = 0x0F*16, [RSP+16..31] = 0x08*16
        mc_ai_enter(c, 0x48)
        mc_b3(c, 0x4D, 0x89, 0xC4) // R12 = pool
        mc_b2(c, 0x48, 0xB8); mc_u64(c, 0x0F0F0F0F0F0F0F0F)
        mc_b4(c, 0x48, 0x89, 0x04, 0x24)
        mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 8)
        mc_b2(c, 0x48, 0xB8); mc_u64(c, 0x0808080808080808)
        mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 16)
        mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 24)

        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 56) // rows
        mc_ai_row_range(c)         // R14 = r0, R15 = r1
        mc_b3(c, 0x4D, 0x39, 0xFE)
        jge_q4e := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x49, 0x8B, 0x6C, 0x24); mc_b1(c, 64) // RBP = nblk
        mc_b4(c, 0x49, 0x8B, 0x7C, 0x24); mc_b1(c, 32) // RDI = act
        mc_b4(c, 0x49, 0x8B, 0x5C, 0x24); mc_b1(c, 48) // RBX = out
        mc_b3(c, 0x48, 0x85, 0xDB)
        jz_q4no := mc_jcc8(c, 0x74)
        mc_b4(c, 0x4A, 0x8D, 0x1C, 0xB3)
        mc_patch_jcc8(c, jz_q4no, buf_len(c))
        mc_b3(c, 0x4C, 0x69, 0xCD); mc_u32(c, 20)       // R9 = nblk * 20
        mc_b4(c, 0x49, 0x8B, 0x74, 0x24); mc_b1(c, 40) // RSI = q4
        mc_b3(c, 0x4C, 0x89, 0xF0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC1)
        mc_b3(c, 0x48, 0x01, 0xC6)
        mc_b3(c, 0x4D, 0x89, 0xF5) // R13 = r0

        lp_q4_row := buf_len(c)
        mc_b3(c, 0x48, 0x89, 0xF1) // RCX = q4_row
        mc_b3(c, 0x48, 0x89, 0xFA) // RDX = act
        mc_b3(c, 0x0F, 0x57, 0xC0)
        mc_b3(c, 0x48, 0x85, 0xED)
        jle_q4_rs := mc_jcc32(c, 0x8E)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_q4_sc := mc_jcc32(c, 0x84)

        mc_b3(c, 0x48, 0x89, 0xE8)      // RAX = nblk
        mc_vex2(c, 4, 1, 0, 0x57, 0xE4) // VXORPS YMM4, YMM4, YMM4
        lp_q4_blk := buf_len(c)
        mc_vex2(c, 0, 0, 2, 0x6F, 0x49); mc_b1(c, 4)    // VMOVDQU XMM1, [RCX+4]
        mc_vex2(c, 2, 0, 1, 0x71, 0xD1); mc_b1(c, 4)    // VPSRLW XMM2, XMM1, 4
        mc_vex2(c, 1, 0, 1, 0xDB, 0x0C); mc_b1(c, 0x24) // VPAND XMM1, XMM1, [RSP]
        mc_vex2(c, 2, 0, 1, 0xDB, 0x14); mc_b1(c, 0x24) // VPAND XMM2, XMM2, [RSP]
        mc_vex2(c, 1, 0, 1, 0x60, 0xC2)                 // VPUNPCKLBW XMM0, XMM1, XMM2
        mc_vex2(c, 1, 0, 1, 0x68, 0xCA)                 // VPUNPCKHBW XMM1, XMM1, XMM2
        mc_vex2(c, 0, 0, 1, 0xF8, 0x44); mc_b2(c, 0x24, 16) // VPSUBB XMM0, XMM0, [RSP+16]
        mc_vex2(c, 1, 0, 1, 0xF8, 0x4C); mc_b2(c, 0x24, 16) // VPSUBB XMM1, XMM1, [RSP+16]
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x21); mc_b1(c, 0xD0) // VPMOVSXBD YMM2, XMM0
        mc_vex2(c, 0, 1, 0, 0x5B, 0xD2)                          // VCVTDQ2PS YMM2, YMM2
        mc_vex2(c, 0, 1, 0, 0x10, 0x1A)                          // VMOVUPS YMM3, [RDX]
        mc_vex2(c, 2, 1, 0, 0x59, 0xEB)                          // VMULPS YMM5, YMM2, YMM3
        mc_vex2(c, 0, 0, 1, 0x73, 0xD8); mc_b1(c, 8)             // VPSRLDQ XMM0, XMM0, 8
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x21); mc_b1(c, 0xD0)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xD2)
        mc_vex2(c, 0, 1, 0, 0x10, 0x5A); mc_b1(c, 0x20)
        mc_vex3(c, 0, 0, 0, 2, 0, 2, 1, 1, 0xB8); mc_b1(c, 0xEB) // VFMADD231PS YMM5, YMM2, YMM3
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x21); mc_b1(c, 0xD1) // VPMOVSXBD YMM2, XMM1
        mc_vex2(c, 0, 1, 0, 0x5B, 0xD2)
        mc_vex2(c, 0, 1, 0, 0x10, 0x5A); mc_b1(c, 0x40)
        mc_vex3(c, 0, 0, 0, 2, 0, 2, 1, 1, 0xB8); mc_b1(c, 0xEB)
        mc_vex2(c, 1, 0, 1, 0x73, 0xD9); mc_b1(c, 8)             // VPSRLDQ XMM1, XMM1, 8
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x21); mc_b1(c, 0xD1)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xD2)
        mc_vex2(c, 0, 1, 0, 0x10, 0x5A); mc_b1(c, 0x60)
        mc_vex3(c, 0, 0, 0, 2, 0, 2, 1, 1, 0xB8); mc_b1(c, 0xEB)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b1(c, 0x11) // VBROADCASTSS YMM2, [RCX]
        mc_vex3(c, 0, 0, 0, 2, 0, 5, 1, 1, 0xB8); mc_b1(c, 0xE2) // VFMADD231PS YMM4, YMM5, YMM2
        mc_b4(c, 0x48, 0x83, 0xC1, 20)
        mc_b3(c, 0x48, 0x81, 0xC2); mc_u32(c, 128)
        mc_b3(c, 0x48, 0xFF, 0xC8)
        jnz_q4b := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_q4b, lp_q4_blk)
        mc_vex2(c, 0, 1, 0, 0x28, 0xC4)
        mc_avx_hsum_ymm0(c)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_b4(c, 0xF3, 0x0F, 0x5A, 0xC0) // CVTSS2SD XMM0, XMM0
        jmp_q4_st := mc_jmp32(c)

        // Scalar SSE2 Q4_0 fallback
        mc_patch_rel32(c, jz_q4_sc, buf_len(c))
        mc_b3(c, 0x49, 0x89, 0xEA) // R10 = nblk
        lp_q4_sb := buf_len(c)
        mc_b3(c, 0x0F, 0x57, 0xC9)
        mc_b4(c, 0x4C, 0x8D, 0x59, 0x04) // R11 = RCX + 4
        mc_b2(c, 0x41, 0xB8); mc_u32(c, 16)
        lp_q4_si := buf_len(c)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x03) // MOVZX EAX, BYTE [R11]
        mc_b2(c, 0x89, 0xC2); mc_b3(c, 0x83, 0xE0, 0x0F); mc_b3(c, 0x83, 0xE8, 0x08) // lo - 8
        mc_b3(c, 0xC1, 0xEA, 0x04); mc_b3(c, 0x83, 0xEA, 0x08) // hi - 8 -> wait EDX was act_ptr! Save/use? Wait R8 free? Use ECX? Wait don't touch RDX!!
        mc_patch_rel32(c, jz_q4_sc, buf_len(c)) // clean restart of Q4 scalar without clobbering RDX:
        mc_b3(c, 0x49, 0x89, 0xEA)
        lp_q4_sb2 := buf_len(c)
        mc_b3(c, 0x0F, 0x57, 0xC9)
        mc_b4(c, 0x4C, 0x8D, 0x59, 0x04)
        mc_b2(c, 0x41, 0xB8); mc_u32(c, 16)
        lp_q4_si2 := buf_len(c)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x03) // MOVZX EAX, BYTE [R11]
        mc_b3(c, 0x83, 0xE0, 0x0F); mc_b3(c, 0x83, 0xE8, 0x08)
        mc_b4(c, 0xF2, 0x0F, 0x2A, 0xD0)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x1A); mc_b4(c, 0xF3, 0x0F, 0x5A, 0xDB)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xD3); mc_b4(c, 0xF2, 0x0F, 0x58, 0xCA)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x03); mc_b3(c, 0xC1, 0xE8, 0x04); mc_b3(c, 0x83, 0xE8, 0x08)
        mc_b4(c, 0xF2, 0x0F, 0x2A, 0xD0)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x5A); mc_b1(c, 4); mc_b4(c, 0xF3, 0x0F, 0x5A, 0xDB)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xD3); mc_b4(c, 0xF2, 0x0F, 0x58, 0xCA)
        mc_b3(c, 0x49, 0xFF, 0xC3)
        mc_b4(c, 0x48, 0x83, 0xC2, 0x08)
        mc_b3(c, 0x41, 0xFF, 0xC8)
        jnz_q4si := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_q4si, lp_q4_si2)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x11); mc_b4(c, 0xF3, 0x0F, 0x5A, 0xD2)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xCA); mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)
        mc_b4(c, 0x48, 0x83, 0xC1, 20)
        mc_b3(c, 0x49, 0xFF, 0xCA)
        jnz_q4sb := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_q4sb, lp_q4_sb2)

        mc_patch_rel32(c, jmp_q4_st, buf_len(c))
        mc_patch_rel32(c, jle_q4_rs, buf_len(c))
        mc_b3(c, 0x48, 0x85, 0xDB)
        jz_q4e := mc_jcc8(c, 0x74)
        mc_b4(c, 0xF2, 0x0F, 0x5A, 0xC8)
        mc_b4(c, 0xF3, 0x0F, 0x11, 0x0B)
        mc_b4(c, 0x48, 0x83, 0xC3, 0x04)
        mc_b3(c, 0x4C, 0x01, 0xCE)
        mc_b3(c, 0x49, 0xFF, 0xC5)
        mc_b3(c, 0x4D, 0x39, 0xFD)
        jl_q4r := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_q4r, lp_q4_row)
        mc_patch_jcc8(c, jz_q4e, buf_len(c))
        mc_patch_rel32(c, jge_q4e, buf_len(c))
        mc_ai_leave(c, 0x48)

        mc_align16(c)
        s_pub := buf_len(c)
        mc_ai_enter(c, 0x48)
        mc_b3(c, 0x48, 0x85, 0xC9)
        jns_q4b := mc_jcc32(c, 0x89)
        mc_b4(c, 0x48, 0x89, 0x54, 0x24); mc_b1(c, 0)
        mc_b4(c, 0x4C, 0x89, 0x44, 0x24); mc_b1(c, 8)
        mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 16); mc_u32(c, 0)
        mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 24); mc_u32(c, 1)
        mc_b4(c, 0x4C, 0x89, 0x4C, 0x24); mc_b1(c, 32)
        mc_b2(c, 0x31, 0xC9); mc_b1(c, 0xBA); mc_u32(c, 1)
        mc_b4(c, 0x4C, 0x8D, 0x44, 0x24); mc_b1(c, 0 - 32)
        mc_b1(c, 0xE8); mc_u32(c, s_wk - (buf_len(c) + 4))
        jmp_q4fin := mc_jmp32(c)
        mc_patch_rel32(c, jns_q4b, buf_len(c))
        mc_b3(c, 0x48, 0x89, 0xCB)
        mc_b4(c, 0x48, 0x8B, 0x43, 24)
        mc_b3(c, 0x48, 0x85, 0xC0)
        jle_q4done := mc_jcc32(c, 0x8E)
        mc_b4(c, 0x48, 0x0F, 0xAF, 0x43); mc_b1(c, 32)
        mc_b2(c, 0x48, 0x3D); mc_u32(c, 512)
        jge_q4p := mc_jcc8(c, 0x7D)
        mc_b2(c, 0x31, 0xC9); mc_b1(c, 0xBA); mc_u32(c, 1)
        mc_b4(c, 0x4C, 0x8D, 0x43, 0xE0)
        mc_b1(c, 0xE8); mc_u32(c, s_wk - (buf_len(c) + 4))
        jmp_q4done := mc_jmp32(c)
        mc_patch_jcc8(c, jge_q4p, buf_len(c))
        mc_b3(c, 0x48, 0x8D, 0x0D); mc_u32(c, s_wk - (buf_len(c) + 4))
        mc_b3(c, 0x48, 0x89, 0xDA)
        cg_call_fn(cg, h_ai_pool_dispatch())
        mc_patch_rel32(c, jle_q4done, buf_len(c))
        mc_patch_rel32(c, jmp_q4done, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_patch_rel32(c, jmp_q4fin, buf_len(c))
        mc_ai_leave(c, 0x48)
        cg_reg_helper(cg, h_ai_gemv_q4_0(), s_pub, buf_len(c))
    }

    // 8. `h_ai_gemv_bitnet`: batch `args=[act, bn, out, rows, nblk]` (12B blocks)
    if cg_is_helper_used(cg, h_ai_gemv_bitnet()) {
        mc_align16(c)
        s_wk := buf_len(c)
        // [RSP+0..31] = shift [0,2,4,6,8,10,12,14], [RSP+32..63] = [1*8]
        mc_ai_enter(c, 0x48)
        mc_b3(c, 0x4D, 0x89, 0xC4)
        mut si := 0
        while si < 8 {
            mc_b4(c, 0xC7, 0x44, 0x24, si * 4); mc_u32(c, si * 2)
            mc_b4(c, 0xC7, 0x44, 0x24, 32 + si * 4); mc_u32(c, 1)
            si += 1
        }
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 56) // rows
        mc_ai_row_range(c)
        mc_b3(c, 0x4D, 0x39, 0xFE)
        jge_bne := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x49, 0x8B, 0x6C, 0x24); mc_b1(c, 64) // RBP = nblk
        mc_b4(c, 0x49, 0x8B, 0x7C, 0x24); mc_b1(c, 32) // RDI = act
        mc_b4(c, 0x49, 0x8B, 0x5C, 0x24); mc_b1(c, 48) // RBX = out
        mc_b4(c, 0x4A, 0x8D, 0x1C, 0xB3)
        mc_b3(c, 0x4C, 0x69, 0xCD); mc_u32(c, 12)       // R9 = nblk * 12
        mc_b4(c, 0x49, 0x8B, 0x74, 0x24); mc_b1(c, 40) // RSI = bn
        mc_b3(c, 0x4C, 0x89, 0xF0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC1)
        mc_b3(c, 0x48, 0x01, 0xC6)
        mc_b3(c, 0x4D, 0x89, 0xF5)

        lp_bn_r := buf_len(c)
        mc_b3(c, 0x48, 0x89, 0xF1)
        mc_b3(c, 0x48, 0x89, 0xFA)
        mc_b3(c, 0x0F, 0x57, 0xC0)
        mc_b3(c, 0x48, 0x85, 0xED)
        jle_bn_rs := mc_jcc32(c, 0x8E)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_bn_sc := mc_jcc32(c, 0x84)

        mc_b3(c, 0x48, 0x89, 0xE8)
        mc_vex2(c, 4, 1, 0, 0x57, 0xE4) // VXORPS YMM4, YMM4, YMM4
        lp_bn_b := buf_len(c)
        // First 16 weights from [RCX+4]
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x58); mc_b2(c, 0x41, 4) // VPBROADCASTD YMM0, [RCX+4]
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x45); mc_b2(c, 0x0C, 0x24) // VPSRLVD YMM1, YMM0, [RSP]
        mc_vex2(c, 2, 1, 1, 0x72, 0xD1); mc_b1(c, 1)
        mc_vex2(c, 1, 1, 1, 0xDB, 0x4C); mc_b2(c, 0x24, 32)
        mc_vex2(c, 2, 1, 1, 0xDB, 0x54); mc_b2(c, 0x24, 32)
        mc_vex2(c, 1, 1, 1, 0xFA, 0xCA)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex2(c, 0, 1, 0, 0x10, 0x12)
        mc_vex2(c, 1, 1, 0, 0x59, 0xEA) // VMULPS YMM5, YMM1, YMM2
        mc_vex2(c, 0, 1, 1, 0x72, 0xD0); mc_b1(c, 16)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x45); mc_b2(c, 0x0C, 0x24)
        mc_vex2(c, 2, 1, 1, 0x72, 0xD1); mc_b1(c, 1)
        mc_vex2(c, 1, 1, 1, 0xDB, 0x4C); mc_b2(c, 0x24, 32)
        mc_vex2(c, 2, 1, 1, 0xDB, 0x54); mc_b2(c, 0x24, 32)
        mc_vex2(c, 1, 1, 1, 0xFA, 0xCA)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex2(c, 0, 1, 0, 0x10, 0x52); mc_b1(c, 0x20)
        mc_vex3(c, 0, 0, 0, 2, 0, 1, 1, 1, 0xB8); mc_b1(c, 0xEA)
        // Second 16 weights from [RCX+8]
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x58); mc_b2(c, 0x41, 8)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x45); mc_b2(c, 0x0C, 0x24)
        mc_vex2(c, 2, 1, 1, 0x72, 0xD1); mc_b1(c, 1)
        mc_vex2(c, 1, 1, 1, 0xDB, 0x4C); mc_b2(c, 0x24, 32)
        mc_vex2(c, 2, 1, 1, 0xDB, 0x54); mc_b2(c, 0x24, 32)
        mc_vex2(c, 1, 1, 1, 0xFA, 0xCA)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex2(c, 0, 1, 0, 0x10, 0x52); mc_b1(c, 0x40)
        mc_vex3(c, 0, 0, 0, 2, 0, 1, 1, 1, 0xB8); mc_b1(c, 0xEA)
        mc_vex2(c, 0, 1, 1, 0x72, 0xD0); mc_b1(c, 16)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x45); mc_b2(c, 0x0C, 0x24)
        mc_vex2(c, 2, 1, 1, 0x72, 0xD1); mc_b1(c, 1)
        mc_vex2(c, 1, 1, 1, 0xDB, 0x4C); mc_b2(c, 0x24, 32)
        mc_vex2(c, 2, 1, 1, 0xDB, 0x54); mc_b2(c, 0x24, 32)
        mc_vex2(c, 1, 1, 1, 0xFA, 0xCA)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex2(c, 0, 1, 0, 0x10, 0x52); mc_b1(c, 0x60)
        mc_vex3(c, 0, 0, 0, 2, 0, 1, 1, 1, 0xB8); mc_b1(c, 0xEA)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b1(c, 0x11)
        mc_vex3(c, 0, 0, 0, 2, 0, 5, 1, 1, 0xB8); mc_b1(c, 0xE2)
        mc_b4(c, 0x48, 0x83, 0xC1, 12)
        mc_b3(c, 0x48, 0x81, 0xC2); mc_u32(c, 128)
        mc_b3(c, 0x48, 0xFF, 0xC8)
        jnz_bnb := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_bnb, lp_bn_b)
        mc_vex2(c, 0, 1, 0, 0x28, 0xC4)
        mc_avx_hsum_ymm0(c)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_bn_st := mc_jmp32(c)

        // Scalar SSE2 fallback
        mc_patch_rel32(c, jz_bn_sc, buf_len(c))
        mc_b3(c, 0x49, 0x89, 0xEA)
        lp_bn_sb := buf_len(c)
        mc_b3(c, 0x0F, 0x57, 0xC9)       // XMM1 = block_sum (f32)
        mc_b4(c, 0x4C, 0x8D, 0x59, 0x04) // R11 = RCX + 4
        mc_b2(c, 0x41, 0xB8); mc_u32(c, 8)
        lp_bn_si := buf_len(c)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x03) // EAX = byte [R11]
        mut kk := 0
        while kk < 4 {
            mc_b4(c, 0xF3, 0x0F, 0x10, 0x52); mc_b1(c, kk * 4)
            mc_b3(c, 0xA8, 0x01, 0x74)
            mc_b1(c, 6)
            mc_b4(c, 0xF3, 0x0F, 0x58, 0xCA)
            mc_b2(c, 0xEB, 8)
            mc_b3(c, 0xA8, 0x02, 0x74)
            mc_b1(c, 4)
            mc_b4(c, 0xF3, 0x0F, 0x5C, 0xCA)
            mc_b3(c, 0xC1, 0xE8, 0x02)
            kk += 1
        }
        mc_b3(c, 0x49, 0xFF, 0xC3)
        mc_b4(c, 0x48, 0x83, 0xC2, 16)
        mc_b3(c, 0x41, 0xFF, 0xC8)
        jnz_bnsi := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_bnsi, lp_bn_si)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0x09) // MULSS XMM1, [RCX]
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1) // ADDSS XMM0, XMM1
        mc_b4(c, 0x48, 0x83, 0xC1, 12)
        mc_b3(c, 0x49, 0xFF, 0xCA)
        jnz_bnsb := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_bnsb, lp_bn_sb)

        mc_patch_rel32(c, jmp_bn_st, buf_len(c))
        mc_patch_rel32(c, jle_bn_rs, buf_len(c))
        mc_b4(c, 0xF3, 0x0F, 0x11, 0x03)
        mc_b4(c, 0x48, 0x83, 0xC3, 0x04)
        mc_b3(c, 0x4C, 0x01, 0xCE)
        mc_b3(c, 0x49, 0xFF, 0xC5)
        mc_b3(c, 0x4D, 0x39, 0xFD)
        jl_bnr := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_bnr, lp_bn_r)
        mc_patch_rel32(c, jge_bne, buf_len(c))
        mc_ai_leave(c, 0x48)
        mc_ai_emit_batch_pub(cg, h_ai_gemv_bitnet(), s_wk, 3, 4, 512)
    }

    // 9. `h_ai_gemv_bnn`: batch `args=[act, bnn, out, rows, nblk]` (pre-binarizes `act` once -> XNOR + POPCNT)
    if cg_is_helper_used(cg, h_ai_gemv_bnn()) {
        mc_align16(c)
        s_wk := buf_len(c)
        mc_ai_enter(c, 0x28)
        mc_b3(c, 0x4D, 0x89, 0xC4) // R12 = pool
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 56)
        mc_ai_row_range(c)
        mc_b3(c, 0x4D, 0x39, 0xFE)
        jge_be := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x49, 0x8B, 0x6C, 0x24); mc_b1(c, 64) // RBP = nblk
        mc_b4(c, 0x49, 0x8B, 0x7C, 0x24); mc_b1(c, 72) // RDI = act_bin (`p5`)
        mc_b4(c, 0x49, 0x8B, 0x5C, 0x24); mc_b1(c, 48) // RBX = out
        mc_b4(c, 0x4A, 0x8D, 0x1C, 0xB3)
        mc_b4(c, 0x4C, 0x8D, 0x0C, 0xED); mc_u32(c, 0) // R9 = nblk * 8
        mc_b4(c, 0x49, 0x8B, 0x74, 0x24); mc_b1(c, 40) // RSI = bnn
        mc_b3(c, 0x4C, 0x89, 0xF0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC1)
        mc_b3(c, 0x48, 0x01, 0xC6)
        mc_b3(c, 0x4D, 0x89, 0xF5)

        lp_bnn_r := buf_len(c)
        mc_b3(c, 0x48, 0x89, 0xF1) // RCX = bnn_row
        mc_b3(c, 0x48, 0x89, 0xFA) // RDX = act_bin
        mc_b3(c, 0x49, 0x89, 0xE8) // R8 = nblk
        mc_b3(c, 0x0F, 0x57, 0xC0) // XORPS XMM0, XMM0
        mc_b3(c, 0x4D, 0x85, 0xC0)
        jle_bnn_s := mc_jcc8(c, 0x7E)
        lp_bnn_b := buf_len(c)
        mc_b2(c, 0x8B, 0x02)             // MOV EAX, [RDX]
        mc_b3(c, 0x33, 0x41, 0x04)       // XOR EAX, [RCX + 4]
        mc_b4(c, 0xF3, 0x0F, 0xB8, 0xC0) // POPCNT EAX, EAX
        mc_b2(c, 0x01, 0xC0)             // EAX *= 2
        mc_b2(c, 0x41, 0xBA); mc_u32(c, 32)
        mc_b3(c, 0x41, 0x29, 0xC2)       // R10D = 32 - 2*popcnt
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x2A); mc_b1(c, 0xCA) // CVTSI2SS XMM1, R10D
        mc_b4(c, 0xF3, 0x0F, 0x59, 0x09) // MULSS XMM1, [RCX]
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1) // ADDSS XMM0, XMM1
        mc_b4(c, 0x48, 0x83, 0xC1, 0x08)
        mc_b4(c, 0x48, 0x83, 0xC2, 0x04)
        mc_b3(c, 0x49, 0xFF, 0xC8)
        jnz_bnn_b := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_bnn_b, lp_bnn_b)
        mc_patch_jcc8(c, jle_bnn_s, buf_len(c))
        mc_b4(c, 0xF3, 0x0F, 0x11, 0x03)
        mc_b4(c, 0x48, 0x83, 0xC3, 0x04)
        mc_b3(c, 0x4C, 0x01, 0xCE)
        mc_b3(c, 0x49, 0xFF, 0xC5)
        mc_b3(c, 0x4D, 0x39, 0xFD)
        jl_bnn_r := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_bnn_r, lp_bnn_r)
        mc_patch_rel32(c, jge_be, buf_len(c))
        mc_ai_leave(c, 0x28)

        // Custom public dispatcher for BNN: pre-binarizes `act` into temp buffer (`nblk * 4`), dispatches, frees!
        mc_align16(c)
        s_pub := buf_len(c)
        mc_ai_enter(c, 0x48)
        mc_b3(c, 0x48, 0x89, 0xCB)       // RBX = args_ptr
        mc_b4(c, 0x48, 0x8B, 0x43, 24)   // rows
        mc_b3(c, 0x48, 0x85, 0xC0)
        jle_bp := mc_jcc32(c, 0x8E)
        mc_b4(c, 0x48, 0x8B, 0x4B, 32)   // RCX = nblk
        mc_b3(c, 0x48, 0x85, 0xC9)
        jle_bp2 := mc_jcc32(c, 0x8E)
        mc_b3(c, 0x48, 0xC1, 0xE1); mc_b1(c, 2) // RCX = nblk * 4
        cg_call_fn(cg, h_alloc_mem())
        mc_b3(c, 0x49, 0x89, 0xC4)       // R12 = act_bin
        // Copy args [0..4] to [RSP+0..32] + set [RSP+40] = act_bin
        mut bi := 0
        while bi < 5 {
            mc_b4(c, 0x48, 0x8B, 0x43, bi * 8)
            mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, bi * 8)
            bi += 1
        }
        mc_b4(c, 0x4C, 0x89, 0x64, 0x24); mc_b1(c, 40)
        // Binarize act -> act_bin (`32` floats per `u32` block)
        mc_b3(c, 0x48, 0x8B, 0x33)       // RSI = act
        mc_b3(c, 0x4C, 0x89, 0xE7)       // RDI = act_bin
        mc_b4(c, 0x48, 0x8B, 0x6B, 32)   // RBP = nblk
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_bpin_sc := mc_jcc32(c, 0x84)
        mc_vex2(c, 5, 1, 0, 0x57, 0xED)  // VXORPS YMM5, YMM5, YMM5
        lp_bpin := buf_len(c)
        mc_vex2(c, 0, 1, 0, 0x10, 0x0E)                         // VMOVUPS YMM1, [RSI]
        mc_vex2(c, 1, 1, 0, 0xC2, 0xC5); mc_b1(c, 0x0D)         // VCMPPS YMM0, YMM1, YMM5, 13 (>= 0)
        mc_vex2(c, 0, 1, 0, 0x50, 0xC0)                         // VMOVMSKPS EAX, YMM0
        mc_vex2(c, 0, 1, 0, 0x10, 0x4E); mc_b1(c, 0x20)
        mc_vex2(c, 1, 1, 0, 0xC2, 0xCD); mc_b1(c, 0x0D)
        mc_vex2(c, 0, 1, 0, 0x50, 0xD1); mc_b3(c, 0xC1, 0xE2, 8); mc_b2(c, 0x09, 0xD0)
        mc_vex2(c, 0, 1, 0, 0x10, 0x4E); mc_b1(c, 0x40)
        mc_vex2(c, 1, 1, 0, 0xC2, 0xCD); mc_b1(c, 0x0D)
        mc_vex2(c, 0, 1, 0, 0x50, 0xD1); mc_b3(c, 0xC1, 0xE2, 16); mc_b2(c, 0x09, 0xD0)
        mc_vex2(c, 0, 1, 0, 0x10, 0x4E); mc_b1(c, 0x60)
        mc_vex2(c, 1, 1, 0, 0xC2, 0xCD); mc_b1(c, 0x0D)
        mc_vex2(c, 0, 1, 0, 0x50, 0xD1); mc_b3(c, 0xC1, 0xE2, 24); mc_b2(c, 0x09, 0xD0)
        mc_b2(c, 0x89, 0x07)             // MOV [RDI], EAX
        mc_b3(c, 0x48, 0x81, 0xC6); mc_u32(c, 128)
        mc_b4(c, 0x48, 0x83, 0xC7, 4)
        mc_b3(c, 0x48, 0xFF, 0xCD)
        jnz_bpin := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_bpin, lp_bpin)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_bpin_d := mc_jmp32(c)
        mc_patch_rel32(c, jz_bpin_sc, buf_len(c))
        mc_b3(c, 0x0F, 0x57, 0xC9) // XMM1 = 0.0
        lp_bpin_s := buf_len(c)
        mc_b2(c, 0x31, 0xC0); mc_b2(c, 0x31, 0xC9)
        lp_bp_i := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x06) // MOVSS XMM0, [RSI]
        mc_b4(c, 0x0F, 0x2F, 0xC1, 0x72); mc_b1(c, 9) // COMISS XMM0, XMM1; JB skip (9B)
        mc_b1(c, 0xBA); mc_u32(c, 1); mc_b2(c, 0xD3, 0xE2); mc_b2(c, 0x09, 0xD0)
        mc_b4(c, 0x48, 0x83, 0xC6, 4); mc_b2(c, 0xFF, 0xC1); mc_b3(c, 0x83, 0xF9, 32)
        jl_bpi := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_bpi, lp_bp_i)
        mc_b2(c, 0x89, 0x07); mc_b4(c, 0x48, 0x83, 0xC7, 4); mc_b3(c, 0x48, 0xFF, 0xCD)
        jnz_bpis := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_bpis, lp_bpin_s)
        mc_patch_rel32(c, jmp_bpin_d, buf_len(c))

        mc_b4(c, 0x48, 0x8B, 0x43, 24)
        mc_b4(c, 0x48, 0x0F, 0xAF, 0x43); mc_b1(c, 32)
        mc_b2(c, 0x48, 0x3D); mc_u32(c, 512)
        jge_bnp := mc_jcc8(c, 0x7D)
        mc_b2(c, 0x31, 0xC9); mc_b1(c, 0xBA); mc_u32(c, 1)
        mc_b4(c, 0x4C, 0x8D, 0x44, 0x24); mc_b1(c, 0 - 32)
        mc_b1(c, 0xE8); mc_u32(c, s_wk - (buf_len(c) + 4))
        jmp_bnfree := mc_jmp32(c)
        mc_patch_jcc8(c, jge_bnp, buf_len(c))
        mc_b3(c, 0x48, 0x8D, 0x0D); mc_u32(c, s_wk - (buf_len(c) + 4))
        mc_b3(c, 0x48, 0x89, 0xE2)
        cg_call_fn(cg, h_ai_pool_dispatch())
        mc_patch_rel32(c, jmp_bnfree, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xE1)
        cg_call_fn(cg, h_free_mem())
        mc_patch_rel32(c, jle_bp, buf_len(c))
        mc_patch_rel32(c, jle_bp2, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_ai_leave(c, 0x48)
        cg_reg_helper(cg, h_ai_gemv_bnn(), s_pub, buf_len(c))
    }
}

fn emit_ai_vec_norm_helpers(cg: CodegenCtx) {
    c := cg.code

    // 10. `h_ai_l2_batch`: args = `[db_ptr, q_ptr, out_ptr, nvecs, dim]`
    if cg_is_helper_used(cg, h_ai_l2_batch()) {
        mc_align16(c)
        s_wk := buf_len(c)
        mc_ai_enter(c, 0x28)
        mc_b3(c, 0x4D, 0x89, 0xC4)
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 56) // nvecs
        mc_ai_row_range(c)
        mc_b3(c, 0x4D, 0x39, 0xFE)
        jge_l2e := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4D, 0x8B, 0x44, 0x24); mc_b1(c, 64) // R8 = dim
        mc_b4(c, 0x49, 0x8B, 0x7C, 0x24); mc_b1(c, 40) // RDI = q_ptr
        mc_b4(c, 0x49, 0x8B, 0x5C, 0x24); mc_b1(c, 48) // RBX = out
        mc_b4(c, 0x4A, 0x8D, 0x1C, 0xB3)
        mc_b3(c, 0x4D, 0x89, 0xC1)                     // MOV R9, R8
        mc_b4(c, 0x49, 0xC1, 0xE1, 0x02)               // R9 = dim * 4
        mc_b4(c, 0x49, 0x8B, 0x74, 0x24); mc_b1(c, 32) // RSI = db_ptr
        mc_b3(c, 0x4C, 0x89, 0xF0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC1)
        mc_b3(c, 0x48, 0x01, 0xC6)
        mc_b3(c, 0x4D, 0x89, 0xF5)

        lp_l2v := buf_len(c)
        mc_b3(c, 0x48, 0x89, 0xF1)       // RCX = db_row
        mc_b3(c, 0x48, 0x89, 0xFA)       // RDX = q_ptr
        mc_b4(c, 0x4A, 0x8D, 0x2C, 0x0A) // RBP = RDX + R9 (q_end)
        mc_b3(c, 0x0F, 0x57, 0xC0)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_l2sc := mc_jcc32(c, 0x84)
        mc_vex2(c, 0, 1, 0, 0x57, 0xC0)
        mc_vex2(c, 1, 1, 0, 0x57, 0xC9)
        mc_vex2(c, 2, 1, 0, 0x57, 0xD2)
        mc_vex2(c, 3, 1, 0, 0x57, 0xDB)
        mc_b3(c, 0x48, 0x89, 0xE8); mc_b2(c, 0x48, 0x2D); mc_u32(c, 128)
        lp_l2_32 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC2)
        ja_l2_8 := mc_jcc32(c, 0x87)
        mc_vex2(c, 0, 1, 0, 0x10, 0x21); mc_vex2(c, 4, 1, 0, 0x5C, 0x22)
        mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0xC4)
        mc_vex2(c, 0, 1, 0, 0x10, 0x69); mc_b1(c, 0x20); mc_vex2(c, 5, 1, 0, 0x5C, 0x6A); mc_b1(c, 0x20)
        mc_vex3(c, 0, 0, 0, 2, 0, 5, 1, 1, 0xB8); mc_b1(c, 0xCD)
        mc_vex2(c, 0, 1, 0, 0x10, 0x61); mc_b1(c, 0x40); mc_vex2(c, 4, 1, 0, 0x5C, 0x62); mc_b1(c, 0x40)
        mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0xD4)
        mc_vex2(c, 0, 1, 0, 0x10, 0x69); mc_b1(c, 0x60); mc_vex2(c, 5, 1, 0, 0x5C, 0x6A); mc_b1(c, 0x60)
        mc_vex3(c, 0, 0, 0, 2, 0, 5, 1, 1, 0xB8); mc_b1(c, 0xDD)
        mc_b3(c, 0x48, 0x81, 0xC1); mc_u32(c, 128)
        mc_b3(c, 0x48, 0x81, 0xC2); mc_u32(c, 128)
        jmp_l232 := mc_jmp32(c); mc_patch_rel32(c, jmp_l232, lp_l2_32)
        mc_patch_rel32(c, ja_l2_8, buf_len(c))
        mc_b4(c, 0x48, 0x8D, 0x45, 0xE0) // RAX = q_end - 32
        lp_l2_8 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC2)
        ja_l2red := mc_jcc8(c, 0x77)
        mc_vex2(c, 0, 1, 0, 0x10, 0x21); mc_vex2(c, 4, 1, 0, 0x5C, 0x22)
        mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0xC4)
        mc_b4(c, 0x48, 0x83, 0xC1, 32); mc_b4(c, 0x48, 0x83, 0xC2, 32)
        jmp_l28 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_l28, lp_l2_8)
        mc_patch_jcc8(c, ja_l2red, buf_len(c))
        mc_vex2(c, 0, 1, 0, 0x58, 0xC1); mc_vex2(c, 2, 1, 0, 0x58, 0xD3); mc_vex2(c, 0, 1, 0, 0x58, 0xC2)
        mc_avx_hsum_ymm0(c)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_patch_rel32(c, jz_l2sc, buf_len(c))
        lp_l2sc := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xEA)
        jae_l2st := mc_jcc8(c, 0x73)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x09); mc_b4(c, 0xF3, 0x0F, 0x5C, 0x0A)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xC9); mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b4(c, 0x48, 0x83, 0xC2, 4)
        jmp_l2s := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_l2s, lp_l2sc)
        mc_patch_jcc8(c, jae_l2st, buf_len(c))
        mc_b4(c, 0xF3, 0x0F, 0x11, 0x03)
        mc_b4(c, 0x48, 0x83, 0xC3, 4)
        mc_b3(c, 0x4C, 0x01, 0xCE)
        mc_b3(c, 0x49, 0xFF, 0xC5)
        mc_b3(c, 0x4D, 0x39, 0xFD)
        jl_l2v := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_l2v, lp_l2v)
        mc_patch_rel32(c, jge_l2e, buf_len(c))
        mc_ai_leave(c, 0x28)
        mc_ai_emit_batch_pub(cg, h_ai_l2_batch(), s_wk, 3, 4, 16384)
    }

    // 11. `h_ai_rmsnorm`: `RCX = args_ptr = [x, w, out, dim, eps_f64]`
    if cg_is_helper_used(cg, h_ai_rmsnorm()) {
        mc_align16(c)
        s_rm := buf_len(c)
        mc_ai_enter(c, 0x28)
        mc_b3(c, 0x49, 0x89, 0xCC)       // R12 = args_ptr
        mc_b4(c, 0x49, 0x8B, 0x4C, 0x24); mc_b1(c, 0)  // x
        mc_b4(c, 0x49, 0x8B, 0x54, 0x24); mc_b1(c, 8)  // w
        mc_b4(c, 0x49, 0x8B, 0x7C, 0x24); mc_b1(c, 16) // out
        mc_b4(c, 0x49, 0x8B, 0x5C, 0x24); mc_b1(c, 24) // RBX = dim
        mc_b3(c, 0x48, 0x85, 0xDB)
        jle_rme := mc_jcc32(c, 0x8E)

        mc_b4(c, 0x48, 0x8D, 0x2C, 0x99) // RBP = x + dim*4 (x_end)
        mc_b3(c, 0x48, 0x89, 0xCE)       // RSI = x_cur
        mc_b3(c, 0x0F, 0x57, 0xC0)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_rm_s1 := mc_jcc32(c, 0x84)
        mc_vex2(c, 0, 1, 0, 0x57, 0xC0); mc_vex2(c, 1, 1, 0, 0x57, 0xC9)
        mc_b3(c, 0x48, 0x89, 0xE8); mc_b4(c, 0x48, 0x83, 0xE8, 64)
        lp_rm16 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC6)
        ja_rm8 := mc_jcc8(c, 0x77)
        mc_vex2(c, 0, 1, 0, 0x10, 0x26); mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0xC4)
        mc_vex2(c, 0, 1, 0, 0x10, 0x6E); mc_b1(c, 32); mc_vex3(c, 0, 0, 0, 2, 0, 5, 1, 1, 0xB8); mc_b1(c, 0xCD)
        mc_b4(c, 0x48, 0x83, 0xC6, 64)
        jmp_rm16 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_rm16, lp_rm16)
        mc_patch_jcc8(c, ja_rm8, buf_len(c))
        mc_vex2(c, 0, 1, 0, 0x58, 0xC1)
        mc_b4(c, 0x48, 0x8D, 0x45, 0xE0)
        lp_rm8 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC6)
        ja_rmr := mc_jcc8(c, 0x77)
        mc_vex2(c, 0, 1, 0, 0x10, 0x26); mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0xC4)
        mc_b4(c, 0x48, 0x83, 0xC6, 32)
        jmp_rm8 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_rm8, lp_rm8)
        mc_patch_jcc8(c, ja_rmr, buf_len(c))
        mc_avx_hsum_ymm0(c)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_patch_rel32(c, jz_rm_s1, buf_len(c))
        lp_rm_s1 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xEE)
        jae_rm_inv := mc_jcc8(c, 0x73)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x0E); mc_b4(c, 0xF3, 0x0F, 0x59, 0xC9); mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1)
        mc_b4(c, 0x48, 0x83, 0xC6, 4)
        jmp_rm_s1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_rm_s1, lp_rm_s1)

        // Compute `inv_rms = (float)(1.0 / sqrt((double)ss / dim + eps_f64))`
        mc_patch_jcc8(c, jae_rm_inv, buf_len(c))
        mc_b4(c, 0xF3, 0x0F, 0x5A, 0xC0)             // CVTSS2SD XMM0, XMM0
        mc_b4(c, 0xF2, 0x48, 0x0F, 0x2A); mc_b1(c, 0xCB) // CVTSI2SD XMM1, RBX
        mc_b4(c, 0xF2, 0x0F, 0x5E, 0xC1)             // DIVSD XMM0, XMM1
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x44, 0x24); mc_b1(c, 32) // ADDSD XMM0, [R12+32]
        mc_b4(c, 0xF2, 0x0F, 0x51, 0xC0)             // SQRTSD XMM0, XMM0
        mc_b1(c, 0xB8); mc_u32(c, 1)
        mc_b4(c, 0xF2, 0x0F, 0x2A, 0xC8)             // CVTSI2SD XMM1, EAX
        mc_b4(c, 0xF2, 0x0F, 0x5E, 0xC8)             // DIVSD XMM1, XMM0
        mc_b4(c, 0xF2, 0x0F, 0x5A, 0xD1)             // CVTSD2SS XMM2, XMM1

        // Pass 2: `out[i] = x[i] * inv_rms * w[i]` (`RCX=x, RDX=w, RDI=out, RBP=x_end`)
        mc_b3(c, 0x48, 0x89, 0xCE)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_rm_s2 := mc_jcc32(c, 0x84)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b1(c, 0xD2) // VBROADCASTSS YMM2, XMM2
        mc_b4(c, 0x48, 0x8D, 0x45, 0xE0) // RAX = x_end - 32
        lp_rm2_8 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC1)
        ja_rm2_sc := mc_jcc8(c, 0x77)
        mc_vex2(c, 0, 1, 0, 0x10, 0x01) // VMOVUPS YMM0, [RCX]
        mc_vex2(c, 0, 1, 0, 0x59, 0xC2) // VMULPS YMM0, YMM0, YMM2
        mc_vex2(c, 0, 1, 0, 0x59, 0x02) // VMULPS YMM0, YMM0, [RDX]
        mc_vex2(c, 0, 1, 0, 0x11, 0x07) // VMOVUPS [RDI], YMM0
        mc_b4(c, 0x48, 0x83, 0xC1, 32); mc_b4(c, 0x48, 0x83, 0xC2, 32); mc_b4(c, 0x48, 0x83, 0xC7, 32)
        jmp_rm28 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_rm28, lp_rm2_8)
        mc_patch_jcc8(c, ja_rm2_sc, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_patch_rel32(c, jz_rm_s2, buf_len(c))
        lp_rm_s2 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xE9)
        jae_rme := mc_jcc8(c, 0x73)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x01); mc_b4(c, 0xF3, 0x0F, 0x59, 0xC2)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0x02); mc_b4(c, 0xF3, 0x0F, 0x11, 0x07)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b4(c, 0x48, 0x83, 0xC2, 4); mc_b4(c, 0x48, 0x83, 0xC7, 4)
        jmp_rm_s2 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_rm_s2, lp_rm_s2)
        mc_patch_jcc8(c, jae_rme, buf_len(c))
        mc_patch_rel32(c, jle_rme, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_ai_leave(c, 0x28)
        cg_reg_helper(cg, h_ai_rmsnorm(), s_rm, buf_len(c))
    }

    // 12. `h_ai_swiglu`: `RCX = args_ptr = [gate, up, out, dim]`
    if cg_is_helper_used(cg, h_ai_swiglu()) {
        mc_align16(c)
        s_sw := buf_len(c)
        mc_ai_enter(c, 0x48)
        // Store 12 f32/u32 constants at [RSP+0..44]
        mc_b4(c, 0xC7, 0x44, 0x24, 0);  mc_u32(c, 0xC2B00000) // -88.0
        mc_b4(c, 0xC7, 0x44, 0x24, 4);  mc_u32(c, 0x42B00000) // +88.0
        mc_b4(c, 0xC7, 0x44, 0x24, 8);  mc_u32(c, 0x3FB8AA3B) // LOG2E
        mc_b4(c, 0xC7, 0x44, 0x24, 12); mc_u32(c, 0x3F318000) // LN2_HI
        mc_b4(c, 0xC7, 0x44, 0x24, 16); mc_u32(c, 0xB95E8083) // LN2_LO
        mc_b4(c, 0xC7, 0x44, 0x24, 20); mc_u32(c, 0x3C088889) // c5
        mc_b4(c, 0xC7, 0x44, 0x24, 24); mc_u32(c, 0x3D2AAAAB) // c4
        mc_b4(c, 0xC7, 0x44, 0x24, 28); mc_u32(c, 0x3E2AAAAB) // c3
        mc_b4(c, 0xC7, 0x44, 0x24, 32); mc_u32(c, 0x3F000000) // c2
        mc_b4(c, 0xC7, 0x44, 0x24, 36); mc_u32(c, 0x3F800000) // 1.0
        mc_b4(c, 0xC7, 0x44, 0x24, 40); mc_u32(c, 127)        // 127
        mc_b4(c, 0xC7, 0x44, 0x24, 44); mc_u32(c, 0x80000000) // sign mask

        mc_b3(c, 0x48, 0x89, 0xCB)
        mc_b4(c, 0x48, 0x8B, 0x43, 24) // dim
        mc_b3(c, 0x48, 0x85, 0xC0)
        jle_swe := mc_jcc32(c, 0x8E)
        mc_b3(c, 0x48, 0x8B, 0x0B)       // RCX = gate
        mc_b4(c, 0x48, 0x8B, 0x53, 8)    // RDX = up
        mc_b4(c, 0x48, 0x8B, 0x7B, 16)   // RDI = out
        mc_b4(c, 0x48, 0x8D, 0x2C, 0x81) // RBP = gate + dim*4 (end)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_swsc := mc_jcc32(c, 0x84)

        mc_b4(c, 0x48, 0x8D, 0x45, 0xE0) // RAX = end - 32
        lp_sw8 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC1)
        ja_sw_tail := mc_jcc32(c, 0x87)
        mc_vex2(c, 0, 1, 0, 0x10, 0x21)                                   // VMOVUPS YMM4, [RCX] (gate)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 44) // VBROADCASTSS YMM3, [RSP+44]
        mc_vex2(c, 4, 1, 0, 0x57, 0xC3)                                   // VXORPS YMM0, YMM4, YMM3 (-gate)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 0)
        mc_vex2(c, 0, 1, 0, 0x5F, 0xC3)                                   // VMAXPS YMM0, YMM0, YMM3
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 4)
        mc_vex2(c, 0, 1, 0, 0x5D, 0xC3)                                   // VMINPS YMM0, YMM0, YMM3
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 8)
        mc_vex2(c, 0, 1, 0, 0x59, 0xCB)                                   // VMULPS YMM1, YMM0, YMM3
        mc_vex2(c, 0, 1, 1, 0x5B, 0xD1)                                   // VCVTPS2DQ YMM2, YMM1
        mc_vex2(c, 0, 1, 0, 0x5B, 0xCA)                                   // VCVTDQ2PS YMM1, YMM2
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 12)
        mc_vex3(c, 0, 0, 0, 2, 0, 1, 1, 1, 0xBC); mc_b1(c, 0xC3)          // VFNMADD231PS YMM0, YMM1, YMM3
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 16)
        mc_vex3(c, 0, 0, 0, 2, 0, 1, 1, 1, 0xBC); mc_b1(c, 0xC3)          // YMM0 = r
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x4C, 0x24, 20) // YMM1 = c5
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 24)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0xA8); mc_b1(c, 0xCB)          // VFMADD213PS YMM1, YMM0, YMM3
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 28)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0xA8); mc_b1(c, 0xCB)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 32)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0xA8); mc_b1(c, 0xCB)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 36)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0xA8); mc_b1(c, 0xCB)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0xA8); mc_b1(c, 0xCB)          // YMM1 = exp(r)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 40) // YMM3 = 127
        mc_vex2(c, 2, 1, 1, 0xFE, 0xD3)                                   // VPADDD YMM2, YMM2, YMM3
        mc_vex2(c, 2, 1, 1, 0x72, 0xF2); mc_b1(c, 23)                     // VPSLLD YMM2, YMM2, 23
        mc_vex2(c, 1, 1, 0, 0x59, 0xCA)                                   // VMULPS YMM1, YMM1, YMM2
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 36)
        mc_vex2(c, 1, 1, 0, 0x58, 0xCB)                                   // VADDPS YMM1, YMM1, YMM3 (1+exp)
        mc_vex2(c, 4, 1, 0, 0x59, 0x22)                                   // VMULPS YMM4, YMM4, [RDX]
        mc_vex2(c, 4, 1, 0, 0x5E, 0xC1)                                   // VDIVPS YMM0, YMM4, YMM1
        mc_vex2(c, 0, 1, 0, 0x11, 0x07)                                   // VMOVUPS [RDI], YMM0
        mc_b4(c, 0x48, 0x83, 0xC1, 32); mc_b4(c, 0x48, 0x83, 0xC2, 32); mc_b4(c, 0x48, 0x83, 0xC7, 32)
        jmp_sw8 := mc_jmp32(c); mc_patch_rel32(c, jmp_sw8, lp_sw8)
        mc_patch_rel32(c, ja_sw_tail, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)

        // Scalar SSE2 tail for SwiGLU (exact same polynomial using XMM0..XMM4!)
        mc_patch_rel32(c, jz_swsc, buf_len(c))
        lp_sws := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xE9)
        jae_swe := mc_jcc32(c, 0x83)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x21)                      // MOVSS XMM4, [RCX] (gate)
        mc_b3(c, 0x0F, 0x28, 0xC4)                            // MOVAPS XMM0, XMM4
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x5C); mc_b2(c, 0x24, 44) // MOVSS XMM3, [RSP+44]
        mc_b3(c, 0x0F, 0x57, 0xC3)                            // XORPS XMM0, XMM3 (-gate)
        mc_b4(c, 0xF3, 0x0F, 0x5F, 0x04); mc_b1(c, 0x24)      // MAXSS XMM0, [RSP+0]
        mc_b4(c, 0xF3, 0x0F, 0x5D, 0x44); mc_b2(c, 0x24, 4)   // MINSS XMM0, [RSP+4]
        mc_b3(c, 0x0F, 0x28, 0xC8)                            // MOVAPS XMM1, XMM0
        mc_b4(c, 0xF3, 0x0F, 0x59, 0x4C); mc_b2(c, 0x24, 8)   // MULSS XMM1, [RSP+8]
        mc_b4(c, 0xF3, 0x0F, 0x2D, 0xC1)                      // CVTSS2SI EAX, XMM1 (nearest)
        mc_b4(c, 0xF3, 0x0F, 0x2A, 0xC8)                      // CVTSI2SS XMM1, EAX
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x5C); mc_b2(c, 0x24, 12)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xD9); mc_b4(c, 0xF3, 0x0F, 0x5C, 0xC3) // z -= k*LN2_HI
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x5C); mc_b2(c, 0x24, 16)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xD9); mc_b4(c, 0xF3, 0x0F, 0x5C, 0xC3) // r = z - k*LN2_LO
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x4C); mc_b2(c, 0x24, 20)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xC8); mc_b4(c, 0xF3, 0x0F, 0x58, 0x4C); mc_b2(c, 0x24, 24)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xC8); mc_b4(c, 0xF3, 0x0F, 0x58, 0x4C); mc_b2(c, 0x24, 28)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xC8); mc_b4(c, 0xF3, 0x0F, 0x58, 0x4C); mc_b2(c, 0x24, 32)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xC8); mc_b4(c, 0xF3, 0x0F, 0x58, 0x4C); mc_b2(c, 0x24, 36)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xC8); mc_b4(c, 0xF3, 0x0F, 0x58, 0x4C); mc_b2(c, 0x24, 36)
        mc_b3(c, 0x83, 0xC0, 127); mc_b3(c, 0xC1, 0xE0, 23)
        mc_b4(c, 0x66, 0x0F, 0x6E, 0xD0)                      // MOVD XMM2, EAX
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xCA)                      // MULSS XMM1, XMM2
        mc_b4(c, 0xF3, 0x0F, 0x58, 0x4C); mc_b2(c, 0x24, 36)  // 1.0 + exp(-gate)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0x22)                      // MULSS XMM4, [RDX]
        mc_b4(c, 0xF3, 0x0F, 0x5E, 0xE1)                      // DIVSS XMM4, XMM1
        mc_b4(c, 0xF3, 0x0F, 0x11, 0x27)                      // MOVSS [RDI], XMM4
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b4(c, 0x48, 0x83, 0xC2, 4); mc_b4(c, 0x48, 0x83, 0xC7, 4)
        jmp_sws := mc_jmp32(c); mc_patch_rel32(c, jmp_sws, lp_sws)

        mc_patch_rel32(c, jae_swe, buf_len(c))
        mc_patch_rel32(c, jle_swe, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_ai_leave(c, 0x48)
        cg_reg_helper(cg, h_ai_swiglu(), s_sw, buf_len(c))
    }
}

fn emit_ai_runtime_helpers(cg: CodegenCtx) {
    emit_ai_ffi_pool_helpers(cg)
    emit_ai_gemv_gemm_helpers(cg)
    emit_ai_quant_helpers(cg)
    emit_ai_vec_norm_helpers(cg)
}

