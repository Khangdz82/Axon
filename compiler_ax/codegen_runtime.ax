                mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x34, 0x24)
                mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x7D, 0)
            } else {
