        j_p64_6_rem := mc_jmp32(c); mc_patch_rel32(c, j_p64_6_rem, lp_p64_6_rem)
        mc_patch_rel32(c, jle_p64_6_e, buf_len(c))
        mc_b4(c, 0x4C, 0x8B, 0x64, 0x24); mc_b1(c, 24)
        mc_vex2(c, 0, 1, 1, 0x11, 0x01); mc_vex2(c, 0, 1, 1, 0x11, 0x49); mc_b1(c, 0x20)
        mc_b3(c, 0x4C, 0x01, 0xE1)
        mc_vex2(c, 0, 1, 1, 0x11, 0x11); mc_vex2(c, 0, 1, 1, 0x11, 0x59); mc_b1(c, 0x20)
        mc_b3(c, 0x4C, 0x01, 0xE1)
        mc_vex2(c, 0, 1, 1, 0x11, 0x21); mc_vex2(c, 0, 1, 1, 0x11, 0x69); mc_b1(c, 0x20)
        mc_b3(c, 0x4C, 0x01, 0xE1)
        mc_vex2(c, 0, 1, 1, 0x11, 0x31); mc_vex2(c, 0, 1, 1, 0x11, 0x79); mc_b1(c, 0x20)
        mc_b3(c, 0x4C, 0x01, 0xE1)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b1(c, 0x01)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x49, 0x20)
        mc_b3(c, 0x4C, 0x01, 0xE1)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b1(c, 0x11)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x59, 0x20)
        mc_b4(c, 0x49, 0x83, 0xC5, 0x06)
        jmp_g64_i6 := mc_jmp32(c); mc_patch_rel32(c, jmp_g64_i6, lp_g64_i6)

