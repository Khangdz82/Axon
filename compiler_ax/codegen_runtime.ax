        mc_vex2(c, 0, 1, 1, 0x10, 0x00); mc_vex2(c, 0, 1, 1, 0x10, 0x48); mc_b1(c, 0x20)
        mc_b3(c, 0x4C, 0x01, 0xE0)
        mc_vex2(c, 0, 1, 1, 0x10, 0x10); mc_vex2(c, 0, 1, 1, 0x10, 0x58); mc_b1(c, 0x20)
        mc_b3(c, 0x4C, 0x01, 0xE0)
        mc_vex2(c, 0, 1, 1, 0x10, 0x20); mc_vex2(c, 0, 1, 1, 0x10, 0x68); mc_b1(c, 0x20)
        mc_b3(c, 0x4C, 0x01, 0xE0)
        mc_vex2(c, 0, 1, 1, 0x10, 0x30); mc_vex2(c, 0, 1, 1, 0x10, 0x78); mc_b1(c, 0x20)
        mc_patch_jcc8(c, jmp_c64_rdy, buf_len(c))

        mc_b4(c, 0x48, 0x8B, 0x5C, 0x24); mc_b1(c, 56)
        mc_b4(c, 0x48, 0x83, 0xFB, 2)
        jl_p64_4_1 := mc_jcc8(c, 0x7C)
        lp_p64_4_u2 := buf_len(c)
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x07) // VBROADCASTSD Y8, [RDI]
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x0E) // VBROADCASTSD Y9, [RSI]
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x10) // VBROADCASTSD Y10, [R8]
