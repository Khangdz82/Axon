        mc_b2(c, 0x81, 0xFA); mc_u32(c, 16000); jge_fw16r1 := mc_jcc32(c, 0x8D)
        mc_vex3(c, 0, 1, 1, 2, 0, 0, 1, 1, 0x79); mc_b2(c, 0x04, 0x5F)
        mc_b2(c, 0x31, 0xC9)
        lp_fw16r1 := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x0C, 0x4C)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x54, 0x4C, 32)
        mc_vex256(c, 1, 1, 1, 0, 0xFD); mc_vex256(c, 1, 2, 2, 0, 0xFD)
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 1, 1, 0xEA); mc_b2(c, 0x0C, 0x4F)
