        mc_vex3(c, 1, 0, 1, 1, 0, 0, 0, 1, 0x6E); mc_b1(c, 0xFE) // VMOVD X15, R14D
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x78); mc_b1(c, 0xFF) // VPBROADCASTB Y15, X15
        mc_b2(c, 0x31, 0xC9)
        lp_bnsub := buf_len(c)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x84, 0x0C); mc_u32(c, 160)
        mc_vex256(c, 1, 0, 0, 15, 0xF8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x84, 0x0C); mc_u32(c, 160)
        mc_b4(c, 0x48, 0x83, 0xC1, 32); mc_b3(c, 0x4C, 0x39, 0xD1)
        jl_bnsub := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_bnsub, lp_bnsub)
        mc_b2(c, 0x31, 0xC0) // RAX = 0
        lp_bn_dot := buf_len(c)
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 0, 1, 0x21); mc_b2(c, 0x84, 0x04); mc_u32(c, 160) // VPMOVSXBD X8, [RSP+RAX+160]
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 0, 1, 0x21); mc_b2(c, 0x94, 0x04); mc_u32(c, 164) // VPMOVSXBD X10, [RSP+RAX+164]
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0xE6); mc_b1(c, 0xC0)                       // VCVTDQ2PD Y8, X8
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0xE6); mc_b1(c, 0xD2)                       // VCVTDQ2PD Y10, X10
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b2(c, 0x0C, 0x81)                 // VCVTPS2PD Y9, [R9+RAX*4]
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b3(c, 0x5C, 0x81, 16)             // VCVTPS2PD Y11, [R9+RAX*4+16]
        mc_vex3(c, 1, 0, 1, 2, 1, 8, 1, 1, 0xB8); mc_b1(c, 0xF1)                       // VFMADD231PD Y14, Y8, Y9
        mc_vex3(c, 1, 0, 1, 2, 1, 10, 1, 1, 0xB8); mc_b1(c, 0xEB)                      // VFMADD231PD Y13, Y10, Y11
        mc_b4(c, 0x48, 0x83, 0xC0, 8); mc_b3(c, 0x4C, 0x39, 0xD0)
        jl_bnd := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_bnd, lp_bn_dot)
        mc_b3(c, 0x4D, 0x01, 0xF3) // R11 += br
        j_bnb := mc_jmp32(c); mc_patch_rel32(c, j_bnb, lp_bn_blk)
        mc_patch_rel32(c, jge_bnb_dn, buf_len(c))
        mc_vex256(c, 1, 14, 14, 13, 0x58)                               // VADDPD Y14, Y14, Y13
        mc_vex3(c, 1, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xF0, 1)     // VEXTRACTF128 X0, Y14, 1
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 1, 0x58); mc_b1(c, 0xC6)        // VADDPD X0, X0, X14
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x15); mc_b1(c, 0xC8)        // VUNPCKHPD X1, X0, X0
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b1(c, 0xC1)        // VADDSD X0, X0, X1
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_bn_blk_end := mc_jmp32(c)

        mc_patch_rel32(c, jle_bn_fb, buf_len(c))
        mc_patch_rel32(c, jg_bn_fb2, buf_len(c))
        mc_patch_rel32(c, jnz_bn_fb, buf_len(c))
