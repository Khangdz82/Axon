        mc_vex3(c, 0, 0, 1, 1, 0, 2, 1, 1, 0xEA); mc_b3(c, 0x54, 0x4E, 32)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x0C, 0x4E)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b3(c, 0x54, 0x4E, 32)
        mc_b4(c, 0x48, 0x83, 0xC1, 32); mc_b3(c, 0x4C, 0x39, 0xC9)
