        mc_b3(c, 0x48, 0x85, 0xC9); jz_cgrs_m1 := mc_jcc8(c, 0x74)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b3(c, 0x54, 0xCA, 0xF8)
        mc_patch_jcc8(c, jz_cgrs_m1, buf_len(c))
        mc_b3(c, 0x48, 0x39, 0xD1); jge_cgrs_p1b := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b3(c, 0x54, 0xCA, 8)
        mc_patch_jcc8(c, jge_cgrs_p1b, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xF9, 64); jl_cgrs_m64 := mc_jcc8(c, 0x7C)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x9C, 0xCA); mc_u32(c, 0xFFFFFE00)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xD9); mc_b4(c, 0xF2, 0x0F, 0x5C, 0xD3)
        mc_patch_jcc8(c, jl_cgrs_m64, buf_len(c))
        mc_b3(c, 0x48, 0x39, 0xF1); jge_cgrs_p64 := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x9C, 0xCA); mc_u32(c, 512)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xD9); mc_b4(c, 0xF2, 0x0F, 0x5C, 0xD3)
        mc_patch_jcc8(c, jge_cgrs_p64, buf_len(c))
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x14, 0xCB)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xCA); mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_cgrsp1 := mc_jmp32(c); mc_patch_rel32(c, j_cgrsp1, lp_cgrs_p1)
        mc_patch_rel32(c, jge_cgrs_p1d, buf_len(c))
        jmp_cgr_ret3 := mc_jmp32(c)
        mc_patch_rel32(c, je_cgrs_p2, buf_len(c))
        mc_b4(c, 0xF2, 0x47, 0x0F, 0x10); mc_b2(c, 0x14, 0xEB) // X10 = alpha
        lp_cgrs_p2 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xF9); jge_cgrs_p2d := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xCA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xCA)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x0C, 0xC8); mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x0C, 0xC8)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x14, 0xCB); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xD2)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xC9); mc_b4(c, 0xF2, 0x0F, 0x5C, 0xCA)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x0C, 0xC9); mc_b4(c, 0xF2, 0x0F, 0x59, 0xC9); mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_cgrsp2 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cgrsp2, lp_cgrs_p2)
        mc_patch_jcc8(c, jge_cgrs_p2d, buf_len(c))
        jmp_cgr_ret4 := mc_jmp32(c)
        mc_patch_rel32(c, jg_cgrs_p3, buf_len(c))
        mc_b4(c, 0xF2, 0x47, 0x0F, 0x10); mc_b3(c, 0x54, 0xEB, 8) // X10 = beta
        lp_cgrs_p3 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xF9); jge_cgrs_p3d := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xCA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xCA)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x0C, 0xC9); mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x0C, 0xCA)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_cgrsp3 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cgrsp3, lp_cgrs_p3)
        mc_patch_jcc8(c, jge_cgrs_p3d, buf_len(c))
        jmp_cgr_ret5 := mc_jmp32(c)

        mc_patch_rel32(c, jz_cg_full, buf_len(c))

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_cg_sc := mc_jcc32(c, 0x84)
        mc_b3(c, 0x49, 0x81, 0xFD); mc_u32(c, 256); jl_cg_sc2 := mc_jcc32(c, 0x8C)
        mc_b4(c, 0x41, 0xF6, 0xC5, 3); jnz_cg_sc3 := mc_jcc32(c, 0x85)

        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0x24)     // Y8  = 6.0
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x4C, 0x24, 32) // Y9  = 0.5
        mc_vex256(c, 1, 6, 6, 6, 0x57)
        mc_b2(c, 0x31, 0xC9)
        lp_cg_r0 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE9); jge_cg_r0 := mc_jcc8(c, 0x7D)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xC9)
        mc_vex256(c, 1, 0, 0, 0, 0x59); mc_vex256(c, 1, 6, 6, 0, 0x58)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); j_cgr0 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cgr0, lp_cg_r0)
        mc_patch_jcc8(c, jge_cg_r0, buf_len(c))
        _mc_vhsum_pd_to_xmm0(c, 6); mc_vex3(c, 1, 0, 0, 1, 0, 0, 0, 3, 0x10); mc_b1(c, 0xF0) // X14 = rsold

        mc_b3(c, 0x45, 0x31, 0xFF) // R15 = it = 0
        lp_cg_it := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xF7); jge_cg_dn := mc_jcc32(c, 0x8D)
        mc_vex256(c, 1, 6, 6, 6, 0x57)
        mc_b4(c, 0x66, 0x45, 0x0F, 0x57); mc_b1(c, 0xDB) // X11 = pap_scalar = 0
        // Boundary i = 0 .. 63
        mc_b2(c, 0x31, 0xC9)
        lp_cg_b0 := buf_len(c)
        mc_b4(c, 0x48, 0x83, 0xF9, 64); jge_cg_b0 := mc_jcc8(c, 0x7D)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x04, 0xCA)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC8)
        mc_b3(c, 0x48, 0x85, 0xC9); jz_cg_z0 := mc_jcc8(c, 0x74)
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 0, 3, 0x5C); mc_b3(c, 0x4C, 0xCA, 0xF8)
        mc_patch_jcc8(c, jz_cg_z0, buf_len(c))
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 0, 3, 0x5C); mc_b3(c, 0x4C, 0xCA, 8)
        mc_vex3(c, 0, 0, 1, 1, 0, 9, 0, 3, 0x59); mc_b2(c, 0x94, 0xCA); mc_u32(c, 512)
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 0, 3, 0x5C); mc_b1(c, 0xCA)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x0C, 0xCB)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC1)
        mc_vex3(c, 1, 0, 0, 1, 0, 11, 0, 3, 0x58); mc_b1(c, 0xD8)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_cgb0 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cgb0, lp_cg_b0)
        mc_patch_jcc8(c, jge_cg_b0, buf_len(c))

        // Interior i = 64 .. n - 64 (8-wide 2x4 AVX2+FMA3 with dual acc Y6/Y7!)
        mc_vex256(c, 1, 7, 7, 7, 0x57)
        mc_b4(c, 0x49, 0x8D, 0x75, 0xBC) // RSI = n - 68
        mc_align16_nop(c)
        lp_cg_in8 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xF1); jg_cg_in4 := mc_jcc32(c, 0x8F)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xCA)                       // Y0 = p[i]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x5C, 0xCA, 32)                   // Y3 = p[i+4]
        mc_vex256(c, 1, 1, 0, 8, 0x59); mc_vex256(c, 1, 4, 3, 8, 0x59)                       // Y1=6*p[i], Y4=6*p[i+4]
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 1, 1, 0x5C); mc_b3(c, 0x4C, 0xCA, 0xF8)                 // Y1 -= p[i-1]
        mc_vex3(c, 0, 0, 1, 1, 0, 4, 1, 1, 0x5C); mc_b3(c, 0x64, 0xCA, 24)                   // Y4 -= p[i+3]
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 1, 1, 0x5C); mc_b3(c, 0x4C, 0xCA, 8)                    // Y1 -= p[i+1]
        mc_vex3(c, 0, 0, 1, 1, 0, 4, 1, 1, 0x5C); mc_b3(c, 0x64, 0xCA, 40)                   // Y4 -= p[i+5]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x94, 0xCA); mc_u32(c, 0xFFFFFE00)// Y2 = p[i-64]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0xAC, 0xCA); mc_u32(c, 0xFFFFFE20)// Y5 = p[i-60]
        mc_vex3(c, 0, 0, 1, 1, 0, 2, 1, 1, 0x58); mc_b2(c, 0x94, 0xCA); mc_u32(c, 512)       // Y2 += p[i+64]
        mc_vex3(c, 0, 0, 1, 1, 0, 5, 1, 1, 0x58); mc_b2(c, 0xAC, 0xCA); mc_u32(c, 544)       // Y5 += p[i+68]
        mc_vex3(c, 0, 0, 0, 2, 1, 9, 1, 1, 0xBC); mc_b1(c, 0xCA)                             // VFNMADD231PD Y1, Y9, Y2
        mc_vex3(c, 0, 0, 0, 2, 1, 9, 1, 1, 0xBC); mc_b1(c, 0xE5)                             // VFNMADD231PD Y4, Y9, Y5
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x0C, 0xCB)                       // ap[i] = Y1
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b3(c, 0x64, 0xCB, 32)                   // ap[i+4] = Y4
        mc_vex3(c, 0, 0, 0, 2, 1, 0, 1, 1, 0xB8); mc_b1(c, 0xF1)                             // VFMADD231PD Y6, Y0, Y1
        mc_vex3(c, 0, 0, 0, 2, 1, 3, 1, 1, 0xB8); mc_b1(c, 0xFC)                             // VFMADD231PD Y7, Y3, Y4
        mc_b4(c, 0x48, 0x83, 0xC1, 8)
        j_cgin8 := mc_jmp32(c); mc_patch_rel32(c, j_cgin8, lp_cg_in8)
        mc_patch_rel32(c, jg_cg_in4, buf_len(c))
        mc_vex256(c, 1, 6, 6, 7, 0x58)
        mc_b4(c, 0x49, 0x8D, 0x75, 0xC0)
        lp_cg_in := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xF1); jge_cg_in := mc_jcc8(c, 0x7D)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xCA)
        mc_vex256(c, 1, 1, 0, 8, 0x59)
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 1, 1, 0x5C); mc_b3(c, 0x4C, 0xCA, 0xF8)
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 1, 1, 0x5C); mc_b3(c, 0x4C, 0xCA, 8)
        mc_vex3(c, 0, 0, 1, 1, 0, 9, 1, 1, 0x59); mc_b2(c, 0x94, 0xCA); mc_u32(c, 0xFFFFFE00)
        mc_vex256(c, 1, 1, 1, 2, 0x5C)
        mc_vex3(c, 0, 0, 1, 1, 0, 9, 1, 1, 0x59); mc_b2(c, 0x94, 0xCA); mc_u32(c, 512)
        mc_vex256(c, 1, 1, 1, 2, 0x5C)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x0C, 0xCB)
        mc_vex256(c, 1, 0, 0, 1, 0x59); mc_vex256(c, 1, 6, 6, 0, 0x58)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); j_cgin := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cgin, lp_cg_in)
        mc_patch_jcc8(c, jge_cg_in, buf_len(c))

        // Boundary i = n - 64 .. n - 1
        mc_b4(c, 0x49, 0x8D, 0x55, 0xFF) // RDX = n - 1
        lp_cg_b1 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE9); jge_cg_b1 := mc_jcc8(c, 0x7D)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x04, 0xCA)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC8)
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 0, 3, 0x5C); mc_b3(c, 0x4C, 0xCA, 0xF8)
        mc_b3(c, 0x48, 0x39, 0xD1); jge_cg_e1 := mc_jcc8(c, 0x7D)
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 0, 3, 0x5C); mc_b3(c, 0x4C, 0xCA, 8)
        mc_patch_jcc8(c, jge_cg_e1, buf_len(c))
        mc_vex3(c, 0, 0, 1, 1, 0, 9, 0, 3, 0x59); mc_b2(c, 0x94, 0xCA); mc_u32(c, 0xFFFFFE00)
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 0, 3, 0x5C); mc_b1(c, 0xCA)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x0C, 0xCB)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC1)
        mc_vex3(c, 1, 0, 0, 1, 0, 11, 0, 3, 0x58); mc_b1(c, 0xD8)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_cgb1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cgb1, lp_cg_b1)
        mc_patch_jcc8(c, jge_cg_b1, buf_len(c))

        // pap = hsum(Y6) + X11; alpha = rsold / pap -> bcast Y10
        _mc_vhsum_pd_to_xmm0(c, 6)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x58); mc_b1(c, 0xC3) // X0 = pap
        mc_vex3(c, 0, 0, 0, 1, 0, 14, 0, 3, 0x5E); mc_b1(c, 0xC0) // X0 = rsold / pap = alpha
        mc_vex256(c, 2, 10, 0, 0, 0x19) // Y10 = bcast(alpha)

        // Pass 2: x += alpha*p; r -= alpha*ap; rsnew = dot(r, r)
        mc_vex256(c, 1, 6, 6, 6, 0x57)
        mc_b2(c, 0x31, 0xC9)
        mc_align16_nop(c)
        lp_cg_p2 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE9); jge_cg_p2 := mc_jcc8(c, 0x7D)
        mc_vex3(c, 0, 0, 1, 1, 0, 10, 1, 1, 0x59); mc_b2(c, 0x04, 0xCA)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x58); mc_b2(c, 0x04, 0xC8)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x04, 0xC8)
        mc_vex3(c, 0, 0, 1, 1, 0, 10, 1, 1, 0x59); mc_b2(c, 0x0C, 0xCB)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x14, 0xC9)
        mc_vex256(c, 1, 2, 2, 1, 0x5C)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x14, 0xC9)
        mc_vex256(c, 1, 2, 2, 2, 0x59); mc_vex256(c, 1, 6, 6, 2, 0x58)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); j_cgp2 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cgp2, lp_cg_p2)
        mc_patch_jcc8(c, jge_cg_p2, buf_len(c))

        // beta = rsnew / rsold -> bcast Y10; rsold = rsnew
        _mc_vhsum_pd_to_xmm0(c, 6)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x5E); mc_b1(c, 0xCE) // X1 = rsnew / rsold
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 0, 3, 0x10); mc_b1(c, 0xF0) // X14 = rsnew
        mc_vex256(c, 2, 10, 0, 1, 0x19) // Y10 = bcast(beta)

        // Pass 3: p[i] = r[i] + beta * p[i]
        mc_b2(c, 0x31, 0xC9)
        mc_align16_nop(c)
        lp_cg_p3 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE9); jge_cg_p3 := mc_jcc8(c, 0x7D)
        mc_vex3(c, 0, 0, 1, 1, 0, 10, 1, 1, 0x59); mc_b2(c, 0x04, 0xCA)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x58); mc_b2(c, 0x04, 0xC9)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x04, 0xCA)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); j_cgp3 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cgp3, lp_cg_p3)
        mc_patch_jcc8(c, jge_cg_p3, buf_len(c))

        mc_b3(c, 0x49, 0xFF, 0xC7); j_cgit := mc_jmp32(c); mc_patch_rel32(c, j_cgit, lp_cg_it)

        mc_patch_rel32(c, jge_cg_dn, buf_len(c))
        mc_vex256(c, 1, 6, 6, 6, 0x57); mc_b2(c, 0x31, 0xC9)
        lp_cg_sx := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE9); jge_cg_sx := mc_jcc8(c, 0x7D)
        mc_vex3(c, 0, 0, 1, 1, 0, 6, 1, 1, 0x58); mc_b2(c, 0x34, 0xC8)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); j_cgsx := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cgsx, lp_cg_sx)
        mc_patch_jcc8(c, jge_cg_sx, buf_len(c))
        _mc_vhsum_pd_to_xmm0(c, 6)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_cg_end := mc_jmp32(c)

        // Scalar fallback (--simd=scalar)
        mc_patch_rel32(c, jz_cg_sc, buf_len(c))
        mc_patch_rel32(c, jl_cg_sc2, buf_len(c))
        mc_patch_rel32(c, jnz_cg_sc3, buf_len(c))
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x04, 0x24)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b3(c, 0x4C, 0x24, 32)
        mc_b4(c, 0x66, 0x45, 0x0F, 0x57); mc_b1(c, 0xF6)
        mc_b2(c, 0x31, 0xC9)
        lp_cgs_r0 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE9); jge_cgs_r0 := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x04, 0xC9)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xC0); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xF0)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_cgsr0 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cgsr0, lp_cgs_r0)
        mc_patch_jcc8(c, jge_cgs_r0, buf_len(c))

        mc_b3(c, 0x45, 0x31, 0xFF)
        lp_cgs_it := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xF7); jge_cgs_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x66, 0x45, 0x0F, 0x57); mc_b1(c, 0xDB)
        mc_b2(c, 0x31, 0xC9)
        mc_b4(c, 0x49, 0x8D, 0x55, 0xFF)
        mc_b4(c, 0x49, 0x8D, 0x75, 0xC0)
        lp_cgs_p1 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE9); jge_cgs_p1 := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x04, 0xCA)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xC8); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xC8)
        mc_b3(c, 0x48, 0x85, 0xC9); jz_s_m1 := mc_jcc8(c, 0x74)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b3(c, 0x4C, 0xCA, 0xF8)
        mc_patch_jcc8(c, jz_s_m1, buf_len(c))
        mc_b3(c, 0x48, 0x39, 0xD1); jge_s_p1 := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b3(c, 0x4C, 0xCA, 8)
        mc_patch_jcc8(c, jge_s_p1, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xF9, 64); jl_s_m64 := mc_jcc8(c, 0x7C)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x94, 0xCA); mc_u32(c, 0xFFFFFE00)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xD1); mc_b4(c, 0xF2, 0x0F, 0x5C, 0xCA)
        mc_patch_jcc8(c, jl_s_m64, buf_len(c))
        mc_b3(c, 0x48, 0x39, 0xF1); jge_s_p64 := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x94, 0xCA); mc_u32(c, 512)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xD1); mc_b4(c, 0xF2, 0x0F, 0x5C, 0xCA)
        mc_patch_jcc8(c, jge_s_p64, buf_len(c))
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x0C, 0xCB)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xC1); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xD8)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_cgsp1 := mc_jmp32(c); mc_patch_rel32(c, j_cgsp1, lp_cgs_p1)
        mc_patch_rel32(c, jge_cgs_p1, buf_len(c))

        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b1(c, 0xD6); mc_b4(c, 0xF2, 0x45, 0x0F, 0x5E); mc_b1(c, 0xD3)
        mc_b4(c, 0x66, 0x45, 0x0F, 0x57); mc_b1(c, 0xE4)
        mc_b2(c, 0x31, 0xC9)
        lp_cgs_p2 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE9); jge_cgs_p2 := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x04, 0xCA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xC2)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x04, 0xC8); mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x04, 0xC8)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xCB); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xCA)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x14, 0xC9); mc_b4(c, 0xF2, 0x0F, 0x5C, 0xD1)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x14, 0xC9)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xD2); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xE2)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_cgsp2 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cgsp2, lp_cgs_p2)
        mc_patch_jcc8(c, jge_cgs_p2, buf_len(c))

        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b1(c, 0xD4); mc_b4(c, 0xF2, 0x45, 0x0F, 0x5E); mc_b1(c, 0xD6)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b1(c, 0xF4)
        mc_b2(c, 0x31, 0xC9)
        lp_cgs_p3 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE9); jge_cgs_p3 := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x04, 0xCA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xC2)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x04, 0xC9); mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x04, 0xCA)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_cgsp3 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cgsp3, lp_cgs_p3)
        mc_patch_jcc8(c, jge_cgs_p3, buf_len(c))

        mc_b3(c, 0x49, 0xFF, 0xC7); j_cgsit := mc_jmp32(c); mc_patch_rel32(c, j_cgsit, lp_cgs_it)
        mc_patch_rel32(c, jge_cgs_dn, buf_len(c))
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0); mc_b2(c, 0x31, 0xC9)
        lp_cgs_sx := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE9); jge_cgs_sx := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x04, 0xC8)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_cgssx := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cgssx, lp_cgs_sx)
        mc_patch_jcc8(c, jge_cgs_sx, buf_len(c))

        mc_patch_rel32(c, jmp_cgr_ret0, buf_len(c))
        mc_patch_rel32(c, jmp_cgr_ret1, buf_len(c))
        mc_patch_rel32(c, jmp_cgr_ret2, buf_len(c))
        mc_patch_rel32(c, jmp_cgr_ret3, buf_len(c))
        mc_patch_rel32(c, jmp_cgr_ret4, buf_len(c))
        mc_patch_rel32(c, jmp_cgr_ret5, buf_len(c))
        mc_patch_rel32(c, jmp_cg_end, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xD8)
        cg_reg_helper(cg, h_ai_cg_sparse_f64(), s_cgs, buf_len(c))
    }

    // 63. `h_ai_crc32_combine(out_ptr, nt, chunk) -> i64`:
    //     Zero-spill native GF(2) 32x32 shift-matrix binary exponentiation + chunk combine (~2us vs 155us)!
    if cg_is_helper_used(cg, h_ai_crc32_combine()) {
        mc_align16(c)
        s_ccmb := buf_len(c)
        mc_ai_enter(c, 0x228)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = out_ptr
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = nt
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = chunk
        mc_b3(c, 0x45, 0x8B, 0x38)       // R15D = crc = out[0]
        mc_b4(c, 0x49, 0x83, 0xF9, 1); jle_cc_dn := mc_jcc32(c, 0x8E)

        mc_b3(c, 0xC7, 0x04, 0x24); mc_u32(c, 0xEDB88320) // odd[0] = 0xEDB88320
        mc_b1(c, 0xB8); mc_u32(c, 1) // EAX = 1
        mc_b2(c, 0x31, 0xC9)         // RCX = 0
        lp_cc_in := buf_len(c)
        mc_b3(c, 0x89, 0x84, 0x8C); mc_u32(c, 256) // smat[n] = 1<<n
        mc_b4(c, 0x48, 0x83, 0xF9, 31); jge_cc_in := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x89, 0x44, 0x8C, 4)              // odd[n+1] = 1<<n
        mc_b2(c, 0xD1, 0xE0)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_ccin := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_ccin, lp_cc_in)
        mc_patch_jcc8(c, jge_cc_in, buf_len(c))

        // Two initial squarings: even = odd^2; odd = even^2
        mc_b2(c, 0x31, 0xED) // RBP = 0, 1
        lp_cc_pre := buf_len(c)
        mc_b3(c, 0x48, 0x89, 0xE7)
        mc_b4(c, 0x48, 0x8D, 0xB4, 0x24); mc_u32(c, 128)
        mc_b3(c, 0x48, 0x85, 0xED); jz_cc_p0 := mc_jcc8(c, 0x74)
        mc_b3(c, 0x48, 0x87, 0xFE)
        mc_patch_jcc8(c, jz_cc_p0, buf_len(c))
        mc_b2(c, 0x31, 0xC9)
        lp_cc_sqi := buf_len(c)
        mc_b3(c, 0x8B, 0x14, 0x8F)
        mc_b2(c, 0x31, 0xC0); mc_b2(c, 0x31, 0xDB)
        lp_cc_sqb := buf_len(c)
        mc_b2(c, 0x85, 0xD2); jz_cc_sqd := mc_jcc8(c, 0x74)
        mc_b2(c, 0xF6, 0xC2); mc_b1(c, 1); jz_cc_sq0 := mc_jcc8(c, 0x74)
        mc_b3(c, 0x33, 0x04, 0x9F)
        mc_patch_jcc8(c, jz_cc_sq0, buf_len(c))
        mc_b2(c, 0xD1, 0xEA); mc_b3(c, 0x48, 0xFF, 0xC3)
        j_ccsqb := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_ccsqb, lp_cc_sqb)
        mc_patch_jcc8(c, jz_cc_sqd, buf_len(c))
        mc_b3(c, 0x89, 0x04, 0x8E)
        mc_b3(c, 0x48, 0xFF, 0xC1); mc_b4(c, 0x48, 0x83, 0xF9, 32)
        jl_cc_sqi := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_cc_sqi, lp_cc_sqi)
        mc_b3(c, 0x48, 0xFF, 0xC5); mc_b4(c, 0x48, 0x83, 0xFD, 2)
        jl_cc_pre := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_cc_pre, lp_cc_pre)

        // Binary exponentiation over R10 = chunk
        mc_b3(c, 0x49, 0x89, 0xE4)                       // R12 = odd (RSP)
        mc_b4(c, 0x4C, 0x8D, 0xAC, 0x24); mc_u32(c, 128) // R13 = even (RSP+128)
        lp_cc_pow := buf_len(c)
        mc_b3(c, 0x4D, 0x85, 0xD2); jz_cc_powd := mc_jcc32(c, 0x84)
        mc_b3(c, 0x4C, 0x89, 0xE7); mc_b3(c, 0x4C, 0x89, 0xEE)
        mc_b2(c, 0x31, 0xC9)
        lp_cc_psqi := buf_len(c)
        mc_b3(c, 0x8B, 0x14, 0x8F); mc_b2(c, 0x31, 0xC0); mc_b2(c, 0x31, 0xDB)
        lp_cc_psqb := buf_len(c)
        mc_b2(c, 0x85, 0xD2); jz_cc_psqd := mc_jcc8(c, 0x74)
        mc_b2(c, 0xF6, 0xC2); mc_b1(c, 1); jz_cc_psq0 := mc_jcc8(c, 0x74)
        mc_b3(c, 0x33, 0x04, 0x9F)
        mc_patch_jcc8(c, jz_cc_psq0, buf_len(c))
        mc_b2(c, 0xD1, 0xEA); mc_b3(c, 0x48, 0xFF, 0xC3)
        j_ccpsqb := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_ccpsqb, lp_cc_psqb)
        mc_patch_jcc8(c, jz_cc_psqd, buf_len(c))
        mc_b3(c, 0x89, 0x04, 0x8E)
        mc_b3(c, 0x48, 0xFF, 0xC1); mc_b4(c, 0x48, 0x83, 0xF9, 32)
        jl_cc_psqi := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_cc_psqi, lp_cc_psqi)
        mc_b3(c, 0x4D, 0x87, 0xE5) // swap R12, R13
        mc_b4(c, 0x41, 0xF6, 0xC2, 1); jz_cc_nb := mc_jcc32(c, 0x84)
        mc_b3(c, 0x4C, 0x89, 0xE7)
        mc_b4(c, 0x4C, 0x8D, 0x9C, 0x24); mc_u32(c, 256)
        mc_b4(c, 0x48, 0x8D, 0xB4, 0x24); mc_u32(c, 384)
        mc_b2(c, 0x31, 0xC9)
        lp_cc_mi := buf_len(c)
        mc_b4(c, 0x41, 0x8B, 0x14, 0x8B)
        mc_b2(c, 0x31, 0xC0); mc_b2(c, 0x31, 0xDB)
        lp_cc_mb := buf_len(c)
        mc_b2(c, 0x85, 0xD2); jz_cc_md := mc_jcc8(c, 0x74)
        mc_b2(c, 0xF6, 0xC2); mc_b1(c, 1); jz_cc_m0 := mc_jcc8(c, 0x74)
        mc_b3(c, 0x33, 0x04, 0x9F)
        mc_patch_jcc8(c, jz_cc_m0, buf_len(c))
        mc_b2(c, 0xD1, 0xEA); mc_b3(c, 0x48, 0xFF, 0xC3)
        j_ccmb := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_ccmb, lp_cc_mb)
        mc_patch_jcc8(c, jz_cc_md, buf_len(c))
        mc_b3(c, 0x89, 0x04, 0x8E)
        mc_b3(c, 0x48, 0xFF, 0xC1); mc_b4(c, 0x48, 0x83, 0xF9, 32)
        jl_cc_mi := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_cc_mi, lp_cc_mi)
        mc_b2(c, 0x31, 0xC9)
        lp_cc_cp := buf_len(c)
        mc_b4(c, 0x48, 0x8B, 0x04, 0xCE); mc_b4(c, 0x49, 0x89, 0x04, 0xCB)
        mc_b3(c, 0x48, 0xFF, 0xC1); mc_b4(c, 0x48, 0x83, 0xF9, 16)
        jl_cc_cp := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_cc_cp, lp_cc_cp)
        mc_patch_rel32(c, jz_cc_nb, buf_len(c))
        mc_b3(c, 0x49, 0xD1, 0xEA); j_ccpow := mc_jmp32(c); mc_patch_rel32(c, j_ccpow, lp_cc_pow)

        mc_patch_rel32(c, jz_cc_powd, buf_len(c))
        mc_b4(c, 0x48, 0x8D, 0xBC, 0x24); mc_u32(c, 256)
        mc_b1(c, 0xB9); mc_u32(c, 1)
        lp_cc_cb := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xC9); jge_cc_cb := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x44, 0x89, 0xFA)
        mc_b2(c, 0x31, 0xC0); mc_b2(c, 0x31, 0xDB)
        lp_cc_cv := buf_len(c)
        mc_b2(c, 0x85, 0xD2); jz_cc_cvd := mc_jcc8(c, 0x74)
        mc_b2(c, 0xF6, 0xC2); mc_b1(c, 1); jz_cc_cv0 := mc_jcc8(c, 0x74)
        mc_b3(c, 0x33, 0x04, 0x9F)
        mc_patch_jcc8(c, jz_cc_cv0, buf_len(c))
        mc_b2(c, 0xD1, 0xEA); mc_b3(c, 0x48, 0xFF, 0xC3)
        j_cccv := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cccv, lp_cc_cv)
        mc_patch_jcc8(c, jz_cc_cvd, buf_len(c))
        mc_b4(c, 0x41, 0x33, 0x04, 0xC8) // EAX ^= (u32)out[t] (stride 8)
        mc_b3(c, 0x41, 0x89, 0xC7)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_cccb := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cccb, lp_cc_cb)
        mc_patch_jcc8(c, jge_cc_cb, buf_len(c))

        mc_patch_rel32(c, jle_cc_dn, buf_len(c))
        mc_b3(c, 0x44, 0x89, 0xF8) // MOV EAX, R15D
        mc_ai_leave(c, 0x228)
        cg_reg_helper(cg, h_ai_crc32_combine(), s_ccmb, buf_len(c))
    }

    // 64. `h_ai_sum_f32(p, n) -> f64`: 16-wide AVX2 f32 -> exact f64 reduction!
    if cg_is_helper_used(cg, h_ai_sum_f32()) {
        mc_align16(c)
        s_sf32 := buf_len(c)
        mc_ai_enter(c, 0x28)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = p
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = n
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) // X0 = 0.0
        mc_b2(c, 0x31, 0xC9)             // RCX = i = 0
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_sf_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x49, 0x83, 0xF9, 16); jl_sf_sc2 := mc_jcc32(c, 0x8C)
        mc_vex256(c, 1, 0, 0, 0, 0x57); mc_vex256(c, 1, 1, 1, 1, 0x57)
        mc_vex256(c, 1, 2, 2, 2, 0x57); mc_vex256(c, 1, 3, 3, 3, 0x57)
        mc_b4(c, 0x4D, 0x8D, 0x51, 0xF0) // R10 = n - 16
        mc_align16_nop(c)
        lp_sf16 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jg_sf_tl := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b2(c, 0x24, 0x88)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b3(c, 0x6C, 0x88, 16)
        mc_vex256(c, 1, 0, 0, 4, 0x58); mc_vex256(c, 1, 1, 1, 5, 0x58)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b3(c, 0x64, 0x88, 32)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b3(c, 0x6C, 0x88, 48)
        mc_vex256(c, 1, 2, 2, 4, 0x58); mc_vex256(c, 1, 3, 3, 5, 0x58)
        mc_b4(c, 0x48, 0x83, 0xC1, 16); j_sf16 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_sf16, lp_sf16)
        mc_patch_jcc8(c, jg_sf_tl, buf_len(c))
        mc_vex256(c, 1, 0, 0, 1, 0x58); mc_vex256(c, 1, 2, 2, 3, 0x58); mc_vex256(c, 1, 0, 0, 2, 0x58)
        _mc_vhsum_pd_to_xmm0(c, 0)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_patch_rel32(c, jz_sf_sc, buf_len(c))
        mc_patch_rel32(c, jl_sf_sc2, buf_len(c))
        lp_sfs := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xC9); jge_sfs := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x5A); mc_b2(c, 0x0C, 0x88)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_sfs := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_sfs, lp_sfs)
        mc_patch_jcc8(c, jge_sfs, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
        mc_ai_leave(c, 0x28)
        cg_reg_helper(cg, h_ai_sum_f32(), s_sf32, buf_len(c))
    }

    // 65. `h_ai_radix_aflag_inplace(arr, offs, ends, cur, sh_xor) -> i64`:
    //     Zero-alloc In-Place 256-Bucket American Flag MSD Partition on L2-hot `arr`!
    if cg_is_helper_used(cg, h_ai_radix_aflag_inplace()) {
        mc_align16(c)
        s_af := buf_len(c)
        mc_ai_enter(c, 0x28)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = arr
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = offs[256]
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = ends[256]
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = cur[256]
        mc_b4(c, 0x48, 0x8B, 0x41, 32)   // RAX = sh | (xor_m << 8)
        mc_b3(c, 0x48, 0x89, 0xC1); mc_b3(c, 0x83, 0xE1, 63) // ECX = sh (CL!)
        mc_b4(c, 0x48, 0xC1, 0xE8, 8); mc_b1(c, 0x25); mc_u32(c, 255)
        mc_b3(c, 0x49, 0x89, 0xC4)       // R12 = xor_m
        // Copy offs[0..255] -> cur[0..255]
        mc_b2(c, 0x31, 0xD2)
        lp_afcp := buf_len(c)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xD1); mc_b4(c, 0x49, 0x89, 0x04, 0xD3)
        mc_b3(c, 0x48, 0xFF, 0xC2); mc_b3(c, 0x48, 0x81, 0xFA); mc_u32(c, 256)
        jl_afcp := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_afcp, lp_afcp)

        // For b (R13) = 0 .. 255:
        mc_b3(c, 0x45, 0x31, 0xED)
        mc_align16_nop(c)
        lp_afb := buf_len(c)
        mc_b3(c, 0x49, 0x81, 0xFD); mc_u32(c, 256); jge_af_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4B, 0x8B, 0x34, 0xEB) // RSI = pos = cur[b]
        mc_b4(c, 0x4B, 0x8B, 0x3C, 0xEA) // RDI = end = ends[b]
        lp_afp := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xFE); jge_afb_nx := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xF0) // RAX = v = arr[pos]
        mc_b3(c, 0x48, 0x89, 0xC2); mc_b3(c, 0x48, 0xD3, 0xEA) // RDX = v >> cl
        mc_b3(c, 0x4C, 0x31, 0xE2); mc_b2(c, 0x81, 0xE2); mc_u32(c, 255) // RDX = dest_b
        mc_b3(c, 0x4C, 0x39, 0xEA); je_af_ok := mc_jcc8(c, 0x74) // already in bucket b!
        // Cycle-leader chase: keep swapping v into cur[dest_b] until dest_b == b!
        lp_afc := buf_len(c)
        mc_b4(c, 0x49, 0x8B, 0x1C, 0xD3) // RBX = dst_pos = cur[dest_b]
        mc_b4(c, 0x48, 0x8D, 0x6B, 1); mc_b4(c, 0x49, 0x89, 0x2C, 0xD3) // cur[dest_b] = dst_pos + 1
        mc_b4(c, 0x49, 0x8B, 0x2C, 0xD8) // RBP = next_v = arr[dst_pos]
        mc_b4(c, 0x49, 0x89, 0x04, 0xD8) // arr[dst_pos] = v
        mc_b3(c, 0x48, 0x89, 0xE8)       // RAX = v = next_v
        mc_b3(c, 0x48, 0x89, 0xC2); mc_b3(c, 0x48, 0xD3, 0xEA)
        mc_b3(c, 0x4C, 0x31, 0xE2); mc_b2(c, 0x81, 0xE2); mc_u32(c, 255)
        mc_b3(c, 0x4C, 0x39, 0xEA); jne_afc := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jne_afc, lp_afc)
        mc_b4(c, 0x49, 0x89, 0x04, 0xF0) // arr[pos] = final v belonging to bucket b!
        mc_patch_jcc8(c, je_af_ok, buf_len(c))
        mc_b3(c, 0x48, 0xFF, 0xC6)       // pos++
        j_afp := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_afp, lp_afp)
        mc_patch_jcc8(c, jge_afb_nx, buf_len(c))
        mc_b4(c, 0x4B, 0x89, 0x34, 0xEB) // cur[b] = pos
        mc_b3(c, 0x49, 0xFF, 0xC5); j_afb := mc_jmp32(c); mc_patch_rel32(c, j_afb, lp_afb)

        mc_patch_rel32(c, jge_af_dn, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_ai_leave(c, 0x28)
        cg_reg_helper(cg, h_ai_radix_aflag_inplace(), s_af, buf_len(c))
    }

    // 66. `h_ai_dmap_rehash(old_p, old_c, np, new_cap) -> i64`:
    //     AVX2 0x7F fill of np + zero-spill Fibonacci-hash rehash loop! Returns re_used.
    if cg_is_helper_used(cg, h_ai_dmap_rehash()) {
        mc_align16(c)
        s_dmr := buf_len(c)
        mc_ai_enter(c, 0x28)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = old_p
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = old_c
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = np
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = new_cap
        // Fill np[0 .. new_cap*16 - 1] with 0x7F7F7F7F7F7F7F7F (AVX2 64B/iter or qword loop!)
        mc_b2(c, 0x49, 0xBC); mc_u64(c, 0x7F7F7F7F7F7F7F7F) // R12 = emp
        mc_b3(c, 0x4C, 0x89, 0xD8); mc_b4(c, 0x48, 0xC1, 0xE0, 4) // RAX = new_cap * 16 (bytes)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_dmrf_sc := mc_jcc8(c, 0x74)
        mc_b4(c, 0x49, 0x83, 0xFB, 8); jl_dmrf_sc2 := mc_jcc8(c, 0x7C)
        mc_vex3(c, 0, 0, 1, 1, 1, 0, 0, 1, 0x6E); mc_b1(c, 0xC4) // VMOVQ X0, R12
        mc_vex256(c, 2, 0, 0, 0, 0x59)                            // VPBROADCASTQ Y0, X0
        mc_b3(c, 0x4C, 0x89, 0xDA); mc_b4(c, 0x48, 0xC1, 0xE2, 4) // RDX = total bytes = new_cap*16
        mc_b2(c, 0x31, 0xC9)
        lp_dmrfv := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD1); jge_dmrfv := mc_jcc8(c, 0x7D)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x04, 0x0A)       // [R10+RCX] = Y0
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b3(c, 0x44, 0x0A, 32)   // [R10+RCX+32] = Y0
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b3(c, 0x44, 0x0A, 64)   // [R10+RCX+64] = Y0
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b3(c, 0x44, 0x0A, 96)   // [R10+RCX+96] = Y0
        mc_b3(c, 0x48, 0x81, 0xC1); mc_u32(c, 128); j_dmrfv := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_dmrfv, lp_dmrfv)
        mc_patch_jcc8(c, jge_dmrfv, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_dmrf_ok := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jz_dmrf_sc, buf_len(c))
        mc_patch_jcc8(c, jl_dmrf_sc2, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xDA); mc_b3(c, 0x48, 0x01, 0xD2) // RDX = new_cap * 2 qwords
        mc_b2(c, 0x31, 0xC9)
        lp_dmrfs := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD1); jge_dmrfs := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x4D, 0x89, 0x24, 0xCA) // [R10 + RCX*8] = R12
        mc_b3(c, 0x48, 0xFF, 0xC1); j_dmrfs := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_dmrfs, lp_dmrfs)
        mc_patch_jcc8(c, jge_dmrfs, buf_len(c))
        mc_patch_jcc8(c, jmp_dmrf_ok, buf_len(c))

        // Rehash loop: direct byte-offset probing (R13 = (new_cap-1)<<4, ZERO SHL inside probe loop!)
        mc_b4(c, 0x4D, 0x8D, 0x6B, 0xFF); mc_b4(c, 0x49, 0xC1, 0xE5, 4) // R13 = (new_cap - 1) << 4
        mc_b2(c, 0x49, 0xBE); mc_u64(c, 0x517CC1B727220A95)              // R14 = FX_MUL
        mc_b3(c, 0x45, 0x31, 0xFF)                                       // R15 = re_used = 0
        mc_b4(c, 0x49, 0x8D, 0x5C, 0x24); mc_b1(c, 0xFF)                 // RBX = R12 - 1 (tmb)
        mc_b3(c, 0x4D, 0x85, 0xC0); jz_dmr_dn := mc_jcc32(c, 0x84)
        mc_b4(c, 0x49, 0xC1, 0xE1, 4)                                    // R9 = old_c * 16 bytes
        mc_b2(c, 0x31, 0xF6)                                             // RSI = byte_off = 0
        mc_align16_nop(c)
        lp_dmr := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xCE); jge_dmr_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x8B, 0x04, 0x30)                                 // RAX = k = old_p[i].k
        mc_b3(c, 0x4C, 0x39, 0xE0); je_dmr_sk := mc_jcc8(c, 0x74)
        mc_b3(c, 0x48, 0x39, 0xD8); je_dmr_sk2 := mc_jcc8(c, 0x74)
        mc_b4(c, 0x49, 0x8B, 0x7C, 0x30); mc_b1(c, 8)                    // RDI = v = old_p[i].v
        mc_b3(c, 0x48, 0x89, 0xC5); mc_b4(c, 0x49, 0x0F, 0xAF, 0xEE)     // RBP = k * FIB_MUL
        mc_b4(c, 0x48, 0xC1, 0xED, 32); mc_b3(c, 0x4C, 0x21, 0xED)       // RBP = ((hash>>36)&mask)*16
        lp_dmrp := buf_len(c)
        mc_b4(c, 0x4D, 0x39, 0x24, 0x2A); je_dmr_put := mc_jcc8(c, 0x74) // CMP [R10+RBP], R12
        mc_b4(c, 0x48, 0x83, 0xC5, 16); mc_b3(c, 0x4C, 0x21, 0xED)       // RBP = (RBP + 16) & mask_bytes
        j_dmrp := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_dmrp, lp_dmrp)
        mc_patch_jcc8(c, je_dmr_put, buf_len(c))
        mc_b4(c, 0x49, 0x89, 0x04, 0x2A)
        mc_b4(c, 0x49, 0x89, 0x7C, 0x2A); mc_b1(c, 8)
        mc_b3(c, 0x49, 0xFF, 0xC7)
        mc_patch_jcc8(c, je_dmr_sk, buf_len(c))
        mc_patch_jcc8(c, je_dmr_sk2, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xC6, 16); j_dmr := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_dmr, lp_dmr)
        mc_patch_jcc8(c, jge_dmr_dn, buf_len(c))
        mc_patch_rel32(c, jz_dmr_dn, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xF8) // RAX = re_used
        mc_ai_leave(c, 0x28)
        cg_reg_helper(cg, h_ai_dmap_rehash(), s_dmr, buf_len(c))
    }

    // 66. `h_ai_nbody_par_f64(meta, barr, n, steps, tid, nt) -> i64`:
    //     Fused 50-step parallel N-Body with 64B-isolated lock-free flag barrier + register-cached AVX2 VRSQRTPS+2xNR!
    //     meta[0..9] = px, py, pz, vx, vy, vz, pm, npx, npy, npz; barr = 8 * 64B cache-line-isolated step flags (zeroed by caller!)
    if cg_is_helper_used(cg, h_ai_nbody_par_f64()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_nbp := buf_len(cg.rdata)
        mut nbk := 0
        while nbk < 4 { buf_push_u64(cg.rdata, 0x3F847AE147AE147B); nbk += 1 } // +0:  4x 0.01 (eps & dt)
        nbk = 0; while nbk < 4 { buf_push_u64(cg.rdata, 0x3FE0000000000000); nbk += 1 } // +32: 4x 0.5
        nbk = 0; while nbk < 4 { buf_push_u64(cg.rdata, 0x3FF8000000000000); nbk += 1 } // +64: 4x 1.5
        buf_push_u64(cg.rdata, 0x3FF0000000000000)                                       // +96: 1.0 (scalar)
        buf_push_u64(cg.rdata, 0); buf_push_u64(cg.rdata, 0); buf_push_u64(cg.rdata, 0)  // pad to +128 (32B-aligned)
        // +128..+639: 8 x 64B upper-triangle lane masks (mask[rem][lane] = -1 if lane > rem else 0)
        mut nbm := 0
        while nbm < 8 {
            mut nbl := 0
            while nbl < 8 {
                buf_push_u64(cg.rdata, if nbl > nbm { -1 } else { 0 })
                nbl += 1
            }
            nbm += 1
        }

        mc_align16(c)
        s_nbp := buf_len(c)
        // Stack 0x138: [0..159]=XMM6..15, [160]=meta, [168]=barr, [176]=n, [184]=steps, [192]=tid, [200]=nt,
        //              [208]=i0, [216]=i1, [224]=px, [232]=py, [240]=pz, [248]=npx/vx, [256]=npy/vy, [264]=npz/vz,
        //              [272]=st, [280]=acc_base, [288]=ax_t, [296]=g_blk
        mc_ai_enter(c, 0x138)
        _mc_save_xmm6_15_rsp(c, 0)
        mut ai := 0
        while ai < 6 {
            mc_b4(c, 0x48, 0x8B, 0x41, ai * 8)
            mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 160 + ai * 8)
            ai += 1
        }
        // Compute i0 = (tid * n) / nt, i1 = ((tid + 1) * n) / nt
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 192) // RAX = tid
        mc_b4(c, 0x48, 0x8B, 0x8C, 0x24); mc_u32(c, 200) // RCX = nt
        mc_b4(c, 0x48, 0x0F, 0xAF, 0x84); mc_b1(c, 0x24); mc_u32(c, 176) // RAX = tid * n
        mc_b2(c, 0x48, 0x99); mc_b3(c, 0x48, 0xF7, 0xF9) // RAX = i0
        mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 208) // [RSP+208] = i0
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 192); mc_b3(c, 0x48, 0xFF, 0xC0) // tid + 1
        mc_b4(c, 0x48, 0x0F, 0xAF, 0x84); mc_b1(c, 0x24); mc_u32(c, 176)
        mc_b2(c, 0x48, 0x99); mc_b3(c, 0x48, 0xF7, 0xF9) // RAX = i1
        mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 216) // [RSP+216] = i1

        // Copy px..pz, npx..npz from meta to stack locals
        mc_b4(c, 0x48, 0x8B, 0x94, 0x24); mc_u32(c, 160) // RDX = meta
        mc_b3(c, 0x48, 0x8B, 0x02); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 224)
        mc_b4(c, 0x48, 0x8B, 0x42, 8);  mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 232)
        mc_b4(c, 0x48, 0x8B, 0x42, 16); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 240)
        mc_b4(c, 0x48, 0x8B, 0x42, 56); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 248)
        mc_b4(c, 0x48, 0x8B, 0x42, 64); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 256)
        mc_b4(c, 0x48, 0x8B, 0x42, 72); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 264)
        mc_b4(c, 0x4C, 0x8B, 0x5A, 48) // R11 = pm = meta[6]
        cg_lea_rax_rdata(cg, roff_nbp); mc_b3(c, 0x49, 0x89, 0xC5) // R13 = &consts
        mc_b4(c, 0x4C, 0x8B, 0xBC, 0x24); mc_u32(c, 176)           // R15 = n
        mc_b3(c, 0x45, 0x31, 0xF6)                                 // R14 = st = 0

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_nbp_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x41, 0xF6, 0xC7, 3); jnz_nbp_sc2 := mc_jcc32(c, 0x85)
        // Check symmetric Newton 3rd Law fastpath: (n & 7) == 0 and meta[10] (acc_base) != 0!
        mc_b4(c, 0x41, 0xF6, 0xC7, 7); jnz_nbp_nosym := mc_jcc8(c, 0x75)
        mc_b4(c, 0x48, 0x8B, 0x94, 0x24); mc_u32(c, 160) // RDX = meta
        mc_b4(c, 0x48, 0x8B, 0x42, 80)                   // RAX = meta[10] (acc_base)
        mc_b3(c, 0x48, 0x85, 0xC0); jnz_nbp_sym := mc_jcc32(c, 0x85)
        mc_patch_jcc8(c, jnz_nbp_nosym, buf_len(c))

        // Zero-reload 8-wide AVX2 N-Body: Y0..Y5 hold dx0..dz1 LIVE across VRSQRTPS+2xNR!
        mc_align16_nop(c)
        lp_nbp_st := buf_len(c)
        mc_b4(c, 0x4C, 0x3B, 0xB4, 0x24); mc_u32(c, 184); jge_nbp_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4C, 0x8B, 0x84, 0x24); mc_u32(c, 224) // R8  = px
        mc_b4(c, 0x4C, 0x8B, 0x8C, 0x24); mc_u32(c, 232) // R9  = py
        mc_b4(c, 0x4C, 0x8B, 0x94, 0x24); mc_u32(c, 240) // R10 = pz
        mc_b4(c, 0x48, 0x8B, 0xBC, 0x24); mc_u32(c, 208) // RDI = i = i0
        mc_b4(c, 0x48, 0x8B, 0xB4, 0x24); mc_u32(c, 216) // RSI = i1

        lp_nbp_i := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xF7); jge_nbp_idn := mc_jcc32(c, 0x8D)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x14, 0xF8) // Y10 = xi (kept live!)
        mc_vex256(c, 1, 13, 13, 13, 0x57); mc_vex256(c, 1, 14, 14, 14, 0x57); mc_vex256(c, 1, 15, 15, 15, 0x57)
        mc_b2(c, 0x31, 0xC9) // RCX = j = 0
        mc_b4(c, 0x49, 0x8D, 0x47, 0xF8) // RAX = n - 8
        lp_nbp_j8 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC1); jg_nbp_j4 := mc_jcc32(c, 0x8F)
        // Compute dx0..dz1 ONCE into Y0..Y5 (zero reload!), use Y11/Y12 as yi/zi then NR temps!
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xC8); mc_vex256(c, 1, 0, 0, 10, 0x5C)       // Y0 = dx0
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x4C, 0xC8, 32); mc_vex256(c, 1, 1, 1, 10, 0x5C)   // Y1 = dx1
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x1C, 0xF9)                                        // Y11 = bcast(yi)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x14, 0xC9); mc_vex256(c, 1, 2, 2, 11, 0x5C)       // Y2 = dy0
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x5C, 0xC9, 32); mc_vex256(c, 1, 3, 3, 11, 0x5C)   // Y3 = dy1
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x24, 0xFA)                                        // Y12 = bcast(zi)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x24, 0xCA); mc_vex256(c, 1, 4, 4, 12, 0x5C)       // Y4 = dz0
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x6C, 0xCA, 32); mc_vex256(c, 1, 5, 5, 12, 0x5C)   // Y5 = dz1
        // r2_0 -> Y6, r2_1 -> Y7 using FMA3 with [R13+0] (eps)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x75, 0)                                           // Y6 = eps
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x7D, 0)                                           // Y7 = eps
        mc_vex3(c, 0, 0, 0, 2, 1, 0, 1, 1, 0xB8); mc_b1(c, 0xF0)                                              // Y6 += dx0^2
        mc_vex3(c, 0, 0, 0, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xF9)                                              // Y7 += dx1^2
        mc_vex3(c, 0, 0, 0, 2, 1, 2, 1, 1, 0xB8); mc_b1(c, 0xF2)                                              // Y6 += dy0^2
        mc_vex3(c, 0, 0, 0, 2, 1, 3, 1, 1, 0xB8); mc_b1(c, 0xFB)                                              // Y7 += dy1^2
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b1(c, 0xF4)                                              // Y6 += dz0^2
        mc_vex3(c, 0, 0, 0, 2, 1, 5, 1, 1, 0xB8); mc_b1(c, 0xFD)                                              // Y7 += dz1^2
        // Pack 8x r2 -> ONE 8-wide VRSQRTPS Y8 -> unpack Y8=y0, Y9=y1
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x5A); mc_b1(c, 0xC6)                                              // VCVTPD2PS X8, Y6
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x5A); mc_b1(c, 0xCF)                                              // VCVTPD2PS X9, Y7
        mc_vex3(c, 1, 0, 1, 3, 0, 8, 1, 1, 0x18); mc_b2(c, 0xC1, 1)                                           // VINSERTF128 Y8, Y8, X9, 1
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 0, 0x52); mc_b1(c, 0xC0)                                              // VRSQRTPS Y8, Y8
        mc_vex3(c, 1, 0, 1, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC1, 1)                                           // VEXTRACTF128 X9, Y8, 1
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b1(c, 0xC0)                                              // VCVTPS2PD Y8, X8
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b1(c, 0xC9)                                              // VCVTPS2PD Y9, X9
        mc_vex3(c, 0, 0, 1, 1, 0, 6, 1, 1, 0x59); mc_b2(c, 0x75, 32)                                          // Y6 = h0 = 0.5*r2_0
        mc_vex3(c, 0, 0, 1, 1, 0, 7, 1, 1, 0x59); mc_b2(c, 0x7D, 32)                                          // Y7 = h1 = 0.5*r2_1
        // Interleaved NR1 & NR2 (2x FMA throughput, Y11/Y12 temps, [R13+64] = 1.5!)
        mc_vex256(c, 1, 11, 8, 8, 0x59); mc_vex256(c, 1, 12, 9, 9, 0x59)
        mc_vex3(c, 1, 0, 1, 2, 1, 6, 1, 1, 0xAC); mc_b2(c, 0x5D, 64)                                          // Y11 = 1.5 - h0*y0^2
        mc_vex3(c, 1, 0, 1, 2, 1, 7, 1, 1, 0xAC); mc_b2(c, 0x65, 64)                                          // Y12 = 1.5 - h1*y1^2
        mc_vex256(c, 1, 8, 8, 11, 0x59); mc_vex256(c, 1, 9, 9, 12, 0x59)
        mc_vex256(c, 1, 11, 8, 8, 0x59); mc_vex256(c, 1, 12, 9, 9, 0x59)
        mc_vex3(c, 1, 0, 1, 2, 1, 6, 1, 1, 0xAC); mc_b2(c, 0x5D, 64)
        mc_vex3(c, 1, 0, 1, 2, 1, 7, 1, 1, 0xAC); mc_b2(c, 0x65, 64)
        mc_vex256(c, 1, 8, 8, 11, 0x59); mc_vex256(c, 1, 9, 9, 12, 0x59)
        // Parallel y^3 * m: (y^2) AND (y*m) issue in parallel -> 2-deep multiply!
        mc_vex256(c, 1, 11, 8, 8, 0x59); mc_vex256(c, 1, 12, 9, 9, 0x59)
        mc_vex3(c, 1, 0, 1, 1, 0, 8, 1, 1, 0x59); mc_b2(c, 0x04, 0xCB)                                        // Y8 *= pm[j]
        mc_vex3(c, 1, 0, 1, 1, 0, 9, 1, 1, 0x59); mc_b3(c, 0x4C, 0xCB, 32)                                    // Y9 *= pm[j+4]
        mc_vex256(c, 1, 6, 11, 8, 0x59); mc_vex256(c, 1, 7, 12, 9, 0x59)                                      // Y6=f0, Y7=f1
        // ZERO-RELOAD FMA accumulate directly from LIVE Y0..Y5!
        mc_vex3(c, 1, 0, 0, 2, 1, 0, 1, 1, 0xB8); mc_b1(c, 0xEE)                                              // Y13 += dx0*f0
        mc_vex3(c, 1, 0, 0, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xEF)                                              // Y13 += dx1*f1
        mc_vex3(c, 1, 0, 0, 2, 1, 2, 1, 1, 0xB8); mc_b1(c, 0xF6)                                              // Y14 += dy0*f0
        mc_vex3(c, 1, 0, 0, 2, 1, 3, 1, 1, 0xB8); mc_b1(c, 0xF7)                                              // Y14 += dy1*f1
        mc_vex3(c, 1, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b1(c, 0xFE)                                              // Y15 += dz0*f0
        mc_vex3(c, 1, 0, 0, 2, 1, 5, 1, 1, 0xB8); mc_b1(c, 0xFF)                                              // Y15 += dz1*f1
        mc_b4(c, 0x48, 0x83, 0xC1, 8)
        j_nbpj8 := mc_jmp32(c); mc_patch_rel32(c, j_nbpj8, lp_nbp_j8)
        mc_patch_rel32(c, jg_nbp_j4, buf_len(c))
        // 4-wide tail only if n % 8 != 0 (skipped in 1 branch for n=96!)
        mc_b3(c, 0x4C, 0x39, 0xF9); jge_nbpj_dn := mc_jcc32(c, 0x8D)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x75, 0)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x7D, 32)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x45, 64)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x1C, 0xF9)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x24, 0xFA)
        lp_nbp_j := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xF9); jge_nbpj_dn2 := mc_jcc32(c, 0x8D)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xC8); mc_vex256(c, 1, 0, 0, 10, 0x5C)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x0C, 0xC9); mc_vex256(c, 1, 1, 1, 11, 0x5C)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x14, 0xCA); mc_vex256(c, 1, 2, 2, 12, 0x5C)
        mc_vex256(c, 1, 3, 0, 0, 0x59); mc_vex256(c, 1, 3, 3, 6, 0x58)
        mc_vex3(c, 0, 0, 0, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xD9)
        mc_vex3(c, 0, 0, 0, 2, 1, 2, 1, 1, 0xB8); mc_b1(c, 0xDA)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x5A); mc_b1(c, 0xE3)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0x52); mc_b1(c, 0xE4)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x5A); mc_b1(c, 0xE4)
        mc_vex256(c, 1, 3, 3, 7, 0x59)
        mc_vex256(c, 1, 5, 4, 4, 0x59)
        mc_vex3(c, 0, 0, 1, 2, 1, 3, 1, 1, 0xAC); mc_b1(c, 0xE8)
        mc_vex256(c, 1, 4, 4, 5, 0x59)
        mc_vex256(c, 1, 5, 4, 4, 0x59)
        mc_vex3(c, 0, 0, 1, 2, 1, 3, 1, 1, 0xAC); mc_b1(c, 0xE8)
        mc_vex256(c, 1, 4, 4, 5, 0x59)
        mc_vex256(c, 1, 3, 4, 4, 0x59); mc_vex256(c, 1, 3, 3, 4, 0x59)
        mc_vex3(c, 0, 0, 1, 1, 0, 3, 1, 1, 0x59); mc_b2(c, 0x1C, 0xCB)
        mc_vex3(c, 1, 0, 0, 2, 1, 0, 1, 1, 0xB8); mc_b1(c, 0xEB)
        mc_vex3(c, 1, 0, 0, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xF3)
        mc_vex3(c, 1, 0, 0, 2, 1, 2, 1, 1, 0xB8); mc_b1(c, 0xFB)
        mc_b4(c, 0x48, 0x83, 0xC1, 4)
        j_nbpj := mc_jmp32(c); mc_patch_rel32(c, j_nbpj, lp_nbp_j)
        mc_patch_rel32(c, jge_nbpj_dn2, buf_len(c))
        mc_patch_rel32(c, jge_nbpj_dn, buf_len(c))

        // Fused vx/vy/vz AND npx/npy/npz update directly for body i!
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x75, 0)    // X6 = dt (0.01)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x1C, 0xF9) // X11 = py[i]
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x24, 0xFA) // X12 = pz[i]
        mc_b4(c, 0x48, 0x8B, 0x94, 0x24); mc_u32(c, 160) // RDX = meta
        // X component: vx[i] += hsum(Y13)*dt; npx[i] = px[i] + vx[i]*dt
        _mc_vhsum_pd_to_xmm0(c, 13)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC6)             // X0 *= X6 (dt)
        mc_b4(c, 0x48, 0x8B, 0x42, 24)                                        // RAX = vx
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x04, 0xF8)       // X0 += vx[i]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xF8)       // vx[i] = X0
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC6)             // X0 *= dt
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x58); mc_b1(c, 0xC2)             // X0 += X10 (px[i])
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 248)                     // RAX = npx
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xF8)       // npx[i] = X0
        // Y component
        _mc_vhsum_pd_to_xmm0(c, 14)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC6)
        mc_b4(c, 0x48, 0x8B, 0x42, 32)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x04, 0xF8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xF8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC6)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x58); mc_b1(c, 0xC3)             // X0 += X11 (py[i])
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 256)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xF8)
        // Z component
        _mc_vhsum_pd_to_xmm0(c, 15)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC6)
        mc_b4(c, 0x48, 0x8B, 0x42, 40)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x04, 0xF8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xF8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC6)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x58); mc_b1(c, 0xC4)             // X0 += X12 (pz[i])
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 264)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xF8)

        mc_b3(c, 0x48, 0xFF, 0xC7); j_nbpi := mc_jmp32(c); mc_patch_rel32(c, j_nbpi, lp_nbp_i)
        mc_patch_rel32(c, jge_nbp_idn, buf_len(c))

        // ZERO-LOCK, 64B-isolated per-thread flag barrier! (barr[tid*64] = st + 1; wait for all t < nt!)
        mc_b3(c, 0x49, 0xFF, 0xC6) // R14 = st + 1
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 168) // RAX = barr
        mc_b4(c, 0x48, 0x8B, 0x8C, 0x24); mc_u32(c, 192) // RCX = tid
        mc_b4(c, 0x48, 0xC1, 0xE1, 6)                    // RCX = tid * 64
        mc_b4(c, 0x4C, 0x89, 0x34, 0x08)                 // MOV [barr + tid*64], st+1 (plain store, x86 TSO release!)
        mc_b4(c, 0x48, 0x8B, 0x9C, 0x24); mc_u32(c, 200) // RBX = nt
        mc_b2(c, 0x31, 0xD2)                             // RDX = t = 0
        lp_nbp_bw := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xDA); jge_nbp_bdn := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE1, 6) // RCX = t * 64
        mc_b1(c, 0xBE); mc_u32(c, 48) // ESI = fast no-PAUSE spin budget (48 polls -> ~15ns wake!)
        lp_nbp_bp := buf_len(c)
        mc_b4(c, 0x4C, 0x39, 0x34, 0x08); jge_nbp_tok := mc_jcc8(c, 0x7D) // [barr+t*64] >= st+1
        mc_b2(c, 0x85, 0xF6); jz_nbp_pau := mc_jcc8(c, 0x74)
        mc_b2(c, 0xFF, 0xCE); j_nbp_bp1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_nbp_bp1, lp_nbp_bp)
        mc_patch_jcc8(c, jz_nbp_pau, buf_len(c))
        mc_b2(c, 0xF3, 0x90); j_nbp_bp2 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_nbp_bp2, lp_nbp_bp)
        mc_patch_jcc8(c, jge_nbp_tok, buf_len(c))
        mc_b3(c, 0x48, 0xFF, 0xC2); j_nbp_bw := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_nbp_bw, lp_nbp_bw)
        mc_patch_jcc8(c, jge_nbp_bdn, buf_len(c))

        // Swap (px,py,pz) <-> (npx,npy,npz) in stack locals
        mut swi := 0
        while swi < 3 {
            o1 := 224 + swi * 8; o2 := 248 + swi * 8
            mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, o1)
            mc_b4(c, 0x48, 0x8B, 0x94, 0x24); mc_u32(c, o2)
            mc_b4(c, 0x48, 0x89, 0x94, 0x24); mc_u32(c, o1)
            mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, o2)
            swi += 1
        }
        j_nbpst := mc_jmp32(c); mc_patch_rel32(c, j_nbpst, lp_nbp_st)
        mc_patch_rel32(c, jge_nbp_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_nbp_end := mc_jmp32(c)

        // Scalar SSE2 fallback (--simd=scalar)
        mc_patch_rel32(c, jz_nbp_sc, buf_len(c))
        mc_patch_rel32(c, jnz_nbp_sc2, buf_len(c))
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x7D, 0)  // X15 = 0.01
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x75, 96) // X14 = 1.0
        lp_nbps_st := buf_len(c)
        mc_b4(c, 0x4C, 0x3B, 0xB4, 0x24); mc_u32(c, 184); jge_nbps_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4C, 0x8B, 0x84, 0x24); mc_u32(c, 224)
        mc_b4(c, 0x4C, 0x8B, 0x8C, 0x24); mc_u32(c, 232)
        mc_b4(c, 0x4C, 0x8B, 0x94, 0x24); mc_u32(c, 240)
        mc_b4(c, 0x48, 0x8B, 0xBC, 0x24); mc_u32(c, 208)
        mc_b4(c, 0x48, 0x8B, 0xB4, 0x24); mc_u32(c, 216)
        lp_nbps_i := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xF7); jge_nbps_idn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x04, 0xF8)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x0C, 0xF9)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x14, 0xFA)
        mc_b4(c, 0x66, 0x45, 0x0F, 0x57); mc_b1(c, 0xDB)
        mc_b4(c, 0x66, 0x45, 0x0F, 0x57); mc_b1(c, 0xE4)
        mc_b4(c, 0x66, 0x45, 0x0F, 0x57); mc_b1(c, 0xED)
        mc_b2(c, 0x31, 0xC9)
        lp_nbps_j := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xF9); jge_nbps_jdn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x04, 0xC8); mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b1(c, 0xC0)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xC9); mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b1(c, 0xC9)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x14, 0xCA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b1(c, 0xD2)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xD8); mc_b4(c, 0xF2, 0x0F, 0x59, 0xD8)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xE1); mc_b4(c, 0xF2, 0x0F, 0x59, 0xE1); mc_b4(c, 0xF2, 0x0F, 0x58, 0xDC)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xE2); mc_b4(c, 0xF2, 0x0F, 0x59, 0xE2); mc_b4(c, 0xF2, 0x0F, 0x58, 0xDC)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b1(c, 0xDF)
        mc_b4(c, 0xF2, 0x0F, 0x51, 0xE3); mc_b4(c, 0xF2, 0x0F, 0x59, 0xDC)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b1(c, 0xE6); mc_b4(c, 0xF2, 0x0F, 0x5E, 0xE3)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x24, 0xCB)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xC4); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xD8)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xCC); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xE1)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xD4); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xEA)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_nbpsj := mc_jmp32(c); mc_patch_rel32(c, j_nbpsj, lp_nbps_j)
        mc_patch_rel32(c, jge_nbps_jdn, buf_len(c))
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b1(c, 0xDF)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b1(c, 0xE7)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b1(c, 0xEF)
        mc_b4(c, 0x48, 0x8B, 0x94, 0x24); mc_u32(c, 160)
        mc_b4(c, 0x48, 0x8B, 0x42, 24); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b2(c, 0x1C, 0xF8); mc_b4(c, 0xF2, 0x44, 0x0F, 0x11); mc_b2(c, 0x1C, 0xF8)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b1(c, 0xDF); mc_b4(c, 0xF2, 0x45, 0x0F, 0x58); mc_b1(c, 0xD8); mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 248); mc_b4(c, 0xF2, 0x44, 0x0F, 0x11); mc_b2(c, 0x1C, 0xF8)
        mc_b4(c, 0x48, 0x8B, 0x42, 32); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b2(c, 0x24, 0xF8); mc_b4(c, 0xF2, 0x44, 0x0F, 0x11); mc_b2(c, 0x24, 0xF8)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b1(c, 0xE7); mc_b4(c, 0xF2, 0x45, 0x0F, 0x58); mc_b1(c, 0xE1); mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 256); mc_b4(c, 0xF2, 0x44, 0x0F, 0x11); mc_b2(c, 0x24, 0xF8)
        mc_b4(c, 0x48, 0x8B, 0x42, 40); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b2(c, 0x2C, 0xF8); mc_b4(c, 0xF2, 0x44, 0x0F, 0x11); mc_b2(c, 0x2C, 0xF8)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b1(c, 0xEF); mc_b4(c, 0xF2, 0x45, 0x0F, 0x58); mc_b1(c, 0xEA); mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 264); mc_b4(c, 0xF2, 0x44, 0x0F, 0x11); mc_b2(c, 0x2C, 0xF8)
        mc_b3(c, 0x48, 0xFF, 0xC7); j_nbpsi := mc_jmp32(c); mc_patch_rel32(c, j_nbpsi, lp_nbps_i)
        mc_patch_rel32(c, jge_nbps_idn, buf_len(c))
        // Lock-free flag barrier
        mc_b3(c, 0x49, 0xFF, 0xC6)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 168)
        mc_b4(c, 0x48, 0x8B, 0x8C, 0x24); mc_u32(c, 192); mc_b4(c, 0x48, 0xC1, 0xE1, 6)
        mc_b4(c, 0x4C, 0x89, 0x34, 0x08)
        mc_b4(c, 0x48, 0x8B, 0x9C, 0x24); mc_u32(c, 200); mc_b2(c, 0x31, 0xD2)
        lp_nbps_bw := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xDA); jge_nbps_bdn := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE1, 6)
        lp_nbps_bp := buf_len(c)
        mc_b4(c, 0x4C, 0x39, 0x34, 0x08); jge_nbps_tok := mc_jcc8(c, 0x7D)
        mc_b2(c, 0xF3, 0x90); j_nbps_bp := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_nbps_bp, lp_nbps_bp)
        mc_patch_jcc8(c, jge_nbps_tok, buf_len(c))
        mc_b3(c, 0x48, 0xFF, 0xC2); j_nbps_bw := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_nbps_bw, lp_nbps_bw)
        mc_patch_jcc8(c, jge_nbps_bdn, buf_len(c))
        swi = 0
        while swi < 3 {
            o1 := 224 + swi * 8; o2 := 248 + swi * 8
            mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, o1)
            mc_b4(c, 0x48, 0x8B, 0x94, 0x24); mc_u32(c, o2)
            mc_b4(c, 0x48, 0x89, 0x94, 0x24); mc_u32(c, o1)
            mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, o2)
            swi += 1
        }
        j_nbpsst := mc_jmp32(c); mc_patch_rel32(c, j_nbpsst, lp_nbps_st)
        mc_patch_rel32(c, jge_nbps_dn, buf_len(c))
        jmp_nbps_end := mc_jmp32(c)

        // =========================================================================
        // SYMMETRIC NEWTON'S 3RD LAW (j > i) 8-WIDE AVX2 FASTPATH (2x fewer pairs!)
        // =========================================================================
        mc_align16(c)
        mc_patch_rel32(c, jnz_nbp_sym, buf_len(c))
        // RAX = acc_base, RDX = meta, R11 = pm, R13 = &consts, R15 = n
        mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 280) // [RSP+280] = acc_base
        // Store vx, vy, vz into [248],[256],[264] (in-place px/py/pz updates after Barrier 1!)
        mc_b4(c, 0x48, 0x8B, 0x4A, 24); mc_b4(c, 0x48, 0x89, 0x8C, 0x24); mc_u32(c, 248)
        mc_b4(c, 0x48, 0x8B, 0x4A, 32); mc_b4(c, 0x48, 0x89, 0x8C, 0x24); mc_u32(c, 256)
        mc_b4(c, 0x48, 0x8B, 0x4A, 40); mc_b4(c, 0x48, 0x89, 0x8C, 0x24); mc_u32(c, 264)
        // ax_t = acc_base + tid * 2560 -> [RSP+288]
        mc_b4(c, 0x48, 0x8B, 0x8C, 0x24); mc_u32(c, 192) // RCX = tid
        mc_b3(c, 0x48, 0x69, 0xC9); mc_u32(c, 2560)
        mc_b3(c, 0x48, 0x01, 0xC1)                       // RCX = acc_base + tid * 2560
        mc_b4(c, 0x48, 0x89, 0x8C, 0x24); mc_u32(c, 288) // [RSP+288] = ax_t
        mc_b4(c, 0x48, 0xC7, 0x84, 0x24); mc_u32(c, 272); mc_u32(c, 0) // st = 0

        mc_align16_nop(c)
        lp_nbs_st := buf_len(c)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 272) // RAX = st
        mc_b4(c, 0x48, 0x3B, 0x84, 0x24); mc_u32(c, 184); jge_nbs_dn := mc_jcc32(c, 0x8D)

        // Zero private ax_t[0..n-1], ay_t[0..n-1], az_t[0..n-1] (3*n f64s in L1D!)
        mc_b4(c, 0x4C, 0x8B, 0xA4, 0x24); mc_u32(c, 288) // R12 = ax_t
        mc_b4(c, 0x48, 0x8B, 0x9C, 0x24); mc_u32(c, 176) // RBX = n
        mc_b4(c, 0x48, 0x8D, 0x04, 0x5B)                 // RAX = 3 * n
        mc_vex256(c, 1, 0, 0, 0, 0x57)                   // Y0 = 0.0
        mc_b2(c, 0x31, 0xC9)
        lp_nbs_z := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x04, 0xCC)     // [R12+RCX*8] = Y0
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b3(c, 0x44, 0xCC, 32) // [R12+RCX*8+32] = Y0
        mc_b4(c, 0x48, 0x83, 0xC1, 8); mc_b3(c, 0x48, 0x39, 0xC1)
        jl_nbs_z := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_nbs_z, lp_nbs_z)

        // Load R8=px, R9=py, R10=pz, R14=ay_t=R12+n*8, R15=az_t=R14+n*8
        mc_b4(c, 0x4C, 0x8B, 0x84, 0x24); mc_u32(c, 224) // R8 = px
        mc_b4(c, 0x4C, 0x8B, 0x8C, 0x24); mc_u32(c, 232) // R9 = py
        mc_b4(c, 0x4C, 0x8B, 0x94, 0x24); mc_u32(c, 240) // R10 = pz
        mc_b4(c, 0x4D, 0x8D, 0x34, 0xDC)                 // R14 = R12 + RBX*8 (ay_t)
        mc_b4(c, 0x4D, 0x8D, 0x3C, 0xDE)                 // R15 = R14 + RBX*8 (az_t)

        // Folded cyclic outer loop: g = 0, 2*nt, 4*nt, ...; phase=0 -> i=g+tid, phase=1 -> i=g+2*nt-1-tid
        mc_b4(c, 0x48, 0xC7, 0x84, 0x24); mc_u32(c, 296); mc_u32(c, 0) // g = 0
        lp_nbs_g := buf_len(c)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 296) // RAX = g
        mc_b3(c, 0x48, 0x39, 0xD8); jge_nbs_gdn := mc_jcc32(c, 0x8D)
        mc_b2(c, 0x31, 0xF6)                             // RSI = phase = 0
        lp_nbs_ph := buf_len(c)
        mc_b4(c, 0x48, 0x8B, 0xBC, 0x24); mc_u32(c, 296) // RDI = g
        mc_b3(c, 0x48, 0x85, 0xF6); jnz_nbs_p1 := mc_jcc8(c, 0x75)
        mc_b4(c, 0x48, 0x03, 0xBC, 0x24); mc_u32(c, 192) // RDI = g + tid
        jmp_nbs_ir := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jnz_nbs_p1, buf_len(c))
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 200) // RAX = nt
        mc_b3(c, 0x48, 0x01, 0xC0); mc_b3(c, 0x48, 0xFF, 0xC8) // RAX = 2*nt - 1
        mc_b4(c, 0x48, 0x2B, 0x84, 0x24); mc_u32(c, 192) // RAX = 2*nt - 1 - tid
        mc_b3(c, 0x48, 0x01, 0xC7)                       // RDI = g + 2*nt - 1 - tid
        mc_patch_jcc8(c, jmp_nbs_ir, buf_len(c))
        // Skip if i >= n - 1 (no j > i!)
        mc_b4(c, 0x48, 0x8D, 0x43, 0xFF)                 // RAX = n - 1
        mc_b3(c, 0x48, 0x39, 0xC7); jge_nbs_iskip := mc_jcc32(c, 0x8D)

        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x14, 0xF8) // Y10 = bcast(xi)
        mc_vex256(c, 1, 13, 13, 13, 0x57); mc_vex256(c, 1, 14, 14, 14, 0x57); mc_vex256(c, 1, 15, 15, 15, 0x57)
        // RCX = j0 = (i + 1) & (-8); RBP = 1 if j0 <= i (needs mask on 1st block) else 0
        mc_b4(c, 0x48, 0x8D, 0x4F, 1); mc_b4(c, 0x48, 0x83, 0xE1, 0xF8) // RCX = (i+1)&(-8)
        mc_b2(c, 0x31, 0xED)                             // RBP = 0
        mc_b3(c, 0x48, 0x39, 0xF9); jg_nbs_nomsk := mc_jcc8(c, 0x7F)
        mc_b1(c, 0xBD); mc_u32(c, 1)                     // RBP = 1 (mask 1st block!)
        mc_patch_jcc8(c, jg_nbs_nomsk, buf_len(c))

        lp_nbs_j8 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD9); jge_nbs_jdn := mc_jcc32(c, 0x8D) // j >= n -> done
        // Compute dx0..dz1 -> Y0..Y5
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xC8); mc_vex256(c, 1, 0, 0, 10, 0x5C)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x4C, 0xC8, 32); mc_vex256(c, 1, 1, 1, 10, 0x5C)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x1C, 0xF9) // Y11 = yi
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x14, 0xC9); mc_vex256(c, 1, 2, 2, 11, 0x5C)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x5C, 0xC9, 32); mc_vex256(c, 1, 3, 3, 11, 0x5C)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x24, 0xFA) // Y12 = zi
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x24, 0xCA); mc_vex256(c, 1, 4, 4, 12, 0x5C)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x6C, 0xCA, 32); mc_vex256(c, 1, 5, 5, 12, 0x5C)
        // r2_0 -> Y6, r2_1 -> Y7
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x75, 0)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x7D, 0)
        mc_vex3(c, 0, 0, 0, 2, 1, 0, 1, 1, 0xB8); mc_b1(c, 0xF0)
        mc_vex3(c, 0, 0, 0, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xF9)
        mc_vex3(c, 0, 0, 0, 2, 1, 2, 1, 1, 0xB8); mc_b1(c, 0xF2)
        mc_vex3(c, 0, 0, 0, 2, 1, 3, 1, 1, 0xB8); mc_b1(c, 0xFB)
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b1(c, 0xF4)
        mc_vex3(c, 0, 0, 0, 2, 1, 5, 1, 1, 0xB8); mc_b1(c, 0xFD)
        // VRSQRTPS + 2x NR -> Y8=y0, Y9=y1
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x5A); mc_b1(c, 0xC6)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x5A); mc_b1(c, 0xCF)
        mc_vex3(c, 1, 0, 1, 3, 0, 8, 1, 1, 0x18); mc_b2(c, 0xC1, 1)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 0, 0x52); mc_b1(c, 0xC0)
        mc_vex3(c, 1, 0, 1, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC1, 1)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b1(c, 0xC0)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b1(c, 0xC9)
        mc_vex3(c, 0, 0, 1, 1, 0, 6, 1, 1, 0x59); mc_b2(c, 0x75, 32)
        mc_vex3(c, 0, 0, 1, 1, 0, 7, 1, 1, 0x59); mc_b2(c, 0x7D, 32)
        mc_vex256(c, 1, 11, 8, 8, 0x59); mc_vex256(c, 1, 12, 9, 9, 0x59)
        mc_vex3(c, 1, 0, 1, 2, 1, 6, 1, 1, 0xAC); mc_b2(c, 0x5D, 64)
        mc_vex3(c, 1, 0, 1, 2, 1, 7, 1, 1, 0xAC); mc_b2(c, 0x65, 64)
        mc_vex256(c, 1, 8, 8, 11, 0x59); mc_vex256(c, 1, 9, 9, 12, 0x59)
        mc_vex256(c, 1, 11, 8, 8, 0x59); mc_vex256(c, 1, 12, 9, 9, 0x59)
        mc_vex3(c, 1, 0, 1, 2, 1, 6, 1, 1, 0xAC); mc_b2(c, 0x5D, 64)
        mc_vex3(c, 1, 0, 1, 2, 1, 7, 1, 1, 0xAC); mc_b2(c, 0x65, 64)
        mc_vex256(c, 1, 8, 8, 11, 0x59); mc_vex256(c, 1, 9, 9, 12, 0x59)
        // Y6 = s0 = y0^3, Y7 = s1 = y1^3
        mc_vex256(c, 1, 11, 8, 8, 0x59); mc_vex256(c, 1, 12, 9, 9, 0x59)
        mc_vex256(c, 1, 6, 11, 8, 0x59); mc_vex256(c, 1, 7, 12, 9, 0x59)
        // Upper-triangle mask if RBP != 0 (only 1st partial block!)
        mc_b3(c, 0x48, 0x85, 0xED); jz_nbs_um := mc_jcc8(c, 0x74)
        mc_b3(c, 0x48, 0x89, 0xF8); mc_b4(c, 0x48, 0x83, 0xE0, 7); mc_b4(c, 0x48, 0xC1, 0xE0, 6)
        mc_vex3(c, 0, 0, 1, 1, 0, 6, 1, 1, 0x54); mc_b2(c, 0xB4, 0x05); mc_u32(c, 128) // VANDPD Y6, Y6, [R13+RAX+128]
        mc_vex3(c, 0, 0, 1, 1, 0, 7, 1, 1, 0x54); mc_b2(c, 0xBC, 0x05); mc_u32(c, 160) // VANDPD Y7, Y7, [R13+RAX+160]
        mc_b2(c, 0x31, 0xED)
        mc_patch_jcc8(c, jz_nbs_um, buf_len(c))
        // Body i update: smj0 = s0*pm[j], smj1 = s1*pm[j+4] -> Y13, Y14, Y15
        mc_vex3(c, 1, 0, 1, 1, 0, 6, 1, 1, 0x59); mc_b2(c, 0x04, 0xCB)     // Y8 = Y6 * [R11+RCX*8]
        mc_vex3(c, 1, 0, 1, 1, 0, 7, 1, 1, 0x59); mc_b3(c, 0x4C, 0xCB, 32) // Y9 = Y7 * [R11+RCX*8+32]
        mc_vex3(c, 1, 0, 1, 2, 1, 0, 1, 1, 0xB8); mc_b1(c, 0xE8)           // Y13 += Y0 * Y8
        mc_vex3(c, 1, 0, 1, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xE9)           // Y13 += Y1 * Y9
        mc_vex3(c, 1, 0, 1, 2, 1, 2, 1, 1, 0xB8); mc_b1(c, 0xF0)           // Y14 += Y2 * Y8
        mc_vex3(c, 1, 0, 1, 2, 1, 3, 1, 1, 0xB8); mc_b1(c, 0xF1)           // Y14 += Y3 * Y9
        mc_vex3(c, 1, 0, 1, 2, 1, 4, 1, 1, 0xB8); mc_b1(c, 0xF8)           // Y15 += Y4 * Y8
        mc_vex3(c, 1, 0, 1, 2, 1, 5, 1, 1, 0xB8); mc_b1(c, 0xF9)           // Y15 += Y5 * Y9
        // Newton 3rd Law body j update: smi0 = s0*mi, smi1 = s1*mi -> ax_t[j], ay_t[j], az_t[j] -= smi*d
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x1C, 0xFB)     // Y11 = bcast(pm[i])
        mc_vex256(c, 1, 6, 6, 11, 0x59); mc_vex256(c, 1, 7, 7, 11, 0x59)
        // ax_t [R12]
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xCC)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x4C, 0xCC, 32)
        mc_vex3(c, 1, 0, 0, 2, 1, 6, 1, 1, 0xBC); mc_b1(c, 0xC0)           // Y8 -= Y6 * Y0
        mc_vex3(c, 1, 0, 0, 2, 1, 7, 1, 1, 0xBC); mc_b1(c, 0xC9)           // Y9 -= Y7 * Y1
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x04, 0xCC)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b3(c, 0x4C, 0xCC, 32)
        // ay_t [R14]
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xCE)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x4C, 0xCE, 32)
        mc_vex3(c, 1, 0, 0, 2, 1, 6, 1, 1, 0xBC); mc_b1(c, 0xC2)           // Y8 -= Y6 * Y2
        mc_vex3(c, 1, 0, 0, 2, 1, 7, 1, 1, 0xBC); mc_b1(c, 0xCB)           // Y9 -= Y7 * Y3
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x04, 0xCE)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b3(c, 0x4C, 0xCE, 32)
        // az_t [R15]
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xCF)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x4C, 0xCF, 32)
        mc_vex3(c, 1, 0, 0, 2, 1, 6, 1, 1, 0xBC); mc_b1(c, 0xC4)           // Y8 -= Y6 * Y4
        mc_vex3(c, 1, 0, 0, 2, 1, 7, 1, 1, 0xBC); mc_b1(c, 0xCD)           // Y9 -= Y7 * Y5
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x04, 0xCF)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b3(c, 0x4C, 0xCF, 32)
        mc_b4(c, 0x48, 0x83, 0xC1, 8)
        j_nbs_j8 := mc_jmp32(c); mc_patch_rel32(c, j_nbs_j8, lp_nbs_j8)

        // Add hsum(Y13..15) into ax_t[i], ay_t[i], az_t[i]
        mc_patch_rel32(c, jge_nbs_jdn, buf_len(c))
        _mc_vhsum_pd_to_xmm0(c, 13)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x04, 0xFC) // X0 += [R12+RDI*8]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xFC)
        _mc_vhsum_pd_to_xmm0(c, 14)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x04, 0xFE) // X0 += [R14+RDI*8]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xFE)
        _mc_vhsum_pd_to_xmm0(c, 15)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x04, 0xFF) // X0 += [R15+RDI*8]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xFF)

        mc_patch_rel32(c, jge_nbs_iskip, buf_len(c))
        mc_b3(c, 0x48, 0xFF, 0xC6); mc_b4(c, 0x48, 0x83, 0xFE, 2)
        jl_nbs_ph := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_nbs_ph, lp_nbs_ph)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 200); mc_b3(c, 0x48, 0x01, 0xC0) // RAX = 2*nt
        mc_b4(c, 0x48, 0x01, 0x84, 0x24); mc_u32(c, 296)                             // g += 2*nt
        j_nbs_g := mc_jmp32(c); mc_patch_rel32(c, j_nbs_g, lp_nbs_g)
        mc_patch_rel32(c, jge_nbs_gdn, buf_len(c))

        // Barrier 1: epoch = st*2 + 1
        mc_b4(c, 0x48, 0x8B, 0xB4, 0x24); mc_u32(c, 272) // RSI = st
        mc_b4(c, 0x48, 0x8D, 0x74, 0x36); mc_b1(c, 1)    // RSI = st*2 + 1
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 168) // RAX = barr
        mc_b4(c, 0x48, 0x8B, 0x8C, 0x24); mc_u32(c, 192); mc_b4(c, 0x48, 0xC1, 0xE1, 6)
        mc_b4(c, 0x48, 0x89, 0x34, 0x08)                 // [barr+tid*64] = ep1
        mc_b4(c, 0x48, 0x8B, 0xBC, 0x24); mc_u32(c, 200) // RDI = nt
        mc_b2(c, 0x31, 0xD2)
        lp_nbs_b1w := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xFA); jge_nbs_b1d := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE1, 6)
        mc_b1(c, 0xBD); mc_u32(c, 64)
        lp_nbs_b1p := buf_len(c)
        mc_b4(c, 0x48, 0x39, 0x34, 0x08); jge_nbs_b1t := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x48, 0xFF, 0xCD); jg_nbs_b1np := mc_jcc8(c, 0x7F); mc_patch_jcc8(c, jg_nbs_b1np, lp_nbs_b1p)
        mc_b2(c, 0xF3, 0x90); j_nbs_b1p := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_nbs_b1p, lp_nbs_b1p)
        mc_patch_jcc8(c, jge_nbs_b1t, buf_len(c))
        mc_b3(c, 0x48, 0xFF, 0xC2); j_nbs_b1w := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_nbs_b1w, lp_nbs_b1w)
        mc_patch_jcc8(c, jge_nbs_b1d, buf_len(c))

        // Parallel AVX2 4-wide reduction & velocity/position integration over k = i0..i1!
        mc_b4(c, 0x48, 0x8B, 0x8C, 0x24); mc_u32(c, 208) // RCX = k = i0
        mc_b4(c, 0x48, 0x8B, 0xB4, 0x24); mc_u32(c, 216) // RSI = i1
        mc_b4(c, 0x4C, 0x8B, 0xA4, 0x24); mc_u32(c, 248) // R12 = vx
        mc_b4(c, 0x4C, 0x8B, 0xB4, 0x24); mc_u32(c, 256) // R14 = vy
        mc_b4(c, 0x4C, 0x8B, 0xBC, 0x24); mc_u32(c, 264) // R15 = vz
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x5D, 0) // Y3 = dt (0.01)
        mc_b4(c, 0x48, 0x8B, 0x9C, 0x24); mc_u32(c, 176); mc_b4(c, 0x48, 0xC1, 0xE3, 3) // RBX = n*8
        lp_nbs_red4 := buf_len(c)
        mc_b4(c, 0x48, 0x8D, 0x41, 4); mc_b3(c, 0x48, 0x39, 0xF0); jg_nbs_red1 := mc_jcc32(c, 0x8F)
        mc_vex256(c, 1, 0, 0, 0, 0x57); mc_vex256(c, 1, 1, 1, 1, 0x57); mc_vex256(c, 1, 2, 2, 2, 0x57)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 280) // RAX = ptr = acc_base
        mc_b4(c, 0x48, 0x8B, 0x94, 0x24); mc_u32(c, 200) // RDX = t_rem = nt
        lp_nbs_rt4 := buf_len(c)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x58); mc_b2(c, 0x04, 0xC8) // Y0 += [RAX + RCX*8]
        mc_b4(c, 0x48, 0x8D, 0x2C, 0x18)                               // RBP = RAX + n*8
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 1, 1, 0x58); mc_b3(c, 0x4C, 0xCD, 0) // Y1 += [RBP + RCX*8 + 0]
        mc_b3(c, 0x48, 0x01, 0xDD)                                     // RBP += n*8
        mc_vex3(c, 0, 0, 0, 1, 0, 2, 1, 1, 0x58); mc_b3(c, 0x54, 0xCD, 0) // Y2 += [RBP + RCX*8 + 0]
        mc_b2(c, 0x48, 0x05); mc_u32(c, 2560)
        mc_b3(c, 0x48, 0xFF, 0xCA); jnz_nbs_rt4 := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_nbs_rt4, lp_nbs_rt4)
        // vx/px, vy/py, vz/pz update (4-wide FMA3!)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x24, 0xCC) // Y4 = vx[k]
        mc_vex3(c, 0, 0, 0, 2, 1, 0, 1, 1, 0xB8); mc_b1(c, 0xE3)       // Y4 += Y0 * Y3
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x24, 0xCC) // vx[k] = Y4
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x2C, 0xC8) // Y5 = px[k]
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b1(c, 0xEB)       // Y5 += Y4 * Y3
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x2C, 0xC8) // px[k] = Y5

        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x24, 0xCE) // Y4 = vy[k]
        mc_vex3(c, 0, 0, 0, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xE3)       // Y4 += Y1 * Y3
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x24, 0xCE) // vy[k] = Y4
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x2C, 0xC9) // Y5 = py[k]
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b1(c, 0xEB)       // Y5 += Y4 * Y3
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x2C, 0xC9) // py[k] = Y5

        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x24, 0xCF) // Y4 = vz[k]
        mc_vex3(c, 0, 0, 0, 2, 1, 2, 1, 1, 0xB8); mc_b1(c, 0xE3)       // Y4 += Y2 * Y3
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x24, 0xCF) // vz[k] = Y4
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x2C, 0xCA) // Y5 = pz[k]
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b1(c, 0xEB)       // Y5 += Y4 * Y3
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x2C, 0xCA) // pz[k] = Y5

        mc_b4(c, 0x48, 0x83, 0xC1, 4)
        j_nbs_r4 := mc_jmp32(c); mc_patch_rel32(c, j_nbs_r4, lp_nbs_red4)

        // Scalar tail k < i1 (for nt where (i1-i0) % 4 != 0)
        mc_patch_rel32(c, jg_nbs_red1, buf_len(c))
        lp_nbs_red1 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xF1); jge_nbs_rdn := mc_jcc32(c, 0x8D)
        mc_vex256(c, 1, 0, 0, 0, 0x57); mc_vex256(c, 1, 1, 1, 1, 0x57); mc_vex256(c, 1, 2, 2, 2, 0x57)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 280)
        mc_b4(c, 0x48, 0x8B, 0x94, 0x24); mc_u32(c, 200)
        lp_nbs_rt1 := buf_len(c)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x04, 0xC8)
        mc_b4(c, 0x48, 0x8D, 0x2C, 0x18)
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 0, 3, 0x58); mc_b3(c, 0x4C, 0xCD, 0)
        mc_b3(c, 0x48, 0x01, 0xDD)
        mc_vex3(c, 0, 0, 0, 1, 0, 2, 0, 3, 0x58); mc_b3(c, 0x54, 0xCD, 0)
        mc_b2(c, 0x48, 0x05); mc_u32(c, 2560)
        mc_b3(c, 0x48, 0xFF, 0xCA); jnz_nbs_rt1 := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_nbs_rt1, lp_nbs_rt1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC3) // X0 *= dt
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x04, 0xCC); mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xCC)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC3)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x04, 0xC8); mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xC8)
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 0, 3, 0x59); mc_b1(c, 0xCB)
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 0, 3, 0x58); mc_b2(c, 0x0C, 0xCE); mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x0C, 0xCE)
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 0, 3, 0x59); mc_b1(c, 0xCB)
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 0, 3, 0x58); mc_b2(c, 0x0C, 0xC9); mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x0C, 0xC9)
        mc_vex3(c, 0, 0, 0, 1, 0, 2, 0, 3, 0x59); mc_b1(c, 0xD3)
        mc_vex3(c, 0, 0, 1, 1, 0, 2, 0, 3, 0x58); mc_b2(c, 0x14, 0xCF); mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x14, 0xCF)
        mc_vex3(c, 0, 0, 0, 1, 0, 2, 0, 3, 0x59); mc_b1(c, 0xD3)
        mc_vex3(c, 0, 0, 1, 1, 0, 2, 0, 3, 0x58); mc_b2(c, 0x14, 0xCA); mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x14, 0xCA)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_nbs_r1 := mc_jmp32(c); mc_patch_rel32(c, j_nbs_r1, lp_nbs_red1)
        mc_patch_rel32(c, jge_nbs_rdn, buf_len(c))

        // Barrier 2: epoch = st*2 + 2
        mc_b4(c, 0x48, 0x8B, 0xB4, 0x24); mc_u32(c, 272)
        mc_b4(c, 0x48, 0x8D, 0x74, 0x36); mc_b1(c, 2)    // RSI = st*2 + 2
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 168)
        mc_b4(c, 0x48, 0x8B, 0x8C, 0x24); mc_u32(c, 192); mc_b4(c, 0x48, 0xC1, 0xE1, 6)
        mc_b4(c, 0x48, 0x89, 0x34, 0x08)
        mc_b4(c, 0x48, 0x8B, 0xBC, 0x24); mc_u32(c, 200)
        mc_b2(c, 0x31, 0xD2)
        lp_nbs_b2w := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xFA); jge_nbs_b2d := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE1, 6)
        mc_b1(c, 0xBD); mc_u32(c, 64)
        lp_nbs_b2p := buf_len(c)
        mc_b4(c, 0x48, 0x39, 0x34, 0x08); jge_nbs_b2t := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x48, 0xFF, 0xCD); jg_nbs_b2np := mc_jcc8(c, 0x7F); mc_patch_jcc8(c, jg_nbs_b2np, lp_nbs_b2p)
        mc_b2(c, 0xF3, 0x90); j_nbs_b2p := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_nbs_b2p, lp_nbs_b2p)
        mc_patch_jcc8(c, jge_nbs_b2t, buf_len(c))
        mc_b3(c, 0x48, 0xFF, 0xC2); j_nbs_b2w := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_nbs_b2w, lp_nbs_b2w)
        mc_patch_jcc8(c, jge_nbs_b2d, buf_len(c))

        mc_b4(c, 0x48, 0xFF, 0x84, 0x24); mc_u32(c, 272) // st++
        j_nbs_st := mc_jmp32(c); mc_patch_rel32(c, j_nbs_st, lp_nbs_st)
        mc_patch_rel32(c, jge_nbs_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)

        mc_patch_rel32(c, jmp_nbp_end, buf_len(c))
        mc_patch_rel32(c, jmp_nbps_end, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0x138)
        cg_reg_helper(cg, h_ai_nbody_par_f64(), s_nbp, buf_len(c))
    }

    // 67. `h_ai_conv1d_k9_f32(px, pd, i0, i1) -> f64`: 4-wide IEEE-754 f64 AVX2+FMA3 9-tap symmetric conv1d!
    if cg_is_helper_used(cg, h_ai_conv1d_k9_f32()) {
        while (buf_len(cg.rdata) & 15) != 0 { buf_push(cg.rdata, 0) }
        roff_c1d := buf_len(cg.rdata)
        buf_push_u64(cg.rdata, 0x3FA999999999999A) // +0:  0.05
        buf_push_u64(cg.rdata, 0x3FB999999999999A) // +8:  0.10
        buf_push_u64(cg.rdata, 0x3FBEB851EB851EB8) // +16: 0.12
        buf_push_u64(cg.rdata, 0x3FC3333333333333) // +24: 0.15
        buf_push_u64(cg.rdata, 0x3FC47AE147AE147B) // +32: 0.16

        mc_align16(c)
        s_c1d := buf_len(c)
        mc_ai_enter(c, 0xB8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = px (f32)
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = pd (f32)
        mc_b4(c, 0x4C, 0x8B, 0x51, 24)   // R10 = i1 (read BEFORE overwriting RCX!)
        mc_b4(c, 0x48, 0x8B, 0x49, 16)   // RCX = i = i0
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) // XORPD X0, X0 (acc = 0.0)
        mc_b3(c, 0x4C, 0x39, 0xD1); jge_c1d_dn := mc_jcc32(c, 0x8D)
        cg_lea_rax_rdata(cg, roff_c1d)
        mc_b3(c, 0x49, 0x89, 0xC3)       // R11 = &consts

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_c1d_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x4D, 0x8D, 0x62, 0xF8) // R12 = i1 - 8
        mc_b3(c, 0x4C, 0x39, 0xE1); jg_c1d_tl := mc_jcc32(c, 0x8F)
        mc_b4(c, 0x49, 0x8D, 0x04, 0x89); mc_b2(c, 0xA8, 31); jnz_c1d_ua := mc_jcc32(c, 0x85)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x13)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x5B, 8)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x63, 16)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x6B, 24)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x73, 32)
        mc_vex256(c, 1, 15, 15, 15, 0x57)
        mc_align16_nop(c)
        lp_c1d4 := buf_len(c)
        mc_b4(c, 0x41, 0x0F, 0x18, 0x84); mc_b1(c, 0x88); mc_u32(c, 512)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b3(c, 0x6C, 0x88, 16)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b3(c, 0x74, 0x88, 20)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b3(c, 0x7C, 0x88, 24)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b3(c, 0x44, 0x88, 28)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b3(c, 0x4C, 0x88, 32)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b2(c, 0x1C, 0x88)
        mc_vex256(c, 1, 3, 3, 9, 0x58); mc_vex256(c, 1, 3, 3, 10, 0x59)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b3(c, 0x4C, 0x88, 4)
        mc_vex256(c, 1, 1, 1, 8, 0x58); mc_vex3(c, 0, 0, 1, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xDB)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b3(c, 0x4C, 0x88, 8)
        mc_vex256(c, 1, 1, 1, 7, 0x58); mc_vex3(c, 0, 0, 1, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xDC)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b3(c, 0x4C, 0x88, 12)
        mc_vex256(c, 1, 1, 1, 6, 0x58); mc_vex3(c, 0, 0, 1, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xDD)
        mc_vex3(c, 0, 0, 1, 2, 1, 5, 1, 1, 0xB8); mc_b1(c, 0xDE)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b3(c, 0x44, 0x88, 48)
        mc_vex256(c, 1, 0, 0, 5, 0x58); mc_vex256(c, 1, 0, 0, 10, 0x59)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b3(c, 0x4C, 0x88, 44)
        mc_vex256(c, 1, 1, 1, 6, 0x58); mc_vex3(c, 0, 0, 1, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xC3)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b3(c, 0x4C, 0x88, 40)
        mc_vex256(c, 1, 1, 1, 7, 0x58); mc_vex3(c, 0, 0, 1, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xC4)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b3(c, 0x4C, 0x88, 36)
        mc_vex256(c, 1, 1, 1, 8, 0x58); mc_vex3(c, 0, 0, 1, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xC5)
        mc_vex3(c, 0, 0, 1, 2, 1, 9, 1, 1, 0xB8); mc_b1(c, 0xC6)
        mc_vex256(c, 1, 15, 15, 3, 0x58); mc_vex256(c, 1, 15, 15, 0, 0x58)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x5A); mc_b1(c, 0xCB)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x5A); mc_b1(c, 0xD0)
        mc_vex3(c, 0, 0, 0, 3, 0, 1, 1, 1, 0x18); mc_b2(c, 0xCA, 1)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x2B); mc_b2(c, 0x0C, 0x89)
        mc_b4(c, 0x48, 0x83, 0xC1, 8); mc_b3(c, 0x4C, 0x39, 0xE1)
        jle_c1d4 := mc_jcc32(c, 0x8E); mc_patch_rel32(c, jle_c1d4, lp_c1d4)
        // Hsum Y15 -> X0
        mc_vex3(c, 1, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xF8, 1)         // VEXTRACTF128 X0, Y15, 1
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 1, 0x58); mc_b1(c, 0xC7)            // VADDPD X0, X0, X15
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x15); mc_b1(c, 0xC8)            // VUNPCKHPD X1, X0, X0
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b1(c, 0xC1)            // VADDSD X0, X0, X1
        mc_b3(c, 0x0F, 0xAE, 0xF8) // SFENCE
        mc_b3(c, 0xC5, 0xF8, 0x77)

        // Exact scalar SSE2 tail + --simd=scalar
        mc_patch_rel32(c, jnz_c1d_ua, buf_len(c))
        mc_patch_rel32(c, jg_c1d_tl, buf_len(c))
        mc_patch_rel32(c, jz_c1d_sc, buf_len(c))
        lp_c1ds := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jge_c1ds := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x5A); mc_b2(c, 0x0C, 0x88)          // CVTSS2SD X1, [R8+RCX*4]
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x5A); mc_b3(c, 0x54, 0x88, 32)      // CVTSS2SD X2, [R8+RCX*4+32]
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xCA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0x0B)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x5A); mc_b3(c, 0x54, 0x88, 4)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x5A); mc_b3(c, 0x5C, 0x88, 28)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xD3); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x53, 8); mc_b4(c, 0xF2, 0x0F, 0x58, 0xCA)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x5A); mc_b3(c, 0x54, 0x88, 8)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x5A); mc_b3(c, 0x5C, 0x88, 24)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xD3); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x53, 16); mc_b4(c, 0xF2, 0x0F, 0x58, 0xCA)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x5A); mc_b3(c, 0x54, 0x88, 12)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x5A); mc_b3(c, 0x5C, 0x88, 20)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xD3); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x53, 24); mc_b4(c, 0xF2, 0x0F, 0x58, 0xCA)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x5A); mc_b3(c, 0x54, 0x88, 16)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x53, 32); mc_b4(c, 0xF2, 0x0F, 0x58, 0xCA)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)                                // ADDSD X0, X1
        mc_b4(c, 0xF2, 0x0F, 0x5A, 0xC9)                                // CVTSD2SS X1, X1
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x11); mc_b2(c, 0x0C, 0x89)          // MOVSS [R9+RCX*4], X1
        mc_b3(c, 0x48, 0xFF, 0xC1); j_c1ds := mc_jmp32(c); mc_patch_rel32(c, j_c1ds, lp_c1ds)

        mc_patch_rel32(c, jge_c1ds, buf_len(c))
        mc_patch_rel32(c, jge_c1d_dn, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0) // MOVQ RAX, X0
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_conv1d_k9_f32(), s_c1d, buf_len(c))
    }

    // 68. `h_ai_hist256_u8(p, i0, i1, hb4k) -> i64`: Direct-MOVZX 4-bank L1D u32 hist + native reduce when p==0!
    if cg_is_helper_used(cg, h_ai_hist256_u8()) {
        mc_align16(c)
        s_hu := buf_len(c)
        mc_ai_enter(c, 0x18)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = p (or 0 => reduce nt=i0 threads at stride=i1 from hb4k -> sum(c*(b+1)))
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = i = i0 (or nt)
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = i1 (or stride)
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = b0 = hb4k
        mc_b3(c, 0x4D, 0x85, 0xC0); jnz_hu_work := mc_jcc32(c, 0x85)
        // Native reduce mode (p==0): R11=hbuf, R9=nt, R10=stride -> RAX = sum_{b=0..255} (sum_t u32[hbuf+t*stride+b*4]) * (b+1)
        mc_b2(c, 0x31, 0xC0) // RAX = acc
        mc_b2(c, 0x31, 0xC9) // RCX = b = 0..255
        lp_hur_b := buf_len(c)
        mc_b3(c, 0x48, 0x81, 0xF9); mc_u32(c, 256); jge_hur_dn := mc_jcc8(c, 0x7D)
        mc_b2(c, 0x31, 0xD2) // RDX = c = 0
        mc_b4(c, 0x49, 0x8D, 0x34, 0x8B) // RSI = &hbuf[0][b]
        mc_b3(c, 0x4C, 0x89, 0xCF)       // RDI = nt
        lp_hur_t := buf_len(c)
        mc_b2(c, 0x8B, 0x1E); mc_b3(c, 0x48, 0x01, 0xDA) // RDX += u32 [RSI]
        mc_b3(c, 0x4C, 0x01, 0xD6); mc_b3(c, 0x48, 0xFF, 0xCF)
        jnz_hurt := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_hurt, lp_hur_t)
        mc_b4(c, 0x48, 0x8D, 0x71, 1); mc_b4(c, 0x48, 0x0F, 0xAF, 0xD6); mc_b3(c, 0x48, 0x01, 0xD0)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_hurb := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_hurb, lp_hur_b)
        mc_patch_jcc8(c, jge_hur_dn, buf_len(c))
        mc_ai_leave(c, 0x18)

        mc_patch_rel32(c, jnz_hu_work, buf_len(c))
        // Zero 4096B (512 qwords)
        mc_b3(c, 0x4C, 0x89, 0xDF); mc_b2(c, 0x31, 0xC0); mc_b1(c, 0xB9); mc_u32(c, 512)
        mc_b3(c, 0xF3, 0x48, 0xAB)       // REP STOSQ
        mc_b3(c, 0x49, 0x8D, 0xB3); mc_u32(c, 1024) // RSI = b1
        mc_b3(c, 0x49, 0x8D, 0xBB); mc_u32(c, 2048) // RDI = b2
        mc_b3(c, 0x49, 0x8D, 0x9B); mc_u32(c, 3072) // RBX = b3
        mc_b4(c, 0x4D, 0x8D, 0x7A, 0xF0)            // R15 = i1 - 16
        mc_align16_nop(c)
        lp_hu8 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xF9); jg_hu_tl := mc_jcc32(c, 0x8F)
        mc_b4(c, 0x43, 0x0F, 0x18, 0x84); mc_b1(c, 0x08); mc_u32(c, 512) // PREFETCHNTA [R8+R9+512]
        // 2-qword (16B/iter) interleaved loads -> 4 banks, ZERO AH stalls, 2 loads per 16 bytes!
        mc_b4(c, 0x4B, 0x8B, 0x04, 0x08)                             // RAX = [R8+R9]
        mc_b4(c, 0x4F, 0x8B, 0x64, 0x08); mc_b1(c, 8)                // R12 = [R8+R9+8]
        mc_b3(c, 0x0F, 0xB6, 0xD0); mc_b4(c, 0x41, 0xFF, 0x04, 0x93) // b0[a0]++
        mc_b4(c, 0x41, 0x0F, 0xB6, 0xCC); mc_b3(c, 0xFF, 0x04, 0x8E) // b1[b0]++
        mc_b4(c, 0x48, 0xC1, 0xE8, 8); mc_b4(c, 0x49, 0xC1, 0xEC, 8)
        mc_b3(c, 0x0F, 0xB6, 0xD0); mc_b3(c, 0xFF, 0x04, 0x97)       // b2[a1]++
        mc_b4(c, 0x41, 0x0F, 0xB6, 0xCC); mc_b3(c, 0xFF, 0x04, 0x8B) // b3[b1]++
        mc_b4(c, 0x48, 0xC1, 0xE8, 8); mc_b4(c, 0x49, 0xC1, 0xEC, 8)
        mc_b3(c, 0x0F, 0xB6, 0xD0); mc_b4(c, 0x41, 0xFF, 0x04, 0x93) // b0[a2]++
        mc_b4(c, 0x41, 0x0F, 0xB6, 0xCC); mc_b3(c, 0xFF, 0x04, 0x8E) // b1[b2]++
        mc_b4(c, 0x48, 0xC1, 0xE8, 8); mc_b4(c, 0x49, 0xC1, 0xEC, 8)
        mc_b3(c, 0x0F, 0xB6, 0xD0); mc_b3(c, 0xFF, 0x04, 0x97)       // b2[a3]++
        mc_b4(c, 0x41, 0x0F, 0xB6, 0xCC); mc_b3(c, 0xFF, 0x04, 0x8B) // b3[b3]++
        mc_b4(c, 0x48, 0xC1, 0xE8, 8); mc_b4(c, 0x49, 0xC1, 0xEC, 8)
        mc_b3(c, 0x0F, 0xB6, 0xD0); mc_b4(c, 0x41, 0xFF, 0x04, 0x93) // b0[a4]++
        mc_b4(c, 0x41, 0x0F, 0xB6, 0xCC); mc_b3(c, 0xFF, 0x04, 0x8E) // b1[b4]++
        mc_b4(c, 0x48, 0xC1, 0xE8, 8); mc_b4(c, 0x49, 0xC1, 0xEC, 8)
        mc_b3(c, 0x0F, 0xB6, 0xD0); mc_b3(c, 0xFF, 0x04, 0x97)       // b2[a5]++
        mc_b4(c, 0x41, 0x0F, 0xB6, 0xCC); mc_b3(c, 0xFF, 0x04, 0x8B) // b3[b5]++
        mc_b4(c, 0x48, 0xC1, 0xE8, 8); mc_b4(c, 0x49, 0xC1, 0xEC, 8)
        mc_b3(c, 0x0F, 0xB6, 0xD0); mc_b4(c, 0x41, 0xFF, 0x04, 0x93) // b0[a6]++
        mc_b4(c, 0x41, 0x0F, 0xB6, 0xCC); mc_b3(c, 0xFF, 0x04, 0x8E) // b1[b6]++
        mc_b4(c, 0x48, 0xC1, 0xE8, 8); mc_b4(c, 0x49, 0xC1, 0xEC, 8)
        mc_b3(c, 0x0F, 0xB6, 0xD0); mc_b3(c, 0xFF, 0x04, 0x97)       // b2[a7]++
        mc_b4(c, 0x41, 0x0F, 0xB6, 0xCC); mc_b3(c, 0xFF, 0x04, 0x8B) // b3[b7]++
        mc_b4(c, 0x49, 0x83, 0xC1, 16); j_hu8 := mc_jmp32(c); mc_patch_rel32(c, j_hu8, lp_hu8)
        mc_patch_rel32(c, jg_hu_tl, buf_len(c))
        lp_hut := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_hut := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x43, 0x0F, 0xB6, 0x04); mc_b1(c, 0x08) // MOVZX EAX, BYTE [R8+R9]
        mc_b4(c, 0x41, 0xFF, 0x04, 0x83)                 // INC DWORD [R11+RAX*4]
        mc_b3(c, 0x49, 0xFF, 0xC1); j_hut := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_hut, lp_hut)
        mc_patch_jcc8(c, jge_hut, buf_len(c))
        // Merge b1+b2+b3 into b0[0..255]
        mc_b2(c, 0x31, 0xC9) // RCX = 0
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_hum_sc := mc_jcc8(c, 0x74)
        lp_humv := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x04, 0x8B) // Y0 = b0[c..c+7]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xFE); mc_b2(c, 0x04, 0x8E) // VPADDD Y0, Y0, [RSI+RCX*4]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xFE); mc_b2(c, 0x04, 0x8F) // VPADDD Y0, Y0, [RDI+RCX*4]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xFE); mc_b2(c, 0x04, 0x8B) // VPADDD Y0, Y0, [RBX+RCX*4]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x04, 0x8B) // b0[c..c+7] = Y0
        mc_b4(c, 0x48, 0x83, 0xC1, 8); mc_b3(c, 0x48, 0x81, 0xF9); mc_u32(c, 256)
        jl_humv := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_humv, lp_humv)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_hum_dn := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jz_hum_sc, buf_len(c))
        lp_hums := buf_len(c)
        mc_b4(c, 0x41, 0x8B, 0x04, 0x8B); mc_b3(c, 0x03, 0x04, 0x8E)
        mc_b3(c, 0x03, 0x04, 0x8F); mc_b3(c, 0x03, 0x04, 0x8B)
        mc_b4(c, 0x41, 0x89, 0x04, 0x8B)
        mc_b3(c, 0x48, 0xFF, 0xC1); mc_b3(c, 0x48, 0x81, 0xF9); mc_u32(c, 256)
        jl_hums := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_hums, lp_hums)
        mc_patch_jcc8(c, jmp_hum_dn, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_ai_leave(c, 0x18)
        cg_reg_helper(cg, h_ai_hist256_u8(), s_hu, buf_len(c))
    }

    // 69. `h_ai_parse_i64_10d(bp, stride, r0, r1) -> i64`: 2x-unrolled pure-register SWAR 10-digit decimal parser (B021)
    if cg_is_helper_used(cg, h_ai_parse_i64_10d()) {
        mc_align16(c)
        s_p10 := buf_len(c)
        mc_ai_enter(c, 0x18)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = bp
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = stride
        mc_b4(c, 0x48, 0x8B, 0x41, 16)   // RAX = r0
        mc_b4(c, 0x4C, 0x8B, 0x51, 24)   // R10 = r1
        mc_b3(c, 0x49, 0x29, 0xC2)       // R10 = cnt = r1 - r0
        mc_b2(c, 0x31, 0xF6)             // R14/acc init: wait use R14, R15
        mc_b3(c, 0x4D, 0x31, 0xF6)       // R14 = 0
        mc_b3(c, 0x4D, 0x31, 0xFF)       // R15 = 0
        mc_b3(c, 0x4D, 0x85, 0xD2); jle_p10_dn := mc_jcc32(c, 0x8E)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC1) // RAX = r0 * stride
        mc_b3(c, 0x49, 0x01, 0xC0)       // R8  = p0 = bp + r0 * stride
        mc_b4(c, 0x4B, 0x8D, 0x34, 0x08) // RSI = p1 = p0 + stride
        mc_b4(c, 0x4B, 0x8D, 0x3C, 0x09) // RDI = 2 * stride
        mc_b2(c, 0x49, 0xBB); mc_u64(c, 0x3030303030303030) // R11 = z8
        mc_b2(c, 0x49, 0xBC); mc_u64(c, 0x00FF00FF00FF00FF) // R12 = m8
        mc_b2(c, 0x49, 0xBD); mc_u64(c, 0x0000FFFF0000FFFF) // R13 = m16
        mc_b4(c, 0x49, 0x83, 0xEA, 2); jl_p10_tl := mc_jcc32(c, 0x8C)
        mc_align16_nop(c)
        lp_p10_2 := buf_len(c)
        mc_b3(c, 0x49, 0x8B, 0x00)       // RAX = [R8]
        mc_b3(c, 0x48, 0x8B, 0x16)       // RDX = [RSI]
        mc_b3(c, 0x4C, 0x29, 0xD8)       // RAX -= z8
        mc_b3(c, 0x4C, 0x29, 0xDA)       // RDX -= z8
        mc_b3(c, 0x48, 0x89, 0xC1)       // RCX = RAX
        mc_b3(c, 0x48, 0x89, 0xD3)       // RBX = RDX
        mc_b3(c, 0x4C, 0x21, 0xE0)       // RAX &= m8
        mc_b3(c, 0x4C, 0x21, 0xE2)       // RDX &= m8
        mc_b4(c, 0x48, 0xC1, 0xE9, 8)    // RCX >>= 8
        mc_b4(c, 0x48, 0xC1, 0xEB, 8)    // RBX >>= 8
        mc_b4(c, 0x48, 0x6B, 0xC0, 10)   // RAX *= 10
        mc_b4(c, 0x48, 0x6B, 0xD2, 10)   // RDX *= 10
        mc_b3(c, 0x4C, 0x21, 0xE1)       // RCX &= m8
        mc_b3(c, 0x4C, 0x21, 0xE3)       // RBX &= m8
        mc_b3(c, 0x48, 0x01, 0xC8)       // RAX += RCX
        mc_b3(c, 0x48, 0x01, 0xDA)       // RDX += RBX
        mc_b3(c, 0x48, 0x89, 0xC1)       // RCX = RAX
        mc_b3(c, 0x48, 0x89, 0xD3)       // RBX = RDX
        mc_b3(c, 0x4C, 0x21, 0xE8)       // RAX &= m16
        mc_b3(c, 0x4C, 0x21, 0xEA)       // RDX &= m16
        mc_b4(c, 0x48, 0xC1, 0xE9, 16)   // RCX >>= 16
        mc_b4(c, 0x48, 0xC1, 0xEB, 16)   // RBX >>= 16
        mc_b4(c, 0x48, 0x6B, 0xC0, 100)  // RAX *= 100
        mc_b4(c, 0x48, 0x6B, 0xD2, 100)  // RDX *= 100
        mc_b3(c, 0x4C, 0x21, 0xE9)       // RCX &= m16
        mc_b3(c, 0x4C, 0x21, 0xEB)       // RBX &= m16
        mc_b3(c, 0x48, 0x01, 0xC8)       // RAX += RCX
        mc_b3(c, 0x48, 0x01, 0xDA)       // RDX += RBX
        mc_b2(c, 0x89, 0xC1)             // ECX = EAX (zero-ext 32)
        mc_b2(c, 0x89, 0xD3)             // EBX = EDX (zero-ext 32)
        mc_b4(c, 0x48, 0xC1, 0xE8, 32)   // RAX >>= 32
        mc_b4(c, 0x48, 0xC1, 0xEA, 32)   // RDX >>= 32
        mc_b3(c, 0x48, 0x69, 0xC9); mc_u32(c, 10000) // RCX *= 10000
        mc_b3(c, 0x48, 0x69, 0xDB); mc_u32(c, 10000) // RBX *= 10000
        mc_b3(c, 0x48, 0x01, 0xC8)       // RAX += RCX
        mc_b3(c, 0x48, 0x01, 0xDA)       // RDX += RBX
        mc_b4(c, 0x48, 0x6B, 0xC0, 100)  // RAX *= 100
        mc_b4(c, 0x48, 0x6B, 0xD2, 100)  // RDX *= 100
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x48); mc_b1(c, 8) // ECX = u8 [R8+8]
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x68); mc_b1(c, 9) // EBP = u8 [R8+9]
        mc_b4(c, 0x48, 0x8D, 0x0C, 0x89)              // RCX *= 5
        mc_b4(c, 0x48, 0x8D, 0x84, 0x48); mc_u32(c, -528) // RAX = RAX + RCX*2 - 528
        mc_b3(c, 0x48, 0x01, 0xE8)                    // RAX += RBP
        mc_b4(c, 0x0F, 0xB6, 0x5E, 8)                 // EBX = u8 [RSI+8]
        mc_b4(c, 0x0F, 0xB6, 0x6E, 9)                 // EBP = u8 [RSI+9]
        mc_b4(c, 0x48, 0x8D, 0x1C, 0x9B)              // RBX *= 5
        mc_b4(c, 0x48, 0x8D, 0x94, 0x5A); mc_u32(c, -528) // RDX = RDX + RBX*2 - 528
        mc_b3(c, 0x48, 0x01, 0xEA)                    // RDX += RBP
        mc_b3(c, 0x49, 0x01, 0xC6)                    // R14 += RAX
        mc_b3(c, 0x49, 0x01, 0xD7)                    // R15 += RDX
        mc_b3(c, 0x49, 0x01, 0xF8)                    // R8  += 2*stride
        mc_b3(c, 0x48, 0x01, 0xFE)                    // RSI += 2*stride
        mc_b4(c, 0x49, 0x83, 0xEA, 2)
        jge_p10 := mc_jcc32(c, 0x8D); mc_patch_rel32(c, jge_p10, lp_p10_2)
        mc_patch_rel32(c, jl_p10_tl, buf_len(c))
        mc_b4(c, 0x49, 0x83, 0xC2, 2); jle_p10_end := mc_jcc8(c, 0x7E)
        // 1-row tail at R8
        mc_b3(c, 0x49, 0x8B, 0x00); mc_b3(c, 0x4C, 0x29, 0xD8)
        mc_b3(c, 0x48, 0x89, 0xC1); mc_b3(c, 0x4C, 0x21, 0xE0); mc_b4(c, 0x48, 0xC1, 0xE9, 8)
        mc_b4(c, 0x48, 0x6B, 0xC0, 10); mc_b3(c, 0x4C, 0x21, 0xE1); mc_b3(c, 0x48, 0x01, 0xC8)
        mc_b3(c, 0x48, 0x89, 0xC1); mc_b3(c, 0x4C, 0x21, 0xE8); mc_b4(c, 0x48, 0xC1, 0xE9, 16)
        mc_b4(c, 0x48, 0x6B, 0xC0, 100); mc_b3(c, 0x4C, 0x21, 0xE9); mc_b3(c, 0x48, 0x01, 0xC8)
        mc_b2(c, 0x89, 0xC1); mc_b4(c, 0x48, 0xC1, 0xE8, 32)
        mc_b3(c, 0x48, 0x69, 0xC9); mc_u32(c, 10000); mc_b3(c, 0x48, 0x01, 0xC8)
        mc_b4(c, 0x48, 0x6B, 0xC0, 100)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x48); mc_b1(c, 8)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x68); mc_b1(c, 9)
        mc_b4(c, 0x48, 0x8D, 0x0C, 0x89)
        mc_b4(c, 0x48, 0x8D, 0x84, 0x48); mc_u32(c, -528)
        mc_b3(c, 0x48, 0x01, 0xE8); mc_b3(c, 0x49, 0x01, 0xC6)
        mc_patch_jcc8(c, jle_p10_end, buf_len(c))
        mc_patch_rel32(c, jle_p10_dn, buf_len(c))
        mc_b4(c, 0x4B, 0x8D, 0x04, 0x3E) // RAX = R14 + R15
        mc_ai_leave(c, 0x18)
        cg_reg_helper(cg, h_ai_parse_i64_10d(), s_p10, buf_len(c))
    }

    // 70. `h_ai_csv_4col_chunk(p, i0, end, out_max_ptr) -> i64`: Pure-register 4-col CSV parser + branchless CMOVG max (B025)
    if cg_is_helper_used(cg, h_ai_csv_4col_chunk()) {
        mc_align16(c)
        s_csv := buf_len(c)
        mc_ai_enter(c, 0x18)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = p
        mc_b4(c, 0x48, 0x8B, 0x71, 8)    // RSI = i0
        mc_b4(c, 0x48, 0x8B, 0x79, 16)   // RDI = end
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = out_max_ptr
        mc_b3(c, 0x4C, 0x01, 0xC6)       // RSI = p + i0
        mc_b3(c, 0x4C, 0x01, 0xC7)       // RDI = p + end
        mc_b3(c, 0x4D, 0x31, 0xF6)       // R14 = sum_v = 0
        mc_b3(c, 0x4D, 0x31, 0xFF)       // R15 = max_v = 0
        mc_align16_nop(c)
        lp_csv_row := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xFE); jae_csv_dn := mc_jcc32(c, 0x83)
        // Col 0 (delim ',')
        mc_b2(c, 0x31, 0xD2)
        lp_c0 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xFE); jae_c0 := mc_jcc8(c, 0x73)
        mc_b3(c, 0x0F, 0xB6, 0x06); mc_b3(c, 0x48, 0xFF, 0xC6)
        mc_b2(c, 0x3C, 44); je_c0 := mc_jcc8(c, 0x74)
        mc_b4(c, 0x48, 0x8D, 0x14, 0x92); mc_b4(c, 0x48, 0x8D, 0x54, 0x50); mc_b1(c, 0xD0) // RDX = RDX*10 + RAX - 48
        j_c0 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_c0, lp_c0)
        mc_patch_jcc8(c, jae_c0, buf_len(c)); mc_patch_jcc8(c, je_c0, buf_len(c))
        mc_b3(c, 0x49, 0x01, 0xD6) // sum_v += c0
        // Col 1 (delim ',')
        mc_b2(c, 0x31, 0xD2)
        lp_c1 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xFE); jae_c1 := mc_jcc8(c, 0x73)
        mc_b3(c, 0x0F, 0xB6, 0x06); mc_b3(c, 0x48, 0xFF, 0xC6)
        mc_b2(c, 0x3C, 44); je_c1 := mc_jcc8(c, 0x74)
        mc_b4(c, 0x48, 0x8D, 0x14, 0x92); mc_b4(c, 0x48, 0x8D, 0x54, 0x50); mc_b1(c, 0xD0)
        j_c1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_c1, lp_c1)
        mc_patch_jcc8(c, jae_c1, buf_len(c)); mc_patch_jcc8(c, je_c1, buf_len(c))
        mc_b3(c, 0x49, 0x01, 0xD6) // sum_v += c1
        // Col 2 (delim ',', track max_v)
        mc_b2(c, 0x31, 0xD2)
        lp_c2 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xFE); jae_c2 := mc_jcc8(c, 0x73)
        mc_b3(c, 0x0F, 0xB6, 0x06); mc_b3(c, 0x48, 0xFF, 0xC6)
        mc_b2(c, 0x3C, 44); je_c2 := mc_jcc8(c, 0x74)
        mc_b4(c, 0x48, 0x8D, 0x14, 0x92); mc_b4(c, 0x48, 0x8D, 0x54, 0x50); mc_b1(c, 0xD0)
        j_c2 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_c2, lp_c2)
        mc_patch_jcc8(c, jae_c2, buf_len(c)); mc_patch_jcc8(c, je_c2, buf_len(c))
        mc_b3(c, 0x49, 0x01, 0xD6)       // sum_v += c2
        mc_b3(c, 0x4C, 0x39, 0xFA)       // CMP RDX, R15
        mc_b4(c, 0x4C, 0x0F, 0x4F, 0xFA) // CMOVG R15, RDX
        // Col 3 (delim LF = 10)
        mc_b2(c, 0x31, 0xD2)
        lp_c3 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xFE); jae_c3 := mc_jcc8(c, 0x73)
        mc_b3(c, 0x0F, 0xB6, 0x06); mc_b3(c, 0x48, 0xFF, 0xC6)
        mc_b2(c, 0x3C, 10); je_c3 := mc_jcc8(c, 0x74)
        mc_b4(c, 0x48, 0x8D, 0x14, 0x92); mc_b4(c, 0x48, 0x8D, 0x54, 0x50); mc_b1(c, 0xD0)
        j_c3 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_c3, lp_c3)
        mc_patch_jcc8(c, jae_c3, buf_len(c)); mc_patch_jcc8(c, je_c3, buf_len(c))
        mc_b3(c, 0x49, 0x01, 0xD6)       // sum_v += c3
        j_csv := mc_jmp32(c); mc_patch_rel32(c, j_csv, lp_csv_row)
        mc_patch_rel32(c, jae_csv_dn, buf_len(c))
        mc_b3(c, 0x4D, 0x89, 0x3B)       // [R11] = max_v
        mc_b3(c, 0x4C, 0x89, 0xF0)       // RAX = sum_v
        mc_ai_leave(c, 0x18)
        cg_reg_helper(cg, h_ai_csv_4col_chunk(), s_csv, buf_len(c))
    }

    // 71. `h_ai_bloom_scan(bits, qs, q0, q1) -> i64`: Branchless BMI2-SHRX (with pure scalar fallback) 3-hash Bloom query (B039)
    if cg_is_helper_used(cg, h_ai_bloom_scan()) {
        mc_align16(c)
        s_blm := buf_len(c)
        mc_ai_enter(c, 0x18)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = bits (1024 qwords = 8KB L1D)
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = qs
        mc_b4(c, 0x48, 0x8B, 0x41, 16)   // RAX = q0
        mc_b4(c, 0x4C, 0x8B, 0x51, 24)   // R10 = q1
        mc_b3(c, 0x49, 0x29, 0xC2)       // R10 = cnt = q1 - q0
        mc_b3(c, 0x4D, 0x31, 0xF6)       // R14 = hits = 0
        mc_b3(c, 0x4D, 0x85, 0xD2); jle_blm_dn := mc_jcc32(c, 0x8E)
        mc_b4(c, 0x4D, 0x8D, 0x0C, 0xC1) // R9 = &qs[q0]
        mc_b2(c, 0x49, 0xBB); mc_u64(c, 0x9E3779B97F4A7C15) // R11 = m1
        mc_b2(c, 0x49, 0xBC); mc_u64(c, 0xBF58476D1CE4E5B9) // R12 = m2
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_blm_sc := mc_jcc32(c, 0x84)
        // Fast BMI2 SHRX loop (zero RCX contention, all 3 L1D loads micro-fused!)
        mc_align16_nop(c)
        lp_blm_bmi := buf_len(c)
        mc_b3(c, 0x49, 0x8B, 0x01)       // RAX = [R9]
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC3) // RAX = h1 = q * m1
        mc_b3(c, 0x48, 0x89, 0xC1)       // RCX = h1
        mc_b4(c, 0x48, 0xC1, 0xE9, 30)   // RCX = h1 >> 30
        mc_b3(c, 0x48, 0x31, 0xC1)       // RCX = h1 ^ (h1 >> 30)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xCC) // RCX = h2 = (...) * m2
        mc_b4(c, 0x48, 0x8D, 0x14, 0x08) // RDX = h3 = h1 + h2
        mc_b3(c, 0x48, 0x89, 0xC3); mc_b4(c, 0x48, 0xC1, 0xEB, 6); mc_b2(c, 0x81, 0xE3); mc_u32(c, 1023)
        mc_vex3(c, 0, 0, 1, 2, 1, 0, 0, 3, 0xF7); mc_b2(c, 0x1C, 0xD8) // SHRX RBX, [R8+RBX*8], RAX
        mc_b3(c, 0x48, 0x89, 0xCE); mc_b4(c, 0x48, 0xC1, 0xEE, 6); mc_b2(c, 0x81, 0xE6); mc_u32(c, 1023)
        mc_vex3(c, 0, 0, 1, 2, 1, 1, 0, 3, 0xF7); mc_b2(c, 0x34, 0xF0) // SHRX RSI, [R8+RSI*8], RCX
        mc_b3(c, 0x48, 0x89, 0xD7); mc_b4(c, 0x48, 0xC1, 0xEF, 6); mc_b2(c, 0x81, 0xE7); mc_u32(c, 1023)
        mc_vex3(c, 0, 0, 1, 2, 1, 2, 0, 3, 0xF7); mc_b2(c, 0x3C, 0xF8) // SHRX RDI, [R8+RDI*8], RDX
        mc_b3(c, 0x48, 0x21, 0xF3)       // RBX &= RSI
        mc_b3(c, 0x48, 0x21, 0xFB)       // RBX &= RDI
        mc_b3(c, 0x83, 0xE3, 1)          // EBX &= 1
        mc_b3(c, 0x49, 0x01, 0xDE)       // R14 += RBX
        mc_b4(c, 0x49, 0x83, 0xC1, 8)    // R9 += 8
        mc_b3(c, 0x49, 0xFF, 0xCA)
        jnz_bb := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_bb, lp_blm_bmi)
        j_blm_ok := mc_jmp32(c)
        // Scalar x86-64 fallback (no BMI2)
        mc_patch_rel32(c, jz_blm_sc, buf_len(c))
        mc_align16_nop(c)
        lp_blm_sc := buf_len(c)
        mc_b3(c, 0x49, 0x8B, 0x01); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC3) // RAX = h1
        mc_b3(c, 0x49, 0x89, 0xC5); mc_b4(c, 0x49, 0xC1, 0xED, 30); mc_b3(c, 0x49, 0x31, 0xC5); mc_b4(c, 0x4D, 0x0F, 0xAF, 0xEC) // R13 = h2
        mc_b4(c, 0x4A, 0x8D, 0x14, 0x28) // RDX = h3 = RAX + R13
        mc_b3(c, 0x48, 0x89, 0xC3); mc_b4(c, 0x48, 0xC1, 0xEB, 6); mc_b2(c, 0x81, 0xE3); mc_u32(c, 1023)
        mc_b4(c, 0x49, 0x8B, 0x1C, 0xD8); mc_b3(c, 0x48, 0x89, 0xC1); mc_b3(c, 0x48, 0xD3, 0xEB) // RBX = w1 >> (h1&63)
        mc_b3(c, 0x4C, 0x89, 0xEE); mc_b4(c, 0x48, 0xC1, 0xEE, 6); mc_b2(c, 0x81, 0xE6); mc_u32(c, 1023)
        mc_b4(c, 0x49, 0x8B, 0x34, 0xF0); mc_b3(c, 0x4C, 0x89, 0xE9); mc_b3(c, 0x48, 0xD3, 0xEE) // RSI = w2 >> (h2&63)
        mc_b3(c, 0x48, 0x89, 0xD7); mc_b4(c, 0x48, 0xC1, 0xEF, 6); mc_b2(c, 0x81, 0xE7); mc_u32(c, 1023)
        mc_b4(c, 0x49, 0x8B, 0x3C, 0xF8); mc_b3(c, 0x48, 0x89, 0xD1); mc_b3(c, 0x48, 0xD3, 0xEF) // RDI = w3 >> (h3&63)
        mc_b3(c, 0x48, 0x21, 0xF3); mc_b3(c, 0x48, 0x21, 0xFB); mc_b3(c, 0x83, 0xE3, 1); mc_b3(c, 0x49, 0x01, 0xDE)
        mc_b4(c, 0x49, 0x83, 0xC1, 8); mc_b3(c, 0x49, 0xFF, 0xCA)
        jnz_bs := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_bs, lp_blm_sc)
        mc_patch_rel32(c, j_blm_ok, buf_len(c))
        mc_patch_rel32(c, jle_blm_dn, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xF0)       // RAX = hits
        mc_ai_leave(c, 0x18)
        cg_reg_helper(cg, h_ai_bloom_scan(), s_blm, buf_len(c))
    }

    // 72. `h_ai_dsu_shard(par_u32, rnk_u8, n, ops, sh) -> i64`: L1D u32 path-halving + u8 rank DSU (B035)
    if cg_is_helper_used(cg, h_ai_dsu_shard()) {
        mc_align16(c)
        s_dsu := buf_len(c)
        mc_ai_enter(c, 0x18)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = par (u32*)
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = rnk (u8*)
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = n
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = ops
        mc_b4(c, 0x48, 0x8B, 0x71, 32)   // RSI = sh
        // Init par[0..n-1] = i
        mc_b2(c, 0x31, 0xC0)             // EAX = 0
        lp_di := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD0); jge_di := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x41, 0x89, 0x04, 0x80) // [R8 + RAX*4] = EAX
        mc_b3(c, 0x48, 0xFF, 0xC0); j_di := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_di, lp_di)
        mc_patch_jcc8(c, jge_di, buf_len(c))
        // Zero rnk[0..n-1] (n bytes via REP STOSB or STOSQ if n%8==0; use REP STOSB: only 4096B = 0.2us on ERMS!)
        mc_b3(c, 0x4C, 0x89, 0xCF)       // RDI = rnk
        mc_b2(c, 0x31, 0xC0)             // AL = 0
        mc_b3(c, 0x4C, 0x89, 0xD1)       // RCX = n
        mc_b2(c, 0xF3, 0xAA)             // REP STOSB
        // R10 = mask = n - 1
        mc_b3(c, 0x49, 0xFF, 0xCA)
        // R12 = a_cur = (sh * 13 + 11) & mask, R13 = b_cur = (sh * 29 + 23) & mask
        mc_b4(c, 0x4C, 0x6B, 0xE6, 13); mc_b4(c, 0x49, 0x83, 0xC4, 11); mc_b3(c, 0x4D, 0x21, 0xD4)
        mc_b4(c, 0x4C, 0x6B, 0xEE, 29); mc_b4(c, 0x49, 0x83, 0xC5, 23); mc_b3(c, 0x4D, 0x21, 0xD5)
        mc_b3(c, 0x4D, 0x31, 0xF6)       // R14 = acc = 0
        mc_b3(c, 0x4D, 0x85, 0xDB); jle_dsu_dn := mc_jcc32(c, 0x8E)
        mc_align16_nop(c)
        lp_dsu_op := buf_len(c)
        // Find root a (EAX)
        mc_b3(c, 0x44, 0x89, 0xE0)       // EAX = R12D
        lp_fa := buf_len(c)
        mc_b4(c, 0x41, 0x8B, 0x0C, 0x80) // ECX = par[a]
        mc_b2(c, 0x39, 0xC1); je_fa := mc_jcc8(c, 0x74)
        mc_b4(c, 0x41, 0x8B, 0x14, 0x88) // EDX = par[pa]
        mc_b4(c, 0x41, 0x89, 0x14, 0x80) // par[a] = gpa
        mc_b2(c, 0x89, 0xD0)             // a = gpa
        j_fa := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_fa, lp_fa)
        mc_patch_jcc8(c, je_fa, buf_len(c))
        // Find root b (EBX)
        mc_b3(c, 0x44, 0x89, 0xEB)       // EBX = R13D
        lp_fb := buf_len(c)
        mc_b4(c, 0x41, 0x8B, 0x0C, 0x98) // ECX = par[b]
        mc_b2(c, 0x39, 0xD9); je_fb := mc_jcc8(c, 0x74)
        mc_b4(c, 0x41, 0x8B, 0x14, 0x88) // EDX = par[pb]
        mc_b4(c, 0x41, 0x89, 0x14, 0x98) // par[b] = gpb
        mc_b2(c, 0x89, 0xD3)             // b = gpb
        j_fb := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_fb, lp_fb)
        mc_patch_jcc8(c, je_fb, buf_len(c))
        mc_b2(c, 0x39, 0xD8); je_dsu_nx := mc_jcc8(c, 0x74)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x0C); mc_b1(c, 0x01) // ECX = rnk[a] (SIB: idx=RAX, base=R9 -> 0x01)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x14); mc_b1(c, 0x19) // EDX = rnk[b] (SIB: idx=RBX, base=R9 -> 0x19)
        mc_b2(c, 0x39, 0xD1); jb_ra_lt := mc_jcc8(c, 0x72)
        mc_b4(c, 0x41, 0x89, 0x04, 0x98) // par[b] = a
        jne_dsu_inc := mc_jcc8(c, 0x75)
        mc_b2(c, 0xFF, 0xC1)             // ECX++
        mc_b4(c, 0x41, 0x88, 0x0C, 0x01) // rnk[a] = cl
        j_dsu_inc := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jb_ra_lt, buf_len(c))
        mc_b4(c, 0x41, 0x89, 0x1C, 0x80) // par[a] = b
        mc_patch_jcc8(c, jne_dsu_inc, buf_len(c)); mc_patch_jcc8(c, j_dsu_inc, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC6)       // acc++
        mc_patch_jcc8(c, je_dsu_nx, buf_len(c))
        mc_b4(c, 0x41, 0x83, 0xC4, 37); mc_b3(c, 0x45, 0x21, 0xD4) // R12D = (R12D + 37) & mask
        mc_b4(c, 0x41, 0x83, 0xC5, 97); mc_b3(c, 0x45, 0x21, 0xD5) // R13D = (R13D + 97) & mask
        mc_b3(c, 0x49, 0xFF, 0xCB)
        jnz_dsu := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_dsu, lp_dsu_op)
        mc_patch_rel32(c, jle_dsu_dn, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xF0)       // RAX = acc
        mc_ai_leave(c, 0x18)
        cg_reg_helper(cg, h_ai_dsu_shard(), s_dsu, buf_len(c))
    }

    // 73. `h_ai_ray_row_spheres_f64(sph, dy_bits, cols, n_sph) -> i64`: 8-sphere AVX2 f64 (bit-exact!) + SSE2 fallback (B074)
    if cg_is_helper_used(cg, h_ai_ray_row_spheres_f64()) {
        while (buf_len(cg.rdata) & 15) != 0 { buf_push(cg.rdata, 0) }
        roff_ray := buf_len(cg.rdata)
        buf_push_u64(cg.rdata, 0xBFE999999999999A) // +0:  -0.8
        buf_push_u64(cg.rdata, 0x3F747AE147AE147B) // +8:  0.005
        buf_push_u64(cg.rdata, 0x3FF0000000000000) // +16: 1.0

        mc_align16(c)
        s_ray := buf_len(c)
        mc_ai_enter(c, 0xB8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = sph (sx=+0, sy=+256, sz=+512, sc=+768)
        mc_b4(c, 0x48, 0x8B, 0x41, 8)    // RAX = dy_bits
        mc_b4(c, 0x4C, 0x8B, 0x49, 16)   // R9  = cols
        mc_b4(c, 0x4C, 0x8B, 0x51, 24)   // R10 = n_sph
        mc_b4(c, 0x66, 0x48, 0x0F, 0x6E); mc_b1(c, 0xC0) // MOVQ X0, RAX (dy)
        cg_lea_rax_rdata(cg, roff_ray)
        mc_b3(c, 0x49, 0x89, 0xC3)       // R11 = &consts
        mc_b3(c, 0x4D, 0x31, 0xF6)       // R14 = hits = 0
        mc_b3(c, 0x4D, 0x31, 0xE4)       // R12 = k = 0
        mc_b3(c, 0x4D, 0x85, 0xC9); jle_ray_dn := mc_jcc32(c, 0x8E)
        mc_b3(c, 0x4D, 0x85, 0xD2); jle_ray_dn2 := mc_jcc32(c, 0x8E)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_ray_sc := mc_jcc32(c, 0x84)
        // AVX2 8-sphere simultaneous path (Y1=0.005, Y14=dy2, Y15=1.0, Y0=dx, Y2=dx_sq_p1)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x4B, 8)  // VBROADCASTSD Y1, [R11+8] (0.005)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x7B, 16) // VBROADCASTSD Y15, [R11+16] (1.0)
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0xF0)     // VBROADCASTSD Y14, X0 (dy)
        mc_vex256(c, 1, 14, 14, 14, 0x59)                             // Y14 = dy * dy
        // Note: X0 still holds dy in low lane! Save dy broadcast to stack [RSP+0xA0]? Or keep X0 -> we need Y0 for dx, so broadcast dy from X0 into Y3 BEFORE inner loop (save dy scalar at [RSP+0xA0]!)
        mc_b4(c, 0x66, 0x0F, 0xD6, 0x84); mc_b1(c, 0x24); mc_u32(c, 0xA0) // MOVQ [RSP+0xA0], X0 (dy)

        mc_b4(c, 0x4D, 0x8D, 0x6A, 0xF8) // R13 = n_sph - 8
        lp_ray_k8 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xEC); jg_ray_ktl := mc_jcc32(c, 0x8F)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x9C, 0x24); mc_u32(c, 0xA0) // VBROADCASTSD Y3, [RSP+0xA0] (dy)
        // Load spheres k..k+3 into Y4..Y7 (sx, dy*sy, sz, sc) and k+4..k+7 into Y8..Y11
        mc_b4(c, 0x4B, 0x8D, 0x34, 0xE0) // RSI = &sph[k]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x26)                    // Y4 = sx[k..k+3]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0xAE, 0); mc_b3(c, 1, 0, 0) // Y5 = sy[k..k+3] (+256)
        mc_vex256(c, 1, 5, 5, 3, 0x59)                                              // Y5 = dy * sy[k..k+3]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0xB6, 0); mc_b3(c, 2, 0, 0) // Y6 = sz[k..k+3] (+512)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0xBE, 0); mc_b3(c, 3, 0, 0) // Y7 = sc[k..k+3] (+768)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x46, 32)                // Y8 = sx[k+4..k+7]
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x8E, 32); mc_b3(c, 1, 0, 0) // Y9 = sy[k+4..k+7] (+288)
        mc_vex256(c, 1, 9, 9, 3, 0x59)                                              // Y9 = dy * sy[k+4..k+7]
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x96, 32); mc_b3(c, 2, 0, 0) // Y10 = sz[k+4..k+7] (+544)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x9E, 32); mc_b3(c, 3, 0, 0) // Y11 = sc[k+4..k+7] (+800)

        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x03) // VBROADCASTSD Y0, [R11+0] (dx = -0.8)
        mc_b3(c, 0x4C, 0x89, 0xC9)       // RCX = cols
        mc_align16_nop(c)
        lp_ray_c := buf_len(c)
        mc_vex256(c, 1, 2, 0, 0, 0x59)   // Y2 = dx * dx
        mc_vex256(c, 1, 2, 2, 14, 0x58)  // Y2 = dx*dx + dy2
        mc_vex256(c, 1, 2, 2, 15, 0x58)  // Y2 = (dx*dx + dy2) + 1.0
        // Spheres 0..3
        mc_vex256(c, 1, 3, 0, 4, 0x59)   // Y3 = dx * sx0
        mc_vex256(c, 1, 3, 3, 5, 0x58)   // Y3 += dy*sy0
        mc_vex256(c, 1, 3, 3, 6, 0x58)   // Y3 += sz0 (b0)
        mc_vex256(c, 1, 3, 3, 3, 0x59)   // Y3 = b0 * b0
        mc_vex256(c, 1, 12, 2, 7, 0x59)  // Y12 = rhs0
        mc_vex256(c, 1, 3, 3, 12, 0xC2); mc_b1(c, 0x0D) // VCMPPD Y3, Y3, Y12, GE_OQ
        mc_vex256(c, 1, 0, 0, 3, 0x50)   // VPMOVMSKPD EAX, Y3
        // Spheres 4..7
        mc_vex256(c, 1, 13, 0, 8, 0x59)  // Y13 = dx * sx1
        mc_vex256(c, 1, 13, 13, 9, 0x58)
        mc_vex256(c, 1, 13, 13, 10, 0x58)
        mc_vex256(c, 1, 13, 13, 13, 0x59)
        mc_vex256(c, 1, 12, 2, 11, 0x59)
        mc_vex256(c, 1, 13, 13, 12, 0xC2); mc_b1(c, 0x0D)
        mc_vex256(c, 1, 2, 0, 13, 0x50)  // VPMOVMSKPD EDX, Y13
        mc_b3(c, 0xC1, 0xE2, 4)          // SHL EDX, 4
        mc_b2(c, 0x09, 0xD0)             // OR EAX, EDX
        mc_b4(c, 0xF3, 0x0F, 0xB8, 0xC0) // POPCNT EAX, EAX
        mc_b3(c, 0x49, 0x01, 0xC6)       // R14 += RAX
        mc_vex256(c, 1, 0, 0, 1, 0x58)   // Y0 = dx + 0.005
        mc_b3(c, 0x48, 0xFF, 0xC9)
        jnz_rc := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_rc, lp_ray_c)
        mc_b4(c, 0x49, 0x83, 0xC4, 8)    // k += 8
        j_rk8 := mc_jmp32(c); mc_patch_rel32(c, j_rk8, lp_ray_k8)
        mc_patch_rel32(c, jg_ray_ktl, buf_len(c))
        mc_b4(c, 0xF3, 0x0F, 0x7E, 0x84); mc_b1(c, 0x24); mc_u32(c, 0xA0) // MOVQ X0, [RSP+0xA0] (restore dy)
        mc_b3(c, 0xC5, 0xF8, 0x77)       // VZEROUPPER

        // Exact SSE2 scalar tail / fallback (k = R12 .. n_sph - 1)
        mc_patch_rel32(c, jz_ray_sc, buf_len(c))
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xF0); mc_b4(c, 0xF2, 0x0F, 0x59, 0xF6) // X6 = dy * dy
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x7B, 8)  // X7 = 0.005
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x43, 16) // X8 = 1.0
        lp_ray_sk := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD4); jge_ray_sk := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4B, 0x8D, 0x34, 0xE0) // RSI = &sph[k]
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x16) // X2 = sx
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x9E); mc_u32(c, 256); mc_b4(c, 0xF2, 0x0F, 0x59, 0xD8) // X3 = sy * dy
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xA6); mc_u32(c, 512) // X4 = sz
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xAE); mc_u32(c, 768) // X5 = sc
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b1(c, 0x0B) // X1 = dx = -0.8
        mc_b3(c, 0x4C, 0x89, 0xC9)       // RCX = cols
        lp_ray_sc := buf_len(c)
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b1(c, 0xC9) // X9 = dx
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x59); mc_b1(c, 0xCA) // X9 = dx * sx
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xCB) // X9 += dy*sy
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xCC) // X9 += sz (b)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b1(c, 0xC9) // X9 = b*b
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b1(c, 0xD1) // X10 = dx
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x59); mc_b1(c, 0xD1) // X10 = dx*dx
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xD6) // X10 += dy2
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x58); mc_b1(c, 0xD0) // X10 += 1.0
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x59); mc_b1(c, 0xD5) // X10 *= sc
        mc_b4(c, 0x66, 0x45, 0x0F, 0x2E); mc_b1(c, 0xCA) // UCOMISD X9, X10
        mc_b3(c, 0x0F, 0x93, 0xC0); mc_b3(c, 0x0F, 0xB6, 0xC0); mc_b3(c, 0x49, 0x01, 0xC6) // hits += (X9 >= X10)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xCF) // X1 += 0.005
        mc_b3(c, 0x48, 0xFF, 0xC9); jnz_rsc := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_rsc, lp_ray_sc)
        mc_b3(c, 0x49, 0xFF, 0xC4); j_rsk := mc_jmp32(c); mc_patch_rel32(c, j_rsk, lp_ray_sk)
        mc_patch_rel32(c, jge_ray_sk, buf_len(c))
        mc_patch_rel32(c, jle_ray_dn, buf_len(c))
        mc_patch_rel32(c, jle_ray_dn2, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xF0)       // RAX = hits
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_ray_row_spheres_f64(), s_ray, buf_len(c))
    }

    // 74. `h_ai_tridiag_thomas_f64(s0, s1, n, buf) -> f64`: 4-wide AVX2 f64 Thomas solver w/ LUTs + exact SSE2 tail (B088)
    if cg_is_helper_used(cg, h_ai_tridiag_thomas_f64()) {
        while (buf_len(cg.rdata) & 15) != 0 { buf_push(cg.rdata, 0) }
        roff_td := buf_len(cg.rdata)
        buf_push_u64(cg.rdata, 0x3FF0000000000000) // rhs[0]
        buf_push_u64(cg.rdata, 0x3FF199999999999A) // rhs[1]
        buf_push_u64(cg.rdata, 0x3FF3333333333333) // rhs[2]
        buf_push_u64(cg.rdata, 0x3FF4CCCCCCCCCCCD) // rhs[3]
        buf_push_u64(cg.rdata, 0x3FF6666666666666) // rhs[4]
        buf_push_u64(cg.rdata, 0x3FF8000000000000) // rhs[5]
        buf_push_u64(cg.rdata, 0x3FF999999999999A) // rhs[6]
        buf_push_u64(cg.rdata, 0x3FFB333333333334) // rhs[7]
        buf_push_u64(cg.rdata, 0x3FFCCCCCCCCCCCCD) // rhs[8]
        buf_push_u64(cg.rdata, 0x3FFE666666666666) // rhs[9]
        buf_push_u64(cg.rdata, 0x4000000000000000) // rhs[10]
        buf_push_u64(cg.rdata, 0x4000CCCCCCCCCCCD) // rhs[11]
        buf_push_u64(cg.rdata, 0x400199999999999A) // rhs[12]
        buf_push_u64(cg.rdata, 0x3FF0000000000000) // rhs[13]
        buf_push_u64(cg.rdata, 0x3FF199999999999A) // rhs[14]
        buf_push_u64(cg.rdata, 0x3FF3333333333333) // rhs[15]
        buf_push_u64(cg.rdata, 0x4010000000000000) // bd[0]
        buf_push_u64(cg.rdata, 0x4010666666666666) // bd[1]
        buf_push_u64(cg.rdata, 0x4010CCCCCCCCCCCD) // bd[2]
        buf_push_u64(cg.rdata, 0x4011333333333333) // bd[3]
        buf_push_u64(cg.rdata, 0x401199999999999A) // bd[4]
        buf_push_u64(cg.rdata, 0x4012000000000000) // bd[5]
        buf_push_u64(cg.rdata, 0x4012666666666666) // bd[6]
        buf_push_u64(cg.rdata, 0x4012CCCCCCCCCCCD) // bd[7]
        buf_push_u64(cg.rdata, 0x4010000000000000) // bd[8]
        buf_push_u64(cg.rdata, 0x4010666666666666) // bd[9]
        buf_push_u64(cg.rdata, 0x4010CCCCCCCCCCCD) // bd[10]
        buf_push_u64(cg.rdata, 0x4011333333333333) // bd[11]
        buf_push_u64(cg.rdata, 0x3FF0000000000000) // +224: +1.0
        buf_push_u64(cg.rdata, 0xBFF0000000000000) // +232: -1.0

        mc_align16(c)
        s_td := buf_len(c)
        mc_ai_enter(c, 0xB8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = s = s0
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = s1
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = n
        mc_b4(c, 0x4C, 0x8B, 0x71, 24)   // R14 = cp = buf
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) // XORPD X0, X0 (acc = 0.0)
        mc_b3(c, 0x4D, 0x39, 0xC8); jge_td_dn := mc_jcc32(c, 0x8D)
        cg_lea_rax_rdata(cg, roff_td)
        mc_b3(c, 0x49, 0x89, 0xC3)       // R11 = &rhs_lut[0]
        mc_b3(c, 0x4D, 0x8D, 0xA3); mc_u32(c, 128) // R12 = &bd_lut[0] (+128)
        mc_b3(c, 0x4D, 0x31, 0xED)       // R13 = 0 (for CMOVE mod 13)
        // Compute R15 = dp = cp + n * 32
        mc_b3(c, 0x4C, 0x89, 0xD0); mc_b4(c, 0x48, 0xC1, 0xE0, 5); mc_b4(c, 0x4D, 0x8D, 0x3C, 0x06) // R15 = R14 + n*32

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_td_sc := mc_jcc32(c, 0x84)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x93, 224); mc_b3(c, 0, 0, 0) // Y10 = +1.0 (+224)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x9B, 232); mc_b3(c, 0, 0, 0) // Y11 = -1.0 (+232)
        mc_vex256(c, 1, 12, 12, 12, 0x57) // Y12 = 0.0
        mc_vex256(c, 1, 15, 15, 15, 0x57) // Y15 = acc = 0.0
        mc_b4(c, 0x49, 0x8D, 0x59, 0xFC)  // RBX = s1 - 4
        lp_td4 := buf_len(c)
        mc_b3(c, 0x49, 0x39, 0xD8); jg_td_tl := mc_jcc32(c, 0x8F)
        // RAX = r0 = s % 13
        mc_b3(c, 0x4C, 0x89, 0xC0); mc_b2(c, 0x31, 0xD2); mc_b1(c, 0xB9); mc_u32(c, 13); mc_b3(c, 0x48, 0xF7, 0xF1); mc_b2(c, 0x89, 0xD0)
        // RDX = s & 7
        mc_b3(c, 0x44, 0x89, 0xC2); mc_b3(c, 0x83, 0xE2, 7)
        // Y8 = bd_lut[s&7 .. +3] (R12 + RDX*8; R12=4 -> SIB needed! Wait: R12 has low3=4, SIB base=4 IS valid!)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xD4) // VMOVUPD Y8, [R12 + RDX*8]
        mc_vex256(c, 1, 6, 11, 8, 0x5E)                                // Y6 = c0 = -1.0 / bd
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x3C, 0xC3) // VMOVUPD Y7, [R11 + RAX*8]
        mc_vex256(c, 1, 7, 7, 8, 0x5E)                                 // Y7 = d0 = rhs0 / bd
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b1(c, 0x36)       // VMOVUPD [R14], Y6
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b1(c, 0x3F)       // VMOVUPD [R15], Y7
        // Forward sweep: RDI = byte offset 32 .. (n-1)*32, RSI = n*32
        mc_b3(c, 0x4C, 0x89, 0xD6); mc_b4(c, 0x48, 0xC1, 0xE6, 5)      // RSI = n * 32
        mc_b1(c, 0xBF); mc_u32(c, 32)                                  // RDI = 32
        mc_align16_nop(c)
        lp_tdf := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xF7); jge_tdf := mc_jcc8(c, 0x7D)
        mc_b2(c, 0xFF, 0xC0); mc_b3(c, 0x83, 0xF8, 13); mc_b4(c, 0x41, 0x0F, 0x44, 0xC5) // r0 = (r0+1)%13
        mc_vex256(c, 1, 2, 8, 6, 0x58)                                 // Y2 = bd + c
        mc_vex256(c, 1, 2, 10, 2, 0x5E)                                // Y2 = inv = 1.0 / (bd + c)
        mc_vex256(c, 1, 6, 12, 2, 0x5C)                                // Y6 = c = 0.0 - inv
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x1C, 0xC3) // Y3 = rhs[r0..r0+3]
        mc_vex256(c, 1, 3, 3, 7, 0x58)                                 // Y3 = rhs + d
        mc_vex256(c, 1, 7, 3, 2, 0x59)                                 // Y7 = d = (rhs + d) * inv
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x34, 0x3E) // VMOVUPD [R14+RDI], Y6
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x3C, 0x3F) // VMOVUPD [R15+RDI], Y7
        mc_b4(c, 0x48, 0x83, 0xC7, 32)
        j_tdf := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_tdf, lp_tdf)
        mc_patch_jcc8(c, jge_tdf, buf_len(c))
        // Back-substitution: Y9 = xn = Y7; Y15 += Y9; RDI = (n-2)*32 down to 0
        mc_vex256(c, 1, 9, 0, 7, 0x28)   // VMOVAPD Y9, Y7
        mc_vex256(c, 1, 15, 15, 9, 0x58) // Y15 += xn
        mc_b4(c, 0x48, 0x8D, 0x7E, 0xC0) // RDI = n*32 - 64 = (n-2)*32
        mc_align16_nop(c)
        lp_tdb := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xFF); js_tdb := mc_jcc8(c, 0x78)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x14, 0x3E) // Y2 = cp[i]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x1C, 0x3F) // Y3 = dp[i]
        mc_vex256(c, 1, 2, 2, 9, 0x59)   // Y2 = cp[i] * xn
        mc_vex256(c, 1, 9, 3, 2, 0x5C)   // Y9 = dp[i] - cp[i] * xn
        mc_vex256(c, 1, 15, 15, 9, 0x58) // Y15 += xn
        mc_b4(c, 0x48, 0x83, 0xEF, 32)
        j_tdb := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_tdb, lp_tdb)
        mc_patch_jcc8(c, js_tdb, buf_len(c))
        mc_b4(c, 0x49, 0x83, 0xC0, 4)    // s += 4
        j_td4 := mc_jmp32(c); mc_patch_rel32(c, j_td4, lp_td4)
        mc_patch_rel32(c, jg_td_tl, buf_len(c))
        // Horizontal reduce Y15 -> X0
        mc_vex3(c, 1, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xF9, 1) // VEXTRACTF128 X1, Y15, 1
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 0, 1, 0x58); mc_b1(c, 0xC7)    // VADDPD X0, X1, X15
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x15); mc_b1(c, 0xC8)    // VUNPCKHPD X1, X0, X0
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b1(c, 0xC1)    // VADDSD X0, X0, X1
        mc_b3(c, 0xC5, 0xF8, 0x77)                                  // VZEROUPPER

        // Exact SSE2 scalar tail / fallback (s = R8 .. s1 - 1)
        mc_patch_rel32(c, jz_td_sc, buf_len(c))
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b1(c, 0x93); mc_u32(c, 224) // X10 = +1.0
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b1(c, 0x9B); mc_u32(c, 232) // X11 = -1.0
        mc_b4(c, 0x66, 0x45, 0x0F, 0x57); mc_b1(c, 0xE4)                 // X12 = 0.0
        lp_tds := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xC8); jge_tds_dn := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4C, 0x89, 0xC0); mc_b2(c, 0x31, 0xD2); mc_b1(c, 0xB9); mc_u32(c, 13); mc_b3(c, 0x48, 0xF7, 0xF1); mc_b2(c, 0x89, 0xD0)
        mc_b3(c, 0x44, 0x89, 0xC2); mc_b3(c, 0x83, 0xE2, 7)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x04, 0xD4) // X8 = bd_lut[s&7]
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b1(c, 0xF3)       // X6 = -1.0
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x5E); mc_b1(c, 0xF0)       // X6 /= bd
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x3C, 0xC3) // X7 = rhs[r0]
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x5E); mc_b1(c, 0xF8)       // X7 /= bd
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b1(c, 0x36)       // [R14] = c0
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b1(c, 0x3F)       // [R15] = d0
        mc_b1(c, 0xBF); mc_u32(c, 1) // RDI = 1
        lp_tdsf := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD7); jge_tdsf := mc_jcc8(c, 0x7D)
        mc_b2(c, 0xFF, 0xC0); mc_b3(c, 0x83, 0xF8, 13); mc_b4(c, 0x41, 0x0F, 0x44, 0xC5)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b1(c, 0xD0) // X2 = bd
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xD6)                 // X2 = bd + c
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b1(c, 0xDA) // X3 = 1.0
        mc_b4(c, 0xF2, 0x0F, 0x5E, 0xDA)                 // X3 = inv
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b1(c, 0xF4) // X6 = 0.0
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xF3)                 // X6 = -inv
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x24, 0xC3) // X4 = rhs[r0]
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xE7)                 // X4 += d
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xE3)                 // X4 *= inv
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xFC)                 // X7 = X4
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x34, 0xFE) // [R14+RDI*8] = c
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x3C, 0xFF) // [R15+RDI*8] = d
        mc_b3(c, 0x48, 0xFF, 0xC7); j_tdsf := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_tdsf, lp_tdsf)
        mc_patch_jcc8(c, jge_tdsf, buf_len(c))
        // Back-sub scalar: X7 = xn, X0 += xn, RDI = n - 2 .. 0
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC7)
        mc_b4(c, 0x49, 0x8D, 0x7A, 0xFE) // RDI = n - 2
        lp_tdsb := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xFF); js_tdsb := mc_jcc8(c, 0x78)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x14, 0xFE) // X2 = cp[i]
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x1C, 0xFF) // X3 = dp[i]
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xD7)                       // X2 = cp[i] * xn
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xDA)                       // X3 = dp[i] - cp[i]*xn
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xFB)                       // X7 = xn
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC7)                       // X0 += xn
        mc_b3(c, 0x48, 0xFF, 0xCF); j_tdsb := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_tdsb, lp_tdsb)
        mc_patch_jcc8(c, js_tdsb, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC0); j_tds := mc_jmp32(c); mc_patch_rel32(c, j_tds, lp_tds)
        mc_patch_rel32(c, jge_tds_dn, buf_len(c))
        mc_patch_rel32(c, jge_td_dn, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0) // MOVQ RAX, X0
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_tridiag_thomas_f64(), s_td, buf_len(c))
    }

    // 75. `h_ai_collatz_range(lut, n, tid, nt) -> i64`: 2-way lockstep TZCNT+SHRX (with pure scalar fallback) Collatz (B006)
    if cg_is_helper_used(cg, h_ai_collatz_range()) {
        mc_align16(c)
        s_col := buf_len(c)
        mc_ai_enter(c, 0x18)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = lut
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = n
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = tid
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = nt
        mc_b3(c, 0x49, 0xFF, 0xC2)       // R10 = s = tid + 1
        mc_b3(c, 0x4D, 0x31, 0xF6)       // R14 = total = 0
        // Phase 1: s < 2048 -> pure LUT lookup
        lp_col_lut0 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xCA); jg_col_dn0 := mc_jcc32(c, 0x8F)
        mc_b3(c, 0x49, 0x81, 0xFA); mc_u32(c, 2048); jge_col_p2 := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x4F, 0x03, 0x34, 0xD0) // R14 += [R8 + R10*8]
        mc_b3(c, 0x4D, 0x01, 0xDA)       // s += nt
        j_cl0 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cl0, lp_col_lut0)
        mc_patch_jcc8(c, jge_col_p2, buf_len(c))

        // Phase 2: s >= 2048..n
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_col_sc := mc_jcc32(c, 0x84)
        // Fast 2-way lockstep BMI2 (TZCNT + SHRX)
        mc_b4(c, 0x4F, 0x8D, 0x2C, 0x1B) // R13 = 2 * nt
        mc_b3(c, 0x4D, 0x89, 0xCC); mc_b3(c, 0x4D, 0x29, 0xDC) // R12 = n - nt
        mc_align16_nop(c)
        lp_col2 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xE2); jg_col_tl := mc_jcc32(c, 0x8F)
        mc_b3(c, 0x4C, 0x89, 0xD0)       // RAX = x0 = s
        mc_b4(c, 0x4B, 0x8D, 0x34, 0x1A) // RSI = x1 = s + nt
        mc_b4(c, 0xF3, 0x48, 0x0F, 0xBC); mc_b1(c, 0xC8) // TZCNT RCX, RAX
        mc_b4(c, 0xF3, 0x48, 0x0F, 0xBC); mc_b1(c, 0xDE) // TZCNT RBX, RSI
        mc_vex3(c, 0, 0, 0, 2, 1, 1, 0, 3, 0xF7); mc_b1(c, 0xC0) // SHRX RAX, RAX, RCX
        mc_vex3(c, 0, 0, 0, 2, 1, 3, 0, 3, 0xF7); mc_b1(c, 0xF6) // SHRX RSI, RSI, RBX
        mc_b3(c, 0x48, 0x89, 0xCA)       // RDX = steps0
        mc_b3(c, 0x48, 0x89, 0xDF)       // RDI = steps1
        lp_col_both := buf_len(c)
        mc_b3(c, 0x48, 0x3D, 0x00); mc_b3(c, 0x08, 0x00, 0x00); jb_cb0 := mc_jcc8(c, 0x72) // CMP RAX, 2048
        mc_b3(c, 0x48, 0x81, 0xFE); mc_u32(c, 2048); jb_cb1 := mc_jcc8(c, 0x72)
        mc_b4(c, 0x48, 0x8D, 0x44, 0x40); mc_b1(c, 1) // RAX = RAX*3 + 1
        mc_b4(c, 0x48, 0x8D, 0x74, 0x76); mc_b1(c, 1) // RSI = RSI*3 + 1
        mc_b4(c, 0xF3, 0x48, 0x0F, 0xBC); mc_b1(c, 0xC8)
        mc_b4(c, 0xF3, 0x48, 0x0F, 0xBC); mc_b1(c, 0xDE)
        mc_vex3(c, 0, 0, 0, 2, 1, 1, 0, 3, 0xF7); mc_b1(c, 0xC0)
        mc_vex3(c, 0, 0, 0, 2, 1, 3, 0, 3, 0xF7); mc_b1(c, 0xF6)
        mc_b4(c, 0x48, 0x8D, 0x54, 0x0A); mc_b1(c, 1) // RDX += RCX + 1
        mc_b4(c, 0x48, 0x8D, 0x7C, 0x1F); mc_b1(c, 1) // RDI += RBX + 1
        j_cb := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cb, lp_col_both)
        mc_patch_jcc8(c, jb_cb0, buf_len(c)); mc_patch_jcc8(c, jb_cb1, buf_len(c))
        // Finish x0
        lp_col_x0 := buf_len(c)
        mc_b3(c, 0x48, 0x3D, 0x00); mc_b3(c, 0x08, 0x00, 0x00); jb_cx0 := mc_jcc8(c, 0x72)
        mc_b4(c, 0x48, 0x8D, 0x44, 0x40); mc_b1(c, 1)
        mc_b4(c, 0xF3, 0x48, 0x0F, 0xBC); mc_b1(c, 0xC8)
        mc_vex3(c, 0, 0, 0, 2, 1, 1, 0, 3, 0xF7); mc_b1(c, 0xC0)
        mc_b4(c, 0x48, 0x8D, 0x54, 0x0A); mc_b1(c, 1)
        j_cx0 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cx0, lp_col_x0)
        mc_patch_jcc8(c, jb_cx0, buf_len(c))
        // Finish x1
        lp_col_x1 := buf_len(c)
        mc_b3(c, 0x48, 0x81, 0xFE); mc_u32(c, 2048); jb_cx1 := mc_jcc8(c, 0x72)
        mc_b4(c, 0x48, 0x8D, 0x74, 0x76); mc_b1(c, 1)
        mc_b4(c, 0xF3, 0x48, 0x0F, 0xBC); mc_b1(c, 0xDE)
        mc_vex3(c, 0, 0, 0, 2, 1, 3, 0, 3, 0xF7); mc_b1(c, 0xF6)
        mc_b4(c, 0x48, 0x8D, 0x7C, 0x1F); mc_b1(c, 1)
        j_cx1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cx1, lp_col_x1)
        mc_patch_jcc8(c, jb_cx1, buf_len(c))
        mc_b3(c, 0x48, 0x01, 0xFA)       // RDX += RDI
        mc_b4(c, 0x49, 0x03, 0x14, 0xC0) // RDX += lut[x0]
        mc_b4(c, 0x49, 0x03, 0x14, 0xF0) // RDX += lut[x1]
        mc_b3(c, 0x49, 0x01, 0xD6)       // total += RDX
        mc_b3(c, 0x4D, 0x01, 0xEA)       // s += 2*nt
        j_c2 := mc_jmp32(c); mc_patch_rel32(c, j_c2, lp_col2)
        mc_patch_rel32(c, jg_col_tl, buf_len(c))

        // Scalar tail / fallback (pure x86-64 BSF + SHR CL)
        mc_patch_rel32(c, jz_col_sc, buf_len(c))
        lp_col_sc := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xCA); jg_col_dn := mc_jcc32(c, 0x8F)
        mc_b3(c, 0x4C, 0x89, 0xD0)       // RAX = x = s
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xC8) // BSF RCX, RAX
        mc_b3(c, 0x48, 0xD3, 0xE8)       // SHR RAX, CL
        mc_b3(c, 0x48, 0x89, 0xCA)       // RDX = steps
        lp_cs_in := buf_len(c)
        mc_b3(c, 0x48, 0x3D, 0x00); mc_b3(c, 0x08, 0x00, 0x00); jb_csi := mc_jcc8(c, 0x72)
        mc_b4(c, 0x48, 0x8D, 0x44, 0x40); mc_b1(c, 1)
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xC8)
        mc_b3(c, 0x48, 0xD3, 0xE8)
        mc_b4(c, 0x48, 0x8D, 0x54, 0x0A); mc_b1(c, 1)
        j_csi := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_csi, lp_cs_in)
        mc_patch_jcc8(c, jb_csi, buf_len(c))
        mc_b4(c, 0x49, 0x03, 0x14, 0xC0) // RDX += lut[x]
        mc_b3(c, 0x49, 0x01, 0xD6)
        mc_b3(c, 0x4D, 0x01, 0xDA)       // s += nt
        j_csc := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_csc, lp_col_sc)
        mc_patch_rel32(c, jg_col_dn, buf_len(c))
        mc_patch_rel32(c, jg_col_dn0, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xF0)       // RAX = total
        mc_ai_leave(c, 0x18)
        cg_reg_helper(cg, h_ai_collatz_range(), s_col, buf_len(c))
    }

    // 76. `h_ai_sieve_seg(seg, primes, np, k0, lim_k) -> i64`: 2x-unrolled byte-clear L1D sieve + POPCNT count (B003)
    if cg_is_helper_used(cg, h_ai_sieve_seg()) {
        while (buf_len(cg.rdata) & 15) != 0 { buf_push(cg.rdata, 0) }
        roff_sv := buf_len(cg.rdata)
        buf_push_u64(cg.rdata, 0x7FBFDFEFF7FBFDFE) // +0: [~1, ~2, ~4, ~8, ~16, ~32, ~64, ~128]

        mc_align16(c)
        s_sv := buf_len(c)
        mc_ai_enter(c, 0x18)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = seg
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = primes
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = np
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = k0
        mc_b4(c, 0x4C, 0x8B, 0x61, 32)   // R12 = lim_k
        cg_lea_rax_rdata(cg, roff_sv)
        mc_b3(c, 0x49, 0x89, 0xC7)       // R15 = &mask8_tbl
        // R14 = lo_odd = (k0 << 1) + 1
        mc_b4(c, 0x4F, 0x8D, 0x74, 0x1B); mc_b1(c, 1) // R14 = R11*2 + 1
        mc_b2(c, 0x31, 0xED)             // RBP = pi = 0 (use RBP as pi!)
        lp_sv_p := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD5); jge_sv_cnt := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x49, 0x8B, 0x1C, 0xE9) // RBX = p = primes[pi]
        mc_b3(c, 0x48, 0x89, 0xD8); mc_b4(c, 0x48, 0x0F, 0xAF, 0xC3) // RAX = m = p * p
        mc_b3(c, 0x4C, 0x39, 0xF0); jae_sv_mok := mc_jcc8(c, 0x73)
        // m < lo_odd: r = lo_odd % p
        mc_b3(c, 0x4C, 0x89, 0xF0); mc_b2(c, 0x31, 0xD2); mc_b3(c, 0x48, 0xF7, 0xF3) // RDX = lo_odd % p
        mc_b3(c, 0x4C, 0x89, 0xF0)       // RAX = lo_odd
        mc_b3(c, 0x48, 0x85, 0xD2); jz_sv_r0 := mc_jcc8(c, 0x74)
        mc_b3(c, 0x48, 0x01, 0xD8); mc_b3(c, 0x48, 0x29, 0xD0) // RAX = lo_odd + p - r
        mc_patch_jcc8(c, jz_sv_r0, buf_len(c))
        mc_b2(c, 0xA8, 1); jnz_sv_mok := mc_jcc8(c, 0x75)
        mc_b3(c, 0x48, 0x01, 0xD8)       // if even, m += p
        mc_patch_jcc8(c, jae_sv_mok, buf_len(c)); mc_patch_jcc8(c, jnz_sv_mok, buf_len(c))
        // k = ((m - 1) >> 1) - k0
        mc_b3(c, 0x48, 0xFF, 0xC8); mc_b3(c, 0x48, 0xD1, 0xE8); mc_b3(c, 0x4C, 0x29, 0xD8)
        // 2x-unrolled byte-clear loop: RAX = k, RSI = k + p, R13 = 2*p
        mc_b4(c, 0x48, 0x8D, 0x34, 0x18) // RSI = k + p
        mc_b4(c, 0x4C, 0x8D, 0x2C, 0x1B) // R13 = 2 * p
        // Save p in [RSP] so RBX/BL is free for 2nd mask!
        mc_b4(c, 0x48, 0x89, 0x1C, 0x24) // [RSP] = p
        lp_sv_k2 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE6); jg_sv_k1 := mc_jcc8(c, 0x7F)
        mc_b3(c, 0x48, 0x89, 0xC2); mc_b2(c, 0x89, 0xC1); mc_b4(c, 0x48, 0xC1, 0xEA, 3); mc_b3(c, 0x83, 0xE1, 7)
        mc_b4(c, 0x41, 0x8A, 0x0C, 0x0F); mc_b4(c, 0x41, 0x20, 0x0C, 0x10) // AND [R8 + RDX], [R15 + RCX]
        mc_b3(c, 0x48, 0x89, 0xF7); mc_b2(c, 0x89, 0xF3); mc_b4(c, 0x48, 0xC1, 0xEF, 3); mc_b3(c, 0x83, 0xE3, 7)
        mc_b4(c, 0x41, 0x8A, 0x1C, 0x1F); mc_b4(c, 0x41, 0x20, 0x1C, 0x38) // AND [R8 + RDI], [R15 + RBX]
        mc_b3(c, 0x4C, 0x01, 0xE8)       // k += 2*p
        mc_b3(c, 0x4C, 0x01, 0xEE)       // k2 += 2*p
        j_sk2 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_sk2, lp_sv_k2)
        mc_patch_jcc8(c, jg_sv_k1, buf_len(c))
        mc_b3(c, 0x4C, 0x39, 0xE0); jg_sv_pnx := mc_jcc8(c, 0x7F)
        mc_b3(c, 0x48, 0x89, 0xC2); mc_b2(c, 0x89, 0xC1); mc_b4(c, 0x48, 0xC1, 0xEA, 3); mc_b3(c, 0x83, 0xE1, 7)
        mc_b4(c, 0x41, 0x8A, 0x0C, 0x0F); mc_b4(c, 0x41, 0x20, 0x0C, 0x10)
        mc_patch_jcc8(c, jg_sv_pnx, buf_len(c))
        mc_b3(c, 0x48, 0xFF, 0xC5)       // pi++
        j_svp := mc_jmp32(c); mc_patch_rel32(c, j_svp, lp_sv_p)

        // Count set bits in seg[0..nw-1], nw = (lim_k >> 6) + 1
        mc_patch_rel32(c, jge_sv_cnt, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xE1); mc_b4(c, 0x48, 0xC1, 0xE9, 6); mc_b3(c, 0x48, 0xFF, 0xC1) // RCX = nw
        mc_b2(c, 0x31, 0xC0)             // RAX = cnt = 0
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_sv_psc := mc_jcc32(c, 0x84)
        mc_b2(c, 0x31, 0xC0)             // RAX = 0
        mc_b2(c, 0x31, 0xF6)             // RSI = 0
        lp_svp := buf_len(c)
        mc_b4(c, 0xF3, 0x49, 0x0F, 0xB8); mc_b2(c, 0x14, 0xF0) // POPCNT RDX, [R8 + RSI*8]
        mc_b3(c, 0x48, 0x01, 0xD0)
        mc_b3(c, 0x48, 0xFF, 0xC6); mc_b3(c, 0x48, 0x39, 0xCE)
        jb_svp := mc_jcc8(c, 0x72); mc_patch_jcc8(c, jb_svp, lp_svp)
        j_sv_dn := mc_jmp32(c)
        // Scalar SWAR popcnt fallback (no POPCNT)
        mc_patch_rel32(c, jz_sv_psc, buf_len(c))
        mc_b2(c, 0x31, 0xC0)             // RAX = cnt
        mc_b2(c, 0x31, 0xF6)             // RSI = 0
        mc_b2(c, 0x49, 0xBB); mc_u64(c, 0x5555555555555555)
        mc_b2(c, 0x49, 0xBC); mc_u64(c, 0x3333333333333333)
        mc_b2(c, 0x49, 0xBD); mc_u64(c, 0x0F0F0F0F0F0F0F0F)
        mc_b2(c, 0x49, 0xBE); mc_u64(c, 0x0101010101010101)
        lp_svs := buf_len(c)
        mc_b4(c, 0x49, 0x8B, 0x14, 0xF0) // RDX = w
        mc_b3(c, 0x48, 0x89, 0xD3); mc_b3(c, 0x48, 0xD1, 0xEB); mc_b3(c, 0x4C, 0x21, 0xDB); mc_b3(c, 0x48, 0x29, 0xDA)
        mc_b3(c, 0x48, 0x89, 0xD3); mc_b3(c, 0x4C, 0x21, 0xE2); mc_b4(c, 0x48, 0xC1, 0xEB, 2); mc_b3(c, 0x4C, 0x21, 0xE3); mc_b3(c, 0x48, 0x01, 0xDA)
        mc_b3(c, 0x48, 0x89, 0xD3); mc_b4(c, 0x48, 0xC1, 0xEB, 4); mc_b3(c, 0x48, 0x01, 0xDA); mc_b3(c, 0x4C, 0x21, 0xEA)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xD6); mc_b4(c, 0x48, 0xC1, 0xEA, 56); mc_b3(c, 0x48, 0x01, 0xD0)
        mc_b3(c, 0x48, 0xFF, 0xC6); mc_b3(c, 0x48, 0x39, 0xCE)
        jb_svs := mc_jcc8(c, 0x72); mc_patch_jcc8(c, jb_svs, lp_svs)
        mc_patch_rel32(c, j_sv_dn, buf_len(c))
        mc_ai_leave(c, 0x18)
        cg_reg_helper(cg, h_ai_sieve_seg(), s_sv, buf_len(c))
    }

    // 77. `h_ai_fw_block_i32(d, n, k0_k1, i0_i1, j0_j1) -> i64`: Blocked AVX2 Floyd-Warshall tile (Y0..Y3 cached row_k, ZERO XMM6..15 saves!)
    if cg_is_helper_used(cg, h_ai_fw_block_i32()) {
        mc_align16(c)
        s_fwb := buf_len(c)
        mc_ai_enter(c, 0x38) // [0]=j0, [8]=j1, [16]=i0, [24]=i1, [32]=k1, [40]=n*4
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = d
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = n
        mc_b4(c, 0x48, 0x8B, 0x41, 16)   // RAX = k0_k1
        mc_b4(c, 0x48, 0x8B, 0x51, 24)   // RDX = i0_i1
        mc_b4(c, 0x4C, 0x8B, 0x51, 32)   // R10 = j0_j1
        mc_b3(c, 0x4D, 0x89, 0xCB); mc_b4(c, 0x49, 0xC1, 0xE3, 2) // R11 = stride = n * 4
        mc_b4(c, 0x4C, 0x89, 0x5C, 0x24); mc_b1(c, 40)
        // Unpack k0 (R12), k1 ([RSP+32]), i0 ([RSP+16]), i1 ([RSP+24]), j0 (R13), j1 ([RSP+8])
        mc_b3(c, 0x49, 0x89, 0xC4); mc_b4(c, 0x49, 0xC1, 0xEC, 32) // R12 = k0
        mc_b2(c, 0x89, 0xC0); mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 32) // [32] = k1
        mc_b3(c, 0x48, 0x89, 0xD0); mc_b4(c, 0x48, 0xC1, 0xE8, 32); mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 16) // [16] = i0
        mc_b2(c, 0x89, 0xD2); mc_b4(c, 0x48, 0x89, 0x54, 0x24); mc_b1(c, 24) // [24] = i1
        mc_b3(c, 0x4D, 0x89, 0xD5); mc_b4(c, 0x49, 0xC1, 0xED, 32) // R13 = j0
        mc_b3(c, 0x45, 0x89, 0xD2); mc_b4(c, 0x4C, 0x89, 0x54, 0x24); mc_b1(c, 8) // [8] = j1
        mc_b4(c, 0x4C, 0x89, 0x6C, 0x24); mc_b1(c, 0) // [0] = j0

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_fwb_sc := mc_jcc32(c, 0x84)
        // Fast AVX2 32-col unrolled path when j1 - j0 == 32!
        mc_b4(c, 0x48, 0x8B, 0x44, 0x24); mc_b1(c, 8)
        mc_b3(c, 0x4C, 0x29, 0xE8); mc_b4(c, 0x48, 0x83, 0xF8, 32); jne_fwb_sc := mc_jcc32(c, 0x85)
        // R14 = &d[k0][j0], RBP = &d[i0][0], R15 = j0 * 4
        mc_b3(c, 0x4D, 0x89, 0xEF); mc_b4(c, 0x49, 0xC1, 0xE7, 2) // R15 = j0 * 4
        mc_b3(c, 0x4C, 0x89, 0xE0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC3) // RAX = k0 * stride
        mc_b4(c, 0x4D, 0x8D, 0x34, 0x00); mc_b3(c, 0x4D, 0x01, 0xFE) // R14 = d + k0*stride + j0*4
        mc_b4(c, 0x48, 0x8B, 0x44, 0x24); mc_b1(c, 16)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC3); mc_b4(c, 0x49, 0x8D, 0x2C, 0x00) // RBP = d + i0*stride
        lp_fwb_k := buf_len(c)
        mc_b4(c, 0x4C, 0x3B, 0x64, 0x24); mc_b1(c, 32); jge_fwb_dn := mc_jcc32(c, 0x8D)
        // Load entire 32-i32 row d[k][j0..j0+31] ONCE into Y0..Y3!
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b1(c, 0x06)        // Y0 = [R14]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x4E, 32)    // Y1 = [R14+32]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x56, 64)    // Y2 = [R14+64]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x5E, 96)    // Y3 = [R14+96]
        mc_b4(c, 0x48, 0x8B, 0x4C, 0x24); mc_b1(c, 16)                  // RCX = i = i0
        mc_b4(c, 0x48, 0x8B, 0x54, 0x24); mc_b1(c, 24)                  // RDX = i1
        mc_b3(c, 0x48, 0x89, 0xEE)                                      // RSI = row_i = RBP
        mc_align16_nop(c)
        lp_fwb_i := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD1); jge_fwb_idn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x42, 0x8B, 0x04, 0xA6)                                // EAX = row_i[k]
        mc_b1(c, 0x3D); mc_u32(c, 1000000000); jge_fwb_sk := mc_jcc8(c, 0x7D)
        mc_vex3(c, 0, 1, 0, 2, 0, 0, 1, 1, 0x58); mc_b2(c, 0x24, 0xA6)  // VPBROADCASTD Y4, [RSI + R12*4]
        mc_b4(c, 0x4A, 0x8D, 0x3C, 0x3E)                                // RDI = row_i + j0*4
        mc_vex256(c, 1, 5, 0, 4, 0xFE); mc_vex3(c, 0, 0, 0, 2, 0, 5, 1, 1, 0x39); mc_b1(c, 0x2F); mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b1(c, 0x2F)
        mc_vex256(c, 1, 5, 1, 4, 0xFE); mc_vex3(c, 0, 0, 0, 2, 0, 5, 1, 1, 0x39); mc_b2(c, 0x6F, 32); mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x6F, 32)
        mc_vex256(c, 1, 5, 2, 4, 0xFE); mc_vex3(c, 0, 0, 0, 2, 0, 5, 1, 1, 0x39); mc_b2(c, 0x6F, 64); mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x6F, 64)
        mc_vex256(c, 1, 5, 3, 4, 0xFE); mc_vex3(c, 0, 0, 0, 2, 0, 5, 1, 1, 0x39); mc_b2(c, 0x6F, 96); mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x6F, 96)
        mc_patch_jcc8(c, jge_fwb_sk, buf_len(c))
        mc_b3(c, 0x4C, 0x01, 0xDE) // RSI += stride
        mc_b3(c, 0x48, 0xFF, 0xC1)
        j_fwbi := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_fwbi, lp_fwb_i)
        mc_patch_rel32(c, jge_fwb_idn, buf_len(c))
        mc_b3(c, 0x4D, 0x01, 0xDE) // R14 += stride
        mc_b3(c, 0x49, 0xFF, 0xC4) // k++
        j_fwbk := mc_jmp32(c); mc_patch_rel32(c, j_fwbk, lp_fwb_k)
        mc_patch_rel32(c, jge_fwb_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        j_fwb_ret := mc_jmp32(c)

        // Exact scalar fallback
        mc_patch_rel32(c, jz_fwb_sc, buf_len(c))
        mc_patch_rel32(c, jne_fwb_sc, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xE0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC3); mc_b4(c, 0x4D, 0x8D, 0x34, 0x00) // R14 = &d[k0][0]
        mc_b4(c, 0x48, 0x8B, 0x44, 0x24); mc_b1(c, 16); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC3); mc_b4(c, 0x49, 0x8D, 0x2C, 0x00) // RBP = &d[i0][0]
        lp_fwbs_k := buf_len(c)
        mc_b4(c, 0x4C, 0x3B, 0x64, 0x24); mc_b1(c, 32); jge_fwbs_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x48, 0x8B, 0x4C, 0x24); mc_b1(c, 16)
        mc_b3(c, 0x48, 0x89, 0xEE) // RSI = row_i
        lp_fwbs_i := buf_len(c)
        mc_b4(c, 0x48, 0x3B, 0x4C, 0x24); mc_b1(c, 24); jge_fwbs_idn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x42, 0x8B, 0x14, 0xA6) // EDX = d[i][k]
        mc_b2(c, 0x81, 0xFA); mc_u32(c, 1000000000); jge_fwbs_sk := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x4C, 0x89, 0xEB) // RBX = j = j0
        mc_b4(c, 0x48, 0x8B, 0x7C, 0x24); mc_b1(c, 8) // RDI = j1
        lp_fwbs_j := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xFB); jge_fwbs_jdn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x41, 0x8B, 0x04, 0x9E) // EAX = d[k][j]
        mc_b2(c, 0x01, 0xD0)             // EAX = d[k][j] + d[i][k]
        mc_b3(c, 0x3B, 0x04, 0x9E); jge_fwbs_nc := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x89, 0x04, 0x9E)       // d[i][j] = EAX
        mc_patch_jcc8(c, jge_fwbs_nc, buf_len(c))
        mc_b3(c, 0x48, 0xFF, 0xC3); j_fwbsj := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_fwbsj, lp_fwbs_j)
        mc_patch_jcc8(c, jge_fwbs_jdn, buf_len(c))
        mc_patch_jcc8(c, jge_fwbs_sk, buf_len(c))
        mc_b3(c, 0x4C, 0x01, 0xDE); mc_b3(c, 0x48, 0xFF, 0xC1)
        j_fwbsi := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_fwbsi, lp_fwbs_i)
        mc_patch_rel32(c, jge_fwbs_idn, buf_len(c))
        mc_b3(c, 0x4D, 0x01, 0xDE); mc_b3(c, 0x49, 0xFF, 0xC4)
        j_fwbsk := mc_jmp32(c); mc_patch_rel32(c, j_fwbsk, lp_fwbs_k)
        mc_patch_rel32(c, jge_fwbs_dn, buf_len(c))
        mc_patch_rel32(c, j_fwb_ret, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_ai_leave(c, 0x38)
        cg_reg_helper(cg, h_ai_fw_block_i32(), s_fwb, buf_len(c))
    }

    // 78. `h_ai_cholesky_blk_f64(l, n, k0_k1, i0_i1, mode_tid_nt) -> f64`: Blocked parallel Cholesky (mode 0=diag, 1=TRSM, 2=SYRK cyclic!)
    if cg_is_helper_used(cg, h_ai_cholesky_blk_f64()) {
        while (buf_len(cg.rdata) & 15) != 0 { buf_push(cg.rdata, 0) }
        roff_cb := buf_len(cg.rdata)
        buf_push_u64(cg.rdata, 0x3FF0000000000000) // +0: 1.0

        mc_align16(c)
        s_cb := buf_len(c)
        mc_ai_enter(c, 0xE8) // [0..159]=XMM6..15, [160]=k0, [168]=k1, [176]=i0, [184]=i1, [192]=tid, [200]=nt, [208]=stride(n*8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = l
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = n
        mc_b4(c, 0x48, 0x8B, 0x41, 16)   // RAX = k0_k1
        mc_b4(c, 0x48, 0x8B, 0x51, 24)   // RDX = i0_i1
        mc_b4(c, 0x4C, 0x8B, 0x51, 32)   // R10 = mode | (tid<<8) | (nt<<16)
        mc_b3(c, 0x4D, 0x89, 0xCB); mc_b4(c, 0x49, 0xC1, 0xE3, 3) // R11 = stride = n*8
        mc_b4(c, 0x4C, 0x89, 0x9C, 0x24); mc_u32(c, 208)
        mc_b3(c, 0x48, 0x89, 0xC3); mc_b4(c, 0x48, 0xC1, 0xEB, 32); mc_b4(c, 0x48, 0x89, 0x9C, 0x24); mc_u32(c, 160) // [160]=k0
        mc_b2(c, 0x89, 0xC0); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 168) // [168]=k1
        mc_b3(c, 0x48, 0x89, 0xD3); mc_b4(c, 0x48, 0xC1, 0xEB, 32); mc_b4(c, 0x48, 0x89, 0x9C, 0x24); mc_u32(c, 176) // [176]=i0
        mc_b2(c, 0x89, 0xD2); mc_b4(c, 0x48, 0x89, 0x94, 0x24); mc_u32(c, 184) // [184]=i1
        mc_b3(c, 0x4C, 0x89, 0xD0); mc_b4(c, 0x48, 0xC1, 0xE8, 8); mc_b3(c, 0x25, 0xFF, 0); mc_b2(c, 0, 0)
        mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 192) // [192]=tid
        mc_b3(c, 0x4C, 0x89, 0xD0); mc_b4(c, 0x48, 0xC1, 0xE8, 16); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 200) // [200]=nt
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) // X0 = ret = 0.0
        mc_b4(c, 0x41, 0x83, 0xE2, 3)    // R10 = mode (0, 1, 2)
        mc_b4(c, 0x49, 0x83, 0xFA, 2); je_cb_m2 := mc_jcc32(c, 0x84)
        mc_b4(c, 0x49, 0x83, 0xFA, 1); je_cb_m1 := mc_jcc32(c, 0x84)

        // === MODE 0: Diagonal block Cholesky [k0..k1), returns sum(L[j,j]) in X0! ===
        mc_b4(c, 0x4C, 0x8B, 0xA4, 0x24); mc_u32(c, 160) // R12 = j = k0
        mc_b4(c, 0x4C, 0x8B, 0xAC, 0x24); mc_u32(c, 168) // R13 = k1
        mc_b3(c, 0x4C, 0x89, 0xE0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC3); mc_b4(c, 0x49, 0x8D, 0x34, 0x00) // RSI = lj = l + k0*stride
        lp_cb0_j := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xEC); jge_cb0_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x10); mc_b2(c, 0x0C, 0xE6) // X1 = lj[j]
        mc_b4(c, 0x48, 0x8B, 0x8C, 0x24); mc_u32(c, 160)       // RCX = k = k0
        lp_cb0_dk := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE1); jge_cb0_dk := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x14); mc_b1(c, 0xCE)       // X2 = lj[k]
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xD2); mc_b4(c, 0xF2, 0x0F, 0x5C, 0xCA) // X1 -= X2*X2
        mc_b3(c, 0x48, 0xFF, 0xC1); j_cb0dk := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cb0dk, lp_cb0_dk)
        mc_patch_jcc8(c, jge_cb0_dk, buf_len(c))
        mc_b4(c, 0xF2, 0x0F, 0x51, 0xC9)                       // X1 = sqrt(X1) = ljj
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x11); mc_b2(c, 0x0C, 0xE6) // lj[j] = ljj
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)                       // X0 += ljj
        cg_lea_rax_rdata(cg, roff_cb); mc_b4(c, 0xF2, 0x0F, 0x10, 0x18); mc_b4(c, 0xF2, 0x0F, 0x5E, 0xD9) // X3 = 1.0 / ljj
        // Update rows i = j+1 .. k1-1 inside block
        mc_b4(c, 0x4D, 0x8D, 0x74, 0x24); mc_b1(c, 1)          // R14 = i = j + 1
        mc_b4(c, 0x4A, 0x8D, 0x3C, 0x1E)                       // RDI = li = lj + stride
        lp_cb0_i := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xEE); jge_cb0_idn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x10); mc_b2(c, 0x24, 0xE7) // X4 = li[j]
        mc_b4(c, 0x48, 0x8B, 0x8C, 0x24); mc_u32(c, 160)       // RCX = k = k0
        lp_cb0_ik := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE1); jge_cb0_ik := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x2C); mc_b1(c, 0xCF)       // X5 = li[k]
        mc_b4(c, 0xF2, 0x0F, 0x59, 0x2C); mc_b1(c, 0xCE)       // X5 *= lj[k]
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xE5)                       // X4 -= X5
        mc_b3(c, 0x48, 0xFF, 0xC1); j_cb0ik := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cb0ik, lp_cb0_ik)
        mc_patch_jcc8(c, jge_cb0_ik, buf_len(c))
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xE3)                       // X4 *= inv_ljj
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x11); mc_b2(c, 0x24, 0xE7) // li[j] = X4
        mc_b3(c, 0x4C, 0x01, 0xDF); mc_b3(c, 0x49, 0xFF, 0xC6)
        j_cb0i := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cb0i, lp_cb0_i)
        mc_patch_jcc8(c, jge_cb0_idn, buf_len(c))
        mc_b3(c, 0x4C, 0x01, 0xDE); mc_b3(c, 0x49, 0xFF, 0xC4)
        j_cb0j := mc_jmp32(c); mc_patch_rel32(c, j_cb0j, lp_cb0_j)
        mc_patch_rel32(c, jge_cb0_dn, buf_len(c))
        j_cb_ret0 := mc_jmp32(c)

        // === MODE 1: Panel TRSM for rows i in [i0..i1), cols j in [k0..k1) ===
        mc_patch_rel32(c, je_cb_m1, buf_len(c))
        mc_b4(c, 0x4C, 0x8B, 0xAC, 0x24); mc_u32(c, 168) // R13 = k1
        mc_b4(c, 0x4C, 0x8B, 0xB4, 0x24); mc_u32(c, 176) // R14 = i = i0
        mc_b3(c, 0x4C, 0x89, 0xF0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC3); mc_b4(c, 0x49, 0x8D, 0x3C, 0x00) // RDI = li = l + i0*stride
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 160); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC3); mc_b4(c, 0x49, 0x8D, 0x2C, 0x00) // RBP = l + k0*stride
        lp_cb1_i := buf_len(c)
        mc_b4(c, 0x4C, 0x3B, 0xB4, 0x24); mc_u32(c, 184); jge_cb1_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4C, 0x8B, 0xA4, 0x24); mc_u32(c, 160) // R12 = j = k0
        mc_b3(c, 0x48, 0x89, 0xEE)                       // RSI = lj = RBP
        lp_cb1_j := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xEC); jge_cb1_jdn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x10); mc_b2(c, 0x24, 0xE7) // X4 = li[j]
        mc_b4(c, 0x48, 0x8B, 0x8C, 0x24); mc_u32(c, 160) // RCX = k = k0
        lp_cb1_k := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE1); jge_cb1_k := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x2C); mc_b1(c, 0xCF) // X5 = li[k]
        mc_b4(c, 0xF2, 0x0F, 0x59, 0x2C); mc_b1(c, 0xCE) // X5 *= lj[k]
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xE5)                 // X4 -= X5
        mc_b3(c, 0x48, 0xFF, 0xC1); j_cb1k := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cb1k, lp_cb1_k)
        mc_patch_jcc8(c, jge_cb1_k, buf_len(c))
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x5E); mc_b2(c, 0x24, 0xE6) // X4 /= lj[j]
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x11); mc_b2(c, 0x24, 0xE7) // li[j] = X4
        mc_b3(c, 0x4C, 0x01, 0xDE); mc_b3(c, 0x49, 0xFF, 0xC4)
        j_cb1j := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cb1j, lp_cb1_j)
        mc_patch_jcc8(c, jge_cb1_jdn, buf_len(c))
        mc_b3(c, 0x4C, 0x01, 0xDF); mc_b3(c, 0x49, 0xFF, 0xC6)
        j_cb1i := mc_jmp32(c); mc_patch_rel32(c, j_cb1i, lp_cb1_i)
        mc_patch_rel32(c, jge_cb1_dn, buf_len(c))
        j_cb_ret1 := mc_jmp32(c)

        // === MODE 2: Parallel Cyclic SYRK Trailing Update (i = k1+tid .. n-1 step nt; j = k1..i) ===
        mc_patch_rel32(c, je_cb_m2, buf_len(c))
        mc_b4(c, 0x4C, 0x8B, 0xA4, 0x24); mc_u32(c, 160) // R12 = k0
        mc_b4(c, 0x4C, 0x8B, 0xAC, 0x24); mc_u32(c, 168) // R13 = k1
        mc_b4(c, 0x4C, 0x8B, 0xB4, 0x24); mc_u32(c, 192) // R14 = tid
        mc_b3(c, 0x4D, 0x01, 0xEE)                       // R14 = i = k1 + tid
        mc_b4(c, 0x4C, 0x8B, 0xBC, 0x24); mc_u32(c, 200) // R15 = nt
        // RBP = &l[k1][k0]
        mc_b3(c, 0x4C, 0x89, 0xE8); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC3)
        mc_b4(c, 0x49, 0x8D, 0x2C, 0x00); mc_b4(c, 0x4A, 0x8D, 0x6C, 0xE5); mc_b1(c, 0) // RBP = l + k1*stride + k0*8
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_cb2_sc := mc_jcc32(c, 0x84)
        mc_b3(c, 0x4C, 0x89, 0xE8); mc_b3(c, 0x4C, 0x29, 0xE0); mc_b4(c, 0x48, 0x83, 0xF8, 32); jne_cb2_sc := mc_jcc32(c, 0x85)

        // AVX2+FMA3 32-wide SYRK: load ENTIRE row L[i, k0..k0+31] ONCE into Y8..Y15 (ZERO reloads across all j!)
        lp_cb2_i := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xCE); jge_cb2_dn := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4C, 0x89, 0xF0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC3); mc_b4(c, 0x49, 0x8D, 0x3C, 0x00) // RDI = &l[i][0]
        mc_b4(c, 0x4A, 0x8D, 0x04, 0xE7)                                                               // RAX = &l[i][k0]
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x00)             // Y8  = [RAX+0]
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x48, 32)         // Y9  = [RAX+32]
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x50, 64)         // Y10 = [RAX+64]
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x58, 96)         // Y11 = [RAX+96]
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0xA0); mc_u32(c, 128) // Y12
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0xA8); mc_u32(c, 160) // Y13
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0xB0); mc_u32(c, 192) // Y14
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0xB8); mc_u32(c, 224) // Y15
        mc_b3(c, 0x4C, 0x89, 0xE9) // RCX = j = k1
        mc_b3(c, 0x48, 0x89, 0xEE) // RSI = &l[j][k0] = RBP
        mc_align16_nop(c)
        lp_cb2_j := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xF1); jg_cb2_jdn := mc_jcc32(c, 0x8F)
        mc_vex3(c, 0, 0, 0, 1, 0, 8, 1, 1, 0x59); mc_b1(c, 0x06)             // Y0 = Y8  * [RSI+0]
        mc_vex3(c, 0, 0, 0, 1, 0, 9, 1, 1, 0x59); mc_b2(c, 0x4E, 32)         // Y1 = Y9  * [RSI+32]
        mc_vex3(c, 0, 0, 0, 1, 0, 10, 1, 1, 0x59); mc_b2(c, 0x56, 64)        // Y2 = Y10 * [RSI+64]
        mc_vex3(c, 0, 0, 0, 1, 0, 11, 1, 1, 0x59); mc_b2(c, 0x5E, 96)        // Y3 = Y11 * [RSI+96]
        mc_vex3(c, 0, 0, 0, 2, 1, 12, 1, 1, 0xB8); mc_b1(c, 0x86); mc_u32(c, 128) // Y0 += Y12 * [RSI+128]
        mc_vex3(c, 0, 0, 0, 2, 1, 13, 1, 1, 0xB8); mc_b1(c, 0x8E); mc_u32(c, 160) // Y1 += Y13 * [RSI+160]
        mc_vex3(c, 0, 0, 0, 2, 1, 14, 1, 1, 0xB8); mc_b1(c, 0x96); mc_u32(c, 192) // Y2 += Y14 * [RSI+192]
        mc_vex3(c, 0, 0, 0, 2, 1, 15, 1, 1, 0xB8); mc_b1(c, 0x9E); mc_u32(c, 224) // Y3 += Y15 * [RSI+224]
        mc_vex256(c, 1, 0, 0, 1, 0x58); mc_vex256(c, 1, 2, 2, 3, 0x58); mc_vex256(c, 1, 0, 0, 2, 0x58)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC1, 1)          // VEXTRACTF128 X1, Y0, 1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x58); mc_b1(c, 0xC1)             // VADDPD X0, X0, X1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x15); mc_b1(c, 0xC8)             // VUNPCKHPD X1, X0, X0
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b1(c, 0xC1)             // VADDSD X0, X0, X1 (dot)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x0C, 0xCF)       // X1 = l[i][j]
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 0, 3, 0x5C); mc_b1(c, 0xC8)             // X1 -= dot
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x0C, 0xCF)       // l[i][j] = X1
        mc_b3(c, 0x4C, 0x01, 0xDE); mc_b3(c, 0x48, 0xFF, 0xC1)
        j_cb2j := mc_jmp32(c); mc_patch_rel32(c, j_cb2j, lp_cb2_j)
        mc_patch_rel32(c, jg_cb2_jdn, buf_len(c))
        mc_b3(c, 0x4D, 0x01, 0xFE) // i += nt
        j_cb2i := mc_jmp32(c); mc_patch_rel32(c, j_cb2i, lp_cb2_i)
        mc_patch_rel32(c, jge_cb2_dn, buf_len(c))
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) // X0 = 0.0
        mc_b3(c, 0xC5, 0xF8, 0x77)
        j_cb_ret2 := mc_jmp32(c)

        // Exact scalar SSE2 fallback for Mode 2
        mc_patch_rel32(c, jz_cb2_sc, buf_len(c))
        mc_patch_rel32(c, jne_cb2_sc, buf_len(c))
        lp_cb2s_i := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xCE); jge_cb2s_dn := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4C, 0x89, 0xF0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC3); mc_b4(c, 0x49, 0x8D, 0x3C, 0x00) // RDI = &l[i][0]
        mc_b3(c, 0x4C, 0x89, 0xE9) // RCX = j = k1
        mc_b3(c, 0x48, 0x89, 0xEE) // RSI = &l[j][k0] = RBP
        lp_cb2s_j := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xF1); jg_cb2s_jdn := mc_jcc8(c, 0x7F)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x0C); mc_b1(c, 0xCF) // X1 = l[i][j]
        mc_b3(c, 0x4C, 0x89, 0xE2) // RDX = k = k0
        mc_b3(c, 0x48, 0x89, 0xF0) // RAX = &l[j][k]
        lp_cb2s_k := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xEA); jge_cb2s_k := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x14); mc_b1(c, 0xD7) // X2 = l[i][k]
        mc_b4(c, 0xF2, 0x0F, 0x59, 0x10)                 // X2 *= [RAX]
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xCA)                 // X1 -= X2
        mc_b4(c, 0x48, 0x83, 0xC0, 8); mc_b3(c, 0x48, 0xFF, 0xC2)
        j_cb2sk := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cb2sk, lp_cb2s_k)
        mc_patch_jcc8(c, jge_cb2s_k, buf_len(c))
        mc_b4(c, 0xF2, 0x0F, 0x11, 0x0C); mc_b1(c, 0xCF)
        mc_b3(c, 0x4C, 0x01, 0xDE); mc_b3(c, 0x48, 0xFF, 0xC1)
        j_cb2sj := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cb2sj, lp_cb2s_j)
        mc_patch_jcc8(c, jg_cb2s_jdn, buf_len(c))
        mc_b3(c, 0x4D, 0x01, 0xFE); j_cb2si := mc_jmp32(c); mc_patch_rel32(c, j_cb2si, lp_cb2s_i)
        mc_patch_rel32(c, jge_cb2s_dn, buf_len(c))
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0)

        mc_patch_rel32(c, j_cb_ret0, buf_len(c))
        mc_patch_rel32(c, j_cb_ret1, buf_len(c))
        mc_patch_rel32(c, j_cb_ret2, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xE8)
        cg_reg_helper(cg, h_ai_cholesky_blk_f64(), s_cb, buf_len(c))
    }

    // 79. `h_ai_row_max_sub_f64(a, b, n, mode) -> f64`: mode 0: mx=max(a), b[i]=mx-a[i]; mode 1: exact dot(a,b,n) (B098)
    if cg_is_helper_used(cg, h_ai_row_max_sub_f64()) {
        mc_align16(c)
        s_rms := buf_len(c)
        mc_ai_enter(c, 0x18) // Volatile Y0..Y5 only! ZERO XMM6..15 saves!
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = a
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = b
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = n
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = mode
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) // X0 = 0.0
        mc_b3(c, 0x4D, 0x85, 0xD2); jle_rms_dn := mc_jcc32(c, 0x8E)
        mc_b4(c, 0x49, 0x83, 0xFB, 2); je_rms_sum := mc_jcc32(c, 0x84)
        mc_b3(c, 0x4D, 0x85, 0xDB); jnz_rms_dot := mc_jcc32(c, 0x85)

        // MODE 0: mx = max(a[0..n-1]), b[i] = mx - a[i]
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_rms0_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x49, 0x83, 0xFA, 8); jl_rms0_sc := mc_jcc32(c, 0x8C)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x00)     // Y0 = a[0..3]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x48, 32) // Y1 = a[4..7]
        mc_b1(c, 0xB9); mc_u32(c, 8)
        mc_b4(c, 0x4D, 0x8D, 0x62, 0xF8) // R12 = n - 8
        lp_rm_m8 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE1); jg_rm_mt := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x5F); mc_b2(c, 0x04, 0xC8)     // VMAXPD Y0, Y0, [R8+RCX*8]
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 1, 1, 0x5F); mc_b3(c, 0x4C, 0xC8, 32) // VMAXPD Y1, Y1, [R8+RCX*8+32]
        mc_b4(c, 0x48, 0x83, 0xC1, 8); j_rmm8 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rmm8, lp_rm_m8)
        mc_patch_jcc8(c, jg_rm_mt, buf_len(c))
        mc_vex256(c, 1, 0, 0, 1, 0x5F)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC1, 1) // VEXTRACTF128 X1, Y0, 1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x5F); mc_b1(c, 0xC1)    // VMAXPD X0, X0, X1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x15); mc_b1(c, 0xC8)    // VUNPCKHPD X1, X0, X0
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x5F); mc_b1(c, 0xC1)    // VMAXSD X0, X0, X1
        lp_rm_mt1 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jge_rm_s := mc_jcc8(c, 0x7D)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x5F); mc_b2(c, 0x04, 0xC8)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_rmmt1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rmmt1, lp_rm_mt1)
        mc_patch_jcc8(c, jge_rm_s, buf_len(c))
        // Broadcast mx -> Y2, write b[i] = mx - a[i] 8-wide!
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0xD0) // VBROADCASTSD Y2, X0
        mc_b2(c, 0x31, 0xC9)
        lp_rm_s8 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE1); jg_rm_st := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 1, 1, 0, 2, 1, 1, 0x5C); mc_b2(c, 0x1C, 0xC8)     // Y3 = Y2 - [R8+RCX*8]
        mc_vex3(c, 0, 0, 1, 1, 0, 2, 1, 1, 0x5C); mc_b3(c, 0x64, 0xC8, 32) // Y4 = Y2 - [R8+RCX*8+32]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x1C, 0xC9)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b3(c, 0x64, 0xC9, 32)
        mc_b4(c, 0x48, 0x83, 0xC1, 8); j_rms8 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rms8, lp_rm_s8)
        mc_patch_jcc8(c, jg_rm_st, buf_len(c))
        lp_rm_st1 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jge_rm_d := mc_jcc8(c, 0x7D)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x5C); mc_b2(c, 0x0C, 0xC8)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x0C, 0xC9)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_rmst1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rmst1, lp_rm_st1)
        mc_patch_jcc8(c, jge_rm_d, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        j_rms_ret0 := mc_jmp32(c)
        // Scalar Mode 0
        mc_patch_rel32(c, jz_rms0_sc, buf_len(c)); mc_patch_rel32(c, jl_rms0_sc, buf_len(c))
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b1(c, 0x00) // X0 = a[0]
        mc_b1(c, 0xB9); mc_u32(c, 1)
        lp_rms0_m := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jge_rms0_s := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x5F); mc_b2(c, 0x04, 0xC8)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_rms0m := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rms0m, lp_rms0_m)
        mc_patch_jcc8(c, jge_rms0_s, buf_len(c))
        mc_b2(c, 0x31, 0xC9)
        lp_rms0_sub := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jge_rms0_d := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xC8); mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b2(c, 0x0C, 0xC8)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x0C, 0xC9)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_rms0s := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rms0s, lp_rms0_sub)
        mc_patch_jcc8(c, jge_rms0_d, buf_len(c))
        j_rms_ret1 := mc_jmp32(c)

        // MODE 1: 8-wide AVX2+FMA3 dot(a, b, n) -> X0!
        mc_patch_rel32(c, jnz_rms_dot, buf_len(c))
        mc_b2(c, 0x31, 0xC9)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_rms1_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x49, 0x83, 0xFA, 8); jl_rms1_sc := mc_jcc32(c, 0x8C)
        mc_vex256(c, 1, 0, 0, 0, 0x57); mc_vex256(c, 1, 1, 1, 1, 0x57)
        mc_b4(c, 0x4D, 0x8D, 0x62, 0xF8)
        lp_rm_d8 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE1); jg_rm_dt := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x14, 0xC8)     // Y2 = a[i..i+3]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x5C, 0xC8, 32) // Y3 = a[i+4..i+7]
        mc_vex3(c, 0, 0, 1, 2, 1, 2, 1, 1, 0xB8); mc_b2(c, 0x04, 0xC9)     // VFMADD231PD Y0, Y2, [R9+RCX*8]
        mc_vex3(c, 0, 0, 1, 2, 1, 3, 1, 1, 0xB8); mc_b3(c, 0x4C, 0xC9, 32) // VFMADD231PD Y1, Y3, [R9+RCX*8+32]
        mc_b4(c, 0x48, 0x83, 0xC1, 8); j_rmd8 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rmd8, lp_rm_d8)
        mc_patch_jcc8(c, jg_rm_dt, buf_len(c))
        mc_vex256(c, 1, 0, 0, 1, 0x58)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC1, 1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x58); mc_b1(c, 0xC1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x15); mc_b1(c, 0xC8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b1(c, 0xC1)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_patch_rel32(c, jz_rms1_sc, buf_len(c)); mc_patch_rel32(c, jl_rms1_sc, buf_len(c))
        lp_rm_dt1 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jge_rm_dn1 := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xC8)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x0C, 0xC9)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_rmdt1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rmdt1, lp_rm_dt1)
        mc_patch_jcc8(c, jge_rm_dn1, buf_len(c))

        mc_patch_rel32(c, j_rms_ret0, buf_len(c))
        mc_patch_rel32(c, j_rms_ret1, buf_len(c))
        jmp_rms_skip2 := mc_jmp32(c)
        // MODE 2: 8-wide AVX2 signed f64 sum of a[0..n-1] (volatile Y0..Y3 only)
        mc_patch_rel32(c, je_rms_sum, buf_len(c))
        mc_b2(c, 0x31, 0xC9) // RCX = i = 0
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_rms2_sc := mc_jcc32(c, 0x84)
        mc_vex2(c, 0, 1, 1, 0x57, 0xC0); mc_vex2(c, 1, 1, 1, 0x57, 0xC9)
        mc_vex2(c, 2, 1, 1, 0x57, 0xD2); mc_vex2(c, 3, 1, 1, 0x57, 0xDB)
        mc_b4(c, 0x49, 0x8D, 0x52, 0xF0) // RDX = n - 16
        lp_rms2v := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD1); jg_rms2r := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x58); mc_b2(c, 0x04, 0xC8)
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 1, 1, 0x58); mc_b3(c, 0x4C, 0xC8, 32)
        mc_vex3(c, 0, 0, 1, 1, 0, 2, 1, 1, 0x58); mc_b3(c, 0x54, 0xC8, 64)
        mc_vex3(c, 0, 0, 1, 1, 0, 3, 1, 1, 0x58); mc_b3(c, 0x5C, 0xC8, 96)
        mc_b4(c, 0x48, 0x83, 0xC1, 16)
        j_rms2v := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rms2v, lp_rms2v)
        mc_patch_jcc8(c, jg_rms2r, buf_len(c))
        mc_vex2(c, 0, 1, 1, 0x58, 0xC1); mc_vex2(c, 2, 1, 1, 0x58, 0xD3); mc_vex2(c, 0, 1, 1, 0x58, 0xC2)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC1, 1)
        mc_vex2(c, 0, 0, 1, 0x58, 0xC1); mc_vex2(c, 0, 0, 1, 0x15, 0xC8); mc_vex2(c, 0, 0, 3, 0x58, 0xC1)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_patch_rel32(c, jz_rms2_sc, buf_len(c))
        lp_rms2s := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jge_rms2s := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x04, 0xC8)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_rms2s := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rms2s, lp_rms2s)
        mc_patch_jcc8(c, jge_rms2s, buf_len(c))
        mc_patch_rel32(c, jmp_rms_skip2, buf_len(c))
                mc_patch_rel32(c, jle_rms_dn, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
        mc_ai_leave(c, 0x18)
        cg_reg_helper(cg, h_ai_row_max_sub_f64(), s_rms, buf_len(c))
    }

    // 80. `h_ai_relu6_sum_f32(px, i0, i1) -> f64`: 8-wide branchless AVX2 ReLU6 f32->f64 sum (B016)
    if cg_is_helper_used(cg, h_ai_relu6_sum_f32()) {
        while (buf_len(cg.rdata) & 15) != 0 { buf_push(cg.rdata, 0) }
        off_r6 := buf_len(cg.rdata)
        buf_push_u32(cg.rdata, 0x40C00000) // +0: f32 6.0
        buf_push_u32(cg.rdata, 0x00000000) // +4: f32 0.0
        buf_push_u64(cg.rdata, 0x4018000000000000) // +8: f64 6.0
        mc_align16(c)
        s_r6 := buf_len(c)
        mc_ai_enter(c, 0x18) // Volatile Y0..Y5 only
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = px
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = i0
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = i1
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) // X0  = 0.0
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_r6_dn := mc_jcc32(c, 0x8D)
        cg_lea_rax_rdata(cg, off_r6)
        mc_b3(c, 0x49, 0x89, 0xC3)       // R11 = &rdata[off_r6]
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_r6_sc := mc_jcc32(c, 0x84)

        // AVX2 8-wide f32 -> 2x4 f64 loop
        mc_vex2(c, 0, 1, 1, 0x57, 0xC0) // VXORPD Y0, Y0, Y0
        mc_vex2(c, 1, 1, 1, 0x57, 0xC9) // VXORPD Y1, Y1, Y1
        mc_vex2(c, 2, 1, 0, 0x57, 0xD2) // VXORPS Y2, Y2, Y2 (0.0f)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x18); mc_b1(c, 0x1B) // VBROADCASTSS Y3, [R11] (6.0f)
        mc_b4(c, 0x49, 0x8D, 0x4A, 0xF8) // RCX = i1 - 8
        mc_align16_nop(c)
        lp_r6a := buf_len(c)
        mc_b3(c, 0x49, 0x39, 0xC9); jg_r6a_done := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 1, 1, 1, 0, 0, 1, 0, 0x10); mc_b2(c, 0x24, 0x88) // VMOVUPS Y4, [R8 + R9*4]
        mc_vex2(c, 4, 1, 0, 0x5F, 0xE2) // VMAXPS Y4, Y4, Y2
        mc_vex2(c, 4, 1, 0, 0x5D, 0xE3) // VMINPS Y4, Y4, Y3
        mc_vex2(c, 0, 1, 0, 0x5A, 0xEC) // VCVTPS2PD Y5, X4
        mc_vex2(c, 0, 1, 1, 0x58, 0xC5) // VADDPD Y0, Y0, Y5
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xE4, 0x01) // VEXTRACTF128 X4, Y4, 1
        mc_vex2(c, 0, 1, 0, 0x5A, 0xE4) // VCVTPS2PD Y4, X4
        mc_vex2(c, 1, 1, 1, 0x58, 0xCC) // VADDPD Y1, Y1, Y4
        mc_b4(c, 0x49, 0x83, 0xC1, 8)   // R9 += 8
        j_r6a := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_r6a, lp_r6a)
        mc_patch_jcc8(c, jg_r6a_done, buf_len(c))
        mc_vex2(c, 0, 1, 1, 0x58, 0xC1) // VADDPD Y0, Y0, Y1
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC1, 0x01) // VEXTRACTF128 X1, Y0, 1
        mc_vex2(c, 0, 0, 1, 0x58, 0xC1) // VADDPD X0, X0, X1
        mc_vex2(c, 0, 0, 1, 0x15, 0xC8) // VUNPCKHPD X1, X0, X0
        mc_vex2(c, 0, 0, 3, 0x58, 0xC1) // VADDSD X0, X0, X1
        mc_b3(c, 0xC5, 0xF8, 0x77)      // VZEROUPPER

        // Scalar tail & --simd=scalar fallback
        mc_patch_rel32(c, jz_r6_sc, buf_len(c))
        mc_b4(c, 0x66, 0x0F, 0x57, 0xD2) // XORPD X2, X2 (0.0)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x5B, 8) // MOVSD X3, [R11+8] (6.0)
        lp_r6s := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_r6s := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF3, 0x43, 0x0F, 0x5A); mc_b2(c, 0x0C, 0x88) // CVTSS2SD X1, [R8 + R9*4]
        mc_b4(c, 0xF2, 0x0F, 0x5F, 0xCA) // MAXSD X1, X2
        mc_b4(c, 0xF2, 0x0F, 0x5D, 0xCB) // MINSD X1, X3
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1) // ADDSD X0, X1
        mc_b3(c, 0x49, 0xFF, 0xC1)
        j_r6s := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_r6s, lp_r6s)
        mc_patch_jcc8(c, jge_r6s, buf_len(c))

        mc_patch_rel32(c, jge_r6_dn, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0) // MOVQ RAX, X0
        mc_ai_leave(c, 0x18)
        cg_reg_helper(cg, h_ai_relu6_sum_f32(), s_r6, buf_len(c))
    }

    // 81. `h_ai_utf8_count(p, i0, i1, out_pair) -> i64`: 64B/iter AVX2 VPCMPGTB(-64)+VPMOVMSKB+POPCNT UTF-8 counter (B027)
    if cg_is_helper_used(cg, h_ai_utf8_count()) {
        mc_align16(c)
        s_u8 := buf_len(c)
        mc_ai_enter(c, 0x18) // Volatile Y0..Y4 only
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = p
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = i0
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = i1
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = out_pair
        mc_b3(c, 0x4D, 0x89, 0xD6); mc_b3(c, 0x4D, 0x29, 0xCE) // R14 = total_bytes = i1 - i0
        mc_b3(c, 0x45, 0x31, 0xE4)       // R12 = cont_cnt = 0
        mc_b3(c, 0x45, 0x31, 0xED)       // R13 = non_asc_cnt = 0
        mc_b3(c, 0x4D, 0x85, 0xF6); jle_u8_dn := mc_jcc32(c, 0x8E)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_u8_sc := mc_jcc32(c, 0x84)

        // AVX2 64-byte/iter loop: signed b < -64 (0xC0) <=> (b & 0xC0) == 0x80
        mc_b1(c, 0xB8); mc_u32(c, 0xC0C0C0C0)
        mc_vex2(c, 0, 0, 1, 0x6E, 0xC0) // VMOVD X0, EAX
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x58); mc_b1(c, 0xC0) // VPBROADCASTD Y0, X0
        mc_b4(c, 0x49, 0x8D, 0x4A, 0xC0) // RCX = i1 - 64
        mc_align16_nop(c)
        lp_u8a := buf_len(c)
        mc_b3(c, 0x49, 0x39, 0xC9); jg_u8a_done := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 1, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x0C, 0x08)      // VMOVDQU Y1, [R8 + R9]
        mc_vex3(c, 0, 1, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x54, 0x08, 32)  // VMOVDQU Y2, [R8 + R9 + 32]
        mc_vex2(c, 0, 1, 1, 0xD7, 0xC1) // VPMOVMSKB EAX, Y1
        mc_vex2(c, 0, 1, 1, 0xD7, 0xD2) // VPMOVMSKB EDX, Y2
        mc_b4(c, 0x48, 0xC1, 0xE2, 32); mc_b3(c, 0x48, 0x09, 0xD0)
        mc_b4(c, 0xF3, 0x48, 0x0F, 0xB8); mc_b1(c, 0xC0) // POPCNT RAX, RAX
        mc_b3(c, 0x49, 0x01, 0xC5)      // R13 += non_asc
        mc_vex2(c, 0, 1, 1, 0x64, 0xD9) // VPCMPGTB Y3, Y0, Y1
        mc_vex2(c, 0, 1, 1, 0x64, 0xE2) // VPCMPGTB Y4, Y0, Y2
        mc_vex2(c, 0, 1, 1, 0xD7, 0xC3) // VPMOVMSKB EAX, Y3
        mc_vex2(c, 0, 1, 1, 0xD7, 0xD4) // VPMOVMSKB EDX, Y4
        mc_b4(c, 0x48, 0xC1, 0xE2, 32); mc_b3(c, 0x48, 0x09, 0xD0)
        mc_b4(c, 0xF3, 0x48, 0x0F, 0xB8); mc_b1(c, 0xC0) // POPCNT RAX, RAX
        mc_b3(c, 0x49, 0x01, 0xC4)      // R12 += cont
        mc_b4(c, 0x49, 0x83, 0xC1, 64)
        j_u8a := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_u8a, lp_u8a)
        mc_patch_jcc8(c, jg_u8a_done, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)      // VZEROUPPER

        // Exact byte tail & --simd=scalar 8B SWAR fallback (baseline x86-64, zero POPCNT)
        jmp_u8_tail := mc_jmp32(c)
        mc_patch_rel32(c, jz_u8_sc, buf_len(c))
        mc_b2(c, 0x48, 0xBB); mc_u64(c, 0x8080808080808080) // RBX = m80
        mc_b2(c, 0x48, 0xBE); mc_u64(c, 0x4040404040404040) // RSI = m40
        mc_b2(c, 0x48, 0xBF); mc_u64(c, 0x0101010101010101) // RDI = m01
        mc_b4(c, 0x49, 0x8D, 0x4A, 0xF8) // RCX = i1 - 8
        lp_u8sw := buf_len(c)
        mc_b3(c, 0x49, 0x39, 0xC9); jg_u8sw_dn := mc_jcc8(c, 0x7F)
        mc_b4(c, 0x4B, 0x8B, 0x04, 0x08) // RAX = [R8 + R9]
        mc_b3(c, 0x48, 0x89, 0xC2); mc_b3(c, 0x48, 0x21, 0xDA) // RDX = w & m80 (msb)
        mc_b3(c, 0x48, 0x89, 0xD5); mc_b4(c, 0x48, 0xC1, 0xED, 7)
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xEF); mc_b4(c, 0x48, 0xC1, 0xED, 56)
        mc_b3(c, 0x49, 0x01, 0xED) // R13 += non_asc
        mc_b3(c, 0x48, 0x21, 0xF0); mc_b3(c, 0x48, 0xD1, 0xE0)
        mc_b3(c, 0x48, 0x31, 0xD8); mc_b3(c, 0x48, 0x21, 0xD0) // cont
        mc_b4(c, 0x48, 0xC1, 0xE8, 7)
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xC7); mc_b4(c, 0x48, 0xC1, 0xE8, 56)
        mc_b3(c, 0x49, 0x01, 0xC4) // R12 += cont
        mc_b4(c, 0x49, 0x83, 0xC1, 8)
        j_u8sw := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_u8sw, lp_u8sw)
        mc_patch_jcc8(c, jg_u8sw_dn, buf_len(c))

        mc_patch_rel32(c, jmp_u8_tail, buf_len(c))
        lp_u8t := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_u8t := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x43, 0x0F, 0xB6, 0x04); mc_b1(c, 0x08) // MOVZX EAX, BYTE [R8 + R9]
        mc_b2(c, 0x89, 0xC2); mc_b3(c, 0x83, 0xE2, 0xC0); mc_b2(c, 0x81, 0xFA); mc_u32(c, 0x80)
        jne_u8c := mc_jcc8(c, 0x75)
        mc_b3(c, 0x49, 0xFF, 0xC4) // R12++ (cont)
        mc_patch_jcc8(c, jne_u8c, buf_len(c))
        mc_b2(c, 0xA8, 0x80); jz_u8a := mc_jcc8(c, 0x74)
        mc_b3(c, 0x49, 0xFF, 0xC5) // R13++ (non_asc)
        mc_patch_jcc8(c, jz_u8a, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC1)
        j_u8t := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_u8t, lp_u8t)
        mc_patch_jcc8(c, jge_u8t, buf_len(c))

        mc_patch_rel32(c, jle_u8_dn, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xF0); mc_b3(c, 0x4C, 0x29, 0xE0) // RAX = total - cont = cps
        mc_b3(c, 0x4C, 0x89, 0xF2); mc_b3(c, 0x4C, 0x29, 0xEA) // RDX = total - non_asc = asc
        mc_b3(c, 0x49, 0x89, 0x03)       // [R11+0] = cps
        mc_b4(c, 0x49, 0x89, 0x53, 8)    // [R11+8] = asc
        mc_ai_leave(c, 0x18)
        cg_reg_helper(cg, h_ai_utf8_count(), s_u8, buf_len(c))
    }

    // 82. `h_ai_rle_rt_chunk(src, len, enc, dec) -> i64`: pure-register RLE encode+decode chunk with BSF & REP STOSQ (B028)
    if cg_is_helper_used(cg, h_ai_rle_rt_chunk()) {
        mc_align16(c)
        s_rle := buf_len(c)
        mc_ai_enter(c, 0x08) // Pure GPR, zero XMM
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = src
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = len
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = enc
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = dec
        mc_b2(c, 0x31, 0xC0)
        mc_b3(c, 0x4D, 0x85, 0xC9); jle_rle_dn := mc_jcc32(c, 0x8E)

        mc_b2(c, 0x49, 0xBC); mc_u64(c, 0x0101010101010101) // R12 = rep8
        mc_b2(c, 0x31, 0xF6) // RSI = i = 0
        mc_b2(c, 0x31, 0xFF) // RDI = ei = 0
        mc_align16_nop(c)
        lp_rle_e := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xCE); jge_rle_e_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x04); mc_b1(c, 0x30) // MOVZX EAX, BYTE [R8 + RSI] (v)
        mc_b3(c, 0x4C, 0x89, 0xCA); mc_b3(c, 0x48, 0x29, 0xF2) // RDX = len - i
        mc_b3(c, 0x48, 0x81, 0xFA); mc_u32(c, 255)
        jbe_rle_mr := mc_jcc8(c, 0x76)
        mc_b1(c, 0xBA); mc_u32(c, 255) // RDX = max_r
        mc_patch_jcc8(c, jbe_rle_mr, buf_len(c))
        mc_b1(c, 0xBB); mc_u32(c, 1) // RBX = run = 1
        mc_b4(c, 0x48, 0x83, 0xFA, 9); jb_rle_eb := mc_jcc8(c, 0x72)
        // Fast 8B XOR + BSF scan
        mc_b3(c, 0x49, 0x89, 0xC5); mc_b4(c, 0x4D, 0x0F, 0xAF, 0xEC) // R13 = v * rep8
        mc_b4(c, 0x49, 0x8D, 0x2C, 0x30) // RBP = src + i
        mc_b4(c, 0x48, 0x8D, 0x4A, 0xF8) // RCX = max_r - 8
        lp_rle_e8 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xCB); jg_rle_eb := mc_jcc8(c, 0x7F)
        mc_b4(c, 0x4C, 0x8B, 0x74, 0x1D); mc_b1(c, 0) // MOV R14, [RBP + RBX]
        mc_b3(c, 0x4D, 0x31, 0xEE)       // XOR R14, R13
        jnz_rle_diff := mc_jcc8(c, 0x75)
        mc_b4(c, 0x48, 0x83, 0xC3, 8)
        j_rle_e8 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rle_e8, lp_rle_e8)
        mc_patch_jcc8(c, jnz_rle_diff, buf_len(c))
        mc_b4(c, 0x4D, 0x0F, 0xBC, 0xF6) // BSF R14, R14
        mc_b4(c, 0x49, 0xC1, 0xEE, 3)    // SHR R14, 3
        mc_b3(c, 0x4C, 0x01, 0xF3)       // ADD RBX, R14
        jmp_rle_emit := mc_jcc8(c, 0xEB)

        mc_patch_jcc8(c, jb_rle_eb, buf_len(c))
        mc_patch_jcc8(c, jg_rle_eb, buf_len(c))
        mc_b4(c, 0x49, 0x8D, 0x2C, 0x30) // RBP = src + i
        lp_rle_eb := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD3); jge_rle_emit := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x38, 0x44, 0x1D, 0)    // CMP [RBP + RBX], AL
        jne_rle_emit := mc_jcc8(c, 0x75)
        mc_b3(c, 0x48, 0xFF, 0xC3)
        j_rle_eb := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rle_eb, lp_rle_eb)

        mc_patch_jcc8(c, jmp_rle_emit, buf_len(c))
        mc_patch_jcc8(c, jge_rle_emit, buf_len(c))
        mc_patch_jcc8(c, jne_rle_emit, buf_len(c))
        // Store 2 bytes [run, v] as 16-bit WORD at enc[ei]
        mc_b3(c, 0xC1, 0xE0, 8); mc_b2(c, 0x09, 0xD8) // EAX = (v << 8) | run
        mc_b4(c, 0x66, 0x41, 0x89, 0x04); mc_b1(c, 0x3A) // MOV WORD [R10 + RDI], AX
        mc_b4(c, 0x48, 0x83, 0xC7, 2)    // ei += 2
        mc_b3(c, 0x48, 0x01, 0xDE)       // i += run
        j_rle_e := mc_jmp32(c); mc_patch_rel32(c, j_rle_e, lp_rle_e)
        mc_patch_rel32(c, jge_rle_e_dn, buf_len(c))

        // Decode enc[0..RDI] -> dec[0..R9] (save ei in R15)
        mc_b3(c, 0x49, 0x89, 0xFF)       // R15 = ei
        mc_b2(c, 0x31, 0xF6)             // RSI = p = 0
        mc_b3(c, 0x4C, 0x89, 0xDD)       // RBP = dst = dec
        mc_b4(c, 0x4F, 0x8D, 0x74, 0x0B); mc_b1(c, 0xF0) // R14 = dec + len - 16 (R=1,X=1(R9),B=1(R11))
        mc_align16_nop(c)
        lp_rle_d := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xFE); jge_rle_d_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x41, 0x0F, 0xB7, 0x04); mc_b1(c, 0x32) // MOVZX EAX, WORD [R10 + RSI]
        mc_b4(c, 0x48, 0x83, 0xC6, 2)    // p += 2
        mc_b3(c, 0x0F, 0xB6, 0xC8)       // MOVZX ECX, AL (cnt)
        mc_b3(c, 0xC1, 0xE8, 8)          // EAX = v
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC4) // RAX = v * rep8 (splat)
        mc_b3(c, 0x4C, 0x39, 0xF5); ja_rle_slow := mc_jcc8(c, 0x77) // near chunk end -> exact REP STOSB
        mc_b4(c, 0x48, 0x83, 0xF9, 8); ja_rle_d16 := mc_jcc8(c, 0x77)
        mc_b4(c, 0x48, 0x89, 0x45, 0)    // MOV [RBP], RAX (<=8B)
        mc_b3(c, 0x48, 0x01, 0xCD)       // dst += cnt
        j_rle_d1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rle_d1, lp_rle_d)
        mc_patch_jcc8(c, ja_rle_d16, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xF9, 16); ja_rle_big := mc_jcc8(c, 0x77)
        mc_b4(c, 0x48, 0x89, 0x45, 0)    // MOV [RBP], RAX
        mc_b4(c, 0x48, 0x89, 0x45, 8)    // MOV [RBP+8], RAX
        mc_b3(c, 0x48, 0x01, 0xCD)
        j_rle_d2 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rle_d2, lp_rle_d)
        mc_patch_jcc8(c, ja_rle_big, buf_len(c))
        mc_b3(c, 0x48, 0x89, 0xEF)       // RDI = dst
        mc_b3(c, 0x48, 0x89, 0xCA)       // RDX = cnt
        mc_b4(c, 0x48, 0xC1, 0xE9, 3)    // RCX = cnt >> 3
        mc_b3(c, 0xF3, 0x48, 0xAB)       // REP STOSQ
        mc_b2(c, 0x89, 0xD1); mc_b3(c, 0x83, 0xE1, 7) // RCX = cnt & 7
        mc_b2(c, 0xF3, 0xAA)             // REP STOSB
        mc_b3(c, 0x48, 0x89, 0xFD)       // dst = RDI
        j_rle_d3 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rle_d3, lp_rle_d)
        mc_patch_jcc8(c, ja_rle_slow, buf_len(c))
        mc_b3(c, 0x48, 0x89, 0xEF)       // RDI = dst
        mc_b2(c, 0xF3, 0xAA)             // REP STOSB
        mc_b3(c, 0x48, 0x89, 0xFD)       // dst = RDI
        j_rle_d4 := mc_jmp32(c); mc_patch_rel32(c, j_rle_d4, lp_rle_d)
        mc_patch_rel32(c, jge_rle_d_dn, buf_len(c))

        // Return ei + dec[0] + dec[di - 1]
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x03)       // MOVZX EAX, BYTE [R11]
        mc_b4(c, 0x0F, 0xB6, 0x55, 0xFF)       // MOVZX EDX, BYTE [RBP - 1]
        mc_b3(c, 0x4C, 0x01, 0xF8)             // RAX += ei (R15)
        mc_b3(c, 0x48, 0x01, 0xD0)             // RAX += dec[di-1]
        mc_patch_rel32(c, jle_rle_dn, buf_len(c))
        mc_ai_leave(c, 0x08)
        cg_reg_helper(cg, h_ai_rle_rt_chunk(), s_rle, buf_len(c))
    }

    // 83. `h_ai_bitset_popcnt(pa, pb, pc, i0_i1) -> i64`: 4x unrolled AND+XOR+POPCNT + baseline SWAR fallback (B038)
    if cg_is_helper_used(cg, h_ai_bitset_popcnt()) {
        mc_align16(c)
        s_bp := buf_len(c)
        mc_ai_enter(c, 0x08) // Pure GPR
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = pa
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = pb
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = pc
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = i0_i1
        mc_b3(c, 0x45, 0x89, 0xDC)       // R12 = i1 (zero-ext low 32b)
        mc_b4(c, 0x49, 0xC1, 0xEB, 32)   // R11 = i0
        mc_b2(c, 0x31, 0xC0)             // RAX = cnt = 0
        mc_b3(c, 0x4D, 0x39, 0xE3); jge_bp_dn := mc_jcc32(c, 0x8D)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_bp_sc := mc_jcc32(c, 0x84)
        mc_b2(c, 0x31, 0xC0) // RAX = 0
        mc_b4(c, 0x49, 0x8D, 0x4C, 0x24); mc_b1(c, 0xFC) // RCX = i1 - 4 (R12 base -> SIB 0x24)
        mc_align16_nop(c)
        lp_bp4 := buf_len(c)
        mc_b3(c, 0x49, 0x39, 0xCB); jg_bp1 := mc_jcc8(c, 0x7F)
        // Lane 0
        mc_b4(c, 0x4B, 0x8B, 0x14, 0xD8) // RDX = pa[i]
        mc_b4(c, 0x4B, 0x23, 0x14, 0xD9) // RDX &= pb[i]
        mc_b4(c, 0x4B, 0x33, 0x14, 0xDA) // RDX ^= pc[i]
        mc_b4(c, 0xF3, 0x48, 0x0F, 0xB8); mc_b1(c, 0xD2) // POPCNT RDX, RDX
        // Lane 1
        mc_b4(c, 0x4B, 0x8B, 0x74, 0xD8); mc_b1(c, 8)
        mc_b4(c, 0x4B, 0x23, 0x74, 0xD9); mc_b1(c, 8)
        mc_b4(c, 0x4B, 0x33, 0x74, 0xDA); mc_b1(c, 8)
        mc_b4(c, 0xF3, 0x48, 0x0F, 0xB8); mc_b1(c, 0xF6) // POPCNT RSI, RSI
        // Lane 2
        mc_b4(c, 0x4B, 0x8B, 0x7C, 0xD8); mc_b1(c, 16)
        mc_b4(c, 0x4B, 0x23, 0x7C, 0xD9); mc_b1(c, 16)
        mc_b4(c, 0x4B, 0x33, 0x7C, 0xDA); mc_b1(c, 16)
        mc_b4(c, 0xF3, 0x48, 0x0F, 0xB8); mc_b1(c, 0xFF) // POPCNT RDI, RDI
        // Lane 3
        mc_b4(c, 0x4B, 0x8B, 0x5C, 0xD8); mc_b1(c, 24)
        mc_b4(c, 0x4B, 0x23, 0x5C, 0xD9); mc_b1(c, 24)
        mc_b4(c, 0x4B, 0x33, 0x5C, 0xDA); mc_b1(c, 24)
        mc_b4(c, 0xF3, 0x48, 0x0F, 0xB8); mc_b1(c, 0xDB) // POPCNT RBX, RBX
        mc_b3(c, 0x48, 0x01, 0xD0); mc_b3(c, 0x48, 0x01, 0xF0)
        mc_b3(c, 0x48, 0x01, 0xF8); mc_b3(c, 0x48, 0x01, 0xD8)
        mc_b4(c, 0x49, 0x83, 0xC3, 4)
        j_bp4 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_bp4, lp_bp4)
        mc_patch_jcc8(c, jg_bp1, buf_len(c))
        lp_bp1 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xE3); jge_bp1_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x4B, 0x8B, 0x14, 0xD8)
        mc_b4(c, 0x4B, 0x23, 0x14, 0xD9)
        mc_b4(c, 0x4B, 0x33, 0x14, 0xDA)
        mc_b4(c, 0xF3, 0x48, 0x0F, 0xB8); mc_b1(c, 0xD2)
        mc_b3(c, 0x48, 0x01, 0xD0)
        mc_b3(c, 0x49, 0xFF, 0xC3)
        j_bp1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_bp1, lp_bp1)
        mc_patch_jcc8(c, jge_bp1_dn, buf_len(c))
        jmp_bp_end := mc_jmp32(c)

        // Baseline SWAR popcnt fallback (--simd=scalar)
        mc_patch_rel32(c, jz_bp_sc, buf_len(c))
        mc_b2(c, 0x31, 0xC0) // RAX = 0
        mc_b2(c, 0x49, 0xBD); mc_u64(c, 0x5555555555555555) // R13
        mc_b2(c, 0x49, 0xBE); mc_u64(c, 0x3333333333333333) // R14
        mc_b2(c, 0x49, 0xBF); mc_u64(c, 0x0F0F0F0F0F0F0F0F) // R15
        mc_b2(c, 0x48, 0xBD); mc_u64(c, 0x0101010101010101) // RBP
        lp_bps := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xE3); jge_bps_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x4B, 0x8B, 0x14, 0xD8)
        mc_b4(c, 0x4B, 0x23, 0x14, 0xD9)
        mc_b4(c, 0x4B, 0x33, 0x14, 0xDA) // RDX = x
        mc_b3(c, 0x48, 0x89, 0xD6); mc_b3(c, 0x48, 0xD1, 0xEE); mc_b3(c, 0x4C, 0x21, 0xEE); mc_b3(c, 0x48, 0x29, 0xF2)
        mc_b3(c, 0x48, 0x89, 0xD6); mc_b4(c, 0x48, 0xC1, 0xEE, 2); mc_b3(c, 0x4C, 0x21, 0xF2); mc_b3(c, 0x4C, 0x21, 0xF6); mc_b3(c, 0x48, 0x01, 0xF2)
        mc_b3(c, 0x48, 0x89, 0xD6); mc_b4(c, 0x48, 0xC1, 0xEE, 4); mc_b3(c, 0x48, 0x01, 0xF2); mc_b3(c, 0x4C, 0x21, 0xFA)
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xD5); mc_b4(c, 0x48, 0xC1, 0xEA, 56)
        mc_b3(c, 0x48, 0x01, 0xD0)
        mc_b3(c, 0x49, 0xFF, 0xC3)
        j_bps := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_bps, lp_bps)
        mc_patch_jcc8(c, jge_bps_dn, buf_len(c))

        mc_patch_rel32(c, jmp_bp_end, buf_len(c))
        mc_patch_rel32(c, jge_bp_dn, buf_len(c))
        mc_ai_leave(c, 0x08)
        cg_reg_helper(cg, h_ai_bitset_popcnt(), s_bp, buf_len(c))
    }

    // 84. `h_ai_murmur3_xxh64(mode, words, m0, m1) -> i64`: native ROL+LEA+IMUL Murmur3-128 (mode 0) & xxHash64 (mode 1) (B056/B057)
    if cg_is_helper_used(cg, h_ai_murmur3_xxh64()) {
        mc_align16(c)
        s_mh := buf_len(c)
        mc_ai_enter(c, 0x08) // Pure GPR, identical on AVX2 and --simd=scalar
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = mode
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = words
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = m0
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = m1
        mc_b2(c, 0x31, 0xDB)             // RBX = acc = 0
        mc_b3(c, 0x4D, 0x39, 0xDA); jge_mh_dn := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4D, 0x85, 0xC0); jnz_mh_xx := mc_jcc32(c, 0x85)

        // MODE 0: Murmur3-128 (256B/msg = 32 qwords)
        mc_b4(c, 0x49, 0xC1, 0xE2, 8); mc_b4(c, 0x49, 0xC1, 0xE3, 8) // m0<<8, m1<<8
        mc_b4(c, 0x4F, 0x8D, 0x04, 0x11) // R8 = words + m0*256 (R=1,X=1(R10),B=1(R9))
        mc_b4(c, 0x4F, 0x8D, 0x0C, 0x19) // R9 = words + m1*256 (R=1,X=1(R11),B=1(R9))
        mc_b2(c, 0x49, 0xBC); mc_u64(c, 0x87c37b91114253d5) // R12 = c1
        mc_b2(c, 0x49, 0xBD); mc_u64(c, 0x4cf5ad432745937f) // R13 = c2
        mc_b2(c, 0x49, 0xBE); mc_u64(c, 0xff51afd7ed558ccd) // R14 = f1
        mc_b2(c, 0x49, 0xBF); mc_u64(c, 0xc4ceb9fe1a85ec53) // R15 = f2
        mc_align16_nop(c)
        lp_m3_o := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xC8); jae_m3_dn := mc_jcc32(c, 0x83)
        mc_b2(c, 0x41, 0xBA); mc_u32(c, 0x9747b28c) // R10 = h1
        mc_b2(c, 0x41, 0xBB); mc_u32(c, 0x9747b28c) // R11 = h2
        mc_b3(c, 0x49, 0x8D, 0xB8); mc_u32(c, 256)  // RDI = R8 + 256
        lp_m3_i := buf_len(c)
        mc_b3(c, 0x49, 0x8B, 0x00)                  // RAX = [R8]
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC4)            // IMUL RAX, R12
        mc_b4(c, 0x48, 0xC1, 0xC0, 31)              // ROL RAX, 31
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC5)            // IMUL RAX, R13
        mc_b3(c, 0x49, 0x31, 0xC2)                  // XOR R10, RAX
        mc_b4(c, 0x49, 0xC1, 0xC2, 27)              // ROL R10, 27
        mc_b3(c, 0x4D, 0x01, 0xDA)                  // ADD R10, R11
        mc_b4(c, 0x4F, 0x8D, 0x94, 0x92); mc_u32(c, 0x52dce729) // LEA R10, [R10 + R10*4 + 0x52dce729]
        mc_b4(c, 0x49, 0x8B, 0x50, 8)               // RDX = [R8+8]
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xD5)            // IMUL RDX, R13
        mc_b4(c, 0x48, 0xC1, 0xC2, 33)              // ROL RDX, 33
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xD4)            // IMUL RDX, R12
        mc_b3(c, 0x49, 0x31, 0xD3)                  // XOR R11, RDX
        mc_b4(c, 0x49, 0xC1, 0xC3, 31)              // ROL R11, 31
        mc_b3(c, 0x4D, 0x01, 0xD3)                  // ADD R11, R10
        mc_b4(c, 0x4F, 0x8D, 0x9C, 0x9B); mc_u32(c, 0x38495ab5) // LEA R11, [R11 + R11*4 + 0x38495ab5]
        mc_b4(c, 0x49, 0x83, 0xC0, 16)              // R8 += 16
        mc_b3(c, 0x49, 0x39, 0xF8)
        jb_m3_i := mc_jcc8(c, 0x72); mc_patch_jcc8(c, jb_m3_i, lp_m3_i)
        // Finalize h1, h2
        mc_b3(c, 0x49, 0x81, 0xF2); mc_u32(c, 256)
        mc_b3(c, 0x49, 0x81, 0xF3); mc_u32(c, 256)
        mc_b3(c, 0x4D, 0x01, 0xDA)
        mc_b3(c, 0x4D, 0x01, 0xD3)
        mc_b3(c, 0x4C, 0x89, 0xD0); mc_b4(c, 0x48, 0xC1, 0xE8, 33); mc_b3(c, 0x49, 0x31, 0xC2); mc_b4(c, 0x4D, 0x0F, 0xAF, 0xD6)
        mc_b3(c, 0x4C, 0x89, 0xD0); mc_b4(c, 0x48, 0xC1, 0xE8, 33); mc_b3(c, 0x49, 0x31, 0xC2); mc_b4(c, 0x4D, 0x0F, 0xAF, 0xD7)
        mc_b3(c, 0x4C, 0x89, 0xD0); mc_b4(c, 0x48, 0xC1, 0xE8, 33); mc_b3(c, 0x49, 0x31, 0xC2)
        mc_b3(c, 0x4C, 0x89, 0xD8); mc_b4(c, 0x48, 0xC1, 0xE8, 33); mc_b3(c, 0x49, 0x31, 0xC3); mc_b4(c, 0x4D, 0x0F, 0xAF, 0xDE)
        mc_b3(c, 0x4C, 0x89, 0xD8); mc_b4(c, 0x48, 0xC1, 0xE8, 33); mc_b3(c, 0x49, 0x31, 0xC3); mc_b4(c, 0x4D, 0x0F, 0xAF, 0xDF)
        mc_b3(c, 0x4C, 0x89, 0xD8); mc_b4(c, 0x48, 0xC1, 0xE8, 33); mc_b3(c, 0x49, 0x31, 0xC3)
        mc_b3(c, 0x4C, 0x31, 0xD3); mc_b3(c, 0x4C, 0x31, 0xDB)
        j_m3_o := mc_jmp32(c); mc_patch_rel32(c, j_m3_o, lp_m3_o)
        mc_patch_rel32(c, jae_m3_dn, buf_len(c))
        jmp_mh_end := mc_jmp32(c)

        // MODE 1: xxHash64 (512B/msg = 64 qwords)
        mc_patch_rel32(c, jnz_mh_xx, buf_len(c))
        mc_b4(c, 0x49, 0xC1, 0xE2, 9); mc_b4(c, 0x49, 0xC1, 0xE3, 9) // m0<<9, m1<<9
        mc_b4(c, 0x4F, 0x8D, 0x04, 0x11) // R8 = words + m0*512
        mc_b4(c, 0x4F, 0x8D, 0x0C, 0x19) // R9 = words + m1*512
        mc_b2(c, 0x49, 0xBC); mc_u64(c, 0x9E3779B185EBCA87) // R12 = p1
        mc_b2(c, 0x49, 0xBD); mc_u64(c, 0xC2B2AE3D27D4EB4F) // R13 = p2
        mc_b2(c, 0x49, 0xBE); mc_u64(c, 0x165667B19E3779F9) // R14 = p3
        mc_align16_nop(c)
        lp_xx_o := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xC8); jae_xx_dn := mc_jcc32(c, 0x83)
        mc_b4(c, 0x4F, 0x8D, 0x14, 0x2C) // R10 = p1 + p2
        mc_b3(c, 0x4D, 0x89, 0xEB)       // R11 = p2
        mc_b2(c, 0x31, 0xF6)             // RSI = 0
        mc_b3(c, 0x4D, 0x89, 0xE7); mc_b3(c, 0x49, 0xF7, 0xDF) // R15 = -p1
        mc_b3(c, 0x49, 0x8D, 0xB8); mc_u32(c, 512) // RDI = R8 + 512
        lp_xx_i := buf_len(c)
        mc_b3(c, 0x49, 0x8B, 0x00); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC5); mc_b3(c, 0x49, 0x01, 0xC2); mc_b4(c, 0x49, 0xC1, 0xC2, 31); mc_b4(c, 0x4D, 0x0F, 0xAF, 0xD4)
        mc_b4(c, 0x49, 0x8B, 0x48, 8); mc_b4(c, 0x49, 0x0F, 0xAF, 0xCD); mc_b3(c, 0x49, 0x01, 0xCB); mc_b4(c, 0x49, 0xC1, 0xC3, 31); mc_b4(c, 0x4D, 0x0F, 0xAF, 0xDC)
        mc_b4(c, 0x49, 0x8B, 0x50, 16); mc_b4(c, 0x49, 0x0F, 0xAF, 0xD5); mc_b3(c, 0x48, 0x01, 0xD6); mc_b4(c, 0x48, 0xC1, 0xC6, 31); mc_b4(c, 0x49, 0x0F, 0xAF, 0xF4)
        mc_b4(c, 0x49, 0x8B, 0x68, 24); mc_b4(c, 0x49, 0x0F, 0xAF, 0xED); mc_b3(c, 0x49, 0x01, 0xEF); mc_b4(c, 0x49, 0xC1, 0xC7, 31); mc_b4(c, 0x4D, 0x0F, 0xAF, 0xFC)
        mc_b4(c, 0x49, 0x83, 0xC0, 32)
        mc_b3(c, 0x49, 0x39, 0xF8)
        jb_xx_i := mc_jcc8(c, 0x72); mc_patch_jcc8(c, jb_xx_i, lp_xx_i)
        mc_b4(c, 0x49, 0xC1, 0xC2, 1)
        mc_b4(c, 0x49, 0xC1, 0xC3, 7)
        mc_b4(c, 0x48, 0xC1, 0xC6, 12)
        mc_b4(c, 0x49, 0xC1, 0xC7, 18)
        mc_b4(c, 0x4B, 0x8D, 0x84, 0x1A); mc_u32(c, 512) // RAX = R10 + R11 + 512
        mc_b3(c, 0x48, 0x01, 0xF0); mc_b3(c, 0x4C, 0x01, 0xF8)
        mc_b3(c, 0x48, 0x89, 0xC2); mc_b4(c, 0x48, 0xC1, 0xEA, 33); mc_b3(c, 0x48, 0x31, 0xD0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC5)
        mc_b3(c, 0x48, 0x89, 0xC2); mc_b4(c, 0x48, 0xC1, 0xEA, 29); mc_b3(c, 0x48, 0x31, 0xD0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC6)
        mc_b3(c, 0x48, 0x89, 0xC2); mc_b4(c, 0x48, 0xC1, 0xEA, 32); mc_b3(c, 0x48, 0x31, 0xD0)
        mc_b3(c, 0x48, 0x31, 0xC3)
        j_xx_o := mc_jmp32(c); mc_patch_rel32(c, j_xx_o, lp_xx_o)
        mc_patch_rel32(c, jae_xx_dn, buf_len(c))

        mc_patch_rel32(c, jmp_mh_end, buf_len(c))
        mc_patch_rel32(c, jge_mh_dn, buf_len(c))
        mc_b3(c, 0x48, 0x89, 0xD8) // RAX = acc
        mc_ai_leave(c, 0x08)
        cg_reg_helper(cg, h_ai_murmur3_xxh64(), s_mh, buf_len(c))
    }

    // 85. `h_ai_aabb_overlap_f64(bx, n, tid, nt) -> i64`: 4-wide AVX2 6-axis AABB overlap counter + SSE2 fallback (B075)
    if cg_is_helper_used(cg, h_ai_aabb_overlap_f64()) {
        mc_align16(c)
        s_ab := buf_len(c)
        mc_ai_enter(c, 0xB8) // [RSP+0x00..0x9F]=XMM6..15, [RSP+0xA0]=nt
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = x0 = bx
        mc_b4(c, 0x4C, 0x8B, 0x79, 8)    // R15 = n
        mc_b4(c, 0x4C, 0x8B, 0x71, 16)   // R14 = i = tid
        mc_b4(c, 0x48, 0x8B, 0x41, 24)   // RAX = nt
        mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 0xA0) // [RSP+0xA0] = nt
        mc_b2(c, 0x31, 0xDB)             // RBX = cnt = 0
        mc_b3(c, 0x4D, 0x39, 0xFE); jge_ab_dn := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4C, 0x89, 0xFE); mc_b4(c, 0x48, 0xC1, 0xE6, 3) // RSI = stride = n * 8
        mc_b4(c, 0x4D, 0x8D, 0x0C, 0x30) // R9  = x1 = x0 + stride
        mc_b4(c, 0x4D, 0x8D, 0x14, 0x31) // R10 = y0 = x1 + stride
        mc_b4(c, 0x4D, 0x8D, 0x1C, 0x32) // R11 = y1 = y0 + stride
        mc_b4(c, 0x4D, 0x8D, 0x24, 0x33) // R12 = z0 = y1 + stride
        mc_b4(c, 0x4D, 0x8D, 0x2C, 0x34) // R13 = z1 = z0 + stride

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_ab_sc := mc_jcc32(c, 0x84)

        // AVX2 4-wide f64 outer i, inner j
        mc_b4(c, 0x49, 0x8D, 0x6F, 0xFC) // RBP = n - 4
        mc_align16_nop(c)
        lp_ab_i := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xFE); jge_ab_i_dn := mc_jcc32(c, 0x8D)
        mc_vex3(c, 0, 1, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x04, 0xF0)       // Y0 = [R8  + R14*8]
        mc_vex3(c, 0, 1, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x0C, 0xF1)       // Y1 = [R9  + R14*8]
        mc_vex3(c, 0, 1, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x14, 0xF2)       // Y2 = [R10 + R14*8]
        mc_vex3(c, 0, 1, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x1C, 0xF3)       // Y3 = [R11 + R14*8]
        mc_vex3(c, 0, 1, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x24, 0xF4)       // Y4 = [R12 + R14*8]
        mc_vex3(c, 0, 1, 1, 2, 0, 0, 1, 1, 0x19); mc_b3(c, 0x6C, 0xF5, 0x00) // Y5 = [R13 + R14*8 + 0]
        mc_b4(c, 0x49, 0x8D, 0x7E, 1) // RDI = j = i + 1
        lp_ab_j4 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xEF); jg_ab_jt := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0xC2); mc_b3(c, 0x34, 0xF9, 0x12)       // Y6 = (Y0 <= x1[j..j+3])
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 1, 1, 0xC2); mc_b3(c, 0x3C, 0xF8, 0x1D)       // Y7 = (Y1 >= x0[j..j+3])
        mc_vex2(c, 6, 1, 1, 0x54, 0xF7)
        mc_vex2(c, 0, 1, 1, 0x50, 0xC6); mc_b2(c, 0x85, 0xC0); jz_ab_skipx := mc_jcc8(c, 0x74)
        mc_vex3(c, 0, 0, 1, 1, 0, 2, 1, 1, 0xC2); mc_b3(c, 0x3C, 0xFB, 0x12)
        mc_vex2(c, 6, 1, 1, 0x54, 0xF7)
        mc_vex3(c, 0, 0, 1, 1, 0, 3, 1, 1, 0xC2); mc_b3(c, 0x3C, 0xFA, 0x1D)
        mc_vex2(c, 6, 1, 1, 0x54, 0xF7)
        mc_vex3(c, 0, 0, 1, 1, 0, 4, 1, 1, 0xC2); mc_b4(c, 0x7C, 0xFD, 0x00, 0x12)
        mc_vex2(c, 6, 1, 1, 0x54, 0xF7)
        mc_vex3(c, 0, 0, 1, 1, 0, 5, 1, 1, 0xC2); mc_b3(c, 0x3C, 0xFC, 0x1D)
        mc_vex2(c, 6, 1, 1, 0x54, 0xF7)
        mc_vex2(c, 0, 1, 1, 0x50, 0xC6) // VPMOVMSKPD EAX, Y6
        mc_b4(c, 0xF3, 0x0F, 0xB8, 0xC0) // POPCNT EAX, EAX
        mc_b3(c, 0x48, 0x01, 0xC3)
        mc_patch_jcc8(c, jz_ab_skipx, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xC7, 4)
        j_ab_j4 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_ab_j4, lp_ab_j4)
        mc_patch_jcc8(c, jg_ab_jt, buf_len(c))
        // VEX-128 tail (0..3 elements) — zero AVX-SSE penalty
        lp_ab_jt := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xFF); jge_ab_jt_dn := mc_jcc8(c, 0x7D)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0xC2); mc_b3(c, 0x34, 0xF9, 0x12)
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 0, 3, 0xC2); mc_b3(c, 0x3C, 0xF8, 0x1D)
        mc_vex2(c, 6, 0, 1, 0x54, 0xF7)
        mc_vex3(c, 0, 0, 1, 1, 0, 2, 0, 3, 0xC2); mc_b3(c, 0x3C, 0xFB, 0x12)
        mc_vex2(c, 6, 0, 1, 0x54, 0xF7)
        mc_vex3(c, 0, 0, 1, 1, 0, 3, 0, 3, 0xC2); mc_b3(c, 0x3C, 0xFA, 0x1D)
        mc_vex2(c, 6, 0, 1, 0x54, 0xF7)
        mc_vex3(c, 0, 0, 1, 1, 0, 4, 0, 3, 0xC2); mc_b4(c, 0x7C, 0xFD, 0x00, 0x12)
        mc_vex2(c, 6, 0, 1, 0x54, 0xF7)
        mc_vex3(c, 0, 0, 1, 1, 0, 5, 0, 3, 0xC2); mc_b3(c, 0x3C, 0xFC, 0x1D)
        mc_vex2(c, 6, 0, 1, 0x54, 0xF7)
        mc_vex2(c, 0, 0, 1, 0x50, 0xC6) // VMOVMSKPD EAX, X6
        mc_b3(c, 0x83, 0xE0, 1)
        mc_b3(c, 0x48, 0x01, 0xC3)
        mc_b3(c, 0x48, 0xFF, 0xC7)
        j_ab_jt := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_ab_jt, lp_ab_jt)
        mc_patch_jcc8(c, jge_ab_jt_dn, buf_len(c))
        mc_b4(c, 0x4C, 0x03, 0xB4, 0x24); mc_u32(c, 0xA0) // R14 += nt
        j_ab_i := mc_jmp32(c); mc_patch_rel32(c, j_ab_i, lp_ab_i)
        mc_patch_rel32(c, jge_ab_i_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77) // VZEROUPPER
        jmp_ab_end := mc_jmp32(c)

        // SSE2 scalar fallback (--simd=scalar)
        mc_patch_rel32(c, jz_ab_sc, buf_len(c))
        lp_abs_i := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xFE); jge_abs_i_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x10); mc_b2(c, 0x04, 0xF0)
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x10); mc_b2(c, 0x0C, 0xF1)
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x10); mc_b2(c, 0x14, 0xF2)
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x10); mc_b2(c, 0x1C, 0xF3)
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x10); mc_b2(c, 0x24, 0xF4)
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x10); mc_b3(c, 0x6C, 0xF5, 0x00)
        mc_b4(c, 0x49, 0x8D, 0x7E, 1) // RDI = j = i + 1
        lp_abs_j := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xFF); jge_abs_j_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x66, 0x41, 0x0F, 0x2E); mc_b2(c, 0x04, 0xF9); ja_abs_n1 := mc_jcc8(c, 0x77)
        mc_b4(c, 0x66, 0x41, 0x0F, 0x2E); mc_b2(c, 0x0C, 0xF8); jb_abs_n2 := mc_jcc8(c, 0x72)
        mc_b4(c, 0x66, 0x41, 0x0F, 0x2E); mc_b2(c, 0x14, 0xFB); ja_abs_n3 := mc_jcc8(c, 0x77)
        mc_b4(c, 0x66, 0x41, 0x0F, 0x2E); mc_b2(c, 0x1C, 0xFA); jb_abs_n4 := mc_jcc8(c, 0x72)
        mc_b4(c, 0x66, 0x41, 0x0F, 0x2E); mc_b3(c, 0x64, 0xFD, 0x00); ja_abs_n5 := mc_jcc8(c, 0x77)
        mc_b4(c, 0x66, 0x41, 0x0F, 0x2E); mc_b2(c, 0x2C, 0xFC); jb_abs_n6 := mc_jcc8(c, 0x72)
        mc_b3(c, 0x48, 0xFF, 0xC3)
        nxt_abs := buf_len(c)
        mc_patch_jcc8(c, ja_abs_n1, nxt_abs); mc_patch_jcc8(c, jb_abs_n2, nxt_abs)
        mc_patch_jcc8(c, ja_abs_n3, nxt_abs); mc_patch_jcc8(c, jb_abs_n4, nxt_abs)
        mc_patch_jcc8(c, ja_abs_n5, nxt_abs); mc_patch_jcc8(c, jb_abs_n6, nxt_abs)
        mc_b3(c, 0x48, 0xFF, 0xC7)
        j_abs_j := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_abs_j, lp_abs_j)
        mc_patch_jcc8(c, jge_abs_j_dn, buf_len(c))
        mc_b4(c, 0x4C, 0x03, 0xB4, 0x24); mc_u32(c, 0xA0)
        j_abs_i := mc_jmp32(c); mc_patch_rel32(c, j_abs_i, lp_abs_i)
        mc_patch_rel32(c, jge_abs_i_dn, buf_len(c))

        mc_patch_rel32(c, jmp_ab_end, buf_len(c))
        mc_patch_rel32(c, jge_ab_dn, buf_len(c))
        mc_b3(c, 0x48, 0x89, 0xD8) // RAX = cnt
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_aabb_overlap_f64(), s_ab, buf_len(c))
    }

    // 86. `h_ai_cosine_64d_f32(pvecs, pqrys, i0_i1, nq, tb) -> i64`: 4-query-simultaneous AVX2+FMA3 f32->f64 cosine top-1 (dim=64) + SSE2 fallback (B096)
    if cg_is_helper_used(cg, h_ai_cosine_64d_f32()) {
        while (buf_len(cg.rdata) & 15) != 0 { buf_push(cg.rdata, 0) }
        off_c64 := buf_len(cg.rdata)
        buf_push_u64(cg.rdata, 0x3FF0000000000000) // +0: f64 1.0
        buf_push_u64(cg.rdata, 0x0000000000000000)
        mc_align16(c)
        s_c64 := buf_len(c)
        mc_ai_enter(c, 0xB8) // [RSP+0..0x9F]=XMM6..15, [RSP+0xA0]=vinv
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = pvecs
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = pqrys
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = i0_i1
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = nq
        mc_b4(c, 0x4C, 0x8B, 0x71, 32)   // R14 = tb
        mc_b3(c, 0x45, 0x89, 0xD4)       // R12 = i1 (low 32b)
        mc_b4(c, 0x49, 0xC1, 0xEA, 32)   // R10 = i0
        mc_b3(c, 0x4D, 0x39, 0xE2); jge_c64_dn := mc_jcc32(c, 0x8D)
        cg_lea_rax_rdata(cg, off_c64)
        mc_b3(c, 0x49, 0x89, 0xC7)       // R15 = &rdata[1.0]
        mc_b4(c, 0x49, 0xC1, 0xE2, 8); mc_b4(c, 0x49, 0xC1, 0xE4, 8)
        mc_b4(c, 0x4B, 0x8D, 0x34, 0x10) // RSI = pvecs + i0*256
        mc_b4(c, 0x4B, 0x8D, 0x2C, 0x20) // RBP = pvecs + i1*256

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_c64_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x49, 0x83, 0xFB, 8); jne_c64_gen := mc_jcc32(c, 0x85)

        // FASTPATH nq == 8: 4 queries simultaneously per vv load + fused vn + Y14/Y15 register-resident best[0..7]!
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x36)     // VMOVUPD Y14, [R14]
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x7E, 32) // VMOVUPD Y15, [R14+32]
        mc_b3(c, 0x4D, 0x8D, 0x99); mc_u32(c, 1024) // R11 = pqrys + 1024 (q4..q7)
        mc_align16_nop(c)
        lp_c64_8i := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xEE); jae_c64_8i_dn := mc_jcc32(c, 0x83)
        // Group 0: vn (Y6) + q0..q3 (Y0..Y3) in one single 16-iter loop!
        mc_vex2(c, 0, 1, 1, 0x57, 0xC0)
        mc_vex2(c, 1, 1, 1, 0x57, 0xC9)
        mc_vex2(c, 2, 1, 1, 0x57, 0xD2)
        mc_vex2(c, 3, 1, 1, 0x57, 0xDB)
        mc_vex2(c, 6, 1, 1, 0x57, 0xF6)
        mc_b2(c, 0x31, 0xC9)
        lp_c64_g0 := buf_len(c)
        mc_vex2(c, 0, 1, 0, 0x5A, 0x24); mc_b1(c, 0x0E)                   // VCVTPS2PD Y4, [RSI+RCX]
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b1(c, 0xF4)          // VFMADD231PD Y6, Y4, Y4
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b2(c, 0x2C, 0x09)    // Y5 = q0[k..k+3]
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b1(c, 0xC5)          // Y0 += Y4*Y5
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b2(c, 0xAC, 0x09); mc_u32(c, 256)
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b1(c, 0xCD)          // Y1 += Y4*Y5
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b2(c, 0xAC, 0x09); mc_u32(c, 512)
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b1(c, 0xD5)          // Y2 += Y4*Y5
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b2(c, 0xAC, 0x09); mc_u32(c, 768)
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b1(c, 0xDD)          // Y3 += Y4*Y5
        mc_b4(c, 0x48, 0x83, 0xC1, 16)
        mc_b3(c, 0x48, 0x81, 0xF9); mc_u32(c, 256)
        jb_c64_g0 := mc_jcc8(c, 0x72); mc_patch_jcc8(c, jb_c64_g0, lp_c64_g0)
        // Reduce Y6 -> vinv broadcast in Y7
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xF5, 0x01)    // VEXTRACTF128 X5, Y6, 1
        mc_vex2(c, 6, 0, 1, 0x58, 0xF5)                                    // VADDPD X6, X6, X5
        mc_vex2(c, 6, 0, 1, 0x15, 0xEE)                                    // VUNPCKHPD X5, X6, X6
        mc_vex2(c, 6, 0, 3, 0x58, 0xF5)                                    // VADDSD X6, X6, X5
        mc_vex2(c, 6, 0, 3, 0x51, 0xF6)                                    // VSQRTSD X6, X6, X6
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b1(c, 0x2F)           // VMOVSD X5, [R15] (1.0)
        mc_vex2(c, 5, 0, 3, 0x5E, 0xF6)                                    // VDIVSD X6, X5, X6
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0xFE)           // VBROADCASTSD Y7, X6
        // 5-insn 4-way reduce Y0..Y3 -> Y0 = [dot0, dot1, dot2, dot3], update Y14
        mc_vex2(c, 0, 1, 1, 0x7C, 0xC1)
        mc_vex2(c, 2, 1, 1, 0x7C, 0xD3)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x06); mc_b2(c, 0xE2, 0x20)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x06); mc_b2(c, 0xEA, 0x31)
        mc_vex2(c, 4, 1, 1, 0x58, 0xC5)
        mc_vex2(c, 0, 1, 1, 0x59, 0xC7)                                    // VMULPD Y0, Y0, Y7
        mc_vex3(c, 1, 0, 0, 1, 0, 14, 1, 1, 0x5F); mc_b1(c, 0xF0)          // VMAXPD Y14, Y14, Y0

        // Group 1: q4..q7 (Y0..Y3)
        mc_vex2(c, 0, 1, 1, 0x57, 0xC0)
        mc_vex2(c, 1, 1, 1, 0x57, 0xC9)
        mc_vex2(c, 2, 1, 1, 0x57, 0xD2)
        mc_vex2(c, 3, 1, 1, 0x57, 0xDB)
        mc_b2(c, 0x31, 0xC9)
        lp_c64_g1 := buf_len(c)
        mc_vex2(c, 0, 1, 0, 0x5A, 0x24); mc_b1(c, 0x0E)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b2(c, 0x2C, 0x0B)
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b1(c, 0xC5)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b2(c, 0xAC, 0x0B); mc_u32(c, 256)
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b1(c, 0xCD)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b2(c, 0xAC, 0x0B); mc_u32(c, 512)
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b1(c, 0xD5)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b2(c, 0xAC, 0x0B); mc_u32(c, 768)
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b1(c, 0xDD)
        mc_b4(c, 0x48, 0x83, 0xC1, 16)
        mc_b3(c, 0x48, 0x81, 0xF9); mc_u32(c, 256)
        jb_c64_g1 := mc_jcc8(c, 0x72); mc_patch_jcc8(c, jb_c64_g1, lp_c64_g1)
        mc_vex2(c, 0, 1, 1, 0x7C, 0xC1)
        mc_vex2(c, 2, 1, 1, 0x7C, 0xD3)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x06); mc_b2(c, 0xE2, 0x20)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x06); mc_b2(c, 0xEA, 0x31)
        mc_vex2(c, 4, 1, 1, 0x58, 0xC5)
        mc_vex2(c, 0, 1, 1, 0x59, 0xC7)
        mc_vex3(c, 1, 0, 0, 1, 0, 15, 1, 1, 0x5F); mc_b1(c, 0xF8)          // VMAXPD Y15, Y15, Y0

        mc_b3(c, 0x48, 0x81, 0xC6); mc_u32(c, 256)
        j_c64_8i := mc_jmp32(c); mc_patch_rel32(c, j_c64_8i, lp_c64_8i)
        mc_patch_rel32(c, jae_c64_8i_dn, buf_len(c))
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b1(c, 0x36)     // VMOVUPD [R14], Y14
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x7E, 32) // VMOVUPD [R14+32], Y15
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_c64_8_end := mc_jmp32(c)

        // Generic nq != 8 AVX2 path & SSE2 scalar fallback (--simd=scalar)
        mc_patch_rel32(c, jne_c64_gen, buf_len(c))
        mc_patch_rel32(c, jz_c64_sc, buf_len(c))
        lp_c64s_i := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xEE); jae_c64s_i_dn := mc_jcc32(c, 0x83)
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0)
        mc_b2(c, 0x31, 0xC9)
        lp_c64s_vn := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x5A, 0x0C); mc_b1(c, 0x0E)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xC9)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)
        mc_b4(c, 0x48, 0x83, 0xC1, 4)
        mc_b3(c, 0x48, 0x81, 0xF9); mc_u32(c, 256)
        jb_c64s_vn := mc_jcc8(c, 0x72); mc_patch_jcc8(c, jb_c64s_vn, lp_c64s_vn)
        mc_b4(c, 0xF2, 0x0F, 0x51, 0xC0)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b1(c, 0x17)
        mc_b4(c, 0xF2, 0x0F, 0x5E, 0xD0)
        mc_b2(c, 0x31, 0xD2)
        mc_b3(c, 0x4C, 0x89, 0xCF)
        lp_c64s_q := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xDA); jge_c64s_q_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0)
        mc_b2(c, 0x31, 0xC9)
        lp_c64s_k := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x5A, 0x0C); mc_b1(c, 0x0E)
        mc_b4(c, 0xF3, 0x0F, 0x5A, 0x1C); mc_b1(c, 0x0F)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xCB)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)
        mc_b4(c, 0x48, 0x83, 0xC1, 4)
        mc_b3(c, 0x48, 0x81, 0xF9); mc_u32(c, 256)
        jb_c64s_k := mc_jcc8(c, 0x72); mc_patch_jcc8(c, jb_c64s_k, lp_c64s_k)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xC2)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x5F); mc_b2(c, 0x04, 0xD6)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x04, 0xD6)
        mc_b3(c, 0x48, 0x81, 0xC7); mc_u32(c, 256)
        mc_b3(c, 0x48, 0xFF, 0xC2)
        j_c64s_q := mc_jmp32(c); mc_patch_rel32(c, j_c64s_q, lp_c64s_q)
        mc_patch_rel32(c, jge_c64s_q_dn, buf_len(c))
        mc_b3(c, 0x48, 0x81, 0xC6); mc_u32(c, 256)
        j_c64s_i := mc_jmp32(c); mc_patch_rel32(c, j_c64s_i, lp_c64s_i)
        mc_patch_rel32(c, jae_c64s_i_dn, buf_len(c))

        mc_patch_rel32(c, jmp_c64_8_end, buf_len(c))
        mc_patch_rel32(c, jge_c64_dn, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_cosine_64d_f32(), s_c64, buf_len(c))
    }

    // 87. `h_thread_yield()`: OS scheduler yield (Win64 Sleep(0) / Linux sched_yield) for anti-LHP barriers
    if cg_is_helper_used(cg, h_thread_yield()) {
        mc_align16(c)
        s_ty := buf_len(c)
        if cg_os_mode(cg) <= 1 {
            mc_b4(c, 0x48, 0x83, 0xEC, 0x28)
            mc_b2(c, 0x31, 0xC9)
            cg_call_iat(cg, iat_sleep())
            mc_b4(c, 0x48, 0x83, 0xC4, 0x28)
            mc_b1(c, 0xC3)
        } else if cg_os_mode(cg) == 2 {
            mc_b1(c, 0xB8); mc_u32(c, 24) // SYS_sched_yield
            mc_b2(c, 0x0F, 0x05)
            mc_b1(c, 0xC3)
        } else {
            mc_b2(c, 0xF3, 0x90)
            mc_b1(c, 0xC3)
        }
        cg_reg_helper(cg, h_thread_yield(), s_ty, buf_len(c))
    }

    // 88. `h_ai_fft_global_stage_f64(meta, hsh_final, bf0, bf1) -> i64`: 4-wide AVX2 global/final FFT butterfly + exact SSE2 fallback (B061)
    if cg_is_helper_used(cg, h_ai_fft_global_stage_f64()) {
        mc_align16(c)
        s_fg := buf_len(c)
        mc_ai_enter(c, 0xD8) // [RSP+0..0x9F]=XMM6..15, [RSP+0xA0]=bf1, [RSP+0xA8]=half, [RSP+0xB0]=step, [RSP+0xB8]=hsh
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x48, 0x8B, 0x01)       // RAX = meta
        mc_b4(c, 0x48, 0x8B, 0x51, 8)    // RDX = hsh_final (low6=hsh, bit6=is_final)
        mc_b4(c, 0x48, 0x8B, 0x59, 16)   // RBX = bf0
        mc_b4(c, 0x4C, 0x8B, 0x79, 24)   // R15 = bf1
        mc_b3(c, 0x4C, 0x39, 0xFB); jge_fg_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4C, 0x89, 0xBC, 0x24); mc_u32(c, 0xA0) // [0xA0]=bf1
        mc_b3(c, 0x4C, 0x8B, 0x28)       // R13 = twr = meta[0]
        mc_b4(c, 0x4C, 0x8B, 0x70, 8)    // R14 = twi = meta[1]
        mc_b4(c, 0x4C, 0x8B, 0x40, 80)   // R8  = tmp_r = meta[10]
        mc_b4(c, 0x4C, 0x8B, 0x48, 88)   // R9  = tmp_i = meta[11]
        mc_b4(c, 0x4C, 0x8B, 0x50, 64)   // R10 = pre = meta[8]
        mc_b4(c, 0x4C, 0x8B, 0x58, 72)   // R11 = pim = meta[9]
        mc_b4(c, 0x4C, 0x8B, 0x60, 24)   // R12 = n = meta[3]
        mc_b3(c, 0x49, 0xD1, 0xEC)       // R12 = half_n = n >> 1

        mc_b3(c, 0xF6, 0xC2, 64); jz_fg_mid := mc_jcc32(c, 0x84)

        // === FINAL STAGE: tmp_r/tmp_i -> pre/pim, contiguous twr[k], half = half_n ===
        mc_b3(c, 0x4C, 0x89, 0xE0); mc_b4(c, 0x48, 0xC1, 0xE0, 3) // RAX = half_n * 8
        mc_b4(c, 0x49, 0x8D, 0x34, 0x00) // RSI = tmp_r + half_n*8 (sv_r)
        mc_b4(c, 0x49, 0x8D, 0x3C, 0x01) // RDI = tmp_i + half_n*8 (sv_i)
        mc_b4(c, 0x49, 0x8D, 0x2C, 0x03) // RBP = pim + half_n*8 (dv_i)
        mc_b3(c, 0x48, 0x89, 0xD9)       // RCX = k = bf0
        mc_b4(c, 0x49, 0x8D, 0x1C, 0x02) // RBX = pre + half_n*8 (dv_r)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_fgf_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x49, 0x8D, 0x57, 0xFC) // RDX = bf1 - 4
        mc_align16_nop(c)
        lp_fgf4 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD1); jg_fgf_t := mc_jcc32(c, 0x8F)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x44, 0xCD, 0x00) // Y0 = twr[k..k+3]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x0C, 0xCE)       // Y1 = twi[k..k+3]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x14, 0xC8)       // Y2 = tmp_r[k..k+3] (ur)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x1C, 0xC9)       // Y3 = tmp_i[k..k+3] (ui)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x24, 0xCE)       // Y4 = sv_r[k..k+3] (vr)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x2C, 0xCF)       // Y5 = sv_i[k..k+3] (vi)
        mc_vex2(c, 4, 1, 1, 0x59, 0xF0) // Y6 = vr * wr
        mc_vex2(c, 5, 1, 1, 0x59, 0xF9) // Y7 = vi * wi
        mc_vex2(c, 6, 1, 1, 0x5C, 0xF7) // Y6 = tr = vr*wr - vi*wi
        mc_vex2(c, 4, 1, 1, 0x59, 0xF9) // Y7 = vr * wi
        mc_vex2(c, 5, 1, 1, 0x59, 0xE8) // Y5 = vi * wr
        mc_vex2(c, 7, 1, 1, 0x58, 0xFD) // Y7 = tim = vr*wi + vi*wr
        mc_vex2(c, 2, 1, 1, 0x58, 0xE6) // Y4 = ur + tr
        mc_vex2(c, 2, 1, 1, 0x5C, 0xD6) // Y2 = ur - tr
        mc_vex2(c, 3, 1, 1, 0x58, 0xEF) // Y5 = ui + tim
        mc_vex2(c, 3, 1, 1, 0x5C, 0xDF) // Y3 = ui - tim
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x24, 0xCA)       // pre[k..k+3] = Y4
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x2C, 0xCB)       // pim[k..k+3] = Y5
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x14, 0xCB)       // dv_r[k..k+3] = Y2
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b3(c, 0x5C, 0xCD, 0x00) // dv_i[k..k+3] = Y3
        mc_b4(c, 0x48, 0x83, 0xC1, 4)
        j_fgf4 := mc_jmp32(c); mc_patch_rel32(c, j_fgf4, lp_fgf4)
        mc_patch_rel32(c, jg_fgf_t, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)

        // Final stage scalar tail & --simd=scalar
        mc_patch_rel32(c, jz_fgf_sc, buf_len(c))
        lp_fgfs := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xF9); jge_fgf_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b3(c, 0x44, 0xCD, 0x00) // X0 = wr
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xCE)       // X1 = wi
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x14, 0xC8)       // X2 = ur
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x1C, 0xC9)       // X3 = ui
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x24); mc_b1(c, 0xCE)             // X4 = vr
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x2C); mc_b1(c, 0xCF)             // X5 = vi
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xF4); mc_b4(c, 0xF2, 0x0F, 0x59, 0xF0) // X6 = vr*wr
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xFD); mc_b4(c, 0xF2, 0x0F, 0x59, 0xF9) // X7 = vi*wi
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xF7)                                   // X6 = tr
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xFC); mc_b4(c, 0xF2, 0x0F, 0x59, 0xF9) // X7 = vr*wi
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xE8); mc_b4(c, 0xF2, 0x0F, 0x58, 0xFD) // X7 = tim
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xE2); mc_b4(c, 0xF2, 0x0F, 0x58, 0xE6) // X4 = ur + tr
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xD6)                                   // X2 = ur - tr
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xEB); mc_b4(c, 0xF2, 0x0F, 0x58, 0xEF) // X5 = ui + tim
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xDF)                                   // X3 = ui - tim
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x24, 0xCA)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x2C, 0xCB)
        mc_b4(c, 0xF2, 0x0F, 0x11, 0x14); mc_b1(c, 0xCB)
        mc_b4(c, 0xF2, 0x0F, 0x11, 0x5C); mc_b2(c, 0xCD, 0x00)
        mc_b3(c, 0x48, 0xFF, 0xC1)
        j_fgfs := mc_jmp32(c); mc_patch_rel32(c, j_fgfs, lp_fgfs)
        mc_patch_rel32(c, jge_fgf_dn, buf_len(c))
        jmp_fg_end := mc_jmp32(c)

        // === INTERMEDIATE GLOBAL STAGE: in-place on tmp_r (R8) / tmp_i (R9) ===
        mc_patch_rel32(c, jz_fg_mid, buf_len(c))
        mc_b3(c, 0x83, 0xE2, 63) // RDX = hsh
        mc_b4(c, 0x48, 0x89, 0x94, 0x24); mc_u32(c, 0xB8) // [0xB8] = hsh
        mc_b3(c, 0x48, 0x89, 0xD1) // RCX = hsh
        mc_b2(c, 0x41, 0xBA); mc_u32(c, 1); mc_b3(c, 0x49, 0xD3, 0xE2) // R10 = half = 1 << hsh
        mc_b4(c, 0x4C, 0x89, 0x94, 0x24); mc_u32(c, 0xA8)             // [0xA8] = half
        mc_b3(c, 0x4D, 0x89, 0xE3); mc_b3(c, 0x49, 0xD3, 0xEB)         // R11 = step = half_n >> hsh
        mc_b4(c, 0x4C, 0x89, 0x9C, 0x24); mc_u32(c, 0xB0)             // [0xB0] = step
        mc_b3(c, 0x4C, 0x89, 0xD5); mc_b4(c, 0x48, 0xC1, 0xE5, 3)      // RBP = half * 8
        mc_b3(c, 0x4C, 0x89, 0xDE); mc_b4(c, 0x48, 0xC1, 0xE6, 3)      // RSI = step * 8
        mc_b4(c, 0x49, 0x8D, 0x7A, 0xFF)                               // RDI = hmask = half - 1
        mc_b3(c, 0x49, 0x89, 0xCC)                                     // R12 = hsh

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_fgm_sc := mc_jcc32(c, 0x84)

        // AVX2 4-wide intermediate global stage (RBX = bf, R15 = bf1)
        mc_align16_nop(c)
        lp_fgm := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xFB); jge_fgm_dn := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4C, 0x89, 0xE1)       // CL = hsh
        mc_b3(c, 0x48, 0x89, 0xD8); mc_b3(c, 0x48, 0x21, 0xF8) // RAX = k = bf & hmask
        mc_b4(c, 0x48, 0x8D, 0x50, 4); mc_b3(c, 0x4C, 0x39, 0xD2); jg_fgm_1 := mc_jcc32(c, 0x8F)
        mc_b4(c, 0x48, 0x8D, 0x53, 4); mc_b3(c, 0x4C, 0x39, 0xFA); jg_fgm_1b := mc_jcc32(c, 0x8F)
        // Compute u = ((bf >> hsh) << (hsh+1)) + k, ti_bytes = k * (step*8)
        mc_b3(c, 0x48, 0x89, 0xDA); mc_b3(c, 0x48, 0xD3, 0xEA) // RDX = blk = bf >> hsh
        mc_b3(c, 0x48, 0x01, 0xD2); mc_b3(c, 0x48, 0xD3, 0xE2) // RDX = blk << (hsh + 1)
        mc_b3(c, 0x48, 0x01, 0xC2)                             // RDX = u_idx
        mc_b3(c, 0x48, 0x89, 0xC1); mc_b4(c, 0x48, 0x0F, 0xAF, 0xCE) // RCX = k * (step * 8) = ti_bytes
        // Gather 4 strided twiddles into Y0 (twr), Y1 (twi) using RAX = twr+ti_bytes, R11 = twi+ti_bytes? Keep R11! Use RAX only sequentially!
        mc_b4(c, 0x49, 0x8D, 0x44, 0x0D); mc_b1(c, 0)          // RAX = R13 + RCX (twr + ti_bytes)
        mc_vex2(c, 0, 0, 3, 0x10, 0x00)                        // VMOVSD X0, [RAX]
        mc_vex2(c, 0, 0, 1, 0x16, 0x04); mc_b1(c, 0x30)        // VMOVHPD X0, X0, [RAX+RSI]
        mc_b4(c, 0x48, 0x8D, 0x04, 0x70)                       // RAX += 2*step*8
        mc_vex2(c, 0, 0, 3, 0x10, 0x30)                        // VMOVSD X6, [RAX]
        mc_vex2(c, 6, 0, 1, 0x16, 0x34); mc_b1(c, 0x30)        // VMOVHPD X6, X6, [RAX+RSI]
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x18); mc_b2(c, 0xC6, 1) // VINSERTF128 Y0, Y0, X6, 1
        mc_b4(c, 0x49, 0x8D, 0x04, 0x0E)                       // RAX = R14 + RCX (twi + ti_bytes)
        mc_vex2(c, 0, 0, 3, 0x10, 0x08)                        // VMOVSD X1, [RAX]
        mc_vex2(c, 1, 0, 1, 0x16, 0x0C); mc_b1(c, 0x30)        // VMOVHPD X1, X1, [RAX+RSI]
        mc_b4(c, 0x48, 0x8D, 0x04, 0x70)
        mc_vex2(c, 0, 0, 3, 0x10, 0x30)
        mc_vex2(c, 6, 0, 1, 0x16, 0x34); mc_b1(c, 0x30)
        mc_vex3(c, 0, 0, 0, 3, 0, 1, 1, 1, 0x18); mc_b2(c, 0xCE, 1) // VINSERTF128 Y1, Y1, X6, 1
        // RAX = tmp_r + u_idx*8, RCX = tmp_i + u_idx*8
        mc_b4(c, 0x49, 0x8D, 0x04, 0xD0) // RAX = R8 + RDX*8
        mc_b4(c, 0x49, 0x8D, 0x0C, 0xD1) // RCX = R9 + RDX*8
        mc_vex2(c, 0, 1, 1, 0x10, 0x10)              // Y2 = [RAX] (ur)
        mc_vex2(c, 0, 1, 1, 0x10, 0x19)              // Y3 = [RCX] (ui)
        mc_vex2(c, 0, 1, 1, 0x10, 0x24); mc_b1(c, 0x28) // Y4 = [RAX + RBP] (vr) (SIB: idx=5(RBP), base=0(RAX) -> 0x28!)
        mc_vex2(c, 0, 1, 1, 0x10, 0x2C); mc_b1(c, 0x29) // Y5 = [RCX + RBP] (vi) (SIB: idx=5(RBP), base=1(RCX) -> 0x29!)
        mc_vex2(c, 4, 1, 1, 0x59, 0xF0) // Y6 = vr * wr
        mc_vex2(c, 5, 1, 1, 0x59, 0xF9) // Y7 = vi * wi
        mc_vex2(c, 6, 1, 1, 0x5C, 0xF7) // Y6 = tr
        mc_vex2(c, 4, 1, 1, 0x59, 0xF9) // Y7 = vr * wi
        mc_vex2(c, 5, 1, 1, 0x59, 0xE8) // Y5 = vi * wr
        mc_vex2(c, 7, 1, 1, 0x58, 0xFD) // Y7 = tim
        mc_vex2(c, 2, 1, 1, 0x58, 0xE6) // Y4 = ur + tr
        mc_vex2(c, 2, 1, 1, 0x5C, 0xD6) // Y2 = ur - tr
        mc_vex2(c, 3, 1, 1, 0x58, 0xEF) // Y5 = ui + tim
        mc_vex2(c, 3, 1, 1, 0x5C, 0xDF) // Y3 = ui - tim
        mc_vex2(c, 0, 1, 1, 0x11, 0x20)                 // [RAX] = Y4
        mc_vex2(c, 0, 1, 1, 0x11, 0x29)                 // [RCX] = Y5
        mc_vex2(c, 0, 1, 1, 0x11, 0x14); mc_b1(c, 0x28) // [RAX + RBP] = Y2
        mc_vex2(c, 0, 1, 1, 0x11, 0x1C); mc_b1(c, 0x29) // [RCX + RBP] = Y3
        mc_b4(c, 0x48, 0x83, 0xC3, 4)
        j_fgm4 := mc_jmp32(c); mc_patch_rel32(c, j_fgm4, lp_fgm)

        // VEX-128 single butterfly (boundary < 4 within block)
        mc_patch_rel32(c, jg_fgm_1, buf_len(c))
        mc_patch_rel32(c, jg_fgm_1b, buf_len(c))
        mc_b3(c, 0x48, 0x89, 0xDA); mc_b3(c, 0x48, 0xD3, 0xEA)
        mc_b3(c, 0x48, 0x01, 0xD2); mc_b3(c, 0x48, 0xD3, 0xE2); mc_b3(c, 0x48, 0x01, 0xC2)
        mc_b3(c, 0x48, 0x89, 0xC1); mc_b4(c, 0x48, 0x0F, 0xAF, 0xCE)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b3(c, 0x44, 0x0D, 0x00) // X0 = twr[ti]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x0C, 0x0E)       // X1 = twi[ti]
        mc_b4(c, 0x49, 0x8D, 0x04, 0xD0); mc_b4(c, 0x49, 0x8D, 0x0C, 0xD1)
        mc_vex2(c, 0, 0, 3, 0x10, 0x10); mc_vex2(c, 0, 0, 3, 0x10, 0x19)
        mc_vex2(c, 0, 0, 3, 0x10, 0x24); mc_b1(c, 0x28)
        mc_vex2(c, 0, 0, 3, 0x10, 0x2C); mc_b1(c, 0x29)
        mc_vex2(c, 4, 0, 3, 0x59, 0xF0); mc_vex2(c, 5, 0, 3, 0x59, 0xF9); mc_vex2(c, 6, 0, 3, 0x5C, 0xF7)
        mc_vex2(c, 4, 0, 3, 0x59, 0xF9); mc_vex2(c, 5, 0, 3, 0x59, 0xE8); mc_vex2(c, 7, 0, 3, 0x58, 0xFD)
        mc_vex2(c, 2, 0, 3, 0x58, 0xE6); mc_vex2(c, 2, 0, 3, 0x5C, 0xD6)
        mc_vex2(c, 3, 0, 3, 0x58, 0xEF); mc_vex2(c, 3, 0, 3, 0x5C, 0xDF)
        mc_vex2(c, 0, 0, 3, 0x11, 0x20); mc_vex2(c, 0, 0, 3, 0x11, 0x29)
        mc_vex2(c, 0, 0, 3, 0x11, 0x14); mc_b1(c, 0x28)
        mc_vex2(c, 0, 0, 3, 0x11, 0x1C); mc_b1(c, 0x29)
        mc_b3(c, 0x48, 0xFF, 0xC3)
        j_fgm1 := mc_jmp32(c); mc_patch_rel32(c, j_fgm1, lp_fgm)
        mc_patch_rel32(c, jge_fgm_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_fg_end2 := mc_jmp32(c)

        // SSE2 scalar fallback for intermediate global stage (--simd=scalar)
        mc_patch_rel32(c, jz_fgm_sc, buf_len(c))
        lp_fgms := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xFB); jge_fgms_dn := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4C, 0x89, 0xE1)
        mc_b3(c, 0x48, 0x89, 0xD8); mc_b3(c, 0x48, 0x21, 0xF8) // k
        mc_b3(c, 0x48, 0x89, 0xDA); mc_b3(c, 0x48, 0xD3, 0xEA)
        mc_b3(c, 0x48, 0x01, 0xD2); mc_b3(c, 0x48, 0xD3, 0xE2); mc_b3(c, 0x48, 0x01, 0xC2)
        mc_b3(c, 0x48, 0x89, 0xC1); mc_b4(c, 0x48, 0x0F, 0xAF, 0xCE)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b3(c, 0x44, 0x0D, 0x00)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0x0E)
        mc_b4(c, 0x49, 0x8D, 0x04, 0xD0); mc_b4(c, 0x49, 0x8D, 0x0C, 0xD1)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x10); mc_b4(c, 0xF2, 0x0F, 0x10, 0x19)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x24); mc_b1(c, 0x28)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x2C); mc_b1(c, 0x29)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xF4); mc_b4(c, 0xF2, 0x0F, 0x59, 0xF0)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xFD); mc_b4(c, 0xF2, 0x0F, 0x59, 0xF9)
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xF7)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xFC); mc_b4(c, 0xF2, 0x0F, 0x59, 0xF9)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xE8); mc_b4(c, 0xF2, 0x0F, 0x58, 0xFD)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xE2); mc_b4(c, 0xF2, 0x0F, 0x58, 0xE6)
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xD6)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xEB); mc_b4(c, 0xF2, 0x0F, 0x58, 0xEF)
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xDF)
        mc_b4(c, 0xF2, 0x0F, 0x11, 0x20); mc_b4(c, 0xF2, 0x0F, 0x11, 0x29)
        mc_b4(c, 0xF2, 0x0F, 0x11, 0x14); mc_b1(c, 0x28)
        mc_b4(c, 0xF2, 0x0F, 0x11, 0x1C); mc_b1(c, 0x29)
        mc_b3(c, 0x48, 0xFF, 0xC3)
        j_fgms := mc_jmp32(c); mc_patch_rel32(c, j_fgms, lp_fgms)
        mc_patch_rel32(c, jge_fgms_dn, buf_len(c))

        mc_patch_rel32(c, jmp_fg_end, buf_len(c))
        mc_patch_rel32(c, jmp_fg_end2, buf_len(c))
        mc_patch_rel32(c, jge_fg_dn, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xD8)
        cg_reg_helper(cg, h_ai_fft_global_stage_f64(), s_fg, buf_len(c))
    }

    // 89. `h_ai_flash_attn_rows_f64(meta, sc_buf, seq_d, r0_r1, scale) -> f64`: fused multi-row AVX2+FMA3 QK^T + exp(-x) + PV (B099)
    if cg_is_helper_used(cg, h_ai_flash_attn_rows_f64()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_far := buf_len(cg.rdata)
        buf_push_u64(cg.rdata, 0x4049000000000000) // +0:  50.0
        buf_push_u64(cg.rdata, 0x3FF71547652B82FE) // +8:  inv_ln2
        buf_push_u64(cg.rdata, 0x3FE0000000000000) // +16: 0.5
        buf_push_u64(cg.rdata, 0x3FE62E42FEFA39EF) // +24: ln2
        buf_push_u64(cg.rdata, 1023)               // +32: 1023 (i64)
        buf_push_u64(cg.rdata, 0x3FF0000000000000) // +40: 1.0
        buf_push_u64(cg.rdata, 0x3FC5555555555555) // +48: c3
        buf_push_u64(cg.rdata, 0x3FA5555555555555) // +56: c4
        buf_push_u64(cg.rdata, 0x3F81111111111111) // +64: c5
        buf_push_u64(cg.rdata, 0x3F56C16C16C16C17) // +72: c6
        buf_push_u64(cg.rdata, 0x3F2A01A01A01A01A) // +80: c7
        buf_push_u64(cg.rdata, 0x3EFA01A01A01A01A) // +88: c8
        buf_push_u64(cg.rdata, 0xC3E0000000000000) // +96: -1e18

        mc_align16(c)
        s_far := buf_len(c)
        mc_ai_enter(c, 0x148)
        // [RSP+0..0x9F]=XMM6..15, [0xA0]=scale, [0xA8]=acc, [0xB0]=hi, [0xB8]=r1, [0xC0]=seq, [0xC8]=d, [0xD0]=sc_buf, [0xD8]=meta, [0xE0]=&rdata, [0xE8]=inv_se
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x48, 0x8B, 0x01); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 0xD8) // meta
        mc_b4(c, 0x48, 0x8B, 0x41, 8); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 0xD0) // sc_buf
        mc_b4(c, 0x48, 0x8B, 0x41, 16) // seq_d
        mc_b2(c, 0x89, 0xC2); mc_b4(c, 0x48, 0x89, 0x94, 0x24); mc_u32(c, 0xC8) // d
        mc_b4(c, 0x48, 0xC1, 0xE8, 32); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 0xC0) // seq
        mc_b4(c, 0x48, 0x8B, 0x41, 24) // r0_r1
        mc_b2(c, 0x89, 0xC2); mc_b4(c, 0x48, 0x89, 0x94, 0x24); mc_u32(c, 0xB8) // r1
        mc_b4(c, 0x48, 0xC1, 0xE8, 32); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 0xB0) // hi = r0
        mc_b4(c, 0x48, 0x8B, 0x41, 32); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 0xA0) // scale
        mc_b3(c, 0x48, 0xC7, 0x84); mc_b1(c, 0x24); mc_u32(c, 0xA8); mc_u32(c, 0) // acc = 0.0
        cg_lea_rax_rdata(cg, roff_far); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 0xE0)

        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 0xB0)
        mc_b4(c, 0x48, 0x3B, 0x84, 0x24); mc_u32(c, 0xB8)
        jge_far_dn := mc_jcc32(c, 0x8D)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_far_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x48, 0xF7, 0x84, 0x24); mc_u32(c, 0xC8); mc_u32(c, 3); jnz_far_sc2 := mc_jcc32(c, 0x85)
        mc_b4(c, 0x48, 0xF7, 0x84, 0x24); mc_u32(c, 0xC0); mc_u32(c, 3); jnz_far_sc3 := mc_jcc32(c, 0x85)

        // === 4-ROW TILED AVX2+FMA3 FASTPATH (4x less K_h and V_h L2 bandwidth when d%8==0 and seq%4==0!) ===
        mc_b4(c, 0x48, 0xF7, 0x84, 0x24); mc_u32(c, 0xC8); mc_u32(c, 7); jnz_far4_skip := mc_jcc32(c, 0x85)
        mc_align16_nop(c)
        lp_far4_hi := buf_len(c)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 0xB0) // RAX = hi
        mc_b4(c, 0x48, 0x8D, 0x50, 4)                     // RDX = hi + 4
        mc_b4(c, 0x48, 0x3B, 0x94, 0x24); mc_u32(c, 0xB8); jg_far4_done := mc_jcc32(c, 0x8F)
        mc_b4(c, 0x4C, 0x8B, 0xA4, 0x24); mc_u32(c, 0xC0) // R12 = seq
        mc_b4(c, 0x4C, 0x8B, 0xAC, 0x24); mc_u32(c, 0xC8) // R13 = d
        mc_b2(c, 0x48, 0x99); mc_b3(c, 0x49, 0xF7, 0xFC) // RAX = h, RDX = i
        mc_b4(c, 0x48, 0x8D, 0x4A, 4); mc_b3(c, 0x4C, 0x39, 0xE1); jg_far4_single := mc_jcc32(c, 0x8F)
        // Compute qi0..qi3, pk_h, pv_h
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC4); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC5) // RAX = base = h*seq*d
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xD5) // RDX = i*d
        mc_b4(c, 0x48, 0x8B, 0xAC, 0x24); mc_u32(c, 0xD8) // RBP = meta
        mc_b3(c, 0x4C, 0x8B, 0x45); mc_b1(c, 0)           // R8  = pq
        mc_b4(c, 0x4C, 0x8B, 0x4D, 8)                     // R9  = pk
        mc_b4(c, 0x4C, 0x8B, 0x55, 16)                    // R10 = pv
        mc_b4(c, 0x48, 0xC1, 0xE0, 3); mc_b4(c, 0x48, 0xC1, 0xE2, 3)
        mc_b3(c, 0x49, 0x01, 0xC0); mc_b3(c, 0x49, 0x01, 0xD0) // R8 = qi0
        mc_b3(c, 0x49, 0x01, 0xC1); mc_b4(c, 0x4C, 0x89, 0x8C, 0x24); mc_u32(c, 0xF0) // [0xF0] = pk_h
        mc_b3(c, 0x49, 0x01, 0xC2); mc_b4(c, 0x4C, 0x89, 0x94, 0x24); mc_u32(c, 0xF8) // [0xF8] = pv_h
        mc_b3(c, 0x4C, 0x89, 0xED); mc_b4(c, 0x48, 0xC1, 0xE5, 3) // RBP = d*8
        mc_b4(c, 0x4D, 0x8D, 0x34, 0x28) // R14 = qi1 = qi0 + d*8
        mc_b4(c, 0x4D, 0x8D, 0x3C, 0x2E) // R15 = qi2 = qi1 + d*8
        mc_b4(c, 0x49, 0x8D, 0x3C, 0x2F) // RDI = qi3 = qi2 + d*8
        mc_b4(c, 0x4C, 0x8B, 0x9C, 0x24); mc_u32(c, 0xD0) // R11 = sc_buf
        mc_b3(c, 0x4C, 0x89, 0xE0); mc_b4(c, 0x48, 0xC1, 0xE0, 3) // RAX = seq*8 (row stride in sc_buf)
        mc_b4(c, 0x48, 0x8B, 0xB4, 0x24); mc_u32(c, 0xF0) // RSI = pk_h
        mc_b4(c, 0x4C, 0x8B, 0x8C, 0x24); mc_u32(c, 0xE0) // R9 = &rdata
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x71, 96) // Y14 = bcast(-1e18)
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0xBC, 0x24); mc_u32(c, 0xA0) // Y15 = bcast(scale)
        // Step 1: 4-Q x 1-K QK^T (j = 0..seq-1, reads K_h ONCE for 4 query rows!)
        mc_b2(c, 0x31, 0xDB) // RBX = j = 0
        lp_f4_qkj := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE3); jge_f4_qk_dn := mc_jcc32(c, 0x8D)
        mc_vex2(c, 0, 1, 1, 0x57, 0xC0); mc_vex2(c, 1, 1, 1, 0x57, 0xC9)
        mc_vex2(c, 2, 1, 1, 0x57, 0xD2); mc_vex2(c, 3, 1, 1, 0x57, 0xDB)
        mc_b2(c, 0x31, 0xC9)
        lp_f4_qkd := buf_len(c)
        mc_vex2(c, 0, 1, 1, 0x10, 0x24); mc_b1(c, 0xCE)                // Y4 = K_h[j, m..m+3]
        mc_vex3(c, 0, 0, 1, 2, 1, 4, 1, 1, 0xB8); mc_b2(c, 0x04, 0xC8) // Y0 += Y4*qi0
        mc_vex3(c, 0, 0, 1, 2, 1, 4, 1, 1, 0xB8); mc_b2(c, 0x0C, 0xCE) // Y1 += Y4*qi1
        mc_vex3(c, 0, 0, 1, 2, 1, 4, 1, 1, 0xB8); mc_b2(c, 0x14, 0xCF) // Y2 += Y4*qi2
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b2(c, 0x1C, 0xCF) // Y3 += Y4*qi3
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b3(c, 0x4C, 0x39, 0xE9)
        jl_f4_qkd := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_f4_qkd, lp_f4_qkd)
        // 5-insn 4-way reduce -> Y0 = [s0, s1, s2, s3] * scale
        mc_vex2(c, 0, 1, 1, 0x7C, 0xC1); mc_vex2(c, 2, 1, 1, 0x7C, 0xD3)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x06); mc_b2(c, 0xE2, 0x20)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x06); mc_b2(c, 0xEA, 0x31)
        mc_vex2(c, 4, 1, 1, 0x58, 0xC5)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x59); mc_b1(c, 0xC7)       // Y0 *= scale
        mc_vex3(c, 1, 0, 0, 1, 0, 14, 1, 1, 0x5F); mc_b1(c, 0xF0)      // Y14 = max(Y14, Y0)
        // Store s0..s3 into sc0[j], sc1[j], sc2[j], sc3[j] (RAX = seq*8, RDX = &sc0[j])
        mc_b4(c, 0x49, 0x8D, 0x14, 0xDB)                               // RDX = R11 + RBX*8
        mc_vex2(c, 0, 0, 3, 0x11, 0x02)                                // [RDX] = s0
        mc_vex2(c, 0, 0, 1, 0x15, 0xC8)                                // X1 = s1
        mc_vex2(c, 0, 0, 3, 0x11, 0x0C); mc_b1(c, 0x02)                // [RDX + RAX] = s1
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC0, 1)    // X0 = [s2, s3]
        mc_vex2(c, 0, 0, 3, 0x11, 0x04); mc_b1(c, 0x42)                // [RDX + RAX*2] = s2
        mc_b3(c, 0x48, 0x01, 0xC2); mc_vex2(c, 0, 0, 1, 0x15, 0xC8)    // RDX += RAX; X1 = s3
        mc_vex2(c, 0, 0, 3, 0x11, 0x0C); mc_b1(c, 0x42)                // [RDX + RAX*2] = s3
        mc_b3(c, 0x48, 0x01, 0xEE); mc_b3(c, 0x48, 0xFF, 0xC3)         // pk += d*8; j++
        j_f4_qkj := mc_jmp32(c); mc_patch_rel32(c, j_f4_qkj, lp_f4_qkj)
        mc_patch_rel32(c, jge_f4_qk_dn, buf_len(c))
        // Store Y14 = [mx0, mx1, mx2, mx3] to [RSP+0x100..0x11F]
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0xB4, 0x24); mc_u32(c, 0x100)

        // Step 2: 4x inline 4-wide AVX2 exp(-u) loading constants Y6..Y15 ONCE for all 4 rows!
        mc_b4(c, 0x48, 0x8B, 0xBC, 0x24); mc_u32(c, 0xE0) // RDI = &rdata
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x37)       // Y6  = 50.0
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x7F, 8)    // Y7  = inv_ln2
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x47, 16)   // Y8  = 0.5
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x4F, 24)   // Y9  = ln2
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x59); mc_b2(c, 0x57, 32)   // Y10 = 1023
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x5F, 40)   // Y11 = 1.0
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x67, 48)   // Y12 = c3
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x6F, 56)   // Y13 = c4
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x77, 64)   // Y14 = c5
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x7F, 72)   // Y15 = c6
        mc_b2(c, 0x31, 0xDB) // RBX = r = 0..3
        mc_b3(c, 0x4D, 0x89, 0xDE) // R14 = cur_sc = sc_buf (advances by RAX = seq*8 each row)
        lp_f4_er := buf_len(c)
        mc_vex2(c, 5, 1, 1, 0x57, 0xED) // Y5 = se = 0
        mc_b2(c, 0x31, 0xC9)            // RCX = j = 0
        lp_f4_ej := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE1); jge_f4_ej_dn := mc_jcc32(c, 0x8D)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x84, 0xDC); mc_u32(c, 0x100) // Y0 = bcast(mx[r]) (SIB: scale=8 idx=3(RBX) base=4(RSP) -> 0xDC!)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x5C); mc_b2(c, 0x04, 0xCE) // Y0 = mx[r] - cur_sc[j..j+3]
        mc_vex256(c, 1, 4, 0, 6, 0xC2); mc_b1(c, 2)
        mc_vex256(c, 1, 0, 0, 6, 0x5D)
        mc_vex256(c, 1, 1, 0, 7, 0x59)
        mc_vex256(c, 1, 1, 1, 8, 0x58)
        mc_vex256(c, 1, 2, 0, 1, 0xE6)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0xE6); mc_b1(c, 0xCA)
        mc_vex256(c, 2, 2, 0, 2, 0x25)
        mc_vex256(c, 1, 2, 10, 2, 0xFB)
        mc_vex3(c, 0, 0, 0, 1, 0, 2, 1, 1, 0x73); mc_b2(c, 0xF2, 52)
        mc_vex256(c, 1, 1, 1, 9, 0x59)
        mc_vex256(c, 1, 0, 1, 0, 0x5C)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x5F, 88)
        mc_vex256(c, 1, 3, 3, 0, 0x59)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x4F, 80)
        mc_vex256(c, 1, 3, 3, 1, 0x58)
        mc_vex256(c, 1, 3, 3, 0, 0x59); mc_vex256(c, 1, 3, 3, 15, 0x58)
        mc_vex256(c, 1, 3, 3, 0, 0x59); mc_vex256(c, 1, 3, 3, 14, 0x58)
        mc_vex256(c, 1, 3, 3, 0, 0x59); mc_vex256(c, 1, 3, 3, 13, 0x58)
        mc_vex256(c, 1, 3, 3, 0, 0x59); mc_vex256(c, 1, 3, 3, 12, 0x58)
        mc_vex256(c, 1, 3, 3, 0, 0x59); mc_vex256(c, 1, 3, 3, 8,  0x58)
        mc_vex256(c, 1, 3, 3, 0, 0x59); mc_vex256(c, 1, 3, 3, 11, 0x58)
        mc_vex256(c, 1, 3, 3, 0, 0x59); mc_vex256(c, 1, 3, 3, 11, 0x58)
        mc_vex256(c, 1, 3, 2, 3, 0x59)
        mc_vex256(c, 1, 3, 3, 4, 0x54)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x1C, 0xCE) // cur_sc[j..j+3] = Y3
        mc_vex256(c, 1, 5, 5, 3, 0x58)
        mc_b4(c, 0x48, 0x83, 0xC1, 4)
        j_f4_ej := mc_jmp32(c); mc_patch_rel32(c, j_f4_ej, lp_f4_ej)
        mc_patch_rel32(c, jge_f4_ej_dn, buf_len(c))
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xE9, 1)
        mc_vex2(c, 5, 0, 1, 0x58, 0xC1); mc_vex2(c, 0, 0, 1, 0x15, 0xC8); mc_vex2(c, 0, 0, 3, 0x58, 0xC1)
        mc_vex3(c, 0, 0, 0, 1, 0, 11, 0, 3, 0x5E); mc_b1(c, 0xC0) // VDIVSD X0, X11(1.0), X0
        mc_vex2(c, 0, 0, 3, 0x11, 0x84); mc_b1(c, 0xDC); mc_u32(c, 0x120) // [RSP+0x120+r*8] = inv_se[r]
        mc_b3(c, 0x49, 0x01, 0xC6) // R14 += seq*8
        mc_b3(c, 0x48, 0xFF, 0xC3); mc_b4(c, 0x48, 0x83, 0xFB, 4)
        jl_f4_er := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_f4_er, lp_f4_er)

        // Step 3: 4-Q x 1-V PV in 8-dim (64B cache-line) strips -> reads V_h ONCE for all 4 rows!
        mc_b4(c, 0x4C, 0x8B, 0x84, 0x24); mc_u32(c, 0xD0) // R8  = sc0
        mc_b4(c, 0x4D, 0x8D, 0x0C, 0x00)                  // R9  = sc1 = R8 + RAX
        mc_b4(c, 0x4D, 0x8D, 0x14, 0x01)                  // R10 = sc2 = R9 + RAX
        mc_b4(c, 0x4D, 0x8D, 0x1C, 0x02)                  // R11 = sc3 = R10 + RAX
        mc_b4(c, 0x4C, 0x8B, 0xB4, 0x24); mc_u32(c, 0xF8) // R14 = pv_h
        mc_vex256(c, 1, 12, 12, 12, 0x57); mc_vex256(c, 1, 13, 13, 13, 0x57)
        mc_vex256(c, 1, 14, 14, 14, 0x57); mc_vex256(c, 1, 15, 15, 15, 0x57)
        mc_b2(c, 0x31, 0xFF) // RDI = m = 0..d-8 step 8
        lp_f4_pvm := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xEF); jge_f4_pv_dn := mc_jcc32(c, 0x8D)
        mut yi4 := 0; while yi4 < 8 { mc_vex256(c, 1, yi4, yi4, yi4, 0x57); yi4 += 1 }
        mc_b4(c, 0x49, 0x8D, 0x34, 0xFE) // RSI = pv_h + m*8
        mc_b2(c, 0x31, 0xC9)             // RCX = j = 0
        lp_f4_pvj := buf_len(c)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x06)        // Y8 = [RSI]
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x4E, 32)    // Y9 = [RSI+32]
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x14, 0xC8)  // Y10 = bcast(sc0[j])
        mc_vex3(c, 0, 0, 1, 2, 1, 10, 1, 1, 0xB8); mc_b1(c, 0xC0)       // Y0 += Y10*Y8
        mc_vex3(c, 0, 0, 1, 2, 1, 10, 1, 1, 0xB8); mc_b1(c, 0xC9)       // Y1 += Y10*Y9
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x14, 0xC9)  // Y10 = bcast(sc1[j])
        mc_vex3(c, 0, 0, 1, 2, 1, 10, 1, 1, 0xB8); mc_b1(c, 0xD0)       // Y2 += Y10*Y8
        mc_vex3(c, 0, 0, 1, 2, 1, 10, 1, 1, 0xB8); mc_b1(c, 0xD9)       // Y3 += Y10*Y9
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x14, 0xCA)  // Y10 = bcast(sc2[j])
        mc_vex3(c, 0, 0, 1, 2, 1, 10, 1, 1, 0xB8); mc_b1(c, 0xE0)       // Y4 += Y10*Y8
        mc_vex3(c, 0, 0, 1, 2, 1, 10, 1, 1, 0xB8); mc_b1(c, 0xE9)       // Y5 += Y10*Y9
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x14, 0xCB)  // Y10 = bcast(sc3[j])
        mc_vex3(c, 0, 0, 1, 2, 1, 10, 1, 1, 0xB8); mc_b1(c, 0xF0)       // Y6 += Y10*Y8
        mc_vex3(c, 0, 0, 1, 2, 1, 10, 1, 1, 0xB8); mc_b1(c, 0xF9)       // Y7 += Y10*Y9
        mc_b3(c, 0x48, 0x01, 0xEE); mc_b3(c, 0x48, 0xFF, 0xC1); mc_b3(c, 0x4C, 0x39, 0xE1)
        jl_f4_pvj := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_f4_pvj, lp_f4_pvj)
        mc_vex256(c, 1, 12, 12, 0, 0x58); mc_vex256(c, 1, 12, 12, 1, 0x58)
        mc_vex256(c, 1, 13, 13, 2, 0x58); mc_vex256(c, 1, 13, 13, 3, 0x58)
        mc_vex256(c, 1, 14, 14, 4, 0x58); mc_vex256(c, 1, 14, 14, 5, 0x58)
        mc_vex256(c, 1, 15, 15, 6, 0x58); mc_vex256(c, 1, 15, 15, 7, 0x58)
        mc_b4(c, 0x48, 0x83, 0xC7, 8)
        j_f4_pvm := mc_jmp32(c); mc_patch_rel32(c, j_f4_pvm, lp_f4_pvm)
        mc_patch_rel32(c, jge_f4_pv_dn, buf_len(c))
        // 5-insn 4-way reduce Y12..Y15 -> Y0 = [sumO0..3], mul inv_se[0..3], hsum -> acc
        mc_vex3(c, 0, 0, 1, 1, 0, 12, 1, 1, 0x7C); mc_b1(c, 0xC5)
        mc_vex3(c, 0, 0, 1, 1, 0, 14, 1, 1, 0x7C); mc_b1(c, 0xD7)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x06); mc_b2(c, 0xE2, 0x20)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x06); mc_b2(c, 0xEA, 0x31)
        mc_vex2(c, 4, 1, 1, 0x58, 0xC5)
        mc_vex2(c, 0, 1, 1, 0x59, 0x84); mc_b1(c, 0x24); mc_u32(c, 0x120) // Y0 *= inv_se[0..3]
        _mc_vhsum_pd_to_xmm0(c, 0)
        mc_vex2(c, 0, 0, 3, 0x58, 0x84); mc_b1(c, 0x24); mc_u32(c, 0xA8)
        mc_vex2(c, 0, 0, 3, 0x11, 0x84); mc_b1(c, 0x24); mc_u32(c, 0xA8)
        mc_b4(c, 0x48, 0x83, 0x84, 0x24); mc_u32(c, 0xB0); mc_b1(c, 4) // hi += 4
        j_far4_hi := mc_jmp32(c); mc_patch_rel32(c, j_far4_hi, lp_far4_hi)
        // Single-row bridge when crossing head boundary: process 1 row in lp_far_hi, then jump back? Even simpler: fall into lp_far_hi for remaining rows (only happens at head boundary < 3 rows, or align r0/r1 in caller!)
        mc_patch_rel32(c, jg_far4_single, buf_len(c))
        mc_patch_rel32(c, jg_far4_done, buf_len(c))
        mc_patch_rel32(c, jnz_far4_skip, buf_len(c))

        // === AVX2+FMA3 FUSED MULTI-ROW LOOP (hi = r0 .. r1-1) ===
        mc_align16_nop(c)
        lp_far_hi := buf_len(c)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 0xB0) // RAX = hi
        mc_b4(c, 0x48, 0x3B, 0x84, 0x24); mc_u32(c, 0xB8); jge_far_hi_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4C, 0x8B, 0xA4, 0x24); mc_u32(c, 0xC0) // R12 = seq
        mc_b4(c, 0x4C, 0x8B, 0xAC, 0x24); mc_u32(c, 0xC8) // R13 = d
        mc_b2(c, 0x48, 0x99); mc_b3(c, 0x49, 0xF7, 0xFC) // RAX = h = hi / seq, RDX = i = hi % seq
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC4); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC5) // RAX = base = h * seq * d
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xD5) // RDX = i * d
        mc_b4(c, 0x48, 0x8B, 0xAC, 0x24); mc_u32(c, 0xD8) // RBP = meta
        mc_b3(c, 0x4C, 0x8B, 0x45); mc_b1(c, 0)           // R8  = pq
        mc_b4(c, 0x4C, 0x8B, 0x4D, 8)                     // R9  = pk
        mc_b4(c, 0x4C, 0x8B, 0x55, 16)                    // R10 = pv
        mc_b4(c, 0x48, 0xC1, 0xE0, 3); mc_b4(c, 0x48, 0xC1, 0xE2, 3) // base*8, i*d*8
        mc_b3(c, 0x49, 0x01, 0xC0); mc_b3(c, 0x49, 0x01, 0xD0)       // R8 = qi
        mc_b3(c, 0x49, 0x01, 0xC1)                                    // R9 = pk_h
        mc_b3(c, 0x49, 0x01, 0xC2)                                    // R10 = pv_h
        mc_b4(c, 0x4C, 0x8B, 0x9C, 0x24); mc_u32(c, 0xD0)             // R11 = sc_buf
        mc_b3(c, 0x4C, 0x89, 0xED); mc_b4(c, 0x48, 0xC1, 0xE5, 3)     // RBP = d*8 (row stride)

        // STEP 1: 4-row QK^T + 5-insn VHADDPD reduce + Y14 max + sc[j] = mx - sc[j]
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 0xE0)             // RAX = &rdata
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x70, 96)  // Y14 = bcast(-1e18)
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0xBC, 0x24); mc_u32(c, 0xA0) // Y15 = bcast(scale)
        mc_b3(c, 0x4C, 0x89, 0xCE)       // RSI = pk_h
        mc_b2(c, 0x31, 0xDB)             // RBX = j = 0
        lp_far_qk4 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE3); jge_far_qk_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x48, 0x8D, 0x3C, 0x2E) // RDI = k1
        mc_b4(c, 0x48, 0x8D, 0x04, 0x2F) // RAX = k2
        mc_b4(c, 0x48, 0x8D, 0x14, 0x28) // RDX = k3
        mc_vex2(c, 0, 1, 1, 0x57, 0xC0); mc_vex2(c, 1, 1, 1, 0x57, 0xC9)
        mc_vex2(c, 2, 1, 1, 0x57, 0xD2); mc_vex2(c, 3, 1, 1, 0x57, 0xDB)
        mc_b2(c, 0x31, 0xC9)
        lp_far_qkd := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x24, 0xC8) // Y4 = qi[m..m+3]
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b2(c, 0x04, 0xCE) // Y0 += Y4*k0
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b2(c, 0x0C, 0xCF) // Y1 += Y4*k1
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b2(c, 0x14, 0xC8) // Y2 += Y4*k2
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b2(c, 0x1C, 0xCA) // Y3 += Y4*k3
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b3(c, 0x4C, 0x39, 0xE9)
        jl_far_qkd := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_far_qkd, lp_far_qkd)
        // 5-insn 4-way reduce Y0..Y3 -> Y0 = [s0, s1, s2, s3] * scale
        mc_vex2(c, 0, 1, 1, 0x7C, 0xC1)
        mc_vex2(c, 2, 1, 1, 0x7C, 0xD3)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x06); mc_b2(c, 0xE2, 0x20)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x06); mc_b2(c, 0xEA, 0x31)
        mc_vex2(c, 4, 1, 1, 0x58, 0xC5)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x59); mc_b1(c, 0xC7)       // VMULPD Y0, Y0, Y15
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x04, 0xDB) // [R11+RBX*8] = Y0
        mc_vex3(c, 1, 0, 0, 1, 0, 14, 1, 1, 0x5F); mc_b1(c, 0xF0)      // VMAXPD Y14, Y14, Y0
        mc_b4(c, 0x48, 0x8D, 0x34, 0x2A) // RSI = RDX + RBP
        mc_b4(c, 0x48, 0x83, 0xC3, 4)
        j_far_qk4 := mc_jmp32(c); mc_patch_rel32(c, j_far_qk4, lp_far_qk4)
        mc_patch_rel32(c, jge_far_qk_dn, buf_len(c))
        // Horizontal max of Y14 -> broadcast mx in Y14
        mc_vex3(c, 1, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xF0, 1)    // VEXTRACTF128 X0, Y14, 1
        mc_vex3(c, 1, 0, 0, 1, 0, 14, 0, 1, 0x5F); mc_b1(c, 0xF0)      // VMAXPD X14, X14, X0
        mc_vex3(c, 0, 0, 1, 1, 0, 14, 0, 1, 0x15); mc_b1(c, 0xC6)      // VUNPCKHPD X0, X14, X14
        mc_vex3(c, 1, 0, 0, 1, 0, 14, 0, 3, 0x5F); mc_b1(c, 0xF0)      // VMAXSD X14, X14, X0
        mc_vex256(c, 2, 14, 0, 14, 0x19)                               // Y14 = bcast(mx)
        // STEP 2: Fused subtract (u = mx - sc[j]) + inline 4-wide AVX2 exp(-u) -> sc[j], sum se in Y5!
        // Save Y14 (mx) into [RSP+0xE8] (1 scalar mx!) so Y6..Y15 can hold all 10 exp constants!
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0xB4, 0x24); mc_u32(c, 0xE8) // [0xE8] = mx
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 0xE0)              // RAX = &rdata (use R14? No, use RDI = &rdata!)
        mc_b3(c, 0x48, 0x89, 0xC7)                                      // RDI = &rdata
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x37)       // Y6  = 50.0
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x7F, 8)    // Y7  = inv_ln2
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x47, 16)   // Y8  = 0.5
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x4F, 24)   // Y9  = ln2
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x59); mc_b2(c, 0x57, 32)   // Y10 = 1023 (i64)
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x5F, 40)   // Y11 = 1.0
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x67, 48)   // Y12 = c3
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x6F, 56)   // Y13 = c4
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x77, 64)   // Y14 = c5
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x7F, 72)   // Y15 = c6
        mc_vex2(c, 5, 1, 1, 0x57, 0xED)                                // Y5  = se = 0.0
        mc_b2(c, 0x31, 0xC9)                                            // RCX = j = 0
        lp_far_exp := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE1); jge_far_exp_dn := mc_jcc32(c, 0x8D)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x84, 0x24); mc_u32(c, 0xE8) // Y0 = bcast(mx)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x5C); mc_b2(c, 0x04, 0xCB) // Y0 = mx - sc[j..j+3] (u)
        mc_vex256(c, 1, 4, 0, 6, 0xC2); mc_b1(c, 2)                    // Y4 = (u <= 50.0)
        mc_vex256(c, 1, 0, 0, 6, 0x5D)                                 // Y0 = min(u, 50.0)
        mc_vex256(c, 1, 1, 0, 7, 0x59)                                 // Y1 = u_c * inv_ln2
        mc_vex256(c, 1, 1, 1, 8, 0x58)                                 // Y1 += 0.5
        mc_vex256(c, 1, 2, 0, 1, 0xE6)                                 // VCVTTPD2DQ X2, Y1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0xE6); mc_b1(c, 0xCA)       // VCVTDQ2PD Y1, X2
        mc_vex256(c, 2, 2, 0, 2, 0x25)                                 // VPMOVSXDQ Y2, X2
        mc_vex256(c, 1, 2, 10, 2, 0xFB)                                // Y2 = 1023 - k64
        mc_vex3(c, 0, 0, 0, 1, 0, 2, 1, 1, 0x73); mc_b2(c, 0xF2, 52)   // Y2 <<= 52 (2^-k)
        mc_vex256(c, 1, 1, 1, 9, 0x59)                                 // Y1 = kf * ln2
        mc_vex256(c, 1, 0, 1, 0, 0x5C)                                 // Y0 = r = kf*ln2 - u_c
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x5F, 88)   // Y3 = c8
        mc_vex256(c, 1, 3, 3, 0, 0x59)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x4F, 80)   // Y1 = c7
        mc_vex256(c, 1, 3, 3, 1, 0x58)
        mc_vex256(c, 1, 3, 3, 0, 0x59); mc_vex256(c, 1, 3, 3, 15, 0x58)
        mc_vex256(c, 1, 3, 3, 0, 0x59); mc_vex256(c, 1, 3, 3, 14, 0x58)
        mc_vex256(c, 1, 3, 3, 0, 0x59); mc_vex256(c, 1, 3, 3, 13, 0x58)
        mc_vex256(c, 1, 3, 3, 0, 0x59); mc_vex256(c, 1, 3, 3, 12, 0x58)
        mc_vex256(c, 1, 3, 3, 0, 0x59); mc_vex256(c, 1, 3, 3, 8,  0x58)
        mc_vex256(c, 1, 3, 3, 0, 0x59); mc_vex256(c, 1, 3, 3, 11, 0x58)
        mc_vex256(c, 1, 3, 3, 0, 0x59); mc_vex256(c, 1, 3, 3, 11, 0x58)
        mc_vex256(c, 1, 3, 2, 3, 0x59)
        mc_vex256(c, 1, 3, 3, 4, 0x54)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x1C, 0xCB) // sc[j..j+3] = Y3
        mc_vex256(c, 1, 5, 5, 3, 0x58)                                 // Y5 += Y3
        mc_b4(c, 0x48, 0x83, 0xC1, 4)
        j_far_exp := mc_jmp32(c); mc_patch_rel32(c, j_far_exp, lp_far_exp)
        mc_patch_rel32(c, jge_far_exp_dn, buf_len(c))
        // Reduce Y5 -> X0 = se, compute X15 = 1.0 / se
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xE9, 1)
        mc_vex2(c, 5, 0, 1, 0x58, 0xC1)
        mc_vex2(c, 0, 0, 1, 0x15, 0xC8)
        mc_vex2(c, 0, 0, 3, 0x58, 0xC1)                                // X0 = se
        mc_vex3(c, 1, 0, 0, 1, 0, 11, 0, 3, 0x5E); mc_b1(c, 0xF8)      // VDIVSD X15, X11 (1.0), X0

        // STEP 3: 8-YMM (32-dim) PV over j=0..seq-1, single inv_se multiply at end!
        mc_vex256(c, 1, 14, 14, 14, 0x57) // Y14 = sum(O)
        mc_b2(c, 0x31, 0xFF)              // RDI = m = 0
        lp_far_pv32 := buf_len(c)
        mc_b4(c, 0x48, 0x8D, 0x47, 32); mc_b3(c, 0x4C, 0x39, 0xE8); jg_far_pv4 := mc_jcc32(c, 0x8F)
        mut yi := 0; while yi < 8 { mc_vex256(c, 1, yi, yi, yi, 0x57); yi += 1 }
        mc_b4(c, 0x49, 0x8D, 0x34, 0xFA) // RSI = pv_h + m*8
        mc_b2(c, 0x31, 0xC9)             // RCX = j = 0
        lp_far_pvj := buf_len(c)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x04, 0xCB) // VBROADCASTSD Y8, [R11+RCX*8] (NO VMULSD in loop!)
        mc_vex3(c, 0, 0, 0, 2, 1, 8, 1, 1, 0xB8); mc_b1(c, 0x06)
        mc_vex3(c, 0, 0, 0, 2, 1, 8, 1, 1, 0xB8); mc_b2(c, 0x4E, 32)
        mc_vex3(c, 0, 0, 0, 2, 1, 8, 1, 1, 0xB8); mc_b2(c, 0x56, 64)
        mc_vex3(c, 0, 0, 0, 2, 1, 8, 1, 1, 0xB8); mc_b2(c, 0x5E, 96)
        mc_vex3(c, 0, 0, 0, 2, 1, 8, 1, 1, 0xB8); mc_b1(c, 0xA6); mc_u32(c, 128)
        mc_vex3(c, 0, 0, 0, 2, 1, 8, 1, 1, 0xB8); mc_b1(c, 0xAE); mc_u32(c, 160)
        mc_vex3(c, 0, 0, 0, 2, 1, 8, 1, 1, 0xB8); mc_b1(c, 0xB6); mc_u32(c, 192)
        mc_vex3(c, 0, 0, 0, 2, 1, 8, 1, 1, 0xB8); mc_b1(c, 0xBE); mc_u32(c, 224)
        mc_b3(c, 0x48, 0x01, 0xEE); mc_b3(c, 0x48, 0xFF, 0xC1); mc_b3(c, 0x4C, 0x39, 0xE1)
        jl_far_pvj := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_far_pvj, lp_far_pvj)
        yi = 0; while yi < 8 { mc_vex256(c, 1, 14, 14, yi, 0x58); yi += 1 }
        mc_b4(c, 0x48, 0x83, 0xC7, 32)
        j_far_pv32 := mc_jmp32(c); mc_patch_rel32(c, j_far_pv32, lp_far_pv32)
        mc_patch_rel32(c, jg_far_pv4, buf_len(c))
        lp_far_pv4 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xEF); jge_far_pv_dn := mc_jcc8(c, 0x7D)
        mc_vex2(c, 0, 1, 1, 0x57, 0xC0)
        mc_b4(c, 0x49, 0x8D, 0x34, 0xFA); mc_b2(c, 0x31, 0xC9)
        lp_far_pv4j := buf_len(c)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x04, 0xCB)
        mc_vex3(c, 0, 0, 0, 2, 1, 8, 1, 1, 0xB8); mc_b1(c, 0x06)
        mc_b3(c, 0x48, 0x01, 0xEE); mc_b3(c, 0x48, 0xFF, 0xC1); mc_b3(c, 0x4C, 0x39, 0xE1)
        jl_far_pv4j := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_far_pv4j, lp_far_pv4j)
        mc_vex256(c, 1, 14, 14, 0, 0x58)
        mc_b4(c, 0x48, 0x83, 0xC7, 4); j_far_pv4 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_far_pv4, lp_far_pv4)
        mc_patch_jcc8(c, jge_far_pv_dn, buf_len(c))
        // Reduce Y14 -> X0, multiply by inv_se (X15), add to [RSP+0xA8]
        _mc_vhsum_pd_to_xmm0(c, 14)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC7) // VMULSD X0, X0, X15
        mc_vex2(c, 0, 0, 3, 0x58, 0x84); mc_b1(c, 0x24); mc_u32(c, 0xA8) // VADDSD X0, X0, [RSP+0xA8]
        mc_vex2(c, 0, 0, 3, 0x11, 0x84); mc_b1(c, 0x24); mc_u32(c, 0xA8) // VMOVSD [RSP+0xA8], X0
        mc_b4(c, 0x48, 0xFF, 0x84, 0x24); mc_u32(c, 0xB0)                // hi++
        j_far_hi := mc_jmp32(c); mc_patch_rel32(c, j_far_hi, lp_far_hi)
        mc_patch_rel32(c, jge_far_hi_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_far_end := mc_jmp32(c)

        // === SSE2 SCALAR FALLBACK (--simd=scalar) ===
        mc_patch_rel32(c, jz_far_sc, buf_len(c))
        mc_patch_rel32(c, jnz_far_sc2, buf_len(c))
        mc_patch_rel32(c, jnz_far_sc3, buf_len(c))
        lp_fars_hi := buf_len(c)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 0xB0)
        mc_b4(c, 0x48, 0x3B, 0x84, 0x24); mc_u32(c, 0xB8); jge_fars_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4C, 0x8B, 0xA4, 0x24); mc_u32(c, 0xC0) // R12 = seq
        mc_b4(c, 0x4C, 0x8B, 0xAC, 0x24); mc_u32(c, 0xC8) // R13 = d
        mc_b2(c, 0x48, 0x99); mc_b3(c, 0x49, 0xF7, 0xFC)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC4); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC5)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xD5)
        mc_b4(c, 0x48, 0x8B, 0xAC, 0x24); mc_u32(c, 0xD8)
        mc_b3(c, 0x4C, 0x8B, 0x45); mc_b1(c, 0)
        mc_b4(c, 0x4C, 0x8B, 0x4D, 8)
        mc_b4(c, 0x4C, 0x8B, 0x55, 16)
        mc_b4(c, 0x48, 0xC1, 0xE0, 3); mc_b4(c, 0x48, 0xC1, 0xE2, 3)
        mc_b3(c, 0x49, 0x01, 0xC0); mc_b3(c, 0x49, 0x01, 0xD0)
        mc_b3(c, 0x49, 0x01, 0xC1); mc_b3(c, 0x49, 0x01, 0xC2)
        mc_b4(c, 0x4C, 0x8B, 0x9C, 0x24); mc_u32(c, 0xD0) // R11 = sc_buf
        mc_b3(c, 0x4C, 0x89, 0xED); mc_b4(c, 0x48, 0xC1, 0xE5, 3) // RBP = d*8
        mc_b4(c, 0x4C, 0x8B, 0xB4, 0x24); mc_u32(c, 0xE0) // R14 = &rdata
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x76, 96) // X14 = -1e18 (mx)
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b2(c, 0xBC, 0x24); mc_u32(c, 0xA0) // X15 = scale
        mc_b3(c, 0x4C, 0x89, 0xCE); mc_b2(c, 0x31, 0xDB) // RSI = pk_h, RBX = j = 0
        lp_fars_qk := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE3); jge_fars_qk_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0); mc_b2(c, 0x31, 0xC9)
        lp_fars_qkd := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE9); jge_fars_qkd := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xC8)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0x0C); mc_b1(c, 0xCE)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_fars_qkd := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_fars_qkd, lp_fars_qkd)
        mc_patch_jcc8(c, jge_fars_qkd, buf_len(c))
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xC7) // MULSD X0, X15
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x04, 0xDB)
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x5F); mc_b1(c, 0xF0) // MAXSD X14, X0
        mc_b3(c, 0x48, 0x01, 0xEE); mc_b3(c, 0x48, 0xFF, 0xC3)
        j_fars_qk := mc_jmp32(c); mc_patch_rel32(c, j_fars_qk, lp_fars_qk)
        mc_patch_rel32(c, jge_fars_qk_dn, buf_len(c))
        // Scalar exp(-(mx - sc[j]))
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) // X0 = se = 0.0
        mc_b2(c, 0x31, 0xC9)
        lp_fars_exp := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE1); jge_fars_exp_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b1(c, 0xCE) // X1 = X14 (mx)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b2(c, 0x0C, 0xCB) // X1 = mx - sc[j]
        mc_b4(c, 0x66, 0x41, 0x0F, 0x2E); mc_b1(c, 0x0E); ja_fars_zero := mc_jcc8(c, 0x77) // X1 > 50.0 -> 0
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xD1); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x56, 8)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x56, 16)
        mc_b4(c, 0xF2, 0x48, 0x0F, 0x2C); mc_b1(c, 0xC2) // RAX = k
        mc_b4(c, 0xF2, 0x48, 0x0F, 0x2A); mc_b1(c, 0xD0) // X2 = kf
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x56, 24)
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xD1)                 // X2 = r
        mc_b1(c, 0xBF); mc_u32(c, 1023); mc_b3(c, 0x48, 0x29, 0xC7); mc_b4(c, 0x48, 0xC1, 0xE7, 52)
        mc_b4(c, 0x66, 0x48, 0x0F, 0x6E); mc_b1(c, 0xCF) // X1 = 2^-k
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x5E, 88)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xDA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x5E, 80)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xDA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x5E, 72)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xDA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x5E, 64)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xDA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x5E, 56)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xDA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x5E, 48)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xDA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x5E, 16)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xDA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x5E, 40)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xDA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x5E, 40)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xD9) // X3 = 2^-k * p
        jmp_fars_st := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, ja_fars_zero, buf_len(c))
        mc_b4(c, 0x66, 0x0F, 0x57, 0xDB)
        mc_patch_jcc8(c, jmp_fars_st, buf_len(c))
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x1C, 0xCB)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC3)
        mc_b3(c, 0x48, 0xFF, 0xC1)
        j_fars_exp := mc_jmp32(c); mc_patch_rel32(c, j_fars_exp, lp_fars_exp)
        mc_patch_rel32(c, jge_fars_exp_dn, buf_len(c))
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x7E, 40) // X15 = 1.0
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x5E); mc_b1(c, 0xF8)     // X15 = 1.0 / se
        // Scalar PV
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) // X0 = sum(O)
        mc_b3(c, 0x4C, 0x89, 0xD6); mc_b2(c, 0x31, 0xDB) // RSI = pv_h, RBX = j = 0
        lp_fars_pvj := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE3); jge_fars_pv_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xDB) // X1 = sc[j]
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xCF)       // X1 *= inv_se
        mc_b2(c, 0x31, 0xC9)
        lp_fars_pvm := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE9); jge_fars_pvm := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x14); mc_b1(c, 0xCE)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xD1); mc_b4(c, 0xF2, 0x0F, 0x58, 0xC2)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_fars_pvm := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_fars_pvm, lp_fars_pvm)
        mc_patch_jcc8(c, jge_fars_pvm, buf_len(c))
        mc_b3(c, 0x48, 0x01, 0xEE); mc_b3(c, 0x48, 0xFF, 0xC3)
        j_fars_pvj := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_fars_pvj, lp_fars_pvj)
        mc_patch_jcc8(c, jge_fars_pv_dn, buf_len(c))
        mc_b4(c, 0xF2, 0x0F, 0x58, 0x84); mc_b1(c, 0x24); mc_u32(c, 0xA8)
        mc_b4(c, 0xF2, 0x0F, 0x11, 0x84); mc_b1(c, 0x24); mc_u32(c, 0xA8)
        mc_b4(c, 0x48, 0xFF, 0x84, 0x24); mc_u32(c, 0xB0)
        j_fars_hi := mc_jmp32(c); mc_patch_rel32(c, j_fars_hi, lp_fars_hi)
        mc_patch_rel32(c, jge_fars_dn, buf_len(c))

        mc_patch_rel32(c, jmp_far_end, buf_len(c))
        mc_patch_rel32(c, jge_far_dn, buf_len(c))
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 0xA8) // RAX = acc (already f64 bits!)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0x148)
        cg_reg_helper(cg, h_ai_flash_attn_rows_f64(), s_far, buf_len(c))
    }



}


fn emit_ai_wave3c2b_helpers(cg: CodegenCtx) {
    c := cg.code

    // 29. `h_ai_nbody_force_f64(px, py, pz, vx, vy, vz, pm, n_i0_i1) -> i64`
    // Parallelizable 4-wide AVX2+FMA3 force kernel: n=(arg7>>32), i0=(arg7>>16)&0xFFFF, i1=arg7&0xFFFF
    if cg_is_helper_used(cg, h_ai_nbody_force_f64()) {
        while (buf_len(cg.rdata) & 15) != 0 { buf_push(cg.rdata, 0) }
        roff_nbf := buf_len(cg.rdata)
        buf_push_u64(cg.rdata, 0x3F847AE147AE147B) // +0: 0.01 (softening & dt)
        buf_push_u64(cg.rdata, 0x3FF0000000000000) // +8: 1.0
        buf_push_u64(cg.rdata, 0); buf_push_u64(cg.rdata, 0) // pad to +32
        mut nrk := 0
        while nrk < 4 { buf_push_u64(cg.rdata, 0x3FE0000000000000); nrk += 1 } // +32: 0.5 x4
        nrk = 0; while nrk < 4 { buf_push_u64(cg.rdata, 0x3FF8000000000000); nrk += 1 } // +64: 1.5 x4

        mc_align16(c)
        s_nbf := buf_len(c)
        mc_ai_enter(c, 0xF8)
        _mc_save_xmm6_15_rsp(c, 0)
        // [RSP+160..215] = px, py, pz, vx, vy, vz, pm
        mut ai := 0
        while ai < 7 {
            mc_b4(c, 0x48, 0x8B, 0x41, ai * 8)
            mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 160 + ai * 8)
            ai += 1
        }
        mc_b4(c, 0x48, 0x8B, 0x41, 56) // RAX = (n<<32)|(i0<<16)|i1
        mc_b3(c, 0x49, 0x89, 0xC6); mc_b3(c, 0x49, 0x81, 0xE6); mc_u32(c, 0xFFFF) // R14 = i1
        mc_b3(c, 0x48, 0x89, 0xC7); mc_b4(c, 0x48, 0xC1, 0xEF, 16); mc_b3(c, 0x48, 0x81, 0xE7); mc_u32(c, 0xFFFF) // RDI = i0
        mc_b4(c, 0x48, 0xC1, 0xE8, 32); mc_b3(c, 0x49, 0x89, 0xC7) // R15 = n
        mc_b4(c, 0x4C, 0x8B, 0x84, 0x24); mc_u32(c, 160) // R8 = px
        mc_b4(c, 0x4C, 0x8B, 0x8C, 0x24); mc_u32(c, 168) // R9 = py
        mc_b4(c, 0x4C, 0x8B, 0x94, 0x24); mc_u32(c, 176) // R10 = pz
        mc_b4(c, 0x4C, 0x8B, 0x9C, 0x24); mc_u32(c, 208) // R11 = pm
        cg_lea_rax_rdata(cg, roff_nbf); mc_b3(c, 0x49, 0x89, 0xC5) // R13 = &consts
        mc_b3(c, 0x4C, 0x39, 0xF7); jge_nbf_dn := mc_jcc32(c, 0x8D)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_nbf_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x41, 0xF6, 0xC7, 3); jnz_nbf_sc2 := mc_jcc32(c, 0x85)

        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x7D, 0) // Y15 = 0.01
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x75, 8) // Y14 = 1.0
        // 2-body interleaved outer loop (i, i+1) overlapping 2x VSQRTPD + 2x VDIVPD!
        // Uses Y8..Y10 = accA (fx,fy,fz), Y11..Y13 = accB (fx,fy,fz), stack [RSP+224..415]? No, broadcast directly from [R8+RDI*8] / [R8+RDI*8+8]!
        // 1-body x 8-neighbor TRUE INTERLEAVED VRSQRTPS + 2x NR FMA3 (saturates BOTH Port 0 & Port 1!)
        mc_b4(c, 0x41, 0xF6, 0xC7, 7); jge_nbfi_1 := mc_jcc32(c, 0x85) // if (n & 7) != 0 -> fallback 4-wide loop
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x65, 64)   // Y12 = 1.5 x4 (in reg, zero mem load!)
        mc_align16_nop(c)
        lp_nbf_i8 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xF7); jge_nbfi8_dn := mc_jcc32(c, 0x8D)
        mc_vex256(c, 1, 13, 13, 13, 0x57) // Y13 = ax = 0
        mc_vex256(c, 1, 14, 14, 14, 0x57) // Y14 = ay = 0
        mc_vex256(c, 1, 15, 15, 15, 0x57) // Y15 = az = 0
        mc_b2(c, 0x31, 0xC9)              // RCX = j = 0
        lp_nbf_j8 := buf_len(c)
        // dxA = px[j..j+3] - xi, dxB = px[j+4..j+7] - xi
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x34, 0xF8)       // Y6 = bcast(px[i])
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xC8)       // Y0 = px[j]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x5C, 0xC8, 32)   // Y3 = px[j+4]
        mc_vex256(c, 1, 0, 0, 6, 0x5C); mc_vex256(c, 1, 3, 3, 6, 0x5C)
        // dyA, dyB
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x34, 0xF9)       // Y6 = bcast(py[i])
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x0C, 0xC9)       // Y1 = py[j]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x64, 0xC9, 32)   // Y4 = py[j+4]
        mc_vex256(c, 1, 1, 1, 6, 0x5C); mc_vex256(c, 1, 4, 4, 6, 0x5C)
        // dzA, dzB
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x34, 0xFA)       // Y6 = bcast(pz[i])
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x14, 0xCA)       // Y2 = pz[j]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x6C, 0xCA, 32)   // Y5 = pz[j+4]
        mc_vex256(c, 1, 2, 2, 6, 0x5C); mc_vex256(c, 1, 5, 5, 6, 0x5C)
        // r2A = dxA^2 + dyA^2 + dzA^2 + 0.01, r2B = dxB^2 + dyB^2 + dzB^2 + 0.01
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x45, 0)          // Y8 = 0.01 x4
        mc_vex256(c, 1, 6, 0, 0, 0x59); mc_vex256(c, 1, 7, 3, 3, 0x59)
        mc_vex256(c, 1, 6, 6, 8, 0x58); mc_vex256(c, 1, 7, 7, 8, 0x58)
        mc_vex3(c, 0, 0, 0, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xF1)             // VFMADD231PD Y6, Y1, Y1
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b1(c, 0xFC)             // VFMADD231PD Y7, Y4, Y4
        mc_vex3(c, 0, 0, 0, 2, 1, 2, 1, 1, 0xB8); mc_b1(c, 0xF2)             // VFMADD231PD Y6, Y2, Y2
        mc_vex3(c, 0, 0, 0, 2, 1, 5, 1, 1, 0xB8); mc_b1(c, 0xFD)             // VFMADD231PD Y7, Y5, Y5
        // Interleaved VRSQRTPS + 2x Newton-Raphson FMA3 (46-bit precision, 2-port saturated!)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x5A); mc_b1(c, 0xC6)             // VCVTPD2PS X8, Y6
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x5A); mc_b1(c, 0xCF)             // VCVTPD2PS X9, Y7
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 0, 0, 0x52); mc_b1(c, 0xC0)             // VRSQRTPS X8, X8
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 0, 0, 0x52); mc_b1(c, 0xC9)             // VRSQRTPS X9, X9
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b1(c, 0xC0)             // VCVTPS2PD Y8, X8
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b1(c, 0xC9)             // VCVTPS2PD Y9, X9
        mc_vex3(c, 0, 0, 1, 1, 0, 6, 1, 1, 0x59); mc_b2(c, 0x75, 32)         // Y6 = 0.5 * r2A
        mc_vex3(c, 0, 0, 1, 1, 0, 7, 1, 1, 0x59); mc_b2(c, 0x7D, 32)         // Y7 = 0.5 * r2B
        // NR1 interleaved
        mc_vex256(c, 1, 10, 8, 8, 0x59); mc_vex256(c, 1, 11, 9, 9, 0x59)
        mc_vex3(c, 1, 0, 1, 2, 1, 6, 1, 1, 0xAC); mc_b1(c, 0xD4)             // Y10 = 1.5 - hA*yA^2
        mc_vex3(c, 1, 0, 1, 2, 1, 7, 1, 1, 0xAC); mc_b1(c, 0xDC)             // Y11 = 1.5 - hB*yB^2
        mc_vex256(c, 1, 8, 8, 10, 0x59); mc_vex256(c, 1, 9, 9, 11, 0x59)
        // NR2 interleaved
        mc_vex256(c, 1, 10, 8, 8, 0x59); mc_vex256(c, 1, 11, 9, 9, 0x59)
        mc_vex3(c, 1, 0, 1, 2, 1, 6, 1, 1, 0xAC); mc_b1(c, 0xD4)
        mc_vex3(c, 1, 0, 1, 2, 1, 7, 1, 1, 0xAC); mc_b1(c, 0xDC)
        mc_vex256(c, 1, 8, 8, 10, 0x59); mc_vex256(c, 1, 9, 9, 11, 0x59)
        // fA = yA^3 * pm[j], fB = yB^3 * pm[j+4]
        mc_vex256(c, 1, 6, 8, 8, 0x59); mc_vex256(c, 1, 7, 9, 9, 0x59)
        mc_vex256(c, 1, 6, 6, 8, 0x59); mc_vex256(c, 1, 7, 7, 9, 0x59)
        mc_vex3(c, 0, 0, 1, 1, 0, 6, 1, 1, 0x59); mc_b2(c, 0x34, 0xCB)       // Y6 *= pm[j]
        mc_vex3(c, 0, 0, 1, 1, 0, 7, 1, 1, 0x59); mc_b3(c, 0x7C, 0xCB, 32)   // Y7 *= pm[j+4]
        // Accumulate ax, ay, az
        mc_vex3(c, 1, 0, 0, 2, 1, 0, 1, 1, 0xB8); mc_b1(c, 0xEE)             // Y13 += Y0*Y6
        mc_vex3(c, 1, 0, 0, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xF6)             // Y14 += Y1*Y6
        mc_vex3(c, 1, 0, 0, 2, 1, 2, 1, 1, 0xB8); mc_b1(c, 0xFE)             // Y15 += Y2*Y6
        mc_vex3(c, 1, 0, 0, 2, 1, 3, 1, 1, 0xB8); mc_b1(c, 0xEF)             // Y13 += Y3*Y7
        mc_vex3(c, 1, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b1(c, 0xF7)             // Y14 += Y4*Y7
        mc_vex3(c, 1, 0, 0, 2, 1, 5, 1, 1, 0xB8); mc_b1(c, 0xFF)             // Y15 += Y5*Y7
        mc_b4(c, 0x48, 0x83, 0xC1, 8); mc_b3(c, 0x4C, 0x39, 0xF9)
        jl_nbfj8 := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_nbfj8, lp_nbf_j8)
        // Store vx[i] += hsum(Y13)*dt, vy[i] += hsum(Y14)*dt, vz[i] += hsum(Y15)*dt
        _mc_vhsum_pd_to_xmm0(c, 13)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x59); mc_b2(c, 0x45, 0)          // X0 *= dt ([R13+0])
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 184)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x04, 0xF8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xF8)
        _mc_vhsum_pd_to_xmm0(c, 14)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x59); mc_b2(c, 0x45, 0)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 192)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x04, 0xF8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xF8)
        _mc_vhsum_pd_to_xmm0(c, 15)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x59); mc_b2(c, 0x45, 0)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 200)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x04, 0xF8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xF8)
        mc_b3(c, 0x48, 0xFF, 0xC7)
        j_nbfi8 := mc_jmp32(c); mc_patch_rel32(c, j_nbfi8, lp_nbf_i8)
        mc_patch_rel32(c, jge_nbfi8_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_nbf_end8 := mc_jmp32(c)

        // Odd body tail (1 body if (i1-i0) is odd)
        mc_patch_rel32(c, jge_nbfi_1, buf_len(c))
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x75, 8) // reload Y14 = 1.0
        lp_nbf_i := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xF7); jge_nbfi_dn := mc_jcc32(c, 0x8D)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x04, 0xF8)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x0C, 0xF9)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x14, 0xFA)
        mc_vex256(c, 1, 11, 11, 11, 0x57); mc_vex256(c, 1, 12, 12, 12, 0x57); mc_vex256(c, 1, 13, 13, 13, 0x57)
        mc_b2(c, 0x31, 0xC9)
        lp_nbf_j := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xC8)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x0C, 0xC9)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x14, 0xCA)
        mc_vex256(c, 1, 0, 0, 8, 0x5C); mc_vex256(c, 1, 1, 1, 9, 0x5C); mc_vex256(c, 1, 2, 2, 10, 0x5C)
        mc_vex256(c, 1, 3, 0, 0, 0x59); mc_vex256(c, 1, 3, 3, 15, 0x58)
        mc_vex3(c, 0, 0, 0, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xD9)
        mc_vex3(c, 0, 0, 0, 2, 1, 2, 1, 1, 0xB8); mc_b1(c, 0xDA)
        mc_vex256(c, 1, 4, 0, 3, 0x51); mc_vex256(c, 1, 4, 3, 4, 0x59); mc_vex256(c, 1, 4, 14, 4, 0x5E)
        mc_vex3(c, 0, 0, 1, 1, 0, 4, 1, 1, 0x59); mc_b2(c, 0x24, 0xCB)
        mc_vex3(c, 1, 0, 0, 2, 1, 0, 1, 1, 0xB8); mc_b1(c, 0xDC)
        mc_vex3(c, 1, 0, 0, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xE4)
        mc_vex3(c, 1, 0, 0, 2, 1, 2, 1, 1, 0xB8); mc_b1(c, 0xEC)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b3(c, 0x4C, 0x39, 0xF9)
        jl_nbfj := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_nbfj, lp_nbf_j)
        _mc_vhsum_pd_to_xmm0(c, 11); mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC7)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 184)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x04, 0xF8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xF8)
        _mc_vhsum_pd_to_xmm0(c, 12); mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC7)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 192)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x04, 0xF8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xF8)
        _mc_vhsum_pd_to_xmm0(c, 13); mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC7)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 200)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x04, 0xF8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xF8)
        mc_b3(c, 0x48, 0xFF, 0xC7)
        j_nbfi := mc_jmp32(c); mc_patch_rel32(c, j_nbfi, lp_nbf_i)
        mc_patch_rel32(c, jge_nbfi_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_nbf_end := mc_jmp32(c)

        // Scalar fallback
        mc_patch_rel32(c, jz_nbf_sc, buf_len(c))
        mc_patch_rel32(c, jnz_nbf_sc2, buf_len(c))
        lp_nbfs_i := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xF7); jge_nbfsi := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x04, 0xF8)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x0C, 0xF9)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x14, 0xFA)
        mc_b4(c, 0x66, 0x45, 0x0F, 0x57); mc_b1(c, 0xDB)
        mc_b4(c, 0x66, 0x45, 0x0F, 0x57); mc_b1(c, 0xE4)
        mc_b4(c, 0x66, 0x45, 0x0F, 0x57); mc_b1(c, 0xED)
        mc_b2(c, 0x31, 0xC9)
        lp_nbfs_j := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xF9); jge_nbfsj := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x04, 0xC8); mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b1(c, 0xC0)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xC9); mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b1(c, 0xC9)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x14, 0xCA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b1(c, 0xD2)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xD8); mc_b4(c, 0xF2, 0x0F, 0x59, 0xDB)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xE1); mc_b4(c, 0xF2, 0x0F, 0x59, 0xE4); mc_b4(c, 0xF2, 0x0F, 0x58, 0xDC)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xEA); mc_b4(c, 0xF2, 0x0F, 0x59, 0xED); mc_b4(c, 0xF2, 0x0F, 0x58, 0xDD)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x5D, 0)
        mc_b4(c, 0xF2, 0x0F, 0x51, 0xE3); mc_b4(c, 0xF2, 0x0F, 0x59, 0xE3)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x6D, 8); mc_b4(c, 0xF2, 0x0F, 0x5E, 0xEC)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x2C, 0xCB)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xC5); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xD8)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xCD); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xE1)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xD5); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xEA)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_nbfsj := mc_jmp32(c); mc_patch_rel32(c, j_nbfsj, lp_nbfs_j)
        mc_patch_rel32(c, jge_nbfsj, buf_len(c))
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 184)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b2(c, 0x5D, 0); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b2(c, 0x1C, 0xF8); mc_b4(c, 0xF2, 0x44, 0x0F, 0x11); mc_b2(c, 0x1C, 0xF8)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 192)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b2(c, 0x65, 0); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b2(c, 0x24, 0xF8); mc_b4(c, 0xF2, 0x44, 0x0F, 0x11); mc_b2(c, 0x24, 0xF8)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 200)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x59); mc_b2(c, 0x6D, 0); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b2(c, 0x2C, 0xF8); mc_b4(c, 0xF2, 0x44, 0x0F, 0x11); mc_b2(c, 0x2C, 0xF8)
        mc_b3(c, 0x48, 0xFF, 0xC7); j_nbfsi := mc_jmp32(c); mc_patch_rel32(c, j_nbfsi, lp_nbfs_i)
        mc_patch_rel32(c, jge_nbfsi, buf_len(c))

        mc_patch_rel32(c, jmp_nbf_end8, buf_len(c))
        mc_patch_rel32(c, jmp_nbf_end, buf_len(c))
        mc_patch_rel32(c, jge_nbf_dn, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xF8)
        cg_reg_helper(cg, h_ai_nbody_force_f64(), s_nbf, buf_len(c))
    }

    // 30. `h_ai_radix_bsort_i64(src, dst, bn, shift) -> i64`: Zero-spill local 64-bucket (6-bit) MSD + register isort!
    if cg_is_helper_used(cg, h_ai_radix_bsort_i64()) {
        mc_align16(c)
        s_rbs := buf_len(c)
        mc_ai_enter(c, 0x418) // [RSP+0..511]=lh[64], [RSP+512..1023]=lo[64]
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = src
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = dst
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = bn
        mc_b4(c, 0x48, 0x8B, 0x49, 24)   // RCX = shift (CL)
        mc_b4(c, 0x49, 0x83, 0xFA, 1); jl_rbs_dn := mc_jcc32(c, 0x8C)
        je_rbs_one := mc_jcc32(c, 0x84)
        mc_b4(c, 0x49, 0x83, 0xFA, 48); jle_rbs_small := mc_jcc32(c, 0x8E)

        // Zero lh[0..63] on stack (4x unrolled = 16 iters!)
        mc_b2(c, 0x31, 0xC0); mc_b2(c, 0x31, 0xD2)
        lp_rbs_z := buf_len(c)
        mc_b4(c, 0x48, 0x89, 0x04, 0xD4)
        mc_b4(c, 0x48, 0x89, 0x44, 0xD4); mc_b1(c, 8)
        mc_b4(c, 0x48, 0x89, 0x44, 0xD4); mc_b1(c, 16)
        mc_b4(c, 0x48, 0x89, 0x44, 0xD4); mc_b1(c, 24)
        mc_b4(c, 0x48, 0x83, 0xC2, 4); mc_b4(c, 0x48, 0x83, 0xFA, 64)
        jl_rbs_z := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_rbs_z, lp_rbs_z)
        // Histogram: sb = (src[k] >> cl) & 63
        mc_b2(c, 0x31, 0xD2) // RDX = k = 0
        lp_rbs_h := buf_len(c)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xD0) // RAX = src[k]
        mc_b3(c, 0x48, 0xD3, 0xE8)       // SHR RAX, CL
        mc_b4(c, 0x48, 0x83, 0xE0, 63)   // AND RAX, 63
        mc_b4(c, 0x48, 0xFF, 0x04, 0xC4) // INC QWORD [RSP + RAX*8]
        mc_b3(c, 0x48, 0xFF, 0xC2); mc_b3(c, 0x4C, 0x39, 0xD2)
        jl_rbs_h := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_rbs_h, lp_rbs_h)
        // Prefix sum lh[0..63] -> lo[0..63]
        mc_b2(c, 0x31, 0xF6); mc_b2(c, 0x31, 0xD2) // RSI=psum=0, RDX=sb=0
        lp_rbs_p := buf_len(c)
        mc_b4(c, 0x48, 0x8B, 0x04, 0xD4) // RAX = lh[sb]
        mc_b4(c, 0x48, 0x89, 0x34, 0xD4) // lh[sb] = psum
        mc_b4(c, 0x48, 0x89, 0xB4, 0xD4); mc_u32(c, 512) // lo[sb] = psum
        mc_b3(c, 0x48, 0x01, 0xC6)       // psum += cnt
        mc_b3(c, 0x48, 0xFF, 0xC2); mc_b4(c, 0x48, 0x83, 0xFA, 64)
        jl_rbs_p := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_rbs_p, lp_rbs_p)
        // Scatter src -> dst
        mc_b2(c, 0x31, 0xD2)
        lp_rbs_s := buf_len(c)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xD0) // RAX = v = src[k]
        mc_b3(c, 0x48, 0x89, 0xC3); mc_b3(c, 0x48, 0xD3, 0xEB); mc_b4(c, 0x48, 0x83, 0xE3, 63) // RBX = sb
        mc_b4(c, 0x48, 0x8B, 0x34, 0xDC) // RSI = pos = lh[sb]
        mc_b4(c, 0x49, 0x89, 0x04, 0xF1) // dst[pos] = v
        mc_b4(c, 0x48, 0xFF, 0x04, 0xDC) // lh[sb]++
        mc_b3(c, 0x48, 0xFF, 0xC2); mc_b3(c, 0x4C, 0x39, 0xD2)
        jl_rbs_s := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_rbs_s, lp_rbs_s)
        // Pure-register insertion sort on each of 64 tiny sub-buckets [lo[sb] .. lh[sb]) in dst
        mc_b3(c, 0x45, 0x31, 0xDB) // R11 = sb = 0
        lp_rbs_sb := buf_len(c)
        mc_b4(c, 0x49, 0x83, 0xFB, 64); jge_rbs_dn2 := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4A, 0x8B, 0xB4, 0xDC); mc_u32(c, 512) // RSI = s0 = lo[sb]
        mc_b4(c, 0x4A, 0x8B, 0x3C, 0xDC)                 // RDI = s1 = lh[sb]
        mc_b4(c, 0x48, 0x8D, 0x56, 1)                    // RDX = i = s0 + 1
        lp_rbs_ii := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xFA); jge_rbs_sb_nx := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xD1) // RAX = key = dst[i]
        mc_b4(c, 0x48, 0x8D, 0x5A, 0xFF) // RBX = j = i - 1
        lp_rbs_ij := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xF3); jl_rbs_ins := mc_jcc8(c, 0x7C)
        mc_b4(c, 0x4D, 0x8B, 0x24, 0xD9) // R12 = dst[j]
        mc_b3(c, 0x4C, 0x39, 0xE0); jge_rbs_ins := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x4D, 0x89, 0x64, 0xD9); mc_b1(c, 8)
        mc_b3(c, 0x48, 0xFF, 0xCB); j_rbs_ij := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rbs_ij, lp_rbs_ij)
        mc_patch_jcc8(c, jl_rbs_ins, buf_len(c))
        mc_patch_jcc8(c, jge_rbs_ins, buf_len(c))
        mc_b4(c, 0x49, 0x89, 0x44, 0xD9); mc_b1(c, 8)
        mc_b3(c, 0x48, 0xFF, 0xC2); j_rbs_ii := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rbs_ii, lp_rbs_ii)
        mc_patch_jcc8(c, jge_rbs_sb_nx, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC3); j_rbs_sb := mc_jmp32(c); mc_patch_rel32(c, j_rbs_sb, lp_rbs_sb)

        // Small (2..48): copy src -> dst + isort
        mc_patch_rel32(c, jle_rbs_small, buf_len(c))
        mc_b2(c, 0x31, 0xD2)
        lp_rbs_cp := buf_len(c)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xD0); mc_b4(c, 0x49, 0x89, 0x04, 0xD1)
        mc_b3(c, 0x48, 0xFF, 0xC2); mc_b3(c, 0x4C, 0x39, 0xD2)
        jl_rbs_cp := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_rbs_cp, lp_rbs_cp)
        mc_b2(c, 0x31, 0xF6); mc_b3(c, 0x4C, 0x89, 0xD7); mc_b1(c, 0xBA); mc_u32(c, 1)
        lp_rbs_sii := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xFA); jge_rbs_sdn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xD1); mc_b4(c, 0x48, 0x8D, 0x5A, 0xFF)
        lp_rbs_sij := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xF3); jl_rbs_sins := mc_jcc8(c, 0x7C)
        mc_b4(c, 0x4D, 0x8B, 0x24, 0xD9); mc_b3(c, 0x4C, 0x39, 0xE0); jge_rbs_sins := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x4D, 0x89, 0x64, 0xD9); mc_b1(c, 8)
        mc_b3(c, 0x48, 0xFF, 0xCB); j_rbs_sij := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rbs_sij, lp_rbs_sij)
        mc_patch_jcc8(c, jl_rbs_sins, buf_len(c)); mc_patch_jcc8(c, jge_rbs_sins, buf_len(c))
        mc_b4(c, 0x49, 0x89, 0x44, 0xD9); mc_b1(c, 8)
        mc_b3(c, 0x48, 0xFF, 0xC2); j_rbs_sii := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rbs_sii, lp_rbs_sii)
        mc_patch_jcc8(c, jge_rbs_sdn, buf_len(c))
        jmp_rbs_end := mc_jmp32(c)

        mc_patch_rel32(c, je_rbs_one, buf_len(c))
        mc_b3(c, 0x49, 0x8B, 0x00); mc_b3(c, 0x49, 0x89, 0x01)

        mc_patch_rel32(c, jmp_rbs_end, buf_len(c))
        mc_patch_rel32(c, jge_rbs_dn2, buf_len(c))
        mc_patch_rel32(c, jl_rbs_dn, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_ai_leave(c, 0x418)
        cg_reg_helper(cg, h_ai_radix_bsort_i64(), s_rbs, buf_len(c))
    }

    // 31. `h_ai_radix_scat16_i64(arr, dst, offs, i0, i1) -> i64`: 16x64B L1D software write-combining AVX2 scatter!
    if cg_is_helper_used(cg, h_ai_radix_scat16_i64()) {
        mc_align16(c)
        s_rs16 := buf_len(c)
        mc_ai_enter(c, 0x558)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = arr
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = dst (0 -> Mode A 4-bank hist!)
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = off[16]
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = i = i0
        mc_b4(c, 0x4C, 0x8B, 0x61, 32)   // R12 = i1
        mc_b4(c, 0x48, 0x8D, 0x6C, 0x24); mc_b1(c, 63)
        mc_b4(c, 0x48, 0x83, 0xE5, 0xC0) // RBP = (RSP + 63) & -64
        mc_b3(c, 0x4D, 0x39, 0xE3); jge_rs16_dn := mc_jcc32(c, 0x8D)

        mc_b3(c, 0x4D, 0x85, 0xC9); jnz_rs16_scat := mc_jcc32(c, 0x85)
        // Mode A: dst == 0 -> Pure-register 4-bank histogram into off[0..15]
        mc_b2(c, 0x31, 0xC0); mc_b2(c, 0x31, 0xC9)
        lp_rhz := buf_len(c)
        mc_b4(c, 0x48, 0x89, 0x44, 0xCD); mc_b1(c, 0)
        mc_b3(c, 0x48, 0xFF, 0xC1); mc_b4(c, 0x48, 0x83, 0xF9, 64)
        jl_rhz := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_rhz, lp_rhz)
        mc_b4(c, 0x4D, 0x8D, 0x6C, 0x24); mc_b1(c, 0xFC) // R13 = i1 - 4
        mc_align16_nop(c)
        lp_rh4 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xEB); jg_rh1 := mc_jcc8(c, 0x7F)
        mc_b4(c, 0x4B, 0x8B, 0x04, 0xD8); mc_b3(c, 0x83, 0xE0, 15)
        mc_b4(c, 0x4B, 0x8B, 0x54, 0xD8); mc_b1(c, 8);  mc_b3(c, 0x83, 0xE2, 15)
        mc_b4(c, 0x4B, 0x8B, 0x74, 0xD8); mc_b1(c, 16); mc_b3(c, 0x83, 0xE6, 15)
        mc_b4(c, 0x4B, 0x8B, 0x7C, 0xD8); mc_b1(c, 24); mc_b3(c, 0x83, 0xE7, 15)
        mc_b4(c, 0x48, 0xFF, 0x44, 0xC5); mc_b1(c, 0)
        mc_b4(c, 0x48, 0xFF, 0x84, 0xD5); mc_u32(c, 128)
        mc_b4(c, 0x48, 0xFF, 0x84, 0xF5); mc_u32(c, 256)
        mc_b4(c, 0x48, 0xFF, 0x84, 0xFD); mc_u32(c, 384)
        mc_b4(c, 0x49, 0x83, 0xC3, 4); j_rh4 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rh4, lp_rh4)
        mc_patch_jcc8(c, jg_rh1, buf_len(c))
        lp_rh1 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xE3); jge_rh_sum := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x4B, 0x8B, 0x04, 0xD8); mc_b3(c, 0x83, 0xE0, 15)
        mc_b4(c, 0x48, 0xFF, 0x44, 0xC5); mc_b1(c, 0)
        mc_b3(c, 0x49, 0xFF, 0xC3); j_rh1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rh1, lp_rh1)
        mc_patch_jcc8(c, jge_rh_sum, buf_len(c))
        mc_b2(c, 0x31, 0xC9)
        lp_rh_m := buf_len(c)
        mc_b4(c, 0x48, 0x8B, 0x44, 0xCD); mc_b1(c, 0)
        mc_b4(c, 0x48, 0x03, 0x84, 0xCD); mc_u32(c, 128)
        mc_b4(c, 0x48, 0x03, 0x84, 0xCD); mc_u32(c, 256)
        mc_b4(c, 0x48, 0x03, 0x84, 0xCD); mc_u32(c, 384)
        mc_b4(c, 0x49, 0x89, 0x04, 0xCA)
        mc_b3(c, 0x48, 0xFF, 0xC1); mc_b4(c, 0x48, 0x83, 0xF9, 16)
        jl_rh_m := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_rh_m, lp_rh_m)
        jmp_rs16_endA := mc_jmp32(c)

        // Mode B: dst != 0 -> Branchless 16x64B Write-Combining VMOVNTDQ (slot = pos & 7, 9 insts/elem!)
        mc_patch_rel32(c, jnz_rs16_scat, buf_len(c))
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_rs16_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x41, 0xF6, 0xC1, 63); jnz_rs16_sc2 := mc_jcc32(c, 0x85)

        // [RBP+0..1023]=wc[16][8], [RBP+1024..1151]=orig_off[16], [RBP+1152..1279]=loc_off[16]
        mc_b2(c, 0x31, 0xC9)
        lp_rw_init := buf_len(c)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xCA)
        mc_b4(c, 0x48, 0x89, 0x84, 0xCD); mc_u32(c, 1024) // orig_off[k] = off[k]
        mc_b4(c, 0x48, 0x89, 0x84, 0xCD); mc_u32(c, 1152) // loc_off[k] = off[k]
        mc_b3(c, 0x48, 0xFF, 0xC1); mc_b4(c, 0x48, 0x83, 0xF9, 16)
        jl_rw_init := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_rw_init, lp_rw_init)

        mc_align16_nop(c)
        lp_rw := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xE3); jge_rw_fl := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4B, 0x8B, 0x04, 0xD8)                   // RAX = v = arr[i]
        mc_b3(c, 0x48, 0x89, 0xC3); mc_b3(c, 0x83, 0xE3, 15) // RBX = b = v & 15
        mc_b4(c, 0x48, 0x8B, 0xB4, 0xDD); mc_u32(c, 1152)  // RSI = pos = loc_off[b]
        mc_b4(c, 0x48, 0x8D, 0x56, 1)
        mc_b4(c, 0x48, 0x89, 0x94, 0xDD); mc_u32(c, 1152)  // loc_off[b] = pos + 1
        mc_b3(c, 0x48, 0x89, 0xF1); mc_b3(c, 0x83, 0xE1, 7) // RCX = slot = pos & 7
        mc_b3(c, 0x48, 0x89, 0xDF); mc_b4(c, 0x48, 0xC1, 0xE7, 6); mc_b3(c, 0x48, 0x01, 0xEF) // RDI = &wc[b][0]
        mc_b4(c, 0x48, 0x89, 0x04, 0xCF)                   // wc[b][slot] = v
        mc_b3(c, 0x83, 0xF9, 7); je_rw_flush := mc_jcc8(c, 0x74)
        mc_b3(c, 0x49, 0xFF, 0xC3); j_rw_n1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rw_n1, lp_rw)

        mc_patch_jcc8(c, je_rw_flush, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xEE, 7)                      // RSI = line_start = pos - 7 (multiple of 8!)
        mc_b4(c, 0x48, 0x3B, 0xB4, 0xDD); mc_u32(c, 1024); jl_rw_pfx := mc_jcc8(c, 0x7C) // rare first partial line!
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x6F); mc_b1(c, 0x07)           // VMOVDQA Y0, [RDI]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x6F); mc_b2(c, 0x4F, 32)       // VMOVDQA Y1, [RDI+32]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0xE7); mc_b2(c, 0x04, 0xF1)     // VMOVNTDQ [R9+RSI*8], Y0
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0xE7); mc_b3(c, 0x4C, 0xF1, 32) // VMOVNTDQ [R9+RSI*8+32], Y1
        mc_b3(c, 0x49, 0xFF, 0xC3); j_rw_n2 := mc_jmp32(c); mc_patch_rel32(c, j_rw_n2, lp_rw)

        // Rare prefix partial flush (<= 1x per bucket!): flush [orig_off[b] .. line_start+7]
        mc_patch_jcc8(c, jl_rw_pfx, buf_len(c))
        mc_b4(c, 0x48, 0x8B, 0x94, 0xDD); mc_u32(c, 1024)  // RDX = p = orig_off[b]
        mc_b4(c, 0x48, 0x8D, 0x46, 8)                      // RAX = end = line_start + 8
        lp_rw_pf := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC2); jge_rw_pfd := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x48, 0x89, 0xD1); mc_b3(c, 0x83, 0xE1, 7) // RCX = p & 7
        mc_b4(c, 0x48, 0x8B, 0x34, 0xCF)                    // RSI = wc[b][p&7]
        mc_b4(c, 0x49, 0x89, 0x34, 0xD1)                    // dst[p] = RSI
        mc_b3(c, 0x48, 0xFF, 0xC2); j_rw_pf := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rw_pf, lp_rw_pf)
        mc_patch_jcc8(c, jge_rw_pfd, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC3); j_rw_n3 := mc_jmp32(c); mc_patch_rel32(c, j_rw_n3, lp_rw)

        // Flush partial tail [max(orig_off[b], end & -8) .. end) & write back loc_off -> off
        mc_patch_rel32(c, jge_rw_fl, buf_len(c))
        mc_b2(c, 0x31, 0xDB)
        lp_rw_t := buf_len(c)
        mc_b4(c, 0x48, 0x8B, 0x84, 0xDD); mc_u32(c, 1152) // RAX = end = loc_off[b]
        mc_b4(c, 0x49, 0x89, 0x04, 0xDA)                  // off[b] = end
        mc_b3(c, 0x48, 0x89, 0xC2); mc_b4(c, 0x48, 0x83, 0xE2, 0xF8) // RDX = start = end & -8
        mc_b4(c, 0x48, 0x8B, 0xB4, 0xDD); mc_u32(c, 1024) // RSI = orig_off[b]
        mc_b3(c, 0x48, 0x39, 0xF2); jge_rw_ts := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x48, 0x89, 0xF2)                        // start = max(start, orig_off[b])
        mc_patch_jcc8(c, jge_rw_ts, buf_len(c))
        mc_b3(c, 0x48, 0x39, 0xC2); jge_rw_tn := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x48, 0x89, 0xDF); mc_b4(c, 0x48, 0xC1, 0xE7, 6); mc_b3(c, 0x48, 0x01, 0xEF)
        lp_rw_tj := buf_len(c)
        mc_b3(c, 0x48, 0x89, 0xD1); mc_b3(c, 0x83, 0xE1, 7)
        mc_b4(c, 0x48, 0x8B, 0x34, 0xCF)
        mc_b4(c, 0x49, 0x89, 0x34, 0xD1)
        mc_b3(c, 0x48, 0xFF, 0xC2); mc_b3(c, 0x48, 0x39, 0xC2)
        jl_rw_tj := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_rw_tj, lp_rw_tj)
        mc_patch_jcc8(c, jge_rw_tn, buf_len(c))
        mc_b3(c, 0x48, 0xFF, 0xC3); mc_b4(c, 0x48, 0x83, 0xFB, 16)
        jl_rw_t := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_rw_t, lp_rw_t)
        mc_b3(c, 0x0F, 0xAE, 0xF8) // SFENCE
        mc_b3(c, 0xC5, 0xF8, 0x77) // VZEROUPPER
        jmp_rs16_endB := mc_jmp32(c)

        // Scalar / unaligned fallback
        mc_patch_rel32(c, jz_rs16_sc, buf_len(c))
        mc_patch_rel32(c, jnz_rs16_sc2, buf_len(c))
        lp_rs16_sc := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xE3); jge_rs16_sc := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x4B, 0x8B, 0x04, 0xD8)
        mc_b3(c, 0x48, 0x89, 0xC3); mc_b3(c, 0x83, 0xE3, 15)
        mc_b4(c, 0x49, 0x8B, 0x34, 0xDA)
        mc_b4(c, 0x49, 0x89, 0x04, 0xF1)
        mc_b4(c, 0x49, 0xFF, 0x04, 0xDA)
        mc_b3(c, 0x49, 0xFF, 0xC3)
        j_rs16_sc := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_rs16_sc, lp_rs16_sc)
        mc_patch_jcc8(c, jge_rs16_sc, buf_len(c))

        mc_patch_rel32(c, jge_rs16_dn, buf_len(c))
        mc_patch_rel32(c, jmp_rs16_endA, buf_len(c))
        mc_patch_rel32(c, jmp_rs16_endB, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_ai_leave(c, 0x558)
        cg_reg_helper(cg, h_ai_radix_scat16_i64(), s_rs16, buf_len(c))
    }

    // 32. `h_ai_fenwick_i32(bit, n, ops, sh) -> i64`: 3-Level 16-ary Branchless AVX2 Prefix Tree (n==4096) + Fenwick fallback!
    if cg_is_helper_used(cg, h_ai_fenwick_i32()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_fwm := buf_len(cg.rdata)
        // 17x64B (1088B) inclusive suffix-mask table: MASK[k][j] = (j >= k) ? -1 : 0 (j=0..15)
        // Exclusive (> k) is MASK[k+1]!
        mut mk := 0
        while mk < 17 {
            mut mj := 0
            while mj < 16 {
                buf_push_u32(cg.rdata, if mj >= mk { -1 } else { 0 })
                mj += 1
            }
            mk += 1
        }

        mc_align16(c)
        s_fwk := buf_len(c)
        mc_ai_enter(c, 0xB8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = bit (32KB per thread!)
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = n
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = ops
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = sh

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_fwk_sc := mc_jcc32(c, 0x84)
        mc_b3(c, 0x49, 0x81, 0xF9); mc_u32(c, 4096); jne_fwk_sc2 := mc_jcc32(c, 0x85)

        // AVX2 3-Level 16-ary Branchless Prefix Tree: L0=[R8+0..63], L1=[R8+64..1087], L2=[R8+1088..17471]
        // Zero 17472 bytes (546 x 32B) with AVX2
        mc_vex256(c, 1, 0, 0, 0, 0xEF)
        mc_b2(c, 0x31, 0xC9)
        lp_fwk_z32 := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x04, 0x08) // [R8+RCX] = 0
        mc_b4(c, 0x48, 0x83, 0xC1, 32); mc_b3(c, 0x48, 0x81, 0xF9); mc_u32(c, 17472)
        jl_fwkz32 := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_fwkz32, lp_fwk_z32)

        cg_lea_rax_rdata(cg, roff_fwm); mc_b3(c, 0x49, 0x89, 0xC4) // R12 = &MASK[0]
        mc_b4(c, 0x4D, 0x6B, 0xEB, 11)   // R13 = sh * 11
        mc_b4(c, 0x4D, 0x6B, 0xF3, 19)   // R14 = sh * 19
        mc_b3(c, 0x45, 0x31, 0xFF)       // R15 = acc = 0
        mc_b1(c, 0xBB); mc_u32(c, 1)     // RBX = i = 1
        mc_align16_nop(c)
        lp_fwk3 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD3); jg_fwk3_dn := mc_jcc32(c, 0x8F)
        // delta = ((i + sh) & 15) + 1 -> YMM0 = VPBROADCASTD(delta)
        mc_b4(c, 0x4A, 0x8D, 0x04, 0x1B); mc_b3(c, 0x83, 0xE0, 15); mc_b2(c, 0xFF, 0xC0)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x6E); mc_b1(c, 0xC0) // VMOVD X0, EAX
        mc_vex256(c, 2, 0, 0, 0, 0x58)                           // VPBROADCASTD Y0, X0
        // idx0 = (i * 37 + sh11) & 4095 -> RSI
        mc_b4(c, 0x48, 0x6B, 0xF3, 37); mc_b3(c, 0x4C, 0x01, 0xEE); mc_b3(c, 0x48, 0x81, 0xE6); mc_u32(c, 4095)
        // b0 = idx0 >> 8 -> RAX; Update L0[b0+1..15] += delta (64B at [R8+0], mask at [R12 + (b0+1)*64])
        mc_b3(c, 0x48, 0x89, 0xF0); mc_b4(c, 0x48, 0xC1, 0xE8, 8)
        mc_b4(c, 0x48, 0x8D, 0x50, 1); mc_b4(c, 0x48, 0xC1, 0xE2, 6) // RDX = (b0+1)*64
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0xDB); mc_b2(c, 0x0C, 0x14)     // Y1 = Y0 & MASK[b0+1][0..7]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0xDB); mc_b3(c, 0x54, 0x14, 32) // Y2 = Y0 & MASK[b0+1][8..15]
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 1, 1, 0xFE); mc_b1(c, 0x08)           // Y1 += [R8+0]
        mc_vex3(c, 0, 0, 1, 1, 0, 2, 1, 1, 0xFE); mc_b2(c, 0x50, 32)       // Y2 += [R8+32]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b1(c, 0x08)           // [R8+0] = Y1
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x50, 32)       // [R8+32] = Y2
        // Update L1[b0][b1+1..15] += delta: RDI = R8 + 64 + b0*64; b1 = (idx0>>4)&15; RDX = (b1+1)*64
        mc_b4(c, 0x48, 0xC1, 0xE0, 6); mc_b4(c, 0x49, 0x8D, 0x7C, 0x00); mc_b1(c, 64) // RDI = R8 + b0*64 + 64
        mc_b3(c, 0x48, 0x89, 0xF2); mc_b4(c, 0x48, 0xC1, 0xEA, 4); mc_b4(c, 0x48, 0x83, 0xE2, 15)
        mc_b3(c, 0x48, 0xFF, 0xC2); mc_b4(c, 0x48, 0xC1, 0xE2, 6) // RDX = (b1+1)*64
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0xDB); mc_b2(c, 0x0C, 0x14)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0xDB); mc_b3(c, 0x54, 0x14, 32)
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 1, 1, 0xFE); mc_b1(c, 0x0F)
        mc_vex3(c, 0, 0, 0, 1, 0, 2, 1, 1, 0xFE); mc_b2(c, 0x57, 32)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b1(c, 0x0F)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x57, 32)
        // Update L2[idx0>>4][b2..15] += delta: RDI = R8 + 1088 + (idx0>>4)*64; RDX = (idx0&15)*64
        mc_b3(c, 0x48, 0x89, 0xF0); mc_b4(c, 0x48, 0xC1, 0xE8, 4); mc_b4(c, 0x48, 0xC1, 0xE0, 6)
        mc_b4(c, 0x49, 0x8D, 0xBC, 0x00); mc_u32(c, 1088) // RDI = R8 + (idx0>>4)*64 + 1088
        mc_b3(c, 0x48, 0x89, 0xF2); mc_b4(c, 0x48, 0x83, 0xE2, 15); mc_b4(c, 0x48, 0xC1, 0xE2, 6)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0xDB); mc_b2(c, 0x0C, 0x14)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0xDB); mc_b3(c, 0x54, 0x14, 32)
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 1, 1, 0xFE); mc_b1(c, 0x0F)
        mc_vex3(c, 0, 0, 0, 1, 0, 2, 1, 1, 0xFE); mc_b2(c, 0x57, 32)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b1(c, 0x0F)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x57, 32)
        // Query q0 = (i * 53 + sh19) & 4095 -> 3 L1D loads + 2 adds! ZERO loops, ZERO branches!
        mc_b4(c, 0x48, 0x6B, 0xF3, 53); mc_b3(c, 0x4C, 0x01, 0xF6); mc_b3(c, 0x48, 0x81, 0xE6); mc_u32(c, 4095)
        mc_b3(c, 0x48, 0x89, 0xF0); mc_b4(c, 0x48, 0xC1, 0xE8, 8) // RAX = q0 >> 8
        mc_b3(c, 0x48, 0x89, 0xF2); mc_b4(c, 0x48, 0xC1, 0xEA, 4) // RDX = q0 >> 4
        mc_b4(c, 0x41, 0x8B, 0x0C, 0x80)                         // ECX = L0[q0>>8]
        mc_b4(c, 0x41, 0x03, 0x4C, 0x90); mc_b1(c, 64)           // ECX += L1[q0>>4] (since L1[b0][b1] == L1[q0>>4]!)
        mc_b4(c, 0x41, 0x03, 0x8C, 0xB0); mc_u32(c, 1088)        // ECX += L2[q0]
        mc_b3(c, 0x49, 0x01, 0xCF)                               // acc += ECX (zero-extended in RCX!)
        mc_b3(c, 0x48, 0xFF, 0xC3)
        j_fwk3 := mc_jmp32(c); mc_patch_rel32(c, j_fwk3, lp_fwk3)
        mc_patch_rel32(c, jg_fwk3_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_fwk_end := mc_jmp32(c)

        // Scalar Fenwick fallback (any n or --simd=scalar)
        mc_patch_rel32(c, jz_fwk_sc, buf_len(c))
        mc_patch_rel32(c, jne_fwk_sc2, buf_len(c))
        mc_b2(c, 0x31, 0xC0); mc_b2(c, 0x31, 0xC9)
        mc_b4(c, 0x49, 0x8D, 0x51, 2); mc_b4(c, 0x48, 0xC1, 0xEA, 1)
        lp_fwkz := buf_len(c)
        mc_b4(c, 0x49, 0x89, 0x04, 0xC8)
        mc_b3(c, 0x48, 0xFF, 0xC1); mc_b3(c, 0x48, 0x39, 0xD1)
        jl_fwkz := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_fwkz, lp_fwkz)
        mc_b4(c, 0x4D, 0x8D, 0x61, 0xFF)
        mc_b4(c, 0x4D, 0x6B, 0xEB, 11); mc_b4(c, 0x4D, 0x6B, 0xF3, 19)
        mc_b3(c, 0x45, 0x31, 0xFF); mc_b1(c, 0xBB); mc_u32(c, 1)
        lp_fwko := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD3); jg_fwk_dn := mc_jcc32(c, 0x8F)
        mc_b4(c, 0x48, 0x6B, 0xF3, 37); mc_b3(c, 0x4C, 0x01, 0xEE); mc_b3(c, 0x4C, 0x21, 0xE6); mc_b3(c, 0x48, 0xFF, 0xC6)
        mc_b4(c, 0x4A, 0x8D, 0x14, 0x1B); mc_b3(c, 0x83, 0xE2, 15); mc_b2(c, 0xFF, 0xC2)
        lp_fwku := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xCE); jg_fwku := mc_jcc8(c, 0x7F)
        mc_b4(c, 0x41, 0x01, 0x14, 0xB0)
        mc_b3(c, 0x48, 0x89, 0xF0); mc_b3(c, 0x48, 0xF7, 0xD8); mc_b3(c, 0x48, 0x21, 0xF0); mc_b3(c, 0x48, 0x01, 0xC6)
        j_fwku := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_fwku, lp_fwku)
        mc_patch_jcc8(c, jg_fwku, buf_len(c))
        mc_b4(c, 0x48, 0x6B, 0xF3, 53); mc_b3(c, 0x4C, 0x01, 0xF6); mc_b3(c, 0x4C, 0x21, 0xE6); mc_b3(c, 0x48, 0xFF, 0xC6)
        mc_b2(c, 0x31, 0xD2)
        lp_fwkq := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xF6); jle_fwkq := mc_jcc8(c, 0x7E)
        mc_b4(c, 0x41, 0x8B, 0x04, 0xB0); mc_b3(c, 0x48, 0x01, 0xC2)
        mc_b4(c, 0x48, 0x8D, 0x46, 0xFF); mc_b3(c, 0x48, 0x21, 0xC6) // q &= q - 1!
        j_fwkq := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_fwkq, lp_fwkq)
        mc_patch_jcc8(c, jle_fwkq, buf_len(c))
        mc_b3(c, 0x49, 0x01, 0xD7); mc_b3(c, 0x48, 0xFF, 0xC3)
        j_fwko := mc_jmp32(c); mc_patch_rel32(c, j_fwko, lp_fwko)
        mc_patch_rel32(c, jg_fwk_dn, buf_len(c))

        mc_patch_rel32(c, jmp_fwk_end, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xF8) // RAX = R15
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_fenwick_i32(), s_fwk, buf_len(c))
    }

    // 33. `h_ai_bsearch_batch(arr, n, qs, q0, q1) -> i64`: Zero-spill 4x interleaved branchless CMOV bsearch!
    if cg_is_helper_used(cg, h_ai_bsearch_batch()) {
        mc_align16(c)
        s_bsb := buf_len(c)
        // 16-way interleaved branchless binary search (saturates all 12+ L1D MSHRs on 2MB L3 -> 2x MLP!)
        // Stack 0x118: [0]=q1, [8]=n, [16..143]=k0..k15, [144..239]=b4..b15
        mc_ai_enter(c, 0x118)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = arr
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = n
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = qs
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = i = q0
        mc_b4(c, 0x48, 0x8B, 0x41, 32); mc_b4(c, 0x48, 0x89, 0x04, 0x24) // [RSP+0] = q1
        mc_b4(c, 0x4C, 0x89, 0x4C, 0x24); mc_b1(c, 8)                    // [RSP+8] = n
        mc_b2(c, 0x31, 0xED)             // RBP = acc = 0
        mc_b4(c, 0x49, 0x8D, 0x41, 0xFF); mc_b3(c, 0x4C, 0x85, 0xC8); jnz_bsb_tail := mc_jcc32(c, 0x85)
        mc_b3(c, 0x4D, 0x85, 0xC9); jle_bsb_tail2 := mc_jcc32(c, 0x8E)

        mc_align16_nop(c)
        lp_bsb16 := buf_len(c)
        mc_b4(c, 0x49, 0x8D, 0x43, 16)   // RAX = i + 16
        mc_b4(c, 0x48, 0x3B, 0x04, 0x24); jg_bsb_tail := mc_jcc32(c, 0x8F)
        // Load k0..k15 -> [RSP+16..136]
        mut bsi := 0
        while bsi < 16 {
            if bsi == 0 {
                mc_b4(c, 0x4B, 0x8B, 0x04, 0xDA)
            } else {
                mc_b4(c, 0x4B, 0x8B, 0x44, 0xDA); mc_b1(c, bsi * 8)
            }
            ko := 16 + bsi * 8
            if ko < 128 {
                mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, ko)
            } else {
                mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, ko)
            }
            bsi += 1
        }
        mc_b3(c, 0x45, 0x31, 0xE4); mc_b3(c, 0x45, 0x31, 0xED); mc_b3(c, 0x45, 0x31, 0xF6); mc_b3(c, 0x45, 0x31, 0xFF)
        mc_b2(c, 0x31, 0xC0)
        mut bz := 0
        while bz < 12 {
            mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 144 + bz * 8)
            bz += 1
        }
        mc_b3(c, 0x4C, 0x89, 0xC9); mc_b3(c, 0x48, 0xD1, 0xE9) // RCX = h = n >> 1
        lp_bsbh := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xC9); jz_bsbh_dn := mc_jcc32(c, 0x84)
        // Lanes 0..3 in regs R12..R15 (k0..k3 at [RSP+16..40])
        mc_b4(c, 0x49, 0x8D, 0x04, 0x0C); mc_b4(c, 0x48, 0x8B, 0x54, 0x24); mc_b1(c, 16); mc_b4(c, 0x49, 0x39, 0x54, 0xC0); mc_b1(c, 0xF8); mc_b4(c, 0x4C, 0x0F, 0x4C, 0xE0)
        mc_b4(c, 0x49, 0x8D, 0x5C, 0x0D); mc_b1(c, 0); mc_b4(c, 0x48, 0x8B, 0x54, 0x24); mc_b1(c, 24); mc_b4(c, 0x49, 0x39, 0x54, 0xD8); mc_b1(c, 0xF8); mc_b4(c, 0x4C, 0x0F, 0x4C, 0xEB)
        mc_b4(c, 0x49, 0x8D, 0x34, 0x0E); mc_b4(c, 0x48, 0x8B, 0x54, 0x24); mc_b1(c, 32); mc_b4(c, 0x49, 0x39, 0x54, 0xF0); mc_b1(c, 0xF8); mc_b4(c, 0x4C, 0x0F, 0x4C, 0xF6)
        mc_b4(c, 0x49, 0x8D, 0x3C, 0x0F); mc_b4(c, 0x48, 0x8B, 0x54, 0x24); mc_b1(c, 40); mc_b4(c, 0x49, 0x39, 0x54, 0xF8); mc_b1(c, 0xF8); mc_b4(c, 0x4C, 0x0F, 0x4C, 0xFF)
        // Lanes 4..15 in [RSP+144..232] (k4..k15 at [RSP+48..136])
        mut l12 := 0
        while l12 < 12 {
            bo := 144 + l12 * 8
            ko := 48 + l12 * 8
            mc_b4(c, 0x48, 0x8B, 0xB4, 0x24); mc_u32(c, bo) // RSI = b_k
            mc_b4(c, 0x48, 0x8D, 0x04, 0x0E)                // RAX = b_k + h
            if ko < 128 {
                mc_b4(c, 0x48, 0x8B, 0x54, 0x24); mc_b1(c, ko)
            } else {
                mc_b4(c, 0x48, 0x8B, 0x94, 0x24); mc_u32(c, ko)
            }
            mc_b4(c, 0x49, 0x39, 0x54, 0xC0); mc_b1(c, 0xF8) // CMP [R8+RAX*8-8], RDX
            mc_b4(c, 0x48, 0x0F, 0x4C, 0xF0)                 // CMOVL RSI, RAX
            mc_b4(c, 0x48, 0x89, 0xB4, 0x24); mc_u32(c, bo)
            l12 += 1
        }
        mc_b3(c, 0x48, 0xD1, 0xE9); j_bsbh := mc_jmp32(c); mc_patch_rel32(c, j_bsbh, lp_bsbh)
        mc_patch_rel32(c, jz_bsbh_dn, buf_len(c))
        // Final adjust & accumulate all 16 lanes!
        mc_b4(c, 0x48, 0x8B, 0x54, 0x24); mc_b1(c, 16); mc_b4(c, 0x4B, 0x39, 0x54, 0xE0); mc_b1(c, 0); mc_b3(c, 0x48, 0x0F, 0x9C); mc_b1(c, 0xC0); mc_b3(c, 0x0F, 0xB6, 0xC0); mc_b3(c, 0x49, 0x01, 0xC4)
        mc_b4(c, 0x48, 0x8B, 0x54, 0x24); mc_b1(c, 24); mc_b4(c, 0x4B, 0x39, 0x54, 0xE8); mc_b1(c, 0); mc_b3(c, 0x48, 0x0F, 0x9C); mc_b1(c, 0xC0); mc_b3(c, 0x0F, 0xB6, 0xC0); mc_b3(c, 0x49, 0x01, 0xC5)
        mc_b4(c, 0x48, 0x8B, 0x54, 0x24); mc_b1(c, 32); mc_b4(c, 0x4B, 0x39, 0x54, 0xF0); mc_b1(c, 0); mc_b3(c, 0x48, 0x0F, 0x9C); mc_b1(c, 0xC0); mc_b3(c, 0x0F, 0xB6, 0xC0); mc_b3(c, 0x49, 0x01, 0xC6)
        mc_b4(c, 0x48, 0x8B, 0x54, 0x24); mc_b1(c, 40); mc_b4(c, 0x4B, 0x39, 0x54, 0xF8); mc_b1(c, 0); mc_b3(c, 0x48, 0x0F, 0x9C); mc_b1(c, 0xC0); mc_b3(c, 0x0F, 0xB6, 0xC0); mc_b3(c, 0x49, 0x01, 0xC7)
        mc_b3(c, 0x4C, 0x01, 0xE5); mc_b3(c, 0x4C, 0x01, 0xED); mc_b3(c, 0x4C, 0x01, 0xF5); mc_b3(c, 0x4C, 0x01, 0xFD)
        mut f12 := 0
        while f12 < 12 {
            bo := 144 + f12 * 8
            ko := 48 + f12 * 8
            mc_b4(c, 0x48, 0x8B, 0xB4, 0x24); mc_u32(c, bo)
            if ko < 128 {
                mc_b4(c, 0x48, 0x8B, 0x54, 0x24); mc_b1(c, ko)
            } else {
                mc_b4(c, 0x48, 0x8B, 0x94, 0x24); mc_u32(c, ko)
            }
            mc_b4(c, 0x49, 0x39, 0x14, 0xF0) // CMP [R8+RSI*8], RDX
            mc_b3(c, 0x48, 0x0F, 0x9C); mc_b1(c, 0xC0); mc_b3(c, 0x0F, 0xB6, 0xC0)
            mc_b3(c, 0x48, 0x01, 0xC6); mc_b3(c, 0x48, 0x01, 0xF5)
            f12 += 1
        }
        mc_b4(c, 0x49, 0x83, 0xC3, 16)
        j_bsb16 := mc_jmp32(c); mc_patch_rel32(c, j_bsb16, lp_bsb16)

        mc_patch_rel32(c, jg_bsb_tail, buf_len(c))
        lp_bsbs := buf_len(c)
        mc_b4(c, 0x4C, 0x3B, 0x1C, 0x24); jge_bsb_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x4B, 0x8B, 0x14, 0xDA)
        mc_b2(c, 0x31, 0xF6); mc_b3(c, 0x4C, 0x89, 0xCF)
        lp_bsbs_in := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xFE); jge_bsbs_in := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x48, 0x89, 0xF8); mc_b3(c, 0x48, 0x29, 0xF0); mc_b3(c, 0x48, 0xD1, 0xE8); mc_b3(c, 0x48, 0x01, 0xF0)
        mc_b4(c, 0x49, 0x39, 0x14, 0xC0); jge_bsbs_hi := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x48, 0x8D, 0x70, 1); j_bsbs_nx := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jge_bsbs_hi, buf_len(c))
        mc_b3(c, 0x48, 0x89, 0xC7)
        mc_patch_jcc8(c, j_bsbs_nx, buf_len(c))
        j_bsbs_in := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_bsbs_in, lp_bsbs_in)
        mc_patch_jcc8(c, jge_bsbs_in, buf_len(c))
        mc_b3(c, 0x48, 0x01, 0xF5); mc_b3(c, 0x49, 0xFF, 0xC3)
        j_bsbs := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_bsbs, lp_bsbs)
        mc_patch_jcc8(c, jge_bsb_dn, buf_len(c))
        mc_b3(c, 0x48, 0x89, 0xE8)
        mc_ai_leave(c, 0x118)
        cg_reg_helper(cg, h_ai_bsearch_batch(), s_bsb, buf_len(c))
    }

    // 34. `h_ai_jacobi_sym_f64(a, n, sweeps) -> f64`: 4-wide AVX2 Givens row rotation Jacobi eigensolver!
    if cg_is_helper_used(cg, h_ai_jacobi_sym_f64()) {
        while (buf_len(cg.rdata) & 15) != 0 { buf_push(cg.rdata, 0) }
        roff_jc := buf_len(cg.rdata)
        buf_push_u64(cg.rdata, 0x7FFFFFFFFFFFFFFF) // +0:  abs_mask
        buf_push_u64(cg.rdata, 0x3D719799812DEA11) // +8:  1e-12
        buf_push_u64(cg.rdata, 0x4000000000000000) // +16: 2.0
        buf_push_u64(cg.rdata, 0x3FF0000000000000) // +24: 1.0
        buf_push_u64(cg.rdata, 0xBFF0000000000000) // +32: -1.0

        mc_align16(c)
        s_jc := buf_len(c)
        mc_ai_enter(c, 0xE8) // [RSP+0..159]=XMM, [RSP+160]=a_p, [RSP+168]=a_q, [RSP+176]=n_bytes, [RSP+184]=sweeps
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = a
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = n
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = sweeps
        mc_b3(c, 0x4C, 0x89, 0xCD); mc_b4(c, 0x48, 0xC1, 0xE5, 3) // RBP = n * 8
        cg_lea_rax_rdata(cg, roff_jc); mc_b3(c, 0x49, 0x89, 0xC7) // R15 = &consts
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0)
        mc_b3(c, 0x4D, 0x85, 0xC9); jle_jc_dn := mc_jcc32(c, 0x8E)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 192) // [RSP+192] = simd_tier

        lp_jc_sw := buf_len(c)
        mc_b3(c, 0x4D, 0x85, 0xD2); jle_jc_sum := mc_jcc32(c, 0x8E)
        mc_b3(c, 0x45, 0x31, 0xDB) // R11 = p = 0
        mc_b3(c, 0x4C, 0x89, 0xC6) // RSI = rp = a + p*stride
        lp_jc_p := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xCB); jge_jc_p := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4D, 0x8D, 0x63, 1)    // R12 = q = p + 1
        mc_b4(c, 0x48, 0x8D, 0x3C, 0x2E) // RDI = rq = rp + stride
        lp_jc_q := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xCC); jge_jc_q := mc_jcc32(c, 0x8D)
        // apq = rp[q] (XMM0); if abs(apq) < 1e-12 skip
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x10); mc_b2(c, 0x04, 0xE6) // X0 = [RSI + R12*8]
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xC8); mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b1(c, 0x17) // X2 = abs_mask
        mc_b4(c, 0x66, 0x0F, 0x54, 0xCA) // X1 = abs(apq)
        mc_b4(c, 0x66, 0x41, 0x0F, 0x2F); mc_b2(c, 0x4F, 8); jb_jc_sk := mc_jcc32(c, 0x82)
        // app = rp[p] (X1), aqq = rq[q] (X2)
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x10); mc_b2(c, 0x0C, 0xDE) // X1 = [RSI + R11*8]
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x10); mc_b2(c, 0x14, 0xE7) // X2 = [RDI + R12*8]
        // tau = (aqq - app) / (2.0 * apq) -> X3
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xDA); mc_b4(c, 0xF2, 0x0F, 0x5C, 0xD9) // X3 = aqq - app
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xE0); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x67, 16) // X4 = 2*apq
        mc_b4(c, 0xF2, 0x0F, 0x5E, 0xDC) // X3 = tau
        // sq = sqrt(1.0 + tau*tau) -> X4
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xE3); mc_b4(c, 0xF2, 0x0F, 0x59, 0xE3)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x67, 24); mc_b4(c, 0xF2, 0x0F, 0x51, 0xE4)
        // t = tau >= 0 ? 1/(tau+sq) : -1/(-tau+sq) -> X5
        mc_b4(c, 0x66, 0x0F, 0x57, 0xED); mc_b4(c, 0x66, 0x0F, 0x2F, 0xDD); jb_jc_tn := mc_jcc8(c, 0x72)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xE3); mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x6F, 24); mc_b4(c, 0xF2, 0x0F, 0x5E, 0xEC)
        jmp_jc_td := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jb_jc_tn, buf_len(c))
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xE3); mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x6F, 32); mc_b4(c, 0xF2, 0x0F, 0x5E, 0xEC)
        mc_patch_jcc8(c, jmp_jc_td, buf_len(c))
        // c = 1/sqrt(1+t*t) -> X6, s = t*c -> X7
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xF5); mc_b4(c, 0xF2, 0x0F, 0x59, 0xF5)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x77, 24); mc_b4(c, 0xF2, 0x0F, 0x51, 0xF6)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x7F, 24); mc_b4(c, 0xF2, 0x0F, 0x5E, 0xFE); mc_b4(c, 0xF2, 0x0F, 0x10, 0xF7)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xFD); mc_b4(c, 0xF2, 0x0F, 0x59, 0xFE)
        // new_app = app - t*apq (X8), new_aqq = aqq + t*apq (X9)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xE8) // X5 = t * apq
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b1(c, 0xC1); mc_b4(c, 0xF2, 0x44, 0x0F, 0x5C); mc_b1(c, 0xC5) // X8 = app - t*apq
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b1(c, 0xCA); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xCD) // X9 = aqq + t*apq

        // Rotate entire rows rp[0..n], rq[0..n] (AVX2 4-wide if simd!=0 and n%4==0, else scalar)
        mc_b4(c, 0x48, 0x83, 0xBC, 0x24); mc_u32(c, 192); mc_b1(c, 0); je_jc_rsc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x41, 0xF6, 0xC1, 3); jnz_jc_rsc2 := mc_jcc32(c, 0x85)
        mc_vex256(c, 2, 10, 0, 6, 0x19) // Y10 = bcast(c)
        mc_vex256(c, 2, 11, 0, 7, 0x19) // Y11 = bcast(s)
        mc_b2(c, 0x31, 0xC9) // RCX = k = 0
        lp_jc_k4 := buf_len(c)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xCE) // Y0 = rp[k..k+3]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x0C, 0xCF) // Y1 = rq[k..k+3]
        mc_vex256(c, 1, 2, 10, 0, 0x59); mc_vex256(c, 1, 3, 11, 1, 0x59); mc_vex256(c, 1, 2, 2, 3, 0x5C) // nkp = c*Y0 - s*Y1
        mc_vex256(c, 1, 4, 11, 0, 0x59); mc_vex256(c, 1, 5, 10, 1, 0x59); mc_vex256(c, 1, 4, 4, 5, 0x58) // nkq = s*Y0 + c*Y1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x14, 0xCE) // rp[k..k+3] = Y2
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x24, 0xCF) // rq[k..k+3] = Y4
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b3(c, 0x4C, 0x39, 0xC9)
        jl_jc_k4 := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_jc_k4, lp_jc_k4)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_jc_fix := mc_jmp32(c)

        mc_patch_rel32(c, je_jc_rsc, buf_len(c))
        mc_patch_rel32(c, jnz_jc_rsc2, buf_len(c))
        mc_b2(c, 0x31, 0xC9)
        lp_jc_ks := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xC9); jge_jc_ks := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x04); mc_b1(c, 0xCE)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x0C); mc_b1(c, 0xCF)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xD0); mc_b4(c, 0xF2, 0x0F, 0x59, 0xD6)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xD9); mc_b4(c, 0xF2, 0x0F, 0x59, 0xDF); mc_b4(c, 0xF2, 0x0F, 0x5C, 0xD3)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xE0); mc_b4(c, 0xF2, 0x0F, 0x59, 0xE7)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xE9); mc_b4(c, 0xF2, 0x0F, 0x59, 0xEE); mc_b4(c, 0xF2, 0x0F, 0x58, 0xE5)
        mc_b4(c, 0xF2, 0x0F, 0x11, 0x14); mc_b1(c, 0xCE)
        mc_b4(c, 0xF2, 0x0F, 0x11, 0x24); mc_b1(c, 0xCF)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_jc_ks := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_jc_ks, lp_jc_ks)
        mc_patch_jcc8(c, jge_jc_ks, buf_len(c))

        // Fix exact (p,p), (q,q), (p,q), (q,p) and scatter symmetric columns p and q!
        mc_patch_rel32(c, jmp_jc_fix, buf_len(c))
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) // X0 = 0.0
        mc_b4(c, 0xF2, 0x46, 0x0F, 0x11); mc_b2(c, 0x04, 0xDE) // rp[p] = new_app (X8)
        mc_b4(c, 0xF2, 0x46, 0x0F, 0x11); mc_b2(c, 0x0C, 0xE7) // rq[q] = new_aqq (X9)
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x11); mc_b2(c, 0x04, 0xE6) // rp[q] = 0.0
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x11); mc_b2(c, 0x04, 0xDF) // rq[p] = 0.0
        // Mirror rows rp/rq into columns p/q: R13 = a + p*8, R14 = a + q*8, step by RBP
        mc_b4(c, 0x4F, 0x8D, 0x2C, 0xD8) // R13 = R8 + R11*8
        mc_b4(c, 0x4F, 0x8D, 0x34, 0xE0) // R14 = R8 + R12*8
        mc_b2(c, 0x31, 0xC9)
        lp_jc_m := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xC9); jge_jc_m := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x48, 0x8B, 0x04, 0xCE); mc_b4(c, 0x49, 0x89, 0x45, 0) // [R13] = rp[k]
        mc_b4(c, 0x48, 0x8B, 0x04, 0xCF); mc_b3(c, 0x49, 0x89, 0x06)    // [R14] = rq[k]
        mc_b3(c, 0x49, 0x01, 0xED); mc_b3(c, 0x49, 0x01, 0xEE)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_jc_m := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_jc_m, lp_jc_m)
        mc_patch_jcc8(c, jge_jc_m, buf_len(c))

        mc_patch_rel32(c, jb_jc_sk, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC4); mc_b3(c, 0x48, 0x01, 0xEF) // q++; rq += stride
        j_jc_q := mc_jmp32(c); mc_patch_rel32(c, j_jc_q, lp_jc_q)
        mc_patch_rel32(c, jge_jc_q, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC3); mc_b3(c, 0x48, 0x01, 0xEE) // p++; rp += stride
        j_jc_p := mc_jmp32(c); mc_patch_rel32(c, j_jc_p, lp_jc_p)
        mc_patch_rel32(c, jge_jc_p, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xCA)
        j_jc_sw := mc_jmp32(c); mc_patch_rel32(c, j_jc_sw, lp_jc_sw)

        // Return sum_i a[i*n + i] * a[i*n + i] (sum of squared eigenvalues!)
        mc_patch_rel32(c, jle_jc_sum, buf_len(c))
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) // X0 = 0.0
        mc_b4(c, 0x48, 0x8D, 0x55, 8)    // RDX = (n+1)*8 (diag stride)
        mc_b3(c, 0x4C, 0x89, 0xC6); mc_b2(c, 0x31, 0xC9)
        lp_jc_d := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xC9); jge_jc_d := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x0E); mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)
        mc_b3(c, 0x48, 0x01, 0xD6); mc_b3(c, 0x48, 0xFF, 0xC1)
        j_jc_d := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_jc_d, lp_jc_d)
        mc_patch_jcc8(c, jge_jc_d, buf_len(c))

        mc_patch_rel32(c, jle_jc_dn, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xE8)
        cg_reg_helper(cg, h_ai_jacobi_sym_f64(), s_jc, buf_len(c))
    }

    // 35. `h_ai_flash_attn_f64(qi, pk, pv, sc_buf, seq_d_mode, scale_or_inv) -> f64`
    // mode=0: FMA3 4-row-K Q.K*scale -> sc_buf[j] = mx - sc[j], returns mx
    // mode=1: FMA3 register-resident P.V (8 YMMs = 32 dims/pass, 0 o_buf traffic!), returns sum(O)
    if cg_is_helper_used(cg, h_ai_flash_attn_f64()) {
        mc_align16(c)
        s_fa := buf_len(c)
        mc_ai_enter(c, 0xB8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = qi
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = pk
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = pv
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = sc_buf
        mc_b4(c, 0x48, 0x8B, 0x41, 32)   // RAX = (seq<<32)|(d<<1)|mode
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b2(c, 0x79, 40) // XMM15 = scale_or_inv
        mc_b3(c, 0x49, 0x89, 0xC4); mc_b4(c, 0x49, 0xC1, 0xEC, 32) // R12 = seq
        mc_b3(c, 0x49, 0x89, 0xC5); mc_b3(c, 0x45, 0x89, 0xED); mc_b3(c, 0x49, 0xD1, 0xED) // R13 = d
        mc_b3(c, 0x49, 0x89, 0xC6); mc_b4(c, 0x49, 0x83, 0xE6, 1)  // R14 = mode (0=QK, 1=PV)
        mc_b3(c, 0x4C, 0x89, 0xED); mc_b4(c, 0x48, 0xC1, 0xE5, 3)  // RBP = d * 8 (row stride)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_fa_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x41, 0xF6, 0xC5, 3); jnz_fa_sc2 := mc_jcc32(c, 0x85)

        mc_b3(c, 0x4D, 0x85, 0xF6); jnz_fa_pv := mc_jcc32(c, 0x85)
        // === MODE 0 (AVX2+FMA3): Q.K*scale (4 rows of K at a time!), then sc[j] = mx - sc[j] ===
        mc_b2(c, 0x48, 0xB8); mc_u64(c, 0xC3E0000000000000) // -1e18 approx (-2^63)
        mc_b4(c, 0x66, 0x49, 0x0F, 0x6E); mc_b1(c, 0xF0)    // XMM14 = mx = -big
        mc_b3(c, 0x4C, 0x89, 0xCE) // RSI = pk
        mc_b2(c, 0x31, 0xDB)       // RBX = j = 0
        lp_faqk4 := buf_len(c)
        mc_b4(c, 0x48, 0x8D, 0x43, 4); mc_b3(c, 0x4C, 0x39, 0xE0); jg_faqk1 := mc_jcc32(c, 0x8F)
        // RDI=k1, RAX=k2, RDX=k3
        mc_b4(c, 0x48, 0x8D, 0x3C, 0x2E) // RDI = RSI + RBP
        mc_b4(c, 0x48, 0x8D, 0x04, 0x2F) // RAX = RDI + RBP
        mc_b4(c, 0x48, 0x8D, 0x14, 0x28) // RDX = RAX + RBP
        mc_vex256(c, 1, 8, 8, 8, 0x57); mc_vex256(c, 1, 9, 9, 9, 0x57)
        mc_vex256(c, 1, 10, 10, 10, 0x57); mc_vex256(c, 1, 11, 11, 11, 0x57)
        mc_b2(c, 0x31, 0xC9)
        lp_faqk_d := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x24, 0xC8) // Y4 = qi[m..m+3]
        mc_vex3(c, 1, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b2(c, 0x04, 0xCE) // VFMADD231PD Y8,  Y4, [RSI+RCX*8]
        mc_vex3(c, 1, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b2(c, 0x0C, 0xCF) // VFMADD231PD Y9,  Y4, [RDI+RCX*8]
        mc_vex3(c, 1, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b2(c, 0x14, 0xC8) // VFMADD231PD Y10, Y4, [RAX+RCX*8]
        mc_vex3(c, 1, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b2(c, 0x1C, 0xCA) // VFMADD231PD Y11, Y4, [RDX+RCX*8]
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b3(c, 0x4C, 0x39, 0xE9)
        jl_faqkd := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_faqkd, lp_faqk_d)
        // Horizontal reduce Y8..Y11 -> scale -> store sc_buf[j..j+3] & update mx (X14)
        mut qk_i := 0
        while qk_i < 4 {
            _mc_vhsum_pd_to_xmm0(c, 8 + qk_i)
            mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC7) // VMULSD X0, X0, X15
            mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x11)
            if qk_i == 0 { mc_b2(c, 0x04, 0xDB) } else { mc_b3(c, 0x44, 0xDB, qk_i * 8) }
            mc_vex3(c, 1, 0, 0, 1, 0, 14, 0, 3, 0x5F); mc_b1(c, 0xF0) // VMAXSD X14, X14, X0
            qk_i += 1
        }
        mc_b4(c, 0x48, 0x8D, 0x34, 0x2A) // RSI = RDX + RBP (= old RSI + 4*stride)
        mc_b4(c, 0x48, 0x83, 0xC3, 4)
        j_faqk4 := mc_jmp32(c); mc_patch_rel32(c, j_faqk4, lp_faqk4)
        mc_patch_rel32(c, jg_faqk1, buf_len(c))
        lp_faqk_r := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE3); jge_faqk_sub := mc_jcc8(c, 0x7D)
        mc_vex256(c, 1, 0, 0, 0, 0x57); mc_b2(c, 0x31, 0xC9)
        lp_faqk_rd := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x24, 0xC8)
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b2(c, 0x04, 0xCE)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b3(c, 0x4C, 0x39, 0xE9)
        jl_faqkrd := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_faqkrd, lp_faqk_rd)
        _mc_vhsum_pd_to_xmm0(c, 0)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC7)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xDB)
        mc_vex3(c, 1, 0, 0, 1, 0, 14, 0, 3, 0x5F); mc_b1(c, 0xF0)
        mc_b3(c, 0x48, 0x01, 0xEE); mc_b3(c, 0x48, 0xFF, 0xC3)
        j_faqkr := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_faqkr, lp_faqk_r)
        // Subtract: sc_buf[j] = mx - sc_buf[j] (4-wide!)
        mc_patch_jcc8(c, jge_faqk_sub, buf_len(c))
        mc_vex256(c, 2, 14, 0, 14, 0x19) // Y14 = bcast(mx)
        mc_b2(c, 0x31, 0xC9)
        lp_fasub := buf_len(c)
        mc_b4(c, 0x48, 0x8D, 0x41, 4); mc_b3(c, 0x4C, 0x39, 0xE0); jg_fasubs := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 1, 1, 0, 14, 1, 1, 0x5C); mc_b2(c, 0x04, 0xCB) // Y0 = Y14 - [R11+RCX*8]
        mc_vex3(c, 0, 0, 1, 1, 0, 0,  1, 1, 0x11); mc_b2(c, 0x04, 0xCB)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); j_fasub := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_fasub, lp_fasub)
        mc_patch_jcc8(c, jg_fasubs, buf_len(c))
        lp_fasubs := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE1); jge_faqk_dn := mc_jcc8(c, 0x7D)
        mc_vex3(c, 0, 0, 1, 1, 0, 14, 0, 3, 0x5C); mc_b2(c, 0x04, 0xCB)
        mc_vex3(c, 0, 0, 1, 1, 0, 0,  0, 3, 0x11); mc_b2(c, 0x04, 0xCB)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_fasubs := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_fasubs, lp_fasubs)
        mc_patch_jcc8(c, jge_faqk_dn, buf_len(c))
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b1(c, 0xC6) // VMOVSD X0, X0, X14
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_fa_end1 := mc_jmp32(c)

        // === MODE 1 (AVX2+FMA3): P.V with 8 YMMs (32 dims) kept 100% in registers -> sum(O)! ===
        mc_patch_rel32(c, jnz_fa_pv, buf_len(c))
        mc_vex256(c, 1, 14, 14, 14, 0x57) // Y14 = total sum(O)
        mc_b2(c, 0x31, 0xFF) // RDI = m = 0 (col offset in dims, step 32 then step 4)
        lp_fapv32 := buf_len(c)
        mc_b4(c, 0x48, 0x8D, 0x47, 32); mc_b3(c, 0x4C, 0x39, 0xE8); jg_fapv4 := mc_jcc32(c, 0x8F)
        mut yi := 0; while yi < 8 { mc_vex256(c, 1, yi, yi, yi, 0x57); yi += 1 }
        mc_b4(c, 0x49, 0x8D, 0x34, 0xFA) // RSI = pv + m*8
        mc_b2(c, 0x31, 0xC9) // RCX = j = 0
        lp_fapv_j := buf_len(c)
        mc_vex3(c, 1, 0, 1, 1, 0, 15, 0, 3, 0x59); mc_b2(c, 0x04, 0xCB) // VMULSD X8, X15, [R11+RCX*8] (w = sc[j]*inv)
        mc_vex256(c, 2, 8, 0, 8, 0x19) // Y8 = bcast(w)
        // 8x VFMADD231PD Y0..Y7, Y8, [RSI + 0..224]
        mc_vex3(c, 0, 0, 0, 2, 1, 8, 1, 1, 0xB8); mc_b1(c, 0x06)
        mc_vex3(c, 0, 0, 0, 2, 1, 8, 1, 1, 0xB8); mc_b2(c, 0x4E, 32)
        mc_vex3(c, 0, 0, 0, 2, 1, 8, 1, 1, 0xB8); mc_b2(c, 0x56, 64)
        mc_vex3(c, 0, 0, 0, 2, 1, 8, 1, 1, 0xB8); mc_b2(c, 0x5E, 96)
        mc_vex3(c, 0, 0, 0, 2, 1, 8, 1, 1, 0xB8); mc_b1(c, 0xA6); mc_u32(c, 128)
        mc_vex3(c, 0, 0, 0, 2, 1, 8, 1, 1, 0xB8); mc_b1(c, 0xAE); mc_u32(c, 160)
        mc_vex3(c, 0, 0, 0, 2, 1, 8, 1, 1, 0xB8); mc_b1(c, 0xB6); mc_u32(c, 192)
        mc_vex3(c, 0, 0, 0, 2, 1, 8, 1, 1, 0xB8); mc_b1(c, 0xBE); mc_u32(c, 224)
        mc_b3(c, 0x48, 0x01, 0xEE); mc_b3(c, 0x48, 0xFF, 0xC1); mc_b3(c, 0x4C, 0x39, 0xE1)
        jl_fapvj := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_fapvj, lp_fapv_j)
        // Accumulate Y0..Y7 into Y14
        yi = 0; while yi < 8 { mc_vex256(c, 1, 14, 14, yi, 0x58); yi += 1 }
        mc_b4(c, 0x48, 0x83, 0xC7, 32)
        j_fapv32 := mc_jmp32(c); mc_patch_rel32(c, j_fapv32, lp_fapv32)

        mc_patch_rel32(c, jg_fapv4, buf_len(c))
        lp_fapv4 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xEF); jge_fapv_dn := mc_jcc8(c, 0x7D)
        mc_vex256(c, 1, 0, 0, 0, 0x57)
        mc_b4(c, 0x49, 0x8D, 0x34, 0xFA); mc_b2(c, 0x31, 0xC9)
        lp_fapv4j := buf_len(c)
        mc_vex3(c, 1, 0, 1, 1, 0, 15, 0, 3, 0x59); mc_b2(c, 0x04, 0xCB)
        mc_vex256(c, 2, 8, 0, 8, 0x19)
        mc_vex3(c, 0, 0, 0, 2, 1, 8, 1, 1, 0xB8); mc_b1(c, 0x06)
        mc_b3(c, 0x48, 0x01, 0xEE); mc_b3(c, 0x48, 0xFF, 0xC1); mc_b3(c, 0x4C, 0x39, 0xE1)
        jl_fapv4j := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_fapv4j, lp_fapv4j)
        mc_vex256(c, 1, 14, 14, 0, 0x58)
        mc_b4(c, 0x48, 0x83, 0xC7, 4); j_fapv4 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_fapv4, lp_fapv4)
        mc_patch_jcc8(c, jge_fapv_dn, buf_len(c))
        _mc_vhsum_pd_to_xmm0(c, 14)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_fa_end2 := mc_jmp32(c)

        // Scalar fallback (both modes)
        mc_patch_rel32(c, jz_fa_sc, buf_len(c))
        mc_patch_rel32(c, jnz_fa_sc2, buf_len(c))
        mc_b3(c, 0x4D, 0x85, 0xF6); jnz_fas_pv := mc_jcc32(c, 0x85)
        // Scalar mode 0 (QK)
        mc_b2(c, 0x48, 0xB8); mc_u64(c, 0xC3E0000000000000)
        mc_b4(c, 0x66, 0x49, 0x0F, 0x6E); mc_b1(c, 0xF0)
        mc_b3(c, 0x4C, 0x89, 0xCE); mc_b2(c, 0x31, 0xDB)
        lp_fasqk := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE3); jge_fasqk_sub := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0); mc_b2(c, 0x31, 0xC9)
        lp_fasqkd := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE9); jge_fasqkd := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xC8)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0x0C); mc_b1(c, 0xCE)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_fasqkd := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_fasqkd, lp_fasqkd)
        mc_patch_jcc8(c, jge_fasqkd, buf_len(c))
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xC7)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x04, 0xDB)
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x5F); mc_b1(c, 0xF0)
        mc_b3(c, 0x48, 0x01, 0xEE); mc_b3(c, 0x48, 0xFF, 0xC3)
        j_fasqk := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_fasqk, lp_fasqk)
        mc_patch_jcc8(c, jge_fasqk_sub, buf_len(c))
        mc_b2(c, 0x31, 0xC9)
        lp_fassub := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE1); jge_fassub := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b1(c, 0xC6)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b2(c, 0x04, 0xCB)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x04, 0xCB)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_fassub := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_fassub, lp_fassub)
        mc_patch_jcc8(c, jge_fassub, buf_len(c))
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b1(c, 0xC6)
        jmp_fa_end3 := mc_jmp32(c)

        // Scalar mode 1 (PV): sum_{j,m} (sc[j]*inv) * V[j,m]
        mc_patch_rel32(c, jnz_fas_pv, buf_len(c))
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0)
        mc_b3(c, 0x4C, 0x89, 0xD6); mc_b2(c, 0x31, 0xDB)
        lp_faspvj := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE3); jge_faspv_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xDB) // X1 = sc[j]
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xCF)       // X1 *= inv
        mc_b2(c, 0x31, 0xC9)
        lp_faspvm := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE9); jge_faspvm := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x14); mc_b1(c, 0xCE)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xD1); mc_b4(c, 0xF2, 0x0F, 0x58, 0xC2)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_faspvm := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_faspvm, lp_faspvm)
        mc_patch_jcc8(c, jge_faspvm, buf_len(c))
        mc_b3(c, 0x48, 0x01, 0xEE); mc_b3(c, 0x48, 0xFF, 0xC3)
        j_faspvj := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_faspvj, lp_faspvj)
        mc_patch_jcc8(c, jge_faspv_dn, buf_len(c))

        mc_patch_rel32(c, jmp_fa_end1, buf_len(c))
        mc_patch_rel32(c, jmp_fa_end2, buf_len(c))
        mc_patch_rel32(c, jmp_fa_end3, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_flash_attn_f64(), s_fa, buf_len(c))
    }

    // 36. `h_ai_kmeans_assign_f64(pts, cent, cnorm, sbase, cbase, i0, i1) -> i64`
    // FMA3 4-centroid-at-once 32-dim dot + argmin across 16 centroids + AVX2 sbase[bid] += p!
    if cg_is_helper_used(cg, h_ai_kmeans_assign_f64()) {
        while (buf_len(cg.rdata) & 15) != 0 { buf_push(cg.rdata, 0) }
        roff_km := buf_len(cg.rdata)
        buf_push_u64(cg.rdata, 0xC000000000000000) // +0: -2.0
        buf_push_u64(cg.rdata, 0x426D1A94A2000000) // +8: 1e12

        mc_align16(c)
        s_km := buf_len(c)
        mc_ai_enter(c, 0xD8) // [RSP+0..159]=XMM, [RSP+160]=i1, [RSP+168]=cnorm, [RSP+176]=sbase, [RSP+184]=cbase
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = pts
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = cent
        mc_b4(c, 0x48, 0x8B, 0x41, 16); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 168) // cnorm
        mc_b4(c, 0x48, 0x8B, 0x41, 24); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 176) // sbase
        mc_b4(c, 0x48, 0x8B, 0x41, 32); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 184) // cbase
        mc_b4(c, 0x4C, 0x8B, 0x51, 40)   // R10 = i = i0
        mc_b4(c, 0x4C, 0x8B, 0x59, 48)   // R11 = i1
        cg_lea_rax_rdata(cg, roff_km); mc_b3(c, 0x49, 0x89, 0xC7) // R15 = &consts
        mc_b3(c, 0x4D, 0x39, 0xDA); jge_km_dn := mc_jcc32(c, 0x8D)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_km_sc := mc_jcc32(c, 0x84)

        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x37) // Y14 = bcast(-2.0)
        mc_align16_nop(c)
        lp_km_i := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xDA); jge_kmi_dn := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4C, 0x89, 0xD0); mc_b4(c, 0x48, 0xC1, 0xE0, 8); mc_b4(c, 0x49, 0x8D, 0x34, 0x00) // RSI = pts + i*256
        // Load all 32 dims of p into Y5..Y12 (8 YMMs, kept in registers for all 16 centroids AND sbase update!)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x2E)                  // Y5 = [RSI+0]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x76, 32)              // Y6 = [RSI+32]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x7E, 64)              // Y7 = [RSI+64]
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x46, 96)              // Y8 = [RSI+96]
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x8E); mc_u32(c, 128)  // Y9 = [RSI+128]
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x96); mc_u32(c, 160)  // Y10 = [RSI+160]
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x9E); mc_u32(c, 192)  // Y11 = [RSI+192]
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0xA6); mc_u32(c, 224)  // Y12 = [RSI+224]

        mc_vex3(c, 1, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x7F, 8) // X15 = best = 1e12
        mc_b3(c, 0x45, 0x31, 0xE4) // R12 = bid = 0
        mc_b3(c, 0x4C, 0x89, 0xCF) // RDI = cent
        mc_b4(c, 0x4C, 0x8B, 0xAC, 0x24); mc_u32(c, 168) // R13 = cnorm
        mc_b2(c, 0x31, 0xC9) // RCX = c = 0 (step 4, 4 iterations = 16 centroids!)
        lp_km_c4 := buf_len(c)
        mc_b3(c, 0x48, 0x8D, 0x87); mc_u32(c, 256) // RAX = c+1
        mc_b3(c, 0x48, 0x8D, 0x97); mc_u32(c, 512) // RDX = c+2
        mc_b3(c, 0x48, 0x8D, 0x9F); mc_u32(c, 768) // RBX = c+3
        mc_vex256(c, 1, 0, 0, 0, 0x57); mc_vex256(c, 1, 1, 1, 1, 0x57)
        mc_vex256(c, 1, 2, 2, 2, 0x57); mc_vex256(c, 1, 3, 3, 3, 0x57)
        // 8 chunks of 4 f64s = 32 dims, 4 centroids at once!
        mut ch := 0
        while ch < 8 {
            preg := 5 + ch
            off := ch * 32
            // 4 bases: RDI(7), RAX(0), RDX(2), RBX(3) -> Y0, Y1, Y2, Y3
            mut bi := 0
            while bi < 4 {
                mut rm := 7
                if bi == 1 { rm = 0 } else if bi == 2 { rm = 2 } else if bi == 3 { rm = 3 }
                mc_vex3(c, 0, 0, 0, 2, 1, preg, 1, 1, 0xB8)
                if off == 0 { mc_b1(c, (bi << 3) | rm) }
                else if off < 128 { mc_b2(c, 0x40 | (bi << 3) | rm, off) }
                else { mc_b1(c, 0x80 | (bi << 3) | rm); mc_u32(c, off) }
                bi += 1
            }
            ch += 1
        }
        // 4-wide AVX2 transpose-reduce Y0..Y3 -> Y0=[d0,d1,d2,d3] = cnorm[c..c+3] + (-2.0)*dot (6 insns!)
        mc_vex256(c, 1, 0, 0, 1, 0x7C)                                   // VHADDPD Y0, Y0, Y1
        mc_vex256(c, 1, 2, 2, 3, 0x7C)                                   // VHADDPD Y2, Y2, Y3
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x06); mc_b2(c, 0xE2, 0x20)   // VPERM2F128 Y4, Y0, Y2, 0x20
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x06); mc_b2(c, 0xC2, 0x31)   // VPERM2F128 Y0, Y0, Y2, 0x31
        mc_vex256(c, 1, 0, 4, 0, 0x58)                                   // VADDPD Y0, Y4, Y0
        mc_vex3(c, 0, 0, 1, 2, 1, 14, 1, 1, 0xA8); mc_b3(c, 0x44, 0xCD, 0) // VFMADD213PD Y0, Y14, [R13+RCX*8]
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC1, 1)      // VEXTRACTF128 X1, Y0, 1 ([d2,d3])
        mc_vex2(c, 0, 0, 1, 0x15, 0xD0)                                  // VUNPCKHPD X2, X0, X0 (d1)
        mc_vex2(c, 1, 0, 1, 0x15, 0xD9)                                  // VUNPCKHPD X3, X1, X1 (d3)
        // Argmin across d0(X0), d1(X2), d2(X1), d3(X3)
        mut ck := 0
        while ck < 4 {
            mut xreg := 0
            if ck == 1 { xreg = 2 } else if ck == 2 { xreg = 1 } else if ck == 3 { xreg = 3 }
            mc_b4(c, 0x66, 0x41, 0x0F, 0x2F); mc_b1(c, 0xC7 | (xreg << 3)) // COMISD Xreg, X15
            jae_km_no := mc_jcc8(c, 0x73)
            mc_vex3(c, 1, 0, 0, 1, 0, 15, 0, 3, 0x10); mc_b1(c, 0xF8 | xreg) // X15 = Xreg
            if ck == 0 { mc_b3(c, 0x49, 0x89, 0xCC) }
            else { mc_b4(c, 0x4C, 0x8D, 0x61, ck) }
            mc_patch_jcc8(c, jae_km_no, buf_len(c))
            ck += 1
        }
        mc_b3(c, 0x48, 0x81, 0xC7); mc_u32(c, 1024)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b4(c, 0x48, 0x83, 0xF9, 16)
        jl_kmc4 := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_kmc4, lp_km_c4)
        // cbase[bid]++, sbase[bid][0..31] += Y5..Y12!
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 184) // RAX = cbase
        mc_b4(c, 0x4A, 0xFF, 0x04, 0xE0)                 // INC QWORD [RAX + R12*8]
        mc_b4(c, 0x48, 0x8B, 0xBC, 0x24); mc_u32(c, 176) // RDI = sbase
        mc_b3(c, 0x4C, 0x89, 0xE0); mc_b4(c, 0x48, 0xC1, 0xE0, 8); mc_b3(c, 0x48, 0x01, 0xC7) // RDI += bid*256
        ch = 0
        while ch < 8 {
            preg := 5 + ch; off := ch * 32
            mc_vex3(c, 0, 0, 0, 1, 0, preg, 1, 1, 0x58)
            if off == 0 { mc_b1(c, 0x07) }
            else if off < 128 { mc_b2(c, 0x47, off) }
            else { mc_b1(c, 0x87); mc_u32(c, off) }
            mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11)
            if off == 0 { mc_b1(c, 0x07) }
            else if off < 128 { mc_b2(c, 0x47, off) }
            else { mc_b1(c, 0x87); mc_u32(c, off) }
            ch += 1
        }
        mc_b3(c, 0x49, 0xFF, 0xC2)
        j_kmi := mc_jmp32(c); mc_patch_rel32(c, j_kmi, lp_km_i)
        mc_patch_rel32(c, jge_kmi_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_km_end := mc_jmp32(c)

        // Scalar fallback
        mc_patch_rel32(c, jz_km_sc, buf_len(c))
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b1(c, 0x37) // X14 = -2.0
        lp_kms_i := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xDA); jge_kmsi := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4C, 0x89, 0xD0); mc_b4(c, 0x48, 0xC1, 0xE0, 8); mc_b4(c, 0x49, 0x8D, 0x34, 0x00)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x7F, 8) // X15 = 1e12
        mc_b3(c, 0x45, 0x31, 0xE4); mc_b3(c, 0x4C, 0x89, 0xCF)
        mc_b4(c, 0x4C, 0x8B, 0xAC, 0x24); mc_u32(c, 168)
        mc_b2(c, 0x31, 0xC9)
        lp_kms_c := buf_len(c)
        mc_b4(c, 0x48, 0x83, 0xF9, 16); jge_kmsc := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0); mc_b2(c, 0x31, 0xD2)
        lp_kms_m := buf_len(c)
        mc_b4(c, 0x48, 0x83, 0xFA, 32); jge_kmsm := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x0C); mc_b1(c, 0xD6)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0x0C); mc_b1(c, 0xD7); mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)
        mc_b3(c, 0x48, 0xFF, 0xC2); j_kmsm := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_kmsm, lp_kms_m)
        mc_patch_jcc8(c, jge_kmsm, buf_len(c))
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xC6)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b3(c, 0x44, 0xCD, 0)
        mc_b4(c, 0x66, 0x41, 0x0F, 0x2F); mc_b1(c, 0xC7); jae_kms_no := mc_jcc8(c, 0x73)
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b1(c, 0xF8); mc_b3(c, 0x49, 0x89, 0xCC)
        mc_patch_jcc8(c, jae_kms_no, buf_len(c))
        mc_b3(c, 0x48, 0x81, 0xC7); mc_u32(c, 256); mc_b3(c, 0x48, 0xFF, 0xC1)
        j_kmsc := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_kmsc, lp_kms_c)
        mc_patch_jcc8(c, jge_kmsc, buf_len(c))
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 184); mc_b4(c, 0x4A, 0xFF, 0x04, 0xE0)
        mc_b4(c, 0x48, 0x8B, 0xBC, 0x24); mc_u32(c, 176)
        mc_b3(c, 0x4C, 0x89, 0xE0); mc_b4(c, 0x48, 0xC1, 0xE0, 8); mc_b3(c, 0x48, 0x01, 0xC7)
        mc_b2(c, 0x31, 0xD2)
        lp_kms_a := buf_len(c)
        mc_b4(c, 0x48, 0x83, 0xFA, 32); jge_kmsa := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x04); mc_b1(c, 0xD7)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0x04); mc_b1(c, 0xD6)
        mc_b4(c, 0xF2, 0x0F, 0x11, 0x04); mc_b1(c, 0xD7)
        mc_b3(c, 0x48, 0xFF, 0xC2); j_kmsa := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_kmsa, lp_kms_a)
        mc_patch_jcc8(c, jge_kmsa, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC2); j_kmsi := mc_jmp32(c); mc_patch_rel32(c, j_kmsi, lp_kms_i)
        mc_patch_rel32(c, jge_kmsi, buf_len(c))

        mc_patch_rel32(c, jmp_km_end, buf_len(c))
        mc_patch_rel32(c, jge_km_dn, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xD8)
        cg_reg_helper(cg, h_ai_kmeans_assign_f64(), s_km, buf_len(c))
    }

    // 37. `h_ai_fir64_f64(px, ph, i0, i1) -> f64`: FMA3 8-output-sample-at-once 64-tap FIR filter!
    if cg_is_helper_used(cg, h_ai_fir64_f64()) {
        mc_align16(c)
        s_fir := buf_len(c)
        mc_ai_enter(c, 0xB8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = px
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = ph (64 taps)
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = i = i0
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = i1
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) // X0 = 0.0
        mc_b3(c, 0x4D, 0x39, 0xDA); jge_fir_dn := mc_jcc32(c, 0x8D)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_fir_sc := mc_jcc32(c, 0x84)

        mc_vex256(c, 1, 6, 6, 6, 0x57) // Y6 = total sum
        mc_vex256(c, 1, 7, 7, 7, 0x57) // Y7 = total sum2
        mc_b4(c, 0x4D, 0x8D, 0x63, 0xF8) // R12 = i1 - 8
        mc_align16_nop(c)
        lp_fir8 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xE2); jg_fir_tail := mc_jcc32(c, 0x8F)
        mc_b4(c, 0x4B, 0x8D, 0x34, 0xD0) // RSI = px + i*8
        mc_vex256(c, 1, 0, 0, 0, 0x57); mc_vex256(c, 1, 1, 1, 1, 0x57)
        mc_b2(c, 0x31, 0xC9) // RCX = k = 0..63 (step 2 -> 32 iters, dual FMA!)
        lp_firk := buf_len(c)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x14, 0xC9)     // Y2 = bcast(ph[k])
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b3(c, 0x5C, 0xC9, 8)  // Y3 = bcast(ph[k+1])
        mc_vex3(c, 0, 0, 0, 2, 1, 2, 1, 1, 0xB8); mc_b2(c, 0x04, 0xCE)     // Y0 += Y2 * [RSI+RCX*8]
        mc_vex3(c, 0, 0, 0, 2, 1, 2, 1, 1, 0xB8); mc_b3(c, 0x4C, 0xCE, 32) // Y1 += Y2 * [RSI+RCX*8+32]
        mc_vex3(c, 0, 0, 0, 2, 1, 3, 1, 1, 0xB8); mc_b3(c, 0x44, 0xCE, 8)  // Y0 += Y3 * [RSI+RCX*8+8]
        mc_vex3(c, 0, 0, 0, 2, 1, 3, 1, 1, 0xB8); mc_b3(c, 0x4C, 0xCE, 40) // Y1 += Y3 * [RSI+RCX*8+40]
        mc_b4(c, 0x48, 0x83, 0xC1, 2); mc_b4(c, 0x48, 0x83, 0xF9, 64)
        jl_firk := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_firk, lp_firk)
        mc_vex256(c, 1, 6, 6, 0, 0x58); mc_vex256(c, 1, 7, 7, 1, 0x58)
        mc_b4(c, 0x49, 0x83, 0xC2, 8)
        j_fir8 := mc_jmp32(c); mc_patch_rel32(c, j_fir8, lp_fir8)
        mc_patch_rel32(c, jg_fir_tail, buf_len(c))
        mc_vex256(c, 1, 6, 6, 7, 0x58)
        _mc_vhsum_pd_to_xmm0(c, 6)
        mc_b3(c, 0xC5, 0xF8, 0x77)

        // Scalar tail & --simd=scalar fallback
        mc_patch_rel32(c, jz_fir_sc, buf_len(c))
        lp_firs := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xDA); jge_firs := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x4B, 0x8D, 0x34, 0xD0)
        mc_b2(c, 0x31, 0xC9)
        lp_firsk := buf_len(c)
        mc_b4(c, 0x48, 0x83, 0xF9, 64); jge_firsk := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x0C); mc_b1(c, 0xCE)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x0C, 0xC9)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_firsk := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_firsk, lp_firsk)
        mc_patch_jcc8(c, jge_firsk, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC2); j_firs := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_firs, lp_firs)
        mc_patch_jcc8(c, jge_firs, buf_len(c))

        mc_patch_rel32(c, jge_fir_dn, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_fir64_f64(), s_fir, buf_len(c))
    }

    // 38. `h_ai_siphash24_4(words, m0, m1) -> i64`: 4-lane AVX2 SipHash-2-4 (32 words/msg)!
    if cg_is_helper_used(cg, h_ai_siphash24_4()) {
        while (buf_len(cg.rdata) & 15) != 0 { buf_push(cg.rdata, 0) }
        roff_sh := buf_len(cg.rdata)
        buf_push_u64(cg.rdata, 0x736f6d6570736575 ^ 0x0706050403020100) // +0:  iv0
        buf_push_u64(cg.rdata, 0x646f72616e646f6d ^ 0x0f0e0d0c0b0a0908) // +8:  iv1
        buf_push_u64(cg.rdata, 0x6c7967656e657261 ^ 0x0706050403020100) // +16: iv2
        buf_push_u64(cg.rdata, 0x7465646279746573 ^ 0x0f0e0d0c0b0a0908) // +24: iv3
        buf_push_u64(cg.rdata, 255)                                      // +32: 0xFF

        mc_align16(c)
        s_sh := buf_len(c)
        mc_ai_enter(c, 0xD8) // [RSP+160..191] = gather/pack temp
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = words
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = mid = m0
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = m1
        mc_b3(c, 0x45, 0x31, 0xFF)       // R15 = acc = 0
        cg_lea_rax_rdata(cg, roff_sh); mc_b3(c, 0x49, 0x89, 0xC6) // R14 = &ivs
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_sh_dn := mc_jcc32(c, 0x8D)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_sh_sc := mc_jcc32(c, 0x84)

        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x59); mc_b1(c, 0x06)     // Y8 = iv0
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x59); mc_b2(c, 0x4E, 8)  // Y9 = iv1
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x59); mc_b2(c, 0x56, 16) // Y10 = iv2
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x59); mc_b2(c, 0x5E, 24) // Y11 = iv3
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x59); mc_b2(c, 0x66, 32) // Y12 = 0xFF
        mc_vex256(c, 1, 15, 15, 15, 0xEF)                            // Y15 = acc_vec = 0
        mc_b4(c, 0x4D, 0x8D, 0x5A, 0xFC) // R11 = m1 - 4
        mc_align16_nop(c)
        lp_sh4 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD9); jg_sh_tail := mc_jcc32(c, 0x8F)
        mc_vex256(c, 1, 0, 0, 8, 0x6F); mc_vex256(c, 1, 1, 0, 9, 0x6F)
        mc_vex256(c, 1, 2, 0, 10, 0x6F); mc_vex256(c, 1, 3, 0, 11, 0x6F)
        // RSI = words + mid*256; RDI=RSI+256; RAX=RSI+512; RDX=RSI+768
        mc_b3(c, 0x4C, 0x89, 0xC8); mc_b4(c, 0x48, 0xC1, 0xE0, 8); mc_b4(c, 0x49, 0x8D, 0x34, 0x00)
        mc_b3(c, 0x48, 0x8D, 0xBE); mc_u32(c, 256)
        mc_b3(c, 0x48, 0x8D, 0x86); mc_u32(c, 512)
        mc_b3(c, 0x48, 0x8D, 0x96); mc_u32(c, 768)
        mc_b2(c, 0x31, 0xC9) // RCX = k = 0..31
        lp_sh4k := buf_len(c)
        // Gather 4 message words into Y4 via stack (L1D store-fwd -> 4 cyc!)
        mc_b4(c, 0x48, 0x8B, 0x1C, 0xCE); mc_b4(c, 0x48, 0x89, 0x9C, 0x24); mc_u32(c, 160)
        mc_b4(c, 0x48, 0x8B, 0x1C, 0xCF); mc_b4(c, 0x48, 0x89, 0x9C, 0x24); mc_u32(c, 168)
        mc_b4(c, 0x48, 0x8B, 0x1C, 0xC8); mc_b4(c, 0x48, 0x89, 0x9C, 0x24); mc_u32(c, 176)
        mc_b4(c, 0x48, 0x8B, 0x1C, 0xCA); mc_b4(c, 0x48, 0x89, 0x9C, 0x24); mc_u32(c, 184)
        _mc_vld_rsp(c, 4, 160)
        mc_vex256(c, 1, 3, 3, 4, 0xEF) // v3 ^= m
        // 2 SipRounds (inline)
        mut sr := 0
        while sr < 2 {
            mc_vex256(c, 1, 0, 0, 1, 0xD4)
            mc_vex3(c, 0, 0, 0, 1, 0, 5, 1, 1, 0x73); mc_b2(c, 0xF1, 13)
            mc_vex3(c, 0, 0, 0, 1, 0, 6, 1, 1, 0x73); mc_b2(c, 0xD1, 51)
            mc_vex256(c, 1, 1, 5, 6, 0xEB); mc_vex256(c, 1, 1, 1, 0, 0xEF)
            mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x70); mc_b2(c, 0xC0, 0xB1) // VPSHUFD Y0, Y0, 0xB1 (rotl32!)
            mc_vex256(c, 1, 2, 2, 3, 0xD4)
            mc_vex3(c, 0, 0, 0, 1, 0, 5, 1, 1, 0x73); mc_b2(c, 0xF3, 16)
            mc_vex3(c, 0, 0, 0, 1, 0, 6, 1, 1, 0x73); mc_b2(c, 0xD3, 48)
            mc_vex256(c, 1, 3, 5, 6, 0xEB); mc_vex256(c, 1, 3, 3, 2, 0xEF)
            mc_vex256(c, 1, 0, 0, 3, 0xD4)
            mc_vex3(c, 0, 0, 0, 1, 0, 5, 1, 1, 0x73); mc_b2(c, 0xF3, 21)
            mc_vex3(c, 0, 0, 0, 1, 0, 6, 1, 1, 0x73); mc_b2(c, 0xD3, 43)
            mc_vex256(c, 1, 3, 5, 6, 0xEB); mc_vex256(c, 1, 3, 3, 0, 0xEF)
            mc_vex256(c, 1, 2, 2, 1, 0xD4)
            mc_vex3(c, 0, 0, 0, 1, 0, 5, 1, 1, 0x73); mc_b2(c, 0xF1, 17)
            mc_vex3(c, 0, 0, 0, 1, 0, 6, 1, 1, 0x73); mc_b2(c, 0xD1, 47)
            mc_vex256(c, 1, 1, 5, 6, 0xEB); mc_vex256(c, 1, 1, 1, 2, 0xEF)
            mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x70); mc_b2(c, 0xD2, 0xB1) // VPSHUFD Y2, Y2, 0xB1 (rotl32!)
            sr += 1
        }
        mc_vex256(c, 1, 0, 0, 4, 0xEF) // v0 ^= m
        mc_b3(c, 0x48, 0xFF, 0xC1); mc_b4(c, 0x48, 0x83, 0xF9, 32)
        jl_sh4k := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_sh4k, lp_sh4k)
        // Finalization: v2 ^= 0xFF, 4 SipRounds
        mc_vex256(c, 1, 2, 2, 12, 0xEF)
        mc_b1(c, 0xB9); mc_u32(c, 4)
        lp_sh4f := buf_len(c)
        mc_vex256(c, 1, 0, 0, 1, 0xD4)
        mc_vex3(c, 0, 0, 0, 1, 0, 5, 1, 1, 0x73); mc_b2(c, 0xF1, 13)
        mc_vex3(c, 0, 0, 0, 1, 0, 6, 1, 1, 0x73); mc_b2(c, 0xD1, 51)
        mc_vex256(c, 1, 1, 5, 6, 0xEB); mc_vex256(c, 1, 1, 1, 0, 0xEF)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x70); mc_b2(c, 0xC0, 0xB1)
        mc_vex256(c, 1, 2, 2, 3, 0xD4)
        mc_vex3(c, 0, 0, 0, 1, 0, 5, 1, 1, 0x73); mc_b2(c, 0xF3, 16)
        mc_vex3(c, 0, 0, 0, 1, 0, 6, 1, 1, 0x73); mc_b2(c, 0xD3, 48)
        mc_vex256(c, 1, 3, 5, 6, 0xEB); mc_vex256(c, 1, 3, 3, 2, 0xEF)
        mc_vex256(c, 1, 0, 0, 3, 0xD4)
        mc_vex3(c, 0, 0, 0, 1, 0, 5, 1, 1, 0x73); mc_b2(c, 0xF3, 21)
        mc_vex3(c, 0, 0, 0, 1, 0, 6, 1, 1, 0x73); mc_b2(c, 0xD3, 43)
        mc_vex256(c, 1, 3, 5, 6, 0xEB); mc_vex256(c, 1, 3, 3, 0, 0xEF)
        mc_vex256(c, 1, 2, 2, 1, 0xD4)
        mc_vex3(c, 0, 0, 0, 1, 0, 5, 1, 1, 0x73); mc_b2(c, 0xF1, 17)
        mc_vex3(c, 0, 0, 0, 1, 0, 6, 1, 1, 0x73); mc_b2(c, 0xD1, 47)
        mc_vex256(c, 1, 1, 5, 6, 0xEB); mc_vex256(c, 1, 1, 1, 2, 0xEF)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x70); mc_b2(c, 0xD2, 0xB1)
        mc_b3(c, 0x48, 0xFF, 0xC9)
        jnz_sh4f := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_sh4f, lp_sh4f)
        mc_vex256(c, 1, 0, 0, 1, 0xEF); mc_vex256(c, 1, 2, 2, 3, 0xEF); mc_vex256(c, 1, 0, 0, 2, 0xEF)
        mc_vex256(c, 1, 15, 15, 0, 0xEF)
        mc_b4(c, 0x49, 0x83, 0xC1, 4)
        j_sh4 := mc_jmp32(c); mc_patch_rel32(c, j_sh4, lp_sh4)
        mc_patch_rel32(c, jg_sh_tail, buf_len(c))
        // XOR-reduce 4 lanes of Y15 into R15
        mc_vex3(c, 1, 0, 0, 3, 0, 0, 1, 1, 0x39); mc_b2(c, 0xF8, 1) // X0 = hi128(Y15)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 1, 0xEF); mc_b1(c, 0xC7)    // X0 ^= X15
        mc_b4(c, 0xC5, 0xF1, 0x73, 0xD8); mc_b1(c, 8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0xEF); mc_b1(c, 0xC1)
        mc_b4(c, 0x66, 0x49, 0x0F, 0x7E); mc_b1(c, 0xC7)            // MOVQ R15, X0
        mc_b3(c, 0xC5, 0xF8, 0x77)

        // Scalar tail & --simd=scalar fallback
        mc_patch_rel32(c, jz_sh_sc, buf_len(c))
        lp_shs := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_shs := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x49, 0x8B, 0x06)       // RAX = v0
        mc_b4(c, 0x49, 0x8B, 0x5E, 8)    // RBX = v1
        mc_b4(c, 0x49, 0x8B, 0x56, 16)   // RDX = v2
        mc_b4(c, 0x49, 0x8B, 0x76, 24)   // RSI = v3
        mc_b3(c, 0x4C, 0x89, 0xCF); mc_b4(c, 0x48, 0xC1, 0xE7, 8); mc_b3(c, 0x4C, 0x01, 0xC7) // RDI = words + mid*256
        mc_b2(c, 0x31, 0xC9) // RCX = k = 0..31
        lp_shsk := buf_len(c)
        mc_b4(c, 0x4C, 0x8B, 0x1C, 0xCF) // R11 = m
        mc_b3(c, 0x4C, 0x31, 0xDE)       // v3 ^= m
        mut srs := 0
        while srs < 2 {
            mc_b3(c, 0x48, 0x01, 0xD8); mc_b4(c, 0x48, 0xC1, 0xC3, 13); mc_b3(c, 0x48, 0x31, 0xC3); mc_b4(c, 0x48, 0xC1, 0xC0, 32)
            mc_b3(c, 0x48, 0x01, 0xF2); mc_b4(c, 0x48, 0xC1, 0xC6, 16); mc_b3(c, 0x48, 0x31, 0xD6)
            mc_b3(c, 0x48, 0x01, 0xF0); mc_b4(c, 0x48, 0xC1, 0xC6, 21); mc_b3(c, 0x48, 0x31, 0xC6)
            mc_b3(c, 0x48, 0x01, 0xDA); mc_b4(c, 0x48, 0xC1, 0xC3, 17); mc_b3(c, 0x48, 0x31, 0xD3); mc_b4(c, 0x48, 0xC1, 0xC2, 32)
            srs += 1
        }
        mc_b3(c, 0x4C, 0x31, 0xD8) // v0 ^= m
        mc_b3(c, 0x48, 0xFF, 0xC1); mc_b4(c, 0x48, 0x83, 0xF9, 32)
        jl_shsk := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_shsk, lp_shsk)
        mc_b3(c, 0x48, 0x81, 0xF2); mc_u32(c, 255)
        mc_b1(c, 0xB9); mc_u32(c, 4)
        lp_shsf := buf_len(c)
        mc_b3(c, 0x48, 0x01, 0xD8); mc_b4(c, 0x48, 0xC1, 0xC3, 13); mc_b3(c, 0x48, 0x31, 0xC3); mc_b4(c, 0x48, 0xC1, 0xC0, 32)
        mc_b3(c, 0x48, 0x01, 0xF2); mc_b4(c, 0x48, 0xC1, 0xC6, 16); mc_b3(c, 0x48, 0x31, 0xD6)
        mc_b3(c, 0x48, 0x01, 0xF0); mc_b4(c, 0x48, 0xC1, 0xC6, 21); mc_b3(c, 0x48, 0x31, 0xC6)
        mc_b3(c, 0x48, 0x01, 0xDA); mc_b4(c, 0x48, 0xC1, 0xC3, 17); mc_b3(c, 0x48, 0x31, 0xD3); mc_b4(c, 0x48, 0xC1, 0xC2, 32)
        mc_b3(c, 0x48, 0xFF, 0xC9); jnz_shsf := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_shsf, lp_shsf)
        mc_b3(c, 0x48, 0x31, 0xD8); mc_b3(c, 0x48, 0x31, 0xD0); mc_b3(c, 0x48, 0x31, 0xF0)
        mc_b3(c, 0x49, 0x31, 0xC7) // R15 ^= hash
        mc_b3(c, 0x49, 0xFF, 0xC1); j_shs := mc_jmp32(c); mc_patch_rel32(c, j_shs, lp_shs)
        mc_patch_rel32(c, jge_shs, buf_len(c))

        mc_patch_rel32(c, jge_sh_dn, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xF8) // RAX = R15
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xD8)
        cg_reg_helper(cg, h_ai_siphash24_4(), s_sh, buf_len(c))
    }
}


fn emit_ai_wave3c2a_helpers(cg: CodegenCtx) {
    c := cg.code

    // 20. `h_ai_floyd_warshall_i32(d, n) -> i64`: In-place 16-wide i16 AVX2 VPADDW+VPMINSW fastpath (when max_path < 16000) + i32 AVX2 + scalar!
    if cg_is_helper_used(cg, h_ai_floyd_warshall_i32()) {
        mc_align16(c)
        s_fw := buf_len(c)
        mc_ai_enter(c, 0x18)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = d
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = n
        mc_b3(c, 0x4D, 0x89, 0xCA); mc_b4(c, 0x49, 0xC1, 0xE2, 2) // R10 = n * 4
        mc_b3(c, 0x4D, 0x85, 0xC9); jle_fw_dn := mc_jcc32(c, 0x8E)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_fw_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x41, 0xF6, 0xC1, 31); jnz_fw_sc2 := mc_jcc32(c, 0x85)

        // Exact i16 fastpath: if n <= 160 and all entries in [0..99] U {1000000000} -> max finite path <= 159*99 = 15741 < 16000!
        mc_b3(c, 0x49, 0x81, 0xF9); mc_u32(c, 160); jg_fw_i32 := mc_jcc32(c, 0x8F)
        mc_b3(c, 0x4C, 0x89, 0xCB); mc_b4(c, 0x49, 0x0F, 0xAF, 0xD9) // RBX = n * n
        mc_b1(c, 0xB8); mc_u32(c, 99)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x6E); mc_b1(c, 0xC0); mc_vex256(c, 2, 0, 0, 0, 0x58) // Y0 = 99
        mc_b1(c, 0xB8); mc_u32(c, 1000000000)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x6E); mc_b1(c, 0xC8); mc_vex256(c, 2, 1, 0, 1, 0x58) // Y1 = 1e9
        mc_vex256(c, 1, 2, 2, 2, 0xEF) // Y2 = 0
        mc_vex256(c, 1, 5, 5, 5, 0xEF) // Y5 = bad_accum = 0
        mc_b2(c, 0x31, 0xC9)
        lp_fw_chk := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x1C, 0x88) // Y3 = d[rcx..rcx+7]
        mc_vex256(c, 1, 4, 2, 3, 0x66) // Y4 = (0 > v)
        mc_vex256(c, 1, 5, 5, 4, 0xEB) // Y5 |= Y4
        mc_vex256(c, 1, 4, 3, 0, 0x66) // Y4 = (v > 99)
        mc_vex256(c, 1, 3, 3, 1, 0x76) // Y3 = (v == 1e9)
        mc_vex256(c, 1, 4, 3, 4, 0xDF) // Y4 = (v != 1e9) & (v > 99)
        mc_vex256(c, 1, 5, 5, 4, 0xEB) // Y5 |= Y4
        mc_b4(c, 0x48, 0x83, 0xC1, 8); mc_b3(c, 0x48, 0x39, 0xD9)
        jl_fw_chk := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_fw_chk, lp_fw_chk)
        mc_vex256(c, 2, 5, 0, 5, 0x17) // VPTEST Y5, Y5
        jnz_fw_i32 := mc_jcc32(c, 0x85)

        // In-place pack i32 -> i16 (1e9 -> 16000, 0..99 -> 0..99)
        mc_b1(c, 0xB8); mc_u32(c, 16000)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x6E); mc_b1(c, 0xC0); mc_vex256(c, 2, 0, 0, 0, 0x58) // Y0 = 16000
        mc_b2(c, 0x31, 0xC9)
        lp_fw_pk := buf_len(c)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x39); mc_b2(c, 0x1C, 0x88)     // VPMINSD Y3, Y0, [R8+RCX*4]
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x39); mc_b3(c, 0x64, 0x88, 32) // VPMINSD Y4, Y0, [R8+RCX*4+32]
        mc_vex256(c, 2, 3, 3, 4, 0x2B)                                      // VPACKUSDW Y3, Y3, Y4
        mc_vex3(c, 0, 0, 0, 3, 1, 0, 1, 1, 0x00); mc_b2(c, 0xDB, 0xD8)     // VPERMQ Y3, Y3, 0xD8
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x1C, 0x48)     // VMOVDQU [R8+RCX*2], Y3
        mc_b4(c, 0x48, 0x83, 0xC1, 16); mc_b3(c, 0x48, 0x39, 0xD9)
        jl_fw_pk := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_fw_pk, lp_fw_pk)

        // 2-row x 32-wide (2x16 i16 = 64B) AVX2 VPADDW+VPMINSW Floyd-Warshall!
        mc_b3(c, 0x49, 0xD1, 0xEA) // R10 = n * 2 (i16 row stride)
        mc_b3(c, 0x45, 0x31, 0xDB) // R11 = k = 0
        mc_b3(c, 0x4D, 0x89, 0xC4) // R12 = row_k = d
        mc_align16_nop(c)
        lp_fw16k := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xCB); jge_fw16k := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x45, 0x31, 0xED) // R13 = i = 0
        mc_b3(c, 0x4D, 0x89, 0xC6) // R14 = row_i = d
        lp_fw16i := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xCD); jge_fw16i := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4F, 0x8D, 0x3C, 0x16)                    // R15 = row_{i+1} = R14 + R10
        mc_b4(c, 0x43, 0x0F, 0xB7, 0x04); mc_b1(c, 0x5E)    // EAX = row_i[k]
        mc_b4(c, 0x43, 0x0F, 0xB7, 0x14); mc_b1(c, 0x5F)    // EDX = row_{i+1}[k]
        mc_b1(c, 0x3D); mc_u32(c, 16000); jge_fw16_s1 := mc_jcc32(c, 0x8D)
        mc_b2(c, 0x81, 0xFA); mc_u32(c, 16000); jge_fw16_s2 := mc_jcc32(c, 0x8D)
        mc_vex3(c, 0, 1, 1, 2, 0, 0, 1, 1, 0x79); mc_b2(c, 0x04, 0x5E) // VPBROADCASTW Y0, [R14+R11*2]
        mc_vex3(c, 0, 1, 1, 2, 0, 0, 1, 1, 0x79); mc_b2(c, 0x0C, 0x5F) // VPBROADCASTW Y1, [R15+R11*2]
        mc_b2(c, 0x31, 0xC9)
        lp_fw16j2 := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x14, 0x4C)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x5C, 0x4C, 32)
        mc_vex256(c, 1, 4, 2, 0, 0xFD); mc_vex256(c, 1, 5, 3, 0, 0xFD)
        mc_vex3(c, 0, 0, 1, 1, 0, 4, 1, 1, 0xEA); mc_b2(c, 0x24, 0x4E)
        mc_vex3(c, 0, 0, 1, 1, 0, 5, 1, 1, 0xEA); mc_b3(c, 0x6C, 0x4E, 32)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x24, 0x4E)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b3(c, 0x6C, 0x4E, 32)
        mc_vex256(c, 1, 2, 2, 1, 0xFD); mc_vex256(c, 1, 3, 3, 1, 0xFD)
        mc_vex3(c, 0, 0, 1, 1, 0, 2, 1, 1, 0xEA); mc_b2(c, 0x14, 0x4F)
        mc_vex3(c, 0, 0, 1, 1, 0, 3, 1, 1, 0xEA); mc_b3(c, 0x5C, 0x4F, 32)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x14, 0x4F)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b3(c, 0x5C, 0x4F, 32)
        mc_b4(c, 0x48, 0x83, 0xC1, 32); mc_b3(c, 0x4C, 0x39, 0xC9)
        jl_fw16j2 := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_fw16j2, lp_fw16j2)
        jmp_fw16i_nx := mc_jmp32(c)

        mc_patch_rel32(c, jge_fw16_s1, buf_len(c))
        mc_patch_rel32(c, jge_fw16_s2, buf_len(c))
        mc_b1(c, 0x3D); mc_u32(c, 16000); jge_fw16r0 := mc_jcc32(c, 0x8D)
        mc_vex3(c, 0, 1, 1, 2, 0, 0, 1, 1, 0x79); mc_b2(c, 0x04, 0x5E)
        mc_b2(c, 0x31, 0xC9)
        lp_fw16r0 := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x0C, 0x4C)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x54, 0x4C, 32)
        mc_vex256(c, 1, 1, 1, 0, 0xFD); mc_vex256(c, 1, 2, 2, 0, 0xFD)
