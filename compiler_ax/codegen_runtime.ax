        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x54, 0x8C, 32)
        mc_vex256(c, 1, 1, 1, 0, 0xFE); mc_vex256(c, 1, 2, 2, 0, 0xFE)
        mc_vex3(c, 0, 0, 1, 2, 0, 1, 1, 1, 0x39); mc_b2(c, 0x0C, 0x8E)
        mc_vex3(c, 0, 0, 1, 2, 0, 2, 1, 1, 0x39); mc_b3(c, 0x54, 0x8E, 32)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x0C, 0x8E)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b3(c, 0x54, 0x8E, 32)
