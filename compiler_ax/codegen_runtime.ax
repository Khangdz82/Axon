        mc_vex3(c, 1, 0, 1, 2, 0, 13, 1, 1, 0xB8); mc_b1(c, 0xD9)          // VFMADD231PS Y11, Y13, Y9
        mc_b4(c, 0x48, 0x83, 0xC1, 16); mc_b3(c, 0x4C, 0x39, 0xE9)
        jle_bn4c := mc_jcc32(c, 0x8E); mc_patch_rel32(c, jle_bn4c, lp_bn4c)
