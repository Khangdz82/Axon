        mc_align16(c)
        s_sc := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xD2); cg_jmp_fn(cg, 0x88, h_sec_trap())
        mc_b3(c, 0x4D, 0x85, 0xC9); cg_jmp_fn(cg, 0x88, h_sec_trap())
        mc_b3(c, 0x49, 0x89, 0xD2); mc_b3(c, 0x4D, 0x01, 0xCA); cg_jmp_fn(cg, 0x80, h_sec_trap())
        mc_b3(c, 0x49, 0x81, 0xFA); mc_u32(c, 0x7FFFFFF0); cg_jmp_fn(cg, 0x8F, h_sec_trap())
        mc_b1(c, 0x53); mc_b2(c, 0x41, 0x54); mc_b2(c, 0x41, 0x55); mc_b2(c, 0x41, 0x56)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x28)
        mc_b3(c, 0x48, 0x89, 0xCB); mc_b3(c, 0x49, 0x89, 0xD4)
        mc_b3(c, 0x4D, 0x89, 0xC5); mc_b3(c, 0x4D, 0x89, 0xCE)
        mc_b3(c, 0x4C, 0x89, 0xE1); mc_b3(c, 0x4C, 0x01, 0xF1)
        cg_call_fn(cg, h_buf_new())
        mc_b3(c, 0x48, 0x89, 0xC1); mc_b3(c, 0x48, 0x89, 0xDA); mc_b3(c, 0x4D, 0x89, 0xE0)
        cg_call_fn(cg, h_jbuf_raw())
        mc_b3(c, 0x48, 0x89, 0xC1); mc_b3(c, 0x4C, 0x89, 0xEA); mc_b3(c, 0x4D, 0x89, 0xF0)
        cg_call_fn(cg, h_jbuf_raw())
        mc_b3(c, 0x48, 0x8B, 0x10)
        mc_b4(c, 0xC6, 0x44, 0x10, 0x10); mc_b1(c, 0)
        mc_b4(c, 0x48, 0x8D, 0x40, 0x10)
        mc_b4(c, 0x48, 0x83, 0xC4, 0x28)
        mc_b2(c, 0x41, 0x5E); mc_b2(c, 0x41, 0x5D); mc_b2(c, 0x41, 0x5C); mc_b1(c, 0x5B)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_str_concat(), s_sc, buf_len(c))
    }

    if cg_is_helper_used(cg, h_pow_i64()) {
        mc_align16(c)
        s_pw := buf_len(c)
        mc_mov_rax_imm(c, 1)
        mc_b3(c, 0x48, 0x85, 0xD2)     // TEST RDX, RDX
        jz_ret := mc_jcc32(c, 0x84)    // JZ ret_1
        jg_pos := mc_jcc8(c, 0x7F)     // JG pos
        mc_b2(c, 0x31, 0xC0)           // XOR EAX, EAX (exp < 0 -> 0)
        mc_b1(c, 0xC3)                 // RET
        mc_patch_jcc8(c, jg_pos, buf_len(c))
        top_pw := buf_len(c)
        mc_b3(c, 0xF6, 0xC2, 0x01)     // TEST DL, 1
        jz_skip := mc_jcc8(c, 0x74)
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1) // IMUL RAX, RCX
        if ibuf_get(cg.state, 0) == 1 {
            cg_jmp_fn(cg, 0x80, h_sec_trap())
        }
        mc_patch_jcc8(c, jz_skip, buf_len(c))
        mc_b3(c, 0x48, 0xD1, 0xEA)     // SHR RDX, 1
        jz_done := mc_jcc8(c, 0x74)    // exit BEFORE squaring base on final bit
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xC9) // IMUL RCX, RCX
        if ibuf_get(cg.state, 0) == 1 {
            cg_jmp_fn(cg, 0x80, h_sec_trap())
        }
        jmp_pw := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_pw, top_pw)
        mc_patch_jcc8(c, jz_done, buf_len(c))
        mc_patch_rel32(c, jz_ret, buf_len(c))
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_pow_i64(), s_pw, buf_len(c))
    }

    if cg_is_helper_used(cg, h_chkstk()) {
        mc_align16(c)
        s_cs := buf_len(c)
        mc_b2(c, 0x51, 0x50)                         // PUSH RCX; PUSH RAX
        mc_b4(c, 0x48, 0x8D, 0x4C, 0x24); mc_b1(c, 24) // LEA RCX, [RSP + 24]
        lp_cs := buf_len(c)
        mc_b3(c, 0x48, 0x81, 0xE9); mc_u32(c, 0x1000) // SUB RCX, 0x1000
        mc_b2(c, 0x85, 0x09)                         // TEST [RCX], ECX
        mc_b1(c, 0x2D); mc_u32(c, 0x1000)             // SUB EAX, 0x1000
        mc_b1(c, 0x3D); mc_u32(c, 0x1000)             // CMP EAX, 0x1000
        ja_cs := mc_jcc8(c, 0x77)                     // JA lp_cs
        mc_patch_jcc8(c, ja_cs, lp_cs)
        mc_b3(c, 0x48, 0x29, 0xC1)                   // SUB RCX, RAX
        mc_b2(c, 0x85, 0x09)                         // TEST [RCX], ECX
        mc_b2(c, 0x58, 0x59)                         // POP RAX; POP RCX
        mc_b1(c, 0xC3)                               // RET
        cg_reg_helper(cg, h_chkstk(), s_cs, buf_len(c))
    }

    // 2. `h_nan_trap(RCX = line)`: `@nan_guard` hardware IEEE-754 NaN/Inf trap -> exit 254
    if cg_is_helper_used(cg, h_nan_trap()) {
        nan_hdr := "[AXON NAN GUARD] IEEE-754 NaN/Inf trapped at line "
        nan_nl := "\n"
        nh_off := cg_intern_lit(cg, nan_hdr)
        nn_off := cg_intern_lit(cg, nan_nl)
        mc_align16(c)
        s_nt := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
        mc_b4(c, 0x48, 0x83, 0xE4, 0xF0)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x30)
        mc_b4(c, 0x48, 0x89, 0x4D, 0xF8) // save line
        cg_lea_rax_rdata(cg, nh_off)
        mc_b3(c, 0x48, 0x89, 0xC1)
        mc_b1(c, 0xBA)
        mc_u32(c, str_len(nan_hdr))
        cg_call_fn(cg, h_print_bytes())
        mc_b4(c, 0x48, 0x8B, 0x4D, 0xF8)
        cg_call_fn(cg, h_print_i64())
        cg_lea_rax_rdata(cg, nn_off)
        mc_b3(c, 0x48, 0x89, 0xC1)
        mc_b1(c, 0xBA)
        mc_u32(c, 1)
        cg_call_fn(cg, h_print_bytes())
        cg_emit_exit_imm(cg, 254)
        cg_reg_helper(cg, h_nan_trap(), s_nt, buf_len(c))
    }

    // 3. `h_par_soa_worker(RCX = tid)`: Win64 `LPTHREAD_START_ROUTINE` for Multi-Core `par_for`!
    if cg_is_helper_used(cg, h_par_soa_worker()) {
        mc_align16(c)
        s_pw := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
        mc_b2(c, 0x56, 0x57) // PUSH RSI; PUSH RDI
        // R9 = tid (RCX), R10 = .data base
        mc_b3(c, 0x49, 0x89, 0xC9) // MOV R9, RCX
        cg_lea_rax_data(cg, 0)
        mc_b3(c, 0x49, 0x89, 0xC2) // MOV R10, RAX

        // RSI = [R10 + 0x40] (src_col_ptr), RDI = [R10 + 0x48] (dst_col_ptr), R11 = [R10 + 0x58] (op_kind)
        mc_b4(c, 0x49, 0x8B, 0x72, 0x40)
        mc_b4(c, 0x49, 0x8B, 0x7A, 0x48)
        mc_b4(c, 0x4D, 0x8B, 0x5A, 0x58)
        // XMM0 = scale_f32 (`[R10 + 0x50]`)
        mc_b4(c, 0x41, 0x8B, 0x42, 0x50)
        mc_b4(c, 0x66, 0x0F, 0x6E, 0xC0) // MOVD XMM0, EAX

        // RAX = start_elem (`[R10 + 0x60 + R9*16]`), RCX = end_elem (`[R10 + 0x68 + R9*16]`)
        mc_b4(c, 0x49, 0xC1, 0xE1, 0x04) // SHL R9, 4
        mc_b3(c, 0x4D, 0x01, 0xCA)       // ADD R10, R9
        mc_b4(c, 0x49, 0x8B, 0x42, 0x60) // RAX = start_elem
        mc_b4(c, 0x49, 0x8B, 0x4A, 0x68) // RCX = end_elem
        mc_b4(c, 0x48, 0xC1, 0xE0, 0x02) // RAX = start_byte
        mc_b4(c, 0x48, 0xC1, 0xE1, 0x02) // RCX = end_byte

        // Check `g_simd_tier` >= 1 for AVX2 32B/iter loop before scalar tail
        mc_b3(c, 0x48, 0x89, 0xC2) // RDX = save RAX
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        mc_b3(c, 0x48, 0x89, 0xD0) // restore RAX = start_byte
        jz_scalar := mc_jcc8(c, 0x74)

        mc_b4(c, 0xC4, 0xE2, 0x7D, 0x18)
        mc_b1(c, 0xC0) // VBROADCASTSS YMM0, XMM0
        avx_top := buf_len(c)
        mc_b4(c, 0x48, 0x8D, 0x50, 0x20) // LEA RDX, [RAX + 32]
        mc_b3(c, 0x48, 0x39, 0xCA)       // CMP RDX, RCX
        ja_stail := mc_jcc8(c, 0x77)
        mc_b4(c, 0xC5, 0xFC, 0x10, 0x14); mc_b1(c, 0x07) // VMOVUPS YMM2, [RDI+RAX]
        mc_b4(c, 0x49, 0x83, 0xFB, 0x02) // CMP R11, 2 (mul-only?)
        je_wmul := mc_jcc8(c, 0x74)
        mc_b4(c, 0xC5, 0xFC, 0x10, 0x0C); mc_b1(c, 0x06) // VMOVUPS YMM1, [RSI+RAX]
        mc_b4(c, 0xC4, 0xE2, 0x75, 0xB8); mc_b1(c, 0xD0) // VFMADD231PS YMM2, YMM1, YMM0
        jmp_wst := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, je_wmul, buf_len(c))
        mc_b4(c, 0xC5, 0xEC, 0x59, 0xD0) // VMULPS YMM2, YMM2, YMM0
        mc_patch_jcc8(c, jmp_wst, buf_len(c))
        mc_b4(c, 0xC5, 0xFC, 0x11, 0x14); mc_b1(c, 0x07) // VMOVUPS [RDI+RAX], YMM2
        mc_b4(c, 0x48, 0x83, 0xC0, 0x20)
        jmp_avxt := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_avxt, avx_top)
        mc_patch_jcc8(c, ja_stail, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77) // VZEROUPPER

        mc_patch_jcc8(c, jz_scalar, buf_len(c))
        // Scalar SSE2 tail loop (`while RAX < RCX`)
        sc_top := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC8)
        jae_wdone := mc_jcc8(c, 0x73)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x14); mc_b1(c, 0x07) // MOVSS XMM2, [RDI+RAX]
        mc_b4(c, 0x49, 0x83, 0xFB, 0x02)
        je_smul := mc_jcc8(c, 0x74)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x0C); mc_b1(c, 0x06) // MOVSS XMM1, [RSI+RAX]
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xC8) // MULSS XMM1, XMM0
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xD1) // ADDSS XMM2, XMM1
        jmp_sst := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, je_smul, buf_len(c))
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xD0) // MULSS XMM2, XMM0
        mc_patch_jcc8(c, jmp_sst, buf_len(c))
        mc_b4(c, 0xF3, 0x0F, 0x11, 0x14); mc_b1(c, 0x07) // MOVSS [RDI+RAX], XMM2
        mc_b4(c, 0x48, 0x83, 0xC0, 0x04)
        jmp_sct := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_sct, sc_top)

        mc_patch_jcc8(c, jae_wdone, buf_len(c))
        mc_b2(c, 0x31, 0xC0) // return 0
        mc_b2(c, 0x5F, 0x5E) // POP RDI; POP RSI
        mc_b1(c, 0x5D)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_par_soa_worker(), s_pw, buf_len(c))
    }

    // 4. `h_alloc_mem` (zeroed) & `h_alloc_mem_raw` (unzeroed safe-buf fastpath):
    //    O(1) Branchless BSR 8-Class Slab Freelist + Zero-Atomic Single-Thread Fast Path + Win64 Heap / Unix mmap / Bare Bump
    mut am_pass := 0
    while am_pass < 2 {
        am_hid := if am_pass == 0 { h_alloc_mem() } else { h_alloc_mem_raw() }
        zero_mem := am_pass == 0
        if cg_is_helper_used(cg, am_hid) {
            mc_align16(c)
            s_am := buf_len(c)
            mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
            mc_b3(c, 0x48, 0x85, 0xC9) // TEST RCX, RCX
            jle_zero := mc_jcc32(c, 0x8E) // <= 0 -> return NULL
            if osm <= 1 {
                mc_b3(c, 0x45, 0x31, 0xC0)             // XOR R8D, R8D (class_tag = 0)
                mc_b3(c, 0x49, 0x89, 0xC9)             // MOV R9, RCX (alloc_size = req)
                mc_b3(c, 0x48, 0x81, 0xF9); mc_u32(c, 507904) // max slab = 496KB (stays strictly < 512KB WinHeap VirtualAlloc cutoff!)
                ja_noslab := mc_jcc32(c, 0x87)
                // Branchless O(1) BSR class tag in 1..8: sizes (64 << tag) + 64 = {192, 320, 576, 1088, 2112, 4160, 8256, 16448}
                mc_b1(c, 0xB8); mc_u32(c, 64)          // MOV EAX, 64
                mc_b3(c, 0x8D, 0x51, 0xBF)             // LEA EDX, [RCX - 65]
                mc_b2(c, 0x81, 0xF9); mc_u32(c, 129)   // CMP ECX, 129
                mc_b3(c, 0x0F, 0x43, 0xC2)             // CMOVAE EAX, EDX
                mc_b4(c, 0x44, 0x0F, 0xBD, 0xC0)       // BSR R8D, EAX (6..13)
                mc_b4(c, 0x41, 0x83, 0xE8, 0x05)       // SUB R8D, 5   (1..8)
                cg_lea_rax_data(cg, data_off_slab_lock())
                mc_b3(c, 0x49, 0x89, 0xC2)             // MOV R10, RAX
                mc_b4(c, 0x41, 0x80, 0x7A, 0x04); mc_b1(c, 0x00) // CMP BYTE PTR [R10 + 4], 0 (mt_active)
                jnz_mt := mc_jcc8(c, 0x75)
                // Single-threaded zero-atomic, zero-taken-branch slab HIT fast path!
                mc_b4(c, 0x4F, 0x8B, 0x1C, 0xC2)       // MOV R11, [R10 + R8*8]
                mc_b3(c, 0x4D, 0x85, 0xDB)             // TEST R11, R11
                jz_miss_st := mc_jcc32(c, 0x84)
                mc_b3(c, 0x49, 0x8B, 0x13)             // MOV RDX, [R11]
                mc_b4(c, 0x4B, 0x89, 0x14, 0xC2)       // MOV [R10 + R8*8], RDX
                mc_b4(c, 0x4B, 0xFF, 0x4C, 0xC2); mc_b1(c, 0x70) // DEC QWORD PTR [R10 + R8*8 + 112]
                hit_ready := buf_len(c)
                mc_b4(c, 0x49, 0xC7, 0x43, 0xE8); mc_u32(c, 1) // MOV QWORD PTR [R11 - 24], 1 (live)
                if zero_mem {
                    mc_b1(c, 0x57)                     // PUSH RDI
                    mc_b3(c, 0x4C, 0x89, 0xDF)         // MOV RDI, R11
                    mc_b4(c, 0x48, 0x83, 0xC1, 0x07)   // ADD RCX, 7
                    mc_b4(c, 0x48, 0xC1, 0xE9, 0x03)   // SHR RCX, 3
                    mc_b2(c, 0x31, 0xC0)               // XOR EAX, EAX
                    mc_b3(c, 0xF3, 0x48, 0xAB)         // REP STOSQ
                    mc_b1(c, 0x5F)                     // POP RDI
                }
                mc_b3(c, 0x4C, 0x89, 0xD8)             // MOV RAX, R11
                mc_b1(c, 0xC3)                         // RET
                // Cold multithreaded TTAS spinlock path
                mc_patch_jcc8(c, jnz_mt, buf_len(c))
                sp_a := buf_len(c)
                mc_b4(c, 0x41, 0x83, 0x3A, 0x00)       // CMP DWORD PTR [R10], 0
                jz_try_a := mc_jcc8(c, 0x74)
                mc_b2(c, 0xF3, 0x90)                   // PAUSE
                jmp_spa := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_spa, sp_a)
                mc_patch_jcc8(c, jz_try_a, buf_len(c))
                mc_b1(c, 0xBA); mc_u32(c, 1)           // MOV EDX, 1
                mc_b3(c, 0x41, 0x87, 0x12)             // XCHG [R10], EDX
                mc_b2(c, 0x85, 0xD2)                   // TEST EDX, EDX
                jnz_retry_a := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_retry_a, sp_a)
                mc_b4(c, 0x4F, 0x8B, 0x1C, 0xC2)       // MOV R11, [R10 + R8*8]
                mc_b3(c, 0x4D, 0x85, 0xDB)             // TEST R11, R11
                jz_miss_mt := mc_jcc8(c, 0x74)
                mc_b3(c, 0x49, 0x8B, 0x13)             // MOV RDX, [R11]
                mc_b4(c, 0x4B, 0x89, 0x14, 0xC2)       // MOV [R10 + R8*8], RDX
                mc_b4(c, 0x4B, 0xFF, 0x4C, 0xC2); mc_b1(c, 0x70)
                mc_b3(c, 0x41, 0xC7, 0x02); mc_u32(c, 0) // unlock
                jmp_hit := mc_jmp32(c); mc_patch_rel32(c, jmp_hit, hit_ready)
                // MT best-fit warm-slab steal (classes 8..13): reuse committed pages before OS HeapAlloc!
                mc_patch_jcc8(c, jz_miss_mt, buf_len(c))
                mc_b4(c, 0x41, 0x83, 0xF8, 10); jl_mts_no := mc_jcc8(c, 0x7C)
                mc_b4(c, 0x49, 0x8D, 0x40, 1)          // RAX = class + 1
                lp_mts := buf_len(c)
                mc_b4(c, 0x48, 0x83, 0xF8, 13); jg_mts_no := mc_jcc8(c, 0x7F)
                mc_b4(c, 0x4D, 0x8B, 0x1C, 0xC2)       // R11 = [R10 + RAX*8]
                mc_b3(c, 0x4D, 0x85, 0xDB); jnz_mts_ok := mc_jcc8(c, 0x75)
                mc_b3(c, 0x48, 0xFF, 0xC0); j_mts := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_mts, lp_mts)
                mc_patch_jcc8(c, jnz_mts_ok, buf_len(c))
                mc_b3(c, 0x49, 0x8B, 0x13)             // RDX = [R11]
                mc_b4(c, 0x49, 0x89, 0x14, 0xC2)       // [R10 + RAX*8] = RDX
                mc_b4(c, 0x49, 0xFF, 0x4C, 0xC2); mc_b1(c, 0x70)
                mc_b3(c, 0x41, 0xC7, 0x02); mc_u32(c, 0) // unlock
                jmp_hit_mts := mc_jmp32(c); mc_patch_rel32(c, jmp_hit_mts, hit_ready)
                mc_patch_jcc8(c, jl_mts_no, buf_len(c))
                mc_patch_jcc8(c, jg_mts_no, buf_len(c))
                mc_b3(c, 0x41, 0xC7, 0x02); mc_u32(c, 0) // unlock before slow path
                jmp_to_slow := mc_jcc8(c, 0xEB)
                // ST best-fit warm-slab steal (classes 8..13)
                mc_patch_rel32(c, jz_miss_st, buf_len(c))
                mc_b4(c, 0x41, 0x83, 0xF8, 10); jl_sts_no := mc_jcc8(c, 0x7C)
                mc_b4(c, 0x49, 0x8D, 0x40, 1)
                lp_sts := buf_len(c)
                mc_b4(c, 0x48, 0x83, 0xF8, 13); jg_sts_no := mc_jcc8(c, 0x7F)
                mc_b4(c, 0x4D, 0x8B, 0x1C, 0xC2)
                mc_b3(c, 0x4D, 0x85, 0xDB); jnz_sts_ok := mc_jcc8(c, 0x75)
                mc_b3(c, 0x48, 0xFF, 0xC0); j_sts := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_sts, lp_sts)
                mc_patch_jcc8(c, jnz_sts_ok, buf_len(c))
                mc_b3(c, 0x49, 0x8B, 0x13)
                mc_b4(c, 0x49, 0x89, 0x14, 0xC2)
                mc_b4(c, 0x49, 0xFF, 0x4C, 0xC2); mc_b1(c, 0x70)
                jmp_hit_sts := mc_jmp32(c); mc_patch_rel32(c, jmp_hit_sts, hit_ready)
                mc_patch_jcc8(c, jl_sts_no, buf_len(c))
                mc_patch_jcc8(c, jg_sts_no, buf_len(c))
                mc_patch_jcc8(c, jmp_to_slow, buf_len(c))
                // Compute slab class size `R9 = (64 << R8D) + 64` only on miss!
                mc_b3(c, 0x44, 0x89, 0xC1)             // MOV ECX, R8D
                mc_b2(c, 0x41, 0xB9); mc_u32(c, 64)    // MOV R9D, 64
                mc_b3(c, 0x49, 0xD3, 0xE1)             // SHL R9, CL
                mc_b4(c, 0x49, 0x83, 0xC1, 0x40)       // ADD R9, 64
                mc_b3(c, 0x49, 0x81, 0xF9); mc_u32(c, 507904)
                jle_c13 := mc_jcc8(c, 0x7E)
                mc_b2(c, 0x41, 0xB9); mc_u32(c, 507904) // clamp class 13 < 512KB WinHeap VirtualAlloc threshold
                mc_patch_jcc8(c, jle_c13, buf_len(c))
                mc_patch_rel32(c, ja_noslab, buf_len(c))

                // Slow path: Win64 ProcessHeap alloc (`R9` bytes + 128 header/align pad, `R8` = class_tag)
                mc_b4(c, 0x55, 0x48, 0x89, 0xE5) // PUSH RBP; MOV RBP, RSP
                mc_b1(c, 0x53)                   // PUSH RBX
                mc_b2(c, 0x41, 0x54)             // PUSH R12 (stack now 16B aligned!)
                mc_b4(c, 0x48, 0x83, 0xEC, 0x20) // SUB RSP, 0x20 (32B shadow space)
                mc_b3(c, 0x4D, 0x89, 0xC4)       // MOV R12, R8 (save class_tag)
                mc_b3(c, 0x4C, 0x89, 0xCB)       // MOV RBX, R9 (alloc_size)
                mc_b3(c, 0x48, 0x81, 0xC3); mc_u32(c, 128) // ADD RBX, 128
                js_ovf := mc_jcc8(c, 0x78)       // guard signed wraparound

                cg_mov_rax_data(cg, data_off_arena_ptr())
                mc_b3(c, 0x48, 0x85, 0xC0)       // TEST RAX, RAX
                jnz_heap := mc_jcc8(c, 0x75)
                cg_call_iat(cg, iat_get_process_heap())
                mc_b3(c, 0x48, 0x85, 0xC0)
                jz_hf1 := mc_jcc8(c, 0x74)
                cg_store_rax_data(cg, data_off_arena_ptr())
                mc_patch_jcc8(c, jnz_heap, buf_len(c))

                mc_b3(c, 0x48, 0x89, 0xC1)       // RCX = hHeap
                if zero_mem {
                    mc_b1(c, 0xBA); mc_u32(c, 8) // EDX = HEAP_ZERO_MEMORY
                } else {
                    mc_b2(c, 0x31, 0xD2)         // EDX = 0
                }
                mc_b3(c, 0x49, 0x89, 0xD8)       // R8  = alloc_size + 128
                cg_call_iat(cg, iat_heap_alloc())
                mc_b3(c, 0x48, 0x85, 0xC0)
                jz_hf2 := mc_jcc8(c, 0x74)

                // Store metadata: `[RDX-8]=raw_ptr`, `[RDX-16]=class_tag`, `[RDX-24]=1 (live)`
                mc_b4(c, 0x48, 0x8D, 0x50, 0x5F) // LEA RDX, [RAX + 95]
                mc_b4(c, 0x48, 0x83, 0xE2, 0xC0) // AND RDX, -64
                mc_b4(c, 0x48, 0x89, 0x42, 0xF8) // MOV [RDX - 8], RAX
                mc_b4(c, 0x4C, 0x89, 0x62, 0xF0) // MOV [RDX - 16], R12
                mc_b4(c, 0x48, 0xC7, 0x42, 0xE8); mc_u32(c, 1) // MOV QWORD PTR [RDX - 24], 1
                mc_b3(c, 0x48, 0x89, 0xD0)       // MOV RAX, RDX
                mc_b4(c, 0x48, 0x83, 0xC4, 0x20)
                mc_b2(c, 0x41, 0x5C)
                mc_b1(c, 0x5B)
                mc_b1(c, 0x5D)
                mc_b1(c, 0xC3)

                fail_off := buf_len(c)
                mc_patch_jcc8(c, js_ovf, fail_off)
                mc_patch_jcc8(c, jz_hf1, fail_off)
                mc_patch_jcc8(c, jz_hf2, fail_off)
                mc_b2(c, 0x31, 0xC0)
                mc_b4(c, 0x48, 0x83, 0xC4, 0x20)
                mc_b2(c, 0x41, 0x5C)
                mc_b1(c, 0x5B)
                mc_b1(c, 0x5D)
                mc_b1(c, 0xC3)
            } else if osm == 2 or osm == 3 {
                mc_b2(c, 0x56, 0x57) // preserve RSI, RDI
                mc_b4(c, 0x48, 0x83, 0xC1, 0x40) // ADD RCX, 64 (reserve metadata header)
                js_mmap_ovf := mc_jcc8(c, 0x78)  // guard signed wraparound
                mc_b3(c, 0x48, 0x89, 0xCE) // RSI = size + 64
                mc_b2(c, 0x31, 0xFF)       // RDI = NULL
                mc_b1(c, 0xBA); mc_u32(c, 3) // PROT_READ | PROT_WRITE
                mc_b3(c, 0x49, 0xC7, 0xC2)
                if osm == 2 { mc_u32(c, 0x22) } else { mc_u32(c, 0x1002) } // MAP_PRIVATE | MAP_ANON
                mc_b3(c, 0x49, 0xC7, 0xC0); mc_u32(c, 0xFFFFFFFF) // R8 = -1
                mc_b3(c, 0x45, 0x31, 0xC9) // R9 = 0
                mc_b1(c, 0xB8)
                if osm == 2 { mc_u32(c, 9) } else { mc_u32(c, 0x20000C5) } // sys_mmap
                mc_b2(c, 0x0F, 0x05)
                // Normalize Linux/macOS `-errno` (`-4095..-1`) to NULL (`0`)
                mc_b2(c, 0x48, 0x3D); mc_u32(c, 0xFFFFF000) // CMP RAX, -4096
                jae_mfail := mc_jcc8(c, 0x73)
                mc_b3(c, 0x48, 0x85, 0xC0) // TEST RAX, RAX
                jz_mfail := mc_jcc8(c, 0x74)
                // Store `[RAX+48] = mapped_len`, `[RAX+40] = 1 (live)`, return `RAX + 64`
                mc_b4(c, 0x48, 0x89, 0x70, 0x30) // MOV [RAX + 48], RSI
                mc_b4(c, 0x48, 0xC7, 0x40, 0x28); mc_u32(c, 1) // MOV QWORD PTR [RAX + 40], 1
                mc_b4(c, 0x48, 0x83, 0xC0, 0x40) // ADD RAX, 64
                mc_b2(c, 0x5F, 0x5E)
                mc_b1(c, 0xC3)
                mfail_off := buf_len(c)
                mc_patch_jcc8(c, js_mmap_ovf, mfail_off)
                mc_patch_jcc8(c, jae_mfail, mfail_off)
                mc_patch_jcc8(c, jz_mfail, mfail_off)
                mc_b2(c, 0x31, 0xC0) // XOR EAX, EAX
                mc_b2(c, 0x5F, 0x5E)
                mc_b1(c, 0xC3)
            } else {
                // Bare-metal / Unikernel bump allocator starting at physical 4 MB (`0x400000`)
                mc_b4(c, 0x48, 0x83, 0xC1, 0x3F)
                mc_b4(c, 0x48, 0x83, 0xE1, 0xC0) // align_up(RCX, 64)
                cg_mov_rax_data(cg, data_off_bare_heap())
                mc_b3(c, 0x48, 0x89, 0xC2) // RDX = old_off
                mc_b3(c, 0x48, 0x01, 0xC8) // RAX = old_off + aligned_size
                cg_store_rax_data(cg, data_off_bare_heap())
                mc_b3(c, 0x48, 0x8D, 0x82)
                mc_u32(c, 0x400000) // LEA RAX, [RDX + 0x400000]
                mc_b1(c, 0xC3)
            }
            mc_patch_rel32(c, jle_zero, buf_len(c))
            mc_b2(c, 0x31, 0xC0)
            mc_b1(c, 0xC3)
            cg_reg_helper(cg, am_hid, s_am, buf_len(c))
        }
        am_pass += 1
    }

    // 5. `h_free_mem(RCX = ptr)`
    if cg_is_helper_used(cg, h_free_mem()) {
        mc_align16(c)
        s_fm := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        mc_b3(c, 0x48, 0x85, 0xC9)
        jz_fm := mc_jcc32(c, 0x84)
        if osm <= 1 {
            mc_b3(c, 0xF6, 0xC1, 0x3F)       // TEST CL, 63 (verify 64B alignment)
            jnz_bad := mc_jcc32(c, 0x85)
            cg_lea_rax_data(cg, data_off_slab_lock())
            mc_b3(c, 0x49, 0x89, 0xC2)       // MOV R10, RAX
            // Double-free guard: fast check in ST mode, atomic XCHG in MT mode
            mc_b4(c, 0x41, 0x80, 0x7A, 0x04); mc_b1(c, 0x00) // CMP BYTE PTR [R10 + 4], 0
            jnz_df_mt := mc_jcc8(c, 0x75)
            mc_b4(c, 0x48, 0x83, 0x79, 0xE8); mc_b1(c, 0x01) // CMP QWORD PTR [RCX - 24], 1
            jne_df := mc_jcc32(c, 0x85)
            mc_b4(c, 0x48, 0xC7, 0x41, 0xE8); mc_u32(c, 0) // MOV QWORD PTR [RCX - 24], 0
            jmp_df_ok := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, jnz_df_mt, buf_len(c))
            mc_b2(c, 0x31, 0xC0)             // XOR EAX, EAX
            mc_b4(c, 0x48, 0x87, 0x41, 0xE8) // XCHG [RCX - 24], RAX (implicit LOCK)
            mc_b4(c, 0x48, 0x83, 0xF8, 0x01) // CMP RAX, 1
            jne_df_mt := mc_jcc32(c, 0x85)
            mc_patch_jcc8(c, jmp_df_ok, buf_len(c))
            // Return slab-sized blocks (`1 <= tag <= 13`, up to 512KB!) to freelist (cap 64 for <=16KB, cap 4 for 32..512KB)
            mc_b4(c, 0x4C, 0x8B, 0x41, 0xF0) // MOV R8, [RCX - 16] (class_tag)
            mc_b3(c, 0x4D, 0x85, 0xC0)
            jz_osfree := mc_jcc32(c, 0x84)
            mc_b4(c, 0x49, 0x83, 0xF8, 0x0D) // CMP R8, 13
            ja_osfree := mc_jcc32(c, 0x87)
            // Compute per-class cap in R9: 64 if R8 <= 8 else 4
            mc_b2(c, 0x41, 0xB9); mc_u32(c, 64)
            mc_b4(c, 0x49, 0x83, 0xF8, 0x08)
            jbe_c64 := mc_jcc8(c, 0x76)
            mc_b2(c, 0x41, 0xB9); mc_u32(c, 4)
            mc_patch_jcc8(c, jbe_c64, buf_len(c))
            mc_b4(c, 0x41, 0x80, 0x7A, 0x04); mc_b1(c, 0x00) // CMP BYTE PTR [R10 + 4], 0 (mt_active)
            jnz_mt_f := mc_jcc8(c, 0x75)
            // Single-threaded zero-atomic freelist push!
            mc_b4(c, 0x4F, 0x39, 0x4C, 0xC2); mc_b1(c, 0x70) // CMP QWORD PTR [R10 + R8*8 + 112], R9
            jae_full_st := mc_jcc32(c, 0x83)
            mc_b4(c, 0x4B, 0x8B, 0x14, 0xC2) // MOV RDX, [R10 + R8*8]
            mc_b3(c, 0x48, 0x89, 0x11)       // MOV [RCX], RDX
            mc_b4(c, 0x4B, 0x89, 0x0C, 0xC2) // MOV [R10 + R8*8], RCX
            mc_b4(c, 0x4B, 0xFF, 0x44, 0xC2); mc_b1(c, 0x70) // INC QWORD PTR [R10 + R8*8 + 112]
            mc_b1(c, 0xC3)                   // RET
            // Cold multithreaded TTAS spinlock path
            mc_patch_jcc8(c, jnz_mt_f, buf_len(c))
            sp_f := buf_len(c)
            mc_b4(c, 0x41, 0x83, 0x3A, 0x00) // CMP DWORD PTR [R10], 0
            jz_try_f := mc_jcc8(c, 0x74)
            mc_b2(c, 0xF3, 0x90)
            jmp_spf := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_spf, sp_f)
            mc_patch_jcc8(c, jz_try_f, buf_len(c))
            mc_b1(c, 0xBA); mc_u32(c, 1)
            mc_b3(c, 0x41, 0x87, 0x12)       // XCHG [R10], EDX
            mc_b2(c, 0x85, 0xD2)
            jnz_retry_f := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_retry_f, sp_f)
            mc_b4(c, 0x4F, 0x39, 0x4C, 0xC2); mc_b1(c, 0x70) // CMP QWORD PTR [R10 + R8*8 + 112], R9
            jae_full := mc_jcc8(c, 0x73)
            mc_b4(c, 0x4B, 0x8B, 0x14, 0xC2) // MOV RDX, [R10 + R8*8]
            mc_b3(c, 0x48, 0x89, 0x11)       // MOV [RCX], RDX
            mc_b4(c, 0x4B, 0x89, 0x0C, 0xC2) // MOV [R10 + R8*8], RCX
            mc_b4(c, 0x4B, 0xFF, 0x44, 0xC2); mc_b1(c, 0x70) // INC QWORD PTR [R10 + R8*8 + 112]
            mc_b3(c, 0x41, 0xC7, 0x02); mc_u32(c, 0) // unlock
            mc_b1(c, 0xC3)                   // RET
            mc_patch_jcc8(c, jae_full, buf_len(c))
            mc_b3(c, 0x41, 0xC7, 0x02); mc_u32(c, 0) // unlock before OS HeapFree
            os_free_lbl := buf_len(c)
            mc_patch_rel32(c, jz_osfree, os_free_lbl)
            mc_patch_rel32(c, ja_osfree, os_free_lbl)
            mc_patch_rel32(c, jae_full_st, os_free_lbl)

            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b4(c, 0x48, 0x83, 0xEC, 0x20)
            mc_b4(c, 0x4C, 0x8B, 0x41, 0xF8) // R8 = raw heap ptr `[RCX - 8]`
            mc_b3(c, 0x4D, 0x85, 0xC0)
            jz_nr := mc_jcc8(c, 0x74)
            mc_b4(c, 0x48, 0xC7, 0x41, 0xF8); mc_u32(c, 0)
            cg_mov_rax_data(cg, data_off_arena_ptr())
            mc_b3(c, 0x48, 0x85, 0xC0)
            jz_nh := mc_jcc8(c, 0x74)
            mc_b3(c, 0x48, 0x89, 0xC1)       // RCX = hHeap
            mc_b2(c, 0x31, 0xD2)             // EDX = 0
            cg_call_iat(cg, iat_heap_free())
            ep_fm := buf_len(c)
            mc_patch_jcc8(c, jz_nr, ep_fm)
            mc_patch_jcc8(c, jz_nh, ep_fm)
            mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
            mc_patch_rel32(c, jnz_bad, buf_len(c))
            mc_patch_rel32(c, jne_df, buf_len(c))
            mc_patch_rel32(c, jne_df_mt, buf_len(c))
        } else if osm == 2 or osm == 3 {
            mc_b3(c, 0xF6, 0xC1, 0x3F)       // TEST CL, 63 (verify 64B alignment)
            jnz_ubad := mc_jcc8(c, 0x75)
            mc_b2(c, 0x31, 0xC0)             // XOR EAX, EAX
            mc_b4(c, 0x48, 0x87, 0x41, 0xE8) // XCHG [RCX - 24], RAX (atomic double-free guard)
            mc_b4(c, 0x48, 0x83, 0xF8, 0x01) // CMP RAX, 1
            jne_udf := mc_jcc8(c, 0x75)
            mc_b2(c, 0x56, 0x57)             // preserve RSI, RDI
            mc_b4(c, 0x48, 0x8B, 0x71, 0xF0) // MOV RSI, [RCX - 16] (mapped_len)
            mc_b4(c, 0x48, 0x8D, 0x79, 0xC0) // LEA RDI, [RCX - 64] (base mmap ptr)
            mc_b1(c, 0xB8)
            if osm == 2 { mc_u32(c, 11) } else { mc_u32(c, 0x2000049) } // SYS_munmap
            mc_b2(c, 0x0F, 0x05)
            mc_b2(c, 0x5F, 0x5E)             // restore RDI, RSI
            mc_patch_jcc8(c, jnz_ubad, buf_len(c))
            mc_patch_jcc8(c, jne_udf, buf_len(c))
        }
        mc_patch_rel32(c, jz_fm, buf_len(c))
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_free_mem(), s_fm, buf_len(c))
    }

    // 6. `h_stdin_read_line(RCX = ByteBuf_ptr) -> RAX = line_len_or_minus1` (Win64 ReadFile / Unix SYS_read(0))
    if cg_is_helper_used(cg, h_stdin_read_line()) {
        mc_align16(c)
        s_rl := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
        mc_b1(c, 0x53)             // PUSH RBX
        mc_b2(c, 0x41, 0x54)       // PUSH R12
        mc_b2(c, 0x41, 0x55)       // PUSH R13
        mc_b4(c, 0x48, 0x83, 0xEC, 0x48)
        mc_b3(c, 0x48, 0x89, 0xCB) // RBX = ByteBuf ptr
        mc_b3(c, 0x48, 0x85, 0xDB)
        jz_null := mc_jcc32(c, 0x84)
        mc_b3(c, 0x48, 0xC7, 0x03); mc_u32(c, 0) // [RBX] = 0 (len = 0)
        mc_b3(c, 0x45, 0x31, 0xED) // R13 = 0 (cur_len)

        if osm <= 1 {
            mc_b1(c, 0xB9); mc_u32(c, 0xFFFFFFF6) // STD_INPUT_HANDLE (-10)
            cg_call_iat(cg, iat_get_std_handle())
            mc_b3(c, 0x49, 0x89, 0xC4) // R12 = hStdin

            rd_loop := buf_len(c)
            mc_b3(c, 0xC7, 0x45, 0xD8); mc_u32(c, 0) // [RBP-0x28] = 0 (nread)
            mc_b3(c, 0x4C, 0x89, 0xE1)               // RCX = R12
            mc_b4(c, 0x48, 0x8D, 0x55, 0xE0)         // RDX = &ch ([RBP-0x20])
            mc_b3(c, 0x41, 0xB8, 0x01); mc_b3(c, 0x00, 0x00, 0x00) // R8D = 1
            mc_b4(c, 0x4C, 0x8D, 0x4D, 0xD8)         // R9 = &nread ([RBP-0x28])
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 0x20); mc_u32(c, 0)
            cg_call_iat(cg, iat_read_file())
            mc_b2(c, 0x85, 0xC0)
            jz_eof1 := mc_jcc8(c, 0x74)
            mc_b4(c, 0x83, 0x7D, 0xD8, 0x00)
            je_eof2 := mc_jcc8(c, 0x74)

            mc_b4(c, 0x0F, 0xB6, 0x45, 0xE0) // MOVZX EAX, BYTE [RBP-0x20]
            mc_b2(c, 0x3C, 10)
            je_nl := mc_jcc8(c, 0x74)
            mc_b2(c, 0x3C, 13)
            je_cr := mc_jcc8(c, 0x74)

            mc_b4(c, 0x4C, 0x3B, 0x6B, 0x08) // CMP R13, [RBX+8]
            jae_full := mc_jcc8(c, 0x73)
            mc_b4(c, 0x48, 0x8D, 0x4B, 0x10) // LEA RCX, [RBX+16]
            mc_b3(c, 0x4C, 0x01, 0xE9)       // ADD RCX, R13
            mc_b2(c, 0x88, 0x01)             // MOV [RCX], AL
            mc_b3(c, 0x49, 0xFF, 0xC5)       // INC R13

            mc_patch_jcc8(c, je_cr, rd_loop)
            mc_patch_jcc8(c, jae_full, rd_loop)
            jmp_rd := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, jmp_rd, rd_loop)

            mc_patch_jcc8(c, jz_eof1, buf_len(c))
            mc_patch_jcc8(c, je_eof2, buf_len(c))
            mc_b3(c, 0x4D, 0x85, 0xED)
            jnz_part := mc_jcc8(c, 0x75)
            mc_b3(c, 0x48, 0xC7, 0xC0); mc_u32(c, 0xFFFFFFFF) // RAX = -1
            jmp_done1 := mc_jcc8(c, 0xEB)

            mc_patch_jcc8(c, je_nl, buf_len(c))
            mc_patch_jcc8(c, jnz_part, buf_len(c))
            mc_b3(c, 0x4C, 0x89, 0x2B) // [RBX] = R13
            mc_b3(c, 0x4C, 0x89, 0xE8) // RAX = R13
            mc_patch_jcc8(c, jmp_done1, buf_len(c))
        } else if osm == 2 or osm == 3 {
            mc_b4(c, 0x48, 0x89, 0x75, 0xD0) // save RSI
            mc_b4(c, 0x48, 0x89, 0x7D, 0xC8) // save RDI
            urd_loop := buf_len(c)
            mc_b2(c, 0x31, 0xFF)             // EDI = 0 (stdin)
            mc_b4(c, 0x48, 0x8D, 0x75, 0xE0) // RSI = &ch
            mc_b1(c, 0xBA); mc_u32(c, 1)     // EDX = 1
            mc_b1(c, 0xB8)
            if osm == 2 { mc_u32(c, 0) } else { mc_u32(c, 0x2000003) } // sys_read
            mc_b2(c, 0x0F, 0x05)
            mc_b3(c, 0x48, 0x85, 0xC0)
            jle_ueof := mc_jcc8(c, 0x7E)

            mc_b4(c, 0x0F, 0xB6, 0x45, 0xE0)
            mc_b2(c, 0x3C, 10)
            je_unl := mc_jcc8(c, 0x74)
            mc_b2(c, 0x3C, 13)
            je_ucr := mc_jcc8(c, 0x74)

            mc_b4(c, 0x4C, 0x3B, 0x6B, 0x08)
            jae_ufull := mc_jcc8(c, 0x73)
            mc_b4(c, 0x48, 0x8D, 0x4B, 0x10)
            mc_b3(c, 0x4C, 0x01, 0xE9)
            mc_b2(c, 0x88, 0x01)
            mc_b3(c, 0x49, 0xFF, 0xC5)

            mc_patch_jcc8(c, je_ucr, urd_loop)
            mc_patch_jcc8(c, jae_ufull, urd_loop)
            jmp_urd := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, jmp_urd, urd_loop)

            mc_patch_jcc8(c, jle_ueof, buf_len(c))
            mc_b3(c, 0x4D, 0x85, 0xED)
            jnz_upart := mc_jcc8(c, 0x75)
            mc_b3(c, 0x48, 0xC7, 0xC0); mc_u32(c, 0xFFFFFFFF)
            jmp_udone := mc_jcc8(c, 0xEB)

            mc_patch_jcc8(c, je_unl, buf_len(c))
            mc_patch_jcc8(c, jnz_upart, buf_len(c))
            mc_b3(c, 0x4C, 0x89, 0x2B)
            mc_b3(c, 0x4C, 0x89, 0xE8)
            mc_patch_jcc8(c, jmp_udone, buf_len(c))
            mc_b4(c, 0x48, 0x8B, 0x75, 0xD0)
            mc_b4(c, 0x48, 0x8B, 0x7D, 0xC8)
        } else {
            mc_b3(c, 0x48, 0xC7, 0xC0); mc_u32(c, 0xFFFFFFFF)
        }

        jmp_rl_end := mc_jcc8(c, 0xEB)
        mc_patch_rel32(c, jz_null, buf_len(c))
        mc_b3(c, 0x48, 0xC7, 0xC0); mc_u32(c, 0xFFFFFFFF)
        mc_patch_jcc8(c, jmp_rl_end, buf_len(c))

        mc_b4(c, 0x48, 0x83, 0xC4, 0x48)
        mc_b2(c, 0x41, 0x5D)
        mc_b2(c, 0x41, 0x5C)
        mc_b1(c, 0x5B)
        mc_b1(c, 0x5D)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_stdin_read_line(), s_rl, buf_len(c))
    }

    // 7. `h_os_exec(RCX = cmd_ptr, RDX = cmd_len) -> RAX = exit_code` (Win64 Zero-CRT CreateProcessA)
    if cg_is_helper_used(cg, h_os_exec()) {
        mc_align16(c)
        s_ox := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        if osm <= 1 {
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b3(c, 0x53, 0x56, 0x57) // PUSH RBX; PUSH RSI; PUSH RDI
            mc_b3(c, 0x48, 0x81, 0xEC); mc_u32(c, 0x528)
            mc_b3(c, 0x48, 0x89, 0xCE) // RSI = cmd_ptr
            mc_b3(c, 0x48, 0x89, 0xD3) // RBX = cmd_len
            mc_b3(c, 0x48, 0x85, 0xF6) // TEST RSI, RSI
            jz_null_cmd := mc_jcc32(c, 0x84)
            mc_b3(c, 0x48, 0x85, 0xDB) // TEST RBX, RBX
            jle_bad_len := mc_jcc32(c, 0x8E) // <= 0 -> reject empty/negative command length
            mc_b3(c, 0x48, 0x81, 0xFB); mc_u32(c, 1000)
            jle_cl := mc_jcc8(c, 0x7E)
            mc_b3(c, 0x48, 0xC7, 0xC3); mc_u32(c, 1000)
            mc_patch_jcc8(c, jle_cl, buf_len(c))

            // Zero `PROCESS_INFORMATION` (`[RSP+0x50]`) + `STARTUPINFOA` (`[RSP+0x80]`) = 22 qwords
            mc_b4(c, 0x48, 0x8D, 0x7C, 0x24); mc_b1(c, 0x50)
            mc_b1(c, 0xB9); mc_u32(c, 22)
            mc_b2(c, 0x31, 0xC0)
            mc_b3(c, 0xF3, 0x48, 0xAB)

            // Copy `cmd_ptr[0..RBX]` into mutable `[RSP + 0x100]` rejecting embedded NUL (CWE-158)
            mc_b4(c, 0x48, 0x8D, 0xBC, 0x24); mc_u32(c, 0x100)
            mc_b3(c, 0x48, 0x31, 0xC9) // XOR RCX, RCX
            ox_cp := buf_len(c)
            mc_b3(c, 0x48, 0x39, 0xD9) // CMP RCX, RBX
            ox_dn := mc_jcc8(c, 0x73) // JAE ox_done
            mc_b3(c, 0x8A, 0x04, 0x0E) // MOV AL, [RSI + RCX]
            mc_b2(c, 0x84, 0xC0)       // TEST AL, AL
            jz_nul_cmd := mc_jcc32(c, 0x84)
            mc_b3(c, 0x88, 0x04, 0x0F) // MOV [RDI + RCX], AL
            mc_b3(c, 0x48, 0xFF, 0xC1) // INC RCX
            ox_lp := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, ox_lp, ox_cp)
            mc_patch_jcc8(c, ox_dn, buf_len(c))
            mc_b4(c, 0xC6, 0x04, 0x1F, 0x00) // MOV BYTE PTR [RDI + RBX], 0

            // `STARTUPINFOA.cb = 104` (+ STARTF_USESHOWWINDOW + CREATE_NO_WINDOW for `--gui` subsystem apps)
            mc_b3(c, 0xC7, 0x84, 0x24); mc_u32(c, 0x80); mc_u32(c, 104)
            is_gui_exec := ibuf_get(cg.state, 240) == 1
            if is_gui_exec {
                mc_b3(c, 0xC7, 0x84, 0x24); mc_u32(c, 0xBC); mc_u32(c, 1) // dwFlags = STARTF_USESHOWWINDOW (wShowWindow=0 SW_HIDE)
            }

            // Stack args 5..10 for `CreateProcessA`
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 0x20); mc_u32(c, 1) // bInheritHandles = TRUE
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 0x28); mc_u32(c, if is_gui_exec { 0x08000000 } else { 0 }) // dwCreationFlags (CREATE_NO_WINDOW on GUI)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 0x30); mc_u32(c, 0)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 0x38); mc_u32(c, 0)
            mc_b4(c, 0x48, 0x8D, 0x84, 0x24); mc_u32(c, 0x80)
            mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 0x40) // lpStartupInfo
            mc_b4(c, 0x48, 0x8D, 0x44, 0x24); mc_b1(c, 0x50)
            mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 0x48) // lpProcessInformation

            mc_b2(c, 0x31, 0xC9) // RCX = NULL
            mc_b4(c, 0x48, 0x8D, 0x94, 0x24); mc_u32(c, 0x100) // RDX = lpCommandLine
            mc_b3(c, 0x45, 0x31, 0xC0) // R8 = NULL
            mc_b3(c, 0x45, 0x31, 0xC9) // R9 = NULL
            cg_call_iat(cg, iat_create_process_a())
            mc_b2(c, 0x85, 0xC0)
            jz_fail := mc_jcc32(c, 0x84)

            // WaitForSingleObject(hProcess, INFINITE)
            mc_b4(c, 0x48, 0x8B, 0x4C, 0x24); mc_b1(c, 0x50)
            mc_b1(c, 0xBA); mc_u32(c, 0xFFFFFFFF)
            cg_call_iat(cg, iat_wait_single())

            // GetExitCodeProcess(hProcess, &exit_code)
            mc_b4(c, 0xC7, 0x44, 0x24, 0x78); mc_u32(c, 0)
            mc_b4(c, 0x48, 0x8B, 0x4C, 0x24); mc_b1(c, 0x50)
            mc_b4(c, 0x48, 0x8D, 0x54, 0x24); mc_b1(c, 0x78)
            cg_call_iat(cg, iat_get_exit_code())

            // CloseHandle(hProcess) & CloseHandle(hThread)
            mc_b4(c, 0x48, 0x8B, 0x4C, 0x24); mc_b1(c, 0x50)
            cg_call_iat(cg, iat_close_handle())
            mc_b4(c, 0x48, 0x8B, 0x4C, 0x24); mc_b1(c, 0x58)
            cg_call_iat(cg, iat_close_handle())

            mc_b4(c, 0x8B, 0x44, 0x24, 0x78) // RAX = exit_code
            jmp_ox_ok := mc_jmp32(c)

            mc_patch_rel32(c, jz_null_cmd, buf_len(c))
            mc_patch_rel32(c, jz_nul_cmd, buf_len(c))
            mc_patch_rel32(c, jle_bad_len, buf_len(c))
            mc_patch_rel32(c, jz_fail, buf_len(c))
            mc_b3(c, 0x48, 0xC7, 0xC0); mc_u32(c, 0xFFFFFFFF)
            mc_patch_rel32(c, jmp_ox_ok, buf_len(c))

            mc_b3(c, 0x48, 0x81, 0xC4); mc_u32(c, 0x528)
            mc_b3(c, 0x5F, 0x5E, 0x5B) // POP RDI; POP RSI; POP RBX
            mc_b1(c, 0x5D)
            mc_b1(c, 0xC3)
        } else {
            mc_b2(c, 0x31, 0xC0)
            mc_b1(c, 0xC3)
        }
        cg_reg_helper(cg, h_os_exec(), s_ox, buf_len(c))
    }
}

// Propagates transitive helper dependencies and emits ONLY helpers actually called by the binary.
fn emit_used_runtime_helpers(cg: CodegenCtx) {
    if cg_is_helper_used(cg, h_shield_verify()) {
        cg_mark_helper_used(cg, h_shield_trap())
    }
    if cg_is_helper_used(cg, h_args_count()) {
        cg_mark_helper_used(cg, h_args_get())
    }
    if cg_is_helper_used(cg, h_nan_trap()) {
        cg_mark_helper_used(cg, h_print_i64())
        cg_mark_helper_used(cg, h_print_bytes())
    }
    if cg_is_helper_used(cg, h_print_dec()) {
        cg_mark_helper_used(cg, h_print_i64())
        cg_mark_helper_used(cg, h_print_bytes())
    }
    if cg_is_helper_used(cg, h_print_i64()) {
        cg_mark_helper_used(cg, h_print_bytes())
    }
    if cg_is_helper_used(cg, h_pow_i64()) and ibuf_get(cg.state, 0) == 1 {
        cg_mark_helper_used(cg, h_sec_trap())
    }
    if cg_is_helper_used(cg, h_shield_trap()) {
        cg_mark_helper_used(cg, h_print_bytes())
    }
    if cg_is_helper_used(cg, h_fs_read()) and not cg_is_win64(cg) {
        cg_mark_helper_used(cg, h_alloc_mem())
    }
    if cg_is_helper_used(cg, h_ai_gemv_f32()) or cg_is_helper_used(cg, h_ai_gemv2_f32()) or cg_is_helper_used(cg, h_ai_gemm_f32()) or cg_is_helper_used(cg, h_ai_gemm_f64()) or cg_is_helper_used(cg, h_ai_gemv_q8_0()) or cg_is_helper_used(cg, h_ai_gemv_q4_0()) or cg_is_helper_used(cg, h_ai_gemv_bitnet()) or cg_is_helper_used(cg, h_ai_gemv_bnn()) or cg_is_helper_used(cg, h_ai_l2_batch()) or cg_is_helper_used(cg, h_ai_bnn_popcnt()) {
        cg_mark_helper_used(cg, h_ai_pool_dispatch())
    }
    if cg_is_helper_used(cg, h_ai_gemv_bnn()) {
        cg_mark_helper_used(cg, h_alloc_mem())
        cg_mark_helper_used(cg, h_free_mem())
    }
    if cg_is_helper_used(cg, h_ai_pool_dispatch()) or cg_is_helper_used(cg, h_ai_pool_dispatch_n()) {
        cg_mark_helper_used(cg, h_alloc_mem())
        cg_mark_helper_used(cg, h_ai_pool_worker())
        cg_mark_helper_used(cg, h_sec_trap())
        cg_mark_helper_used(cg, h_print_bytes())
    }
    if cg_is_helper_used(cg, h_sec_trap()) {
        cg_mark_helper_used(cg, h_print_i64())
        cg_mark_helper_used(cg, h_print_bytes())
    }

    emit_v7_core_helpers_used(cg)

    c := cg.code
    osm := cg_os_mode(cg)

    if cg_is_helper_used(cg, h_shield_verify()) {
        poly_seed := ibuf_get(cg.state, 15)
        mc_align16(c)
        s_sv := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA) // ENDBR64 (also verified inline by every `@shield` fn!)
        mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
        mut jne_peb_dbg := 0
        mut jnz_ntgf := 0
        if osm <= 1 {
            // Layer 1: Zero-API Kernel PEB Anti-Debug (immune to `IsDebuggerPresent` IAT hooks!)
            // MOV RAX, GS:[0x60] (PEB)
            mc_b4(c, 0x65, 0x48, 0x8B, 0x04); mc_b1(c, 0x25); mc_u32(c, 0x60)
            // CMP BYTE PTR [RAX + 0x02], 0 (`PEB.BeingDebugged`)
            mc_b4(c, 0x80, 0x78, 0x02, 0x00)
            jne_peb_dbg = mc_jcc32(c, 0x85)
            // TEST DWORD PTR [RAX + 0xBC], 0x70 (`PEB.NtGlobalFlag` heap debug flags)
            mc_b2(c, 0xF7, 0x80); mc_u32(c, 0xBC); mc_u32(c, 0x70)
            jnz_ntgf = mc_jcc32(c, 0x85)
        }
        // Layer 1b: Caller Return-Address INT3 (0xCC) Step-Out Breakpoint Trap
        mc_b4(c, 0x48, 0x8B, 0x45, 0x08) // MOV RAX, [RBP + 8] (caller return RIP)
        mc_b3(c, 0x80, 0x38, 0xCC)       // CMP BYTE PTR [RAX], 0xCC
        je_ret_bp := mc_jcc32(c, 0x84)
        // Layer 2: RDTSC Anti-Single-Step Start Timestamp -> R11
        mc_b2(c, 0x0F, 0x31)             // RDTSC
        mc_b4(c, 0x48, 0xC1, 0xE2, 0x20) // SHL RDX, 32
        mc_b3(c, 0x48, 0x09, 0xD0)       // OR  RAX, RDX
        mc_b3(c, 0x49, 0x89, 0xC3)       // MOV R11, RAX

        // Layer 3: Polymorphic `.text` Code Integrity MAC (`0 .. s_sv`)
        mc_b3(c, 0x48, 0x8D, 0x0D)
        disp0 := 0 - (buf_len(c) + 4)
        mc_u32(c, disp0)
        mc_b1(c, 0xBA)
        ibuf_set(cg.state, 2, buf_len(c))
        mc_u32(c, 0)
        mc_b2(c, 0x48, 0xB8)
        mc_u64(c, poly_seed ^ 0xcbf29ce484222325)
        mc_b2(c, 0x49, 0xB8)
        mc_u64(c, 0x9E3779B97F4A7C15)
        mc_b2(c, 0x49, 0xBA)
        mc_u64(c, poly_seed)

        ltop := buf_len(c)
        mc_b2(c, 0x32, 0x01)
        mc_b4(c, 0x48, 0xC1, 0xC0, 0x0D)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC0)
        mc_b3(c, 0x4C, 0x01, 0xD0)
        mc_b3(c, 0x48, 0xFF, 0xC1)
        mc_b2(c, 0xFF, 0xCA)
        jnz_p := mc_jcc8(c, 0x75)
        mc_patch_jcc8(c, jnz_p, ltop)

        // RDTSC End Timestamp & Single-Step Check (preserves computed MAC in RAX via PUSH/POP!)
        mc_b1(c, 0x50)                   // PUSH RAX
        mc_b2(c, 0x0F, 0x31)             // RDTSC
        mc_b4(c, 0x48, 0xC1, 0xE2, 0x20) // SHL RDX, 32
        mc_b3(c, 0x48, 0x09, 0xD0)       // OR  RAX, RDX
        mc_b3(c, 0x4C, 0x29, 0xD8)       // SUB RAX, R11
        mc_b2(c, 0x41, 0xBB); mc_u32(c, 0x7FFFFFFF) // MOV R11D, 0x7FFFFFFF (~2.1B cycles)
        mc_b3(c, 0x4C, 0x39, 0xD8)       // CMP RAX, R11
        mc_b1(c, 0x58)                   // POP RAX (does not modify flags!)
        ja_rdtsc := mc_jcc32(c, 0x87)

        mc_b3(c, 0x48, 0x8D, 0x0D)
        dp := buf_len(c)
        mc_u32(c, 0)
        nr := buf_len(c)
        cg_add_fixup(cg.fixups, dp, nr, fx_shield())
        mc_b3(c, 0x48, 0x8B, 0x11)
        mc_b4(c, 0x48, 0x33, 0x51, 0x08)
        mc_b3(c, 0x48, 0x39, 0xD0)
        jne_trap := mc_jcc8(c, 0x75)
        mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
        mc_b1(c, 0xC3)

        trap_pos := buf_len(c)
        if jne_peb_dbg > 0 { mc_patch_rel32(c, jne_peb_dbg, trap_pos) }
        if jnz_ntgf > 0 { mc_patch_rel32(c, jnz_ntgf, trap_pos) }
        mc_patch_rel32(c, je_ret_bp, trap_pos)
        mc_patch_rel32(c, ja_rdtsc, trap_pos)
        mc_patch_jcc8(c, jne_trap, trap_pos)
        cg_call_fn(cg, h_shield_trap())
        mc_b2(c, 0x0F, 0x0B) // UD2 (un-hookable hardware kill!)
        cg_reg_helper(cg, h_shield_verify(), s_sv, buf_len(c))
    }

    if cg_is_helper_used(cg, h_print_bytes()) {
        mc_align16(c)
        s_pb := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        if osm <= 1 {
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b4(c, 0x48, 0x83, 0xEC, 0x50)
            mc_b4(c, 0x48, 0x89, 0x4D, 0xF8)
            mc_b4(c, 0x48, 0x89, 0x55, 0xF0)
            mc_b1(c, 0xB9)
            mc_u32(c, 0xFFFFFFF5)
            cg_call_iat(cg, iat_get_std_handle())
            mc_b3(c, 0x48, 0x89, 0xC1)
            mc_b4(c, 0x48, 0x8B, 0x55, 0xF8)
            mc_b4(c, 0x44, 0x8B, 0x45, 0xF0)
            mc_b4(c, 0x4C, 0x8D, 0x4D, 0xE8)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24)
            mc_b1(c, 0x20)
            mc_u32(c, 0)
            cg_call_iat(cg, iat_write_file())
            mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
            mc_b1(c, 0xC3)
        } else if osm == 2 or osm == 3 {
            mc_b2(c, 0x56, 0x57)
            mc_b3(c, 0x48, 0x89, 0xCE) // RSI = ptr (RCX)
            mc_b1(c, 0xBF); mc_u32(c, 1) // EDI = 1 (stdout), RDX already = len!
            mc_b1(c, 0xB8)
            if osm == 2 { mc_u32(c, 1) } else { mc_u32(c, 0x2000004) } // sys_write
            mc_b2(c, 0x0F, 0x05)
            mc_b2(c, 0x5F, 0x5E)
            mc_b1(c, 0xC3)
        } else {
            // Bare-metal / Unikernel `COM1 0x3F8` serial UART output
            mc_b3(c, 0x49, 0x89, 0xC8) // R8 = ptr
            mc_b3(c, 0x49, 0x89, 0xD1) // R9 = len
            mc_b3(c, 0x45, 0x31, 0xD2) // R10 = 0
            mc_b4(c, 0x66, 0xBA, 0xF8, 0x03) // MOV DX, 0x3F8
            ul := buf_len(c)
            mc_b3(c, 0x4D, 0x39, 0xCA)
            jae_u := mc_jcc8(c, 0x73)
            mc_b4(c, 0x43, 0x8A, 0x04, 0x10) // MOV AL, [R8 + R10]
            mc_b1(c, 0xEE)                   // OUT DX, AL
            mc_b3(c, 0x49, 0xFF, 0xC2)
            jmp_u := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, jmp_u, ul)
            mc_patch_jcc8(c, jae_u, buf_len(c))
            mc_b1(c, 0xC3)
        }
        cg_reg_helper(cg, h_print_bytes(), s_pb, buf_len(c))
    }

    if cg_is_helper_used(cg, h_print_i64()) {
        mc_align16(c)
        s_pi := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x50)
        mc_b4(c, 0x4C, 0x8D, 0x45, 0xF8)
        mc_b3(c, 0x4D, 0x89, 0xC1)
        mc_b3(c, 0x45, 0x31, 0xD2)
        mc_b3(c, 0x48, 0x89, 0xC8)
        mc_b3(c, 0x48, 0x85, 0xC0)
        jge_pi := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x48, 0xF7, 0xD8)
        mc_b3(c, 0x41, 0xB2, 0x01)
        mc_patch_jcc8(c, jge_pi, buf_len(c))
        mc_b3(c, 0x49, 0xC7, 0xC3)
        mc_u32(c, 10)
        dloop := buf_len(c)
        mc_b2(c, 0x31, 0xD2)
        mc_b3(c, 0x49, 0xF7, 0xF3)
        mc_b3(c, 0x80, 0xC2, 0x30)
        mc_b3(c, 0x49, 0xFF, 0xC8)
        mc_b3(c, 0x41, 0x88, 0x10)
        mc_b3(c, 0x48, 0x85, 0xC0)
        jnz_dl := mc_jcc8(c, 0x75)
        mc_patch_jcc8(c, jnz_dl, dloop)
        mc_b3(c, 0x45, 0x85, 0xD2)
        jz_sg := mc_jcc8(c, 0x74)
        mc_b3(c, 0x49, 0xFF, 0xC8)
        mc_b4(c, 0x41, 0xC6, 0x00, 45)
        mc_patch_jcc8(c, jz_sg, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xC1)
        mc_b3(c, 0x4C, 0x89, 0xCA)
        mc_b3(c, 0x4C, 0x29, 0xC2)
        cg_call_fn(cg, h_print_bytes())
        mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_print_i64(), s_pi, buf_len(c))
    }

    if cg_is_helper_used(cg, h_print_dec()) {
        mc_align16(c)
        s_pd := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x40)
        mc_b4(c, 0x48, 0x89, 0x4D, 0xF8)
        mc_b3(c, 0x48, 0x85, 0xC9)
        jge_pd := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xC6, 0x45, 0xEF, 45)
        mc_b4(c, 0x48, 0x8D, 0x4D, 0xEF)
        mc_b1(c, 0xBA)
        mc_u32(c, 1)
        cg_call_fn(cg, h_print_bytes())
        mc_b4(c, 0x48, 0x8B, 0x4D, 0xF8)
        mc_b3(c, 0x48, 0xF7, 0xD9)
        mc_b4(c, 0x48, 0x89, 0x4D, 0xF8)
        mc_patch_jcc8(c, jge_pd, buf_len(c))
        mc_b4(c, 0x48, 0x8B, 0x45, 0xF8)
        mc_b2(c, 0x31, 0xD2)
        mc_b3(c, 0x48, 0xC7, 0xC1)
        mc_u32(c, 10000)
        mc_b3(c, 0x48, 0xF7, 0xF1)
        mc_b4(c, 0x48, 0x89, 0x55, 0xF0)
        mc_b3(c, 0x48, 0x89, 0xC1)
        cg_call_fn(cg, h_print_i64())
        mc_b4(c, 0xC6, 0x45, 0xE8, 46)
        mc_b4(c, 0x48, 0x8B, 0x45, 0xF0)
        mc_b2(c, 0x31, 0xD2)
        mc_b3(c, 0x48, 0xC7, 0xC1)
        mc_u32(c, 100)
        mc_b3(c, 0x48, 0xF7, 0xF1)
        mc_b2(c, 0x31, 0xD2)
        mc_b3(c, 0x48, 0xC7, 0xC1)
        mc_u32(c, 10)
        mc_b3(c, 0x48, 0xF7, 0xF1)
        mc_b2(c, 0x04, 0x30)
        mc_b3(c, 0x80, 0xC2, 0x30)
        mc_b3(c, 0x88, 0x45, 0xE9)
        mc_b3(c, 0x88, 0x55, 0xEA)
        mc_b4(c, 0x48, 0x8D, 0x4D, 0xE8)
        mc_b1(c, 0xBA)
        mc_u32(c, 3)
        cg_call_fn(cg, h_print_bytes())
        mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_print_dec(), s_pd, buf_len(c))
    }

    if cg_is_helper_used(cg, h_clock_ns()) {
        mc_align16(c)
        s_ck := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        if osm <= 1 {
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b4(c, 0x48, 0x83, 0xEC, 0x40)
            mc_b4(c, 0x48, 0x8D, 0x4D, 0xF8)
            cg_call_iat(cg, iat_qpc())
            // Cache QueryPerformanceFrequency in `.data` (1 syscall per process instead of every clock_ns!)
            cg_mov_rax_data(cg, data_off_qpf())
            mc_b3(c, 0x48, 0x85, 0xC0)
            jnz_qpf := mc_jcc8(c, 0x75)
            mc_b4(c, 0x48, 0x8D, 0x4D, 0xF0)
            cg_call_iat(cg, iat_qpf())
            mc_b4(c, 0x48, 0x8B, 0x45, 0xF0)
            cg_store_rax_data(cg, data_off_qpf())
            mc_patch_jcc8(c, jnz_qpf, buf_len(c))
            mc_b3(c, 0x49, 0x89, 0xC0)       // MOV R8, RAX (cached freq)
            mc_b4(c, 0x48, 0x8B, 0x45, 0xF8)
            mc_b3(c, 0x48, 0xC7, 0xC1)
            mc_u32(c, 1000000000)
            mc_b3(c, 0x48, 0xF7, 0xE1)
            mc_b3(c, 0x49, 0xF7, 0xF0)       // DIV R8
            mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
            mc_b1(c, 0xC3)
        } else if osm == 2 {
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b2(c, 0x56, 0x57)
            mc_b4(c, 0x48, 0x83, 0xEC, 0x20)
            mc_b1(c, 0xBF); mc_u32(c, 1) // CLOCK_MONOTONIC = 1
            mc_b3(c, 0x48, 0x89, 0xE6)   // RSI = RSP (&timespec)
            mc_b1(c, 0xB8); mc_u32(c, 228) // sys_clock_gettime
            mc_b2(c, 0x0F, 0x05)
            mc_b3(c, 0x48, 0x8B, 0x04); mc_b1(c, 0x24) // tv_sec
            mc_b3(c, 0x48, 0x69, 0xC0); mc_u32(c, 1000000000)
            mc_b4(c, 0x48, 0x03, 0x44, 0x24); mc_b1(c, 0x08) // + tv_nsec
            mc_b4(c, 0x48, 0x83, 0xC4, 0x20)
            mc_b2(c, 0x5F, 0x5E)
            mc_b1(c, 0x5D)
            mc_b1(c, 0xC3)
        } else {
            mc_b2(c, 0x0F, 0x31) // RDTSC
            mc_b4(c, 0x48, 0xC1, 0xE2, 0x20)
            mc_b3(c, 0x48, 0x09, 0xD0)
            mc_b1(c, 0xC3)
        }
        cg_reg_helper(cg, h_clock_ns(), s_ck, buf_len(c))
    }

    if cg_is_helper_used(cg, h_sec_trap()) {
        sec_msg := "[AXON SECURITY] Memory/Arithmetic safety violation blocked\n"
        sec_off := cg_intern_lit(cg, sec_msg)
        bt_hdr := "Stack backtrace:\n"
        bt_hdr_off := cg_intern_lit(cg, bt_hdr)
        bt_pfx := "  #"
        bt_pfx_off := cg_intern_lit(cg, bt_pfx)
        bt_sp := "  "
        bt_sp_off := cg_intern_lit(cg, bt_sp)
        bt_nl := "\n"
        bt_nl_off := cg_intern_lit(cg, bt_nl)
        symtab_roff := ibuf_get(cg.state, 22)
        mc_align16(c)
        s_t1 := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        // Capture faulting RIP (`[RSP]`) and frame pointer (`RBP`) BEFORE setting up trap frame!
        mc_b4(c, 0x4C, 0x8B, 0x2C, 0x24) // MOV R13, [RSP]
        mc_b3(c, 0x49, 0x89, 0xEE)       // MOV R14, RBP
        mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
        mc_b4(c, 0x48, 0x83, 0xE4, 0xF0)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x20)
        cg_lea_rax_rdata(cg, sec_off)
        mc_b3(c, 0x48, 0x89, 0xC1)
        mc_b1(c, 0xBA)
        mc_u32(c, str_len(sec_msg))
        cg_call_fn(cg, h_print_bytes())
        if symtab_roff > 0 {
            cg_lea_rax_rdata(cg, bt_hdr_off)
            mc_b3(c, 0x48, 0x89, 0xC1)
            mc_b1(c, 0xBA); mc_u32(c, str_len(bt_hdr))
            cg_call_fn(cg, h_print_bytes())
            // R12 = PIE runtime `.text + 0` base
            mc_b3(c, 0x4C, 0x8D, 0x25)
            mc_u32(c, 0 - (buf_len(c) + 4))
            // R15 = PIE runtime `.rdata` user base, RBX = symtab base
            cg_lea_rax_rdata(cg, 0); mc_b3(c, 0x49, 0x89, 0xC7)
            cg_lea_rax_rdata(cg, symtab_roff); mc_b3(c, 0x48, 0x89, 0xC3)
            mc_b2(c, 0x31, 0xF6) // XOR ESI, ESI (frame index = 0)
            lp_bt := buf_len(c)
            mc_b3(c, 0x4C, 0x89, 0xE8) // MOV RAX, R13
            mc_b3(c, 0x4C, 0x29, 0xE0) // SUB RAX, R12 (rel_rip)
            mc_b3(c, 0x48, 0xFF, 0xC8) // DEC RAX (point inside CALL instruction so fn_end stub matches `#0`!)
            mc_b3(c, 0x48, 0x89, 0xDF) // MOV RDI, RBX
            lp_sym := buf_len(c)
            mc_b2(c, 0x8B, 0x0F)             // MOV ECX, [RDI] (start)
            mc_b3(c, 0x8B, 0x57, 0x04)       // MOV EDX, [RDI + 4] (end)
            mc_b2(c, 0x85, 0xD2); jz_smiss := mc_jcc32(c, 0x84)
            mc_b3(c, 0x48, 0x39, 0xC8); jb_snext := mc_jcc8(c, 0x72)
            mc_b3(c, 0x48, 0x39, 0xD0); jae_snext := mc_jcc8(c, 0x73)
            // Matched function entry `[RDI]`! Print `  #<idx>  <name>\n`
            cg_lea_rax_rdata(cg, bt_pfx_off); mc_b3(c, 0x48, 0x89, 0xC1)
            mc_b1(c, 0xBA); mc_u32(c, str_len(bt_pfx))
            cg_call_fn(cg, h_print_bytes())
            mc_b3(c, 0x48, 0x89, 0xF1) // MOV RCX, RSI
            cg_call_fn(cg, h_print_i64())
            cg_lea_rax_rdata(cg, bt_sp_off); mc_b3(c, 0x48, 0x89, 0xC1)
            mc_b1(c, 0xBA); mc_u32(c, str_len(bt_sp))
            cg_call_fn(cg, h_print_bytes())
            mc_b3(c, 0x8B, 0x4F, 0x08) // MOV ECX, [RDI + 8] (name_roff)
            mc_b3(c, 0x4C, 0x01, 0xF9) // ADD RCX, R15
            mc_b3(c, 0x8B, 0x57, 0x0C) // MOV EDX, [RDI + 12] (name_len)
            cg_call_fn(cg, h_print_bytes())
            cg_lea_rax_rdata(cg, bt_nl_off); mc_b3(c, 0x48, 0x89, 0xC1)
            mc_b1(c, 0xBA); mc_u32(c, 1)
            cg_call_fn(cg, h_print_bytes())
            jmp_bt_next := mc_jmp32(c)
            sym_next_p := buf_len(c)
            mc_patch_jcc8(c, jb_snext, sym_next_p)
            mc_patch_jcc8(c, jae_snext, sym_next_p)
            mc_b4(c, 0x48, 0x83, 0xC7, 0x10) // ADD RDI, 16
            jmp_lp_sym := mc_jmp32(c)
            mc_patch_rel32(c, jmp_lp_sym, lp_sym)
            mc_patch_rel32(c, jz_smiss, buf_len(c))
            mc_b3(c, 0x48, 0x85, 0xF6); jnz_bt_done0 := mc_jcc32(c, 0x85)
            // Advance frame pointer safely
            bt_next_p := buf_len(c)
            mc_patch_rel32(c, jmp_bt_next, bt_next_p)
            mc_b3(c, 0x4D, 0x85, 0xF6); jz_bt_d1 := mc_jcc32(c, 0x84) // TEST R14, R14
            mc_b3(c, 0x49, 0xF7, 0xC6); mc_u32(c, 7); jnz_bt_d2 := mc_jcc32(c, 0x85) // TEST R14, 7
            mc_b3(c, 0x49, 0x8B, 0x06)       // MOV RAX, [R14] (next_rbp)
            mc_b3(c, 0x4C, 0x39, 0xF0); jbe_bt_d3 := mc_jcc32(c, 0x86) // CMP RAX, R14
            mc_b3(c, 0x48, 0x89, 0xC2); mc_b3(c, 0x4C, 0x29, 0xF2) // RDX = RAX - R14
            mc_b3(c, 0x48, 0x81, 0xFA); mc_u32(c, 0x100000); ja_bt_d4 := mc_jcc32(c, 0x87)
            mc_b4(c, 0x4D, 0x8B, 0x6E, 0x08) // MOV R13, [R14 + 8] (caller RIP)
            mc_b3(c, 0x49, 0x89, 0xC6)       // MOV R14, RAX
            mc_b3(c, 0x48, 0xFF, 0xC6)       // INC RSI
            mc_b4(c, 0x48, 0x83, 0xFE, 0x10) // CMP RSI, 16
            jl_bt := mc_jcc32(c, 0x8C)
            mc_patch_rel32(c, jl_bt, lp_bt)
            bt_done_p := buf_len(c)
            mc_patch_rel32(c, jnz_bt_done0, bt_done_p)
            mc_patch_rel32(c, jz_bt_d1, bt_done_p)
            mc_patch_rel32(c, jnz_bt_d2, bt_done_p)
            mc_patch_rel32(c, jbe_bt_d3, bt_done_p)
            mc_patch_rel32(c, ja_bt_d4, bt_done_p)
        }
        cg_emit_exit_imm(cg, 101)
        cg_reg_helper(cg, h_sec_trap(), s_t1, buf_len(c))
    }

    if cg_is_helper_used(cg, h_shield_trap()) {
        shd_msg := "[AXON SHIELD] Code integrity verification mismatch blocked\n"
        shd_off := cg_intern_lit(cg, shd_msg)
        mc_align16(c)
        s_t2 := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
        mc_b4(c, 0x48, 0x83, 0xE4, 0xF0)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x20)
        cg_lea_rax_rdata(cg, shd_off)
        mc_b3(c, 0x48, 0x89, 0xC1)
        mc_b1(c, 0xBA)
        mc_u32(c, str_len(shd_msg))
        cg_call_fn(cg, h_print_bytes())
        cg_emit_exit_imm(cg, 255)
        mc_b2(c, 0x0F, 0x0B) // UD2 fallback if ExitProcess is hooked!
        mc_b1(c, 0xCC)
        cg_reg_helper(cg, h_shield_trap(), s_t2, buf_len(c))
    }


    // GF(2)-Verified Slicing-by-16 Byte-Table Loop Accelerator (`h_crc32_slice8(RCX=crc, RDX=buf_ptr, R8=count, R9=tbl_ptr) -> RAX=new_crc or -1`)
    if cg_is_helper_used(cg, h_crc32_slice8()) {
        mc_align16(c)
        s_cs8 := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA) // ENDBR64
        mc_b4(c, 0x55, 0x48, 0x89, 0xE5) // PUSH RBP; MOV RBP, RSP
        mc_b1(c, 0x53); mc_b1(c, 0x56); mc_b1(c, 0x57) // PUSH RBX; PUSH RSI; PUSH RDI
        mc_b2(c, 0x41, 0x54); mc_b2(c, 0x41, 0x55)     // PUSH R12; PUSH R13
        mc_b4(c, 0x48, 0x83, 0xEC, 0x08)               // align RSP 16B

        // Guards: count >= 256, (crc >> 32) == 0, tbl != 0, tbl[0] == 0
        mc_b3(c, 0x49, 0x81, 0xF8); mc_u32(c, 256)
        jl_fb := mc_jcc32(c, 0x8C)
        mc_b3(c, 0x48, 0x85, 0xD2)
        jz_fb0 := mc_jcc32(c, 0x84)
        mc_b3(c, 0x4D, 0x85, 0xC9)
        jz_fb1 := mc_jcc32(c, 0x84)
        mc_b3(c, 0x48, 0x89, 0xC8)
        mc_b4(c, 0x48, 0xC1, 0xE8, 0x20)
        jnz_fb2 := mc_jcc32(c, 0x85)
        mc_b4(c, 0x49, 0x83, 0x39, 0x00)
        jne_fb3 := mc_jcc32(c, 0x85)

        // Verify GF(2)-linearity & 32-bit range of tbl[1..255]: tbl[i] == tbl[i & (i-1)] ^ tbl[i & -i]
        mc_b1(c, 0xBE); mc_u32(c, 1)
        lp_vf := buf_len(c)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xF1)
        mc_b3(c, 0x48, 0x89, 0xC3)
        mc_b4(c, 0x48, 0xC1, 0xEB, 0x20)
        jnz_fb4 := mc_jcc32(c, 0x85)
        mc_b4(c, 0x48, 0x8D, 0x7E, 0xFF)
        mc_b3(c, 0x48, 0x21, 0xF7)
        jz_pow2 := mc_jcc8(c, 0x74)
        mc_b3(c, 0x49, 0x89, 0xF2)
        mc_b3(c, 0x49, 0x31, 0xFA)
        mc_b4(c, 0x4D, 0x8B, 0x1C, 0xF9)
        mc_b4(c, 0x4F, 0x33, 0x1C, 0xD1)
        mc_b3(c, 0x4C, 0x39, 0xD8)
        jne_fb5 := mc_jcc32(c, 0x85)
        mc_patch_jcc8(c, jz_pow2, buf_len(c))
        mc_b2(c, 0xFF, 0xC6)
        mc_b2(c, 0x81, 0xFE); mc_u32(c, 256)
        jl_vf := mc_jcc8(c, 0x7C)
        mc_patch_jcc8(c, jl_vf, lp_vf)

        // Probe & allocate 16 KB (`u32 T[16][256]`) on stack across Win64 4 KB guard pages
        mut pg := 0
        while pg < 4 {
            mc_b3(c, 0x48, 0x81, 0xEC); mc_u32(c, 0x1000)
            mc_b4(c, 0x48, 0xC7, 0x04, 0x24); mc_u32(c, 0)
            pg += 1
        }

        mc_b3(c, 0x41, 0x89, 0xCD) // MOV R13D, ECX (crc)
        mc_b3(c, 0x4C, 0x89, 0xC3) // MOV RBX, R8   (rem)

        // Copy T0[0..255] as u32
        mc_b2(c, 0x31, 0xF6)
        lp_t0 := buf_len(c)
        mc_b4(c, 0x41, 0x8B, 0x04, 0xF1)
        mc_b3(c, 0x89, 0x04, 0xB4)
        mc_b2(c, 0xFF, 0xC6)
        mc_b2(c, 0x81, 0xFE); mc_u32(c, 256)
        jl_t0 := mc_jcc8(c, 0x7C)
        mc_patch_jcc8(c, jl_t0, lp_t0)

        // Build T1..T15 in one flat loop: RSI = 0..3839 (15 * 256)
        mc_b2(c, 0x31, 0xF6)
        lp_tk := buf_len(c)
        mc_b3(c, 0x8B, 0x04, 0xB4)
        mc_b3(c, 0x0F, 0xB6, 0xF8)
        mc_b3(c, 0xC1, 0xE8, 0x08)
        mc_b3(c, 0x33, 0x04, 0xBC)
        mc_b3(c, 0x89, 0x84, 0xB4); mc_u32(c, 0x400)
        mc_b2(c, 0xFF, 0xC6)
        mc_b2(c, 0x81, 0xFE); mc_u32(c, 3840)
        jl_tk := mc_jcc8(c, 0x7C)
        mc_patch_jcc8(c, jl_tk, lp_tk)

        // EAX = crc, RDX = buf_ptr, RBX = rem
        mc_b3(c, 0x44, 0x89, 0xE8) // MOV EAX, R13D
        mc_b4(c, 0x48, 0x83, 0xFB, 0x10)
        jb_tail16 := mc_jcc32(c, 0x82)

        mc_align16_nop(c)
        lp_s16 := buf_len(c)
        // Compute crc-INDEPENDENT words W1=[RDX+4], W2=[RDX+8], W3=[RDX+12] into R10D & R11D FIRST so OoO CPU runs next iter ahead!
        // Word 3 (bytes 12..15 -> T3..T0) -> R10D
        mc_b3(c, 0x8B, 0x4A, 0x0C)             // MOV ECX, [RDX + 12]
        mc_b3(c, 0x0F, 0xB6, 0xF1)             // MOVZX ESI, CL
        mc_b2(c, 0x89, 0xCF); mc_b3(c, 0xC1, 0xEF, 0x08); mc_b4(c, 0x40, 0x0F, 0xB6, 0xFF) // EDI = byte1
        mc_b3(c, 0x41, 0x89, 0xC8); mc_b4(c, 0x41, 0xC1, 0xE8, 0x10); mc_b4(c, 0x45, 0x0F, 0xB6, 0xC0) // R8D = byte2
        mc_b3(c, 0xC1, 0xE9, 0x18)             // ECX = byte3
        mc_b4(c, 0x44, 0x8B, 0x94, 0xB4); mc_u32(c, 0x0C00) // R10D = T3[b12]
        mc_b4(c, 0x44, 0x8B, 0x9C, 0xBC); mc_u32(c, 0x0800) // R11D = T2[b13]
        mc_b4(c, 0x46, 0x33, 0x94, 0x84); mc_u32(c, 0x0400) // R10D ^= T1[b14]
        mc_b4(c, 0x44, 0x33, 0x1C, 0x8C)                    // R11D ^= T0[b15]
        mc_b3(c, 0x45, 0x31, 0xDA)                          // R10D ^= R11D

        // Word 2 (bytes 8..11 -> T7..T4) -> R11D, fold into R10D
        mc_b3(c, 0x8B, 0x4A, 0x08)             // MOV ECX, [RDX + 8]
        mc_b3(c, 0x0F, 0xB6, 0xF1)
        mc_b2(c, 0x89, 0xCF); mc_b3(c, 0xC1, 0xEF, 0x08); mc_b4(c, 0x40, 0x0F, 0xB6, 0xFF)
        mc_b3(c, 0x41, 0x89, 0xC8); mc_b4(c, 0x41, 0xC1, 0xE8, 0x10); mc_b4(c, 0x45, 0x0F, 0xB6, 0xC0)
        mc_b3(c, 0xC1, 0xE9, 0x18)
        mc_b4(c, 0x44, 0x8B, 0x9C, 0xB4); mc_u32(c, 0x1C00) // R11D = T7[b8]
        mc_b4(c, 0x44, 0x8B, 0xA4, 0xBC); mc_u32(c, 0x1800) // R12D = T6[b9]
        mc_b4(c, 0x46, 0x33, 0x9C, 0x84); mc_u32(c, 0x1400) // R11D ^= T5[b10]
        mc_b4(c, 0x44, 0x33, 0xA4, 0x8C); mc_u32(c, 0x1000) // R12D ^= T4[b11]
        mc_b3(c, 0x45, 0x31, 0xE3)                          // R11D ^= R12D
        mc_b3(c, 0x45, 0x31, 0xDA)                          // R10D ^= R11D

        // Word 1 (bytes 4..7 -> T11..T8) -> R11D, fold into R10D
        mc_b3(c, 0x8B, 0x4A, 0x04)             // MOV ECX, [RDX + 4]
        mc_b3(c, 0x0F, 0xB6, 0xF1)
        mc_b2(c, 0x89, 0xCF); mc_b3(c, 0xC1, 0xEF, 0x08); mc_b4(c, 0x40, 0x0F, 0xB6, 0xFF)
        mc_b3(c, 0x41, 0x89, 0xC8); mc_b4(c, 0x41, 0xC1, 0xE8, 0x10); mc_b4(c, 0x45, 0x0F, 0xB6, 0xC0)
        mc_b3(c, 0xC1, 0xE9, 0x18)
        mc_b4(c, 0x44, 0x8B, 0x9C, 0xB4); mc_u32(c, 0x2C00) // R11D = T11[b4]
        mc_b4(c, 0x44, 0x8B, 0xA4, 0xBC); mc_u32(c, 0x2800) // R12D = T10[b5]
        mc_b4(c, 0x46, 0x33, 0x9C, 0x84); mc_u32(c, 0x2400) // R11D ^= T9[b6]
        mc_b4(c, 0x44, 0x33, 0xA4, 0x8C); mc_u32(c, 0x2000) // R12D ^= T8[b7]
        mc_b3(c, 0x45, 0x31, 0xE3)
        mc_b3(c, 0x45, 0x31, 0xDA)

        // Word 0 (crc ^ [RDX + 0] -> T15..T12) -> short critical path!
        mc_b2(c, 0x33, 0x02)                   // XOR EAX, [RDX]
        mc_b4(c, 0x48, 0x83, 0xC2, 0x10)       // ADD RDX, 16
        mc_b3(c, 0x0F, 0xB6, 0xF0)             // ESI = L0
        mc_b2(c, 0x89, 0xC7); mc_b3(c, 0xC1, 0xEF, 0x08); mc_b4(c, 0x40, 0x0F, 0xB6, 0xFF) // EDI = L1
        mc_b3(c, 0x41, 0x89, 0xC0); mc_b4(c, 0x41, 0xC1, 0xE8, 0x10); mc_b4(c, 0x45, 0x0F, 0xB6, 0xC0) // R8D = L2
        mc_b3(c, 0xC1, 0xE8, 0x18)             // EAX = L3
        mc_b3(c, 0x8B, 0x8C, 0xB4); mc_u32(c, 0x3C00)       // ECX  = T15[L0]
        mc_b4(c, 0x44, 0x8B, 0x9C, 0xBC); mc_u32(c, 0x3800) // R11D = T14[L1]
        mc_b4(c, 0x42, 0x33, 0x8C, 0x84); mc_u32(c, 0x3400) // ECX  ^= T13[L2]
        mc_b4(c, 0x44, 0x33, 0x9C, 0x84); mc_u32(c, 0x3000) // R11D ^= T12[L3]
        mc_b3(c, 0x44, 0x31, 0xD9)             // XOR ECX, R11D
        mc_b3(c, 0x44, 0x89, 0xD0)             // MOV EAX, R10D
        mc_b2(c, 0x31, 0xC8)                   // XOR EAX, ECX

        mc_b4(c, 0x48, 0x83, 0xEB, 0x10)       // SUB RBX, 16
        mc_b4(c, 0x48, 0x83, 0xFB, 0x10)       // CMP RBX, 16
        jae_s16 := mc_jcc32(c, 0x83)
        mc_patch_rel32(c, jae_s16, lp_s16)

        mc_patch_rel32(c, jb_tail16, buf_len(c))
        // Scalar tail (0..15 bytes)
        mc_b3(c, 0x48, 0x85, 0xDB)
        jz_done := mc_jcc8(c, 0x74)
        lp_tail := buf_len(c)
        mc_b3(c, 0x0F, 0xB6, 0x0A)
        mc_b3(c, 0x48, 0xFF, 0xC2)
        mc_b2(c, 0x31, 0xC1)
        mc_b3(c, 0x0F, 0xB6, 0xC9)
        mc_b3(c, 0xC1, 0xE8, 0x08)
        mc_b3(c, 0x33, 0x04, 0x8C)
        mc_b3(c, 0x48, 0xFF, 0xCB)
        jnz_tl := mc_jcc8(c, 0x75)
        mc_patch_jcc8(c, jnz_tl, lp_tail)
        mc_patch_jcc8(c, jz_done, buf_len(c))

        mc_b3(c, 0x48, 0x81, 0xC4); mc_u32(c, 0x4008) // ADD RSP, 0x4008 (16 KB + 8B align)
        mc_b2(c, 0x41, 0x5D); mc_b2(c, 0x41, 0x5C)
        mc_b1(c, 0x5F); mc_b1(c, 0x5E); mc_b1(c, 0x5B)
        mc_b1(c, 0x5D); mc_b1(c, 0xC3)

        fb_lbl := buf_len(c)
        mc_patch_rel32(c, jl_fb, fb_lbl)
        mc_patch_rel32(c, jz_fb0, fb_lbl)
        mc_patch_rel32(c, jz_fb1, fb_lbl)
        mc_patch_rel32(c, jnz_fb2, fb_lbl)
        mc_patch_rel32(c, jne_fb3, fb_lbl)
        mc_patch_rel32(c, jnz_fb4, fb_lbl)
        mc_patch_rel32(c, jne_fb5, fb_lbl)
        mc_b4(c, 0x48, 0x83, 0xC4, 0x08)
        mc_b3(c, 0x48, 0xC7, 0xC0); mc_u32(c, 0xFFFFFFFF)
        mc_b2(c, 0x41, 0x5D); mc_b2(c, 0x41, 0x5C)
        mc_b1(c, 0x5F); mc_b1(c, 0x5E); mc_b1(c, 0x5B)
        mc_b1(c, 0x5D); mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_crc32_slice8(), s_cs8, buf_len(c))
    }

    // Native x86_64 Register-Resident Multi-Block SHA-256 Kernel:
    // `h_sha256_blocks(RCX=h_i64x8_ptr, RDX=data_ptr, R8=nblocks) -> RAX=0`
    // Keeps a..h pinned in R8D..R15D (zero spills, zero inter-round shuffles) + W[0..15] in L1 stack cache line.
    if cg_is_helper_used(cg, h_sha256_blocks()) {
        mc_align16(c)
        s_sha := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA) // ENDBR64
        mc_b1(c, 0x55); mc_b1(c, 0x53); mc_b1(c, 0x56); mc_b1(c, 0x57)
        mc_b2(c, 0x41, 0x54); mc_b2(c, 0x41, 0x55); mc_b2(c, 0x41, 0x56); mc_b2(c, 0x41, 0x57)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x48) // SUB RSP, 72 (16B aligned; [RSP+0..63] = W[0..15])

        // Guards: RCX != 0, RDX != 0, R8 > 0
        mc_b3(c, 0x48, 0x85, 0xC9); jz_h := mc_jcc32(c, 0x84)
        mc_b3(c, 0x48, 0x85, 0xD2); jz_d := mc_jcc32(c, 0x84)
        mc_b3(c, 0x4D, 0x85, 0xC0); jle_n := mc_jcc32(c, 0x8E)

        mc_b3(c, 0x48, 0x89, 0xCF) // MOV RDI, RCX (h_ptr)
        mc_b3(c, 0x48, 0x89, 0xD5) // MOV RBP, RDX (data_ptr)
        mc_b3(c, 0x4C, 0x89, 0xC6) // MOV RSI, R8  (nblocks)

        // Build FIPS 180-4 K[0..63] compile-time table
        ks := ibuf_new(64)
        ibuf_push(ks, 0x428a2f98); ibuf_push(ks, 0x71374491); ibuf_push(ks, 0xb5c0fbcf); ibuf_push(ks, 0xe9b5dba5)
        ibuf_push(ks, 0x3956c25b); ibuf_push(ks, 0x59f111f1); ibuf_push(ks, 0x923f82a4); ibuf_push(ks, 0xab1c5ed5)
        ibuf_push(ks, 0xd807aa98); ibuf_push(ks, 0x12835b01); ibuf_push(ks, 0x243185be); ibuf_push(ks, 0x550c7dc3)
        ibuf_push(ks, 0x72be5d74); ibuf_push(ks, 0x80deb1fe); ibuf_push(ks, 0x9bdc06a7); ibuf_push(ks, 0xc19bf174)
        ibuf_push(ks, 0xe49b69c1); ibuf_push(ks, 0xefbe4786); ibuf_push(ks, 0x0fc19dc6); ibuf_push(ks, 0x240ca1cc)
        ibuf_push(ks, 0x2de92c6f); ibuf_push(ks, 0x4a7484aa); ibuf_push(ks, 0x5cb0a9dc); ibuf_push(ks, 0x76f988da)
        ibuf_push(ks, 0x983e5152); ibuf_push(ks, 0xa831c66d); ibuf_push(ks, 0xb00327c8); ibuf_push(ks, 0xbf597fc7)
        ibuf_push(ks, 0xc6e00bf3); ibuf_push(ks, 0xd5a79147); ibuf_push(ks, 0x06ca6351); ibuf_push(ks, 0x14292967)
        ibuf_push(ks, 0x27b70a85); ibuf_push(ks, 0x2e1b2138); ibuf_push(ks, 0x4d2c6dfc); ibuf_push(ks, 0x53380d13)
        ibuf_push(ks, 0x650a7354); ibuf_push(ks, 0x766a0abb); ibuf_push(ks, 0x81c2c92e); ibuf_push(ks, 0x92722c85)
        ibuf_push(ks, 0xa2bfe8a1); ibuf_push(ks, 0xa81a664b); ibuf_push(ks, 0xc24b8b70); ibuf_push(ks, 0xc76c51a3)
        ibuf_push(ks, 0xd192e819); ibuf_push(ks, 0xd6990624); ibuf_push(ks, 0xf40e3585); ibuf_push(ks, 0x106aa070)
        ibuf_push(ks, 0x19a4c116); ibuf_push(ks, 0x1e376c08); ibuf_push(ks, 0x2748774c); ibuf_push(ks, 0x34b0bcb5)
        ibuf_push(ks, 0x391c0cb3); ibuf_push(ks, 0x4ed8aa4a); ibuf_push(ks, 0x5b9cca4f); ibuf_push(ks, 0x682e6ff3)
        ibuf_push(ks, 0x748f82ee); ibuf_push(ks, 0x78a5636f); ibuf_push(ks, 0x84c87814); ibuf_push(ks, 0x8cc70208)
        ibuf_push(ks, 0x90befffa); ibuf_push(ks, 0xa4506ceb); ibuf_push(ks, 0xbef9a3f7); ibuf_push(ks, 0xc67178f2)

        lp_blk := buf_len(c)
        // Load & BSWAP 16 big-endian u32 words from [RBP + k*4] into [RSP + k*4]
        mut wk := 0
        while wk < 16 {
            mc_b3(c, 0x8B, 0x45, wk * 4)        // MOV EAX, DWORD [RBP + wk*4]
            mc_b2(c, 0x0F, 0xC8)                // BSWAP EAX
            mc_b4(c, 0x89, 0x44, 0x24, wk * 4)  // MOV DWORD [RSP + wk*4], EAX
            wk += 1
        }
        // Load H[0..7] into R8D..R15D from i64[8] at [RDI + k*8]
        mut hk := 0
        while hk < 8 {
            mc_b4(c, 0x44, 0x8B, 0x47 | (hk << 3), hk * 8)
            hk += 1
        }
        // 64 register-rotating rounds with Horner-nested ROR + ILP-interleaved ALU chains (zero spills!)
        mut rnd := 0
        while rnd < 64 {
            ia := (64 - rnd) & 7; ib := (65 - rnd) & 7; ic := (66 - rnd) & 7; id := (67 - rnd) & 7
            ie := (68 - rnd) & 7; if_ := (69 - rnd) & 7; ig := (70 - rnd) & 7; ih := (71 - rnd) & 7
            if rnd < 16 {
                mc_b4(c, 0x8B, 0x44, 0x24, rnd * 4)
            } else {
                i16 := (rnd & 15) * 4
                i15 := ((rnd - 15) & 15) * 4
                i7  := ((rnd - 7) & 15) * 4
                i2  := ((rnd - 2) & 15) * 4
                // Interleave s0(W[i15]) in EBX/ECX and s1(W[i2]) in EAX/EDX using Horner ROR!
                mc_b4(c, 0x8B, 0x5C, 0x24, i15) // MOV EBX, [RSP + i15]
                mc_b4(c, 0x8B, 0x44, 0x24, i2)  // MOV EAX, [RSP + i2]
                mc_b2(c, 0x89, 0xD9)            // MOV ECX, EBX
                mc_b2(c, 0x89, 0xC2)            // MOV EDX, EAX
                mc_b3(c, 0xC1, 0xCB, 11)        // ROR EBX, 11
                mc_b3(c, 0xC1, 0xC8, 2)         // ROR EAX, 2
                mc_b2(c, 0x31, 0xCB)            // XOR EBX, ECX
                mc_b2(c, 0x31, 0xD0)            // XOR EAX, EDX
                mc_b3(c, 0xC1, 0xCB, 7)         // ROR EBX, 7
                mc_b3(c, 0xC1, 0xC8, 17)        // ROR EAX, 17
                mc_b3(c, 0xC1, 0xE9, 3)         // SHR ECX, 3
                mc_b3(c, 0xC1, 0xEA, 10)        // SHR EDX, 10
                mc_b2(c, 0x31, 0xCB)            // XOR EBX, ECX -> s0
                mc_b2(c, 0x31, 0xD0)            // XOR EAX, EDX -> s1
                mc_b4(c, 0x03, 0x5C, 0x24, i16) // ADD EBX, [RSP + i16]
                mc_b4(c, 0x03, 0x44, 0x24, i7)  // ADD EAX, [RSP + i7]
                mc_b2(c, 0x01, 0xD8)            // ADD EAX, EBX -> W[i16]
                mc_b4(c, 0x89, 0x44, 0x24, i16) // MOV [RSP + i16], EAX
            }
            // Start EAX = W[r] + K[r] + h while interleaving Ch(e,f,g) in ECX and Horner Sigma1(e) in EBX!
            mc_b1(c, 0x05); mc_u32(c, ibuf_get(ks, rnd))
            mc_b3(c, 0x44, 0x89, 0xC3 | (ie << 3))   // MOV EBX, e
            mc_b3(c, 0x44, 0x89, 0xC1 | (if_ << 3))  // MOV ECX, f
            mc_b3(c, 0x44, 0x01, 0xC0 | (ih << 3))   // ADD EAX, h
            mc_b3(c, 0xC1, 0xCB, 14)                 // ROR EBX, 14
            mc_b3(c, 0x44, 0x31, 0xC1 | (ig << 3))   // XOR ECX, g
            mc_b3(c, 0x44, 0x31, 0xC3 | (ie << 3))   // XOR EBX, e
            mc_b3(c, 0x44, 0x21, 0xC1 | (ie << 3))   // AND ECX, e
            mc_b3(c, 0xC1, 0xCB, 5)                  // ROR EBX, 5
            mc_b3(c, 0x44, 0x31, 0xC1 | (ig << 3))   // XOR ECX, g -> Ch(e,f,g)
            mc_b3(c, 0x44, 0x31, 0xC3 | (ie << 3))   // XOR EBX, e
            mc_b2(c, 0x01, 0xC8)                     // ADD EAX, ECX (EAX += Ch)
            mc_b3(c, 0xC1, 0xCB, 6)                  // ROR EBX, 6 -> Sigma1(e)
            // Start Maj(a,b,c) in ECX/EDX and Horner Sigma0(a) in EDX? Use ECX/EDX while finishing t1!
            mc_b2(c, 0x01, 0xD8)                     // ADD EAX, EBX -> EAX = t1!
            mc_b3(c, 0x44, 0x89, 0xC3 | (ia << 3))   // MOV EBX, a (for Sigma0)
            mc_b3(c, 0x44, 0x89, 0xC1 | (ia << 3))   // MOV ECX, a (for Maj)
            mc_b3(c, 0x41, 0x01, 0xC0 | id)          // ADD d, EAX (d += t1)
            mc_b3(c, 0x44, 0x89, 0xC2 | (ia << 3))   // MOV EDX, a (for Maj)
            mc_b3(c, 0xC1, 0xCB, 9)                  // ROR EBX, 9
            mc_b3(c, 0x44, 0x21, 0xC1 | (ib << 3))   // AND ECX, b
            mc_b3(c, 0x44, 0x09, 0xC2 | (ib << 3))   // OR EDX, b
            mc_b3(c, 0x44, 0x31, 0xC3 | (ia << 3))   // XOR EBX, a
            mc_b3(c, 0x44, 0x21, 0xC2 | (ic << 3))   // AND EDX, c
            mc_b3(c, 0xC1, 0xCB, 11)                 // ROR EBX, 11
            mc_b2(c, 0x09, 0xD1)                     // OR ECX, EDX -> Maj(a,b,c)
            mc_b3(c, 0x44, 0x31, 0xC3 | (ia << 3))   // XOR EBX, a
            mc_b2(c, 0x01, 0xC8)                     // ADD EAX, ECX (EAX = t1 + Maj)
            mc_b3(c, 0xC1, 0xCB, 2)                  // ROR EBX, 2 -> Sigma0(a)
            mc_b2(c, 0x01, 0xD8)                     // ADD EAX, EBX (EAX = t1 + t2)
            mc_b3(c, 0x41, 0x89, 0xC0 | ih)          // MOV h, EAX (next round's a!)
            rnd += 1
        }
        buf_free(move ks)

        // Accumulate H[k] = u32(H[k] + reg_k) zero-extended into i64[8] at [RDI + k*8]
        hk = 0
        while hk < 8 {
            mc_b4(c, 0x44, 0x03, 0x47 | (hk << 3), hk * 8)
            mc_b4(c, 0x4C, 0x89, 0x47 | (hk << 3), hk * 8)
            hk += 1
        }
        mc_b4(c, 0x48, 0x83, 0xC5, 0x40) // ADD RBP, 64
        mc_b3(c, 0x48, 0xFF, 0xCE)       // DEC RSI
        jnz_blk := mc_jcc32(c, 0x85)
        mc_patch_rel32(c, jnz_blk, lp_blk)

        done_sha := buf_len(c)
        mc_patch_rel32(c, jz_h, done_sha)
        mc_patch_rel32(c, jz_d, done_sha)
        mc_patch_rel32(c, jle_n, done_sha)
        mc_b2(c, 0x31, 0xC0) // XOR EAX, EAX
        mc_b4(c, 0x48, 0x83, 0xC4, 0x48)
        mc_b2(c, 0x41, 0x5F); mc_b2(c, 0x41, 0x5E); mc_b2(c, 0x41, 0x5D); mc_b2(c, 0x41, 0x5C)
        mc_b1(c, 0x5F); mc_b1(c, 0x5E); mc_b1(c, 0x5B); mc_b1(c, 0x5D); mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_sha256_blocks(), s_sha, buf_len(c))
    }

    // Leaf AVX2 128B/iter `h_fast_memcpy(RCX=dst, RDX=src, R8=n) -> RAX=dst` (zero REP MOVSB microcode startup!)
    if cg_is_helper_used(cg, h_fast_memcpy()) {
        mc_align16(c)
        s_fmc := buf_len(c)
        mc_b3(c, 0x49, 0x89, 0xCA)                   // MOV R10, RCX (save return dst)
        mc_b3(c, 0x4D, 0x85, 0xC0)                   // TEST R8, R8
        jle_m0 := mc_jcc32(c, 0x8E)
        mc_b4(c, 0x49, 0x83, 0xF8, 0x20)             // CMP R8, 32
        jb_m_tail := mc_jcc32(c, 0x82)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_m_tail := mc_jcc32(c, 0x84)
        // AVX2 256B/iter loop (YMM0..YMM3 x2 — 100% Win64-ABI volatile leaf, 2x fewer branches!)
        mc_b3(c, 0x49, 0x81, 0xF8); mc_u32(c, 256)   // CMP R8, 256
        jb_m128 := mc_jcc32(c, 0x82)
        mc_align16_nop(c)
        lp_m256 := buf_len(c)
        mc_b4(c, 0xC5, 0xFE, 0x6F, 0x02)             // VMOVDQU YMM0, [RDX]
        mc_b4(c, 0xC5, 0xFE, 0x6F, 0x4A); mc_b1(c, 32)
        mc_b4(c, 0xC5, 0xFE, 0x6F, 0x52); mc_b1(c, 64)
        mc_b4(c, 0xC5, 0xFE, 0x6F, 0x5A); mc_b1(c, 96)
        mc_b4(c, 0xC5, 0xFE, 0x7F, 0x01)             // VMOVDQU [RCX], YMM0
        mc_b4(c, 0xC5, 0xFE, 0x7F, 0x49); mc_b1(c, 32)
        mc_b4(c, 0xC5, 0xFE, 0x7F, 0x51); mc_b1(c, 64)
        mc_b4(c, 0xC5, 0xFE, 0x7F, 0x59); mc_b1(c, 96)
        mc_b4(c, 0xC5, 0xFE, 0x6F, 0x82); mc_u32(c, 128) // VMOVDQU YMM0, [RDX+128]
        mc_b4(c, 0xC5, 0xFE, 0x6F, 0x8A); mc_u32(c, 160) // VMOVDQU YMM1, [RDX+160]
        mc_b4(c, 0xC5, 0xFE, 0x6F, 0x92); mc_u32(c, 192) // VMOVDQU YMM2, [RDX+192]
        mc_b4(c, 0xC5, 0xFE, 0x6F, 0x9A); mc_u32(c, 224) // VMOVDQU YMM3, [RDX+224]
        mc_b4(c, 0xC5, 0xFE, 0x7F, 0x81); mc_u32(c, 128) // VMOVDQU [RCX+128], YMM0
        mc_b4(c, 0xC5, 0xFE, 0x7F, 0x89); mc_u32(c, 160) // VMOVDQU [RCX+160], YMM1
        mc_b4(c, 0xC5, 0xFE, 0x7F, 0x91); mc_u32(c, 192) // VMOVDQU [RCX+192], YMM2
        mc_b4(c, 0xC5, 0xFE, 0x7F, 0x99); mc_u32(c, 224) // VMOVDQU [RCX+224], YMM3
        mc_b3(c, 0x48, 0x81, 0xC2); mc_u32(c, 256)   // ADD RDX, 256
        mc_b3(c, 0x48, 0x81, 0xC1); mc_u32(c, 256)   // ADD RCX, 256
        mc_b3(c, 0x49, 0x81, 0xE8); mc_u32(c, 256)   // SUB R8, 256
        mc_b3(c, 0x49, 0x81, 0xF8); mc_u32(c, 256)   // CMP R8, 256
        jae_m256 := mc_jcc32(c, 0x83); mc_patch_rel32(c, jae_m256, lp_m256)
        mc_patch_rel32(c, jb_m128, buf_len(c))
        // AVX2 128B/iter loop
        mc_b3(c, 0x49, 0x81, 0xF8); mc_u32(c, 128)   // CMP R8, 128
        jb_m32 := mc_jcc8(c, 0x72)
        mc_align16_nop(c)
        lp_m128 := buf_len(c)
        mc_b4(c, 0xC5, 0xFE, 0x6F, 0x02)             // VMOVDQU YMM0, [RDX]
        mc_b4(c, 0xC5, 0xFE, 0x6F, 0x4A); mc_b1(c, 32)
        mc_b4(c, 0xC5, 0xFE, 0x6F, 0x52); mc_b1(c, 64)
        mc_b4(c, 0xC5, 0xFE, 0x6F, 0x5A); mc_b1(c, 96)
        mc_b4(c, 0xC5, 0xFE, 0x7F, 0x01)             // VMOVDQU [RCX], YMM0
        mc_b4(c, 0xC5, 0xFE, 0x7F, 0x49); mc_b1(c, 32)
        mc_b4(c, 0xC5, 0xFE, 0x7F, 0x51); mc_b1(c, 64)
        mc_b4(c, 0xC5, 0xFE, 0x7F, 0x59); mc_b1(c, 96)
        mc_b3(c, 0x48, 0x81, 0xC2); mc_u32(c, 128)   // ADD RDX, 128
        mc_b3(c, 0x48, 0x81, 0xC1); mc_u32(c, 128)   // ADD RCX, 128
        mc_b3(c, 0x49, 0x81, 0xE8); mc_u32(c, 128)   // SUB R8, 128
        mc_b3(c, 0x49, 0x81, 0xF8); mc_u32(c, 128)   // CMP R8, 128
        jae_m128 := mc_jcc8(c, 0x73); mc_patch_jcc8(c, jae_m128, lp_m128)
        mc_patch_jcc8(c, jb_m32, buf_len(c))
        // AVX2 32B/iter loop
        mc_b4(c, 0x49, 0x83, 0xF8, 0x20)
        jb_m_vzu := mc_jcc8(c, 0x72)
        lp_m32 := buf_len(c)
        mc_b4(c, 0xC5, 0xFE, 0x6F, 0x02)             // VMOVDQU YMM0, [RDX]
        mc_b4(c, 0xC5, 0xFE, 0x7F, 0x01)             // VMOVDQU [RCX], YMM0
        mc_b4(c, 0x48, 0x83, 0xC2, 32)
        mc_b4(c, 0x48, 0x83, 0xC1, 32)
        mc_b4(c, 0x49, 0x83, 0xE8, 32)
        mc_b4(c, 0x49, 0x83, 0xF8, 32)
        jae_m32 := mc_jcc8(c, 0x73); mc_patch_jcc8(c, jae_m32, lp_m32)
        mc_patch_jcc8(c, jb_m_vzu, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)                   // VZEROUPPER
        mc_b3(c, 0x4D, 0x85, 0xC0)                   // TEST R8, R8
        jz_m_vret := mc_jcc8(c, 0x74)
        // Scalar 8B + 1B tail (also handles --simd=scalar & n < 32)
        mc_patch_rel32(c, jb_m_tail, buf_len(c))
        mc_patch_rel32(c, jz_m_tail, buf_len(c))
        mc_b4(c, 0x49, 0x83, 0xF8, 8)
        jb_m1 := mc_jcc8(c, 0x72)
        lp_m8 := buf_len(c)
        mc_b3(c, 0x48, 0x8B, 0x02)                   // MOV RAX, [RDX]
        mc_b3(c, 0x48, 0x89, 0x01)                   // MOV [RCX], RAX
        mc_b4(c, 0x48, 0x83, 0xC2, 8)
        mc_b4(c, 0x48, 0x83, 0xC1, 8)
        mc_b4(c, 0x49, 0x83, 0xE8, 8)
        mc_b4(c, 0x49, 0x83, 0xF8, 8)
        jae_m8 := mc_jcc8(c, 0x73); mc_patch_jcc8(c, jae_m8, lp_m8)
        mc_patch_jcc8(c, jb_m1, buf_len(c))
        mc_b3(c, 0x4D, 0x85, 0xC0)
        jz_m_ret := mc_jcc8(c, 0x74)
        lp_m1 := buf_len(c)
        mc_b2(c, 0x8A, 0x02)                         // MOV AL, [RDX]
        mc_b2(c, 0x88, 0x01)                         // MOV [RCX], AL
        mc_b3(c, 0x48, 0xFF, 0xC2)
        mc_b3(c, 0x48, 0xFF, 0xC1)
        mc_b3(c, 0x49, 0xFF, 0xC8)
        jnz_m1 := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_m1, lp_m1)
        mc_patch_jcc8(c, jz_m_ret, buf_len(c))
        mc_patch_jcc8(c, jz_m_vret, buf_len(c))
        mc_patch_rel32(c, jle_m0, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xD0)                   // MOV RAX, R10
        mc_b1(c, 0xC3)                               // RET
        cg_reg_helper(cg, h_fast_memcpy(), s_fmc, buf_len(c))
    }

    // Leaf AVX2 128B/iter `h_fast_memset(RCX=dst, RDX=val, R8=n)` (zero REP STOSB startup!)
    if cg_is_helper_used(cg, h_fast_memset()) {
        mc_align16(c)
        s_fms := buf_len(c)
        mc_b3(c, 0x4D, 0x85, 0xC0)                   // TEST R8, R8
        jle_s0 := mc_jcc32(c, 0x8E)
        mc_b3(c, 0x0F, 0xB6, 0xC2)                   // MOVZX EAX, DL
        mc_b2(c, 0x49, 0xB9); mc_u64(c, 0x0101010101010101) // MOVABS R9, 0x0101010101010101
        mc_b4(c, 0x4C, 0x0F, 0xAF, 0xC8)             // IMUL R9, RAX (8x replicated byte)
        mc_b4(c, 0x49, 0x83, 0xF8, 32)
        jb_s_tail := mc_jcc32(c, 0x82)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_s_tail := mc_jcc32(c, 0x84)
        mc_vex3(c, 0, 0, 1, 1, 1, 0, 0, 1, 0x6E); mc_b1(c, 0xC1) // VMOVQ XMM0, R9
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x59); mc_b1(c, 0xC0) // VPBROADCASTQ YMM0, XMM0
        mc_b3(c, 0x49, 0x81, 0xF8); mc_u32(c, 128)
        jb_s32 := mc_jcc8(c, 0x72)
        mc_align16_nop(c)
        lp_s128 := buf_len(c)
        mc_b4(c, 0xC5, 0xFE, 0x7F, 0x01)
        mc_b4(c, 0xC5, 0xFE, 0x7F, 0x41); mc_b1(c, 32)
        mc_b4(c, 0xC5, 0xFE, 0x7F, 0x41); mc_b1(c, 64)
        mc_b4(c, 0xC5, 0xFE, 0x7F, 0x41); mc_b1(c, 96)
        mc_b3(c, 0x48, 0x81, 0xC1); mc_u32(c, 128)
        mc_b3(c, 0x49, 0x81, 0xE8); mc_u32(c, 128)
        mc_b3(c, 0x49, 0x81, 0xF8); mc_u32(c, 128)
        jae_s128 := mc_jcc8(c, 0x73); mc_patch_jcc8(c, jae_s128, lp_s128)
        mc_patch_jcc8(c, jb_s32, buf_len(c))
        mc_b4(c, 0x49, 0x83, 0xF8, 32)
        jb_s_vzu := mc_jcc8(c, 0x72)
        lp_s32 := buf_len(c)
        mc_b4(c, 0xC5, 0xFE, 0x7F, 0x01)
        mc_b4(c, 0x48, 0x83, 0xC1, 32)
        mc_b4(c, 0x49, 0x83, 0xE8, 32)
        mc_b4(c, 0x49, 0x83, 0xF8, 32)
        jae_s32 := mc_jcc8(c, 0x73); mc_patch_jcc8(c, jae_s32, lp_s32)
        mc_patch_jcc8(c, jb_s_vzu, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)                   // VZEROUPPER
        mc_patch_rel32(c, jb_s_tail, buf_len(c))
        mc_patch_rel32(c, jz_s_tail, buf_len(c))
        mc_b4(c, 0x49, 0x83, 0xF8, 8)
        jb_s1 := mc_jcc8(c, 0x72)
        lp_s8 := buf_len(c)
        mc_b3(c, 0x4C, 0x89, 0x09)                   // MOV [RCX], R9
        mc_b4(c, 0x48, 0x83, 0xC1, 8)
        mc_b4(c, 0x49, 0x83, 0xE8, 8)
        mc_b4(c, 0x49, 0x83, 0xF8, 8)
        jae_s8 := mc_jcc8(c, 0x73); mc_patch_jcc8(c, jae_s8, lp_s8)
        mc_patch_jcc8(c, jb_s1, buf_len(c))
        mc_b3(c, 0x4D, 0x85, 0xC0)
        jz_s_ret := mc_jcc8(c, 0x74)
        lp_s1 := buf_len(c)
        mc_b2(c, 0x88, 0x11)                         // MOV [RCX], DL
        mc_b3(c, 0x48, 0xFF, 0xC1)
        mc_b3(c, 0x49, 0xFF, 0xC8)
        jnz_s1 := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_s1, lp_s1)
        mc_patch_jcc8(c, jz_s_ret, buf_len(c))
        mc_patch_rel32(c, jle_s0, buf_len(c))
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_fast_memset(), s_fms, buf_len(c))
    }

    emit_io_helpers_used(cg)
}

fn emit_io_helpers_used(cg: CodegenCtx) {
    c := cg.code
    osm := cg_os_mode(cg)

    if cg_is_helper_used(cg, h_str_eq()) {
        mc_align16(c)
        s_eq := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        mc_b3(c, 0x4C, 0x39, 0xCA)             // CMP RDX, R9 (lenA == lenB)
        jne_len := mc_jcc32(c, 0x85)
        mc_b3(c, 0x4C, 0x39, 0xC1)             // CMP RCX, R8 (ptrA == ptrB fastpath!)
        je_ptr := mc_jcc32(c, 0x84)
        mc_b3(c, 0x48, 0x85, 0xD2)             // TEST RDX, RDX (len == 0)
        jz_empty := mc_jcc32(c, 0x84)
        // AVX2 32-byte/iter + overlapped last-32B fastpath when len >= 32 and g_simd_tier >= 1
        mc_b4(c, 0x48, 0x83, 0xFA, 0x20)       // CMP RDX, 32
        jb_lt32 := mc_jcc32(c, 0x82)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)             // TEST RAX, RAX
        jz_no_avx := mc_jcc32(c, 0x84)
        mc_b4(c, 0x4C, 0x8D, 0x5A, 0xE0)       // LEA R11, [RDX - 32]
        // Single-shot 32..64B dual-YMM fastpath (0 loop overhead!)
        mc_b4(c, 0x48, 0x83, 0xFA, 0x40)       // CMP RDX, 64
        ja_gt64 := mc_jcc8(c, 0x77)
        mc_b3(c, 0xC5, 0xFE, 0x6F); mc_b1(c, 0x01)                           // VMOVDQU YMM0, [RCX]
        mc_b4(c, 0xC4, 0xC1, 0x7D, 0x74); mc_b1(c, 0x00)                     // VPCMPEQB YMM0, YMM0, [R8]
        mc_b4(c, 0xC4, 0xA1, 0x7E, 0x6F); mc_b2(c, 0x0C, 0x19)               // VMOVDQU YMM1, [RCX + R11]
        mc_b4(c, 0xC4, 0x81, 0x75, 0x74); mc_b2(c, 0x0C, 0x18)               // VPCMPEQB YMM1, YMM1, [R8 + R11]
        mc_b4(c, 0xC5, 0xFD, 0xDB, 0xC1)                                     // VPAND YMM0, YMM0, YMM1
        mc_b4(c, 0xC5, 0xFD, 0xD7, 0xC0)                                     // VPMOVMSKB EAX, YMM0
        mc_b3(c, 0xC5, 0xF8, 0x77)                                           // VZEROUPPER
        mc_b3(c, 0x83, 0xF8, 0xFF)                                           // CMP EAX, -1
        mc_b3(c, 0x0F, 0x94, 0xC0)                                           // SETE AL
        mc_b3(c, 0x0F, 0xB6, 0xC0)                                           // MOVZX EAX, AL
        mc_b1(c, 0xC3)
        mc_patch_jcc8(c, ja_gt64, buf_len(c))
        mc_b2(c, 0x31, 0xC0)                   // XOR EAX, EAX
        mc_b3(c, 0x4C, 0x39, 0xD8)             // CMP RAX, R11
        jae_tail32 := mc_jcc8(c, 0x73)
        lp_eq32 := buf_len(c)
        mc_b4(c, 0xC5, 0xFE, 0x6F, 0x04); mc_b1(c, 0x01)                   // VMOVDQU YMM0, [RCX + RAX]
        mc_b4(c, 0xC4, 0xC1, 0x7D, 0x74); mc_b2(c, 0x04, 0x00)             // VPCMPEQB YMM0, YMM0, [R8 + RAX]
        mc_b4(c, 0xC5, 0x7D, 0xD7, 0xD0)                                   // VPMOVMSKB R10D, YMM0
        mc_b4(c, 0x41, 0x83, 0xFA, 0xFF)                                   // CMP R10D, -1
        jne_avx := mc_jcc8(c, 0x75)
        mc_b4(c, 0x48, 0x83, 0xC0, 0x20)                                   // ADD RAX, 32
        mc_b3(c, 0x4C, 0x39, 0xD8)                                         // CMP RAX, R11
        jb_eq32 := mc_jcc8(c, 0x72)
        mc_patch_jcc8(c, jb_eq32, lp_eq32)
        mc_patch_jcc8(c, jae_tail32, buf_len(c))
        mc_b4(c, 0xC4, 0xA1, 0x7E, 0x6F); mc_b2(c, 0x04, 0x19)             // VMOVDQU YMM0, [RCX + R11]
        mc_b4(c, 0xC4, 0x81, 0x7D, 0x74); mc_b2(c, 0x04, 0x18)             // VPCMPEQB YMM0, YMM0, [R8 + R11]
        mc_b4(c, 0xC5, 0xFD, 0xD7, 0xC0)                                   // VPMOVMSKB EAX, YMM0
        mc_b3(c, 0xC5, 0xF8, 0x77)                                         // VZEROUPPER
        mc_b3(c, 0x83, 0xF8, 0xFF)                                         // CMP EAX, -1
        mc_b3(c, 0x0F, 0x94, 0xC0)                                         // SETE AL
        mc_b3(c, 0x0F, 0xB6, 0xC0)                                         // MOVZX EAX, AL
        mc_b1(c, 0xC3)
        mc_patch_jcc8(c, jne_avx, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)                                         // VZEROUPPER
        mc_b3(c, 0x31, 0xC0, 0xC3)                                         // XOR EAX, EAX; RET
        lt32_pos := buf_len(c)
        mc_patch_rel32(c, jb_lt32, lt32_pos)
        mc_patch_rel32(c, jz_no_avx, lt32_pos)
        mc_b2(c, 0x31, 0xC0)                   // XOR EAX, EAX
        // 8-byte SWAR compare loop + scalar tail
        mc_b3(c, 0x49, 0x89, 0xD3)             // MOV R11, RDX
        mc_b4(c, 0x49, 0x83, 0xE3, 0xF8)       // AND R11, -8
        lp_eq8 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD8)             // CMP RAX, R11
        jae_eq8 := mc_jcc8(c, 0x73)
        mc_b4(c, 0x4C, 0x8B, 0x14, 0x01)       // MOV R10, [RCX + RAX]
        mc_b4(c, 0x4D, 0x3B, 0x14, 0x00)       // CMP R10, [R8 + RAX]
        jne_q := mc_jcc8(c, 0x75)
        mc_b4(c, 0x48, 0x83, 0xC0, 0x08)       // ADD RAX, 8
        jmp_eq8 := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_eq8, lp_eq8)
        mc_patch_jcc8(c, jae_eq8, buf_len(c))
        lpos := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD0)
        jae_t := mc_jcc8(c, 0x73)
        mc_b4(c, 0x44, 0x8A, 0x14, 0x01)
        mc_b4(c, 0x45, 0x3A, 0x14, 0x00)
        jne_b := mc_jcc8(c, 0x75)
        mc_b3(c, 0x48, 0xFF, 0xC0)
        jmp_l := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_l, lpos)
        r_true := buf_len(c)
        mc_b1(c, 0xB8)
        mc_u32(c, 1)
        mc_b1(c, 0xC3)
        r_false := buf_len(c)
        mc_b3(c, 0x31, 0xC0, 0xC3)
        mc_patch_rel32(c, je_ptr, r_true)
        mc_patch_rel32(c, jz_empty, r_true)
        mc_patch_jcc8(c, jae_t, r_true)
        mc_patch_rel32(c, jne_len, r_false)
        mc_patch_jcc8(c, jne_q, r_false)
        mc_patch_jcc8(c, jne_b, r_false)
        cg_reg_helper(cg, h_str_eq(), s_eq, buf_len(c))
    }

    if cg_is_helper_used(cg, h_args_get()) {
        mc_align16(c)
        s_ag := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        if osm <= 1 {
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b4(c, 0x48, 0x83, 0xEC, 0x30)
            mc_b4(c, 0x48, 0x89, 0x4D, 0xF8)
            cg_call_iat(cg, iat_get_command_line_a())
            mc_b3(c, 0x49, 0x89, 0xC0)
            mc_b3(c, 0x45, 0x31, 0xC9)
            mc_b4(c, 0x4C, 0x8B, 0x55, 0xF8)

            next_tok := buf_len(c)
            skip_ws := buf_len(c)
            mc_b4(c, 0x41, 0x0F, 0xB6, 0x00)
            mc_b2(c, 0x3C, 32)
            je_sp := mc_jcc8(c, 0x74)
            mc_b2(c, 0x3C, 9)
            jne_wsd := mc_jcc8(c, 0x75)
            mc_patch_jcc8(c, je_sp, buf_len(c))
            mc_b3(c, 0x49, 0xFF, 0xC0)
            jmp_ws := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, jmp_ws, skip_ws)
            mc_patch_jcc8(c, jne_wsd, buf_len(c))

            mc_b2(c, 0x84, 0xC0)
            jz_done := mc_jcc32(c, 0x84)
            mc_b2(c, 0x3C, 34)
            jne_uq := mc_jcc8(c, 0x75)

            mc_b3(c, 0x49, 0xFF, 0xC0)
            mc_b3(c, 0x4C, 0x89, 0xC1)
            ql := buf_len(c)
            mc_b4(c, 0x41, 0x0F, 0xB6, 0x00)
            mc_b2(c, 0x84, 0xC0)
            jz_qe := mc_jcc8(c, 0x74)
            mc_b2(c, 0x3C, 34)
            je_qe := mc_jcc8(c, 0x74)
            mc_b3(c, 0x49, 0xFF, 0xC0)
            j_ql := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, j_ql, ql)
            mc_patch_jcc8(c, jz_qe, buf_len(c))
            mc_patch_jcc8(c, je_qe, buf_len(c))
            mc_b3(c, 0x4C, 0x89, 0xC2)
            mc_b3(c, 0x48, 0x29, 0xCA)
            mc_b2(c, 0x3C, 34)
            jne_gfq := mc_jcc8(c, 0x75)
            mc_b3(c, 0x49, 0xFF, 0xC0)
            jmp_gfq := mc_jcc8(c, 0xEB)

            mc_patch_jcc8(c, jne_uq, buf_len(c))
            mc_b3(c, 0x4C, 0x89, 0xC1)
            uql := buf_len(c)
            mc_b4(c, 0x41, 0x0F, 0xB6, 0x00)
            mc_b2(c, 0x84, 0xC0)
            jz_uqe := mc_jcc8(c, 0x74)
            mc_b2(c, 0x3C, 32)
            je_uqs := mc_jcc8(c, 0x74)
            mc_b2(c, 0x3C, 9)
            je_uqt := mc_jcc8(c, 0x74)
            mc_b3(c, 0x49, 0xFF, 0xC0)
            j_uql := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, j_uql, uql)
            mc_patch_jcc8(c, jz_uqe, buf_len(c))
            mc_patch_jcc8(c, je_uqs, buf_len(c))
            mc_patch_jcc8(c, je_uqt, buf_len(c))
            mc_b3(c, 0x4C, 0x89, 0xC2)
            mc_b3(c, 0x48, 0x29, 0xCA)

            mc_patch_jcc8(c, jne_gfq, buf_len(c))
            mc_patch_jcc8(c, jmp_gfq, buf_len(c))
            mc_b3(c, 0x4D, 0x39, 0xD1)
            je_fnd := mc_jcc8(c, 0x74)
            mc_b3(c, 0x49, 0xFF, 0xC1)
            j_nt := mc_jmp32(c)
            mc_patch_rel32(c, j_nt, next_tok)

            mc_patch_jcc8(c, je_fnd, buf_len(c))
            mc_b3(c, 0x48, 0x89, 0xC8)
            mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
            mc_b1(c, 0xC3)

            mc_patch_rel32(c, jz_done, buf_len(c))
            mc_b3(c, 0x4D, 0x85, 0xD2)
            jns_nc := mc_jcc8(c, 0x79)
            mc_b3(c, 0x4C, 0x89, 0xC8)
            mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
            mc_b1(c, 0xC3)
            mc_patch_jcc8(c, jns_nc, buf_len(c))
            mc_b4(c, 0x31, 0xC0, 0x31, 0xD2)
            mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
            mc_b1(c, 0xC3)
        } else {
            // Linux / macOS SysV `_start` stack: `[saved_rsp] = argc`, `[saved_rsp + 8 + idx*8] = argv[idx]`
            cg_mov_rax_data(cg, data_off_unix_rsp())
            mc_b3(c, 0x48, 0x85, 0xC0)
            jz_no_rsp := mc_jcc8(c, 0x74)
            mc_b3(c, 0x4C, 0x8B, 0x00) // R8 = argc
            mc_b3(c, 0x48, 0x85, 0xC9) // TEST RCX, RCX (`idx < 0` -> return `argc`)
            jns_idx := mc_jcc8(c, 0x79)
            mc_b3(c, 0x4C, 0x89, 0xC0)
            mc_b1(c, 0xC3)
            mc_patch_jcc8(c, jns_idx, buf_len(c))
            mc_b3(c, 0x4C, 0x39, 0xC1) // CMP RCX, R8
            jae_oob := mc_jcc8(c, 0x73)
            mc_b4(c, 0x48, 0x8B, 0x44, 0xC8); mc_b1(c, 0x08) // RAX = [RAX + RCX*8 + 8]
            mc_b2(c, 0x31, 0xD2)
            sl_top := buf_len(c)
            mc_b4(c, 0x80, 0x3C, 0x10, 0x00) // CMP byte [RAX + RDX], 0
            je_sld := mc_jcc8(c, 0x74)
            mc_b3(c, 0x48, 0xFF, 0xC2)
            jmp_sl := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, jmp_sl, sl_top)
            mc_patch_jcc8(c, je_sld, buf_len(c))
            mc_b1(c, 0xC3)
            mc_patch_jcc8(c, jz_no_rsp, buf_len(c))
            mc_patch_jcc8(c, jae_oob, buf_len(c))
            mc_b4(c, 0x31, 0xC0, 0x31, 0xD2)
            mc_b1(c, 0xC3)
        }
        cg_reg_helper(cg, h_args_get(), s_ag, buf_len(c))

        if cg_is_helper_used(cg, h_args_count()) {
            mc_align16(c)
            s_ac := buf_len(c)
            mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
            mc_b3(c, 0x48, 0xC7, 0xC1)
            mc_u32(c, 0xFFFFFFFF)
            j_ag := mc_jmp32(c)
            mc_patch_rel32(c, j_ag, s_ag)
            cg_reg_helper(cg, h_args_count(), s_ac, buf_len(c))
        }
    }

    emit_fs_helpers_used(cg)
}

fn emit_fs_helpers_used(cg: CodegenCtx) {
    c := cg.code
    osm := cg_os_mode(cg)

    if cg_is_helper_used(cg, h_fs_read()) {
        mc_align16(c)
        s_fr := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        if osm <= 1 {
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b3(c, 0x48, 0x81, 0xEC)
            mc_u32(c, 0x280)
            mc_b3(c, 0x48, 0x85, 0xC9) // TEST RCX, RCX
            jz_rnull := mc_jcc32(c, 0x84)
            mc_b3(c, 0x48, 0x85, 0xD2) // TEST RDX, RDX
            jle_rlen := mc_jcc32(c, 0x8E)
            mc_b3(c, 0x48, 0x81, 0xFA); mc_u32(c, 500) // CMP RDX, 500
            jae_rlen := mc_jcc32(c, 0x83) // reject path >= 500 bytes (no silent truncation)
            mc_b3(c, 0x4C, 0x8D, 0x85)
            mc_u32(c, 0 - 0x220)
            mc_b2(c, 0x31, 0xC0)
            cpl1 := buf_len(c)
            mc_b3(c, 0x48, 0x39, 0xD0)
            ja1 := mc_jcc8(c, 0x73)
            mc_b4(c, 0x44, 0x8A, 0x0C, 0x01)
            mc_b3(c, 0x45, 0x84, 0xC9) // TEST R9B, R9B (reject embedded NUL CWE-158)
            jz_rnul := mc_jcc32(c, 0x84)
            mc_b4(c, 0x45, 0x88, 0x0C, 0x00)
            mc_b3(c, 0x48, 0xFF, 0xC0)
            jcp1 := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, jcp1, cpl1)
            mc_patch_jcc8(c, ja1, buf_len(c))
            mc_b4(c, 0x41, 0xC6, 0x04, 0x00)
            mc_b1(c, 0)

            mc_b3(c, 0x4C, 0x89, 0xC1)
            mc_b1(c, 0xBA)
            mc_u32(c, 0x80000000)
            mc_b2(c, 0x41, 0xB8)
            mc_u32(c, 1)
            mc_b3(c, 0x45, 0x31, 0xC9)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24)
            mc_b1(c, 0x20)
            mc_u32(c, 3)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24)
            mc_b1(c, 0x28)
            mc_u32(c, 0x80)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24)
            mc_b1(c, 0x30)
            mc_u32(c, 0)
            cg_call_iat(cg, iat_create_file_a())

            mc_b4(c, 0x48, 0x83, 0xF8, 0xFF)
            je_er1 := mc_jcc32(c, 0x84)
            mc_b4(c, 0x48, 0x89, 0x45, 0xF8)
            mc_b3(c, 0x48, 0x89, 0xC1)
            mc_b4(c, 0x48, 0x8D, 0x55, 0xF0)
            cg_call_iat(cg, iat_get_file_size_ex())
            mc_b2(c, 0x85, 0xC0)
            jz_gsz := mc_jcc32(c, 0x84)
            mc_b4(c, 0x48, 0x8B, 0x55, 0xF0)
            mc_b3(c, 0x48, 0x85, 0xD2)
            js_fsz := mc_jcc32(c, 0x88)
            mc_b3(c, 0x48, 0x81, 0xFA); mc_u32(c, 0x7FFF0000)
            ja_fsz := mc_jcc32(c, 0x87)

            mc_b4(c, 0x48, 0x8D, 0x4A, 0x40) // LEA RCX, [RDX + 64]
            cg_call_fn(cg, h_alloc_mem())
            mc_b3(c, 0x48, 0x85, 0xC0)
            jz_va := mc_jcc32(c, 0x84)

            mc_b4(c, 0x48, 0x89, 0x45, 0xE8)
            mc_b4(c, 0x48, 0x8B, 0x55, 0xF0)
            mc_b4(c, 0x48, 0x83, 0xC2, 0x20)
            mc_b4(c, 0x48, 0x89, 0x50, 0x08)
            mc_b4(c, 0x48, 0x8B, 0x4D, 0xF8)
            mc_b4(c, 0x48, 0x8D, 0x50, 0x10)
            mc_b4(c, 0x44, 0x8B, 0x45, 0xF0)
            mc_b4(c, 0x4C, 0x8D, 0x4D, 0xE0)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24)
            mc_b1(c, 0x20)
            mc_u32(c, 0)
            mc_b4(c, 0x48, 0xC7, 0x45, 0xE0)
            mc_u32(c, 0)
            cg_call_iat(cg, iat_read_file())

            mc_b4(c, 0x48, 0x8B, 0x45, 0xE8)
            mc_b3(c, 0x8B, 0x55, 0xE0)
            mc_b3(c, 0x48, 0x89, 0x10)
            mc_b4(c, 0x48, 0x8B, 0x4D, 0xF8)
            cg_call_iat(cg, iat_close_handle())

            mc_b2(c, 0x31, 0xC0)
            mc_b4(c, 0x48, 0x8B, 0x55, 0xE8)
            mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
            mc_b1(c, 0xC3)

            mc_patch_rel32(c, jz_gsz, buf_len(c))
            mc_patch_rel32(c, js_fsz, buf_len(c))
            mc_patch_rel32(c, ja_fsz, buf_len(c))
            mc_patch_rel32(c, jz_va, buf_len(c))
            mc_b4(c, 0x48, 0x8B, 0x4D, 0xF8)
            cg_call_iat(cg, iat_close_handle())

            mc_patch_rel32(c, jz_rnull, buf_len(c))
            mc_patch_rel32(c, jz_rnul, buf_len(c))
            mc_patch_rel32(c, jle_rlen, buf_len(c))
            mc_patch_rel32(c, jae_rlen, buf_len(c))
            mc_patch_rel32(c, je_er1, buf_len(c))
            mc_b1(c, 0xB8)
            mc_u32(c, 1)
            mc_b2(c, 0x31, 0xD2)
            mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
            mc_b1(c, 0xC3)
        } else {
            // Direct Linux x86_64 `openat(257)` + `lseek(8)` + `h_alloc_mem` + `read(0)` + `close(3)`
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b2(c, 0x56, 0x57)
            mc_b3(c, 0x48, 0x81, 0xEC); mc_u32(c, 0x260)
            mc_b3(c, 0x48, 0x85, 0xC9)
            jz_lrnull := mc_jcc32(c, 0x84)
            mc_b3(c, 0x48, 0x85, 0xD2)
            jle_lrlen := mc_jcc32(c, 0x8E)
            mc_b3(c, 0x48, 0x81, 0xFA); mc_u32(c, 500)
            jae_lrlen := mc_jcc32(c, 0x83)
            mc_b3(c, 0x4C, 0x8D, 0x85); mc_u32(c, 0 - 0x220)
            mc_b2(c, 0x31, 0xC0)
            lcpl := buf_len(c)
            mc_b3(c, 0x48, 0x39, 0xD0)
            lja1 := mc_jcc8(c, 0x73)
            mc_b4(c, 0x44, 0x8A, 0x0C, 0x01)
            mc_b3(c, 0x45, 0x84, 0xC9)
            jz_lrnul := mc_jcc32(c, 0x84)
            mc_b4(c, 0x45, 0x88, 0x0C, 0x00)
            mc_b3(c, 0x48, 0xFF, 0xC0)
            ljcp := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, ljcp, lcpl)
            mc_patch_jcc8(c, lja1, buf_len(c))
            mc_b4(c, 0x41, 0xC6, 0x04, 0x00); mc_b1(c, 0)

            // sys_openat(AT_FDCWD=-100, path, O_RDONLY=0, 0)
            mc_b3(c, 0x48, 0xC7, 0xC7); mc_u32(c, 0 - 100)
            mc_b3(c, 0x4C, 0x89, 0xC6) // RSI = path
            mc_b2(c, 0x31, 0xD2)       // RDX = 0
            mc_b3(c, 0x45, 0x31, 0xD2) // R10 = 0
            mc_b1(c, 0xB8); mc_u32(c, 257)
            mc_b2(c, 0x0F, 0x05)
            mc_b3(c, 0x48, 0x85, 0xC0)
            jl_er := mc_jcc32(c, 0x8C)
            mc_b4(c, 0x48, 0x89, 0x45, 0xE8) // [RBP-0x18] = fd

            // size = sys_lseek(fd, 0, SEEK_END=2)
            mc_b3(c, 0x48, 0x89, 0xC7)
            mc_b2(c, 0x31, 0xF6)
            mc_b1(c, 0xBA); mc_u32(c, 2)
            mc_b1(c, 0xB8); mc_u32(c, 8)
            mc_b2(c, 0x0F, 0x05)
            mc_b3(c, 0x48, 0x85, 0xC0)
            jl_lsz := mc_jcc32(c, 0x8C)
            mc_b2(c, 0x48, 0x3D); mc_u32(c, 0x7FFF0000)
            ja_lsz := mc_jcc32(c, 0x87)
            mc_b4(c, 0x48, 0x89, 0x45, 0xE0) // [RBP-0x20] = size

            // sys_lseek(fd, 0, SEEK_SET=0)
            mc_b4(c, 0x48, 0x8B, 0x7D, 0xE8)
            mc_b2(c, 0x31, 0xF6)
            mc_b2(c, 0x31, 0xD2)
            mc_b1(c, 0xB8); mc_u32(c, 8)
            mc_b2(c, 0x0F, 0x05)

            // buf = h_alloc_mem(size + 64)
            mc_b4(c, 0x48, 0x8B, 0x4D, 0xE0)
            mc_b4(c, 0x48, 0x83, 0xC1, 0x40)
            cg_call_fn(cg, h_alloc_mem())
            mc_b3(c, 0x48, 0x85, 0xC0)
            jz_lva := mc_jcc32(c, 0x84)
            mc_b4(c, 0x48, 0x89, 0x45, 0xD8) // [RBP-0x28] = buf
            mc_b4(c, 0x48, 0x8B, 0x55, 0xE0)
            mc_b4(c, 0x48, 0x83, 0xC2, 0x20)
            mc_b4(c, 0x48, 0x89, 0x50, 0x08) // [buf+8] = cap

            // nread = sys_read(fd, buf+16, size)
            mc_b4(c, 0x48, 0x8B, 0x7D, 0xE8)
            mc_b4(c, 0x48, 0x8D, 0x70, 0x10)
            mc_b4(c, 0x48, 0x8B, 0x55, 0xE0)
            mc_b2(c, 0x31, 0xC0) // sys_read = 0
            mc_b2(c, 0x0F, 0x05)
            mc_b3(c, 0x48, 0x85, 0xC0)
            jge_lrd := mc_jcc8(c, 0x7D)
            mc_b2(c, 0x31, 0xC0)
            mc_patch_jcc8(c, jge_lrd, buf_len(c))
            mc_b4(c, 0x48, 0x8B, 0x55, 0xD8)
            mc_b3(c, 0x48, 0x89, 0x02) // [buf] = nread

            // sys_close(fd)
            mc_b4(c, 0x48, 0x8B, 0x7D, 0xE8)
            mc_b1(c, 0xB8); mc_u32(c, 3)
            mc_b2(c, 0x0F, 0x05)

            mc_b2(c, 0x31, 0xC0)
            mc_b4(c, 0x48, 0x8B, 0x55, 0xD8)
            mc_b3(c, 0x48, 0x81, 0xC4); mc_u32(c, 0x260)
            mc_b2(c, 0x5F, 0x5E)
            mc_b1(c, 0x5D)
            mc_b1(c, 0xC3)

            mc_patch_rel32(c, jl_lsz, buf_len(c))
            mc_patch_rel32(c, ja_lsz, buf_len(c))
            mc_patch_rel32(c, jz_lva, buf_len(c))
            mc_b4(c, 0x48, 0x8B, 0x7D, 0xE8)
            mc_b1(c, 0xB8); mc_u32(c, 3)
            mc_b2(c, 0x0F, 0x05)

            mc_patch_rel32(c, jz_lrnull, buf_len(c))
            mc_patch_rel32(c, jz_lrnul, buf_len(c))
            mc_patch_rel32(c, jle_lrlen, buf_len(c))
            mc_patch_rel32(c, jae_lrlen, buf_len(c))
            mc_patch_rel32(c, jl_er, buf_len(c))
            mc_b1(c, 0xB8); mc_u32(c, 1)
            mc_b2(c, 0x31, 0xD2)
            mc_b3(c, 0x48, 0x81, 0xC4); mc_u32(c, 0x260)
            mc_b2(c, 0x5F, 0x5E)
            mc_b1(c, 0x5D)
            mc_b1(c, 0xC3)
        }
        cg_reg_helper(cg, h_fs_read(), s_fr, buf_len(c))
    }

    if cg_is_helper_used(cg, h_fs_write()) {
        mc_align16(c)
        s_fw := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
        if osm <= 1 {
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b3(c, 0x48, 0x81, 0xEC)
            mc_u32(c, 0x280)
            mc_b4(c, 0x4C, 0x89, 0x45, 0xE8)
            mc_b3(c, 0x48, 0x85, 0xC9)
            jz_wnull := mc_jcc32(c, 0x84)
            mc_b3(c, 0x4D, 0x85, 0xC0) // TEST R8, R8 (buf ptr)
            jz_wbuf := mc_jcc32(c, 0x84)
            mc_b3(c, 0x48, 0x85, 0xD2)
            jle_wlen := mc_jcc32(c, 0x8E)
            mc_b3(c, 0x48, 0x81, 0xFA); mc_u32(c, 500)
            jae_wlen := mc_jcc32(c, 0x83)
            mc_b3(c, 0x4C, 0x8D, 0x85)
            mc_u32(c, 0 - 0x220)
            mc_b2(c, 0x31, 0xC0)
            cpl2 := buf_len(c)
            mc_b3(c, 0x48, 0x39, 0xD0)
            jb1 := mc_jcc8(c, 0x73)
            mc_b4(c, 0x44, 0x8A, 0x0C, 0x01)
            mc_b3(c, 0x45, 0x84, 0xC9)
            jz_wnul := mc_jcc32(c, 0x84)
            mc_b4(c, 0x45, 0x88, 0x0C, 0x00)
            mc_b3(c, 0x48, 0xFF, 0xC0)
            jcp2 := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, jcp2, cpl2)
            mc_patch_jcc8(c, jb1, buf_len(c))
            mc_b4(c, 0x41, 0xC6, 0x04, 0x00)
            mc_b1(c, 0)

            mc_b3(c, 0x4C, 0x89, 0xC1)
            mc_b1(c, 0xBA)
            mc_u32(c, 0x40000000)
            mc_b3(c, 0x45, 0x31, 0xC0)
            mc_b3(c, 0x45, 0x31, 0xC9)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24)
            mc_b1(c, 0x20)
            mc_u32(c, 2)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24)
            mc_b1(c, 0x28)
            mc_u32(c, 0x80)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24)
            mc_b1(c, 0x30)
            mc_u32(c, 0)
            cg_call_iat(cg, iat_create_file_a())

            mc_b4(c, 0x48, 0x83, 0xF8, 0xFF)
            je_er2 := mc_jcc32(c, 0x84)
            mc_b4(c, 0x48, 0x89, 0x45, 0xF8)
            mc_b4(c, 0x4C, 0x8B, 0x55, 0xE8)
            mc_b3(c, 0x48, 0x89, 0xC1)
            mc_b4(c, 0x49, 0x8D, 0x52, 0x10)
            mc_b3(c, 0x45, 0x8B, 0x02)
            mc_b4(c, 0x4C, 0x8D, 0x4D, 0xE0)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24)
            mc_b1(c, 0x20)
            mc_u32(c, 0)
            mc_b4(c, 0x48, 0xC7, 0x45, 0xE0)
            mc_u32(c, 0)
            cg_call_iat(cg, iat_write_file())

            mc_b4(c, 0x48, 0x8B, 0x4D, 0xF8)
            cg_call_iat(cg, iat_close_handle())

            mc_b2(c, 0x31, 0xC0)
            mc_b3(c, 0x8B, 0x55, 0xE0)
            mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
            mc_b1(c, 0xC3)

            mc_patch_rel32(c, jz_wnull, buf_len(c))
            mc_patch_rel32(c, jz_wnul, buf_len(c))
            mc_patch_rel32(c, jz_wbuf, buf_len(c))
            mc_patch_rel32(c, jle_wlen, buf_len(c))
            mc_patch_rel32(c, jae_wlen, buf_len(c))
            mc_patch_rel32(c, je_er2, buf_len(c))
            mc_b1(c, 0xB8)
            mc_u32(c, 1)
            mc_b2(c, 0x31, 0xD2)
            mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
            mc_b1(c, 0xC3)
        } else {
            // Direct Linux x86_64 `openat(257, O_WRONLY|O_CREAT|O_TRUNC=0x241, 0755=493)` + `write(1)` + `close(3)`
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b2(c, 0x56, 0x57)
            mc_b3(c, 0x48, 0x81, 0xEC); mc_u32(c, 0x260)
            mc_b4(c, 0x4C, 0x89, 0x45, 0xE8) // [RBP-0x18] = buf (R8)
            mc_b3(c, 0x48, 0x85, 0xC9)
            jz_lwn := mc_jcc32(c, 0x84)
            mc_b3(c, 0x4D, 0x85, 0xC0)
            jz_lwb := mc_jcc32(c, 0x84)
            mc_b3(c, 0x48, 0x85, 0xD2)
            jle_lwl := mc_jcc32(c, 0x8E)
            mc_b3(c, 0x48, 0x81, 0xFA); mc_u32(c, 500)
            jae_lwl := mc_jcc32(c, 0x83)
            mc_b3(c, 0x4C, 0x8D, 0x85); mc_u32(c, 0 - 0x220)
            mc_b2(c, 0x31, 0xC0)
            lcpl2 := buf_len(c)
            mc_b3(c, 0x48, 0x39, 0xD0)
            ljb1 := mc_jcc8(c, 0x73)
            mc_b4(c, 0x44, 0x8A, 0x0C, 0x01)
            mc_b3(c, 0x45, 0x84, 0xC9)
            jz_lwnul := mc_jcc32(c, 0x84)
            mc_b4(c, 0x45, 0x88, 0x0C, 0x00)
            mc_b3(c, 0x48, 0xFF, 0xC0)
            ljcp2 := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, ljcp2, lcpl2)
            mc_patch_jcc8(c, ljb1, buf_len(c))
            mc_b4(c, 0x41, 0xC6, 0x04, 0x00); mc_b1(c, 0)

            mc_b3(c, 0x48, 0xC7, 0xC7); mc_u32(c, 0 - 100) // AT_FDCWD
            mc_b3(c, 0x4C, 0x89, 0xC6)
            mc_b1(c, 0xBA); mc_u32(c, 0x241)
            mc_b3(c, 0x49, 0xC7, 0xC2); mc_u32(c, 493) // 0755 executable permissions!
            mc_b1(c, 0xB8); mc_u32(c, 257)
            mc_b2(c, 0x0F, 0x05)
            mc_b3(c, 0x48, 0x85, 0xC0)
            jl_er2 := mc_jcc32(c, 0x8C)
            mc_b4(c, 0x48, 0x89, 0x45, 0xE0) // [RBP-0x20] = fd

            mc_b3(c, 0x48, 0x89, 0xC7) // EDI = fd
            mc_b4(c, 0x48, 0x8B, 0x45, 0xE8)
            mc_b4(c, 0x48, 0x8D, 0x70, 0x10) // RSI = buf + 16
            mc_b3(c, 0x48, 0x8B, 0x10)       // RDX = [buf]
            mc_b1(c, 0xB8); mc_u32(c, 1)     // sys_write
            mc_b2(c, 0x0F, 0x05)
            mc_b4(c, 0x48, 0x89, 0x45, 0xD8) // [RBP-0x28] = nwritten

            mc_b4(c, 0x48, 0x8B, 0x7D, 0xE0)
            mc_b1(c, 0xB8); mc_u32(c, 3)     // sys_close
            mc_b2(c, 0x0F, 0x05)

            mc_b2(c, 0x31, 0xC0)
            mc_b4(c, 0x48, 0x8B, 0x55, 0xD8)
            mc_b3(c, 0x48, 0x81, 0xC4); mc_u32(c, 0x260)
            mc_b2(c, 0x5F, 0x5E)
            mc_b1(c, 0x5D)
            mc_b1(c, 0xC3)

            mc_patch_rel32(c, jz_lwn, buf_len(c))
            mc_patch_rel32(c, jz_lwnul, buf_len(c))
            mc_patch_rel32(c, jz_lwb, buf_len(c))
            mc_patch_rel32(c, jle_lwl, buf_len(c))
            mc_patch_rel32(c, jae_lwl, buf_len(c))
            mc_patch_rel32(c, jl_er2, buf_len(c))
            mc_b1(c, 0xB8); mc_u32(c, 1)
            mc_b2(c, 0x31, 0xD2)
            mc_b3(c, 0x48, 0x81, 0xC4); mc_u32(c, 0x260)
            mc_b2(c, 0x5F, 0x5E)
            mc_b1(c, 0x5D)
            mc_b1(c, 0xC3)
        }
        cg_reg_helper(cg, h_fs_write(), s_fw, buf_len(c))
    }

    emit_ai_runtime_helpers(cg)

    // Demand-driven `h_detect_cpuid`: inspect `cg.fixups` to see whether `g_simd_tier` or `g_cpu_threads` is actually read!
    if cg_is_helper_used(cg, h_detect_cpuid()) {
        mut need_simd := false
        mut need_threads := false
        fxc := ibuf_len(cg.fixups) / 4
        mut fxi := 0
        while fxi < fxc {
            fb := fxi * 4
            if ibuf_get(cg.fixups, fb + 2) == fx_data() {
                doff := ibuf_get(cg.fixups, fb + 3)
                if doff == data_off_simd_tier() { need_simd = true }
                if doff == data_off_cpu_threads() { need_threads = true }
            }
            fxi += 1
        }
        if not need_simd and not need_threads {
            // Elide `h_detect_cpuid` completely and replace `_start` CALL rel32 with 5-byte NOP (`0F 1F 44 00 00`)!
            fxi = 0
            while fxi < fxc {
                fb := fxi * 4
                if ibuf_get(cg.fixups, fb + 2) == fx_fn() and ibuf_get(cg.fixups, fb + 3) == h_detect_cpuid() {
                    dp := ibuf_get(cg.fixups, fb)
                    if dp >= 1 and buf_get(c, dp - 1) == 0xE8 {
                        buf_set(c, dp - 1, 0x0F)
                        buf_set(c, dp, 0x1F)
                        buf_set(c, dp + 1, 0x44)
                        buf_set(c, dp + 2, 0x00)
                        buf_set(c, dp + 3, 0x00)
                        ibuf_set(cg.fixups, fb + 2, 0)
                    }
                }
                fxi += 1
            }
        } else {
            mc_align16(c)
            s_cp := buf_len(c)
            mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b1(c, 0x53)
            mc_b4(c, 0x48, 0x83, 0xEC, 0x58)
            if need_simd {
                simd_ov := ibuf_get(cg.state, 17)
                if simd_ov >= 0 {
                    mc_mov_rax_imm(c, simd_ov)
                    cg_store_rax_data(cg, data_off_simd_tier())
                } else {
                    mc_b3(c, 0x45, 0x31, 0xC0)
                    mc_b1(c, 0xB8); mc_u32(c, 1)
                    mc_b2(c, 0x31, 0xC9)
                    mc_b2(c, 0x0F, 0xA2)
                    mc_b2(c, 0x81, 0xE1); mc_u32(c, 0x18001000)
                    mc_b2(c, 0x81, 0xF9); mc_u32(c, 0x18001000)
                    jne_c1 := mc_jcc8(c, 0x75)
                    mc_b2(c, 0x31, 0xC9)
                    mc_b3(c, 0x0F, 0x01, 0xD0)
                    mc_b3(c, 0x41, 0x89, 0xC1)
                    mc_b3(c, 0x83, 0xE0, 0x06)
                    mc_b3(c, 0x83, 0xF8, 0x06)
                    jne_c2 := mc_jcc8(c, 0x75)
                    mc_b1(c, 0xB8); mc_u32(c, 7)
                    mc_b2(c, 0x31, 0xC9)
                    mc_b2(c, 0x0F, 0xA2)
                    // Require AVX2 (EBX bit 5 = 0x20), BMI1 (bit 3 = 0x8) AND BMI2 (bit 8 = 0x100) for simd_tier >= 1
                    mc_b2(c, 0x89, 0xD8)
                    mc_b1(c, 0x25); mc_u32(c, 0x00000128)
                    mc_b1(c, 0x3D); mc_u32(c, 0x00000128)
                    jz_c3 := mc_jcc8(c, 0x75)
                    mc_b2(c, 0x41, 0xB8); mc_u32(c, 1)
                    mc_b2(c, 0xF7, 0xC3); mc_u32(c, 0x00010000)
                    jz_c4 := mc_jcc8(c, 0x74)
                    mc_b3(c, 0x41, 0x81, 0xE1); mc_u32(c, 0xE6)
                    mc_b3(c, 0x41, 0x81, 0xF9); mc_u32(c, 0xE6)
                    jne_c5 := mc_jcc8(c, 0x75)
                    mc_b2(c, 0x41, 0xB8); mc_u32(c, 2)
                    mc_patch_jcc8(c, jne_c1, buf_len(c))
                    mc_patch_jcc8(c, jne_c2, buf_len(c))
                    mc_patch_jcc8(c, jz_c3, buf_len(c))
                    mc_patch_jcc8(c, jz_c4, buf_len(c))
                    mc_patch_jcc8(c, jne_c5, buf_len(c))
                    mc_b3(c, 0x4C, 0x89, 0xC0)
                    cg_store_rax_data(cg, data_off_simd_tier())
                }
            }
            if need_threads {
                if osm <= 1 {
                    mc_b4(c, 0x48, 0x8D, 0x4C, 0x24); mc_b1(c, 0x20)
                    cg_call_iat(cg, iat_get_system_info())
                    mc_b4(c, 0x8B, 0x44, 0x24, 0x40)
                    mc_b3(c, 0x83, 0xF8, 0x01)
                    jge_t1 := mc_jcc8(c, 0x7D)
                    mc_b1(c, 0xB8); mc_u32(c, 1)
                    mc_patch_jcc8(c, jge_t1, buf_len(c))
                    mc_b3(c, 0x83, 0xF8, 0x10)
                    jle_t8 := mc_jcc8(c, 0x7E)
                    mc_b1(c, 0xB8); mc_u32(c, 16)
                    mc_patch_jcc8(c, jle_t8, buf_len(c))
                    cg_store_rax_data(cg, data_off_cpu_threads())
                } else {
                    mc_mov_rax_imm(c, 1)
                    cg_store_rax_data(cg, data_off_cpu_threads())
                }
            }
            mc_b4(c, 0x48, 0x83, 0xC4, 0x58)
            mc_b1(c, 0x5B)
            mc_b1(c, 0x5D)
            mc_b1(c, 0xC3)
            cg_reg_helper(cg, h_detect_cpuid(), s_cp, buf_len(c))
        }
    }
}

// ---------------------------------------------------------------------------
// High-Performance AI Runtime Helpers (VEX/AVX2+FMA3 + Persistent Thread Pool)
// IDs `10000038..10000049`
// ---------------------------------------------------------------------------

fn mc_vex2(c: ByteBuf, vreg: i64, l: i64, pp: i64, op: i64, modrm: i64) {
    b1 := 0x80 | (((vreg ^ 15) & 15) << 3) | ((l & 1) << 2) | (pp & 3)
    mc_b4(c, 0xC5, b1, op, modrm)
}

fn mc_vex3(c: ByteBuf, r_hi: i64, x_hi: i64, b_hi: i64, m: i64, w: i64, vreg: i64, l: i64, pp: i64, op: i64) {
    b1 := (((r_hi ^ 1) & 1) << 7) | (((x_hi ^ 1) & 1) << 6) | (((b_hi ^ 1) & 1) << 5) | (m & 31)
    b2 := ((w & 1) << 7) | (((vreg ^ 15) & 15) << 3) | ((l & 1) << 2) | (pp & 3)
    mc_b4(c, 0xC4, b1, b2, op)
}

fn mc_ai_enter(c: ByteBuf, stack_sz: i64) {
    mc_align16(c)
    mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
    mc_b4(c, 0x55, 0x53, 0x56, 0x57)
    mc_b2(c, 0x41, 0x54)
    mc_b2(c, 0x41, 0x55)
    mc_b2(c, 0x41, 0x56)
    mc_b2(c, 0x41, 0x57)
    mut rem := stack_sz
    while rem >= 4096 {
        mc_b3(c, 0x48, 0x81, 0xEC); mc_u32(c, 4096)
        mc_b3(c, 0x85, 0x04, 0x24) // TEST [RSP], EAX (probe Win64 stack guard page)
        rem -= 4096
    }
    if rem > 0 {
        mc_b3(c, 0x48, 0x81, 0xEC); mc_u32(c, rem)
    }
}

fn mc_ai_leave(c: ByteBuf, stack_sz: i64) {
    mc_b3(c, 0x48, 0x81, 0xC4); mc_u32(c, stack_sz)
    mc_b2(c, 0x41, 0x5F)
    mc_b2(c, 0x41, 0x5E)
    mc_b2(c, 0x41, 0x5D)
    mc_b2(c, 0x41, 0x5C)
    mc_b4(c, 0x5F, 0x5E, 0x5B, 0x5D)
    mc_b1(c, 0xC3)
}

// Compute equal thread shard `R14 = (total * RCX) / RDX`, `R15 = (total * (RCX + 1)) / RDX`.
// Input: `RCX = wid`, `RDX = T`, `RAX = total`. Clobbers `RAX, RDX, RBX, R9`.
fn mc_ai_row_range(c: ByteBuf) {
    mc_b3(c, 0x48, 0x89, 0xD3)       // MOV RBX, RDX (T)
    mc_b3(c, 0x49, 0x89, 0xC1)       // MOV R9, RAX (total)
    mc_b3(c, 0x48, 0xF7, 0xE1)       // MUL RCX
    mc_b3(c, 0x48, 0xF7, 0xF3)       // DIV RBX
    mc_b3(c, 0x49, 0x89, 0xC6)       // MOV R14, RAX (r0)
    mc_b4(c, 0x48, 0x8D, 0x41, 0x01) // LEA RAX, [RCX + 1]
    mc_b3(c, 0x49, 0xF7, 0xE1)       // MUL R9
    mc_b3(c, 0x48, 0xF7, 0xF3)       // DIV RBX
    mc_b3(c, 0x49, 0x89, 0xC7)       // MOV R15, RAX (r1)
}

// Horizontal sum of `YMM0` (`8 x f32`) -> scalar `XMM0[0]` (`f32`). Clobbers `XMM1`.
fn mc_avx_hsum_ymm0(c: ByteBuf) {
    mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC1, 0x01) // VEXTRACTF128 XMM1, YMM0, 1
    mc_vex2(c, 0, 0, 0, 0x58, 0xC1)                                // VADDPS XMM0, XMM0, XMM1
    mc_vex2(c, 0, 0, 0, 0x12, 0xC8)                                // VMOVHLPS XMM1, XMM0, XMM0
    mc_vex2(c, 0, 0, 0, 0x58, 0xC1)                                // VADDPS XMM0, XMM0, XMM1
    mc_vex2(c, 0, 0, 0, 0xC6, 0xC8); mc_b1(c, 0x01)                // VSHUFPS XMM1, XMM0, XMM0, 1
    mc_vex2(c, 0, 0, 2, 0x58, 0xC1)                                // VADDSS XMM0, XMM0, XMM1
}

// Emit standard batch dispatcher `pub(RCX = args_ptr)` over local `wk_off` when `work_calc` >= `min_work`.
// Expects `[args_ptr + off_a*8]` * `[args_ptr + off_b*8]` >= `min_work` -> parallel dispatch; else 1T direct call.
fn mc_ai_emit_batch_pub(cg: CodegenCtx, hid: i64, wk_off: i64, off_a: i64, off_b: i64, min_work: i64) {
    c := cg.code
    mc_align16(c)
    s_pub := buf_len(c)
    mc_ai_enter(c, 0x28)
    mc_b3(c, 0x48, 0x89, 0xCB) // MOV RBX, RCX (args_ptr)
    mc_b3(c, 0x48, 0x8B, 0x43); mc_b1(c, off_a * 8) // MOV RAX, [RBX + off_a*8]
    mc_b3(c, 0x48, 0x85, 0xC0)
    jle_done := mc_jcc32(c, 0x8E)
    if off_b >= 0 {
        mc_b4(c, 0x48, 0x0F, 0xAF, 0x43); mc_b1(c, off_b * 8) // IMUL RAX, [RBX + off_b*8]
    }
    mc_b2(c, 0x48, 0x3D); mc_u32(c, min_work)
    jge_par := mc_jcc32(c, 0x8D)
    // 1T direct fast path: wk(wid=0, T=1, args_ptr - 32)
    mc_b2(c, 0x31, 0xC9)             // XOR ECX, ECX
    mc_b1(c, 0xBA); mc_u32(c, 1)     // MOV EDX, 1
    mc_b4(c, 0x4C, 0x8D, 0x43, 0xE0) // LEA R8, [RBX - 32]
    mc_b1(c, 0xE8)
    rel_c := wk_off - (buf_len(c) + 4)
    mc_u32(c, rel_c)
    jmp_end := mc_jmp32(c)
    mc_patch_rel32(c, jge_par, buf_len(c))
    mc_b3(c, 0x48, 0x8D, 0x0D)
    rel_w := wk_off - (buf_len(c) + 4)
    mc_u32(c, rel_w)                 // LEA RCX, [RIP + wk]
    mc_b3(c, 0x48, 0x89, 0xDA)       // MOV RDX, RBX
    cg_call_fn(cg, h_ai_pool_dispatch())
    mc_patch_rel32(c, jle_done, buf_len(c))
    mc_patch_rel32(c, jmp_end, buf_len(c))
    mc_b2(c, 0x31, 0xC0)
    mc_ai_leave(c, 0x28)
    cg_reg_helper(cg, hid, s_pub, buf_len(c))
}

fn emit_ai_ffi_pool_helpers(cg: CodegenCtx) {
    c := cg.code
    osm := cg_os_mode(cg)

    // 1. `h_c_call_v(RCX = fn_ptr, RDX = argc, R8 = argv_ptr) -> RAX`
    if cg_is_helper_used(cg, h_c_call_v()) {
        mc_align16(c)
        s_cc := buf_len(c)
        if osm <= 1 {
            mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b3(c, 0x53, 0x56, 0x41); mc_b1(c, 0x54) // PUSH RBX, RSI, R12
            mc_b3(c, 0x48, 0x81, 0xEC); mc_u32(c, 0x88) // 16B aligned + 16 qwords stack
            mc_b3(c, 0x48, 0x89, 0xCB) // RBX = fn_ptr
            mc_b3(c, 0x49, 0x89, 0xD4) // R12 = argc
            mc_b3(c, 0x4C, 0x89, 0xC6) // RSI = argv
            mc_b2(c, 0x31, 0xC0)
            mc_b3(c, 0x48, 0x85, 0xDB)
            jz_cc := mc_jcc32(c, 0x84)
            mc_b4(c, 0x49, 0x83, 0xFC, 0x00)
            jle_cc0 := mc_jcc32(c, 0x8E)
            mc_b3(c, 0x48, 0x85, 0xF6)
            jz_cc2 := mc_jcc32(c, 0x84)
            // Stack args i = 4 .. min(argc, 16) - 1
            mc_b4(c, 0x49, 0x83, 0xFC, 0x04)
            jle_ccr := mc_jcc32(c, 0x8E)
            mc_b3(c, 0x4C, 0x89, 0xE1) // MOV RCX, R12
            mc_b4(c, 0x48, 0x83, 0xF9, 0x10)
            jle_c16 := mc_jcc8(c, 0x7E)
            mc_b1(c, 0xB9); mc_u32(c, 16)
            mc_patch_jcc8(c, jle_c16, buf_len(c))
            mc_b1(c, 0xB8); mc_u32(c, 4)
            lp_ccs := buf_len(c)
            mc_b4(c, 0x48, 0x8B, 0x14, 0xC6) // MOV RDX, [RSI + RAX*8]
            mc_b4(c, 0x48, 0x89, 0x14, 0xC4) // MOV [RSP + RAX*8], RDX
            mc_b3(c, 0x48, 0xFF, 0xC0)
            mc_b3(c, 0x48, 0x39, 0xC8)
            jl_ccs := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_ccs, lp_ccs)

            mc_patch_rel32(c, jle_ccr, buf_len(c))
            mc_b3(c, 0x48, 0x8B, 0x0E)                   // MOV RCX, [RSI]
            mc_b4(c, 0x49, 0x83, 0xFC, 0x01)
            jle_c1 := mc_jcc8(c, 0x7E)
            mc_b4(c, 0x48, 0x8B, 0x56, 0x08)             // MOV RDX, [RSI + 8]
            mc_patch_jcc8(c, jle_c1, buf_len(c))
            mc_b4(c, 0x49, 0x83, 0xFC, 0x02)
            jle_c2 := mc_jcc8(c, 0x7E)
            mc_b4(c, 0x4C, 0x8B, 0x46, 0x10)             // MOV R8, [RSI + 16]
            mc_patch_jcc8(c, jle_c2, buf_len(c))
            mc_b4(c, 0x49, 0x83, 0xFC, 0x03)
            jle_c3 := mc_jcc8(c, 0x7E)
            mc_b4(c, 0x4C, 0x8B, 0x4E, 0x18)             // MOV R9, [RSI + 24]
            mc_patch_jcc8(c, jle_c3, buf_len(c))

            mc_patch_rel32(c, jle_cc0, buf_len(c))
            mc_b2(c, 0xFF, 0xD3) // CALL RBX
            mc_patch_rel32(c, jz_cc, buf_len(c))
            mc_patch_rel32(c, jz_cc2, buf_len(c))
            mc_b3(c, 0x48, 0x81, 0xC4); mc_u32(c, 0x88)
            mc_b4(c, 0x41, 0x5C, 0x5E, 0x5B)
            mc_b2(c, 0x5D, 0xC3)
        } else {
            // SysV x86_64 ABI (`RDI, RSI, RDX, RCX, R8, R9` + stack args `6..15` for Linux/macOS)
            mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
            mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
            mc_b3(c, 0x53, 0x41, 0x54); mc_b2(c, 0x41, 0x55) // PUSH RBX, R12, R13
            mc_b3(c, 0x48, 0x81, 0xEC); mc_u32(c, 0x68)     // 16B aligned + 12 qwords stack
            mc_b3(c, 0x48, 0x89, 0xCB) // RBX = fn_ptr (from RCX)
            mc_b3(c, 0x49, 0x89, 0xD4) // R12 = argc (from RDX)
            mc_b3(c, 0x4D, 0x89, 0xC5) // R13 = argv (from R8)
            mc_b2(c, 0x31, 0xC0)
            mc_b3(c, 0x48, 0x85, 0xDB); jz_su := mc_jcc32(c, 0x84)
            mc_b4(c, 0x49, 0x83, 0xFC, 0x00); jle_su0 := mc_jcc32(c, 0x8E)
            mc_b3(c, 0x4D, 0x85, 0xED); jz_su2 := mc_jcc32(c, 0x84)
            // Stack args i = 6 .. min(argc, 16) - 1 -> [RSP + (i-6)*8]
            mc_b4(c, 0x49, 0x83, 0xFC, 0x06); jle_sur := mc_jcc32(c, 0x8E)
            mc_b3(c, 0x4C, 0x89, 0xE1) // RCX = R12
            mc_b4(c, 0x48, 0x83, 0xF9, 0x10); jle_s16 := mc_jcc8(c, 0x7E)
            mc_b1(c, 0xB9); mc_u32(c, 16)
            mc_patch_jcc8(c, jle_s16, buf_len(c))
            mc_b1(c, 0xB8); mc_u32(c, 6)
            lp_sus := buf_len(c)
            mc_b4(c, 0x49, 0x8B, 0x54, 0xC5); mc_b1(c, 0) // MOV RDX, [R13 + RAX*8 + 0]
            mc_b4(c, 0x48, 0x89, 0x54, 0xC4); mc_b1(c, 0xD0) // MOV [RSP + RAX*8 - 48], RDX
            mc_b3(c, 0x48, 0xFF, 0xC0)
            mc_b3(c, 0x48, 0x39, 0xC8)
            jl_sus := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_sus, lp_sus)
            mc_patch_rel32(c, jle_sur, buf_len(c))
            mc_b4(c, 0x49, 0x8B, 0x7D, 0x00) // RDI = [R13 + 0]
            mc_b4(c, 0x49, 0x83, 0xFC, 0x01); jle_s1 := mc_jcc8(c, 0x7E)
            mc_b4(c, 0x49, 0x8B, 0x75, 0x08) // RSI = [R13 + 8]
            mc_patch_jcc8(c, jle_s1, buf_len(c))
            mc_b4(c, 0x49, 0x83, 0xFC, 0x02); jle_s2 := mc_jcc8(c, 0x7E)
            mc_b4(c, 0x49, 0x8B, 0x55, 0x10) // RDX = [R13 + 16]
            mc_patch_jcc8(c, jle_s2, buf_len(c))
            mc_b4(c, 0x49, 0x83, 0xFC, 0x03); jle_s3 := mc_jcc8(c, 0x7E)
            mc_b4(c, 0x49, 0x8B, 0x4D, 0x18) // RCX = [R13 + 24]
            mc_patch_jcc8(c, jle_s3, buf_len(c))
            mc_b4(c, 0x49, 0x83, 0xFC, 0x04); jle_s4 := mc_jcc8(c, 0x7E)
            mc_b4(c, 0x4D, 0x8B, 0x45, 0x20) // R8  = [R13 + 32]
            mc_patch_jcc8(c, jle_s4, buf_len(c))
            mc_b4(c, 0x49, 0x83, 0xFC, 0x05); jle_s5 := mc_jcc8(c, 0x7E)
            mc_b4(c, 0x4D, 0x8B, 0x4D, 0x28) // R9  = [R13 + 40]
            mc_patch_jcc8(c, jle_s5, buf_len(c))
            mc_patch_rel32(c, jle_su0, buf_len(c))
            mc_b2(c, 0x31, 0xC0) // AL = 0 (SysV varargs XMM count)
            mc_b2(c, 0xFF, 0xD3) // CALL RBX
            mc_patch_rel32(c, jz_su, buf_len(c))
            mc_patch_rel32(c, jz_su2, buf_len(c))
            mc_b3(c, 0x48, 0x81, 0xC4); mc_u32(c, 0x68)
            mc_b4(c, 0x41, 0x5D, 0x41, 0x5C); mc_b1(c, 0x5B)
            mc_b2(c, 0x5D, 0xC3)
        }
        cg_reg_helper(cg, h_c_call_v(), s_cc, buf_len(c))
    }

    // 1b. `h_thread_trampoline(RCX/RDI = ctx_ptr)`: Cross-OS thread entry wrapper for `std::threading`
    // Layout of `ctx_ptr`: `[0]=fn_addr (fn(i64)->i64), [8]=user_arg, [16]=ret_val, [24]=done_flag`
    if cg_is_helper_used(cg, h_thread_trampoline()) {
        mc_align16(c)
        s_tt := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA) // ENDBR64
        mc_b4(c, 0x55, 0x48, 0x89, 0xE5) // PUSH RBP; MOV RBP, RSP
        mc_b3(c, 0x53, 0x56, 0x57)       // PUSH RBX, RSI, RDI
        mc_b4(c, 0x41, 0x54, 0x41, 0x55) // PUSH R12, R13
        mc_b4(c, 0x41, 0x56, 0x41, 0x57) // PUSH R14, R15 (56B pushed)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x28) // SUB RSP, 0x28 (96B total -> 16B aligned!)
        if osm <= 1 {
            mc_b3(c, 0x48, 0x89, 0xCB)   // MOV RBX, RCX (Win64 LPTHREAD_START_ROUTINE arg)
        } else {
            mc_b3(c, 0x48, 0x89, 0xFB)   // MOV RBX, RDI (SysV pthread_create arg)
        }
        mc_b3(c, 0x48, 0x85, 0xDB)       // TEST RBX, RBX
        jz_tt1 := mc_jcc32(c, 0x84)
        mc_b3(c, 0x48, 0x8B, 0x03)       // MOV RAX, [RBX] (fn_addr)
        mc_b3(c, 0x48, 0x85, 0xC0)       // TEST RAX, RAX
        jz_tt2 := mc_jcc32(c, 0x84)
        mc_b4(c, 0x48, 0x8B, 0x4B, 0x08) // MOV RCX, [RBX + 8] (Axon fast_abi arg0)
        mc_b2(c, 0xFF, 0xD0)             // CALL RAX
        mc_b4(c, 0x48, 0x89, 0x43, 0x10) // MOV [RBX + 16], RAX (full 64-bit return)
        mc_b4(c, 0x48, 0xC7, 0x43, 0x18); mc_u32(c, 1) // MOV QWORD [RBX + 24], 1 (done_flag)
        mc_patch_rel32(c, jz_tt1, buf_len(c))
        mc_patch_rel32(c, jz_tt2, buf_len(c))
        mc_b2(c, 0x31, 0xC0)             // XOR EAX, EAX
        mc_b4(c, 0x48, 0x83, 0xC4, 0x28) // ADD RSP, 0x28
        mc_b4(c, 0x41, 0x5F, 0x41, 0x5E) // POP R15, R14
        mc_b4(c, 0x41, 0x5D, 0x41, 0x5C) // POP R13, R12
        mc_b3(c, 0x5F, 0x5E, 0x5B)       // POP RDI, RSI, RBX
        mc_b2(c, 0x5D, 0xC3)             // POP RBP; RET
        cg_reg_helper(cg, h_thread_trampoline(), s_tt, buf_len(c))
    }

    // 2. `h_ai_pool_worker(RCX = wid)`: Win64 Dekker hybrid adaptive spin-then-park worker loop (~0.3 us hot wake, 0% idle CPU)
    if cg_is_helper_used(cg, h_ai_pool_worker()) {
        mc_align16(c)
        s_pw := buf_len(c)
        if osm <= 1 {
            mc_ai_enter(c, 0x28)
            mc_b3(c, 0x49, 0x89, 0xCD) // R13 = wid (1..15)
            cg_mov_rax_data(cg, data_off_ai_pool())
            mc_b3(c, 0x49, 0x89, 0xC4) // R12 = pool
            mc_b3(c, 0x45, 0x31, 0xF6) // R14 = my_epoch = 0
            // R15 = &w_epoch[wid] = R12 + 512 + wid*64 (OWN dedicated 64B cache line -> ZERO false sharing!)
            mc_b3(c, 0x4C, 0x89, 0xE8); mc_b4(c, 0x48, 0xC1, 0xE0, 6) // RAX = wid * 64
            mc_b4(c, 0x4D, 0x8D, 0xBC, 0x04); mc_u32(c, 512)          // R15 = R12 + RAX + 512

            w_top := buf_len(c)
            // Phase 1: Hot spin (~1.1ms) on own 64B-isolated w_epoch[wid]; if wid >= active_t, 8x PAUSE silent-yield
            mc_b1(c, 0xBB); mc_u32(c, 122880)
            w_spin := buf_len(c)
            mc_b3(c, 0x49, 0x8B, 0x07)                        // MOV RAX, [R15] (own 64B cache line!)
            mc_b3(c, 0x4C, 0x39, 0xF0)                        // CMP RAX, R14
            jne_wjob1 := mc_jcc32(c, 0x85)
            mc_b4(c, 0x4D, 0x3B, 0xAC, 0x24); mc_u32(c, 1600) // CMP R13, [R12+1600] (wid >= active_t?)
            jb_wact := mc_jcc8(c, 0x72)
            mc_b2(c, 0xF3, 0x90); mc_b2(c, 0xF3, 0x90); mc_b2(c, 0xF3, 0x90); mc_b2(c, 0xF3, 0x90)
            mc_b2(c, 0xF3, 0x90); mc_b2(c, 0xF3, 0x90); mc_b2(c, 0xF3, 0x90); mc_b2(c, 0xF3, 0x90)
            mc_b4(c, 0x48, 0x83, 0xEB, 8)
            jg_wspin2 := mc_jcc8(c, 0x7F); mc_patch_jcc8(c, jg_wspin2, w_spin)
            jmp_wpark_now := mc_jmp32(c)
            mc_patch_jcc8(c, jb_wact, buf_len(c))
            mc_b2(c, 0xF3, 0x90)                              // 1x PAUSE for active workers
            mc_b3(c, 0x48, 0xFF, 0xCB)
            jle_wpark_end := mc_jcc8(c, 0x7E)
            mc_b2(c, 0xF7, 0xC3); mc_u32(c, 1023)             // TEST EBX, 1023 (every ~22us; 122880%1024==0!)
            jnz_ws_ny := mc_jcc8(c, 0x75)
            // Anti-LHP: if current job still incomplete (done_cnt < active_t), yield CPU to preempted sibling!
            mc_b4(c, 0x49, 0x8B, 0x84, 0x24); mc_u32(c, 1664) // RAX = done_cnt
            mc_b4(c, 0x49, 0x3B, 0x84, 0x24); mc_u32(c, 1600) // CMP done_cnt, active_t
            jge_ws_ny := mc_jcc8(c, 0x7D)
            mc_b2(c, 0x31, 0xC9)                              // Sleep(0)
            cg_call_iat(cg, iat_sleep())
            mc_patch_jcc8(c, jnz_ws_ny, buf_len(c))
            mc_patch_jcc8(c, jge_ws_ny, buf_len(c))
            jg_wspin := mc_jmp32(c); mc_patch_rel32(c, jg_wspin, w_spin)
            mc_patch_jcc8(c, jle_wpark_end, buf_len(c))
            mc_patch_rel32(c, jmp_wpark_now, buf_len(c))

            // Phase 2: Dekker store-load fence via LOCK BTS sleeping_mask[wid] before WaitForSingleObject
            mc_b4(c, 0xF0, 0x4D, 0x0F, 0xAB); mc_b2(c, 0xAC, 0x24); mc_u32(c, 256) // LOCK BTS [R12+256], R13
            mc_b3(c, 0x49, 0x8B, 0x07)                                              // re-check [R15] AFTER setting sleep bit
            mc_b3(c, 0x4C, 0x39, 0xF0)
            jne_wcancel := mc_jcc8(c, 0x75)

            mc_b4(c, 0x4B, 0x8B, 0x8C, 0xEC); mc_u32(c, 128) // MOV RCX, event[wid]
            mc_b1(c, 0xBA); mc_u32(c, 0xFFFFFFFF)             // INFINITE
            cg_call_iat(cg, iat_wait_single())

            mc_patch_jcc8(c, jne_wcancel, buf_len(c))
            mc_b4(c, 0xF0, 0x4D, 0x0F, 0xB3); mc_b2(c, 0xAC, 0x24); mc_u32(c, 256) // LOCK BTR [R12+256], R13
            mc_b3(c, 0x49, 0x8B, 0x07)                                              // RAX = w_epoch[wid]
            mc_b3(c, 0x4C, 0x39, 0xF0)
            je_wtop := mc_jcc32(c, 0x84); mc_patch_rel32(c, je_wtop, w_top)

            mc_patch_rel32(c, jne_wjob1, buf_len(c))
            mc_b3(c, 0x49, 0x89, 0xC6)                        // my_epoch = w_epoch[wid]
            mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 16)
            mc_b3(c, 0x48, 0x85, 0xC0)
            jnz_pw := mc_jcc32(c, 0x85)
            mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 8)     // fn_ptr
            mc_b3(c, 0x4C, 0x89, 0xE9)                        // wid
            mc_b4(c, 0x49, 0x8B, 0x94, 0x24); mc_u32(c, 1600) // RDX = active_t
            mc_b3(c, 0x4D, 0x89, 0xE0)                        // R8 = pool
            mc_b2(c, 0xFF, 0xD0)                              // CALL RAX
            mc_b4(c, 0xF0, 0x49, 0xFF, 0x84); mc_b1(c, 0x24); mc_u32(c, 1664) // LOCK INC done_cnt
            jmp_wt := mc_jmp32(c); mc_patch_rel32(c, jmp_wt, w_top)
            mc_patch_rel32(c, jnz_pw, buf_len(c))
            mc_b2(c, 0x31, 0xC0)
            mc_ai_leave(c, 0x28)
        } else {
            mc_b2(c, 0x31, 0xC0); mc_b1(c, 0xC3)
        }
        cg_reg_helper(cg, h_ai_pool_worker(), s_pw, buf_len(c))
    }

    // 3. `h_ai_pool_dispatch(RCX = worker_fn, RDX = args_ptr)` + `h_ai_pool_dispatch_n(RCX = fn, RDX = args, R8 = max_t)`
    if cg_is_helper_used(cg, h_ai_pool_dispatch()) or cg_is_helper_used(cg, h_ai_pool_dispatch_n()) {
        mc_align16(c)
        s_pd := buf_len(c)
        mc_b2(c, 0x41, 0xB8); mc_u32(c, 16) // R8 = 16 (default all threads)
        jmp_pd_to_n := mc_jcc8(c, 0xEB)
        mc_align16(c)
        s_pdn := buf_len(c)
        mc_patch_jcc8(c, jmp_pd_to_n, s_pdn)
        mc_ai_enter(c, 0x48)
        mc_b3(c, 0x49, 0x89, 0xCE) // R14 = worker_fn
        mc_b3(c, 0x49, 0x89, 0xD7) // R15 = args_ptr
        mc_b3(c, 0x4C, 0x89, 0xC5) // RBP = max_t
        cg_mov_rax_data(cg, data_off_ai_pool())
        mc_b3(c, 0x49, 0x89, 0xC4) // R12 = pool
        mc_b3(c, 0x4D, 0x85, 0xE4)
        jnz_init := mc_jcc32(c, 0x85)

        // Lazy init 2048B persistent pool (zeroed by h_alloc_mem -> sleeping_mask & 64B-padded w_epoch[0..15] all 0!)
        mc_b1(c, 0xB9); mc_u32(c, 2048)
        cg_call_fn(cg, h_alloc_mem())
        mc_b3(c, 0x48, 0x85, 0xC0)
        cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b3(c, 0x49, 0x89, 0xC4) // R12 = pool
        mc_b3(c, 0x4C, 0x89, 0xE0) // RAX = R12
        cg_store_rax_data(cg, data_off_ai_pool())
        if osm <= 1 {
            cg_mov_rax_data(cg, data_off_cpu_threads())
            mc_b4(c, 0x48, 0x83, 0xF8, 0x08) // CMP RAX, 8: leave 2 logical CPUs free for OS on >=8T machines (eliminates 5ms preemption stalls!)
            jl_t_noht := mc_jcc8(c, 0x7C)
            mc_b4(c, 0x48, 0x83, 0xE8, 2) // SUB RAX, 2
            mc_patch_jcc8(c, jl_t_noht, buf_len(c))
            mc_b4(c, 0x48, 0x83, 0xF8, 0x01)
            jge_t1 := mc_jcc8(c, 0x7D)
            mc_b1(c, 0xB8); mc_u32(c, 1)
            mc_patch_jcc8(c, jge_t1, buf_len(c))
            mc_b4(c, 0x48, 0x83, 0xF8, 0x10)
            jle_t16 := mc_jcc8(c, 0x7E)
            mc_b1(c, 0xB8); mc_u32(c, 16)
            mc_patch_jcc8(c, jle_t16, buf_len(c))
        } else {
            mc_b1(c, 0xB8); mc_u32(c, 1)
        }
        mc_b3(c, 0x48, 0x89, 0xC3) // RBX = T
        mc_b3(c, 0x49, 0x89, 0x1C); mc_b1(c, 0x24) // [R12] = T
        mc_b4(c, 0x49, 0xC7, 0x44, 0x24); mc_b1(c, 16); mc_u32(c, 0)
        if osm <= 1 {
            mc_b4(c, 0x48, 0x83, 0xFB, 0x01)
            jle_nothr := mc_jcc32(c, 0x8E)
            cg_lea_rax_data(cg, data_off_mt_active())
            mc_b2(c, 0xC7, 0x00); mc_u32(c, 1) // enable allocator spinlock before spawning worker threads
            mc_b2(c, 0x41, 0xBD); mc_u32(c, 1) // R13 = 1
            lp_mk := buf_len(c)
            mc_b2(c, 0x31, 0xC9); mc_b2(c, 0x31, 0xD2)
            mc_b3(c, 0x45, 0x31, 0xC0); mc_b3(c, 0x45, 0x31, 0xC9)
            cg_call_iat(cg, iat_create_event_a())
            mc_b3(c, 0x48, 0x85, 0xC0)
            jz_mk_fail1 := mc_jcc32(c, 0x84)
            mc_b4(c, 0x4B, 0x89, 0x84, 0xEC); mc_u32(c, 128) // [R12 + R13*8 + 128] = event
            mc_b2(c, 0x31, 0xC9); mc_b2(c, 0x31, 0xD2)
            cg_lea_rax_fn(cg, h_ai_pool_worker())
            mc_b3(c, 0x49, 0x89, 0xC0) // R8 = worker
            mc_b3(c, 0x4D, 0x89, 0xE9) // R9 = wid
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 0x20); mc_u32(c, 0)
            mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 0x28); mc_u32(c, 0)
            cg_call_iat(cg, iat_create_thread())
            mc_b3(c, 0x48, 0x85, 0xC0)
            jz_mk_fail2 := mc_jcc32(c, 0x84)
            mc_b3(c, 0x49, 0xFF, 0xC5) // INC R13
            mc_b3(c, 0x49, 0x39, 0xDD) // CMP R13, RBX
            jl_mk := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_mk, lp_mk)
            jmp_mk_ok := mc_jcc8(c, 0xEB)
            mc_patch_rel32(c, jz_mk_fail1, buf_len(c))
            mc_patch_rel32(c, jz_mk_fail2, buf_len(c))
            mc_b3(c, 0x4C, 0x89, 0xEB) // MOV RBX, R13 (clamp T to actually spawned workers)
            mc_b3(c, 0x49, 0x89, 0x1C); mc_b1(c, 0x24) // [R12] = RBX
            mc_patch_jcc8(c, jmp_mk_ok, buf_len(c))
            mc_patch_rel32(c, jle_nothr, buf_len(c))
        }
        mc_b3(c, 0x4C, 0x89, 0xE0)
        cg_store_rax_data(cg, data_off_ai_pool())

        mc_patch_rel32(c, jnz_init, buf_len(c))
        // Write job args into [R12 + 32..72], zero isolated done_cnt at [R12 + 1664]
        mc_b4(c, 0x4D, 0x89, 0x74, 0x24); mc_b1(c, 8) // [R12 + 8] = fn_ptr
        mc_b4(c, 0x49, 0xC7, 0x84, 0x24); mc_u32(c, 1664); mc_u32(c, 0) // done_cnt = 0
        mc_b4(c, 0x49, 0xC7, 0x84, 0x24); mc_u32(c, 1728); mc_u32(c, 0) // dyn_ctr = 0 (pool[216], 64B isolated!)
        mut ai := 0
        while ai < 6 {
            mc_b3(c, 0x49, 0x8B, 0x47); mc_b1(c, ai * 8)
            mc_b4(c, 0x49, 0x89, 0x44, 0x24); mc_b1(c, 32 + ai * 8)
            ai += 1
        }
        mc_b3(c, 0x49, 0x8B, 0x1C); mc_b1(c, 0x24) // RBX = T
        // active_t = clamp(max_t, 1, T) -> RBX & [R12 + 640]
        mc_b4(c, 0x48, 0x83, 0xFD, 1); jge_mt_ok := mc_jcc8(c, 0x7D)
        mc_b1(c, 0xBD); mc_u32(c, 1)
        mc_patch_jcc8(c, jge_mt_ok, buf_len(c))
        mc_b3(c, 0x48, 0x39, 0xEB); jle_mt_cl := mc_jcc8(c, 0x7E)
        mc_b3(c, 0x48, 0x89, 0xEB) // RBX = min(T, max_t)
        mc_patch_jcc8(c, jle_mt_cl, buf_len(c))
        mc_b4(c, 0x49, 0x89, 0x9C, 0x24); mc_u32(c, 1600) // [R12 + 1600] = active_t
        mut jle_nowk := 0
        mut jle_nowk2 := 0
        if osm <= 1 {
            mc_b4(c, 0x48, 0x83, 0xFB, 0x01)
            jle_nowk = mc_jcc32(c, 0x8E)
            // Plain 1-cycle INC on 64B-isolated w_epoch[1..active_t-1] + 1 MFENCE + sleeping_mask! (0 false sharing, 0 idle wakeups!)
            mc_b4(c, 0x49, 0x8D, 0x84, 0x24); mc_u32(c, 576) // RAX = &w_epoch[1] = R12 + 512 + 64
            mc_b4(c, 0x48, 0x8D, 0x4B, 0xFF)                 // RCX = active_t - 1
            lp_inc_ep := buf_len(c)
            mc_b3(c, 0x48, 0xFF, 0x00)                       // INC QWORD [RAX] (plain 1-cycle store!)
            mc_b4(c, 0x48, 0x83, 0xC0, 64)
            mc_b3(c, 0x48, 0xFF, 0xC9)
            jnz_inc_ep := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_inc_ep, lp_inc_ep)
            mc_b3(c, 0x0F, 0xAE, 0xF0)                       // MFENCE (single Dekker fence before reading sleeping_mask!)
            mc_b4(c, 0x4D, 0x8B, 0xAC, 0x24); mc_u32(c, 256) // R13 = sleeping_mask
            mc_b3(c, 0x4D, 0x85, 0xED); jz_no_wake := mc_jcc8(c, 0x74)
            lp_wk := buf_len(c)
            mc_b4(c, 0x49, 0x0F, 0xBC, 0xC5)                 // BSF RAX, R13
            mc_b4(c, 0x49, 0x0F, 0xB3, 0xC5)                 // BTR R13, RAX
            mc_b3(c, 0x48, 0x39, 0xD8); jae_wk_nx := mc_jcc8(c, 0x73)
            mc_b4(c, 0x49, 0x8B, 0x8C, 0xC4); mc_u32(c, 128) // RCX = event[RAX]
            cg_call_iat(cg, iat_set_event())
            mc_patch_jcc8(c, jae_wk_nx, buf_len(c))
            mc_b3(c, 0x4D, 0x85, 0xED); jnz_wk := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_wk, lp_wk)
            mc_patch_jcc8(c, jz_no_wake, buf_len(c))
            mc_patch_rel32(c, jle_nowk, buf_len(c))
        }
        // Master executes shard wid=0
        mc_b2(c, 0x31, 0xC9)       // wid = 0
        mc_b3(c, 0x48, 0x89, 0xDA) // RDX = active_t
        mc_b3(c, 0x4D, 0x89, 0xE0) // R8 = pool
        mc_b3(c, 0x41, 0xFF, 0xD6) // CALL R14
        if osm <= 1 {
            mc_b4(c, 0x48, 0x83, 0xFB, 0x01)
            jle_nowk2 = mc_jcc32(c, 0x8E)
            mc_b4(c, 0xF0, 0x49, 0xFF, 0x84); mc_b1(c, 0x24); mc_u32(c, 1664) // LOCK INC [R12 + 1664]
            mc_b1(c, 0xBE); mc_u32(c, 1536)                   // ESI = anti-LHP spin budget (~35us)
            lp_wait := buf_len(c)
            mc_b4(c, 0x49, 0x8B, 0x84, 0x24); mc_u32(c, 1664) // MOV RAX, [R12 + 1664]
            mc_b3(c, 0x48, 0x39, 0xD8)
            jge_done := mc_jcc8(c, 0x7D)
            mc_b2(c, 0xF3, 0x90) // PAUSE
            mc_b2(c, 0xFF, 0xCE) // DEC ESI
            jnz_mw := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_mw, lp_wait)
            mc_b2(c, 0x31, 0xC9) // Sleep(0): instant anti-LHP yield to preempted worker!
            cg_call_iat(cg, iat_sleep())
            mc_b1(c, 0xBE); mc_u32(c, 512)
            jmp_w := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_w, lp_wait)
            mc_patch_jcc8(c, jge_done, buf_len(c))
            mc_patch_rel32(c, jle_nowk2, buf_len(c))
        }
        mc_ai_leave(c, 0x48)
        e_pd := buf_len(c)
        cg_reg_helper(cg, h_ai_pool_dispatch(), s_pd, e_pd)
        cg_reg_helper(cg, h_ai_pool_dispatch_n(), s_pdn, e_pd)
    }
}

fn emit_ai_gemv_gemm_helpers(cg: CodegenCtx) {
    c := cg.code

    // 4. `h_ai_gemv_f32`: args = `[w_ptr, x_ptr, out_ptr, rows, cols]`
    if cg_is_helper_used(cg, h_ai_gemv_f32()) {
        mc_align16(c)
        s_wk := buf_len(c)
        mc_ai_enter(c, 0x28)
        mc_b3(c, 0x4D, 0x89, 0xC4) // R12 = pool
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 56) // total_rows
        mc_ai_row_range(c)         // R14 = r0, R15 = r1
        mc_b3(c, 0x4D, 0x39, 0xFE) // CMP R14, R15
        jge_gv_e := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4D, 0x8B, 0x44, 0x24); mc_b1(c, 64) // R8 = cols
        mc_b4(c, 0x49, 0x8B, 0x5C, 0x24); mc_b1(c, 40) // RBX = x_ptr
        mc_b4(c, 0x49, 0x8B, 0x6C, 0x24); mc_b1(c, 48) // RBP = out_ptr
        mc_b4(c, 0x49, 0x8B, 0x74, 0x24); mc_b1(c, 32) // RSI = w_ptr
        // R9 = row_bytes = cols * 4
        mc_b3(c, 0x4D, 0x89, 0xC1)                     // MOV R9, R8
        mc_b4(c, 0x49, 0xC1, 0xE1, 0x02)               // SHL R9, 2
        mc_b3(c, 0x4D, 0x89, 0xF5) // R13 = r0
        mc_b3(c, 0x4C, 0x89, 0xF0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC1) // RAX = r0 * row_bytes
        mc_b3(c, 0x48, 0x01, 0xC6) // RSI = w_row

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_gv_sc := mc_jcc32(c, 0x84)

        // AVX2+FMA3 2-row pair loop (`r13 + 1 < r15`)
        lp_gv2 := buf_len(c)
        mc_b4(c, 0x49, 0x8D, 0x45, 0x01) // LEA RAX, [R13 + 1]
        mc_b3(c, 0x4C, 0x39, 0xF8)       // CMP RAX, R15
        jge_gv1 := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x48, 0x89, 0xF1)       // RCX = row0 ptr
        mc_b4(c, 0x4A, 0x8D, 0x3C, 0x0E) // RDI = row0 + row_bytes (row1 ptr)
        mc_b3(c, 0x48, 0x89, 0xDA)       // RDX = x_ptr
        mc_b4(c, 0x4A, 0x8D, 0x04, 0x0A) // RAX = RDX + R9 (x_end)
        mc_vex2(c, 0, 1, 0, 0x57, 0xC0)  // VXORPS YMM0, YMM0, YMM0
        mc_vex2(c, 1, 1, 0, 0x57, 0xC9)  // VXORPS YMM1, YMM1, YMM1
        mc_vex2(c, 2, 1, 0, 0x57, 0xD2)  // VXORPS YMM2, YMM2, YMM2
        mc_vex2(c, 3, 1, 0, 0x57, 0xDB)  // VXORPS YMM3, YMM3, YMM3
        mc_b4(c, 0x48, 0x83, 0xE8, 0x40) // x_end16 = x_end - 64
        mc_b3(c, 0x48, 0x39, 0xC2)
        ja_g2_8 := mc_jcc32(c, 0x87)
        lp_g2_16 := buf_len(c)
        mc_vex2(c, 0, 1, 0, 0x10, 0x22)                          // VMOVUPS YMM4, [RDX]
        mc_vex2(c, 0, 1, 0, 0x10, 0x6A); mc_b1(c, 0x20)          // VMOVUPS YMM5, [RDX+32]
        mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0x01) // VFMADD231PS YMM0, YMM4, [RCX]
        mc_vex3(c, 0, 0, 0, 2, 0, 5, 1, 1, 0xB8); mc_b2(c, 0x49, 0x20) // VFMADD231PS YMM1, YMM5, [RCX+32]
        mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0x17) // VFMADD231PS YMM2, YMM4, [RDI]
        mc_vex3(c, 0, 0, 0, 2, 0, 5, 1, 1, 0xB8); mc_b2(c, 0x5F, 0x20) // VFMADD231PS YMM3, YMM5, [RDI+32]
        mc_b4(c, 0x48, 0x83, 0xC1, 0x40)
        mc_b4(c, 0x48, 0x83, 0xC7, 0x40)
        mc_b4(c, 0x48, 0x83, 0xC2, 0x40)
        mc_b3(c, 0x48, 0x39, 0xC2)
        jbe_g2_16 := mc_jcc8(c, 0x76); mc_patch_jcc8(c, jbe_g2_16, lp_g2_16)
        mc_patch_rel32(c, ja_g2_8, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xC0, 0x40) // RAX = x_end
        mc_vex2(c, 0, 1, 0, 0x58, 0xC1)  // VADDPS YMM0, YMM0, YMM1
        mc_vex2(c, 2, 1, 0, 0x58, 0xD3)  // VADDPS YMM2, YMM2, YMM3
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC1, 0x01)
        mc_vex2(c, 0, 0, 0, 0x58, 0xC1)
        mc_vex2(c, 0, 0, 0, 0x12, 0xC8)
        mc_vex2(c, 0, 0, 0, 0x58, 0xC1)
        mc_vex2(c, 0, 0, 0, 0xC6, 0xC8); mc_b1(c, 0x01)
        mc_vex2(c, 0, 0, 2, 0x58, 0xC1) // XMM0 = sum0 (f32)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xD1, 0x01) // VEXTRACTF128 XMM1, YMM2, 1
        mc_vex2(c, 2, 0, 0, 0x58, 0xD1) // VADDPS XMM2, XMM2, XMM1
        mc_vex2(c, 2, 0, 0, 0x12, 0xCA) // VMOVHLPS XMM1, XMM2, XMM2
        mc_vex2(c, 2, 0, 0, 0x58, 0xD1)
        mc_vex2(c, 2, 0, 0, 0xC6, 0xCA); mc_b1(c, 0x01)
        mc_vex2(c, 2, 0, 2, 0x58, 0xD1) // XMM2 = sum1 (f32)
        lp_g2_sc := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC2)
        jae_g2_st := mc_jcc8(c, 0x73)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x0A) // MOVSS XMM1, [RDX]
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x19) // MOVSS XMM3, [RCX]
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xD9) // MULSS XMM3, XMM1
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xC3) // ADDSS XMM0, XMM3
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x1F) // MOVSS XMM3, [RDI]
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xD9) // MULSS XMM3, XMM1
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xD3) // ADDSS XMM2, XMM3
        mc_b4(c, 0x48, 0x83, 0xC1, 0x04)
        mc_b4(c, 0x48, 0x83, 0xC7, 0x04)
        mc_b4(c, 0x48, 0x83, 0xC2, 0x04)
        jmp_g2sc := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_g2sc, lp_g2_sc)
        mc_patch_jcc8(c, jae_g2_st, buf_len(c))
        mc_b4(c, 0xF3, 0x42, 0x0F, 0x11); mc_b3(c, 0x44, 0xAD, 0x00) // MOVSS [RBP + R13*4], XMM0
        mc_b4(c, 0xF3, 0x42, 0x0F, 0x11); mc_b3(c, 0x54, 0xAD, 0x04) // MOVSS [RBP + R13*4 + 4], XMM2
        mc_b4(c, 0x49, 0x83, 0xC5, 0x02) // R13 += 2
        mc_b4(c, 0x4A, 0x8D, 0x34, 0x4E) // LEA RSI, [RSI + R9*2]
        jmp_gv2 := mc_jmp32(c); mc_patch_rel32(c, jmp_gv2, lp_gv2)

        // Tail 0 or 1 row AVX2 (or scalar SSE2 fallback)
        mc_patch_rel32(c, jge_gv1, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77) // VZEROUPPER (guarded: AVX2 2-row path only)
        mc_patch_rel32(c, jz_gv_sc, buf_len(c))
        lp_gv1 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xFD) // CMP R13, R15
        jge_gv1d := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x48, 0x89, 0xF1) // RCX = w_row
        mc_b3(c, 0x48, 0x89, 0xDA) // RDX = x_ptr
        mc_b4(c, 0x4A, 0x8D, 0x04, 0x0A) // RAX = x_end
        mc_b3(c, 0x0F, 0x57, 0xC0)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_g1_sc := mc_jcc8(c, 0x74)
        mc_vex2(c, 0, 1, 0, 0x57, 0xC0)
        mc_b4(c, 0x4A, 0x8D, 0x04, 0x0B) // LEA RAX, [RBX + R9] (RBX=x_ptr!)
        mc_b4(c, 0x48, 0x83, 0xE8, 0x20)
        lp_g1_8 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC2)
        ja_g1_red := mc_jcc8(c, 0x77)
        mc_vex2(c, 0, 1, 0, 0x10, 0x22)
        mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0x01)
        mc_b4(c, 0x48, 0x83, 0xC1, 0x20)
        mc_b4(c, 0x48, 0x83, 0xC2, 0x20)
        jmp_g1_8 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_g1_8, lp_g1_8)
        mc_patch_jcc8(c, ja_g1_red, buf_len(c))
        mc_avx_hsum_ymm0(c)
        mc_b3(c, 0xC5, 0xF8, 0x77) // VZEROUPPER (guarded: AVX2 1-row path only)
        mc_b4(c, 0x48, 0x83, 0xC0, 0x20)
        jmp_g1_sc := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jz_g1_sc, buf_len(c))
        mc_b4(c, 0x4A, 0x8D, 0x04, 0x0B) // LEA RAX, [RBX + R9]
        mc_patch_jcc8(c, jmp_g1_sc, buf_len(c))
        lp_g1_sc := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC2)
        jae_g1_st := mc_jcc8(c, 0x73)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x0A)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0x09)
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1)
        mc_b4(c, 0x48, 0x83, 0xC1, 0x04)
        mc_b4(c, 0x48, 0x83, 0xC2, 0x04)
        jmp_g1s := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_g1s, lp_g1_sc)
        mc_patch_jcc8(c, jae_g1_st, buf_len(c))
        mc_b4(c, 0xF3, 0x42, 0x0F, 0x11); mc_b3(c, 0x44, 0xAD, 0x00)
        mc_b3(c, 0x49, 0xFF, 0xC5)
        mc_b3(c, 0x4C, 0x01, 0xCE)
        jmp_gv1 := mc_jmp32(c); mc_patch_rel32(c, jmp_gv1, lp_gv1)
        mc_patch_rel32(c, jge_gv1d, buf_len(c))
        mc_patch_rel32(c, jge_gv_e, buf_len(c))
        mc_ai_leave(c, 0x28)
        mc_ai_emit_batch_pub(cg, h_ai_gemv_f32(), s_wk, 3, 4, 16384)
    }

    // 4b. `h_ai_gemv2_f32`: fused 2-row simultaneous dual-matrix GEMV (`out1=W1*x, out2=W2*x`) sharing `x` + 1 pool dispatch!
    // args = `[w1_ptr, w2_ptr, x_ptr, out1_ptr, out2_ptr, dims=(rows<<32)|cols]`
    if cg_is_helper_used(cg, h_ai_gemv2_f32()) {
        mc_align16(c)
        s_wk := buf_len(c)
        mc_ai_enter(c, 0x68)
        mc_b4(c, 0x0F, 0x11, 0x34, 0x24)
        mc_b4(c, 0x0F, 0x11, 0x7C, 0x24); mc_b1(c, 16)
        mc_b4(c, 0x44, 0x0F, 0x11, 0x44); mc_b2(c, 0x24, 32)
        mc_b4(c, 0x44, 0x0F, 0x11, 0x4C); mc_b2(c, 0x24, 48)
        mc_b3(c, 0x4D, 0x89, 0xC4) // R12 = pool
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 72) // dims
        mc_b4(c, 0x48, 0xC1, 0xE8, 32)                 // RAX = rows
        mc_ai_row_range(c)                             // R14 = r0, R15 = r1
        mc_b3(c, 0x4D, 0x39, 0xFE)
        jge_g2e := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x45, 0x8B, 0x44, 0x24); mc_b1(c, 72) // MOV R8D, DWORD [R12+72] (cols)
        mc_b3(c, 0x4D, 0x89, 0xC1)
        mc_b4(c, 0x49, 0xC1, 0xE1, 0x02)               // R9 = cols * 4 (row_bytes)
        mc_b4(c, 0x49, 0x8B, 0x74, 0x24); mc_b1(c, 32) // RSI = w1
        mc_b4(c, 0x49, 0x8B, 0x7C, 0x24); mc_b1(c, 40) // RDI = w2
        mc_b4(c, 0x49, 0x8B, 0x5C, 0x24); mc_b1(c, 48) // RBX = x
        mc_b4(c, 0x49, 0x8B, 0x6C, 0x24); mc_b1(c, 56) // RBP = out1
        mc_b4(c, 0x4D, 0x8B, 0x54, 0x24); mc_b1(c, 64) // R10 = out2
        mc_b3(c, 0x4C, 0x89, 0xF0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC1) // RAX = r0 * row_bytes
        mc_b3(c, 0x48, 0x01, 0xC6)                     // RSI = w1 + r0 * row_bytes
        mc_b3(c, 0x48, 0x01, 0xC7)                     // RDI = w2 + r0 * row_bytes
        mc_b3(c, 0x4D, 0x89, 0xF5)                     // R13 = r0

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_g2_sc := mc_jcc32(c, 0x84)

        // 2-row simultaneous fastpath when (cols & 15) == 0 and cols >= 16 (halves x loads + 8 independent FMAs!)
        mc_b4(c, 0x41, 0xF6, 0xC0, 15); jnz_g2_1r := mc_jcc32(c, 0x85)
        mc_b4(c, 0x49, 0x83, 0xF8, 16); jl_g2_1r2 := mc_jcc32(c, 0x8C)
        mc_align16_nop(c)
        lp_g2r2 := buf_len(c)
        mc_b4(c, 0x49, 0x8D, 0x45, 2) // RAX = r + 2
        mc_b3(c, 0x4C, 0x39, 0xF8); jg_g2r2_dn := mc_jcc32(c, 0x8F)
        mc_b3(c, 0x48, 0x89, 0xF1)                     // RCX = w1_row
        mc_b3(c, 0x49, 0x89, 0xFB)                     // R11 = w2_row
        mc_b3(c, 0x48, 0x89, 0xDA)                     // RDX = x
        mc_b4(c, 0x4A, 0x8D, 0x04, 0x0A)               // RAX = x + row_bytes
        mc_b4(c, 0x48, 0x83, 0xE8, 0x40)               // RAX = x_end - 64
        mc_vex2(c, 0, 1, 0, 0x57, 0xC0); mc_vex2(c, 1, 1, 0, 0x57, 0xC9)
        mc_vex2(c, 2, 1, 0, 0x57, 0xD2); mc_vex2(c, 3, 1, 0, 0x57, 0xDB)
        mc_vex2(c, 6, 1, 0, 0x57, 0xF6); mc_vex2(c, 7, 1, 0, 0x57, 0xFF)
        mc_vex3(c, 1, 0, 1, 1, 0, 8, 1, 0, 0x57); mc_b1(c, 0xC0) // VXORPS Y8, Y8, Y8
        mc_vex3(c, 1, 0, 1, 1, 0, 9, 1, 0, 0x57); mc_b1(c, 0xC9) // VXORPS Y9, Y9, Y9
        mc_align16_nop(c)
        lp_g2d2_16 := buf_len(c)
        mc_vex2(c, 0, 1, 0, 0x10, 0x22)                                        // VMOVUPS Y4, [RDX]
        mc_vex2(c, 0, 1, 0, 0x10, 0x6A); mc_b1(c, 0x20)                        // VMOVUPS Y5, [RDX+32]
        mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0x01)               // Y0 += Y4 * [RCX]
        mc_vex3(c, 0, 0, 0, 2, 0, 5, 1, 1, 0xB8); mc_b2(c, 0x49, 0x20)         // Y1 += Y5 * [RCX+32]
        mc_vex3(c, 0, 0, 1, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0x13)               // Y2 += Y4 * [R11]
        mc_vex3(c, 0, 0, 1, 2, 0, 5, 1, 1, 0xB8); mc_b2(c, 0x5B, 0x20)         // Y3 += Y5 * [R11+32]
        mc_vex3(c, 0, 1, 0, 2, 0, 4, 1, 1, 0xB8); mc_b2(c, 0x34, 0x09)         // Y6 += Y4 * [RCX+R9]
        mc_vex3(c, 0, 1, 0, 2, 0, 5, 1, 1, 0xB8); mc_b3(c, 0x7C, 0x09, 0x20)   // Y7 += Y5 * [RCX+R9+32]
        mc_vex3(c, 1, 1, 1, 2, 0, 4, 1, 1, 0xB8); mc_b2(c, 0x04, 0x0B)         // Y8 += Y4 * [R11+R9]
        mc_vex3(c, 1, 1, 1, 2, 0, 5, 1, 1, 0xB8); mc_b3(c, 0x4C, 0x0B, 0x20)   // Y9 += Y5 * [R11+R9+32]
        mc_b4(c, 0x48, 0x83, 0xC1, 0x40)
        mc_b4(c, 0x49, 0x83, 0xC3, 0x40)
        mc_b4(c, 0x48, 0x83, 0xC2, 0x40)
        mc_b3(c, 0x48, 0x39, 0xC2)
        jbe_g2d2_16 := mc_jcc8(c, 0x76); mc_patch_jcc8(c, jbe_g2d2_16, lp_g2d2_16)
        // Horizontal reduce 4 outputs (Y0+Y1->X0, Y2+Y3->X2, Y6+Y7->X6, Y8+Y9->X8)
        mc_vex2(c, 0, 1, 0, 0x58, 0xC1); mc_vex2(c, 2, 1, 0, 0x58, 0xD3)
        mc_vex2(c, 6, 1, 0, 0x58, 0xF7)
        mc_vex3(c, 1, 0, 1, 1, 0, 8, 1, 0, 0x58); mc_b1(c, 0xC1) // VADDPS Y8, Y8, Y9
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC1, 0x01)
        mc_vex2(c, 0, 0, 0, 0x58, 0xC1); mc_vex2(c, 0, 0, 0, 0x12, 0xC8); mc_vex2(c, 0, 0, 0, 0x58, 0xC1)
        mc_vex2(c, 0, 0, 0, 0xC6, 0xC8); mc_b1(c, 0x01); mc_vex2(c, 0, 0, 2, 0x58, 0xC1)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xD1, 0x01)
        mc_vex2(c, 2, 0, 0, 0x58, 0xD1); mc_vex2(c, 2, 0, 0, 0x12, 0xCA); mc_vex2(c, 2, 0, 0, 0x58, 0xD1)
        mc_vex2(c, 2, 0, 0, 0xC6, 0xCA); mc_b1(c, 0x01); mc_vex2(c, 2, 0, 2, 0x58, 0xD1)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xF1, 0x01) // VEXTRACTF128 X1, Y6, 1
        mc_vex2(c, 6, 0, 0, 0x58, 0xF1); mc_vex2(c, 6, 0, 0, 0x12, 0xCE); mc_vex2(c, 6, 0, 0, 0x58, 0xF1)
        mc_vex2(c, 6, 0, 0, 0xC6, 0xCE); mc_b1(c, 0x01); mc_vex2(c, 6, 0, 2, 0x58, 0xF1)
        mc_vex3(c, 1, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC1, 0x01) // VEXTRACTF128 X1, Y8, 1
        mc_vex3(c, 1, 0, 0, 1, 0, 8, 0, 0, 0x58); mc_b1(c, 0xC1)       // VADDPS X8, X8, X1
        mc_vex3(c, 0, 0, 1, 1, 0, 8, 0, 0, 0x12); mc_b1(c, 0xC8)       // VMOVHLPS X1, X8, X8
        mc_vex3(c, 1, 0, 0, 1, 0, 8, 0, 0, 0x58); mc_b1(c, 0xC1)
        mc_vex3(c, 0, 0, 1, 1, 0, 8, 0, 0, 0xC6); mc_b2(c, 0xC8, 0x01) // VSHUFPS X1, X8, X8, 1
        mc_vex3(c, 1, 0, 0, 1, 0, 8, 0, 2, 0x58); mc_b1(c, 0xC1)       // VADDSS X8, X8, X1
        mc_b4(c, 0xF3, 0x42, 0x0F, 0x11); mc_b3(c, 0x44, 0xAD, 0x00)   // MOVSS [RBP+R13*4], X0
        mc_b4(c, 0xF3, 0x42, 0x0F, 0x11); mc_b3(c, 0x74, 0xAD, 0x04)   // MOVSS [RBP+R13*4+4], X6
        mc_b4(c, 0xF3, 0x43, 0x0F, 0x11); mc_b2(c, 0x14, 0xAA)         // MOVSS [R10+R13*4], X2
        mc_b4(c, 0xF3, 0x47, 0x0F, 0x11); mc_b3(c, 0x44, 0xAA, 0x04)   // MOVSS [R10+R13*4+4], X8
        mc_b4(c, 0x49, 0x83, 0xC5, 2)
        mc_b4(c, 0x4A, 0x8D, 0x34, 0x4E) // LEA RSI, [RSI + R9*2]
        mc_b4(c, 0x4A, 0x8D, 0x3C, 0x4F) // LEA RDI, [RDI + R9*2]
        jmp_g2r2 := mc_jmp32(c); mc_patch_rel32(c, jmp_g2r2, lp_g2r2)
        mc_patch_rel32(c, jg_g2r2_dn, buf_len(c))
        mc_patch_rel32(c, jnz_g2_1r, buf_len(c))
        mc_patch_rel32(c, jl_g2_1r2, buf_len(c))

        lp_g2r := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xFD)                     // CMP R13, R15
        jge_g2_vzu := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x48, 0x89, 0xF1)                     // RCX = w1_row
        mc_b3(c, 0x49, 0x89, 0xFB)                     // R11 = w2_row (RDI) -> wait: MOV R11, RDI = 49 89 FB!
        mc_b3(c, 0x48, 0x89, 0xDA)                     // RDX = x
        mc_b4(c, 0x4A, 0x8D, 0x04, 0x0A)               // RAX = x + row_bytes
        mc_vex2(c, 0, 1, 0, 0x57, 0xC0)
        mc_vex2(c, 1, 1, 0, 0x57, 0xC9)
        mc_vex2(c, 2, 1, 0, 0x57, 0xD2)
        mc_vex2(c, 3, 1, 0, 0x57, 0xDB)
        mc_b4(c, 0x48, 0x83, 0xE8, 0x40)               // x_end - 64
        mc_b3(c, 0x48, 0x39, 0xC2)
        ja_g2d_red := mc_jcc32(c, 0x87)
        lp_g2d_16 := buf_len(c)
        mc_vex2(c, 0, 1, 0, 0x10, 0x22)                          // VMOVUPS YMM4, [RDX]
        mc_vex2(c, 0, 1, 0, 0x10, 0x6A); mc_b1(c, 0x20)          // VMOVUPS YMM5, [RDX+32]
        mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0x01) // VFMADD231PS YMM0, YMM4, [RCX]
        mc_vex3(c, 0, 0, 0, 2, 0, 5, 1, 1, 0xB8); mc_b2(c, 0x49, 0x20)
        mc_vex3(c, 0, 0, 1, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0x13) // VFMADD231PS YMM2, YMM4, [R11]
        mc_vex3(c, 0, 0, 1, 2, 0, 5, 1, 1, 0xB8); mc_b2(c, 0x5B, 0x20) // VFMADD231PS YMM3, YMM5, [R11+32]
        mc_b4(c, 0x48, 0x83, 0xC1, 0x40)
        mc_b4(c, 0x49, 0x83, 0xC3, 0x40)
        mc_b4(c, 0x48, 0x83, 0xC2, 0x40)
        mc_b3(c, 0x48, 0x39, 0xC2)
        jbe_g2d_16 := mc_jcc8(c, 0x76); mc_patch_jcc8(c, jbe_g2d_16, lp_g2d_16)
        mc_patch_rel32(c, ja_g2d_red, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xC0, 0x40)
        mc_vex2(c, 0, 1, 0, 0x58, 0xC1)
        mc_vex2(c, 2, 1, 0, 0x58, 0xD3)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC1, 0x01)
        mc_vex2(c, 0, 0, 0, 0x58, 0xC1)
        mc_vex2(c, 0, 0, 0, 0x12, 0xC8)
        mc_vex2(c, 0, 0, 0, 0x58, 0xC1)
        mc_vex2(c, 0, 0, 0, 0xC6, 0xC8); mc_b1(c, 0x01)
        mc_vex2(c, 0, 0, 2, 0x58, 0xC1) // XMM0 = out1[r]
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xD1, 0x01)
        mc_vex2(c, 2, 0, 0, 0x58, 0xD1)
        mc_vex2(c, 2, 0, 0, 0x12, 0xCA)
        mc_vex2(c, 2, 0, 0, 0x58, 0xD1)
        mc_vex2(c, 2, 0, 0, 0xC6, 0xCA); mc_b1(c, 0x01)
        mc_vex2(c, 2, 0, 2, 0x58, 0xD1) // XMM2 = out2[r]
        lp_g2d_sc := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC2)
        jae_g2d_st := mc_jcc8(c, 0x73)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x0A)       // MOVSS XMM1, [RDX]
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x19)       // MOVSS XMM3, [RCX]
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xD9)       // MULSS XMM3, XMM1
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xC3)       // ADDSS XMM0, XMM3
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b1(c, 0x1B) // MOVSS XMM3, [R11]
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xD9)
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xD3)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b4(c, 0x49, 0x83, 0xC3, 4); mc_b4(c, 0x48, 0x83, 0xC2, 4)
        jmp_g2dsc := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_g2dsc, lp_g2d_sc)
        mc_patch_jcc8(c, jae_g2d_st, buf_len(c))
        mc_b4(c, 0xF3, 0x42, 0x0F, 0x11); mc_b3(c, 0x44, 0xAD, 0x00) // MOVSS [RBP + R13*4], XMM0
        mc_b4(c, 0xF3, 0x43, 0x0F, 0x11); mc_b2(c, 0x14, 0xAA)       // MOVSS [R10 + R13*4], XMM2
        mc_b3(c, 0x49, 0xFF, 0xC5)
        mc_b3(c, 0x4C, 0x01, 0xCE)
        mc_b3(c, 0x4C, 0x01, 0xCF)
        jmp_g2r := mc_jmp32(c); mc_patch_rel32(c, jmp_g2r, lp_g2r)

        mc_patch_rel32(c, jge_g2_vzu, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77) // VZEROUPPER (once per worker!)
        jmp_g2done := mc_jmp32(c)

        // Scalar SSE2 fallback
        mc_patch_rel32(c, jz_g2_sc, buf_len(c))
        lp_g2s := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xFD)
        jge_g2sd := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x48, 0x89, 0xF1)
        mc_b3(c, 0x49, 0x89, 0xFB)
        mc_b3(c, 0x48, 0x89, 0xDA)
        mc_b4(c, 0x4A, 0x8D, 0x04, 0x0A)
        mc_b3(c, 0x0F, 0x57, 0xC0); mc_b3(c, 0x0F, 0x57, 0xD2)
        lp_g2si := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC2); jae_g2sst := mc_jcc8(c, 0x73)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x0A)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x19); mc_b4(c, 0xF3, 0x0F, 0x59, 0xD9); mc_b4(c, 0xF3, 0x0F, 0x58, 0xC3)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b1(c, 0x1B); mc_b4(c, 0xF3, 0x0F, 0x59, 0xD9); mc_b4(c, 0xF3, 0x0F, 0x58, 0xD3)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b4(c, 0x49, 0x83, 0xC3, 4); mc_b4(c, 0x48, 0x83, 0xC2, 4)
        jmp_g2si := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_g2si, lp_g2si)
        mc_patch_jcc8(c, jae_g2sst, buf_len(c))
        mc_b4(c, 0xF3, 0x42, 0x0F, 0x11); mc_b3(c, 0x44, 0xAD, 0x00)
        mc_b4(c, 0xF3, 0x43, 0x0F, 0x11); mc_b2(c, 0x14, 0xAA)
        mc_b3(c, 0x49, 0xFF, 0xC5); mc_b3(c, 0x4C, 0x01, 0xCE); mc_b3(c, 0x4C, 0x01, 0xCF)
        jmp_g2s := mc_jmp32(c); mc_patch_rel32(c, jmp_g2s, lp_g2s)
        mc_patch_rel32(c, jge_g2sd, buf_len(c))
        mc_patch_rel32(c, jmp_g2done, buf_len(c))
        mc_patch_rel32(c, jge_g2e, buf_len(c))
        mc_b4(c, 0x0F, 0x10, 0x34, 0x24)
        mc_b4(c, 0x0F, 0x10, 0x7C, 0x24); mc_b1(c, 16)
        mc_b4(c, 0x44, 0x0F, 0x10, 0x44); mc_b2(c, 0x24, 32)
        mc_b4(c, 0x44, 0x0F, 0x10, 0x4C); mc_b2(c, 0x24, 48)
        mc_ai_leave(c, 0x68)

        mc_align16(c)
        s_pub := buf_len(c)
        mc_ai_enter(c, 0x28)
        mc_b3(c, 0x48, 0x89, 0xCB) // RBX = args_ptr
        mc_b4(c, 0x48, 0x8B, 0x43, 40) // dims
        mc_b3(c, 0x48, 0x89, 0xC2); mc_b4(c, 0x48, 0xC1, 0xEA, 32) // RDX = rows
        mc_b3(c, 0x48, 0x85, 0xD2); jle_p2e := mc_jcc32(c, 0x8E)
        mc_b3(c, 0x48, 0x8D, 0x0D); mc_u32(c, s_wk - (buf_len(c) + 4))
        mc_b3(c, 0x48, 0x89, 0xDA) // MOV RDX, RBX (args_ptr)
        cg_call_fn(cg, h_ai_pool_dispatch())
        mc_patch_rel32(c, jle_p2e, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_ai_leave(c, 0x28)
        cg_reg_helper(cg, h_ai_gemv2_f32(), s_pub, buf_len(c))
    }

    // 5. `h_ai_gemm_f32`: args = `[A, B, C, m, k, n]` (KC=64 packed L1D micro-panel + 4x16 FMA3 + multi-core pool)
    if cg_is_helper_used(cg, h_ai_gemm_f32()) {
        mc_align16(c)
        s_wk := buf_len(c)
        // Stack locals (`0x10D8` = 4312B, guard-page probed by `mc_ai_enter`): `[RSP+0]=k`, `[RSP+8]=n`, `[RSP+16]=B`, `[RSP+24]=b_stride(n*4)`,
        // `[RSP+32]=r0`, `[RSP+40]=a_stride(k*4)`, `[RSP+48]=pc`, `[RSP+56]=k_blk`, `[RSP+64..191]=XMM6..13`, `[RSP+192..4287]=B_pack[64][16]`
        // Stack locals (`0x3138` = 12600B): [12512]=pool, [12520]=wid, [12528]=T, [12536]=m, [12544]=r_mid, [12552]=tot_tasks, [12560]=n_mh, [12568]=loc_task
        mc_ai_enter(c, 0x3138)
        mc_b3(c, 0x4D, 0x89, 0xC4) // R12 = pool
        mc_b4(c, 0x4C, 0x89, 0xA4, 0x24); mc_u32(c, 12512) // [12512] = pool
        mc_b4(c, 0x48, 0x89, 0x8C, 0x24); mc_u32(c, 12520) // [12520] = wid
        mc_b4(c, 0x48, 0x89, 0x94, 0x24); mc_u32(c, 12528) // [12528] = T
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 56)    // RAX = m
        mc_b3(c, 0x48, 0x85, 0xC0)
        jle_gm_e := mc_jcc32(c, 0x8E)
        mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 12536) // [12536] = m
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 64)    // k
        mc_b4(c, 0x48, 0x89, 0x04, 0x24)                  // [RSP] = k
        mc_b3(c, 0x48, 0xC1, 0xE0); mc_b1(c, 2)           // RAX = k*4
        mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 40)    // [RSP+40] = a_stride
        mc_b4(c, 0x49, 0x8B, 0x4C, 0x24); mc_b1(c, 72)    // n
        mc_b4(c, 0x48, 0x89, 0x4C, 0x24); mc_b1(c, 8)     // [RSP+8] = n
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 40)    // B
        mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 16)    // [RSP+16] = B
        mc_b3(c, 0x48, 0xC1, 0xE1); mc_b1(c, 2)           // RCX = n*4
        mc_b4(c, 0x48, 0x89, 0x4C, 0x24); mc_b1(c, 24)    // [RSP+24] = b_stride
        mc_b4(c, 0x4D, 0x8B, 0x4C, 0x24); mc_b1(c, 32)    // R9  = A
        mc_b4(c, 0x4D, 0x8B, 0x5C, 0x24); mc_b1(c, 48)    // R11 = C

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_gm_sc := mc_jcc32(c, 0x84)

        mut gxi := 0
        while gxi < 8 {
            xreg := 6 + gxi
            mut xr_bit := 1
            if (xreg & 8) != 0 { xr_bit = 0 }
            off_x := 64 + gxi * 16
            mc_b4(c, 0xC4, (xr_bit << 7) | 0x61, 0x7A, 0x7F)
            if off_x < 128 {
                mc_b3(c, 0x44 | ((xreg & 7) << 3), 0x24, off_x)
            } else {
                mc_b2(c, 0x84 | ((xreg & 7) << 3), 0x24); mc_u32(c, off_x)
            }
            gxi += 1
        }
        mc_b4(c, 0x44, 0x0F, 0x11, 0xB4); mc_b1(c, 0x24); mc_u32(c, 12480)
        mc_b4(c, 0x44, 0x0F, 0x11, 0xBC); mc_b1(c, 0x24); mc_u32(c, 12496)

        // Dynamic (j_panel, row_half) task queue: 5x less B packing + 0 HT imbalance!
        mc_b4(c, 0x48, 0x8B, 0x4C, 0x24); mc_b1(c, 8)     // RCX = n
        mc_b4(c, 0x48, 0xC1, 0xE9, 4)                     // RCX = n_j = n >> 4
        mc_b3(c, 0x48, 0x85, 0xC9); jle_gm_j0 := mc_jcc32(c, 0x8E)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 12536) // RAX = m
        mc_b1(c, 0xBA); mc_u32(c, 1)                       // RDX = n_mh = 1
        mc_b3(c, 0x48, 0x89, 0xC6)                         // RSI = r_mid = m
        mc_b4(c, 0x48, 0x83, 0xBC, 0x24); mc_u32(c, 12528); mc_b1(c, 1); jle_gm_1mh := mc_jcc8(c, 0x7E)
        mc_b2(c, 0x48, 0x3D); mc_u32(c, 192); jl_gm_1mh2 := mc_jcc8(c, 0x7C)
        mc_b3(c, 0x48, 0xD1, 0xE8); mc_b4(c, 0x48, 0x83, 0xC0, 5)
        mc_b2(c, 0x31, 0xD2); mc_b1(c, 0xBF); mc_u32(c, 6); mc_b3(c, 0x48, 0xF7, 0xF7)
        mc_b4(c, 0x48, 0x6B, 0xF0, 6)
        mc_b1(c, 0xBA); mc_u32(c, 2)
        mc_b3(c, 0x48, 0xD1, 0xE1)
        mc_patch_jcc8(c, jle_gm_1mh, buf_len(c))
        mc_patch_jcc8(c, jl_gm_1mh2, buf_len(c))
        mc_b4(c, 0x48, 0x89, 0xB4, 0x24); mc_u32(c, 12544)
        mc_b4(c, 0x48, 0x89, 0x8C, 0x24); mc_u32(c, 12552)
        mc_b4(c, 0x48, 0x89, 0x94, 0x24); mc_u32(c, 12560)
        mc_b4(c, 0x48, 0xC7, 0x84, 0x24); mc_u32(c, 12568); mc_u32(c, 0)

        lp_gm_j16 := buf_len(c)
        mc_b4(c, 0x48, 0x83, 0xBC, 0x24); mc_u32(c, 12528); mc_b1(c, 1); jle_gm_st := mc_jcc8(c, 0x7E)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 12512)
        mc_b1(c, 0xBA); mc_u32(c, 1)
        mc_b4(c, 0xF0, 0x48, 0x0F, 0xC1); mc_b1(c, 0x90); mc_u32(c, 1728)
        mc_b3(c, 0x48, 0x89, 0xD0)
        jmp_gm_gt := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jle_gm_st, buf_len(c))
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 12568)
        mc_b4(c, 0x48, 0xFF, 0x84, 0x24); mc_u32(c, 12568)
        mc_patch_jcc8(c, jmp_gm_gt, buf_len(c))
        mc_b4(c, 0x48, 0x3B, 0x84, 0x24); mc_u32(c, 12552)
        jg_gm_j8 := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x48, 0x83, 0xBC, 0x24); mc_u32(c, 12560); mc_b1(c, 2); jne_gm_d1 := mc_jcc8(c, 0x75)
        mc_b3(c, 0x49, 0x89, 0xC2); mc_b3(c, 0x49, 0xD1, 0xEA); mc_b4(c, 0x49, 0xC1, 0xE2, 4)
        mc_b2(c, 0xA8, 0x01); jnz_gm_h1 := mc_jcc8(c, 0x75)
        mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 32); mc_u32(c, 0)
        mc_b4(c, 0x4C, 0x8B, 0xBC, 0x24); mc_u32(c, 12544)
        jmp_gm_dr := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jnz_gm_h1, buf_len(c))
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 12544)
        mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 32)
        mc_b4(c, 0x4C, 0x8B, 0xBC, 0x24); mc_u32(c, 12536)
        jmp_gm_dr2 := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jne_gm_d1, buf_len(c))
        mc_b3(c, 0x49, 0x89, 0xC2); mc_b4(c, 0x49, 0xC1, 0xE2, 4)
        mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 32); mc_u32(c, 0)
        mc_b4(c, 0x4C, 0x8B, 0xBC, 0x24); mc_u32(c, 12536)
        mc_patch_jcc8(c, jmp_gm_dr, buf_len(c))
        mc_patch_jcc8(c, jmp_gm_dr2, buf_len(c))

        // Middle k-tile loop (`pc = 0; do { ... } while (pc < k)`, `KC = 64`)
        mc_b2(c, 0x31, 0xC0)
        mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 48) // [RSP+48] = pc = 0
        lp_gm_pc := buf_len(c)
        mc_b4(c, 0x48, 0x8B, 0x04, 0x24)               // RAX = k
        mc_b4(c, 0x48, 0x2B, 0x44, 0x24); mc_b1(c, 48) // RAX = k - pc
        mc_b2(c, 0x48, 0x3D); mc_u32(c, 192)           // CMP RAX, 192 (12KB L1D B_pack -> 3x fewer C reloads!)
        jle_kb32 := mc_jcc8(c, 0x7E)
        mc_b1(c, 0xB8); mc_u32(c, 192)
        mc_patch_jcc8(c, jle_kb32, buf_len(c))
        mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 56) // [RSP+56] = k_blk

        // Pack `B[pc..pc+k_blk-1, j..j+15]` into contiguous `[RSP + 192]` (eliminates all L1D stride conflicts!)
        mc_b3(c, 0x48, 0x89, 0xC3)                     // RBX = k_blk
        mc_b3(c, 0x48, 0x85, 0xDB)
        jle_pack_e := mc_jcc8(c, 0x7E)
        mc_b4(c, 0x48, 0x8B, 0x44, 0x24); mc_b1(c, 48) // RAX = pc
        mc_b4(c, 0x48, 0x8B, 0x4C, 0x24); mc_b1(c, 24) // RCX = b_stride
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)               // RAX = pc * b_stride
        mc_b4(c, 0x48, 0x03, 0x44, 0x24); mc_b1(c, 16) // RAX = B + pc * b_stride
        mc_b4(c, 0x4A, 0x8D, 0x34, 0x90)               // LEA RSI, [RAX + R10*4]
        mc_b4(c, 0x48, 0x8D, 0xBC, 0x24); mc_u32(c, 192) // LEA RDI, [RSP + 192]
        lp_pack := buf_len(c)
        mc_vex2(c, 0, 1, 0, 0x10, 0x06)                 // VMOVUPS YMM0, [RSI]
        mc_vex2(c, 0, 1, 0, 0x10, 0x4E); mc_b1(c, 0x20) // VMOVUPS YMM1, [RSI + 32]
        mc_vex2(c, 0, 1, 0, 0x11, 0x07)                 // VMOVUPS [RDI], YMM0
        mc_vex2(c, 0, 1, 0, 0x11, 0x4F); mc_b1(c, 0x20) // VMOVUPS [RDI + 32], YMM1
        mc_b3(c, 0x48, 0x01, 0xCE)                      // ADD RSI, RCX (b_stride)
        mc_b4(c, 0x48, 0x83, 0xC7, 0x40)                // ADD RDI, 64
        mc_b3(c, 0x48, 0xFF, 0xCB)                      // DEC RBX
        jnz_pack := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_pack, lp_pack)
        mc_patch_jcc8(c, jle_pack_e, buf_len(c))

        // 6x16 row block `i = r0 .. r1-6` (`YMM0..YMM11` = 12 C accs, 2x K-unrolled!)
        mc_b4(c, 0x4C, 0x8B, 0x6C, 0x24); mc_b1(c, 32) // R13 = r0
        lp_gm_i6 := buf_len(c)
        mc_b4(c, 0x49, 0x8D, 0x45, 0x05)
        mc_b3(c, 0x4C, 0x39, 0xF8)
        jge_gm_i4 := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x48, 0x8B, 0x04, 0x24)
