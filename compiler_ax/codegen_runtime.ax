        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x31); mc_b3(c, 0x6C, 0x0F, 8)  // VPMOVZXBD Y13, [RDI+RCX+8]
        mc_vex256(c, 1, 12, 12, 6, 0xFA); mc_vex256(c, 1, 13, 13, 6, 0xFA)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 0, 0x5B); mc_b1(c, 0xE4)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 0, 0x5B); mc_b1(c, 0xED)
        mc_vex3(c, 0, 0, 1, 2, 0, 12, 1, 1, 0xB8); mc_b1(c, 0xD0)          // VFMADD231PS Y2, Y12, Y8
        mc_vex3(c, 0, 0, 1, 2, 0, 13, 1, 1, 0xB8); mc_b1(c, 0xD9)          // VFMADD231PS Y3, Y13, Y9
        // Row 2 (RBX) -> Y4, Y5
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x31); mc_b2(c, 0x24, 0x0B)     // VPMOVZXBD Y12, [RBX+RCX]
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x31); mc_b3(c, 0x6C, 0x0B, 8)  // VPMOVZXBD Y13, [RBX+RCX+8]
        mc_vex256(c, 1, 12, 12, 6, 0xFA); mc_vex256(c, 1, 13, 13, 6, 0xFA)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 0, 0x5B); mc_b1(c, 0xE4)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 0, 0x5B); mc_b1(c, 0xED)
        mc_vex3(c, 0, 0, 1, 2, 0, 12, 1, 1, 0xB8); mc_b1(c, 0xE0)          // VFMADD231PS Y4, Y12, Y8
        mc_vex3(c, 0, 0, 1, 2, 0, 13, 1, 1, 0xB8); mc_b1(c, 0xE9)          // VFMADD231PS Y5, Y13, Y9
        // Row 3 (RDX) -> Y10, Y11
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x31); mc_b2(c, 0x24, 0x0A)     // VPMOVZXBD Y12, [RDX+RCX]
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x31); mc_b3(c, 0x6C, 0x0A, 8)  // VPMOVZXBD Y13, [RDX+RCX+8]
        mc_vex256(c, 1, 12, 12, 6, 0xFA); mc_vex256(c, 1, 13, 13, 6, 0xFA)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 0, 0x5B); mc_b1(c, 0xE4)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 0, 0x5B); mc_b1(c, 0xED)
