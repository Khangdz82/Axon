        jle_gm64_e := mc_jcc32(c, 0x8E)
        mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 16632)
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 64)
        mc_b4(c, 0x48, 0x89, 0x04, 0x24)
        mc_b3(c, 0x48, 0xC1, 0xE0); mc_b1(c, 3)
        mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 40)
        mc_b4(c, 0x49, 0x8B, 0x4C, 0x24); mc_b1(c, 72)
        mc_b4(c, 0x48, 0x89, 0x4C, 0x24); mc_b1(c, 8)
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 40)
        mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 16)
        mc_b3(c, 0x48, 0xC1, 0xE1); mc_b1(c, 3)
        mc_b4(c, 0x48, 0x89, 0x4C, 0x24); mc_b1(c, 24)
        mc_b4(c, 0x4D, 0x8B, 0x4C, 0x24); mc_b1(c, 32)
        mc_b4(c, 0x4D, 0x8B, 0x5C, 0x24); mc_b1(c, 48)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_gm64_sc := mc_jcc32(c, 0x84)

        mut gxi64 := 0
        while gxi64 < 8 {
            xreg := 6 + gxi64
            mut xr_bit := 1
            if (xreg & 8) != 0 { xr_bit = 0 }
            off_x := 64 + gxi64 * 16
            mc_b4(c, 0xC4, (xr_bit << 7) | 0x61, 0x7A, 0x7F)
            if off_x < 128 {
                mc_b3(c, 0x44 | ((xreg & 7) << 3), 0x24, off_x)
            } else {
                mc_b2(c, 0x84 | ((xreg & 7) << 3), 0x24); mc_u32(c, off_x)
            }
            gxi64 += 1
        }
        mc_b4(c, 0x44, 0x0F, 0x11, 0xB4); mc_b1(c, 0x24); mc_u32(c, 16576)
        mc_b4(c, 0x44, 0x0F, 0x11, 0xBC); mc_b1(c, 0x24); mc_u32(c, 16592)

        mc_b4(c, 0x48, 0x8B, 0x4C, 0x24); mc_b1(c, 8)
        mc_b4(c, 0x48, 0xC1, 0xE9, 3)
        mc_b3(c, 0x48, 0x85, 0xC9); jle_g64_j0 := mc_jcc32(c, 0x8E)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 16632)
        mc_b1(c, 0xBA); mc_u32(c, 1)
        mc_b3(c, 0x48, 0x89, 0xC6)
        mc_b4(c, 0x48, 0x83, 0xBC, 0x24); mc_u32(c, 16624); mc_b1(c, 1); jle_g64_1mh := mc_jcc8(c, 0x7E)
        mc_b2(c, 0x48, 0x3D); mc_u32(c, 128); jl_g64_1mh2 := mc_jcc8(c, 0x7C)
        mc_b3(c, 0x48, 0xD1, 0xE8); mc_b4(c, 0x48, 0x83, 0xC0, 5)
        mc_b2(c, 0x31, 0xD2); mc_b1(c, 0xBF); mc_u32(c, 6); mc_b3(c, 0x48, 0xF7, 0xF7)
        mc_b4(c, 0x48, 0x6B, 0xF0, 6)
        mc_b1(c, 0xBA); mc_u32(c, 2)
        mc_b3(c, 0x48, 0xD1, 0xE1)
        mc_patch_jcc8(c, jle_g64_1mh, buf_len(c))
        mc_patch_jcc8(c, jl_g64_1mh2, buf_len(c))
        mc_b4(c, 0x48, 0x89, 0xB4, 0x24); mc_u32(c, 16640)
        mc_b4(c, 0x48, 0x89, 0x8C, 0x24); mc_u32(c, 16648)
        mc_b4(c, 0x48, 0x89, 0x94, 0x24); mc_u32(c, 16656)
        mc_b4(c, 0x48, 0xC7, 0x84, 0x24); mc_u32(c, 16664); mc_u32(c, 0)

        lp_g64_j8 := buf_len(c)
        mc_b4(c, 0x48, 0x83, 0xBC, 0x24); mc_u32(c, 16624); mc_b1(c, 1); jle_g64_st := mc_jcc8(c, 0x7E)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 16608)
        mc_b1(c, 0xBA); mc_u32(c, 1)
        mc_b4(c, 0xF0, 0x48, 0x0F, 0xC1); mc_b1(c, 0x90); mc_u32(c, 1728)
        mc_b3(c, 0x48, 0x89, 0xD0)
        jmp_g64_gt := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jle_g64_st, buf_len(c))
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 16664)
        mc_b4(c, 0x48, 0xFF, 0x84, 0x24); mc_u32(c, 16664)
        mc_patch_jcc8(c, jmp_g64_gt, buf_len(c))
        mc_b4(c, 0x48, 0x3B, 0x84, 0x24); mc_u32(c, 16648)
        jg_g64_jt := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x48, 0x83, 0xBC, 0x24); mc_u32(c, 16656); mc_b1(c, 2); jne_g64_d1 := mc_jcc8(c, 0x75)
        mc_b3(c, 0x49, 0x89, 0xC2); mc_b3(c, 0x49, 0xD1, 0xEA); mc_b4(c, 0x49, 0xC1, 0xE2, 3)
        mc_b2(c, 0xA8, 0x01); jnz_g64_h1 := mc_jcc8(c, 0x75)
        mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 32); mc_u32(c, 0)
        mc_b4(c, 0x4C, 0x8B, 0xBC, 0x24); mc_u32(c, 16640)
        jmp_g64_dr := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jnz_g64_h1, buf_len(c))
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 16640)
        mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 32)
        mc_b4(c, 0x4C, 0x8B, 0xBC, 0x24); mc_u32(c, 16632)
        jmp_g64_dr2 := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jne_g64_d1, buf_len(c))
        mc_b3(c, 0x49, 0x89, 0xC2); mc_b4(c, 0x49, 0xC1, 0xE2, 3)
        mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 32); mc_u32(c, 0)
        mc_b4(c, 0x4C, 0x8B, 0xBC, 0x24); mc_u32(c, 16632)
        mc_patch_jcc8(c, jmp_g64_dr, buf_len(c))
        mc_patch_jcc8(c, jmp_g64_dr2, buf_len(c))

        mc_b2(c, 0x31, 0xC0)
        mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 48)
        lp_g64_pc := buf_len(c)
        mc_b4(c, 0x48, 0x8B, 0x04, 0x24)
        mc_b4(c, 0x48, 0x2B, 0x44, 0x24); mc_b1(c, 48)
        mc_b2(c, 0x48, 0x3D); mc_u32(c, 256)
        jle_kb64 := mc_jcc8(c, 0x7E)
        mc_b1(c, 0xB8); mc_u32(c, 256)
        mc_patch_jcc8(c, jle_kb64, buf_len(c))
        mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 56)

        // Pack B[pc..pc+k_blk-1, j..j+7] -> [RSP + 192] (64B/row)
        mc_b3(c, 0x48, 0x89, 0xC3)
        mc_b3(c, 0x48, 0x85, 0xDB)
        jle_pk64e := mc_jcc8(c, 0x7E)
        mc_b4(c, 0x48, 0x8B, 0x44, 0x24); mc_b1(c, 48)
        mc_b4(c, 0x48, 0x8B, 0x4C, 0x24); mc_b1(c, 24)
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
        mc_b4(c, 0x48, 0x03, 0x44, 0x24); mc_b1(c, 16)
        mc_b4(c, 0x4A, 0x8D, 0x34, 0xD0) // LEA RSI, [RAX + R10*8]
        mc_b4(c, 0x48, 0x8D, 0xBC, 0x24); mc_u32(c, 192)
        lp_pk64 := buf_len(c)
        mc_vex2(c, 0, 1, 1, 0x10, 0x06)                 // VMOVUPD YMM0, [RSI]
        mc_vex2(c, 0, 1, 1, 0x10, 0x4E); mc_b1(c, 0x20) // VMOVUPD YMM1, [RSI+32]
        mc_vex2(c, 0, 1, 1, 0x11, 0x07)                 // VMOVUPD [RDI], YMM0
        mc_vex2(c, 0, 1, 1, 0x11, 0x4F); mc_b1(c, 0x20) // VMOVUPD [RDI+32], YMM1
        mc_b3(c, 0x48, 0x01, 0xCE)
        mc_b4(c, 0x48, 0x83, 0xC7, 0x40)
        mc_b3(c, 0x48, 0xFF, 0xCB)
        jnz_pk64 := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_pk64, lp_pk64)
        mc_patch_jcc8(c, jle_pk64e, buf_len(c))

        // 6x8 row block `i = r0 .. r1-6` (`YMM0..YMM11` = 12 C accs, 2x K-unrolled FMA3!)
        mc_b4(c, 0x4C, 0x8B, 0x6C, 0x24); mc_b1(c, 32)
        lp_g64_i6 := buf_len(c)
        mc_b4(c, 0x49, 0x8D, 0x45, 0x05)
        mc_b3(c, 0x4C, 0x39, 0xF8)
        jge_g64_i4 := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x48, 0x8B, 0x04, 0x24)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC5)
        mc_b4(c, 0x48, 0x03, 0x44, 0x24); mc_b1(c, 48)
        mc_b4(c, 0x49, 0x8D, 0x3C, 0xC1)
        mc_b4(c, 0x4C, 0x8B, 0x64, 0x24); mc_b1(c, 40)
        mc_b4(c, 0x4A, 0x8D, 0x34, 0x27)
        mc_b3(c, 0x49, 0x89, 0xF0); mc_b3(c, 0x4D, 0x01, 0xE0)
        mc_b3(c, 0x4D, 0x89, 0xC6); mc_b3(c, 0x4D, 0x01, 0xE6)
        mc_b3(c, 0x4C, 0x89, 0xF5); mc_b3(c, 0x4C, 0x01, 0xE5)
        mc_b3(c, 0x49, 0x01, 0xEC)
        mc_b3(c, 0x49, 0x87, 0xEC)
        mc_b4(c, 0x48, 0x8D, 0x94, 0x24); mc_u32(c, 192)
        mc_b4(c, 0x48, 0x8B, 0x44, 0x24); mc_b1(c, 8)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC5)
        mc_b3(c, 0x4C, 0x01, 0xD0)
        mc_b4(c, 0x49, 0x8D, 0x0C, 0xC3)
        mc_b4(c, 0x48, 0x83, 0x7C, 0x24); mc_b2(c, 48, 0)
        jne_ld64_c6 := mc_jcc32(c, 0x85)
        mut yz64_6 := 0
        while yz64_6 < 8 { mc_vex2(c, yz64_6, 1, 1, 0x57, 0xC0 | (yz64_6 << 3) | yz64_6); yz64_6 += 1 }
        while yz64_6 < 12 { mc_vex3(c, 1, 0, 1, 1, 0, yz64_6, 1, 1, 0x57); mc_b1(c, 0xC0 | ((yz64_6 - 8) << 3) | (yz64_6 - 8)); yz64_6 += 1 }
        jmp_c64_6rdy := mc_jmp32(c)
        mc_patch_rel32(c, jne_ld64_c6, buf_len(c))
        mc_b3(c, 0x48, 0x89, 0xC8)
        mc_b4(c, 0x48, 0x8B, 0x5C, 0x24); mc_b1(c, 24)
        mc_vex2(c, 0, 1, 1, 0x10, 0x00); mc_vex2(c, 0, 1, 1, 0x10, 0x48); mc_b1(c, 0x20)
        mc_b3(c, 0x48, 0x01, 0xD8)
        mc_vex2(c, 0, 1, 1, 0x10, 0x10); mc_vex2(c, 0, 1, 1, 0x10, 0x58); mc_b1(c, 0x20)
        mc_b3(c, 0x48, 0x01, 0xD8)
        mc_vex2(c, 0, 1, 1, 0x10, 0x20); mc_vex2(c, 0, 1, 1, 0x10, 0x68); mc_b1(c, 0x20)
        mc_b3(c, 0x48, 0x01, 0xD8)
        mc_vex2(c, 0, 1, 1, 0x10, 0x30); mc_vex2(c, 0, 1, 1, 0x10, 0x78); mc_b1(c, 0x20)
        mc_b3(c, 0x48, 0x01, 0xD8)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x00)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x48, 0x20)
        mc_b3(c, 0x48, 0x01, 0xD8)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x10)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x58, 0x20)
        mc_patch_rel32(c, jmp_c64_6rdy, buf_len(c))

        mc_b4(c, 0x48, 0x8B, 0x5C, 0x24); mc_b1(c, 56)
        mc_align16_nop(c)
        lp_p64_6_2 := buf_len(c)
        mc_b4(c, 0x48, 0x83, 0xFB, 4); jl_p64_6_1 := mc_jcc32(c, 0x8C)
        mut ku64 := 0
        while ku64 < 4 {
            aoff := ku64 * 8
            boff := ku64 * 64
            if boff == 0 {
                mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x22)
                mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x6A, 32)
            } else if boff < 128 {
                mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x62, boff)
                mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x6A, boff + 32)
            } else {
                mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0xA2); mc_u32(c, boff)
                mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0xAA); mc_u32(c, boff + 32)
            }
            if aoff == 0 {
                mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x37)
                mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x3E)
            } else {
                mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x77, aoff)
                mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x7E, aoff)
            }
            mc_vex3(c, 0, 0, 1, 2, 1, 14, 1, 1, 0xB8); mc_b1(c, 0xC4)
            mc_vex3(c, 0, 0, 1, 2, 1, 14, 1, 1, 0xB8); mc_b1(c, 0xCD)
            mc_vex3(c, 0, 0, 1, 2, 1, 15, 1, 1, 0xB8); mc_b1(c, 0xD4)
            mc_vex3(c, 0, 0, 1, 2, 1, 15, 1, 1, 0xB8); mc_b1(c, 0xDD)
            if aoff == 0 {
                mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x30)
                mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x3E)
            } else {
                mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x70, aoff)
                mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x7E, aoff)
            }
            mc_vex3(c, 0, 0, 1, 2, 1, 14, 1, 1, 0xB8); mc_b1(c, 0xE4)
            mc_vex3(c, 0, 0, 1, 2, 1, 14, 1, 1, 0xB8); mc_b1(c, 0xED)
            mc_vex3(c, 0, 0, 1, 2, 1, 15, 1, 1, 0xB8); mc_b1(c, 0xF4)
            mc_vex3(c, 0, 0, 1, 2, 1, 15, 1, 1, 0xB8); mc_b1(c, 0xFD)
