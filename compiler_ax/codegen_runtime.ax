        mc_b4(c, 0x48, 0x83, 0xEB, 4)
        j_p64_6_2 := mc_jmp32(c); mc_patch_rel32(c, j_p64_6_2, lp_p64_6_2)

        mc_patch_rel32(c, jl_p64_6_1, buf_len(c))
        lp_p64_6_rem := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xDB); jle_p64_6_e := mc_jcc32(c, 0x8E)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x22)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x6A, 32)
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x37)
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x3E)
        mc_vex3(c, 0, 0, 1, 2, 1, 14, 1, 1, 0xB8); mc_b1(c, 0xC4)
        mc_vex3(c, 0, 0, 1, 2, 1, 14, 1, 1, 0xB8); mc_b1(c, 0xCD)
        mc_vex3(c, 0, 0, 1, 2, 1, 15, 1, 1, 0xB8); mc_b1(c, 0xD4)
        mc_vex3(c, 0, 0, 1, 2, 1, 15, 1, 1, 0xB8); mc_b1(c, 0xDD)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x30)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x3E)
        mc_vex3(c, 0, 0, 1, 2, 1, 14, 1, 1, 0xB8); mc_b1(c, 0xE4)
        mc_vex3(c, 0, 0, 1, 2, 1, 14, 1, 1, 0xB8); mc_b1(c, 0xED)
        mc_vex3(c, 0, 0, 1, 2, 1, 15, 1, 1, 0xB8); mc_b1(c, 0xF4)
