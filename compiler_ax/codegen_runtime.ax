        mc_b3(c, 0x48, 0x81, 0xFA); mc_u32(c, 0x7FFFFFF0); cg_jmp_fn(cg, 0x8F, h_sec_trap())
        mc_b3(c, 0x48, 0x8B, 0x01)
        mc_b3(c, 0x49, 0x89, 0xC0)
        mc_b3(c, 0x49, 0x01, 0xD0); cg_jmp_fn(cg, 0x80, h_sec_trap())
        mc_b3(c, 0x49, 0x81, 0xF8); mc_u32(c, 0x7FFFFFF0); cg_jmp_fn(cg, 0x8F, h_sec_trap())
        mc_b4(c, 0x4C, 0x3B, 0x41, 0x08)
        ja_grow := mc_jcc8(c, 0x77)
        mc_b3(c, 0x48, 0x89, 0xC8)
        mc_b1(c, 0xC3)
