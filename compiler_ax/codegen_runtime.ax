        mc_vex3(c, 0, 0, 0, 1, 0, 2, 1, 0, 0x58); mc_b1(c, 0xD3)
        mc_vex3(c, 0, 0, 0, 1, 0, 4, 1, 0, 0x58); mc_b1(c, 0xE5)
        mc_vex3(c, 1, 0, 1, 1, 0, 10, 1, 0, 0x58); mc_b1(c, 0xD3)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC1, 1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0x58); mc_b1(c, 0xC1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0x12); mc_b1(c, 0xC8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0x58); mc_b1(c, 0xC1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0xC6); mc_b2(c, 0xC8, 1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 2, 0x58); mc_b1(c, 0xC1); mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 2, 0x5A); mc_b1(c, 0xC0) // VCVTSS2SD X0, X0, X0
        mc_vex3(c, 1, 0, 0, 1, 0, 14, 0, 3, 0x58); mc_b1(c, 0xF0)                            // VADDSD X14, X14, X0
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xD1, 1)
        mc_vex3(c, 0, 0, 0, 1, 0, 2, 0, 0, 0x58); mc_b1(c, 0xC1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0x12); mc_b1(c, 0xC8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0x58); mc_b1(c, 0xC1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0xC6); mc_b2(c, 0xC8, 1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 2, 0x58); mc_b1(c, 0xC1); mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 2, 0x5A); mc_b1(c, 0xC0)
        mc_vex3(c, 1, 0, 0, 1, 0, 14, 0, 3, 0x58); mc_b1(c, 0xF0)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xE1, 1)
        mc_vex3(c, 0, 0, 0, 1, 0, 4, 0, 0, 0x58); mc_b1(c, 0xC1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0x12); mc_b1(c, 0xC8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0x58); mc_b1(c, 0xC1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0xC6); mc_b2(c, 0xC8, 1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 2, 0x58); mc_b1(c, 0xC1); mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 2, 0x5A); mc_b1(c, 0xC0)
        mc_vex3(c, 1, 0, 0, 1, 0, 14, 0, 3, 0x58); mc_b1(c, 0xF0)
        mc_vex3(c, 1, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xD1, 1)
        mc_vex3(c, 0, 0, 0, 1, 0, 10, 0, 0, 0x58); mc_b1(c, 0xC1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0x12); mc_b1(c, 0xC8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0x58); mc_b1(c, 0xC1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0xC6); mc_b2(c, 0xC8, 1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 2, 0x58); mc_b1(c, 0xC1); mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 2, 0x5A); mc_b1(c, 0xC0)
        mc_vex3(c, 1, 0, 0, 1, 0, 14, 0, 3, 0x58); mc_b1(c, 0xF0)
        mc_b4(c, 0x4A, 0x8D, 0x34, 0x12)                         // RSI = RDX + cols = row + 4
        mc_b4(c, 0x49, 0x83, 0xC3, 4)                            // r += 4
        j_bn4r := mc_jmp32(c); mc_patch_rel32(c, j_bn4r, lp_bn4r)

        // Remainder 1-row path (for rows % 4 or cols % 16)
        mc_patch_rel32(c, jnz_bn1r, buf_len(c))
        mc_patch_rel32(c, jg_bn1r, buf_len(c))
        mc_b4(c, 0x4D, 0x8D, 0x6A, 0xF8)                         // R13 = cols - 8
        lp_bnr := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xE3); jge_bnr_dn := mc_jcc32(c, 0x8D)
        mc_vex256(c, 1, 0, 0, 0, 0x57)                           // Y0 = row f32 acc
        mc_b2(c, 0x31, 0xC9)
        mc_b3(c, 0x4C, 0x39, 0xE9); jg_bnt := mc_jcc32(c, 0x8F)
        lp_bnc := buf_len(c)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x31); mc_b2(c, 0x0C, 0x0E)
        mc_vex256(c, 1, 1, 1, 6, 0xFA)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x5B); mc_b1(c, 0xC9)
        mc_vex3(c, 0, 0, 1, 2, 0, 1, 1, 1, 0xB8); mc_b2(c, 0x04, 0x89) // VFMADD231PS Y0, Y1, [R9+RCX*4]
        mc_b4(c, 0x48, 0x83, 0xC1, 8); mc_b3(c, 0x4C, 0x39, 0xE9)
        jle_bnc := mc_jcc8(c, 0x7E); mc_patch_jcc8(c, jle_bnc, lp_bnc)
        mc_patch_rel32(c, jg_bnt, buf_len(c))
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC1, 1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0x58); mc_b1(c, 0xC1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0x12); mc_b1(c, 0xC8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0x58); mc_b1(c, 0xC1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0xC6); mc_b2(c, 0xC8, 1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 2, 0x58); mc_b1(c, 0xC1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 2, 0x5A); mc_b1(c, 0xC0)
        mc_vex3(c, 1, 0, 0, 1, 0, 14, 0, 3, 0x58); mc_b1(c, 0xF0)
        lp_bnt := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jge_bnt_dn := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x0F, 0xB6, 0x04); mc_b1(c, 0x0E)
        mc_b3(c, 0x83, 0xE8, 1)
        mc_b4(c, 0xF2, 0x0F, 0x2A, 0xC8)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x5A); mc_b2(c, 0x14, 0x89)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xCA); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xF1) // ADDSD X14, X1
        mc_b3(c, 0x48, 0xFF, 0xC1)
        j_bnt := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_bnt, lp_bnt)
        mc_patch_jcc8(c, jge_bnt_dn, buf_len(c))
        mc_b3(c, 0x4C, 0x01, 0xD6); mc_b3(c, 0x49, 0xFF, 0xC3)
        j_bnr := mc_jmp32(c); mc_patch_rel32(c, j_bnr, lp_bnr)
        mc_patch_rel32(c, jge_bnr_dn, buf_len(c))
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b1(c, 0xC6) // VMOVSD X0, X0, X14
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_bn_end := mc_jmp32(c)

        // Scalar fallback for `--simd=scalar`
        mc_patch_rel32(c, jz_bn_sc, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xD8); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC2); mc_b3(c, 0x4C, 0x01, 0xC0); mc_b3(c, 0x48, 0x89, 0xC6)
        lp_bnsr := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xE3); jge_bns_dn := mc_jcc32(c, 0x8D)
        mc_b2(c, 0x31, 0xC9)
        lp_bnsc := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jge_bnsc := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x0F, 0xB6, 0x04); mc_b1(c, 0x0E)
        mc_b3(c, 0x83, 0xE8, 1)
        mc_b4(c, 0xF2, 0x0F, 0x2A, 0xC8)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x5A); mc_b2(c, 0x14, 0x89)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xCA); mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)
        mc_b3(c, 0x48, 0xFF, 0xC1)
        j_bnsc := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_bnsc, lp_bnsc)
        mc_patch_jcc8(c, jge_bnsc, buf_len(c))
        mc_b3(c, 0x4C, 0x01, 0xD6); mc_b3(c, 0x49, 0xFF, 0xC3)
        j_bnsr := mc_jmp32(c); mc_patch_rel32(c, j_bnsr, lp_bnsr)
        mc_patch_rel32(c, jge_bns_dn, buf_len(c))

        mc_patch_rel32(c, jmp_bn_blk_end, buf_len(c))
        mc_patch_rel32(c, jmp_bn_end, buf_len(c))
        mc_patch_rel32(c, jge_bn_dn, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0) // MOVQ RAX, XMM0
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0x8B8)
        cg_reg_helper(cg, h_ai_bitnet158_dot(), s_bn, buf_len(c))
    }

