        mc_b3(c, 0x45, 0x31, 0xED); mc_b3(c, 0x4D, 0x89, 0xC6)
        lp_fwsi := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xCD); jge_fwsi := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4D, 0x39, 0xDD); je_fwsi_sk := mc_jcc8(c, 0x74)
        mc_b4(c, 0x43, 0x8B, 0x04, 0x9E)
        mc_b1(c, 0x3D); mc_u32(c, 1000000000); jge_fwsi_sk2 := mc_jcc8(c, 0x7D)
        mc_b2(c, 0x31, 0xC9)
        lp_fwsj := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xC9); jge_fwsj := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x41, 0x8B, 0x14, 0x8C)
        mc_b2(c, 0x01, 0xC2)
        mc_b4(c, 0x41, 0x8B, 0x34, 0x8E)
        mc_b2(c, 0x39, 0xF2); jge_fw_no := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x41, 0x89, 0x14, 0x8E)
        mc_patch_jcc8(c, jge_fw_no, buf_len(c))
        mc_b3(c, 0x48, 0xFF, 0xC1); j_fwsj := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_fwsj, lp_fwsj)
        mc_patch_jcc8(c, jge_fwsj, buf_len(c))
        mc_patch_jcc8(c, je_fwsi_sk, buf_len(c))
        mc_patch_jcc8(c, jge_fwsi_sk2, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC5); mc_b3(c, 0x4D, 0x01, 0xD6)
        j_fwsi := mc_jmp32(c); mc_patch_rel32(c, j_fwsi, lp_fwsi)
        mc_patch_rel32(c, jge_fwsi, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC3); mc_b3(c, 0x4D, 0x01, 0xD4)
        j_fwsk := mc_jmp32(c); mc_patch_rel32(c, j_fwsk, lp_fwsk)
        mc_patch_rel32(c, jge_fwsk, buf_len(c))

        mc_patch_rel32(c, jmp_fw16_end, buf_len(c))
        mc_patch_rel32(c, jmp_fw_end, buf_len(c))
        mc_patch_rel32(c, jle_fw_dn, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_ai_leave(c, 0x18)
        cg_reg_helper(cg, h_ai_floyd_warshall_i32(), s_fw, buf_len(c))
    }

    // 21. `h_ai_minmax_sum_i64(p, n, out3) -> i64`: 4-wide AVX2 VPCMPGTQ+VPBLENDVB+VPADDQ (2x unrolled!)
    if cg_is_helper_used(cg, h_ai_minmax_sum_i64()) {
        mc_align16(c)
        s_mm := buf_len(c)
        mc_ai_enter(c, 0x118)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = p
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = n
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = out3
        mc_b2(c, 0x49, 0xBB); mc_u64(c, 0x7FFFFFFFFFFFFFFF) // R11 = mn
        mc_b2(c, 0x49, 0xBC); mc_u64(c, -0x7FFFFFFFFFFFFFFF - 1) // R12 = mx
        mc_b3(c, 0x45, 0x31, 0xED)       // R13 = sum = 0
        mc_b2(c, 0x31, 0xC9)             // RCX = i = 0
        mc_b3(c, 0x4D, 0x85, 0xC9); jle_mm_dn := mc_jcc32(c, 0x8E)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_mm_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x49, 0x83, 0xF9, 8); jl_mm_sc2 := mc_jcc32(c, 0x8C)

        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x59); mc_b1(c, 0x00) // VPBROADCASTQ Y0, [R8] (mn0)
        mc_vex256(c, 1, 1, 0, 0, 0x6F) // Y1 = Y0 (mx0)
        mc_vex256(c, 1, 3, 0, 0, 0x6F) // Y3 = Y0 (mn1)
        mc_vex256(c, 1, 4, 0, 0, 0x6F) // Y4 = Y0 (mx1)
        mc_vex256(c, 1, 2, 2, 2, 0xEF) // Y2 = 0 (sum0)
        mc_vex256(c, 1, 5, 5, 5, 0xEF) // Y5 = 0 (sum1)
        mc_b4(c, 0x4D, 0x8D, 0x71, 0xF8) // R14 = n - 8
        mc_align16_nop(c)
        lp_mm8 := buf_len(c)
        mc_b4(c, 0x41, 0x0F, 0x18, 0x84); mc_b1(c, 0xC8); mc_u32(c, 512)   // PREFETCHNTA [R8+RCX*8+512] (preserve L3!)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x34, 0xC8)     // Y6 = [R8+RCX*8]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x7C, 0xC8, 32) // Y7 = [R8+RCX*8+32]
        mc_vex256(c, 1, 2, 2, 6, 0xD4); mc_vex256(c, 1, 5, 5, 7, 0xD4)
        mc_vex256(c, 2, 8, 0, 6, 0x37); mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x4C); mc_b2(c, 0xC6, 0x80)
        mc_vex256(c, 2, 8, 6, 1, 0x37); mc_vex3(c, 0, 0, 0, 3, 0, 1, 1, 1, 0x4C); mc_b2(c, 0xCE, 0x80)
        mc_vex256(c, 2, 9, 3, 7, 0x37); mc_vex3(c, 0, 0, 0, 3, 0, 3, 1, 1, 0x4C); mc_b2(c, 0xDF, 0x90)
        mc_vex256(c, 2, 9, 7, 4, 0x37); mc_vex3(c, 0, 0, 0, 3, 0, 4, 1, 1, 0x4C); mc_b2(c, 0xE7, 0x90)
        mc_b4(c, 0x48, 0x83, 0xC1, 8); mc_b3(c, 0x4C, 0x39, 0xF1)
        jle_mm8 := mc_jcc8(c, 0x7E); mc_patch_jcc8(c, jle_mm8, lp_mm8)
        // Merge halves: Y0=min(Y0,Y3), Y1=max(Y1,Y4), Y2=Y2+Y5
        mc_vex256(c, 2, 8, 0, 3, 0x37); mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x4C); mc_b2(c, 0xC3, 0x80)
        mc_vex256(c, 2, 8, 4, 1, 0x37); mc_vex3(c, 0, 0, 0, 3, 0, 1, 1, 1, 0x4C); mc_b2(c, 0xCC, 0x80)
        mc_vex256(c, 1, 2, 2, 5, 0xD4)
        _mc_vst_rsp(c, 160, 0); _mc_vst_rsp(c, 192, 1); _mc_vst_rsp(c, 224, 2)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        // Fold 4 lanes from stack into R11, R12, R13
        mut ln := 0
        while ln < 4 {
            mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 160 + ln * 8)
            mc_b3(c, 0x4C, 0x39, 0xD8); mc_b4(c, 0x4C, 0x0F, 0x4C, 0xD8) // CMP RAX, R11; CMOVL R11, RAX
            mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 192 + ln * 8)
            mc_b3(c, 0x4C, 0x39, 0xE0); mc_b4(c, 0x4C, 0x0F, 0x4F, 0xE0) // CMP RAX, R12; CMOVG R12, RAX
            mc_b4(c, 0x4C, 0x03, 0xAC, 0x24); mc_u32(c, 224 + ln * 8)     // ADD R13, [RSP+224+ln*8]
            ln += 1
        }

        // Scalar tail & --simd=scalar fallback
        mc_patch_rel32(c, jz_mm_sc, buf_len(c))
        mc_patch_rel32(c, jl_mm_sc2, buf_len(c))
        lp_mms := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xC9); jge_mms := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xC8)
        mc_b3(c, 0x4C, 0x39, 0xD8); mc_b4(c, 0x4C, 0x0F, 0x4C, 0xD8)
        mc_b3(c, 0x4C, 0x39, 0xE0); mc_b4(c, 0x4C, 0x0F, 0x4F, 0xE0)
        mc_b3(c, 0x49, 0x01, 0xC5)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_mms := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_mms, lp_mms)
        mc_patch_jcc8(c, jge_mms, buf_len(c))

        mc_patch_rel32(c, jle_mm_dn, buf_len(c))
        mc_b3(c, 0x4D, 0x89, 0x1A)       // [R10+0] = R11
        mc_b4(c, 0x4D, 0x89, 0x62, 8)    // [R10+8] = R12
        mc_b4(c, 0x4D, 0x89, 0x6A, 16)   // [R10+16] = R13
        mc_b2(c, 0x31, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0x118)
        cg_reg_helper(cg, h_ai_minmax_sum_i64(), s_mm, buf_len(c))
    }

    // 22. `h_ai_saxpy_sum_f32(px, py, pd, n, a_f64) -> f64`: 8-wide AVX2 VMULPS+VADDPS+VMOVUPS+VCVTPS2PD exact sum!
    if cg_is_helper_used(cg, h_ai_saxpy_sum_f32()) {
        mc_align16(c)
        s_sx := buf_len(c)
        mc_ai_enter(c, 0xB8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = px
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = py
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = pd
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = n
        mc_b4(c, 0xF2, 0x0F, 0x5A, 0x69); mc_b1(c, 32) // CVTSD2SS XMM5, [RCX+32] (a as f32)
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) // XORPD XMM0, XMM0
        mc_b2(c, 0x31, 0xC9)             // RCX = i = 0
        mc_b3(c, 0x4D, 0x85, 0xDB); jle_sx_dn := mc_jcc32(c, 0x8E)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_sx_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x49, 0x83, 0xFB, 8); jl_sx_sc2 := mc_jcc32(c, 0x8C)

        mc_vex256(c, 2, 5, 0, 5, 0x18)   // VBROADCASTSS YMM5, XMM5
        mc_vex256(c, 1, 6, 6, 6, 0x57)   // Y6 = 0.0
        mc_vex256(c, 1, 7, 7, 7, 0x57)   // Y7 = 0.0
        mc_b4(c, 0x4D, 0x8D, 0x63, 0xF8) // R12 = n - 8
        mc_b4(c, 0x41, 0xF6, 0xC2, 63); jnz_sx_norm := mc_jcc32(c, 0x85)
        mc_b3(c, 0x49, 0x81, 0xFB); mc_u32(c, 16384); jl_sx_norm2 := mc_jcc32(c, 0x8C)
        mc_b4(c, 0x4D, 0x8D, 0x6B, 0xF0) // R13 = n - 16
        mc_b3(c, 0x4C, 0x89, 0xC6); mc_b3(c, 0x4C, 0x89, 0xCF); mc_b3(c, 0x4C, 0x89, 0xD2) // RSI=px, RDI=py, RDX=pd
        mc_vex256(c, 1, 8, 8, 8, 0x57); mc_vex256(c, 1, 9, 9, 9, 0x57)
        mc_align16_nop(c)
        lp_sx8_nt := buf_len(c)
        // 16 floats (64B FULL cache line) with base-pointer VMOVNTPS (zero SIB unlamination!)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x10); mc_b1(c, 0x06)        // VMOVUPS Y0, [RSI]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x10); mc_b2(c, 0x5E, 32)    // VMOVUPS Y3, [RSI+32]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x59); mc_b1(c, 0xC5)        // VMULPS Y0, Y0, Y5
        mc_vex3(c, 0, 0, 0, 1, 0, 3, 1, 0, 0x59); mc_b1(c, 0xDD)        // VMULPS Y3, Y3, Y5
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x58); mc_b1(c, 0x07)        // VADDPS Y0, Y0, [RDI]
        mc_vex3(c, 0, 0, 0, 1, 0, 3, 1, 0, 0x58); mc_b2(c, 0x5F, 32)    // VADDPS Y3, Y3, [RDI+32]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x2B); mc_b1(c, 0x02)        // VMOVNTPS [RDX], Y0
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x2B); mc_b2(c, 0x5A, 32)    // VMOVNTPS [RDX+32], Y3
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x5A); mc_b1(c, 0xC8)        // VCVTPS2PD Y1, X0
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC2, 1)     // VEXTRACTF128 X2, Y0, 1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x5A); mc_b1(c, 0xD2)        // VCVTPS2PD Y2, X2
        mc_vex256(c, 1, 6, 6, 1, 0x58); mc_vex256(c, 1, 7, 7, 2, 0x58)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x5A); mc_b1(c, 0xCB)        // VCVTPS2PD Y1, X3
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xDA, 1)     // VEXTRACTF128 X2, Y3, 1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x5A); mc_b1(c, 0xD2)        // VCVTPS2PD Y2, X2
        mc_vex256(c, 1, 8, 8, 1, 0x58); mc_vex256(c, 1, 9, 9, 2, 0x58)
        mc_b4(c, 0x48, 0x83, 0xC6, 64); mc_b4(c, 0x48, 0x83, 0xC7, 64); mc_b4(c, 0x48, 0x83, 0xC2, 64)
        mc_b4(c, 0x48, 0x83, 0xC1, 16); mc_b3(c, 0x4C, 0x39, 0xE9)
        jle_sx8_nt := mc_jcc32(c, 0x8E); mc_patch_rel32(c, jle_sx8_nt, lp_sx8_nt)
        mc_vex256(c, 1, 6, 6, 8, 0x58); mc_vex256(c, 1, 7, 7, 9, 0x58)
        mc_b3(c, 0x0F, 0xAE, 0xF8) // SFENCE
        jmp_sx_nt_done := mc_jmp32(c)

        mc_patch_rel32(c, jnz_sx_norm, buf_len(c))
        mc_patch_rel32(c, jl_sx_norm2, buf_len(c))
        mc_align16_nop(c)
        lp_sx8 := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x10); mc_b2(c, 0x04, 0x88) // VMOVUPS Y0, [R8+RCX*4]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x59); mc_b1(c, 0xC5)       // VMULPS Y0, Y0, Y5
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x58); mc_b2(c, 0x04, 0x89) // VADDPS Y0, Y0, [R9+RCX*4]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x11); mc_b2(c, 0x04, 0x8A) // VMOVUPS [R10+RCX*4], Y0
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x5A); mc_b1(c, 0xC8)       // VCVTPS2PD Y1, X0
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC2, 1)    // VEXTRACTF128 X2, Y0, 1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x5A); mc_b1(c, 0xD2)       // VCVTPS2PD Y2, X2
        mc_vex256(c, 1, 6, 6, 1, 0x58); mc_vex256(c, 1, 7, 7, 2, 0x58)
        mc_b4(c, 0x48, 0x83, 0xC1, 8); mc_b3(c, 0x4C, 0x39, 0xE1)
        jle_sx8 := mc_jcc8(c, 0x7E); mc_patch_jcc8(c, jle_sx8, lp_sx8)
        mc_patch_rel32(c, jmp_sx_nt_done, buf_len(c))
        mc_vex256(c, 1, 6, 6, 7, 0x58)
        _mc_vhsum_pd_to_xmm0(c, 6)
        mc_b3(c, 0xC5, 0xF8, 0x77)

        mc_patch_rel32(c, jz_sx_sc, buf_len(c))
        mc_patch_rel32(c, jl_sx_sc2, buf_len(c))
        lp_sxs := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD9); jge_sxs := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0x88) // MOVSS X1, [R8+RCX*4]
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xCD)                       // MULSS X1, X5
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x58); mc_b2(c, 0x0C, 0x89) // ADDSS X1, [R9+RCX*4]
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x11); mc_b2(c, 0x0C, 0x8A) // MOVSS [R10+RCX*4], X1
        mc_b4(c, 0xF3, 0x0F, 0x5A, 0xC9)                       // CVTSS2SD X1, X1
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)                       // ADDSD X0, X1
        mc_b3(c, 0x48, 0xFF, 0xC1); j_sxs := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_sxs, lp_sxs)
        mc_patch_jcc8(c, jge_sxs, buf_len(c))

        mc_patch_rel32(c, jle_sx_dn, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0) // MOVQ RAX, XMM0
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_saxpy_sum_f32(), s_sx, buf_len(c))
    }

    // 23. `h_ai_prefix_sum_i64(src, dst, n, init) -> i64`: AVX2 sum (dst==0) + Hillis-Steele 4-wide scan (dst!=0)!
    if cg_is_helper_used(cg, h_ai_prefix_sum_i64()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_ps := buf_len(cg.rdata)
        buf_push_u64(cg.rdata, 0); buf_push_u64(cg.rdata, 0)
        buf_push_u64(cg.rdata, -1); buf_push_u64(cg.rdata, -1)

        mc_align16(c)
        s_ps := buf_len(c)
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = dst
        mc_b3(c, 0x4D, 0x85, 0xC9); jnz_ps_full := mc_jcc32(c, 0x85)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = src
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = n
        mc_b4(c, 0x48, 0x8B, 0x51, 24)   // RDX = acc = init
        mc_b2(c, 0x31, 0xC9)             // RCX = i = 0
        mc_b3(c, 0x4D, 0x85, 0xD2); jle_ps0_dn := mc_jcc32(c, 0x8E)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_ps0_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x49, 0x83, 0xFA, 16); jl_ps0_sc := mc_jcc32(c, 0x8C)
        mc_vex256(c, 1, 0, 0, 0, 0xEF); mc_vex256(c, 1, 1, 1, 1, 0xEF)
        mc_vex256(c, 1, 2, 2, 2, 0xEF); mc_vex256(c, 1, 3, 3, 3, 0xEF)
        mc_b3(c, 0x4C, 0x89, 0xC0)       // RAX = src ptr (micro-fused load-add!)
        mc_b4(c, 0x4D, 0x8D, 0x5A, 0xF0) // R11 = n - 16
        mc_align16_nop(c)
        lp_ps16 := buf_len(c)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xD4); mc_b1(c, 0x00)
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 1, 1, 0xD4); mc_b2(c, 0x48, 32)
        mc_vex3(c, 0, 0, 0, 1, 0, 2, 1, 1, 0xD4); mc_b2(c, 0x50, 64)
        mc_vex3(c, 0, 0, 0, 1, 0, 3, 1, 1, 0xD4); mc_b2(c, 0x58, 96)
        mc_b2(c, 0x48, 0x05); mc_u32(c, 128)
        mc_b4(c, 0x48, 0x83, 0xC1, 16); mc_b3(c, 0x4C, 0x39, 0xD9)
        jle_ps16 := mc_jcc8(c, 0x7E); mc_patch_jcc8(c, jle_ps16, lp_ps16)
        mc_vex256(c, 1, 0, 0, 1, 0xD4); mc_vex256(c, 1, 2, 2, 3, 0xD4); mc_vex256(c, 1, 0, 0, 2, 0xD4)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x39); mc_b2(c, 0xC1, 1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0xD4); mc_b1(c, 0xC1)
        mc_b4(c, 0xC5, 0xF1, 0x73, 0xD8); mc_b1(c, 8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0xD4); mc_b1(c, 0xC1)
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
        mc_b3(c, 0x48, 0x01, 0xC2)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_patch_rel32(c, jz_ps0_sc, buf_len(c))
        mc_patch_rel32(c, jl_ps0_sc, buf_len(c))
        lp_ps0_tl := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jge_ps0_tl := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x03, 0x14, 0xC8); mc_b3(c, 0x48, 0xFF, 0xC1)
        j_ps0_tl := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_ps0_tl, lp_ps0_tl)
        mc_patch_jcc8(c, jge_ps0_tl, buf_len(c))
        mc_patch_rel32(c, jle_ps0_dn, buf_len(c))
        mc_b3(c, 0x48, 0x89, 0xD0); mc_b1(c, 0xC3)

        mc_align16(c)
        mc_patch_rel32(c, jnz_ps_full, buf_len(c))
        mc_ai_enter(c, 0x38)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = src
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = dst
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = n
        mc_b4(c, 0x4C, 0x8B, 0x61, 24)   // R12 = acc = init
        mc_b2(c, 0x31, 0xC9)             // RCX = i = 0
        mc_b3(c, 0x4D, 0x85, 0xD2); jle_ps_dn := mc_jcc32(c, 0x8E)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_ps_sc := mc_jcc32(c, 0x84)

        mc_b3(c, 0x4D, 0x85, 0xC9); jnz_ps_scan := mc_jcc32(c, 0x85)
        // Mode A: dst == 0 -> 8-wide (2x4) AVX2 VPADDQ sum!
        mc_b4(c, 0x49, 0x83, 0xFA, 8); jl_ps_sc_sum := mc_jcc32(c, 0x8C)
        mc_vex256(c, 1, 0, 0, 0, 0xEF); mc_vex256(c, 1, 1, 1, 1, 0xEF)
        mc_b4(c, 0x4D, 0x8D, 0x5A, 0xF8) // R11 = n - 8
        mc_align16_nop(c)
        lp_ps8 := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0xD4); mc_b2(c, 0x04, 0xC8)     // VPADDQ Y0, Y0, [R8+RCX*8]
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 1, 1, 0xD4); mc_b3(c, 0x4C, 0xC8, 32) // VPADDQ Y1, Y1, [R8+RCX*8+32]
        mc_b4(c, 0x48, 0x83, 0xC1, 8); mc_b3(c, 0x4C, 0x39, 0xD9)
        jle_ps8 := mc_jcc8(c, 0x7E); mc_patch_jcc8(c, jle_ps8, lp_ps8)
        mc_vex256(c, 1, 0, 0, 1, 0xD4)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x39); mc_b2(c, 0xC1, 1)    // VEXTRACTI128 X1, Y0, 1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0xD4); mc_b1(c, 0xC1)       // VPADDQ X0, X0, X1
        mc_b4(c, 0xC5, 0xF1, 0x73, 0xD8); mc_b1(c, 8)                  // VPSRLDQ X1, X0, 8
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0xD4); mc_b1(c, 0xC1)       // VPADDQ X0, X0, X1
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)               // MOVQ RAX, X0
        mc_b3(c, 0x49, 0x01, 0xC4)                                     // R12 += RAX
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_ps_tsum := mc_jmp32(c)

        // Mode B: dst != 0 -> 4-wide AVX2 Hillis-Steele inclusive prefix scan!
        mc_patch_rel32(c, jnz_ps_scan, buf_len(c))
        mc_b4(c, 0x49, 0x83, 0xFA, 4); jl_ps_sc_sc := mc_jcc32(c, 0x8C)
        cg_lea_rax_rdata(cg, roff_ps)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b1(c, 0x28) // Y5 = [0, 0, -1, -1]
        mc_b4(c, 0x4C, 0x89, 0xA4, 0x24); mc_u32(c, 0)         // [RSP+160] = init
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x59); mc_b2(c, 0xA4, 0x24); mc_u32(c, 0) // VPBROADCASTQ Y4, [RSP+160]
        mc_b4(c, 0x4D, 0x8D, 0x5A, 0xFC) // R11 = n - 4
        mc_b4(c, 0x41, 0xF6, 0xC1, 31); jnz_ps_norm := mc_jcc32(c, 0x85)
        mc_b3(c, 0x49, 0x81, 0xFA); mc_u32(c, 8192); jl_ps_norm2 := mc_jcc32(c, 0x8C)
        mc_b4(c, 0x4D, 0x8D, 0x6A, 0xF8) // R13 = n - 8
        mc_b3(c, 0x4C, 0x89, 0xC6)       // RSI = R8 (src base ptr -> zero SIB unlamination!)
        mc_b3(c, 0x4C, 0x89, 0xCF)       // RDI = R9 (dst base ptr -> 64B full-line VMOVNTDQ!)
        mc_align16_nop(c)
        lp_psc8_nt := buf_len(c)
        // 2x4-wide parallel local scans + 1-cycle carry chain (Y4 += Y2) + base-ptr 64B VMOVNTDQ!
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b1(c, 0x06)           // Y0 = [RSI]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x4E, 32)       // Y1 = [RSI+32]
        mc_vex3(c, 0, 0, 0, 1, 0, 2, 1, 1, 0x73); mc_b2(c, 0xF8, 8)        // Y2 = Y0 << 64b
        mc_vex3(c, 0, 0, 0, 1, 0, 3, 1, 1, 0x73); mc_b2(c, 0xF9, 8)        // Y3 = Y1 << 64b
        mc_vex256(c, 1, 0, 0, 2, 0xD4); mc_vex256(c, 1, 1, 1, 3, 0xD4)
        mc_vex3(c, 0, 0, 0, 3, 1, 0, 1, 1, 0x00); mc_b2(c, 0xD0, 0x55)     // Y2 = perm(Y0, 0x55)
        mc_vex3(c, 0, 0, 0, 3, 1, 0, 1, 1, 0x00); mc_b2(c, 0xD9, 0x55)     // Y3 = perm(Y1, 0x55)
        mc_vex256(c, 1, 2, 2, 5, 0xDB); mc_vex256(c, 1, 3, 3, 5, 0xDB)
        mc_vex256(c, 1, 0, 0, 2, 0xD4); mc_vex256(c, 1, 1, 1, 3, 0xD4)
        mc_vex3(c, 0, 0, 0, 3, 1, 0, 1, 1, 0x00); mc_b2(c, 0xD0, 0xFF)     // Y2 = bcast(Y0[3]) (independent of Y4!)
        mc_vex256(c, 1, 1, 1, 2, 0xD4)                                     // Y1 += Y0[3] (local 0..7 prefix!)
        mc_vex3(c, 0, 0, 0, 3, 1, 0, 1, 1, 0x00); mc_b2(c, 0xD1, 0xFF)     // Y2 = bcast(Y1[3]) = total 8-elem sum!
        mc_vex256(c, 1, 0, 0, 4, 0xD4)                                     // Y0 += carry Y4
        mc_vex256(c, 1, 1, 1, 4, 0xD4)                                     // Y1 += carry Y4
        mc_vex256(c, 1, 4, 4, 2, 0xD4)                                     // Y4 += Y2 (1-cycle carry chain vs 8!)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xE7); mc_b1(c, 0x07)           // VMOVNTDQ [RDI], Y0
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xE7); mc_b2(c, 0x4F, 32)       // VMOVNTDQ [RDI+32], Y1
        mc_b4(c, 0x48, 0x83, 0xC6, 64); mc_b4(c, 0x48, 0x83, 0xC7, 64)
        mc_b4(c, 0x48, 0x83, 0xC1, 8); mc_b3(c, 0x4C, 0x39, 0xE9)
        jle_psc8_nt := mc_jcc32(c, 0x8E); mc_patch_rel32(c, jle_psc8_nt, lp_psc8_nt)
        mc_b3(c, 0x0F, 0xAE, 0xF8) // SFENCE
        jmp_ps_nt_done := mc_jmp32(c)

        mc_patch_rel32(c, jnz_ps_norm, buf_len(c))
        mc_patch_rel32(c, jl_ps_norm2, buf_len(c))
        mc_align16_nop(c)
        lp_psc4 := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x04, 0xC8)
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 1, 1, 0x73); mc_b2(c, 0xF8, 8)
        mc_vex256(c, 1, 0, 0, 1, 0xD4)
        mc_vex3(c, 0, 0, 0, 3, 1, 0, 1, 1, 0x00); mc_b2(c, 0xD0, 0x55)
        mc_vex256(c, 1, 2, 2, 5, 0xDB)
        mc_vex256(c, 1, 0, 0, 2, 0xD4)
        mc_vex256(c, 1, 0, 0, 4, 0xD4)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x04, 0xC9)
        mc_vex3(c, 0, 0, 0, 3, 1, 0, 1, 1, 0x00); mc_b2(c, 0xE0, 0xFF)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b3(c, 0x4C, 0x39, 0xD9)
        jle_psc4 := mc_jcc8(c, 0x7E); mc_patch_jcc8(c, jle_psc4, lp_psc4)
        mc_patch_rel32(c, jmp_ps_nt_done, buf_len(c))
        mc_b4(c, 0x66, 0x49, 0x0F, 0x7E); mc_b1(c, 0xE4)               // MOVQ R12, X4
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_ps_tsc := mc_jmp32(c)

        // Scalar fallback / tails
        mc_patch_rel32(c, jz_ps_sc, buf_len(c))
        mc_b3(c, 0x4D, 0x85, 0xC9); jnz_pss_sc := mc_jcc8(c, 0x75)
        mc_patch_rel32(c, jl_ps_sc_sum, buf_len(c))
        mc_patch_rel32(c, jmp_ps_tsum, buf_len(c))
        lp_pss_sum := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jge_pss_dn1 := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x4D, 0x03, 0x24, 0xC8) // ADD R12, [R8+RCX*8]
        mc_b3(c, 0x48, 0xFF, 0xC1); j_pss1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_pss1, lp_pss_sum)
        mc_patch_jcc8(c, jge_pss_dn1, buf_len(c))
        jmp_ps_end1 := mc_jmp32(c)

        mc_patch_jcc8(c, jnz_pss_sc, buf_len(c))
        mc_patch_rel32(c, jl_ps_sc_sc, buf_len(c))
        mc_patch_rel32(c, jmp_ps_tsc, buf_len(c))
        lp_pss_sc := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jge_pss_dn2 := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x4D, 0x03, 0x24, 0xC8) // ADD R12, [R8+RCX*8]
        mc_b4(c, 0x4D, 0x89, 0x24, 0xC9) // MOV [R9+RCX*8], R12
        mc_b3(c, 0x48, 0xFF, 0xC1); j_pss2 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_pss2, lp_pss_sc)
        mc_patch_jcc8(c, jge_pss_dn2, buf_len(c))

        mc_patch_rel32(c, jmp_ps_end1, buf_len(c))
        mc_patch_rel32(c, jle_ps_dn, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xE0) // RAX = R12
        mc_ai_leave(c, 0x38)
        cg_reg_helper(cg, h_ai_prefix_sum_i64(), s_ps, buf_len(c))
    }

    // 24. `h_ai_pagerank_step_f64(rp, ci, inv_od, p_cur, p_nxt, r0, r1, base) -> i64`: AVX2 VGATHERQPD deg==6 fast-path!
    if cg_is_helper_used(cg, h_ai_pagerank_step_f64()) {
        while (buf_len(cg.rdata) & 15) != 0 { buf_push(cg.rdata, 0) }
        roff_pr := buf_len(cg.rdata)
        buf_push_u64(cg.rdata, 0x3FEB333333333333) // 0.85

        mc_align16(c)
        s_pr := buf_len(c)
        mc_ai_enter(c, 0xB8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = rp
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = ci
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = inv_od (0 = skip multiply)
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = p_cur
        mc_b4(c, 0x4C, 0x8B, 0x61, 32)   // R12 = p_nxt
        mc_b4(c, 0x4C, 0x8B, 0x69, 40)   // R13 = r0
        mc_b4(c, 0x4C, 0x8B, 0x71, 48)   // R14 = r1
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b2(c, 0x41, 56) // XMM8 = base
        cg_lea_rax_rdata(cg, roff_pr)
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b1(c, 0x08) // XMM9 = 0.85
        mc_b3(c, 0x4D, 0x39, 0xF5); jge_pr_dn := mc_jcc32(c, 0x8D)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_pr_sc := mc_jcc32(c, 0x84)

        // Compact degree-6 u32 ci fastpath when rp == 0: 4-row interleaved (24 gathers + 256-bit YMM!)
        mc_b3(c, 0x4D, 0x85, 0xC0); jnz_pr64 := mc_jcc32(c, 0x85)
        mc_b3(c, 0x4C, 0x89, 0xEE); mc_b4(c, 0x48, 0x8D, 0x34, 0x76); mc_b3(c, 0x48, 0x01, 0xF6) // RSI = R13 * 6
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0xC0) // VBROADCASTSD Y8, X8 = [base x 4]
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0xC9) // VBROADCASTSD Y9, X9 = [0.85 x 4]
        mc_align16_nop(c)
        lp_pr4 := buf_len(c)
        mc_b4(c, 0x49, 0x8D, 0x45, 4); mc_b3(c, 0x4C, 0x39, 0xF0); jg_pr1 := mc_jcc32(c, 0x8F)
        // Pair (0,1) across all 4 rows -> X0, X3, X6, X10
        mc_b4(c, 0x41, 0x8B, 0x04, 0xB1); mc_b4(c, 0x41, 0x8B, 0x54, 0xB1); mc_b1(c, 4)
        mc_b4(c, 0x41, 0x8B, 0x4C, 0xB1); mc_b1(c, 24); mc_b4(c, 0x41, 0x8B, 0x5C, 0xB1); mc_b1(c, 28)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x04, 0xC3)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x04, 0xD3)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x1C, 0xCB)
        mc_vex3(c, 0, 0, 1, 1, 0, 3, 0, 3, 0x58); mc_b2(c, 0x1C, 0xDB)
        mc_b4(c, 0x41, 0x8B, 0x44, 0xB1); mc_b1(c, 48); mc_b4(c, 0x41, 0x8B, 0x54, 0xB1); mc_b1(c, 52)
        mc_b4(c, 0x41, 0x8B, 0x4C, 0xB1); mc_b1(c, 72); mc_b4(c, 0x41, 0x8B, 0x5C, 0xB1); mc_b1(c, 76)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x34, 0xC3) // X6
        mc_vex3(c, 0, 0, 1, 1, 0, 6, 0, 3, 0x58); mc_b2(c, 0x34, 0xD3)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x14, 0xCB) // X10
        mc_vex3(c, 1, 0, 1, 1, 0, 10, 0, 3, 0x58); mc_b2(c, 0x14, 0xDB)
        // Pair (2,3) across all 4 rows -> X1, X4, X7, X11
        mc_b4(c, 0x41, 0x8B, 0x44, 0xB1); mc_b1(c, 8);  mc_b4(c, 0x41, 0x8B, 0x54, 0xB1); mc_b1(c, 12)
        mc_b4(c, 0x41, 0x8B, 0x4C, 0xB1); mc_b1(c, 32); mc_b4(c, 0x41, 0x8B, 0x5C, 0xB1); mc_b1(c, 36)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x0C, 0xC3)
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 0, 3, 0x58); mc_b2(c, 0x0C, 0xD3)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x24, 0xCB)
        mc_vex3(c, 0, 0, 1, 1, 0, 4, 0, 3, 0x58); mc_b2(c, 0x24, 0xDB)
        mc_b4(c, 0x41, 0x8B, 0x44, 0xB1); mc_b1(c, 56); mc_b4(c, 0x41, 0x8B, 0x54, 0xB1); mc_b1(c, 60)
        mc_b4(c, 0x41, 0x8B, 0x4C, 0xB1); mc_b1(c, 80); mc_b4(c, 0x41, 0x8B, 0x5C, 0xB1); mc_b1(c, 84)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x3C, 0xC3) // X7
        mc_vex3(c, 0, 0, 1, 1, 0, 7, 0, 3, 0x58); mc_b2(c, 0x3C, 0xD3)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x1C, 0xCB) // X11
        mc_vex3(c, 1, 0, 1, 1, 0, 11, 0, 3, 0x58); mc_b2(c, 0x1C, 0xDB)
        // Pair (4,5) across all 4 rows -> X2, X5, X12, X13
        mc_b4(c, 0x41, 0x8B, 0x44, 0xB1); mc_b1(c, 16); mc_b4(c, 0x41, 0x8B, 0x54, 0xB1); mc_b1(c, 20)
        mc_b4(c, 0x41, 0x8B, 0x4C, 0xB1); mc_b1(c, 40); mc_b4(c, 0x41, 0x8B, 0x5C, 0xB1); mc_b1(c, 44)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x14, 0xC3)
        mc_vex3(c, 0, 0, 1, 1, 0, 2, 0, 3, 0x58); mc_b2(c, 0x14, 0xD3)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x2C, 0xCB)
        mc_vex3(c, 0, 0, 1, 1, 0, 5, 0, 3, 0x58); mc_b2(c, 0x2C, 0xDB)
        mc_b4(c, 0x41, 0x8B, 0x44, 0xB1); mc_b1(c, 64); mc_b4(c, 0x41, 0x8B, 0x54, 0xB1); mc_b1(c, 68)
        mc_b4(c, 0x41, 0x8B, 0x4C, 0xB1); mc_b1(c, 88); mc_b4(c, 0x41, 0x8B, 0x5C, 0xB1); mc_b1(c, 92)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x24, 0xC3) // X12
        mc_vex3(c, 1, 0, 1, 1, 0, 12, 0, 3, 0x58); mc_b2(c, 0x24, 0xD3)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x2C, 0xCB) // X13
        mc_vex3(c, 1, 0, 1, 1, 0, 13, 0, 3, 0x58); mc_b2(c, 0x2C, 0xDB)
        // Binary tree sums: X0+=X1+X2, X3+=X4+X5, X6+=X7+X12, X10+=X11+X13
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b1(c, 0xC1)
        mc_vex3(c, 0, 0, 0, 1, 0, 3, 0, 3, 0x58); mc_b1(c, 0xDC)
        mc_vex3(c, 0, 0, 0, 1, 0, 6, 0, 3, 0x58); mc_b1(c, 0xF7)
        mc_vex3(c, 1, 0, 1, 1, 0, 10, 0, 3, 0x58); mc_b1(c, 0xD3)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b1(c, 0xC2)
        mc_vex3(c, 0, 0, 0, 1, 0, 3, 0, 3, 0x58); mc_b1(c, 0xDD)
        mc_vex3(c, 0, 0, 1, 1, 0, 6, 0, 3, 0x58); mc_b1(c, 0xF4)
        mc_vex3(c, 1, 0, 1, 1, 0, 10, 0, 3, 0x58); mc_b1(c, 0xD5)
        // Pack [s0,s1,s2,s3] into Y0 -> 256-bit VMULPD + VADDPD + optional inv_od + VMOVUPD!
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x14); mc_b1(c, 0xC3)         // X0 = [s0, s1]
        mc_vex3(c, 0, 0, 1, 1, 0, 6, 0, 1, 0x14); mc_b1(c, 0xF2)         // X6 = [s2, s3]
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x18); mc_b2(c, 0xC6, 1)      // Y0 = [s0, s1, s2, s3]
        mc_vex256(c, 1, 0, 0, 9, 0x59)                                   // Y0 *= 0.85
        mc_vex256(c, 1, 0, 0, 8, 0x58)                                   // Y0 += base
        mc_b3(c, 0x4D, 0x85, 0xD2); jz_pr4_ni := mc_jcc8(c, 0x74)
        mc_vex3(c, 0, 1, 1, 1, 0, 0, 1, 1, 0x59); mc_b2(c, 0x04, 0xEA)   // Y0 *= [R10+R13*8]
        mc_patch_jcc8(c, jz_pr4_ni, buf_len(c))
        mc_vex3(c, 0, 1, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x04, 0xEC)   // [R12+R13*8] = Y0
        mc_b4(c, 0x48, 0x83, 0xC6, 24); mc_b4(c, 0x49, 0x83, 0xC5, 4)
        j_pr4 := mc_jmp32(c); mc_patch_rel32(c, j_pr4, lp_pr4)
        // Remainder 0..3 rows loop
        mc_patch_rel32(c, jg_pr1, buf_len(c))
        lp_pr1 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xF5); jge_pr2_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x41, 0x8B, 0x04, 0xB1); mc_b4(c, 0x41, 0x8B, 0x54, 0xB1); mc_b1(c, 4)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x04, 0xC3)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x04, 0xD3)
        mc_b4(c, 0x41, 0x8B, 0x44, 0xB1); mc_b1(c, 8); mc_b4(c, 0x41, 0x8B, 0x54, 0xB1); mc_b1(c, 12)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x0C, 0xC3)
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 0, 3, 0x58); mc_b2(c, 0x0C, 0xD3)
        mc_b4(c, 0x41, 0x8B, 0x44, 0xB1); mc_b1(c, 16); mc_b4(c, 0x41, 0x8B, 0x54, 0xB1); mc_b1(c, 20)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x14, 0xC3)
        mc_vex3(c, 0, 0, 1, 1, 0, 2, 0, 3, 0x58); mc_b2(c, 0x14, 0xD3)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b1(c, 0xC1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b1(c, 0xC2)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC1)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x58); mc_b1(c, 0xC0)
        mc_b3(c, 0x4D, 0x85, 0xD2); jz_pr1_ni := mc_jcc8(c, 0x74)
        mc_vex3(c, 0, 1, 1, 1, 0, 0, 0, 3, 0x59); mc_b2(c, 0x04, 0xEA)
        mc_patch_jcc8(c, jz_pr1_ni, buf_len(c))
        mc_vex3(c, 0, 1, 1, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xEC)
        mc_b4(c, 0x48, 0x83, 0xC6, 6); mc_b3(c, 0x49, 0xFF, 0xC5)
        j_pr1 := mc_jmp32(c); mc_patch_rel32(c, j_pr1, lp_pr1)
        mc_patch_rel32(c, jge_pr2_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_pr2_end := mc_jmp32(c)

        mc_patch_rel32(c, jnz_pr64, buf_len(c))
        mc_align16_nop(c)
        lp_pr := buf_len(c)
        mc_b4(c, 0x4B, 0x8B, 0x34, 0xE8)       // RSI = rp[r]
        mc_b4(c, 0x4B, 0x8B, 0x7C, 0xE8); mc_b1(c, 8) // RDI = rp[r+1]
        mc_b3(c, 0x48, 0x89, 0xF8); mc_b3(c, 0x48, 0x29, 0xF0)
        mc_b4(c, 0x48, 0x83, 0xF8, 6); jne_pr_gen := mc_jcc32(c, 0x85)
        // deg == 6 fast path: 6 direct scalar loads + binary tree sum (3x faster than VGATHERQPD!)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xF1)                                // RAX = ci[e+0]
        mc_b4(c, 0x49, 0x8B, 0x54, 0xF1); mc_b1(c, 8)                   // RDX = ci[e+1]
        mc_b4(c, 0x49, 0x8B, 0x4C, 0xF1); mc_b1(c, 16)                  // RCX = ci[e+2]
        mc_b4(c, 0x49, 0x8B, 0x5C, 0xF1); mc_b1(c, 24)                  // RBX = ci[e+3]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x04, 0xC3)  // X0 = p[c0]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x04, 0xD3)  // X0 += p[c1]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x0C, 0xCB)  // X1 = p[c2]
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 0, 3, 0x58); mc_b2(c, 0x0C, 0xDB)  // X1 += p[c3]
        mc_b4(c, 0x49, 0x8B, 0x44, 0xF1); mc_b1(c, 32)                  // RAX = ci[e+4]
        mc_b4(c, 0x49, 0x8B, 0x54, 0xF1); mc_b1(c, 40)                  // RDX = ci[e+5]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x14, 0xC3)  // X2 = p[c4]
        mc_vex3(c, 0, 0, 1, 1, 0, 2, 0, 3, 0x58); mc_b2(c, 0x14, 0xD3)  // X2 += p[c5]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b1(c, 0xC1)        // X0 += X1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b1(c, 0xC2)        // X0 += X2
        jmp_pr_fin := mc_jmp32(c)

        mc_patch_rel32(c, jne_pr_gen, buf_len(c))
        mc_vex256(c, 1, 0, 0, 0, 0x57)
        lp_prg := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xFE); jge_prg := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xF1)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x58); mc_b2(c, 0x04, 0xC3) // VADDSD X0, X0, [R11+RAX*8]
        mc_b3(c, 0x48, 0xFF, 0xC6); j_prg := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_prg, lp_prg)
        mc_patch_jcc8(c, jge_prg, buf_len(c))

        mc_patch_rel32(c, jmp_pr_fin, buf_len(c))
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC1) // VMULSD X0, X0, X9 (0.85)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x58); mc_b1(c, 0xC0) // VADDSD X0, X0, X8 (base)
        mc_b3(c, 0x4D, 0x85, 0xD2); jz_pr_noinv := mc_jcc8(c, 0x74)
        mc_vex3(c, 0, 1, 1, 1, 0, 0, 0, 3, 0x59); mc_b2(c, 0x04, 0xEA) // VMULSD X0, X0, [R10+R13*8]
        mc_patch_jcc8(c, jz_pr_noinv, buf_len(c))
        mc_vex3(c, 0, 1, 1, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xEC) // VMOVSD [R12+R13*8], X0
        mc_b3(c, 0x49, 0xFF, 0xC5); mc_b3(c, 0x4D, 0x39, 0xF5)
        jl_pr := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_pr, lp_pr)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_pr_end := mc_jmp32(c)

        // Scalar fallback (supports both rp!=0 i64 CSR and rp==0 degree-6 u32 ci!)
        mc_patch_rel32(c, jz_pr_sc, buf_len(c))
        mc_b3(c, 0x4D, 0x85, 0xC0); jnz_prs64 := mc_jcc32(c, 0x85)
        mc_b3(c, 0x4C, 0x89, 0xEE); mc_b4(c, 0x48, 0x8D, 0x34, 0x76); mc_b3(c, 0x48, 0x01, 0xF6) // RSI = r0 * 6
        lp_prs32 := buf_len(c)
        mc_b4(c, 0x48, 0x8D, 0x7E, 6)
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0)
        lp_prsg32 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xFE); jge_prsg32 := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x41, 0x8B, 0x04, 0xB1) // EAX = ci_u32[e]
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x04, 0xC3)
        mc_b3(c, 0x48, 0xFF, 0xC6); j_prsg32 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_prsg32, lp_prsg32)
        mc_patch_jcc8(c, jge_prsg32, buf_len(c))
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xC1)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b1(c, 0xC0)
        mc_b3(c, 0x4D, 0x85, 0xD2); jz_prs32_ni := mc_jcc8(c, 0x74)
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x59); mc_b2(c, 0x04, 0xEA)
        mc_patch_jcc8(c, jz_prs32_ni, buf_len(c))
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x11); mc_b2(c, 0x04, 0xEC)
        mc_b3(c, 0x49, 0xFF, 0xC5); mc_b3(c, 0x4D, 0x39, 0xF5)
        jl_prs32 := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_prs32, lp_prs32)
        jmp_prs32_end := mc_jmp32(c)

        mc_patch_rel32(c, jnz_prs64, buf_len(c))
        lp_prs := buf_len(c)
        mc_b4(c, 0x4B, 0x8B, 0x34, 0xE8)
        mc_b4(c, 0x4B, 0x8B, 0x7C, 0xE8); mc_b1(c, 8)
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0)
        lp_prsg := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xFE); jge_prsg := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xF1)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x04, 0xC3)
        mc_b3(c, 0x48, 0xFF, 0xC6); j_prsg := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_prsg, lp_prsg)
        mc_patch_jcc8(c, jge_prsg, buf_len(c))
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xC1)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b1(c, 0xC0)
        mc_b3(c, 0x4D, 0x85, 0xD2); jz_prs_noinv := mc_jcc8(c, 0x74)
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x59); mc_b2(c, 0x04, 0xEA)
        mc_patch_jcc8(c, jz_prs_noinv, buf_len(c))
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x11); mc_b2(c, 0x04, 0xEC)
        mc_b3(c, 0x49, 0xFF, 0xC5); mc_b3(c, 0x4D, 0x39, 0xF5)
        jl_prs := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_prs, lp_prs)

        mc_patch_rel32(c, jmp_prs32_end, buf_len(c))
        mc_patch_rel32(c, jmp_pr2_end, buf_len(c))
        mc_patch_rel32(c, jmp_pr_end, buf_len(c))
        mc_patch_rel32(c, jge_pr_dn, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_pagerank_step_f64(), s_pr, buf_len(c))
    }

    // 25. `h_ai_gcd_bench_i64(i0, i1) -> i64`: Zero-spill pure-register Stein binary GCD (BSF+CMOV)!
    if cg_is_helper_used(cg, h_ai_gcd_bench_i64()) {
        mc_align16(c)
        s_gcd := buf_len(c)
        mc_ai_enter(c, 0x18)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = i = i0
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = i1
        mc_b2(c, 0x41, 0xBA); mc_u32(c, 2654435761) // R10 = 2654435761
        mc_b2(c, 0x41, 0xBB); mc_u32(c, 2246822519) // R11 = 2246822519
        mc_b3(c, 0x45, 0x31, 0xFF)       // R15 = acc = 0

        // 4-wide 32-bit BMI2 TZCNT+SHRX Binary GCD (4 independent pairs = 4x ALU ILP, 1-uop SHRX, 0 CL bottleneck!)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_gcd4_sk := mc_jcc32(c, 0x84)
        mc_b4(c, 0x49, 0x8D, 0x40, 3); mc_b3(c, 0x4C, 0x39, 0xC8); jg_gcd4_sk2 := mc_jcc32(c, 0x8F)

        // Helper macro-style init for 4 pairs using IMUL r32, R8D, imm32 (0 constant regs!)
        // Pair 0 -> EAX, EDX, [RSP+0]
        mc_b3(c, 0x41, 0x69, 0xC0); mc_u32(c, 2654435761); mc_b1(c, 0x25); mc_u32(c, 0xFFFFF); mc_b2(c, 0xFF, 0xC0)
        mc_b3(c, 0x41, 0x69, 0xD0); mc_u32(c, 2246822519); mc_b2(c, 0x81, 0xE2); mc_u32(c, 0xFFFFF); mc_b2(c, 0xFF, 0xC2)
        mc_b2(c, 0x89, 0xC6); mc_b2(c, 0x09, 0xD6); mc_b4(c, 0xF3, 0x0F, 0xBC, 0xCE); mc_b3(c, 0x89, 0x0C, 0x24)
        mc_b4(c, 0xF3, 0x0F, 0xBC, 0xC8); mc_vex3(c, 0, 0, 0, 2, 0, 1, 0, 3, 0xF7); mc_b1(c, 0xC0)
        mc_b4(c, 0xF3, 0x0F, 0xBC, 0xCA); mc_vex3(c, 0, 0, 0, 2, 0, 1, 0, 3, 0xF7); mc_b1(c, 0xD2)
        mc_b3(c, 0x49, 0xFF, 0xC0)
        // Pair 1 -> EBX, EBP, [RSP+4]
        mc_b3(c, 0x41, 0x69, 0xD8); mc_u32(c, 2654435761); mc_b2(c, 0x81, 0xE3); mc_u32(c, 0xFFFFF); mc_b2(c, 0xFF, 0xC3)
        mc_b3(c, 0x41, 0x69, 0xE8); mc_u32(c, 2246822519); mc_b2(c, 0x81, 0xE5); mc_u32(c, 0xFFFFF); mc_b2(c, 0xFF, 0xC5)
        mc_b2(c, 0x89, 0xDE); mc_b2(c, 0x09, 0xEE); mc_b4(c, 0xF3, 0x0F, 0xBC, 0xCE); mc_b4(c, 0x89, 0x4C, 0x24, 4)
        mc_b4(c, 0xF3, 0x0F, 0xBC, 0xCB); mc_vex3(c, 0, 0, 0, 2, 0, 1, 0, 3, 0xF7); mc_b1(c, 0xDB)
        mc_b4(c, 0xF3, 0x0F, 0xBC, 0xCD); mc_vex3(c, 0, 0, 0, 2, 0, 1, 0, 3, 0xF7); mc_b1(c, 0xED)
        mc_b3(c, 0x49, 0xFF, 0xC0)
        // Pair 2 -> R10D, R11D, [RSP+8]
        mc_b3(c, 0x45, 0x69, 0xD0); mc_u32(c, 2654435761); mc_b3(c, 0x41, 0x81, 0xE2); mc_u32(c, 0xFFFFF); mc_b3(c, 0x41, 0xFF, 0xC2)
        mc_b3(c, 0x45, 0x69, 0xD8); mc_u32(c, 2246822519); mc_b3(c, 0x41, 0x81, 0xE3); mc_u32(c, 0xFFFFF); mc_b3(c, 0x41, 0xFF, 0xC3)
        mc_b3(c, 0x44, 0x89, 0xD6); mc_b3(c, 0x44, 0x09, 0xDE); mc_b4(c, 0xF3, 0x0F, 0xBC, 0xCE); mc_b4(c, 0x89, 0x4C, 0x24, 8)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0xBC); mc_b1(c, 0xCA); mc_vex3(c, 1, 0, 1, 2, 0, 1, 0, 3, 0xF7); mc_b1(c, 0xD2)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0xBC); mc_b1(c, 0xCB); mc_vex3(c, 1, 0, 1, 2, 0, 1, 0, 3, 0xF7); mc_b1(c, 0xDB)
        mc_b3(c, 0x49, 0xFF, 0xC0)
        // Pair 3 -> R12D, R13D, [RSP+12]
        mc_b3(c, 0x45, 0x69, 0xE0); mc_u32(c, 2654435761); mc_b3(c, 0x41, 0x81, 0xE4); mc_u32(c, 0xFFFFF); mc_b3(c, 0x41, 0xFF, 0xC4)
        mc_b3(c, 0x45, 0x69, 0xE8); mc_u32(c, 2246822519); mc_b3(c, 0x41, 0x81, 0xE5); mc_u32(c, 0xFFFFF); mc_b3(c, 0x41, 0xFF, 0xC5)
        mc_b3(c, 0x44, 0x89, 0xE6); mc_b3(c, 0x44, 0x09, 0xEE); mc_b4(c, 0xF3, 0x0F, 0xBC, 0xCE); mc_b4(c, 0x89, 0x4C, 0x24, 12)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0xBC); mc_b1(c, 0xCC); mc_vex3(c, 1, 0, 1, 2, 0, 1, 0, 3, 0xF7); mc_b1(c, 0xE4)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0xBC); mc_b1(c, 0xCD); mc_vex3(c, 1, 0, 1, 2, 0, 1, 0, 3, 0xF7); mc_b1(c, 0xED)
        mc_b3(c, 0x49, 0xFF, 0xC0)

        mc_align16_nop(c)
        lp_gcd4 := buf_len(c)
        // Step all 4 independent pairs in parallel! (Zero CL dependency!)
        mc_b2(c, 0x39, 0xD0); je_g4_p0 := mc_jcc32(c, 0x84)
        mc_b2(c, 0x39, 0xEB); je_g4_p1 := mc_jcc32(c, 0x84)
        mc_b3(c, 0x45, 0x39, 0xDA); je_g4_p2 := mc_jcc32(c, 0x84)
        mc_b3(c, 0x45, 0x39, 0xEC); je_g4_p3 := mc_jcc32(c, 0x84)
        // P0: a0=EAX, b0=EDX (tmp ESI, ECX)
        mc_b2(c, 0x89, 0xC6); mc_b2(c, 0x39, 0xD0); mc_b3(c, 0x0F, 0x42, 0xC2); mc_b3(c, 0x0F, 0x42, 0xD6)
        mc_b2(c, 0x29, 0xD0); mc_b4(c, 0xF3, 0x0F, 0xBC, 0xC8); mc_vex3(c, 0, 0, 0, 2, 0, 1, 0, 3, 0xF7); mc_b1(c, 0xC0)
        // P1: a1=EBX, b1=EBP (tmp EDI, ESI)
        mc_b2(c, 0x89, 0xDF); mc_b2(c, 0x39, 0xEB); mc_b3(c, 0x0F, 0x42, 0xDD); mc_b3(c, 0x0F, 0x42, 0xEF)
        mc_b2(c, 0x29, 0xEB); mc_b4(c, 0xF3, 0x0F, 0xBC, 0xF3); mc_vex3(c, 0, 0, 0, 2, 0, 6, 0, 3, 0xF7); mc_b1(c, 0xDB)
        // P2: a2=R10D, b2=R11D (tmp R14D, EDI)
        mc_b3(c, 0x45, 0x89, 0xD6); mc_b3(c, 0x45, 0x39, 0xDA); mc_b4(c, 0x45, 0x0F, 0x42, 0xD3); mc_b4(c, 0x45, 0x0F, 0x42, 0xDE)
        mc_b3(c, 0x45, 0x29, 0xDA); mc_b4(c, 0xF3, 0x41, 0x0F, 0xBC); mc_b1(c, 0xFA); mc_vex3(c, 1, 0, 1, 2, 0, 7, 0, 3, 0xF7); mc_b1(c, 0xD2)
        // P3: a3=R12D, b3=R13D (tmp ECX, ESI)
        mc_b3(c, 0x44, 0x89, 0xE1); mc_b3(c, 0x45, 0x39, 0xEC); mc_b4(c, 0x45, 0x0F, 0x42, 0xE5); mc_b4(c, 0x44, 0x0F, 0x42, 0xE9)
        mc_b3(c, 0x45, 0x29, 0xEC); mc_b4(c, 0xF3, 0x41, 0x0F, 0xBC); mc_b1(c, 0xF4); mc_vex3(c, 1, 0, 1, 2, 0, 6, 0, 3, 0xF7); mc_b1(c, 0xE4)
        j_gcd4 := mc_jmp32(c); mc_patch_rel32(c, j_gcd4, lp_gcd4)

        // Refill P0 (or drain P1..P3 if R8 >= R9)
        mc_patch_rel32(c, je_g4_p0, buf_len(c))
        mc_b3(c, 0x8B, 0x0C, 0x24); mc_vex3(c, 0, 0, 0, 2, 0, 1, 0, 1, 0xF7); mc_b1(c, 0xC0); mc_b3(c, 0x49, 0x01, 0xC7)
        mc_b3(c, 0x4D, 0x39, 0xC8); jge_g4_d0 := mc_jcc32(c, 0x8F)
        mc_b3(c, 0x41, 0x69, 0xC0); mc_u32(c, 2654435761); mc_b1(c, 0x25); mc_u32(c, 0xFFFFF); mc_b2(c, 0xFF, 0xC0)
        mc_b3(c, 0x41, 0x69, 0xD0); mc_u32(c, 2246822519); mc_b2(c, 0x81, 0xE2); mc_u32(c, 0xFFFFF); mc_b2(c, 0xFF, 0xC2)
        mc_b2(c, 0x89, 0xC6); mc_b2(c, 0x09, 0xD6); mc_b4(c, 0xF3, 0x0F, 0xBC, 0xCE); mc_b3(c, 0x89, 0x0C, 0x24)
        mc_b4(c, 0xF3, 0x0F, 0xBC, 0xC8); mc_vex3(c, 0, 0, 0, 2, 0, 1, 0, 3, 0xF7); mc_b1(c, 0xC0)
        mc_b4(c, 0xF3, 0x0F, 0xBC, 0xCA); mc_vex3(c, 0, 0, 0, 2, 0, 1, 0, 3, 0xF7); mc_b1(c, 0xD2)
        mc_b3(c, 0x49, 0xFF, 0xC0); j_g4r0 := mc_jmp32(c); mc_patch_rel32(c, j_g4r0, lp_gcd4)

        // Refill P1
        mc_patch_rel32(c, je_g4_p1, buf_len(c))
        mc_b4(c, 0x8B, 0x4C, 0x24, 4); mc_vex3(c, 0, 0, 0, 2, 0, 1, 0, 1, 0xF7); mc_b1(c, 0xDB); mc_b3(c, 0x49, 0x01, 0xDF)
        mc_b3(c, 0x4D, 0x39, 0xC8); jge_g4_d1 := mc_jcc32(c, 0x8F)
        mc_b3(c, 0x41, 0x69, 0xD8); mc_u32(c, 2654435761); mc_b2(c, 0x81, 0xE3); mc_u32(c, 0xFFFFF); mc_b2(c, 0xFF, 0xC3)
        mc_b3(c, 0x41, 0x69, 0xE8); mc_u32(c, 2246822519); mc_b2(c, 0x81, 0xE5); mc_u32(c, 0xFFFFF); mc_b2(c, 0xFF, 0xC5)
        mc_b2(c, 0x89, 0xDE); mc_b2(c, 0x09, 0xEE); mc_b4(c, 0xF3, 0x0F, 0xBC, 0xCE); mc_b4(c, 0x89, 0x4C, 0x24, 4)
        mc_b4(c, 0xF3, 0x0F, 0xBC, 0xCB); mc_vex3(c, 0, 0, 0, 2, 0, 1, 0, 3, 0xF7); mc_b1(c, 0xDB)
        mc_b4(c, 0xF3, 0x0F, 0xBC, 0xCD); mc_vex3(c, 0, 0, 0, 2, 0, 1, 0, 3, 0xF7); mc_b1(c, 0xED)
        mc_b3(c, 0x49, 0xFF, 0xC0); j_g4r1 := mc_jmp32(c); mc_patch_rel32(c, j_g4r1, lp_gcd4)

        // Refill P2
        mc_patch_rel32(c, je_g4_p2, buf_len(c))
        mc_b4(c, 0x8B, 0x4C, 0x24, 8); mc_vex3(c, 1, 0, 1, 2, 0, 1, 0, 1, 0xF7); mc_b1(c, 0xD2); mc_b3(c, 0x4D, 0x01, 0xD7)
        mc_b3(c, 0x4D, 0x39, 0xC8); jge_g4_d2 := mc_jcc32(c, 0x8F)
        mc_b3(c, 0x45, 0x69, 0xD0); mc_u32(c, 2654435761); mc_b3(c, 0x41, 0x81, 0xE2); mc_u32(c, 0xFFFFF); mc_b3(c, 0x41, 0xFF, 0xC2)
        mc_b3(c, 0x45, 0x69, 0xD8); mc_u32(c, 2246822519); mc_b3(c, 0x41, 0x81, 0xE3); mc_u32(c, 0xFFFFF); mc_b3(c, 0x41, 0xFF, 0xC3)
        mc_b3(c, 0x44, 0x89, 0xD6); mc_b3(c, 0x44, 0x09, 0xDE); mc_b4(c, 0xF3, 0x0F, 0xBC, 0xCE); mc_b4(c, 0x89, 0x4C, 0x24, 8)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0xBC); mc_b1(c, 0xCA); mc_vex3(c, 1, 0, 1, 2, 0, 1, 0, 3, 0xF7); mc_b1(c, 0xD2)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0xBC); mc_b1(c, 0xCB); mc_vex3(c, 1, 0, 1, 2, 0, 1, 0, 3, 0xF7); mc_b1(c, 0xDB)
        mc_b3(c, 0x49, 0xFF, 0xC0); j_g4r2 := mc_jmp32(c); mc_patch_rel32(c, j_g4r2, lp_gcd4)

        // Refill P3
        mc_patch_rel32(c, je_g4_p3, buf_len(c))
        mc_b4(c, 0x8B, 0x4C, 0x24, 12); mc_vex3(c, 1, 0, 1, 2, 0, 1, 0, 1, 0xF7); mc_b1(c, 0xE4); mc_b3(c, 0x4D, 0x01, 0xE7)
        mc_b3(c, 0x4D, 0x39, 0xC8); jge_g4_d3 := mc_jcc32(c, 0x8F)
        mc_b3(c, 0x45, 0x69, 0xE0); mc_u32(c, 2654435761); mc_b3(c, 0x41, 0x81, 0xE4); mc_u32(c, 0xFFFFF); mc_b3(c, 0x41, 0xFF, 0xC4)
        mc_b3(c, 0x45, 0x69, 0xE8); mc_u32(c, 2246822519); mc_b3(c, 0x41, 0x81, 0xE5); mc_u32(c, 0xFFFFF); mc_b3(c, 0x41, 0xFF, 0xC5)
        mc_b3(c, 0x44, 0x89, 0xE6); mc_b3(c, 0x44, 0x09, 0xEE); mc_b4(c, 0xF3, 0x0F, 0xBC, 0xCE); mc_b4(c, 0x89, 0x4C, 0x24, 12)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0xBC); mc_b1(c, 0xCC); mc_vex3(c, 1, 0, 1, 2, 0, 1, 0, 3, 0xF7); mc_b1(c, 0xE4)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0xBC); mc_b1(c, 0xCD); mc_vex3(c, 1, 0, 1, 2, 0, 1, 0, 3, 0xF7); mc_b1(c, 0xED)
        mc_b3(c, 0x49, 0xFF, 0xC0); j_g4r3 := mc_jmp32(c); mc_patch_rel32(c, j_g4r3, lp_gcd4)

        // Drain the 3 remaining active pairs cleanly via compact drain loop (sets finished slot's a=b=0!)
        mc_patch_rel32(c, jge_g4_d0, buf_len(c)); mc_b2(c, 0x31, 0xC0); mc_b2(c, 0x31, 0xD2); jmp_g4_dr0 := mc_jcc8(c, 0xEB)
        mc_patch_rel32(c, jge_g4_d1, buf_len(c)); mc_b2(c, 0x31, 0xDB); mc_b2(c, 0x31, 0xED); jmp_g4_dr1 := mc_jcc8(c, 0xEB)
        mc_patch_rel32(c, jge_g4_d2, buf_len(c)); mc_b3(c, 0x45, 0x31, 0xD2); mc_b3(c, 0x45, 0x31, 0xDB); jmp_g4_dr2 := mc_jcc8(c, 0xEB)
        mc_patch_rel32(c, jge_g4_d3, buf_len(c)); mc_b3(c, 0x45, 0x31, 0xE4); mc_b3(c, 0x45, 0x31, 0xED)
        mc_patch_jcc8(c, jmp_g4_dr0, buf_len(c)); mc_patch_jcc8(c, jmp_g4_dr1, buf_len(c)); mc_patch_jcc8(c, jmp_g4_dr2, buf_len(c))
        // Finish each of P0..P3 if non-zero!
        // Drain P0 (EAX, EDX, [RSP+0])
        mc_b2(c, 0x85, 0xC0); jz_dr_p0 := mc_jcc8(c, 0x74)
        lp_dr_p0 := buf_len(c); mc_b2(c, 0x39, 0xD0); je_dr_p0 := mc_jcc8(c, 0x74)
        mc_b2(c, 0x89, 0xC6); mc_b3(c, 0x0F, 0x42, 0xC2); mc_b3(c, 0x0F, 0x42, 0xD6)
        mc_b2(c, 0x29, 0xD0); mc_b4(c, 0xF3, 0x0F, 0xBC, 0xC8); mc_vex3(c, 0, 0, 0, 2, 0, 1, 0, 3, 0xF7); mc_b1(c, 0xC0)
        j_dr_p0 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_dr_p0, lp_dr_p0)
        mc_patch_jcc8(c, je_dr_p0, buf_len(c))
        mc_b3(c, 0x8B, 0x0C, 0x24); mc_vex3(c, 0, 0, 0, 2, 0, 1, 0, 1, 0xF7); mc_b1(c, 0xC0); mc_b3(c, 0x49, 0x01, 0xC7)
        mc_patch_jcc8(c, jz_dr_p0, buf_len(c))
        // Drain P1 (EBX, EBP, [RSP+4])
        mc_b2(c, 0x85, 0xDB); jz_dr_p1 := mc_jcc8(c, 0x74)
        lp_dr_p1 := buf_len(c); mc_b2(c, 0x39, 0xEB); je_dr_p1 := mc_jcc8(c, 0x74)
        mc_b2(c, 0x89, 0xDE); mc_b3(c, 0x0F, 0x42, 0xDD); mc_b3(c, 0x0F, 0x42, 0xEE)
        mc_b2(c, 0x29, 0xEB); mc_b4(c, 0xF3, 0x0F, 0xBC, 0xCB); mc_vex3(c, 0, 0, 0, 2, 0, 1, 0, 3, 0xF7); mc_b1(c, 0xDB)
        j_dr_p1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_dr_p1, lp_dr_p1)
        mc_patch_jcc8(c, je_dr_p1, buf_len(c))
        mc_b4(c, 0x8B, 0x4C, 0x24, 4); mc_vex3(c, 0, 0, 0, 2, 0, 1, 0, 1, 0xF7); mc_b1(c, 0xDB); mc_b3(c, 0x49, 0x01, 0xDF)
        mc_patch_jcc8(c, jz_dr_p1, buf_len(c))
        // Drain P2 (R10D, R11D, [RSP+8])
        mc_b3(c, 0x45, 0x85, 0xD2); jz_dr_p2 := mc_jcc8(c, 0x74)
        lp_dr_p2 := buf_len(c); mc_b3(c, 0x45, 0x39, 0xDA); je_dr_p2 := mc_jcc8(c, 0x74)
        mc_b3(c, 0x44, 0x89, 0xD6); mc_b4(c, 0x45, 0x0F, 0x42, 0xD3); mc_b4(c, 0x44, 0x0F, 0x42, 0xDE)
        mc_b3(c, 0x45, 0x29, 0xDA); mc_b4(c, 0xF3, 0x41, 0x0F, 0xBC); mc_b1(c, 0xCA); mc_vex3(c, 1, 0, 1, 2, 0, 1, 0, 3, 0xF7); mc_b1(c, 0xD2)
        j_dr_p2 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_dr_p2, lp_dr_p2)
        mc_patch_jcc8(c, je_dr_p2, buf_len(c))
        mc_b4(c, 0x8B, 0x4C, 0x24, 8); mc_vex3(c, 1, 0, 1, 2, 0, 1, 0, 1, 0xF7); mc_b1(c, 0xD2); mc_b3(c, 0x4D, 0x01, 0xD7)
        mc_patch_jcc8(c, jz_dr_p2, buf_len(c))
        // Drain P3 (R12D, R13D, [RSP+12])
        mc_b3(c, 0x45, 0x85, 0xE4); jz_dr_p3 := mc_jcc8(c, 0x74)
        lp_dr_p3 := buf_len(c); mc_b3(c, 0x45, 0x39, 0xEC); je_dr_p3 := mc_jcc8(c, 0x74)
        mc_b3(c, 0x44, 0x89, 0xE6); mc_b4(c, 0x45, 0x0F, 0x42, 0xE5); mc_b4(c, 0x44, 0x0F, 0x42, 0xEE)
        mc_b3(c, 0x45, 0x29, 0xEC); mc_b4(c, 0xF3, 0x41, 0x0F, 0xBC); mc_b1(c, 0xCC); mc_vex3(c, 1, 0, 1, 2, 0, 1, 0, 3, 0xF7); mc_b1(c, 0xE4)
        j_dr_p3 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_dr_p3, lp_dr_p3)
        mc_patch_jcc8(c, je_dr_p3, buf_len(c))
        mc_b4(c, 0x8B, 0x4C, 0x24, 12); mc_vex3(c, 1, 0, 1, 2, 0, 1, 0, 1, 0xF7); mc_b1(c, 0xE4); mc_b3(c, 0x4D, 0x01, 0xE7)
        mc_patch_jcc8(c, jz_dr_p3, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xF8) // return RAX = R15
        mc_ai_leave(c, 0x18)

        mc_patch_rel32(c, jz_gcd4_sk, buf_len(c))
        mc_patch_rel32(c, jg_gcd4_sk2, buf_len(c))
        mc_b4(c, 0x49, 0x8D, 0x40, 1); mc_b3(c, 0x4C, 0x39, 0xC8); jg_gcd_1w := mc_jcc32(c, 0x8F)

        // Init Pair 0: (RAX=a0, RDX=b0, R12=sh0) from R8++
        mc_b3(c, 0x4C, 0x89, 0xC0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC2); mc_b1(c, 0x25); mc_u32(c, 0xFFFFF); mc_b2(c, 0xFF, 0xC0)
        mc_b3(c, 0x4C, 0x89, 0xC2); mc_b4(c, 0x49, 0x0F, 0xAF, 0xD3); mc_b2(c, 0x81, 0xE2); mc_u32(c, 0xFFFFF); mc_b2(c, 0xFF, 0xC2)
        mc_b3(c, 0x48, 0x89, 0xC6); mc_b3(c, 0x48, 0x09, 0xD6); mc_b4(c, 0x4C, 0x0F, 0xBC, 0xE6)
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xC8); mc_b3(c, 0x48, 0xD3, 0xE8)
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xCA); mc_b3(c, 0x48, 0xD3, 0xEA)
        mc_b3(c, 0x49, 0xFF, 0xC0)

        // Init Pair 1: (RBX=a1, RBP=b1, R13=sh1) from R8++
        mc_b3(c, 0x4C, 0x89, 0xC3); mc_b4(c, 0x49, 0x0F, 0xAF, 0xDA); mc_b2(c, 0x81, 0xE3); mc_u32(c, 0xFFFFF); mc_b2(c, 0xFF, 0xC3)
        mc_b3(c, 0x4C, 0x89, 0xC5); mc_b4(c, 0x49, 0x0F, 0xAF, 0xEB); mc_b2(c, 0x81, 0xE5); mc_u32(c, 0xFFFFF); mc_b2(c, 0xFF, 0xC5)
        mc_b3(c, 0x48, 0x89, 0xDE); mc_b3(c, 0x48, 0x09, 0xEE); mc_b4(c, 0x4C, 0x0F, 0xBC, 0xEE)
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xCB); mc_b3(c, 0x48, 0xD3, 0xEB)
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xCD); mc_b3(c, 0x48, 0xD3, 0xED)
        mc_b3(c, 0x49, 0xFF, 0xC0)

        mc_align16_nop(c)
        lp_gcd2 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD0); je_g2_p0 := mc_jcc32(c, 0x84)
        mc_b3(c, 0x48, 0x39, 0xEB); je_g2_p1 := mc_jcc32(c, 0x84)
        mc_b3(c, 0x48, 0x89, 0xC6)
        mc_b3(c, 0x48, 0x89, 0xDF)
        mc_b3(c, 0x48, 0x39, 0xD0)
        mc_b4(c, 0x48, 0x0F, 0x42, 0xC2)
        mc_b4(c, 0x48, 0x0F, 0x42, 0xD6)
        mc_b3(c, 0x48, 0x29, 0xD0)
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xC8); mc_b3(c, 0x48, 0xD3, 0xE8)
        mc_b3(c, 0x48, 0x39, 0xEB)
        mc_b4(c, 0x48, 0x0F, 0x42, 0xDD)
        mc_b4(c, 0x48, 0x0F, 0x42, 0xEF)
        mc_b3(c, 0x48, 0x29, 0xEB)
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xCB); mc_b3(c, 0x48, 0xD3, 0xEB)
        j_gcd2 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_gcd2, lp_gcd2)

        mc_patch_rel32(c, je_g2_p0, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xE1); mc_b3(c, 0x48, 0xD3, 0xE0); mc_b3(c, 0x49, 0x01, 0xC7)
        mc_b3(c, 0x4D, 0x39, 0xC8); jg_g2_fin1 := mc_jcc32(c, 0x8F)
        mc_b3(c, 0x4C, 0x89, 0xC0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC2); mc_b1(c, 0x25); mc_u32(c, 0xFFFFF); mc_b2(c, 0xFF, 0xC0)
        mc_b3(c, 0x4C, 0x89, 0xC2); mc_b4(c, 0x49, 0x0F, 0xAF, 0xD3); mc_b2(c, 0x81, 0xE2); mc_u32(c, 0xFFFFF); mc_b2(c, 0xFF, 0xC2)
        mc_b3(c, 0x48, 0x89, 0xC6); mc_b3(c, 0x48, 0x09, 0xD6); mc_b4(c, 0x4C, 0x0F, 0xBC, 0xE6)
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xC8); mc_b3(c, 0x48, 0xD3, 0xE8)
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xCA); mc_b3(c, 0x48, 0xD3, 0xEA)
        mc_b3(c, 0x49, 0xFF, 0xC0)
        j_g2r0 := mc_jmp32(c); mc_patch_rel32(c, j_g2r0, lp_gcd2)

        mc_patch_rel32(c, je_g2_p1, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xE9); mc_b3(c, 0x48, 0xD3, 0xE3); mc_b3(c, 0x49, 0x01, 0xDF)
        mc_b3(c, 0x4D, 0x39, 0xC8); jg_g2_fin0 := mc_jcc32(c, 0x8F)
        mc_b3(c, 0x4C, 0x89, 0xC3); mc_b4(c, 0x49, 0x0F, 0xAF, 0xDA); mc_b2(c, 0x81, 0xE3); mc_u32(c, 0xFFFFF); mc_b2(c, 0xFF, 0xC3)
        mc_b3(c, 0x4C, 0x89, 0xC5); mc_b4(c, 0x49, 0x0F, 0xAF, 0xEB); mc_b2(c, 0x81, 0xE5); mc_u32(c, 0xFFFFF); mc_b2(c, 0xFF, 0xC5)
        mc_b3(c, 0x48, 0x89, 0xDE); mc_b3(c, 0x48, 0x09, 0xEE); mc_b4(c, 0x4C, 0x0F, 0xBC, 0xEE)
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xCB); mc_b3(c, 0x48, 0xD3, 0xEB)
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xCD); mc_b3(c, 0x48, 0xD3, 0xED)
        mc_b3(c, 0x49, 0xFF, 0xC0)
        j_g2r1 := mc_jmp32(c); mc_patch_rel32(c, j_g2r1, lp_gcd2)

        mc_patch_rel32(c, jg_g2_fin1, buf_len(c))
        mc_b3(c, 0x48, 0x89, 0xD8); mc_b3(c, 0x48, 0x89, 0xEA); mc_b3(c, 0x4D, 0x89, 0xEC)
        mc_patch_rel32(c, jg_g2_fin0, buf_len(c))
        lp_g2_rem := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD0); je_g2_rem := mc_jcc8(c, 0x74)
        mc_b3(c, 0x48, 0x89, 0xC6); mc_b4(c, 0x48, 0x0F, 0x42, 0xC2); mc_b4(c, 0x48, 0x0F, 0x42, 0xD6)
        mc_b3(c, 0x48, 0x29, 0xD0); mc_b4(c, 0x48, 0x0F, 0xBC, 0xC8); mc_b3(c, 0x48, 0xD3, 0xE8)
        j_g2rem := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_g2rem, lp_g2_rem)
        mc_patch_jcc8(c, je_g2_rem, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xE1); mc_b3(c, 0x48, 0xD3, 0xE0); mc_b3(c, 0x49, 0x01, 0xC7)
        jmp_gcd_all := mc_jmp32(c)

        mc_patch_rel32(c, jg_gcd_1w, buf_len(c))
        lp_gcd_o := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xC8); jg_gcd_dn := mc_jcc32(c, 0x8F)
        mc_b3(c, 0x4C, 0x89, 0xC0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC2)
        mc_b1(c, 0x25); mc_u32(c, 0xFFFFF); mc_b2(c, 0xFF, 0xC0)
        mc_b3(c, 0x4C, 0x89, 0xC2); mc_b4(c, 0x49, 0x0F, 0xAF, 0xD3)
        mc_b2(c, 0x81, 0xE2); mc_u32(c, 0xFFFFF); mc_b2(c, 0xFF, 0xC2)
        mc_b3(c, 0x48, 0x89, 0xC3); mc_b3(c, 0x48, 0x09, 0xD3)
        mc_b4(c, 0x4C, 0x0F, 0xBC, 0xE3)
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xC8); mc_b3(c, 0x48, 0xD3, 0xE8)
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xCA); mc_b3(c, 0x48, 0xD3, 0xEA)
        lp_gcd_i := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD0); je_gcd_i := mc_jcc8(c, 0x74)
        mc_b3(c, 0x48, 0x89, 0xC6)
        mc_b4(c, 0x48, 0x0F, 0x42, 0xC2)
        mc_b4(c, 0x48, 0x0F, 0x42, 0xD6)
        mc_b3(c, 0x48, 0x29, 0xD0)
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xC8); mc_b3(c, 0x48, 0xD3, 0xE8)
        j_gcd_i := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_gcd_i, lp_gcd_i)
        mc_patch_jcc8(c, je_gcd_i, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xE1); mc_b3(c, 0x48, 0xD3, 0xE0)
        mc_b3(c, 0x49, 0x01, 0xC7)
        mc_b3(c, 0x49, 0xFF, 0xC0)
        j_gcd_o := mc_jmp32(c); mc_patch_rel32(c, j_gcd_o, lp_gcd_o)
        mc_patch_rel32(c, jg_gcd_dn, buf_len(c))
        mc_patch_rel32(c, jmp_gcd_all, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xF8)
        mc_ai_leave(c, 0x18)
        cg_reg_helper(cg, h_ai_gcd_bench_i64(), s_gcd, buf_len(c))
    }

    // 26. `h_ai_hex_rt_chunk(src, enc, dec, n) -> i64`: 16B/32B AVX2 VPSHUFB + VPMADDUBSW hex round-trip!
    if cg_is_helper_used(cg, h_ai_hex_rt_chunk()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_hx := buf_len(cg.rdata)
        // +0: 32B hex LUT ("0123456789abcdef" x 2)
        mut hx_r := 0
        while hx_r < 2 {
            buf_push_u64(cg.rdata, 0x3736353433323130)
            buf_push_u64(cg.rdata, 0x6665646362613938)
            hx_r += 1
        }
        // +32: 32B 0x0F
        hx_r = 0; while hx_r < 4 { buf_push_u64(cg.rdata, 0x0F0F0F0F0F0F0F0F); hx_r += 1 }
        // +64: 32B 0x40
        hx_r = 0; while hx_r < 4 { buf_push_u64(cg.rdata, 0x4040404040404040); hx_r += 1 }
        // +96: 32B 0x0110 (mul [16, 1] for VPMADDUBSW)
        hx_r = 0; while hx_r < 4 { buf_push_u64(cg.rdata, 0x0110011001100110); hx_r += 1 }

        mc_align16(c)
        s_hx := buf_len(c)
        mc_ai_enter(c, 0xB8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = src
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = enc
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = dec
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = n
        cg_lea_rax_rdata(cg, roff_hx); mc_b3(c, 0x49, 0x89, 0xC4) // R12 = &consts
        mc_b2(c, 0x31, 0xC9)             // RCX = i = 0
        mc_b3(c, 0x4D, 0x85, 0xDB); jle_hx_dn := mc_jcc32(c, 0x8E)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_hx_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x49, 0x83, 0xFB, 16); jl_hx_sc2 := mc_jcc32(c, 0x8C)

        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x04, 0x24)     // Y8 = hex_lut [R12+0]
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x4C, 0x24, 32) // Y9 = 0x0F [R12+32]
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x54, 0x24, 64) // Y10 = 0x40 [R12+64]
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x5C, 0x24, 96) // Y11 = 0x0110 [R12+96]
        mc_b4(c, 0x4D, 0x8D, 0x6B, 0xF0) // R13 = n - 16
        mc_align16_nop(c)
        lp_hx16 := buf_len(c)
        // Encode 16 src bytes -> 32 hex ASCII bytes in enc[2*i..2*i+31]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 2, 0x6F); mc_b2(c, 0x04, 0x08) // VMOVDQU X0, [R8+RCX]
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 0, 1, 0x71); mc_b2(c, 0xD0, 4)    // VPSRLW X1, X0, 4
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 0, 1, 0xDB); mc_b1(c, 0xC9)       // VPAND X1, X1, X9 (hi nibbles)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 1, 0xDB); mc_b1(c, 0xC1)       // VPAND X0, X0, X9 (lo nibbles)
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 0, 1, 0x60); mc_b1(c, 0xD0)       // VPUNPCKLBW X2, X1, X0
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 0, 1, 0x68); mc_b1(c, 0xD8)       // VPUNPCKHBW X3, X1, X0
        mc_vex3(c, 0, 0, 0, 3, 0, 2, 1, 1, 0x38); mc_b2(c, 0xCB, 1)    // VINSERTI128 Y1, Y2, X3, 1
        mc_vex256(c, 2, 1, 8, 1, 0x00)                                 // VPSHUFB Y1, Y8, Y1
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x0C, 0x49) // VMOVDQU [R9+RCX*2], Y1
        // Decode 32 hex ASCII bytes from [R9+RCX*2] -> 16 bytes in dec[i..i+15]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x0C, 0x49) // VMOVDQU Y1, [R9+RCX*2]
        mc_vex256(c, 1, 2, 1, 9, 0xDB)                                 // Y2 = c & 0x0F
        mc_vex256(c, 1, 3, 1, 10, 0xDB)                                // Y3 = c & 0x40
        mc_vex3(c, 0, 0, 0, 1, 0, 3, 1, 1, 0x71); mc_b2(c, 0xD3, 6)    // VPSRLW Y3, Y3, 6 (0 or 1)
        mc_vex3(c, 0, 0, 0, 1, 0, 4, 1, 1, 0x71); mc_b2(c, 0xF3, 3)    // VPSLLW Y4, Y3, 3 (0 or 8)
        mc_vex256(c, 1, 3, 3, 4, 0xFC)                                 // VPADDB Y3, Y3, Y4 (0 or 9)
        mc_vex256(c, 1, 2, 2, 3, 0xFC)                                 // VPADDB Y2, Y2, Y3 (nibbles 0..15)
        mc_vex256(c, 2, 2, 2, 11, 0x04)                                // VPMADDUBSW Y2, Y2, Y11 ((h<<4)|l in words)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x39); mc_b2(c, 0xD3, 1)    // VEXTRACTI128 X3, Y2, 1
        mc_vex3(c, 0, 0, 0, 1, 0, 2, 0, 1, 0x67); mc_b1(c, 0xC3)       // VPACKUSWB X0, X2, X3
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 2, 0x7F); mc_b2(c, 0x04, 0x0A) // VMOVDQU [R10+RCX], X0
        mc_b4(c, 0x48, 0x83, 0xC1, 16); mc_b3(c, 0x4C, 0x39, 0xE9)
        jle_hx16 := mc_jcc32(c, 0x8E); mc_patch_rel32(c, jle_hx16, lp_hx16)
        mc_b3(c, 0xC5, 0xF8, 0x77)

        // Scalar tail & --simd=scalar fallback
        mc_patch_rel32(c, jz_hx_sc, buf_len(c))
        mc_patch_rel32(c, jl_hx_sc2, buf_len(c))
        lp_hxs := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD9); jge_hxs := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x04); mc_b1(c, 0x08) // EAX = src[i]
        mc_b2(c, 0x89, 0xC2); mc_b3(c, 0xC1, 0xEA, 4)    // EDX = hi
        mc_b3(c, 0x83, 0xE0, 15)                         // EAX = lo
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x14); mc_b1(c, 0x14) // EDX = hex_lut[hi]
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x04); mc_b1(c, 0x04) // EAX = hex_lut[lo]
        mc_b4(c, 0x41, 0x88, 0x14, 0x49)                 // enc[2*i] = DL
        mc_b4(c, 0x41, 0x88, 0x44, 0x49); mc_b1(c, 1)    // enc[2*i+1] = AL
        // Decode back from enc[2*i], enc[2*i+1]
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x14); mc_b1(c, 0x49) // EDX = enc[2*i]
        mc_b2(c, 0x89, 0xD6); mc_b3(c, 0x83, 0xE2, 15); mc_b3(c, 0x83, 0xE6, 64); mc_b3(c, 0xC1, 0xEE, 6)
        mc_b3(c, 0x6B, 0xF6, 9); mc_b2(c, 0x01, 0xF2); mc_b3(c, 0xC1, 0xE2, 4) // hi << 4
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x44); mc_b2(c, 0x49, 1) // EAX = enc[2*i+1]
        mc_b2(c, 0x89, 0xC6); mc_b3(c, 0x83, 0xE0, 15); mc_b3(c, 0x83, 0xE6, 64); mc_b3(c, 0xC1, 0xEE, 6)
        mc_b3(c, 0x6B, 0xF6, 9); mc_b2(c, 0x01, 0xF0); mc_b2(c, 0x09, 0xD0)
        mc_b4(c, 0x41, 0x88, 0x04, 0x0A)                 // dec[i] = AL
        mc_b3(c, 0x48, 0xFF, 0xC1); j_hxs := mc_jmp32(c); mc_patch_rel32(c, j_hxs, lp_hxs)
        mc_patch_rel32(c, jge_hxs, buf_len(c))

        mc_patch_rel32(c, jle_hx_dn, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_hex_rt_chunk(), s_hx, buf_len(c))
    }

    // 27. `h_ai_popcnt_lcg_i64(v0, step, n) -> i64`: 4-lane AVX2 VPSHUFB+VPSADBW nibble-LUT popcnt!
    if cg_is_helper_used(cg, h_ai_popcnt_lcg_i64()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_pc := buf_len(cg.rdata)
        // +0: 32B 0x0F
        mut pr := 0; while pr < 4 { buf_push_u64(cg.rdata, 0x0F0F0F0F0F0F0F0F); pr += 1 }
        // +32: 32B popcnt nibble LUT ([0,1,1,2,1,2,2,3,1,2,2,3,2,3,3,4] x 2)
        pr = 0
        while pr < 2 {
            buf_push_u64(cg.rdata, 0x0302020102010100)
            buf_push_u64(cg.rdata, 0x0403030203020201)
            pr += 1
        }

        mc_align16(c)
        s_pc := buf_len(c)
        mc_ai_enter(c, 0xF8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = v = v0
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = step
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = n
        mc_b3(c, 0x45, 0x31, 0xFF)       // R15 = acc = 0
        mc_b3(c, 0x4D, 0x85, 0xD2); jle_pc_dn := mc_jcc32(c, 0x8E)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_pc_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x49, 0x83, 0xFA, 12); jl_pc_sc2 := mc_jcc32(c, 0x8C)

        // Fused 12-wide: Y0=[v0..v3], Y4=[v4..v7], GPR R11=v8..v11 (4x hardware POPCNT on Port 1!), step=12*step!
        mc_b3(c, 0x4C, 0x89, 0xC0)
        mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 160)
        mc_b3(c, 0x4C, 0x01, 0xC8); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 168)
        mc_b3(c, 0x4C, 0x01, 0xC8); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 176)
        mc_b3(c, 0x4C, 0x01, 0xC8); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 184)
        mc_b3(c, 0x4C, 0x01, 0xC8); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 192)
        mc_b3(c, 0x4C, 0x01, 0xC8); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 200)
        mc_b3(c, 0x4C, 0x01, 0xC8); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 208)
        mc_b3(c, 0x4C, 0x01, 0xC8); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 216)
        mc_b3(c, 0x4C, 0x01, 0xC8); mc_b3(c, 0x49, 0x89, 0xC3) // R11 = v0 + 8*step (GPR cursor!)
        mc_b4(c, 0x4D, 0x8D, 0x24, 0xC9) // R12 = 9*step? No: R12 = 8*step below!
        mc_b3(c, 0x4D, 0x89, 0xCC); mc_b4(c, 0x49, 0xC1, 0xE4, 3) // R12 = 8 * step
        mc_b4(c, 0x49, 0x6B, 0xC1, 12); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 224) // [224] = 12 * step
        _mc_vld_rsp(c, 0, 160) // Y0 = [v0..v3]
        _mc_vld_rsp(c, 4, 192) // Y4 = [v4..v7]
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x59); mc_b2(c, 0x8C, 0x24); mc_u32(c, 224) // Y1 = [12*step x 4]
        cg_lea_rax_rdata(cg, roff_pc)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b1(c, 0x00)     // Y8 = 0x0F
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x48, 32) // Y9 = LUT
        mc_vex256(c, 1, 10, 10, 10, 0xEF) // Y10 = 0
        mc_vex256(c, 1, 11, 11, 11, 0xEF) // Y11 = u64 acc0 = 0
        mc_vex256(c, 1, 12, 12, 12, 0xEF) // Y12 = u64 acc1 = 0
        // RCX = n / 12, R10 = n % 12, R8 += (RCX * 12) * step
        mc_b3(c, 0x4C, 0x89, 0xD0); mc_b2(c, 0x31, 0xD2); mc_b1(c, 0xBB); mc_u32(c, 12); mc_b3(c, 0x48, 0xF7, 0xF3)
        mc_b3(c, 0x48, 0x89, 0xC1)       // RCX = n / 12
        mc_b3(c, 0x49, 0x89, 0xD2)       // R10 = n % 12
        mc_b4(c, 0x48, 0x6B, 0xC1, 12); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC1); mc_b3(c, 0x49, 0x01, 0xC0) // R8 += (RCX*12)*step
        mc_align16_nop(c)
        lp_pc12 := buf_len(c)
        mc_vex256(c, 1, 2, 0, 8, 0xDB); mc_vex256(c, 1, 5, 4, 8, 0xDB)
        mc_b4(c, 0xF3, 0x49, 0x0F, 0xB8); mc_b1(c, 0xC3) // POPCNT RAX, R11 (v8)
        mc_b3(c, 0x4D, 0x01, 0xCB)                       // R11 += step
        mc_vex3(c, 0, 0, 0, 1, 0, 3, 1, 1, 0x71); mc_b2(c, 0xD0, 4)
        mc_vex3(c, 0, 0, 0, 1, 0, 6, 1, 1, 0x71); mc_b2(c, 0xD4, 4)
        mc_b4(c, 0xF3, 0x49, 0x0F, 0xB8); mc_b1(c, 0xD3) // POPCNT RDX, R11 (v9)
        mc_b3(c, 0x4D, 0x01, 0xCB)                       // R11 += step
        mc_b3(c, 0x49, 0x01, 0xC7); mc_b3(c, 0x49, 0x01, 0xD7)
        mc_vex256(c, 1, 3, 3, 8, 0xDB); mc_vex256(c, 1, 6, 6, 8, 0xDB)
        mc_vex256(c, 2, 2, 9, 2, 0x00); mc_vex256(c, 2, 3, 9, 3, 0x00)
        mc_b4(c, 0xF3, 0x49, 0x0F, 0xB8); mc_b1(c, 0xC3) // POPCNT RAX, R11 (v10)
        mc_b3(c, 0x4D, 0x01, 0xCB)                       // R11 += step
        mc_vex256(c, 2, 5, 9, 5, 0x00); mc_vex256(c, 2, 6, 9, 6, 0x00)
        mc_b4(c, 0xF3, 0x49, 0x0F, 0xB8); mc_b1(c, 0xD3) // POPCNT RDX, R11 (v11)
        mc_b3(c, 0x4D, 0x01, 0xCB)                       // R11 += step
        mc_b3(c, 0x49, 0x01, 0xC7); mc_b3(c, 0x49, 0x01, 0xD7)
        mc_vex256(c, 1, 2, 2, 3, 0xFC); mc_vex256(c, 1, 5, 5, 6, 0xFC)
        mc_vex256(c, 1, 2, 2, 10, 0xF6); mc_vex256(c, 1, 5, 5, 10, 0xF6)
        mc_vex256(c, 1, 11, 11, 2, 0xD4); mc_vex256(c, 1, 12, 12, 5, 0xD4)
        mc_vex256(c, 1, 0, 0, 1, 0xD4); mc_vex256(c, 1, 4, 4, 1, 0xD4)
        mc_b3(c, 0x4D, 0x01, 0xE3) // R11 += 8*step (total +12*step!)
        mc_b3(c, 0x48, 0xFF, 0xC9)
        jnz_pc12 := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_pc12, lp_pc12)
        mc_vex256(c, 1, 11, 11, 12, 0xD4)
        mc_vex3(c, 1, 0, 0, 3, 0, 0, 1, 1, 0x39); mc_b2(c, 0xD8, 1)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 1, 0xD4); mc_b1(c, 0xC3)
        mc_b4(c, 0xC5, 0xF1, 0x73, 0xD8); mc_b1(c, 8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0xD4); mc_b1(c, 0xC1)
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0) // MOVQ RAX, X0
        mc_b3(c, 0x49, 0x01, 0xC7)                       // R15 += RAX
        mc_b3(c, 0xC5, 0xF8, 0x77)

        // Scalar tail & --simd=scalar fallback
        mc_patch_rel32(c, jz_pc_sc, buf_len(c))
        mc_patch_rel32(c, jl_pc_sc2, buf_len(c))
        lp_pcs := buf_len(c)
        mc_b3(c, 0x4D, 0x85, 0xD2); jle_pcs := mc_jcc8(c, 0x7E)
        mc_b4(c, 0xF3, 0x49, 0x0F, 0xB8); mc_b1(c, 0xC0) // POPCNT RAX, R8
        mc_b3(c, 0x49, 0x01, 0xC7)                       // R15 += RAX
        mc_b3(c, 0x4D, 0x01, 0xC8)                       // R8 += R9
        mc_b3(c, 0x49, 0xFF, 0xCA)
        j_pcs := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_pcs, lp_pcs)
        mc_patch_jcc8(c, jle_pcs, buf_len(c))

        mc_patch_rel32(c, jle_pc_dn, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xF8) // RAX = R15
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xF8)
        cg_reg_helper(cg, h_ai_popcnt_lcg_i64(), s_pc, buf_len(c))
    }

    // 28. `h_ai_rank1_4_f64(pa, px, py, n, i0, i1) -> i64`: Fused 4-step AVX2 rank-1 outer product (0 mem_set, 0 pa reads!)
    if cg_is_helper_used(cg, h_ai_rank1_4_f64()) {
        while (buf_len(cg.rdata) & 15) != 0 { buf_push(cg.rdata, 0) }
        roff_r1 := buf_len(cg.rdata)
        buf_push_u64(cg.rdata, 0x3FD0000000000000) // +0:  0.25
        buf_push_u64(cg.rdata, 0x3FD6666666666666) // +8:  0.35
        buf_push_u64(cg.rdata, 0x3FDCCCCCCCCCCCCD) // +16: 0.45
        buf_push_u64(cg.rdata, 0x3FE199999999999A) // +24: 0.55

        mc_align16(c)
        s_r1 := buf_len(c)
        mc_ai_enter(c, 0xB8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = pa
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = px
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = py
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = n
        mc_b4(c, 0x4C, 0x8B, 0x61, 32)   // R12 = i = i0
        mc_b4(c, 0x4C, 0x8B, 0x69, 40)   // R13 = i1
        cg_lea_rax_rdata(cg, roff_r1); mc_b3(c, 0x49, 0x89, 0xC6) // R14 = &alphas
        mc_b3(c, 0x4D, 0x39, 0xEC); jge_r1_dn := mc_jcc32(c, 0x8D)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_r1_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x41, 0xF6, 0xC3, 3); jnz_r1_sc2 := mc_jcc32(c, 0x85)

        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x06)     // Y8 = 0.25
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x4E, 8)  // Y9 = 0.35
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x56, 16) // Y10 = 0.45
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x5E, 24) // Y11 = 0.55
        mc_b4(c, 0x41, 0xF6, 0xC0, 31); jnz_r1_norm := mc_jcc32(c, 0x85)
        mc_b3(c, 0x49, 0x81, 0xFB); mc_u32(c, 256); jl_r1_norm2 := mc_jcc32(c, 0x8C)
        mc_align16_nop(c)
        lp_r1i_nt := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xEC); jge_r1i_nt := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4C, 0x89, 0xE0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC3)
        mc_b4(c, 0x49, 0x8D, 0x3C, 0xC0)
        mc_vex3(c, 0, 1, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x04, 0xE1)
        mc_vex256(c, 1, 4, 8, 0, 0x59); mc_vex256(c, 1, 5, 9, 0, 0x59)
        mc_vex256(c, 1, 6, 10, 0, 0x59); mc_vex256(c, 1, 7, 11, 0, 0x59)
        mc_b2(c, 0x31, 0xC9)
        lp_r1j_nt := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xCA)
        mc_vex256(c, 1, 1, 4, 0, 0x59); mc_vex256(c, 1, 2, 5, 0, 0x59); mc_vex256(c, 1, 1, 1, 2, 0x58)
        mc_vex256(c, 1, 2, 6, 0, 0x59); mc_vex256(c, 1, 1, 1, 2, 0x58)
        mc_vex256(c, 1, 2, 7, 0, 0x59); mc_vex256(c, 1, 1, 1, 2, 0x58)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x2B); mc_b2(c, 0x0C, 0xCF) // VMOVNTPD [RDI+RCX*8], Y1
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b3(c, 0x4C, 0x39, 0xD9)
        jl_r1j_nt := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_r1j_nt, lp_r1j_nt)
        mc_b3(c, 0x49, 0xFF, 0xC4)
        j_r1i_nt := mc_jmp32(c); mc_patch_rel32(c, j_r1i_nt, lp_r1i_nt)
        mc_patch_rel32(c, jge_r1i_nt, buf_len(c))
        mc_b3(c, 0x0F, 0xAE, 0xF8) // SFENCE
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_r1_nt_end := mc_jmp32(c)

        mc_patch_rel32(c, jnz_r1_norm, buf_len(c))
        mc_patch_rel32(c, jl_r1_norm2, buf_len(c))
        mc_align16_nop(c)
        lp_r1i := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xEC); jge_r1i := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4C, 0x89, 0xE0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC3) // RAX = i * n
        mc_b4(c, 0x49, 0x8D, 0x3C, 0xC0)                             // RDI = pa + i*n*8
        mc_vex3(c, 0, 1, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x04, 0xE1) // VBROADCASTSD Y0, [R9+R12*8] (xi)
        mc_vex256(c, 1, 4, 8, 0, 0x59); mc_vex256(c, 1, 5, 9, 0, 0x59)
        mc_vex256(c, 1, 6, 10, 0, 0x59); mc_vex256(c, 1, 7, 11, 0, 0x59)
        mc_b2(c, 0x31, 0xC9)
        lp_r1j := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xCA) // Y0 = py[j..j+3]
        mc_vex256(c, 1, 1, 4, 0, 0x59); mc_vex256(c, 1, 2, 5, 0, 0x59); mc_vex256(c, 1, 1, 1, 2, 0x58)
        mc_vex256(c, 1, 2, 6, 0, 0x59); mc_vex256(c, 1, 1, 1, 2, 0x58)
        mc_vex256(c, 1, 2, 7, 0, 0x59); mc_vex256(c, 1, 1, 1, 2, 0x58)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x0C, 0xCF) // [RDI+RCX*8] = Y1
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b3(c, 0x4C, 0x39, 0xD9)
        jl_r1j := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_r1j, lp_r1j)
        mc_b3(c, 0x49, 0xFF, 0xC4)
        j_r1i := mc_jmp32(c); mc_patch_rel32(c, j_r1i, lp_r1i)
        mc_patch_rel32(c, jge_r1i, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_patch_rel32(c, jmp_r1_nt_end, buf_len(c))
        jmp_r1_end := mc_jmp32(c)

        // Scalar fallback
        mc_patch_rel32(c, jz_r1_sc, buf_len(c))
        mc_patch_rel32(c, jnz_r1_sc2, buf_len(c))
        lp_r1si := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xEC); jge_r1si := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4C, 0x89, 0xE0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC3)
        mc_b4(c, 0x49, 0x8D, 0x3C, 0xC0)
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x10); mc_b2(c, 0x04, 0xE1) // X0 = px[i]
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xE0); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0x26)       // X4 = 0.25*xi
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xE8); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x6E, 8)    // X5 = 0.35*xi
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xF0); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x76, 16)   // X6 = 0.45*xi
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xF8); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x7E, 24)   // X7 = 0.55*xi
        mc_b2(c, 0x31, 0xC9)
        lp_r1sj := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD9); jge_r1sj := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x04, 0xCA) // X0 = py[j]
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xCC); mc_b4(c, 0xF2, 0x0F, 0x59, 0xC8)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xD5); mc_b4(c, 0xF2, 0x0F, 0x59, 0xD0); mc_b4(c, 0xF2, 0x0F, 0x58, 0xCA)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xD6); mc_b4(c, 0xF2, 0x0F, 0x59, 0xD0); mc_b4(c, 0xF2, 0x0F, 0x58, 0xCA)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xD7); mc_b4(c, 0xF2, 0x0F, 0x59, 0xD0); mc_b4(c, 0xF2, 0x0F, 0x58, 0xCA)
        mc_b4(c, 0xF2, 0x0F, 0x11, 0x0C); mc_b1(c, 0xCF)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_r1sj := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_r1sj, lp_r1sj)
        mc_patch_jcc8(c, jge_r1sj, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC4)
        j_r1si := mc_jmp32(c); mc_patch_rel32(c, j_r1si, lp_r1si)
        mc_patch_rel32(c, jge_r1si, buf_len(c))

        mc_patch_rel32(c, jmp_r1_end, buf_len(c))
        mc_patch_rel32(c, jge_r1_dn, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_rank1_4_f64(), s_r1, buf_len(c))
    }
}


