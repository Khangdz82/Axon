        mc_patch_rel32(c, jge_g64_i4, buf_len(c))
        lp_g64_i4 := buf_len(c)
        mc_b4(c, 0x49, 0x8D, 0x45, 0x03)
        mc_b3(c, 0x4C, 0x39, 0xF8)
        jge_g64_i2 := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x48, 0x8B, 0x04, 0x24)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC5)
        mc_b4(c, 0x48, 0x03, 0x44, 0x24); mc_b1(c, 48)
        mc_b4(c, 0x49, 0x8D, 0x3C, 0xC1)               // RDI = A + (i*k+pc)*8
        mc_b4(c, 0x4C, 0x8B, 0x64, 0x24); mc_b1(c, 40) // R12 = a_stride (k*8)
        mc_b4(c, 0x4A, 0x8D, 0x34, 0x27)               // RSI = RDI + R12
        mc_b3(c, 0x49, 0x89, 0xF0); mc_b3(c, 0x4D, 0x01, 0xE0)
        mc_b3(c, 0x4D, 0x89, 0xC6); mc_b3(c, 0x4D, 0x01, 0xE6)
        mc_b4(c, 0x48, 0x8D, 0x94, 0x24); mc_u32(c, 192)
        mc_b4(c, 0x48, 0x8B, 0x44, 0x24); mc_b1(c, 8)
