        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x33); mc_b3(c, 0x64, 0x48, 16) // VPMOVZXWD Y4, [R8+RCX*2+16]
        mc_vex256(c, 1, 2, 3, 0, 0x76); mc_vex256(c, 1, 2, 2, 1, 0xDB); mc_vex256(c, 1, 3, 3, 2, 0xFE)
        mc_vex256(c, 1, 5, 4, 0, 0x76); mc_vex256(c, 1, 5, 5, 1, 0xDB); mc_vex256(c, 1, 4, 4, 5, 0xFE)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x1C, 0x88)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b3(c, 0x64, 0x88, 32)
        mc_b4(c, 0x48, 0x83, 0xE9, 16)
        jge_fw_unpk := mc_jcc8(c, 0x7D); mc_patch_jcc8(c, jge_fw_unpk, lp_fw_unpk)
