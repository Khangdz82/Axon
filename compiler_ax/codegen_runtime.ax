        // 4-row simultaneous x 16 cols/iter AVX2+FMA3 (only when cols % 16 == 0, else 1-row!)
        mc_b4(c, 0x41, 0xF6, 0xC2, 15); jnz_bn1r := mc_jcc32(c, 0x85)
        mc_b4(c, 0x4D, 0x8D, 0x6A, 0xF0)                         // R13 = cols - 16
        mc_align16_nop(c)
        lp_bn4r := buf_len(c)
        mc_b4(c, 0x49, 0x8D, 0x43, 4); mc_b3(c, 0x4C, 0x39, 0xE0); jg_bn1r := mc_jcc32(c, 0x8F)
        mc_b4(c, 0x4A, 0x8D, 0x3C, 0x16)                         // RDI = RSI + cols (row1)
        mc_b4(c, 0x4A, 0x8D, 0x1C, 0x17)                         // RBX = RDI + cols (row2)
        mc_b4(c, 0x4A, 0x8D, 0x14, 0x13)                         // RDX = RBX + cols (row3)
        mc_vex256(c, 1, 0, 0, 0, 0x57); mc_vex256(c, 1, 1, 1, 1, 0x57)
        mc_vex256(c, 1, 2, 2, 2, 0x57); mc_vex256(c, 1, 3, 3, 3, 0x57)
        mc_vex256(c, 1, 4, 4, 4, 0x57); mc_vex256(c, 1, 5, 5, 5, 0x57)
        mc_vex256(c, 1, 10, 10, 10, 0x57); mc_vex256(c, 1, 11, 11, 11, 0x57)
        mc_b2(c, 0x31, 0xC9)                                     // RCX = c = 0
        lp_bn4c := buf_len(c)
        // Load 16 f32 activations ONCE into Y8, Y9 for all 4 rows!
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 0, 0x10); mc_b2(c, 0x04, 0x89)     // VMOVUPS Y8, [R9+RCX*4]
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 0, 0x10); mc_b3(c, 0x4C, 0x89, 32) // VMOVUPS Y9, [R9+RCX*4+32]
        // Row 0 (RSI) -> Y0, Y1
