    if cg_is_helper_used(cg, h_jbuf_ensure()) {
        mc_align16(c)
        s_je := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xC9); cg_jmp_fn(cg, 0x84, h_sec_trap())
