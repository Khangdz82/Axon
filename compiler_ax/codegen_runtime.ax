        mc_patch_rel32(c, jge_fw16k, buf_len(c))

        // Backwards in-place unpack i16 -> i32 (16000 -> 1000000000)
        mc_b1(c, 0xB8); mc_u32(c, 16000)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x6E); mc_b1(c, 0xC0); mc_vex256(c, 2, 0, 0, 0, 0x58) // Y0 = 16000
        mc_b1(c, 0xB8); mc_u32(c, 999984000)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x6E); mc_b1(c, 0xC8); mc_vex256(c, 2, 1, 0, 1, 0x58) // Y1 = 1e9 - 16000
        mc_b4(c, 0x48, 0x8D, 0x4B, 0xF0) // RCX = n*n - 16
        lp_fw_unpk := buf_len(c)
