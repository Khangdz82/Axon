// Axon v7.0 Self-Hosted Compiler - Multi-OS x86_64 Primitives, CPUID Dispatch, GF(2^8) Whitebox & Runtime
// (`compiler_ax/codegen_runtime.ax`) - 100% Pure Axon, Zero CRT, Multi-OS Native ABI:
//   `os_mode == 0`: Win64 PE32+ `.exe` (`KERNEL32.dll` + IOCP + OS Threads)
//   `os_mode == 1`: Win64 PE32+ `--shared` `.dll`/`.pyd` (`DllMain` + C-ABI `.edata`)
//   `os_mode == 2`: Linux x86_64 `ELF64` (Direct `SYSCALL`: `openat`/`read`/`write`/`mmap`/`clock_gettime`)
//   `os_mode == 3`: macOS x86_64 `Mach-O 64` (Direct Darwin `0x2000000+N` `SYSCALL`)
//   `os_mode == 4`: Bare-Metal / Unikernel x86_64 (`Multiboot2` + `COM1 0x3F8` UART + Bump Heap)

use compiler_ax::tokens_ast
use compiler_ax::linker_pe

struct CodegenCtx {
    pool: ByteBuf
    nodes: IntBuf
    extra: IntBuf
    sym: IntBuf
    code: ByteBuf
    rdata: ByteBuf
    fixups: IntBuf
    fn_ranges: IntBuf
    interns: IntBuf
    state: IntBuf
}

// Runtime Helper IDs (`10000001..10000060`, flags in `state[100 + hid - 10000000]`, offsets in `state[170 + hid - 10000000]`)
fn h_id_base() -> i64        { return 10000000 }
fn h_print_bytes() -> i64    { return 10000001 }
fn h_print_i64() -> i64      { return 10000002 }
fn h_print_dec() -> i64      { return 10000003 }
fn h_clock_ns() -> i64       { return 10000004 }
fn h_sec_trap() -> i64       { return 10000005 }
fn h_shield_trap() -> i64    { return 10000006 }
fn h_str_eq() -> i64         { return 10000007 }
fn h_args_get() -> i64       { return 10000008 }
fn h_args_count() -> i64     { return 10000009 }
fn h_fs_read() -> i64        { return 10000010 }
fn h_fs_write() -> i64       { return 10000011 }
fn h_shield_verify() -> i64  { return 10000012 }
fn h_detect_cpuid() -> i64   { return 10000013 }
fn h_nan_trap() -> i64       { return 10000014 }
fn h_par_soa_worker() -> i64 { return 10000015 }
fn h_alloc_mem() -> i64      { return 10000016 }
fn h_free_mem() -> i64       { return 10000017 }
fn h_stdin_read_line() -> i64 { return 10000018 }
fn h_os_exec() -> i64         { return 10000019 }
fn h_buf_new() -> i64         { return 10000020 }
fn h_ibuf_new() -> i64        { return 10000021 }
fn h_buf_get() -> i64         { return 10000022 }
fn h_buf_set() -> i64         { return 10000023 }
fn h_buf_put_u() -> i64       { return 10000024 }
fn h_buf_push1() -> i64       { return 10000025 }
fn h_buf_push_w() -> i64      { return 10000026 }
fn h_buf_push_str() -> i64    { return 10000027 }
fn h_buf_slice_str() -> i64   { return 10000028 }
fn h_ibuf_push() -> i64       { return 10000029 }
fn h_ibuf_get() -> i64        { return 10000030 }
fn h_ibuf_set() -> i64        { return 10000031 }
fn h_str_byte() -> i64        { return 10000032 }
fn h_jbuf_ensure() -> i64     { return 10000033 }
fn h_jbuf_raw() -> i64        { return 10000034 }
fn h_jbuf_i64() -> i64        { return 10000035 }
fn h_jbuf_qstr() -> i64       { return 10000036 }
fn h_str_concat() -> i64      { return 10000037 }
fn h_c_call_v() -> i64        { return 10000038 }
fn h_ai_pool_worker() -> i64  { return 10000039 }
fn h_ai_pool_dispatch() -> i64 { return 10000040 }
fn h_ai_gemv_f32() -> i64     { return 10000041 }
fn h_ai_gemm_f32() -> i64     { return 10000042 }
fn h_ai_gemv_q8_0() -> i64    { return 10000043 }
fn h_ai_gemv_q4_0() -> i64    { return 10000044 }
fn h_ai_gemv_bitnet() -> i64  { return 10000045 }
fn h_ai_gemv_bnn() -> i64     { return 10000046 }
fn h_ai_l2_batch() -> i64     { return 10000047 }
fn h_ai_rmsnorm() -> i64      { return 10000048 }
fn h_ai_swiglu() -> i64       { return 10000049 }
fn h_pow_i64() -> i64         { return 10000050 }
fn h_chkstk() -> i64          { return 10000051 }
fn h_ai_bnn_popcnt() -> i64   { return 10000052 }

// Fixup Kinds
fn fx_iat() -> i64    { return 1 }
fn fx_rdata() -> i64  { return 2 }
fn fx_shield() -> i64 { return 3 }
fn fx_fn() -> i64     { return 4 }
fn fx_data() -> i64   { return 5 }

// `.data` RW Section Offsets (W^X Clean Mutable Globals)
fn data_off_simd_tier() -> i64   { return 0x00 }
fn data_off_cpu_threads() -> i64 { return 0x08 }
fn data_off_unix_rsp() -> i64    { return 0x10 }
fn data_off_arena_ptr() -> i64   { return 0x18 }
fn data_off_arena_off() -> i64   { return 0x20 }
fn data_off_bare_heap() -> i64   { return 0x28 }
fn data_off_ai_pool() -> i64     { return 0x30 }
fn data_off_par_ctx() -> i64     { return 0x40 }

fn mc_b1(code: ByteBuf, b0: i64) {
    buf_push(code, b0 & 255)
}

fn mc_b2(code: ByteBuf, b0: i64, b1: i64) {
    buf_push(code, b0 & 255)
    buf_push(code, b1 & 255)
}

fn mc_b3(code: ByteBuf, b0: i64, b1: i64, b2: i64) {
    buf_push(code, b0 & 255)
    buf_push(code, b1 & 255)
    buf_push(code, b2 & 255)
}

fn mc_b4(code: ByteBuf, b0: i64, b1: i64, b2: i64, b3: i64) {
    buf_push(code, b0 & 255)
    buf_push(code, b1 & 255)
    buf_push(code, b2 & 255)
    buf_push(code, b3 & 255)
}

fn mc_u32(code: ByteBuf, val: i64) {
    buf_push_u32(code, val)
}

fn mc_u64(code: ByteBuf, val: i64) {
    buf_push_u64(code, val)
}

fn mc_align16(code: ByteBuf) {
    while (buf_len(code) & 15) != 0 {
        buf_push(code, 0xCC)
    }
}

fn mc_jcc8(code: ByteBuf, op: i64) -> i64 {
    buf_push(code, op & 255)
    pos := buf_len(code)
    buf_push(code, 0)
    return pos
}

fn mc_patch_jcc8(code: ByteBuf, pos: i64, target: i64) {
    rel := target - (pos + 1)
    buf_set(code, pos, rel & 255)
}

fn mc_jcc32(code: ByteBuf, op2: i64) -> i64 {
    mc_b2(code, 0x0F, op2)
    pos := buf_len(code)
    buf_push_u32(code, 0)
    return pos
}

fn mc_jmp32(code: ByteBuf) -> i64 {
    buf_push(code, 0xE9)
    pos := buf_len(code)
    buf_push_u32(code, 0)
    return pos
}

fn mc_patch_rel32(code: ByteBuf, pos: i64, target: i64) {
    rel := target - (pos + 4)
    buf_put_u32(code, pos, rel)
}

fn mc_slot_disp(slot: i64, sub_off: i64) -> i64 {
    return 0 - ((slot + sub_off) * 8)
}

// Emits 4-byte `[RBP + disp8]` when `-128 <= disp <= 127` and 7-byte `[RBP + disp32]` otherwise.
fn mc_rbp_slot(code: ByteBuf, rex_op_reg: i64, slot: i64, sub_off: i64) {
    rex := (rex_op_reg >> 16) & 255
    op := (rex_op_reg >> 8) & 255
    reg3 := rex_op_reg & 7
    disp := 0 - ((slot + sub_off) * 8)
    if disp >= -128 and disp <= 127 {
        mc_b4(code, rex, op, 0x45 | (reg3 << 3), disp & 255)
    } else {
        mc_b3(code, rex, op, 0x85 | (reg3 << 3))
        mc_u32(code, disp)
    }
}

fn mc_load_rax(code: ByteBuf, slot: i64, sub_off: i64)     { mc_rbp_slot(code, 0x488B00, slot, sub_off) }
fn mc_store_rax(code: ByteBuf, slot: i64, sub_off: i64)    { mc_rbp_slot(code, 0x488900, slot, sub_off) }
fn mc_lea_rax(code: ByteBuf, slot: i64, sub_off: i64)      { mc_rbp_slot(code, 0x488D00, slot, sub_off) }
fn mc_cmp_rax_slot(code: ByteBuf, slot: i64, sub_off: i64) { mc_rbp_slot(code, 0x483B00, slot, sub_off) }
fn mc_load_rcx(code: ByteBuf, slot: i64, sub_off: i64)     { mc_rbp_slot(code, 0x488B01, slot, sub_off) }
fn mc_store_rcx(code: ByteBuf, slot: i64, sub_off: i64)    { mc_rbp_slot(code, 0x488901, slot, sub_off) }
fn mc_load_rdx(code: ByteBuf, slot: i64, sub_off: i64)     { mc_rbp_slot(code, 0x488B02, slot, sub_off) }
fn mc_store_rdx(code: ByteBuf, slot: i64, sub_off: i64)    { mc_rbp_slot(code, 0x488902, slot, sub_off) }
fn mc_load_r8(code: ByteBuf, slot: i64, sub_off: i64)      { mc_rbp_slot(code, 0x4C8B00, slot, sub_off) }
fn mc_store_r8(code: ByteBuf, slot: i64, sub_off: i64)     { mc_rbp_slot(code, 0x4C8900, slot, sub_off) }
fn mc_load_r9(code: ByteBuf, slot: i64, sub_off: i64)      { mc_rbp_slot(code, 0x4C8B01, slot, sub_off) }
fn mc_store_r9(code: ByteBuf, slot: i64, sub_off: i64)     { mc_rbp_slot(code, 0x4C8901, slot, sub_off) }
fn mc_load_r10(code: ByteBuf, slot: i64, sub_off: i64)     { mc_rbp_slot(code, 0x4C8B02, slot, sub_off) }
fn mc_store_r10(code: ByteBuf, slot: i64, sub_off: i64)    { mc_rbp_slot(code, 0x4C8902, slot, sub_off) }
fn mc_load_r11(code: ByteBuf, slot: i64, sub_off: i64)     { mc_rbp_slot(code, 0x4C8B03, slot, sub_off) }
fn mc_store_r11(code: ByteBuf, slot: i64, sub_off: i64)    { mc_rbp_slot(code, 0x4C8903, slot, sub_off) }
fn mc_load_rsi(code: ByteBuf, slot: i64, sub_off: i64)     { mc_rbp_slot(code, 0x488B06, slot, sub_off) }
fn mc_store_rsi(code: ByteBuf, slot: i64, sub_off: i64)    { mc_rbp_slot(code, 0x488906, slot, sub_off) }
fn mc_load_rdi(code: ByteBuf, slot: i64, sub_off: i64)     { mc_rbp_slot(code, 0x488B07, slot, sub_off) }
fn mc_store_rdi(code: ByteBuf, slot: i64, sub_off: i64)    { mc_rbp_slot(code, 0x488907, slot, sub_off) }

fn mc_r8_mem_rax(code: ByteBuf, op: i64, disp: i64) {
    if disp == 0 {
        mc_b3(code, 0x49, op, 0x00)
    } else if disp >= -128 and disp <= 127 {
        mc_b4(code, 0x49, op, 0x40, disp & 255)
    } else {
        mc_b3(code, 0x49, op, 0x80)
        mc_u32(code, disp)
    }
}
fn mc_r8_store_rax(code: ByteBuf, disp: i64) { mc_r8_mem_rax(code, 0x89, disp) }
fn mc_r8_load_rax(code: ByteBuf, disp: i64)  { mc_r8_mem_rax(code, 0x8B, disp) }

fn mc_mov_reg_imm(code: ByteBuf, ridx: i64, val: i64) {
    mut r3 := 1
    mut hi := false
    if ridx == 1 { r3 = 2 }
    else if ridx == 2 { r3 = 0; hi = true }
    else if ridx == 3 { r3 = 1; hi = true }
    else if ridx == 4 { r3 = 2; hi = true }
    else if ridx == 5 { r3 = 3; hi = true }
    if val == 0 {
        modrm := 0xC0 | (r3 << 3) | r3
        if hi { mc_b3(code, 0x45, 0x31, modrm) }
        else  { mc_b2(code, 0x31, modrm) }
    } else if val > 0 and val <= 0x7FFFFFFF {
        if hi { mc_b2(code, 0x41, 0xB8 + r3) }
        else  { mc_b1(code, 0xB8 + r3) }
        mc_u32(code, val)
    } else if val < 0 and val >= -2147483648 {
        mut rex := 0x48
        if hi { rex = 0x49 }
        mc_b3(code, rex, 0xC7, 0xC0 + r3)
        mc_u32(code, val)
    } else {
        mut rex := 0x48
        if hi { rex = 0x49 }
        mc_b2(code, rex, 0xB8 + r3)
        mc_u64(code, val)
    }
}

fn cg_lea_reg_rdata(cg: CodegenCtx, ridx: i64, rdata_off: i64) {
    mut r3 := 1
    mut rex := 0x48
    if ridx == 1 { r3 = 2 }
    else if ridx >= 2 { r3 = ridx - 2; rex = 0x4C }
    mc_b3(cg.code, rex, 0x8D, 0x05 | (r3 << 3))
    dp := buf_len(cg.code)
    buf_push_u32(cg.code, 0)
    nr := buf_len(cg.code)
    cg_add_fixup(cg.fixups, dp, nr, fx_rdata() | (rdata_off << 8))
}

fn cg_unit_slot(cg: CodegenCtx) -> i64 {
    us := ibuf_get(cg.state, 21)
    if us > 0 { return us }
    return cg_alloc_slots(cg, 1)
}

fn mc_mov_rax_imm(code: ByteBuf, val: i64) {
    if val == 0 {
        mc_b2(code, 0x31, 0xC0)
    } else if val > 0 and val <= 0x7FFFFFFF {
        mc_b1(code, 0xB8)
        mc_u32(code, val)
    } else if val < 0 and val >= -2147483648 {
        mc_b3(code, 0x48, 0xC7, 0xC0)
        mc_u32(code, val)
    } else {
        mc_b2(code, 0x48, 0xB8)
        mc_u64(code, val)
    }
}

fn cg_os_mode(cg: CodegenCtx) -> i64 {
    return ibuf_get(cg.state, 16)
}

fn cg_is_win64(cg: CodegenCtx) -> bool {
    return ibuf_get(cg.state, 16) <= 1
}

fn cg_mark_helper_used(cg: CodegenCtx, hid: i64) {
    if hid >= 10000001 and hid <= 10000060 {
        ibuf_set(cg.state, 100 + (hid - 10000000), 1)
    }
}

fn cg_is_helper_used(cg: CodegenCtx, hid: i64) -> bool {
    if hid >= 10000001 and hid <= 10000060 {
        return ibuf_get(cg.state, 100 + (hid - 10000000)) == 1
    }
    return false
}

fn cg_add_fixup(fixups: IntBuf, disp_pos: i64, next_rip: i64, kind_and_tgt: i64) {
    ibuf_push(fixups, disp_pos)
    ibuf_push(fixups, next_rip)
    ibuf_push(fixups, kind_and_tgt & 255)
    ibuf_push(fixups, ushr64(kind_and_tgt, 8))
}

fn cg_call_fn(cg: CodegenCtx, fn_id: i64) {
    cg_mark_helper_used(cg, fn_id)
    buf_push(cg.code, 0xE8)
    dp := buf_len(cg.code)
    buf_push_u32(cg.code, 0)
    nr := buf_len(cg.code)
    cg_add_fixup(cg.fixups, dp, nr, fx_fn() | (fn_id << 8))
}

fn cg_lea_rax_fn(cg: CodegenCtx, fn_id: i64) {
    cg_mark_helper_used(cg, fn_id)
    mc_b3(cg.code, 0x48, 0x8D, 0x05)
    dp := buf_len(cg.code)
    buf_push_u32(cg.code, 0)
    nr := buf_len(cg.code)
    cg_add_fixup(cg.fixups, dp, nr, fx_fn() | (fn_id << 8))
}

fn cg_jmp_fn(cg: CodegenCtx, op2: i64, fn_id: i64) {
    cg_mark_helper_used(cg, fn_id)
    mc_b2(cg.code, 0x0F, op2)
    dp := buf_len(cg.code)
    buf_push_u32(cg.code, 0)
    nr := buf_len(cg.code)
    cg_add_fixup(cg.fixups, dp, nr, fx_fn() | (fn_id << 8))
}

fn cg_call_iat(cg: CodegenCtx, slot: i64) {
    mc_b2(cg.code, 0xFF, 0x15)
    dp := buf_len(cg.code)
    buf_push_u32(cg.code, 0)
    nr := buf_len(cg.code)
    cg_add_fixup(cg.fixups, dp, nr, fx_iat() | (slot << 8))
}

fn cg_lea_rax_rdata(cg: CodegenCtx, rdata_off: i64) {
    mc_b3(cg.code, 0x48, 0x8D, 0x05)
    dp := buf_len(cg.code)
    buf_push_u32(cg.code, 0)
    nr := buf_len(cg.code)
    cg_add_fixup(cg.fixups, dp, nr, fx_rdata() | (rdata_off << 8))
}

fn cg_lea_rax_data(cg: CodegenCtx, data_off: i64) {
    mc_b3(cg.code, 0x48, 0x8D, 0x05)
    dp := buf_len(cg.code)
    buf_push_u32(cg.code, 0)
    nr := buf_len(cg.code)
    cg_add_fixup(cg.fixups, dp, nr, fx_data() | (data_off << 8))
}

fn cg_mov_rax_data(cg: CodegenCtx, data_off: i64) {
    mc_b3(cg.code, 0x48, 0x8B, 0x05)
    dp := buf_len(cg.code)
    buf_push_u32(cg.code, 0)
    nr := buf_len(cg.code)
    cg_add_fixup(cg.fixups, dp, nr, fx_data() | (data_off << 8))
}

fn cg_store_rax_data(cg: CodegenCtx, data_off: i64) {
    mc_b3(cg.code, 0x48, 0x89, 0x05)
    dp := buf_len(cg.code)
    buf_push_u32(cg.code, 0)
    nr := buf_len(cg.code)
    cg_add_fixup(cg.fixups, dp, nr, fx_data() | (data_off << 8))
}

fn cg_reg_helper(cg: CodegenCtx, hid: i64, start_off: i64, end_off: i64) {
    ibuf_set(cg.state, 170 + (hid - 10000000), start_off)
    ibuf_push(cg.fn_ranges, start_off)
    ibuf_push(cg.fn_ranges, end_off)
}

fn cg_emit_exit_imm(cg: CodegenCtx, exit_code: i64) {
    c := cg.code
    osm := cg_os_mode(cg)
    if osm <= 1 {
        mc_b1(c, 0xB9)
        mc_u32(c, exit_code)
        cg_call_iat(cg, iat_exit_process())
        mc_b1(c, 0xCC)
    } else if osm == 2 {
        mc_b1(c, 0xBF) // MOV EDI, exit_code
        mc_u32(c, exit_code)
        mc_b1(c, 0xB8) // MOV EAX, 231 (sys_exit_group)
        mc_u32(c, 231)
        mc_b2(c, 0x0F, 0x05) // SYSCALL
        mc_b1(c, 0xCC)
    } else if osm == 3 {
        mc_b1(c, 0xBF)
        mc_u32(c, exit_code)
        mc_b1(c, 0xB8) // MOV EAX, 0x2000001 (Darwin exit)
        mc_u32(c, 0x2000001)
        mc_b2(c, 0x0F, 0x05)
        mc_b1(c, 0xCC)
    } else {
        mc_b2(c, 0xFA, 0xF4) // CLI; HLT
        mc_b2(c, 0xEB, 0xFD) // JMP -3
    }
}

fn cg_intern_pool_slice(cg: CodegenCtx, soff: i64, slen: i64) -> i64 {
    icnt := ibuf_len(cg.interns) / 4
    mut i := 0
    while i < icnt {
        base := i * 4
        if ibuf_get(cg.interns, base) == 1 and ibuf_get(cg.interns, base + 2) == slen {
            prev_soff := ibuf_get(cg.interns, base + 1)
            if pool_str_eq2(cg.pool, prev_soff, slen, soff) {
                return ibuf_get(cg.interns, base + 3)
            }
        }
        i += 1
    }
    roff := buf_len(cg.rdata)
    mut j := 0
    while j < slen {
        buf_push(cg.rdata, buf_get(cg.pool, soff + j))
        j += 1
    }
    buf_push(cg.rdata, 0)
    ibuf_push(cg.interns, 1)
    ibuf_push(cg.interns, soff)
    ibuf_push(cg.interns, slen)
    ibuf_push(cg.interns, roff)
    return roff
}

fn cg_intern_lit(cg: CodegenCtx, lit: str) -> i64 {
    soff := pool_intern_str(cg.pool, lit)
    return cg_intern_pool_slice(cg, soff, str_len(lit))
}

fn cg_intern_u64_rdata(cg: CodegenCtx, bits: i64, align16: bool) -> i64 {
    mut aflag := 0
    if align16 { aflag = 1 }
    icnt := ibuf_len(cg.interns) / 4
    mut i := 0
    while i < icnt {
        base := i * 4
        if ibuf_get(cg.interns, base) == 5 and ibuf_get(cg.interns, base + 1) == bits and ibuf_get(cg.interns, base + 2) >= aflag {
            return ibuf_get(cg.interns, base + 3)
        }
        i += 1
    }
    mut mask := 7
    if align16 { mask = 15 }
    while (buf_len(cg.rdata) & mask) != 0 {
        buf_push(cg.rdata, 0)
    }
    roff := buf_len(cg.rdata)
    buf_push_u64(cg.rdata, bits)
    if align16 {
        buf_push_u64(cg.rdata, 0)
    }
    ibuf_push(cg.interns, 5)
    ibuf_push(cg.interns, bits)
    ibuf_push(cg.interns, aflag)
    ibuf_push(cg.interns, roff)
    return roff
}

fn rotl64(x: i64, k: i64) -> i64 {
    s := k & 63
    if s == 0 {
        return x
    }
    return (x << s) | ushr64(x, 64 - s)
}

fn gf256_mul_ax(a_in: i64, b_in: i64) -> i64 {
    mut a := a_in & 255
    mut b := b_in & 255
    mut p := 0
    mut i := 0
    while i < 8 {
        if (b & 1) != 0 {
            p = p ^ a
        }
        hi := a & 0x80
        a = (a << 1) & 255
        if hi != 0 {
            a = a ^ 0x1B
        }
        b = b >> 1
        i += 1
    }
    return p & 255
}

fn gf256_inv_ax(x_in: i64) -> i64 {
    x := x_in & 255
    if x == 0 {
        return 0
    }
    mut res := 1
    mut base := x
    mut exp := 254
    while exp > 0 {
        if (exp & 1) != 0 {
            res = gf256_mul_ax(res, base)
        }
        base = gf256_mul_ax(base, base)
        exp = exp >> 1
    }
    return res
}

fn affine_byte_ax(x_in: i64, c_in: i64) -> i64 {
    x := x_in & 255
    r1 := ((x << 1) | (x >> 7)) & 255
    r2 := ((x << 2) | (x >> 6)) & 255
    r3 := ((x << 3) | (x >> 5)) & 255
    r4 := ((x << 4) | (x >> 4)) & 255
    return (x ^ r1 ^ r2 ^ r3 ^ r4 ^ (c_in & 255)) & 255
}

fn cg_intern_whitebox(cg: CodegenCtx, seed_key: i64) -> i64 {
    icnt := ibuf_len(cg.interns) / 4
    mut i := 0
    while i < icnt {
        base := i * 4
        if ibuf_get(cg.interns, base) == 2 and ibuf_get(cg.interns, base + 1) == seed_key {
            return ibuf_get(cg.interns, base + 3)
        }
        i += 1
    }
    while (buf_len(cg.rdata) & 15) != 0 {
        buf_push(cg.rdata, 0)
    }
    roff := buf_len(cg.rdata)
    k0 := seed_key & 255
    k1 := (ushr64(seed_key, 8) & 255) | 1
    mask_out := (ushr64(seed_key, 16) & 255) ^ 0x63
    mut x := 0
    while x < 256 {
        mixed_in := gf256_mul_ax(x ^ k0, k1)
        sub := affine_byte_ax(gf256_inv_ax(mixed_in), mask_out)
        buf_push(cg.rdata, sub)
        buf_push(cg.rdata, sub ^ 0x5A)
        buf_push(cg.rdata, (sub * 37 + x) & 255)
        buf_push(cg.rdata, 0)
        x += 1
    }
    ibuf_push(cg.interns, 2)
    ibuf_push(cg.interns, seed_key)
    ibuf_push(cg.interns, 0)
    ibuf_push(cg.interns, roff)
    return roff
}

fn find_fn_idx_rt(pool: ByteBuf, sym: IntBuf, soff: i64, slen: i64) -> i64 {
    return sym_find_fn_idx(pool, sym, soff, slen)
}

// Emits `_start` (or `DllMain` when `os_mode == 1`) at `.text + 0`.
fn emit_entry_only(cg: CodegenCtx) {
    c := cg.code
    osm := cg_os_mode(cg)
    start_beg := buf_len(c)
    mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA) // ENDBR64

    // DLL entry (`--shared` `.dll` / `.pyd`): `BOOL WINAPI DllMain(HINSTANCE, DWORD fdwReason, LPVOID)`
    if osm == 1 {
        mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x30)
        mc_b3(c, 0x83, 0xFA, 0x01) // CMP EDX, DLL_PROCESS_ATTACH (1)
        jne_ret := mc_jcc8(c, 0x75)
        cg_call_fn(cg, h_detect_cpuid())
        if ibuf_get(cg.state, 0) == 1 {
            cg_call_fn(cg, h_shield_verify())
        }
        mc_patch_jcc8(c, jne_ret, buf_len(c))
        mc_b1(c, 0xB8)
        mc_u32(c, 1) // return TRUE
        mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
        mc_b1(c, 0xC3)
        ibuf_push(cg.fn_ranges, start_beg)
        ibuf_push(cg.fn_ranges, buf_len(c))
        return
    }

    // Linux / macOS `_start`: save initial `RSP` (`[RSP] = argc, [RSP+8] = argv[0]`) BEFORE pushing RBP!
    if osm == 2 or osm == 3 {
        mc_b3(c, 0x48, 0x89, 0xE0) // MOV RAX, RSP
        cg_store_rax_data(cg, data_off_unix_rsp())
        mc_b4(c, 0x48, 0x83, 0xE4, 0xF0) // AND RSP, -16
    }

    mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
    mc_b4(c, 0x48, 0x83, 0xEC, 0x40)

    if osm != 4 {
        cg_call_fn(cg, h_detect_cpuid())
    }
    if ibuf_get(cg.state, 0) == 1 and osm <= 1 {
        cg_call_fn(cg, h_shield_verify())
    }

    main_soff := pool_intern_str(cg.pool, "main")
    main_idx := find_fn_idx_rt(cg.pool, cg.sym, main_soff, 4)
    if main_idx >= 0 {
        f_off := ibuf_get(cg.sym, 7) + main_idx * 10
        if ibuf_get(cg.sym, f_off + 8) == 0 {
            mc_b4(c, 0x48, 0x8D, 0x4D, 0xE0)
            mc_b4(c, 0x48, 0x8D, 0x55, 0xE0)
        }
        cg_call_fn(cg, main_idx)
    } else {
        mc_b2(c, 0x31, 0xC0)
    }

    if osm <= 1 {
        mc_b2(c, 0x89, 0xC1)
        cg_call_iat(cg, iat_exit_process())
        mc_b1(c, 0xCC)
    } else if osm == 2 {
        mc_b2(c, 0x89, 0xC7) // MOV EDI, EAX
        mc_b1(c, 0xB8)
        mc_u32(c, 231) // sys_exit_group
        mc_b2(c, 0x0F, 0x05)
        mc_b1(c, 0xCC)
    } else if osm == 3 {
        mc_b2(c, 0x89, 0xC7)
        mc_b1(c, 0xB8)
        mc_u32(c, 0x2000001)
        mc_b2(c, 0x0F, 0x05)
        mc_b1(c, 0xCC)
    } else {
        mc_b2(c, 0xFA, 0xF4) // CLI; HLT
        mc_b2(c, 0xEB, 0xFD)
    }
    ibuf_push(cg.fn_ranges, start_beg)
    ibuf_push(cg.fn_ranges, buf_len(c))
}

// Emits `h_detect_cpuid` (`3013`), `h_nan_trap` (`3014`), `h_par_soa_worker` (`3015`), `h_alloc_mem` (`3016`), `h_free_mem` (`3017`).
fn emit_v7_core_helpers_used(cg: CodegenCtx) {
    c := cg.code
    osm := cg_os_mode(cg)

    // Propagate helper dependencies so callers don't miss transitive runtime emitters.
    if cg_is_helper_used(cg, h_str_concat()) {
        cg_mark_helper_used(cg, h_buf_new())
        cg_mark_helper_used(cg, h_jbuf_raw())
    }
    if cg_is_helper_used(cg, h_jbuf_raw()) or cg_is_helper_used(cg, h_jbuf_i64()) or cg_is_helper_used(cg, h_jbuf_qstr()) {
        cg_mark_helper_used(cg, h_jbuf_ensure())
    }
    if cg_is_helper_used(cg, h_buf_new()) or cg_is_helper_used(cg, h_ibuf_new()) or cg_is_helper_used(cg, h_jbuf_ensure()) or cg_is_helper_used(cg, h_fs_read()) {
        cg_mark_helper_used(cg, h_alloc_mem())
    }
    if cg_is_helper_used(cg, h_jbuf_ensure()) {
        cg_mark_helper_used(cg, h_free_mem())
    }

    // 0. Compact Shared `ByteBuf` / `IntBuf` / `str` Runtime Helpers (`h_buf_*`, `h_ibuf_*`, `h_str_byte`, `h_jbuf_*`)
    if cg_is_helper_used(cg, h_buf_new()) {
        mc_align16(c)
        s_bn := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xC9); cg_jmp_fn(cg, 0x88, h_sec_trap())
        mc_b3(c, 0x48, 0x81, 0xF9); mc_u32(c, 0x7FFFFFF0)
        cg_jmp_fn(cg, 0x8F, h_sec_trap())
        mc_b3(c, 0x48, 0x81, 0xF9); mc_u32(c, 64)
        mc_b2(c, 0x7D, 0x05)
        mc_b1(c, 0xB9); mc_u32(c, 64)
        mc_b1(c, 0x53)
        mc_b3(c, 0x48, 0x89, 0xCB)
        mc_b4(c, 0x48, 0x8D, 0x4B, 0x40)
        cg_call_fn(cg, h_alloc_mem())
        mc_b3(c, 0x48, 0x85, 0xC0)
        cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b3(c, 0x48, 0xC7, 0x00); mc_u32(c, 0)
        mc_b4(c, 0x48, 0x89, 0x58, 0x08)
        mc_b1(c, 0x5B)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_buf_new(), s_bn, buf_len(c))
    }

    if cg_is_helper_used(cg, h_ibuf_new()) {
        mc_align16(c)
        s_ibn := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xC9); cg_jmp_fn(cg, 0x88, h_sec_trap())
        mc_b3(c, 0x48, 0x81, 0xF9); mc_u32(c, 0x0FFFFFF0)
        cg_jmp_fn(cg, 0x8F, h_sec_trap())
        mc_b3(c, 0x48, 0x81, 0xF9); mc_u32(c, 16)
        mc_b2(c, 0x7D, 0x05)
        mc_b1(c, 0xB9); mc_u32(c, 16)
        mc_b1(c, 0x53)
        mc_b3(c, 0x48, 0x89, 0xCB)
        mc_b4(c, 0x48, 0xC1, 0xE1, 0x03)
        mc_b4(c, 0x48, 0x83, 0xC1, 0x40)
        cg_call_fn(cg, h_alloc_mem())
        mc_b3(c, 0x48, 0x85, 0xC0)
        cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b3(c, 0x48, 0xC7, 0x00); mc_u32(c, 0)
        mc_b4(c, 0x48, 0x89, 0x58, 0x08)
        mc_b1(c, 0x5B)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_ibuf_new(), s_ibn, buf_len(c))
    }

    if cg_is_helper_used(cg, h_buf_get()) {
        mc_align16(c)
        s_bg := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xC9); cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b3(c, 0x48, 0x3B, 0x11); cg_jmp_fn(cg, 0x83, h_sec_trap())
        mc_b4(c, 0x0F, 0xB6, 0x44, 0x11); mc_b1(c, 0x10)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_buf_get(), s_bg, buf_len(c))
    }

    if cg_is_helper_used(cg, h_buf_set()) {
        mc_align16(c)
        s_bs := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xC9); cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b3(c, 0x48, 0x3B, 0x11); cg_jmp_fn(cg, 0x83, h_sec_trap())
        mc_b4(c, 0x44, 0x88, 0x44, 0x11); mc_b1(c, 0x10)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_buf_set(), s_bs, buf_len(c))
    }

    if cg_is_helper_used(cg, h_buf_put_u()) {
        mc_align16(c)
        s_bp := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xC9); cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b3(c, 0x48, 0x85, 0xD2); cg_jmp_fn(cg, 0x88, h_sec_trap())
        mc_b3(c, 0x48, 0x89, 0xD0)
        mc_b3(c, 0x4C, 0x01, 0xC8)
        mc_b3(c, 0x48, 0x3B, 0x01); cg_jmp_fn(cg, 0x87, h_sec_trap())
        mc_b4(c, 0x49, 0x83, 0xF9, 0x04)
        jne_u8 := mc_jcc8(c, 0x75)
        mc_b4(c, 0x44, 0x89, 0x44, 0x11); mc_b1(c, 0x10)
        mc_b1(c, 0xC3)
        mc_patch_jcc8(c, jne_u8, buf_len(c))
        mc_b4(c, 0x4C, 0x89, 0x44, 0x11); mc_b1(c, 0x10)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_buf_put_u(), s_bp, buf_len(c))
    }

    if cg_is_helper_used(cg, h_buf_push1()) {
        mc_align16(c)
        s_bp1 := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xC9); cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b3(c, 0x4C, 0x8B, 0x09)
        mc_b4(c, 0x49, 0x8D, 0x41, 0x01)
        mc_b4(c, 0x48, 0x3B, 0x41, 0x08); cg_jmp_fn(cg, 0x87, h_sec_trap())
        mc_b4(c, 0x42, 0x88, 0x54, 0x09); mc_b1(c, 0x10)
        mc_b3(c, 0x48, 0x89, 0x01)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_buf_push1(), s_bp1, buf_len(c))
    }

    if cg_is_helper_used(cg, h_buf_push_w()) {
        mc_align16(c)
        s_bpw := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xC9); cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b3(c, 0x4C, 0x8B, 0x09)
        mc_b3(c, 0x4C, 0x89, 0xC8)
        mc_b3(c, 0x4C, 0x01, 0xC0)
        mc_b4(c, 0x48, 0x3B, 0x41, 0x08); cg_jmp_fn(cg, 0x87, h_sec_trap())
        mc_b4(c, 0x49, 0x83, 0xF8, 0x02)
        jne_pw2 := mc_jcc8(c, 0x75)
        mc_b4(c, 0x66, 0x42, 0x89, 0x54); mc_b2(c, 0x09, 0x10)
        jd_pw2 := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jne_pw2, buf_len(c))
        mc_b4(c, 0x49, 0x83, 0xF8, 0x04)
        jne_pw4 := mc_jcc8(c, 0x75)
        mc_b4(c, 0x42, 0x89, 0x54, 0x09); mc_b1(c, 0x10)
        jd_pw4 := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jne_pw4, buf_len(c))
        mc_b4(c, 0x4A, 0x89, 0x54, 0x09); mc_b1(c, 0x10)
        mc_patch_jcc8(c, jd_pw2, buf_len(c))
        mc_patch_jcc8(c, jd_pw4, buf_len(c))
        mc_b3(c, 0x48, 0x89, 0x01)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_buf_push_w(), s_bpw, buf_len(c))
    }

    if cg_is_helper_used(cg, h_buf_push_str()) {
        mc_align16(c)
        s_bps := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xC9); cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b3(c, 0x4D, 0x85, 0xC0); cg_jmp_fn(cg, 0x88, h_sec_trap())
        mc_b3(c, 0x4C, 0x8B, 0x09)
        mc_b3(c, 0x4D, 0x89, 0xCA)
        mc_b3(c, 0x4D, 0x01, 0xC2)
        mc_b4(c, 0x4C, 0x3B, 0x51, 0x08); cg_jmp_fn(cg, 0x87, h_sec_trap())
        mc_b3(c, 0x4D, 0x85, 0xC0)
        jz_bps := mc_jcc8(c, 0x74)
        mc_b3(c, 0x48, 0x85, 0xD2); cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b3(c, 0x4C, 0x89, 0x11)
        mc_b3(c, 0x4C, 0x01, 0xC9)
        mc_b2(c, 0x31, 0xC0)
        lp_bps := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xC0)
        jae_bps := mc_jcc8(c, 0x73)
        mc_b4(c, 0x44, 0x8A, 0x1C, 0x02)
        mc_b4(c, 0x44, 0x88, 0x5C, 0x01); mc_b1(c, 0x10)
        mc_b3(c, 0x48, 0xFF, 0xC0)
        jmp_bps := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_bps, lp_bps)
        mc_patch_jcc8(c, jae_bps, buf_len(c))
        mc_patch_jcc8(c, jz_bps, buf_len(c))
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_buf_push_str(), s_bps, buf_len(c))
    }

    if cg_is_helper_used(cg, h_buf_slice_str()) {
        mc_align16(c)
        s_bss := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xC9); cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b3(c, 0x4C, 0x39, 0xC2); cg_jmp_fn(cg, 0x87, h_sec_trap())
        mc_b3(c, 0x4C, 0x3B, 0x01); cg_jmp_fn(cg, 0x87, h_sec_trap())
        mc_b4(c, 0x48, 0x8D, 0x44, 0x11); mc_b1(c, 0x10)
        mc_b3(c, 0x49, 0x29, 0xD0)
        mc_b3(c, 0x4C, 0x89, 0xC2)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_buf_slice_str(), s_bss, buf_len(c))
    }

    if cg_is_helper_used(cg, h_ibuf_push()) {
        mc_align16(c)
        s_ip := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xC9); cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b3(c, 0x4C, 0x8B, 0x09)
        mc_b4(c, 0x4C, 0x3B, 0x49, 0x08); cg_jmp_fn(cg, 0x83, h_sec_trap())
        mc_b4(c, 0x4A, 0x89, 0x54, 0xC9); mc_b1(c, 0x10)
        mc_b3(c, 0x48, 0xFF, 0x01)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_ibuf_push(), s_ip, buf_len(c))
    }

    if cg_is_helper_used(cg, h_ibuf_get()) {
        mc_align16(c)
        s_ig := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xC9); cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b3(c, 0x48, 0x3B, 0x11); cg_jmp_fn(cg, 0x83, h_sec_trap())
        mc_b4(c, 0x48, 0x8B, 0x44, 0xD1); mc_b1(c, 0x10)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_ibuf_get(), s_ig, buf_len(c))
    }

    if cg_is_helper_used(cg, h_ibuf_set()) {
        mc_align16(c)
        s_is := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xC9); cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b3(c, 0x48, 0x3B, 0x11); cg_jmp_fn(cg, 0x83, h_sec_trap())
        mc_b4(c, 0x4C, 0x89, 0x44, 0xD1); mc_b1(c, 0x10)
        mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_ibuf_set(), s_is, buf_len(c))
    }

    if cg_is_helper_used(cg, h_str_byte()) {
        mc_align16(c)
        s_sb := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xC9); cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b3(c, 0x49, 0x39, 0xD0); cg_jmp_fn(cg, 0x83, h_sec_trap())
        mc_b4(c, 0x42, 0x0F, 0xB6, 0x04); mc_b1(c, 0x01)
        mc_b1(c, 0xC3)
