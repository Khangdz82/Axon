        mc_patch_rel32(c, jge_fwr0_sk, buf_len(c))
        mc_b2(c, 0x81, 0xFA); mc_u32(c, 1000000000); jge_fwr1_sk := mc_jcc32(c, 0x8D)
        mc_vex3(c, 0, 1, 1, 2, 0, 0, 1, 1, 0x58); mc_b2(c, 0x04, 0x9F)
        mc_b2(c, 0x31, 0xC9)
        lp_fwr1 := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x0C, 0x8C)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x54, 0x8C, 32)
