        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b1(c, 0x30) // YMM6 = [1i32; 8]
        mc_vex256(c, 1, 14, 14, 14, 0x57)                        // XMM14 = total_f64 = 0.0
        // RSI = pw + r0 * cols
