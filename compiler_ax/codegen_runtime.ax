        mc_vex3(c, 0, 0, 1, 2, 1, 10, 1, 1, 0xB8); mc_b1(c, 0xED)
        mc_vex3(c, 0, 0, 1, 2, 1, 11, 1, 1, 0xB8); mc_b1(c, 0xF4)
        mc_vex3(c, 0, 0, 1, 2, 1, 11, 1, 1, 0xB8); mc_b1(c, 0xFD)
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x47, 8) // VBROADCASTSD Y8, [RDI+8]
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x4E, 8) // VBROADCASTSD Y9, [RSI+8]
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x50, 8) // VBROADCASTSD Y10, [R8+8]
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x5E, 8) // VBROADCASTSD Y11, [R14+8]
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x62, 64)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x6A, 96)
        mc_vex3(c, 0, 0, 1, 2, 1, 8,  1, 1, 0xB8); mc_b1(c, 0xC4)
        mc_vex3(c, 0, 0, 1, 2, 1, 8,  1, 1, 0xB8); mc_b1(c, 0xCD)
        mc_vex3(c, 0, 0, 1, 2, 1, 9,  1, 1, 0xB8); mc_b1(c, 0xD4)
        mc_vex3(c, 0, 0, 1, 2, 1, 9,  1, 1, 0xB8); mc_b1(c, 0xDD)
        mc_vex3(c, 0, 0, 1, 2, 1, 10, 1, 1, 0xB8); mc_b1(c, 0xE4)
        mc_vex3(c, 0, 0, 1, 2, 1, 10, 1, 1, 0xB8); mc_b1(c, 0xED)
        mc_vex3(c, 0, 0, 1, 2, 1, 11, 1, 1, 0xB8); mc_b1(c, 0xF4)
        mc_vex3(c, 0, 0, 1, 2, 1, 11, 1, 1, 0xB8); mc_b1(c, 0xFD)
        mc_b4(c, 0x48, 0x83, 0xC7, 0x10)
        mc_b4(c, 0x48, 0x83, 0xC6, 0x10)
        mc_b4(c, 0x49, 0x83, 0xC0, 0x10)
        mc_b4(c, 0x49, 0x83, 0xC6, 0x10)
        mc_b3(c, 0x48, 0x81, 0xC2); mc_u32(c, 128)
        mc_b4(c, 0x48, 0x83, 0xEB, 2)
        mc_b4(c, 0x48, 0x83, 0xFB, 2)
        jge_p64_4_u2 := mc_jcc32(c, 0x8D); mc_patch_rel32(c, jge_p64_4_u2, lp_p64_4_u2)
        mc_patch_jcc8(c, jl_p64_4_1, buf_len(c))
        mc_b3(c, 0x48, 0x85, 0xDB)
        jle_p64_4e := mc_jcc8(c, 0x7E)
        lp_p64_4 := buf_len(c)
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x07) // VBROADCASTSD YMM8,  [RDI]
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x0E) // VBROADCASTSD YMM9,  [RSI]
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x10) // VBROADCASTSD YMM10, [R8]
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x1E) // VBROADCASTSD YMM11, [R14]
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x22) // VMOVUPD YMM12, [RDX]
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x6A, 32) // VMOVUPD YMM13, [RDX+32]
        mc_vex3(c, 0, 0, 1, 2, 1, 8,  1, 1, 0xB8); mc_b1(c, 0xC4) // VFMADD231PD YMM0, YMM8,  YMM12
        mc_vex3(c, 0, 0, 1, 2, 1, 8,  1, 1, 0xB8); mc_b1(c, 0xCD) // VFMADD231PD YMM1, YMM8,  YMM13
        mc_vex3(c, 0, 0, 1, 2, 1, 9,  1, 1, 0xB8); mc_b1(c, 0xD4)
        mc_vex3(c, 0, 0, 1, 2, 1, 9,  1, 1, 0xB8); mc_b1(c, 0xDD)
        mc_vex3(c, 0, 0, 1, 2, 1, 10, 1, 1, 0xB8); mc_b1(c, 0xE4)
        mc_vex3(c, 0, 0, 1, 2, 1, 10, 1, 1, 0xB8); mc_b1(c, 0xED)
        mc_vex3(c, 0, 0, 1, 2, 1, 11, 1, 1, 0xB8); mc_b1(c, 0xF4)
        mc_vex3(c, 0, 0, 1, 2, 1, 11, 1, 1, 0xB8); mc_b1(c, 0xFD)
        mc_b4(c, 0x48, 0x83, 0xC7, 0x08)
        mc_b4(c, 0x48, 0x83, 0xC6, 0x08)
        mc_b4(c, 0x49, 0x83, 0xC0, 0x08)
        mc_b4(c, 0x49, 0x83, 0xC6, 0x08)
        mc_b4(c, 0x48, 0x83, 0xC2, 0x40)
        mc_b3(c, 0x48, 0xFF, 0xCB)
        jnz_p64_4 := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_p64_4, lp_p64_4)
        mc_patch_jcc8(c, jle_p64_4e, buf_len(c))
        mc_vex2(c, 0, 1, 1, 0x11, 0x01); mc_vex2(c, 0, 1, 1, 0x11, 0x49); mc_b1(c, 0x20)
        mc_b3(c, 0x4C, 0x01, 0xE1)
        mc_vex2(c, 0, 1, 1, 0x11, 0x11); mc_vex2(c, 0, 1, 1, 0x11, 0x59); mc_b1(c, 0x20)
        mc_b3(c, 0x4C, 0x01, 0xE1)
        mc_vex2(c, 0, 1, 1, 0x11, 0x21); mc_vex2(c, 0, 1, 1, 0x11, 0x69); mc_b1(c, 0x20)
        mc_b3(c, 0x4C, 0x01, 0xE1)
        mc_vex2(c, 0, 1, 1, 0x11, 0x31); mc_vex2(c, 0, 1, 1, 0x11, 0x79); mc_b1(c, 0x20)
        mc_b4(c, 0x49, 0x83, 0xC5, 0x04)
        jmp_g64_i4 := mc_jmp32(c); mc_patch_rel32(c, jmp_g64_i4, lp_g64_i4)

        // Pair i = .. r1-2
        mc_patch_rel32(c, jge_g64_i2, buf_len(c))
        lp_g64_i2 := buf_len(c)
        mc_b4(c, 0x49, 0x8D, 0x45, 0x01)
        mc_b3(c, 0x4C, 0x39, 0xF8)
        jge_g64_i1 := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x48, 0x8B, 0x1C, 0x24)
        mc_b3(c, 0x4C, 0x89, 0xE8); mc_b4(c, 0x48, 0x0F, 0xAF, 0xC3)
        mc_b4(c, 0x48, 0x03, 0x44, 0x24); mc_b1(c, 48)
        mc_b4(c, 0x49, 0x8D, 0x3C, 0xC1)
        mc_b4(c, 0x48, 0x8D, 0x34, 0xDF) // RSI = RDI + k*8
        mc_b4(c, 0x48, 0x8D, 0x94, 0x24); mc_u32(c, 192)
        mc_b4(c, 0x48, 0x8B, 0x44, 0x24); mc_b1(c, 8)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC5)
        mc_b3(c, 0x4C, 0x01, 0xD0)
        mc_b4(c, 0x49, 0x8D, 0x0C, 0xC3)
        mc_b4(c, 0x4C, 0x8B, 0x64, 0x24); mc_b1(c, 24)
        mc_b4(c, 0x48, 0x83, 0x7C, 0x24); mc_b2(c, 48, 0)
        jne_ld64_c2 := mc_jcc8(c, 0x75)
        mc_vex2(c, 0, 1, 1, 0x57, 0xC0); mc_vex2(c, 1, 1, 1, 0x57, 0xC9)
        mc_vex2(c, 2, 1, 1, 0x57, 0xD2); mc_vex2(c, 3, 1, 1, 0x57, 0xDB)
        jmp_c64_2rdy := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jne_ld64_c2, buf_len(c))
        mc_vex2(c, 0, 1, 1, 0x10, 0x01); mc_vex2(c, 0, 1, 1, 0x10, 0x49); mc_b1(c, 0x20)
        mc_b4(c, 0x4A, 0x8D, 0x04, 0x21)
        mc_vex2(c, 0, 1, 1, 0x10, 0x10); mc_vex2(c, 0, 1, 1, 0x10, 0x58); mc_b1(c, 0x20)
        mc_patch_jcc8(c, jmp_c64_2rdy, buf_len(c))
        mc_b4(c, 0x48, 0x8B, 0x5C, 0x24); mc_b1(c, 56)
        mc_b3(c, 0x48, 0x85, 0xDB)
        jle_p64_2e := mc_jcc8(c, 0x7E)
        lp_p64_2 := buf_len(c)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x27)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x2E)
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b1(c, 0x02)
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b2(c, 0x4A, 0x20)
        mc_vex3(c, 0, 0, 0, 2, 1, 5, 1, 1, 0xB8); mc_b1(c, 0x12)
        mc_vex3(c, 0, 0, 0, 2, 1, 5, 1, 1, 0xB8); mc_b2(c, 0x5A, 0x20)
        mc_b4(c, 0x48, 0x83, 0xC7, 0x08); mc_b4(c, 0x48, 0x83, 0xC6, 0x08)
        mc_b4(c, 0x48, 0x83, 0xC2, 0x40); mc_b3(c, 0x48, 0xFF, 0xCB)
        jnz_p64_2 := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_p64_2, lp_p64_2)
        mc_patch_jcc8(c, jle_p64_2e, buf_len(c))
        mc_vex2(c, 0, 1, 1, 0x11, 0x01); mc_vex2(c, 0, 1, 1, 0x11, 0x49); mc_b1(c, 0x20)
        mc_b4(c, 0x4A, 0x8D, 0x34, 0x21)
        mc_vex2(c, 0, 1, 1, 0x11, 0x16); mc_vex2(c, 0, 1, 1, 0x11, 0x5E); mc_b1(c, 0x20)
        mc_b4(c, 0x49, 0x83, 0xC5, 0x02)
        jmp_g64_i2 := mc_jmp32(c); mc_patch_rel32(c, jmp_g64_i2, lp_g64_i2)

        // Single odd remaining row
        mc_patch_rel32(c, jge_g64_i1, buf_len(c))
        mc_b3(c, 0x4D, 0x39, 0xFD)
        jge_g64_nj := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x48, 0x8B, 0x1C, 0x24)
        mc_b3(c, 0x4C, 0x89, 0xE8); mc_b4(c, 0x48, 0x0F, 0xAF, 0xC3)
        mc_b4(c, 0x48, 0x03, 0x44, 0x24); mc_b1(c, 48)
        mc_b4(c, 0x49, 0x8D, 0x3C, 0xC1)
        mc_b4(c, 0x48, 0x8D, 0x94, 0x24); mc_u32(c, 192)
        mc_b4(c, 0x48, 0x8B, 0x44, 0x24); mc_b1(c, 8)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC5)
        mc_b3(c, 0x4C, 0x01, 0xD0)
        mc_b4(c, 0x49, 0x8D, 0x0C, 0xC3)
        mc_b4(c, 0x48, 0x83, 0x7C, 0x24); mc_b2(c, 48, 0)
        jne_ld64_c1 := mc_jcc8(c, 0x75)
        mc_vex2(c, 0, 1, 1, 0x57, 0xC0); mc_vex2(c, 1, 1, 1, 0x57, 0xC9)
        jmp_c64_1rdy := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jne_ld64_c1, buf_len(c))
        mc_vex2(c, 0, 1, 1, 0x10, 0x01); mc_vex2(c, 0, 1, 1, 0x10, 0x49); mc_b1(c, 0x20)
        mc_patch_jcc8(c, jmp_c64_1rdy, buf_len(c))
        mc_b4(c, 0x48, 0x8B, 0x5C, 0x24); mc_b1(c, 56)
        mc_b3(c, 0x48, 0x85, 0xDB)
        jle_p64_1e := mc_jcc8(c, 0x7E)
        lp_p64_1 := buf_len(c)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x27)
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b1(c, 0x02)
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b2(c, 0x4A, 0x20)
        mc_b4(c, 0x48, 0x83, 0xC7, 0x08); mc_b4(c, 0x48, 0x83, 0xC2, 0x40)
        mc_b3(c, 0x48, 0xFF, 0xCB)
        jnz_p64_1 := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_p64_1, lp_p64_1)
        mc_patch_jcc8(c, jle_p64_1e, buf_len(c))
        mc_vex2(c, 0, 1, 1, 0x11, 0x01); mc_vex2(c, 0, 1, 1, 0x11, 0x49); mc_b1(c, 0x20)

        mc_patch_rel32(c, jge_g64_nj, buf_len(c))
        mc_b4(c, 0x48, 0x8B, 0x44, 0x24); mc_b1(c, 48)
        mc_b2(c, 0x48, 0x05); mc_u32(c, 256)
        mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 48)
        mc_b4(c, 0x48, 0x3B, 0x04, 0x24)
        jl_g64_pc := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_g64_pc, lp_g64_pc)

        jmp_g64_j8 := mc_jmp32(c); mc_patch_rel32(c, jmp_g64_j8, lp_g64_j8)

        mc_patch_rel32(c, jle_g64_j0, buf_len(c))
        mc_patch_rel32(c, jg_g64_jt, buf_len(c))
        mut grx64 := 0
        while grx64 < 8 {
            xreg := 6 + grx64
            mut xr_bit := 1
            if (xreg & 8) != 0 { xr_bit = 0 }
            off_x := 64 + grx64 * 16
            mc_b4(c, 0xC4, (xr_bit << 7) | 0x61, 0x7A, 0x6F)
            if off_x < 128 {
                mc_b3(c, 0x44 | ((xreg & 7) << 3), 0x24, off_x)
            } else {
                mc_b2(c, 0x84 | ((xreg & 7) << 3), 0x24); mc_u32(c, off_x)
            }
            grx64 += 1
        }
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_b4(c, 0x44, 0x0F, 0x10, 0xB4); mc_b1(c, 0x24); mc_u32(c, 16576)
        mc_b4(c, 0x44, 0x0F, 0x10, 0xBC); mc_b1(c, 0x24); mc_u32(c, 16592)
        mc_b4(c, 0x48, 0x83, 0xBC, 0x24); mc_u32(c, 16616); mc_b1(c, 0)
        jne_g64_notail := mc_jcc32(c, 0x85)
        mc_b4(c, 0x4C, 0x8B, 0x54, 0x24); mc_b1(c, 8)
        mc_b4(c, 0x49, 0x83, 0xE2, 0xF8)
        mc_b3(c, 0x45, 0x31, 0xF6)
        mc_b4(c, 0x4C, 0x8B, 0xBC, 0x24); mc_u32(c, 16632)
        jmp_g64_jt := mc_jmp32(c)
        mc_patch_rel32(c, jz_gm64_sc, buf_len(c))
        mc_b4(c, 0x48, 0x8B, 0x8C, 0x24); mc_u32(c, 16616)
        mc_b4(c, 0x48, 0x8B, 0x94, 0x24); mc_u32(c, 16624)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 16632)
        mc_ai_row_range(c)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 16608) // RAX = pool
        mc_b4(c, 0x4C, 0x8B, 0x48, 32)                     // R9 = A (restored after mc_ai_row_range!)
        mc_b3(c, 0x45, 0x31, 0xD2)
        mc_patch_rel32(c, jmp_g64_jt, buf_len(c))
        lp_g64_jt := buf_len(c)
        mc_b4(c, 0x4C, 0x3B, 0x54, 0x24); mc_b1(c, 8)
        jge_g64_all := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4D, 0x89, 0xF5)
        lp_g64_it := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xFD)
        jge_g64_it := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x48, 0x8B, 0x1C, 0x24)
        mc_b3(c, 0x4C, 0x89, 0xE8); mc_b4(c, 0x48, 0x0F, 0xAF, 0xC3)
        mc_b4(c, 0x49, 0x8D, 0x3C, 0xC1)
        mc_b4(c, 0x48, 0x8B, 0x54, 0x24); mc_b1(c, 16)
        mc_b4(c, 0x4A, 0x8D, 0x14, 0xD2)
        mc_b4(c, 0x48, 0x8B, 0x4C, 0x24); mc_b1(c, 24)
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) // XORPD XMM0, XMM0
        mc_b3(c, 0x48, 0x85, 0xDB)
        jle_pt64 := mc_jcc8(c, 0x7E)
        lp_pt64 := buf_len(c)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x0F) // MOVSD XMM1, [RDI]
        mc_b4(c, 0xF2, 0x0F, 0x59, 0x0A) // MULSD XMM1, [RDX]
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1) // ADDSD XMM0, XMM1
        mc_b4(c, 0x48, 0x83, 0xC7, 0x08)
        mc_b3(c, 0x48, 0x01, 0xCA)
        mc_b3(c, 0x48, 0xFF, 0xCB)
        jnz_pt64 := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_pt64, lp_pt64)
        mc_patch_jcc8(c, jle_pt64, buf_len(c))
        mc_b4(c, 0x48, 0x8B, 0x44, 0x24); mc_b1(c, 8)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC5)
        mc_b3(c, 0x4C, 0x01, 0xD0)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x04, 0xC3) // MOVSD [R11 + RAX*8], XMM0
        mc_b3(c, 0x49, 0xFF, 0xC5)
        jmp_it64 := mc_jmp32(c); mc_patch_rel32(c, jmp_it64, lp_g64_it)
        mc_patch_rel32(c, jge_g64_it, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC2)
        jmp_jt64 := mc_jmp32(c); mc_patch_rel32(c, jmp_jt64, lp_g64_jt)
        mc_patch_rel32(c, jne_g64_notail, buf_len(c))
        mc_patch_rel32(c, jge_g64_all, buf_len(c))
        mc_patch_rel32(c, jle_gm64_e, buf_len(c))
        mc_ai_leave(c, 0x4138)
        mc_ai_emit_batch_pub(cg, h_ai_gemm_f64(), s_wk, 3, 5, 8192)
    }

    // 5b. `h_ai_bnn_popcnt`: args = `[weights, act, out, rows, words]` (2-row-tiled 4-word POPCNT + multi-core pool)
    if cg_is_helper_used(cg, h_ai_bnn_popcnt()) {
        mc_align16(c)
        s_wk := buf_len(c)
        mc_ai_enter(c, 0x28)
        mc_b3(c, 0x4D, 0x89, 0xC4)                      // R12 = pool
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 56)  // RAX = rows
        mc_ai_row_range(c)                              // R14 = r0, R15 = r1
        mc_b3(c, 0x4D, 0x39, 0xFE)
        jge_be := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4D, 0x8B, 0x5C, 0x24); mc_b1(c, 32)  // R11 = weights
        mc_b4(c, 0x4D, 0x8B, 0x44, 0x24); mc_b1(c, 40)  // R8  = act
        mc_b4(c, 0x49, 0x8B, 0x4C, 0x24); mc_b1(c, 48)  // RCX = out
        mc_b4(c, 0x4D, 0x8B, 0x54, 0x24); mc_b1(c, 64)  // R10 = words
        mc_b3(c, 0x4D, 0x85, 0xDB); jz_bw := mc_jcc32(c, 0x84)
        mc_b3(c, 0x4D, 0x85, 0xC0); jz_ba := mc_jcc32(c, 0x84)
        mc_b3(c, 0x48, 0x85, 0xC9); jz_bo := mc_jcc32(c, 0x84)
        mc_b3(c, 0x4D, 0x85, 0xD2); jle_bd := mc_jcc32(c, 0x8E)
        mc_b3(c, 0x4D, 0x89, 0xF9)                      // R9  = r1
        mc_b3(c, 0x4C, 0x89, 0xF7)                      // RDI = r0
        mc_b3(c, 0x4D, 0x89, 0xD4); mc_b4(c, 0x49, 0xC1, 0xE4, 0x03) // R12 = words * 8
        mc_b3(c, 0x48, 0x89, 0xF8); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC4) // RAX = r0 * row_bytes
        mc_b3(c, 0x49, 0x01, 0xC3)                      // R11 = weights + r0 * row_bytes
        // 2-row tiled 4-word unrolled POPCNT
        lp_b2r := buf_len(c)
        mc_b4(c, 0x48, 0x8D, 0x47, 0x01)
        mc_b3(c, 0x4C, 0x39, 0xC8)
        jge_bodd := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4D, 0x89, 0xDF); mc_b3(c, 0x4D, 0x01, 0xE7) // R15 = R11 + R12 (row1 ptr)
        mc_b2(c, 0x31, 0xDB)                            // RBX  = sum0a
        mc_b3(c, 0x45, 0x31, 0xED)                      // R13D = sum0b
        mc_b2(c, 0x31, 0xD2)                            // RDX  = sum1
        mc_b2(c, 0x31, 0xF6)                            // RSI  = w = 0
        lp_b2w := buf_len(c)
        mc_b4(c, 0x48, 0x8D, 0x46, 0x04)
        mc_b3(c, 0x4C, 0x39, 0xD0)
        jg_b2tl := mc_jcc32(c, 0x8F)
        mc_b4(c, 0x41, 0x0F, 0x18, 0x8C); mc_b1(c, 0xF3); mc_u32(c, 256) // PREFETCHT0 [R11+RSI*8+256]
        mut wi := 0
        while wi < 4 {
            off := wi * 8
            if off == 0 {
                mc_b4(c, 0x49, 0x8B, 0x04, 0xF0)
                mc_b3(c, 0x49, 0x89, 0xC6)
                mc_b4(c, 0x49, 0x33, 0x04, 0xF3)
                mc_b4(c, 0x4D, 0x33, 0x34, 0xF7)
            } else {
                mc_b4(c, 0x49, 0x8B, 0x44, 0xF0); mc_b1(c, off)
                mc_b3(c, 0x49, 0x89, 0xC6)
                mc_b4(c, 0x49, 0x33, 0x44, 0xF3); mc_b1(c, off)
                mc_b4(c, 0x4D, 0x33, 0x74, 0xF7); mc_b1(c, off)
            }
            mc_b4(c, 0xF3, 0x48, 0x0F, 0xB8); mc_b1(c, 0xC0)
            mc_b4(c, 0xF3, 0x4D, 0x0F, 0xB8); mc_b1(c, 0xF6)
            if (wi & 1) == 0 { mc_b2(c, 0x01, 0xC3) }
            else             { mc_b3(c, 0x41, 0x01, 0xC5) }
            mc_b3(c, 0x44, 0x01, 0xF2)
            wi += 1
        }
        mc_b4(c, 0x48, 0x83, 0xC6, 0x04)
        j_b2w := mc_jmp32(c); mc_patch_rel32(c, j_b2w, lp_b2w)
        mc_patch_rel32(c, jg_b2tl, buf_len(c))
        lp_b2t := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD6); jge_b2td := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xF0); mc_b3(c, 0x49, 0x89, 0xC6)
        mc_b4(c, 0x49, 0x33, 0x04, 0xF3); mc_b4(c, 0x4D, 0x33, 0x34, 0xF7)
        mc_b4(c, 0xF3, 0x48, 0x0F, 0xB8); mc_b1(c, 0xC0)
        mc_b4(c, 0xF3, 0x4D, 0x0F, 0xB8); mc_b1(c, 0xF6)
        mc_b2(c, 0x01, 0xC3); mc_b3(c, 0x44, 0x01, 0xF2)
        mc_b3(c, 0x48, 0xFF, 0xC6)
        j_b2t := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_b2t, lp_b2t)
        mc_patch_jcc8(c, jge_b2td, buf_len(c))
        mc_b3(c, 0x44, 0x01, 0xEB)                      // ADD EBX, R13D
        mc_b4(c, 0x48, 0x89, 0x1C, 0xF9)
        mc_b4(c, 0x48, 0x89, 0x54, 0xF9); mc_b1(c, 8)
        mc_b3(c, 0x4D, 0x01, 0xE3); mc_b3(c, 0x4D, 0x01, 0xE3)
        mc_b4(c, 0x48, 0x83, 0xC7, 0x02)
        j_b2r := mc_jmp32(c); mc_patch_rel32(c, j_b2r, lp_b2r)
        // Odd final row if (r1 - r0) is odd
        mc_patch_rel32(c, jge_bodd, buf_len(c))
        mc_b3(c, 0x4C, 0x39, 0xCF); jge_bdone := mc_jcc32(c, 0x8D)
        mc_b2(c, 0x31, 0xDB); mc_b2(c, 0x31, 0xF6)
        lp_b1t := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD6); jge_b1td := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xF3); mc_b4(c, 0x49, 0x33, 0x04, 0xF0)
        mc_b4(c, 0xF3, 0x48, 0x0F, 0xB8); mc_b1(c, 0xC0)
        mc_b2(c, 0x01, 0xC3); mc_b3(c, 0x48, 0xFF, 0xC6)
        j_b1t := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_b1t, lp_b1t)
        mc_patch_jcc8(c, jge_b1td, buf_len(c))
        mc_b4(c, 0x48, 0x89, 0x1C, 0xF9)
        bdone := buf_len(c)
        mc_patch_rel32(c, jge_be, bdone)
        mc_patch_rel32(c, jz_bw, bdone)
        mc_patch_rel32(c, jz_ba, bdone)
        mc_patch_rel32(c, jz_bo, bdone)
        mc_patch_rel32(c, jle_bd, bdone)
        mc_patch_rel32(c, jge_bdone, bdone)
        mc_ai_leave(c, 0x28)
        mc_ai_emit_batch_pub(cg, h_ai_bnn_popcnt(), s_wk, 3, 4, 32768)
    }
}

fn emit_ai_quant_helpers(cg: CodegenCtx) {
    c := cg.code

    // 6. `h_ai_gemv_q8_0`: single-row (`RCX < 0`: `RDX=act, R8=q8, R9=nblk -> XMM0=f64`) OR batch `args=[act, q8, out, rows, nblk]` (2-row AVX2+FMA3)
    if cg_is_helper_used(cg, h_ai_gemv_q8_0()) {
        mc_align16(c)
        s_wk := buf_len(c)
        mc_ai_enter(c, 0x58)
        // Save callee-saved XMM6..XMM9 at [RSP+0..48], T at [RSP+64]
        mc_b4(c, 0x0F, 0x11, 0x74, 0x24); mc_b1(c, 0)
        mc_b4(c, 0x0F, 0x11, 0x7C, 0x24); mc_b1(c, 16)
        mc_b4(c, 0x44, 0x0F, 0x11, 0x44); mc_b2(c, 0x24, 32)
        mc_b4(c, 0x44, 0x0F, 0x11, 0x4C); mc_b2(c, 0x24, 48)
        mc_b4(c, 0x48, 0x89, 0x54, 0x24); mc_b1(c, 64)
        mc_b3(c, 0x4D, 0x89, 0xC4)
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 56)
        mc_ai_row_range(c)
        mc_b3(c, 0x4D, 0x39, 0xFE)
        jge_q8e := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x49, 0x8B, 0x6C, 0x24); mc_b1(c, 64) // RBP = nblk
        mc_b4(c, 0x49, 0x8B, 0x7C, 0x24); mc_b1(c, 32) // RDI = act
        mc_b4(c, 0x49, 0x8B, 0x5C, 0x24); mc_b1(c, 48) // RBX = out
        mc_b3(c, 0x48, 0x85, 0xDB)
        jz_q8no := mc_jcc8(c, 0x74)
        mc_b4(c, 0x4A, 0x8D, 0x1C, 0xB3) // LEA RBX, [RBX + R14*4]
        mc_patch_jcc8(c, jz_q8no, buf_len(c))
        mc_b3(c, 0x4C, 0x69, 0xCD); mc_u32(c, 36)       // IMUL R9, RBP, 36
        mc_b4(c, 0x49, 0x8B, 0x74, 0x24); mc_b1(c, 40) // RSI = q8
        mc_b3(c, 0x4C, 0x89, 0xF0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC1)
        mc_b3(c, 0x48, 0x01, 0xC6) // RSI = q8 + r0 * row_bytes
        mc_b3(c, 0x4D, 0x89, 0xF5) // R13 = r0

        // Check SIMD tier ONCE outside row loop
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_q8_sc_rows := mc_jcc32(c, 0x84)

        // AVX2 2-row simultaneous fastpath (+ dynamic 32-row stealing when T>1, nblk>0, out!=0)
        mc_b3(c, 0x48, 0x85, 0xED)
        jle_q8_1r_a := mc_jcc32(c, 0x8E)
        mc_b3(c, 0x48, 0x85, 0xDB)
        jz_q8_1r_b := mc_jcc32(c, 0x84)

        mc_b4(c, 0x48, 0x83, 0x7C, 0x24); mc_b2(c, 64, 1); jle_q8_stat := mc_jcc32(c, 0x8E)
        lp_q8_dyn := buf_len(c)
        mc_b1(c, 0xB8); mc_u32(c, 32)
        mc_b4(c, 0xF0, 0x49, 0x0F, 0xC1); mc_b2(c, 0x84, 0x24); mc_u32(c, 1728)
        mc_b4(c, 0x4D, 0x8B, 0x5C, 0x24); mc_b1(c, 56)
        mc_b3(c, 0x4C, 0x39, 0xD8); jge_q8_dyn_dn := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x49, 0x89, 0xC5)
        mc_b4(c, 0x4C, 0x8D, 0x78, 32)
        mc_b3(c, 0x4D, 0x39, 0xDF); mc_b4(c, 0x4D, 0x0F, 0x4F, 0xFB)
        mc_b4(c, 0x49, 0x8B, 0x5C, 0x24); mc_b1(c, 48)
        mc_b4(c, 0x4A, 0x8D, 0x1C, 0xAB)
        mc_b4(c, 0x49, 0x8B, 0x74, 0x24); mc_b1(c, 40)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC1); mc_b3(c, 0x48, 0x01, 0xC6)
        mc_patch_rel32(c, jle_q8_stat, buf_len(c))

        lp_q8_2row := buf_len(c)
        mc_b4(c, 0x49, 0x8D, 0x45, 0x02) // LEA RAX, [R13+2]
        mc_b3(c, 0x4C, 0x39, 0xF8)       // CMP RAX, R15
        jg_q8_1r := mc_jcc32(c, 0x8F)

        mc_b3(c, 0x48, 0x89, 0xF1)       // RCX = row0
        mc_b4(c, 0x4E, 0x8D, 0x14, 0x0E) // LEA R10, [RSI+R9] (row1)
        mc_b3(c, 0x48, 0x89, 0xFA)       // RDX = act
        mc_b3(c, 0x48, 0x89, 0xE8)       // RAX = nblk
        mc_vex2(c, 4, 1, 0, 0x57, 0xE4)  // VXORPS YMM4, YMM4, YMM4
        mc_vex2(c, 5, 1, 0, 0x57, 0xED)  // VXORPS YMM5, YMM5, YMM5
        mc_vex2(c, 6, 1, 0, 0x57, 0xF6)  // VXORPS YMM6, YMM6, YMM6
        mc_vex2(c, 7, 1, 0, 0x57, 0xFF)  // VXORPS YMM7, YMM7, YMM7

        mc_align16_nop(c)
        lp_q8_2blk := buf_len(c)
        mc_b4(c, 0x0F, 0x18, 0x89, 144); mc_b3(c, 0, 0, 0)             // PREFETCHT0 [RCX+144]
        mc_b4(c, 0x41, 0x0F, 0x18, 0x8A); mc_u32(c, 144)               // PREFETCHT0 [R10+144]
        // Chunk 0 (+0, +4)
        mc_vex2(c, 0, 1, 0, 0x10, 0x12)                                // VMOVUPS YMM2, [RDX]
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x21); mc_b2(c, 0x49, 0x04) // VPMOVSXBD YMM1, [RCX+4]
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)                                // VCVTDQ2PS YMM1, YMM1
        mc_vex2(c, 1, 1, 0, 0x59, 0xC2)                                // VMULPS YMM0, YMM1, YMM2
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x21); mc_b2(c, 0x4A, 0x04) // VPMOVSXBD YMM1, [R10+4]
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex3(c, 1, 0, 0, 1, 0, 1, 1, 0, 0x59); mc_b1(c, 0xC2)       // VMULPS YMM8, YMM1, YMM2
        // Chunk 1 (+32, +12)
        mc_vex2(c, 0, 1, 0, 0x10, 0x52); mc_b1(c, 0x20)                // VMOVUPS YMM2, [RDX+32]
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x21); mc_b2(c, 0x49, 0x0C) // VPMOVSXBD YMM1, [RCX+12]
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex2(c, 1, 1, 0, 0x59, 0xDA)                                // VMULPS YMM3, YMM1, YMM2
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x21); mc_b2(c, 0x4A, 0x0C) // VPMOVSXBD YMM1, [R10+12]
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex3(c, 1, 0, 0, 1, 0, 1, 1, 0, 0x59); mc_b1(c, 0xCA)       // VMULPS YMM9, YMM1, YMM2
        // Chunk 2 (+64, +20)
        mc_vex2(c, 0, 1, 0, 0x10, 0x52); mc_b1(c, 0x40)                // VMOVUPS YMM2, [RDX+64]
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x21); mc_b2(c, 0x49, 0x14) // VPMOVSXBD YMM1, [RCX+20]
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex3(c, 0, 0, 0, 2, 0, 1, 1, 1, 0xB8); mc_b1(c, 0xC2)       // VFMADD231PS YMM0, YMM1, YMM2
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x21); mc_b2(c, 0x4A, 0x14) // VPMOVSXBD YMM1, [R10+20]
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex3(c, 1, 0, 0, 2, 0, 1, 1, 1, 0xB8); mc_b1(c, 0xC2)       // VFMADD231PS YMM8, YMM1, YMM2
        // Chunk 3 (+96, +28)
        mc_vex2(c, 0, 1, 0, 0x10, 0x52); mc_b1(c, 0x60)                // VMOVUPS YMM2, [RDX+96]
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x21); mc_b2(c, 0x49, 0x1C) // VPMOVSXBD YMM1, [RCX+28]
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex3(c, 0, 0, 0, 2, 0, 1, 1, 1, 0xB8); mc_b1(c, 0xDA)       // VFMADD231PS YMM3, YMM1, YMM2
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x21); mc_b2(c, 0x4A, 0x1C) // VPMOVSXBD YMM1, [R10+28]
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex3(c, 1, 0, 0, 2, 0, 1, 1, 1, 0xB8); mc_b1(c, 0xCA)       // VFMADD231PS YMM9, YMM1, YMM2
        // Scale FMAs
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b1(c, 0x11)       // VBROADCASTSS YMM2, [RCX]
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0xB8); mc_b1(c, 0xE2)       // VFMADD231PS YMM4, YMM0, YMM2
        mc_vex3(c, 0, 0, 0, 2, 0, 3, 1, 1, 0xB8); mc_b1(c, 0xEA)       // VFMADD231PS YMM5, YMM3, YMM2
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x18); mc_b1(c, 0x12)       // VBROADCASTSS YMM2, [R10]
        mc_vex3(c, 0, 0, 0, 2, 0, 8, 1, 1, 0xB8); mc_b1(c, 0xF2)       // VFMADD231PS YMM6, YMM8, YMM2
        mc_vex3(c, 0, 0, 0, 2, 0, 9, 1, 1, 0xB8); mc_b1(c, 0xFA)       // VFMADD231PS YMM7, YMM9, YMM2
        mc_b4(c, 0x48, 0x83, 0xC1, 36)                                  // ADD RCX, 36
        mc_b4(c, 0x49, 0x83, 0xC2, 36)                                  // ADD R10, 36
        mc_b3(c, 0x48, 0x81, 0xC2); mc_u32(c, 128)                      // ADD RDX, 128
        mc_b3(c, 0x48, 0xFF, 0xC8)                                      // DEC RAX
        jnz_q82b := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_q82b, lp_q8_2blk)

        // Store row0 & row1
        mc_vex2(c, 4, 1, 0, 0x58, 0xC5)                                 // VADDPS YMM0, YMM4, YMM5
        mc_avx_hsum_ymm0(c)
        mc_vex2(c, 0, 0, 2, 0x11, 0x03)                                 // VMOVSS [RBX], XMM0
        mc_vex2(c, 6, 1, 0, 0x58, 0xC7)                                 // VADDPS YMM0, YMM6, YMM7
        mc_avx_hsum_ymm0(c)
        mc_vex2(c, 0, 0, 2, 0x11, 0x43); mc_b1(c, 4)                    // VMOVSS [RBX+4], XMM0
        mc_b4(c, 0x48, 0x83, 0xC3, 0x08)                                // ADD RBX, 8
        mc_b4(c, 0x4A, 0x8D, 0x34, 0x4E)                                // LEA RSI, [RSI + R9*2]
        mc_b4(c, 0x49, 0x83, 0xC5, 0x02)                                // ADD R13, 2
        jmp_q82r := mc_jmp32(c); mc_patch_rel32(c, jmp_q82r, lp_q8_2row)

        // AVX2 1-row tail (also handles single-row out==0 and nblk<=0)
        mc_patch_rel32(c, jle_q8_1r_a, buf_len(c))
        mc_patch_rel32(c, jz_q8_1r_b, buf_len(c))
        mc_patch_rel32(c, jg_q8_1r, buf_len(c))
        lp_q8_1row := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xFD)
        jge_q8_avxdone := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x48, 0x89, 0xF1) // RCX = q8_row
        mc_b3(c, 0x48, 0x89, 0xFA) // RDX = act
        mc_vex2(c, 0, 0, 0, 0x57, 0xC0) // VXORPS XMM0, XMM0, XMM0
        mc_b3(c, 0x48, 0x85, 0xED)
        jle_q8_1st := mc_jcc32(c, 0x8E)
        mc_b3(c, 0x48, 0x89, 0xE8)
        mc_vex2(c, 4, 1, 0, 0x57, 0xE4)
        mc_vex2(c, 5, 1, 0, 0x57, 0xED)
        lp_q8_blk := buf_len(c)
        mc_b4(c, 0x0F, 0x18, 0x89, 144); mc_b3(c, 0, 0, 0)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x21); mc_b2(c, 0x49, 0x04)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex2(c, 0, 1, 0, 0x10, 0x12)
        mc_vex2(c, 1, 1, 0, 0x59, 0xC2)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x21); mc_b2(c, 0x49, 0x0C)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex2(c, 0, 1, 0, 0x10, 0x52); mc_b1(c, 0x20)
        mc_vex2(c, 1, 1, 0, 0x59, 0xDA)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x21); mc_b2(c, 0x49, 0x14)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex2(c, 0, 1, 0, 0x10, 0x52); mc_b1(c, 0x40)
        mc_vex3(c, 0, 0, 0, 2, 0, 1, 1, 1, 0xB8); mc_b1(c, 0xC2)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x21); mc_b2(c, 0x49, 0x1C)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex2(c, 0, 1, 0, 0x10, 0x52); mc_b1(c, 0x60)
        mc_vex3(c, 0, 0, 0, 2, 0, 1, 1, 1, 0xB8); mc_b1(c, 0xDA)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b1(c, 0x11)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0xB8); mc_b1(c, 0xE2)
        mc_vex3(c, 0, 0, 0, 2, 0, 3, 1, 1, 0xB8); mc_b1(c, 0xEA)
        mc_b4(c, 0x48, 0x83, 0xC1, 36)
        mc_b3(c, 0x48, 0x81, 0xC2); mc_u32(c, 128)
        mc_b3(c, 0x48, 0xFF, 0xC8)
        jnz_q8b := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_q8b, lp_q8_blk)
        mc_vex2(c, 4, 1, 0, 0x58, 0xC5)
        mc_avx_hsum_ymm0(c)
        mc_patch_rel32(c, jle_q8_1st, buf_len(c))
        mc_b3(c, 0x48, 0x85, 0xDB)
        jz_q8_1ret := mc_jcc8(c, 0x74)
        mc_vex2(c, 0, 0, 2, 0x11, 0x03) // VMOVSS [RBX], XMM0
        mc_b4(c, 0x48, 0x83, 0xC3, 0x04)
        mc_b3(c, 0x4C, 0x01, 0xCE)
        mc_b3(c, 0x49, 0xFF, 0xC5)
        jmp_q81r := mc_jmp32(c); mc_patch_rel32(c, jmp_q81r, lp_q8_1row)
        mc_patch_rel32(c, jge_q8_avxdone, buf_len(c))
        mc_b3(c, 0x48, 0x85, 0xED); jle_q8_nd := mc_jcc8(c, 0x7E)
        mc_b3(c, 0x48, 0x85, 0xDB); jz_q8_nd2 := mc_jcc8(c, 0x74)
        mc_b4(c, 0x48, 0x83, 0x7C, 0x24); mc_b2(c, 64, 1); jg_q8_next := mc_jcc32(c, 0x8F); mc_patch_rel32(c, jg_q8_next, lp_q8_dyn)
        mc_patch_jcc8(c, jle_q8_nd, buf_len(c))
        mc_patch_jcc8(c, jz_q8_nd2, buf_len(c))
        jmp_q8_vzu := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jz_q8_1ret, buf_len(c))
        mc_vex2(c, 0, 0, 2, 0x5A, 0xC0) // VCVTSS2SD XMM0, XMM0, XMM0 (for single-row f64 return)
        mc_patch_jcc8(c, jmp_q8_vzu, buf_len(c))
        mc_patch_rel32(c, jge_q8_dyn_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)      // VZEROUPPER ONCE after all AVX2 rows!
        jmp_q8_alldone := mc_jmp32(c)

        // Scalar SSE2 fallback (`RCX=q8_row, RDX=act, RBP=nblk -> XMM0=f64`)
        mc_patch_rel32(c, jz_q8_sc_rows, buf_len(c))
        lp_q8_sc_row := buf_len(c)
        mc_b3(c, 0x48, 0x89, 0xF1) // RCX = q8_row
        mc_b3(c, 0x48, 0x89, 0xFA) // RDX = act
        mc_b3(c, 0x0F, 0x57, 0xC0) // XORPS XMM0, XMM0
        mc_b3(c, 0x48, 0x85, 0xED)
        jle_q8_sc_st := mc_jcc32(c, 0x8E)
        mc_b3(c, 0x49, 0x89, 0xEA) // R10 = nblk
        lp_q8_sb := buf_len(c)
        mc_b3(c, 0x0F, 0x57, 0xC9)       // XORPS XMM1, XMM1 (f64 block sum)
        mc_b4(c, 0x4C, 0x8D, 0x59, 0x04) // R11 = RCX + 4
        mc_b2(c, 0x41, 0xB8); mc_u32(c, 32) // R8D = 32
        lp_q8_si := buf_len(c)
        mc_b4(c, 0x41, 0x0F, 0xBE, 0x03) // MOVSX EAX, BYTE [R11]
        mc_b4(c, 0xF2, 0x0F, 0x2A, 0xD0) // CVTSI2SD XMM2, EAX
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x1A) // MOVSS XMM3, [RDX]
        mc_b4(c, 0xF3, 0x0F, 0x5A, 0xDB) // CVTSS2SD XMM3, XMM3
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xD3) // MULSD XMM2, XMM3
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xCA) // ADDSD XMM1, XMM2
        mc_b3(c, 0x49, 0xFF, 0xC3)
        mc_b4(c, 0x48, 0x83, 0xC2, 0x04)
        mc_b3(c, 0x41, 0xFF, 0xC8)
        jnz_q8si := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_q8si, lp_q8_si)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x11) // MOVSS XMM2, [RCX]
        mc_b4(c, 0xF3, 0x0F, 0x5A, 0xD2) // CVTSS2SD XMM2, XMM2
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xCA) // MULSD XMM1, XMM2
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1) // ADDSD XMM0, XMM1
        mc_b4(c, 0x48, 0x83, 0xC1, 36)
        mc_b3(c, 0x49, 0xFF, 0xCA)
        jnz_q8sb := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_q8sb, lp_q8_sb)
        mc_patch_rel32(c, jle_q8_sc_st, buf_len(c))
        mc_b3(c, 0x48, 0x85, 0xDB)
        jz_q8e := mc_jcc8(c, 0x74)
        mc_b4(c, 0xF2, 0x0F, 0x5A, 0xC8)
        mc_b4(c, 0xF3, 0x0F, 0x11, 0x0B)
        mc_b4(c, 0x48, 0x83, 0xC3, 0x04)
        mc_b3(c, 0x4C, 0x01, 0xCE)
        mc_b3(c, 0x49, 0xFF, 0xC5)
        mc_b3(c, 0x4D, 0x39, 0xFD)
        jl_q8r := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_q8r, lp_q8_sc_row)

        mc_patch_jcc8(c, jz_q8e, buf_len(c))
        mc_patch_rel32(c, jmp_q8_alldone, buf_len(c))
        mc_patch_rel32(c, jge_q8e, buf_len(c))
        // Restore XMM6..XMM9
        mc_b4(c, 0x0F, 0x10, 0x74, 0x24); mc_b1(c, 0)
        mc_b4(c, 0x0F, 0x10, 0x7C, 0x24); mc_b1(c, 16)
        mc_b4(c, 0x44, 0x0F, 0x10, 0x44); mc_b2(c, 0x24, 32)
        mc_b4(c, 0x44, 0x0F, 0x10, 0x4C); mc_b2(c, 0x24, 48)
        mc_ai_leave(c, 0x58)

        // Dual-mode entry: RCX < 0 -> single row `(RDX=act, R8=q8, R9=nblk) -> f64`; else `RCX = args_ptr`
        mc_align16(c)
        s_pub := buf_len(c)
        mc_ai_enter(c, 0x48)
        mc_b3(c, 0x48, 0x85, 0xC9)
        jns_q8b := mc_jcc32(c, 0x89)
        mc_b4(c, 0x48, 0x89, 0x54, 0x24); mc_b1(c, 0)
        mc_b4(c, 0x4C, 0x89, 0x44, 0x24); mc_b1(c, 8)
        mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 16); mc_u32(c, 0)
        mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 24); mc_u32(c, 1)
        mc_b4(c, 0x4C, 0x89, 0x4C, 0x24); mc_b1(c, 32)
        mc_b2(c, 0x31, 0xC9); mc_b1(c, 0xBA); mc_u32(c, 1)
        mc_b4(c, 0x4C, 0x8D, 0x44, 0x24); mc_b1(c, 0 - 32)
        mc_b1(c, 0xE8); mc_u32(c, s_wk - (buf_len(c) + 4))
        jmp_q8fin := mc_jmp32(c)

        mc_patch_rel32(c, jns_q8b, buf_len(c))
        mc_b3(c, 0x48, 0x89, 0xCB)
        mc_b4(c, 0x48, 0x8B, 0x43, 24)
        mc_b3(c, 0x48, 0x85, 0xC0)
        jle_q8done := mc_jcc32(c, 0x8E)
        mc_b4(c, 0x48, 0x0F, 0xAF, 0x43); mc_b1(c, 32)
        mc_b2(c, 0x48, 0x3D); mc_u32(c, 512)
        jge_q8p := mc_jcc8(c, 0x7D)
        mc_b2(c, 0x31, 0xC9); mc_b1(c, 0xBA); mc_u32(c, 1)
        mc_b4(c, 0x4C, 0x8D, 0x43, 0xE0)
        mc_b1(c, 0xE8); mc_u32(c, s_wk - (buf_len(c) + 4))
        jmp_q8done := mc_jmp32(c)
        mc_patch_jcc8(c, jge_q8p, buf_len(c))
        mc_b3(c, 0x48, 0x8D, 0x0D); mc_u32(c, s_wk - (buf_len(c) + 4))
        mc_b3(c, 0x48, 0x89, 0xDA)
        cg_call_fn(cg, h_ai_pool_dispatch())
        mc_patch_rel32(c, jle_q8done, buf_len(c))
        mc_patch_rel32(c, jmp_q8done, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_patch_rel32(c, jmp_q8fin, buf_len(c))
        mc_ai_leave(c, 0x48)
        cg_reg_helper(cg, h_ai_gemv_q8_0(), s_pub, buf_len(c))
    }

    // 7. `h_ai_gemv_q4_0`: single-row (`RCX < 0`) OR batch `args=[act, q4, out, rows, nblk]` (20B blocks, 2-row hoisted-const AVX2+FMA3)
    if cg_is_helper_used(cg, h_ai_gemv_q4_0()) {
        mc_align16(c)
        s_wk := buf_len(c)
        // [RSP+0..127] saves callee-saved XMM6..XMM13, [RSP+128]=T
        mc_ai_enter(c, 0x98)
        mc_b4(c, 0x0F, 0x11, 0x74, 0x24); mc_b1(c, 0)
        mc_b4(c, 0x0F, 0x11, 0x7C, 0x24); mc_b1(c, 16)
        mc_b4(c, 0x44, 0x0F, 0x11, 0x44); mc_b2(c, 0x24, 32)
        mc_b4(c, 0x44, 0x0F, 0x11, 0x4C); mc_b2(c, 0x24, 48)
        mc_b4(c, 0x44, 0x0F, 0x11, 0x54); mc_b2(c, 0x24, 64)
        mc_b4(c, 0x44, 0x0F, 0x11, 0x5C); mc_b2(c, 0x24, 80)
        mc_b4(c, 0x44, 0x0F, 0x11, 0x64); mc_b2(c, 0x24, 96)
        mc_b4(c, 0x44, 0x0F, 0x11, 0x6C); mc_b2(c, 0x24, 112)
        mc_b4(c, 0x48, 0x89, 0x94, 0x24); mc_u32(c, 128)
        mc_b3(c, 0x4D, 0x89, 0xC4)
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 56)
        mc_ai_row_range(c)         // R14 = r0, R15 = r1
        mc_b3(c, 0x4D, 0x39, 0xFE)
        jge_q4e := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x49, 0x8B, 0x6C, 0x24); mc_b1(c, 64) // RBP = nblk
        mc_b4(c, 0x49, 0x8B, 0x7C, 0x24); mc_b1(c, 32) // RDI = act
        mc_b4(c, 0x49, 0x8B, 0x5C, 0x24); mc_b1(c, 48) // RBX = out
        mc_b3(c, 0x48, 0x85, 0xDB)
        jz_q4no := mc_jcc8(c, 0x74)
        mc_b4(c, 0x4A, 0x8D, 0x1C, 0xB3)
        mc_patch_jcc8(c, jz_q4no, buf_len(c))
        mc_b3(c, 0x4C, 0x69, 0xCD); mc_u32(c, 20)       // R9 = nblk * 20
        mc_b4(c, 0x49, 0x8B, 0x74, 0x24); mc_b1(c, 40) // RSI = q4
        mc_b3(c, 0x4C, 0x89, 0xF0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC1)
        mc_b3(c, 0x48, 0x01, 0xC6)
        mc_b3(c, 0x4D, 0x89, 0xF5) // R13 = r0

        // Check SIMD tier ONCE outside row loop
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_q4_sc_rows := mc_jcc32(c, 0x84)

        // Hoist 0x0F*16 -> XMM6 and 0x08*16 -> XMM7 ONCE for all rows!
        mc_b2(c, 0x48, 0xB8); mc_u64(c, 0x0F0F0F0F0F0F0F0F)
        mc_vex3(c, 0, 0, 0, 1, 1, 0, 0, 1, 0x6E); mc_b1(c, 0xF0) // VMOVQ XMM6, RAX
        mc_vex2(c, 6, 0, 1, 0x6C, 0xF6)                          // VPUNPCKLQDQ XMM6, XMM6, XMM6
        mc_b2(c, 0x48, 0xB8); mc_u64(c, 0x0808080808080808)
        mc_vex3(c, 0, 0, 0, 1, 1, 0, 0, 1, 0x6E); mc_b1(c, 0xF8) // VMOVQ XMM7, RAX
        mc_vex2(c, 7, 0, 1, 0x6C, 0xFF)                          // VPUNPCKLQDQ XMM7, XMM7, XMM7

        // AVX2 2-row simultaneous fastpath (+ dynamic 32-row stealing when T>1, nblk>0, out!=0)
        mc_b3(c, 0x48, 0x85, 0xED)
        jle_q4_1r_a := mc_jcc32(c, 0x8E)
        mc_b3(c, 0x48, 0x85, 0xDB)
        jz_q4_1r_b := mc_jcc32(c, 0x84)

        mc_b4(c, 0x48, 0x83, 0xBC, 0x24); mc_u32(c, 128); mc_b1(c, 1); jle_q4_stat := mc_jcc32(c, 0x8E)
        lp_q4_dyn := buf_len(c)
        mc_b1(c, 0xB8); mc_u32(c, 32)
        mc_b4(c, 0xF0, 0x49, 0x0F, 0xC1); mc_b2(c, 0x84, 0x24); mc_u32(c, 1728)
        mc_b4(c, 0x4D, 0x8B, 0x5C, 0x24); mc_b1(c, 56)
        mc_b3(c, 0x4C, 0x39, 0xD8); jge_q4_dyn_dn := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x49, 0x89, 0xC5)
        mc_b4(c, 0x4C, 0x8D, 0x78, 32)
        mc_b3(c, 0x4D, 0x39, 0xDF); mc_b4(c, 0x4D, 0x0F, 0x4F, 0xFB)
        mc_b4(c, 0x49, 0x8B, 0x5C, 0x24); mc_b1(c, 48)
        mc_b4(c, 0x4A, 0x8D, 0x1C, 0xAB)
        mc_b4(c, 0x49, 0x8B, 0x74, 0x24); mc_b1(c, 40)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC1); mc_b3(c, 0x48, 0x01, 0xC6)
        mc_patch_rel32(c, jle_q4_stat, buf_len(c))

        lp_q4_2row := buf_len(c)
        mc_b4(c, 0x49, 0x8D, 0x45, 0x02) // LEA RAX, [R13+2]
        mc_b3(c, 0x4C, 0x39, 0xF8)       // CMP RAX, R15
        jg_q4_1r := mc_jcc32(c, 0x8F)

        mc_b3(c, 0x48, 0x89, 0xF1)       // RCX = row0
        mc_b4(c, 0x4E, 0x8D, 0x14, 0x0E) // LEA R10, [RSI+R9] (row1)
        mc_b3(c, 0x48, 0x89, 0xFA)       // RDX = act
        mc_b3(c, 0x48, 0x89, 0xE8)       // RAX = nblk
        mc_vex2(c, 4, 1, 1, 0x57, 0xE4)                          // VXORPD YMM4, YMM4, YMM4
        mc_vex3(c, 1, 0, 1, 1, 0, 12, 1, 1, 0x57); mc_b1(c, 0xE4) // VXORPD YMM12, YMM12, YMM12

        mc_align16_nop(c)
        lp_q4_2blk := buf_len(c)
        mc_b4(c, 0x0F, 0x18, 0x89, 120); mc_b3(c, 0, 0, 0)              // PREFETCHT0 [RCX+120]
        mc_b4(c, 0x41, 0x0F, 0x18, 0x8A); mc_u32(c, 120)                // PREFETCHT0 [R10+120]
        // Decode Row0 -> XMM8 (lo16), XMM9 (hi16)
        mc_vex2(c, 0, 0, 2, 0x6F, 0x49); mc_b1(c, 4)                    // VMOVDQU XMM1, [RCX+4]
        mc_vex2(c, 2, 0, 1, 0x71, 0xD1); mc_b1(c, 4)                    // VPSRLW XMM2, XMM1, 4
        mc_vex2(c, 1, 0, 1, 0xDB, 0xCE)                                 // VPAND XMM1, XMM1, XMM6
        mc_vex2(c, 2, 0, 1, 0xDB, 0xD6)                                 // VPAND XMM2, XMM2, XMM6
        mc_vex3(c, 1, 0, 0, 1, 0, 1, 0, 1, 0x60); mc_b1(c, 0xC2)        // VPUNPCKLBW XMM8, XMM1, XMM2
        mc_vex3(c, 1, 0, 0, 1, 0, 1, 0, 1, 0x68); mc_b1(c, 0xCA)        // VPUNPCKHBW XMM9, XMM1, XMM2
        mc_vex3(c, 1, 0, 0, 1, 0, 8, 0, 1, 0xF8); mc_b1(c, 0xC7)        // VPSUBB XMM8, XMM8, XMM7
        mc_vex3(c, 1, 0, 0, 1, 0, 9, 0, 1, 0xF8); mc_b1(c, 0xCF)        // VPSUBB XMM9, XMM9, XMM7
        // Decode Row1 -> XMM10 (lo16), XMM13 (hi16)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 2, 0x6F); mc_b2(c, 0x4A, 4)     // VMOVDQU XMM1, [R10+4]
        mc_vex2(c, 2, 0, 1, 0x71, 0xD1); mc_b1(c, 4)                    // VPSRLW XMM2, XMM1, 4
        mc_vex2(c, 1, 0, 1, 0xDB, 0xCE)                                 // VPAND XMM1, XMM1, XMM6
        mc_vex2(c, 2, 0, 1, 0xDB, 0xD6)                                 // VPAND XMM2, XMM2, XMM6
        mc_vex3(c, 1, 0, 0, 1, 0, 1, 0, 1, 0x60); mc_b1(c, 0xD2)        // VPUNPCKLBW XMM10, XMM1, XMM2
        mc_vex3(c, 1, 0, 0, 1, 0, 1, 0, 1, 0x68); mc_b1(c, 0xEA)        // VPUNPCKHBW XMM13, XMM1, XMM2
        mc_vex3(c, 1, 0, 0, 1, 0, 10, 0, 1, 0xF8); mc_b1(c, 0xD7)       // VPSUBB XMM10, XMM10, XMM7
        mc_vex3(c, 1, 0, 0, 1, 0, 13, 0, 1, 0xF8); mc_b1(c, 0xEF)       // VPSUBB XMM13, XMM13, XMM7
        // Chunk 0 (+0): XMM8 lo & XMM10 lo
        mc_vex2(c, 0, 1, 0, 0x10, 0x1A)                                 // VMOVUPS YMM3, [RDX]
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x21); mc_b1(c, 0xD0)        // VPMOVSXBD YMM2, XMM8
        mc_vex2(c, 0, 1, 0, 0x5B, 0xD2)                                 // VCVTDQ2PS YMM2, YMM2
        mc_vex2(c, 2, 1, 0, 0x59, 0xEB)                                 // VMULPS YMM5, YMM2, YMM3
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x21); mc_b1(c, 0xD2)        // VPMOVSXBD YMM2, XMM10
        mc_vex2(c, 0, 1, 0, 0x5B, 0xD2)
        mc_vex3(c, 1, 0, 0, 1, 0, 2, 1, 0, 0x59); mc_b1(c, 0xDB)        // VMULPS YMM11, YMM2, YMM3
        // Chunk 1 (+32): dual-acc YMM0 (Row0) & YMM1 (Row1) -> cuts FMA latency chain in HALF!
        mc_vex2(c, 0, 1, 0, 0x10, 0x5A); mc_b1(c, 0x20)
        mc_vex3(c, 0, 0, 1, 1, 0, 8, 0, 1, 0x73); mc_b2(c, 0xD8, 8)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x21); mc_b1(c, 0xD0)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xD2)
        mc_vex2(c, 2, 1, 0, 0x59, 0xC3)
        mc_vex3(c, 0, 0, 1, 1, 0, 10, 0, 1, 0x73); mc_b2(c, 0xDA, 8)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x21); mc_b1(c, 0xD2)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xD2)
        mc_vex2(c, 2, 1, 0, 0x59, 0xCB)
        // Chunk 2 (+64): XMM9 lo -> YMM5, XMM13 lo -> YMM11
        mc_vex2(c, 0, 1, 0, 0x10, 0x5A); mc_b1(c, 0x40)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x21); mc_b1(c, 0xD1)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xD2)
        mc_vex3(c, 0, 0, 0, 2, 0, 2, 1, 1, 0xB8); mc_b1(c, 0xEB)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x21); mc_b1(c, 0xD5)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xD2)
        mc_vex3(c, 1, 0, 0, 2, 0, 2, 1, 1, 0xB8); mc_b1(c, 0xDB)
        // Chunk 3 (+96): XMM9>>8 -> YMM0, XMM13>>8 -> YMM1
        mc_vex2(c, 0, 1, 0, 0x10, 0x5A); mc_b1(c, 0x60)
        mc_vex3(c, 0, 0, 1, 1, 0, 9, 0, 1, 0x73); mc_b2(c, 0xD9, 8)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x21); mc_b1(c, 0xD1)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xD2)
        mc_vex3(c, 0, 0, 0, 2, 0, 2, 1, 1, 0xB8); mc_b1(c, 0xC3)
        mc_vex3(c, 0, 0, 1, 1, 0, 13, 0, 1, 0x73); mc_b2(c, 0xDD, 8)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x21); mc_b1(c, 0xD5)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xD2)
        mc_vex3(c, 0, 0, 0, 2, 0, 2, 1, 1, 0xB8); mc_b1(c, 0xCB)
        // Merge dual accs & fast 5-insn widen to FP64 YMM4/YMM12!
        mc_vex2(c, 5, 1, 0, 0x58, 0xE8)
        mc_vex3(c, 1, 0, 0, 1, 0, 11, 1, 0, 0x58); mc_b1(c, 0xD9)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xE9, 0x01)
        mc_vex2(c, 5, 0, 0, 0x58, 0xC1)
        mc_vex2(c, 0, 1, 0, 0x5A, 0xC0)
        mc_vex2(c, 2, 0, 2, 0x5A, 0x11)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0xD2)
        mc_vex3(c, 0, 0, 0, 2, 1, 0, 1, 1, 0xB8); mc_b1(c, 0xE2)
        mc_vex3(c, 1, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xD9, 0x01)
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 0, 0, 0x58); mc_b1(c, 0xC3)
        mc_vex2(c, 0, 1, 0, 0x5A, 0xC0)
        mc_vex3(c, 0, 0, 1, 1, 0, 2, 0, 2, 0x5A); mc_b1(c, 0x12)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0xD2)
        mc_vex3(c, 1, 0, 0, 2, 1, 0, 1, 1, 0xB8); mc_b1(c, 0xE2)
        mc_b4(c, 0x48, 0x83, 0xC1, 20)
        mc_b4(c, 0x49, 0x83, 0xC2, 20)
        mc_b3(c, 0x48, 0x81, 0xC2); mc_u32(c, 128)
        mc_b3(c, 0x48, 0xFF, 0xC8)
        jnz_q42b := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_q42b, lp_q4_2blk)

        // Reduce & store Row0 (YMM4) and Row1 (YMM12)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xE1, 0x01) // VEXTRACTF128 XMM1, YMM4, 1
        mc_vex2(c, 4, 0, 1, 0x58, 0xC1)                                // VADDPD XMM0, XMM4, XMM1
        mc_vex2(c, 0, 0, 1, 0x15, 0xC8)                                // VUNPCKHPD XMM1, XMM0, XMM0
        mc_vex2(c, 0, 0, 3, 0x58, 0xC1)                                // VADDSD XMM0, XMM0, XMM1
        mc_vex2(c, 0, 0, 3, 0x5A, 0xC0)                                // VCVTSD2SS XMM0, XMM0, XMM0
        mc_vex2(c, 0, 0, 2, 0x11, 0x03)                                // VMOVSS [RBX], XMM0
        mc_vex3(c, 1, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xE1, 0x01) // VEXTRACTF128 XMM1, YMM12, 1
        mc_vex2(c, 12, 0, 1, 0x58, 0xC1)                               // VADDPD XMM0, XMM12, XMM1
        mc_vex2(c, 0, 0, 1, 0x15, 0xC8)                                // VUNPCKHPD XMM1, XMM0, XMM0
        mc_vex2(c, 0, 0, 3, 0x58, 0xC1)                                // VADDSD XMM0, XMM0, XMM1
        mc_vex2(c, 0, 0, 3, 0x5A, 0xC0)                                // VCVTSD2SS XMM0, XMM0, XMM0
        mc_vex2(c, 0, 0, 2, 0x11, 0x43); mc_b1(c, 4)                   // VMOVSS [RBX+4], XMM0
        mc_b4(c, 0x48, 0x83, 0xC3, 0x08)
        mc_b4(c, 0x4A, 0x8D, 0x34, 0x4E)                               // LEA RSI, [RSI + R9*2]
        mc_b4(c, 0x49, 0x83, 0xC5, 0x02)
        jmp_q42r := mc_jmp32(c); mc_patch_rel32(c, jmp_q42r, lp_q4_2row)

        // AVX2 1-row tail (uses hoisted XMM6/XMM7)
        mc_patch_rel32(c, jle_q4_1r_a, buf_len(c))
        mc_patch_rel32(c, jz_q4_1r_b, buf_len(c))
        mc_patch_rel32(c, jg_q4_1r, buf_len(c))
        lp_q4_1row := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xFD)
        jge_q4_avxdone := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x48, 0x89, 0xF1)
        mc_b3(c, 0x48, 0x89, 0xFA)
        mc_vex2(c, 0, 0, 1, 0x57, 0xC0) // VXORPD XMM0, XMM0, XMM0
        mc_b3(c, 0x48, 0x85, 0xED)
        jle_q4_1st := mc_jcc32(c, 0x8E)
        mc_b3(c, 0x48, 0x89, 0xE8)
        mc_vex2(c, 4, 1, 1, 0x57, 0xE4)
        lp_q4_blk := buf_len(c)
        mc_vex2(c, 0, 0, 2, 0x6F, 0x49); mc_b1(c, 4)
        mc_vex2(c, 2, 0, 1, 0x71, 0xD1); mc_b1(c, 4)
        mc_vex2(c, 1, 0, 1, 0xDB, 0xCE) // VPAND XMM1, XMM1, XMM6
        mc_vex2(c, 2, 0, 1, 0xDB, 0xD6) // VPAND XMM2, XMM2, XMM6
        mc_vex2(c, 1, 0, 1, 0x60, 0xC2)
        mc_vex2(c, 1, 0, 1, 0x68, 0xCA)
        mc_vex2(c, 0, 0, 1, 0xF8, 0xC7) // VPSUBB XMM0, XMM0, XMM7
        mc_vex2(c, 1, 0, 1, 0xF8, 0xCF) // VPSUBB XMM1, XMM1, XMM7
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x21); mc_b1(c, 0xD0)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xD2)
        mc_vex2(c, 0, 1, 0, 0x10, 0x1A)
        mc_vex2(c, 2, 1, 0, 0x59, 0xEB)
        mc_vex2(c, 0, 0, 1, 0x73, 0xD8); mc_b1(c, 8)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x21); mc_b1(c, 0xD0)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xD2)
        mc_vex2(c, 0, 1, 0, 0x10, 0x5A); mc_b1(c, 0x20)
        mc_vex3(c, 0, 0, 0, 2, 0, 2, 1, 1, 0xB8); mc_b1(c, 0xEB)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x21); mc_b1(c, 0xD1)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xD2)
        mc_vex2(c, 0, 1, 0, 0x10, 0x5A); mc_b1(c, 0x40)
        mc_vex3(c, 0, 0, 0, 2, 0, 2, 1, 1, 0xB8); mc_b1(c, 0xEB)
        mc_vex2(c, 1, 0, 1, 0x73, 0xD9); mc_b1(c, 8)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x21); mc_b1(c, 0xD1)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xD2)
        mc_vex2(c, 0, 1, 0, 0x10, 0x5A); mc_b1(c, 0x60)
        mc_vex3(c, 0, 0, 0, 2, 0, 2, 1, 1, 0xB8); mc_b1(c, 0xEB)
        mc_vex2(c, 0, 1, 0, 0x5A, 0xC5)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xE9, 0x01)
        mc_vex2(c, 0, 1, 0, 0x5A, 0xC9)
        mc_vex2(c, 0, 1, 1, 0x58, 0xC1)
        mc_vex2(c, 2, 0, 2, 0x5A, 0x11)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0xD2)
        mc_vex3(c, 0, 0, 0, 2, 1, 0, 1, 1, 0xB8); mc_b1(c, 0xE2)
        mc_b4(c, 0x48, 0x83, 0xC1, 20)
        mc_b3(c, 0x48, 0x81, 0xC2); mc_u32(c, 128)
        mc_b3(c, 0x48, 0xFF, 0xC8)
        jnz_q4b := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_q4b, lp_q4_blk)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xE1, 0x01)
        mc_vex2(c, 4, 0, 1, 0x58, 0xC1)
        mc_vex2(c, 0, 0, 1, 0x15, 0xC8)
        mc_vex2(c, 0, 0, 3, 0x58, 0xC1)
        mc_patch_rel32(c, jle_q4_1st, buf_len(c))
        mc_b3(c, 0x48, 0x85, 0xDB)
        jz_q4_1ret := mc_jcc8(c, 0x74)
        mc_vex2(c, 0, 0, 3, 0x5A, 0xC8) // VCVTSD2SS XMM1, XMM0, XMM0
        mc_vex2(c, 0, 0, 2, 0x11, 0x0B) // VMOVSS [RBX], XMM1
        mc_b4(c, 0x48, 0x83, 0xC3, 0x04)
        mc_b3(c, 0x4C, 0x01, 0xCE)
        mc_b3(c, 0x49, 0xFF, 0xC5)
        jmp_q41r := mc_jmp32(c); mc_patch_rel32(c, jmp_q41r, lp_q4_1row)
        mc_patch_rel32(c, jge_q4_avxdone, buf_len(c))
        mc_b3(c, 0x48, 0x85, 0xED); jle_q4_nd := mc_jcc8(c, 0x7E)
        mc_b3(c, 0x48, 0x85, 0xDB); jz_q4_nd2 := mc_jcc8(c, 0x74)
        mc_b4(c, 0x48, 0x83, 0xBC, 0x24); mc_u32(c, 128); mc_b1(c, 1); jg_q4_next := mc_jcc32(c, 0x8F); mc_patch_rel32(c, jg_q4_next, lp_q4_dyn)
        mc_patch_jcc8(c, jle_q4_nd, buf_len(c))
        mc_patch_jcc8(c, jz_q4_nd2, buf_len(c))
        mc_patch_jcc8(c, jz_q4_1ret, buf_len(c))
        mc_patch_rel32(c, jge_q4_dyn_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)      // VZEROUPPER ONCE!
        jmp_q4_alldone := mc_jmp32(c)

        // Scalar SSE2 Q4_0 fallback
        mc_patch_rel32(c, jz_q4_sc_rows, buf_len(c))
        lp_q4_sc_row := buf_len(c)
        mc_b3(c, 0x48, 0x89, 0xF1)
        mc_b3(c, 0x48, 0x89, 0xFA)
        mc_b3(c, 0x0F, 0x57, 0xC0)
        mc_b3(c, 0x48, 0x85, 0xED)
        jle_q4_sc_st := mc_jcc32(c, 0x8E)
        mc_b3(c, 0x49, 0x89, 0xEA)
        lp_q4_sb2 := buf_len(c)
        mc_b3(c, 0x0F, 0x57, 0xC9)
        mc_b4(c, 0x4C, 0x8D, 0x59, 0x04)
        mc_b2(c, 0x41, 0xB8); mc_u32(c, 16)
        lp_q4_si2 := buf_len(c)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x03)
        mc_b3(c, 0x83, 0xE0, 0x0F); mc_b3(c, 0x83, 0xE8, 0x08)
        mc_b4(c, 0xF2, 0x0F, 0x2A, 0xD0)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x1A); mc_b4(c, 0xF3, 0x0F, 0x5A, 0xDB)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xD3); mc_b4(c, 0xF2, 0x0F, 0x58, 0xCA)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x03); mc_b3(c, 0xC1, 0xE8, 0x04); mc_b3(c, 0x83, 0xE8, 0x08)
        mc_b4(c, 0xF2, 0x0F, 0x2A, 0xD0)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x5A); mc_b1(c, 4); mc_b4(c, 0xF3, 0x0F, 0x5A, 0xDB)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xD3); mc_b4(c, 0xF2, 0x0F, 0x58, 0xCA)
        mc_b3(c, 0x49, 0xFF, 0xC3)
        mc_b4(c, 0x48, 0x83, 0xC2, 0x08)
        mc_b3(c, 0x41, 0xFF, 0xC8)
        jnz_q4si := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_q4si, lp_q4_si2)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x11); mc_b4(c, 0xF3, 0x0F, 0x5A, 0xD2)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xCA); mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)
        mc_b4(c, 0x48, 0x83, 0xC1, 20)
        mc_b3(c, 0x49, 0xFF, 0xCA)
        jnz_q4sb := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_q4sb, lp_q4_sb2)
        mc_patch_rel32(c, jle_q4_sc_st, buf_len(c))
        mc_b3(c, 0x48, 0x85, 0xDB)
        jz_q4e := mc_jcc8(c, 0x74)
        mc_b4(c, 0xF2, 0x0F, 0x5A, 0xC8)
        mc_b4(c, 0xF3, 0x0F, 0x11, 0x0B)
        mc_b4(c, 0x48, 0x83, 0xC3, 0x04)
        mc_b3(c, 0x4C, 0x01, 0xCE)
        mc_b3(c, 0x49, 0xFF, 0xC5)
        mc_b3(c, 0x4D, 0x39, 0xFD)
        jl_q4r := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_q4r, lp_q4_sc_row)

        mc_patch_jcc8(c, jz_q4e, buf_len(c))
        mc_patch_rel32(c, jmp_q4_alldone, buf_len(c))
        mc_patch_rel32(c, jge_q4e, buf_len(c))
        // Restore XMM6..XMM13
        mc_b4(c, 0x0F, 0x10, 0x74, 0x24); mc_b1(c, 0)
        mc_b4(c, 0x0F, 0x10, 0x7C, 0x24); mc_b1(c, 16)
        mc_b4(c, 0x44, 0x0F, 0x10, 0x44); mc_b2(c, 0x24, 32)
        mc_b4(c, 0x44, 0x0F, 0x10, 0x4C); mc_b2(c, 0x24, 48)
        mc_b4(c, 0x44, 0x0F, 0x10, 0x54); mc_b2(c, 0x24, 64)
        mc_b4(c, 0x44, 0x0F, 0x10, 0x5C); mc_b2(c, 0x24, 80)
        mc_b4(c, 0x44, 0x0F, 0x10, 0x64); mc_b2(c, 0x24, 96)
        mc_b4(c, 0x44, 0x0F, 0x10, 0x6C); mc_b2(c, 0x24, 112)
        mc_ai_leave(c, 0x98)

        mc_align16(c)
        s_pub := buf_len(c)
        mc_ai_enter(c, 0x48)
        mc_b3(c, 0x48, 0x85, 0xC9)
        jns_q4b := mc_jcc32(c, 0x89)
        mc_b4(c, 0x48, 0x89, 0x54, 0x24); mc_b1(c, 0)
        mc_b4(c, 0x4C, 0x89, 0x44, 0x24); mc_b1(c, 8)
        mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 16); mc_u32(c, 0)
        mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 24); mc_u32(c, 1)
        mc_b4(c, 0x4C, 0x89, 0x4C, 0x24); mc_b1(c, 32)
        mc_b2(c, 0x31, 0xC9); mc_b1(c, 0xBA); mc_u32(c, 1)
        mc_b4(c, 0x4C, 0x8D, 0x44, 0x24); mc_b1(c, 0 - 32)
        mc_b1(c, 0xE8); mc_u32(c, s_wk - (buf_len(c) + 4))
        jmp_q4fin := mc_jmp32(c)
        mc_patch_rel32(c, jns_q4b, buf_len(c))
        mc_b3(c, 0x48, 0x89, 0xCB)
        mc_b4(c, 0x48, 0x8B, 0x43, 24)
        mc_b3(c, 0x48, 0x85, 0xC0)
        jle_q4done := mc_jcc32(c, 0x8E)
        mc_b4(c, 0x48, 0x0F, 0xAF, 0x43); mc_b1(c, 32)
        mc_b2(c, 0x48, 0x3D); mc_u32(c, 512)
        jge_q4p := mc_jcc8(c, 0x7D)
        mc_b2(c, 0x31, 0xC9); mc_b1(c, 0xBA); mc_u32(c, 1)
        mc_b4(c, 0x4C, 0x8D, 0x43, 0xE0)
        mc_b1(c, 0xE8); mc_u32(c, s_wk - (buf_len(c) + 4))
        jmp_q4done := mc_jmp32(c)
        mc_patch_jcc8(c, jge_q4p, buf_len(c))
        mc_b3(c, 0x48, 0x8D, 0x0D); mc_u32(c, s_wk - (buf_len(c) + 4))
        mc_b3(c, 0x48, 0x89, 0xDA)
        cg_call_fn(cg, h_ai_pool_dispatch())
        mc_patch_rel32(c, jle_q4done, buf_len(c))
        mc_patch_rel32(c, jmp_q4done, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_patch_rel32(c, jmp_q4fin, buf_len(c))
        mc_ai_leave(c, 0x48)
        cg_reg_helper(cg, h_ai_gemv_q4_0(), s_pub, buf_len(c))
    }

    // 8. `h_ai_gemv_bitnet`: batch `args=[act, bn, out, rows, nblk]` (12B blocks)
    if cg_is_helper_used(cg, h_ai_gemv_bitnet()) {
        mc_align16(c)
        s_wk := buf_len(c)
        // [RSP+0..31] = shift [0,2,4,6,8,10,12,14], [RSP+32..63] = [1*8]
        mc_ai_enter(c, 0x48)
        mc_b3(c, 0x4D, 0x89, 0xC4)
        mut si := 0
        while si < 8 {
            mc_b4(c, 0xC7, 0x44, 0x24, si * 4); mc_u32(c, si * 2)
            mc_b4(c, 0xC7, 0x44, 0x24, 32 + si * 4); mc_u32(c, 1)
            si += 1
        }
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 56) // rows
        mc_ai_row_range(c)
        mc_b3(c, 0x4D, 0x39, 0xFE)
        jge_bne := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x49, 0x8B, 0x6C, 0x24); mc_b1(c, 64) // RBP = nblk
        mc_b4(c, 0x49, 0x8B, 0x7C, 0x24); mc_b1(c, 32) // RDI = act
        mc_b4(c, 0x49, 0x8B, 0x5C, 0x24); mc_b1(c, 48) // RBX = out
        mc_b4(c, 0x4A, 0x8D, 0x1C, 0xB3)
        mc_b3(c, 0x4C, 0x69, 0xCD); mc_u32(c, 12)       // R9 = nblk * 12
        mc_b4(c, 0x49, 0x8B, 0x74, 0x24); mc_b1(c, 40) // RSI = bn
        mc_b3(c, 0x4C, 0x89, 0xF0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC1)
        mc_b3(c, 0x48, 0x01, 0xC6)
        mc_b3(c, 0x4D, 0x89, 0xF5)

        lp_bn_r := buf_len(c)
        mc_b3(c, 0x48, 0x89, 0xF1)
        mc_b3(c, 0x48, 0x89, 0xFA)
        mc_b3(c, 0x0F, 0x57, 0xC0)
        mc_b3(c, 0x48, 0x85, 0xED)
        jle_bn_rs := mc_jcc32(c, 0x8E)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_bn_sc := mc_jcc32(c, 0x84)

        mc_b3(c, 0x48, 0x89, 0xE8)
        mc_vex2(c, 4, 1, 0, 0x57, 0xE4) // VXORPS YMM4, YMM4, YMM4
        lp_bn_b := buf_len(c)
        // First 16 weights from [RCX+4]
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x58); mc_b2(c, 0x41, 4) // VPBROADCASTD YMM0, [RCX+4]
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x45); mc_b2(c, 0x0C, 0x24) // VPSRLVD YMM1, YMM0, [RSP]
        mc_vex2(c, 2, 1, 1, 0x72, 0xD1); mc_b1(c, 1)
        mc_vex2(c, 1, 1, 1, 0xDB, 0x4C); mc_b2(c, 0x24, 32)
        mc_vex2(c, 2, 1, 1, 0xDB, 0x54); mc_b2(c, 0x24, 32)
        mc_vex2(c, 1, 1, 1, 0xFA, 0xCA)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex2(c, 0, 1, 0, 0x10, 0x12)
        mc_vex2(c, 1, 1, 0, 0x59, 0xEA) // VMULPS YMM5, YMM1, YMM2
        mc_vex2(c, 0, 1, 1, 0x72, 0xD0); mc_b1(c, 16)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x45); mc_b2(c, 0x0C, 0x24)
        mc_vex2(c, 2, 1, 1, 0x72, 0xD1); mc_b1(c, 1)
        mc_vex2(c, 1, 1, 1, 0xDB, 0x4C); mc_b2(c, 0x24, 32)
        mc_vex2(c, 2, 1, 1, 0xDB, 0x54); mc_b2(c, 0x24, 32)
        mc_vex2(c, 1, 1, 1, 0xFA, 0xCA)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex2(c, 0, 1, 0, 0x10, 0x52); mc_b1(c, 0x20)
        mc_vex3(c, 0, 0, 0, 2, 0, 1, 1, 1, 0xB8); mc_b1(c, 0xEA)
        // Second 16 weights from [RCX+8]
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x58); mc_b2(c, 0x41, 8)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x45); mc_b2(c, 0x0C, 0x24)
        mc_vex2(c, 2, 1, 1, 0x72, 0xD1); mc_b1(c, 1)
        mc_vex2(c, 1, 1, 1, 0xDB, 0x4C); mc_b2(c, 0x24, 32)
        mc_vex2(c, 2, 1, 1, 0xDB, 0x54); mc_b2(c, 0x24, 32)
        mc_vex2(c, 1, 1, 1, 0xFA, 0xCA)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex2(c, 0, 1, 0, 0x10, 0x52); mc_b1(c, 0x40)
        mc_vex3(c, 0, 0, 0, 2, 0, 1, 1, 1, 0xB8); mc_b1(c, 0xEA)
        mc_vex2(c, 0, 1, 1, 0x72, 0xD0); mc_b1(c, 16)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x45); mc_b2(c, 0x0C, 0x24)
        mc_vex2(c, 2, 1, 1, 0x72, 0xD1); mc_b1(c, 1)
        mc_vex2(c, 1, 1, 1, 0xDB, 0x4C); mc_b2(c, 0x24, 32)
        mc_vex2(c, 2, 1, 1, 0xDB, 0x54); mc_b2(c, 0x24, 32)
        mc_vex2(c, 1, 1, 1, 0xFA, 0xCA)
        mc_vex2(c, 0, 1, 0, 0x5B, 0xC9)
        mc_vex2(c, 0, 1, 0, 0x10, 0x52); mc_b1(c, 0x60)
        mc_vex3(c, 0, 0, 0, 2, 0, 1, 1, 1, 0xB8); mc_b1(c, 0xEA)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b1(c, 0x11)
        mc_vex3(c, 0, 0, 0, 2, 0, 5, 1, 1, 0xB8); mc_b1(c, 0xE2)
        mc_b4(c, 0x48, 0x83, 0xC1, 12)
        mc_b3(c, 0x48, 0x81, 0xC2); mc_u32(c, 128)
        mc_b3(c, 0x48, 0xFF, 0xC8)
        jnz_bnb := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_bnb, lp_bn_b)
        mc_vex2(c, 0, 1, 0, 0x28, 0xC4)
        mc_avx_hsum_ymm0(c)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_bn_st := mc_jmp32(c)

        // Scalar SSE2 fallback
        mc_patch_rel32(c, jz_bn_sc, buf_len(c))
        mc_b3(c, 0x49, 0x89, 0xEA)
        lp_bn_sb := buf_len(c)
        mc_b3(c, 0x0F, 0x57, 0xC9)       // XMM1 = block_sum (f32)
        mc_b4(c, 0x4C, 0x8D, 0x59, 0x04) // R11 = RCX + 4
        mc_b2(c, 0x41, 0xB8); mc_u32(c, 8)
        lp_bn_si := buf_len(c)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x03) // EAX = byte [R11]
        mut kk := 0
        while kk < 4 {
            mc_b4(c, 0xF3, 0x0F, 0x10, 0x52); mc_b1(c, kk * 4)
            mc_b3(c, 0xA8, 0x01, 0x74)
            mc_b1(c, 6)
            mc_b4(c, 0xF3, 0x0F, 0x58, 0xCA)
            mc_b2(c, 0xEB, 8)
            mc_b3(c, 0xA8, 0x02, 0x74)
            mc_b1(c, 4)
            mc_b4(c, 0xF3, 0x0F, 0x5C, 0xCA)
            mc_b3(c, 0xC1, 0xE8, 0x02)
            kk += 1
        }
        mc_b3(c, 0x49, 0xFF, 0xC3)
        mc_b4(c, 0x48, 0x83, 0xC2, 16)
        mc_b3(c, 0x41, 0xFF, 0xC8)
        jnz_bnsi := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_bnsi, lp_bn_si)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0x09) // MULSS XMM1, [RCX]
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1) // ADDSS XMM0, XMM1
        mc_b4(c, 0x48, 0x83, 0xC1, 12)
        mc_b3(c, 0x49, 0xFF, 0xCA)
        jnz_bnsb := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_bnsb, lp_bn_sb)

        mc_patch_rel32(c, jmp_bn_st, buf_len(c))
        mc_patch_rel32(c, jle_bn_rs, buf_len(c))
        mc_b4(c, 0xF3, 0x0F, 0x11, 0x03)
        mc_b4(c, 0x48, 0x83, 0xC3, 0x04)
        mc_b3(c, 0x4C, 0x01, 0xCE)
        mc_b3(c, 0x49, 0xFF, 0xC5)
        mc_b3(c, 0x4D, 0x39, 0xFD)
        jl_bnr := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_bnr, lp_bn_r)
        mc_patch_rel32(c, jge_bne, buf_len(c))
        mc_ai_leave(c, 0x48)
        mc_ai_emit_batch_pub(cg, h_ai_gemv_bitnet(), s_wk, 3, 4, 512)
    }

    // 9. `h_ai_gemv_bnn`: batch `args=[act, bnn, out, rows, nblk]` (pre-binarizes `act` once -> XNOR + POPCNT)
    if cg_is_helper_used(cg, h_ai_gemv_bnn()) {
        mc_align16(c)
        s_wk := buf_len(c)
        mc_ai_enter(c, 0x28)
        mc_b3(c, 0x4D, 0x89, 0xC4) // R12 = pool
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 56)
        mc_ai_row_range(c)
        mc_b3(c, 0x4D, 0x39, 0xFE)
        jge_be := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x49, 0x8B, 0x6C, 0x24); mc_b1(c, 64) // RBP = nblk
        mc_b4(c, 0x49, 0x8B, 0x7C, 0x24); mc_b1(c, 72) // RDI = act_bin (`p5`)
        mc_b4(c, 0x49, 0x8B, 0x5C, 0x24); mc_b1(c, 48) // RBX = out
        mc_b4(c, 0x4A, 0x8D, 0x1C, 0xB3)
        mc_b4(c, 0x4C, 0x8D, 0x0C, 0xED); mc_u32(c, 0) // R9 = nblk * 8
        mc_b4(c, 0x49, 0x8B, 0x74, 0x24); mc_b1(c, 40) // RSI = bnn
        mc_b3(c, 0x4C, 0x89, 0xF0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC1)
        mc_b3(c, 0x48, 0x01, 0xC6)
        mc_b3(c, 0x4D, 0x89, 0xF5)

        lp_bnn_r := buf_len(c)
        mc_b3(c, 0x48, 0x89, 0xF1) // RCX = bnn_row
        mc_b3(c, 0x48, 0x89, 0xFA) // RDX = act_bin
        mc_b3(c, 0x49, 0x89, 0xE8) // R8 = nblk
        mc_b3(c, 0x0F, 0x57, 0xC0) // XORPS XMM0, XMM0
        mc_b3(c, 0x4D, 0x85, 0xC0)
        jle_bnn_s := mc_jcc8(c, 0x7E)
        lp_bnn_b := buf_len(c)
        mc_b2(c, 0x8B, 0x02)             // MOV EAX, [RDX]
        mc_b3(c, 0x33, 0x41, 0x04)       // XOR EAX, [RCX + 4]
        mc_b4(c, 0xF3, 0x0F, 0xB8, 0xC0) // POPCNT EAX, EAX
        mc_b2(c, 0x01, 0xC0)             // EAX *= 2
        mc_b2(c, 0x41, 0xBA); mc_u32(c, 32)
        mc_b3(c, 0x41, 0x29, 0xC2)       // R10D = 32 - 2*popcnt
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x2A); mc_b1(c, 0xCA) // CVTSI2SS XMM1, R10D
        mc_b4(c, 0xF3, 0x0F, 0x59, 0x09) // MULSS XMM1, [RCX]
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1) // ADDSS XMM0, XMM1
        mc_b4(c, 0x48, 0x83, 0xC1, 0x08)
        mc_b4(c, 0x48, 0x83, 0xC2, 0x04)
        mc_b3(c, 0x49, 0xFF, 0xC8)
        jnz_bnn_b := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_bnn_b, lp_bnn_b)
        mc_patch_jcc8(c, jle_bnn_s, buf_len(c))
        mc_b4(c, 0xF3, 0x0F, 0x11, 0x03)
        mc_b4(c, 0x48, 0x83, 0xC3, 0x04)
        mc_b3(c, 0x4C, 0x01, 0xCE)
        mc_b3(c, 0x49, 0xFF, 0xC5)
        mc_b3(c, 0x4D, 0x39, 0xFD)
        jl_bnn_r := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_bnn_r, lp_bnn_r)
        mc_patch_rel32(c, jge_be, buf_len(c))
        mc_ai_leave(c, 0x28)

        // Custom public dispatcher for BNN: pre-binarizes `act` into temp buffer (`nblk * 4`), dispatches, frees!
        mc_align16(c)
        s_pub := buf_len(c)
        mc_ai_enter(c, 0x48)
        mc_b3(c, 0x48, 0x89, 0xCB)       // RBX = args_ptr
        mc_b4(c, 0x48, 0x8B, 0x43, 24)   // rows
        mc_b3(c, 0x48, 0x85, 0xC0)
        jle_bp := mc_jcc32(c, 0x8E)
        mc_b4(c, 0x48, 0x8B, 0x4B, 32)   // RCX = nblk
        mc_b3(c, 0x48, 0x85, 0xC9)
        jle_bp2 := mc_jcc32(c, 0x8E)
        mc_b3(c, 0x48, 0xC1, 0xE1); mc_b1(c, 2) // RCX = nblk * 4
        cg_call_fn(cg, h_alloc_mem())
        mc_b3(c, 0x49, 0x89, 0xC4)       // R12 = act_bin
        // Copy args [0..4] to [RSP+0..32] + set [RSP+40] = act_bin
        mut bi := 0
        while bi < 5 {
            mc_b4(c, 0x48, 0x8B, 0x43, bi * 8)
            mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, bi * 8)
            bi += 1
        }
        mc_b4(c, 0x4C, 0x89, 0x64, 0x24); mc_b1(c, 40)
        // Binarize act -> act_bin (`32` floats per `u32` block)
        mc_b3(c, 0x48, 0x8B, 0x33)       // RSI = act
        mc_b3(c, 0x4C, 0x89, 0xE7)       // RDI = act_bin
        mc_b4(c, 0x48, 0x8B, 0x6B, 32)   // RBP = nblk
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_bpin_sc := mc_jcc32(c, 0x84)
        mc_vex2(c, 5, 1, 0, 0x57, 0xED)  // VXORPS YMM5, YMM5, YMM5
        lp_bpin := buf_len(c)
        mc_vex2(c, 0, 1, 0, 0x10, 0x0E)                         // VMOVUPS YMM1, [RSI]
        mc_vex2(c, 1, 1, 0, 0xC2, 0xC5); mc_b1(c, 0x0D)         // VCMPPS YMM0, YMM1, YMM5, 13 (>= 0)
        mc_vex2(c, 0, 1, 0, 0x50, 0xC0)                         // VMOVMSKPS EAX, YMM0
        mc_vex2(c, 0, 1, 0, 0x10, 0x4E); mc_b1(c, 0x20)
        mc_vex2(c, 1, 1, 0, 0xC2, 0xCD); mc_b1(c, 0x0D)
        mc_vex2(c, 0, 1, 0, 0x50, 0xD1); mc_b3(c, 0xC1, 0xE2, 8); mc_b2(c, 0x09, 0xD0)
        mc_vex2(c, 0, 1, 0, 0x10, 0x4E); mc_b1(c, 0x40)
        mc_vex2(c, 1, 1, 0, 0xC2, 0xCD); mc_b1(c, 0x0D)
        mc_vex2(c, 0, 1, 0, 0x50, 0xD1); mc_b3(c, 0xC1, 0xE2, 16); mc_b2(c, 0x09, 0xD0)
        mc_vex2(c, 0, 1, 0, 0x10, 0x4E); mc_b1(c, 0x60)
        mc_vex2(c, 1, 1, 0, 0xC2, 0xCD); mc_b1(c, 0x0D)
        mc_vex2(c, 0, 1, 0, 0x50, 0xD1); mc_b3(c, 0xC1, 0xE2, 24); mc_b2(c, 0x09, 0xD0)
        mc_b2(c, 0x89, 0x07)             // MOV [RDI], EAX
        mc_b3(c, 0x48, 0x81, 0xC6); mc_u32(c, 128)
        mc_b4(c, 0x48, 0x83, 0xC7, 4)
        mc_b3(c, 0x48, 0xFF, 0xCD)
        jnz_bpin := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_bpin, lp_bpin)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_bpin_d := mc_jmp32(c)
        mc_patch_rel32(c, jz_bpin_sc, buf_len(c))
        mc_b3(c, 0x0F, 0x57, 0xC9) // XMM1 = 0.0
        lp_bpin_s := buf_len(c)
        mc_b2(c, 0x31, 0xC0); mc_b2(c, 0x31, 0xC9)
        lp_bp_i := buf_len(c)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x06) // MOVSS XMM0, [RSI]
        mc_b4(c, 0x0F, 0x2F, 0xC1, 0x72); mc_b1(c, 9) // COMISS XMM0, XMM1; JB skip (9B)
        mc_b1(c, 0xBA); mc_u32(c, 1); mc_b2(c, 0xD3, 0xE2); mc_b2(c, 0x09, 0xD0)
        mc_b4(c, 0x48, 0x83, 0xC6, 4); mc_b2(c, 0xFF, 0xC1); mc_b3(c, 0x83, 0xF9, 32)
        jl_bpi := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_bpi, lp_bp_i)
        mc_b2(c, 0x89, 0x07); mc_b4(c, 0x48, 0x83, 0xC7, 4); mc_b3(c, 0x48, 0xFF, 0xCD)
        jnz_bpis := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_bpis, lp_bpin_s)
        mc_patch_rel32(c, jmp_bpin_d, buf_len(c))

        mc_b4(c, 0x48, 0x8B, 0x43, 24)
        mc_b4(c, 0x48, 0x0F, 0xAF, 0x43); mc_b1(c, 32)
        mc_b2(c, 0x48, 0x3D); mc_u32(c, 512)
        jge_bnp := mc_jcc8(c, 0x7D)
        mc_b2(c, 0x31, 0xC9); mc_b1(c, 0xBA); mc_u32(c, 1)
        mc_b4(c, 0x4C, 0x8D, 0x44, 0x24); mc_b1(c, 0 - 32)
        mc_b1(c, 0xE8); mc_u32(c, s_wk - (buf_len(c) + 4))
        jmp_bnfree := mc_jmp32(c)
        mc_patch_jcc8(c, jge_bnp, buf_len(c))
        mc_b3(c, 0x48, 0x8D, 0x0D); mc_u32(c, s_wk - (buf_len(c) + 4))
        mc_b3(c, 0x48, 0x89, 0xE2)
        cg_call_fn(cg, h_ai_pool_dispatch())
        mc_patch_rel32(c, jmp_bnfree, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xE1)
        cg_call_fn(cg, h_free_mem())
        mc_patch_rel32(c, jle_bp, buf_len(c))
        mc_patch_rel32(c, jle_bp2, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_ai_leave(c, 0x48)
        cg_reg_helper(cg, h_ai_gemv_bnn(), s_pub, buf_len(c))
    }
}

fn emit_ai_vec_norm_helpers(cg: CodegenCtx) {
    c := cg.code

    // 10. `h_ai_l2_batch`: args = `[db_ptr, q_ptr, out_ptr, nvecs, dim]`
    if cg_is_helper_used(cg, h_ai_l2_batch()) {
        mc_align16(c)
        s_wk := buf_len(c)
        mc_ai_enter(c, 0x28)
        mc_b3(c, 0x4D, 0x89, 0xC4)
        mc_b4(c, 0x49, 0x8B, 0x44, 0x24); mc_b1(c, 56) // nvecs
        mc_ai_row_range(c)
        mc_b3(c, 0x4D, 0x39, 0xFE)
        jge_l2e := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4D, 0x8B, 0x44, 0x24); mc_b1(c, 64) // R8 = dim
        mc_b4(c, 0x49, 0x8B, 0x7C, 0x24); mc_b1(c, 40) // RDI = q_ptr
        mc_b4(c, 0x49, 0x8B, 0x5C, 0x24); mc_b1(c, 48) // RBX = out
        mc_b4(c, 0x4A, 0x8D, 0x1C, 0xB3)
        mc_b3(c, 0x4D, 0x89, 0xC1)                     // MOV R9, R8
        mc_b4(c, 0x49, 0xC1, 0xE1, 0x02)               // R9 = dim * 4
        mc_b4(c, 0x49, 0x8B, 0x74, 0x24); mc_b1(c, 32) // RSI = db_ptr
        mc_b3(c, 0x4C, 0x89, 0xF0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC1)
        mc_b3(c, 0x48, 0x01, 0xC6)
        mc_b3(c, 0x4D, 0x89, 0xF5)

        lp_l2v := buf_len(c)
        mc_b3(c, 0x48, 0x89, 0xF1)       // RCX = db_row
        mc_b3(c, 0x48, 0x89, 0xFA)       // RDX = q_ptr
        mc_b4(c, 0x4A, 0x8D, 0x2C, 0x0A) // RBP = RDX + R9 (q_end)
        mc_b3(c, 0x0F, 0x57, 0xC0)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_l2sc := mc_jcc32(c, 0x84)
        mc_vex2(c, 0, 1, 0, 0x57, 0xC0)
        mc_vex2(c, 1, 1, 0, 0x57, 0xC9)
        mc_vex2(c, 2, 1, 0, 0x57, 0xD2)
        mc_vex2(c, 3, 1, 0, 0x57, 0xDB)
        mc_b3(c, 0x48, 0x89, 0xE8); mc_b2(c, 0x48, 0x2D); mc_u32(c, 128)
        lp_l2_32 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC2)
        ja_l2_8 := mc_jcc32(c, 0x87)
        mc_vex2(c, 0, 1, 0, 0x10, 0x21); mc_vex2(c, 4, 1, 0, 0x5C, 0x22)
        mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0xC4)
        mc_vex2(c, 0, 1, 0, 0x10, 0x69); mc_b1(c, 0x20); mc_vex2(c, 5, 1, 0, 0x5C, 0x6A); mc_b1(c, 0x20)
        mc_vex3(c, 0, 0, 0, 2, 0, 5, 1, 1, 0xB8); mc_b1(c, 0xCD)
        mc_vex2(c, 0, 1, 0, 0x10, 0x61); mc_b1(c, 0x40); mc_vex2(c, 4, 1, 0, 0x5C, 0x62); mc_b1(c, 0x40)
        mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0xD4)
        mc_vex2(c, 0, 1, 0, 0x10, 0x69); mc_b1(c, 0x60); mc_vex2(c, 5, 1, 0, 0x5C, 0x6A); mc_b1(c, 0x60)
        mc_vex3(c, 0, 0, 0, 2, 0, 5, 1, 1, 0xB8); mc_b1(c, 0xDD)
        mc_b3(c, 0x48, 0x81, 0xC1); mc_u32(c, 128)
        mc_b3(c, 0x48, 0x81, 0xC2); mc_u32(c, 128)
        jmp_l232 := mc_jmp32(c); mc_patch_rel32(c, jmp_l232, lp_l2_32)
        mc_patch_rel32(c, ja_l2_8, buf_len(c))
        mc_b4(c, 0x48, 0x8D, 0x45, 0xE0) // RAX = q_end - 32
        lp_l2_8 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC2)
        ja_l2red := mc_jcc8(c, 0x77)
        mc_vex2(c, 0, 1, 0, 0x10, 0x21); mc_vex2(c, 4, 1, 0, 0x5C, 0x22)
        mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0xC4)
        mc_b4(c, 0x48, 0x83, 0xC1, 32); mc_b4(c, 0x48, 0x83, 0xC2, 32)
        jmp_l28 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_l28, lp_l2_8)
        mc_patch_jcc8(c, ja_l2red, buf_len(c))
        mc_vex2(c, 0, 1, 0, 0x58, 0xC1); mc_vex2(c, 2, 1, 0, 0x58, 0xD3); mc_vex2(c, 0, 1, 0, 0x58, 0xC2)
        mc_avx_hsum_ymm0(c)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_patch_rel32(c, jz_l2sc, buf_len(c))
        lp_l2sc := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xEA)
        jae_l2st := mc_jcc8(c, 0x73)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x09); mc_b4(c, 0xF3, 0x0F, 0x5C, 0x0A)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xC9); mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b4(c, 0x48, 0x83, 0xC2, 4)
        jmp_l2s := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_l2s, lp_l2sc)
        mc_patch_jcc8(c, jae_l2st, buf_len(c))
        mc_b4(c, 0xF3, 0x0F, 0x11, 0x03)
        mc_b4(c, 0x48, 0x83, 0xC3, 4)
        mc_b3(c, 0x4C, 0x01, 0xCE)
        mc_b3(c, 0x49, 0xFF, 0xC5)
        mc_b3(c, 0x4D, 0x39, 0xFD)
        jl_l2v := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_l2v, lp_l2v)
        mc_patch_rel32(c, jge_l2e, buf_len(c))
        mc_ai_leave(c, 0x28)
        mc_ai_emit_batch_pub(cg, h_ai_l2_batch(), s_wk, 3, 4, 16384)
    }

    // 11. `h_ai_rmsnorm`: `RCX = args_ptr = [x, w, out, dim, eps_f64]`
    if cg_is_helper_used(cg, h_ai_rmsnorm()) {
        mc_align16(c)
        s_rm := buf_len(c)
        mc_ai_enter(c, 0x28)
        mc_b3(c, 0x49, 0x89, 0xCC)       // R12 = args_ptr
        mc_b4(c, 0x49, 0x8B, 0x4C, 0x24); mc_b1(c, 0)  // x
        mc_b4(c, 0x49, 0x8B, 0x54, 0x24); mc_b1(c, 8)  // w
        mc_b4(c, 0x49, 0x8B, 0x7C, 0x24); mc_b1(c, 16) // out
        mc_b4(c, 0x49, 0x8B, 0x5C, 0x24); mc_b1(c, 24) // RBX = dim
        mc_b3(c, 0x48, 0x85, 0xDB)
        jle_rme := mc_jcc32(c, 0x8E)

        mc_b4(c, 0x48, 0x8D, 0x2C, 0x99) // RBP = x + dim*4 (x_end)
        mc_b3(c, 0x48, 0x89, 0xCE)       // RSI = x_cur
        mc_b3(c, 0x0F, 0x57, 0xC0)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_rm_s1 := mc_jcc32(c, 0x84)
        mc_vex2(c, 0, 1, 0, 0x57, 0xC0); mc_vex2(c, 1, 1, 0, 0x57, 0xC9)
        mc_b3(c, 0x48, 0x89, 0xE8); mc_b4(c, 0x48, 0x83, 0xE8, 64)
        lp_rm16 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC6)
        ja_rm8 := mc_jcc8(c, 0x77)
        mc_vex2(c, 0, 1, 0, 0x10, 0x26); mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0xC4)
        mc_vex2(c, 0, 1, 0, 0x10, 0x6E); mc_b1(c, 32); mc_vex3(c, 0, 0, 0, 2, 0, 5, 1, 1, 0xB8); mc_b1(c, 0xCD)
        mc_b4(c, 0x48, 0x83, 0xC6, 64)
        jmp_rm16 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_rm16, lp_rm16)
        mc_patch_jcc8(c, ja_rm8, buf_len(c))
        mc_vex2(c, 0, 1, 0, 0x58, 0xC1)
        mc_b4(c, 0x48, 0x8D, 0x45, 0xE0)
        lp_rm8 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC6)
        ja_rmr := mc_jcc8(c, 0x77)
        mc_vex2(c, 0, 1, 0, 0x10, 0x26); mc_vex3(c, 0, 0, 0, 2, 0, 4, 1, 1, 0xB8); mc_b1(c, 0xC4)
        mc_b4(c, 0x48, 0x83, 0xC6, 32)
        jmp_rm8 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_rm8, lp_rm8)
        mc_patch_jcc8(c, ja_rmr, buf_len(c))
        mc_avx_hsum_ymm0(c)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_patch_rel32(c, jz_rm_s1, buf_len(c))
        lp_rm_s1 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xEE)
        jae_rm_inv := mc_jcc8(c, 0x73)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x0E); mc_b4(c, 0xF3, 0x0F, 0x59, 0xC9); mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1)
        mc_b4(c, 0x48, 0x83, 0xC6, 4)
        jmp_rm_s1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_rm_s1, lp_rm_s1)

        // Compute `inv_rms = (float)(1.0 / sqrt((double)ss / dim + eps_f64))`
        mc_patch_jcc8(c, jae_rm_inv, buf_len(c))
        mc_b4(c, 0xF3, 0x0F, 0x5A, 0xC0)             // CVTSS2SD XMM0, XMM0
        mc_b4(c, 0xF2, 0x48, 0x0F, 0x2A); mc_b1(c, 0xCB) // CVTSI2SD XMM1, RBX
        mc_b4(c, 0xF2, 0x0F, 0x5E, 0xC1)             // DIVSD XMM0, XMM1
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x44, 0x24); mc_b1(c, 32) // ADDSD XMM0, [R12+32]
        mc_b4(c, 0xF2, 0x0F, 0x51, 0xC0)             // SQRTSD XMM0, XMM0
        mc_b1(c, 0xB8); mc_u32(c, 1)
        mc_b4(c, 0xF2, 0x0F, 0x2A, 0xC8)             // CVTSI2SD XMM1, EAX
        mc_b4(c, 0xF2, 0x0F, 0x5E, 0xC8)             // DIVSD XMM1, XMM0
        mc_b4(c, 0xF2, 0x0F, 0x5A, 0xD1)             // CVTSD2SS XMM2, XMM1

        // Pass 2: `out[i] = x[i] * inv_rms * w[i]` (`RCX=x, RDX=w, RDI=out, RBP=x_end`)
        mc_b3(c, 0x48, 0x89, 0xCE)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_rm_s2 := mc_jcc32(c, 0x84)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b1(c, 0xD2) // VBROADCASTSS YMM2, XMM2
        mc_b4(c, 0x48, 0x8D, 0x45, 0xE0) // RAX = x_end - 32
        lp_rm2_8 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC1)
        ja_rm2_sc := mc_jcc8(c, 0x77)
        mc_vex2(c, 0, 1, 0, 0x10, 0x01) // VMOVUPS YMM0, [RCX]
        mc_vex2(c, 0, 1, 0, 0x59, 0xC2) // VMULPS YMM0, YMM0, YMM2
        mc_vex2(c, 0, 1, 0, 0x59, 0x02) // VMULPS YMM0, YMM0, [RDX]
        mc_vex2(c, 0, 1, 0, 0x11, 0x07) // VMOVUPS [RDI], YMM0
        mc_b4(c, 0x48, 0x83, 0xC1, 32); mc_b4(c, 0x48, 0x83, 0xC2, 32); mc_b4(c, 0x48, 0x83, 0xC7, 32)
        jmp_rm28 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_rm28, lp_rm2_8)
        mc_patch_jcc8(c, ja_rm2_sc, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_patch_rel32(c, jz_rm_s2, buf_len(c))
        lp_rm_s2 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xE9)
        jae_rme := mc_jcc8(c, 0x73)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x01); mc_b4(c, 0xF3, 0x0F, 0x59, 0xC2)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0x02); mc_b4(c, 0xF3, 0x0F, 0x11, 0x07)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b4(c, 0x48, 0x83, 0xC2, 4); mc_b4(c, 0x48, 0x83, 0xC7, 4)
        jmp_rm_s2 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_rm_s2, lp_rm_s2)
        mc_patch_jcc8(c, jae_rme, buf_len(c))
        mc_patch_rel32(c, jle_rme, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_ai_leave(c, 0x28)
        cg_reg_helper(cg, h_ai_rmsnorm(), s_rm, buf_len(c))
    }

    // 12. `h_ai_swiglu`: `RCX = args_ptr = [gate, up, out, dim]`
    if cg_is_helper_used(cg, h_ai_swiglu()) {
        mc_align16(c)
        s_sw := buf_len(c)
        mc_ai_enter(c, 0x48)
        // Store 12 f32/u32 constants at [RSP+0..44]
        mc_b4(c, 0xC7, 0x44, 0x24, 0);  mc_u32(c, 0xC2B00000) // -88.0
        mc_b4(c, 0xC7, 0x44, 0x24, 4);  mc_u32(c, 0x42B00000) // +88.0
        mc_b4(c, 0xC7, 0x44, 0x24, 8);  mc_u32(c, 0x3FB8AA3B) // LOG2E
        mc_b4(c, 0xC7, 0x44, 0x24, 12); mc_u32(c, 0x3F318000) // LN2_HI
        mc_b4(c, 0xC7, 0x44, 0x24, 16); mc_u32(c, 0xB95E8083) // LN2_LO
        mc_b4(c, 0xC7, 0x44, 0x24, 20); mc_u32(c, 0x3C088889) // c5
        mc_b4(c, 0xC7, 0x44, 0x24, 24); mc_u32(c, 0x3D2AAAAB) // c4
        mc_b4(c, 0xC7, 0x44, 0x24, 28); mc_u32(c, 0x3E2AAAAB) // c3
        mc_b4(c, 0xC7, 0x44, 0x24, 32); mc_u32(c, 0x3F000000) // c2
        mc_b4(c, 0xC7, 0x44, 0x24, 36); mc_u32(c, 0x3F800000) // 1.0
        mc_b4(c, 0xC7, 0x44, 0x24, 40); mc_u32(c, 127)        // 127
        mc_b4(c, 0xC7, 0x44, 0x24, 44); mc_u32(c, 0x80000000) // sign mask

        mc_b3(c, 0x48, 0x89, 0xCB)
        mc_b4(c, 0x48, 0x8B, 0x43, 24) // dim
        mc_b3(c, 0x48, 0x85, 0xC0)
        jle_swe := mc_jcc32(c, 0x8E)
        mc_b3(c, 0x48, 0x8B, 0x0B)       // RCX = gate
        mc_b4(c, 0x48, 0x8B, 0x53, 8)    // RDX = up
        mc_b4(c, 0x48, 0x8B, 0x7B, 16)   // RDI = out
        mc_b4(c, 0x48, 0x8D, 0x2C, 0x81) // RBP = gate + dim*4 (end)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_swsc := mc_jcc32(c, 0x84)

        mc_b4(c, 0x48, 0x8D, 0x45, 0xE0) // RAX = end - 32
        lp_sw8 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC1)
        ja_sw_tail := mc_jcc32(c, 0x87)
        mc_vex2(c, 0, 1, 0, 0x10, 0x21)                                   // VMOVUPS YMM4, [RCX] (gate)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 44) // VBROADCASTSS YMM3, [RSP+44]
        mc_vex2(c, 4, 1, 0, 0x57, 0xC3)                                   // VXORPS YMM0, YMM4, YMM3 (-gate)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 0)
        mc_vex2(c, 0, 1, 0, 0x5F, 0xC3)                                   // VMAXPS YMM0, YMM0, YMM3
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 4)
        mc_vex2(c, 0, 1, 0, 0x5D, 0xC3)                                   // VMINPS YMM0, YMM0, YMM3
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 8)
        mc_vex2(c, 0, 1, 0, 0x59, 0xCB)                                   // VMULPS YMM1, YMM0, YMM3
        mc_vex2(c, 0, 1, 1, 0x5B, 0xD1)                                   // VCVTPS2DQ YMM2, YMM1
        mc_vex2(c, 0, 1, 0, 0x5B, 0xCA)                                   // VCVTDQ2PS YMM1, YMM2
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 12)
        mc_vex3(c, 0, 0, 0, 2, 0, 1, 1, 1, 0xBC); mc_b1(c, 0xC3)          // VFNMADD231PS YMM0, YMM1, YMM3
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 16)
        mc_vex3(c, 0, 0, 0, 2, 0, 1, 1, 1, 0xBC); mc_b1(c, 0xC3)          // YMM0 = r
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x4C, 0x24, 20) // YMM1 = c5
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 24)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0xA8); mc_b1(c, 0xCB)          // VFMADD213PS YMM1, YMM0, YMM3
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 28)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0xA8); mc_b1(c, 0xCB)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 32)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0xA8); mc_b1(c, 0xCB)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 36)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0xA8); mc_b1(c, 0xCB)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0xA8); mc_b1(c, 0xCB)          // YMM1 = exp(r)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 40) // YMM3 = 127
        mc_vex2(c, 2, 1, 1, 0xFE, 0xD3)                                   // VPADDD YMM2, YMM2, YMM3
        mc_vex2(c, 2, 1, 1, 0x72, 0xF2); mc_b1(c, 23)                     // VPSLLD YMM2, YMM2, 23
        mc_vex2(c, 1, 1, 0, 0x59, 0xCA)                                   // VMULPS YMM1, YMM1, YMM2
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x18); mc_b3(c, 0x5C, 0x24, 36)
        mc_vex2(c, 1, 1, 0, 0x58, 0xCB)                                   // VADDPS YMM1, YMM1, YMM3 (1+exp)
        mc_vex2(c, 4, 1, 0, 0x59, 0x22)                                   // VMULPS YMM4, YMM4, [RDX]
        mc_vex2(c, 4, 1, 0, 0x5E, 0xC1)                                   // VDIVPS YMM0, YMM4, YMM1
        mc_vex2(c, 0, 1, 0, 0x11, 0x07)                                   // VMOVUPS [RDI], YMM0
        mc_b4(c, 0x48, 0x83, 0xC1, 32); mc_b4(c, 0x48, 0x83, 0xC2, 32); mc_b4(c, 0x48, 0x83, 0xC7, 32)
        jmp_sw8 := mc_jmp32(c); mc_patch_rel32(c, jmp_sw8, lp_sw8)
        mc_patch_rel32(c, ja_sw_tail, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)

        // Scalar SSE2 tail for SwiGLU (exact same polynomial using XMM0..XMM4!)
        mc_patch_rel32(c, jz_swsc, buf_len(c))
        lp_sws := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xE9)
        jae_swe := mc_jcc32(c, 0x83)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x21)                      // MOVSS XMM4, [RCX] (gate)
        mc_b3(c, 0x0F, 0x28, 0xC4)                            // MOVAPS XMM0, XMM4
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x5C); mc_b2(c, 0x24, 44) // MOVSS XMM3, [RSP+44]
        mc_b3(c, 0x0F, 0x57, 0xC3)                            // XORPS XMM0, XMM3 (-gate)
        mc_b4(c, 0xF3, 0x0F, 0x5F, 0x04); mc_b1(c, 0x24)      // MAXSS XMM0, [RSP+0]
        mc_b4(c, 0xF3, 0x0F, 0x5D, 0x44); mc_b2(c, 0x24, 4)   // MINSS XMM0, [RSP+4]
        mc_b3(c, 0x0F, 0x28, 0xC8)                            // MOVAPS XMM1, XMM0
        mc_b4(c, 0xF3, 0x0F, 0x59, 0x4C); mc_b2(c, 0x24, 8)   // MULSS XMM1, [RSP+8]
        mc_b4(c, 0xF3, 0x0F, 0x2D, 0xC1)                      // CVTSS2SI EAX, XMM1 (nearest)
        mc_b4(c, 0xF3, 0x0F, 0x2A, 0xC8)                      // CVTSI2SS XMM1, EAX
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x5C); mc_b2(c, 0x24, 12)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xD9); mc_b4(c, 0xF3, 0x0F, 0x5C, 0xC3) // z -= k*LN2_HI
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x5C); mc_b2(c, 0x24, 16)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xD9); mc_b4(c, 0xF3, 0x0F, 0x5C, 0xC3) // r = z - k*LN2_LO
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x4C); mc_b2(c, 0x24, 20)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xC8); mc_b4(c, 0xF3, 0x0F, 0x58, 0x4C); mc_b2(c, 0x24, 24)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xC8); mc_b4(c, 0xF3, 0x0F, 0x58, 0x4C); mc_b2(c, 0x24, 28)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xC8); mc_b4(c, 0xF3, 0x0F, 0x58, 0x4C); mc_b2(c, 0x24, 32)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xC8); mc_b4(c, 0xF3, 0x0F, 0x58, 0x4C); mc_b2(c, 0x24, 36)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xC8); mc_b4(c, 0xF3, 0x0F, 0x58, 0x4C); mc_b2(c, 0x24, 36)
        mc_b3(c, 0x83, 0xC0, 127); mc_b3(c, 0xC1, 0xE0, 23)
        mc_b4(c, 0x66, 0x0F, 0x6E, 0xD0)                      // MOVD XMM2, EAX
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xCA)                      // MULSS XMM1, XMM2
        mc_b4(c, 0xF3, 0x0F, 0x58, 0x4C); mc_b2(c, 0x24, 36)  // 1.0 + exp(-gate)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0x22)                      // MULSS XMM4, [RDX]
        mc_b4(c, 0xF3, 0x0F, 0x5E, 0xE1)                      // DIVSS XMM4, XMM1
        mc_b4(c, 0xF3, 0x0F, 0x11, 0x27)                      // MOVSS [RDI], XMM4
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b4(c, 0x48, 0x83, 0xC2, 4); mc_b4(c, 0x48, 0x83, 0xC7, 4)
        jmp_sws := mc_jmp32(c); mc_patch_rel32(c, jmp_sws, lp_sws)

        mc_patch_rel32(c, jae_swe, buf_len(c))
        mc_patch_rel32(c, jle_swe, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_ai_leave(c, 0x48)
        cg_reg_helper(cg, h_ai_swiglu(), s_sw, buf_len(c))
    }
}

fn _mc_save_xmm6_15_rsp(c: ByteBuf, base_off: i64) {
    mut xi := 6
    while xi <= 15 {
        off := base_off + (xi - 6) * 16
        if xi >= 8 { mc_b1(c, 0x44) }
        if off == 0 { mc_b4(c, 0x0F, 0x11, 0x04 | ((xi & 7) << 3), 0x24) }
        else if off < 128 { mc_b4(c, 0x0F, 0x11, 0x44 | ((xi & 7) << 3), 0x24); mc_b1(c, off) }
        else { mc_b4(c, 0x0F, 0x11, 0x84 | ((xi & 7) << 3), 0x24); mc_u32(c, off) }
        xi += 1
    }
}

fn _mc_load_xmm6_15_rsp(c: ByteBuf, base_off: i64) {
    mut xi := 6
    while xi <= 15 {
        off := base_off + (xi - 6) * 16
        if xi >= 8 { mc_b1(c, 0x44) }
        if off == 0 { mc_b4(c, 0x0F, 0x10, 0x04 | ((xi & 7) << 3), 0x24) }
        else if off < 128 { mc_b4(c, 0x0F, 0x10, 0x44 | ((xi & 7) << 3), 0x24); mc_b1(c, off) }
        else { mc_b4(c, 0x0F, 0x10, 0x84 | ((xi & 7) << 3), 0x24); mc_u32(c, off) }
        xi += 1
    }
}

fn _mc_chacha_qr8(c: ByteBuf, a: i64, b: i64, cc: i64, d_off: i64) {
    // Load d -> YMM12 from [RSP + d_off], run RFC 8439 QR on 8 u32 lanes, store YMM12 back.
    mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0xA4, 0x24); mc_u32(c, d_off) // VMOVDQU YMM12, [RSP+d_off]
    mc_vex256(c, 1, a, a, b, 0xFE)     // a += b
    mc_vex256(c, 1, 12, 12, a, 0xEF)   // d ^= a
    mc_vex256(c, 2, 12, 12, 14, 0x00)  // d = ROL16(d)
    mc_vex256(c, 1, cc, cc, 12, 0xFE)  // c += d
    mc_vex256(c, 1, b, b, cc, 0xEF)    // b ^= c
    mc_vex3(c, 0, 0, (b >> 3) & 1, 1, 0, 13, 1, 1, 0x72); mc_b2(c, 0xF0 | (b & 7), 12)
    mc_vex3(c, 0, 0, (b >> 3) & 1, 1, 0, b,  1, 1, 0x72); mc_b2(c, 0xD0 | (b & 7), 20)
    mc_vex256(c, 1, b, b, 13, 0xEB)    // b = ROL12(b)
    mc_vex256(c, 1, a, a, b, 0xFE)     // a += b
    mc_vex256(c, 1, 12, 12, a, 0xEF)   // d ^= a
    mc_vex256(c, 2, 12, 12, 15, 0x00)  // d = ROL8(d)
    mc_vex256(c, 1, cc, cc, 12, 0xFE)  // c += d
    mc_vex256(c, 1, b, b, cc, 0xEF)    // b ^= c
    mc_vex3(c, 0, 0, (b >> 3) & 1, 1, 0, 13, 1, 1, 0x72); mc_b2(c, 0xF0 | (b & 7), 7)
    mc_vex3(c, 0, 0, (b >> 3) & 1, 1, 0, b,  1, 1, 0x72); mc_b2(c, 0xD0 | (b & 7), 25)
    mc_vex256(c, 1, b, b, 13, 0xEB)    // b = ROL7(b)
    mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0xA4, 0x24); mc_u32(c, d_off) // VMOVDQU [RSP+d_off], YMM12
}

fn _mc_blake2s_g8(c: ByteBuf, a: i64, b: i64, cc: i64, d_off: i64, s1: i64, s2: i64) {
    // RSI = msg8x16 (512B), RDI = sigma_row (16B). YMM14 = ROR16 shuf, YMM15 = ROR8 shuf.
    mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0xA4, 0x24); mc_u32(c, d_off) // VMOVDQU YMM12, [RSP+d_off]
    mc_b4(c, 0x0F, 0xB6, 0x47, s1)                                                    // MOVZX EAX, BYTE [RDI + s1]
    mc_b3(c, 0xC1, 0xE0, 5)                                                           // SHL EAX, 5
    mc_vex256(c, 1, a, a, b, 0xFE)                                                    // a += b
    mc_vex3(c, (a >> 3) & 1, 0, 0, 1, 0, a, 1, 1, 0xFE); mc_b2(c, 0x04 | ((a & 7) << 3), 0x06) // VPADDD a, a, [RSI+RAX]
    mc_vex256(c, 1, 12, 12, a, 0xEF)                                                  // d ^= a
    mc_vex256(c, 2, 12, 12, 14, 0x00)                                                 // d = ROR16(d)
    mc_vex256(c, 1, cc, cc, 12, 0xFE)                                                 // c += d
    mc_vex256(c, 1, b, b, cc, 0xEF)                                                   // b ^= c
    mc_vex3(c, 0, 0, (b >> 3) & 1, 1, 0, 13, 1, 1, 0x72); mc_b2(c, 0xD0 | (b & 7), 12)
    mc_vex3(c, 0, 0, (b >> 3) & 1, 1, 0, b,  1, 1, 0x72); mc_b2(c, 0xF0 | (b & 7), 20)
    mc_vex256(c, 1, b, b, 13, 0xEB)                                                   // b = ROR12(b)
    mc_b4(c, 0x0F, 0xB6, 0x47, s2)                                                    // MOVZX EAX, BYTE [RDI + s2]
    mc_b3(c, 0xC1, 0xE0, 5)                                                           // SHL EAX, 5
    mc_vex256(c, 1, a, a, b, 0xFE)                                                    // a += b
    mc_vex3(c, (a >> 3) & 1, 0, 0, 1, 0, a, 1, 1, 0xFE); mc_b2(c, 0x04 | ((a & 7) << 3), 0x06) // VPADDD a, a, [RSI+RAX]
    mc_vex256(c, 1, 12, 12, a, 0xEF)                                                  // d ^= a
    mc_vex256(c, 2, 12, 12, 15, 0x00)                                                 // d = ROR8(d)
    mc_vex256(c, 1, cc, cc, 12, 0xFE)                                                 // c += d
    mc_vex256(c, 1, b, b, cc, 0xEF)                                                   // b ^= c
    mc_vex3(c, 0, 0, (b >> 3) & 1, 1, 0, 13, 1, 1, 0x72); mc_b2(c, 0xD0 | (b & 7), 7)
    mc_vex3(c, 0, 0, (b >> 3) & 1, 1, 0, b,  1, 1, 0x72); mc_b2(c, 0xF0 | (b & 7), 25)
    mc_vex256(c, 1, b, b, 13, 0xEB)                                                   // b = ROR7(b)
    mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0xA4, 0x24); mc_u32(c, d_off) // VMOVDQU [RSP+d_off], YMM12
}

fn emit_ai_crypto_math_helpers(cg: CodegenCtx) {
    c := cg.code
    // 1. `h_ai_exp_neg_f64`: 4-wide AVX2 IEEE-754 range-reduced `exp(-u)` (`0` ULP drift vs `_fast_exp_neg`!) + SSE2 tail
    if cg_is_helper_used(cg, h_ai_exp_neg_f64()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff := buf_len(cg.rdata)
        buf_push_u64(cg.rdata, 0x4049000000000000) // +0:  50.0
        buf_push_u64(cg.rdata, 0x3FF71547652B82FE) // +8:  inv_ln2
        buf_push_u64(cg.rdata, 0x3FE0000000000000) // +16: 0.5
        buf_push_u64(cg.rdata, 0x3FE62E42FEFA39EF) // +24: ln2
        buf_push_u64(cg.rdata, 1023)               // +32: 1023 (i64)
        buf_push_u64(cg.rdata, 0x3FF0000000000000) // +40: 1.0
        buf_push_u64(cg.rdata, 0x3FC5555555555555) // +48: c3 (1/6)
        buf_push_u64(cg.rdata, 0x3FA5555555555555) // +56: c4 (1/24)
        buf_push_u64(cg.rdata, 0x3F81111111111111) // +64: c5 (1/120)
        buf_push_u64(cg.rdata, 0x3F56C16C16C16C17) // +72: c6 (1/720)
        buf_push_u64(cg.rdata, 0x3F2A01A01A01A01A) // +80: c7 (1/5040)
        buf_push_u64(cg.rdata, 0x3EFA01A01A01A01A) // +88: c8 (1/40320)

        mc_align16(c)
        s_fn := buf_len(c)
        mc_ai_enter(c, 0xB8) // 184B (160B for XMM6..XMM15 + 24B align)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)          // MOV R8, [RCX]      (src)
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)       // MOV R9, [RCX + 8]  (dst)
        mc_b4(c, 0x48, 0x8B, 0x51, 16)      // MOV RDX, [RCX + 16] (n)
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0)    // XORPD XMM0, XMM0 (sum = 0.0)
        mc_b2(c, 0x31, 0xC9)                // XOR ECX, ECX (i = 0)
        mc_b3(c, 0x48, 0x85, 0xD2)
        jle_done := mc_jcc32(c, 0x8E)

        cg_lea_rax_rdata(cg, roff); mc_b3(c, 0x49, 0x89, 0xC2) // R10 = &consts
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_sc := mc_jcc32(c, 0x84)

        mc_b4(c, 0x4C, 0x8D, 0x5A, 0xFC) // R11 = n - 4
        mc_b3(c, 0x4C, 0x39, 0xD9)
        jg_tail := mc_jcc32(c, 0x8F)

        // Broadcast 10 constants into YMM6..YMM15 (ZERO reloads in loop!)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0x32)         // YMM6  = 50.0
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x7A, 8)      // YMM7  = inv_ln2
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x42, 16)     // YMM8  = 0.5
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x4A, 24)     // YMM9  = ln2
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x59); mc_b2(c, 0x52, 32)     // YMM10 = 1023 (i64)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x5A, 40)     // YMM11 = 1.0
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x62, 48)     // YMM12 = c3
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x6A, 56)     // YMM13 = c4
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x72, 64)     // YMM14 = c5
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x7A, 72)     // YMM15 = c6
        mc_vex256(c, 1, 5, 5, 5, 0x57)                                   // VXORPD YMM5, YMM5, YMM5 (sum)

        mc_align16_nop(c)
        lp4 := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xC8)   // VMOVUPD YMM0, [R8+RCX*8] (u)
        mc_vex256(c, 1, 4, 0, 6, 0xC2); mc_b1(c, 2)                      // VCMPPD YMM4, YMM0, YMM6, 2 (u<=50)
        mc_vex256(c, 1, 0, 0, 6, 0x5D)                                   // VMINPD YMM0, YMM0, YMM6 (u_c)
        mc_vex256(c, 1, 1, 0, 7, 0x59)                                   // VMULPD YMM1, YMM0, inv_ln2
        mc_vex256(c, 1, 1, 1, 8, 0x58)                                   // VADDPD YMM1, YMM1, 0.5
        mc_vex256(c, 1, 2, 0, 1, 0xE6)                                   // VCVTTPD2DQ XMM2, YMM1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0xE6); mc_b1(c, 0xCA)         // VCVTDQ2PD YMM1, XMM2 (kf)
        mc_vex256(c, 2, 2, 0, 2, 0x25)                                   // VPMOVSXDQ YMM2, XMM2 (k64)
        mc_vex256(c, 1, 2, 10, 2, 0xFB)                                  // VPSUBQ YMM2, 1023, k64
        mc_vex3(c, 0, 0, 0, 1, 0, 2, 1, 1, 0x73); mc_b2(c, 0xF2, 52)     // VPSLLQ YMM2, YMM2, 52 (2^-k)
        mc_vex256(c, 1, 1, 1, 9, 0x59)                                   // VMULPD YMM1, kf, ln2
        mc_vex256(c, 1, 0, 1, 0, 0x5C)                                   // VSUBPD YMM0, YMM1, u_c (r)
        // Degree-8 Horner (exact non-FMA rounding matching scalar `_fast_exp_neg`!)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x5A, 88)     // YMM3 = c8
        mc_vex256(c, 1, 3, 3, 0, 0x59)                                   // * r
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x4A, 80)     // YMM1 = c7
        mc_vex256(c, 1, 3, 3, 1, 0x58)                                   // + c7
        mc_vex256(c, 1, 3, 3, 0, 0x59); mc_vex256(c, 1, 3, 3, 15, 0x58)  // *r + c6
        mc_vex256(c, 1, 3, 3, 0, 0x59); mc_vex256(c, 1, 3, 3, 14, 0x58)  // *r + c5
        mc_vex256(c, 1, 3, 3, 0, 0x59); mc_vex256(c, 1, 3, 3, 13, 0x58)  // *r + c4
        mc_vex256(c, 1, 3, 3, 0, 0x59); mc_vex256(c, 1, 3, 3, 12, 0x58)  // *r + c3
        mc_vex256(c, 1, 3, 3, 0, 0x59); mc_vex256(c, 1, 3, 3, 8,  0x58)  // *r + 0.5
        mc_vex256(c, 1, 3, 3, 0, 0x59); mc_vex256(c, 1, 3, 3, 11, 0x58)  // *r + 1.0
        mc_vex256(c, 1, 3, 3, 0, 0x59); mc_vex256(c, 1, 3, 3, 11, 0x58)  // *r + 1.0
        mc_vex256(c, 1, 3, 2, 3, 0x59)                                   // exp2 * p
        mc_vex256(c, 1, 3, 3, 4, 0x54)                                   // VANDPD mask_ok
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x1C, 0xC9)   // VMOVUPD [R9+RCX*8], YMM3
        mc_vex256(c, 1, 5, 5, 3, 0x58)                                   // sum += res
        mc_b4(c, 0x48, 0x83, 0xC1, 4)
        mc_b3(c, 0x4C, 0x39, 0xD9)
        jle_lp4 := mc_jcc32(c, 0x8E); mc_patch_rel32(c, jle_lp4, lp4)

        // Horizontal sum of YMM5 -> XMM0
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xE9, 1)      // VEXTRACTF128 XMM1, YMM5, 1
        mc_vex3(c, 0, 0, 0, 1, 0, 5, 0, 1, 0x58); mc_b1(c, 0xC1)         // VADDPD XMM0, XMM5, XMM1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x15); mc_b1(c, 0xC8)         // VUNPCKHPD XMM1, XMM0, XMM0
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b1(c, 0xC1)         // VADDSD XMM0, XMM0, XMM1
        mc_b3(c, 0xC5, 0xF8, 0x77)                                       // VZEROUPPER

        // Scalar SSE2 tail & `--simd=scalar` path (exact match!)
        mc_patch_rel32(c, jg_tail, buf_len(c))
        mc_patch_rel32(c, jz_sc, buf_len(c))
        lp_sc := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD1)
        jae_done := mc_jcc32(c, 0x83)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xC8)           // MOVSD XMM1, [R8+RCX*8] (u)
        mc_b4(c, 0x66, 0x41, 0x0F, 0x2F); mc_b1(c, 0x0A)                 // COMISD XMM1, [R10+0] (50.0)
        jbe_ok := mc_jcc8(c, 0x76)
        mc_b4(c, 0x66, 0x0F, 0x57, 0xDB)                                 // XORPD XMM3, XMM3 (0.0)
        jmp_st := mc_jmp32(c)
        mc_patch_jcc8(c, jbe_ok, buf_len(c))
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xD1)                                 // MOVSD XMM2, XMM1
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x52, 8)              // MULSD XMM2, [R10+8] (inv_ln2)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x52, 16)             // ADDSD XMM2, [R10+16] (0.5)
        mc_b4(c, 0xF2, 0x48, 0x0F, 0x2C); mc_b1(c, 0xC2)                 // CVTTSD2SI RAX, XMM2 (k)
        mc_b4(c, 0xF2, 0x48, 0x0F, 0x2A); mc_b1(c, 0xD0)                 // CVTSI2SD XMM2, RAX (kf)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x52, 24)             // MULSD XMM2, [R10+24] (ln2)
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xD1)                                 // SUBSD XMM2, XMM1 (r in XMM2)
        mc_b1(c, 0xBF); mc_u32(c, 1023)                                  // MOV EDI, 1023
        mc_b3(c, 0x48, 0x29, 0xC7)                                       // SUB RDI, RAX
        mc_b4(c, 0x48, 0xC1, 0xE7, 52)                                   // SHL RDI, 52
        mc_b4(c, 0x66, 0x48, 0x0F, 0x6E); mc_b1(c, 0xCF)                 // MOVQ XMM1, RDI (2^-k)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x5A, 88)             // MOVSD XMM3, [R10+88] (c8)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xDA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x5A, 80) // *r + c7
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xDA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x5A, 72) // *r + c6
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xDA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x5A, 64) // *r + c5
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xDA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x5A, 56) // *r + c4
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xDA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x5A, 48) // *r + c3
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xDA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x5A, 16) // *r + 0.5
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xDA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x5A, 40) // *r + 1.0
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xDA); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x5A, 40) // *r + 1.0
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xD9)                                 // MULSD XMM3, XMM1
        mc_patch_rel32(c, jmp_st, buf_len(c))
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x1C, 0xC9)           // MOVSD [R9+RCX*8], XMM3
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC3)                                 // ADDSD XMM0, XMM3
        mc_b3(c, 0x48, 0xFF, 0xC1)
        jmp_sc := mc_jmp32(c); mc_patch_rel32(c, jmp_sc, lp_sc)

        mc_patch_rel32(c, jae_done, buf_len(c))
        mc_patch_rel32(c, jle_done, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)                 // MOVQ RAX, XMM0
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_exp_neg_f64(), s_fn, buf_len(c))
    }

    // 2. `h_ai_chacha20_8`: 8-lane AVX2 RFC 8439 ChaCha20 (`state16_i64`, `start_ctr`, `out512_u32_lane_major`) + scalar fallback
    if cg_is_helper_used(cg, h_ai_chacha20_8()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_cc := buf_len(cg.rdata)
        mut li := 0; while li < 8 { buf_push_u32(cg.rdata, li); li += 1 }
        // +32: ROL16 shuf mask (2x16B)
        li = 0; while li < 8 { buf_push(cg.rdata, (li & 3)*4 + 2); buf_push(cg.rdata, (li & 3)*4 + 3); buf_push(cg.rdata, (li & 3)*4 + 0); buf_push(cg.rdata, (li & 3)*4 + 1); li += 1 }
        // +64: ROL8 shuf mask (2x16B)
        li = 0; while li < 8 { buf_push(cg.rdata, (li & 3)*4 + 3); buf_push(cg.rdata, (li & 3)*4 + 0); buf_push(cg.rdata, (li & 3)*4 + 1); buf_push(cg.rdata, (li & 3)*4 + 2); li += 1 }

        mc_align16(c)
        s_cc := buf_len(c)
        mc_ai_enter(c, 0x168) // 160B XMM6..15 + 160B v12..15 + init_ctr (160..319) + 40B
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = state16_i64
        mc_b4(c, 0x48, 0x8B, 0x51, 8)    // RDX = start_ctr
        mc_b4(c, 0x4C, 0x8B, 0x49, 16)   // R9 = out512

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_cc_sc := mc_jcc32(c, 0x84)

        cg_lea_rax_rdata(cg, roff_cc); mc_b3(c, 0x49, 0x89, 0xC2) // R10 = consts
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x72, 32) // YMM14 = ROL16
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x7A, 64) // YMM15 = ROL8
        // Broadcast words 0..11 into YMM0..YMM11
        mut w := 0
        while w < 12 {
            mc_b4(c, 0x41, 0x8B, 0x40, w * 8) // MOV EAX, [R8 + w*8]
            mc_vex3(c, (w >> 3) & 1, 0, 0, 1, 0, 0, 0, 1, 0x6E); mc_b1(c, 0xC0 | ((w & 7) << 3))
            mc_vex256(c, 2, w, 0, w, 0x58)
            w += 1
        }
        // Word 12 = start_ctr + [0..7] -> store to [RSP+160] (v12) and [RSP+288] (init12)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 0, 1, 0x6E); mc_b1(c, 0xE2) // VMOVD XMM12, EDX
        mc_vex256(c, 2, 12, 0, 12, 0x58)                         // VPBROADCASTD YMM12, XMM12
        mc_vex3(c, 1, 0, 1, 1, 0, 12, 1, 1, 0xFE); mc_b1(c, 0x22) // VPADDD YMM12, YMM12, [R10]
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0xA4, 0x24); mc_u32(c, 160)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0xA4, 0x24); mc_u32(c, 288)
        // Words 13..15 -> [RSP+192, 224, 256]
        w = 13
        while w < 16 {
            mc_b4(c, 0x41, 0x8B, 0x40, w * 8)
            mc_vex3(c, 1, 0, 0, 1, 0, 0, 0, 1, 0x6E); mc_b1(c, 0xE0)
            mc_vex256(c, 2, 12, 0, 12, 0x58)
            mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0xA4, 0x24); mc_u32(c, 160 + (w - 12) * 32)
            w += 1
        }
        // 10 double-rounds
        mc_b2(c, 0x41, 0xBB); mc_u32(c, 10) // MOV R11D, 10
        mc_align16_nop(c)
        lp_cc := buf_len(c)
        _mc_chacha_qr8(c, 0, 4, 8,  160); _mc_chacha_qr8(c, 1, 5, 9,  192)
        _mc_chacha_qr8(c, 2, 6, 10, 224); _mc_chacha_qr8(c, 3, 7, 11, 256)
        _mc_chacha_qr8(c, 0, 5, 10, 256); _mc_chacha_qr8(c, 1, 6, 11, 160)
        _mc_chacha_qr8(c, 2, 7, 8,  192); _mc_chacha_qr8(c, 3, 4, 9,  224)
        mc_b3(c, 0x41, 0xFF, 0xCB) // DEC R11D
        jnz_cc := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_cc, lp_cc)

        // Feed-forward + store 16 vectors to [R9 + w*32]
        w = 0
        while w < 12 {
            mc_b4(c, 0x41, 0x8B, 0x40, w * 8)
            mc_vex3(c, 1, 0, 0, 1, 0, 0, 0, 1, 0x6E); mc_b1(c, 0xE8)
            mc_vex256(c, 2, 13, 0, 13, 0x58)
            mc_vex256(c, 1, w, w, 13, 0xFE)
            mc_vex3(c, (w >> 3) & 1, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b1(c, 0x81 | ((w & 7) << 3)); mc_u32(c, w * 32)
            w += 1
        }
        // Word 12 += init12 ([RSP+288])
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0xA4, 0x24); mc_u32(c, 160)
        mc_vex3(c, 1, 0, 0, 1, 0, 12, 1, 1, 0xFE); mc_b2(c, 0xA4, 0x24); mc_u32(c, 288)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b1(c, 0xA1); mc_u32(c, 12 * 32)
        // Words 13..15
        w = 13
        while w < 16 {
            mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0xA4, 0x24); mc_u32(c, 160 + (w - 12) * 32)
            mc_b4(c, 0x41, 0x8B, 0x40, w * 8)
            mc_vex3(c, 1, 0, 0, 1, 0, 0, 0, 1, 0x6E); mc_b1(c, 0xE8)
            mc_vex256(c, 2, 13, 0, 13, 0x58)
            mc_vex256(c, 1, 12, 12, 13, 0xFE)
            mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b1(c, 0xA1); mc_u32(c, w * 32)
            w += 1
        }
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_cc_dn := mc_jmp32(c)

        // Scalar fallback for `--simd=scalar` (8 lanes sequentially, exact same lane-major layout!)
        mc_patch_rel32(c, jz_cc_sc, buf_len(c))
        // R14 = lane 0..7; [RSP+160..223] = 16 u32 state
        mc_b3(c, 0x45, 0x31, 0xF6) // XOR R14D, R14D
        lp_ccl := buf_len(c)
        w = 0
        while w < 16 {
            if w == 12 {
                mc_b4(c, 0x42, 0x8D, 0x04, 0x32) // LEA EAX, [RDX + R14]
            } else {
                mc_b4(c, 0x41, 0x8B, 0x40, w * 8)
            }
            mc_b3(c, 0x89, 0x84, 0x24); mc_u32(c, 160 + w * 4)
            w += 1
        }
        mc_b2(c, 0x41, 0xBB); mc_u32(c, 10)
        lp_ccsr := buf_len(c)
        // Scalar QR helper inline via loop over 8 tuples encoded directly:
        mut qri := 0
        while qri < 8 {
            qa := if qri < 4 { qri } else { qri - 4 }
            qb := if qri < 4 { qri + 4 } else { 4 + ((qri - 3) & 3) }
            qc := if qri < 4 { qri + 8 } else { 8 + ((qri - 2) & 3) }
            qd := if qri < 4 { qri + 12 } else { 12 + ((qri - 1) & 3) }
            // EAX=a, EBX=b, ESI=c, EDI=d
            mc_b3(c, 0x8B, 0x84, 0x24); mc_u32(c, 160 + qa * 4)
            mc_b3(c, 0x8B, 0x9C, 0x24); mc_u32(c, 160 + qb * 4)
            mc_b3(c, 0x8B, 0xB4, 0x24); mc_u32(c, 160 + qc * 4)
            mc_b3(c, 0x8B, 0xBC, 0x24); mc_u32(c, 160 + qd * 4)
            mc_b2(c, 0x01, 0xD8); mc_b2(c, 0x31, 0xC7); mc_b3(c, 0xC1, 0xC7, 16)
            mc_b2(c, 0x01, 0xFE); mc_b2(c, 0x31, 0xF3); mc_b3(c, 0xC1, 0xC3, 12)
            mc_b2(c, 0x01, 0xD8); mc_b2(c, 0x31, 0xC7); mc_b3(c, 0xC1, 0xC7, 8)
            mc_b2(c, 0x01, 0xFE); mc_b2(c, 0x31, 0xF3); mc_b3(c, 0xC1, 0xC3, 7)
            mc_b3(c, 0x89, 0x84, 0x24); mc_u32(c, 160 + qa * 4)
            mc_b3(c, 0x89, 0x9C, 0x24); mc_u32(c, 160 + qb * 4)
            mc_b3(c, 0x89, 0xB4, 0x24); mc_u32(c, 160 + qc * 4)
            mc_b3(c, 0x89, 0xBC, 0x24); mc_u32(c, 160 + qd * 4)
            qri += 1
        }
        mc_b3(c, 0x41, 0xFF, 0xCB)
        jnz_ccsr := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_ccsr, lp_ccsr)
        w = 0
        while w < 16 {
            mc_b3(c, 0x8B, 0x84, 0x24); mc_u32(c, 160 + w * 4)
            if w == 12 { mc_b2(c, 0x01, 0xD0); mc_b3(c, 0x44, 0x01, 0xF0) }
            else { mc_b4(c, 0x41, 0x03, 0x40, w * 8) }
            mc_b4(c, 0x43, 0x89, 0x84, 0xB1); mc_u32(c, w * 32) // MOV [R9 + R14*4 + w*32], EAX
            w += 1
        }
        mc_b3(c, 0x41, 0xFF, 0xC6)
        mc_b4(c, 0x41, 0x83, 0xFE, 8)
        jl_ccl := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_ccl, lp_ccl)

        mc_patch_rel32(c, jmp_cc_dn, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0x168)
        cg_reg_helper(cg, h_ai_chacha20_8(), s_cc, buf_len(c))
    }

    // 3. `h_ai_blake2s_8`: 8-lane AVX2 BLAKE2s compression (`h8_i64`, `msg8x16_u32`, `sigma160_u8`, `t0`, `f0`, `out8x8_u32`)
    if cg_is_helper_used(cg, h_ai_blake2s_8()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_b2 := buf_len(cg.rdata)
        // +0: BLAKE2s IV (8 x u32 = 32B)
        buf_push_u32(cg.rdata, 0x6a09e667); buf_push_u32(cg.rdata, 0xbb67ae85)
        buf_push_u32(cg.rdata, 0x3c6ef372); buf_push_u32(cg.rdata, 0xa54ff53a)
        buf_push_u32(cg.rdata, 0x510e527f); buf_push_u32(cg.rdata, 0x9b05688c)
        buf_push_u32(cg.rdata, 0x1f83d9ab); buf_push_u32(cg.rdata, 0x5be0cd19)
        // +32: ROR16 shuf (2x16B)
        mut li := 0; while li < 8 { buf_push(cg.rdata, (li & 3)*4 + 2); buf_push(cg.rdata, (li & 3)*4 + 3); buf_push(cg.rdata, (li & 3)*4 + 0); buf_push(cg.rdata, (li & 3)*4 + 1); li += 1 }
        // +64: ROR8 shuf (2x16B): [1,2,3,0]
        li = 0; while li < 8 { buf_push(cg.rdata, (li & 3)*4 + 1); buf_push(cg.rdata, (li & 3)*4 + 2); buf_push(cg.rdata, (li & 3)*4 + 3); buf_push(cg.rdata, (li & 3)*4 + 0); li += 1 }

        mc_align16(c)
        s_b2 := buf_len(c)
        mc_ai_enter(c, 0x148) // 160B XMM6..15 + 128B v12..15 (160..287) + 40B
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = h8_i64
        mc_b4(c, 0x48, 0x8B, 0x71, 8)    // RSI = msg8x16_u32
        mc_b4(c, 0x48, 0x8B, 0x79, 16)   // RDI = sigma160_u8
        mc_b4(c, 0x48, 0x8B, 0x51, 24)   // RDX = t0
        mc_b4(c, 0x4C, 0x8B, 0x69, 32)   // R13 = f0
        mc_b4(c, 0x4C, 0x8B, 0x49, 40)   // R9 = out8x8_u32

        cg_lea_rax_rdata(cg, roff_b2); mc_b3(c, 0x49, 0x89, 0xC2) // R10 = consts
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_b2_sc := mc_jcc32(c, 0x84)

        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x72, 32) // YMM14 = ROR16
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x7A, 64) // YMM15 = ROR8
        // Broadcast v0..v7 from [R8 + w*8] -> YMM0..YMM7
        mut w := 0
        while w < 8 {
            mc_b4(c, 0x41, 0x8B, 0x40, w * 8)
            mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x6E); mc_b1(c, 0xC0 | (w << 3))
            mc_vex256(c, 2, w, 0, w, 0x58)
            w += 1
        }
        // Broadcast v8..v11 from IV[0..3] ([R10 + k*4]) -> YMM8..YMM11
        w = 0
        while w < 4 {
            mc_b4(c, 0x41, 0x8B, 0x42, w * 4) // MOV EAX, [R10 + w*4]
            mc_vex3(c, 1, 0, 0, 1, 0, 0, 0, 1, 0x6E); mc_b1(c, 0xC0 | (w << 3))
            mc_vex256(c, 2, 8 + w, 0, 8 + w, 0x58)
            w += 1
        }
        // v12 = IV[4] ^ t0, v13 = IV[5], v14 = IV[6] ^ f0, v15 = IV[7] -> [RSP+160..287]
        w = 4
        while w < 8 {
            mc_b4(c, 0x41, 0x8B, 0x42, w * 4)
            if w == 4 { mc_b2(c, 0x31, 0xD0) }             // XOR EAX, EDX (t0)
            if w == 6 { mc_b3(c, 0x44, 0x31, 0xE8) }       // XOR EAX, R13D (f0)
            mc_vex3(c, 1, 0, 0, 1, 0, 0, 0, 1, 0x6E); mc_b1(c, 0xE0)
            mc_vex256(c, 2, 12, 0, 12, 0x58)
            mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0xA4, 0x24); mc_u32(c, 160 + (w - 4) * 32)
            w += 1
        }
        // 10 rounds
        mc_b2(c, 0x41, 0xBB); mc_u32(c, 10)
        mc_align16_nop(c)
        lp_b2 := buf_len(c)
        _mc_blake2s_g8(c, 0, 4, 8,  160, 0, 1);  _mc_blake2s_g8(c, 1, 5, 9,  192, 2, 3)
        _mc_blake2s_g8(c, 2, 6, 10, 224, 4, 5);  _mc_blake2s_g8(c, 3, 7, 11, 256, 6, 7)
        _mc_blake2s_g8(c, 0, 5, 10, 256, 8, 9);  _mc_blake2s_g8(c, 1, 6, 11, 160, 10, 11)
        _mc_blake2s_g8(c, 2, 7, 8,  192, 12, 13); _mc_blake2s_g8(c, 3, 4, 9,  224, 14, 15)
        mc_b4(c, 0x48, 0x83, 0xC7, 16) // ADD RDI, 16 (next sigma row)
        mc_b3(c, 0x41, 0xFF, 0xCB)
        jnz_b2 := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_b2, lp_b2)

        // Store `v[i] ^ v[i+8]` for i=0..7 into `[R9 + i*32]`
        w = 0
        while w < 4 {
            mc_vex256(c, 1, w, w, 8 + w, 0xEF)
            mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b1(c, 0x81 | (w << 3)); mc_u32(c, w * 32)
            w += 1
        }
        w = 4
        while w < 8 {
            mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0xA4, 0x24); mc_u32(c, 160 + (w - 4) * 32)
            mc_vex256(c, 1, w, w, 12, 0xEF)
            mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b1(c, 0x81 | (w << 3)); mc_u32(c, w * 32)
            w += 1
        }
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_b2_dn := mc_jmp32(c)

        // Scalar fallback for `--simd=scalar` (8 lanes sequentially, exact same layout!)
        mc_patch_rel32(c, jz_b2_sc, buf_len(c))
        mc_b3(c, 0x45, 0x31, 0xF6) // R14 = lane 0..7
        lp_b2l := buf_len(c)
        w = 0
        while w < 8 {
            mc_b4(c, 0x41, 0x8B, 0x40, w * 8)
            mc_b3(c, 0x89, 0x84, 0x24); mc_u32(c, 160 + w * 4)
            w += 1
        }
        w = 0
        while w < 8 {
            mc_b4(c, 0x41, 0x8B, 0x42, w * 4)
            if w == 4 { mc_b2(c, 0x31, 0xD0) }
            if w == 6 { mc_b3(c, 0x44, 0x31, 0xE8) }
            mc_b3(c, 0x89, 0x84, 0x24); mc_u32(c, 160 + (8 + w) * 4)
            w += 1
        }
        mc_b3(c, 0x49, 0x89, 0xFC) // MOV R12, RDI (sigma_cur; R13 holds f0)
        mc_b2(c, 0x41, 0xBB); mc_u32(c, 10)
        lp_b2sr := buf_len(c)
        mut gi := 0
        while gi < 8 {
            ga := if gi < 4 { gi } else { gi - 4 }
            gb := if gi < 4 { gi + 4 } else { 4 + ((gi - 3) & 3) }
            gc := if gi < 4 { gi + 8 } else { 8 + ((gi - 2) & 3) }
            gd := if gi < 4 { gi + 12 } else { 12 + ((gi - 1) & 3) }
            // EAX=a, EBX=b, ECX=c, EBP=d (save RBP? RBP is callee-saved & saved by mc_ai_enter, unused here!)
            mc_b3(c, 0x8B, 0x84, 0x24); mc_u32(c, 160 + ga * 4)
            mc_b3(c, 0x8B, 0x9C, 0x24); mc_u32(c, 160 + gb * 4)
            mc_b3(c, 0x8B, 0x8C, 0x24); mc_u32(c, 160 + gc * 4)
            mc_b3(c, 0x8B, 0xAC, 0x24); mc_u32(c, 160 + gd * 4)
            // a += b + msg[s1][lane]
            mc_b4(c, 0x45, 0x0F, 0xB6, 0x7C); mc_b2(c, 0x24, gi * 2)     // MOVZX R15D, BYTE [R12 + gi*2]
            mc_b4(c, 0x41, 0xC1, 0xE7, 3)                                // SHL R15D, 3 (*8 u32s)
            mc_b3(c, 0x45, 0x01, 0xF7)                                   // ADD R15D, R14D (+lane)
            mc_b2(c, 0x01, 0xD8); mc_b4(c, 0x42, 0x03, 0x04, 0xBE)       // ADD EAX, EBX; ADD EAX, [RSI+R15*4]
            mc_b2(c, 0x31, 0xC5); mc_b3(c, 0xC1, 0xCD, 16)               // XOR EBP, EAX; ROR EBP, 16
            mc_b2(c, 0x01, 0xE9); mc_b2(c, 0x31, 0xCB); mc_b3(c, 0xC1, 0xCB, 12)
            mc_b4(c, 0x45, 0x0F, 0xB6, 0x7C); mc_b2(c, 0x24, gi * 2 + 1)
            mc_b4(c, 0x41, 0xC1, 0xE7, 3); mc_b3(c, 0x45, 0x01, 0xF7)
            mc_b2(c, 0x01, 0xD8); mc_b4(c, 0x42, 0x03, 0x04, 0xBE)
            mc_b2(c, 0x31, 0xC5); mc_b3(c, 0xC1, 0xCD, 8)
            mc_b2(c, 0x01, 0xE9); mc_b2(c, 0x31, 0xCB); mc_b3(c, 0xC1, 0xCB, 7)
            mc_b3(c, 0x89, 0x84, 0x24); mc_u32(c, 160 + ga * 4)
            mc_b3(c, 0x89, 0x9C, 0x24); mc_u32(c, 160 + gb * 4)
            mc_b3(c, 0x89, 0x8C, 0x24); mc_u32(c, 160 + gc * 4)
            mc_b3(c, 0x89, 0xAC, 0x24); mc_u32(c, 160 + gd * 4)
            gi += 1
        }
        mc_b4(c, 0x49, 0x83, 0xC4, 16) // ADD R12, 16
        mc_b3(c, 0x41, 0xFF, 0xCB)
        jnz_b2sr := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_b2sr, lp_b2sr)
        w = 0
        while w < 8 {
            mc_b3(c, 0x8B, 0x84, 0x24); mc_u32(c, 160 + w * 4)
            mc_b3(c, 0x33, 0x84, 0x24); mc_u32(c, 160 + (8 + w) * 4)
            mc_b4(c, 0x43, 0x89, 0x84, 0xB1); mc_u32(c, w * 32)
            w += 1
        }
        mc_b3(c, 0x41, 0xFF, 0xC6)
        mc_b4(c, 0x41, 0x83, 0xFE, 8)
        jl_b2l := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_b2l, lp_b2l)

        mc_patch_rel32(c, jmp_b2_dn, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0x148)
        cg_reg_helper(cg, h_ai_blake2s_8(), s_b2, buf_len(c))
    }
}


// Shared compact VEX micro-emitters for AVX2 crypto / numerical / ML helpers
fn _mc_vld_rsp(c: ByteBuf, y: i64, off: i64) {
    mc_vex3(c, (y >> 3) & 1, 0, 0, 1, 0, 0, 1, 2, 0x6F)
    mc_b2(c, 0x84 | ((y & 7) << 3), 0x24); mc_u32(c, off)
}
fn _mc_vst_rsp(c: ByteBuf, off: i64, y: i64) {
    mc_vex3(c, (y >> 3) & 1, 0, 0, 1, 0, 0, 1, 2, 0x7F)
    mc_b2(c, 0x84 | ((y & 7) << 3), 0x24); mc_u32(c, off)
}
fn _mc_vpsrld_i(c: ByteBuf, dst: i64, src: i64, sh: i64) {
    mc_vex3(c, 0, 0, (src >> 3) & 1, 1, 0, dst, 1, 1, 0x72); mc_b2(c, 0xD0 | (src & 7), sh)
}
fn _mc_vpslld_i(c: ByteBuf, dst: i64, src: i64, sh: i64) {
    mc_vex3(c, 0, 0, (src >> 3) & 1, 1, 0, dst, 1, 1, 0x72); mc_b2(c, 0xF0 | (src & 7), sh)
}
fn _mc_vpsrlq_i(c: ByteBuf, dst: i64, src: i64, sh: i64) {
    mc_vex3(c, 0, 0, (src >> 3) & 1, 1, 0, dst, 1, 1, 0x73); mc_b2(c, 0xD0 | (src & 7), sh)
}
fn _mc_vpsllq_i(c: ByteBuf, dst: i64, src: i64, sh: i64) {
    mc_vex3(c, 0, 0, (src >> 3) & 1, 1, 0, dst, 1, 1, 0x73); mc_b2(c, 0xF0 | (src & 7), sh)
}
fn _mc_vrotr32(c: ByteBuf, dst: i64, src: i64, sh: i64, tmp: i64) {
    _mc_vpsrld_i(c, dst, src, sh)
    _mc_vpslld_i(c, tmp, src, 32 - sh)
    mc_vex256(c, 1, dst, dst, tmp, 0xEB)
}
fn _mc_vhsum_pd_to_xmm0(c: ByteBuf, y: i64) {
    mc_vex3(c, (y >> 3) & 1, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC1 | ((y & 7) << 3), 1)
    mc_vex3(c, 0, 0, 0, 1, 0, y, 0, 1, 0x58); mc_b1(c, 0xC1)
    mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x15); mc_b1(c, 0xC8)
    mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x58); mc_b1(c, 0xC1)
}
fn _mc_sha256_round8(c: ByteBuf, a: i64, b: i64, cc: i64, d: i64, e: i64, f: i64, g: i64, h: i64, wi: i64, k_off: i64, expand: bool) {
    // Expand W[wi] in-place if expand==true (uses YMM8..YMM13)
    if expand {
        w_m2  := (wi + 14) & 15
        w_m7  := (wi + 9) & 15
        w_m15 := (wi + 1) & 15
        // YMM8 = sigma1(W[wi-2]) = ROR17 ^ ROR19 ^ SHR10
        _mc_vld_rsp(c, 12, 160 + w_m2 * 32)
        _mc_vrotr32(c, 8, 12, 17, 13)
        _mc_vrotr32(c, 9, 12, 19, 13)
        _mc_vpsrld_i(c, 10, 12, 10)
        mc_vex256(c, 1, 8, 8, 9, 0xEF); mc_vex256(c, 1, 8, 8, 10, 0xEF)
        // YMM9 = sigma0(W[wi-15]) = ROR7 ^ ROR18 ^ SHR3
        _mc_vld_rsp(c, 12, 160 + w_m15 * 32)
        _mc_vrotr32(c, 9, 12, 7, 13)
        _mc_vrotr32(c, 10, 12, 18, 13)
        _mc_vpsrld_i(c, 11, 12, 3)
        mc_vex256(c, 1, 9, 9, 10, 0xEF); mc_vex256(c, 1, 9, 9, 11, 0xEF)
        // W[wi] += W[wi-7] + sigma0 + sigma1
        _mc_vld_rsp(c, 10, 160 + wi * 32)
        _mc_vld_rsp(c, 11, 160 + w_m7 * 32)
        mc_vex256(c, 1, 10, 10, 11, 0xFE)
        mc_vex256(c, 1, 10, 10, 8, 0xFE)
        mc_vex256(c, 1, 10, 10, 9, 0xFE)
        _mc_vst_rsp(c, 160 + wi * 32, 10)
    } else {
        _mc_vld_rsp(c, 10, 160 + wi * 32)
    }
    // YMM8 = S1(e) = ROR6 ^ ROR11 ^ ROR25
    _mc_vrotr32(c, 8, e, 6, 13)
    _mc_vrotr32(c, 9, e, 11, 13)
    _mc_vrotr32(c, 11, e, 25, 13)
    mc_vex256(c, 1, 8, 8, 9, 0xEF); mc_vex256(c, 1, 8, 8, 11, 0xEF)
    // YMM9 = Ch(e,f,g) = (e & f) ^ (~e & g)
    mc_vex256(c, 1, 9, e, f, 0xDB)
    mc_vex256(c, 1, 11, e, g, 0xDF)
    mc_vex256(c, 1, 9, 9, 11, 0xEF)
    // YMM11 = VPBROADCASTD [R12 + k_off] (R12 -> b_hi=1, rm=4 -> SIB 0x24!)
    if k_off == 0 {
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x58); mc_b2(c, 0x1C, 0x24)
    } else if k_off < 128 {
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x58); mc_b3(c, 0x5C, 0x24, k_off)
    } else {
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x58); mc_b2(c, 0x9C, 0x24); mc_u32(c, k_off)
    }
    // T1 (in h) = h + S1 + Ch + K[r] + W[wi]
    mc_vex256(c, 1, h, h, 8, 0xFE)
    mc_vex256(c, 1, h, h, 9, 0xFE)
    mc_vex256(c, 1, h, h, 11, 0xFE)
    mc_vex256(c, 1, h, h, 10, 0xFE)
    // d += T1
    mc_vex256(c, 1, d, d, h, 0xFE)
    // YMM8 = S0(a) = ROR2 ^ ROR13 ^ ROR22
    _mc_vrotr32(c, 8, a, 2, 13)
    _mc_vrotr32(c, 9, a, 13, 13)
    _mc_vrotr32(c, 11, a, 22, 13)
    mc_vex256(c, 1, 8, 8, 9, 0xEF); mc_vex256(c, 1, 8, 8, 11, 0xEF)
    // YMM9 = Maj(a,b,c) = (a & (b | c)) | (b & c)
    mc_vex256(c, 1, 9, b, cc, 0xEB)
    mc_vex256(c, 1, 9, 9, a, 0xDB)
    mc_vex256(c, 1, 11, b, cc, 0xDB)
    mc_vex256(c, 1, 9, 9, 11, 0xEB)
    // h = T1 + S0 + Maj
    mc_vex256(c, 1, h, h, 8, 0xFE)
    mc_vex256(c, 1, h, h, 9, 0xFE)
}

fn _mc_mont_mul4(c: ByteBuf, dst: i64, a: i64, b: i64) {
    // 4-lane AVX2 Montgomery multiply: YMM10=m, YMM11=minv. Clobbers YMM6, YMM7, YMM8.
    mc_vex256(c, 1, 6, a, b, 0xF4)    // p = VPMULUDQ(a, b)
    mc_vex256(c, 1, 7, 6, 11, 0xF4)   // w = VPMULUDQ(p, minv) (low32)
    mc_vex256(c, 1, 7, 7, 10, 0xF4)   // wm = VPMULUDQ(w, m)
    mc_vex256(c, 1, 6, 6, 7, 0xD4)    // p + wm
    _mc_vpsrlq_i(c, dst, 6, 32)       // z = (p + wm) >> 32
    mc_vex256(c, 2, 8, 10, dst, 0x37) // mask = VPCMPGTQ(m, z) (-1 if z < m, 0 if z >= m)
    mc_vex256(c, 1, 7, 8, 10, 0xDF)   // sub = VPANDN(mask, m) (m if z >= m, 0 if z < m)
    mc_vex256(c, 1, dst, dst, 7, 0xFB) // dst = VPSUBQ(z, sub)
}

fn _mc_mont_mul4_x2(c: ByteBuf, dstA: i64, aA: i64, bA: i64, dstB: i64, aB: i64, bB: i64) {
    // Interleaved 8-lane (2x4 YMM) AVX2 Montgomery multiply: YMM10=m, YMM11=minv.
    // Stream A uses temps Y6,Y7,Y8; Stream B uses temps Y9,Y12,Y13. dstA may be Y6; dstB may be Y9.
    mc_vex256(c, 1, 6, aA, bA, 0xF4);    mc_vex256(c, 1, 9, aB, bB, 0xF4)
    mc_vex256(c, 1, 7, 6, 11, 0xF4);     mc_vex256(c, 1, 12, 9, 11, 0xF4)
    mc_vex256(c, 1, 7, 7, 10, 0xF4);     mc_vex256(c, 1, 12, 12, 10, 0xF4)
    mc_vex256(c, 1, 6, 6, 7, 0xD4);      mc_vex256(c, 1, 9, 9, 12, 0xD4)
    _mc_vpsrlq_i(c, dstA, 6, 32);        _mc_vpsrlq_i(c, dstB, 9, 32)
    mc_vex256(c, 2, 8, 10, dstA, 0x37);  mc_vex256(c, 2, 13, 10, dstB, 0x37)
    mc_vex256(c, 1, 7, 8, 10, 0xDF);     mc_vex256(c, 1, 12, 13, 10, 0xDF)
    mc_vex256(c, 1, dstA, dstA, 7, 0xFB); mc_vex256(c, 1, dstB, dstB, 12, 0xFB)
}

fn emit_ai_wave3b_helpers(cg: CodegenCtx) {
    c := cg.code

    // 4. `h_ai_sha256_8`: 8-stream AVX2 SHA-256 (`ptrs8`, `state8x8_u32`, `nblocks`) + scalar fallback
    if cg_is_helper_used(cg, h_ai_sha256_8()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_sha := buf_len(cg.rdata)
        // +0: SHA-256 K[0..63] (256B)
        buf_push_u32(cg.rdata, 0x428a2f98); buf_push_u32(cg.rdata, 0x71374491); buf_push_u32(cg.rdata, 0xb5c0fbcf); buf_push_u32(cg.rdata, 0xe9b5dba5)
        buf_push_u32(cg.rdata, 0x3956c25b); buf_push_u32(cg.rdata, 0x59f111f1); buf_push_u32(cg.rdata, 0x923f82a4); buf_push_u32(cg.rdata, 0xab1c5ed5)
        buf_push_u32(cg.rdata, 0xd807aa98); buf_push_u32(cg.rdata, 0x12835b01); buf_push_u32(cg.rdata, 0x243185be); buf_push_u32(cg.rdata, 0x550c7dc3)
        buf_push_u32(cg.rdata, 0x72be5d74); buf_push_u32(cg.rdata, 0x80deb1fe); buf_push_u32(cg.rdata, 0x9bdc06a7); buf_push_u32(cg.rdata, 0xc19bf174)
        buf_push_u32(cg.rdata, 0xe49b69c1); buf_push_u32(cg.rdata, 0xefbe4786); buf_push_u32(cg.rdata, 0x0fc19dc6); buf_push_u32(cg.rdata, 0x240ca1cc)
        buf_push_u32(cg.rdata, 0x2de92c6f); buf_push_u32(cg.rdata, 0x4a7484aa); buf_push_u32(cg.rdata, 0x5cb0a9dc); buf_push_u32(cg.rdata, 0x76f988da)
        buf_push_u32(cg.rdata, 0x983e5152); buf_push_u32(cg.rdata, 0xa831c66d); buf_push_u32(cg.rdata, 0xb00327c8); buf_push_u32(cg.rdata, 0xbf597fc7)
        buf_push_u32(cg.rdata, 0xc6e00bf3); buf_push_u32(cg.rdata, 0xd5a79147); buf_push_u32(cg.rdata, 0x06ca6351); buf_push_u32(cg.rdata, 0x14292967)
        buf_push_u32(cg.rdata, 0x27b70a85); buf_push_u32(cg.rdata, 0x2e1b2138); buf_push_u32(cg.rdata, 0x4d2c6dfc); buf_push_u32(cg.rdata, 0x53380d13)
        buf_push_u32(cg.rdata, 0x650a7354); buf_push_u32(cg.rdata, 0x766a0abb); buf_push_u32(cg.rdata, 0x81c2c92e); buf_push_u32(cg.rdata, 0x92722c85)
        buf_push_u32(cg.rdata, 0xa2bfe8a1); buf_push_u32(cg.rdata, 0xa81a664b); buf_push_u32(cg.rdata, 0xc24b8b70); buf_push_u32(cg.rdata, 0xc76c51a3)
        buf_push_u32(cg.rdata, 0xd192e819); buf_push_u32(cg.rdata, 0xd6990624); buf_push_u32(cg.rdata, 0xf40e3585); buf_push_u32(cg.rdata, 0x106aa070)
        buf_push_u32(cg.rdata, 0x19a4c116); buf_push_u32(cg.rdata, 0x1e376c08); buf_push_u32(cg.rdata, 0x2748774c); buf_push_u32(cg.rdata, 0x34b0bcb5)
        buf_push_u32(cg.rdata, 0x391c0cb3); buf_push_u32(cg.rdata, 0x4ed8aa4a); buf_push_u32(cg.rdata, 0x5b9cca4f); buf_push_u32(cg.rdata, 0x682e6ff3)
        buf_push_u32(cg.rdata, 0x748f82ee); buf_push_u32(cg.rdata, 0x78a5636f); buf_push_u32(cg.rdata, 0x84c87814); buf_push_u32(cg.rdata, 0x8cc70208)
        buf_push_u32(cg.rdata, 0x90befffa); buf_push_u32(cg.rdata, 0xa4506ceb); buf_push_u32(cg.rdata, 0xbef9a3f7); buf_push_u32(cg.rdata, 0xc67178f2)
        // +256: bswap32 shuffle mask (2x16B)
        mut bi := 0
        while bi < 8 {
            bbase := (bi & 3) * 4
            buf_push(cg.rdata, bbase + 3); buf_push(cg.rdata, bbase + 2)
            buf_push(cg.rdata, bbase + 1); buf_push(cg.rdata, bbase + 0)
            bi += 1
        }

        mc_align16(c)
        s_sha := buf_len(c)
        mc_ai_enter(c, 0x368)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = ptrs8
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = state8x8
        mc_b4(c, 0x48, 0x8B, 0x51, 16)   // RDX = nblocks
        mc_b3(c, 0x48, 0x85, 0xD2)
        jle_sha_dn := mc_jcc32(c, 0x8E)

        cg_lea_rax_rdata(cg, roff_sha); mc_b3(c, 0x49, 0x89, 0xC2) // R10 = &K[0]
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_sha_sc := mc_jcc32(c, 0x84)

        // Copy ptrs8[0..7] to [RSP+672..735]
        mut l := 0
        while l < 8 {
            mc_b4(c, 0x49, 0x8B, 0x40, l * 8)
            mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 672 + l * 8)
            l += 1
        }
        // YMM15 = bswap32 mask ([R10 + 256])
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b1(c, 0xBA); mc_u32(c, 256)

        mc_align16_nop(c)
        lp_shab := buf_len(c)
        // Transpose 16 words x 8 streams directly into W[0..15] at [RSP+160..671]
        mut g := 0
        while g < 4 {
            goff := g * 16
            l = 0
            while l < 4 {
                mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 672 + l * 8)
                mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 2, 0x6F)
                if goff == 0 { mc_b1(c, l << 3) } else { mc_b2(c, 0x40 | (l << 3), goff) }
                mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 672 + (l + 4) * 8)
                mc_vex3(c, 0, 0, 0, 3, 0, l, 1, 1, 0x38)
                if goff == 0 { mc_b2(c, l << 3, 1) } else { mc_b3(c, 0x40 | (l << 3), goff, 1) }
                mc_vex256(c, 2, l, l, 15, 0x00) // VPSHUFB bswap32
                l += 1
            }
            mc_vex256(c, 1, 4, 0, 1, 0x62) // VPUNPCKLDQ Y4, Y0, Y1
            mc_vex256(c, 1, 5, 0, 1, 0x6A) // VPUNPCKHDQ Y5, Y0, Y1
            mc_vex256(c, 1, 6, 2, 3, 0x62) // VPUNPCKLDQ Y6, Y2, Y3
            mc_vex256(c, 1, 7, 2, 3, 0x6A) // VPUNPCKHDQ Y7, Y2, Y3
            mc_vex256(c, 1, 8,  4, 6, 0x6C); _mc_vst_rsp(c, 160 + (g * 4 + 0) * 32, 8)
            mc_vex256(c, 1, 9,  4, 6, 0x6D); _mc_vst_rsp(c, 160 + (g * 4 + 1) * 32, 9)
            mc_vex256(c, 1, 10, 5, 7, 0x6C); _mc_vst_rsp(c, 160 + (g * 4 + 2) * 32, 10)
            mc_vex256(c, 1, 11, 5, 7, 0x6D); _mc_vst_rsp(c, 160 + (g * 4 + 3) * 32, 11)
            g += 1
        }
        // Advance all 8 pointers by +64
        l = 0
        while l < 8 {
            mc_b4(c, 0x48, 0x83, 0x84, 0x24); mc_u32(c, 672 + l * 8); mc_b1(c, 64)
            l += 1
        }
        // Load a..h -> YMM0..YMM7 from [R9 + w*32]
        mut w := 0
        while w < 8 {
            mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b1(c, 0x81 | (w << 3)); mc_u32(c, w * 32)
            w += 1
        }
        // Rounds 0..15 (no schedule expansion)
        mc_b3(c, 0x4D, 0x89, 0xD4) // MOV R12, R10 (&K[0])
        mut r := 0
        while r < 16 {
            a := (8 - (r & 7)) & 7; b := (a + 1) & 7; cc := (a + 2) & 7; d := (a + 3) & 7
            e := (a + 4) & 7; f := (a + 5) & 7; gg := (a + 6) & 7; h := (a + 7) & 7
            _mc_sha256_round8(c, a, b, cc, d, e, f, gg, h, r, r * 4, false)
            r += 1
        }
        // Rounds 16..63: 3 iterations x 16 unrolled rounds!
        mc_b4(c, 0x49, 0x83, 0xC4, 64) // ADD R12, 64 (&K[16])
        mc_b2(c, 0x41, 0xBB); mc_u32(c, 3) // MOV R11D, 3
        lp_shar := buf_len(c)
        r = 0
        while r < 16 {
            a := (8 - (r & 7)) & 7; b := (a + 1) & 7; cc := (a + 2) & 7; d := (a + 3) & 7
            e := (a + 4) & 7; f := (a + 5) & 7; gg := (a + 6) & 7; h := (a + 7) & 7
            _mc_sha256_round8(c, a, b, cc, d, e, f, gg, h, r, r * 4, true)
            r += 1
        }
        mc_b4(c, 0x49, 0x83, 0xC4, 64)
        mc_b3(c, 0x41, 0xFF, 0xCB)
        jnz_shar := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_shar, lp_shar)
        // Feed-forward + store state[w] += YMM{w}
        w = 0
        while w < 8 {
            mc_vex3(c, 0, 0, 1, 1, 0, w, 1, 1, 0xFE); mc_b1(c, 0x81 | (w << 3)); mc_u32(c, w * 32)
            mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b1(c, 0x81 | (w << 3)); mc_u32(c, w * 32)
            w += 1
        }
        mc_b3(c, 0x48, 0xFF, 0xCA) // DEC RDX
        jnz_shab := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_shab, lp_shab)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_sha_dn := mc_jmp32(c)

        // Scalar fallback for `--simd=scalar` (exact same 8-stream lane-major layout!)
        mc_patch_rel32(c, jz_sha_sc, buf_len(c))
        mc_b3(c, 0x45, 0x31, 0xF6) // R14 = lane 0..7
        lp_shas_l := buf_len(c)
        mc_b4(c, 0x4B, 0x8B, 0x34, 0xF0) // MOV RSI, [R8 + R14*8] (msg ptr)
        mc_b3(c, 0x49, 0x89, 0xD5)       // MOV R13, RDX (nblocks)
        lp_shas_b := buf_len(c)
        // Load 16 BE words into [RSP+736..799]
        mc_b2(c, 0x31, 0xC9) // ECX = 0..15
        lp_shas_w := buf_len(c)
        mc_b3(c, 0x8B, 0x04, 0x8E) // MOV EAX, [RSI + RCX*4]
        mc_b2(c, 0x0F, 0xC8)       // BSWAP EAX
        mc_b4(c, 0x89, 0x84, 0x8C, 0xE0); mc_b3(c, 0x02, 0x00, 0x00) // MOV [RSP + RCX*4 + 736], EAX
        mc_b3(c, 0x48, 0xFF, 0xC1); mc_b3(c, 0x83, 0xF9, 16)
        jl_sw := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_sw, lp_shas_w)
        // Load a..h from [R9 + w*32 + R14*4] into [RSP+800+w*4]
        w = 0
        while w < 8 {
            mc_b4(c, 0x43, 0x8B, 0x84, 0xB1); mc_u32(c, w * 32)
            mc_b3(c, 0x89, 0x84, 0x24); mc_u32(c, 800 + w * 4)
            w += 1
        }
        // 64 rounds scalar: RCX = r (0..63), R15D/EBX/EBP/EDI/EAX temps
        mc_b2(c, 0x31, 0xC9)
        lp_shas_r := buf_len(c)
        mc_b3(c, 0x83, 0xF9, 16)
        jl_noexp := mc_jcc32(c, 0x8C)
        // Expand W[r&15]:
        mc_b2(c, 0x89, 0xC8); mc_b3(c, 0x83, 0xC0, 14); mc_b3(c, 0x83, 0xE0, 15)
        mc_b4(c, 0x8B, 0x9C, 0x84, 0xE0); mc_b3(c, 0x02, 0x00, 0x00) // EBX = W[(r-2)&15]
        mc_b2(c, 0x89, 0xDF); mc_b3(c, 0xC1, 0xCF, 17)
        mc_b2(c, 0x89, 0xDD); mc_b3(c, 0xC1, 0xCD, 19); mc_b2(c, 0x31, 0xEF)
        mc_b3(c, 0xC1, 0xEB, 10); mc_b2(c, 0x31, 0xDF) // EDI = sigma1
        mc_b2(c, 0x89, 0xC8); mc_b3(c, 0x83, 0xC0, 1); mc_b3(c, 0x83, 0xE0, 15)
        mc_b4(c, 0x8B, 0x9C, 0x84, 0xE0); mc_b3(c, 0x02, 0x00, 0x00) // EBX = W[(r-15)&15]
        mc_b2(c, 0x89, 0xDD); mc_b3(c, 0xC1, 0xCD, 7)
        mc_b3(c, 0x41, 0x89, 0xDF); mc_b4(c, 0x41, 0xC1, 0xCF, 18); mc_b3(c, 0x44, 0x31, 0xFD)
        mc_b3(c, 0xC1, 0xEB, 3); mc_b2(c, 0x31, 0xDD); mc_b2(c, 0x01, 0xEF) // EDI = sigma0 + sigma1
        mc_b2(c, 0x89, 0xC8); mc_b3(c, 0x83, 0xC0, 9); mc_b3(c, 0x83, 0xE0, 15)
        mc_b4(c, 0x03, 0xBC, 0x84, 0xE0); mc_b3(c, 0x02, 0x00, 0x00) // EDI += W[(r-7)&15]
        mc_b2(c, 0x89, 0xC8); mc_b3(c, 0x83, 0xE0, 15)
        mc_b4(c, 0x01, 0xBC, 0x84, 0xE0); mc_b3(c, 0x02, 0x00, 0x00) // W[r&15] += EDI
        mc_patch_rel32(c, jl_noexp, buf_len(c))
        // T1 = h + S1(e) + Ch(e,f,g) + K[r] + W[r&15] -> R11D
        mc_b3(c, 0x8B, 0x9C, 0x24); mc_u32(c, 816) // EBX = e
        mc_b2(c, 0x89, 0xDF); mc_b3(c, 0xC1, 0xCF, 6)
        mc_b2(c, 0x89, 0xDD); mc_b3(c, 0xC1, 0xCD, 11); mc_b2(c, 0x31, 0xEF)
        mc_b2(c, 0x89, 0xDD); mc_b3(c, 0xC1, 0xCD, 25); mc_b2(c, 0x31, 0xEF) // EDI = S1
        mc_b3(c, 0x8B, 0x84, 0x24); mc_u32(c, 820) // EAX = f
        mc_b2(c, 0x21, 0xD8) // e & f
        mc_b2(c, 0x89, 0xDD); mc_b2(c, 0xF7, 0xD5) // ~e
        mc_b3(c, 0x23, 0xAC, 0x24); mc_u32(c, 824) // ~e & g
        mc_b2(c, 0x31, 0xE8) // EAX = Ch
        mc_b2(c, 0x01, 0xF8) // Ch + S1
        mc_b3(c, 0x03, 0x84, 0x24); mc_u32(c, 828) // + h
        mc_b4(c, 0x41, 0x03, 0x04, 0x8A)           // + K[r] ([R10 + RCX*4])
        mc_b2(c, 0x89, 0xCB); mc_b3(c, 0x83, 0xE3, 15)
        mc_b4(c, 0x03, 0x84, 0x9C, 0xE0); mc_b3(c, 0x02, 0x00, 0x00) // + W[r&15]
        mc_b3(c, 0x41, 0x89, 0xC3) // R11D = T1
        // T2 = S0(a) + Maj(a,b,c) -> R15D
        mc_b3(c, 0x8B, 0x9C, 0x24); mc_u32(c, 800) // EBX = a
        mc_b2(c, 0x89, 0xDF); mc_b3(c, 0xC1, 0xCF, 2)
        mc_b2(c, 0x89, 0xDD); mc_b3(c, 0xC1, 0xCD, 13); mc_b2(c, 0x31, 0xEF)
        mc_b2(c, 0x89, 0xDD); mc_b3(c, 0xC1, 0xCD, 22); mc_b2(c, 0x31, 0xEF) // EDI = S0
        mc_b3(c, 0x8B, 0x84, 0x24); mc_u32(c, 804) // EAX = b
        mc_b3(c, 0x8B, 0xAC, 0x24); mc_u32(c, 808) // EBP = c
        mc_b3(c, 0x41, 0x89, 0xC7); mc_b3(c, 0x41, 0x09, 0xEF) // R15D = b | c
        mc_b3(c, 0x41, 0x21, 0xDF) // R15D = a & (b | c)
        mc_b2(c, 0x21, 0xE8)       // EAX = b & c
        mc_b3(c, 0x41, 0x09, 0xC7) // R15D = Maj
        mc_b3(c, 0x41, 0x01, 0xFF) // R15D = T2
        // Shift h<-g<-f<-e<-d+T1, d<-c<-b<-a<-T1+T2
        mc_b3(c, 0x8B, 0x84, 0x24); mc_u32(c, 824); mc_b3(c, 0x89, 0x84, 0x24); mc_u32(c, 828)
        mc_b3(c, 0x8B, 0x84, 0x24); mc_u32(c, 820); mc_b3(c, 0x89, 0x84, 0x24); mc_u32(c, 824)
        mc_b3(c, 0x8B, 0x84, 0x24); mc_u32(c, 816); mc_b3(c, 0x89, 0x84, 0x24); mc_u32(c, 820)
        mc_b3(c, 0x8B, 0x84, 0x24); mc_u32(c, 812); mc_b3(c, 0x44, 0x01, 0xD8); mc_b3(c, 0x89, 0x84, 0x24); mc_u32(c, 816)
        mc_b3(c, 0x8B, 0x84, 0x24); mc_u32(c, 808); mc_b3(c, 0x89, 0x84, 0x24); mc_u32(c, 812)
        mc_b3(c, 0x8B, 0x84, 0x24); mc_u32(c, 804); mc_b3(c, 0x89, 0x84, 0x24); mc_u32(c, 808)
        mc_b3(c, 0x8B, 0x84, 0x24); mc_u32(c, 800); mc_b3(c, 0x89, 0x84, 0x24); mc_u32(c, 804)
        mc_b3(c, 0x45, 0x01, 0xDF); mc_b4(c, 0x44, 0x89, 0xBC, 0x24); mc_u32(c, 800) // a = T1 + T2
        mc_b3(c, 0x48, 0xFF, 0xC1); mc_b3(c, 0x83, 0xF9, 64)
        jl_sr := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_sr, lp_shas_r)
        // Feed-forward into state[w*8 + lane]
        w = 0
        while w < 8 {
            mc_b3(c, 0x8B, 0x84, 0x24); mc_u32(c, 800 + w * 4)
            mc_b4(c, 0x43, 0x01, 0x84, 0xB1); mc_u32(c, w * 32)
            w += 1
        }
        mc_b4(c, 0x48, 0x83, 0xC6, 64) // RSI += 64
        mc_b3(c, 0x49, 0xFF, 0xCD)     // DEC R13
        jnz_sb := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_sb, lp_shas_b)
        mc_b3(c, 0x41, 0xFF, 0xC6); mc_b4(c, 0x41, 0x83, 0xFE, 8)
        jl_sl := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_sl, lp_shas_l)

        mc_patch_rel32(c, jmp_sha_dn, buf_len(c))
        mc_patch_rel32(c, jle_sha_dn, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0x368)
        cg_reg_helper(cg, h_ai_sha256_8(), s_sha, buf_len(c))
    }

    // 5. `h_ai_speck128_4`: 4-lane AVX2 64-bit Speck-128 CTR scan (`b0`, `b1`, `rkeys`, `nr`) -> XOR acc
    if cg_is_helper_used(cg, h_ai_speck128_4()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_sp := buf_len(cg.rdata)
        // +0: ROR8 shuffle mask for 4 x u64 (2x16B): [1,2,3,4,5,6,7,0, 9,10,11,12,13,14,15,8]
        mut si := 0
        while si < 4 {
            sb := (si & 1) * 8
            buf_push(cg.rdata, sb + 1); buf_push(cg.rdata, sb + 2); buf_push(cg.rdata, sb + 3); buf_push(cg.rdata, sb + 4)
            buf_push(cg.rdata, sb + 5); buf_push(cg.rdata, sb + 6); buf_push(cg.rdata, sb + 7); buf_push(cg.rdata, sb + 0)
            si += 1
        }
        // +32: [0, 1, 2, 3] u64
        buf_push_u64(cg.rdata, 0); buf_push_u64(cg.rdata, 1); buf_push_u64(cg.rdata, 2); buf_push_u64(cg.rdata, 3)
        // +64: [0*C, 1*C, 2*C, 3*C] where C = 0x9E3779B97F4A7C15
        buf_push_u64(cg.rdata, 0)
        buf_push_u64(cg.rdata, 0x9E3779B97F4A7C15)
        buf_push_u64(cg.rdata, 0x9E3779B97F4A7C15 *% 2)
        buf_push_u64(cg.rdata, 0x9E3779B97F4A7C15 *% 3)
        // +96: 4*C, +104: 0xA5A5A5A5A5A5A5A5, +112: 4
        buf_push_u64(cg.rdata, 0x9E3779B97F4A7C15 *% 4)
        buf_push_u64(cg.rdata, 0xA5A5A5A5A5A5A5A5)
        buf_push_u64(cg.rdata, 4)

        mc_align16(c)
        s_sp := buf_len(c)
        mc_ai_enter(c, 0xB8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = b0 (cur blk)
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = b1
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = rkeys
        mc_b4(c, 0x48, 0x8B, 0x51, 24)   // RDX = nr
        mc_b3(c, 0x45, 0x31, 0xFF)       // R15 = acc = 0

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_sp_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x4D, 0x8D, 0x59, 0xFC) // R11 = b1 - 4
        mc_b3(c, 0x4D, 0x39, 0xD8)       // CMP R8, R11
        jg_sp_tail := mc_jcc32(c, 0x8F)

        cg_lea_rax_rdata(cg, roff_sp); mc_b3(c, 0x49, 0x89, 0xC4) // R12 = consts
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x3C, 0x24)       // YMM15 = ROR8 shuf ([R12])
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x59); mc_b3(c, 0x74, 0x24, 96)   // YMM14 = 4*C
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x59); mc_b3(c, 0x6C, 0x24, 104)  // YMM13 = 0xA5A5..
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x59); mc_b3(c, 0x64, 0x24, 112)  // YMM12 = 4
        // YMM11 = [b0, b0+1, b0+2, b0+3]
        mc_vex3(c, 1, 0, 1, 1, 1, 0, 0, 1, 0x6E); mc_b1(c, 0xD8)             // VMOVQ XMM11, R8
        mc_vex256(c, 2, 11, 0, 11, 0x59)                                     // VPBROADCASTQ YMM11, XMM11
        mc_vex3(c, 1, 0, 1, 1, 0, 11, 1, 1, 0xD4); mc_b3(c, 0x5C, 0x24, 32)  // VPADDQ YMM11, YMM11, [R12+32]
        // YMM10 = [b0*C, (b0+1)*C, (b0+2)*C, (b0+3)*C]
        mc_mov_rax_imm(c, 0x9E3779B97F4A7C15)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC0)                                     // IMUL RAX, R8
        mc_vex3(c, 1, 0, 0, 1, 1, 0, 0, 1, 0x6E); mc_b1(c, 0xD0)             // VMOVQ XMM10, RAX
        mc_vex256(c, 2, 10, 0, 10, 0x59)                                     // VPBROADCASTQ YMM10, XMM10
        mc_vex3(c, 1, 0, 1, 1, 0, 10, 1, 1, 0xD4); mc_b3(c, 0x54, 0x24, 64)  // VPADDQ YMM10, YMM10, [R12+64]
        mc_vex256(c, 1, 9, 9, 9, 0xEF)                                       // YMM9 = acc = 0

        mc_align16_nop(c)
        lp_sp4 := buf_len(c)
        mc_vex256(c, 1, 0, 10, 10, 0xEB)                                     // YMM0 = x
        mc_vex256(c, 1, 1, 11, 13, 0xEF)                                     // YMM1 = y = blk ^ 0xA5A5..
        mc_vex256(c, 1, 10, 10, 14, 0xD4)                                    // x_base += 4*C
        mc_vex256(c, 1, 11, 11, 12, 0xD4)                                    // blk += 4
        mc_b2(c, 0x31, 0xC9)                                                 // RCX = r = 0
        lp_spr := buf_len(c)
        mc_vex256(c, 2, 0, 0, 15, 0x00)                                      // x = ROR8(x) (1 inst VPSHUFB!)
        mc_vex256(c, 1, 0, 0, 1, 0xD4)                                       // x += y
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x59); mc_b2(c, 0x14, 0xCA)       // VPBROADCASTQ YMM2, [R10 + RCX*8]
        mc_vex256(c, 1, 0, 0, 2, 0xEF)                                       // x ^= rk
        _mc_vpsllq_i(c, 2, 1, 3); _mc_vpsrlq_i(c, 3, 1, 61)
        mc_vex256(c, 1, 1, 2, 3, 0xEB)                                       // y = ROL3(y)
        mc_vex256(c, 1, 1, 1, 0, 0xEF)                                       // y ^= x
        mc_b3(c, 0x48, 0xFF, 0xC1); mc_b3(c, 0x48, 0x39, 0xD1)
        jl_spr := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_spr, lp_spr)
        mc_vex256(c, 1, 9, 9, 0, 0xEF); mc_vex256(c, 1, 9, 9, 1, 0xEF)       // acc ^= x ^ y
        mc_b4(c, 0x49, 0x83, 0xC0, 4)                                        // R8 += 4
        mc_b3(c, 0x4D, 0x39, 0xD8)
        jle_sp4 := mc_jcc32(c, 0x8E); mc_patch_rel32(c, jle_sp4, lp_sp4)
        // Reduce YMM9 (4 x u64 XOR) -> R15
        mc_vex3(c, 1, 0, 0, 3, 0, 0, 1, 1, 0x39); mc_b2(c, 0xC8, 1)          // VEXTRACTI128 XMM0, YMM9, 1
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 1, 0xEF); mc_b1(c, 0xC1)             // VPXOR XMM0, XMM0, XMM9
        mc_b4(c, 0xC5, 0xF1, 0x73, 0xD8); mc_b1(c, 8)                        // VPSRLDQ XMM1, XMM0, 8
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0xEF); mc_b1(c, 0xC1)             // VPXOR XMM0, XMM0, XMM1
        mc_b4(c, 0x66, 0x49, 0x0F, 0x7E); mc_b1(c, 0xC7)                     // MOVQ R15, XMM0
        mc_b3(c, 0xC5, 0xF8, 0x77)

        // Scalar tail + `--simd=scalar`
        mc_patch_rel32(c, jg_sp_tail, buf_len(c))
        mc_patch_rel32(c, jz_sp_sc, buf_len(c))
        mc_mov_rax_imm(c, 0x9E3779B97F4A7C15); mc_b3(c, 0x49, 0x89, 0xC5)    // R13 = C
        mc_mov_rax_imm(c, 0xA5A5A5A5A5A5A5A5); mc_b3(c, 0x49, 0x89, 0xC6)    // R14 = 0xA5A5..
        lp_spsc := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xC8)
        jge_sp_dn := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4C, 0x89, 0xC0); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC5)         // RAX = x = blk * C
        mc_b3(c, 0x4C, 0x89, 0xC3); mc_b3(c, 0x4C, 0x31, 0xF3)               // RBX = y = blk ^ 0xA5..
        mc_b2(c, 0x31, 0xC9)                                                 // RCX = r = 0
        lp_spsr := buf_len(c)
        mc_b4(c, 0x48, 0xC1, 0xC8, 8)                                        // ROR RAX, 8
        mc_b3(c, 0x48, 0x01, 0xD8)                                           // ADD RAX, RBX
        mc_b4(c, 0x49, 0x33, 0x04, 0xCA)                                     // XOR RAX, [R10 + RCX*8]
        mc_b4(c, 0x48, 0xC1, 0xC3, 3)                                        // ROL RBX, 3
        mc_b3(c, 0x48, 0x31, 0xC3)                                           // XOR RBX, RAX
        mc_b3(c, 0x48, 0xFF, 0xC1); mc_b3(c, 0x48, 0x39, 0xD1)
        jl_spsr := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_spsr, lp_spsr)
        mc_b3(c, 0x49, 0x31, 0xC7); mc_b3(c, 0x49, 0x31, 0xDF)               // R15 ^= x ^ y
        mc_b3(c, 0x49, 0xFF, 0xC0)                                           // R8 += 1
        jmp_spsc := mc_jmp32(c); mc_patch_rel32(c, jmp_spsc, lp_spsc)

        mc_patch_rel32(c, jge_sp_dn, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xF8) // MOV RAX, R15
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_speck128_4(), s_sp, buf_len(c))
    }

    // 6. `h_ai_modexp_mont32`: 4-lane AVX2 VPMULUDQ Montgomery modexp (`bases_u32`, `exps_u32`, `params4`, `n`, `out_u32`) -> sum(out)
    if cg_is_helper_used(cg, h_ai_modexp_mont32()) {
        mc_align16(c)
        s_me := buf_len(c)
        mc_ai_enter(c, 0x118) // [0..159]=XMM6..15, [160]=r1, [192]=r2, [224]=acc
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = bases_u32
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = exps_u32
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = params4 [m, minv, r1, r2]
        mc_b4(c, 0x48, 0x8B, 0x51, 24)   // RDX = n
        mc_b4(c, 0x4C, 0x8B, 0x59, 32)   // R11 = out_u32 (optional if 0)
        mc_b3(c, 0x45, 0x31, 0xFF)       // R15 = acc = 0
        mc_b2(c, 0x31, 0xC9)             // RCX = i = 0
        mc_b3(c, 0x48, 0x85, 0xD2)
        jle_me_dn := mc_jcc32(c, 0x8E)
        // If R11 < 0: native generator fills bs[0..n-1] = (k*31+17)%m, es[0..n-1] = (k*19+1234567)&0x3FFFFFFF for k=-R11..
        mc_b3(c, 0x4D, 0x85, 0xDB); jns_me_nogen := mc_jcc32(c, 0x89)
        mc_b3(c, 0x49, 0xF7, 0xDB) // R11 = k0 = -R11
        mc_b3(c, 0x49, 0x8B, 0x32) // RSI = m = params4[0]
        // Initial b = (k0*31 + 17) % m -> RAX; initial e = k0*19 + 1234567 -> RDI
        mc_b4(c, 0x49, 0x6B, 0xC3, 31); mc_b4(c, 0x48, 0x83, 0xC0, 17)
        mc_b3(c, 0x48, 0x39, 0xF0); jb_meg_m := mc_jcc8(c, 0x72)
        mc_b3(c, 0x48, 0x89, 0xD3); mc_b2(c, 0x31, 0xD2); mc_b3(c, 0x48, 0xF7, 0xF6); mc_b3(c, 0x48, 0x89, 0xD0); mc_b3(c, 0x48, 0x89, 0xDA)
        mc_patch_jcc8(c, jb_meg_m, buf_len(c))
        mc_b4(c, 0x49, 0x6B, 0xFB, 19); mc_b2(c, 0x81, 0xC7); mc_u32(c, 1234567) // RDI = e0
        mc_b1(c, 0xBB); mc_u32(c, 0x3FFFFFFF) // EBX = mask
        lp_meg := buf_len(c)
        mc_b4(c, 0x41, 0x89, 0x04, 0x88) // [R8 + RCX*4] = EAX
        mc_b2(c, 0x89, 0xFD); mc_b2(c, 0x21, 0xDD); mc_b4(c, 0x41, 0x89, 0x2C, 0x89) // [R9 + RCX*4] = EDI & mask
        mc_b4(c, 0x48, 0x83, 0xC0, 31); mc_b3(c, 0x48, 0x39, 0xF0); jb_meg_w := mc_jcc8(c, 0x72); mc_b3(c, 0x48, 0x29, 0xF0); mc_patch_jcc8(c, jb_meg_w, buf_len(c))
        mc_b3(c, 0x83, 0xC7, 19)
        mc_b3(c, 0x48, 0xFF, 0xC1); mc_b3(c, 0x48, 0x39, 0xD1); jb_meg := mc_jcc8(c, 0x72); mc_patch_jcc8(c, jb_meg, lp_meg)
        mc_b2(c, 0x31, 0xC9); mc_b3(c, 0x45, 0x31, 0xDB) // RCX = 0, R11 = 0
        mc_patch_rel32(c, jns_me_nogen, buf_len(c))

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_me_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x4C, 0x8D, 0x62, 0xF8) // R12 = n - 8
        mc_b3(c, 0x4C, 0x39, 0xE1)       // CMP RCX, R12
        jg_me_tail := mc_jcc32(c, 0x8F)

        // Broadcast params: Y10=m, Y11=minv, Y14=0, Y15=1; [RSP+160]=r1, [RSP+192]=r2, [RSP+224]=acc(0)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x59); mc_b1(c, 0x12)         // Y10 = bcast(m)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x59); mc_b2(c, 0x5A, 8)      // Y11 = bcast(minv)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x59); mc_b2(c, 0x42, 16)     // Y0  = bcast(r1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x84, 0x24); mc_u32(c, 160)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x59); mc_b2(c, 0x42, 24)     // Y0  = bcast(r2)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x84, 0x24); mc_u32(c, 192)
        mc_vex256(c, 1, 14, 14, 14, 0xEF)                                // Y14 = 0
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0xB4, 0x24); mc_u32(c, 224) // [224] = 0
        mc_b1(c, 0xB8); mc_u32(c, 1)
        mc_vex3(c, 1, 0, 0, 1, 1, 0, 0, 1, 0x6E); mc_b1(c, 0xF8)         // VMOVQ X15, RAX
        mc_vex256(c, 2, 15, 0, 15, 0x59)                                 // Y15 = [1, 1, 1, 1] u64

        mc_align16_nop(c)
        lp_me8 := buf_len(c)
        // 8-wide (2x4 YMM) interleaved Montgomery modexp: A=(Y0,Y1,Y2), B=(Y3,Y4,Y5)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x35); mc_b2(c, 0x04, 0x88)         // Y0 = bases[i..i+3]
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x35); mc_b3(c, 0x5C, 0x88, 16)     // Y3 = bases[i+4..i+7]
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x35); mc_b2(c, 0x14, 0x89)         // Y2 = exps[i..i+3]
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x35); mc_b3(c, 0x6C, 0x89, 16)     // Y5 = exps[i+4..i+7]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x8C, 0x24); mc_u32(c, 192) // Y1 = r2
        _mc_mont_mul4_x2(c, 0, 0, 1, 3, 3, 1)                                  // bA=mont(bA,r2), bB=mont(bB,r2)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x8C, 0x24); mc_u32(c, 160) // Y1 = r1
        mc_vex256(c, 1, 4, 1, 1, 0xEB)                                         // Y4 = r1
        lp_mebit8 := buf_len(c)
        mc_vex256(c, 1, 6, 2, 5, 0xEB)                                         // Y6 = eA | eB
        mc_vex256(c, 2, 6, 0, 6, 0x17)                                         // VPTEST Y6, Y6
        jz_medone := mc_jcc32(c, 0x84)
        _mc_mont_mul4_x2(c, 6, 1, 0, 9, 4, 3)                                  // candA=resA*bA, candB=resB*bB
        mc_vex256(c, 1, 7, 2, 15, 0xDB);  mc_vex256(c, 1, 12, 5, 15, 0xDB)     // bitA, bitB
        mc_vex256(c, 1, 7, 14, 7, 0xFB);  mc_vex256(c, 1, 12, 14, 12, 0xFB)    // maskA, maskB
        mc_vex256(c, 1, 8, 7, 6, 0xDB);   mc_vex256(c, 1, 13, 12, 9, 0xDB)     // mask & cand
        mc_vex256(c, 1, 1, 7, 1, 0xDF);   mc_vex256(c, 1, 4, 12, 4, 0xDF)      // ~mask & res
        mc_vex256(c, 1, 1, 1, 8, 0xEB);   mc_vex256(c, 1, 4, 4, 13, 0xEB)      // blend resA, resB
        _mc_mont_mul4_x2(c, 0, 0, 0, 3, 3, 3)                                  // bA=bA^2, bB=bB^2
        _mc_vpsrlq_i(c, 2, 2, 1);         _mc_vpsrlq_i(c, 5, 5, 1)             // eA>>=1, eB>>=1
        jmp_meb := mc_jmp32(c); mc_patch_rel32(c, jmp_meb, lp_mebit8)
        mc_patch_rel32(c, jz_medone, buf_len(c))
        _mc_mont_mul4_x2(c, 1, 1, 15, 4, 4, 15)                                // exit mont A & B
        mc_vex256(c, 1, 6, 1, 4, 0xD4)                                         // Y6 = resA + resB
        mc_vex3(c, 0, 0, 0, 1, 0, 6, 1, 1, 0xD4); mc_b2(c, 0xB4, 0x24); mc_u32(c, 224)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0xB4, 0x24); mc_u32(c, 224)
        mc_b3(c, 0x4D, 0x85, 0xDB)
        jz_nost := mc_jcc8(c, 0x74)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 1, 0x7E); mc_b2(c, 0x0C, 0x8B)
        mc_vex3(c, 0, 0, 1, 3, 0, 0, 0, 1, 0x16); mc_b3(c, 0x4C, 0x8B, 4); mc_b1(c, 2)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x39); mc_b2(c, 0xC8, 1)
        mc_vex3(c, 0, 0, 1, 3, 0, 0, 0, 1, 0x16); mc_b3(c, 0x44, 0x8B, 8); mc_b1(c, 0)
        mc_vex3(c, 0, 0, 1, 3, 0, 0, 0, 1, 0x16); mc_b3(c, 0x44, 0x8B, 12); mc_b1(c, 2)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 1, 0x7E); mc_b3(c, 0x64, 0x8B, 16)
        mc_vex3(c, 0, 0, 1, 3, 0, 0, 0, 1, 0x16); mc_b3(c, 0x64, 0x8B, 20); mc_b1(c, 2)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x39); mc_b2(c, 0xE0, 1)
        mc_vex3(c, 0, 0, 1, 3, 0, 0, 0, 1, 0x16); mc_b3(c, 0x44, 0x8B, 24); mc_b1(c, 0)
        mc_vex3(c, 0, 0, 1, 3, 0, 0, 0, 1, 0x16); mc_b3(c, 0x44, 0x8B, 28); mc_b1(c, 2)
        mc_patch_jcc8(c, jz_nost, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xC1, 8)
        mc_b3(c, 0x4C, 0x39, 0xE1)
        jle_me8 := mc_jcc32(c, 0x8E); mc_patch_rel32(c, jle_me8, lp_me8)
        // Sum 4 lanes of [RSP+224] -> R15
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x8C, 0x24); mc_u32(c, 224) // Y9 = acc
        mc_vex3(c, 1, 0, 0, 3, 0, 0, 1, 1, 0x39); mc_b2(c, 0xC8, 1)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 1, 0xD4); mc_b1(c, 0xC1)
        mc_b4(c, 0xC5, 0xF1, 0x73, 0xD8); mc_b1(c, 8)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0xD4); mc_b1(c, 0xC1)
        mc_b4(c, 0x66, 0x49, 0x0F, 0x7E); mc_b1(c, 0xC7)
        mc_b3(c, 0xC5, 0xF8, 0x77)

        // Scalar tail + `--simd=scalar`
        mc_patch_rel32(c, jg_me_tail, buf_len(c))
        mc_patch_rel32(c, jz_me_sc, buf_len(c))
        mc_b3(c, 0x4D, 0x8B, 0x22)       // R12 = m
        mc_b4(c, 0x4D, 0x8B, 0x6A, 8)    // R13 = minv
        mc_b4(c, 0x4D, 0x8B, 0x72, 16)   // R14 = r1
        lp_mesc := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD1)
        jge_mesc_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x41, 0x8B, 0x04, 0x88) // EAX = bases[i] (zero-ext to RAX)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0x42); mc_b1(c, 24) // IMUL RAX, [R10+24] (r2)
        // MontRed(RAX) -> RSI (b)
        mc_b3(c, 0x48, 0x89, 0xC3); mc_b4(c, 0x49, 0x0F, 0xAF, 0xDD); mc_b2(c, 0x89, 0xDB) // RBX = (t*minv)&u32
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xDC); mc_b3(c, 0x48, 0x01, 0xD8); mc_b4(c, 0x48, 0xC1, 0xE8, 32)
        mc_b3(c, 0x4C, 0x39, 0xE0); mc_b2(c, 0x72, 0x03); mc_b3(c, 0x4C, 0x29, 0xE0)
        mc_b3(c, 0x48, 0x89, 0xC6)       // RSI = b
        mc_b3(c, 0x4C, 0x89, 0xF7)       // RDI = res = r1
        mc_b4(c, 0x41, 0x8B, 0x2C, 0x89) // EBP = exps[i]
        lp_mesb := buf_len(c)
        mc_b2(c, 0x85, 0xED)
        jz_mesb_dn := mc_jcc8(c, 0x74)
        mc_b4(c, 0x40, 0xF6, 0xC5, 1)
        jz_me_no := mc_jcc8(c, 0x74)
        mc_b3(c, 0x48, 0x89, 0xF8); mc_b4(c, 0x48, 0x0F, 0xAF, 0xC6)
        mc_b3(c, 0x48, 0x89, 0xC3); mc_b4(c, 0x49, 0x0F, 0xAF, 0xDD); mc_b2(c, 0x89, 0xDB)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xDC); mc_b3(c, 0x48, 0x01, 0xD8); mc_b4(c, 0x48, 0xC1, 0xE8, 32)
        mc_b3(c, 0x4C, 0x39, 0xE0); mc_b2(c, 0x72, 0x03); mc_b3(c, 0x4C, 0x29, 0xE0)
        mc_b3(c, 0x48, 0x89, 0xC7)
        mc_patch_jcc8(c, jz_me_no, buf_len(c))
        mc_b3(c, 0x48, 0x89, 0xF0); mc_b4(c, 0x48, 0x0F, 0xAF, 0xC6)
        mc_b3(c, 0x48, 0x89, 0xC3); mc_b4(c, 0x49, 0x0F, 0xAF, 0xDD); mc_b2(c, 0x89, 0xDB)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xDC); mc_b3(c, 0x48, 0x01, 0xD8); mc_b4(c, 0x48, 0xC1, 0xE8, 32)
        mc_b3(c, 0x4C, 0x39, 0xE0); mc_b2(c, 0x72, 0x03); mc_b3(c, 0x4C, 0x29, 0xE0)
        mc_b3(c, 0x48, 0x89, 0xC6)
        mc_b2(c, 0xD1, 0xED)             // SHR EBP, 1
        jmp_mesb := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_mesb, lp_mesb)
        mc_patch_jcc8(c, jz_mesb_dn, buf_len(c))
        // Exit mont: MontRed(RDI)
        mc_b3(c, 0x48, 0x89, 0xF8)
        mc_b3(c, 0x48, 0x89, 0xC3); mc_b4(c, 0x49, 0x0F, 0xAF, 0xDD); mc_b2(c, 0x89, 0xDB)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xDC); mc_b3(c, 0x48, 0x01, 0xD8); mc_b4(c, 0x48, 0xC1, 0xE8, 32)
        mc_b3(c, 0x4C, 0x39, 0xE0); mc_b2(c, 0x72, 0x03); mc_b3(c, 0x4C, 0x29, 0xE0)
        mc_b3(c, 0x49, 0x01, 0xC7)       // R15 += res
        mc_b3(c, 0x4D, 0x85, 0xDB); jz_nost2 := mc_jcc8(c, 0x74)
        mc_b4(c, 0x41, 0x89, 0x04, 0x8B) // MOV [R11 + RCX*4], EAX
        mc_patch_jcc8(c, jz_nost2, buf_len(c))
        mc_b3(c, 0x48, 0xFF, 0xC1)
        jmp_mesc := mc_jmp32(c); mc_patch_rel32(c, jmp_mesc, lp_mesc)

        mc_patch_rel32(c, jge_mesc_dn, buf_len(c))
        mc_patch_rel32(c, jle_me_dn, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xF8) // MOV RAX, R15
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0x118)
        cg_reg_helper(cg, h_ai_modexp_mont32(), s_me, buf_len(c))
    }

    // 7. `h_ai_l2_argmin4_f32`: 4-query x 8-lane AVX2 L2^2 nearest-neighbor scan (`pvecs, pqrys4, nvecs, dim, out_best_f64, out_id_i64`)
    if cg_is_helper_used(cg, h_ai_l2_argmin4_f32()) {
        while (buf_len(cg.rdata) & 15) != 0 { buf_push(cg.rdata, 0) }
        roff_l2 := buf_len(cg.rdata)
        buf_push_u32(cg.rdata, 0x7F7FFFFF); buf_push_u32(cg.rdata, 0x7F7FFFFF)
        buf_push_u32(cg.rdata, 0x7F7FFFFF); buf_push_u32(cg.rdata, 0x7F7FFFFF)

        mc_align16(c)
        s_l2 := buf_len(c)
        mc_ai_enter(c, 0xF8) // 160B XMM6..15 + 32B best_f32 (160) + 32B ids (192) + 24B
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = pvecs
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = pqrys4 (q0)
        mc_b4(c, 0x48, 0x8B, 0x51, 16)   // RDX = nvecs
        mc_b4(c, 0x4C, 0x8B, 0x51, 24)   // R10 = dim
        mc_b4(c, 0x4C, 0x8B, 0x59, 32)   // R11 = out_best_f64
        mc_b4(c, 0x4C, 0x8B, 0x61, 40)   // R12 = out_id_i64
        mc_b3(c, 0x4C, 0x89, 0xD5); mc_b4(c, 0x48, 0xC1, 0xE5, 2) // MOV RBP, R10; SHL RBP, 2 (dim_bytes)
        // Init ids = 0
        mc_b2(c, 0x31, 0xC0)
        mut qi := 0
        while qi < 4 { mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 192 + qi * 8); qi += 1 }
        // q1=R13, q2=R14, q3=R15
        mc_b4(c, 0x4D, 0x8D, 0x2C, 0x29) // LEA R13, [R9 + RBP]
        mc_b4(c, 0x4D, 0x8D, 0x74, 0x2D); mc_b1(c, 0) // LEA R14, [R13 + RBP + 0]
        mc_b4(c, 0x4D, 0x8D, 0x3C, 0x2E) // LEA R15, [R14 + RBP]

        cg_lea_rax_rdata(cg, roff_l2)
        mc_b4(c, 0x44, 0x0F, 0x10, 0x08) // MOVUPS XMM9, [RAX] (best[0..3] = FLT_MAX)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_l2_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x41, 0xF6, 0xC2, 7); jnz_l2_sc2 := mc_jcc32(c, 0x85) // fallback if dim % 8 != 0

        mc_b3(c, 0x4C, 0x89, 0xC7)       // RDI = cur vec ptr
        mc_b2(c, 0x31, 0xF6)             // RSI = i = 0
        mc_b3(c, 0x48, 0x85, 0xD2); jle_l2_dn := mc_jcc32(c, 0x8E)

        mc_align16_nop(c)
        lp_l2v := buf_len(c)
        mc_vex256(c, 1, 0, 0, 0, 0x57); mc_vex256(c, 1, 1, 1, 1, 0x57)
        mc_vex256(c, 1, 2, 2, 2, 0x57); mc_vex256(c, 1, 3, 3, 3, 0x57)
        mc_b2(c, 0x31, 0xC9)             // RCX = byte_off = 0
        lp_l2k := buf_len(c)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x10); mc_b2(c, 0x24, 0x0F)       // VMOVUPS YMM4, [RDI+RCX]
        // q0 (R9):
        mc_vex3(c, 0, 0, 1, 1, 0, 4, 1, 0, 0x5C); mc_b2(c, 0x2C, 0x09)       // VSUBPS YMM5, YMM4, [R9+RCX]
        mc_vex3(c, 0, 0, 0, 1, 0, 5, 1, 0, 0x59); mc_b1(c, 0xED)             // VMULPS YMM5, YMM5, YMM5
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x58); mc_b1(c, 0xC5)             // VADDPS YMM0, YMM0, YMM5
        // q1 (R13 -> disp8=0 required for R13 base in ModRM 0x44!):
        mc_vex3(c, 0, 0, 1, 1, 0, 4, 1, 0, 0x5C); mc_b3(c, 0x74, 0x0D, 0)    // VSUBPS YMM6, YMM4, [R13+RCX+0]
        mc_vex3(c, 0, 0, 0, 1, 0, 6, 1, 0, 0x59); mc_b1(c, 0xF6)             // VMULPS YMM6, YMM6, YMM6
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 1, 0, 0x58); mc_b1(c, 0xCE)             // VADDPS YMM1, YMM1, YMM6
        // q2 (R14):
        mc_vex3(c, 0, 0, 1, 1, 0, 4, 1, 0, 0x5C); mc_b2(c, 0x3C, 0x0E)       // VSUBPS YMM7, YMM4, [R14+RCX]
        mc_vex3(c, 0, 0, 0, 1, 0, 7, 1, 0, 0x59); mc_b1(c, 0xFF)             // VMULPS YMM7, YMM7, YMM7
        mc_vex3(c, 0, 0, 0, 1, 0, 2, 1, 0, 0x58); mc_b1(c, 0xD7)             // VADDPS YMM2, YMM2, YMM7
        // q3 (R15):
        mc_vex3(c, 1, 0, 1, 1, 0, 4, 1, 0, 0x5C); mc_b2(c, 0x04, 0x0F)       // VSUBPS YMM8, YMM4, [R15+RCX]
        mc_vex3(c, 1, 0, 1, 1, 0, 8, 1, 0, 0x59); mc_b1(c, 0xC0)             // VMULPS YMM8, YMM8, YMM8
        mc_vex3(c, 0, 0, 1, 1, 0, 3, 1, 0, 0x58); mc_b1(c, 0xD8)             // VADDPS YMM3, YMM3, YMM8
        mc_b4(c, 0x48, 0x83, 0xC1, 32); mc_b3(c, 0x48, 0x39, 0xE9)           // RCX += 32; CMP RCX, RBP
        jl_l2k := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_l2k, lp_l2k)

        // 5-instruction 4-vector horizontal reduction -> XMM0 = [d0, d1, d2, d3]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 3, 0x7C); mc_b1(c, 0xC1)             // VHADDPS YMM0, YMM0, YMM1
        mc_vex3(c, 0, 0, 0, 1, 0, 2, 1, 3, 0x7C); mc_b1(c, 0xD3)             // VHADDPS YMM2, YMM2, YMM3
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 3, 0x7C); mc_b1(c, 0xC2)             // VHADDPS YMM0, YMM0, YMM2
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC1, 1)          // VEXTRACTF128 XMM1, YMM0, 1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0x58); mc_b1(c, 0xC1)             // VADDPS XMM0, XMM0, XMM1
        // Compare XMM0 < XMM9
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 0, 0xC2); mc_b2(c, 0xE1, 1)          // VCMPLTPS XMM4, XMM0, XMM9
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 0, 0x50); mc_b1(c, 0xC4)             // VMOVMSKPS EAX, XMM4
        mc_b2(c, 0x85, 0xC0)
        jz_l2_noup := mc_jcc8(c, 0x74)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 0, 0, 0x5D); mc_b1(c, 0xC9)             // VMINPS XMM9, XMM0, XMM9
        qi = 0
        while qi < 4 {
            mc_b2(c, 0xA8, 1 << qi)                                          // TEST AL, (1 << qi)
            jz_q := mc_jcc8(c, 0x74)
            mc_b4(c, 0x48, 0x89, 0xB4, 0x24); mc_u32(c, 192 + qi * 8)        // MOV [RSP+192+qi*8], RSI
            mc_patch_jcc8(c, jz_q, buf_len(c))
            qi += 1
        }
        mc_patch_jcc8(c, jz_l2_noup, buf_len(c))
        mc_b3(c, 0x48, 0x01, 0xEF)                                           // ADD RDI, RBP
        mc_b3(c, 0x48, 0xFF, 0xC6); mc_b3(c, 0x48, 0x39, 0xD6)               // INC RSI; CMP RSI, RDX
        jl_l2v := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_l2v, lp_l2v)
        mc_patch_rel32(c, jle_l2_dn, buf_len(c))
        // Store 4 best f32 -> 4 f64 to [R11], and 4 ids to [R12]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x5A); mc_b1(c, 0xC1)             // VCVTPS2PD YMM0, XMM9
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b1(c, 0x03)             // VMOVUPD [R11], YMM0
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_l2_ids := mc_jmp32(c)

        // Scalar fallback for `--simd=scalar` or dim%8!=0
        mc_patch_rel32(c, jz_l2_sc, buf_len(c))
        mc_patch_rel32(c, jnz_l2_sc2, buf_len(c))
        mc_b4(c, 0x44, 0x0F, 0x11, 0x8C); mc_b1(c, 0x24); mc_u32(c, 160)     // MOVUPS [RSP+160], XMM9
        mc_b3(c, 0x4C, 0x89, 0xC7); mc_b2(c, 0x31, 0xF6)                     // RDI = pvecs, RSI = 0
        lp_l2sv := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD6); jge_l2s_dn := mc_jcc32(c, 0x8D)
        qi = 0
        while qi < 4 {
            mc_b3(c, 0x0F, 0x57, 0xC0)                                       // XORPS XMM0, XMM0
            mc_b2(c, 0x31, 0xC9)                                             // RCX = 0
            lp_l2sk := buf_len(c)
            mc_b3(c, 0x48, 0x39, 0xE9); jge_sk := mc_jcc8(c, 0x7D)
            mc_b4(c, 0xF3, 0x0F, 0x10, 0x0C); mc_b1(c, 0x0F)                 // MOVSS XMM1, [RDI+RCX]
            if qi == 0 { mc_b4(c, 0xF3, 0x41, 0x0F, 0x5C); mc_b2(c, 0x0C, 0x09) }
            else if qi == 1 { mc_b4(c, 0xF3, 0x41, 0x0F, 0x5C); mc_b3(c, 0x4C, 0x0D, 0) }
            else if qi == 2 { mc_b4(c, 0xF3, 0x41, 0x0F, 0x5C); mc_b2(c, 0x0C, 0x0E) }
            else { mc_b4(c, 0xF3, 0x41, 0x0F, 0x5C); mc_b2(c, 0x0C, 0x0F) }
            mc_b4(c, 0xF3, 0x0F, 0x59, 0xC9); mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1)
            mc_b4(c, 0x48, 0x83, 0xC1, 4)
            j_sk := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_sk, lp_l2sk)
            mc_patch_jcc8(c, jge_sk, buf_len(c))
            mc_b3(c, 0x0F, 0x2F, 0x84); mc_b1(c, 0x24); mc_u32(c, 160 + qi * 4) // COMISS XMM0, [RSP+160+qi*4]
            jae_sq := mc_jcc8(c, 0x73)
            mc_b4(c, 0xF3, 0x0F, 0x11, 0x84); mc_b1(c, 0x24); mc_u32(c, 160 + qi * 4)
            mc_b4(c, 0x48, 0x89, 0xB4, 0x24); mc_u32(c, 192 + qi * 8)
            mc_patch_jcc8(c, jae_sq, buf_len(c))
            qi += 1
        }
        mc_b3(c, 0x48, 0x01, 0xEF); mc_b3(c, 0x48, 0xFF, 0xC6)
        j_sv := mc_jmp32(c); mc_patch_rel32(c, j_sv, lp_l2sv)
        mc_patch_rel32(c, jge_l2s_dn, buf_len(c))
        qi = 0
        while qi < 4 {
            mc_b4(c, 0xF3, 0x0F, 0x5A, 0x84); mc_b1(c, 0x24); mc_u32(c, 160 + qi * 4) // CVTSS2SD XMM0, [RSP+160+qi*4]
            mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x43, qi * 8)                  // MOVSD [R11+qi*8], XMM0
            qi += 1
        }
        mc_patch_rel32(c, jmp_l2_ids, buf_len(c))
        qi = 0
        while qi < 4 {
            mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 192 + qi * 8)
            mc_b4(c, 0x49, 0x89, 0x44, 0x24); mc_b1(c, qi * 8) // MOV [R12+qi*8], RAX
            qi += 1
        }
        mc_b2(c, 0x31, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xF8)
        cg_reg_helper(cg, h_ai_l2_argmin4_f32(), s_l2, buf_len(c))
    }

    // 8. `h_ai_transpose_f64`: 4x4 AVX2 f64 tiled matrix transpose (`src, dst, n, r0, r1`) + scalar fallback
    if cg_is_helper_used(cg, h_ai_transpose_f64()) {
        mc_align16(c)
        s_tr := buf_len(c)
        // 8x8 L1D/L3-safe blocked transpose: separates 4KB-strided reads & 64B full-line writes via 512B L1D buffer!
        // Stack: [RSP+0..159]=XMM6..15, RBP=(RSP+192+63)&-64 -> [RBP+0..511]=8x8 f64 temp tile
        mc_ai_enter(c, 0x338)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = src
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = dst
        mc_b4(c, 0x48, 0x8B, 0x51, 16)   // RDX = n
        mc_b4(c, 0x4C, 0x8B, 0x51, 24)   // R10 = r0
        mc_b4(c, 0x4C, 0x8B, 0x59, 32)   // R11 = r1
        mc_b3(c, 0x48, 0x89, 0xD3); mc_b4(c, 0x48, 0xC1, 0xE3, 3) // RBX = stride = n * 8
        mc_b4(c, 0x48, 0x8D, 0xAC, 0x24); mc_u32(c, 224)
        mc_b4(c, 0x48, 0x83, 0xE5, 0xC0) // RBP = 64B-aligned 512B tile buffer

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_tr_sc := mc_jcc32(c, 0x84)
        mc_b3(c, 0xF6, 0xC2, 7); jnz_tr_sc2 := mc_jcc32(c, 0x85)
        mc_b3(c, 0x4C, 0x89, 0xD8); mc_b3(c, 0x4C, 0x29, 0xD0)
        mc_b2(c, 0xA8, 7); jnz_tr_sc3 := mc_jcc32(c, 0x85)
        mc_b4(c, 0x41, 0xF6, 0xC1, 31); jnz_tr_sc4 := mc_jcc32(c, 0x85)

        // Outer i = r0 .. r1 step 8, inner jj = 0 .. n step 8
        mc_b3(c, 0x4D, 0x89, 0xD6) // R14 = i = r0
        lp_tr_i := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xDE); jge_tri_dn := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4C, 0x89, 0xF0); mc_b4(c, 0x48, 0x0F, 0xAF, 0xC3)
        mc_b4(c, 0x4D, 0x8D, 0x24, 0x00) // R12 = src + i * stride
        mc_b4(c, 0x4F, 0x8D, 0x2C, 0xF1) // R13 = dst + i * 8
        mc_b3(c, 0x45, 0x31, 0xFF)       // R15 = jj = 0
        mc_align16_nop(c)
        lp_tr_jj := buf_len(c)
        mc_b3(c, 0x49, 0x39, 0xD7); jge_trjj_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4B, 0x8D, 0x34, 0xFC) // RSI = &src[i][jj]
        // 1. Top-Left 4x4 (src[i..i+3][jj..jj+3]) -> tile[0..3][0..3] ([RBP + r*64 + 0])
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x06); mc_b3(c, 0x48, 0x01, 0xDE)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x0E); mc_b3(c, 0x48, 0x01, 0xDE)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x16); mc_b3(c, 0x48, 0x01, 0xDE)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x1E); mc_b3(c, 0x48, 0x01, 0xDE)
        mc_vex256(c, 1, 4, 0, 1, 0x14); mc_vex256(c, 1, 5, 0, 1, 0x15)
        mc_vex256(c, 1, 6, 2, 3, 0x14); mc_vex256(c, 1, 7, 2, 3, 0x15)
        mc_vex3(c, 0, 0, 0, 3, 0, 4, 1, 1, 0x06); mc_b2(c, 0xC6, 0x20)
        mc_vex3(c, 0, 0, 0, 3, 0, 5, 1, 1, 0x06); mc_b2(c, 0xCF, 0x20)
        mc_vex3(c, 0, 0, 0, 3, 0, 4, 1, 1, 0x06); mc_b2(c, 0xD6, 0x31)
        mc_vex3(c, 0, 0, 0, 3, 0, 5, 1, 1, 0x06); mc_b2(c, 0xDF, 0x31)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x29); mc_b2(c, 0x45, 0)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x29); mc_b2(c, 0x4D, 64)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x29); mc_b1(c, 0x95); mc_u32(c, 128)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x29); mc_b1(c, 0x9D); mc_u32(c, 192)
        // 2. Bottom-Left 4x4 (src[i+4..i+7][jj..jj+3]) -> tile[0..3][4..7] ([RBP + r*64 + 32])
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x06); mc_b3(c, 0x48, 0x01, 0xDE)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x0E); mc_b3(c, 0x48, 0x01, 0xDE)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x16); mc_b3(c, 0x48, 0x01, 0xDE)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x1E)
        mc_vex256(c, 1, 4, 0, 1, 0x14); mc_vex256(c, 1, 5, 0, 1, 0x15)
        mc_vex256(c, 1, 6, 2, 3, 0x14); mc_vex256(c, 1, 7, 2, 3, 0x15)
        mc_vex3(c, 0, 0, 0, 3, 0, 4, 1, 1, 0x06); mc_b2(c, 0xC6, 0x20)
        mc_vex3(c, 0, 0, 0, 3, 0, 5, 1, 1, 0x06); mc_b2(c, 0xCF, 0x20)
        mc_vex3(c, 0, 0, 0, 3, 0, 4, 1, 1, 0x06); mc_b2(c, 0xD6, 0x31)
        mc_vex3(c, 0, 0, 0, 3, 0, 5, 1, 1, 0x06); mc_b2(c, 0xDF, 0x31)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x29); mc_b2(c, 0x45, 32)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x29); mc_b2(c, 0x4D, 96)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x29); mc_b1(c, 0x95); mc_u32(c, 160)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x29); mc_b1(c, 0x9D); mc_u32(c, 224)
        // 3. Top-Right 4x4 (src[i..i+3][jj+4..jj+7]) -> tile[4..7][0..3] ([RBP + 256 + r*64])
        mc_b4(c, 0x4B, 0x8D, 0x74, 0xFC); mc_b1(c, 32) // RSI = &src[i][jj+4]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x06); mc_b3(c, 0x48, 0x01, 0xDE)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x0E); mc_b3(c, 0x48, 0x01, 0xDE)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x16); mc_b3(c, 0x48, 0x01, 0xDE)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x1E); mc_b3(c, 0x48, 0x01, 0xDE)
        mc_vex256(c, 1, 4, 0, 1, 0x14); mc_vex256(c, 1, 5, 0, 1, 0x15)
        mc_vex256(c, 1, 6, 2, 3, 0x14); mc_vex256(c, 1, 7, 2, 3, 0x15)
        mc_vex3(c, 0, 0, 0, 3, 0, 4, 1, 1, 0x06); mc_b2(c, 0xC6, 0x20)
        mc_vex3(c, 0, 0, 0, 3, 0, 5, 1, 1, 0x06); mc_b2(c, 0xCF, 0x20)
        mc_vex3(c, 0, 0, 0, 3, 0, 4, 1, 1, 0x06); mc_b2(c, 0xD6, 0x31)
        mc_vex3(c, 0, 0, 0, 3, 0, 5, 1, 1, 0x06); mc_b2(c, 0xDF, 0x31)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x29); mc_b1(c, 0x85); mc_u32(c, 256)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x29); mc_b1(c, 0x8D); mc_u32(c, 320)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x29); mc_b1(c, 0x95); mc_u32(c, 384)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x29); mc_b1(c, 0x9D); mc_u32(c, 448)
        // 4. Bottom-Right 4x4 (src[i+4..i+7][jj+4..jj+7]) -> tile[4..7][4..7] ([RBP + 288 + r*64])
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x06); mc_b3(c, 0x48, 0x01, 0xDE)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x0E); mc_b3(c, 0x48, 0x01, 0xDE)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x16); mc_b3(c, 0x48, 0x01, 0xDE)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x1E)
        mc_vex256(c, 1, 4, 0, 1, 0x14); mc_vex256(c, 1, 5, 0, 1, 0x15)
        mc_vex256(c, 1, 6, 2, 3, 0x14); mc_vex256(c, 1, 7, 2, 3, 0x15)
        mc_vex3(c, 0, 0, 0, 3, 0, 4, 1, 1, 0x06); mc_b2(c, 0xC6, 0x20)
        mc_vex3(c, 0, 0, 0, 3, 0, 5, 1, 1, 0x06); mc_b2(c, 0xCF, 0x20)
        mc_vex3(c, 0, 0, 0, 3, 0, 4, 1, 1, 0x06); mc_b2(c, 0xD6, 0x31)
        mc_vex3(c, 0, 0, 0, 3, 0, 5, 1, 1, 0x06); mc_b2(c, 0xDF, 0x31)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x29); mc_b1(c, 0x85); mc_u32(c, 288)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x29); mc_b1(c, 0x8D); mc_u32(c, 352)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x29); mc_b1(c, 0x95); mc_u32(c, 416)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x29); mc_b1(c, 0x9D); mc_u32(c, 480)
        // Phase 2: Stream 8 FULL 64B cache lines from tile[0..7] -> dst[jj..jj+7][i..i+7] (stays in L3!)
        mc_b3(c, 0x4C, 0x89, 0xEF) // RDI = R13
        mc_b2(c, 0x31, 0xC9)       // RCX = row = 0..7
        lp_tr_fl := buf_len(c)
        mc_b3(c, 0x48, 0x89, 0xC8); mc_b4(c, 0x48, 0xC1, 0xE0, 6) // RAX = row * 64
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x28); mc_b3(c, 0x44, 0x05, 0)  // VMOVAPD Y0, [RBP+RAX]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x28); mc_b3(c, 0x4C, 0x05, 32) // VMOVAPD Y1, [RBP+RAX+32]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x2B); mc_b1(c, 0x07)           // VMOVNTPD [RDI], Y0 (bypass RFO!)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x2B); mc_b2(c, 0x4F, 32)       // VMOVNTPD [RDI+32], Y1 (bypass RFO!)
        mc_b3(c, 0x48, 0x01, 0xDF) // RDI += stride
        mc_b3(c, 0x48, 0xFF, 0xC1); mc_b4(c, 0x48, 0x83, 0xF9, 8)
        jl_tr_fl := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_tr_fl, lp_tr_fl)
        mc_b3(c, 0x49, 0x89, 0xFD) // R13 = RDI
        mc_b4(c, 0x49, 0x83, 0xC7, 8)
        j_trjj := mc_jmp32(c); mc_patch_rel32(c, j_trjj, lp_tr_jj)
        mc_patch_rel32(c, jge_trjj_dn, buf_len(c))
        mc_b4(c, 0x49, 0x83, 0xC6, 8)
        j_tri := mc_jmp32(c); mc_patch_rel32(c, j_tri, lp_tr_i)
        mc_patch_rel32(c, jge_tri_dn, buf_len(c))
        mc_b3(c, 0x0F, 0xAE, 0xF8) // SFENCE
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_tr_end := mc_jmp32(c)

        // Scalar fallback
        mc_patch_rel32(c, jz_tr_sc, buf_len(c))
        mc_patch_rel32(c, jnz_tr_sc2, buf_len(c))
        mc_patch_rel32(c, jnz_tr_sc3, buf_len(c))
        mc_patch_rel32(c, jnz_tr_sc4, buf_len(c))
        mc_b3(c, 0x4D, 0x89, 0xD6)
        lp_trs_i := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xDE); jge_trsi_dn := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4C, 0x89, 0xF0); mc_b4(c, 0x48, 0x0F, 0xAF, 0xC3)
        mc_b4(c, 0x49, 0x8D, 0x34, 0x00)
        mc_b4(c, 0x4B, 0x8D, 0x3C, 0xF1)
        mc_b2(c, 0x31, 0xC9)
        lp_trs_j := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD1); jge_trsj_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x48, 0x8B, 0x04, 0xCE); mc_b3(c, 0x48, 0x89, 0x07)
        mc_b3(c, 0x48, 0x01, 0xDF); mc_b3(c, 0x48, 0xFF, 0xC1)
        j_trsj := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_trsj, lp_trs_j)
        mc_patch_jcc8(c, jge_trsj_dn, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC6)
        j_trsi := mc_jmp32(c); mc_patch_rel32(c, j_trsi, lp_trs_i)
        mc_patch_rel32(c, jge_trsi_dn, buf_len(c))

        mc_patch_rel32(c, jmp_tr_end, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0x338)
        cg_reg_helper(cg, h_ai_transpose_f64(), s_tr, buf_len(c))
    }

    // 9. `h_ai_bitnet158_dot`: Branchless 8-wide AVX2 BitNet-1.58 (0,1,2 -> -1,0,+1, 53-bit FP64 accum!) (`pw, pact, rows, cols, r0, r1`) -> f64
    if cg_is_helper_used(cg, h_ai_bitnet158_dot()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_bn := buf_len(cg.rdata)
        mut oi := 0; while oi < 8 { buf_push_u32(cg.rdata, 1); oi += 1 }

        mc_align16(c)
        s_bn := buf_len(c)
        mc_ai_enter(c, 0x8B8) // [0..159]=XMM6..15, [160..2207]=2048B L1D row-major u8 col-sum scratch
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = pw (u8)
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = pact (f32)
        mc_b4(c, 0x4C, 0x8B, 0x51, 24)   // R10 = cols
        mc_b4(c, 0x4C, 0x8B, 0x59, 32)   // R11 = r0
        mc_b4(c, 0x4C, 0x8B, 0x61, 40)   // R12 = r1
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) // XORPD XMM0, XMM0 (tot = 0.0)
        mc_b3(c, 0x4D, 0x39, 0xE3); jge_bn_dn := mc_jcc32(c, 0x8D)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_bn_sc := mc_jcc32(c, 0x84)
        // ROW-MAJOR sequential-stream 64-row VPADDB into 2KB L1D scratch + exact f64 dot (0 < cols <= 2048, cols%256==0)!
        mc_b3(c, 0x4D, 0x85, 0xD2); jle_bn_fb := mc_jcc32(c, 0x8E)
        mc_b3(c, 0x49, 0x81, 0xFA); mc_u32(c, 2048); jg_bn_fb2 := mc_jcc32(c, 0x8F)
        mc_b3(c, 0x41, 0xF7, 0xC2); mc_u32(c, 255); jnz_bn_fb := mc_jcc32(c, 0x85)
        mc_vex256(c, 1, 14, 14, 14, 0x57); mc_vex256(c, 1, 13, 13, 13, 0x57) // Y14, Y13 = 0.0 f64
        mc_b3(c, 0x4C, 0x89, 0xD8); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC2)
        mc_b3(c, 0x4C, 0x01, 0xC0); mc_b3(c, 0x48, 0x89, 0xC6) // RSI = pw + r0 * cols (sequential single-pass stream!)
        lp_bn_blk := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xE3); jge_bnb_dn := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4D, 0x89, 0xE6); mc_b3(c, 0x4D, 0x29, 0xDE) // R14 = br = min(64, r1 - r)
        mc_b4(c, 0x49, 0x83, 0xFE, 64); jle_bnbr := mc_jcc8(c, 0x7E)
        mc_b2(c, 0x41, 0xBE); mc_u32(c, 64)
        mc_patch_jcc8(c, jle_bnbr, buf_len(c))
        // Copy row 0 of block directly into [RSP+160..160+cols) (avoids separate zero pass!)
        mc_b2(c, 0x31, 0xC9)
        lp_bn_cp := buf_len(c)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x04, 0x0E)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x4C, 0x0E, 32)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x54, 0x0E, 64)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x5C, 0x0E, 96)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x84, 0x0C); mc_u32(c, 160)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x8C, 0x0C); mc_u32(c, 192)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x94, 0x0C); mc_u32(c, 224)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x9C, 0x0C); mc_u32(c, 256)
        mc_b3(c, 0x48, 0x81, 0xC1); mc_u32(c, 128); mc_b3(c, 0x4C, 0x39, 0xD1)
        jl_bncp := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_bncp, lp_bn_cp)
