        mc_b3(c, 0x45, 0x31, 0xDB)
        mc_b3(c, 0x4D, 0x89, 0xC4)
        mc_align16_nop(c)
        lp_fwk := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xCB); jge_fwk_dn := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x45, 0x31, 0xED)
        mc_b3(c, 0x4D, 0x89, 0xC6)
        lp_fwi := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xCD); jge_fwi_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4F, 0x8D, 0x3C, 0x16)
        mc_b4(c, 0x43, 0x8B, 0x04, 0x9E)
        mc_b4(c, 0x43, 0x8B, 0x14, 0x9F)
        mc_b1(c, 0x3D); mc_u32(c, 1000000000); jge_fw_sl1 := mc_jcc32(c, 0x8D)
        mc_b2(c, 0x81, 0xFA); mc_u32(c, 1000000000); jge_fw_sl2 := mc_jcc32(c, 0x8D)
        mc_vex3(c, 0, 1, 1, 2, 0, 0, 1, 1, 0x58); mc_b2(c, 0x04, 0x9E)
        mc_vex3(c, 0, 1, 1, 2, 0, 0, 1, 1, 0x58); mc_b2(c, 0x0C, 0x9F)
        mc_b2(c, 0x31, 0xC9)
        lp_fwj2 := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x14, 0x8C)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x5C, 0x8C, 32)
        mc_vex256(c, 1, 4, 2, 0, 0xFE); mc_vex256(c, 1, 5, 3, 0, 0xFE)
        mc_vex3(c, 0, 0, 1, 2, 0, 4, 1, 1, 0x39); mc_b2(c, 0x24, 0x8E)
        mc_vex3(c, 0, 0, 1, 2, 0, 5, 1, 1, 0x39); mc_b3(c, 0x6C, 0x8E, 32)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x24, 0x8E)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b3(c, 0x6C, 0x8E, 32)
        mc_vex256(c, 1, 2, 2, 1, 0xFE); mc_vex256(c, 1, 3, 3, 1, 0xFE)
        mc_vex3(c, 0, 0, 1, 2, 0, 2, 1, 1, 0x39); mc_b2(c, 0x14, 0x8F)
        mc_vex3(c, 0, 0, 1, 2, 0, 3, 1, 1, 0x39); mc_b3(c, 0x5C, 0x8F, 32)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x14, 0x8F)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b3(c, 0x5C, 0x8F, 32)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x54, 0x8C, 64)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x5C, 0x8C, 96)
