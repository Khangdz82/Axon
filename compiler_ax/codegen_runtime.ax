        lp_qrsd := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xC9); jge_qrsd := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x0C); mc_b1(c, 0xCE); mc_b4(c, 0xF2, 0x0F, 0x59, 0x0C); mc_b1(c, 0xCF); mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_qrsd := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_qrsd, lp_qrsd)
        mc_patch_jcc8(c, jge_qrsd, buf_len(c))
        mc_b2(c, 0x31, 0xC9)
        lp_qrsa := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xC9); jge_qrsa := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x0C); mc_b1(c, 0xCE); mc_b4(c, 0xF2, 0x0F, 0x59, 0xC8)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x14); mc_b1(c, 0xCF); mc_b4(c, 0xF2, 0x0F, 0x5C, 0xD1); mc_b4(c, 0xF2, 0x0F, 0x11, 0x14); mc_b1(c, 0xCF)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_qrsa := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_qrsa, lp_qrsa)
        mc_patch_jcc8(c, jge_qrsa, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC4); mc_b3(c, 0x48, 0x01, 0xEF)
        j_qrsj := mc_jmp32(c); mc_patch_rel32(c, j_qrsj, lp_qrsj)
        mc_patch_rel32(c, jge_qrsj, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xBC, 0x24); mc_u32(c, 160); mc_b1(c, 0); jne_qr_p2sd := mc_jcc8(c, 0x75)
        mc_b3(c, 0x49, 0xFF, 0xC3); mc_b3(c, 0x48, 0x01, 0xEE)
        j_qrsk := mc_jmp32(c); mc_patch_rel32(c, j_qrsk, lp_qrsk)
        mc_patch_rel32(c, je_qr_p1s, buf_len(c))
        mc_patch_jcc8(c, jne_qr_p2sd, buf_len(c))
        mc_patch_rel32(c, jge_qrsk_dn, buf_len(c))

        mc_patch_rel32(c, jmp_qr_end, buf_len(c))
        mc_patch_rel32(c, jle_qr_dn, buf_len(c))
        mc_b4(c, 0x66, 0x4C, 0x0F, 0x7E); mc_b1(c, 0xF8)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xC8)
        cg_reg_helper(cg, h_ai_qr_mgs_f64(), s_qr, buf_len(c))
    }
}

fn emit_ai_runtime_helpers(cg: CodegenCtx) {
    emit_ai_ffi_pool_helpers(cg)
    emit_ai_gemv_gemm_helpers(cg)
    emit_ai_quant_helpers(cg)
    emit_ai_vec_norm_helpers(cg)
    emit_ai_crypto_math_helpers(cg)
    emit_ai_wave3b_helpers(cg)
    emit_ai_wave3c_helpers(cg)
    emit_ai_wave3c2a_helpers(cg)
    emit_ai_wave3c2b_helpers(cg)
    emit_ai_wave3c2c_helpers(cg)
}

fn emit_ai_wave3c2c_helpers(cg: CodegenCtx) {
    c := cg.code

    // 39. `h_ai_dijkstra_dial(src, dp, hp, ep, bhead, pool) -> i64`: Pure-register Dial Dijkstra + 512-bit BSF bitmap!
    if cg_is_helper_used(cg, h_ai_dijkstra_dial()) {
        mc_align16(c)
        s_dj := buf_len(c)
        mc_ai_enter(c, 0x68) // [RSP+0..63]=bitmap, [RSP+64]=hcap, [RSP+72]=orig_dp, [RSP+80]=nv
        mc_b3(c, 0x48, 0x8B, 0x01)       // RAX = src
        mc_b4(c, 0x4C, 0x8B, 0x41, 8)    // R8 = dp
        mc_b4(c, 0x4C, 0x8B, 0x49, 16)   // R9 = hp
        mc_b4(c, 0x4C, 0x8B, 0x51, 24)   // R10 = ep
        mc_b4(c, 0x4C, 0x8B, 0x59, 32)   // R11 = bhead
        mc_b4(c, 0x4C, 0x8B, 0x61, 40)   // R12 = pool
        mc_b3(c, 0x49, 0x8B, 0x14); mc_b1(c, 0x24) // RDX = hcap_flags = pool[0]
        // Check bit 61: ultra-compact L1D-resident mode (head_i32 + edges_3xi32 + dist_u32[nv] at bhead+2048!)
        mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE9, 61)
        mc_b3(c, 0xF6, 0xC1, 1); jz_djc_skip := mc_jcc32(c, 0x84)
        mc_b4(c, 0x4C, 0x89, 0x44, 0x24); mc_b1(c, 72) // [RSP+72] = orig dp
        mc_b3(c, 0x48, 0x89, 0xD6); mc_b4(c, 0x48, 0xC1, 0xEE, 60) // RSI bit 0 = use_128 (bit 60)
        mc_b3(c, 0x48, 0x89, 0xD3); mc_b4(c, 0x48, 0xC1, 0xEB, 32); mc_b2(c, 0x81, 0xE3); mc_u32(c, 0xFFFF)
        mc_b4(c, 0x48, 0x89, 0x5C, 0x24); mc_b1(c, 80) // [RSP+80] = nv
        mc_b2(c, 0x81, 0xE2); mc_u32(c, 0xFFFF)        // RDX = hcap
        mc_b4(c, 0x48, 0x89, 0x54, 0x24); mc_b1(c, 64) // [RSP+64] = hcap
        mc_b4(c, 0x40, 0xF6, 0xC6, 1); jz_d128_sk := mc_jcc32(c, 0x84)
        // === 128-Bucket 2-Register Bitmap Dial (bhead=512B L1D, RBP=bmap0, RBX=bmap1, ZERO stack RMW!) ===
        mc_b3(c, 0x4D, 0x8D, 0x83); mc_u32(c, 512)     // R8 = dist_u32 = bhead + 512
        mc_b3(c, 0x48, 0x89, 0xC5)                     // RBP = save src temporarily
        // AVX2 fast zero bhead[512B] + fill dist_u32[0..nv-1] = 0x3F3F3F3F (or scalar fallback)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_d128_zsc := mc_jcc32(c, 0x84)
        mc_vex256(c, 1, 0, 0, 0, 0xEF)                 // Y0 = 0
        mc_b2(c, 0x31, 0xC9)
        lp_d128_bhv := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x04, 0x0B)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b3(c, 0x44, 0x0B, 32)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b3(c, 0x44, 0x0B, 64)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b3(c, 0x44, 0x0B, 96)
        mc_b3(c, 0x48, 0x81, 0xC1); mc_u32(c, 128); mc_b3(c, 0x48, 0x81, 0xF9); mc_u32(c, 512)
        jl_d128_bhv := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_d128_bhv, lp_d128_bhv)
        // Fill dist_u32 (nv*4 bytes rounded up to 64B, since dist_bytes is 64B-aligned!)
        mc_b1(c, 0xB8); mc_u32(c, 0x3F3F3F3F); mc_b4(c, 0x48, 0x89, 0x04, 0x24)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x58); mc_b2(c, 0x04, 0x24) // VPBROADCASTD Y0, [RSP]
        mc_b3(c, 0x48, 0x89, 0xDE); mc_b4(c, 0x48, 0xC1, 0xE6, 2); mc_b4(c, 0x48, 0x83, 0xC6, 63); mc_b4(c, 0x48, 0x83, 0xE6, 0xC0)
        mc_b2(c, 0x31, 0xC9)
        lp_d128_dv := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x04, 0x08)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b3(c, 0x44, 0x08, 32)
        mc_b4(c, 0x48, 0x83, 0xC1, 64); mc_b3(c, 0x48, 0x39, 0xF1)
        jl_d128_dv := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_d128_dv, lp_d128_dv)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_d128_zdn := mc_jcc8(c, 0xEB)
        mc_patch_rel32(c, jz_d128_zsc, buf_len(c))
        mc_b2(c, 0x31, 0xC9); mc_b2(c, 0x31, 0xD2)
        lp_d128_bhs := buf_len(c)
        mc_b4(c, 0x49, 0x89, 0x14, 0xCB); mc_b3(c, 0x48, 0xFF, 0xC1); mc_b4(c, 0x48, 0x83, 0xF9, 64)
        jl_d128_bhs := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_d128_bhs, lp_d128_bhs)
        mc_b2(c, 0x48, 0xBA); mc_u64(c, 0x3F3F3F3F3F3F3F3F)
        mc_b4(c, 0x48, 0x8D, 0x73, 0x01); mc_b3(c, 0x48, 0xD1, 0xEE)
        mc_b2(c, 0x31, 0xC9)
        lp_d128_ds := buf_len(c)
        mc_b4(c, 0x49, 0x89, 0x14, 0xC8); mc_b3(c, 0x48, 0xFF, 0xC1); mc_b3(c, 0x48, 0x39, 0xF1)
        jl_d128_ds := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_d128_ds, lp_d128_ds)
        mc_patch_jcc8(c, jmp_d128_zdn, buf_len(c))

        // Init: RAX = src (from RBP); dist_u32[src]=0; pool[1]=src<<16; bhead[0]=1; RBP=1, RBX=0, R13=0, R14=1, R15=2
        mc_b3(c, 0x48, 0x89, 0xE8)
        mc_b4(c, 0x41, 0xC7, 0x04, 0x80); mc_u32(c, 0)
        mc_b3(c, 0xC1, 0xE0, 16)
        mc_b4(c, 0x41, 0x89, 0x44, 0x24); mc_b1(c, 4)
        mc_b3(c, 0x41, 0xC7, 0x03); mc_u32(c, 1)
        mc_b1(c, 0xBD); mc_u32(c, 1)                   // RBP = bmap0 = 1
        mc_b2(c, 0x31, 0xDB)                           // RBX = bmap1 = 0
        mc_b3(c, 0x45, 0x31, 0xED)                     // R13 = cur = 0
        mc_b2(c, 0x41, 0xBE); mc_u32(c, 1)             // R14 = cnt = 1
        mc_b2(c, 0x41, 0xBF); mc_u32(c, 2)             // R15 = next_free = 2
        mc_align16_nop(c)
        lp_d128_m := buf_len(c)
        mc_b3(c, 0x4D, 0x85, 0xF6); jle_d128_ok := mc_jcc32(c, 0x8E)
        mc_b3(c, 0x44, 0x89, 0xE8); mc_b3(c, 0x83, 0xE0, 127) // EAX = b = cur & 127
        mc_b4(c, 0x41, 0x8B, 0x14, 0x83)               // EDX = bhead[b]
        mc_b2(c, 0x85, 0xD2); jnz_d128_got := mc_jcc32(c, 0x85)
        // Register-only 2-word bitmap search (ZERO memory loads, ZERO loop!)
        mc_b2(c, 0xA8, 0x40); jnz_d128_hi := mc_jcc8(c, 0x75)
        // Case b in 0..63: check RBP >> b, then RBX, then RBP wrap
        mc_b2(c, 0x89, 0xC1); mc_b3(c, 0x48, 0x89, 0xEE); mc_b3(c, 0x48, 0xD3, 0xEE)
        mc_b3(c, 0x48, 0x85, 0xF6); jz_d128_b1 := mc_jcc8(c, 0x74)
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xD6); mc_b3(c, 0x49, 0x01, 0xD5) // cur += bsf(RBP>>b)
        jmp_d128_f0 := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jz_d128_b1, buf_len(c))
        mc_b3(c, 0x48, 0x85, 0xDB); jz_d128_w0 := mc_jcc8(c, 0x74)
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xD3); mc_b3(c, 0x48, 0x29, 0xC2); mc_b4(c, 0x48, 0x83, 0xC2, 64); mc_b3(c, 0x49, 0x01, 0xD5)
        jmp_d128_f1 := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jz_d128_w0, buf_len(c))
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xD5); mc_b3(c, 0x48, 0x29, 0xC2); mc_b3(c, 0x48, 0x81, 0xC2); mc_u32(c, 128); mc_b3(c, 0x49, 0x01, 0xD5)
        jmp_d128_f2 := mc_jcc8(c, 0xEB)
        // Case b in 64..127: check RBX >> (b-64), then RBP, then RBX wrap
        mc_patch_jcc8(c, jnz_d128_hi, buf_len(c))
        mc_b3(c, 0x8D, 0x48, 0xC0)                     // ECX = b - 64
        mc_b3(c, 0x48, 0x89, 0xDE); mc_b3(c, 0x48, 0xD3, 0xEE)
        mc_b3(c, 0x48, 0x85, 0xF6); jz_d128_b0 := mc_jcc8(c, 0x74)
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xD6); mc_b3(c, 0x49, 0x01, 0xD5)
        jmp_d128_f3 := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jz_d128_b0, buf_len(c))
        mc_b3(c, 0x48, 0x85, 0xED); jz_d128_w1 := mc_jcc8(c, 0x74)
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xD5); mc_b3(c, 0x48, 0x29, 0xCA); mc_b4(c, 0x48, 0x83, 0xC2, 64); mc_b3(c, 0x49, 0x01, 0xD5)
        jmp_d128_f4 := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jz_d128_w1, buf_len(c))
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xD3); mc_b3(c, 0x48, 0x29, 0xCA); mc_b3(c, 0x48, 0x81, 0xC2); mc_u32(c, 128); mc_b3(c, 0x49, 0x01, 0xD5)

        mc_patch_jcc8(c, jmp_d128_f0, buf_len(c))
        mc_patch_jcc8(c, jmp_d128_f1, buf_len(c))
        mc_patch_jcc8(c, jmp_d128_f2, buf_len(c))
        mc_patch_jcc8(c, jmp_d128_f3, buf_len(c))
        mc_patch_jcc8(c, jmp_d128_f4, buf_len(c))
        mc_b3(c, 0x44, 0x89, 0xE8); mc_b3(c, 0x83, 0xE0, 127)
        mc_b4(c, 0x41, 0x8B, 0x14, 0x83)               // EDX = bhead[new_b]

        mc_patch_rel32(c, jnz_d128_got, buf_len(c))
        mc_b4(c, 0x41, 0x8B, 0x34, 0x94)               // ESI = pool[idx] = (u<<16)|next
        mc_b2(c, 0x89, 0xF2); mc_b2(c, 0x81, 0xE2); mc_u32(c, 0xFFFF)
        mc_b4(c, 0x41, 0x89, 0x14, 0x83)               // bhead[b] = next
        mc_b2(c, 0x85, 0xD2); jnz_d128_nb := mc_jcc8(c, 0x75)
        // Clear bit EAX in RBP or RBX (1-insn register BTR, auto mod-64!)
        mc_b2(c, 0xA8, 0x40); jnz_d128_cl1 := mc_jcc8(c, 0x75)
        mc_b4(c, 0x48, 0x0F, 0xB3, 0xC5); jmp_d128_cl := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jnz_d128_cl1, buf_len(c))
        mc_b4(c, 0x48, 0x0F, 0xB3, 0xC3)
        mc_patch_jcc8(c, jmp_d128_cl, buf_len(c))
        mc_patch_jcc8(c, jnz_d128_nb, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xCE)                     // cnt--
        mc_b3(c, 0xC1, 0xEE, 16)                       // ESI = u
        mc_b4(c, 0x45, 0x3B, 0x2C, 0xB0); jg_d128_m := mc_jcc32(c, 0x8F) // stale check!
        mc_b4(c, 0x49, 0x63, 0x3C, 0xB1)               // RDI = head[u]
        mc_b3(c, 0x48, 0x85, 0xFF); js_d128_ed := mc_jcc32(c, 0x88)
        lp_d128_e := buf_len(c)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xFA)               // RAX = edges_u64[e]
        mc_b3(c, 0x48, 0x89, 0xC7); mc_b4(c, 0x48, 0xC1, 0xFF, 32) // RDI = next
        mc_b2(c, 0x89, 0xC6); mc_b3(c, 0xC1, 0xEE, 16) // ESI = w
        mc_b3(c, 0x83, 0xFE, 127); jg_d128_w := mc_jcc32(c, 0x8F) // w >= 128 -> rc=3 fallback!
        mc_b3(c, 0x0F, 0xB7, 0xC0)                     // EAX = v
        mc_b4(c, 0x4A, 0x8D, 0x14, 0x2E)               // RDX = nd = cur + w
        mc_b4(c, 0x41, 0x3B, 0x14, 0x80); jge_d128_ne := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x41, 0x89, 0x14, 0x80)               // dist_u32[v] = nd
        mc_b4(c, 0x4C, 0x3B, 0x7C, 0x24); mc_b1(c, 64); jge_d128_ov := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x83, 0xE2, 127)                      // EDX = nb = nd & 127
        mc_b3(c, 0xC1, 0xE0, 16)
        mc_b4(c, 0x41, 0x0B, 0x04, 0x93)               // EAX = (v<<16) | bhead[nb]
        mc_b4(c, 0x43, 0x89, 0x04, 0xBC)               // pool[next_free] = EAX
        mc_b4(c, 0x45, 0x89, 0x3C, 0x93)               // bhead[nb] = next_free
        // Branchless register-only bit set in RBP (0..63) / RBX (64..127), ZERO memory ops!
        mc_b2(c, 0x31, 0xC0); mc_b4(c, 0x48, 0x0F, 0xAB, 0xD0) // RAX = 1 << (nb & 63)
        mc_b4(c, 0x0F, 0xBA, 0xE2, 6); mc_b3(c, 0x48, 0x19, 0xC9) // BT EDX, 6; SBB RCX, RCX
        mc_b3(c, 0x48, 0x21, 0xC1); mc_b3(c, 0x48, 0x09, 0xCB) // RCX &= RAX; RBX |= RCX
        mc_b3(c, 0x48, 0x31, 0xC8); mc_b3(c, 0x48, 0x09, 0xC5) // RAX ^= RCX; RBP |= RAX
        mc_b3(c, 0x49, 0xFF, 0xC7); mc_b3(c, 0x49, 0xFF, 0xC6) // next_free++; cnt++
        mc_patch_jcc8(c, jge_d128_ne, buf_len(c))
        mc_b3(c, 0x48, 0x85, 0xFF); jns_d128_e := mc_jcc32(c, 0x89); mc_patch_rel32(c, jns_d128_e, lp_d128_e)
        mc_patch_rel32(c, jg_d128_m, buf_len(c))
        mc_patch_rel32(c, js_d128_ed, buf_len(c))
        j_d128_m := mc_jmp32(c); mc_patch_rel32(c, j_d128_m, lp_d128_m)

        mc_patch_rel32(c, jz_d128_sk, buf_len(c))
        mc_b3(c, 0x4D, 0x8D, 0x83); mc_u32(c, 2048)    // R8 = dist_u32 = bhead + 2048 (512-bucket fallback)
        // Zero 64B bitmap
        mc_b2(c, 0x31, 0xC9); mc_b2(c, 0x31, 0xD2)
        lp_dcz := buf_len(c)
        mc_b4(c, 0x48, 0x89, 0x14, 0xCC); mc_b3(c, 0x48, 0xFF, 0xC1); mc_b4(c, 0x48, 0x83, 0xF9, 8)
        jl_dcz := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_dcz, lp_dcz)
        // Zero bhead_u32[0..511] (2048B = 256 qwords)
        mc_b2(c, 0x31, 0xC9)
        lp_dcbhz := buf_len(c)
        mc_b4(c, 0x49, 0x89, 0x14, 0xCB); mc_b4(c, 0x49, 0x89, 0x54, 0xCB); mc_b1(c, 8)
        mc_b4(c, 0x49, 0x89, 0x54, 0xCB); mc_b1(c, 16); mc_b4(c, 0x49, 0x89, 0x54, 0xCB); mc_b1(c, 24)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b3(c, 0x48, 0x81, 0xF9); mc_u32(c, 256)
        jl_dcbhz := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_dcbhz, lp_dcbhz)
        // Fill dist_u32[0..nv-1] = 0x3F3F3F3F (qword pairs + odd tail!)
        mc_b2(c, 0x48, 0xBA); mc_u64(c, 0x3F3F3F3F3F3F3F3F)
        mc_b4(c, 0x48, 0x8D, 0x73, 0x01); mc_b3(c, 0x48, 0xD1, 0xEE) // RSI = (nv + 1) >> 1 qwords
        mc_b2(c, 0x31, 0xC9)
        lp_dcdz := buf_len(c)
        mc_b4(c, 0x49, 0x89, 0x14, 0xC8); mc_b3(c, 0x48, 0xFF, 0xC1); mc_b3(c, 0x48, 0x39, 0xF1)
        jl_dcdz := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_dcdz, lp_dcdz)
        // dist_u32[src] = 0; pool[1] = src<<16; bhead[0] = 1; bmap[0] = 1
        mc_b4(c, 0x41, 0xC7, 0x04, 0x80); mc_u32(c, 0)
        mc_b3(c, 0xC1, 0xE0, 16)
        mc_b4(c, 0x41, 0x89, 0x44, 0x24); mc_b1(c, 4)
        mc_b3(c, 0x41, 0xC7, 0x03); mc_u32(c, 1)
        mc_b4(c, 0x48, 0xC7, 0x04, 0x24); mc_u32(c, 1)
        mc_b3(c, 0x45, 0x31, 0xED)
        mc_b2(c, 0x41, 0xBE); mc_u32(c, 1)
        mc_b2(c, 0x41, 0xBF); mc_u32(c, 2)
        mc_align16_nop(c)
        lp_dc_m := buf_len(c)
        mc_b3(c, 0x4D, 0x85, 0xF6); jle_dc_ok := mc_jcc32(c, 0x8E)
        lp_dc_f := buf_len(c)
        mc_b3(c, 0x4C, 0x89, 0xE8); mc_b1(c, 0x25); mc_u32(c, 511)
        mc_b4(c, 0x41, 0x8B, 0x14, 0x83)
        mc_b2(c, 0x85, 0xD2); jnz_dc_got := mc_jcc8(c, 0x75)
        mc_b2(c, 0x89, 0xC1); mc_b3(c, 0xC1, 0xE9, 6)
        mc_b4(c, 0x48, 0x8B, 0x1C, 0xCC)
        mc_b2(c, 0x89, 0xC6); mc_b3(c, 0x83, 0xE6, 63)
        mc_b2(c, 0x89, 0xF1); mc_b3(c, 0x48, 0xD3, 0xEB)
        mc_b3(c, 0x48, 0x85, 0xDB); jz_dc_nw := mc_jcc8(c, 0x74)
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xD3); mc_b3(c, 0x49, 0x01, 0xD5)
        j_dc_f1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_dc_f1, lp_dc_f)
        mc_patch_jcc8(c, jz_dc_nw, buf_len(c))
        mc_b1(c, 0xB8); mc_u32(c, 64); mc_b2(c, 0x29, 0xF0); mc_b3(c, 0x49, 0x01, 0xC5)
        j_dc_f2 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_dc_f2, lp_dc_f)
        mc_patch_jcc8(c, jnz_dc_got, buf_len(c))
        mc_b4(c, 0x41, 0x8B, 0x34, 0x94)
        mc_b2(c, 0x89, 0xF2); mc_b2(c, 0x81, 0xE2); mc_u32(c, 0xFFFF)
        mc_b4(c, 0x41, 0x89, 0x14, 0x83)
        mc_b2(c, 0x85, 0xD2); jnz_dc_nb := mc_jcc8(c, 0x75)
        mc_b2(c, 0x89, 0xC1); mc_b3(c, 0xC1, 0xE9, 6); mc_b3(c, 0x83, 0xE0, 63)
        mc_b4(c, 0x48, 0x8B, 0x14, 0xCC); mc_b4(c, 0x48, 0x0F, 0xB3, 0xC2); mc_b4(c, 0x48, 0x89, 0x14, 0xCC)
        mc_patch_jcc8(c, jnz_dc_nb, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xCE)
        mc_b3(c, 0xC1, 0xEE, 16)         // ESI = u
        mc_b4(c, 0x45, 0x3B, 0x2C, 0xB0); jg_dc_m := mc_jcc32(c, 0x8F) // CMP R13D, dist_u32[u]
        mc_b4(c, 0x49, 0x63, 0x3C, 0xB1) // MOVSXD RDI, head_i32[u]
        mc_b3(c, 0x48, 0x85, 0xFF); js_dc_ed := mc_jcc32(c, 0x88)
        lp_dc_e := buf_len(c)
        // 8-byte packed edge: (v:u16 | w:u16<<16 | next:i32<<32) -> 1 single 64-bit load, ZERO e*3!
        mc_b4(c, 0x49, 0x8B, 0x04, 0xFA) // RAX = edges_u64[e]
        mc_b3(c, 0x48, 0x89, 0xC7); mc_b4(c, 0x48, 0xC1, 0xFF, 32) // RDI = next (i32 sign-ext)
        mc_b2(c, 0x89, 0xC6); mc_b3(c, 0xC1, 0xEE, 16)             // ESI = w (u16, 0..65535)
        mc_b2(c, 0x81, 0xFE); mc_u32(c, 512); jge_dc_w := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x0F, 0xB7, 0xC0)       // EAX = v (u16)
        mc_b4(c, 0x4A, 0x8D, 0x14, 0x2E) // RDX = nd = cur + w
        mc_b4(c, 0x41, 0x3B, 0x14, 0x80); jge_dc_ne := mc_jcc8(c, 0x7D) // CMP EDX, dist_u32[v]
        mc_b4(c, 0x41, 0x89, 0x14, 0x80) // dist_u32[v] = EDX
        mc_b4(c, 0x4C, 0x3B, 0x7C, 0x24); mc_b1(c, 64); jge_dc_ov := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x48, 0x81, 0xE2); mc_u32(c, 511)
        mc_b3(c, 0xC1, 0xE0, 16)
        mc_b4(c, 0x41, 0x0B, 0x04, 0x93)
        mc_b4(c, 0x43, 0x89, 0x04, 0xBC)
        mc_b4(c, 0x45, 0x89, 0x3C, 0x93)
        mc_b2(c, 0x89, 0xD1); mc_b3(c, 0xC1, 0xE9, 6)
        mc_b3(c, 0x48, 0x89, 0xD0); mc_b4(c, 0x48, 0x83, 0xE0, 63)
        mc_b4(c, 0x48, 0x8B, 0x14, 0xCC); mc_b4(c, 0x48, 0x0F, 0xAB, 0xC2); mc_b4(c, 0x48, 0x89, 0x14, 0xCC)
        mc_b3(c, 0x49, 0xFF, 0xC7); mc_b3(c, 0x49, 0xFF, 0xC6)
        mc_patch_jcc8(c, jge_dc_ne, buf_len(c))
        mc_b3(c, 0x48, 0x85, 0xFF); jns_dc_e := mc_jcc32(c, 0x89); mc_patch_rel32(c, jns_dc_e, lp_dc_e)
        mc_patch_rel32(c, jg_dc_m, buf_len(c))
        mc_patch_rel32(c, js_dc_ed, buf_len(c))
        j_dc_m := mc_jmp32(c); mc_patch_rel32(c, j_dc_m, lp_dc_m)
        // Widen dist_u32[0..nv-1] -> orig dp[0..nv-1] (4-wide AVX2 VPMOVZXDQ + branchless INF blend!)
        mc_patch_rel32(c, jle_dc_ok, buf_len(c))
        mc_patch_rel32(c, jle_d128_ok, buf_len(c))
        mc_b4(c, 0x4C, 0x8B, 0x4C, 0x24); mc_b1(c, 72) // R9 = orig dp
        mc_b4(c, 0x4C, 0x8B, 0x54, 0x24); mc_b1(c, 80) // R10 = nv
        mc_b2(c, 0x48, 0xBA); mc_u64(c, 0x3FFFFFFFFFFFFFFF)
        mc_b2(c, 0x31, 0xC9)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_dcw_sc := mc_jcc8(c, 0x74)
        mc_b4(c, 0x49, 0x8D, 0x72, 0xFC) // RSI = nv - 4
        mc_b4(c, 0x48, 0x89, 0x14, 0x24) // [RSP+0] = INF64
        mc_b1(c, 0xB8); mc_u32(c, 0x3F3F3F3F); mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 8) // [RSP+8] = 0x3F3F3F3F
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x59); mc_b2(c, 0x1C, 0x24)       // Y3 = bcast(INF64)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x59); mc_b3(c, 0x64, 0x24, 8)    // Y4 = bcast(0x3F3F3F3F)
        lp_dcwv := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xF1); jg_dcwv_dn := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x35); mc_b2(c, 0x04, 0x88)       // VPMOVZXDQ Y0, [R8+RCX*4]
        mc_vex256(c, 2, 1, 0, 4, 0x29)                                       // VPCMPEQQ Y1, Y0, Y4
        mc_vex256(c, 1, 2, 1, 3, 0xDB); mc_vex256(c, 1, 0, 1, 0, 0xDF); mc_vex256(c, 1, 0, 0, 2, 0xEB)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x04, 0xC9)       // VMOVDQU [R9+RCX*8], Y0
        mc_b4(c, 0x48, 0x83, 0xC1, 4); j_dcwv := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_dcwv, lp_dcwv)
        mc_patch_jcc8(c, jg_dcwv_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_patch_jcc8(c, jz_dcw_sc, buf_len(c))
        lp_dcw := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jge_dcw_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x41, 0x8B, 0x04, 0x88) // EAX = dist_u32[i] (zero-ext!)
        mc_b1(c, 0x3D); mc_u32(c, 0x3F3F3F3F)
        mc_b4(c, 0x48, 0x0F, 0x44, 0xC2) // CMOVE RAX, RDX
        mc_b4(c, 0x49, 0x89, 0x04, 0xC9) // orig_dp[i] = RAX
        mc_b3(c, 0x48, 0xFF, 0xC1); j_dcw := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_dcw, lp_dcw)
        mc_patch_jcc8(c, jge_dcw_dn, buf_len(c))
        mc_b2(c, 0x31, 0xC0); jmp_dc_ret := mc_jmp32(c)
        mc_patch_rel32(c, jge_dc_ov, buf_len(c))
        mc_patch_rel32(c, jge_d128_ov, buf_len(c))
        mc_b1(c, 0xB8); mc_u32(c, 1); jmp_dc_ret1 := mc_jmp32(c)
        mc_patch_rel32(c, jge_dc_w, buf_len(c))
        mc_b1(c, 0xB8); mc_u32(c, 2); jmp_dc_ret2 := mc_jmp32(c)
        mc_patch_rel32(c, jg_d128_w, buf_len(c))
        mc_b1(c, 0xB8); mc_u32(c, 3); jmp_dc_ret3 := mc_jmp32(c)

        mc_patch_rel32(c, jz_djc_skip, buf_len(c))
        mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE9, 62) // RCX = mode_u32 (bit 62)
        mc_b3(c, 0x48, 0x85, 0xC9); jz_dj64 := mc_jcc32(c, 0x84)
        // ===== Compact u32 Dial fastpath (bhead[512] = 2KB L1D, pool[hcap] = 4B/entry (v<<16)|next -> fits 100% in L2!) =====
        mc_b2(c, 0x48, 0xB9); mc_u64(c, 0x3FFFFFFFFFFFFFFF)
        mc_b3(c, 0x48, 0x21, 0xCA) // RDX = hcap (clear bit 62)
        mc_b4(c, 0x48, 0x89, 0x54, 0x24); mc_b1(c, 64)
        // Zero 64B bitmap [RSP+0..63]
        mc_b2(c, 0x31, 0xC9); mc_b2(c, 0x31, 0xD2)
        lp_d3z := buf_len(c)
        mc_b4(c, 0x48, 0x89, 0x14, 0xCC); mc_b3(c, 0x48, 0xFF, 0xC1); mc_b4(c, 0x48, 0x83, 0xF9, 8)
        jl_d3z := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_d3z, lp_d3z)
        // Zero bhead[0..511] (2048B = 256 qwords, fast qword loop!)
        mc_b2(c, 0x31, 0xC9)
        lp_d3bhz := buf_len(c)
        mc_b4(c, 0x49, 0x89, 0x14, 0xCB); mc_b4(c, 0x49, 0x89, 0x54, 0xCB); mc_b1(c, 8)
        mc_b4(c, 0x49, 0x89, 0x54, 0xCB); mc_b1(c, 16); mc_b4(c, 0x49, 0x89, 0x54, 0xCB); mc_b1(c, 24)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b3(c, 0x48, 0x81, 0xF9); mc_u32(c, 256)
        jl_d3bhz := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_d3bhz, lp_d3bhz)
        // pool[1] = (u32)(src << 16); bhead[0] = 1; bmap[0] = 1
        mc_b3(c, 0xC1, 0xE0, 16)
        mc_b4(c, 0x41, 0x89, 0x44, 0x24); mc_b1(c, 4) // DWORD [R12+4] = src << 16
        mc_b3(c, 0x41, 0xC7, 0x03); mc_u32(c, 1)      // DWORD [R11] = 1
        mc_b4(c, 0x48, 0xC7, 0x04, 0x24); mc_u32(c, 1)
        mc_b3(c, 0x45, 0x31, 0xED)       // R13 = cur = 0
        mc_b2(c, 0x41, 0xBE); mc_u32(c, 1) // R14 = cnt = 1
        mc_b2(c, 0x41, 0xBF); mc_u32(c, 2) // R15 = slot = 2

        mc_align16_nop(c)
        lp_d3_m := buf_len(c)
        mc_b3(c, 0x4D, 0x85, 0xF6); jle_d3_ok := mc_jcc32(c, 0x8E)
        lp_d3_f := buf_len(c)
        mc_b3(c, 0x4C, 0x89, 0xE8); mc_b1(c, 0x25); mc_u32(c, 511)
        mc_b4(c, 0x41, 0x8B, 0x14, 0x83) // EDX = bhead_u32[bk] (zero-ext!)
        mc_b2(c, 0x85, 0xD2); jnz_d3_got := mc_jcc8(c, 0x75)
        mc_b2(c, 0x89, 0xC1); mc_b3(c, 0xC1, 0xE9, 6)
        mc_b4(c, 0x48, 0x8B, 0x1C, 0xCC)
        mc_b2(c, 0x89, 0xC6); mc_b3(c, 0x83, 0xE6, 63)
        mc_b2(c, 0x89, 0xF1); mc_b3(c, 0x48, 0xD3, 0xEB)
        mc_b3(c, 0x48, 0x85, 0xDB); jz_d3_nw := mc_jcc8(c, 0x74)
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xD3); mc_b3(c, 0x49, 0x01, 0xD5)
        j_d3_f1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_d3_f1, lp_d3_f)
        mc_patch_jcc8(c, jz_d3_nw, buf_len(c))
        mc_b1(c, 0xB8); mc_u32(c, 64); mc_b2(c, 0x29, 0xF0); mc_b3(c, 0x49, 0x01, 0xC5)
        j_d3_f2 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_d3_f2, lp_d3_f)

        mc_patch_jcc8(c, jnz_d3_got, buf_len(c))
        mc_b4(c, 0x41, 0x8B, 0x34, 0x94) // ESI = packed32 = pool_u32[hd] (zero-ext!)
        mc_b2(c, 0x89, 0xF2); mc_b2(c, 0x81, 0xE2); mc_u32(c, 0xFFFF) // EDX = next_hd = packed32 & 0xFFFF
        mc_b4(c, 0x41, 0x89, 0x14, 0x83) // bhead_u32[bk] = EDX
        mc_b2(c, 0x85, 0xD2); jnz_d3_nb := mc_jcc8(c, 0x75)
        mc_b2(c, 0x89, 0xC1); mc_b3(c, 0xC1, 0xE9, 6)
        mc_b3(c, 0x83, 0xE0, 63)
        mc_b4(c, 0x48, 0x8B, 0x14, 0xCC); mc_b4(c, 0x48, 0x0F, 0xB3, 0xC2); mc_b4(c, 0x48, 0x89, 0x14, 0xCC)
        mc_patch_jcc8(c, jnz_d3_nb, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xCE)       // cnt--
        mc_b3(c, 0xC1, 0xEE, 16)         // ESI = u = packed32 >> 16
        mc_b4(c, 0x4D, 0x3B, 0x2C, 0xF0); jg_d3_m := mc_jcc32(c, 0x8F)
        mc_b4(c, 0x49, 0x8B, 0x3C, 0xF1) // RDI = e = hp[u]
        lp_d3_e := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xFF); js_d3_ed := mc_jcc32(c, 0x88)
        mc_b4(c, 0x48, 0x8D, 0x1C, 0x7F) // RBX = b = e * 3
        mc_b4(c, 0x49, 0x8B, 0x74, 0xDA); mc_b1(c, 8) // RSI = w = ep[b+1]
        mc_b3(c, 0x48, 0x81, 0xFE); mc_u32(c, 512); jge_d3_w := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x48, 0x85, 0xF6); js_d3_ne := mc_jcc8(c, 0x78)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xDA) // RAX = v = ep[b]
        mc_b4(c, 0x4A, 0x8D, 0x14, 0x2E) // RDX = nd = cur + w
        mc_b4(c, 0x49, 0x3B, 0x14, 0xC0); jge_d3_ne := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x89, 0x14, 0xC0) // dp[v] = nd
        mc_b4(c, 0x4C, 0x3B, 0x7C, 0x24); mc_b1(c, 64); jge_d3_ov := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x48, 0x81, 0xE2); mc_u32(c, 511) // RDX = nb = nd & 511
        mc_b3(c, 0xC1, 0xE0, 16)                   // EAX = v << 16
        mc_b4(c, 0x41, 0x0B, 0x04, 0x93)           // EAX |= bhead_u32[nb]
        mc_b4(c, 0x43, 0x89, 0x04, 0xBC)           // pool_u32[slot] = EAX
        mc_b4(c, 0x45, 0x89, 0x3C, 0x93)           // bhead_u32[nb] = R15D (slot)
        mc_b2(c, 0x89, 0xD1); mc_b3(c, 0xC1, 0xE9, 6)
        mc_b3(c, 0x48, 0x89, 0xD0); mc_b4(c, 0x48, 0x83, 0xE0, 63)
        mc_b4(c, 0x48, 0x8B, 0x14, 0xCC); mc_b4(c, 0x48, 0x0F, 0xAB, 0xC2); mc_b4(c, 0x48, 0x89, 0x14, 0xCC)
        mc_b3(c, 0x49, 0xFF, 0xC7); mc_b3(c, 0x49, 0xFF, 0xC6)
        mc_patch_jcc8(c, js_d3_ne, buf_len(c))
        mc_patch_jcc8(c, jge_d3_ne, buf_len(c))
        mc_b4(c, 0x49, 0x8B, 0x7C, 0xDA); mc_b1(c, 16)
        j_d3_e := mc_jmp32(c); mc_patch_rel32(c, j_d3_e, lp_d3_e)
        mc_patch_rel32(c, jg_d3_m, buf_len(c))
        mc_patch_rel32(c, js_d3_ed, buf_len(c))
        j_d3_m := mc_jmp32(c); mc_patch_rel32(c, j_d3_m, lp_d3_m)
        mc_patch_rel32(c, jle_d3_ok, buf_len(c))
        mc_b2(c, 0x31, 0xC0); jmp_d3_ret := mc_jmp32(c)
        mc_patch_rel32(c, jge_d3_ov, buf_len(c))
        mc_b1(c, 0xB8); mc_u32(c, 1); jmp_d3_ret1 := mc_jmp32(c)
        mc_patch_rel32(c, jge_d3_w, buf_len(c))
        mc_b1(c, 0xB8); mc_u32(c, 2); jmp_d3_ret2 := mc_jmp32(c)

        // ===== General 64-bit Dial path (nv > 65535 or hcap > 65535) =====
        mc_patch_rel32(c, jz_dj64, buf_len(c))
        mc_b4(c, 0x48, 0x89, 0x54, 0x24); mc_b1(c, 64)
        // Zero 64B bitmap at [RSP+0..63]
        mc_b2(c, 0x31, 0xC9); mc_b2(c, 0x31, 0xD2)
        lp_djz := buf_len(c)
        mc_b4(c, 0x48, 0x89, 0x14, 0xCC); mc_b3(c, 0x48, 0xFF, 0xC1); mc_b4(c, 0x48, 0x83, 0xF9, 8)
        jl_djz := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_djz, lp_djz)
        // pool[1] = src << 32; bhead[0] = 1; bmap[0] = 1
        mc_b4(c, 0x48, 0xC1, 0xE0, 32)
        mc_b4(c, 0x49, 0x89, 0x44, 0x24); mc_b1(c, 8)
        mc_b3(c, 0x49, 0xC7, 0x03); mc_u32(c, 1)
        mc_b4(c, 0x48, 0xC7, 0x04, 0x24); mc_u32(c, 1)
        mc_b3(c, 0x45, 0x31, 0xED) // R13 = cur = 0
        mc_b2(c, 0x41, 0xBE); mc_u32(c, 1) // R14 = cnt = 1
        mc_b2(c, 0x41, 0xBF); mc_u32(c, 2) // R15 = slot = 2

        mc_align16_nop(c)
        lp_dj_m := buf_len(c)
        mc_b3(c, 0x4D, 0x85, 0xF6); jle_dj_ok := mc_jcc32(c, 0x8E)
        // Find next non-empty bucket >= cur via 512-bit bitmap + BSF!
        lp_dj_f := buf_len(c)
        mc_b3(c, 0x4C, 0x89, 0xE8); mc_b1(c, 0x25); mc_u32(c, 511) // EAX = bk = cur & 511
        mc_b4(c, 0x49, 0x8B, 0x14, 0xC3) // RDX = hd = bhead[bk]
        mc_b3(c, 0x48, 0x85, 0xD2); jnz_dj_got := mc_jcc8(c, 0x75)
        // Fast bitmap jump: check remaining bits in current word [bk>>6]
        mc_b2(c, 0x89, 0xC1); mc_b3(c, 0xC1, 0xE9, 6) // ECX = w = bk >> 6 (0..7)
        mc_b4(c, 0x48, 0x8B, 0x1C, 0xCC) // RBX = bmap[w]
        mc_b2(c, 0x89, 0xC6); mc_b3(c, 0x83, 0xE6, 63) // ESI = bit = bk & 63
        mc_b2(c, 0x89, 0xF1); mc_b3(c, 0x48, 0xD3, 0xEB) // RBX >>= bit
        mc_b3(c, 0x48, 0x85, 0xDB); jz_dj_nw := mc_jcc8(c, 0x74)
        mc_b4(c, 0x48, 0x0F, 0xBC, 0xD3); mc_b3(c, 0x49, 0x01, 0xD5) // cur += BSF(RBX)
        j_dj_f1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_dj_f1, lp_dj_f)
        mc_patch_jcc8(c, jz_dj_nw, buf_len(c))
        // Advance cur to start of next 64-bucket word: cur += 64 - bit
        mc_b1(c, 0xB8); mc_u32(c, 64); mc_b2(c, 0x29, 0xF0); mc_b3(c, 0x49, 0x01, 0xC5)
        j_dj_f2 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_dj_f2, lp_dj_f)

        mc_patch_jcc8(c, jnz_dj_got, buf_len(c))
        // Pop hd from bhead[bk]; RAX=bk, RDX=hd
        mc_b4(c, 0x49, 0x8B, 0x34, 0xD4) // RSI = packed = pool[hd]
        mc_b2(c, 0x89, 0xF2)             // EDX = next_hd = packed & 0xFFFFFFFF (zero-ext!)
        mc_b4(c, 0x49, 0x89, 0x14, 0xC3) // bhead[bk] = next_hd
        mc_b3(c, 0x48, 0x85, 0xD2); jnz_dj_nb := mc_jcc8(c, 0x75)
        // Clear bit bk in bitmap!
        mc_b2(c, 0x89, 0xC1); mc_b3(c, 0xC1, 0xE9, 6) // ECX = bk >> 6
        mc_b3(c, 0x83, 0xE0, 63)
        mc_b4(c, 0x48, 0x8B, 0x14, 0xCC) // MOV RDX, [RSP + RCX*8]
        mc_b4(c, 0x48, 0x0F, 0xB3, 0xC2) // BTR RDX, RAX (1-cycle register form!)
        mc_b4(c, 0x48, 0x89, 0x14, 0xCC) // MOV [RSP + RCX*8], RDX
        mc_patch_jcc8(c, jnz_dj_nb, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xCE) // cnt--
        mc_b4(c, 0x48, 0xC1, 0xEE, 32) // RSI = u = packed >> 32
        mc_b4(c, 0x4D, 0x3B, 0x2C, 0xF0); jg_dj_m := mc_jcc32(c, 0x8F) // if cur > dp[u] continue
        // Traverse adjacency list e = hp[u]
        mc_b4(c, 0x49, 0x8B, 0x3C, 0xF1) // RDI = e = hp[u]
        lp_dj_e := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xFF); js_dj_ed := mc_jcc32(c, 0x88)
        mc_b4(c, 0x48, 0x8D, 0x1C, 0x7F) // RBX = b = e * 3
        mc_b4(c, 0x49, 0x8B, 0x74, 0xDA); mc_b1(c, 8) // RSI = w = ep[b+1]
        mc_b3(c, 0x48, 0x81, 0xFE); mc_u32(c, 512); jge_dj_w := mc_jcc32(c, 0x8D) // if w >= 512 return 2
        mc_b3(c, 0x48, 0x85, 0xF6); js_dj_ne := mc_jcc8(c, 0x78)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xDA) // RAX = v = ep[b]
        mc_b4(c, 0x4A, 0x8D, 0x14, 0x2E) // RDX = nd = cur + w (R13 + RSI)
        mc_b4(c, 0x49, 0x3B, 0x14, 0xC0); jge_dj_ne := mc_jcc8(c, 0x7D) // if nd >= dp[v] skip
        mc_b4(c, 0x49, 0x89, 0x14, 0xC0) // dp[v] = nd
        mc_b4(c, 0x4C, 0x3B, 0x7C, 0x24); mc_b1(c, 64); jge_dj_ov := mc_jcc32(c, 0x8D) // if slot >= hcap return 1
        mc_b3(c, 0x48, 0x81, 0xE2); mc_u32(c, 511) // RDX = nb = nd & 511
        mc_b4(c, 0x48, 0xC1, 0xE0, 32)             // RAX = v << 32
        mc_b4(c, 0x49, 0x0B, 0x04, 0xD3)           // RAX |= bhead[nb]
        mc_b4(c, 0x4B, 0x89, 0x04, 0xFC)           // pool[slot] = RAX
        mc_b4(c, 0x4D, 0x89, 0x3C, 0xD3)           // bhead[nb] = slot
        // Set bit nb in bitmap
        mc_b2(c, 0x89, 0xD1); mc_b3(c, 0xC1, 0xE9, 6) // ECX = nb >> 6
        mc_b3(c, 0x48, 0x89, 0xD0); mc_b4(c, 0x48, 0x83, 0xE0, 63) // RAX = nb & 63
        mc_b4(c, 0x48, 0x8B, 0x14, 0xCC) // MOV RDX, [RSP + RCX*8]
        mc_b4(c, 0x48, 0x0F, 0xAB, 0xC2) // BTS RDX, RAX (1-cycle register form!)
        mc_b4(c, 0x48, 0x89, 0x14, 0xCC) // MOV [RSP + RCX*8], RDX
        mc_b3(c, 0x49, 0xFF, 0xC7); mc_b3(c, 0x49, 0xFF, 0xC6) // slot++; cnt++
        mc_patch_jcc8(c, js_dj_ne, buf_len(c))
        mc_patch_jcc8(c, jge_dj_ne, buf_len(c))
        mc_b4(c, 0x49, 0x8B, 0x7C, 0xDA); mc_b1(c, 16) // e = ep[b+2]
        j_dj_e := mc_jmp32(c); mc_patch_rel32(c, j_dj_e, lp_dj_e)

        mc_patch_rel32(c, jg_dj_m, buf_len(c))
        mc_patch_rel32(c, js_dj_ed, buf_len(c))
        j_dj_m := mc_jmp32(c); mc_patch_rel32(c, j_dj_m, lp_dj_m)

        mc_patch_rel32(c, jle_dj_ok, buf_len(c))
        mc_b2(c, 0x31, 0xC0); jmp_dj_ret := mc_jcc8(c, 0xEB)
        mc_patch_rel32(c, jge_dj_ov, buf_len(c))
        mc_b1(c, 0xB8); mc_u32(c, 1); jmp_dj_ret2 := mc_jcc8(c, 0xEB)
        mc_patch_rel32(c, jge_dj_w, buf_len(c))
        mc_b1(c, 0xB8); mc_u32(c, 2)
        mc_patch_jcc8(c, jmp_dj_ret, buf_len(c))
        mc_patch_jcc8(c, jmp_dj_ret2, buf_len(c))
        mc_patch_rel32(c, jmp_dc_ret, buf_len(c))
        mc_patch_rel32(c, jmp_dc_ret1, buf_len(c))
        mc_patch_rel32(c, jmp_dc_ret2, buf_len(c)); mc_patch_rel32(c, jmp_dc_ret3, buf_len(c))
        mc_patch_rel32(c, jmp_d3_ret, buf_len(c))
        mc_patch_rel32(c, jmp_d3_ret1, buf_len(c))
        mc_patch_rel32(c, jmp_d3_ret2, buf_len(c))
        mc_ai_leave(c, 0x68)
        cg_reg_helper(cg, h_ai_dijkstra_dial(), s_dj, buf_len(c))
    }

    // 40. `h_ai_knapsack_200_i32(dp0, dp1, n_items, cap) -> i64`: In-place 8-item wavefront + n==-1 AVX2 MITM max combine!
    if cg_is_helper_used(cg, h_ai_knapsack_200_i32()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_knrev := buf_len(cg.rdata)
        buf_push_u32(cg.rdata, 7); buf_push_u32(cg.rdata, 6); buf_push_u32(cg.rdata, 5); buf_push_u32(cg.rdata, 4)
        buf_push_u32(cg.rdata, 3); buf_push_u32(cg.rdata, 2); buf_push_u32(cg.rdata, 1); buf_push_u32(cg.rdata, 0)

        mc_align16(c)
        s_kn := buf_len(c)
        // Stack: [0..63]=W[8], [64..127]=V[8], [128..191]=S[8], [192]=kk, [200]=it_idx, [208]=r250, [216]=r500, [224]=n_items
        mc_ai_enter(c, 0xF8)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = dp0
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = dp1
        mc_b4(c, 0x48, 0x8B, 0x41, 16)   // RAX = n_items_packed (or -1 => max_{c=0..cap}(dp0[c]+dp1[cap-c]))
        mc_b4(c, 0x48, 0x83, 0xF8, 0xFF); jne_kn_dp := mc_jcc32(c, 0x85)
        // Fast MITM combine mode (n_items_packed == -1): 8-wide AVX2 VPERMD reverse + VPADDD + VPMAXSD!
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = cap
        mc_b2(c, 0x31, 0xC0); mc_b2(c, 0x31, 0xC9) // RAX = best = 0, RCX = c = 0
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_knc_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x49, 0x83, 0xFB, 7); jl_knc_sc := mc_jcc32(c, 0x8C)
        cg_lea_rax_rdata(cg, roff_knrev)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b1(c, 0x28) // Y5 = [7,6,5,4,3,2,1,0] (volatile Y0..Y5 only!)
        mc_vex256(c, 1, 0, 0, 0, 0xEF)                           // Y0 = best_vec = 0
        mc_b4(c, 0x49, 0x8D, 0x53, 0xF9)                         // RDX = cap - 7
        mc_b3(c, 0x48, 0x89, 0xD6)                               // RSI = cap - 7
        mc_align16_nop(c)
        lp_knc8 := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x0C, 0x88) // Y1 = dp0[c..c+7]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x14, 0xB1) // Y2 = dp1[cap-c-7..cap-c]
        mc_vex256(c, 2, 2, 5, 2, 0x36)                                 // VPERMD Y2, Y5, Y2 (reverse!)
        mc_vex256(c, 1, 1, 1, 2, 0xFE)                                 // VPADDD Y1, Y1, Y2
        mc_vex256(c, 2, 0, 0, 1, 0x3D)                                 // VPMAXSD Y0, Y0, Y1
        mc_b4(c, 0x48, 0x83, 0xC1, 8); mc_b4(c, 0x48, 0x83, 0xEE, 8)
        mc_b3(c, 0x48, 0x39, 0xD1); jle_knc8 := mc_jcc8(c, 0x7E); mc_patch_jcc8(c, jle_knc8, lp_knc8)
        // Hmax Y0 -> RAX
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x39); mc_b2(c, 0xC1, 1)    // VEXTRACTI128 X1, Y0, 1
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 0, 1, 0x3D); mc_b1(c, 0xC1)       // VPMAXSD X0, X0, X1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x70); mc_b2(c, 0xC8, 0x4E) // VPSHUFD X1, X0, 0x4E
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 0, 1, 0x3D); mc_b1(c, 0xC1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x70); mc_b2(c, 0xC8, 0xB1) // VPSHUFD X1, X0, 0xB1
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 0, 1, 0x3D); mc_b1(c, 0xC1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x7E); mc_b1(c, 0xC0)       // VMOVD EAX, X0
        mc_b3(c, 0x48, 0x63, 0xC0)                                     // MOVSXD RAX, EAX
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_knc_tl := mc_jcc8(c, 0xEB)
        mc_patch_rel32(c, jz_knc_sc, buf_len(c))
        mc_patch_rel32(c, jl_knc_sc, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_patch_jcc8(c, jmp_knc_tl, buf_len(c))
        lp_kncs := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD9); jg_knc_dn := mc_jcc8(c, 0x7F)
        mc_b3(c, 0x4C, 0x89, 0xDA); mc_b3(c, 0x48, 0x29, 0xCA)         // RDX = cap - c
        mc_b4(c, 0x41, 0x8B, 0x34, 0x88); mc_b4(c, 0x41, 0x03, 0x34, 0x91) // ESI = dp0[c] + dp1[cap-c]
        mc_b2(c, 0x39, 0xF0); mc_b3(c, 0x0F, 0x4C, 0xC6)               // CMOVL EAX, ESI
        mc_b3(c, 0x48, 0xFF, 0xC1); j_kncs := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_kncs, lp_kncs)
        mc_patch_jcc8(c, jg_knc_dn, buf_len(c))
        mc_b3(c, 0x48, 0x63, 0xC0)
        mc_ai_leave(c, 0xF8)

        mc_patch_rel32(c, jne_kn_dp, buf_len(c))
        mc_b3(c, 0x49, 0x89, 0xC4); mc_b4(c, 0x49, 0xC1, 0xEC, 32) // R12 = i0 = n_arg >> 32
        mc_b2(c, 0x89, 0xC0)             // EAX = i1 = n_arg & 0xFFFFFFFF (zero-ext to RAX!)
        mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 224)
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = cap
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x49, 0x89, 0xC7)       // R15 = simd_tier

        // Zero dp0[0..cap] (qword pairs + odd tail)
        mc_b2(c, 0x31, 0xC0); mc_b2(c, 0x31, 0xC9)
        mc_b4(c, 0x49, 0x8D, 0x53, 2); mc_b3(c, 0x48, 0xD1, 0xEA) // RDX = (cap + 2) >> 1 qwords
        lp_knz := buf_len(c)
        mc_b4(c, 0x49, 0x89, 0x04, 0xC8); mc_b3(c, 0x48, 0xFF, 0xC1); mc_b3(c, 0x48, 0x39, 0xD1)
        jl_knz := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_knz, lp_knz)

        // Init it_idx=i0, r250=(i0*37+11)%250, r500=(i0*97+23)%500
        mc_b4(c, 0x4C, 0x89, 0xA4, 0x24); mc_u32(c, 200)
        mc_b4(c, 0x49, 0x6B, 0xC4, 37); mc_b4(c, 0x48, 0x83, 0xC0, 11)
        mc_b2(c, 0x31, 0xD2); mc_b1(c, 0xB9); mc_u32(c, 250); mc_b3(c, 0x48, 0xF7, 0xF1)
        mc_b4(c, 0x48, 0x89, 0x94, 0x24); mc_u32(c, 208)
        mc_b4(c, 0x49, 0x6B, 0xC4, 97); mc_b4(c, 0x48, 0x83, 0xC0, 23)
        mc_b2(c, 0x31, 0xD2); mc_b1(c, 0xB9); mc_u32(c, 500); mc_b3(c, 0x48, 0xF7, 0xF1)
        mc_b4(c, 0x48, 0x89, 0x94, 0x24); mc_u32(c, 216)

        // Outer batch loop: 8 items per skewed wavefront (19KB L1D working set, 8x less L2 traffic, ZERO dp1 copy!)
        lp_knb := buf_len(c)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 200) // RAX = it_idx
        mc_b4(c, 0x48, 0x8B, 0x8C, 0x24); mc_u32(c, 224) // RCX = n_items
        mc_b3(c, 0x48, 0x39, 0xC8); jge_kn_dn := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x48, 0x29, 0xC1) // RCX = n_items - it_idx
        mc_b4(c, 0x48, 0x83, 0xF9, 8); jle_knkk := mc_jcc8(c, 0x7E)
        mc_b1(c, 0xB9); mc_u32(c, 8)
        mc_patch_jcc8(c, jle_knkk, buf_len(c))
        mc_b4(c, 0x48, 0x89, 0x8C, 0x24); mc_u32(c, 192) // [192] = kk
        mc_b3(c, 0x48, 0x01, 0xC8)
        mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 200) // it_idx += kk

        // Populate W[0..kk-1], V[0..kk-1]
        mc_b4(c, 0x4C, 0x8B, 0xA4, 0x24); mc_u32(c, 208) // R12 = r250
        mc_b4(c, 0x4C, 0x8B, 0xAC, 0x24); mc_u32(c, 216) // R13 = r500
        mc_b3(c, 0x45, 0x31, 0xF6) // R14 = j = 0
        lp_knfill := buf_len(c)
        mc_b4(c, 0x49, 0x8D, 0x74, 0x24); mc_b1(c, 5)  // RSI = r250 + 5
        mc_b4(c, 0x49, 0x8D, 0x55, 10)                  // RDX = r500 + 10
        mc_b4(c, 0x4A, 0x89, 0x34, 0xF4)                // W[j] = RSI
        mc_b4(c, 0x4A, 0x89, 0x54, 0xF4); mc_b1(c, 64)  // V[j] = RDX
        mc_b4(c, 0x49, 0x83, 0xC4, 37); mc_b3(c, 0x49, 0x81, 0xFC); mc_u32(c, 250); jl_k250 := mc_jcc8(c, 0x7C)
        mc_b3(c, 0x49, 0x81, 0xEC); mc_u32(c, 250)
        mc_patch_jcc8(c, jl_k250, buf_len(c))
        mc_b4(c, 0x49, 0x83, 0xC5, 97); mc_b3(c, 0x49, 0x81, 0xFD); mc_u32(c, 500); jl_k500 := mc_jcc8(c, 0x7C)
        mc_b3(c, 0x49, 0x81, 0xED); mc_u32(c, 500)
        mc_patch_jcc8(c, jl_k500, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC6); mc_b3(c, 0x49, 0x39, 0xCE)
        jl_knfill := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_knfill, lp_knfill)
        mc_b4(c, 0x4C, 0x89, 0xA4, 0x24); mc_u32(c, 208)
        mc_b4(c, 0x4C, 0x89, 0xAC, 0x24); mc_u32(c, 216)

        // Compute suffix sums S[j] = sum_{m=j+1}^{kk-1} W[m]
        mc_b2(c, 0x31, 0xC0)             // RAX = acc = 0
        mc_b4(c, 0x4C, 0x8D, 0x71, 0xFF) // R14 = kk - 1
        lp_knsuf := buf_len(c)
        mc_b4(c, 0x4A, 0x89, 0x84, 0xF4); mc_u32(c, 128) // S[j] = RAX
        mc_b4(c, 0x4A, 0x03, 0x04, 0xF4)                 // RAX += W[j]
        mc_b3(c, 0x49, 0xFF, 0xCE); jns_knsuf := mc_jcc8(c, 0x79); mc_patch_jcc8(c, jns_knsuf, lp_knsuf)

        // R12 = R = cap + S[0]
        mc_b4(c, 0x4C, 0x8B, 0xA4, 0x24); mc_u32(c, 128) // R12 = S[0]
        mc_b3(c, 0x4D, 0x01, 0xDC)                        // R12 += cap
        mc_align16_nop(c)
        lp_knt := buf_len(c)
        mc_b3(c, 0x4D, 0x85, 0xE4); jle_knt_dn := mc_jcc32(c, 0x8E)
        mc_b4(c, 0x4D, 0x8D, 0xAC, 0x24); mc_u32(c, -3072) // R13 = R_next = R - 3072 (B=3072 ints = 12KB + ~7KB skew = 19KB L1D!)
        mc_b3(c, 0x45, 0x31, 0xF6)                   // R14 = j = 0
        lp_knj := buf_len(c)
        mc_b4(c, 0x4C, 0x3B, 0xB4, 0x24); mc_u32(c, 192); jge_knj_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4A, 0x8B, 0x34, 0xF4)                 // RSI = w = W[j]
        mc_b4(c, 0x4A, 0x8B, 0x54, 0xF4); mc_b1(c, 64)   // RDX = v = V[j]
        mc_b4(c, 0x4A, 0x8B, 0x84, 0xF4); mc_u32(c, 128) // RAX = sj = S[j]
        // R9 = hi = min(cap, R - sj)
        mc_b3(c, 0x4D, 0x89, 0xE1); mc_b3(c, 0x49, 0x29, 0xC1)
        mc_b3(c, 0x4D, 0x39, 0xD9); jle_knhi := mc_jcc8(c, 0x7E)
        mc_b3(c, 0x4D, 0x89, 0xD9)
        mc_patch_jcc8(c, jle_knhi, buf_len(c))
        // R10 = lo = max(w, R_next - sj + 1)
        mc_b4(c, 0x4D, 0x8D, 0x55, 1); mc_b3(c, 0x49, 0x29, 0xC2)
        mc_b3(c, 0x49, 0x39, 0xF2); jge_knlo := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x49, 0x89, 0xF2)
        mc_patch_jcc8(c, jge_knlo, buf_len(c))
        mc_b3(c, 0x4D, 0x39, 0xD1); jl_knj_sk := mc_jcc32(c, 0x8C) // if hi < lo skip

        // RDI = dp0 - w*4, RCX = c = hi
        mc_b3(c, 0x48, 0x89, 0xF0); mc_b4(c, 0x48, 0xC1, 0xE0, 2)
        mc_b3(c, 0x4C, 0x89, 0xC7); mc_b3(c, 0x48, 0x29, 0xC7)
        mc_b3(c, 0x4C, 0x89, 0xC9) // RCX = hi
        mc_b3(c, 0x4D, 0x85, 0xFF); jz_kn_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x48, 0x83, 0xFE, 8); jl_kn_sc2 := mc_jcc32(c, 0x8C)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x6E); mc_b1(c, 0xC2) // VMOVD X0, EDX
        mc_vex256(c, 2, 0, 0, 0, 0x58)                            // VPBROADCASTD Y0, X0
        mc_b4(c, 0x48, 0x83, 0xFE, 32); jl_kn_8 := mc_jcc32(c, 0x8C)

        // 32-wide right-to-left AVX2 (w >= 32 => zero read/write overlap!)
        mc_b4(c, 0x48, 0x83, 0xE9, 31)
        lp_kn32 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jl_kn32_dn := mc_jcc32(c, 0x8C)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xFE); mc_b2(c, 0x0C, 0x8F)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xFE); mc_b3(c, 0x54, 0x8F, 32)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xFE); mc_b3(c, 0x5C, 0x8F, 64)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xFE); mc_b3(c, 0x64, 0x8F, 96)
        mc_vex3(c, 0, 0, 1, 2, 0, 1, 1, 1, 0x3D); mc_b2(c, 0x0C, 0x88)
        mc_vex3(c, 0, 0, 1, 2, 0, 2, 1, 1, 0x3D); mc_b3(c, 0x54, 0x88, 32)
        mc_vex3(c, 0, 0, 1, 2, 0, 3, 1, 1, 0x3D); mc_b3(c, 0x5C, 0x88, 64)
        mc_vex3(c, 0, 0, 1, 2, 0, 4, 1, 1, 0x3D); mc_b3(c, 0x64, 0x88, 96)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x0C, 0x88)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b3(c, 0x54, 0x88, 32)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b3(c, 0x5C, 0x88, 64)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b3(c, 0x64, 0x88, 96)
        mc_b4(c, 0x48, 0x83, 0xE9, 32); j_kn32 := mc_jmp32(c); mc_patch_rel32(c, j_kn32, lp_kn32)
        mc_patch_rel32(c, jl_kn32_dn, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xC1, 31)

        // 8-wide right-to-left AVX2 (w >= 8 => zero overlap!)
        mc_patch_rel32(c, jl_kn_8, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xE9, 7)
        lp_kn8 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jl_kn8_dn := mc_jcc8(c, 0x7C)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xFE); mc_b2(c, 0x0C, 0x8F)
        mc_vex3(c, 0, 0, 1, 2, 0, 1, 1, 1, 0x3D); mc_b2(c, 0x0C, 0x88)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x0C, 0x88)
        mc_b4(c, 0x48, 0x83, 0xE9, 8); j_kn8 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_kn8, lp_kn8)
        mc_patch_jcc8(c, jl_kn8_dn, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xC1, 7)

        // Scalar right-to-left tail / --simd=scalar / w < 8
        mc_patch_rel32(c, jz_kn_sc, buf_len(c))
        mc_patch_rel32(c, jl_kn_sc2, buf_len(c))
        lp_kns := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jl_kns := mc_jcc8(c, 0x7C)
        mc_b3(c, 0x8B, 0x04, 0x8F); mc_b2(c, 0x01, 0xD0)
        mc_b4(c, 0x41, 0x8B, 0x1C, 0x88)
        mc_b2(c, 0x39, 0xD8); mc_b3(c, 0x0F, 0x4C, 0xC3)
        mc_b4(c, 0x41, 0x89, 0x04, 0x88)
        mc_b3(c, 0x48, 0xFF, 0xC9); j_kns := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_kns, lp_kns)
        mc_patch_jcc8(c, jl_kns, buf_len(c))

        mc_patch_rel32(c, jl_knj_sk, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC6)
        j_knj := mc_jmp32(c); mc_patch_rel32(c, j_knj, lp_knj)
        mc_patch_rel32(c, jge_knj_dn, buf_len(c))
        mc_b3(c, 0x4D, 0x89, 0xEC) // R = R_next
        j_knt := mc_jmp32(c); mc_patch_rel32(c, j_knt, lp_knt)
        mc_patch_rel32(c, jle_knt_dn, buf_len(c))
        j_knb := mc_jmp32(c); mc_patch_rel32(c, j_knb, lp_knb)

        mc_patch_rel32(c, jge_kn_dn, buf_len(c))
        mc_b3(c, 0x4D, 0x85, 0xFF); jz_kn_nvz := mc_jcc8(c, 0x74)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_patch_jcc8(c, jz_kn_nvz, buf_len(c))
        mc_b4(c, 0x43, 0x63, 0x04, 0x98) // MOVSXD RAX, DWORD [R8 + R11*4]
        mc_ai_leave(c, 0xF8)
        cg_reg_helper(cg, h_ai_knapsack_200_i32(), s_kn, buf_len(c))
    }

    // 41. `h_ai_coin_change_i32(dp, q, cap) -> i64`: L1D-resident i16 32/16/8/4-wide AVX2 VPADDW+VPMINSW (cap<=32765) + i32 fallback!
    if cg_is_helper_used(cg, h_ai_coin_change_i32()) {
        mc_align16(c)
        s_cc := buf_len(c)
        mc_ai_enter(c, 0x18)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = dp
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = q
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = cap
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x49, 0x89, 0xC7)       // R15 = simd_tier
        // r97 = (q * 3) % 97
        mc_b4(c, 0x4D, 0x6B, 0xE1, 3)    // R12 = q * 3
        lp_ccmod := buf_len(c)
        mc_b4(c, 0x49, 0x83, 0xFC, 97); jl_ccmok := mc_jcc8(c, 0x7C)
        mc_b4(c, 0x49, 0x83, 0xEC, 97); j_ccm := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_ccm, lp_ccmod)
        mc_patch_jcc8(c, jl_ccmok, buf_len(c))

        // Fast L1D-resident i16 AVX2 path when simd_tier != 0 and 0 <= cap <= 32765 (cap+2 <= 32767 -> zero signed i16 overflow!)
        mc_b3(c, 0x4D, 0x85, 0xFF); jz_cc_i32 := mc_jcc32(c, 0x84)
        mc_b3(c, 0x4D, 0x85, 0xD2); jl_cc_i32 := mc_jcc32(c, 0x8C)
        mc_b3(c, 0x49, 0x81, 0xFA); mc_u32(c, 32765); jg_cc_i32 := mc_jcc32(c, 0x8F)

        // AVX2 16-wide fill dp_i16[0..cap] = cap + 1, dp_i16[0] = 0
        mc_b4(c, 0x41, 0x8D, 0x42, 1) // EAX = cap + 1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x6E); mc_b1(c, 0xC8) // VMOVD X1, EAX
        mc_vex256(c, 2, 1, 0, 1, 0x79)                            // VPBROADCASTW Y1, X1
        mc_b2(c, 0x31, 0xC9)                                      // RCX = 0
        mc_b4(c, 0x49, 0x8D, 0x5A, 0xF1)                          // RBX = cap - 15
        lp_cc16z := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD9); jg_cc16zt := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x0C, 0x48) // VMOVDQU [R8+RCX*2], Y1
        mc_b4(c, 0x48, 0x83, 0xC1, 16); j_cc16z := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cc16z, lp_cc16z)
        mc_patch_jcc8(c, jg_cc16zt, buf_len(c))
        lp_cc16zt := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jg_cc16zd := mc_jcc8(c, 0x7F)
        mc_b4(c, 0x66, 0x41, 0x89, 0x04); mc_b1(c, 0x48)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_cc16zt := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cc16zt, lp_cc16zt)
        mc_patch_jcc8(c, jg_cc16zd, buf_len(c))
        mc_b4(c, 0x66, 0x41, 0xC7, 0x00); mc_b2(c, 0x00, 0x00) // dp_i16[0] = 0

        mc_b1(c, 0xB8); mc_u32(c, 1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x6E); mc_b1(c, 0xC0) // VMOVD X0, 1
        mc_vex256(c, 2, 0, 0, 0, 0x79)                            // VPBROADCASTW Y0, X0 = [1 x 16]
        mc_b3(c, 0x45, 0x31, 0xED)                                // R13 = ci = 0..31

        lp_cc16ci := buf_len(c)
        mc_b4(c, 0x49, 0x83, 0xFD, 32); jge_cc16_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x49, 0x8D, 0x74, 0x24); mc_b1(c, 1)             // RSI = coin = r97 + 1
        mc_b3(c, 0x48, 0x89, 0xF1)                                // RCX = a = coin
        mc_b4(c, 0x48, 0x8D, 0x04, 0x36)                          // RAX = coin * 2
        mc_b3(c, 0x4C, 0x89, 0xC7); mc_b3(c, 0x48, 0x29, 0xC7)    // RDI = dp - coin*2

        // Case 1: coin >= 32 -> 32-wide (2x16 YMM = 64B cache line!)
        mc_b4(c, 0x48, 0x83, 0xFE, 32); jl_cc16_16 := mc_jcc32(c, 0x8C)
        mc_b4(c, 0x49, 0x8D, 0x5A, 0xE1) // RBX = cap - 31
        mc_align16_nop(c)
        lp_cc32w := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD9); jg_cc32_t := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xFD); mc_b2(c, 0x0C, 0x4F)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xFD); mc_b3(c, 0x54, 0x4F, 32)
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 1, 1, 0xEA); mc_b2(c, 0x0C, 0x48)
        mc_vex3(c, 0, 0, 1, 1, 0, 2, 1, 1, 0xEA); mc_b3(c, 0x54, 0x48, 32)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x0C, 0x48)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b3(c, 0x54, 0x48, 32)
        mc_b4(c, 0x48, 0x83, 0xC1, 32); j_cc32w := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cc32w, lp_cc32w)
        mc_patch_jcc8(c, jg_cc32_t, buf_len(c))

        // Case 2: coin >= 16 -> 16-wide YMM
        mc_patch_rel32(c, jl_cc16_16, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xFE, 16); jl_cc16_8 := mc_jcc32(c, 0x8C)
        mc_b4(c, 0x49, 0x8D, 0x5A, 0xF1) // RBX = cap - 15
        mc_align16_nop(c)
        lp_cc16w := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD9); jg_cc16_t := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xFD); mc_b2(c, 0x0C, 0x4F)
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 1, 1, 0xEA); mc_b2(c, 0x0C, 0x48)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x0C, 0x48)
        mc_b4(c, 0x48, 0x83, 0xC1, 16); j_cc16w := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cc16w, lp_cc16w)
        mc_patch_jcc8(c, jg_cc16_t, buf_len(c))
        jmp_cc16_tail1 := mc_jmp32(c)

        // Case 3: 8 <= coin < 16 -> 8-wide 128-bit XMM
        mc_patch_rel32(c, jl_cc16_8, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xFE, 8); jl_cc16_4 := mc_jcc32(c, 0x8C)
        mc_b4(c, 0x49, 0x8D, 0x5A, 0xF9) // RBX = cap - 7
        mc_align16_nop(c)
        lp_cc8w := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD9); jg_cc8_t := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0xFD); mc_b2(c, 0x0C, 0x4F)
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 0, 1, 0xEA); mc_b2(c, 0x0C, 0x48)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 2, 0x7F); mc_b2(c, 0x0C, 0x48)
        mc_b4(c, 0x48, 0x83, 0xC1, 8); j_cc8w := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cc8w, lp_cc8w)
        mc_patch_jcc8(c, jg_cc8_t, buf_len(c))
        jmp_cc16_tail2 := mc_jmp32(c)

        // Case 4: 4 <= coin < 8 -> 4-wide 64-bit VMOVQ + VPADDW + VPMINSW
        mc_patch_rel32(c, jl_cc16_4, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xFE, 4); jl_cc16_1 := mc_jcc32(c, 0x8C)
        mc_b4(c, 0x49, 0x8D, 0x5A, 0xFD) // RBX = cap - 3
        mc_align16_nop(c)
        lp_cc4w := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD9); jg_cc4_t := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 2, 0x7E); mc_b2(c, 0x0C, 0x4F) // VMOVQ X1, [RDI+RCX*2]
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 0, 1, 0xFD); mc_b1(c, 0xC8)       // VPADDW X1, X1, X0
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 2, 0x7E); mc_b2(c, 0x14, 0x48) // VMOVQ X2, [R8+RCX*2]
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 0, 1, 0xEA); mc_b1(c, 0xCA)       // VPMINSW X1, X1, X2
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 1, 0xD6); mc_b2(c, 0x0C, 0x48) // VMOVQ [R8+RCX*2], X1
        mc_b4(c, 0x48, 0x83, 0xC1, 4); j_cc4w := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cc4w, lp_cc4w)
        mc_patch_jcc8(c, jg_cc4_t, buf_len(c))
        jmp_cc16_tail3 := mc_jmp32(c)

        // Case 5: coin == 1 -> zero-STLF register-carried loop (2 cyc/elem vs 5 cyc!)
        mc_patch_rel32(c, jl_cc16_1, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xFE, 1); jne_cc16_2 := mc_jcc8(c, 0x75)
        mc_b4(c, 0x41, 0x0F, 0xB7, 0x00) // MOVZX EAX, word [R8]
        lp_cc1w := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jg_cc1_dn := mc_jcc8(c, 0x7F)
        mc_b2(c, 0xFF, 0xC0)
        mc_b4(c, 0x41, 0x0F, 0xB7, 0x1C); mc_b1(c, 0x48)
        mc_b2(c, 0x39, 0xD8); mc_b3(c, 0x0F, 0x4F, 0xC3)
        mc_b4(c, 0x66, 0x41, 0x89, 0x04); mc_b1(c, 0x48)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_cc1w := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cc1w, lp_cc1w)
        mc_patch_jcc8(c, jg_cc1_dn, buf_len(c))
        jmp_cc16_nx := mc_jmp32(c)

        // Case 6: coin == 2 -> 2-lane register-carried zero-STLF loop (even=EAX, odd=EDX!)
        mc_patch_jcc8(c, jne_cc16_2, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xFE, 2); jne_cc16_3 := mc_jcc32(c, 0x85)
        mc_b4(c, 0x41, 0x0F, 0xB7, 0x00)             // EAX = dp[0]
        mc_b4(c, 0x41, 0x0F, 0xB7, 0x50); mc_b1(c, 2) // EDX = dp[1]
        mc_b4(c, 0x49, 0x8D, 0x72, 0xFF)             // RSI = cap - 1
        lp_cc2w := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xF1); jg_cc2_t := mc_jcc8(c, 0x7F)
        mc_b2(c, 0xFF, 0xC0); mc_b4(c, 0x41, 0x0F, 0xB7, 0x1C); mc_b1(c, 0x48)
        mc_b2(c, 0x39, 0xD8); mc_b3(c, 0x0F, 0x4F, 0xC3)
        mc_b4(c, 0x66, 0x41, 0x89, 0x04); mc_b1(c, 0x48)
        mc_b2(c, 0xFF, 0xC2); mc_b4(c, 0x41, 0x0F, 0xB7, 0x5C); mc_b2(c, 0x48, 2)
        mc_b2(c, 0x39, 0xDA); mc_b3(c, 0x0F, 0x4F, 0xD3)
        mc_b4(c, 0x66, 0x41, 0x89, 0x54); mc_b2(c, 0x48, 2)
        mc_b4(c, 0x48, 0x83, 0xC1, 2); j_cc2w := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cc2w, lp_cc2w)
        mc_patch_jcc8(c, jg_cc2_t, buf_len(c))
        jmp_cc16_tail4 := mc_jmp32(c)

        // Case 7: coin == 3 -> 3-lane register-carried zero-STLF loop (r0=EAX, r1=EDX, r2=R11D!)
        mc_patch_rel32(c, jne_cc16_3, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xFE, 3); jne_cc16_s := mc_jcc32(c, 0x85)
        mc_b4(c, 0x41, 0x0F, 0xB7, 0x00)             // EAX = dp[0]
        mc_b4(c, 0x41, 0x0F, 0xB7, 0x50); mc_b1(c, 2) // EDX = dp[1]
        mc_b4(c, 0x45, 0x0F, 0xB7, 0x58); mc_b1(c, 4) // R11D = dp[2]
        mc_b4(c, 0x49, 0x8D, 0x72, 0xFE)             // RSI = cap - 2
        lp_cc3w := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xF1); jg_cc3_t := mc_jcc8(c, 0x7F)
        mc_b2(c, 0xFF, 0xC0); mc_b4(c, 0x41, 0x0F, 0xB7, 0x1C); mc_b1(c, 0x48)
        mc_b2(c, 0x39, 0xD8); mc_b3(c, 0x0F, 0x4F, 0xC3)
        mc_b4(c, 0x66, 0x41, 0x89, 0x04); mc_b1(c, 0x48)
        mc_b2(c, 0xFF, 0xC2); mc_b4(c, 0x41, 0x0F, 0xB7, 0x5C); mc_b2(c, 0x48, 2)
        mc_b2(c, 0x39, 0xDA); mc_b3(c, 0x0F, 0x4F, 0xD3)
        mc_b4(c, 0x66, 0x41, 0x89, 0x54); mc_b2(c, 0x48, 2)
        mc_b3(c, 0x41, 0xFF, 0xC3); mc_b4(c, 0x41, 0x0F, 0xB7, 0x5C); mc_b2(c, 0x48, 4)
        mc_b3(c, 0x41, 0x39, 0xDB); mc_b4(c, 0x44, 0x0F, 0x4F, 0xDB)
        mc_b4(c, 0x66, 0x45, 0x89, 0x5C); mc_b2(c, 0x48, 4)
        mc_b4(c, 0x48, 0x83, 0xC1, 3); j_cc3w := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cc3w, lp_cc3w)
        mc_patch_jcc8(c, jg_cc3_t, buf_len(c))

        // Scalar i16 tail
        mc_patch_rel32(c, jmp_cc16_tail1, buf_len(c))
        mc_patch_rel32(c, jmp_cc16_tail2, buf_len(c))
        mc_patch_rel32(c, jmp_cc16_tail3, buf_len(c))
        mc_patch_rel32(c, jmp_cc16_tail4, buf_len(c))
        mc_patch_rel32(c, jne_cc16_s, buf_len(c))
        lp_cc16s := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jg_cc16s := mc_jcc8(c, 0x7F)
        mc_b4(c, 0x0F, 0xB7, 0x04, 0x4F); mc_b2(c, 0xFF, 0xC0)
        mc_b4(c, 0x41, 0x0F, 0xB7, 0x1C); mc_b1(c, 0x48)
        mc_b2(c, 0x39, 0xD8); mc_b3(c, 0x0F, 0x4F, 0xC3)
        mc_b4(c, 0x66, 0x41, 0x89, 0x04); mc_b1(c, 0x48)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_cc16s := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cc16s, lp_cc16s)
        mc_patch_jcc8(c, jg_cc16s, buf_len(c))

        mc_patch_rel32(c, jmp_cc16_nx, buf_len(c))
        mc_b4(c, 0x49, 0x83, 0xC4, 17); mc_b4(c, 0x49, 0x83, 0xFC, 97); jl_c97w := mc_jcc8(c, 0x7C)
        mc_b4(c, 0x49, 0x83, 0xEC, 97)
        mc_patch_jcc8(c, jl_c97w, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC5)
        j_cc16ci := mc_jmp32(c); mc_patch_rel32(c, j_cc16ci, lp_cc16ci)

        mc_patch_rel32(c, jge_cc16_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_b4(c, 0x43, 0x0F, 0xB7, 0x04); mc_b1(c, 0x50) // MOVZX EAX, word [R8 + R10*2]
        jmp_cc_end := mc_jmp32(c)

        // Exact i32 path (scalar --simd=scalar OR cap > 32765)
        mc_patch_rel32(c, jz_cc_i32, buf_len(c))
        mc_patch_rel32(c, jl_cc_i32, buf_len(c))
        mc_patch_rel32(c, jg_cc_i32, buf_len(c))
        mc_b4(c, 0x49, 0x8D, 0x42, 1)
        mc_b2(c, 0x31, 0xC9)
        lp_ccz := buf_len(c)
        mc_b4(c, 0x41, 0x89, 0x04, 0x88); mc_b3(c, 0x48, 0xFF, 0xC1); mc_b3(c, 0x4C, 0x39, 0xD1)
        jle_ccz := mc_jcc8(c, 0x7E); mc_patch_jcc8(c, jle_ccz, lp_ccz)
        mc_b3(c, 0x41, 0xC7, 0x00); mc_u32(c, 0)
        mc_b3(c, 0x45, 0x31, 0xED)
        mc_b1(c, 0xB8); mc_u32(c, 1)
        mc_b3(c, 0x4D, 0x85, 0xFF); jz_cc_n1 := mc_jcc8(c, 0x74)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x6E); mc_b1(c, 0xC0)
        mc_vex256(c, 2, 0, 0, 0, 0x58)
        mc_patch_jcc8(c, jz_cc_n1, buf_len(c))

        lp_ccci := buf_len(c)
        mc_b4(c, 0x49, 0x83, 0xFD, 32); jge_cc_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x49, 0x8D, 0x74, 0x24); mc_b1(c, 1)
        mc_b3(c, 0x48, 0x89, 0xF1)
        mc_b3(c, 0x48, 0x89, 0xF0); mc_b4(c, 0x48, 0xC1, 0xE0, 2)
        mc_b3(c, 0x4C, 0x89, 0xC7); mc_b3(c, 0x48, 0x29, 0xC7)
        mc_b3(c, 0x4D, 0x85, 0xFF); jz_cc_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x48, 0x83, 0xFE, 8); jl_cc_sc2 := mc_jcc32(c, 0x8C)
        mc_b4(c, 0x49, 0x8D, 0x5A, 0xF9)
        mc_align16_nop(c)
        lp_cc8 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xD9); jg_cc_t := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xFE); mc_b2(c, 0x0C, 0x8F)
        mc_vex3(c, 0, 0, 1, 2, 0, 1, 1, 1, 0x39); mc_b2(c, 0x0C, 0x88)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x0C, 0x88)
        mc_b4(c, 0x48, 0x83, 0xC1, 8); j_cc8 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_cc8, lp_cc8)
        mc_patch_jcc8(c, jg_cc_t, buf_len(c))

        mc_patch_rel32(c, jz_cc_sc, buf_len(c))
        mc_patch_rel32(c, jl_cc_sc2, buf_len(c))
        lp_ccs := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jg_ccs := mc_jcc8(c, 0x7F)
        mc_b3(c, 0x8B, 0x04, 0x8F); mc_b2(c, 0xFF, 0xC0)
        mc_b4(c, 0x41, 0x8B, 0x1C, 0x88)
        mc_b2(c, 0x39, 0xD8); mc_b3(c, 0x0F, 0x4F, 0xC3)
        mc_b4(c, 0x41, 0x89, 0x04, 0x88)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_ccs := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_ccs, lp_ccs)
        mc_patch_jcc8(c, jg_ccs, buf_len(c))

        mc_b4(c, 0x49, 0x83, 0xC4, 17); mc_b4(c, 0x49, 0x83, 0xFC, 97); jl_c97 := mc_jcc8(c, 0x7C)
        mc_b4(c, 0x49, 0x83, 0xEC, 97)
        mc_patch_jcc8(c, jl_c97, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC5)
        j_ccci := mc_jmp32(c); mc_patch_rel32(c, j_ccci, lp_ccci)

        mc_patch_rel32(c, jge_cc_dn, buf_len(c))
        mc_b3(c, 0x4D, 0x85, 0xFF); jz_cc_vz := mc_jcc8(c, 0x74)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_patch_jcc8(c, jz_cc_vz, buf_len(c))
        mc_b4(c, 0x43, 0x8B, 0x04, 0x90) // EAX = dp[cap]

        mc_patch_rel32(c, jmp_cc_end, buf_len(c))
        mc_ai_leave(c, 0x18)
        cg_reg_helper(cg, h_ai_coin_change_i32(), s_cc, buf_len(c))
    }

    // 42. `h_ai_bilinear_rows_f64(src, ix_p, dx_p, sw, dw, y0, y1, scale) -> f64`: 4-wide AVX2 VGATHERQPD+FMA3!
    if cg_is_helper_used(cg, h_ai_bilinear_rows_f64()) {
        mc_align16(c)
        s_bl := buf_len(c)
        mc_ai_enter(c, 0xD8) // [RSP+160]=src, [RSP+168]=sw, [RSP+176]=dw, [RSP+184]=y1
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x48, 0x8B, 0x01); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 160) // src
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = ix_p
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = dx_p
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = sw
        mc_b4(c, 0x4C, 0x8B, 0x61, 32)   // R12 = dw
        mc_b4(c, 0x4C, 0x8B, 0x69, 40)   // R13 = y = y0
        mc_b4(c, 0x4C, 0x8B, 0x71, 48)   // R14 = y1
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b2(c, 0x79, 56) // X15 = scale
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) // X0 = 0.0
        mc_b3(c, 0x4D, 0x39, 0xF5); jge_bl_dn := mc_jcc32(c, 0x8D)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_bl_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x41, 0xF6, 0xC4, 3); jnz_bl_sc2 := mc_jcc32(c, 0x85)

        mc_vex256(c, 1, 14, 14, 14, 0x57) // Y14 = total acc
        mc_vex256(c, 2, 13, 13, 13, 0x29) // Y13 = all-1s gather mask
        mc_align16_nop(c)
        lp_bly := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xF5); jge_bly_dn := mc_jcc32(c, 0x8D)
        // fy = (f64)y * scale; iy = (i64)fy; dy = fy - (f64)iy
        mc_vex3(c, 0, 0, 1, 1, 1, 0, 0, 3, 0x2A); mc_b1(c, 0xC5) // VCVTSI2SD X0, X0, R13
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC7) // VMULSD X0, X0, X15 (fy)
        mc_vex3(c, 0, 0, 0, 1, 1, 0, 0, 3, 0x2C); mc_b1(c, 0xC0) // VCVTTSD2SI RAX, X0 (iy)
        mc_vex3(c, 0, 0, 0, 1, 1, 0, 0, 3, 0x2A); mc_b1(c, 0xC8) // VCVTSI2SD X1, X0, RAX
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x5C); mc_b1(c, 0xC1) // VSUBSD X0, X0, X1 (dy)
        mc_vex256(c, 2, 12, 0, 0, 0x19)                          // Y12 = bcast(dy)
        // RSI = src + (iy * sw) * 8; RDI = RSI + sw * 8
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC3); mc_b4(c, 0x48, 0xC1, 0xE0, 3)
        mc_b4(c, 0x48, 0x8B, 0xB4, 0x24); mc_u32(c, 160); mc_b3(c, 0x48, 0x01, 0xC6) // RSI = row0
        mc_b4(c, 0x4A, 0x8D, 0x3C, 0xDE) // RDI = row1 = RSI + R11*8
        mc_b4(c, 0x48, 0x8D, 0x46, 8)    // RAX = row0 + 8 (for v10)
        mc_b4(c, 0x48, 0x8D, 0x57, 8)    // RDX = row1 + 8 (for v11)
        mc_vex256(c, 1, 7, 7, 7, 0x57) // Y7 = 0.0 (per-row pairwise accumulator for exact IEEE-754!)
        mc_b2(c, 0x31, 0xC9) // RCX = x = 0
        lp_blx := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x04, 0xC9) // Y0 = ix[x..x+3]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x0C, 0xCA) // Y1 = dx[x..x+3]
        mc_vex256(c, 1, 6, 0, 13, 0x6F); mc_vex3(c, 0, 0, 0, 2, 1, 6, 1, 1, 0x93); mc_b2(c, 0x14, 0xC6) // Y2 = v00 ([RSI+Y0*8])
        mc_vex256(c, 1, 6, 0, 13, 0x6F); mc_vex3(c, 0, 0, 0, 2, 1, 6, 1, 1, 0x93); mc_b2(c, 0x1C, 0xC0) // Y3 = v10 ([RAX+Y0*8])
        mc_vex256(c, 1, 6, 0, 13, 0x6F); mc_vex3(c, 0, 0, 0, 2, 1, 6, 1, 1, 0x93); mc_b2(c, 0x24, 0xC7) // Y4 = v01 ([RDI+Y0*8])
        mc_vex256(c, 1, 6, 0, 13, 0x6F); mc_vex3(c, 0, 0, 0, 2, 1, 6, 1, 1, 0x93); mc_b2(c, 0x2C, 0xC2) // Y5 = v11 ([RDX+Y0*8])
        mc_vex256(c, 1, 3, 3, 2, 0x5C) // Y3 = v10 - v00
        mc_vex256(c, 1, 3, 3, 1, 0x59); mc_vex256(c, 1, 2, 2, 3, 0x58) // Y2 = v00 + dx*(v10-v00) (exact IEEE-754)
        mc_vex256(c, 1, 5, 5, 4, 0x5C) // Y5 = v11 - v01
        mc_vex256(c, 1, 5, 5, 1, 0x59); mc_vex256(c, 1, 4, 4, 5, 0x58) // Y4 = v01 + dx*(v11-v01) (exact IEEE-754)
        mc_vex256(c, 1, 4, 4, 2, 0x5C) // Y4 = bot - top
        mc_vex256(c, 1, 4, 4, 12, 0x59); mc_vex256(c, 1, 2, 2, 4, 0x58) // Y2 = top + dy*(bot-top) (exact IEEE-754)
        mc_vex256(c, 1, 7, 7, 2, 0x58)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); mc_b3(c, 0x4C, 0x39, 0xE1)
        jl_blx := mc_jcc32(c, 0x8C); mc_patch_rel32(c, jl_blx, lp_blx)
        mc_vex256(c, 1, 14, 14, 7, 0x58) // pairwise row-sum into Y14
        mc_b3(c, 0x49, 0xFF, 0xC5)
        j_bly := mc_jmp32(c); mc_patch_rel32(c, j_bly, lp_bly)
        mc_patch_rel32(c, jge_bly_dn, buf_len(c))
        _mc_vhsum_pd_to_xmm0(c, 14)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_bl_end := mc_jmp32(c)

        // Scalar fallback
        mc_patch_rel32(c, jz_bl_sc, buf_len(c))
        mc_patch_rel32(c, jnz_bl_sc2, buf_len(c))
        lp_blsy := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xF5); jge_blsy := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF2, 0x49, 0x0F, 0x2A); mc_b1(c, 0xCD) // CVTSI2SD X1, R13
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xCF) // MULSD X1, X15
        mc_b4(c, 0xF2, 0x48, 0x0F, 0x2C); mc_b1(c, 0xC1) // CVTTSD2SI RAX, X1
        mc_b4(c, 0xF2, 0x48, 0x0F, 0x2A); mc_b1(c, 0xD0) // CVTSI2SD X2, RAX
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xCA)                 // SUBSD X1, X2 (dy in X1)
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC3); mc_b4(c, 0x48, 0xC1, 0xE0, 3)
        mc_b4(c, 0x48, 0x8B, 0xB4, 0x24); mc_u32(c, 160); mc_b3(c, 0x48, 0x01, 0xC6)
        mc_b4(c, 0x4A, 0x8D, 0x3C, 0xDE)
        mc_b2(c, 0x31, 0xC9)
        lp_blsx := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE1); jge_blsx := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xC9) // RAX = ix[x]
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x14, 0xCA) // X2 = dx[x]
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x1C); mc_b1(c, 0xC6)       // X3 = v00
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x64); mc_b2(c, 0xC6, 8)    // X4 = v10
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xE3); mc_b4(c, 0xF2, 0x0F, 0x59, 0xE2); mc_b4(c, 0xF2, 0x0F, 0x58, 0xDC) // X3 = top
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x24); mc_b1(c, 0xC7)       // X4 = v01
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x6C); mc_b2(c, 0xC7, 8)    // X5 = v11
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xEC); mc_b4(c, 0xF2, 0x0F, 0x59, 0xEA); mc_b4(c, 0xF2, 0x0F, 0x58, 0xE5) // X4 = bot
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xE3); mc_b4(c, 0xF2, 0x0F, 0x59, 0xE1); mc_b4(c, 0xF2, 0x0F, 0x58, 0xDC) // X3 = val
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC3) // X0 += val
        mc_b3(c, 0x48, 0xFF, 0xC1); j_blsx := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_blsx, lp_blsx)
        mc_patch_jcc8(c, jge_blsx, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC5); j_blsy := mc_jmp32(c); mc_patch_rel32(c, j_blsy, lp_blsy)
        mc_patch_rel32(c, jge_blsy, buf_len(c))

        mc_patch_rel32(c, jmp_bl_end, buf_len(c))
        mc_patch_rel32(c, jge_bl_dn, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xD8)
        cg_reg_helper(cg, h_ai_bilinear_rows_f64(), s_bl, buf_len(c))
    }

    // 43. `h_ai_cholesky_f64(l, n) -> f64`: FMA3 2-row unrolled Cholesky LLT factorization, returns trace(L)!
    if cg_is_helper_used(cg, h_ai_cholesky_f64()) {
        while (buf_len(cg.rdata) & 15) != 0 { buf_push(cg.rdata, 0) }
        roff_ch := buf_len(cg.rdata)
        buf_push_u64(cg.rdata, 0x3FF0000000000000) // 1.0

        mc_align16(c)
        s_ch := buf_len(c)
        mc_ai_enter(c, 0xB8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = l
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = n
        mc_b3(c, 0x4C, 0x89, 0xCD); mc_b4(c, 0x48, 0xC1, 0xE5, 3) // RBP = n * 8
        cg_lea_rax_rdata(cg, roff_ch); mc_b3(c, 0x49, 0x89, 0xC2) // R10 = &1.0
        mc_b4(c, 0x66, 0x45, 0x0F, 0x57); mc_b1(c, 0xFF)          // X15 = tr = 0.0
        mc_b3(c, 0x4D, 0x85, 0xC9); jle_ch_dn := mc_jcc32(c, 0x8E)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_ch_sc := mc_jcc32(c, 0x84)

        mc_b3(c, 0x45, 0x31, 0xDB) // R11 = j = 0
        mc_b3(c, 0x4C, 0x89, 0xC6) // RSI = lj = l + j*stride
        mc_align16_nop(c)
        lp_chj := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xCB); jge_chj_dn := mc_jcc32(c, 0x8D)
        // Diagonal: s = lj[j] - dot(lj[0..j], lj[0..j])
        mc_vex256(c, 1, 2, 2, 2, 0x57)
        mc_b2(c, 0x31, 0xC9)
        mc_b4(c, 0x4D, 0x8D, 0x63, 0xFC) // R12 = j - 4
        lp_chd4 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE1); jg_chd1 := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x1C, 0xCE) // Y3 = lj[k..k+3]
        mc_vex3(c, 0, 0, 0, 2, 1, 3, 1, 1, 0xB8); mc_b1(c, 0xD3)       // Y2 += Y3*Y3
        mc_b4(c, 0x48, 0x83, 0xC1, 4); j_chd4 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_chd4, lp_chd4)
        mc_patch_jcc8(c, jg_chd1, buf_len(c))
        _mc_vhsum_pd_to_xmm0(c, 2)
        lp_chd1 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD9); jge_chd_e := mc_jcc8(c, 0x7D)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x1C, 0xCE)
        mc_vex3(c, 0, 0, 0, 2, 1, 3, 0, 1, 0xB9); mc_b1(c, 0xC3) // VFMADD231SD X0, X3, X3
        mc_b3(c, 0x48, 0xFF, 0xC1); j_chd1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_chd1, lp_chd1)
        mc_patch_jcc8(c, jge_chd_e, buf_len(c))
        mc_vex3(c, 0, 1, 0, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x0C, 0xDE) // X1 = lj[j]
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 0, 3, 0x5C); mc_b1(c, 0xC0)       // X0 = lj[j] - dot
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x51); mc_b1(c, 0xC0)       // X0 = sqrt(s) = ljj
        mc_vex3(c, 0, 1, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xDE) // lj[j] = ljj
        mc_vex3(c, 1, 0, 0, 1, 0, 15, 0, 3, 0x58); mc_b1(c, 0xF8)      // X15 += ljj
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b1(c, 0x32)       // X14 = 1.0
        mc_vex3(c, 1, 0, 0, 1, 0, 14, 0, 3, 0x5E); mc_b1(c, 0xF0)      // X14 = inv_ljj = 1.0 / ljj
        // Off-diagonal column j: 2 rows (i, i+1) simultaneously!
        mc_b4(c, 0x4D, 0x8D, 0x6B, 1)    // R13 = i = j + 1
        mc_b4(c, 0x48, 0x8D, 0x3C, 0x2E) // RDI = li = lj + stride
        lp_chi2 := buf_len(c)
        mc_b4(c, 0x4D, 0x8D, 0x75, 1); mc_b3(c, 0x4D, 0x39, 0xCE); jge_chi1 := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x48, 0x8D, 0x1C, 0x2F) // RBX = li1 = li + stride
        mc_vex256(c, 1, 2, 2, 2, 0x57); mc_vex256(c, 1, 3, 3, 3, 0x57)
        mc_b2(c, 0x31, 0xC9)
        lp_chi2_4 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE1); jg_chi2_1 := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x24, 0xCE) // Y4 = lj[k..k+3]
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b2(c, 0x14, 0xCF) // Y2 += Y4 * li[k..k+3]
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b2(c, 0x1C, 0xCB) // Y3 += Y4 * li1[k..k+3]
        mc_b4(c, 0x48, 0x83, 0xC1, 4); j_chi2_4 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_chi2_4, lp_chi2_4)
        mc_patch_jcc8(c, jg_chi2_1, buf_len(c))
        _mc_vhsum_pd_to_xmm0(c, 2); mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x10); mc_b1(c, 0xE8) // X5 = dot0
        _mc_vhsum_pd_to_xmm0(c, 3); mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x10); mc_b1(c, 0xF0) // X6 = dot1
        lp_chi2_t := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD9); jge_chi2_e := mc_jcc8(c, 0x7D)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x24, 0xCE) // X4 = lj[k]
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 0, 1, 0xB9); mc_b2(c, 0x2C, 0xCF) // X5 += X4 * li[k]
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 0, 1, 0xB9); mc_b2(c, 0x34, 0xCB) // X6 += X4 * li1[k]
        mc_b3(c, 0x48, 0xFF, 0xC1); j_chi2_t := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_chi2_t, lp_chi2_t)
        mc_patch_jcc8(c, jge_chi2_e, buf_len(c))
        mc_vex3(c, 0, 1, 0, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x04, 0xDF) // X0 = li[j]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x5C); mc_b1(c, 0xC5)       // X0 -= dot0
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC6)       // X0 *= inv_ljj
        mc_vex3(c, 0, 1, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xDF) // li[j] = X0
        mc_vex3(c, 0, 1, 0, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x04, 0xDB) // X0 = li1[j]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x5C); mc_b1(c, 0xC6)       // X0 -= dot1
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC6)       // X0 *= inv_ljj
        mc_vex3(c, 0, 1, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xDB) // li1[j] = X0
        mc_b4(c, 0x49, 0x83, 0xC5, 2); mc_b4(c, 0x48, 0x8D, 0x3C, 0x2B) // i+=2; li = li1 + stride
        j_chi2 := mc_jmp32(c); mc_patch_rel32(c, j_chi2, lp_chi2)
        // Odd final row i = n - 1
        mc_patch_rel32(c, jge_chi1, buf_len(c))
        mc_b3(c, 0x4D, 0x39, 0xCD); jge_chi_dn := mc_jcc32(c, 0x8D)
        mc_vex256(c, 1, 2, 2, 2, 0x57); mc_b2(c, 0x31, 0xC9)
        lp_chi1_4 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE1); jg_chi1_1 := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x24, 0xCE)
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 1, 1, 0xB8); mc_b2(c, 0x14, 0xCF)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); j_chi1_4 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_chi1_4, lp_chi1_4)
        mc_patch_jcc8(c, jg_chi1_1, buf_len(c))
        _mc_vhsum_pd_to_xmm0(c, 2); mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x10); mc_b1(c, 0xE8)
        lp_chi1_t := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD9); jge_chi1_e := mc_jcc8(c, 0x7D)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x24, 0xCE)
        mc_vex3(c, 0, 0, 0, 2, 1, 4, 0, 1, 0xB9); mc_b2(c, 0x2C, 0xCF)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_chi1_t := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_chi1_t, lp_chi1_t)
        mc_patch_jcc8(c, jge_chi1_e, buf_len(c))
        mc_vex3(c, 0, 1, 0, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x04, 0xDF)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x5C); mc_b1(c, 0xC5)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC6)
        mc_vex3(c, 0, 1, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xDF)
        mc_patch_rel32(c, jge_chi_dn, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC3); mc_b3(c, 0x48, 0x01, 0xEE)
        j_chj := mc_jmp32(c); mc_patch_rel32(c, j_chj, lp_chj)
        mc_patch_rel32(c, jge_chj_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_ch_end := mc_jmp32(c)

        // Scalar fallback
        mc_patch_rel32(c, jz_ch_sc, buf_len(c))
        mc_b3(c, 0x45, 0x31, 0xDB); mc_b3(c, 0x4C, 0x89, 0xC6)
        lp_chsj := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xCB); jge_chsj := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x10); mc_b2(c, 0x04, 0xDE) // X0 = lj[j]
        mc_b2(c, 0x31, 0xC9)
        lp_chsd := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD9); jge_chsd := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x0C); mc_b1(c, 0xCE); mc_b4(c, 0xF2, 0x0F, 0x59, 0xC9); mc_b4(c, 0xF2, 0x0F, 0x5C, 0xC1)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_chsd := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_chsd, lp_chsd)
        mc_patch_jcc8(c, jge_chsd, buf_len(c))
        mc_b4(c, 0xF2, 0x0F, 0x51, 0xC0); mc_b4(c, 0xF2, 0x42, 0x0F, 0x11); mc_b2(c, 0x04, 0xDE)
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xF8)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b1(c, 0x32); mc_b4(c, 0xF2, 0x44, 0x0F, 0x5E); mc_b1(c, 0xF0)
        mc_b4(c, 0x4D, 0x8D, 0x6B, 1); mc_b4(c, 0x48, 0x8D, 0x3C, 0x2E)
        lp_chsi := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xCD); jge_chsi := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x10); mc_b2(c, 0x04, 0xDF); mc_b2(c, 0x31, 0xC9)
        lp_chsik := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD9); jge_chsik := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x0C); mc_b1(c, 0xCF); mc_b4(c, 0xF2, 0x0F, 0x59, 0x0C); mc_b1(c, 0xCE)
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xC1)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_chsik := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_chsik, lp_chsik)
        mc_patch_jcc8(c, jge_chsik, buf_len(c))
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xC6); mc_b4(c, 0xF2, 0x42, 0x0F, 0x11); mc_b2(c, 0x04, 0xDF)
        mc_b3(c, 0x49, 0xFF, 0xC5); mc_b3(c, 0x48, 0x01, 0xEF)
        j_chsi := mc_jmp32(c); mc_patch_rel32(c, j_chsi, lp_chsi)
        mc_patch_rel32(c, jge_chsi, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC3); mc_b3(c, 0x48, 0x01, 0xEE)
        j_chsj := mc_jmp32(c); mc_patch_rel32(c, j_chsj, lp_chsj)
        mc_patch_rel32(c, jge_chsj, buf_len(c))

        mc_patch_rel32(c, jmp_ch_end, buf_len(c))
        mc_patch_rel32(c, jle_ch_dn, buf_len(c))
        mc_b4(c, 0x66, 0x4C, 0x0F, 0x7E); mc_b1(c, 0xF8) // MOVQ RAX, X15
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_cholesky_f64(), s_ch, buf_len(c))
    }

    // 44. `h_ai_lu_factor_f64(a, n) -> f64`: FMA3 (VFNMADD231PD) 2-row unrolled LU factorization, returns trace(U)!
    if cg_is_helper_used(cg, h_ai_lu_factor_f64()) {
        while (buf_len(cg.rdata) & 15) != 0 { buf_push(cg.rdata, 0) }
        roff_lu := buf_len(cg.rdata)
        buf_push_u64(cg.rdata, 0x3FF0000000000000) // 1.0

        mc_align16(c)
        s_lu := buf_len(c)
        mc_ai_enter(c, 0xB8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = a
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = n
        mc_b3(c, 0x4C, 0x89, 0xCD); mc_b4(c, 0x48, 0xC1, 0xE5, 3) // RBP = n * 8
        cg_lea_rax_rdata(cg, roff_lu); mc_b3(c, 0x49, 0x89, 0xC2) // R10 = &1.0
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0)
        mc_b3(c, 0x4D, 0x85, 0xC9); jle_lu_dn := mc_jcc32(c, 0x8E)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_lu_sc := mc_jcc32(c, 0x84)

        mc_b3(c, 0x45, 0x31, 0xDB) // R11 = k = 0
        mc_b3(c, 0x4C, 0x89, 0xC6) // RSI = rk = a + k*stride
        mc_align16_nop(c)
        lp_luk := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xCB); jge_luk_dn := mc_jcc32(c, 0x8D)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b1(c, 0x32)       // X14 = 1.0
        mc_vex3(c, 1, 1, 0, 1, 0, 14, 0, 3, 0x5E); mc_b2(c, 0x34, 0xDE) // X14 = inv_piv = 1.0 / rk[k]
        mc_b4(c, 0x4D, 0x8D, 0x63, 1)    // R12 = i = k + 1
        mc_b4(c, 0x48, 0x8D, 0x3C, 0x2E) // RDI = ri = rk + stride
        mc_b4(c, 0x4D, 0x8D, 0x69, 0xFC) // R13 = n - 4
        lp_lui2 := buf_len(c)
        mc_b4(c, 0x4D, 0x8D, 0x74, 0x24); mc_b1(c, 1); mc_b3(c, 0x4D, 0x39, 0xCE); jge_lui1 := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x48, 0x8D, 0x1C, 0x2F) // RBX = ri1 = ri + stride
        mc_vex3(c, 0, 1, 0, 1, 0, 14, 0, 3, 0x59); mc_b2(c, 0x14, 0xDF) // X2 = f0 = ri[k] * inv_piv
        mc_vex3(c, 0, 1, 0, 1, 0, 0,  0, 3, 0x11); mc_b2(c, 0x14, 0xDF) // ri[k] = f0
        mc_vex256(c, 2, 2, 0, 2, 0x19)                                   // Y2 = bcast(f0)
        mc_vex3(c, 0, 1, 0, 1, 0, 14, 0, 3, 0x59); mc_b2(c, 0x1C, 0xDB) // X3 = f1 = ri1[k] * inv_piv
        mc_vex3(c, 0, 1, 0, 1, 0, 0,  0, 3, 0x11); mc_b2(c, 0x1C, 0xDB) // ri1[k] = f1
        mc_vex256(c, 2, 3, 0, 3, 0x19)                                   // Y3 = bcast(f1)
        mc_b4(c, 0x49, 0x8D, 0x4B, 1) // RCX = j = k + 1
        lp_luj2_4 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE9); jg_luj2_1 := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x24, 0xCE) // Y4 = rk[j..j+3]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xCF) // Y0 = ri[j..j+3]
        mc_vex3(c, 0, 0, 0, 2, 1, 2, 1, 1, 0xBC); mc_b1(c, 0xC4)       // VFNMADD231PD Y0, Y2, Y4
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x04, 0xCF)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x0C, 0xCB) // Y1 = ri1[j..j+3]
        mc_vex3(c, 0, 0, 0, 2, 1, 3, 1, 1, 0xBC); mc_b1(c, 0xCC)       // VFNMADD231PD Y1, Y3, Y4
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x0C, 0xCB)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); j_luj2_4 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_luj2_4, lp_luj2_4)
        mc_patch_jcc8(c, jg_luj2_1, buf_len(c))
        lp_luj2_1 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xC9); jge_luj2_e := mc_jcc8(c, 0x7D)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x24, 0xCE)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x04, 0xCF); mc_vex3(c, 0, 0, 0, 2, 1, 2, 0, 1, 0xBD); mc_b1(c, 0xC4); mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xCF)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x0C, 0xCB); mc_vex3(c, 0, 0, 0, 2, 1, 3, 0, 1, 0xBD); mc_b1(c, 0xCC); mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x0C, 0xCB)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_luj2_1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_luj2_1, lp_luj2_1)
        mc_patch_jcc8(c, jge_luj2_e, buf_len(c))
        mc_b4(c, 0x49, 0x83, 0xC4, 2); mc_b4(c, 0x48, 0x8D, 0x3C, 0x2B)
        j_lui2 := mc_jmp32(c); mc_patch_rel32(c, j_lui2, lp_lui2)
        // Odd final row
        mc_patch_rel32(c, jge_lui1, buf_len(c))
        mc_b3(c, 0x4D, 0x39, 0xCC); jge_lui_dn := mc_jcc32(c, 0x8D)
        mc_vex3(c, 0, 1, 0, 1, 0, 14, 0, 3, 0x59); mc_b2(c, 0x14, 0xDF)
        mc_vex3(c, 0, 1, 0, 1, 0, 0,  0, 3, 0x11); mc_b2(c, 0x14, 0xDF)
        mc_vex256(c, 2, 2, 0, 2, 0x19)
        mc_b4(c, 0x49, 0x8D, 0x4B, 1)
        lp_luj1_4 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE9); jg_luj1_1 := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x24, 0xCE)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xCF)
        mc_vex3(c, 0, 0, 0, 2, 1, 2, 1, 1, 0xBC); mc_b1(c, 0xC4)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x04, 0xCF)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); j_luj1_4 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_luj1_4, lp_luj1_4)
        mc_patch_jcc8(c, jg_luj1_1, buf_len(c))
        lp_luj1_1 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xC9); jge_luj1_e := mc_jcc8(c, 0x7D)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x24, 0xCE)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x04, 0xCF); mc_vex3(c, 0, 0, 0, 2, 1, 2, 0, 1, 0xBD); mc_b1(c, 0xC4); mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xCF)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_luj1_1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_luj1_1, lp_luj1_1)
        mc_patch_jcc8(c, jge_luj1_e, buf_len(c))
        mc_patch_rel32(c, jge_lui_dn, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC3); mc_b3(c, 0x48, 0x01, 0xEE)
        j_luk := mc_jmp32(c); mc_patch_rel32(c, j_luk, lp_luk)
        mc_patch_rel32(c, jge_luk_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_lu_sum := mc_jmp32(c)

        // Scalar fallback
        mc_patch_rel32(c, jz_lu_sc, buf_len(c))
        mc_b3(c, 0x45, 0x31, 0xDB); mc_b3(c, 0x4C, 0x89, 0xC6)
        lp_lusk := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xCB); jge_lusk := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b1(c, 0x32); mc_b4(c, 0xF2, 0x46, 0x0F, 0x5E); mc_b2(c, 0x34, 0xDE)
        mc_b4(c, 0x4D, 0x8D, 0x63, 1); mc_b4(c, 0x48, 0x8D, 0x3C, 0x2E)
        lp_lusi := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xCC); jge_lusi := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x10); mc_b2(c, 0x14, 0xDF); mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xD6)
        mc_b4(c, 0xF2, 0x42, 0x0F, 0x11); mc_b2(c, 0x14, 0xDF)
        mc_b4(c, 0x49, 0x8D, 0x4B, 1)
        lp_lusj := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xC9); jge_lusj := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x04); mc_b1(c, 0xCE); mc_b4(c, 0xF2, 0x0F, 0x59, 0xC2)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0x0C); mc_b1(c, 0xCF); mc_b4(c, 0xF2, 0x0F, 0x5C, 0xC8); mc_b4(c, 0xF2, 0x0F, 0x11, 0x0C); mc_b1(c, 0xCF)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_lusj := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_lusj, lp_lusj)
        mc_patch_jcc8(c, jge_lusj, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC4); mc_b3(c, 0x48, 0x01, 0xEF)
        j_lusi := mc_jmp32(c); mc_patch_rel32(c, j_lusi, lp_lusi)
        mc_patch_rel32(c, jge_lusi, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC3); mc_b3(c, 0x48, 0x01, 0xEE)
        j_lusk := mc_jmp32(c); mc_patch_rel32(c, j_lusk, lp_lusk)
        mc_patch_rel32(c, jge_lusk, buf_len(c))

        // Return trace(U) = sum_i a[i*n + i]
        mc_patch_rel32(c, jmp_lu_sum, buf_len(c))
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0); mc_b4(c, 0x48, 0x8D, 0x55, 8); mc_b3(c, 0x4C, 0x89, 0xC6); mc_b2(c, 0x31, 0xC9)
        lp_lud := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xC9); jge_lud := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0x06); mc_b3(c, 0x48, 0x01, 0xD6); mc_b3(c, 0x48, 0xFF, 0xC1)
        j_lud := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_lud, lp_lud)
        mc_patch_jcc8(c, jge_lud, buf_len(c))

        mc_patch_rel32(c, jle_lu_dn, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_lu_factor_f64(), s_lu, buf_len(c))
    }

    // 45. `h_ai_varint_rt_i64(vals, buf, i0, i1) -> i64`: Branchless BMI2 PDEP encode + PEXT/BLSMSK/TZCNT decode!
    if cg_is_helper_used(cg, h_ai_varint_rt_i64()) {
        mc_align16(c)
        s_vi := buf_len(c)
        mc_ai_enter(c, 0x28)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = vals
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = buf
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = blk = i0
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = i1
        mc_b3(c, 0x45, 0x31, 0xFF)       // R15 = acc = 0
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_vi_sc := mc_jcc32(c, 0x84)

        mc_b2(c, 0x49, 0xBD); mc_u64(c, 0x7F7F7F7F7F7F7F7F) // R13 = 7-bit payload mask
        mc_b2(c, 0x49, 0xBE); mc_u64(c, 0x8080808080808080) // R14 = continuation-bit mask
        mc_align16_nop(c)
        lp_vib2 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xDA); jge_vi2_dn := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4D, 0x8D, 0xA2); mc_u32(c, 4096) // R12 = bend = min(i1, blk + 4096)
        mc_b3(c, 0x4D, 0x39, 0xDC); jle_vib2_ok := mc_jcc8(c, 0x7E)
        mc_b3(c, 0x4D, 0x89, 0xDC)
        mc_patch_jcc8(c, jle_vib2_ok, buf_len(c))
        // 2-Stream Split: [blk..mid) -> buf+0, [mid..bend) -> buf+32768 (breaks 10-cycle serial decode chain -> 2x ILP!)
        mc_b3(c, 0x4C, 0x89, 0xD0); mc_b3(c, 0x4C, 0x01, 0xE0); mc_b3(c, 0x48, 0xD1, 0xE8) // RAX = mid = (blk+bend)>>1
        mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 16) // [RSP+16] = mid
        // Encode Stream A ([blk..mid) -> buf+0) and Stream B ([mid..bend) -> buf+32768)
        mut vst := 0
        while vst < 2 {
            if vst == 0 {
                mc_b3(c, 0x4C, 0x89, 0xD6)                      // RSI = blk
                mc_b4(c, 0x48, 0x8B, 0x6C, 0x24); mc_b1(c, 16)  // RBP = mid
                mc_b3(c, 0x4C, 0x89, 0xCF)                      // RDI = buf + 0
            } else {
                mc_b4(c, 0x48, 0x8B, 0x74, 0x24); mc_b1(c, 16)  // RSI = mid
                mc_b3(c, 0x4C, 0x89, 0xE5)                      // RBP = bend
                mc_b3(c, 0x49, 0x8D, 0xB9); mc_u32(c, 32768)    // RDI = buf + 32768
            }
            mc_align16_nop(c)
            lp_vie_s := buf_len(c)
            mc_b3(c, 0x48, 0x39, 0xEE); jge_vie_s := mc_jcc32(c, 0x8D)
            mc_b4(c, 0x49, 0x8B, 0x04, 0xF0)
            mc_b3(c, 0x48, 0x89, 0xC2); mc_b4(c, 0x48, 0x83, 0xCA, 1)
            mc_b4(c, 0x48, 0x0F, 0xBD, 0xD2)
            mc_b3(c, 0x83, 0xFA, 55); jg_vie_r := mc_jcc8(c, 0x7F)
            mc_b3(c, 0x6B, 0xCA, 37); mc_b3(c, 0xC1, 0xE9, 8)
            mc_b4(c, 0x48, 0x8D, 0x59, 1); mc_b3(c, 0xC1, 0xE1, 3)
            mc_vex3(c, 0, 0, 1, 2, 1, 1, 0, 0, 0xF5); mc_b1(c, 0xD6)
            mc_vex3(c, 0, 0, 1, 2, 1, 0, 0, 3, 0xF5); mc_b1(c, 0xC5)
            mc_b3(c, 0x48, 0x09, 0xD0); mc_b3(c, 0x48, 0x89, 0x07)
            mc_b3(c, 0x48, 0x01, 0xDF); mc_b3(c, 0x48, 0xFF, 0xC6)
            j_vie_s := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_vie_s, lp_vie_s)
            mc_patch_jcc8(c, jg_vie_r, buf_len(c))
            lp_vie_rb := buf_len(c)
            mc_b4(c, 0x48, 0x83, 0xF8, 127); jbe_vie_rl := mc_jcc8(c, 0x76)
            mc_b2(c, 0x89, 0xC2); mc_b3(c, 0x80, 0xCA, 0x80); mc_b2(c, 0x88, 0x17); mc_b3(c, 0x48, 0xFF, 0xC7)
            mc_b4(c, 0x48, 0xC1, 0xE8, 7); j_vie_rb := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_vie_rb, lp_vie_rb)
            mc_patch_jcc8(c, jbe_vie_rl, buf_len(c))
            mc_b2(c, 0x88, 0x07); mc_b3(c, 0x48, 0xFF, 0xC7); mc_b3(c, 0x48, 0xFF, 0xC6)
            j_vie_b := mc_jmp32(c); mc_patch_rel32(c, j_vie_b, lp_vie_s)
            mc_patch_rel32(c, jge_vie_s, buf_len(c))
            if vst == 0 {
                mc_b4(c, 0x48, 0x89, 0x3C, 0x24)          // [RSP+0] = end_a
            } else {
                mc_b4(c, 0x48, 0x89, 0x7C, 0x24); mc_b1(c, 8) // [RSP+8] = end_b
            }
            vst += 1
        }
        // 2-Way Interleaved BMI2 Decode (RSI = Stream A, RDI = Stream B in parallel!)
        mc_b3(c, 0x4C, 0x89, 0xCE)                     // RSI = buf + 0
        mc_b3(c, 0x49, 0x8D, 0xB9); mc_u32(c, 32768)   // RDI = buf + 32768
        mc_align16_nop(c)
        lp_vid_dual := buf_len(c)
        mc_b4(c, 0x48, 0x3B, 0x34, 0x24); jge_vdd_dn1 := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x48, 0x3B, 0x7C, 0x24); mc_b1(c, 8); jge_vdd_dn2 := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x48, 0x8B, 0x06)                               // RAX = [RSI] (Stream A)
        mc_b3(c, 0x48, 0x8B, 0x2F)                               // RBP = [RDI] (Stream B)
        mc_vex3(c, 0, 0, 1, 2, 1, 0, 0, 0, 0xF2); mc_b1(c, 0xD6) // ANDN RDX, RAX, R14
        jz_vdd_r1 := mc_jcc32(c, 0x84)
        mc_vex3(c, 0, 0, 1, 2, 1, 5, 0, 0, 0xF2); mc_b1(c, 0xDE) // ANDN RBX, RBP, R14
        jz_vdd_r2 := mc_jcc32(c, 0x84)
        mc_vex3(c, 0, 0, 0, 2, 1, 1, 0, 0, 0xF3); mc_b1(c, 0xD2) // BLSMSK RCX, RDX
        mc_b4(c, 0xF3, 0x48, 0x0F, 0xBC); mc_b1(c, 0xD2)         // TZCNT RDX, RDX
        mc_b3(c, 0xC1, 0xEA, 3)
        mc_b4(c, 0x48, 0x8D, 0x74, 0x16); mc_b1(c, 1)            // RSI += RDX + 1
        mc_vex3(c, 0, 0, 0, 2, 1, 2, 0, 0, 0xF3); mc_b1(c, 0xD3) // BLSMSK RDX, RBX
        mc_b4(c, 0xF3, 0x48, 0x0F, 0xBC); mc_b1(c, 0xDB)         // TZCNT RBX, RBX
        mc_b3(c, 0xC1, 0xEB, 3)
        mc_b4(c, 0x48, 0x8D, 0x7C, 0x1F); mc_b1(c, 1)            // RDI += RBX + 1
        mc_b3(c, 0x4C, 0x21, 0xE9)                               // RCX &= M7
        mc_b3(c, 0x4C, 0x21, 0xEA)                               // RDX &= M7
        mc_vex3(c, 0, 0, 0, 2, 1, 0, 0, 2, 0xF5); mc_b1(c, 0xC1) // PEXT RAX, RAX, RCX
        mc_vex3(c, 0, 0, 0, 2, 1, 5, 0, 2, 0xF5); mc_b1(c, 0xEA) // PEXT RBP, RBP, RDX
        mc_b3(c, 0x49, 0x01, 0xC7); mc_b3(c, 0x49, 0x01, 0xEF)   // R15 += RAX + RBP
        j_vdd := mc_jmp32(c); mc_patch_rel32(c, j_vdd, lp_vid_dual)

        // Drain remaining Stream A then Stream B (also handles rare 9..10B varints cleanly!)
        mc_patch_rel32(c, jge_vdd_dn1, buf_len(c))
        mc_patch_rel32(c, jge_vdd_dn2, buf_len(c))
        mc_patch_rel32(c, jz_vdd_r1, buf_len(c))
        mc_patch_rel32(c, jz_vdd_r2, buf_len(c))
        mc_b4(c, 0x48, 0x89, 0x7C, 0x24); mc_b1(c, 24)           // save RDI (p_b) at [RSP+24]
        mut dpass := 0
        while dpass < 2 {
            if dpass == 0 {
                mc_b4(c, 0x48, 0x8B, 0x3C, 0x24)                 // RDI = end_a (RSI already = p_a)
            } else {
                mc_b4(c, 0x48, 0x8B, 0x74, 0x24); mc_b1(c, 24)   // RSI = p_b
                mc_b4(c, 0x48, 0x8B, 0x7C, 0x24); mc_b1(c, 8)    // RDI = end_b
            }
            lp_vid_s := buf_len(c)
            mc_b3(c, 0x48, 0x39, 0xFE); jge_vid_sdn := mc_jcc32(c, 0x8D)
            mc_b3(c, 0x48, 0x8B, 0x06)
            mc_vex3(c, 0, 0, 1, 2, 1, 0, 0, 0, 0xF2); mc_b1(c, 0xD6)
            jz_vid_sr := mc_jcc8(c, 0x74)
            mc_vex3(c, 0, 0, 0, 2, 1, 1, 0, 0, 0xF3); mc_b1(c, 0xD2)
            mc_b4(c, 0xF3, 0x48, 0x0F, 0xBC); mc_b1(c, 0xD2)
            mc_b3(c, 0xC1, 0xEA, 3)
            mc_b4(c, 0x48, 0x8D, 0x74, 0x16); mc_b1(c, 1)
            mc_b3(c, 0x4C, 0x21, 0xE9)
            mc_vex3(c, 0, 0, 0, 2, 1, 0, 0, 2, 0xF5); mc_b1(c, 0xC1)
            mc_b3(c, 0x49, 0x01, 0xC7)
            j_vid_s := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_vid_s, lp_vid_s)
            mc_patch_jcc8(c, jz_vid_sr, buf_len(c))
            mc_b2(c, 0x31, 0xC0); mc_b2(c, 0x31, 0xC9)
            lp_vid_sr := buf_len(c)
            mc_b3(c, 0x0F, 0xB6, 0x16); mc_b3(c, 0x48, 0xFF, 0xC6)
            mc_b2(c, 0x89, 0xD3); mc_b3(c, 0x83, 0xE3, 127); mc_b3(c, 0x48, 0xD3, 0xE3); mc_b3(c, 0x48, 0x09, 0xD8)
            mc_b3(c, 0xF6, 0xC2, 0x80); jz_vid_srd := mc_jcc8(c, 0x74)
            mc_b3(c, 0x83, 0xC1, 7); j_vid_srm := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_vid_srm, lp_vid_sr)
            mc_patch_jcc8(c, jz_vid_srd, buf_len(c))
            mc_b3(c, 0x49, 0x01, 0xC7); j_vid_sb := mc_jmp32(c); mc_patch_rel32(c, j_vid_sb, lp_vid_s)
            mc_patch_rel32(c, jge_vid_sdn, buf_len(c))
            dpass += 1
        }
        mc_b3(c, 0x4D, 0x89, 0xE2)
        j_vib2 := mc_jmp32(c); mc_patch_rel32(c, j_vib2, lp_vib2)
        mc_patch_rel32(c, jge_vi2_dn, buf_len(c))
        jmp_vi_end := mc_jmp32(c)

        // Scalar fallback (--simd=scalar)
        mc_patch_rel32(c, jz_vi_sc, buf_len(c))
        mc_align16_nop(c)
        lp_vib := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xDA); jge_vi_dn := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4D, 0x8D, 0xA2); mc_u32(c, 4096) // R12 = bend = blk + 4096
        mc_b3(c, 0x4D, 0x39, 0xDC); jle_vib_ok := mc_jcc8(c, 0x7E)
        mc_b3(c, 0x4D, 0x89, 0xDC)
        mc_patch_jcc8(c, jle_vib_ok, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xD6) // RSI = i = blk
        mc_b3(c, 0x4C, 0x89, 0xCF) // RDI = out_ptr = buf
        lp_vie := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE6); jge_vie_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xF0) // RAX = v = vals[i]
        lp_vie_b := buf_len(c)
        mc_b4(c, 0x48, 0x83, 0xF8, 127); jbe_vie_last := mc_jcc8(c, 0x76)
        mc_b2(c, 0x89, 0xC2)
        mc_b3(c, 0x80, 0xCA, 0x80); mc_b2(c, 0x88, 0x17); mc_b3(c, 0x48, 0xFF, 0xC7)
        mc_b4(c, 0x48, 0xC1, 0xE8, 7); j_vie_b := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_vie_b, lp_vie_b)
        mc_patch_jcc8(c, jbe_vie_last, buf_len(c))
        mc_b2(c, 0x88, 0x07); mc_b3(c, 0x48, 0xFF, 0xC7); mc_b3(c, 0x48, 0xFF, 0xC6)
        j_vie := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_vie, lp_vie)
        mc_patch_jcc8(c, jge_vie_dn, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xCE) // RSI = p = buf
        lp_vid := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xFE); jge_vid_dn := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x0F, 0xB6, 0x06); mc_b3(c, 0x48, 0xFF, 0xC6) // EAX = b0 = *p++
        mc_b2(c, 0xA8, 0x80); jnz_vid_m := mc_jcc8(c, 0x75)
        mc_b3(c, 0x49, 0x01, 0xC7); j_vid1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_vid1, lp_vid)
        mc_patch_jcc8(c, jnz_vid_m, buf_len(c))
        mc_b3(c, 0x83, 0xE0, 127) // RAX = res = b0 & 127
        mc_b1(c, 0xB9); mc_u32(c, 7) // ECX = sh = 7
        lp_vid_m := buf_len(c)
        mc_b3(c, 0x0F, 0xB6, 0x16); mc_b3(c, 0x48, 0xFF, 0xC6) // EDX = b = *p++
        mc_b2(c, 0x89, 0xD3); mc_b3(c, 0x83, 0xE3, 127); mc_b3(c, 0x48, 0xD3, 0xE3); mc_b3(c, 0x48, 0x09, 0xD8)
        mc_b3(c, 0xF6, 0xC2, 0x80); jz_vid_done := mc_jcc8(c, 0x74)
        mc_b3(c, 0x83, 0xC1, 7); j_vid_m := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_vid_m, lp_vid_m)
        mc_patch_jcc8(c, jz_vid_done, buf_len(c))
        mc_b3(c, 0x49, 0x01, 0xC7); j_vid2s := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_vid2s, lp_vid)
        mc_patch_jcc8(c, jge_vid_dn, buf_len(c))
        mc_b3(c, 0x4D, 0x89, 0xE2) // blk = bend
        j_vib := mc_jmp32(c); mc_patch_rel32(c, j_vib, lp_vib)
        mc_patch_rel32(c, jge_vi_dn, buf_len(c))
        mc_patch_rel32(c, jmp_vi_end, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xF8) // RAX = R15
        mc_ai_leave(c, 0x28)
        cg_reg_helper(cg, h_ai_varint_rt_i64(), s_vi, buf_len(c))
    }

    // 46. `h_ai_url_query_sum(p, i0, i1) -> i64`: 32B AVX2 VPCMPEQB('=') + VPMOVMSKB + BSF URL query sum!
    if cg_is_helper_used(cg, h_ai_url_query_sum()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_uq := buf_len(cg.rdata)
        mut ur := 0; while ur < 4 { buf_push_u64(cg.rdata, 0x3D3D3D3D3D3D3D3D); ur += 1 } // '=' (61) x 32

        mc_align16(c)
        s_uq := buf_len(c)
        mc_ai_enter(c, 0xB8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = p
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = i = i0
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = end = i1
        mc_b3(c, 0x45, 0x31, 0xFF)       // R15 = acc = 0
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_uq_dn := mc_jcc32(c, 0x8D)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_uq_sc := mc_jcc32(c, 0x84)

        cg_lea_rax_rdata(cg, roff_uq)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b1(c, 0x00) // Y0 = '=' x 32
        mc_b4(c, 0x4D, 0x8D, 0x5A, 0xE0) // R11 = end - 32
        mc_align16_nop(c)
        lp_uq32 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD9); jg_uq_tail := mc_jcc32(c, 0x8F)
        mc_vex3(c, 0, 1, 1, 1, 0, 0, 1, 1, 0x74); mc_b2(c, 0x0C, 0x08) // VPCMPEQB Y1, Y0, [R8+R9]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xD7); mc_b1(c, 0xC1)       // VPMOVMSKB EAX, Y1
        mc_b2(c, 0x85, 0xC0); jnz_uq_hit := mc_jcc8(c, 0x75)
        mc_b4(c, 0x49, 0x83, 0xC1, 32); j_uq32 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_uq32, lp_uq32)
        mc_patch_jcc8(c, jnz_uq_hit, buf_len(c))
        mc_b3(c, 0x0F, 0xBC, 0xC8) // BSF ECX, EAX (offset of '=')
        mc_b4(c, 0x4D, 0x8D, 0x4C, 0x09); mc_b1(c, 1) // R9 = R9 + RCX + 1 (first digit!)
        // Parse decimal integer at [R8 + R9]
        mc_b2(c, 0x31, 0xD2) // RDX = v = 0
        lp_uqd := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_uqd_e := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x43, 0x0F, 0xB6, 0x04); mc_b1(c, 0x08) // EAX = p[i]
        mc_b3(c, 0x83, 0xE8, 48); mc_b3(c, 0x83, 0xF8, 9); ja_uqd_e := mc_jcc8(c, 0x77)
        mc_b4(c, 0x48, 0x8D, 0x14, 0x92); mc_b4(c, 0x48, 0x8D, 0x14, 0x50) // RDX = RDX*5*2 + RAX = RDX*10 + d
        mc_b3(c, 0x49, 0xFF, 0xC1); j_uqd := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_uqd, lp_uqd)
        mc_patch_jcc8(c, jge_uqd_e, buf_len(c))
        mc_patch_jcc8(c, ja_uqd_e, buf_len(c))
        mc_b3(c, 0x49, 0x01, 0xD7) // acc += v
        j_uq_nx := mc_jmp32(c); mc_patch_rel32(c, j_uq_nx, lp_uq32)

        mc_patch_rel32(c, jg_uq_tail, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)

        // Scalar tail & --simd=scalar fallback
        mc_patch_rel32(c, jz_uq_sc, buf_len(c))
        lp_uqs := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_uqs_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x43, 0x0F, 0xB6, 0x04); mc_b1(c, 0x08)
        mc_b3(c, 0x49, 0xFF, 0xC1)
        mc_b3(c, 0x83, 0xF8, 61); jne_uqs := mc_jcc8(c, 0x75)
        mc_b2(c, 0x31, 0xD2)
        lp_uqsd := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_uqsd := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x43, 0x0F, 0xB6, 0x04); mc_b1(c, 0x08)
        mc_b3(c, 0x83, 0xE8, 48); mc_b3(c, 0x83, 0xF8, 9); ja_uqsd := mc_jcc8(c, 0x77)
        mc_b4(c, 0x48, 0x8D, 0x14, 0x92); mc_b4(c, 0x48, 0x8D, 0x14, 0x50)
        mc_b3(c, 0x49, 0xFF, 0xC1); j_uqsd := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_uqsd, lp_uqsd)
        mc_patch_jcc8(c, jge_uqsd, buf_len(c))
        mc_patch_jcc8(c, ja_uqsd, buf_len(c))
        mc_b3(c, 0x49, 0x01, 0xD7)
        mc_patch_jcc8(c, jne_uqs, buf_len(c))
        j_uqs := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_uqs, lp_uqs)
        mc_patch_jcc8(c, jge_uqs_dn, buf_len(c))

        mc_patch_rel32(c, jge_uq_dn, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xF8) // RAX = R15
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_url_query_sum(), s_uq, buf_len(c))
    }

    // 47. `h_ai_lis_patience_seq(seed, len, tails) -> i64`: 2-level AVX2 VPCMPGTD+POPCNT 128-entry stack-resident patience sort + exact i64 spillover!
    if cg_is_helper_used(cg, h_ai_lis_patience_seq()) {
        mc_align16(c)
        s_lis := buf_len(c)
        mc_ai_enter(c, 0x238) // [RSP+0..31]=hdr[8] i32, [RSP+32..543]=tails_i32[128]
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = x = seed
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = len
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = tails (i64 fallback)
        mc_b2(c, 0x49, 0xBB); mc_u64(c, 6364136223846793005) // R11 = LCG mult
        mc_b2(c, 0x49, 0xBC); mc_u64(c, 1442695040888963407) // R12 = LCG inc
        mc_b3(c, 0x45, 0x31, 0xED)       // R13 = tsz = 0
        mc_b3(c, 0x4D, 0x85, 0xC9); jle_lis_dn0 := mc_jcc32(c, 0x8E)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_lis_sc := mc_jcc32(c, 0x84)

        // Pre-fill hdr[0..7] and tails_i32[0..127] with 0x7FFFFFFF (strict `< v` holds identically for all 31-bit v <= 0x7FFFFFFF!)
        mc_b1(c, 0xB8); mc_u32(c, 0x7FFFFFFF)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x6E); mc_b1(c, 0xE0) // VMOVD X4, EAX
        mc_vex256(c, 2, 4, 0, 4, 0x58)                            // VPBROADCASTD Y4, X4
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x24, 0x24) // VMOVDQU [RSP], Y4
        mc_b4(c, 0x4C, 0x8D, 0x74, 0x24); mc_b1(c, 32)            // R14 = RSP + 32
        mc_b2(c, 0x31, 0xC9)
        lp_lisf := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x24, 0x0E) // VMOVDQU [R14+RCX], Y4
        mc_b4(c, 0x48, 0x83, 0xC1, 32); mc_b3(c, 0x48, 0x81, 0xF9); mc_u32(c, 512)
        jl_lisf := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_lisf, lp_lisf)

        mc_align16_nop(c)
        lp_lis_avx := buf_len(c)
        mc_b4(c, 0x4D, 0x0F, 0xAF, 0xC3); mc_b3(c, 0x4D, 0x01, 0xE0) // R8 = R8 * R11 + R12
        mc_b3(c, 0x4C, 0x89, 0xC0); mc_b4(c, 0x48, 0xC1, 0xE8, 33)   // RAX = v = x >> 33 (0..0x7FFFFFFF)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x6E); mc_b1(c, 0xC0)     // VMOVD X0, EAX
        mc_vex256(c, 2, 0, 0, 0, 0x58)                                // VPBROADCASTD Y0, X0
        mc_vex256(c, 1, 1, 0, 4, 0x66)                                // VPCMPGTD Y1, Y0, Y4 (v > hdr[0..7])
        mc_vex2(c, 0, 1, 0, 0x50, 0xF1)                               // VMOVMSKPS ESI, Y1
        mc_b4(c, 0xF3, 0x0F, 0xB8, 0xF6)                              // POPCNT ESI, ESI (block 0..7)
        mc_b3(c, 0xC1, 0xE6, 4)                                       // ESI = block * 16
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x66); mc_b2(c, 0x0C, 0xB6)     // VPCMPGTD Y1, Y0, [R14+RSI*4]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x66); mc_b3(c, 0x54, 0xB6, 32) // VPCMPGTD Y2, Y0, [R14+RSI*4+32]
        mc_vex2(c, 0, 1, 0, 0x50, 0xD1)                               // VMOVMSKPS EDX, Y1
        mc_vex2(c, 0, 1, 0, 0x50, 0xCA)                               // VMOVMSKPS ECX, Y2
        mc_b4(c, 0xF3, 0x0F, 0xB8, 0xD2)                              // POPCNT EDX, EDX
        mc_b4(c, 0xF3, 0x0F, 0xB8, 0xC9)                              // POPCNT ECX, ECX
        mc_b2(c, 0x01, 0xD6); mc_b2(c, 0x01, 0xCE)                    // ESI += EDX + ECX (lo in 0..127)
        mc_b4(c, 0x41, 0x89, 0x04, 0xB6)                              // tails_i32[lo] = v
        // Rare 1/16 update of hdr[lo >> 4] when (lo & 15) == 15
        mc_b2(c, 0x89, 0xF7); mc_b3(c, 0x83, 0xE7, 15); mc_b3(c, 0x83, 0xFF, 15)
        jne_lis_hdr := mc_jcc8(c, 0x75)
        mc_b2(c, 0x89, 0xF7); mc_b3(c, 0xC1, 0xEF, 4)                 // EDI = lo >> 4
        mc_b3(c, 0x89, 0x04, 0xBC)                                    // hdr[EDI] = EAX
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x24, 0x24) // VMOVDQU Y4, [RSP]
        mc_patch_jcc8(c, jne_lis_hdr, buf_len(c))
        mc_b3(c, 0x4C, 0x39, 0xEE); jne_lis_ag := mc_jcc8(c, 0x75)
        mc_b3(c, 0x49, 0xFF, 0xC5)                                    // tsz++
        mc_b3(c, 0x49, 0x81, 0xFD); mc_u32(c, 128); jge_lis_sp := mc_jcc32(c, 0x8D)
        mc_patch_jcc8(c, jne_lis_ag, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC9)
        jnz_lis_avx := mc_jcc32(c, 0x85); mc_patch_rel32(c, jnz_lis_avx, lp_lis_avx)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_lis_done := mc_jmp32(c)

        // Spillover if tsz reaches 128: copy tails_i32[0..127] -> tails_i64[0..127] and continue in scalar loop!
        mc_patch_rel32(c, jge_lis_sp, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC9) // consume current element
        mc_b2(c, 0x31, 0xC9)
        lp_lis_sp := buf_len(c)
        mc_b4(c, 0x41, 0x8B, 0x04, 0x8E) // MOV EAX, [R14+RCX*4] (zero-extends to RAX)
        mc_b4(c, 0x49, 0x89, 0x04, 0xCA) // MOV [R10+RCX*8], RAX
        mc_b3(c, 0x48, 0xFF, 0xC1); mc_b3(c, 0x48, 0x81, 0xF9); mc_u32(c, 128)
        jl_lis_sp := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_lis_sp, lp_lis_sp)
        mc_b3(c, 0xC5, 0xF8, 0x77)

        mc_patch_rel32(c, jz_lis_sc, buf_len(c))
        mc_align16_nop(c)
        lp_lis := buf_len(c)
        mc_b3(c, 0x4D, 0x85, 0xC9); jle_lis_dn := mc_jcc32(c, 0x8E)
        mc_b4(c, 0x4D, 0x0F, 0xAF, 0xC3); mc_b3(c, 0x4D, 0x01, 0xE0)
        mc_b3(c, 0x4C, 0x89, 0xC0); mc_b4(c, 0x48, 0xC1, 0xE8, 33)
        mc_b2(c, 0x31, 0xF6); mc_b3(c, 0x4C, 0x89, 0xEF)
        lp_lis_b := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xFE); jge_lis_bd := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x48, 0x8D, 0x14, 0x3E); mc_b3(c, 0x48, 0xD1, 0xEA)
        mc_b4(c, 0x48, 0x8D, 0x4A, 1)
        mc_b4(c, 0x49, 0x39, 0x04, 0xD2)
        mc_b4(c, 0x48, 0x0F, 0x4C, 0xF1)
        mc_b4(c, 0x48, 0x0F, 0x4D, 0xFA)
        j_lis_b := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_lis_b, lp_lis_b)
        mc_patch_jcc8(c, jge_lis_bd, buf_len(c))
        mc_b4(c, 0x49, 0x89, 0x04, 0xF2)
        mc_b3(c, 0x4C, 0x39, 0xEE); jne_lis_g := mc_jcc8(c, 0x75)
        mc_b3(c, 0x49, 0xFF, 0xC5)
        mc_patch_jcc8(c, jne_lis_g, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC9)
        j_lis := mc_jmp32(c); mc_patch_rel32(c, j_lis, lp_lis)

        mc_patch_rel32(c, jle_lis_dn, buf_len(c))
        mc_patch_rel32(c, jle_lis_dn0, buf_len(c))
        mc_patch_rel32(c, jmp_lis_done, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xE8) // RAX = R13 (tsz)
        mc_ai_leave(c, 0x238)
        cg_reg_helper(cg, h_ai_lis_patience_seq(), s_lis, buf_len(c))
    }

    // 48. `h_ai_morton3d_range(i0, i1) -> i64`: Compact 8-wide VPGATHERDD (L1D 4KB LUT) + 4-wide Reg-Only BMI2 PDEP (12 elems/iter, fits 64-uop LSD!)
    if cg_is_helper_used(cg, h_ai_morton3d_range()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_m3c := buf_len(cg.rdata)
        // [0]: VPSHUFB Step 1 mask: [b0, b1, 0, 0] -> [b0, 0, 0, b1] = (x | (x<<16)) & 0x030000FF (1 insn, Port 5!)
        buf_push_u32(cg.rdata, 0x01808000); buf_push_u32(cg.rdata, 0x05808004)
        buf_push_u32(cg.rdata, 0x09808008); buf_push_u32(cg.rdata, 0x0D80800C)
        buf_push_u32(cg.rdata, 0x01808000); buf_push_u32(cg.rdata, 0x05808004)
        buf_push_u32(cg.rdata, 0x09808008); buf_push_u32(cg.rdata, 0x0D80800C)
        mut mr := 0; while mr < 8 { buf_push_u32(cg.rdata, mr * 13); mr += 1 } // [32]:  x_off
        mr = 0; while mr < 8 { buf_push_u32(cg.rdata, mr * 29); mr += 1 }      // [64]:  y_off
        mr = 0; while mr < 8 { buf_push_u32(cg.rdata, mr * 47); mr += 1 }      // [96]:  z_off
        mr = 0; while mr < 8 { buf_push_u32(cg.rdata, 104); mr += 1 }          // [128]: 8 * 13
        mr = 0; while mr < 8 { buf_push_u32(cg.rdata, 232); mr += 1 }          // [160]: 8 * 29
        mr = 0; while mr < 8 { buf_push_u32(cg.rdata, 376); mr += 1 }          // [192]: 8 * 47
        mr = 0; while mr < 8 { buf_push_u32(cg.rdata, 0x0300F00F); mr += 1 }   // [224]: Y8
        mr = 0; while mr < 8 { buf_push_u32(cg.rdata, 0x030C30C3); mr += 1 }   // [256]: Y9
        mr = 0; while mr < 8 { buf_push_u32(cg.rdata, 0x09249249); mr += 1 }   // [288]: Y10

        mc_align16(c)
        s_m3 := buf_len(c)
        mc_ai_enter(c, 0xD8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = i0
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = i1
        mc_b3(c, 0x45, 0x31, 0xFF)       // R15 = acc = 0
        mc_b3(c, 0x4D, 0x39, 0xC8); jge_m3_dn := mc_jcc32(c, 0x8D)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_m3_sc := mc_jcc32(c, 0x84)
        mc_b3(c, 0x4C, 0x89, 0xC8); mc_b3(c, 0x4C, 0x29, 0xC0)
        mc_b4(c, 0x48, 0x83, 0xF8, 16); jl_m3_sc2 := mc_jcc32(c, 0x8C)

        cg_lea_rax_rdata(cg, roff_m3c); mc_b3(c, 0x49, 0x89, 0xC2) // R10 = &roff_m3c
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b1(c, 0x3A)                   // Y7  = VPSHUFB mask [R10+0]
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b1(c, 0x82); mc_u32(c, 224)   // Y8  = 0x0300F00F
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b1(c, 0x8A); mc_u32(c, 256)   // Y9  = 0x030C30C3
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b1(c, 0x92); mc_u32(c, 288)   // Y10 = 0x09249249

        mc_b4(c, 0x49, 0x6B, 0xC0, 13); mc_b3(c, 0x83, 0xC0, 5)
        mc_b3(c, 0x89, 0x84, 0x24); mc_u32(c, 160)
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x58); mc_b2(c, 0x9C, 0x24); mc_u32(c, 160) // Y11 = bcast(i0*13+5)
        mc_vex3(c, 1, 0, 1, 1, 0, 11, 1, 1, 0xFE); mc_b2(c, 0x5A, 32)                  // Y11 += x_off

        mc_b4(c, 0x49, 0x6B, 0xC0, 29); mc_b3(c, 0x83, 0xC0, 11)
        mc_b3(c, 0x89, 0x84, 0x24); mc_u32(c, 160)
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x58); mc_b2(c, 0xA4, 0x24); mc_u32(c, 160) // Y12 = bcast(i0*29+11)
        mc_vex3(c, 1, 0, 1, 1, 0, 12, 1, 1, 0xFE); mc_b2(c, 0x62, 64)                  // Y12 += y_off

        mc_b4(c, 0x49, 0x6B, 0xC0, 47); mc_b3(c, 0x83, 0xC0, 19)
        mc_b3(c, 0x89, 0x84, 0x24); mc_u32(c, 160)
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x58); mc_b2(c, 0xAC, 0x24); mc_u32(c, 160) // Y13 = bcast(i0*47+19)
        mc_vex3(c, 1, 0, 1, 1, 0, 13, 1, 1, 0xFE); mc_b2(c, 0x6A, 96)                  // Y13 += z_off

        mc_vex256(c, 1, 14, 14, 14, 0xEF)
        mc_vex256(c, 1, 15, 15, 15, 0xEF)
        mc_b4(c, 0x4D, 0x8D, 0x59, 0xF0) // R11 = i1 - 16

        // Pure-AVX2 2x8 (16 elems/iter): VPSHUFB Step 1 + VPSLLD/VPOR/VPAND Steps 2-4 + u32 pair sum!
        mc_align16_nop(c)
        lp_m3 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD8); jg_m3_tl := mc_jcc32(c, 0x8F)
        mut m3p := 0
        while m3p < 2 {
            mc_vex256(c, 2, 0, 11, 7, 0x00)
            mc_vex256(c, 2, 1, 12, 7, 0x00)
            mc_vex256(c, 2, 2, 13, 7, 0x00)
            mc_vex3(c, 1, 0, 1, 1, 0, 11, 1, 1, 0xFE); mc_b1(c, 0x9A); mc_u32(c, 128)
            mc_vex3(c, 1, 0, 1, 1, 0, 12, 1, 1, 0xFE); mc_b1(c, 0xA2); mc_u32(c, 160)
            mc_vex3(c, 1, 0, 1, 1, 0, 13, 1, 1, 0xFE); mc_b1(c, 0xAA); mc_u32(c, 192)
            mc_vex3(c, 0, 0, 0, 1, 0, 3, 1, 1, 0x72); mc_b2(c, 0xF0, 8)
            mc_vex3(c, 0, 0, 0, 1, 0, 4, 1, 1, 0x72); mc_b2(c, 0xF1, 8)
            mc_vex3(c, 0, 0, 0, 1, 0, 5, 1, 1, 0x72); mc_b2(c, 0xF2, 8)
            mc_vex256(c, 1, 0, 0, 3, 0xEB); mc_vex256(c, 1, 1, 1, 4, 0xEB); mc_vex256(c, 1, 2, 2, 5, 0xEB)
            mc_vex256(c, 1, 0, 0, 8, 0xDB); mc_vex256(c, 1, 1, 1, 8, 0xDB); mc_vex256(c, 1, 2, 2, 8, 0xDB)
            mc_vex3(c, 0, 0, 0, 1, 0, 3, 1, 1, 0x72); mc_b2(c, 0xF0, 4)
            mc_vex3(c, 0, 0, 0, 1, 0, 4, 1, 1, 0x72); mc_b2(c, 0xF1, 4)
            mc_vex3(c, 0, 0, 0, 1, 0, 5, 1, 1, 0x72); mc_b2(c, 0xF2, 4)
            mc_vex256(c, 1, 0, 0, 3, 0xEB); mc_vex256(c, 1, 1, 1, 4, 0xEB); mc_vex256(c, 1, 2, 2, 5, 0xEB)
            mc_vex256(c, 1, 0, 0, 9, 0xDB); mc_vex256(c, 1, 1, 1, 9, 0xDB); mc_vex256(c, 1, 2, 2, 9, 0xDB)
            mc_vex3(c, 0, 0, 0, 1, 0, 3, 1, 1, 0x72); mc_b2(c, 0xF0, 2)
            mc_vex3(c, 0, 0, 0, 1, 0, 4, 1, 1, 0x72); mc_b2(c, 0xF1, 2)
            mc_vex3(c, 0, 0, 0, 1, 0, 5, 1, 1, 0x72); mc_b2(c, 0xF2, 2)
            mc_vex256(c, 1, 0, 0, 3, 0xEB); mc_vex256(c, 1, 1, 1, 4, 0xEB); mc_vex256(c, 1, 2, 2, 5, 0xEB)
            mc_vex256(c, 1, 0, 0, 10, 0xDB); mc_vex256(c, 1, 1, 1, 10, 0xDB); mc_vex256(c, 1, 2, 2, 10, 0xDB)
            mc_vex256(c, 1, 1, 1, 1, 0xFE)
            mc_vex3(c, 0, 0, 0, 1, 0, 2, 1, 1, 0x72); mc_b2(c, 0xF2, 2)
            if m3p == 0 {
                mc_vex256(c, 1, 6, 0, 1, 0xEB)
                mc_vex256(c, 1, 6, 6, 2, 0xEB)
            } else {
                mc_vex256(c, 1, 0, 0, 1, 0xEB)
                mc_vex256(c, 1, 0, 0, 2, 0xEB)
                mc_vex256(c, 1, 0, 0, 6, 0xFE)
            }
            m3p += 1
        }
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x35); mc_b1(c, 0xC8)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x39); mc_b2(c, 0xC2, 1)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x35); mc_b1(c, 0xD2)
        mc_vex256(c, 1, 14, 14, 1, 0xD4); mc_vex256(c, 1, 15, 15, 2, 0xD4)
        mc_b4(c, 0x49, 0x83, 0xC0, 16)
        j_m3 := mc_jmp32(c); mc_patch_rel32(c, j_m3, lp_m3)

        mc_patch_rel32(c, jg_m3_tl, buf_len(c))
        mc_vex256(c, 1, 14, 14, 15, 0xD4)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0xB4, 0x24); mc_u32(c, 160)
        mc_b4(c, 0x4C, 0x03, 0xBC, 0x24); mc_u32(c, 160)
        mc_b4(c, 0x4C, 0x03, 0xBC, 0x24); mc_u32(c, 168)
        mc_b4(c, 0x4C, 0x03, 0xBC, 0x24); mc_u32(c, 176)
        mc_b4(c, 0x4C, 0x03, 0xBC, 0x24); mc_u32(c, 184)
        mc_b3(c, 0xC5, 0xF8, 0x77)

        mc_patch_rel32(c, jz_m3_sc, buf_len(c))
        mc_patch_rel32(c, jl_m3_sc2, buf_len(c))
        lp_m3s := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xC8); jge_m3s_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x49, 0x6B, 0xC0, 13); mc_b3(c, 0x83, 0xC0, 5); mc_b1(c, 0x25); mc_u32(c, 1023)
        mc_b2(c, 0x89, 0xC1); mc_b3(c, 0xC1, 0xE1, 16); mc_b2(c, 0x09, 0xC8); mc_b1(c, 0x25); mc_u32(c, 0x030000FF)
        mc_b2(c, 0x89, 0xC1); mc_b3(c, 0xC1, 0xE1, 8);  mc_b2(c, 0x09, 0xC8); mc_b1(c, 0x25); mc_u32(c, 0x0300F00F)
        mc_b2(c, 0x89, 0xC1); mc_b3(c, 0xC1, 0xE1, 4);  mc_b2(c, 0x09, 0xC8); mc_b1(c, 0x25); mc_u32(c, 0x030C30C3)
        mc_b2(c, 0x89, 0xC1); mc_b3(c, 0xC1, 0xE1, 2);  mc_b2(c, 0x09, 0xC8); mc_b1(c, 0x25); mc_u32(c, 0x09249249)
        mc_b2(c, 0x89, 0xC6)
        mc_b4(c, 0x49, 0x6B, 0xC0, 29); mc_b3(c, 0x83, 0xC0, 11); mc_b1(c, 0x25); mc_u32(c, 1023)
        mc_b2(c, 0x89, 0xC1); mc_b3(c, 0xC1, 0xE1, 16); mc_b2(c, 0x09, 0xC8); mc_b1(c, 0x25); mc_u32(c, 0x030000FF)
        mc_b2(c, 0x89, 0xC1); mc_b3(c, 0xC1, 0xE1, 8);  mc_b2(c, 0x09, 0xC8); mc_b1(c, 0x25); mc_u32(c, 0x0300F00F)
        mc_b2(c, 0x89, 0xC1); mc_b3(c, 0xC1, 0xE1, 4);  mc_b2(c, 0x09, 0xC8); mc_b1(c, 0x25); mc_u32(c, 0x030C30C3)
        mc_b2(c, 0x89, 0xC1); mc_b3(c, 0xC1, 0xE1, 2);  mc_b2(c, 0x09, 0xC8); mc_b1(c, 0x25); mc_u32(c, 0x09249249)
        mc_b2(c, 0x01, 0xC0); mc_b2(c, 0x09, 0xC6)
        mc_b4(c, 0x49, 0x6B, 0xC0, 47); mc_b3(c, 0x83, 0xC0, 19); mc_b1(c, 0x25); mc_u32(c, 1023)
        mc_b2(c, 0x89, 0xC1); mc_b3(c, 0xC1, 0xE1, 16); mc_b2(c, 0x09, 0xC8); mc_b1(c, 0x25); mc_u32(c, 0x030000FF)
        mc_b2(c, 0x89, 0xC1); mc_b3(c, 0xC1, 0xE1, 8);  mc_b2(c, 0x09, 0xC8); mc_b1(c, 0x25); mc_u32(c, 0x0300F00F)
        mc_b2(c, 0x89, 0xC1); mc_b3(c, 0xC1, 0xE1, 4);  mc_b2(c, 0x09, 0xC8); mc_b1(c, 0x25); mc_u32(c, 0x030C30C3)
        mc_b2(c, 0x89, 0xC1); mc_b3(c, 0xC1, 0xE1, 2);  mc_b2(c, 0x09, 0xC8); mc_b1(c, 0x25); mc_u32(c, 0x09249249)
        mc_b3(c, 0xC1, 0xE0, 2); mc_b2(c, 0x09, 0xC6)
        mc_b3(c, 0x49, 0x01, 0xF7)
        mc_b3(c, 0x49, 0xFF, 0xC0)
        j_m3s := mc_jmp32(c); mc_patch_rel32(c, j_m3s, lp_m3s)
        mc_patch_rel32(c, jge_m3s_dn, buf_len(c))
        mc_patch_rel32(c, jge_m3_dn, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xF8)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xD8)
        cg_reg_helper(cg, h_ai_morton3d_range(), s_m3, buf_len(c))
    }

    // 49. `h_ai_stats_f64_chunk(mode, pa, i0, i1, x0_f64, out_ptr) -> i64`:
    // 8-wide (2x4 YMM) AVX2 L3-streaming L1+L2 norm (mode=0) & centered variance s1+s2 (mode=1)!
    if cg_is_helper_used(cg, h_ai_stats_f64_chunk()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_st := buf_len(cg.rdata)
        mut sr := 0; while sr < 4 { buf_push_u64(cg.rdata, 0x7FFFFFFFFFFFFFFF); sr += 1 }

        mc_align16(c)
        s_st := buf_len(c)
        mc_ai_enter(c, 0xB8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = mode
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = pa
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = i = i0
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = i1
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b2(c, 0x79, 32) // X15 = x0
        mc_b4(c, 0x4C, 0x8B, 0x61, 40)   // R12 = out_ptr
        mc_b4(c, 0x66, 0x45, 0x0F, 0x57); mc_b1(c, 0xDB) // X11 = 0.0
        mc_b4(c, 0x66, 0x45, 0x0F, 0x57); mc_b1(c, 0xE4) // X12 = 0.0
        mc_b4(c, 0x49, 0x83, 0xF8, 2); je_st_m2 := mc_jcc32(c, 0x84)
        mc_b3(c, 0x4D, 0x39, 0xDA); jge_st_dn := mc_jcc32(c, 0x8D)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_st_sc := mc_jcc32(c, 0x84)
        mc_b3(c, 0x4C, 0x89, 0xD8); mc_b3(c, 0x4C, 0x29, 0xD0)
        mc_b4(c, 0x48, 0x83, 0xF8, 8); jl_st_sc2 := mc_jcc32(c, 0x8C)

        mc_vex256(c, 1, 6, 6, 6, 0x57); mc_vex256(c, 1, 7, 7, 7, 0x57)
        mc_vex256(c, 1, 8, 8, 8, 0x57); mc_vex256(c, 1, 9, 9, 9, 0x57)
        mc_b4(c, 0x4D, 0x8D, 0x6B, 0xF8) // R13 = i1 - 8
        mc_b3(c, 0x4D, 0x85, 0xC0); jnz_st_m1 := mc_jcc32(c, 0x85)

        cg_lea_rax_rdata(cg, roff_st)
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x10) // Y10 = abs_mask
        mc_align16_nop(c)
        lp_st0 := buf_len(c)
        mc_vex3(c, 0, 1, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xD1)
        mc_vex3(c, 0, 1, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x4C, 0xD1, 32)
        mc_vex256(c, 1, 2, 0, 10, 0x54); mc_vex256(c, 1, 3, 1, 10, 0x54)
        mc_vex256(c, 1, 6, 6, 2, 0x58);  mc_vex256(c, 1, 7, 7, 3, 0x58)
        mc_vex256(c, 1, 0, 0, 0, 0x59);  mc_vex256(c, 1, 1, 1, 1, 0x59)
        mc_vex256(c, 1, 8, 8, 0, 0x58);  mc_vex256(c, 1, 9, 9, 1, 0x58)
        mc_b4(c, 0x49, 0x83, 0xC2, 8); mc_b3(c, 0x4D, 0x39, 0xEA)
        jle_st0 := mc_jcc8(c, 0x7E); mc_patch_jcc8(c, jle_st0, lp_st0)
        jmp_st_red := mc_jmp32(c)

        mc_patch_rel32(c, jnz_st_m1, buf_len(c))
        mc_vex256(c, 2, 10, 0, 15, 0x19) // Y10 = bcast(x0)
        mc_align16_nop(c)
        lp_st1 := buf_len(c)
        mc_vex3(c, 0, 1, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xD1)
        mc_vex3(c, 0, 1, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x4C, 0xD1, 32)
        mc_vex256(c, 1, 0, 0, 10, 0x5C); mc_vex256(c, 1, 1, 1, 10, 0x5C)
        mc_vex256(c, 1, 6, 6, 0, 0x58);  mc_vex256(c, 1, 7, 7, 1, 0x58)
        mc_vex256(c, 1, 0, 0, 0, 0x59);  mc_vex256(c, 1, 1, 1, 1, 0x59)
        mc_vex256(c, 1, 8, 8, 0, 0x58);  mc_vex256(c, 1, 9, 9, 1, 0x58)
        mc_b4(c, 0x49, 0x83, 0xC2, 8); mc_b3(c, 0x4D, 0x39, 0xEA)
        jle_st1 := mc_jcc8(c, 0x7E); mc_patch_jcc8(c, jle_st1, lp_st1)

        mc_patch_rel32(c, jmp_st_red, buf_len(c))
        mc_vex256(c, 1, 6, 6, 7, 0x58); mc_vex256(c, 1, 8, 8, 9, 0x58)
        _mc_vhsum_pd_to_xmm0(c, 6); mc_vex3(c, 1, 0, 0, 1, 0, 0, 0, 3, 0x10); mc_b1(c, 0xD8) // X11 = X0
        _mc_vhsum_pd_to_xmm0(c, 8); mc_vex3(c, 1, 0, 0, 1, 0, 0, 0, 3, 0x10); mc_b1(c, 0xE0) // X12 = X0
        mc_b3(c, 0xC5, 0xF8, 0x77)

        mc_patch_rel32(c, jz_st_sc, buf_len(c))
        mc_patch_rel32(c, jl_st_sc2, buf_len(c))
        cg_lea_rax_rdata(cg, roff_st)
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x10); mc_b1(c, 0x10) // X10 = abs_mask
        lp_sts := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xDA); jge_sts_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x43, 0x0F, 0x10); mc_b2(c, 0x04, 0xD1)
        mc_b3(c, 0x4D, 0x85, 0xC0); jnz_sts1 := mc_jcc8(c, 0x75)
        mc_b4(c, 0x66, 0x0F, 0x28, 0xC8); mc_b4(c, 0x66, 0x41, 0x0F, 0x54); mc_b1(c, 0xCA)
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xD9)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xC0); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xE0)
        j_sts_nx := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jnz_sts1, buf_len(c))
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b1(c, 0xC7)
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xD8)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xC0); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xE0)
        mc_patch_jcc8(c, j_sts_nx, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC2); j_sts := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_sts, lp_sts)
        mc_patch_jcc8(c, jge_sts_dn, buf_len(c))
        jmp_st_fin := mc_jmp32(c)

        // Mode 2: 16-wide (4x4 YMM) exact IEEE-754 dot(pa=R9, pb=R10, n=R11) -> [out_ptr=R12]!
        mc_patch_rel32(c, je_st_m2, buf_len(c))
        mc_b2(c, 0x31, 0xC9) // RCX = i = 0
        mc_b3(c, 0x4D, 0x85, 0xDB); jle_m2_dn := mc_jcc32(c, 0x8E)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_m2_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x49, 0x83, 0xFB, 16); jl_m2_sc2 := mc_jcc32(c, 0x8C)
        mc_vex256(c, 1, 6, 6, 6, 0x57); mc_vex256(c, 1, 7, 7, 7, 0x57)
        mc_vex256(c, 1, 8, 8, 8, 0x57); mc_vex256(c, 1, 9, 9, 9, 0x57)
        mc_b4(c, 0x4D, 0x8D, 0x6B, 0xF0) // R13 = n - 16
        mc_align16_nop(c)
        lp_m2 := buf_len(c)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xC9)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x4C, 0xC9, 32)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x54, 0xC9, 64)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x5C, 0xC9, 96)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x59); mc_b2(c, 0x04, 0xCA)
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 1, 1, 0x59); mc_b3(c, 0x4C, 0xCA, 32)
        mc_vex3(c, 0, 0, 1, 1, 0, 2, 1, 1, 0x59); mc_b3(c, 0x54, 0xCA, 64)
        mc_vex3(c, 0, 0, 1, 1, 0, 3, 1, 1, 0x59); mc_b3(c, 0x5C, 0xCA, 96)
        mc_vex256(c, 1, 6, 6, 0, 0x58); mc_vex256(c, 1, 7, 7, 1, 0x58)
        mc_vex256(c, 1, 8, 8, 2, 0x58); mc_vex256(c, 1, 9, 9, 3, 0x58)
        mc_b4(c, 0x48, 0x83, 0xC1, 16); mc_b3(c, 0x4C, 0x39, 0xE9)
        jle_m2 := mc_jcc32(c, 0x8E); mc_patch_rel32(c, jle_m2, lp_m2)
        mc_vex256(c, 1, 6, 6, 7, 0x58); mc_vex256(c, 1, 8, 8, 9, 0x58)
        mc_vex256(c, 1, 6, 6, 8, 0x58)
        _mc_vhsum_pd_to_xmm0(c, 6); mc_vex3(c, 1, 0, 0, 1, 0, 0, 0, 3, 0x10); mc_b1(c, 0xD8)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_patch_rel32(c, jz_m2_sc, buf_len(c))
        mc_patch_rel32(c, jl_m2_sc2, buf_len(c))
        lp_m2s := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD9); jge_m2s := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x04, 0xC9)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x04, 0xCA)
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xD8)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_m2s := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_m2s, lp_m2s)
        mc_patch_jcc8(c, jge_m2s, buf_len(c))
        mc_patch_rel32(c, jle_m2_dn, buf_len(c))

        mc_patch_rel32(c, jmp_st_fin, buf_len(c))
        mc_patch_rel32(c, jge_st_dn, buf_len(c))
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x11); mc_b2(c, 0x1C, 0x24)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x11); mc_b3(c, 0x64, 0x24, 8)
        mc_b2(c, 0x31, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_stats_f64_chunk(), s_st, buf_len(c))
    }

    // 50. `h_ai_bfs_topo_csr(mode, rp, ci, n, arr, q) -> i64`: Zero-spill CSR BFS (mode=0) & Kahn Toposort (mode=1)!
    if cg_is_helper_used(cg, h_ai_bfs_topo_csr()) {
        mc_align16(c)
        s_bt := buf_len(c)
        mc_ai_enter(c, 0x28)
        mc_b3(c, 0x48, 0x8B, 0x01)       // RAX = mode (0=bfs64, 1=topo64, 2=bfs32, 3=topo32)
        mc_b3(c, 0x48, 0x89, 0xC5); mc_b3(c, 0x48, 0xD1, 0xED) // RBP = is_u32 (mode >> 1)
        mc_b4(c, 0x4C, 0x8B, 0x41, 8)    // R8  = rp
        mc_b4(c, 0x4C, 0x8B, 0x49, 16)   // R9  = ci
        mc_b4(c, 0x4C, 0x8B, 0x51, 24)   // R10 = n
        mc_b4(c, 0x4C, 0x8B, 0x59, 32)   // R11 = arr (compact i32[n])
        mc_b4(c, 0x4C, 0x8B, 0x61, 40)   // R12 = q   (compact i32[n])
        mc_b2(c, 0xA8, 0x01); jnz_bt_topo := mc_jcc32(c, 0x85)

        // Mode 0: CSR BFS (compact i32 dist[n] & q[n])
        mc_b2(c, 0x31, 0xC9)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_bfzv_sk := mc_jcc8(c, 0x74)
        mc_b4(c, 0x4D, 0x8D, 0x6A, 0xF0) // R13 = n - 16
        mc_vex256(c, 1, 0, 0, 0, 0x76)   // VPCMPEQD Y0, Y0, Y0 (all -1!)
        lp_bfzv := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE9); jg_bfzv_dn := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x04, 0x8B)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b3(c, 0x44, 0x8B, 32)
        mc_b4(c, 0x48, 0x83, 0xC1, 16); j_bfzv := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_bfzv, lp_bfzv)
        mc_patch_jcc8(c, jg_bfzv_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_patch_jcc8(c, jz_bfzv_sk, buf_len(c))
        mc_b1(c, 0xB8); mc_u32(c, 0xFFFFFFFF)
        lp_bfz := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jge_bfz_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x41, 0x89, 0x04, 0x8B)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_bfz := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_bfz, lp_bfz)
        mc_patch_jcc8(c, jge_bfz_dn, buf_len(c))
        mc_b3(c, 0x41, 0xC7, 0x03); mc_u32(c, 0)       // dist[0] = 0
        mc_b4(c, 0x41, 0xC7, 0x04, 0x24); mc_u32(c, 0) // q[0] = 0
        mc_b3(c, 0x45, 0x31, 0xED)                     // R13 = head = 0
        mc_b2(c, 0x41, 0xBE); mc_u32(c, 1)             // R14 = tail = 1
        mc_b3(c, 0x48, 0x85, 0xED); jz_bfs64 := mc_jcc32(c, 0x84)
        // Compact u32 CSR BFS (half L2/L3 footprint: rp_i32 + ci_i32 + dist_i32 + q_i32!)
        mc_align16_nop(c)
        lp_bfs32 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xF5); jge_bfs32_dn := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4D, 0x39, 0xD6); jge_bfs32_all := mc_jcc32(c, 0x8D) // early exit when tail == n!
        mc_b4(c, 0x43, 0x8B, 0x04, 0xAC)               // EAX = u = q[head]
        mc_b3(c, 0x49, 0xFF, 0xC5)
        mc_b4(c, 0x41, 0x8B, 0x14, 0x83); mc_b2(c, 0xFF, 0xC2) // EDX = nd = dist[u] + 1
        mc_b4(c, 0x41, 0x8B, 0x34, 0x80)               // ESI = e = rp_u32[u]
        mc_b4(c, 0x41, 0x8B, 0x7C, 0x80); mc_b1(c, 4)  // EDI = ee = rp_u32[u+1]
        // Branchless 4-edge unroll when ee == e + 4 and tail + 4 <= n (0 mispredicts, 100% OOB-safe!)
        mc_b4(c, 0x48, 0x8D, 0x5E, 4); mc_b3(c, 0x48, 0x39, 0xFB); jne_b32_e := mc_jcc32(c, 0x85)
        mc_b4(c, 0x49, 0x8D, 0x46, 4); mc_b3(c, 0x4C, 0x39, 0xD0); jg_b32_e := mc_jcc32(c, 0x8F)
        // Edge 0..3 branchless CMOVS
        mc_b4(c, 0x41, 0x8B, 0x0C, 0xB1)
        mc_b4(c, 0x41, 0x8B, 0x1C, 0x8B); mc_b4(c, 0x43, 0x89, 0x0C, 0xB4)
        mc_b2(c, 0x85, 0xDB); mc_b3(c, 0x0F, 0x48, 0xDA); mc_b4(c, 0x41, 0x89, 0x1C, 0x8B)
        mc_b4(c, 0x49, 0x8D, 0x46, 1); mc_b4(c, 0x4C, 0x0F, 0x48, 0xF0)
        mc_b4(c, 0x41, 0x8B, 0x4C, 0xB1); mc_b1(c, 4)
        mc_b4(c, 0x41, 0x8B, 0x1C, 0x8B); mc_b4(c, 0x43, 0x89, 0x0C, 0xB4)
        mc_b2(c, 0x85, 0xDB); mc_b3(c, 0x0F, 0x48, 0xDA); mc_b4(c, 0x41, 0x89, 0x1C, 0x8B)
        mc_b4(c, 0x49, 0x8D, 0x46, 1); mc_b4(c, 0x4C, 0x0F, 0x48, 0xF0)
        mc_b4(c, 0x41, 0x8B, 0x4C, 0xB1); mc_b1(c, 8)
        mc_b4(c, 0x41, 0x8B, 0x1C, 0x8B); mc_b4(c, 0x43, 0x89, 0x0C, 0xB4)
        mc_b2(c, 0x85, 0xDB); mc_b3(c, 0x0F, 0x48, 0xDA); mc_b4(c, 0x41, 0x89, 0x1C, 0x8B)
        mc_b4(c, 0x49, 0x8D, 0x46, 1); mc_b4(c, 0x4C, 0x0F, 0x48, 0xF0)
        mc_b4(c, 0x41, 0x8B, 0x4C, 0xB1); mc_b1(c, 12)
        mc_b4(c, 0x41, 0x8B, 0x1C, 0x8B); mc_b4(c, 0x43, 0x89, 0x0C, 0xB4)
        mc_b2(c, 0x85, 0xDB); mc_b3(c, 0x0F, 0x48, 0xDA); mc_b4(c, 0x41, 0x89, 0x1C, 0x8B)
        mc_b4(c, 0x49, 0x8D, 0x46, 1); mc_b4(c, 0x4C, 0x0F, 0x48, 0xF0)
        j_bfs32_n1 := mc_jmp32(c); mc_patch_rel32(c, j_bfs32_n1, lp_bfs32)
        mc_patch_rel32(c, jne_b32_e, buf_len(c))
        mc_patch_rel32(c, jg_b32_e, buf_len(c))
        lp_b32_e := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xFE); jge_b32_ed := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x41, 0x8B, 0x0C, 0xB1)
        mc_b4(c, 0x41, 0x83, 0x3C, 0x8B); mc_b1(c, 0); jge_b32_sk := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x41, 0x89, 0x14, 0x8B); mc_b4(c, 0x43, 0x89, 0x0C, 0xB4); mc_b3(c, 0x49, 0xFF, 0xC6)
        mc_patch_jcc8(c, jge_b32_sk, buf_len(c))
        mc_b3(c, 0x48, 0xFF, 0xC6); j_b32_e := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_b32_e, lp_b32_e)
        mc_patch_jcc8(c, jge_b32_ed, buf_len(c))
        j_bfs32_n2 := mc_jmp32(c); mc_patch_rel32(c, j_bfs32_n2, lp_bfs32)
        mc_patch_rel32(c, jz_bfs64, buf_len(c))
        mc_align16_nop(c)
        lp_bfs := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xF5); jge_bfs_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x43, 0x8B, 0x04, 0xAC)               // EAX = u = q[head] (zero-ext u32 -> RAX!)
        mc_b3(c, 0x49, 0xFF, 0xC5)
        mc_b4(c, 0x41, 0x8B, 0x14, 0x83); mc_b2(c, 0xFF, 0xC2) // EDX = nd = dist[u] + 1
        mc_b4(c, 0x49, 0x8B, 0x34, 0xC0)               // RSI = e = rp[u]
        mc_b4(c, 0x49, 0x8B, 0x7C, 0xC0); mc_b1(c, 8)  // RDI = ee = rp[u+1]
        lp_bfse := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xFE); jge_bfse_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x8B, 0x0C, 0xF1)               // RCX = v = ci[e]
        mc_b4(c, 0x41, 0x83, 0x3C, 0x8B); mc_b1(c, 0); jge_bfse_sk := mc_jcc8(c, 0x7D) // dist[v] >= 0
        mc_b4(c, 0x41, 0x89, 0x14, 0x8B)               // dist[v] = nd
        mc_b4(c, 0x43, 0x89, 0x0C, 0xB4)               // q[tail] = ECX (v)
        mc_b3(c, 0x49, 0xFF, 0xC6)
        mc_patch_jcc8(c, jge_bfse_sk, buf_len(c))
        mc_b3(c, 0x48, 0xFF, 0xC6); j_bfse := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_bfse, lp_bfse)
        mc_patch_jcc8(c, jge_bfse_dn, buf_len(c))
        j_bfs := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_bfs, lp_bfs)
        mc_patch_jcc8(c, jge_bfs_dn, buf_len(c))
        mc_patch_rel32(c, jge_bfs32_dn, buf_len(c))
        mc_patch_rel32(c, jge_bfs32_all, buf_len(c))
        // Branchless AVX2 8-wide BFS dist sum (VPMAXSD(dist, 0) -> VPMOVSXDQ -> VPADDQ!)
        mc_b2(c, 0x31, 0xC0); mc_b2(c, 0x31, 0xC9)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_bfss_sc := mc_jcc8(c, 0x74)
        mc_b2(c, 0x31, 0xC0)
        mc_b4(c, 0x4D, 0x8D, 0x6A, 0xF8) // R13 = n - 8
        mc_vex256(c, 1, 0, 0, 0, 0xEF)   // Y0 = 0
        mc_vex256(c, 1, 1, 1, 1, 0xEF)   // Y1 = sum_lo = 0
        mc_vex256(c, 1, 2, 2, 2, 0xEF)   // Y2 = sum_hi = 0
        lp_bfssv := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE9); jg_bfssv_dn := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x1C, 0x8B) // Y3 = dist[i..i+7]
        mc_vex256(c, 2, 3, 3, 0, 0x3D)                                  // VPMAXSD Y3, Y3, Y0 (clamps -1 -> 0!)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x25); mc_b1(c, 0xE3)       // VPMOVSXDQ Y4, X3 (lo 4)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x39); mc_b2(c, 0xDD, 1)    // VEXTRACTI128 X5, Y3, 1
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x25); mc_b1(c, 0xED)       // VPMOVSXDQ Y5, X5 (hi 4)
        mc_vex256(c, 1, 1, 1, 4, 0xD4); mc_vex256(c, 1, 2, 2, 5, 0xD4)
        mc_b4(c, 0x48, 0x83, 0xC1, 8); j_bfssv := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_bfssv, lp_bfssv)
        mc_patch_jcc8(c, jg_bfssv_dn, buf_len(c))
        mc_vex256(c, 1, 1, 1, 2, 0xD4)
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x39); mc_b2(c, 0xCA, 1)
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 0, 1, 0xD4); mc_b1(c, 0xCA)
        mc_b4(c, 0xC5, 0xE9, 0x73, 0xD9); mc_b1(c, 8)
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 0, 1, 0xD4); mc_b1(c, 0xCA)
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC8) // MOVQ RAX, X1
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_bfss_tl := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jz_bfss_sc, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_patch_jcc8(c, jmp_bfss_tl, buf_len(c))
        lp_bfss := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jge_bfss_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x63, 0x14, 0x8B); mc_b3(c, 0x48, 0x85, 0xD2); js_bfss := mc_jcc8(c, 0x78)
        mc_b3(c, 0x48, 0x01, 0xD0)
        mc_patch_jcc8(c, js_bfss, buf_len(c))
        mc_b3(c, 0x48, 0xFF, 0xC1); j_bfss := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_bfss, lp_bfss)
        mc_patch_jcc8(c, jge_bfss_dn, buf_len(c))
        jmp_bt_end := mc_jmp32(c)

        // Mode 1: CSR Kahn Toposort (compact i32 indeg[n] & q[n])
        mc_patch_rel32(c, jnz_bt_topo, buf_len(c))
        mc_b2(c, 0x31, 0xC9)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_tpzv_sk := mc_jcc8(c, 0x74)
        mc_b4(c, 0x4D, 0x8D, 0x6A, 0xF0) // R13 = n - 16
        mc_vex256(c, 1, 0, 0, 0, 0xEF)   // VPXOR Y0, Y0, Y0
        lp_tpzv := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE9); jg_tpzv_dn := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x04, 0x8B)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b3(c, 0x44, 0x8B, 32)
        mc_b4(c, 0x48, 0x83, 0xC1, 16); j_tpzv := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_tpzv, lp_tpzv)
        mc_patch_jcc8(c, jg_tpzv_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_patch_jcc8(c, jz_tpzv_sk, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        lp_tpz := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jge_tpz := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x41, 0x89, 0x04, 0x8B)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_tpz := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_tpz, lp_tpz)
        mc_patch_jcc8(c, jge_tpz, buf_len(c))
        mc_b3(c, 0x48, 0x85, 0xED); jz_tpi64 := mc_jcc32(c, 0x84)
        // Compact u32 CSR Toposort Pass 1 (4x unrolled!)
        mc_b4(c, 0x43, 0x8B, 0x34, 0x90) // ESI = tot_e = rp_u32[n]
        mc_b2(c, 0x31, 0xC9)
        mc_b4(c, 0x48, 0x8D, 0x7E, 0xFC) // RDI = tot_e - 4
        lp_tpi32_4 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xF9); jg_tpi32_4 := mc_jcc8(c, 0x7F)
        mc_b4(c, 0x41, 0x8B, 0x04, 0x89); mc_b4(c, 0x41, 0xFF, 0x04, 0x83)
        mc_b4(c, 0x41, 0x8B, 0x54, 0x89); mc_b1(c, 4);  mc_b4(c, 0x41, 0xFF, 0x04, 0x93)
        mc_b4(c, 0x41, 0x8B, 0x44, 0x89); mc_b1(c, 8);  mc_b4(c, 0x41, 0xFF, 0x04, 0x83)
        mc_b4(c, 0x41, 0x8B, 0x54, 0x89); mc_b1(c, 12); mc_b4(c, 0x41, 0xFF, 0x04, 0x93)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); j_tpi32_4 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_tpi32_4, lp_tpi32_4)
        mc_patch_jcc8(c, jg_tpi32_4, buf_len(c))
        lp_tpi32 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xF1); jge_tpi32 := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x41, 0x8B, 0x04, 0x89); mc_b4(c, 0x41, 0xFF, 0x04, 0x83)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_tpi32 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_tpi32, lp_tpi32)
        mc_patch_jcc8(c, jge_tpi32, buf_len(c))
        jmp_tpi_dn := mc_jmp32(c)
        mc_patch_rel32(c, jz_tpi64, buf_len(c))
        mc_b4(c, 0x4B, 0x8B, 0x34, 0xD0) // RSI = tot_e = rp[n]
        mc_b2(c, 0x31, 0xC9)
        mc_b4(c, 0x48, 0x8D, 0x7E, 0xFC) // RDI = tot_e - 4
        lp_tpi4 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xF9); jg_tpi4_dn := mc_jcc8(c, 0x7F)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xC9); mc_b4(c, 0x41, 0xFF, 0x04, 0x83)
        mc_b4(c, 0x49, 0x8B, 0x54, 0xC9); mc_b1(c, 8);  mc_b4(c, 0x41, 0xFF, 0x04, 0x93)
        mc_b4(c, 0x49, 0x8B, 0x44, 0xC9); mc_b1(c, 16); mc_b4(c, 0x41, 0xFF, 0x04, 0x83)
        mc_b4(c, 0x49, 0x8B, 0x54, 0xC9); mc_b1(c, 24); mc_b4(c, 0x41, 0xFF, 0x04, 0x93)
        mc_b4(c, 0x48, 0x83, 0xC1, 4); j_tpi4 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_tpi4, lp_tpi4)
        mc_patch_jcc8(c, jg_tpi4_dn, buf_len(c))
        lp_tpi := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xF1); jge_tpi := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x8B, 0x04, 0xC9)
        mc_b4(c, 0x41, 0xFF, 0x04, 0x83)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_tpi := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_tpi, lp_tpi)
        mc_patch_jcc8(c, jge_tpi, buf_len(c))
        mc_patch_rel32(c, jmp_tpi_dn, buf_len(c))
        // AVX2 8-wide skip-all-nonzero scan for initial zero-indegree queue (B043!)
        mc_b3(c, 0x45, 0x31, 0xED); mc_b3(c, 0x45, 0x31, 0xF6)
        mc_b2(c, 0x31, 0xC9)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_tpqv_sk := mc_jcc8(c, 0x74)
        mc_b4(c, 0x4D, 0x8D, 0x7A, 0xF8) // R15 = n - 8
        mc_vex256(c, 1, 0, 0, 0, 0xEF)   // Y0 = 0
        lp_tpqv := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xF9); jg_tpqv_dn := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x0C, 0x8B) // Y1 = indeg[i..i+7]
        mc_vex256(c, 1, 1, 1, 0, 0x76)                                  // VPCMPEQD Y1, Y1, Y0
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xD7); mc_b1(c, 0xC1)       // VPMOVMSKB EAX, Y1
        mc_b2(c, 0x85, 0xC0); jz_tpqv_nx := mc_jcc8(c, 0x74)           // fast skip 8 non-zero verts in 2 cyc!
        // Extract set lanes via TZCNT/BSF on 4-bit-spaced dword mask (bits 0,4,8,12,16,20,24,28 -> bit >> 2 = lane!)
        mc_b1(c, 0x25); mc_u32(c, 0x11111111)
        lp_tpqv_b := buf_len(c)
        mc_b3(c, 0x0F, 0xBC, 0xD0)       // BSF EDX, EAX
        mc_b3(c, 0x0F, 0xB3, 0xD0)       // BTR EAX, EDX
        mc_b3(c, 0xC1, 0xEA, 2)          // EDX = lane (0..7)
        mc_b2(c, 0x01, 0xCA)             // EDX += ECX (vertex id)
        mc_b4(c, 0x43, 0x89, 0x14, 0xB4); mc_b3(c, 0x49, 0xFF, 0xC6) // q[tail++] = EDX
        mc_b2(c, 0x85, 0xC0); jnz_tpqv_b := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jnz_tpqv_b, lp_tpqv_b)
        mc_patch_jcc8(c, jz_tpqv_nx, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xC1, 8); j_tpqv := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_tpqv, lp_tpqv)
        mc_patch_jcc8(c, jg_tpqv_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_patch_jcc8(c, jz_tpqv_sk, buf_len(c))
        lp_tpq := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jge_tpq := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x41, 0x83, 0x3C, 0x8B); mc_b1(c, 0); jne_tpq := mc_jcc8(c, 0x75)
        mc_b4(c, 0x43, 0x89, 0x0C, 0xB4); mc_b3(c, 0x49, 0xFF, 0xC6)
        mc_patch_jcc8(c, jne_tpq, buf_len(c))
        mc_b3(c, 0x48, 0xFF, 0xC1); j_tpq := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_tpq, lp_tpq)
        mc_patch_jcc8(c, jge_tpq, buf_len(c))
        mc_b3(c, 0x45, 0x31, 0xFF); mc_b1(c, 0xBB); mc_u32(c, 1)
        mc_b3(c, 0x48, 0x85, 0xED); jz_tpk64 := mc_jcc32(c, 0x84)
        // Compact u32 CSR Kahn BFS!
        mc_align16_nop(c)
        lp_tpk32 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xF5); jge_tpk32 := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x43, 0x8B, 0x04, 0xAC); mc_b3(c, 0x49, 0xFF, 0xC5) // EAX = u = q[head++]
        mc_b3(c, 0x48, 0x89, 0xC2); mc_b4(c, 0x48, 0x0F, 0xAF, 0xD3)
        mc_b3(c, 0x49, 0x01, 0xD7); mc_b3(c, 0x48, 0xFF, 0xC3)
        mc_b4(c, 0x41, 0x8B, 0x34, 0x80)               // ESI = rp_u32[u]
        mc_b4(c, 0x41, 0x8B, 0x7C, 0x80); mc_b1(c, 4)  // EDI = rp_u32[u+1]
        mc_b4(c, 0x48, 0x8D, 0x56, 4); mc_b3(c, 0x48, 0x39, 0xFA); jne_t32_e := mc_jcc8(c, 0x75)
        mc_b4(c, 0x41, 0x8B, 0x0C, 0xB1); mc_b4(c, 0x41, 0xFF, 0x0C, 0x8B); jne_t32_0 := mc_jcc8(c, 0x75)
        mc_b4(c, 0x43, 0x89, 0x0C, 0xB4); mc_b3(c, 0x49, 0xFF, 0xC6)
        mc_patch_jcc8(c, jne_t32_0, buf_len(c))
        mc_b4(c, 0x41, 0x8B, 0x4C, 0xB1); mc_b1(c, 4); mc_b4(c, 0x41, 0xFF, 0x0C, 0x8B); jne_t32_1 := mc_jcc8(c, 0x75)
        mc_b4(c, 0x43, 0x89, 0x0C, 0xB4); mc_b3(c, 0x49, 0xFF, 0xC6)
        mc_patch_jcc8(c, jne_t32_1, buf_len(c))
        mc_b4(c, 0x41, 0x8B, 0x4C, 0xB1); mc_b1(c, 8); mc_b4(c, 0x41, 0xFF, 0x0C, 0x8B); jne_t32_2 := mc_jcc8(c, 0x75)
        mc_b4(c, 0x43, 0x89, 0x0C, 0xB4); mc_b3(c, 0x49, 0xFF, 0xC6)
        mc_patch_jcc8(c, jne_t32_2, buf_len(c))
        mc_b4(c, 0x41, 0x8B, 0x4C, 0xB1); mc_b1(c, 12); mc_b4(c, 0x41, 0xFF, 0x0C, 0x8B); jne_t32_3 := mc_jcc8(c, 0x75)
        mc_b4(c, 0x43, 0x89, 0x0C, 0xB4); mc_b3(c, 0x49, 0xFF, 0xC6)
        mc_patch_jcc8(c, jne_t32_3, buf_len(c))
        j_tpk32_1 := mc_jmp32(c); mc_patch_rel32(c, j_tpk32_1, lp_tpk32)
        mc_patch_jcc8(c, jne_t32_e, buf_len(c))
        lp_t32_e := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xFE); jge_t32_ed := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x41, 0x8B, 0x0C, 0xB1)
        mc_b4(c, 0x41, 0xFF, 0x0C, 0x8B); jne_t32_sk := mc_jcc8(c, 0x75)
        mc_b4(c, 0x43, 0x89, 0x0C, 0xB4); mc_b3(c, 0x49, 0xFF, 0xC6)
        mc_patch_jcc8(c, jne_t32_sk, buf_len(c))
        mc_b3(c, 0x48, 0xFF, 0xC6); j_t32_e := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_t32_e, lp_t32_e)
        mc_patch_jcc8(c, jge_t32_ed, buf_len(c))
        j_tpk32_2 := mc_jmp32(c); mc_patch_rel32(c, j_tpk32_2, lp_tpk32)
        mc_patch_rel32(c, jz_tpk64, buf_len(c))
        mc_align16_nop(c)
        lp_tpk := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xF5); jge_tpk := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x43, 0x8B, 0x04, 0xAC); mc_b3(c, 0x49, 0xFF, 0xC5) // EAX = u = q[head++]
        mc_b3(c, 0x48, 0x89, 0xC2); mc_b4(c, 0x48, 0x0F, 0xAF, 0xD3)
        mc_b3(c, 0x49, 0x01, 0xD7); mc_b3(c, 0x48, 0xFF, 0xC3)
        mc_b4(c, 0x49, 0x8B, 0x34, 0xC0)
        mc_b4(c, 0x49, 0x8B, 0x7C, 0xC0); mc_b1(c, 8)
        lp_tpke := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xFE); jge_tpke := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x8B, 0x0C, 0xF1)
        mc_b4(c, 0x41, 0xFF, 0x0C, 0x8B); jne_tpke := mc_jcc8(c, 0x75) // DEC DWORD [R11 + RCX*4]
        mc_b4(c, 0x43, 0x89, 0x0C, 0xB4); mc_b3(c, 0x49, 0xFF, 0xC6)
        mc_patch_jcc8(c, jne_tpke, buf_len(c))
        mc_b3(c, 0x48, 0xFF, 0xC6); j_tpke := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_tpke, lp_tpke)
        mc_patch_jcc8(c, jge_tpke, buf_len(c))
        j_tpk := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_tpk, lp_tpk)
        mc_patch_jcc8(c, jge_tpk, buf_len(c))
        mc_patch_rel32(c, jge_tpk32, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xF8)

        mc_patch_rel32(c, jmp_bt_end, buf_len(c))
        mc_ai_leave(c, 0x28)
        cg_reg_helper(cg, h_ai_bfs_topo_csr(), s_bt, buf_len(c))
    }

    // 51. `h_ai_iota_i64(dst, base, n) -> i64`: 8-wide AVX2 VPADDQ fill dst[k] = base + k!
    if cg_is_helper_used(cg, h_ai_iota_i64()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_io := buf_len(cg.rdata)
        mut ioi := 0; while ioi < 16 { buf_push_u64(cg.rdata, ioi); ioi += 1 }
        buf_push_u64(cg.rdata, 16); buf_push_u64(cg.rdata, 16); buf_push_u64(cg.rdata, 16); buf_push_u64(cg.rdata, 16)

        mc_align16(c)
        s_io := buf_len(c)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = dst
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = base
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = n
        mc_b3(c, 0x48, 0x89, 0xCA)       // RDX = args_ptr
        mc_b2(c, 0x31, 0xC9)             // RCX = i = 0
        mc_b3(c, 0x4D, 0x85, 0xD2); jle_io_dn := mc_jcc32(c, 0x8E)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_io_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x49, 0x83, 0xFA, 16); jl_io_sc2 := mc_jcc32(c, 0x8C)

        cg_lea_rax_rdata(cg, roff_io)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x59); mc_b2(c, 0x42, 8)      // VPBROADCASTQ Y0, [RDX+8]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xD4); mc_b2(c, 0x48, 32)     // Y1 = Y0 + [4..7]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xD4); mc_b2(c, 0x50, 64)     // Y2 = Y0 + [8..11]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xD4); mc_b2(c, 0x58, 96)     // Y3 = Y0 + [12..15]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xD4); mc_b1(c, 0x00)         // Y0 = Y0 + [0..3]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b1(c, 0xA0); mc_u32(c, 128) // Y4 = [16,16,16,16]
        mc_b3(c, 0x4C, 0x89, 0xC0)       // RAX = dst ptr (no SIB -> zero store unlamination!)
        mc_b4(c, 0x4D, 0x8D, 0x5A, 0xF0) // R11 = n - 16
        mc_align16_nop(c)
        lp_io16 := buf_len(c)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b1(c, 0x00)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x48, 32)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x50, 64)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0x58, 96)
        mc_vex256(c, 1, 0, 0, 4, 0xD4); mc_vex256(c, 1, 1, 1, 4, 0xD4)
        mc_vex256(c, 1, 2, 2, 4, 0xD4); mc_vex256(c, 1, 3, 3, 4, 0xD4)
        mc_b2(c, 0x48, 0x05); mc_u32(c, 128)
        mc_b4(c, 0x48, 0x83, 0xC1, 16); mc_b3(c, 0x4C, 0x39, 0xD9)
        jle_io16 := mc_jcc8(c, 0x7E); mc_patch_jcc8(c, jle_io16, lp_io16)
        mc_b3(c, 0xC5, 0xF8, 0x77)

        mc_patch_rel32(c, jz_io_sc, buf_len(c))
        mc_patch_rel32(c, jl_io_sc2, buf_len(c))
        lp_ios := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD1); jge_ios := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x8D, 0x04, 0x09)
        mc_b4(c, 0x49, 0x89, 0x04, 0xC8)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_ios := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_ios, lp_ios)
        mc_patch_jcc8(c, jge_ios, buf_len(c))
        mc_patch_rel32(c, jle_io_dn, buf_len(c))
        mc_b2(c, 0x31, 0xC0); mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_ai_iota_i64(), s_io, buf_len(c))
    }

    // 52. `h_ai_topk_filter_i64(arr, i0, i1, hp) -> i64`: 8-wide AVX2 VPCMPGTQ+VPTEST top-64 min-heap!
    if cg_is_helper_used(cg, h_ai_topk_filter_i64()) {
        mc_align16(c)
        s_tk := buf_len(c)
        mc_ai_enter(c, 0x28)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = arr
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = i = i0
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = i1
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = hp
        mc_b3(c, 0x45, 0x31, 0xE4)       // R12 = sz = 0
        lp_tkf := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_tk_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x49, 0x83, 0xFC, 64); jge_tk_full := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x4B, 0x8B, 0x04, 0xC8)
        mc_b3(c, 0x4C, 0x89, 0xE1); mc_b3(c, 0x49, 0xFF, 0xC4)
        lp_tkup := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xC9); jle_tkup := mc_jcc8(c, 0x7E)
        mc_b4(c, 0x48, 0x8D, 0x51, 0xFF); mc_b3(c, 0x48, 0xD1, 0xEA)
        mc_b4(c, 0x49, 0x8B, 0x34, 0xD3)
        mc_b3(c, 0x48, 0x39, 0xC6); jle_tkup2 := mc_jcc8(c, 0x7E)
        mc_b4(c, 0x49, 0x89, 0x34, 0xCB); mc_b3(c, 0x48, 0x89, 0xD1)
        j_tkup := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_tkup, lp_tkup)
        mc_patch_jcc8(c, jle_tkup, buf_len(c)); mc_patch_jcc8(c, jle_tkup2, buf_len(c))
        mc_b4(c, 0x49, 0x89, 0x04, 0xCB)
        mc_b3(c, 0x49, 0xFF, 0xC1); j_tkf := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_tkf, lp_tkf)

        mc_patch_jcc8(c, jge_tk_full, buf_len(c))
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_tk_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x4D, 0x8D, 0x6A, 0xF0) // R13 = i1 - 16
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x59); mc_b1(c, 0x03) // Y0 = bcast(hp[0])
        mc_align16_nop(c)
        lp_tk8 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xE9); jg_tk_tail := mc_jcc32(c, 0x8F)
        mc_vex3(c, 0, 1, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x0C, 0xC8)
        mc_vex3(c, 0, 1, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x54, 0xC8, 32)
        mc_vex3(c, 0, 1, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x5C, 0xC8, 64)
        mc_vex3(c, 0, 1, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x64, 0xC8, 96)
        mc_vex256(c, 2, 1, 1, 0, 0x37); mc_vex256(c, 2, 2, 2, 0, 0x37)
        mc_vex256(c, 2, 3, 3, 0, 0x37); mc_vex256(c, 2, 4, 4, 0, 0x37)
        mc_vex256(c, 1, 1, 1, 2, 0xEB); mc_vex256(c, 1, 3, 3, 4, 0xEB)
        mc_vex256(c, 1, 1, 1, 3, 0xEB)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x17); mc_b1(c, 0xC9) // VPTEST Y1, Y1
        jnz_tk_hit := mc_jcc8(c, 0x75)
        mc_b4(c, 0x49, 0x83, 0xC1, 16); j_tk8 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_tk8, lp_tk8)

        mc_patch_jcc8(c, jnz_tk_hit, buf_len(c))
        mc_b4(c, 0x4D, 0x8D, 0x71, 16) // R14 = i + 16
        lp_tkh := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xF1); jge_tkh_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x4B, 0x8B, 0x04, 0xC8)
        mc_b3(c, 0x49, 0x3B, 0x03); jle_tkh_sk := mc_jcc8(c, 0x7E)
        mc_b2(c, 0x31, 0xC9)
        lp_tksd := buf_len(c)
        mc_b4(c, 0x48, 0x8D, 0x54, 0x09); mc_b1(c, 1)
        mc_b4(c, 0x48, 0x83, 0xFA, 64); jge_tksd_e := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x8B, 0x34, 0xD3)
        mc_b4(c, 0x48, 0x8D, 0x7A, 1)
        mc_b4(c, 0x48, 0x83, 0xFF, 64); jge_tksd_nr := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x8B, 0x1C, 0xFB)
        mc_b3(c, 0x48, 0x39, 0xF3); jge_tksd_nr2 := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x48, 0x89, 0xFA); mc_b3(c, 0x48, 0x89, 0xDE)
        mc_patch_jcc8(c, jge_tksd_nr, buf_len(c)); mc_patch_jcc8(c, jge_tksd_nr2, buf_len(c))
        mc_b3(c, 0x48, 0x39, 0xF0); jle_tksd_e2 := mc_jcc8(c, 0x7E)
        mc_b4(c, 0x49, 0x89, 0x34, 0xCB); mc_b3(c, 0x48, 0x89, 0xD1)
        j_tksd := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_tksd, lp_tksd)
        mc_patch_jcc8(c, jge_tksd_e, buf_len(c)); mc_patch_jcc8(c, jle_tksd_e2, buf_len(c))
        mc_b4(c, 0x49, 0x89, 0x04, 0xCB)
        mc_patch_jcc8(c, jle_tkh_sk, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC1); j_tkh := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_tkh, lp_tkh)
        mc_patch_jcc8(c, jge_tkh_dn, buf_len(c))
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x59); mc_b1(c, 0x03)
        j_tk8_b := mc_jmp32(c); mc_patch_rel32(c, j_tk8_b, lp_tk8)

        mc_patch_rel32(c, jg_tk_tail, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)

        mc_patch_rel32(c, jz_tk_sc, buf_len(c))
        lp_tks := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_tks_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x4B, 0x8B, 0x04, 0xC8)
        mc_b3(c, 0x49, 0x3B, 0x03); jle_tks_sk := mc_jcc8(c, 0x7E)
        mc_b2(c, 0x31, 0xC9)
        lp_tkss := buf_len(c)
        mc_b4(c, 0x48, 0x8D, 0x54, 0x09); mc_b1(c, 1)
        mc_b4(c, 0x48, 0x83, 0xFA, 64); jge_tkss1 := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x8B, 0x34, 0xD3)
        mc_b4(c, 0x48, 0x8D, 0x7A, 1)
        mc_b4(c, 0x48, 0x83, 0xFF, 64); jge_tkss2 := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x49, 0x8B, 0x1C, 0xFB)
        mc_b3(c, 0x48, 0x39, 0xF3); jge_tkss3 := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x48, 0x89, 0xFA); mc_b3(c, 0x48, 0x89, 0xDE)
        mc_patch_jcc8(c, jge_tkss2, buf_len(c)); mc_patch_jcc8(c, jge_tkss3, buf_len(c))
        mc_b3(c, 0x48, 0x39, 0xF0); jle_tkss4 := mc_jcc8(c, 0x7E)
        mc_b4(c, 0x49, 0x89, 0x34, 0xCB); mc_b3(c, 0x48, 0x89, 0xD1)
        j_tkss := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_tkss, lp_tkss)
        mc_patch_jcc8(c, jge_tkss1, buf_len(c)); mc_patch_jcc8(c, jle_tkss4, buf_len(c))
        mc_b4(c, 0x49, 0x89, 0x04, 0xCB)
        mc_patch_jcc8(c, jle_tks_sk, buf_len(c))
        mc_b3(c, 0x49, 0xFF, 0xC1); j_tks := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_tks, lp_tks)
        mc_patch_jcc8(c, jge_tks_dn, buf_len(c))

        mc_patch_rel32(c, jge_tk_dn, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xE0)
        mc_ai_leave(c, 0x28)
        cg_reg_helper(cg, h_ai_topk_filter_i64(), s_tk, buf_len(c))
    }

    // 53. `h_ai_dmap_op(hdr, key, val_or_def, is_get) -> i64`: Zero-spill leaf DynMap put/get fastpath!
    // is_get==1: returns val (or default_val) directly for ALL keys including sentinels!
    // is_get==0: returns 0 if inserted/updated on fastpath, 1 if _dmap_put_cold needed!
    if cg_is_helper_used(cg, h_ai_dmap_op()) {
        mc_align16(c)
        s_dm := buf_len(c)
        mc_b3(c, 0x48, 0x85, 0xC9); jnz_dm_ok := mc_jcc8(c, 0x75)
        mc_b3(c, 0x4C, 0x89, 0xC0); mc_b1(c, 0xC3)
        mc_patch_jcc8(c, jnz_dm_ok, buf_len(c))

        mc_b2(c, 0x49, 0xBA); mc_u64(c, 0x7F7F7F7F7F7F7F7F) // R10 = emp
        mc_b4(c, 0x49, 0x8D, 0x42, 0xFF)                     // RAX = tmb = emp - 1
        mc_b3(c, 0x48, 0x31, 0xD0); mc_b3(c, 0x48, 0xD1, 0xE8)
        mc_b3(c, 0x48, 0x85, 0xC0); jz_dm_sent := mc_jcc32(c, 0x84)

        mc_b2(c, 0x49, 0xBB); mc_u64(c, 0x517CC1B727220A95)
        mc_b4(c, 0x4C, 0x0F, 0xAF, 0xDA) // IMUL R11, RDX
        mc_b4(c, 0x49, 0xC1, 0xEB, 32)   // SHR R11, 32 (>>36 after <<4 mask!)
        mc_b4(c, 0x48, 0x8B, 0x41, 8)    // RAX = mask = hdr[1]
        mc_b4(c, 0x48, 0xC1, 0xE0, 4)    // RAX = mask_bytes = mask << 4
        mc_b3(c, 0x49, 0x21, 0xC3)       // R11 = byte_off = idx << 4
        mc_b3(c, 0x4D, 0x85, 0xC9); jz_dm_put := mc_jcc8(c, 0x74)

        // GET fastpath (0 push/pop, 0 LEA per probe!)
        mc_b3(c, 0x48, 0x8B, 0x09)
        lp_dmg := buf_len(c)
        mc_b4(c, 0x4A, 0x39, 0x14, 0x19); je_dmg_hit := mc_jcc8(c, 0x74)
        mc_b4(c, 0x4E, 0x39, 0x14, 0x19); je_dmg_miss := mc_jcc8(c, 0x74)
        mc_b4(c, 0x49, 0x83, 0xC3, 16); mc_b3(c, 0x49, 0x21, 0xC3)
        j_dmg := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_dmg, lp_dmg)
        mc_patch_jcc8(c, je_dmg_hit, buf_len(c))
        mc_b4(c, 0x4A, 0x8B, 0x44, 0x19); mc_b1(c, 8); mc_b1(c, 0xC3)
        mc_patch_jcc8(c, je_dmg_miss, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xC0); mc_b1(c, 0xC3)

        // PUT fastpath (0 push/pop, 0 LEA per probe!)
        mc_patch_jcc8(c, jz_dm_put, buf_len(c))
        mc_b4(c, 0x4C, 0x8B, 0x49, 24)
        mc_b4(c, 0x4C, 0x3B, 0x49, 56); jge_dmp_cold := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x4C, 0x3B, 0x49, 16); jne_dmp_cold := mc_jcc8(c, 0x75)
        mc_b3(c, 0x4C, 0x8B, 0x09)
        lp_dmp := buf_len(c)
        mc_b4(c, 0x4F, 0x39, 0x14, 0x19); je_dmp_ins := mc_jcc8(c, 0x74)
        mc_b4(c, 0x4B, 0x39, 0x14, 0x19); je_dmp_upd := mc_jcc8(c, 0x74)
        mc_b4(c, 0x49, 0x83, 0xC3, 16); mc_b3(c, 0x49, 0x21, 0xC3)
        j_dmp := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_dmp, lp_dmp)
        mc_patch_jcc8(c, je_dmp_ins, buf_len(c))
        mc_b4(c, 0x4B, 0x89, 0x14, 0x19)
        mc_b4(c, 0x4F, 0x89, 0x44, 0x19); mc_b1(c, 8)
        mc_b4(c, 0x48, 0xFF, 0x41, 16)
        mc_b4(c, 0x48, 0xFF, 0x41, 24)
        mc_b2(c, 0x31, 0xC0); mc_b1(c, 0xC3)
        mc_patch_jcc8(c, je_dmp_upd, buf_len(c))
        mc_b4(c, 0x4F, 0x89, 0x44, 0x19); mc_b1(c, 8)
        mc_b2(c, 0x31, 0xC0); mc_b1(c, 0xC3)

        // Sentinel handler
        mc_patch_rel32(c, jz_dm_sent, buf_len(c))
        mc_b3(c, 0x4D, 0x85, 0xC9); jz_dm_cold2 := mc_jcc8(c, 0x74)
        mc_b4(c, 0x48, 0x8B, 0x41, 32)
        mc_b3(c, 0x4C, 0x39, 0xD2); jne_dm_stmb := mc_jcc8(c, 0x75)
        mc_b2(c, 0xA8, 0x01); jz_dm_sdef := mc_jcc8(c, 0x74)
        mc_b4(c, 0x48, 0x8B, 0x41, 40); mc_b1(c, 0xC3)
        mc_patch_jcc8(c, jne_dm_stmb, buf_len(c))
        mc_b2(c, 0xA8, 0x02); jz_dm_sdef2 := mc_jcc8(c, 0x74)
        mc_b4(c, 0x48, 0x8B, 0x41, 48); mc_b1(c, 0xC3)
        mc_patch_jcc8(c, jz_dm_sdef, buf_len(c))
        mc_patch_jcc8(c, jz_dm_sdef2, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xC0); mc_b1(c, 0xC3)

        mc_patch_jcc8(c, jge_dmp_cold, buf_len(c))
        mc_patch_jcc8(c, jne_dmp_cold, buf_len(c))
        mc_patch_jcc8(c, jz_dm_cold2, buf_len(c))
        mc_b1(c, 0xB8); mc_u32(c, 1); mc_b1(c, 0xC3)
        cg_reg_helper(cg, h_ai_dmap_op(), s_dm, buf_len(c))
    }

    // 54. `h_ai_base64_rt_chunk(src, enc, dec, t0, t1) -> i64`: Zero-spill L1D-tiled Base64 encode+decode!
    if cg_is_helper_used(cg, h_ai_base64_rt_chunk()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_b64e := buf_len(cg.rdata)
        // 64B standard Base64 alphabet: A-Z (65..90), a-z (97..122), 0-9 (48..57), '+' (43), '/' (47)
        mut bi := 0
        while bi < 26 { buf_push(cg.rdata, 65 + bi); bi += 1 }
        bi = 0; while bi < 26 { buf_push(cg.rdata, 97 + bi); bi += 1 }
        bi = 0; while bi < 10 { buf_push(cg.rdata, 48 + bi); bi += 1 }
        buf_push(cg.rdata, 43); buf_push(cg.rdata, 47)
        // 256B decode LUT at roff_b64e + 64
        mut di := 0
        while di < 256 {
            mut dv := 0
            if di >= 65 and di <= 90 { dv = di - 65 }
            else if di >= 97 and di <= 122 { dv = di - 71 }
            else if di >= 48 and di <= 57 { dv = di + 4 }
            else if di == 43 { dv = 62 }
            else if di == 47 { dv = 63 }
            buf_push(cg.rdata, dv)
            di += 1
        }

        mc_align16(c)
        s_b64 := buf_len(c)
        mc_ai_enter(c, 0x38) // [RSP+0]=etbl, [RSP+8]=dtbl, [RSP+16]=t1
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = src
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = enc
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = dec
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = tb = t0
        mc_b4(c, 0x4C, 0x8B, 0x61, 32)   // R12 = t1
        mc_b4(c, 0x4C, 0x89, 0x64, 0x24); mc_b1(c, 16)
        cg_lea_rax_rdata(cg, roff_b64e)
        mc_b4(c, 0x48, 0x89, 0x04, 0x24) // [RSP+0] = etbl
        mc_b4(c, 0x48, 0x83, 0xC0, 64)
        mc_b4(c, 0x48, 0x89, 0x44, 0x24); mc_b1(c, 8) // [RSP+8] = dtbl

        lp_b64_blk := buf_len(c)
        mc_b4(c, 0x4C, 0x3B, 0x5C, 0x24); mc_b1(c, 16); jge_b64_dn := mc_jcc32(c, 0x8D)
        mc_b3(c, 0x4D, 0x8D, 0xA3); mc_u32(c, 1024) // R12 = te = tb + 1024 (4KB L1D tile)
        mc_b4(c, 0x4C, 0x3B, 0x64, 0x24); mc_b1(c, 16); jle_b64_tok := mc_jcc8(c, 0x7E)
        mc_b4(c, 0x4C, 0x8B, 0x64, 0x24); mc_b1(c, 16)
        mc_patch_jcc8(c, jle_b64_tok, buf_len(c))

        // Phase 1: Encode src[tb*3 .. te*3) -> enc[tb*4 .. te*4) (1 triple = 3B -> 4B via pure regs!)
        mc_b4(c, 0x4B, 0x8D, 0x34, 0x5B) // RSI = si = tb*3
        mc_b3(c, 0x4C, 0x89, 0xDF); mc_b4(c, 0x48, 0xC1, 0xE7, 2) // RDI = ei = tb*4
        mc_b4(c, 0x4F, 0x8D, 0x2C, 0x64) // R13 = end_s = te*3
        mc_b4(c, 0x4C, 0x8B, 0x34, 0x24) // R14 = etbl
        mc_align16_nop(c)
        lp_b64_enc := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xEE); jge_b64_ed := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x04); mc_b1(c, 0x30)           // EAX = src[si]
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x54); mc_b2(c, 0x30, 1)        // EDX = src[si+1]
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x4C); mc_b2(c, 0x30, 2)        // ECX = src[si+2]
        mc_b3(c, 0xC1, 0xE0, 16); mc_b3(c, 0xC1, 0xE2, 8); mc_b2(c, 0x09, 0xD0); mc_b2(c, 0x09, 0xC8) // EAX = v
        mc_b2(c, 0x89, 0xC2); mc_b3(c, 0xC1, 0xEA, 18); mc_b3(c, 0x83, 0xE2, 63)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x1C); mc_b1(c, 0x16)           // EBX = etbl[v>>18]
        mc_b2(c, 0x89, 0xC2); mc_b3(c, 0xC1, 0xEA, 12); mc_b3(c, 0x83, 0xE2, 63)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x0C); mc_b1(c, 0x16); mc_b3(c, 0xC1, 0xE1, 8); mc_b2(c, 0x09, 0xCB)
        mc_b2(c, 0x89, 0xC2); mc_b3(c, 0xC1, 0xEA, 6);  mc_b3(c, 0x83, 0xE2, 63)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x0C); mc_b1(c, 0x16); mc_b3(c, 0xC1, 0xE1, 16); mc_b2(c, 0x09, 0xCB)
        mc_b3(c, 0x83, 0xE0, 63)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x0C); mc_b1(c, 0x06); mc_b3(c, 0xC1, 0xE1, 24); mc_b2(c, 0x09, 0xCB)
        mc_b4(c, 0x41, 0x89, 0x1C, 0x39)                           // DWORD [R9+RDI] = EBX (4B store!)
        mc_b4(c, 0x48, 0x83, 0xC6, 3); mc_b4(c, 0x48, 0x83, 0xC7, 4)
        j_b64e := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_b64e, lp_b64_enc)
        mc_patch_jcc8(c, jge_b64_ed, buf_len(c))

        // Phase 2: Decode enc[tb*4 .. te*4) -> dec[tb*3 .. te*3) (1 quad = 4B -> 3B, 100% L1D hot!)
        mc_b4(c, 0x4B, 0x8D, 0x34, 0x5B)                           // RSI = di = tb*3
        mc_b3(c, 0x4C, 0x89, 0xDF); mc_b4(c, 0x48, 0xC1, 0xE7, 2)  // RDI = ei = tb*4
        mc_b4(c, 0x4C, 0x8B, 0x74, 0x24); mc_b1(c, 8)              // R14 = dtbl
        mc_align16_nop(c)
        lp_b64_dec := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xEE); jge_b64_dd := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x41, 0x8B, 0x04, 0x39)                           // EAX = 4B from enc[ei]
        mc_b2(c, 0x0F, 0xB6); mc_b1(c, 0xD0)                       // EDX = AL
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x1C); mc_b1(c, 0x16); mc_b3(c, 0xC1, 0xE3, 18) // EBX = dtbl[b0]<<18
        mc_b3(c, 0xC1, 0xE8, 8); mc_b2(c, 0x0F, 0xB6); mc_b1(c, 0xD0)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x0C); mc_b1(c, 0x16); mc_b3(c, 0xC1, 0xE1, 12); mc_b2(c, 0x09, 0xCB)
        mc_b3(c, 0xC1, 0xE8, 8); mc_b2(c, 0x0F, 0xB6); mc_b1(c, 0xD0)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x0C); mc_b1(c, 0x16); mc_b3(c, 0xC1, 0xE1, 6);  mc_b2(c, 0x09, 0xCB)
        mc_b3(c, 0xC1, 0xE8, 8)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x0C); mc_b1(c, 0x06); mc_b2(c, 0x09, 0xCB)     // EBX = 24-bit val
        mc_b2(c, 0x89, 0xD8); mc_b3(c, 0xC1, 0xE8, 16); mc_b4(c, 0x41, 0x88, 0x04, 0x32) // dec[di] = v>>16
        mc_b2(c, 0x89, 0xD8); mc_b3(c, 0xC1, 0xE8, 8);  mc_b4(c, 0x41, 0x88, 0x44, 0x32); mc_b1(c, 1) // dec[di+1]
        mc_b4(c, 0x41, 0x88, 0x5C, 0x32); mc_b1(c, 2)                                    // dec[di+2]
        mc_b4(c, 0x48, 0x83, 0xC6, 3); mc_b4(c, 0x48, 0x83, 0xC7, 4)
        j_b64d := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_b64d, lp_b64_dec)
        mc_patch_jcc8(c, jge_b64_dd, buf_len(c))

        mc_b3(c, 0x4D, 0x89, 0xE3) // tb = te
        j_b64b := mc_jmp32(c); mc_patch_rel32(c, j_b64b, lp_b64_blk)
        mc_patch_rel32(c, jge_b64_dn, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_ai_leave(c, 0x38)
        cg_reg_helper(cg, h_ai_base64_rt_chunk(), s_b64, buf_len(c))
    }

    // 55. `h_ai_json_scan_chunk(p, pos, end) -> i64`: 32B AVX2 VPCMPEQB(':') + VPMOVMSKB + BSF JSON record scanner!
    if cg_is_helper_used(cg, h_ai_json_scan_chunk()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_js := buf_len(cg.rdata)
        mut jr := 0; while jr < 4 { buf_push_u64(cg.rdata, 0x3A3A3A3A3A3A3A3A); jr += 1 } // ':' (58) x 32
        jr = 0; while jr < 4 { buf_push_u64(cg.rdata, 0x0A0A0A0A0A0A0A0A); jr += 1 }      // LF (10) x 32

        mc_align16(c)
        s_js := buf_len(c)
        mc_ai_enter(c, 0x28)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = p
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = pos
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = end
        mc_b3(c, 0x45, 0x31, 0xFF)       // R15 = acc = 0
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_js_dn := mc_jcc32(c, 0x8D)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_js_sc := mc_jcc32(c, 0x84)
        cg_lea_rax_rdata(cg, roff_js)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b1(c, 0x00)     // Y0 = ':' x 32
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x50, 32) // Y2 = ' ' x 32
        mc_b4(c, 0x4D, 0x8D, 0x5A, 0xE0) // R11 = end - 32

        mc_align16_nop(c)
        lp_js := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD9); jg_js_tail := mc_jcc32(c, 0x8F)
        // Find 1st ':' (id)
        lp_jsc1 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD9); jg_js_tail2 := mc_jcc32(c, 0x8F)
        mc_vex3(c, 0, 1, 1, 1, 0, 0, 1, 1, 0x74); mc_b2(c, 0x0C, 0x08) // VPCMPEQB Y1, Y0, [R8+R9]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xD7); mc_b1(c, 0xC1)       // VPMOVMSKB EAX, Y1
        mc_b2(c, 0x85, 0xC0); jnz_jsc1 := mc_jcc8(c, 0x75)
        mc_b4(c, 0x49, 0x83, 0xC1, 32); j_jsc1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_jsc1, lp_jsc1)
        mc_patch_jcc8(c, jnz_jsc1, buf_len(c))
        mc_b3(c, 0x0F, 0xBC, 0xC8)
        mc_b4(c, 0x4D, 0x8D, 0x4C, 0x09); mc_b1(c, 1) // R9 = R9 + RCX + 1
        // Parse decimal id -> RDX, add to R15
        mc_b2(c, 0x31, 0xD2)
        lp_jsd1 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_jsd1 := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x43, 0x0F, 0xB6, 0x04); mc_b1(c, 0x08)
        mc_b3(c, 0x83, 0xE8, 48); mc_b3(c, 0x83, 0xF8, 9); ja_jsd1 := mc_jcc8(c, 0x77)
        mc_b4(c, 0x48, 0x8D, 0x14, 0x92); mc_b4(c, 0x48, 0x8D, 0x14, 0x50)
        mc_b3(c, 0x49, 0xFF, 0xC1); j_jsd1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_jsd1, lp_jsd1)
        mc_patch_jcc8(c, jge_jsd1, buf_len(c)); mc_patch_jcc8(c, ja_jsd1, buf_len(c))
        mc_b3(c, 0x49, 0x01, 0xD7) // acc += id
        // Find 2nd ':' (val) — usually within 10 bytes!
        lp_jsc2 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_js_vzu := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x43, 0x0F, 0xB6, 0x04); mc_b1(c, 0x08)
        mc_b3(c, 0x49, 0xFF, 0xC1)
        mc_b3(c, 0x83, 0xF8, 58); jne_jsc2 := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jne_jsc2, lp_jsc2)
        mc_b2(c, 0x31, 0xD2)
        lp_jsd2 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_jsd2 := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x43, 0x0F, 0xB6, 0x04); mc_b1(c, 0x08)
        mc_b3(c, 0x83, 0xE8, 48); mc_b3(c, 0x83, 0xF8, 9); ja_jsd2 := mc_jcc8(c, 0x77)
        mc_b4(c, 0x48, 0x8D, 0x14, 0x92); mc_b4(c, 0x48, 0x8D, 0x14, 0x50)
        mc_b3(c, 0x49, 0xFF, 0xC1); j_jsd2 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_jsd2, lp_jsd2)
        mc_patch_jcc8(c, jge_jsd2, buf_len(c)); mc_patch_jcc8(c, ja_jsd2, buf_len(c))
        mc_b3(c, 0x49, 0x01, 0xD7) // acc += val
        // Skip to LF + 1 via 32B AVX2 VPCMPEQB(LF)!
        lp_jsnl := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD9); jg_jsnl_sc := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 1, 1, 1, 0, 2, 1, 1, 0x74); mc_b2(c, 0x0C, 0x08) // VPCMPEQB Y1, Y2, [R8+R9]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xD7); mc_b1(c, 0xC1)
        mc_b2(c, 0x85, 0xC0); jnz_jsnl := mc_jcc8(c, 0x75)
        mc_b4(c, 0x49, 0x83, 0xC1, 32); j_jsnl := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_jsnl, lp_jsnl)
        mc_patch_jcc8(c, jnz_jsnl, buf_len(c))
        mc_b3(c, 0x0F, 0xBC, 0xC8); mc_b4(c, 0x4D, 0x8D, 0x4C, 0x09); mc_b1(c, 1)
        j_js_nx := mc_jmp32(c); mc_patch_rel32(c, j_js_nx, lp_js)
        mc_patch_jcc8(c, jg_jsnl_sc, buf_len(c))
        lp_jsnl_s := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_js_vzu2 := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x43, 0x0F, 0xB6, 0x04); mc_b1(c, 0x08); mc_b3(c, 0x49, 0xFF, 0xC1)
        mc_b3(c, 0x83, 0xF8, 10); jne_jsnls := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jne_jsnls, lp_jsnl_s)
        j_js_nx2 := mc_jmp32(c); mc_patch_rel32(c, j_js_nx2, lp_js)

        mc_patch_rel32(c, jg_js_tail, buf_len(c))
        mc_patch_rel32(c, jg_js_tail2, buf_len(c))
        mc_patch_rel32(c, jge_js_vzu, buf_len(c))
        mc_patch_rel32(c, jge_js_vzu2, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)

        // Scalar tail & --simd=scalar fallback
        mc_patch_rel32(c, jz_js_sc, buf_len(c))
        lp_jss := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_jss_dn := mc_jcc32(c, 0x8D)
        lp_jssc1 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_jss_dn2 := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x43, 0x0F, 0xB6, 0x04); mc_b1(c, 0x08); mc_b3(c, 0x49, 0xFF, 0xC1)
        mc_b3(c, 0x83, 0xF8, 58); jne_jssc1 := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jne_jssc1, lp_jssc1)
        mc_b2(c, 0x31, 0xD2)
        lp_jssd1 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_jssd1 := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x43, 0x0F, 0xB6, 0x04); mc_b1(c, 0x08)
        mc_b3(c, 0x83, 0xE8, 48); mc_b3(c, 0x83, 0xF8, 9); ja_jssd1 := mc_jcc8(c, 0x77)
        mc_b4(c, 0x48, 0x8D, 0x14, 0x92); mc_b4(c, 0x48, 0x8D, 0x14, 0x50)
        mc_b3(c, 0x49, 0xFF, 0xC1); j_jssd1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_jssd1, lp_jssd1)
        mc_patch_jcc8(c, jge_jssd1, buf_len(c)); mc_patch_jcc8(c, ja_jssd1, buf_len(c))
        mc_b3(c, 0x49, 0x01, 0xD7)
        lp_jssc2 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_jss_dn3 := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x43, 0x0F, 0xB6, 0x04); mc_b1(c, 0x08); mc_b3(c, 0x49, 0xFF, 0xC1)
        mc_b3(c, 0x83, 0xF8, 58); jne_jssc2 := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jne_jssc2, lp_jssc2)
        mc_b2(c, 0x31, 0xD2)
        lp_jssd2 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_jssd2 := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x43, 0x0F, 0xB6, 0x04); mc_b1(c, 0x08)
        mc_b3(c, 0x83, 0xE8, 48); mc_b3(c, 0x83, 0xF8, 9); ja_jssd2 := mc_jcc8(c, 0x77)
        mc_b4(c, 0x48, 0x8D, 0x14, 0x92); mc_b4(c, 0x48, 0x8D, 0x14, 0x50)
        mc_b3(c, 0x49, 0xFF, 0xC1); j_jssd2 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_jssd2, lp_jssd2)
        mc_patch_jcc8(c, jge_jssd2, buf_len(c)); mc_patch_jcc8(c, ja_jssd2, buf_len(c))
        mc_b3(c, 0x49, 0x01, 0xD7)
        lp_jssnl := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_jss_dn4 := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x43, 0x0F, 0xB6, 0x04); mc_b1(c, 0x08); mc_b3(c, 0x49, 0xFF, 0xC1)
        mc_b3(c, 0x83, 0xF8, 10); jne_jssnl := mc_jcc8(c, 0x75); mc_patch_jcc8(c, jne_jssnl, lp_jssnl)
        j_jss := mc_jmp32(c); mc_patch_rel32(c, j_jss, lp_jss)

        mc_patch_rel32(c, jge_jss_dn, buf_len(c)); mc_patch_rel32(c, jge_jss_dn2, buf_len(c))
        mc_patch_rel32(c, jge_jss_dn3, buf_len(c)); mc_patch_rel32(c, jge_jss_dn4, buf_len(c))
        mc_patch_rel32(c, jge_js_dn, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xF8)
        mc_ai_leave(c, 0x28)
        cg_reg_helper(cg, h_ai_json_scan_chunk(), s_js, buf_len(c))
    }

    // 56. `h_ai_crc32_slice(p, n) -> i64`: Slice-by-8 IEEE 802.3 CRC-32 (8KB L1D table, 8B/iter)!
    if cg_is_helper_used(cg, h_ai_crc32_slice()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_crc_k := buf_len(cg.rdata)
        // Intel reflected IEEE 802.3 PCLMULQDQ folding constants (verified bit-exact vs zlib!)
        buf_push_u64(cg.rdata, 0x0000000154442BD4); buf_push_u64(cg.rdata, 0x00000001C6E41596) // [0]:  k1, k2 (64B fold)
        buf_push_u64(cg.rdata, 0x00000001751997D0); buf_push_u64(cg.rdata, 0x00000000CCAA009E) // [16]: k3, k4 (16B fold)
        buf_push_u64(cg.rdata, 0x0000000163CD6124); buf_push_u64(cg.rdata, 0x0000000000000000) // [32]: k5, 0
        buf_push_u64(cg.rdata, 0x00000001F7011641); buf_push_u64(cg.rdata, 0x00000001DB710641) // [48]: u', P' (Barrett)
        buf_push_u64(cg.rdata, 0x00000000FFFFFFFF); buf_push_u64(cg.rdata, 0x0000000000000000) // [64]: mask32 / init
        roff_crc := buf_len(cg.rdata)
        // Generate 8 x 256 u32 Slice-by-8 tables for small slices & --simd=scalar
        mut ct0 := ibuf_new(256)
        mut ci := 0
        while ci < 256 {
            mut cval := ci
            mut cb := 0
            while cb < 8 {
                if (cval & 1) != 0 { cval = ushr64(cval, 1) ^ 0xEDB88320 }
                else { cval = ushr64(cval, 1) }
                cb += 1
            }
            ibuf_push(ct0, cval)
            buf_push_u32(cg.rdata, cval)
            ci += 1
        }
        mut prev_t := ibuf_new(256)
        ci = 0; while ci < 256 { ibuf_push(prev_t, ibuf_get(ct0, ci)); ci += 1 }
        mut sl := 1
        while sl < 8 {
            ci = 0
            while ci < 256 {
                pv := ibuf_get(prev_t, ci)
                nv := ushr64(pv, 8) ^ ibuf_get(ct0, pv & 255)
                ibuf_set(prev_t, ci, nv)
                buf_push_u32(cg.rdata, nv)
                ci += 1
            }
            sl += 1
        }
        buf_free(move ct0); buf_free(move prev_t)

        mc_align16(c)
        s_crc := buf_len(c)
        mc_ai_enter(c, 0xB8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = p
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = n
        mc_b1(c, 0xB8); mc_u32(c, 0xFFFFFFFF) // EAX = 0xFFFFFFFF
        mc_b3(c, 0x4D, 0x85, 0xC9); jle_crc_dn := mc_jcc32(c, 0x8E)
        cg_lea_rax_rdata(cg, roff_crc); mc_b3(c, 0x49, 0x89, 0xC2) // R10 = T0
        mc_b1(c, 0xB8); mc_u32(c, 0xFFFFFFFF)
        mc_b2(c, 0x31, 0xC9) // RCX = i = 0

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_crc_sb8 := mc_jcc32(c, 0x84)
        mc_b3(c, 0x49, 0x81, 0xF9); mc_u32(c, 128); jl_crc_sb8b := mc_jcc32(c, 0x8C)

        // ===== 4-stream 64B/iter VPCLMULQDQ hardware CRC32 =====
        cg_lea_rax_rdata(cg, roff_crc_k); mc_b3(c, 0x49, 0x89, 0xC4) // R12 = &k_consts
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 0, 2, 0x6F); mc_b2(c, 0x04, 0x24)     // X8  = [k1, k2]
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 0, 2, 0x6F); mc_b3(c, 0x4C, 0x24, 16) // X9  = [k3, k4]
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 0, 2, 0x6F); mc_b3(c, 0x54, 0x24, 32) // X10 = [k5, 0]
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 0, 2, 0x6F); mc_b3(c, 0x5C, 0x24, 48) // X11 = [u', P']
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 0, 2, 0x6F); mc_b3(c, 0x64, 0x24, 64) // X12 = [0xFFFFFFFF, 0]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 2, 0x6F); mc_b1(c, 0x00)           // X0 = [R8+0]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 1, 0xEF); mc_b1(c, 0xC4)           // VPXOR X0, X0, X12 (init crc^=0xFFFFFFFF)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 2, 0x6F); mc_b2(c, 0x48, 16)       // X1 = [R8+16]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 2, 0x6F); mc_b2(c, 0x50, 32)       // X2 = [R8+32]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 2, 0x6F); mc_b2(c, 0x58, 48)       // X3 = [R8+48]
        mc_b1(c, 0xB9); mc_u32(c, 64)                                       // RCX = 64
        mc_b4(c, 0x4D, 0x8D, 0x59, 0xC0)                                    // R11 = n - 64
        mc_align16_nop(c)
        lp_clm64 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD9); jg_clm16 := mc_jcc32(c, 0x8F)
        // Fold all 4 streams (64 bytes in 16 instructions!)
        mc_vex3(c, 0, 0, 1, 3, 0, 0, 0, 1, 0x44); mc_b2(c, 0xE0, 0x11) // X4 = clmul(X0.hi, k2)
        mc_vex3(c, 0, 0, 1, 3, 0, 0, 0, 1, 0x44); mc_b2(c, 0xC0, 0x00) // X0 = clmul(X0.lo, k1)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0xEF); mc_b1(c, 0xC4)       // X0 ^= X4
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 1, 0xEF); mc_b2(c, 0x04, 0x08) // X0 ^= [R8+RCX]

        mc_vex3(c, 0, 0, 1, 3, 0, 1, 0, 1, 0x44); mc_b2(c, 0xE8, 0x11)
        mc_vex3(c, 0, 0, 1, 3, 0, 1, 0, 1, 0x44); mc_b2(c, 0xC8, 0x00)
        mc_vex3(c, 0, 0, 0, 1, 0, 1, 0, 1, 0xEF); mc_b1(c, 0xCD)
        mc_vex3(c, 0, 0, 1, 1, 0, 1, 0, 1, 0xEF); mc_b3(c, 0x4C, 0x08, 16)

        mc_vex3(c, 0, 0, 1, 3, 0, 2, 0, 1, 0x44); mc_b2(c, 0xF0, 0x11)
        mc_vex3(c, 0, 0, 1, 3, 0, 2, 0, 1, 0x44); mc_b2(c, 0xD0, 0x00)
        mc_vex3(c, 0, 0, 0, 1, 0, 2, 0, 1, 0xEF); mc_b1(c, 0xD6)
        mc_vex3(c, 0, 0, 1, 1, 0, 2, 0, 1, 0xEF); mc_b3(c, 0x54, 0x08, 32)

        mc_vex3(c, 0, 0, 1, 3, 0, 3, 0, 1, 0x44); mc_b2(c, 0xF8, 0x11)
        mc_vex3(c, 0, 0, 1, 3, 0, 3, 0, 1, 0x44); mc_b2(c, 0xD8, 0x00)
        mc_vex3(c, 0, 0, 0, 1, 0, 3, 0, 1, 0xEF); mc_b1(c, 0xDF)
        mc_vex3(c, 0, 0, 1, 1, 0, 3, 0, 1, 0xEF); mc_b3(c, 0x5C, 0x08, 48)

        mc_b4(c, 0x48, 0x83, 0xC1, 64); j_clm64 := mc_jmp32(c); mc_patch_rel32(c, j_clm64, lp_clm64)

        // Fold 4 -> 1 (X0 -> X1 -> X2 -> X3) with X9=[k3, k4]
        mc_patch_rel32(c, jg_clm16, buf_len(c))
        mc_vex3(c, 0, 0, 1, 3, 0, 0, 0, 1, 0x44); mc_b2(c, 0xE1, 0x11)
        mc_vex3(c, 0, 0, 1, 3, 0, 0, 0, 1, 0x44); mc_b2(c, 0xC1, 0x00)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0xEF); mc_b1(c, 0xC4)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0xEF); mc_b1(c, 0xC1) // X0 ^= X1

        mc_vex3(c, 0, 0, 1, 3, 0, 0, 0, 1, 0x44); mc_b2(c, 0xE1, 0x11)
        mc_vex3(c, 0, 0, 1, 3, 0, 0, 0, 1, 0x44); mc_b2(c, 0xC1, 0x00)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0xEF); mc_b1(c, 0xC4)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0xEF); mc_b1(c, 0xC2) // X0 ^= X2

        mc_vex3(c, 0, 0, 1, 3, 0, 0, 0, 1, 0x44); mc_b2(c, 0xE1, 0x11)
        mc_vex3(c, 0, 0, 1, 3, 0, 0, 0, 1, 0x44); mc_b2(c, 0xC1, 0x00)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0xEF); mc_b1(c, 0xC4)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0xEF); mc_b1(c, 0xC3) // X0 ^= X3

        // Fold remaining 16B chunks
        mc_b4(c, 0x4D, 0x8D, 0x59, 0xF0) // R11 = n - 16
        lp_clm16 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD9); jg_clm_rd := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 1, 3, 0, 0, 0, 1, 0x44); mc_b2(c, 0xE1, 0x11)
        mc_vex3(c, 0, 0, 1, 3, 0, 0, 0, 1, 0x44); mc_b2(c, 0xC1, 0x00)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0xEF); mc_b1(c, 0xC4)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 1, 0xEF); mc_b2(c, 0x04, 0x08)
        mc_b4(c, 0x48, 0x83, 0xC1, 16); j_clm16 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_clm16, lp_clm16)
        mc_patch_jcc8(c, jg_clm_rd, buf_len(c))

        // Fold 128b -> 64b -> Barrett 32b (exact match with Python verified sim!)
        mc_vex3(c, 0, 0, 1, 3, 0, 0, 0, 1, 0x44); mc_b2(c, 0xE1, 0x10) // X4 = X0.lo * k4
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x73); mc_b2(c, 0xD8, 8)    // VPSRLDQ X0, X0, 8 (hi64 -> lo64)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0xEF); mc_b1(c, 0xC4)       // X0 = X4 ^ (X0 >> 64)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 1, 0xDB); mc_b1(c, 0xE4)       // VPAND X4, X0, X12 (lo32)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x73); mc_b2(c, 0xD8, 4)    // VPSRLDQ X0, X0, 4 (hi96)
        mc_vex3(c, 0, 0, 1, 3, 0, 4, 0, 1, 0x44); mc_b2(c, 0xE2, 0x00) // X4 = lo32 * k5 (X10)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0xEF); mc_b1(c, 0xC4)       // X0 ^= X4
        // Barrett reduction: t1 = (X0 & mask32) * u'; t2 = (t1 & mask32) * P'; crc = (X0 ^ t2).dword[1]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 1, 0xDB); mc_b1(c, 0xE4)       // X4 = X0 & mask32
        mc_vex3(c, 0, 0, 1, 3, 0, 4, 0, 1, 0x44); mc_b2(c, 0xE3, 0x00) // X4 = t1 = lo32 * u' (X11.lo)
        mc_vex3(c, 0, 0, 1, 1, 0, 4, 0, 1, 0xDB); mc_b1(c, 0xE4)       // X4 &= mask32
        mc_vex3(c, 0, 0, 1, 3, 0, 4, 0, 1, 0x44); mc_b2(c, 0xE3, 0x10) // X4 = t2 = lo32 * P' (X11.hi)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0xEF); mc_b1(c, 0xC4)       // X0 ^= X4
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 0, 1, 0x16); mc_b2(c, 0xC0, 1)    // VPEXTRD EAX, X0, 1 (raw un-inverted CRC!)
        jmp_crc_tl1 := mc_jmp32(c)

        // Slice-by-8 fallback (n < 128 or --simd=scalar)
        mc_patch_rel32(c, jz_crc_sb8, buf_len(c))
        mc_patch_rel32(c, jl_crc_sb8b, buf_len(c))
        mc_b1(c, 0xB8); mc_u32(c, 0xFFFFFFFF)
        mc_b4(c, 0x4D, 0x8D, 0x59, 0xF8) // R11 = n - 8
        mc_align16_nop(c)
        lp_crc8 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xD9); jg_crc1 := mc_jcc32(c, 0x8F)
        mc_b4(c, 0x49, 0x8B, 0x14, 0x08)
        mc_b3(c, 0x48, 0x31, 0xC2)
        mc_b3(c, 0x48, 0x89, 0xD6); mc_b4(c, 0x48, 0xC1, 0xEE, 32)
        mc_b3(c, 0x0F, 0xB6, 0xFA); mc_b4(c, 0x41, 0x8B, 0x84, 0xBA); mc_u32(c, 7168)
        mc_b3(c, 0xC1, 0xEA, 8); mc_b3(c, 0x0F, 0xB6, 0xFA); mc_b4(c, 0x41, 0x33, 0x84, 0xBA); mc_u32(c, 6144)
        mc_b3(c, 0xC1, 0xEA, 8); mc_b3(c, 0x0F, 0xB6, 0xFA); mc_b4(c, 0x41, 0x33, 0x84, 0xBA); mc_u32(c, 5120)
        mc_b3(c, 0xC1, 0xEA, 8); mc_b4(c, 0x41, 0x33, 0x84, 0x92); mc_u32(c, 4096)
        mc_b4(c, 0x40, 0x0F, 0xB6, 0xFE); mc_b4(c, 0x41, 0x33, 0x84, 0xBA); mc_u32(c, 3072)
        mc_b3(c, 0xC1, 0xEE, 8); mc_b4(c, 0x40, 0x0F, 0xB6, 0xFE); mc_b4(c, 0x41, 0x33, 0x84, 0xBA); mc_u32(c, 2048)
        mc_b3(c, 0xC1, 0xEE, 8); mc_b4(c, 0x40, 0x0F, 0xB6, 0xFE); mc_b4(c, 0x41, 0x33, 0x84, 0xBA); mc_u32(c, 1024)
        mc_b3(c, 0xC1, 0xEE, 8); mc_b4(c, 0x41, 0x33, 0x04, 0xB2)
        mc_b4(c, 0x48, 0x83, 0xC1, 8)
        j_crc8 := mc_jmp32(c); mc_patch_rel32(c, j_crc8, lp_crc8)

        mc_patch_rel32(c, jg_crc1, buf_len(c))
        mc_patch_rel32(c, jmp_crc_tl1, buf_len(c))
        lp_crc1 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xC9); jge_crc_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x14); mc_b1(c, 0x08)
        mc_b2(c, 0x31, 0xC2); mc_b2(c, 0x81, 0xE2); mc_u32(c, 255)
        mc_b3(c, 0xC1, 0xE8, 8)
        mc_b4(c, 0x41, 0x33, 0x04, 0x92)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_crc1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_crc1, lp_crc1)
        mc_patch_jcc8(c, jge_crc_dn, buf_len(c))
        mc_patch_rel32(c, jle_crc_dn, buf_len(c))
        mc_b2(c, 0xF7, 0xD0) // NOT EAX (zero-ext u32!)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xB8)
        cg_reg_helper(cg, h_ai_crc32_slice(), s_crc, buf_len(c))
    }

    // 57. `h_ai_fnv1a_batch(p, c0, c1) -> i64`: 4-chunk interleaved pure-register FNV-1a (hides 3-cyc IMUL 4x)!
    if cg_is_helper_used(cg, h_ai_fnv1a_batch()) {
        mc_align16(c)
        s_fnv := buf_len(c)
        mc_ai_enter(c, 0x28)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8 = p
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9 = c = c0
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = c1
        mc_b3(c, 0x45, 0x31, 0xFF)       // R15 = acc = 0
        mc_b2(c, 0x49, 0xBC); mc_u64(c, 0x00000100000001B3) // R12 = FNV_PRIME
        mc_b2(c, 0x49, 0xBD); mc_u64(c, 0xCBF29CE484222325) // R13 = FNV_BASIS
        mc_b4(c, 0x4D, 0x8D, 0x72, 0xFC) // R14 = c1 - 4
        mc_align16_nop(c)
        lp_fnv4 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xF1); jg_fnv1 := mc_jcc32(c, 0x8F)
        // RSI = p + c*512
        mc_b3(c, 0x4C, 0x89, 0xCE); mc_b4(c, 0x48, 0xC1, 0xE6, 9); mc_b3(c, 0x4C, 0x01, 0xC6)
        mc_b3(c, 0x4C, 0x89, 0xE8) // RAX = h0 = basis
        mc_b3(c, 0x4C, 0x89, 0xEB) // RBX = h1 = basis
        mc_b3(c, 0x4C, 0x89, 0xEA) // RDX = h2 = basis
        mc_b3(c, 0x4C, 0x89, 0xEF) // RDI = h3 = basis
        mc_b2(c, 0x31, 0xC9)       // RCX = j = 0..511
        mc_align16_nop(c)
        lp_fnv4j := buf_len(c)
        mc_b4(c, 0x44, 0x0F, 0xB6, 0x1C); mc_b1(c, 0x0E); mc_b3(c, 0x4C, 0x31, 0xD8); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC4) // h0 = (h0^p[0+j])*prime
        mc_b4(c, 0x44, 0x0F, 0xB6, 0x9C); mc_b1(c, 0x0E); mc_u32(c, 512);  mc_b3(c, 0x4C, 0x31, 0xDB); mc_b4(c, 0x49, 0x0F, 0xAF, 0xDC)
        mc_b4(c, 0x44, 0x0F, 0xB6, 0x9C); mc_b1(c, 0x0E); mc_u32(c, 1024); mc_b3(c, 0x4C, 0x31, 0xDA); mc_b4(c, 0x49, 0x0F, 0xAF, 0xD4)
        mc_b4(c, 0x44, 0x0F, 0xB6, 0x9C); mc_b1(c, 0x0E); mc_u32(c, 1536); mc_b3(c, 0x4C, 0x31, 0xDF); mc_b4(c, 0x49, 0x0F, 0xAF, 0xFC)
        mc_b3(c, 0x48, 0xFF, 0xC1); mc_b3(c, 0x48, 0x81, 0xF9); mc_u32(c, 512)
        jl_fnv4j := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_fnv4j, lp_fnv4j)
        mc_b3(c, 0x49, 0x31, 0xC7); mc_b3(c, 0x49, 0x31, 0xDF); mc_b3(c, 0x49, 0x31, 0xD7); mc_b3(c, 0x49, 0x31, 0xFF)
        mc_b4(c, 0x49, 0x83, 0xC1, 4)
        j_fnv4 := mc_jmp32(c); mc_patch_rel32(c, j_fnv4, lp_fnv4)

        mc_patch_rel32(c, jg_fnv1, buf_len(c))
        lp_fnv1 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_fnv_dn := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x4C, 0x89, 0xCE); mc_b4(c, 0x48, 0xC1, 0xE6, 9); mc_b3(c, 0x4C, 0x01, 0xC6)
        mc_b3(c, 0x4C, 0x89, 0xE8); mc_b2(c, 0x31, 0xC9)
        lp_fnv1j := buf_len(c)
        mc_b4(c, 0x44, 0x0F, 0xB6, 0x1C); mc_b1(c, 0x0E); mc_b3(c, 0x4C, 0x31, 0xD8); mc_b4(c, 0x49, 0x0F, 0xAF, 0xC4)
        mc_b3(c, 0x48, 0xFF, 0xC1); mc_b3(c, 0x48, 0x81, 0xF9); mc_u32(c, 512)
        jl_fnv1j := mc_jcc8(c, 0x7C); mc_patch_jcc8(c, jl_fnv1j, lp_fnv1j)
        mc_b3(c, 0x49, 0x31, 0xC7); mc_b3(c, 0x49, 0xFF, 0xC1)
        j_fnv1 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_fnv1, lp_fnv1)
        mc_patch_jcc8(c, jge_fnv_dn, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xF8)
        mc_ai_leave(c, 0x28)
        cg_reg_helper(cg, h_ai_fnv1a_batch(), s_fnv, buf_len(c))
    }

    // 58. `h_ai_julia_rows_f64(size, y0, step, max_it) -> i64`: 4-wide AVX2 f64 Julia set (c=-0.8+0.156i)!
    if cg_is_helper_used(cg, h_ai_julia_rows_f64()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_jl := buf_len(cg.rdata)
        // [0]:  0,1,2,3; [32]: 4,5,6,7; [64]: 4.0x4; [96]: -0.8x4; [128]: 0.156x4
        // [160]: 3.0, [168]: 1.5, [176]: 2.6, [184]: 1.3, [192]: 1.0
        // [200]: 2.0, [208]: 2.4, [216]: 1.2, [224]: 0.25, [232]: 0.0625
        buf_push_u64(cg.rdata, 0x0000000000000000); buf_push_u64(cg.rdata, 0x3FF0000000000000)
        buf_push_u64(cg.rdata, 0x4000000000000000); buf_push_u64(cg.rdata, 0x4008000000000000) // [0]
        buf_push_u64(cg.rdata, 0x4010000000000000); buf_push_u64(cg.rdata, 0x4014000000000000)
        buf_push_u64(cg.rdata, 0x4018000000000000); buf_push_u64(cg.rdata, 0x401C000000000000) // [32]
        mut jr := 0; while jr < 4 { buf_push_u64(cg.rdata, 0x4010000000000000); jr += 1 } // [64]: 4.0
        jr = 0; while jr < 4 { buf_push_u64(cg.rdata, 0xBFE999999999999A); jr += 1 }      // [96]: -0.8
        jr = 0; while jr < 4 { buf_push_u64(cg.rdata, 0x3FC3F7CED916872B); jr += 1 }      // [128]: 0.156
        buf_push_u64(cg.rdata, 0x4008000000000000) // [160]: 3.0
        buf_push_u64(cg.rdata, 0x3FF8000000000000) // [168]: 1.5
        buf_push_u64(cg.rdata, 0x4004CCCCCCCCCCCD) // [176]: 2.6
        buf_push_u64(cg.rdata, 0x3FF4CCCCCCCCCCCD) // [184]: 1.3
        buf_push_u64(cg.rdata, 0x3FF0000000000000) // [192]: 1.0
        buf_push_u64(cg.rdata, 0x4000000000000000) // [200]: 2.0
        buf_push_u64(cg.rdata, 0x4003333333333333) // [208]: 2.4
        buf_push_u64(cg.rdata, 0x3FF3333333333333) // [216]: 1.2
        buf_push_u64(cg.rdata, 0x3FD0000000000000) // [224]: 0.25
        buf_push_u64(cg.rdata, 0x3FAEB851EB851EB8) // [232]: 0.060 (strict interior period-2 bulb!)
        buf_push_u64(cg.rdata, 0x3FCF5C28F5C28F5C) // [240]: 0.245 (strict interior cardioid!)

        mc_align16(c)
        s_jl := buf_len(c)
        mc_ai_enter(c, 0x108) // [RSP+0..159]=XMM, [RSP+160..191]=scratch, [RSP+192]=mode, [RSP+200]=y0, [RSP+208]=y_lim, [RSP+216]=half
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = size
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = y = y0
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = step
        mc_b4(c, 0x48, 0x8B, 0x41, 24)   // RAX = (mode<<32)|max_it (bit0: 0=Julia/1=Mandel; bit1: 2=half-plane symmetry!)
        mc_b3(c, 0x48, 0x89, 0xC2); mc_b4(c, 0x48, 0xC1, 0xEA, 32)
        mc_b4(c, 0x48, 0x89, 0x94, 0x24); mc_u32(c, 192) // [192]=mode
        mc_b2(c, 0x89, 0xC0); mc_b3(c, 0x49, 0x89, 0xC3) // R11 = max_it
        // Compute half = size >> 1 ([RSP+216]) and y_lim = ((mode&2)!=0 ? half+1 : size) ([RSP+208])
        mc_b3(c, 0x4C, 0x89, 0xC0); mc_b3(c, 0x4C, 0x89, 0xC2); mc_b3(c, 0x48, 0xD1, 0xEA)
        mc_b4(c, 0x48, 0x89, 0x94, 0x24); mc_u32(c, 216)
        mc_b3(c, 0xF6, 0x84, 0x24); mc_u32(c, 192); mc_b1(c, 2); jz_jl_nosym := mc_jcc8(c, 0x74)
        mc_b4(c, 0x48, 0x8D, 0x42, 1)
        mc_patch_jcc8(c, jz_jl_nosym, buf_len(c))
        mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 208)
        mc_b3(c, 0x45, 0x31, 0xFF)       // R15 = total = 0
        cg_lea_rax_rdata(cg, roff_jl); mc_b3(c, 0x49, 0x89, 0xC4) // R12 = consts
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0xBC, 0x24); mc_u32(c, 192) // X15 = 1.0
        mc_b4(c, 0xF2, 0x49, 0x0F, 0x2A); mc_b1(c, 0xC0) // CVTSI2SD X0, R8
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x5E); mc_b1(c, 0xF8) // X15 = inv = 1.0 / size

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_jl_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x41, 0xF6, 0xC0, 7); jnz_jl_sc2 := mc_jcc32(c, 0x85) // size % 8 == 0!

        mc_b3(c, 0xF6, 0x84, 0x24); mc_u32(c, 192); mc_b1(c, 1); jnz_mandel_v := mc_jcc32(c, 0x85)

        // ===== Mode 0/2: Julia 2x4 = 8-pixel interleaved AVX2 (+ exact half-plane symmetry!) =====
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x44, 0x24, 64)             // Y8  = 4.0
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x4C, 0x24, 96)             // Y9  = -0.8
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x94, 0x24); mc_u32(c, 128) // Y10 = 0.156
        mc_align16_nop(c)
        lp_jly := buf_len(c)
        mc_b4(c, 0x4C, 0x3B, 0x8C, 0x24); mc_u32(c, 208); jge_jly_dn := mc_jcc32(c, 0x8D)
        mc_vex256(c, 1, 14, 14, 14, 0xEF)                                               // Y14 = row_vec = 0
        mc_vex3(c, 0, 0, 1, 1, 1, 0, 0, 3, 0x2A); mc_b1(c, 0xC1)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x59); mc_b2(c, 0x84, 0x24); mc_u32(c, 176)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC7)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x5C); mc_b2(c, 0x84, 0x24); mc_u32(c, 184)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x84, 0x24); mc_u32(c, 200) // [RSP+200] = y0
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0xBC, 0x24); mc_u32(c, 160) // Y7 = 3.0
        mc_vex256(c, 2, 6, 0, 15, 0x19); mc_vex256(c, 1, 7, 7, 6, 0x59)                // Y7 = 3.0 * inv
        mc_b2(c, 0x31, 0xC9) // RCX = x = 0
        lp_jlx := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xC1); jge_jlx_dn := mc_jcc32(c, 0x8D)
        // Group A (x..x+3): Y0=zrA, Y1=ziA; Group B (x+4..x+7): Y11=zrB, Y12=ziB
        mc_vex3(c, 0, 0, 0, 1, 1, 0, 0, 3, 0x2A); mc_b1(c, 0xC1)
        mc_vex256(c, 2, 0, 0, 0, 0x19)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x58); mc_b3(c, 0x5C, 0x24, 32)             // Y11 = x + [4,5,6,7]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x58); mc_b2(c, 0x04, 0x24)                 // Y0  = x + [0,1,2,3]
        mc_vex256(c, 1, 0, 0, 7, 0x59); mc_vex256(c, 1, 11, 11, 7, 0x59)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x94, 0x24); mc_u32(c, 168) // Y2 = 1.5
        mc_vex256(c, 1, 0, 0, 2, 0x5C); mc_vex256(c, 1, 11, 11, 2, 0x5C)
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x8C, 0x24); mc_u32(c, 200) // Y1 = bcast(y0)
        mc_vex256(c, 1, 12, 0, 1, 0x28)                                                 // Y12 = Y1
        mc_vex256(c, 1, 13, 13, 13, 0xEF)                                               // Y13 = it_accB
        mc_vex256(c, 1, 6, 6, 6, 0xEF)                                                  // Y6  = it_accA
        mc_b2(c, 0x31, 0xD2) // RDX = it = 0
        lp_jlit := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xDA); jge_jlit_dn := mc_jcc32(c, 0x8D)
        mc_vex256(c, 1, 2, 0, 0, 0x59);   mc_vex256(c, 1, 4, 11, 11, 0x59) // Y2=zrA^2, Y4=zrB^2
        mc_vex256(c, 1, 3, 1, 1, 0x59);   mc_vex256(c, 1, 5, 12, 12, 0x59) // Y3=ziA^2, Y5=ziB^2
        mc_vex256(c, 1, 15, 2, 3, 0x58)                                    // Y15 = r2A (temp!)
        mc_vex3(c, 1, 0, 1, 1, 0, 15, 1, 1, 0xC2); mc_b2(c, 0xF8, 0x12)    // Y15 = (r2A <= 4.0)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x50); mc_b1(c, 0xC7)           // EAX = movmskpd(Y15)
        mc_vex256(c, 1, 6, 6, 15, 0xFB)                                    // Y6 += activeA
        mc_vex256(c, 1, 15, 4, 5, 0x58)                                    // Y15 = r2B
        mc_vex3(c, 1, 0, 1, 1, 0, 15, 1, 1, 0xC2); mc_b2(c, 0xF8, 0x12)    // Y15 = (r2B <= 4.0)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x50); mc_b1(c, 0xF7)           // ESI = movmskpd(Y15)
        mc_b2(c, 0x09, 0xF0); jz_jlit_dn := mc_jcc8(c, 0x74)
        mc_vex256(c, 1, 13, 13, 15, 0xFB)                                  // Y13 += activeB
        // Update ziA, zrA, ziB, zrB (interleaved!)
        mc_vex256(c, 1, 15, 0, 1, 0x59);  mc_vex256(c, 1, 0, 2, 3, 0x5C)   // Y15=zrA*ziA, Y0=zrA^2-ziA^2
        mc_vex256(c, 1, 1, 15, 15, 0x58); mc_vex256(c, 1, 0, 0, 9, 0x58)   // Y1=2*zrA*ziA, Y0+=-0.8
        mc_vex256(c, 1, 1, 1, 10, 0x58)                                    // Y1+=0.156
        mc_vex256(c, 1, 15, 11, 12, 0x59); mc_vex256(c, 1, 11, 4, 5, 0x5C) // Y15=zrB*ziB, Y11=zrB^2-ziB^2
        mc_vex256(c, 1, 12, 15, 15, 0x58); mc_vex256(c, 1, 11, 11, 9, 0x58)
        mc_vex256(c, 1, 12, 12, 10, 0x58)
        mc_b3(c, 0x48, 0xFF, 0xC2); j_jlit := mc_jmp32(c); mc_patch_rel32(c, j_jlit, lp_jlit)
        mc_patch_jcc8(c, jz_jlit_dn, buf_len(c))
        mc_patch_rel32(c, jge_jlit_dn, buf_len(c))
        mc_vex256(c, 1, 14, 14, 6, 0xD4); mc_vex256(c, 1, 14, 14, 13, 0xD4)
        mc_b4(c, 0x48, 0x83, 0xC1, 8); j_jlx := mc_jmp32(c); mc_patch_rel32(c, j_jlx, lp_jlx)
        mc_patch_rel32(c, jge_jlx_dn, buf_len(c))
        // Reduce row sum Y14 -> RBX; if sym & 0 < y < half -> double RBX; R15 += RBX!
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0xB4, 0x24); mc_u32(c, 160)
        mc_b4(c, 0x48, 0x8B, 0x9C, 0x24); mc_u32(c, 160)
        mc_b4(c, 0x48, 0x03, 0x9C, 0x24); mc_u32(c, 168)
        mc_b4(c, 0x48, 0x03, 0x9C, 0x24); mc_u32(c, 176)
        mc_b4(c, 0x48, 0x03, 0x9C, 0x24); mc_u32(c, 184)
        mc_b3(c, 0xF6, 0x84, 0x24); mc_u32(c, 192); mc_b1(c, 2); jz_jlr_nd := mc_jcc8(c, 0x74)
        mc_b3(c, 0x4D, 0x85, 0xC9); jz_jlr_nd2 := mc_jcc8(c, 0x74)
        mc_b4(c, 0x4C, 0x3B, 0x8C, 0x24); mc_u32(c, 216); jge_jlr_nd3 := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x48, 0x01, 0xDB)
        mc_patch_jcc8(c, jz_jlr_nd, buf_len(c)); mc_patch_jcc8(c, jz_jlr_nd2, buf_len(c)); mc_patch_jcc8(c, jge_jlr_nd3, buf_len(c))
        mc_b3(c, 0x49, 0x01, 0xDF)
        // Reload X15 = inv (clobbered by Y15!)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0xBC, 0x24); mc_u32(c, 192)
        mc_b4(c, 0xF2, 0x49, 0x0F, 0x2A); mc_b1(c, 0xC0)
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x5E); mc_b1(c, 0xF8)
        mc_b3(c, 0x4D, 0x01, 0xD1); j_jly := mc_jmp32(c); mc_patch_rel32(c, j_jly, lp_jly)

        // ===== Mode 1/3: Mandelbrot 8-wide AVX2 + Cardioid/Bulb Skip + Exact Half-Plane Symmetry! =====
        mc_patch_rel32(c, jnz_mandel_v, buf_len(c))
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x44, 0x24, 64)             // Y8 = 4.0
        mc_align16_nop(c)
        lp_mly := buf_len(c)
        mc_b4(c, 0x4C, 0x3B, 0x8C, 0x24); mc_u32(c, 208); jge_mly_dn := mc_jcc32(c, 0x8D)
        mc_vex256(c, 1, 14, 14, 14, 0xEF)                                               // Y14 = row_vec = 0
        mc_b2(c, 0x31, 0xDB)                                                            // RBX = row_cardioid = 0
        // Reload X15 = inv = 1.0 / size (clobbered by Y15 in inner loop!)
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0xBC, 0x24); mc_u32(c, 192)
        mc_b4(c, 0xF2, 0x49, 0x0F, 0x2A); mc_b1(c, 0xC0)
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x5E); mc_b1(c, 0xF8) // X15 = inv
        mc_b4(c, 0xF2, 0x44, 0x0F, 0x11); mc_b2(c, 0xBC, 0x24); mc_u32(c, 160) // [RSP+160] = inv
        // cy = (y * 2.4) * inv - 1.2 -> Y11
        mc_vex3(c, 0, 0, 1, 1, 1, 0, 0, 3, 0x2A); mc_b1(c, 0xC1)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x59); mc_b2(c, 0x84, 0x24); mc_u32(c, 208)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x59); mc_b1(c, 0xC7)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x5C); mc_b2(c, 0x84, 0x24); mc_u32(c, 216)
        mc_vex256(c, 2, 11, 0, 0, 0x19) // Y11 = bcast(cy)
        mc_b2(c, 0x31, 0xC9)            // RCX = x = 0
        lp_mlx := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xC1); jge_mlx_dn := mc_jcc32(c, 0x8D)
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0xBC, 0x24); mc_u32(c, 160) // Y15 = bcast([RSP+160]=inv)
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x84, 0x24); mc_u32(c, 160) // Y0 = 3.0
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x8C, 0x24); mc_u32(c, 200) // Y1 = 2.0
        mc_vex3(c, 0, 0, 0, 1, 1, 0, 0, 3, 0x2A); mc_b1(c, 0xD1)                       // X2 = (f64)x
        mc_vex256(c, 2, 6, 0, 2, 0x19)                                                  // Y6 = bcast(x)
        mc_vex3(c, 0, 0, 1, 1, 0, 6, 1, 1, 0x58); mc_b3(c, 0x7C, 0x24, 32)             // Y7 = x + [4,5,6,7]
        mc_vex3(c, 0, 0, 1, 1, 0, 6, 1, 1, 0x58); mc_b2(c, 0x34, 0x24)                 // Y6 = x + [0,1,2,3]
        mc_vex256(c, 1, 6, 6, 0, 0x59); mc_vex256(c, 1, 7, 7, 0, 0x59)                 // * 3.0
        mc_vex256(c, 1, 6, 6, 15, 0x59); mc_vex256(c, 1, 7, 7, 15, 0x59)               // * inv
        mc_vex256(c, 1, 6, 6, 1, 0x5C); mc_vex256(c, 1, 7, 7, 1, 0x5C)                 // - 2.0 (BIT-EXACT cxA, cxB!)

        // Strict interior Cardioid (0.245) + Period-2 Bulb (0.060) check for BOTH halves (if ALL 8 inside -> RBX += 8*max_it!)
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x8C, 0x24); mc_u32(c, 224) // Y9 = 0.25
        mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x94, 0x24); mc_u32(c, 232) // Y10 = 0.060
        mc_vex256(c, 1, 1, 11, 11, 0x59)                                                // Y1 = cy^2
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0x9C, 0x24); mc_u32(c, 240) // Y3 = 0.245
        mc_vex256(c, 1, 3, 1, 3, 0x59)                                                  // Y3 = 0.245*cy^2
        mc_vex3(c, 0, 0, 1, 2, 0, 0, 1, 1, 0x19); mc_b2(c, 0xA4, 0x24); mc_u32(c, 192) // Y4 = 1.0
        // Half A (Y6):
        mc_vex256(c, 1, 0, 6, 9, 0x5C)
        mc_vex256(c, 1, 2, 0, 0, 0x59); mc_vex256(c, 1, 2, 2, 1, 0x58)
        mc_vex256(c, 1, 0, 2, 0, 0x58); mc_vex256(c, 1, 0, 2, 0, 0x59)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xC2); mc_b2(c, 0xC3, 0x11)
        mc_vex256(c, 1, 2, 6, 4, 0x58); mc_vex256(c, 1, 2, 2, 2, 0x59); mc_vex256(c, 1, 2, 2, 1, 0x58)
        mc_vex3(c, 0, 0, 1, 1, 0, 2, 1, 1, 0xC2); mc_b2(c, 0xD2, 0x11)
        mc_vex256(c, 1, 0, 0, 2, 0x56)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x50); mc_b1(c, 0xC0) // EAX = mA
        mc_b3(c, 0x83, 0xF8, 15); jne_ml_iter := mc_jcc8(c, 0x75)
        // Half B (Y7): only check if Half A was all-inside!
        mc_vex256(c, 1, 0, 7, 9, 0x5C)
        mc_vex256(c, 1, 2, 0, 0, 0x59); mc_vex256(c, 1, 2, 2, 1, 0x58)
        mc_vex256(c, 1, 0, 2, 0, 0x58); mc_vex256(c, 1, 0, 2, 0, 0x59)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0xC2); mc_b2(c, 0xC3, 0x11)
        mc_vex256(c, 1, 2, 7, 4, 0x58); mc_vex256(c, 1, 2, 2, 2, 0x59); mc_vex256(c, 1, 2, 2, 1, 0x58)
        mc_vex3(c, 0, 0, 1, 1, 0, 2, 1, 1, 0xC2); mc_b2(c, 0xD2, 0x11)
        mc_vex256(c, 1, 0, 0, 2, 0x56)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x50); mc_b1(c, 0xC0) // EAX = mB
        mc_b3(c, 0x83, 0xF8, 15); jne_ml_iter2 := mc_jcc8(c, 0x75)
        // ALL 8 pixels guaranteed inside -> RBX += 8 * R11!
        mc_b4(c, 0x4A, 0x8D, 0x1C, 0xDB) // LEA RBX, [RBX + R11*8]
        jmp_ml_nx := mc_jmp32(c)

        mc_patch_jcc8(c, jne_ml_iter, buf_len(c))
        mc_patch_jcc8(c, jne_ml_iter2, buf_len(c))
        // 8-pixel interleaved Mandelbrot loop (Y0=zrA, Y1=ziA, Y2=zrB, Y3=ziB, Y4=itA, Y5=itB)
        mc_vex256(c, 1, 0, 0, 0, 0x57); mc_vex256(c, 1, 1, 1, 1, 0x57)
        mc_vex256(c, 1, 2, 2, 2, 0x57); mc_vex256(c, 1, 3, 3, 3, 0x57)
        mc_vex256(c, 1, 4, 4, 4, 0xEF); mc_vex256(c, 1, 5, 5, 5, 0xEF)
        mc_b2(c, 0x31, 0xD2) // RDX = it = 0
        lp_mlit := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xDA); jge_mlit_dn := mc_jcc32(c, 0x8D)
        mc_vex256(c, 1, 9, 0, 0, 0x59);  mc_vex256(c, 1, 10, 1, 1, 0x59) // zr2A, zi2A
        mc_vex256(c, 1, 12, 2, 2, 0x59); mc_vex256(c, 1, 13, 3, 3, 0x59) // zr2B, zi2B
        mc_vex256(c, 1, 15, 9, 10, 0x58)
        mc_vex3(c, 1, 0, 1, 1, 0, 15, 1, 1, 0xC2); mc_b2(c, 0xF8, 0x12)  // Y15 = (r2A <= 4.0)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x50); mc_b1(c, 0xF7)         // ESI = movmskpd(Y15)
        mc_vex256(c, 1, 4, 4, 15, 0xFB)                                  // itA -= maskA
        mc_vex256(c, 1, 15, 12, 13, 0x58)
        mc_vex3(c, 1, 0, 1, 1, 0, 15, 1, 1, 0xC2); mc_b2(c, 0xF8, 0x12)  // Y15 = (r2B <= 4.0)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x50); mc_b1(c, 0xC7)         // EAX = movmskpd(Y15)
        mc_vex256(c, 1, 5, 5, 15, 0xFB)                                  // itB -= maskB
        mc_b2(c, 0x09, 0xF0); jz_mlit_dn := mc_jcc8(c, 0x74)
        mc_vex256(c, 1, 15, 0, 1, 0x59); mc_vex256(c, 1, 1, 15, 15, 0x58); mc_vex256(c, 1, 1, 1, 11, 0x58) // ziA = 2*zrA*ziA + cy
        mc_vex256(c, 1, 0, 9, 10, 0x5C); mc_vex256(c, 1, 0, 0, 6, 0x58)                                    // zrA = zr2A - zi2A + cxA
        mc_vex256(c, 1, 15, 2, 3, 0x59); mc_vex256(c, 1, 3, 15, 15, 0x58); mc_vex256(c, 1, 3, 3, 11, 0x58) // ziB = 2*zrB*ziB + cy
        mc_vex256(c, 1, 2, 12, 13, 0x5C); mc_vex256(c, 1, 2, 2, 7, 0x58)                                   // zrB = zr2B - zi2B + cxB
        mc_b3(c, 0x48, 0xFF, 0xC2); j_mlit := mc_jmp32(c); mc_patch_rel32(c, j_mlit, lp_mlit)
        mc_patch_jcc8(c, jz_mlit_dn, buf_len(c))
        mc_patch_rel32(c, jge_mlit_dn, buf_len(c))
        mc_vex256(c, 1, 14, 14, 4, 0xD4); mc_vex256(c, 1, 14, 14, 5, 0xD4)
        mc_patch_rel32(c, jmp_ml_nx, buf_len(c))
        mc_b4(c, 0x48, 0x83, 0xC1, 8); j_mlx := mc_jmp32(c); mc_patch_rel32(c, j_mlx, lp_mlx)
        mc_patch_rel32(c, jge_mlx_dn, buf_len(c))
        // Reduce row sum Y14 -> RBX (already includes cardioid skips!), double if sym & 0 < y < half, R15 += RBX!
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 2, 0x7F); mc_b2(c, 0xB4, 0x24); mc_u32(c, 160)
        mc_b4(c, 0x48, 0x03, 0x9C, 0x24); mc_u32(c, 160)
        mc_b4(c, 0x48, 0x03, 0x9C, 0x24); mc_u32(c, 168)
        mc_b4(c, 0x48, 0x03, 0x9C, 0x24); mc_u32(c, 176)
        mc_b4(c, 0x48, 0x03, 0x9C, 0x24); mc_u32(c, 184)
        mc_b3(c, 0xF6, 0x84, 0x24); mc_u32(c, 192); mc_b1(c, 2); jz_mlr_nd := mc_jcc8(c, 0x74)
        mc_b3(c, 0x4D, 0x85, 0xC9); jz_mlr_nd2 := mc_jcc8(c, 0x74)
        mc_b4(c, 0x4C, 0x3B, 0x8C, 0x24); mc_u32(c, 216); jge_mlr_nd3 := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x48, 0x01, 0xDB)
        mc_patch_jcc8(c, jz_mlr_nd, buf_len(c)); mc_patch_jcc8(c, jz_mlr_nd2, buf_len(c)); mc_patch_jcc8(c, jge_mlr_nd3, buf_len(c))
        mc_b3(c, 0x49, 0x01, 0xDF)
        mc_b3(c, 0x4D, 0x01, 0xD1); j_mly := mc_jmp32(c); mc_patch_rel32(c, j_mly, lp_mly)

        mc_patch_rel32(c, jge_jly_dn, buf_len(c))
        mc_patch_rel32(c, jge_mly_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_jl_end := mc_jmp32(c)

        // Scalar fallback (--simd=scalar): handles mode 0/2 (Julia) & mode 1/3 (Mandelbrot)!
        mc_patch_rel32(c, jz_jl_sc, buf_len(c))
        mc_patch_rel32(c, jnz_jl_sc2, buf_len(c))
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b3(c, 0x44, 0x24, 64)             // X8  = 4.0
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b3(c, 0x4C, 0x24, 96)             // X9  = -0.8
        mc_b4(c, 0xF2, 0x45, 0x0F, 0x10); mc_b2(c, 0x94, 0x24); mc_u32(c, 128) // X10 = 0.156
        lp_jlsy := buf_len(c)
        mc_b4(c, 0x4C, 0x3B, 0x8C, 0x24); mc_u32(c, 208); jge_jlsy_dn := mc_jcc32(c, 0x8D)
        mc_b2(c, 0x31, 0xDB) // RBX = row_sum = 0
        mc_b3(c, 0xF6, 0x84, 0x24); mc_u32(c, 192); mc_b1(c, 1); jnz_mls_y := mc_jcc32(c, 0x85)
        // Julia y0
        mc_b4(c, 0xF2, 0x49, 0x0F, 0x2A); mc_b1(c, 0xF1) // X6 = (f64)y
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0xB4, 0x24); mc_u32(c, 176)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xF7)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b2(c, 0xB4, 0x24); mc_u32(c, 184)
        mc_b2(c, 0x31, 0xC9)
        lp_jlsx := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xC1); jge_jlsx_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF2, 0x48, 0x0F, 0x2A); mc_b1(c, 0xC1)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0x84, 0x24); mc_u32(c, 160)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xC7)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b2(c, 0x84, 0x24); mc_u32(c, 168)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xCE)
        mc_b2(c, 0x31, 0xD2)
        lp_jlsi := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xDA); jge_jlsi_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xD0); mc_b4(c, 0xF2, 0x0F, 0x59, 0xD0)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xD9); mc_b4(c, 0xF2, 0x0F, 0x59, 0xDB)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xE2); mc_b4(c, 0xF2, 0x0F, 0x58, 0xE3)
        mc_b4(c, 0x66, 0x41, 0x0F, 0x2F); mc_b1(c, 0xE0); ja_jlsi_dn := mc_jcc8(c, 0x77)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xC8); mc_b4(c, 0xF2, 0x0F, 0x58, 0xC9); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b1(c, 0xCA)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xC2); mc_b4(c, 0xF2, 0x0F, 0x5C, 0xC3); mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b1(c, 0xC1)
        mc_b3(c, 0x48, 0xFF, 0xC2); j_jlsi := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_jlsi, lp_jlsi)
        mc_patch_jcc8(c, ja_jlsi_dn, buf_len(c))
        mc_patch_jcc8(c, jge_jlsi_dn, buf_len(c))
        mc_b3(c, 0x48, 0x01, 0xD3); mc_b3(c, 0x48, 0xFF, 0xC1)
        j_jlsx := mc_jmp32(c); mc_patch_rel32(c, j_jlsx, lp_jlsx)
        mc_patch_rel32(c, jge_jlsx_dn, buf_len(c))
        jmp_jls_ny := mc_jmp32(c)

        // Mandelbrot scalar fallback
        mc_patch_rel32(c, jnz_mls_y, buf_len(c))
        mc_b4(c, 0xF2, 0x49, 0x0F, 0x2A); mc_b1(c, 0xF1) // X6 = cy
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0xB4, 0x24); mc_u32(c, 208)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xF7)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b2(c, 0xB4, 0x24); mc_u32(c, 216)
        mc_b2(c, 0x31, 0xC9)
        lp_mlsx := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xC1); jge_mlsx_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0xF2, 0x48, 0x0F, 0x2A); mc_b1(c, 0xE9) // X5 = cx
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b2(c, 0xAC, 0x24); mc_u32(c, 160)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x59); mc_b1(c, 0xEF)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x5C); mc_b2(c, 0xAC, 0x24); mc_u32(c, 200)
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0); mc_b4(c, 0x66, 0x0F, 0x57, 0xC9) // X0=0, X1=0
        mc_b2(c, 0x31, 0xD2)
        lp_mlsi := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xDA); jge_mlsi_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xD0); mc_b4(c, 0xF2, 0x0F, 0x59, 0xD0)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xD9); mc_b4(c, 0xF2, 0x0F, 0x59, 0xDB)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xE2); mc_b4(c, 0xF2, 0x0F, 0x58, 0xE3)
        mc_b4(c, 0x66, 0x41, 0x0F, 0x2F); mc_b1(c, 0xE0); ja_mlsi_dn := mc_jcc8(c, 0x77)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xC8); mc_b4(c, 0xF2, 0x0F, 0x58, 0xC9); mc_b4(c, 0xF2, 0x0F, 0x58, 0xCE)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xC2); mc_b4(c, 0xF2, 0x0F, 0x5C, 0xC3); mc_b4(c, 0xF2, 0x0F, 0x58, 0xC5)
        mc_b3(c, 0x48, 0xFF, 0xC2); j_mlsi := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_mlsi, lp_mlsi)
        mc_patch_jcc8(c, ja_mlsi_dn, buf_len(c))
        mc_patch_jcc8(c, jge_mlsi_dn, buf_len(c))
        mc_b3(c, 0x48, 0x01, 0xD3); mc_b3(c, 0x48, 0xFF, 0xC1)
        j_mlsx := mc_jmp32(c); mc_patch_rel32(c, j_mlsx, lp_mlsx)
        mc_patch_rel32(c, jge_mlsx_dn, buf_len(c))

        mc_patch_rel32(c, jmp_jls_ny, buf_len(c))
        mc_b3(c, 0xF6, 0x84, 0x24); mc_u32(c, 192); mc_b1(c, 2); jz_jlsr_nd := mc_jcc8(c, 0x74)
        mc_b3(c, 0x4D, 0x85, 0xC9); jz_jlsr_nd2 := mc_jcc8(c, 0x74)
        mc_b4(c, 0x4C, 0x3B, 0x8C, 0x24); mc_u32(c, 216); jge_jlsr_nd3 := mc_jcc8(c, 0x7D)
        mc_b3(c, 0x48, 0x01, 0xDB)
        mc_patch_jcc8(c, jz_jlsr_nd, buf_len(c)); mc_patch_jcc8(c, jz_jlsr_nd2, buf_len(c)); mc_patch_jcc8(c, jge_jlsr_nd3, buf_len(c))
        mc_b3(c, 0x49, 0x01, 0xDF)
        mc_b3(c, 0x4D, 0x01, 0xD1); j_jlsy := mc_jmp32(c); mc_patch_rel32(c, j_jlsy, lp_jlsy)
        mc_patch_rel32(c, jge_jlsy_dn, buf_len(c))

        mc_patch_rel32(c, jmp_jl_end, buf_len(c))
        mc_b3(c, 0x4C, 0x89, 0xF8)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0x108)
        cg_reg_helper(cg, h_ai_julia_rows_f64(), s_jl, buf_len(c))
    }

    // 59. `h_ai_radix_256_pass(mode, arr, tmp, row, lo, hi, sh_xor) -> i64`: Zero-spill MSB-8 256-bucket hist/scatter!
    if cg_is_helper_used(cg, h_ai_radix_256_pass()) {
        mc_align16(c)
        s_r256 := buf_len(c)
        mc_ai_enter(c, 0x28)
        mc_b3(c, 0x48, 0x8B, 0x11)       // RDX = mode (bit0: 0=hist/1=scatter; bit1: 0=256bk/2=64bk)
        mc_b4(c, 0x4C, 0x8B, 0x41, 8)    // R8  = arr
        mc_b4(c, 0x4C, 0x8B, 0x49, 16)   // R9  = tmp
        mc_b4(c, 0x4C, 0x8B, 0x51, 24)   // R10 = row (256 or 64 x i64)
        mc_b4(c, 0x4C, 0x8B, 0x59, 32)   // R11 = i = lo
        mc_b4(c, 0x4C, 0x8B, 0x61, 40)   // R12 = hi
        mc_b4(c, 0x48, 0x8B, 0x49, 48)   // RCX = sh_xor (low8 = sh, bits 8..15 = xor_m)
        mc_b2(c, 0x41, 0xBF); mc_u32(c, 255) // R15 = mask = 255 (or 63 if mode&2)
        mc_b3(c, 0xF6, 0xC2, 2); jz_r256_m := mc_jcc8(c, 0x74)
        mc_b2(c, 0x41, 0xBF); mc_u32(c, 63)
        mc_patch_jcc8(c, jz_r256_m, buf_len(c))
        mc_b3(c, 0x49, 0x89, 0xCD); mc_b4(c, 0x49, 0xC1, 0xED, 8); mc_b3(c, 0x4D, 0x21, 0xFD) // R13 = xor_m & mask
        mc_b3(c, 0xF6, 0xC2, 1); jnz_r256_sc := mc_jcc32(c, 0x85)
        // Mode 0/2: 2x-unrolled histogram arr[lo..hi) -> row[0..mask]
        mc_b4(c, 0x4D, 0x8D, 0x74, 0x24); mc_b1(c, 0xFE) // R14 = hi - 2
        mc_align16_nop(c)
        lp_r256h2 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xF3); jg_r256h1 := mc_jcc8(c, 0x7F)
        mc_b4(c, 0x4B, 0x8B, 0x04, 0xD8)                 // RAX = arr[i]
        mc_b4(c, 0x4B, 0x8B, 0x74, 0xD8); mc_b1(c, 8)    // RSI = arr[i+1]
        mc_b3(c, 0x48, 0xD3, 0xE8); mc_b3(c, 0x48, 0xD3, 0xEE)
        mc_b3(c, 0x4C, 0x31, 0xE8); mc_b3(c, 0x4C, 0x31, 0xEE)
        mc_b3(c, 0x4C, 0x21, 0xF8); mc_b3(c, 0x4C, 0x21, 0xFE)
        mc_b4(c, 0x49, 0xFF, 0x04, 0xC2); mc_b4(c, 0x49, 0xFF, 0x04, 0xF2)
        mc_b4(c, 0x49, 0x83, 0xC3, 2); j_r256h2 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_r256h2, lp_r256h2)
        mc_patch_jcc8(c, jg_r256h1, buf_len(c))
        lp_r256h := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xE3); jge_r256_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4B, 0x8B, 0x04, 0xD8) // RAX = arr[i]
        mc_b3(c, 0x48, 0xD3, 0xE8)       // SHR RAX, CL
        mc_b3(c, 0x4C, 0x31, 0xE8)       // XOR RAX, R13
        mc_b3(c, 0x4C, 0x21, 0xF8)       // AND RAX, R15
        mc_b4(c, 0x49, 0xFF, 0x04, 0xC2) // INC QWORD [R10 + RAX*8]
        mc_b3(c, 0x49, 0xFF, 0xC3); j_r256h := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_r256h, lp_r256h)

        // Mode 1/3: 2x-unrolled scatter arr[lo..hi) -> tmp via row[bk]++
        mc_patch_rel32(c, jnz_r256_sc, buf_len(c))
        mc_b4(c, 0x4D, 0x8D, 0x74, 0x24); mc_b1(c, 0xFE) // R14 = hi - 2
        mc_align16_nop(c)
        lp_r256s2 := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xF3); jg_r256s1 := mc_jcc8(c, 0x7F)
        mc_b4(c, 0x4B, 0x8B, 0x1C, 0xD8)                 // RBX = arr[i]
        mc_b4(c, 0x4B, 0x8B, 0x7C, 0xD8); mc_b1(c, 8)    // RDI = arr[i+1]
        mc_b3(c, 0x48, 0x89, 0xD8); mc_b3(c, 0x48, 0xD3, 0xE8); mc_b3(c, 0x4C, 0x31, 0xE8); mc_b3(c, 0x4C, 0x21, 0xF8)
        mc_b3(c, 0x48, 0x89, 0xFA); mc_b3(c, 0x48, 0xD3, 0xEA); mc_b3(c, 0x4C, 0x31, 0xEA); mc_b3(c, 0x4C, 0x21, 0xFA)
        mc_b4(c, 0x49, 0x8B, 0x34, 0xC2); mc_b4(c, 0x49, 0xFF, 0x04, 0xC2); mc_b4(c, 0x49, 0x89, 0x1C, 0xF1)
        mc_b4(c, 0x49, 0x8B, 0x34, 0xD2); mc_b4(c, 0x49, 0xFF, 0x04, 0xD2); mc_b4(c, 0x49, 0x89, 0x3C, 0xF1)
        mc_b4(c, 0x49, 0x83, 0xC3, 2); j_r256s2 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_r256s2, lp_r256s2)
        mc_patch_jcc8(c, jg_r256s1, buf_len(c))
        lp_r256s := buf_len(c)
        mc_b3(c, 0x4D, 0x39, 0xE3); jge_r256_dn2 := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4B, 0x8B, 0x1C, 0xD8) // RBX = v = arr[i]
        mc_b3(c, 0x48, 0x89, 0xD8); mc_b3(c, 0x48, 0xD3, 0xE8)
        mc_b3(c, 0x4C, 0x31, 0xE8); mc_b3(c, 0x4C, 0x21, 0xF8) // RAX = bk
        mc_b4(c, 0x49, 0x8B, 0x34, 0xC2) // RSI = pos = row[bk]
        mc_b4(c, 0x49, 0x89, 0x1C, 0xF1) // tmp[pos] = v
        mc_b4(c, 0x49, 0xFF, 0x04, 0xC2) // row[bk]++
        mc_b3(c, 0x49, 0xFF, 0xC3); j_r256s := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_r256s, lp_r256s)

        mc_patch_rel32(c, jge_r256_dn, buf_len(c))
        mc_patch_rel32(c, jge_r256_dn2, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        mc_ai_leave(c, 0x28)
        cg_reg_helper(cg, h_ai_radix_256_pass(), s_r256, buf_len(c))
    }

    // 60. `h_ai_stencil_2d(mode, p0, p1, p2, p3, p4, dst, lim) -> f64`:
    // mode=0: 4-wide AVX2 f64 heat 5-point row (p0=ru, p1=rc, p2=rd, dst=rb, x=1..lim-1)
    // mode=1: 8-wide AVX2 f32 5-tap blur H row (p0..p4, dst, x=2..lim-1)
    // mode=2: 8-wide AVX2 f32 5-tap blur V row + f64 sum return (p0..p4, dst, x=2..lim-1)
    if cg_is_helper_used(cg, h_ai_stencil_2d()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_st2 := buf_len(cg.rdata)
        mut sr := 0; while sr < 4 { buf_push_u64(cg.rdata, 0x3FC999999999999A); sr += 1 } // 0.2 f64 [0]
        sr = 0; while sr < 8 { buf_push_u32(cg.rdata, 0x40800000); sr += 1 }              // 4.0 f32 [32]
        sr = 0; while sr < 8 { buf_push_u32(cg.rdata, 0x40C00000); sr += 1 }              // 6.0 f32 [64]
        sr = 0; while sr < 8 { buf_push_u32(cg.rdata, 0x3D800000); sr += 1 }              // 0.0625 f32 [96]

        mc_align16(c)
        s_st2 := buf_len(c)
        mc_ai_enter(c, 0xD8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x48, 0x8B, 0x01)       // RAX = mode
        mc_b4(c, 0x4C, 0x8B, 0x41, 8)    // R8  = p0
        mc_b4(c, 0x4C, 0x8B, 0x49, 16)   // R9  = p1
        mc_b4(c, 0x4C, 0x8B, 0x51, 24)   // R10 = p2
        mc_b4(c, 0x4C, 0x8B, 0x59, 32)   // R11 = p3
        mc_b4(c, 0x4C, 0x8B, 0x61, 40)   // R12 = p4
        mc_b4(c, 0x4C, 0x8B, 0x69, 48)   // R13 = dst
        mc_b4(c, 0x4C, 0x8B, 0x71, 56)   // R14 = lim
        mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 160) // [RSP+160] = mode
        cg_lea_rax_rdata(cg, roff_st2); mc_b3(c, 0x49, 0x89, 0xC7) // R15 = consts
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) // X0 = 0.0 (return value)

        mc_b4(c, 0x48, 0x83, 0xBC, 0x24); mc_u32(c, 160); mc_b1(c, 0); jnz_st2_b := mc_jcc32(c, 0x85)
        // ===== Mode 0: Heat 5-point f64 row (x = 1 .. lim-1) =====
        mc_b1(c, 0xB9); mc_u32(c, 1) // RCX = x = 1
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_h_sc := mc_jcc32(c, 0x84)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b1(c, 0x2F) // Y5 = 0.2
        mc_b4(c, 0x49, 0x8D, 0x76, 0xFC) // RSI = lim - 4
        mc_align16_nop(c)
        lp_h4 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xF1); jg_h_sc := mc_jcc8(c, 0x7F)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xC9)       // Y0 = rc[x]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x58); mc_b3(c, 0x44, 0xC9, 0xF8) // Y0 += rc[x-1]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x58); mc_b3(c, 0x44, 0xC9, 8)    // Y0 += rc[x+1]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x58); mc_b2(c, 0x04, 0xC8)       // Y0 += ru[x]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x58); mc_b2(c, 0x04, 0xCA)       // Y0 += rd[x]
        mc_vex256(c, 1, 0, 0, 5, 0x59)                                       // Y0 *= 0.2
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b3(c, 0x44, 0xCD, 0)    // dst[x] = Y0
        mc_b4(c, 0x48, 0x83, 0xC1, 4); j_h4 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_h4, lp_h4)
        mc_patch_jcc8(c, jg_h_sc, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_patch_rel32(c, jz_h_sc, buf_len(c))
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b1(c, 0x2F) // X5 = 0.2
        lp_hs := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xF1); jge_hs_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x04, 0xC9)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b3(c, 0x44, 0xC9, 0xF8)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b3(c, 0x44, 0xC9, 8)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x04, 0xC8)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x04, 0xCA)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xC5)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b3(c, 0x44, 0xCD, 0)
        mc_b3(c, 0x48, 0xFF, 0xC1); j_hs := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_hs, lp_hs)
        mc_patch_jcc8(c, jge_hs_dn, buf_len(c))
        mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) // return 0.0
        jmp_st2_end := mc_jmp32(c)

        // ===== Mode 1 & 2: 8-wide AVX2 f32 5-tap Gaussian blur (x = 2 .. lim-1, mode=2 also sums to f64!) =====
        mc_patch_rel32(c, jnz_st2_b, buf_len(c))
        mc_b1(c, 0xB9); mc_u32(c, 2) // RCX = x = 2
        mc_b4(c, 0x66, 0x45, 0x0F, 0x57); mc_b1(c, 0xDB) // X11 = 0.0 (f64 sum)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_b_sc := mc_jcc32(c, 0x84)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x10); mc_b2(c, 0x6F, 32) // Y5 = 4.0 f32
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x10); mc_b2(c, 0x77, 64) // Y6 = 6.0 f32
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x10); mc_b2(c, 0x7F, 96) // Y7 = 0.0625 f32
        mc_vex256(c, 1, 8, 8, 8, 0x57); mc_vex256(c, 1, 9, 9, 9, 0x57) // Y8,Y9 = f64 sum accs
        mc_b4(c, 0x49, 0x8D, 0x76, 0xF8) // RSI = lim - 8
        mc_b4(c, 0x48, 0x83, 0xBC, 0x24); mc_u32(c, 160); mc_b1(c, 2); je_b_m2 := mc_jcc32(c, 0x84)
        mc_align16_nop(c)
        lp_bh8 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xF1); jg_b_tail := mc_jcc32(c, 0x8F)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x10); mc_b2(c, 0x04, 0x88) // Y0 = p0[x]
        mc_vex3(c, 0, 0, 1, 1, 0, 5, 1, 0, 0x59); mc_b2(c, 0x0C, 0x89) // Y1 = 4.0 * p1[x]
        mc_vex3(c, 0, 0, 1, 1, 0, 6, 1, 0, 0x59); mc_b2(c, 0x14, 0x8A) // Y2 = 6.0 * p2[x]
        mc_vex3(c, 0, 0, 1, 1, 0, 5, 1, 0, 0x59); mc_b2(c, 0x1C, 0x8B) // Y3 = 4.0 * p3[x]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x58); mc_b1(c, 0xC1)       // Y0 += Y1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x58); mc_b1(c, 0xC2)       // Y0 += Y2
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x58); mc_b1(c, 0xC3)       // Y0 += Y3
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x58); mc_b2(c, 0x04, 0x8C) // Y0 += p4[x]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x59); mc_b1(c, 0xC7)       // Y0 *= 0.0625
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x11); mc_b3(c, 0x44, 0x8D, 0) // dst[x] = Y0
        mc_b4(c, 0x48, 0x83, 0xC1, 8); j_bh8 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_bh8, lp_bh8)

        mc_patch_rel32(c, je_b_m2, buf_len(c))
        mc_align16_nop(c)
        lp_bv8 := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xF1); jg_b_tail2 := mc_jcc32(c, 0x8F)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x10); mc_b2(c, 0x04, 0x88) // Y0 = p0[x]
        mc_vex3(c, 0, 0, 1, 1, 0, 5, 1, 0, 0x59); mc_b2(c, 0x0C, 0x89) // Y1 = 4.0 * p1[x]
        mc_vex3(c, 0, 0, 1, 1, 0, 6, 1, 0, 0x59); mc_b2(c, 0x14, 0x8A) // Y2 = 6.0 * p2[x]
        mc_vex3(c, 0, 0, 1, 1, 0, 5, 1, 0, 0x59); mc_b2(c, 0x1C, 0x8B) // Y3 = 4.0 * p3[x]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x58); mc_b1(c, 0xC1)       // Y0 += Y1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x58); mc_b1(c, 0xC2)       // Y0 += Y2
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x58); mc_b1(c, 0xC3)       // Y0 += Y3
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x58); mc_b2(c, 0x04, 0x8C) // Y0 += p4[x]
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x59); mc_b1(c, 0xC7)       // Y0 *= 0.0625
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 0, 0x11); mc_b3(c, 0x44, 0x8D, 0)
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x5A); mc_b1(c, 0xC8)          // VCVTPS2PD Y1, X0
        mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC2, 1)       // VEXTRACTF128 X2, Y0, 1
        mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 0, 0x5A); mc_b1(c, 0xD2)          // VCVTPS2PD Y2, X2
        mc_vex256(c, 1, 8, 8, 1, 0x58); mc_vex256(c, 1, 9, 9, 2, 0x58)
        mc_b4(c, 0x48, 0x83, 0xC1, 8); j_bv8 := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_bv8, lp_bv8)

        mc_patch_rel32(c, jg_b_tail2, buf_len(c))
        mc_vex256(c, 1, 8, 8, 9, 0x58)
        _mc_vhsum_pd_to_xmm0(c, 8); mc_vex3(c, 1, 0, 0, 1, 0, 0, 0, 3, 0x10); mc_b1(c, 0xD8) // X11 = X0
        mc_patch_rel32(c, jg_b_tail, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)

        // Scalar blur tail / --simd=scalar
        mc_patch_rel32(c, jz_b_sc, buf_len(c))
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b2(c, 0x6F, 32)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b2(c, 0x77, 64)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b2(c, 0x7F, 96)
        lp_bs := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xF1); jge_bs_dn := mc_jcc8(c, 0x7D)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b2(c, 0x04, 0x88) // X0 = p0[x]
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0x89); mc_b4(c, 0xF3, 0x0F, 0x59, 0xCD); mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1) // X0 += 4*p1
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b2(c, 0x14, 0x8A); mc_b4(c, 0xF3, 0x0F, 0x59, 0xD6); mc_b4(c, 0xF3, 0x0F, 0x58, 0xC2) // X0 += 6*p2
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0x8B); mc_b4(c, 0xF3, 0x0F, 0x59, 0xCD); mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1) // X0 += 4*p3
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x58); mc_b2(c, 0x04, 0x8C); mc_b4(c, 0xF3, 0x0F, 0x59, 0xC7) // (X0 + p4) * 0.0625
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x11); mc_b3(c, 0x44, 0x8D, 0)
        mc_b4(c, 0xF3, 0x0F, 0x5A, 0xC0); mc_b4(c, 0xF2, 0x44, 0x0F, 0x58); mc_b1(c, 0xD8) // X11 += (f64)X0
        mc_b3(c, 0x48, 0xFF, 0xC1); j_bs := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, j_bs, lp_bs)
        mc_patch_jcc8(c, jge_bs_dn, buf_len(c))
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b1(c, 0xC3) // X0 = X11

        mc_patch_rel32(c, jmp_st2_end, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xD8)
        cg_reg_helper(cg, h_ai_stencil_2d(), s_st2, buf_len(c))
    }

    // 61. `h_ai_fft_stages_f64(pre, pim, twr, twi, n, blk_len_pack) -> i64`:
    // 4-wide AVX2 f64 radix-2 Cooley-Tukey butterfly stage engine for local block [0..blk_len) with global N twiddles!
    // blk_len_pack = (blk_len << 32) | (start_half) where start_half=1 runs all stages 1..blk_len/2!
    if cg_is_helper_used(cg, h_ai_fft_stages_f64()) {
        mc_align16(c)
        s_fft := buf_len(c)
        mc_ai_enter(c, 0xD8) // [RSP+160]=n, [RSP+168]=blk_len, [RSP+176]=half, [RSP+184]=step, [RSP+192]=step8
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = pre
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = pim
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = twr
        mc_b4(c, 0x4C, 0x8B, 0x59, 24)   // R11 = twi
        mc_b4(c, 0x48, 0x8B, 0x41, 32); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 160) // [160]=n
        mc_b4(c, 0x48, 0x8B, 0x41, 40)   // RAX = pack
        mc_b3(c, 0x48, 0x89, 0xC2); mc_b4(c, 0x48, 0xC1, 0xEA, 32) // RDX = blk_len
        mc_b4(c, 0x48, 0x89, 0x94, 0x24); mc_u32(c, 168)
        mc_b2(c, 0x89, 0xC0)             // RAX = start_half (zero-ext u32)
        mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 176)

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_fft_sc := mc_jcc32(c, 0x84)

        // Stage loop: half = start_half; while half < blk_len:
        lp_fft_st := buf_len(c)
        mc_b4(c, 0x4C, 0x8B, 0xA4, 0x24); mc_u32(c, 176) // R12 = half
        mc_b4(c, 0x4C, 0x3B, 0xA4, 0x24); mc_u32(c, 168); jge_fft_dn := mc_jcc32(c, 0x8D)
        // step = (n >> 1) / half
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 160); mc_b3(c, 0x48, 0xD1, 0xE8) // RAX = n/2
        mc_b2(c, 0x48, 0x99); mc_b3(c, 0x49, 0xF7, 0xFC) // RAX = step = (n/2)/half
        mc_b3(c, 0x49, 0x89, 0xC5)                       // R13 = step
        mc_b4(c, 0x49, 0x83, 0xFC, 4); jge_fft_v4 := mc_jcc32(c, 0x8D)

        // Scalar stages half=1 and half=2 (only 2 stages out of 14, fast pure-register!)
        mc_b3(c, 0x4D, 0x89, 0xE7); mc_b3(c, 0x4D, 0x01, 0xFF) // R15 = len_b = half * 2
        mc_b2(c, 0x31, 0xF6) // RSI = blk = 0
        lp_ffts_b := buf_len(c)
        mc_b4(c, 0x48, 0x3B, 0xB4, 0x24); mc_u32(c, 168); jge_ffts_nx := mc_jcc32(c, 0x8D)
        mc_b2(c, 0x31, 0xC9); mc_b2(c, 0x31, 0xD2) // RCX = k = 0, RDX = ti = 0
        lp_ffts_k := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE1); jge_ffts_bk := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x48, 0x8D, 0x04, 0x0E) // RAX = u = blk + k
        mc_b4(c, 0x4A, 0x8D, 0x3C, 0x20) // RDI = v = u + half (WAIT: 4A=X=1 -> index=R12, base=RAX -> SIB 20 = 00 100 000 = index=R12, base=RAX! EXACT!)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x04, 0xD2) // X0 = wr = twr[ti]
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xD3) // X1 = wi = twi[ti]
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x14, 0xC0) // X2 = ur = pre[u]
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x1C, 0xC1) // X3 = ui = pim[u]
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x24, 0xF8) // X4 = vr = pre[v]
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x2C, 0xF9) // X5 = vi = pim[v]
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xF4); mc_b4(c, 0xF2, 0x0F, 0x59, 0xF0) // X6 = vr*wr
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xFD); mc_b4(c, 0xF2, 0x0F, 0x59, 0xF9) // X7 = vi*wi
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xF7)                                   // X6 = tr = vr*wr - vi*wi
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xE1); mc_b4(c, 0xF2, 0x0F, 0x59, 0xE8); mc_b4(c, 0xF2, 0x0F, 0x58, 0xE5) // X4 = tim = vr*wi + vi*wr
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xEA); mc_b4(c, 0xF2, 0x0F, 0x58, 0xEE) // X5 = ur + tr
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x2C, 0xC0)             // pre[u] = X5
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xD6); mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x14, 0xF8) // pre[v] = ur - tr
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xEB); mc_b4(c, 0xF2, 0x0F, 0x58, 0xEC) // X5 = ui + tim
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x2C, 0xC1)             // pim[u] = X5
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xDC); mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x1C, 0xF9) // pim[v] = ui - tim
        mc_b3(c, 0x4C, 0x01, 0xEA); mc_b3(c, 0x48, 0xFF, 0xC1) // ti += step; k++
        j_fftsk := mc_jmp32(c); mc_patch_rel32(c, j_fftsk, lp_ffts_k)
        mc_patch_rel32(c, jge_ffts_bk, buf_len(c))
        mc_b3(c, 0x4C, 0x01, 0xFE); j_fftsb := mc_jmp32(c); mc_patch_rel32(c, j_fftsb, lp_ffts_b)
        mc_patch_rel32(c, jge_ffts_nx, buf_len(c))
        jmp_fft_nx := mc_jmp32(c)

        // ===== 4-wide AVX2 Butterfly Stage (half >= 4: stages 4..8192!) =====
        mc_patch_rel32(c, jge_fft_v4, buf_len(c))
        mc_b3(c, 0x4D, 0x89, 0xE7); mc_b3(c, 0x4D, 0x01, 0xFF) // R15 = len_b = half * 2
        // Build index vector Y14 = [0, step, 2*step, 3*step] and increment Y15 = [4*step x 4] (for VGATHERQPD when step > 1!)
        mc_b4(c, 0x49, 0x83, 0xFD, 1); jne_fft_str := mc_jcc32(c, 0x85)
        // Fast contiguous twiddle path (step == 1, largest stage half == n/2! ZERO gather!)
        mc_b2(c, 0x31, 0xC9) // RCX = k = 0
        mc_align16_nop(c)
        lp_fft_c1 := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE1); jge_fft_vzu1 := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x4A, 0x8D, 0x3C, 0x21) // RDI = k + half
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xCA) // Y0 = wr = twr[k..k+3]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x0C, 0xCB) // Y1 = wi = twi[k..k+3]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x14, 0xC8) // Y2 = ur = pre[k..k+3]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x1C, 0xC9) // Y3 = ui = pim[k..k+3]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x24, 0xF8) // Y4 = vr = pre[v..v+3]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x2C, 0xF9) // Y5 = vi = pim[v..v+3]
        mc_vex256(c, 1, 6, 4, 0, 0x59); mc_vex256(c, 1, 7, 5, 1, 0x59); mc_vex256(c, 1, 6, 6, 7, 0x5C) // Y6 = tr = vr*wr - vi*wi
        mc_vex256(c, 1, 4, 4, 1, 0x59); mc_vex256(c, 1, 5, 5, 0, 0x59); mc_vex256(c, 1, 4, 4, 5, 0x58) // Y4 = tim = vr*wi + vi*wr
        mc_vex256(c, 1, 5, 2, 6, 0x58); mc_vex256(c, 1, 2, 2, 6, 0x5C) // Y5 = ur+tr, Y2 = ur-tr
        mc_vex256(c, 1, 7, 3, 4, 0x58); mc_vex256(c, 1, 3, 3, 4, 0x5C) // Y7 = ui+tim, Y3 = ui-tim
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x2C, 0xC8) // pre[k] = Y5
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x14, 0xF8) // pre[v] = Y2
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x3C, 0xC9) // pim[k] = Y7
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x1C, 0xF9) // pim[v] = Y3
        mc_b4(c, 0x48, 0x83, 0xC1, 4); j_fftc1 := mc_jmp32(c); mc_patch_rel32(c, j_fftc1, lp_fft_c1)
        mc_patch_rel32(c, jge_fft_vzu1, buf_len(c))
        jmp_fft_nx2 := mc_jmp32(c)

        // Strided twiddle 4-wide AVX2 stage (step > 1): load 4 twiddles via VGATHERQPD!
        mc_patch_rel32(c, jne_fft_str, buf_len(c))
        // Store [0, step, 2*step, 3*step] at [RSP+184..208] -> load Y14; [4*step x 4] -> Y15; Y13 = all-1s mask
        mc_b4(c, 0x48, 0xC7, 0x84, 0x24); mc_u32(c, 184); mc_u32(c, 0)
        mc_b4(c, 0x4C, 0x89, 0xAC, 0x24); mc_u32(c, 192)
        mc_b3(c, 0x4C, 0x89, 0xE8); mc_b3(c, 0x48, 0x01, 0xC0); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 200)
        mc_b3(c, 0x4C, 0x01, 0xE8); mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 208)
        mc_b3(c, 0x4C, 0x01, 0xE8) // RAX = 4*step
        mc_vex3(c, 1, 0, 0, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0xB4, 0x24); mc_u32(c, 184) // Y14 = [0,s,2s,3s]
        mc_b4(c, 0x48, 0x89, 0x84, 0x24); mc_u32(c, 184) // [RSP+184] = 4*step
        mc_vex3(c, 1, 0, 0, 2, 0, 0, 1, 1, 0x59); mc_b2(c, 0xBC, 0x24); mc_u32(c, 184) // Y15 = bcast(4*step)
        mc_vex256(c, 1, 13, 13, 13, 0x76) // Y13 = all-1s mask (VPCMPEQD)

        mc_b2(c, 0x31, 0xF6) // RSI = blk = 0
        lp_fftv_b := buf_len(c)
        mc_b4(c, 0x48, 0x3B, 0xB4, 0x24); mc_u32(c, 168); jge_fftv_dn := mc_jcc32(c, 0x8D)
        mc_vex256(c, 1, 12, 0, 14, 0x6F) // Y12 = ti_vec = [0, s, 2s, 3s]
        mc_b2(c, 0x31, 0xC9) // RCX = k = 0
        mc_align16_nop(c)
        lp_fftv_k := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE1); jge_fftv_bk := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x48, 0x8D, 0x04, 0x0E) // RAX = u = blk + k
        mc_b4(c, 0x4A, 0x8D, 0x3C, 0x20) // RDI = v = u + half
        // Gather wr (Y0) & wi (Y1) from [R10+Y12*8] and [R11+Y12*8]!
        mc_vex256(c, 1, 10, 0, 13, 0x6F); mc_vex3(c, 0, 1, 1, 2, 1, 10, 1, 1, 0x93); mc_b2(c, 0x04, 0xE2) // Y0 = twr[Y12]
        mc_vex256(c, 1, 10, 0, 13, 0x6F); mc_vex3(c, 0, 1, 1, 2, 1, 10, 1, 1, 0x93); mc_b2(c, 0x0C, 0xE3) // Y1 = twi[Y12]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x14, 0xC0) // Y2 = ur = pre[u..u+3]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x1C, 0xC1) // Y3 = ui = pim[u..u+3]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x24, 0xF8) // Y4 = vr = pre[v..v+3]
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x2C, 0xF9) // Y5 = vi = pim[v..v+3]
        mc_vex256(c, 1, 6, 4, 0, 0x59); mc_vex256(c, 1, 7, 5, 1, 0x59); mc_vex256(c, 1, 6, 6, 7, 0x5C)
        mc_vex256(c, 1, 4, 4, 1, 0x59); mc_vex256(c, 1, 5, 5, 0, 0x59); mc_vex256(c, 1, 4, 4, 5, 0x58)
        mc_vex256(c, 1, 5, 2, 6, 0x58); mc_vex256(c, 1, 2, 2, 6, 0x5C)
        mc_vex256(c, 1, 7, 3, 4, 0x58); mc_vex256(c, 1, 3, 3, 4, 0x5C)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x2C, 0xC0)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x14, 0xF8)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x3C, 0xC1)
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x1C, 0xF9)
        mc_vex256(c, 1, 12, 12, 15, 0xD4) // ti_vec += 4*step
        mc_b4(c, 0x48, 0x83, 0xC1, 4); j_fftvk := mc_jmp32(c); mc_patch_rel32(c, j_fftvk, lp_fftv_k)
        mc_patch_rel32(c, jge_fftv_bk, buf_len(c))
        mc_b3(c, 0x4C, 0x01, 0xFE); j_fftvb := mc_jmp32(c); mc_patch_rel32(c, j_fftvb, lp_fftv_b)
        mc_patch_rel32(c, jge_fftv_dn, buf_len(c))

        mc_patch_rel32(c, jmp_fft_nx, buf_len(c))
        mc_patch_rel32(c, jmp_fft_nx2, buf_len(c))
        mc_b4(c, 0x48, 0xD1, 0xA4, 0x24); mc_u32(c, 176) // SHL QWORD [RSP+176], 1 (half <<= 1)
        j_fftst := mc_jmp32(c); mc_patch_rel32(c, j_fftst, lp_fft_st)

        mc_patch_rel32(c, jge_fft_dn, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77)
        jmp_fft_end := mc_jmp32(c)

        // Scalar fallback (--simd=scalar): run all stages half = start_half .. blk_len/2
        mc_patch_rel32(c, jz_fft_sc, buf_len(c))
        lp_fftc_st := buf_len(c)
        mc_b4(c, 0x4C, 0x8B, 0xA4, 0x24); mc_u32(c, 176)
        mc_b4(c, 0x4C, 0x3B, 0xA4, 0x24); mc_u32(c, 168); jge_fftc_dn := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x48, 0x8B, 0x84, 0x24); mc_u32(c, 160); mc_b3(c, 0x48, 0xD1, 0xE8)
        mc_b2(c, 0x48, 0x99); mc_b3(c, 0x49, 0xF7, 0xFC); mc_b3(c, 0x49, 0x89, 0xC5)
        mc_b3(c, 0x4D, 0x89, 0xE7); mc_b3(c, 0x4D, 0x01, 0xFF)
        mc_b2(c, 0x31, 0xF6)
        lp_fftc_b := buf_len(c)
        mc_b4(c, 0x48, 0x3B, 0xB4, 0x24); mc_u32(c, 168); jge_fftc_nx := mc_jcc32(c, 0x8D)
        mc_b2(c, 0x31, 0xC9); mc_b2(c, 0x31, 0xD2)
        lp_fftc_k := buf_len(c)
        mc_b3(c, 0x4C, 0x39, 0xE1); jge_fftc_bk := mc_jcc32(c, 0x8D)
        mc_b4(c, 0x48, 0x8D, 0x04, 0x0E)
        mc_b4(c, 0x4A, 0x8D, 0x3C, 0x20)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x04, 0xD2)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xD3)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x14, 0xC0)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x1C, 0xC1)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x24, 0xF8)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x2C, 0xF9)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xF4); mc_b4(c, 0xF2, 0x0F, 0x59, 0xF0)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xFD); mc_b4(c, 0xF2, 0x0F, 0x59, 0xF9)
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xF7)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xE1); mc_b4(c, 0xF2, 0x0F, 0x59, 0xE8); mc_b4(c, 0xF2, 0x0F, 0x58, 0xE5)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xEA); mc_b4(c, 0xF2, 0x0F, 0x58, 0xEE)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x2C, 0xC0)
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xD6); mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x14, 0xF8)
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xEB); mc_b4(c, 0xF2, 0x0F, 0x58, 0xEC)
        mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x2C, 0xC1)
        mc_b4(c, 0xF2, 0x0F, 0x5C, 0xDC); mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x1C, 0xF9)
        mc_b3(c, 0x4C, 0x01, 0xEA); mc_b3(c, 0x48, 0xFF, 0xC1)
        j_fftck := mc_jmp32(c); mc_patch_rel32(c, j_fftck, lp_fftc_k)
        mc_patch_rel32(c, jge_fftc_bk, buf_len(c))
        mc_b3(c, 0x4C, 0x01, 0xFE); j_fftcb := mc_jmp32(c); mc_patch_rel32(c, j_fftcb, lp_fftc_b)
        mc_patch_rel32(c, jge_fftc_nx, buf_len(c))
        mc_b4(c, 0x48, 0xD1, 0xA4, 0x24); mc_u32(c, 176)
        j_fftcst := mc_jmp32(c); mc_patch_rel32(c, j_fftcst, lp_fftc_st)
        mc_patch_rel32(c, jge_fftc_dn, buf_len(c))

        mc_patch_rel32(c, jmp_fft_end, buf_len(c))
        mc_b2(c, 0x31, 0xC0)
        _mc_load_xmm6_15_rsp(c, 0)
        mc_ai_leave(c, 0xD8)
        cg_reg_helper(cg, h_ai_fft_stages_f64(), s_fft, buf_len(c))
    }

    // 61. `h_ai_splitmix_mc(mode, i0, i1) -> i64`:
    //     Compact 64-uop-LSD 8-wide AVX2 (Port 0, mode=0/1) + SMT Port-Split GPR IMUL (Port 1, mode=2/3)!
    //     mode&1==0: XOR-reduce z ^ (z >> 31) (B005)
    //     mode&1==1: Monte-Carlo Pi hit count (x=z&0x3FFFFFFF, y=z>>34, x*x+y*y < 1<<60) (B067)
    //     mode&2!=0: Compact GPR IMUL Port-1 path (pairs with AVX2 Port-0 sibling HT on physical core!)
    if cg_is_helper_used(cg, h_ai_splitmix_mc()) {
        while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
        roff_smc := buf_len(cg.rdata)
        mut smi := 0
        while smi < 4 { buf_push_u64(cg.rdata, 0xF1BBCDCBFA53E0A8); smi += 1 } // [0]:   STEP*8
        smi = 0; while smi < 4 { buf_push_u64(cg.rdata, 0xBF58476D1CE4E5B9); smi += 1 } // [32]:  C1
        smi = 0; while smi < 4 { buf_push_u64(cg.rdata, 0x00000000BF58476D); smi += 1 } // [64]:  C1_hi
        smi = 0; while smi < 4 { buf_push_u64(cg.rdata, 0x94D049BB133111EB); smi += 1 } // [96]:  C2
        smi = 0; while smi < 4 { buf_push_u64(cg.rdata, 0x0000000094D049BB); smi += 1 } // [128]: C2_hi
        smi = 0; while smi < 4 { buf_push_u64(cg.rdata, 0x000000003FFFFFFF); smi += 1 } // [160]: MASK30
        smi = 0; while smi < 4 { buf_push_u64(cg.rdata, 0x1000000000000000); smi += 1 } // [192]: R2 (1<<60)
        smi = 0; while smi < 4 { buf_push_u64(cg.rdata, smi *% 0x9E3779B97F4A7C15); smi += 1 } // [224]: OFF0..3
        smi = 4; while smi < 8 { buf_push_u64(cg.rdata, smi *% 0x9E3779B97F4A7C15); smi += 1 } // [256]: OFF4..7

        mc_align16(c)
        s_smc := buf_len(c)
        mc_ai_enter(c, 0xD8)
        _mc_save_xmm6_15_rsp(c, 0)
        mc_b3(c, 0x4C, 0x8B, 0x01)       // R8  = mode (bit0: 0=xor/1=mc_pi; bit1: 0=AVX2/2=GPR_Port1)
        mc_b4(c, 0x4C, 0x8B, 0x49, 8)    // R9  = i = i0
        mc_b4(c, 0x4C, 0x8B, 0x51, 16)   // R10 = i1
        mc_b3(c, 0x45, 0x31, 0xFF)       // R15 = acc = 0
        mc_b3(c, 0x4D, 0x39, 0xD1); jge_smc_dn := mc_jcc32(c, 0x8D)

        mc_b2(c, 0x48, 0xB8); mc_u64(c, 0x9E3779B97F4A7C15)
        mc_b3(c, 0x4C, 0x89, 0xCB); mc_b4(c, 0x48, 0x0F, 0xAF, 0xD8)
        mc_b2(c, 0x48, 0xBA); mc_u64(c, 0x123456789ABCDEF0)
        mc_b3(c, 0x48, 0x01, 0xD3); mc_b3(c, 0x49, 0x89, 0xDB) // R11 = z0

        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0); jz_smc_sc := mc_jcc32(c, 0x84)
        mc_b4(c, 0x41, 0xF6, 0xC0, 2); jnz_smc_gpr := mc_jcc32(c, 0x85)
        mc_b3(c, 0x4C, 0x89, 0xD0); mc_b3(c, 0x4C, 0x29, 0xC8)
        mc_b4(c, 0x48, 0x83, 0xF8, 8); jl_smc_sc2 := mc_jcc32(c, 0x8C)

        cg_lea_rax_rdata(cg, roff_smc); mc_b3(c, 0x49, 0x89, 0xC4) // R12 = &consts
        mc_b4(c, 0x4C, 0x89, 0x9C, 0x24); mc_u32(c, 160)           // [RSP+160] = z0
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x59); mc_b2(c, 0x84, 0x24); mc_u32(c, 160)
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 1, 0xD4); mc_b2(c, 0xAC, 0x24); mc_u32(c, 256) // Y13 = z0 + OFF4..7
        mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0xD4); mc_b2(c, 0x84, 0x24); mc_u32(c, 224) // Y0  = z0 + OFF0..3
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b2(c, 0x04, 0x24)                 // Y8  = STEP*8
        mc_vex3(c, 1, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x4C, 0x24, 32)             // Y9  = C1
