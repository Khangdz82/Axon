// Axon v1.0.0 Package Manager (`axpm`), Multi-Target Registry, Incremental Cache & MCP JSON-RPC Helpers
// (`compiler_ax/pkg_mcp.ax`) - 100% Pure Axon, Zero External Dependencies.

use compiler_ax::tokens_ast
use compiler_ax::diagnostics

// Native Zero-CRT Stdin & Subprocess Execution Bridges
fn ax_stdin_line(line_buf: ByteBuf) -> i64 {
    return stdin_read_line(line_buf)
}

fn ax_os_exec(cmd: str) -> i64 {
    return os_exec(cmd)
}

fn parse_target_flag(s: str) -> i64 {
    if s == "native" or s == "win-x64" or s == "windows-x64" { return tgt_win_x64() }
    if s == "linux-x64" { return tgt_linux_x64() }
    if s == "linux-arm64" or s == "aarch64-linux" { return tgt_linux_arm64() }
    if s == "macos-x64" or s == "darwin-x64" { return tgt_macos_x64() }
    if s == "macos-arm64" or s == "darwin-arm64" { return tgt_macos_arm64() }
    if s == "wasm32" or s == "wasm32-wasi" { return tgt_wasm32() }
    if s == "unikernel-x64" { return tgt_unikernel_x64() }
    if s == "freestanding-x64" { return tgt_freestanding_x64() }
    if s == "freestanding-riscv64" or s == "riscv64" { return tgt_riscv64() }
    if s == "spirv" or s == "vulkan-spirv" { return tgt_spirv() }
    if s == "ptx" or s == "nvptx64" { return tgt_ptx() }
    return -1
}

fn parse_simd_flag(s: str) -> i64 {
    if s == "scalar" or s == "sse2" or s == "--simd=scalar" { return 0 }
    if s == "avx2" or s == "--simd=avx2" { return 1 }
    if s == "avx512" or s == "--simd=avx512" { return 2 }
    return -1
}

fn target_display_name(tgt: i64) -> str {
    if tgt == tgt_win_x64()          { return "win-x64 (PE32+ x86_64 + SEH + W^X + IOCP)" }
    if tgt == tgt_linux_x64()        { return "linux-x64 (ELF64 x86_64 Direct SYSCALL)" }
    if tgt == tgt_linux_arm64()      { return "linux-arm64 (ELF64 AArch64 + NEON SIMD)" }
    if tgt == tgt_macos_x64()        { return "macos-x64 (Mach-O 64 x86_64)" }
    if tgt == tgt_macos_arm64()      { return "macos-arm64 (Mach-O 64 Apple Silicon 16KB + NEON)" }
    if tgt == tgt_wasm32()           { return "wasm32 (W3C WebAssembly + SIMD128 + WASI)" }
    if tgt == tgt_unikernel_x64()    { return "unikernel-x64 (Multiboot2 Bare-Metal x86_64 + UART)" }
    if tgt == tgt_freestanding_x64() { return "freestanding-x64 (Zero-OS Ring-0 x86_64 ELF64)" }
    if tgt == tgt_riscv64(){ return "freestanding-riscv64 (RV64GC Native Machine Code ELF64)" }
    if tgt == tgt_spirv()            { return "spirv (Khronos SPIR-V 1.6 Binary Compute Kernel)" }
    if tgt == tgt_ptx()              { return "ptx (NVIDIA PTX 8.0 sm_80 Compute Kernel)" }
    return "unknown"
}

