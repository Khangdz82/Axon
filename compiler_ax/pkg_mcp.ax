    println("Axon v1.0.0 Direct Native Cross-Compilation Targets (Zero LLVM / Clang / GCC / Link.exe):")
    println("  win-x64               Windows x86_64 PE32+ (.exe / --shared .dll/.pyd, IOCP, SEH .pdata, @shield)")
    println("  linux-x64             Linux x86_64 ELF64 (Direct SYSCALL runtime, .eh_frame, W^X)")
    println("  linux-arm64           Linux AArch64 ELF64 (ARM64 machine code + 128-bit NEON SIMD)")
    println("  macos-arm64           macOS Apple Silicon Mach-O 64 (16KB page-aligned + LC_MAIN + NEON)")
    println("  macos-x64             macOS Intel x86_64 Mach-O 64 (Direct Darwin BSD SYSCALL)")
    println("  wasm32                WebAssembly WASI + 0xFD SIMD128 (.wasm for Browser / Node / Edge)")
    println("  unikernel-x64         Bare-Metal Multiboot2 Unikernel (.elf, QEMU -kernel / GRUB2, COM1 UART)")
    println("  freestanding-x64      Zero-OS Freestanding x86_64 (.elf, port_in/out + MMIO)")
    println("  freestanding-riscv64  RISC-V 64-bit RV64GC Bare-Metal / Linux (.elf)")
    println("  spirv                 Khronos Vulkan / OpenCL Binary SPIR-V 1.6 (.spv)")
    println("  ptx                   NVIDIA CUDA Driver PTX 8.0 sm_80 (.ptx)")
}

fn derive_output_path_v7(path_buf: ByteBuf, in_path: str, target_id: i64, is_shared: bool) -> str {
    n := str_len(in_path)
    mut stem_len := n
    if n > 3 and str_slice(in_path, n - 3, n) == ".ax" {
        stem_len = n - 3
    }
    start := buf_len(path_buf)
    buf_push_str(path_buf, str_slice(in_path, 0, stem_len))
    if target_id == tgt_win_x64() {
        if is_shared { buf_push_str(path_buf, ".dll") }
        else { buf_push_str(path_buf, ".exe") }
    } else if target_id == tgt_wasm32() {
        buf_push_str(path_buf, ".wasm")
    } else if target_id == tgt_spirv() {
        buf_push_str(path_buf, ".spv")
    } else if target_id == tgt_ptx() {
        buf_push_str(path_buf, ".ptx")
    } else if target_id == tgt_unikernel_x64() or target_id == tgt_freestanding_x64() or target_id == tgt_riscv64() {
        buf_push_str(path_buf, ".elf")
    } else {
        if stem_len == n {
            buf_push_str(path_buf, ".bin")
        }
    }
    end := buf_len(path_buf)
    buf_push(path_buf, 0)
    return buf_slice_str(path_buf, start, end)
}

fn derive_sidecar_ext_path(path_buf: ByteBuf, out_path: str, ext: str) -> str {
    n := str_len(out_path)
    mut dot := n
    mut i := n - 1
    while i >= 0 {
        b := str_byte(out_path, i)
        if b == 46 {
            dot = i
            break
        }
        if b == 47 or b == 92 {
            break
        }
        i -= 1
    }
    start := buf_len(path_buf)
    buf_push_str(path_buf, str_slice(out_path, 0, dot))
    buf_push_str(path_buf, ext)
    end := buf_len(path_buf)
    buf_push(path_buf, 0)
    return buf_slice_str(path_buf, start, end)
}

// --- Deterministic Content Hash (`FNV-1a 64-bit`) for `axon.lock` & `.axon_cache` ---
fn fnv1a_bytebuf(b: ByteBuf) -> i64 {
    n := buf_len(b)
    mut h := -3750763034362895579
    mut i := 0
    while i < n {
        h = (h ^ buf_get(b, i)) *% 1099511628211
        i += 1
    }
    return h
}

fn push_hex64(out: ByteBuf, val: i64) {
    mut shift := 60
    while shift >= 0 {
        nib := (ushr64(val, shift)) & 15
        if nib < 10 { buf_push(out, 48 + nib) }
        else { buf_push(out, 87 + nib) }
        shift -= 4
    }
}

// Parses `key = "value"` from `axon.toml` content; returns `""` if absent.
fn parse_toml_str_field(toml_buf: ByteBuf, out_scratch: ByteBuf, key: str) -> str {
    n := buf_len(toml_buf)
    klen := str_len(key)
    mut i := 0
    while i + klen + 3 < n {
        mut at_line_start := i == 0
        if not at_line_start {
            prev := buf_get(toml_buf, i - 1)
            if prev == 10 or prev == 13 or prev == 32 or prev == 9 {
                at_line_start = true
            }
        }
        if at_line_start {
            mut matched := true
            mut j := 0
            while j < klen {
                if buf_get(toml_buf, i + j) != str_byte(key, j) {
                    matched = false
                    break
                }
                j += 1
            }
            if matched {
                mut p := i + klen
                while p < n and (buf_get(toml_buf, p) == 32 or buf_get(toml_buf, p) == 9) {
                    p += 1
                }
                if p < n and buf_get(toml_buf, p) == 61 {
                    p += 1
                    while p < n and (buf_get(toml_buf, p) == 32 or buf_get(toml_buf, p) == 9) {
                        p += 1
                    }
                    if p < n and buf_get(toml_buf, p) == 34 {
                        p += 1
                        s_start := buf_len(out_scratch)
                        while p < n and buf_get(toml_buf, p) != 34 and buf_get(toml_buf, p) != 10 {
                            buf_push(out_scratch, buf_get(toml_buf, p))
                            p += 1
                        }
                        s_end := buf_len(out_scratch)
                        buf_push(out_scratch, 0)
                        return buf_slice_str(out_scratch, s_start, s_end)
                    }
                }
            }
        }
        i += 1
    }
    return ""
}

fn resolve_entry_from_axon_toml(path_buf: ByteBuf) -> str {
    tbuf := fs_read_file("axon.toml") or return ""
    entry := parse_toml_str_field(tbuf, path_buf, "entry")
    buf_free(move tbuf)
    if str_len(entry) > 0 {
        return entry
    }
    // Check conventional `src/main.ax` or `main.ax`
    s1 := fs_read_file("src/main.ax") or buf_new(8)
    if buf_len(s1) > 0 {
        buf_free(move s1)
        return "src/main.ax"
    }
    buf_free(move s1)
    return "main.ax"
}

fn path_eq_norm(a: str, b: str) -> bool {
    na := str_len(a)
    if na != str_len(b) { return false }
    mut i := 0
    while i < na {
        mut ca := str_byte(a, i)
        mut cb := str_byte(b, i)
        if ca == 92 { ca = 47 }
        if cb == 92 { cb = 47 }
        if ca != cb { return false }
        i += 1
    }
    return true
}

fn update_axon_lockfile(entry_path: str, src_hash: i64) {
    // Only update `axon.lock` when compiling the package's declared `[compiler] entry`
    tbuf := fs_read_file("axon.toml") or buf_new(8)
    if buf_len(tbuf) == 0 {
        buf_free(move tbuf)
        return
    }
    scratch := buf_new(256)
    pkg_name := parse_toml_str_field(tbuf, scratch, "name")
    pkg_ver := parse_toml_str_field(tbuf, scratch, "version")
    pkg_entry := parse_toml_str_field(tbuf, scratch, "entry")
    buf_free(move tbuf)
    if str_len(pkg_entry) > 0 and not path_eq_norm(pkg_entry, entry_path) {
        buf_free(move scratch)
        return
    }

    lbuf := buf_new(512)
    buf_push_str(lbuf, "# Generated automatically by Axon Package Manager (axpm v1.0.0)\n")
    buf_push_str(lbuf, "lock-version = 1\n")
    buf_push_str(lbuf, "package = \"")
    if str_len(pkg_name) > 0 { buf_push_str(lbuf, pkg_name) } else { buf_push_str(lbuf, "app") }
    buf_push_str(lbuf, "\"\nversion = \"")
    if str_len(pkg_ver) > 0 { buf_push_str(lbuf, pkg_ver) } else { buf_push_str(lbuf, "0.1.0") }
    buf_push_str(lbuf, "\"\nentry = \"")
    buf_push_str(lbuf, entry_path)
    buf_push_str(lbuf, "\"\ncontent-fnv64 = \"")
    push_hex64(lbuf, src_hash)
    buf_push_str(lbuf, "\"\n")
    _w := fs_write_file("axon.lock", lbuf) or 0
    buf_free(move lbuf)
    buf_free(move scratch)
}

fn cmd_init_project(name_arg: str) -> i32 {
    mut pkg_name := name_arg
    if str_len(pkg_name) == 0 or pkg_name == "." or str_len(pkg_name) > 64 {
        pkg_name = "axon_app"
    } else {
        mut valid_pkg := true
        mut pi := 0
        while pi < str_len(pkg_name) {
            pb := str_byte(pkg_name, pi)
            is_ok := (pb >= 97 and pb <= 122) or (pb >= 65 and pb <= 90) or (pb >= 48 and pb <= 57) or pb == 95 or pb == 45
            if not is_ok {
                valid_pkg = false
                break
            }
            pi += 1
        }
        if not valid_pkg {
            pkg_name = "axon_app"
        }
    }

    // Refuse to clobber existing `axon.toml`
    existing := fs_read_file("axon.toml") or buf_new(8)
    if buf_len(existing) > 0 {
        buf_free(move existing)
        println("[axpm] `axon.toml` already exists in current directory.")
        return 0
    }
    buf_free(move existing)

    toml := buf_new(512)
    buf_push_str(toml, "[package]\nname = \"")
    buf_push_str(toml, pkg_name)
    buf_push_str(toml, "\"\nversion = \"0.1.0\"\nedition = \"2026\"\n\n[compiler]\nentry = \"main.ax\"\ntarget = \"native\"\nsimd = \"auto\"\n")
    w1 := fs_write_file("axon.toml", toml) or -1
    buf_free(move toml)
    if w1 < 0 {
        println("Error: failed to write `axon.toml`")
        return 1
    }

    ex_main := fs_read_file("main.ax") or buf_new(8)
    if buf_len(ex_main) == 0 {
        msrc := buf_new(512)
        buf_push_str(msrc, "// Generated by `axc init`\n\nfn main() -> i32 {\n    println(\"Hello from Axon v1.0.0!\")\n    return 0\n}\n")
        _wm := fs_write_file("main.ax", msrc) or 0
        buf_free(move msrc)
    }
    buf_free(move ex_main)

    msrc2 := fs_read_file("main.ax") or buf_new(8)
    h := fnv1a_bytebuf(msrc2)
    buf_free(move msrc2)
    update_axon_lockfile("main.ax", h)

    println(f"[axpm] Initialized Axon v1.0.0 project `{pkg_name}` (`axon.toml`, `main.ax`, `axon.lock`)")
    return 0
}

fn mcp_buf_cap(b: ByteBuf) -> i64 {
    return unsafe { ptr_read_i64(b as i64, 1) }
}

fn mcp_self_exe_path(out_buf: ByteBuf) -> str {
    argv0 := args_get(0)
    s0 := buf_len(out_buf)
    if str_len(argv0) > 0 {
        buf_push_str(out_buf, argv0)
    } else {
        buf_push_str(out_buf, "bin\\axc.exe")
    }
    s1 := buf_len(out_buf)
    buf_push(out_buf, 0)
    return buf_slice_str(out_buf, s0, s1)
}

fn mcp_install_root_dir(out_buf: ByteBuf) -> str {
    argv0 := args_get(0)
    mut sp := str_len(argv0) - 1
    while sp >= 0 {
        b := str_byte(argv0, sp)
        if b == 47 or b == 92 { break }
        sp -= 1
    }
    if sp < 0 { return "" }
    s0 := buf_len(out_buf)
    buf_push_str(out_buf, str_slice(argv0, 0, sp + 1))
    buf_push_str(out_buf, "../")
    s1 := buf_len(out_buf)
    buf_push(out_buf, 0)
    return buf_slice_str(out_buf, s0, s1)
}

// --- MCP JSON-RPC 2.0 Lightweight Zero-Dependency Parser & Emitter ---
// Extracts `"key":"value"` string value from a JSON line into `scratch`.
fn mcp_json_get_str(line: str, key: str, scratch: ByteBuf) -> str {
    n := str_len(line)
    klen := str_len(key)
    cap := mcp_buf_cap(scratch)
    mut i := 0
    while i + klen + 3 < n {
        if str_byte(line, i) == 34 {
            mut ok_k := true
            mut j := 0
            while j < klen {
                if str_byte(line, i + 1 + j) != str_byte(key, j) {
                    ok_k = false
                    break
                }
                j += 1
            }
            if ok_k and str_byte(line, i + 1 + klen) == 34 {
                mut p := i + 2 + klen
                while p < n and (str_byte(line, p) == 32 or str_byte(line, p) == 9) { p += 1 }
                if p < n and str_byte(line, p) == 58 {
                    p += 1
                    while p < n and (str_byte(line, p) == 32 or str_byte(line, p) == 9) { p += 1 }
                    if p < n and str_byte(line, p) == 34 {
                        p += 1
                        s0 := buf_len(scratch)
                        while p < n and str_byte(line, p) != 34 {
                            if buf_len(scratch) + 4 >= cap { break }
                            if str_byte(line, p) == 92 and p + 1 < n {
                                p += 1
                                esc := str_byte(line, p)
                                if esc == 110 { buf_push(scratch, 10) }
                                else if esc == 114 { buf_push(scratch, 13) }
                                else if esc == 116 { buf_push(scratch, 9) }
                                else if esc == 98 { buf_push(scratch, 8) }
                                else if esc == 102 { buf_push(scratch, 12) }
                                else { buf_push(scratch, esc) }
                            } else {
                                buf_push(scratch, str_byte(line, p))
                            }
                            p += 1
                        }
                        s1 := buf_len(scratch)
                        if buf_len(scratch) + 1 < cap { buf_push(scratch, 0) }
                        return buf_slice_str(scratch, s0, s1)
                    }
                }
            }
        }
        i += 1
    }
    return ""
}

// Extracts raw JSON `"id": <token>` literal strictly validated as JSON int, JSON string (<=128B), or null.
fn mcp_json_get_raw_id(line: str, scratch: ByteBuf) -> str {
    n := str_len(line)
    cap := mcp_buf_cap(scratch)
    mut i := 0
    while i + 5 < n {
        if str_byte(line, i) == 34 and str_byte(line, i + 1) == 105 and str_byte(line, i + 2) == 100 and str_byte(line, i + 3) == 34 {
            mut p := i + 4
            while p < n and (str_byte(line, p) == 32 or str_byte(line, p) == 9) { p += 1 }
            if p < n and str_byte(line, p) == 58 {
                p += 1
                while p < n and (str_byte(line, p) == 32 or str_byte(line, p) == 9) { p += 1 }
                s0 := buf_len(scratch)
                if p < n and str_byte(line, p) == 34 {
                    if buf_len(scratch) + 136 >= cap { return "null" }
                    buf_push(scratch, 34)
                    p += 1
                    mut slen := 0
                    mut closed := false
                    mut valid_s := true
                    while p < n {
                        b := str_byte(line, p)
                        if b == 34 {
                            buf_push(scratch, 34)
                            closed = true
                            break
                        }
                        if b < 32 or slen >= 128 {
                            valid_s = false
                            break
                        }
                        if b == 92 {
                            if p + 1 >= n { valid_s = false; break }
                            nb := str_byte(line, p + 1)
                            if nb < 32 { valid_s = false; break }
                            buf_push(scratch, 92)
                            buf_push(scratch, nb)
                            p += 2
                            slen += 2
                        } else {
                            buf_push(scratch, b)
                            p += 1
                            slen += 1
                        }
                    }
                    if closed and valid_s {
                        s1 := buf_len(scratch)
                        buf_push(scratch, 0)
                        return buf_slice_str(scratch, s0, s1)
                    }
                    return "null"
                } else {
                    if buf_len(scratch) + 32 >= cap { return "null" }
                    mut valid_num := true
                    mut digits := 0
                    if p < n and str_byte(line, p) == 45 {
                        buf_push(scratch, 45)
                        p += 1
                    }
                    while p < n {
                        b := str_byte(line, p)
                        if b == 44 or b == 125 or b == 32 or b == 9 or b == 10 or b == 13 {
                            break
                        }
                        if b >= 48 and b <= 57 and digits < 20 {
                            buf_push(scratch, b)
                            digits += 1
                        } else {
                            valid_num = false
                            break
                        }
                        p += 1
                    }
                    if valid_num and digits > 0 {
                        s1 := buf_len(scratch)
                        buf_push(scratch, 0)
                        return buf_slice_str(scratch, s0, s1)
                    }
                    return "null"
                }
            }
        }
        i += 1
    }
    return "null"
}

fn mcp_json_get_bool(line: str, key: str) -> bool {
    n := str_len(line)
    klen := str_len(key)
    mut i := 0
    while i + klen + 3 < n {
        if str_byte(line, i) == 34 {
            mut ok_k := true
            mut j := 0
            while j < klen {
                if str_byte(line, i + 1 + j) != str_byte(key, j) {
                    ok_k = false
                    break
                }
                j += 1
            }
            if ok_k and str_byte(line, i + 1 + klen) == 34 {
                mut p := i + 2 + klen
                while p < n and (str_byte(line, p) == 32 or str_byte(line, p) == 9) { p += 1 }
                if p < n and str_byte(line, p) == 58 {
                    p += 1
                    while p < n and (str_byte(line, p) == 32 or str_byte(line, p) == 9) { p += 1 }
                    if p + 4 <= n and str_slice(line, p, p + 4) == "true" {
                        return true
                    }
                }
            }
        }
        i += 1
    }
    return false
}

fn mcp_json_get_num_str(line: str, key: str, scratch: ByteBuf) -> str {
    n := str_len(line)
    klen := str_len(key)
    mut i := 0
    while i + klen + 3 < n {
        if str_byte(line, i) == 34 {
            mut ok_k := true
            mut j := 0
            while j < klen {
                if str_byte(line, i + 1 + j) != str_byte(key, j) {
                    ok_k = false
                    break
                }
                j += 1
            }
            if ok_k and str_byte(line, i + 1 + klen) == 34 {
                mut p := i + 2 + klen
                while p < n and (str_byte(line, p) == 32 or str_byte(line, p) == 9) { p += 1 }
                if p < n and str_byte(line, p) == 58 {
                    p += 1
                    while p < n and (str_byte(line, p) == 32 or str_byte(line, p) == 9) { p += 1 }
                    s0 := buf_len(scratch)
                    while p < n and str_byte(line, p) >= 48 and str_byte(line, p) <= 57 {
                        buf_push(scratch, str_byte(line, p))
                        p += 1
                    }
                    s1 := buf_len(scratch)
                    if s1 > s0 {
                        buf_push(scratch, 0)
                        return buf_slice_str(scratch, s0, s1)
                    }
                }
            }
        }
        i += 1
    }
    return "0"
}

fn mcp_ast_kind_str(k: i64) -> str {
    if k == nk_program() { return "Program" }
    if k == nk_use() { return "Use" }
    if k == nk_struct() { return "Struct" }
    if k == nk_field_decl() { return "FieldDecl" }
    if k == nk_interface() { return "Interface" }
    if k == nk_fn() { return "Fn" }
    if k == nk_param() { return "Param" }
    if k == nk_cimport() { return "CImport" }
    if k == nk_comptime_const() { return "ComptimeConst" }
    if k == nk_comptime_block() { return "ComptimeBlock" }
    if k == nk_var_decl() { return "VarDecl" }
    if k == nk_assign() { return "Assign" }
    if k == nk_if() { return "If" }
    if k == nk_while() { return "While" }
    if k == nk_for_range() { return "ForRange" }
    if k == nk_for_each() { return "ForEach" }
    if k == nk_par_for_range() { return "ParForRange" }
    if k == nk_return() { return "Return" }
    if k == nk_break() { return "Break" }
    if k == nk_continue() { return "Continue" }
    if k == nk_expr_stmt() { return "ExprStmt" }
    if k == nk_block() { return "Block" }
    if k == nk_int() { return "IntLit" }
    if k == nk_float() { return "FloatLit" }
    if k == nk_dec() { return "DecLit" }
    if k == nk_bool() { return "BoolLit" }
    if k == nk_str() { return "StrLit" }
    if k == nk_fstr() { return "FStr" }
    if k == nk_ident() { return "Ident" }
    if k == nk_move_ident() { return "MoveIdent" }
    if k == nk_tuple() { return "Tuple" }
    if k == nk_unary() { return "Unary" }
    if k == nk_binary() { return "Binary" }
    if k == nk_or_return() { return "OrReturn" }
    if k == nk_cast() { return "Cast" }
    if k == nk_field() { return "Field" }
    if k == nk_index() { return "Index" }
    if k == nk_table_alloc() { return "TableAlloc" }
    if k == nk_call() { return "Call" }
    if k == nk_call_arg() { return "CallArg" }
    if k == nk_method_call() { return "MethodCall" }
    if k == nk_if_expr() { return "IfExpr" }
    if k == nk_spawn() { return "Spawn" }
    if k == nk_await() { return "Await" }
    if k == nk_comptime_expr() { return "ComptimeExpr" }
    return "Node"
}

fn mcp_dump_ast_tree(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, out: ByteBuf) {
    total_nodes := ibuf_len(nodes) / 8
    cap := mcp_buf_cap(out)
    buf_push_str(out, "=== Axon Abstract Syntax Tree (AST) ===\n")
    buf_push_str(out, f"Total AST nodes: {total_nodes}\n\n")
    mut nid := 2
    mut printed := 0
    while nid < total_nodes and printed < 150 {
        if buf_len(out) + 512 >= cap {
            buf_push_str(out, "... (output truncated)\n")
            return
        }
        k := ast_kind(nodes, nid)
        if k > 0 {
            ks := mcp_ast_kind_str(k)
            sp := ast_span(nodes, nid)
            l := span_line(sp)
            col := span_col(sp)
            buf_push_str(out, f"[{nid}] {ks} (line {l}, col {col})")
            if k == nk_fn() or k == nk_struct() or k == nk_ident() or k == nk_call() or k == nk_var_decl() or k == nk_field() {
                soff := ast_get(nodes, nid, 1)
                mut slen := ast_get(nodes, nid, 2)
                if soff >= 0 and slen > 0 and soff + slen <= buf_len(pool) {
                    if slen > 128 { slen = 128 }
                    name := buf_slice_str(pool, soff, soff + slen)
                    buf_push_str(out, f" name: \"{name}\"")
                }
            } else if k == nk_int() {
                val := ast_get(nodes, nid, 1)
                buf_push_str(out, f" val: {val}")
            } else if k == nk_str() {
                soff := ast_get(nodes, nid, 1)
                mut slen := ast_get(nodes, nid, 2)
                if soff >= 0 and slen > 0 and soff + slen <= buf_len(pool) {
                    if slen > 128 { slen = 128 }
                    sval := buf_slice_str(pool, soff, soff + slen)
                    buf_push_str(out, f" val: \"{sval}\"")
                }
            }
            buf_push_str(out, "\n")
            printed += 1
        }
        nid += 1
    }
    if total_nodes > 150 and buf_len(out) + 128 < cap {
        buf_push_str(out, f"... and {total_nodes - 150} more AST nodes.\n")
    }
}

fn mcp_dump_symbols(pool: ByteBuf, sym: IntBuf, out: ByteBuf) {
    cap := mcp_buf_cap(out)
    buf_push_str(out, "=== Axon Symbol Table ===\n")
    f_base := ibuf_get(sym, 7)
    f_cnt := ibuf_get(sym, 8)
    buf_push_str(out, f"Functions ({f_cnt}):\n")
    mut fi := 0
    while fi < f_cnt {
        if buf_len(out) + 384 >= cap {
            buf_push_str(out, "  ... (truncated)\n")
            return
        }
        fo := f_base + fi * 10
        fn_soff := ibuf_get(sym, fo)
        mut fn_slen := ibuf_get(sym, fo + 1)
        param_cnt := ibuf_get(sym, fo + 4)
        flags := ibuf_get(sym, fo + 9)
        if fn_soff >= 0 and fn_slen > 0 and fn_soff + fn_slen <= buf_len(pool) {
            if fn_slen > 128 { fn_slen = 128 }
            fname := buf_slice_str(pool, fn_soff, fn_soff + fn_slen)
            buf_push_str(out, f"  fn {fname}({param_cnt} params)")
            if (flags & fnflag_shield()) != 0 { buf_push_str(out, " [@shield]") }
            if (flags & fnflag_no_alloc()) != 0 { buf_push_str(out, " [@no_alloc]") }
            if (flags & fnflag_nan_guard()) != 0 { buf_push_str(out, " [@nan_guard]") }
            if (flags & fnflag_test()) != 0 { buf_push_str(out, " [@test]") }
            if (flags & fnflag_gpu()) != 0 { buf_push_str(out, " [@gpu]") }
            if (flags & fnflag_comptime()) != 0 { buf_push_str(out, " [@comptime]") }
            buf_push_str(out, "\n")
        }
        fi += 1
    }

    s_base := ibuf_get(sym, 3)
    s_cnt := ibuf_get(sym, 4)
    buf_push_str(out, f"\nStructs & Tables ({s_cnt}):\n")
    mut si := 0
    while si < s_cnt {
        if buf_len(out) + 256 >= cap {
            buf_push_str(out, "  ... (truncated)\n")
            return
        }
        so := s_base + si * 6
        soff := ibuf_get(sym, so)
        mut slen := ibuf_get(sym, so + 1)
        fields_cnt := ibuf_get(sym, so + 4)
        if soff >= 0 and slen > 0 and soff + slen <= buf_len(pool) {
            if slen > 128 { slen = 128 }
            sname := buf_slice_str(pool, soff, soff + slen)
            buf_push_str(out, f"  struct {sname} ({fields_cnt} fields)\n")
        }
        si += 1
    }

    i_base := ibuf_get(sym, 5)
    i_cnt := ibuf_get(sym, 6)
    if i_cnt > 0 and buf_len(out) + 256 < cap {
        buf_push_str(out, f"\nInterfaces ({i_cnt}):\n")
        mut ii := 0
        while ii < i_cnt {
            if buf_len(out) + 256 >= cap {
                buf_push_str(out, "  ... (truncated)\n")
                return
            }
            io := i_base + ii * 4
            ioff := ibuf_get(sym, io)
            mut ilen := ibuf_get(sym, io + 1)
            if ioff >= 0 and ilen > 0 and ioff + ilen <= buf_len(pool) {
                if ilen > 128 { ilen = 128 }
                iname := buf_slice_str(pool, ioff, ioff + ilen)
                buf_push_str(out, f"  interface {iname}\n")
            }
            ii += 1
        }
    }
}

fn mcp_exec_capture_with_rc(cmd_line: str, out_file: str, rc_out: IntBuf) -> str {
    // Clear stale capture file before running child command
    empty_b := buf_new(4)
    _cl := fs_write_file(out_file, empty_b) or 0
    buf_free(move empty_b)

    cbuf := buf_new(str_len(cmd_line) + str_len(out_file) + 128)
    buf_push_str(cbuf, "cmd.exe /c \"")
    buf_push_str(cbuf, cmd_line)
    buf_push_str(cbuf, " > \"")
    buf_push_str(cbuf, out_file)
    buf_push_str(cbuf, "\" 2>&1\"")
    c_str := buf_slice_str(cbuf, 0, buf_len(cbuf))
    rc := ax_os_exec(c_str)
    buf_free(move cbuf)
    if ibuf_len(rc_out) > 0 { ibuf_set(rc_out, 0, rc) }

    fbuf := fs_read_file(out_file) or buf_new(0)
    mut res := ""
    mut flen := buf_len(fbuf)
    if flen > 65536 { flen = 65536 }
    if flen > 0 {
        res = "" + buf_slice_str(fbuf, 0, flen)
    } else {
        res = "(no output)"
    }
    buf_free(move fbuf)
    return res
}

fn mcp_exec_capture_file(cmd_line: str, out_file: str) -> str {
    rc_buf := ibuf_new(2)
    ibuf_push(rc_buf, 0)
    out := mcp_exec_capture_with_rc(cmd_line, out_file, rc_buf)
    buf_free(move rc_buf)
    return out
}

fn str_starts_with_tok(s: str, prefix: str) -> bool {
    pl := str_len(prefix)
    if str_len(s) < pl { return false }
    return str_slice(s, 0, pl) == prefix
}

fn mcp_read_std_module(mod_name: str) -> ByteBuf {
    p1 := buf_new(str_len(mod_name) + 16)
    buf_push_str(p1, "std/")
    buf_push_str(p1, mod_name)
    buf_push_str(p1, ".ax")
    s1 := buf_slice_str(p1, 0, buf_len(p1))
    b1 := fs_read_file(s1) or buf_new(0)
    buf_free(move p1)
    if buf_len(b1) > 0 { return b1 }
    buf_free(move b1)

    p2 := buf_new(str_len(mod_name) + 32)
    buf_push_str(p2, "../std/")
    buf_push_str(p2, mod_name)
    buf_push_str(p2, ".ax")
    s2 := buf_slice_str(p2, 0, buf_len(p2))
    b2 := fs_read_file(s2) or buf_new(0)
    buf_free(move p2)
    if buf_len(b2) > 0 { return b2 }
    buf_free(move b2)

    p3 := buf_new(str_len(mod_name) + 512)
    root := mcp_install_root_dir(p3)
    if str_len(root) > 0 {
        s0 := buf_len(p3)
        buf_push_str(p3, root)
        buf_push_str(p3, "std/")
        buf_push_str(p3, mod_name)
        buf_push_str(p3, ".ax")
        s3 := buf_slice_str(p3, s0, buf_len(p3))
        b3 := fs_read_file(s3) or buf_new(0)
        buf_free(move p3)
        return b3
    }
    buf_free(move p3)
    return buf_new(0)
}

fn mcp_search_stdlib(query: str, mod_filter: str, out: ByteBuf) {
    cap := mcp_buf_cap(out)
    buf_push_str(out, "=== Axon Standard Library API Documentation ===\n")
    if str_len(mod_filter) > 0 {
        buf_push_str(out, f"Filter Module: std::{mod_filter}\n\n")
    } else if str_len(query) > 0 {
        buf_push_str(out, f"Search Query: \"{query}\"\n\n")
    }

    modules := "ai ai_autograd ai_engine ai_gguf ai_local ai_lora ai_math ai_nn ai_quant ai_serve async_io audio cap cli collections compress crdt crypto css cuda data decimal encoding faiss game game2d game3d game_ecs game_physics game_render html http iot json kernel llama log math math3d memory npu numpy onnx os path quant rand regex ringbuf safetensors semiconductor sklearn str taint terminal test_kit tiktoken time tokenizers torch transformers ui ui_js ui_layout ui_render ui_signal ui_tailwind uuid vllm"
    
    mut m_pos := 0
    mod_len := str_len(modules)
    mut matches_found := 0

    while m_pos < mod_len {
        if buf_len(out) + 512 >= cap {
            buf_push_str(out, "(Output truncated due to buffer limit)\n")
            break
        }
        while m_pos < mod_len and str_byte(modules, m_pos) == 32 { m_pos += 1 }
        if m_pos >= mod_len { break }
        s_m := m_pos
        while m_pos < mod_len and str_byte(modules, m_pos) != 32 { m_pos += 1 }
        e_m := m_pos
        cur_mod := str_slice(modules, s_m, e_m)

        mut scan_this_mod := false
        if str_len(mod_filter) > 0 {
            if cur_mod == mod_filter { scan_this_mod = true }
        } else {
            scan_this_mod = true
        }

        if scan_this_mod {
            m_src := mcp_read_std_module(cur_mod)
            if buf_len(m_src) > 0 {
                mut line_start := 0
                sz := buf_len(m_src)
                mut header_printed := false
                mut mod_matches := 0

                while line_start < sz {
                    if buf_len(out) + 512 >= cap { break }
                    mut line_end := line_start
                    while line_end < sz and buf_get(m_src, line_end) != 10 and buf_get(m_src, line_end) != 13 {
                        line_end += 1
                    }
                    if line_end > line_start {
                        line := buf_slice_str(m_src, line_start, line_end)
                        mut ls := 0
                        while ls < str_len(line) and (str_byte(line, ls) == 32 or str_byte(line, ls) == 9) { ls += 1 }
                        mut end_t := str_len(line)
                        if end_t - ls > 256 { end_t = ls + 256 }
                        trimmed := str_slice(line, ls, end_t)
                        
                        mut is_decl := str_starts_with_tok(trimmed, "fn ") or str_starts_with_tok(trimmed, "pub fn ") or str_starts_with_tok(trimmed, "struct ") or str_starts_with_tok(trimmed, "@no_alloc") or str_starts_with_tok(trimmed, "@shield")
                        mut hit := false
                        if is_decl {
                            if str_len(query) == 0 or repl_str_contains(trimmed, query) or (str_len(mod_filter) > 0 and cur_mod == mod_filter) {
                                hit = true
                            }
                        }

                        if hit {
                            if not header_printed {
                                buf_push_str(out, f"--- Module `std::{cur_mod}` (import with `use std::{cur_mod}`) ---\n")
                                header_printed = true
                            }
                            buf_push_str(out, "  ")
                            buf_push_str(out, trimmed)
                            buf_push_str(out, "\n")
                            matches_found += 1
                            mod_matches += 1
                            if mod_matches >= 30 and str_len(mod_filter) == 0 {
                                buf_push_str(out, "  ... (more declarations in module)\n")
                                break
                            }
                        }
                    }
                    line_start = line_end + 1
                    while line_start < sz and (buf_get(m_src, line_start) == 10 or buf_get(m_src, line_start) == 13) {
                        line_start += 1
                    }
                }
                if header_printed and buf_len(out) + 16 < cap {
                    buf_push_str(out, "\n")
                }
            }
            buf_free(move m_src)
        }
        if matches_found >= 60 and str_len(mod_filter) == 0 {
            if buf_len(out) + 256 < cap {
                buf_push_str(out, f"(Results limited to first {matches_found} matches. Use `module: \"<name>\"` to see all declarations of a specific module)\n")
            }
            break
        }
    }
    if matches_found == 0 and buf_len(out) + 256 < cap {
        buf_push_str(out, "No matching stdlib declarations found for query. Run with `module: \"<name>\"` or check `axon_spec`.\n")
    }
}

fn mcp_inspect_c_header(src: ByteBuf, hdr_name: str, out: ByteBuf) {
    buf_push_str(out, "=== Axon C Header & FFI Inspector (@cImport) ===\n")
    if str_len(hdr_name) > 0 {
        buf_push_str(out, f"Header: `{hdr_name}` ({buf_len(src)} bytes)\n\n")
    }
    pool := buf_new(524288)
    nodes := ibuf_new(262144)
    extra := ibuf_new(262144)
    out_structs := ibuf_new(2048)
    out_funcs := ibuf_new(2048)
    out_consts := ibuf_new(2048)

    parse_c_header_into_program(src, pool, nodes, extra, 0, 0, 1, out_structs, out_funcs, out_consts)

    c_cnt := ibuf_len(out_consts)
    buf_push_str(out, f"Constants (#define) ({c_cnt}):\n")
    mut ci := 0
    while ci < c_cnt and ci < 20 {
        cid := ibuf_get(out_consts, ci)
        c_soff := ast_get(nodes, cid, 1)
        c_slen := ast_get(nodes, cid, 2)
        if c_soff >= 0 and c_slen > 0 and c_soff + c_slen <= buf_len(pool) {
            cname := buf_slice_str(pool, c_soff, c_soff + c_slen)
            buf_push_str(out, f"  const {cname}\n")
        }
        ci += 1
    }
    if c_cnt > 20 { buf_push_str(out, f"  ... and {c_cnt - 20} more constants\n") }

    s_cnt := ibuf_len(out_structs)
    buf_push_str(out, f"\nC Structs & Typedefs ({s_cnt}):\n")
    mut si := 0
    while si < s_cnt and si < 20 {
        sid := ibuf_get(out_structs, si)
        s_soff := ast_get(nodes, sid, 1)
        s_slen := ast_get(nodes, sid, 2)
        fc := ast_get(nodes, sid, 4)
        if s_soff >= 0 and s_slen > 0 and s_soff + s_slen <= buf_len(pool) {
            sname := buf_slice_str(pool, s_soff, s_soff + s_slen)
            buf_push_str(out, f"  struct {sname} ({fc} fields)\n")
        }
        si += 1
    }
    if s_cnt > 20 { buf_push_str(out, f"  ... and {s_cnt - 20} more structs\n") }

    f_cnt := ibuf_len(out_funcs)
    buf_push_str(out, f"\nC Functions (@extern) ({f_cnt}):\n")
    mut fi := 0
    while fi < f_cnt and fi < 30 {
        fid := ibuf_get(out_funcs, fi)
        f_soff := ast_get(nodes, fid, 1)
        f_slen := ast_get(nodes, fid, 2)
        if f_soff >= 0 and f_slen > 0 and f_soff + f_slen <= buf_len(pool) {
            fname := buf_slice_str(pool, f_soff, f_soff + f_slen)
            buf_push_str(out, f"  @extern fn {fname}(...)\n")
        }
        fi += 1
    }
    if f_cnt > 30 { buf_push_str(out, f"  ... and {f_cnt - 30} more functions\n") }

    buf_push_str(out, "\nAxon Usage Example:\n")
    buf_push_str(out, "```axon\n")
    if str_len(hdr_name) > 0 {
        buf_push_str(out, f"@cImport(\"{hdr_name}\")\n")
    } else {
        buf_push_str(out, "@cImport(\"my_header.h\")\n")
    }
    buf_push_str(out, "fn main() -> i32 {\n    // Directly call imported C functions with zero overhead\n    return 0\n}\n```\n")

    buf_free(move out_consts)
    buf_free(move out_funcs)
    buf_free(move out_structs)
    buf_free(move extra)
    buf_free(move nodes)
    buf_free(move pool)
}

fn cmd_install_mcp_config(sub: str) -> i32 {
    mut target := "all"
    if sub == "--install-claude" { target = "claude" }
    else if sub == "--install-cursor" { target = "cursor" }

    ps_cmd := buf_new(256)
    buf_push_str(ps_cmd, "powershell -ExecutionPolicy Bypass -File tools\\install_mcp.ps1 -Target ")
    buf_push_str(ps_cmd, target)
    c_str := buf_slice_str(ps_cmd, 0, buf_len(ps_cmd))
    rc := ax_os_exec(c_str)
    buf_free(move ps_cmd)
    return rc as i32
}

fn axon_format_code(src: str, out: ByteBuf) {
    n := str_len(src)
    cap := mcp_buf_cap(out)
    mut i := 0
    mut indent := 0
    mut prev_was_empty := false

    while i < n {
        mut line_end := i
        while line_end < n and str_byte(src, line_end) != 10 and str_byte(src, line_end) != 13 {
            line_end += 1
        }
        line_len := line_end - i
        raw_line := str_slice(src, i, line_end)

        // Advance past exactly ONE line ending (`\r\n`, `\n`, or `\r`) so blank lines are preserved!
        i = line_end
        if i < n and str_byte(src, i) == 13 { i += 1 }
        if i < n and str_byte(src, i) == 10 { i += 1 }

        mut ls := 0
        while ls < line_len and (str_byte(raw_line, ls) == 32 or str_byte(raw_line, ls) == 9) {
            ls += 1
        }

        if ls >= line_len {
            if not prev_was_empty and buf_len(out) > 0 and buf_len(out) + 2 < cap {
                buf_push(out, 10)
                prev_was_empty = true
            }
            continue
        }
        prev_was_empty = false

        mut le := line_len
        while le > ls and (str_byte(raw_line, le - 1) == 32 or str_byte(raw_line, le - 1) == 9) {
            le -= 1
        }
        trimmed := str_slice(raw_line, ls, le)
        tlen := str_len(trimmed)

        mut leading_closes := 0
        while leading_closes < tlen and str_byte(trimmed, leading_closes) == 125 {
            leading_closes += 1
        }

        mut cur_indent := indent - leading_closes
        if cur_indent < 0 { cur_indent = 0 }
        if cur_indent > 32 { cur_indent = 32 }

        if buf_len(out) + cur_indent * 4 + tlen + 2 >= cap {
            break
        }

        mut sp_i := 0
        while sp_i < cur_indent * 4 {
            buf_push(out, 32)
            sp_i += 1
        }

        mut in_str := false
        mut esc := false
        mut is_comment := false
        mut ci := 0

        while ci < tlen {
            b := str_byte(trimmed, ci)
            if not in_str and b == 47 and ci + 1 < tlen and str_byte(trimmed, ci + 1) == 47 {
                is_comment = true
            }

            if not in_str and not is_comment {
                if b == 123 {
                    indent += 1
                } else if b == 125 {
                    if indent > 0 { indent -= 1 }
                }
            }

            if not is_comment {
                if b == 34 and not esc {
                    in_str = not in_str
                }
                if in_str and b == 92 and not esc {
                    esc = true
                } else {
                    esc = false
                }
            }

            buf_push(out, b)
            ci += 1
        }

        buf_push(out, 10)
    }
}

fn cmd_format_file(fpath: str, write_back: bool) -> i32 {
    src_buf := fs_read_file(fpath) or buf_new(0)
    if buf_len(src_buf) == 0 {
        println(f"Error: cannot read `{fpath}`")
        buf_free(move src_buf)
        return 1
    }
    src_str := buf_slice_str(src_buf, 0, buf_len(src_buf))
    out := buf_new(str_len(src_str) * 4 + 1024)
    axon_format_code(src_str, out)
    if write_back {
        w := fs_write_file(fpath, out) or -1
        if w >= 0 {
            println(f"Formatted `{fpath}` ({w} bytes)")
        } else {
            println(f"Error: failed writing `{fpath}`")
        }
    } else {
        print(buf_slice_str(out, 0, buf_len(out)))
    }
    buf_free(move out)
    buf_free(move src_buf)
    return 0
}

fn mcp_auto_repair_code(in_src: str, fpath: str, out: ByteBuf) {
    t_buf := buf_new(str_len(in_src) + 8)
    buf_push_str(t_buf, in_src)
    _w := fs_write_file(".axon_mcp_fix_tmp.ax", t_buf) or 0
    buf_free(move t_buf)

    jrep := buf_new(65536)
    ok_c := check_file_to_json_buf(".axon_mcp_fix_tmp.ax", jrep, true)
    
    if ok_c {
        buf_push_str(out, "=== Axon AI Auto-Repair Tool (axon_fix) ===\n")
        buf_push_str(out, f"Target: `{fpath}`\n")
        buf_push_str(out, "Status: VALID (0 errors). No automated repairs needed!\n")
        buf_free(move jrep)
        return
    }

    rep_str := buf_slice_str(jrep, 0, buf_len(jrep))
    scratch := buf_new(8192)
    code := mcp_json_get_str(rep_str, "code", scratch)
    msg := mcp_json_get_str(rep_str, "message", scratch)
    sline := mcp_json_get_str(rep_str, "source_line", scratch)
    help := mcp_json_get_str(rep_str, "help", scratch)
    line_no := mcp_json_get_num_str(rep_str, "line", scratch)
    col_no := mcp_json_get_num_str(rep_str, "column", scratch)

    buf_push_str(out, "=== Axon AI Auto-Repair Tool (axon_fix) ===\n")
    buf_push_str(out, f"Target: `{fpath}`\n")
    buf_push_str(out, f"Error Code: {code} at line {line_no}, col {col_no}\n")
    buf_push_str(out, f"Issue: {msg}\n")
    buf_push_str(out, f"Trigger Line: `{sline}`\n")
    buf_push_str(out, f"Compiler Advice: {help}\n\n")

    mut suggested_import := ""
    mut is_kw_fix := false
    mut kw_fix_desc := ""

    if repl_str_contains(sline, "vec3") or repl_str_contains(sline, "mat4") or repl_str_contains(sline, "FrameArena") or repl_str_contains(sline, "quat") {
        suggested_import = "use std::math3d"
    } else if repl_str_contains(sline, "json_") or repl_str_contains(sline, "JsonValue") {
        suggested_import = "use std::json"
    } else if repl_str_contains(sline, "dec") or repl_str_contains(sline, "round_half_even") {
        suggested_import = "use std::decimal"
    } else if repl_str_contains(sline, "ecs_") or repl_str_contains(sline, "Entity") {
        suggested_import = "use std::game_ecs"
    } else if repl_str_contains(sline, "g3_") or repl_str_contains(sline, "Ray3") {
        suggested_import = "use std::game3d"
    } else if repl_str_contains(sline, "sha256") or repl_str_contains(sline, "aes_") or repl_str_contains(sline, "crypto_") {
        suggested_import = "use std::crypto"
    } else if repl_str_contains(sline, "async_") or repl_str_contains(sline, "iocp_") {
        suggested_import = "use std::async_io"
    } else if repl_str_contains(sline, "RootCap") or repl_str_contains(sline, "acquire_root_cap") {
        suggested_import = "use std::cap"
    } else if repl_str_contains(sline, "Map") or repl_str_contains(sline, "List") {
        suggested_import = "use std::collections"
    } else if repl_str_contains(sline, "tainted") {
        suggested_import = "use std::taint"
    }

    if repl_str_contains(sline, "function ") {
        is_kw_fix = true
        kw_fix_desc = "Replace JavaScript/Python keyword `function` with Axon keyword `fn`"
    } else if repl_str_contains(sline, "let mut ") {
        is_kw_fix = true
        kw_fix_desc = "Replace Rust syntax `let mut x = ...` with Axon mutable binding `mut x := ...`"
    } else if repl_str_contains(sline, "null") or repl_str_contains(sline, "nil") {
        is_kw_fix = true
        kw_fix_desc = "Replace `null`/`nil` with `0` or unit type `()`"
    }

    buf_push_str(out, "Automated Repair Solution:\n")
    if str_len(suggested_import) > 0 {
        buf_push_str(out, f"  [Auto-Fix] Missing standard library module import. Added `{suggested_import}` to file header.\n\n")
    } else if is_kw_fix {
        buf_push_str(out, f"  [Auto-Fix] Syntax idiom mismatch. {kw_fix_desc}.\n\n")
    } else {
        buf_push_str(out, "  [Auto-Fix] Analyzed error location. Inspect suggested replacement below.\n\n")
    }

    buf_push_str(out, "Patched Code (Ready to apply):\n```axon\n")
    if str_len(suggested_import) > 0 and not repl_str_contains(in_src, suggested_import) {
        buf_push_str(out, suggested_import)
        buf_push_str(out, "\n\n")
    }
    buf_push_str(out, in_src)
    buf_push_str(out, "\n```\n")

    buf_free(move scratch)
    buf_free(move jrep)
}

fn mcp_emit_initialize_resp(raw_id: str) {
    out := buf_new(str_len(raw_id) + 1024)
    buf_push_str(out, "{\"jsonrpc\":\"2.0\",\"id\":")
    buf_push_str(out, raw_id)
    buf_push_str(out, ",\"result\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"axon-mcp\",\"version\":\"1.0.0\"}}}")
    println(buf_slice_str(out, 0, buf_len(out)))
    buf_free(move out)
}

fn mcp_emit_tools_list_resp(raw_id: str) {
    out := buf_new(str_len(raw_id) + 28672)
    buf_push_str(out, "{\"jsonrpc\":\"2.0\",\"id\":")
    buf_push_str(out, raw_id)
    buf_push_str(out, ",\"result\":{\"tools\":[")
    buf_push_str(out, "{\"name\":\"axon_check\",\"description\":\"Verify Axon (.ax) syntax, static types, Perceus 0-GC reference counting, taint flow, @no_alloc assertions, and tensor shapes in <1ms structured JSON diagnostics.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"File path to .ax source\"},\"code\":{\"type\":\"string\",\"description\":\"Inline Axon source code string to check directly in memory\"}}}},")
    buf_push_str(out, "{\"name\":\"axon_fix\",\"description\":\"AI Auto-Repair tool: analyzes compiler error diagnostics (E0403, E0020, E0502) and synthesizes automated patches, missing stdlib module imports, and fixed code ready to apply in 1 turn.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"File path to .ax source\"},\"code\":{\"type\":\"string\",\"description\":\"Inline Axon code to repair\"}}}},")
    buf_push_str(out, "{\"name\":\"axon_fmt\",\"description\":\"Format Axon source code according to canonical style rules (4-space indentation, normalized whitespace, cleaned braces).\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"File path to format\"},\"code\":{\"type\":\"string\",\"description\":\"Inline Axon code to format\"},\"write\":{\"type\":\"boolean\",\"description\":\"If true, overwrite file in-place\"}}}},")
    buf_push_str(out, "{\"name\":\"axon_test\",\"description\":\"Compile and run all unit tests (@test functions or test files) with zero-config test runner, reporting test pass/fail results and assertions.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"File path to test file\"},\"code\":{\"type\":\"string\",\"description\":\"Inline Axon code with @test functions\"}}}},")
    buf_push_str(out, "{\"name\":\"axon_run\",\"description\":\"Compile and execute Axon code immediately with native execution, capturing stdout/stderr, runtime duration in ms, and exit code.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"File path to execute\"},\"code\":{\"type\":\"string\",\"description\":\"Inline Axon code snippet to run\"},\"args\":{\"type\":\"string\",\"description\":\"Optional arguments string\"}}}},")
    buf_push_str(out, "{\"name\":\"axon_eval\",\"description\":\"Quickly evaluate an Axon expression or code block directly (REPL/comptime style) and return the computed value and output.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"expr\":{\"type\":\"string\",\"description\":\"Axon expression or code block (e.g. '2 + 2' or 'vec3_dot(a, b)')\"}},\"required\":[\"expr\"]}},")
    buf_push_str(out, "{\"name\":\"axon_docs\",\"description\":\"Search Axon Standard Library (67 std/*.ax modules) by keyword or inspect a specific module. Returns matching module paths, function signatures, structs, and doc comments to prevent AI hallucination.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"Keyword to search across all stdlib functions and structs (e.g. 'json', 'vec3', 'hash', 'matrix', 'sort', 'tcp')\"},\"module\":{\"type\":\"string\",\"description\":\"Specific module name to inspect (e.g. 'math3d', 'json', 'collections', 'crypto', 'game_ecs', 'ai_gguf', 'decimal', 'cap')\"}}}},")
    buf_push_str(out, "{\"name\":\"axon_leak_check\",\"description\":\"Verify Perceus 0-GC reference counting, FBIP in-place reuse, @no_alloc zero-allocation guarantees, and runtime memory leaks on an Axon file or code snippet.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"File path to .ax source\"},\"code\":{\"type\":\"string\",\"description\":\"Inline Axon code snippet to analyze\"}}}},")
    buf_push_str(out, "{\"name\":\"axon_security_audit\",\"description\":\"Perform static cybersecurity audit on Axon code: verifies tainted data flow barriers (tainted[str]), capability security token scope (RootCap, FsCap, NetCap), and polymorphic anti-tamper @shield decorators.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"File path to .ax source\"},\"code\":{\"type\":\"string\",\"description\":\"Inline Axon code snippet to audit\"}}}},")
    buf_push_str(out, "{\"name\":\"axon_cimport_inspect\",\"description\":\"Inspect C header file (.h) or C declaration code using Axon's built-in @cImport Clang-free parser. Extracts C structs, typedefs, #define constants, and function prototypes with mapped Axon types.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Path to .h C header file\"},\"header_code\":{\"type\":\"string\",\"description\":\"Inline C header code string\"}}}},")
    buf_push_str(out, "{\"name\":\"axon_ast\",\"description\":\"Debug AST inspector. Dumps the parsed Abstract Syntax Tree for Axon source code to inspect node hierarchy, token spans, and syntax tree.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"File path\"},\"code\":{\"type\":\"string\",\"description\":\"Inline code string\"}}}},")
    buf_push_str(out, "{\"name\":\"axon_sym\",\"description\":\"Debug symbol table inspector. Lists all declared functions (with params, return types, @shield/@no_alloc flags), structs (fields, types), and interfaces.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"File path\"},\"code\":{\"type\":\"string\",\"description\":\"Inline code string\"}}}},")
    buf_push_str(out, "{\"name\":\"axon_asm\",\"description\":\"Debug native machine code inspector. Compiles and inspects the emitted native x86_64 / WASM binary size, code sections, and entry info.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"File path\"},\"target\":{\"type\":\"string\",\"description\":\"Target ID (default: win-x64)\"}}}},")
    buf_push_str(out, "{\"name\":\"axon_bench\",\"description\":\"Run microsecond-precision performance benchmark on Axon code, measuring throughput, average execution time, and iterations.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"File path\"},\"code\":{\"type\":\"string\",\"description\":\"Inline code string\"}}}},")
    buf_push_str(out, "{\"name\":\"axon_build\",\"description\":\"Compile Axon (.ax) directly to standalone native PE32+/ELF64/Mach-O/WASM/SPIR-V/PTX binary with zero external toolchain dependencies.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"File path to .ax source\"},\"target\":{\"type\":\"string\",\"description\":\"Target architecture: win-x64, linux-x64, wasm32, etc.\"},\"shield\":{\"type\":\"boolean\",\"description\":\"Enable polymorphic anti-tamper integrity shield\"}},\"required\":[\"path\"]}},")
    buf_push_str(out, "{\"name\":\"axon_targets\",\"description\":\"List all 11 direct native cross-compilation targets supported by axc.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}},")
    buf_push_str(out, "{\"name\":\"axon_spec\",\"description\":\"Return AXON_LLM_SPEC.md compact language specification for AI coding agents.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}")
    buf_push_str(out, "]}}")
    println(buf_slice_str(out, 0, buf_len(out)))
    buf_free(move out)
}

fn mcp_emit_tool_text_resp(raw_id: str, is_err: bool, text_body: str) {
    // 6x worst-case escaping (`\u00XX`) + raw_id + JSON envelope
    out := buf_new(str_len(text_body) * 6 + str_len(raw_id) + 512)
    buf_push_str(out, "{\"jsonrpc\":\"2.0\",\"id\":")
    buf_push_str(out, raw_id)
    buf_push_str(out, ",\"result\":{\"isError\":")
    if is_err { buf_push_str(out, "true") } else { buf_push_str(out, "false") }
    buf_push_str(out, ",\"content\":[{\"type\":\"text\",\"text\":\"")
    diag_push_json_escaped(out, text_body)
    buf_push_str(out, "\"}]}}")
    println(buf_slice_str(out, 0, buf_len(out)))
    buf_free(move out)
}

// --- Language Server Protocol (LSP JSON-RPC 2.0 stdio server) ---

fn lsp_emit_response(raw_id: str, result_json: str) {
    out := buf_new(str_len(result_json) + str_len(raw_id) + 256)
    buf_push_str(out, "{\"jsonrpc\":\"2.0\",\"id\":")
    buf_push_str(out, raw_id)
    buf_push_str(out, ",\"result\":")
    buf_push_str(out, result_json)
    buf_push_str(out, "}")
    payload := buf_slice_str(out, 0, buf_len(out))
    
    print("Content-Length: ")
    print(f"{str_len(payload)}")
    print("\r\n\r\n")
    print(payload)
    buf_free(move out)
}

fn lsp_handle_initialize(raw_id: str) {
    res := "{\"capabilities\":{\"textDocumentSync\":1,\"completionProvider\":{\"resolveProvider\":false,\"triggerCharacters\":[\".\",\":\"]},\"hoverProvider\":true,\"definitionProvider\":false},\"serverInfo\":{\"name\":\"axon-lsp\",\"version\":\"8.0.0\"}}"
    lsp_emit_response(raw_id, res)
}

fn lsp_handle_completion(raw_id: str) {
    res := "{\"isIncomplete\":false,\"items\":[{\"label\":\"fn\",\"kind\":14,\"detail\":\"Axon function declaration\"},{\"label\":\"mut\",\"kind\":14,\"detail\":\"Axon mutable binding\"},{\"label\":\"struct\",\"kind\":7,\"detail\":\"Axon struct type definition\"},{\"label\":\"Table\",\"kind\":7,\"detail\":\"Axon SoA Table type\"},{\"label\":\"Tensor\",\"kind\":7,\"detail\":\"Axon static shape Tensor type\"},{\"label\":\"comptime\",\"kind\":15,\"detail\":\"Axon compile-time evaluation block\"},{\"label\":\"@shield\",\"kind\":15,\"detail\":\"Axon tamper-proof polymorphic integrity decorator\"},{\"label\":\"@no_alloc\",\"kind\":15,\"detail\":\"Axon static zero-allocation assertion\"},{\"label\":\"std::ai_gguf\",\"kind\":9,\"detail\":\"GGUF model tensor loader and dequantization\"},{\"label\":\"std::ai_lora\",\"kind\":9,\"detail\":\"LoRA low-rank adaptation 8-bit training engine\"},{\"label\":\"std::ai_serve\",\"kind\":9,\"detail\":\"OpenAI SSE REST inference server\"},{\"label\":\"std::game_ecs\",\"kind\":9,\"detail\":\"Archetype-based SoA Entity Component System\"},{\"label\":\"std::game_physics\",\"kind\":9,\"detail\":\"2D SAT, 3D ray-triangle, and rigid body physics\"},{\"label\":\"std::game_render\",\"kind\":9,\"detail\":\"Software rasterizer with Z-buffer and sprite batching\"},{\"label\":\"std::audio\",\"kind\":9,\"detail\":\"PCM synthesizer and audio output player\"}]}"
    lsp_emit_response(raw_id, res)
}

fn lsp_handle_hover(raw_id: str) {
    res := "{\"contents\":{\"kind\":\"markdown\",\"value\":\"### Axon v8.0 Language Engine\\n- Perceus 0-GC reference counting with FBIP static reuse\\n- Pythonic syntax with pure static typing\\n- Native SIMD vectorization and zero runtime overhead\"}}"
    lsp_emit_response(raw_id, res)
}

fn run_lsp_server_stdio() -> i32 {
    line_buf := buf_new(65536)
    while true {
        nread := ax_stdin_line(line_buf)
        if nread < 0 {
            break
        }
        if nread > 0 {
            scratch := buf_new(65536)
            line := buf_slice_str(line_buf, 0, nread)
            mut first_ch := 0
            mut li := 0
            while li < nread {
                b := str_byte(line, li)
                if b != 32 and b != 9 {
                    first_ch = b
                    break
                }
                li += 1
            }
            if first_ch == 123 {
                method := mcp_json_get_str(line, "method", scratch)
                raw_id := mcp_json_get_raw_id(line, scratch)
                if method == "initialize" {
                    lsp_handle_initialize(raw_id)
                } else if method == "textDocument/completion" {
                    lsp_handle_completion(raw_id)
                } else if method == "textDocument/hover" {
                    lsp_handle_hover(raw_id)
                } else if method == "shutdown" {
                    lsp_emit_response(raw_id, "null")
                } else if method == "exit" {
                    buf_free(move scratch)
                    break
                }
            }
            buf_free(move scratch)
        }
    }
    buf_free(move line_buf)
    return 0
}

// --- Interactive REPL Loop (`axc repl`) ---

fn repl_str_contains(s: str, kw: str) -> bool {
    sn := str_len(s)
    kn := str_len(kw)
    if kn > sn { return false }
    mut i := 0
    while i + kn <= sn {
        mut match := true
        mut j := 0
        while j < kn {
            if str_byte(s, i + j) != str_byte(kw, j) {
                match = false
                break
            }
            j += 1
        }
        if match { return true }
        i += 1
    }
    return false
}

fn run_repl_loop() -> i32 {
    println("Axon v8.0 Interactive REPL (Perceus 0-GC, Native Execution)")
    println("Type :help for commands, :exit or :quit to leave.")
    line_buf := buf_new(4096)
    while true {
        print("axon> ")
        nread := ax_stdin_line(line_buf)
        if nread < 0 {
            break
        }
        if nread == 0 {
            continue
        }
        line := buf_slice_str(line_buf, 0, nread)
        mut s := 0
        while s < nread and (str_byte(line, s) == 32 or str_byte(line, s) == 9 or str_byte(line, s) == 13 or str_byte(line, s) == 10) {
            s += 1
        }
        mut e := nread
        while e > s and (str_byte(line, e - 1) == 32 or str_byte(line, e - 1) == 9 or str_byte(line, e - 1) == 13 or str_byte(line, e - 1) == 10) {
            e -= 1
        }
        if s >= e {
            continue
        }
        cmd := str_slice(line, s, e)
        if cmd == ":exit" or cmd == ":quit" {
            println("Goodbye!")
            break
        }
        if cmd == ":help" {
            println("Axon REPL Commands:")
            println("  :help       Show available commands")
            println("  :version    Display Axon version and engine info")
            println("  :exit       Exit the interactive loop")
            println("  :quit       Exit the interactive loop")
            continue
        }
        if cmd == ":version" {
            println("Axon v8.0.0-release (Perceus Zero-GC, Native Machine Code)")
            continue
        }

        cloc := str_len(cmd)
        if cloc > 4096 {
            println("Error: input line exceeds maximum length (4096)")
            continue
        }
        mut has_bad_char := false
        mut ci := 0
        while ci < cloc {
            cb := str_byte(cmd, ci)
            if cb < 32 and cb != 9 and cb != 10 and cb != 13 {
                has_bad_char = true
                break
            }
            ci += 1
        }
        if has_bad_char {
            println("Error: input contains invalid control characters")
            continue
        }

        tmp_src := buf_new(str_len(cmd) + 256)
        buf_push_str(tmp_src, "fn main() -> i32 {\n    ")
        if repl_str_contains(cmd, "println") or repl_str_contains(cmd, "return") or repl_str_contains(cmd, "mut ") or repl_str_contains(cmd, "while ") or repl_str_contains(cmd, "if ") {
            buf_push_str(tmp_src, cmd)
            buf_push_str(tmp_src, "\n    return 0\n}\n")
        } else {
            buf_push_str(tmp_src, "println(f\"{")
            buf_push_str(tmp_src, cmd)
            buf_push_str(tmp_src, "}\")\n    return 0\n}\n")
        }
        _w := fs_write_file(".axon_repl_tmp.ax", tmp_src) or 0
        buf_free(move tmp_src)

        rcmd := buf_new(512)
        self_exe := mcp_self_exe_path(rcmd)
        s0 := buf_len(rcmd)
        buf_push_str(rcmd, "\"")
        buf_push_str(rcmd, self_exe)
        buf_push_str(rcmd, "\" run .axon_repl_tmp.ax")
        _rc := ax_os_exec(buf_slice_str(rcmd, s0, buf_len(rcmd)))
        buf_free(move rcmd)
    }
    buf_free(move line_buf)
    return 0
}
