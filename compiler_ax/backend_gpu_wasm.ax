        wasm_local_get(c, ttmp); wasm_op4(c, 0x50, 0x04, 0x40, 0x00); buf_push(c, 0x0B)
        wasm_local_get(c, itmp); wasm_wrap_mem(c, ttmp, 0x29, 3, 0); wasm_trap_ge_u(c)
        wasm_wrap_mem(c, ttmp, 0x28, 2, 16); wasm_get_wrap(c, itmp)
        if tty == ty_intbuf() {
            wasm_i32_const(c, 3); wasm_op2(c, 0x74, 0x6A); wasm_mem_op(c, 0x29, 3, 0)
        } else {
            buf_push(c, 0x6A); wasm_mem_op(c, 0x31, 0, 0)
        }
        return
    }
    if k == nk_unary() {
        op := ast_get(wc.nodes, enid, 1); sub := ast_get(wc.nodes, enid, 2)
        if op == uop_neg() {
