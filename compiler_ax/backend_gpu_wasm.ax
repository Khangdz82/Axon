    }
    if k == nk_index() {
        te := ast_get(wc.nodes, enid, 1)
        ie := ast_get(wc.nodes, enid, 2)
        tty := wasm_infer_expr_ty(wc, te)
        ttmp := wasm_alloc_tmp(wc)
        itmp := wasm_alloc_tmp(wc)
        wasm_emit_expr(wc, c, te); wasm_local_set(c, ttmp)
        wasm_emit_expr(wc, c, ie); wasm_local_set(c, itmp)
        if tty == ty_str() {
            wasm_local_get(c, itmp)
            wasm_local_get(c, ttmp); wasm_i64_const(c, 32); buf_push(c, 0x88)
            buf_push(c, 0x5A) // i64.ge_u
            wasm_trap_ge_u(c)
            wasm_get_wrap(c, ttmp); wasm_get_wrap(c, itmp); buf_push(c, 0x6A)
