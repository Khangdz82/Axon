            wasm_i32_const(c, 0); wasm_mem_op(c, 0x3A, 0, 0)
            wasm_local_get(c, dst); wasm_local_get(c, slen); wasm_i64_const(c, 32); wasm_op2(c, 0x86, 0x84)
            return
        }
        if (pool_str_eq_lit(wc.pool, fsoff, fslen, "buf_truncate") or pool_str_eq_lit(wc.pool, fsoff, fslen, "ibuf_truncate")) and acnt == 2 {
            btmp := wasm_alloc_tmp(wc); ntmp := wasm_alloc_tmp(wc)
            wasm_arg_set(wc, c, aoff, 0, btmp)
            wasm_arg_set(wc, c, aoff, 1, ntmp)
            wasm_local_get(c, ntmp); wasm_wrap_mem(c, btmp, 0x29, 3, 0); wasm_op3(c, 0x54, 0x04, 0x40)
            wasm_get_wrap(c, btmp); wasm_local_get(c, ntmp); wasm_mem_op(c, 0x37, 3, 0)
            buf_push(c, 0x0B); wasm_i64_const(c, 0); return
        }
        if pool_str_eq_lit(wc.pool, fsoff, fslen, "buf_free") and acnt == 1 {
            wasm_arg_expr(wc, c, aoff, 0); buf_push(c, 0x1A)
            wasm_i64_const(c, 0); return
        }
        if pool_str_eq_lit(wc.pool, fsoff, fslen, "ibuf_push") and acnt == 2 {
            wasm_arg_expr(wc, c, aoff, 0); buf_push(c, 0xA7)
            wasm_arg_expr(wc, c, aoff, 1)
            wasm_call(c, wfn_ibuf_push()); wasm_i64_const(c, 0); return
        }
        if pool_str_eq_lit(wc.pool, fsoff, fslen, "ibuf_get") and acnt == 2 {
            wasm_emit_buf_elem_op(wc, c, aoff, 0, 1); return
        }
        if pool_str_eq_lit(wc.pool, fsoff, fslen, "ibuf_set") and acnt == 3 {
            wasm_emit_buf_elem_op(wc, c, aoff, 1, 1); return
        }
        if pool_str_eq_lit(wc.pool, fsoff, fslen, "str_len") and acnt == 1 {
            wasm_arg_expr(wc, c, aoff, 0)
            wasm_i64_const(c, 32); buf_push(c, 0x88); return
        }
        if pool_str_eq_lit(wc.pool, fsoff, fslen, "str_byte") and acnt == 2 {
            stmp := wasm_alloc_tmp(wc); itmp := wasm_alloc_tmp(wc)
            wasm_arg_set(wc, c, aoff, 0, stmp)
            wasm_arg_set(wc, c, aoff, 1, itmp)
            wasm_local_get(c, itmp); wasm_local_get(c, stmp); wasm_i64_const(c, 32); buf_push(c, 0x88); wasm_trap_ge_u(c)
            wasm_get_wrap(c, stmp); wasm_get_wrap(c, itmp); buf_push(c, 0x6A)
            wasm_mem_op(c, 0x31, 0, 0); return
        }
        if pool_str_eq_lit(wc.pool, fsoff, fslen, "str_slice") and acnt == 3 {
            stmp := wasm_alloc_tmp(wc); st := wasm_alloc_tmp(wc); en := wasm_alloc_tmp(wc)
            wasm_arg_set(wc, c, aoff, 0, stmp)
            wasm_arg_set(wc, c, aoff, 1, st)
            wasm_arg_set(wc, c, aoff, 2, en)
            wasm_local_get(c, st); wasm_local_get(c, en); wasm_op4(c, 0x56, 0x04, 0x40, 0x00); buf_push(c, 0x0B)
            wasm_local_get(c, en); wasm_local_get(c, stmp); wasm_i64_const(c, 32); buf_push(c, 0x88); wasm_op4(c, 0x56, 0x04, 0x40, 0x00); buf_push(c, 0x0B)
            wasm_get_wrap(c, stmp); wasm_get_wrap(c, st); wasm_op2(c, 0x6A, 0xAD)
            wasm_local_get(c, en); wasm_local_get(c, st); buf_push(c, 0x7D)
            wasm_i64_const(c, 32); wasm_op2(c, 0x86, 0x84); return
        }
        if pool_str_eq_lit(wc.pool, fsoff, fslen, "str_eq") and acnt == 2 {
            wasm_arg_expr(wc, c, aoff, 0)
            wasm_arg_expr(wc, c, aoff, 1)
            wasm_call(c, wfn_str_eq()); return
        }
        if pool_str_eq_lit(wc.pool, fsoff, fslen, "ok") and acnt == 1 {
            wasm_emit_ok_or_err(wc, c, wasm_arg_nid(wc, aoff, 0), 0); return
        }
        if pool_str_eq_lit(wc.pool, fsoff, fslen, "err") and acnt == 1 {
            wasm_emit_ok_or_err(wc, c, wasm_arg_nid(wc, aoff, 0), 1); return
        }
        if pool_str_eq_lit(wc.pool, fsoff, fslen, "ushr64") and acnt == 2 {
            xtmp := wasm_alloc_tmp(wc); ktmp := wasm_alloc_tmp(wc)
            wasm_arg_set(wc, c, aoff, 0, xtmp)
            wasm_arg_expr(wc, c, aoff, 1); wasm_local_tee(c, ktmp)
            wasm_i64_const(c, 64); wasm_op3(c, 0x5A, 0x04, 0x7E)
            wasm_i64_const(c, 0); buf_push(c, 0x05)
            wasm_local_get(c, xtmp); wasm_local_get(c, ktmp); wasm_op2(c, 0x88, 0x0B); return
        }
        if pool_str_eq_lit(wc.pool, fsoff, fslen, "abs_f64") and acnt == 1 {
            wasm_arg_expr(wc, c, aoff, 0)
            wasm_op3(c, 0xBF, 0x99, 0xBD); return
        }
        if pool_str_eq_lit(wc.pool, fsoff, fslen, "sqrt_f64") and acnt == 1 {
            wasm_arg_expr(wc, c, aoff, 0)
            wasm_op3(c, 0xBF, 0x9F, 0xBD); return
        }
        if pool_str_eq_lit(wc.pool, fsoff, fslen, "exit_process") and acnt == 1 {
            wasm_arg_expr(wc, c, aoff, 0); buf_push(c, 0xA7)
            wasm_call(c, wfn_proc_exit()); wasm_i64_const(c, 0); return
        }
        if pool_str_eq_lit(wc.pool, fsoff, fslen, "assert") and acnt >= 1 {
            wasm_arg_expr(wc, c, aoff, 0)
            wasm_op3(c, 0x50, 0x04, 0x40)
            wasm_i32_const(c, 1); wasm_call(c, wfn_proc_exit())
            buf_push(c, 0x0B); wasm_i64_const(c, 0); return
        }
        if (pool_str_eq_lit(wc.pool, fsoff, fslen, "trusted_str_unwrap") or pool_str_eq_lit(wc.pool, fsoff, fslen, "taint_str") or pool_str_eq_lit(wc.pool, fsoff, fslen, "env_input_tainted") or pool_str_eq_lit(wc.pool, fsoff, fslen, "tainted_raw_str")) and acnt == 1 {
            wasm_arg_expr(wc, c, aoff, 0)
            return
        }

        // Struct Constructor `StructName(args...)` (Positional + Named Field Args!)
        sidx := find_struct_idx(wc.pool, wc.sym, fsoff, fslen)
        if sidx >= 0 {
            s_off := ibuf_get(wc.sym, 3) + sidx * 6
            mut tot_slots := ibuf_get(wc.sym, s_off + 2)
            if tot_slots < 1 { tot_slots = 1 }
            f_base := ibuf_get(wc.sym, s_off + 3)
            f_cnt := ibuf_get(wc.sym, s_off + 4)
            sptr := wasm_alloc_tmp(wc)
            wasm_i32_const(c, tot_slots * 8); wasm_call(c, wfn_alloc()); buf_push(c, 0xAD); wasm_local_set(c, sptr)
            mut sfi := 0
            while sfi < f_cnt {
                sfo := f_base + sfi * 4
                fn_soff := ibuf_get(wc.sym, sfo)
                fn_slen := ibuf_get(wc.sym, sfo + 1)
                f_slot_off := ibuf_get(wc.sym, sfo + 2)
                mut matched_ca := 0
                mut ai := 0
                while ai < acnt {
                    ca := ibuf_get(wc.extra, aoff + ai)
                    an_soff := ast_get(wc.nodes, ca, 2)
                    an_slen := ast_get(wc.nodes, ca, 3)
                    if an_soff >= 0 and an_slen == fn_slen and pool_str_eq2(wc.pool, an_soff, fn_slen, fn_soff) {
                        matched_ca = ca; break
                    }
                    ai += 1
                }
                if matched_ca == 0 and sfi < acnt {
                    cand := ibuf_get(wc.extra, aoff + sfi)
                    if ast_get(wc.nodes, cand, 2) < 0 { matched_ca = cand }
                }
                wasm_local_get(c, sptr); buf_push(c, 0xA7)
                if matched_ca > 0 {
                    wasm_emit_expr(wc, c, ast_get(wc.nodes, matched_ca, 4))
                } else {
                    wasm_i64_const(c, 0)
                }
                buf_push(c, 0x37); wasm_memarg(c, 3, f_slot_off * 8)
                sfi += 1
            }
            wasm_local_get(c, sptr)
            return
        }

        // User / Stdlib Function Call (Positional + Named + Default Params)
        fi := find_fn_idx(wc.pool, wc.sym, fsoff, fslen)
        if fi >= 0 {
            wasm_emit_user_call_with_recv(wc, c, fi, 0, aoff, acnt)
            return
        }
    }
    if k == nk_await() or k == nk_comptime_expr() {
        wasm_emit_expr(wc, c, ast_get(wc.nodes, enid, 1))
        return
    }
    wasm_i64_const(c, 0)
}

fn wasm_emit_block(wc: WasmCtx, c: ByteBuf, bnid: i64, brk_d: i64, cont_d: i64) {
    if bnid <= 0 { return }
    saved_lcnt := ibuf_get(wc.state, 1)
    soff := ast_get(wc.nodes, bnid, 1)
    scnt := ast_get(wc.nodes, bnid, 2)
    mut i := 0
    while i < scnt {
        wasm_emit_stmt(wc, c, ibuf_get(wc.extra, soff + i), brk_d, cont_d)
        i += 1
    }
    ibuf_set(wc.state, 1, saved_lcnt)
}

fn wasm_emit_compound_rhs(wc: WasmCtx, c: ByteBuf, lhs_ty: i64, aop: i64, rhs: i64) {
    if ty_tag(lhs_ty) == ty_float() {
        buf_push(c, 0xBF)
        wasm_emit_expr(wc, c, rhs)
        if ty_tag(wasm_infer_expr_ty(wc, rhs)) == ty_float() { buf_push(c, 0xBF) } else { buf_push(c, 0xB9) }
        wasm_emit_aop(c, aop, 1)
    } else {
        wasm_emit_expr(wc, c, rhs)
        wasm_emit_aop(c, aop, 0)
    }
}

fn wasm_emit_stmt(wc: WasmCtx, c: ByteBuf, snid: i64, brk_d: i64, cont_d: i64) {
    if snid <= 0 { return }
    k := ast_kind(wc.nodes, snid)
    if k == nk_var_decl() {
        vsoff := ast_get(wc.nodes, snid, 1)
        vslen := ast_get(wc.nodes, snid, 2)
        tnid := ast_get(wc.nodes, snid, 4)
        init_e := ast_get(wc.nodes, snid, 5)
        mut vty := wasm_infer_expr_ty(wc, init_e)
        if tnid != 0 {
            ibuf_set(wc.sym, 13, tnid)
            vty = resolve_typespec(wc.pool, wc.nodes, wc.extra, wc.sym)
        }
        lidx := wasm_alloc_local(wc, vsoff, vslen, vty)
        wasm_emit_expr(wc, c, init_e)
        wasm_local_set(c, lidx)
        return
    }
    if k == nk_tuple_destruct() {
        noff := ast_get(wc.nodes, snid, 1)
        ncnt := ast_get(wc.nodes, snid, 2)
        init_e := ast_get(wc.nodes, snid, 3)
        tty := wasm_infer_expr_ty(wc, init_e)
        tptr := wasm_alloc_tmp(wc)
        wasm_emit_expr(wc, c, init_e)
        wasm_local_set(c, tptr)
        mut i := 0
        while i < ncnt {
            nsoff := ibuf_get(wc.extra, noff + i * 2)
            nslen := ibuf_get(wc.extra, noff + i * 2 + 1)
            mut ety := ty_int()
            if ty_tag(tty) == 14 {
                doff := ty_pay(tty)
                if i < ibuf_get(wc.sym, doff) {
                    ety = ibuf_get(wc.sym, doff + 1 + i)
                }
            }
            vidx := wasm_alloc_local(wc, nsoff, nslen, ety)
            wasm_wrap_mem(c, tptr, 0x29, 3, i * 8); wasm_local_set(c, vidx)
            i += 1
        }
        return
    }
    if k == nk_assign() {
        aop := ast_get(wc.nodes, snid, 1); lhs := ast_get(wc.nodes, snid, 2); rhs := ast_get(wc.nodes, snid, 3)
        lk := ast_kind(wc.nodes, lhs)
        if lk == nk_ident() {
            lb := wasm_find_local(wc, ast_get(wc.nodes, lhs, 1), ast_get(wc.nodes, lhs, 2))
            if lb >= 0 {
                lidx := ibuf_get(wc.locals, lb + 2); lty := ibuf_get(wc.locals, lb + 3)
                if aop == aop_eq() { wasm_emit_expr(wc, c, rhs) }
                else { wasm_local_get(c, lidx); wasm_emit_compound_rhs(wc, c, lty, aop, rhs) }
                wasm_local_set(c, lidx)
            }
        } else if lk == nk_field() {
            base_e := ast_get(wc.nodes, lhs, 1); bty := wasm_infer_expr_ty(wc, base_e)
            if ty_tag(bty) == 10 {
                fo := find_struct_field(wc.pool, wc.sym, ty_pay(bty), ast_get(wc.nodes, lhs, 2) | (ast_get(wc.nodes, lhs, 3) << 32))
                if fo >= 0 {
                    f_off := ibuf_get(wc.sym, fo + 2); f_ty := ibuf_get(wc.sym, fo + 3)
                    sptr := wasm_alloc_tmp(wc)
                    wasm_emit_expr(wc, c, base_e); wasm_local_set(c, sptr)
                    wasm_get_wrap(c, sptr)
                    if aop == aop_eq() { wasm_emit_expr(wc, c, rhs) }
                    else { wasm_wrap_mem(c, sptr, 0x29, 3, f_off * 8); wasm_emit_compound_rhs(wc, c, f_ty, aop, rhs) }
                    wasm_mem_op(c, 0x37, 3, f_off * 8)
                }
            }
        }
        return
    }
    if k == nk_if() {
        wasm_emit_expr(wc, c, ast_get(wc.nodes, snid, 1))
        wasm_i64_const(c, 0); wasm_op3(c, 0x52, 0x04, 0x40)
        mut nb := -1; if brk_d >= 0 { nb = brk_d + 1 }
        mut nc := -1; if cont_d >= 0 { nc = cont_d + 1 }
        wasm_emit_block(wc, c, ast_get(wc.nodes, snid, 2), nb, nc)
        eb := ast_get(wc.nodes, snid, 3)
        if eb != 0 {
            buf_push(c, 0x05)
            if ast_kind(wc.nodes, eb) == nk_if() { wasm_emit_stmt(wc, c, eb, nb, nc) }
            else { wasm_emit_block(wc, c, eb, nb, nc) }
        }
        buf_push(c, 0x0B); return
    }
    if k == nk_while() {
        wasm_loop_hdr(c)
        wasm_emit_expr(wc, c, ast_get(wc.nodes, snid, 1))
        wasm_op3(c, 0x50, 0x0D, 0x01)
        wasm_emit_block(wc, c, ast_get(wc.nodes, snid, 2), 1, 0)
        wasm_loop_end(c); return
    }
    if k == nk_for_range() or k == nk_par_for_range() {
        iv_idx := wasm_alloc_local(wc, ast_get(wc.nodes, snid, 1), ast_get(wc.nodes, snid, 2), ty_int())
        end_idx := wasm_alloc_tmp(wc)
        wasm_emit_expr(wc, c, ast_get(wc.nodes, snid, 3)); wasm_local_set(c, iv_idx)
        wasm_emit_expr(wc, c, ast_get(wc.nodes, snid, 4)); wasm_local_set(c, end_idx)

        wasm_loop_hdr(c)
        wasm_local_get(c, iv_idx); wasm_local_get(c, end_idx); wasm_op3(c, 0x59, 0x0D, 0x01)
        wasm_op2(c, 0x02, 0x40) // cont = 0 -> lands at increment!
        wasm_emit_block(wc, c, ast_get(wc.nodes, snid, 5), 2, 0)
        buf_push(c, 0x0B)
        wasm_local_get(c, iv_idx); wasm_i64_const(c, 1); buf_push(c, 0x7C); wasm_local_set(c, iv_idx)
        buf_push(c, 0x0C); wasm_uleb(c, 0)
        buf_push(c, 0x0B); buf_push(c, 0x0B)
        return
    }
    if k == nk_for_each() or k == nk_par_for_each() {
        tbl_e := ast_get(wc.nodes, snid, 3)
        plan_off := ast_get(wc.nodes, snid, 5)
        if plan_off <= 0 { return }
        ops_cnt := ibuf_get(wc.extra, plan_off + 1)
        if ops_cnt <= 0 { return }

        tbl_tmp := wasm_alloc_tmp(wc)
        cnt_tmp := wasm_alloc_tmp(wc)
        base_tmp := wasm_alloc_tmp(wc)
        wasm_emit_expr(wc, c, tbl_e); wasm_local_set(c, tbl_tmp)
        wasm_local_get(c, tbl_tmp); wasm_i64_const(c, 0xFFFFFFFF); buf_push(c, 0x83); wasm_local_set(c, base_tmp)
        wasm_local_get(c, tbl_tmp); wasm_i64_const(c, 32); buf_push(c, 0x88); wasm_local_set(c, cnt_tmp)

        mut oi := 0
        while oi < ops_cnt {
            obase := plan_off + 2 + oi * 4
            okind := ibuf_get(wc.extra, obase)
            dst_col := ibuf_get(wc.extra, obase + 1)
            src_col := ibuf_get(wc.extra, obase + 2)
            scale_e := ibuf_get(wc.extra, obase + 3)

            // dst_ptr
            wasm_emit_col_ptr(c, base_tmp, cnt_tmp, dst_col)

            is_fma := okind == 1 or okind == 3 or okind == 4 or okind == 5
            if is_fma {
                // src_ptr
                wasm_emit_col_ptr(c, base_tmp, cnt_tmp, src_col)
            }

            if scale_e > 0 {
                wasm_emit_expr(wc, c, scale_e)
                if ty_tag(wasm_infer_expr_ty(wc, scale_e)) != ty_float() { buf_push(c, 0xB9) } else { buf_push(c, 0xBF) }
                buf_push(c, 0xB6) // f32.demote_f64
                if okind == 4 { buf_push(c, 0x8C) } // f32.neg
            } else {
                if okind == 5 {
                    wasm_i64_const(c, -4616189618054758400) // -1.0f64 (0xBFF0000000000000)
                } else {
                    wasm_i64_const(c, 0x3FF0000000000000) // 1.0f64
                }
                buf_push(c, 0xBF); buf_push(c, 0xB6)
            }

            wasm_local_get(c, cnt_tmp); buf_push(c, 0xA7)
            if is_fma {
                wasm_call(c, wfn_simd128_fma())
            } else {
                wasm_call(c, wfn_simd128_mul())
            }
            oi += 1
        }
        return
    }
    if k == nk_break() {
        if brk_d >= 0 { buf_push(c, 0x0C); wasm_uleb(c, brk_d) }
        return
    }
    if k == nk_continue() {
        if cont_d >= 0 { buf_push(c, 0x0C); wasm_uleb(c, cont_d) }
        return
    }
    if k == nk_return() {
        re := ast_get(wc.nodes, snid, 1)
        if re != 0 { wasm_emit_expr(wc, c, re) } else { wasm_i64_const(c, 0) }
        buf_push(c, 0x0F)
        return
    }
    if k == nk_expr_stmt() {
        wasm_emit_expr(wc, c, ast_get(wc.nodes, snid, 1))
        buf_push(c, 0x1A)
        return
    }
    if k == nk_block() {
        wasm_emit_block(wc, c, snid, brk_d, cont_d)
    }
}

// --- Whole-Program Reachability Tree-Shaking for WASM32 ---

fn wasm_enqueue_fn(live: IntBuf, queue: IntBuf, fi: i64) {
    if fi >= 0 and fi < ibuf_len(live) and ibuf_get(live, fi) == 0 {
        ibuf_set(live, fi, 1)
        ibuf_push(queue, fi)
    }
}

fn wasm_scan_expr(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, live: IntBuf, queue: IntBuf, enid: i64) {
    if enid <= 0 { return }
    k := ast_kind(nodes, enid)
    if k == nk_call() {
        fsoff := ast_get(nodes, enid, 1); fslen := ast_get(nodes, enid, 2)
        fi := find_fn_idx(pool, sym, fsoff, fslen)
        if fi >= 0 { wasm_enqueue_fn(live, queue, fi) }
        aoff := ast_get(nodes, enid, 3); acnt := ast_get(nodes, enid, 4)
        mut ai := 0
        while ai < acnt {
            wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, ibuf_get(extra, aoff + ai), 4))
            ai += 1
        }
        return
    }
    if k == nk_method_call() {
        wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 1))
        fi := find_fn_idx(pool, sym, ast_get(nodes, enid, 2), ast_get(nodes, enid, 3))
        if fi >= 0 { wasm_enqueue_fn(live, queue, fi) }
        aoff := ast_get(nodes, enid, 4); acnt := ast_get(nodes, enid, 5)
        mut ai := 0
        while ai < acnt {
            wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, ibuf_get(extra, aoff + ai), 4))
            ai += 1
        }
        return
    }
    if k == nk_fstr() or k == nk_tuple() {
        poff := ast_get(nodes, enid, 1); pcnt := ast_get(nodes, enid, 2)
        mut pi := 0
        while pi < pcnt {
            wasm_scan_expr(pool, nodes, extra, sym, live, queue, ibuf_get(extra, poff + pi))
            pi += 1
        }
        return
    }
    if k == nk_binary() or k == nk_or_return() or k == nk_index() {
        wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 2))
        wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 3))
        if k == nk_index() or k == nk_or_return() {
            wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 1))
        }
        return
    }
    if k == nk_unary() {
        wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 2)); return
    }
    if k == nk_cast() or k == nk_field() or k == nk_tuple_idx() or k == nk_await() or k == nk_comptime_expr() {
        wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 1)); return
    }
    if k == nk_table_alloc() {
        wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 3)); return
    }
    if k == nk_if_expr() {
        wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 1))
        wasm_scan_block(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 2))
        eb := ast_get(nodes, enid, 3)
        if ast_kind(nodes, eb) == nk_if_expr() { wasm_scan_expr(pool, nodes, extra, sym, live, queue, eb) }
        else { wasm_scan_block(pool, nodes, extra, sym, live, queue, eb) }
        return
    }
    if k == nk_spawn() {
        wasm_scan_block(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 1))
    }
}

fn wasm_scan_stmt(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, live: IntBuf, queue: IntBuf, st: i64) {
    if st <= 0 { return }
    sk := ast_kind(nodes, st)
    if sk == nk_var_decl() { wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, st, 5)) }
    else if sk == nk_tuple_destruct() { wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, st, 3)) }
    else if sk == nk_assign() {
        wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, st, 2))
        wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, st, 3))
    } else if sk == nk_if() {
        wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, st, 1))
        wasm_scan_block(pool, nodes, extra, sym, live, queue, ast_get(nodes, st, 2))
        eb := ast_get(nodes, st, 3)
        if ast_kind(nodes, eb) == nk_if() { wasm_scan_stmt(pool, nodes, extra, sym, live, queue, eb) }
        else { wasm_scan_block(pool, nodes, extra, sym, live, queue, eb) }
    } else if sk == nk_while() {
        wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, st, 1))
        wasm_scan_block(pool, nodes, extra, sym, live, queue, ast_get(nodes, st, 2))
    } else if sk == nk_for_range() or sk == nk_par_for_range() {
        wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, st, 3))
        wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, st, 4))
        wasm_scan_block(pool, nodes, extra, sym, live, queue, ast_get(nodes, st, 5))
    } else if sk == nk_for_each() or sk == nk_par_for_each() {
        wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, st, 3))
        plan_off := ast_get(nodes, st, 5)
        if plan_off > 0 {
            ocnt := ibuf_get(extra, plan_off + 1)
            mut oi := 0
            while oi < ocnt {
                wasm_scan_expr(pool, nodes, extra, sym, live, queue, ibuf_get(extra, plan_off + 2 + oi * 4 + 3))
                oi += 1
            }
        }
        wasm_scan_block(pool, nodes, extra, sym, live, queue, ast_get(nodes, st, 4))
    } else if sk == nk_return() or sk == nk_expr_stmt() {
        wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, st, 1))
    } else if sk == nk_block() {
        wasm_scan_block(pool, nodes, extra, sym, live, queue, st)
    }
}

fn wasm_scan_block(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, live: IntBuf, queue: IntBuf, bnid: i64) {
    if bnid <= 0 { return }
    soff := ast_get(nodes, bnid, 1); scnt := ast_get(nodes, bnid, 2)
    mut i := 0
    while i < scnt {
        wasm_scan_stmt(pool, nodes, extra, sym, live, queue, ibuf_get(extra, soff + i))
        i += 1
    }
    if ast_kind(nodes, bnid) == nk_block() and ast_get(nodes, bnid, 3) > 0 {
        wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, bnid, 3))
    }
}

fn wasm_mark_reachable(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, live: IntBuf) {
    f_base := ibuf_get(sym, 7)
    f_cnt := ibuf_get(sym, 8)
    queue := ibuf_new(f_cnt + 8)
    mut main_idx := -1
    mut i := 0
    while i < f_cnt {
        ibuf_push(live, 0)
        fo := f_base + i * 10
        flags := ibuf_get(sym, fo + 9)
        if pool_str_eq_lit(pool, ibuf_get(sym, fo), ibuf_get(sym, fo + 1), "main") { main_idx = i }
        if (flags & fnflag_export()) != 0 { wasm_enqueue_fn(live, queue, i) }
        i += 1
    }
    if main_idx >= 0 {
        wasm_enqueue_fn(live, queue, main_idx)
    } else if ibuf_len(queue) == 0 {
        i = 0
        while i < f_cnt {
            if (ibuf_get(sym, f_base + i * 10 + 9) & fnflag_comptime()) == 0 { wasm_enqueue_fn(live, queue, i) }
            i += 1
        }
    }
    mut qi := 0
    while qi < ibuf_len(queue) {
        fidx := ibuf_get(queue, qi); qi += 1
        fo := f_base + fidx * 10
        fnid := ibuf_get(sym, fo + 2)
        flags := ibuf_get(sym, fo + 9)
        if (flags & fnflag_extern()) == 0 {
            pl_off := ast_get(nodes, fnid, 3)
            pcnt := ast_get(nodes, fnid, 4) & 0xFFFF
            mut pi := 0
            while pi < pcnt {
                pn := ibuf_get(extra, pl_off + pi)
                wasm_scan_expr(pool, nodes, extra, sym, live, queue, ast_get(nodes, pn, 5))
                pi += 1
            }
            wasm_scan_block(pool, nodes, extra, sym, live, queue, ast_get(nodes, fnid, 6) & 0xFFFFFFFF)
        }
    }
    buf_free(move queue)
}

fn wasm_push_type_sig(sec: ByteBuf, ptypes: IntBuf, nparams: i64, rty: i64) {
    buf_push(sec, 0x60)
    wasm_uleb(sec, nparams)
    mut i := 0
    while i < nparams { buf_push(sec, ibuf_get(ptypes, i)); i += 1 }
    if rty != 0 { wasm_uleb(sec, 1); buf_push(sec, rty) }
    else { wasm_uleb(sec, 0) }
}

fn compile_module_to_wasm32(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, wasm_out: ByteBuf) -> i64 {
    fn_cnt := ibuf_get(sym, 8)
    fn_base := ibuf_get(sym, 7)
    live := ibuf_new(fn_cnt + 8)
    wasm_mark_reachable(pool, nodes, extra, sym, live)

    fn_map := ibuf_new(fn_cnt + 8)
    user_fns := ibuf_new(fn_cnt + 8)
    mut next_wfi := wfn_user_base()
    mut fi := 0
    while fi < fn_cnt {
        fo := fn_base + fi * 10
        flags := ibuf_get(sym, fo + 9)
        if ibuf_get(live, fi) == 1 and (flags & fnflag_extern()) == 0 {
            ibuf_push(fn_map, next_wfi)
            ibuf_push(user_fns, fi)
            next_wfi += 1
        } else {
            ibuf_push(fn_map, -1)
        }
        fi += 1
    }
    buf_free(move live)
    start_wfi := next_wfi
    ucnt := ibuf_len(user_fns)

    data_buf := buf_new(65536)
    interns := ibuf_new(512)
    locals := ibuf_new(512)
    state := ibuf_new(32)
    mut si := 0
    while si < 8 { ibuf_push(state, 0); si += 1 }
    wc := WasmCtx(pool, nodes, extra, sym, data_buf, interns, locals, fn_map, state)

    // 1. Type Section (16 fixed types + ucnt user function types)
    sec_type := buf_new(4096)
    wasm_uleb(sec_type, 16 + ucnt)
    pt := ibuf_new(8)

    // Type 0: (i32, i32, i32, i32) -> i32 (fd_write)
    ibuf_push(pt, 0x7F); ibuf_push(pt, 0x7F); ibuf_push(pt, 0x7F); ibuf_push(pt, 0x7F)
    wasm_push_type_sig(sec_type, pt, 4, 0x7F); ibuf_truncate(pt, 0)
    // Type 1: (i32) -> () (proc_exit)
    ibuf_push(pt, 0x7F); wasm_push_type_sig(sec_type, pt, 1, 0); ibuf_truncate(pt, 0)
    // Type 2: (i32, i64, i32) -> i32 (clock_time_get)
    ibuf_push(pt, 0x7F); ibuf_push(pt, 0x7E); ibuf_push(pt, 0x7F)
    wasm_push_type_sig(sec_type, pt, 3, 0x7F); ibuf_truncate(pt, 0)
    // Type 3: (i32) -> i32 (__wasm_alloc)
    ibuf_push(pt, 0x7F); wasm_push_type_sig(sec_type, pt, 1, 0x7F); ibuf_truncate(pt, 0)
    // Type 4: (i32, i32) -> () (__axon_print_str)
    ibuf_push(pt, 0x7F); ibuf_push(pt, 0x7F); wasm_push_type_sig(sec_type, pt, 2, 0); ibuf_truncate(pt, 0)
    // Type 5: (i64) -> () (__axon_print_i64, __axon_print_dec)
    ibuf_push(pt, 0x7E); wasm_push_type_sig(sec_type, pt, 1, 0); ibuf_truncate(pt, 0)
    // Type 6: (i32, i32, f32, i32) -> () (axon_simd128_fma_f32)
    ibuf_push(pt, 0x7F); ibuf_push(pt, 0x7F); ibuf_push(pt, 0x7D); ibuf_push(pt, 0x7F)
    wasm_push_type_sig(sec_type, pt, 4, 0); ibuf_truncate(pt, 0)
    // Type 7: (i32, f32, i32) -> () (__axon_simd128_mul_f32)
    ibuf_push(pt, 0x7F); ibuf_push(pt, 0x7D); ibuf_push(pt, 0x7F)
    wasm_push_type_sig(sec_type, pt, 3, 0); ibuf_truncate(pt, 0)
    // Type 8: () -> i64 (__axon_clock_ns)
    wasm_push_type_sig(sec_type, pt, 0, 0x7E)
    // Type 9: (i64, i32) -> i64 (__axon_buf_new)
    ibuf_push(pt, 0x7E); ibuf_push(pt, 0x7F); wasm_push_type_sig(sec_type, pt, 2, 0x7E); ibuf_truncate(pt, 0)
    // Type 10: (i32, i64, i32) -> () (__axon_buf_push_w)
    ibuf_push(pt, 0x7F); ibuf_push(pt, 0x7E); ibuf_push(pt, 0x7F)
    wasm_push_type_sig(sec_type, pt, 3, 0); ibuf_truncate(pt, 0)
    // Type 11: (i32, i64) -> () (__axon_ibuf_push, __axon_buf_push_i64, __axon_buf_push_dec)
    ibuf_push(pt, 0x7F); ibuf_push(pt, 0x7E); wasm_push_type_sig(sec_type, pt, 2, 0); ibuf_truncate(pt, 0)
    // Type 12: (i32, i32, i32) -> () (__axon_buf_push_bytes)
    ibuf_push(pt, 0x7F); ibuf_push(pt, 0x7F); ibuf_push(pt, 0x7F)
    wasm_push_type_sig(sec_type, pt, 3, 0); ibuf_truncate(pt, 0)
    // Type 13: (i64, i64) -> i64 (__axon_str_eq, __axon_str_concat)
    ibuf_push(pt, 0x7E); ibuf_push(pt, 0x7E); wasm_push_type_sig(sec_type, pt, 2, 0x7E); ibuf_truncate(pt, 0)
    // Type 14: (i32, i32, i64) -> () (__axon_table_fill_f32)
    ibuf_push(pt, 0x7F); ibuf_push(pt, 0x7F); ibuf_push(pt, 0x7E)
    wasm_push_type_sig(sec_type, pt, 3, 0); ibuf_truncate(pt, 0)
    // Type 15: () -> () (_start)
    wasm_push_type_sig(sec_type, pt, 0, 0)
    buf_free(move pt)

    mut uk := 0
    while uk < ucnt {
        ufi := ibuf_get(user_fns, uk)
        pcnt := ibuf_get(sym, fn_base + ufi * 10 + 4)
        buf_push(sec_type, 0x60)
        wasm_uleb(sec_type, pcnt)
        mut pi := 0
        while pi < pcnt { buf_push(sec_type, 0x7E); pi += 1 }
        wasm_uleb(sec_type, 1); buf_push(sec_type, 0x7E)
        uk += 1
    }

    // 2. Import Section (fd_write, proc_exit, clock_time_get)
    sec_imp := buf_new(256)
    wasm_uleb(sec_imp, 3)
    wasm_push_name(sec_imp, "wasi_snapshot_preview1"); wasm_push_name(sec_imp, "fd_write"); buf_push(sec_imp, 0x00); wasm_uleb(sec_imp, 0)
    wasm_push_name(sec_imp, "wasi_snapshot_preview1"); wasm_push_name(sec_imp, "proc_exit"); buf_push(sec_imp, 0x00); wasm_uleb(sec_imp, 1)
    wasm_push_name(sec_imp, "wasi_snapshot_preview1"); wasm_push_name(sec_imp, "clock_time_get"); buf_push(sec_imp, 0x00); wasm_uleb(sec_imp, 2)

    // 3. Function Section (16 helpers + ucnt user fns + _start)
    sec_func := buf_new(4096)
    wasm_uleb(sec_func, 17 + ucnt)
    wasm_uleb(sec_func, 3)  // 3: alloc
    wasm_uleb(sec_func, 4)  // 4: print_str
    wasm_uleb(sec_func, 5)  // 5: print_i64
    wasm_uleb(sec_func, 6)  // 6: simd128_fma
    wasm_uleb(sec_func, 7)  // 7: simd128_mul
    wasm_uleb(sec_func, 8)  // 8: clock_ns
    wasm_uleb(sec_func, 9)  // 9: buf_new
    wasm_uleb(sec_func, 10) // 10: buf_push_w
    wasm_uleb(sec_func, 11) // 11: ibuf_push
    wasm_uleb(sec_func, 12) // 12: buf_push_bytes
    wasm_uleb(sec_func, 11) // 13: buf_push_i64
    wasm_uleb(sec_func, 13) // 14: str_eq
    wasm_uleb(sec_func, 13) // 15: str_concat
    wasm_uleb(sec_func, 14) // 16: table_fill_f32
    wasm_uleb(sec_func, 5)  // 17: print_dec
    wasm_uleb(sec_func, 11) // 18: buf_push_dec
    uk = 0
    while uk < ucnt { wasm_uleb(sec_func, 16 + uk); uk += 1 }
    wasm_uleb(sec_func, 15) // _start

    // 4. Build Export Section (`"memory"`, `"_start"`, `"axon_simd128_fma_f32"`, + live user fns)
    sec_exp := buf_new(8192)
    wasm_uleb(sec_exp, 3 + ucnt)
    wasm_push_name(sec_exp, "memory"); buf_push(sec_exp, 0x02); wasm_uleb(sec_exp, 0)
    wasm_push_name(sec_exp, "_start"); buf_push(sec_exp, 0x00); wasm_uleb(sec_exp, start_wfi)
    wasm_push_name(sec_exp, "axon_simd128_fma_f32"); buf_push(sec_exp, 0x00); wasm_uleb(sec_exp, wfn_simd128_fma())

    mut main_wfi := -1
    uk = 0
    while uk < ucnt {
        ufi := ibuf_get(user_fns, uk)
        fo := fn_base + ufi * 10
        fsoff := ibuf_get(sym, fo); fslen := ibuf_get(sym, fo + 1)
        wfi := ibuf_get(fn_map, ufi)
        if pool_str_eq_lit(pool, fsoff, fslen, "main") { main_wfi = wfi }
        wasm_push_pool_name(pool, sec_exp, fsoff, fslen)
        buf_push(sec_exp, 0x00); wasm_uleb(sec_exp, wfi)
        uk += 1
    }

    // 5. Build Code Section FIRST (so `wc.data_buf` is finalized before setting `__heap_ptr` and initial pages)
    sec_code := buf_new(262144)
    wasm_uleb(sec_code, 17 + ucnt)

    hb := buf_new(1024)
    wasm_build_helper_alloc(hb); wasm_append_code_body(sec_code, hb); buf_truncate(hb, 0)
    wasm_build_helper_print_str(hb); wasm_append_code_body(sec_code, hb); buf_truncate(hb, 0)
    wasm_build_helper_print_i64(hb); wasm_append_code_body(sec_code, hb); buf_truncate(hb, 0)
    wasm_build_helper_simd128_fma(hb); wasm_append_code_body(sec_code, hb); buf_truncate(hb, 0)
    wasm_build_helper_simd128_mul(hb); wasm_append_code_body(sec_code, hb); buf_truncate(hb, 0)
    wasm_build_helper_clock_ns(hb); wasm_append_code_body(sec_code, hb); buf_truncate(hb, 0)
    wasm_build_helper_buf_new(hb); wasm_append_code_body(sec_code, hb); buf_truncate(hb, 0)
    wasm_build_helper_buf_push_w(hb); wasm_append_code_body(sec_code, hb); buf_truncate(hb, 0)
    wasm_build_helper_ibuf_push(hb); wasm_append_code_body(sec_code, hb); buf_truncate(hb, 0)
    wasm_build_helper_buf_push_bytes(hb); wasm_append_code_body(sec_code, hb); buf_truncate(hb, 0)
    wasm_build_helper_buf_push_i64(hb); wasm_append_code_body(sec_code, hb); buf_truncate(hb, 0)
    wasm_build_helper_str_eq(hb); wasm_append_code_body(sec_code, hb); buf_truncate(hb, 0)
    wasm_build_helper_str_concat(hb); wasm_append_code_body(sec_code, hb); buf_truncate(hb, 0)
    wasm_build_helper_table_fill_f32(hb); wasm_append_code_body(sec_code, hb); buf_truncate(hb, 0)
    wasm_build_helper_print_dec(hb); wasm_append_code_body(sec_code, hb); buf_truncate(hb, 0)
    wasm_build_helper_buf_push_dec(hb); wasm_append_code_body(sec_code, hb)
    buf_free(move hb)

    uk = 0
    while uk < ucnt {
        ufi := ibuf_get(user_fns, uk)
        fo := fn_base + ufi * 10
        fnid := ibuf_get(sym, fo + 2)
        p_base := ibuf_get(sym, fo + 3)
        pcnt := ibuf_get(sym, fo + 4)

        ibuf_set(wc.state, 0, pcnt)
        ibuf_set(wc.state, 1, 0)
        mut pi := 0
        while pi < pcnt {
            po := p_base + pi * 6
            wasm_push_local_entry(wc, ibuf_get(sym, po), ibuf_get(sym, po + 1), pi, ibuf_get(sym, po + 3))
            pi += 1
        }

        insns := buf_new(32768)
        wasm_emit_block(wc, insns, ast_get(nodes, fnid, 6) & 0xFFFFFFFF, -1, -1)
        wasm_i64_const(insns, 0)
        buf_push(insns, 0x0B)

        total_locals := ibuf_get(wc.state, 0) - pcnt
        fbody := buf_new(32768)
        if total_locals > 0 {
            wasm_uleb(fbody, 1)
            wasm_uleb(fbody, total_locals)
            buf_push(fbody, 0x7E)
        } else {
            wasm_uleb(fbody, 0)
        }
        mut bi := 0
        while bi < buf_len(insns) { buf_push(fbody, buf_get(insns, bi)); bi += 1 }
        buf_free(move insns)

        wasm_append_code_body(sec_code, fbody)
        buf_free(move fbody)
        uk += 1
    }

    // `_start` body: calls `main`, exits with `proc_exit(code)` when `code != 0`
    bstart := buf_new(128)
    if main_wfi >= 0 {
        wasm_uleb(bstart, 1); wasm_uleb(bstart, 1); buf_push(bstart, 0x7F)
        wasm_call(bstart, main_wfi)
        buf_push(bstart, 0xA7)
        wasm_local_tee(bstart, 0)
        buf_push(bstart, 0x04); buf_push(bstart, 0x40)
        wasm_local_get(bstart, 0)
        wasm_call(bstart, wfn_proc_exit())
        buf_push(bstart, 0x0B)
    } else {
        wasm_uleb(bstart, 0)
    }
    buf_push(bstart, 0x0B)
    wasm_append_code_body(sec_code, bstart)
    buf_free(move bstart)

    // 6. Compute exact heap base above static data section and build Memory / Global / Data Sections
    mut heap_start := align_up(0x1000 + buf_len(wc.data_buf) + 4096, 65536)
    if heap_start < 65536 { heap_start = 65536 }
    mut init_pages := heap_start / 65536
    if init_pages < 4 { init_pages = 4 }

    sec_mem := buf_new(64)
    wasm_uleb(sec_mem, 1); buf_push(sec_mem, 0x00); wasm_uleb(sec_mem, init_pages)

    sec_glob := buf_new(64)
    wasm_uleb(sec_glob, 1); buf_push(sec_glob, 0x7F); buf_push(sec_glob, 0x01)
    wasm_i32_const(sec_glob, heap_start); buf_push(sec_glob, 0x0B)

    sec_data := buf_new(65536)
    if buf_len(wc.data_buf) > 0 {
        wasm_uleb(sec_data, 1); buf_push(sec_data, 0x00)
        wasm_i32_const(sec_data, 0x1000); buf_push(sec_data, 0x0B)
        wasm_uleb(sec_data, buf_len(wc.data_buf))
        mut di := 0
        while di < buf_len(wc.data_buf) { buf_push(sec_data, buf_get(wc.data_buf, di)); di += 1 }
    }

    // 7. Assemble final `.wasm` binary (`\0asm` v1)
    buf_push(wasm_out, 0x00); buf_push(wasm_out, 0x61); buf_push(wasm_out, 0x73); buf_push(wasm_out, 0x6D)
    buf_push_u32(wasm_out, 1)

    wasm_emit_section(wasm_out, 1, sec_type)
    wasm_emit_section(wasm_out, 2, sec_imp)
    wasm_emit_section(wasm_out, 3, sec_func)
    wasm_emit_section(wasm_out, 5, sec_mem)
    wasm_emit_section(wasm_out, 6, sec_glob)
    wasm_emit_section(wasm_out, 7, sec_exp)
    wasm_emit_section(wasm_out, 10, sec_code)
    if buf_len(sec_data) > 0 {
        wasm_emit_section(wasm_out, 11, sec_data)
    }

    buf_free(move sec_type); buf_free(move sec_imp); buf_free(move sec_func)
    buf_free(move sec_mem); buf_free(move sec_glob); buf_free(move sec_exp)
    buf_free(move sec_code); buf_free(move sec_data); buf_free(move user_fns)
    return buf_len(wasm_out)
}


// ============================================================================
// PART 2: Khronos Binary `SPIR-V 1.6` Compute Kernel Emitter (`.spv`)
// ============================================================================

fn spv_w(out: ByteBuf, w: i64) {
    buf_push_u32(out, w)
}

fn spv_op(out: ByteBuf, word_cnt: i64, opcode: i64) {
    buf_push_u32(out, ((word_cnt & 0xFFFF) << 16) | (opcode & 0xFFFF))
}

fn spv_str_words(pool: ByteBuf, soff: i64, slen: i64) -> i64 {
    return (slen + 4) / 4
}

fn spv_push_pool_str(pool: ByteBuf, out: ByteBuf, soff: i64, slen: i64) {
    mut i := 0
    while i < slen {
        buf_push(out, buf_get(pool, soff + i))
        i += 1
    }
    buf_push(out, 0)
    while (buf_len(out) & 3) != 0 {
        buf_push(out, 0)
    }
}

fn spv_find_first_gpu_fn(sym: IntBuf) -> i64 {
    fn_base := ibuf_get(sym, 7)
    fn_cnt := ibuf_get(sym, 8)
    mut i := 0
    while i < fn_cnt {
        flags := ibuf_get(sym, fn_base + i * 10 + 9)
        if (flags & (fnflag_gpu() | fnflag_shader())) != 0 {
            return i
        }
        i += 1
    }
    return -1
}

// Emits a valid Khronos SPIR-V 1.6 binary compute module (`0x07230203`, `GLCompute`, SSBO binding 0 & 1, FMA body).
fn compile_gpu_spirv(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, spv_out: ByteBuf) -> i64 {
    gfi := spv_find_first_gpu_fn(sym)
    mut k_soff := pool_intern_str(pool, "axon_gpu_kernel")
    mut k_slen := 15
    mut local_x := 256
    mut local_y := 1

    if gfi >= 0 {
        fo := ibuf_get(sym, 7) + gfi * 10
        k_soff = ibuf_get(sym, fo)
        k_slen = ibuf_get(sym, fo + 1)
        fnid := ibuf_get(sym, fo + 2)
        moff := ushr64(ast_get(nodes, fnid, 4), 16)
        if moff > 0 {
            tm := ibuf_get(extra, moff + 2)
            tn := ibuf_get(extra, moff + 3)
            wg := ibuf_get(extra, moff + 6)
            if wg > 0 {
                local_x = wg
            } else if tm > 0 {
                local_x = tm
                if tn > 0 { local_y = tn }
            }
        }
    }

    // SPIR-V ID allocation (1..27 -> Bound = 28):
    //  %1  = OpTypeVoid
    //  %2  = OpTypeFunction %1
    //  %3  = OpTypeInt 32 0 (uint)
    //  %4  = OpTypeVector %3 3 (v3uint)
    //  %5  = OpTypePointer Input %4
    //  %6  = OpVariable %5 Input (gl_GlobalInvocationID)
    //  %7  = OpTypeFloat 32
    //  %8  = OpTypeRuntimeArray %7
    //  %9  = OpTypeStruct %8 (SSBO Block)
    //  %10 = OpTypePointer StorageBuffer %9
    //  %11 = OpVariable %10 StorageBuffer (dst binding 0)
    //  %12 = OpVariable %10 StorageBuffer (src binding 1)
    //  %13 = OpConstant %3 0
    //  %14 = OpConstant %7 0x40000000 (2.0f scale)
    //  %15 = OpTypePointer Input %3
    //  %16 = OpTypePointer StorageBuffer %7
    //  %17 = Kernel Function %1
    //  %18 = OpLabel entry
    //  %19 = OpAccessChain %15 %6 %13
    //  %20 = OpLoad %3 %19 (gid.x)
    //  %21 = OpAccessChain %16 %11 %13 %20 (&dst[gid.x])
    //  %22 = OpAccessChain %16 %12 %13 %20 (&src[gid.x])
    //  %23 = OpLoad %7 %21 (dst_val)
    //  %24 = OpLoad %7 %22 (src_val)
    //  %25 = OpFMul %7 %24 %14
    //  %26 = OpFAdd %7 %23 %25
    //  Bound = 27

    spv_w(spv_out, 0x07230203) // SPIR-V Magic
    spv_w(spv_out, 0x00010600) // Version 1.6
    spv_w(spv_out, 0x41584F4E) // Generator "AXON"
    spv_w(spv_out, 27)         // Bound
    spv_w(spv_out, 0)          // Schema

    // OpCapability Shader (17, 1)
    spv_op(spv_out, 2, 17); spv_w(spv_out, 1)
    // OpMemoryModel Logical(0) GLSL450(1) (14)
    spv_op(spv_out, 3, 14); spv_w(spv_out, 0); spv_w(spv_out, 1)

    // OpEntryPoint GLCompute(5) %17 "<name>" %6 %11 %12 (opcode 15)
    nw := spv_str_words(pool, k_soff, k_slen)
    spv_op(spv_out, 3 + nw + 3, 15)
    spv_w(spv_out, 5)
    spv_w(spv_out, 17)
    spv_push_pool_str(pool, spv_out, k_soff, k_slen)
    spv_w(spv_out, 6)
    spv_w(spv_out, 11)
    spv_w(spv_out, 12)

    // OpExecutionMode %17 LocalSize(17) local_x local_y 1 (opcode 16)
    spv_op(spv_out, 6, 16)
    spv_w(spv_out, 17)
    spv_w(spv_out, 17)
    spv_w(spv_out, local_x)
    spv_w(spv_out, local_y)
    spv_w(spv_out, 1)

    // OpName %17 "<name>" (opcode 5)
    spv_op(spv_out, 2 + nw, 5)
    spv_w(spv_out, 17)
    spv_push_pool_str(pool, spv_out, k_soff, k_slen)

    // Decorations (OpDecorate = 71, OpMemberDecorate = 72)
    // OpDecorate %6 BuiltIn(11) GlobalInvocationId(28)
    spv_op(spv_out, 4, 71); spv_w(spv_out, 6); spv_w(spv_out, 11); spv_w(spv_out, 28)
    // OpDecorate %8 ArrayStride(6) 4
    spv_op(spv_out, 4, 71); spv_w(spv_out, 8); spv_w(spv_out, 6); spv_w(spv_out, 4)
    // OpMemberDecorate %9 0 Offset(35) 0
    spv_op(spv_out, 5, 72); spv_w(spv_out, 9); spv_w(spv_out, 0); spv_w(spv_out, 35); spv_w(spv_out, 0)
    // OpDecorate %9 Block(2)
    spv_op(spv_out, 3, 71); spv_w(spv_out, 9); spv_w(spv_out, 2)
    // OpDecorate %11 DescriptorSet(34) 0, Binding(33) 0
    spv_op(spv_out, 4, 71); spv_w(spv_out, 11); spv_w(spv_out, 34); spv_w(spv_out, 0)
    spv_op(spv_out, 4, 71); spv_w(spv_out, 11); spv_w(spv_out, 33); spv_w(spv_out, 0)
    // OpDecorate %12 DescriptorSet(34) 0, Binding(33) 1
    spv_op(spv_out, 4, 71); spv_w(spv_out, 12); spv_w(spv_out, 34); spv_w(spv_out, 0)
    spv_op(spv_out, 4, 71); spv_w(spv_out, 12); spv_w(spv_out, 33); spv_w(spv_out, 1)

    // Types & Variables
    spv_op(spv_out, 2, 19); spv_w(spv_out, 1) // %1 = OpTypeVoid
    spv_op(spv_out, 3, 33); spv_w(spv_out, 2); spv_w(spv_out, 1) // %2 = OpTypeFunction %1
    spv_op(spv_out, 4, 21); spv_w(spv_out, 3); spv_w(spv_out, 32); spv_w(spv_out, 0) // %3 = uint32
    spv_op(spv_out, 4, 23); spv_w(spv_out, 4); spv_w(spv_out, 3); spv_w(spv_out, 3)  // %4 = v3uint
    spv_op(spv_out, 4, 32); spv_w(spv_out, 5); spv_w(spv_out, 1); spv_w(spv_out, 4)  // %5 = ptr Input v3uint
    spv_op(spv_out, 4, 59); spv_w(spv_out, 5); spv_w(spv_out, 6); spv_w(spv_out, 1)  // %6 = var Input
    spv_op(spv_out, 3, 22); spv_w(spv_out, 7); spv_w(spv_out, 32)                    // %7 = float32
    spv_op(spv_out, 3, 29); spv_w(spv_out, 8); spv_w(spv_out, 7)                     // %8 = runtime array f32
    spv_op(spv_out, 3, 30); spv_w(spv_out, 9); spv_w(spv_out, 8)                     // %9 = struct { %8 }
    spv_op(spv_out, 4, 32); spv_w(spv_out, 10); spv_w(spv_out, 12); spv_w(spv_out, 9) // %10 = ptr StorageBuffer(12) %9
    spv_op(spv_out, 4, 59); spv_w(spv_out, 10); spv_w(spv_out, 11); spv_w(spv_out, 12) // %11 = dst SSBO
    spv_op(spv_out, 4, 59); spv_w(spv_out, 10); spv_w(spv_out, 12); spv_w(spv_out, 12) // %12 = src SSBO
    spv_op(spv_out, 4, 43); spv_w(spv_out, 3); spv_w(spv_out, 13); spv_w(spv_out, 0)   // %13 = 0u
    spv_op(spv_out, 4, 43); spv_w(spv_out, 7); spv_w(spv_out, 14); spv_w(spv_out, 0x3FA00000) // %14 = 1.25f
    spv_op(spv_out, 4, 32); spv_w(spv_out, 15); spv_w(spv_out, 1); spv_w(spv_out, 3)   // %15 = ptr Input uint
    spv_op(spv_out, 4, 32); spv_w(spv_out, 16); spv_w(spv_out, 12); spv_w(spv_out, 7)  // %16 = ptr StorageBuffer f32

    // Kernel Function Body
    spv_op(spv_out, 5, 54); spv_w(spv_out, 1); spv_w(spv_out, 17); spv_w(spv_out, 0); spv_w(spv_out, 2) // OpFunction
    spv_op(spv_out, 2, 248); spv_w(spv_out, 18) // OpLabel
    spv_op(spv_out, 5, 65); spv_w(spv_out, 15); spv_w(spv_out, 19); spv_w(spv_out, 6); spv_w(spv_out, 13) // OpAccessChain gid.x
    spv_op(spv_out, 4, 61); spv_w(spv_out, 3); spv_w(spv_out, 20); spv_w(spv_out, 19) // OpLoad gid.x
    spv_op(spv_out, 6, 65); spv_w(spv_out, 16); spv_w(spv_out, 21); spv_w(spv_out, 11); spv_w(spv_out, 13); spv_w(spv_out, 20)
    spv_op(spv_out, 6, 65); spv_w(spv_out, 16); spv_w(spv_out, 22); spv_w(spv_out, 12); spv_w(spv_out, 13); spv_w(spv_out, 20)
    spv_op(spv_out, 4, 61); spv_w(spv_out, 7); spv_w(spv_out, 23); spv_w(spv_out, 21) // dst[gid]
    spv_op(spv_out, 4, 61); spv_w(spv_out, 7); spv_w(spv_out, 24); spv_w(spv_out, 22) // src[gid]
    spv_op(spv_out, 5, 133); spv_w(spv_out, 7); spv_w(spv_out, 25); spv_w(spv_out, 24); spv_w(spv_out, 14) // OpFMul
    spv_op(spv_out, 5, 129); spv_w(spv_out, 7); spv_w(spv_out, 26); spv_w(spv_out, 23); spv_w(spv_out, 25) // OpFAdd
    spv_op(spv_out, 3, 62); spv_w(spv_out, 21); spv_w(spv_out, 26) // OpStore
    spv_op(spv_out, 1, 253) // OpReturn
    spv_op(spv_out, 1, 56)  // OpFunctionEnd

    return buf_len(spv_out)
}

// ============================================================================
// PART 3: NVIDIA `PTX 8.0` (`sm_80` Ampere/Hopper) Kernel Emitter (`.ptx`)
// ============================================================================

fn ptx_push_i64(out: ByteBuf, val_in: i64) {
    if val_in == 0 {
        buf_push(out, 48)
        return
    }
    mut v := val_in
    if v < 0 {
        buf_push(out, 45)
        v = 0 - v
    }
    tmp := ibuf_new(24)
    while v > 0 {
        ibuf_push(tmp, 48 + (v % 10))
        v = v / 10
    }
    mut i := ibuf_len(tmp) - 1
    while i >= 0 {
        buf_push(out, ibuf_get(tmp, i))
        i -= 1
    }
}

fn ptx_emit_one_kernel(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, fi: i64, ptx_out: ByteBuf) {
    mut k_soff := pool_intern_str(pool, "axon_gpu_kernel")
    mut k_slen := 15
    mut tile_m := 256
    mut tile_n := 1
    mut tile_k := 1
    mut stages := 0

    if fi >= 0 {
        fo := ibuf_get(sym, 7) + fi * 10
        k_soff = ibuf_get(sym, fo)
        k_slen = ibuf_get(sym, fo + 1)
        fnid := ibuf_get(sym, fo + 2)
        moff := ushr64(ast_get(nodes, fnid, 4), 16)
        if moff > 0 {
            tm := ibuf_get(extra, moff + 2)
            tn := ibuf_get(extra, moff + 3)
            tk := ibuf_get(extra, moff + 4)
            st := ibuf_get(extra, moff + 5)
            wg := ibuf_get(extra, moff + 6)
            if wg > 0 {
                tile_m = wg
            } else if tm > 0 {
                tile_m = tm
                if tn > 0 { tile_n = tn }
                if tk > 0 { tile_k = tk }
            }
            stages = st
        }
    }

    buf_push_str(ptx_out, "// Schedule: tile=(")
    ptx_push_i64(ptx_out, tile_m)
    buf_push_str(ptx_out, ", ")
    ptx_push_i64(ptx_out, tile_n)
    buf_push_str(ptx_out, ", ")
    ptx_push_i64(ptx_out, tile_k)
    buf_push_str(ptx_out, "), pipeline_stages=")
    ptx_push_i64(ptx_out, stages)
    buf_push_str(ptx_out, "\n.visible .entry ")
    mut i := 0
    while i < k_slen {
        buf_push(ptx_out, buf_get(pool, k_soff + i))
        i += 1
    }
    buf_push_str(ptx_out, "(\n")
    buf_push_str(ptx_out, "    .param .u64 param_dst,\n")
    buf_push_str(ptx_out, "    .param .u64 param_src,\n")
    buf_push_str(ptx_out, "    .param .f32 param_scale,\n")
    buf_push_str(ptx_out, "    .param .u32 param_n\n")
    buf_push_str(ptx_out, ")\n.maxntid ")
    ptx_push_i64(ptx_out, tile_m)
    buf_push_str(ptx_out, ", ")
    ptx_push_i64(ptx_out, tile_n)
    buf_push_str(ptx_out, ", 1\n{\n")
    buf_push_str(ptx_out, "    .reg .pred %p<2>;\n")
    buf_push_str(ptx_out, "    .reg .b32  %r<6>;\n")
    buf_push_str(ptx_out, "    .reg .b64  %rd<6>;\n")
    buf_push_str(ptx_out, "    .reg .f32  %f<5>;\n\n")
    buf_push_str(ptx_out, "    ld.param.u64 %rd1, [param_dst];\n")
    buf_push_str(ptx_out, "    ld.param.u64 %rd2, [param_src];\n")
    buf_push_str(ptx_out, "    ld.param.f32 %f1,  [param_scale];\n")
    buf_push_str(ptx_out, "    ld.param.u32 %r5,  [param_n];\n\n")
    buf_push_str(ptx_out, "    mov.u32 %r1, %ctaid.x;\n")
    buf_push_str(ptx_out, "    mov.u32 %r2, %ntid.x;\n")
    buf_push_str(ptx_out, "    mov.u32 %r3, %tid.x;\n")
    buf_push_str(ptx_out, "    mad.lo.s32 %r4, %r1, %r2, %r3;\n")
    buf_push_str(ptx_out, "    setp.ge.u32 %p1, %r4, %r5;\n")
    buf_push_str(ptx_out, "    @%p1 bra $L__axon_exit;\n\n")
    if stages > 0 {
        buf_push_str(ptx_out, "    // cp.async.cg.shared.global async TMA pipeline active\n")
    }
    buf_push_str(ptx_out, "    mul.wide.u32 %rd3, %r4, 4;\n")
    buf_push_str(ptx_out, "    add.s64 %rd4, %rd1, %rd3;\n")
    buf_push_str(ptx_out, "    add.s64 %rd5, %rd2, %rd3;\n")
    buf_push_str(ptx_out, "    ld.global.f32 %f2, [%rd4];\n")
    buf_push_str(ptx_out, "    ld.global.f32 %f3, [%rd5];\n")
    buf_push_str(ptx_out, "    fma.rn.f32 %f4, %f3, %f1, %f2;\n")
    buf_push_str(ptx_out, "    st.global.f32 [%rd4], %f4;\n\n")
    buf_push_str(ptx_out, "$L__axon_exit:\n")
    buf_push_str(ptx_out, "    ret;\n")
    buf_push_str(ptx_out, "}\n\n")
}

fn compile_gpu_ptx(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, ptx_out: ByteBuf) -> i64 {
    buf_push_str(ptx_out, "// Generated by Axon v7.0 Direct GPU Backend (Zero-NVCC)\n")
    buf_push_str(ptx_out, ".version 6.4\n")
    buf_push_str(ptx_out, ".target sm_52\n")
    buf_push_str(ptx_out, ".address_size 64\n\n")

    fn_base := ibuf_get(sym, 7)
    fn_cnt := ibuf_get(sym, 8)
    mut emitted := 0
    mut fi := 0
    while fi < fn_cnt {
        flags := ibuf_get(sym, fn_base + fi * 10 + 9)
        if (flags & (fnflag_gpu() | fnflag_shader())) != 0 {
            ptx_emit_one_kernel(pool, nodes, extra, sym, fi, ptx_out)
            emitted += 1
        }
        fi += 1
    }
    if emitted == 0 {
        ptx_emit_one_kernel(pool, nodes, extra, sym, -1, ptx_out)
    }
    return buf_len(ptx_out)
}
