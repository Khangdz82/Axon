            wasm_local_get(c, en); wasm_wrap_mem(c, btmp, 0x29, 3, 0); wasm_op4(c, 0x56, 0x04, 0x40, 0x00); buf_push(c, 0x0B)
            wasm_local_get(c, en); wasm_local_get(c, st); buf_push(c, 0x7D); wasm_local_tee(c, slen)
