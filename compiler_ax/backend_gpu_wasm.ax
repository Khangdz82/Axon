// Axon v7.0 Self-Hosted Compiler - WebAssembly (`wasm32` + `SIMD128` + WASI) & GPU (`SPIR-V 1.6` + `NVIDIA PTX 8.0`)
// (`compiler_ax/backend_gpu_wasm.ax`) - 100% Pure Axon, Zero LLVM/Binaryen/glslang/nvcc Dependencies.
// Emits:
//   1. Direct W3C WebAssembly Binary `.wasm` (`\0asm` v1 + `0xFD` SIMD128 `f32x4` + WASI `fd_write`)
//   2. Direct Khronos Binary `SPIR-V 1.6` `.spv` (`0x07230203`, `GLCompute` storage buffer kernels)
//   3. Direct `NVIDIA PTX 8.0` `.ptx` (`sm_80` Ampere/Hopper `@tile` & `@pipeline_stages` kernels)

use compiler_ax::tokens_ast
use compiler_ax::sema_effects
use compiler_ax::sema_perceus
use compiler_ax::comptime

// ============================================================================
// PART 1: W3C WebAssembly (`wasm32` + `0xFD` SIMD128 + WASI `preview1`) Backend
// ============================================================================
// Pure zero-SDK WASM emitter with:
//   - Whole-program reachability tree-shaking from `main` / `@export`
//   - Dynamic `memory.grow` 16B-aligned bump allocator
//   - Full WASI (`fd_write`, `proc_exit`, `clock_time_get`)
//   - Full Axon feature parity (`f"..."`, `str`, default/named args, `struct`, `ByteBuf`/`IntBuf`, `ok`/`err`/`or`, `Table[T]` SoA + `0xFD` SIMD128)

struct WasmCtx {
    pool: ByteBuf
    nodes: IntBuf
    extra: IntBuf
    sym: IntBuf
    data_buf: ByteBuf
    interns: IntBuf
    locals: IntBuf
    fn_map: IntBuf
    state: IntBuf
}

// Fixed WASI Imports (func 0..2) & Runtime Helpers (func 3..17)
fn wfn_fd_write() -> i64       { return 0 }
fn wfn_proc_exit() -> i64      { return 1 }
fn wfn_clock_time_get() -> i64 { return 2 }
fn wfn_alloc() -> i64          { return 3 }
fn wfn_print_str() -> i64      { return 4 }
fn wfn_print_i64() -> i64      { return 5 }
fn wfn_simd128_fma() -> i64    { return 6 }
fn wfn_simd128_mul() -> i64    { return 7 }
fn wfn_clock_ns() -> i64       { return 8 }
fn wfn_buf_new() -> i64        { return 9 }
fn wfn_buf_push_w() -> i64     { return 10 }
fn wfn_ibuf_push() -> i64      { return 11 }
fn wfn_buf_push_bytes() -> i64 { return 12 }
fn wfn_buf_push_i64() -> i64   { return 13 }
fn wfn_str_eq() -> i64         { return 14 }
fn wfn_str_concat() -> i64     { return 15 }
fn wfn_table_fill_f32() -> i64 { return 16 }
fn wfn_print_dec() -> i64      { return 17 }
fn wfn_buf_push_dec() -> i64   { return 18 }
fn wfn_user_base() -> i64      { return 19 }

fn wasm_uleb(out: ByteBuf, val_in: i64) {
    mut v := val_in
    while true {
        b := v & 0x7F
        v = ushr64(v, 7)
        if v == 0 {
            buf_push(out, b)
            return
        }
        buf_push(out, b | 0x80)
    }
}

fn wasm_sleb(out: ByteBuf, val_in: i64) {
    mut v := val_in
    while true {
        b := v & 0x7F
        v = v >> 7
        sign_bit := (b & 0x40) != 0
        if (v == 0 and not sign_bit) or (v == -1 and sign_bit) {
            buf_push(out, b)
            return
        }
        buf_push(out, b | 0x80)
    }
}

fn wasm_push_name(out: ByteBuf, s: str) {
    n := str_len(s)
    wasm_uleb(out, n)
    buf_push_str(out, s)
}

fn wasm_push_pool_name(pool: ByteBuf, out: ByteBuf, soff: i64, slen: i64) {
    wasm_uleb(out, slen)
    mut i := 0
    while i < slen {
        buf_push(out, buf_get(pool, soff + i))
        i += 1
    }
}

fn wasm_emit_section(out: ByteBuf, sec_id: i64, payload: ByteBuf) {
    buf_push(out, sec_id & 255)
    wasm_uleb(out, buf_len(payload))
    mut i := 0
    n := buf_len(payload)
    while i < n {
        buf_push(out, buf_get(payload, i))
        i += 1
    }
}

fn wasm_append_code_body(sec_code: ByteBuf, body: ByteBuf) {
    wasm_uleb(sec_code, buf_len(body))
    mut bi := 0
    n := buf_len(body)
    while bi < n {
        buf_push(sec_code, buf_get(body, bi))
        bi += 1
    }
}

fn wasm_intern_slice(wc: WasmCtx, soff: i64, slen: i64) -> i64 {
    icnt := ibuf_len(wc.interns) / 3
    mut i := 0
    while i < icnt {
        base := i * 3
        if ibuf_get(wc.interns, base + 1) == slen and pool_str_eq2(wc.pool, ibuf_get(wc.interns, base), slen, soff) {
            return ibuf_get(wc.interns, base + 2)
        }
        i += 1
    }
    addr := 0x1000 + buf_len(wc.data_buf)
    mut j := 0
    while j < slen {
        buf_push(wc.data_buf, buf_get(wc.pool, soff + j))
        j += 1
    }
    buf_push(wc.data_buf, 0)
    packed_ref := (addr & 0xFFFFFFFF) | ((slen & 0xFFFFFFFF) << 32)
    ibuf_push(wc.interns, soff)
    ibuf_push(wc.interns, slen)
    ibuf_push(wc.interns, packed_ref)
    return packed_ref
}

fn wasm_intern_lit(wc: WasmCtx, lit: str) -> i64 {
    soff := pool_intern_str(wc.pool, lit)
    return wasm_intern_slice(wc, soff, str_len(lit))
}

fn wasm_find_local(wc: WasmCtx, soff: i64, slen: i64) -> i64 {
    mut i := ibuf_get(wc.state, 1) - 1
    while i >= 0 {
        base := i * 4
        if ibuf_get(wc.locals, base + 1) == slen and pool_str_eq2(wc.pool, ibuf_get(wc.locals, base), slen, soff) {
            return base
        }
        i -= 1
    }
    return -1
}

fn wasm_push_local_entry(wc: WasmCtx, soff: i64, slen: i64, idx: i64, ty: i64) {
    cnt := ibuf_get(wc.state, 1)
    base := cnt * 4
    if base + 4 <= ibuf_len(wc.locals) {
        ibuf_set(wc.locals, base, soff)
        ibuf_set(wc.locals, base + 1, slen)
        ibuf_set(wc.locals, base + 2, idx)
        ibuf_set(wc.locals, base + 3, ty)
    } else {
        ibuf_push(wc.locals, soff)
        ibuf_push(wc.locals, slen)
        ibuf_push(wc.locals, idx)
        ibuf_push(wc.locals, ty)
    }
    ibuf_set(wc.state, 1, cnt + 1)
}

fn wasm_alloc_local(wc: WasmCtx, soff: i64, slen: i64, ty: i64) -> i64 {
    idx := ibuf_get(wc.state, 0)
    ibuf_set(wc.state, 0, idx + 1)
    wasm_push_local_entry(wc, soff, slen, idx, ty)
    return idx
}

fn wasm_alloc_tmp(wc: WasmCtx) -> i64 {
    idx := ibuf_get(wc.state, 0)
    ibuf_set(wc.state, 0, idx + 1)
    return idx
}

fn wasm_local_get(c: ByteBuf, idx: i64) {
    buf_push(c, 0x20)
    wasm_uleb(c, idx)
}

fn wasm_local_set(c: ByteBuf, idx: i64) {
    buf_push(c, 0x21)
    wasm_uleb(c, idx)
}

fn wasm_local_tee(c: ByteBuf, idx: i64) {
    buf_push(c, 0x22)
    wasm_uleb(c, idx)
}

fn wasm_i32_const(c: ByteBuf, val: i64) {
    buf_push(c, 0x41)
    wasm_sleb(c, val)
}

fn wasm_i64_const(c: ByteBuf, val: i64) {
    buf_push(c, 0x42)
    wasm_sleb(c, val)
}

fn wasm_call(c: ByteBuf, fn_idx: i64) {
    buf_push(c, 0x10)
    wasm_uleb(c, fn_idx)
}

fn wasm_memarg(c: ByteBuf, align_pow2: i64, offset: i64) {
    wasm_uleb(c, align_pow2)
    wasm_uleb(c, offset)
}

fn wasm_op2(c: ByteBuf, a: i64, b: i64) {
    buf_push(c, a); buf_push(c, b)
}

fn wasm_op3(c: ByteBuf, a: i64, b: i64, d: i64) {
    buf_push(c, a); buf_push(c, b); buf_push(c, d)
}

fn wasm_op4(c: ByteBuf, a: i64, b: i64, d: i64, e: i64) {
    buf_push(c, a); buf_push(c, b); buf_push(c, d); buf_push(c, e)
}

fn wasm_get_wrap(c: ByteBuf, idx: i64) {
    wasm_local_get(c, idx); buf_push(c, 0xA7)
}

fn wasm_mem_op(c: ByteBuf, op: i64, align_pow2: i64, offset: i64) {
    buf_push(c, op); wasm_memarg(c, align_pow2, offset)
}

fn wasm_get_mem(c: ByteBuf, idx: i64, op: i64, align_pow2: i64, offset: i64) {
    wasm_local_get(c, idx); buf_push(c, op); wasm_memarg(c, align_pow2, offset)
}

fn wasm_wrap_mem(c: ByteBuf, idx: i64, op: i64, align_pow2: i64, offset: i64) {
    wasm_get_wrap(c, idx); buf_push(c, op); wasm_memarg(c, align_pow2, offset)
}

fn wasm_emit_ptr_field_load(c: ByteBuf, ptmp: i64, off_bytes: i64) {
    wasm_local_tee(c, ptmp)
    wasm_op3(c, 0x50, 0x04, 0x7E)
    wasm_i64_const(c, 0); buf_push(c, 0x05)
    wasm_wrap_mem(c, ptmp, 0x29, 3, off_bytes)
    buf_push(c, 0x0B)
}

fn wasm_emit_float_to_dec(c: ByteBuf) {
    buf_push(c, 0xBF) // f64.reinterpret_i64
    wasm_i64_const(c, 0x40C3880000000000) // 10000.0
    wasm_op3(c, 0xBF, 0xA2, 0xB0) // f64.reinterpret, mul, trunc_f64_s
}

fn wasm_arg_nid(wc: WasmCtx, aoff: i64, idx: i64) -> i64 {
    return ast_get(wc.nodes, ibuf_get(wc.extra, aoff + idx), 4)
}

fn wasm_arg_expr(wc: WasmCtx, c: ByteBuf, aoff: i64, idx: i64) {
    wasm_emit_expr(wc, c, wasm_arg_nid(wc, aoff, idx))
}

fn wasm_arg_set(wc: WasmCtx, c: ByteBuf, aoff: i64, idx: i64, tmp: i64) {
    wasm_emit_expr(wc, c, wasm_arg_nid(wc, aoff, idx))
    wasm_local_set(c, tmp)
}

fn wasm_emit_col_ptr(c: ByteBuf, base_tmp: i64, cnt_tmp: i64, col_idx: i64) {
    wasm_local_get(c, base_tmp)
    wasm_i64_const(c, col_idx); wasm_local_get(c, cnt_tmp); buf_push(c, 0x7E)
    wasm_i64_const(c, 2); wasm_op3(c, 0x86, 0x7C, 0xA7)
}

fn wasm_trap_ge_u(c: ByteBuf) {
    wasm_op4(c, 0x5A, 0x04, 0x40, 0x00); buf_push(c, 0x0B)
}

fn wasm_loop_hdr(c: ByteBuf) {
    wasm_op4(c, 0x02, 0x40, 0x03, 0x40)
}

fn wasm_loop_end(c: ByteBuf) {
    wasm_op4(c, 0x0C, 0x00, 0x0B, 0x0B)
}

fn wasm_simd_op(c: ByteBuf, op: i64) {
    buf_push(c, 0xFD); wasm_uleb(c, op)
}

fn wasm_emit_aop(c: ByteBuf, aop: i64, is_f64: i64) {
    if is_f64 != 0 {
        if aop == aop_add() { wasm_op2(c, 0xA0, 0xBD) }
        else if aop == aop_sub() { wasm_op2(c, 0xA1, 0xBD) }
        else if aop == aop_mul() { wasm_op2(c, 0xA2, 0xBD) }
        else { wasm_op2(c, 0xA3, 0xBD) }
        return
    }
    if aop == aop_add() { buf_push(c, 0x7C) }
    else if aop == aop_sub() { buf_push(c, 0x7D) }
    else if aop == aop_mul() { buf_push(c, 0x7E) }
    else { buf_push(c, 0x7F) }
}

fn wasm_emit_bin_num_op(c: ByteBuf, op: i64, is_f64: i64) {
    if is_f64 != 0 {
        if op == op_add() { wasm_op2(c, 0xA0, 0xBD); return }
        if op == op_sub() { wasm_op2(c, 0xA1, 0xBD); return }
        if op == op_mul() { wasm_op2(c, 0xA2, 0xBD); return }
        if op == op_div() { wasm_op2(c, 0xA3, 0xBD); return }
        mut cmp := 0x66
        if op == op_eq() { cmp = 0x61 } else if op == op_neq() { cmp = 0x62 }
        else if op == op_lt() { cmp = 0x63 } else if op == op_gt() { cmp = 0x64 }
        else if op == op_lte() { cmp = 0x65 }
        wasm_op2(c, cmp, 0xAD)
        return
    }
    if op == op_add() or op == op_wrap_add() { buf_push(c, 0x7C); return }
    if op == op_sub() or op == op_wrap_sub() { buf_push(c, 0x7D); return }
    if op == op_mul() or op == op_wrap_mul() { buf_push(c, 0x7E); return }
    if op == op_div() { buf_push(c, 0x7F); return }
    if op == op_mod() { buf_push(c, 0x81); return }
    if op == op_bit_and() { buf_push(c, 0x83); return }
    if op == op_bit_or() { buf_push(c, 0x84); return }
    if op == op_bit_xor() { buf_push(c, 0x85); return }
    if op == op_shl() { buf_push(c, 0x86); return }
    if op == op_shr() { buf_push(c, 0x87); return }
    mut cmp := 0x59
    if op == op_eq() { cmp = 0x51 } else if op == op_neq() { cmp = 0x52 }
    else if op == op_lt() { cmp = 0x53 } else if op == op_gt() { cmp = 0x55 }
    else if op == op_lte() { cmp = 0x57 }
    wasm_op2(c, cmp, 0xAD)
}

// --- Runtime Helper Body Emitters ---

// `wfn_alloc(bytes: i32) -> i32`: 16-byte aligned linear bump allocator with `memory.grow`
fn wasm_build_helper_alloc(body: ByteBuf) {
    // param 0=bytes(i32); locals: 1=sz(i32), 2=ptr(i32), 3=end(i32), 4=cur(i32)
    wasm_op3(body, 1, 4, 0x7F)

    wasm_local_get(body, 0); wasm_i32_const(body, 16)
    wasm_op3(body, 0x48, 0x04, 0x40)
    wasm_i32_const(body, 16); wasm_local_set(body, 1)
    buf_push(body, 0x05)
    wasm_local_get(body, 0); wasm_i32_const(body, 15); buf_push(body, 0x6A)
    wasm_i32_const(body, -16); buf_push(body, 0x71); wasm_local_set(body, 1)
    buf_push(body, 0x0B)

    wasm_op2(body, 0x23, 0) // global.get 0
    wasm_local_tee(body, 2); wasm_local_get(body, 1); buf_push(body, 0x6A); wasm_local_set(body, 3)

    // Guard i32 wraparound
    wasm_local_get(body, 3); wasm_local_get(body, 2); wasm_op4(body, 0x49, 0x04, 0x40, 0x00); buf_push(body, 0x0B)

    wasm_op2(body, 0x3F, 0x00) // memory.size
    wasm_i32_const(body, 16); buf_push(body, 0x74); wasm_local_set(body, 4)

    wasm_local_get(body, 3); wasm_local_get(body, 4); wasm_op3(body, 0x4B, 0x04, 0x40)
    wasm_local_get(body, 3); wasm_local_get(body, 4); buf_push(body, 0x6B)
    wasm_i32_const(body, 65535); buf_push(body, 0x6A)
    wasm_i32_const(body, 16); wasm_op3(body, 0x76, 0x40, 0x00) // memory.grow
    wasm_i32_const(body, -1); wasm_op4(body, 0x46, 0x04, 0x40, 0x00)
    wasm_op2(body, 0x0B, 0x0B)

    wasm_local_get(body, 3); wasm_op2(body, 0x24, 0) // global.set 0
    wasm_local_get(body, 2); buf_push(body, 0x0B)
}

// `wfn_print_str(ptr: i32, len: i32) -> ()`
fn wasm_build_helper_print_str(body: ByteBuf) {
    buf_push(body, 0)
    wasm_i32_const(body, 0); wasm_local_get(body, 0); wasm_mem_op(body, 0x36, 2, 0)
    wasm_i32_const(body, 4); wasm_local_get(body, 1); wasm_mem_op(body, 0x36, 2, 0)
    wasm_i32_const(body, 1); wasm_i32_const(body, 0); wasm_i32_const(body, 1); wasm_i32_const(body, 8)
    wasm_call(body, wfn_fd_write())
    wasm_op2(body, 0x1A, 0x0B)
}

// Formats signed `i64` into `[16..63]` leaving starting `pos: i32` and ending at `64`
fn wasm_emit_format_i64_scratch(body: ByteBuf, val_loc: i64, cur_loc: i64, pos_loc: i64, neg_loc: i64) {
    wasm_i32_const(body, 64); wasm_local_set(body, pos_loc)
    wasm_i32_const(body, 0); wasm_local_set(body, neg_loc)

    wasm_local_get(body, val_loc); wasm_i64_const(body, 0); wasm_op3(body, 0x53, 0x04, 0x40)
    wasm_i64_const(body, 0); wasm_local_get(body, val_loc); buf_push(body, 0x7D); wasm_local_set(body, cur_loc)
    wasm_i32_const(body, 1); wasm_local_set(body, neg_loc)
    buf_push(body, 0x05)
    wasm_local_get(body, val_loc); wasm_local_set(body, cur_loc)
    buf_push(body, 0x0B)

    wasm_loop_hdr(body)
    wasm_local_get(body, pos_loc); wasm_i32_const(body, 1); buf_push(body, 0x6B); wasm_local_tee(body, pos_loc)
    wasm_local_get(body, cur_loc); wasm_i64_const(body, 10); wasm_op2(body, 0x82, 0xA7)
    wasm_i32_const(body, 48); buf_push(body, 0x6A); wasm_mem_op(body, 0x3A, 0, 0)
    wasm_local_get(body, cur_loc); wasm_i64_const(body, 10); buf_push(body, 0x80); wasm_local_tee(body, cur_loc)
    wasm_i64_const(body, 0); wasm_op3(body, 0x52, 0x0D, 0x00)
    wasm_op2(body, 0x0B, 0x0B)

    wasm_local_get(body, neg_loc); wasm_op2(body, 0x04, 0x40)
    wasm_local_get(body, pos_loc); wasm_i32_const(body, 1); buf_push(body, 0x6B); wasm_local_tee(body, pos_loc)
    wasm_i32_const(body, 45); wasm_mem_op(body, 0x3A, 0, 0)
    buf_push(body, 0x0B)
}

// Formats 4-decimal `dec` (`val_loc`) into `[16..63]` leaving starting `pos_loc` and ending at `64`
fn wasm_emit_format_dec_scratch(body: ByteBuf, val_loc: i64, cur_loc: i64, whole_loc: i64, frac_loc: i64, pos_loc: i64, neg_loc: i64, i_loc: i64) {
    wasm_i32_const(body, 64); wasm_local_set(body, pos_loc)
    wasm_i32_const(body, 0); wasm_local_set(body, neg_loc)
    wasm_local_get(body, val_loc); wasm_i64_const(body, 0); wasm_op3(body, 0x53, 0x04, 0x40)
    wasm_i64_const(body, 0); wasm_local_get(body, val_loc); buf_push(body, 0x7D); wasm_local_set(body, cur_loc)
    wasm_i32_const(body, 1); wasm_local_set(body, neg_loc)
    buf_push(body, 0x05)
    wasm_local_get(body, val_loc); wasm_local_set(body, cur_loc)
    buf_push(body, 0x0B)

    wasm_local_get(body, cur_loc); wasm_i64_const(body, 10000); buf_push(body, 0x82); wasm_local_set(body, frac_loc)
    wasm_local_get(body, cur_loc); wasm_i64_const(body, 10000); buf_push(body, 0x80); wasm_local_set(body, whole_loc)

    wasm_i32_const(body, 0); wasm_local_set(body, i_loc)
    wasm_loop_hdr(body)
    wasm_local_get(body, i_loc); wasm_i32_const(body, 4); wasm_op3(body, 0x4E, 0x0D, 0x01)
    wasm_local_get(body, pos_loc); wasm_i32_const(body, 1); buf_push(body, 0x6B); wasm_local_tee(body, pos_loc)
    wasm_local_get(body, frac_loc); wasm_i64_const(body, 10); wasm_op2(body, 0x82, 0xA7); wasm_i32_const(body, 48); buf_push(body, 0x6A)
    wasm_mem_op(body, 0x3A, 0, 0)
    wasm_local_get(body, frac_loc); wasm_i64_const(body, 10); buf_push(body, 0x80); wasm_local_set(body, frac_loc)
    wasm_local_get(body, i_loc); wasm_i32_const(body, 1); buf_push(body, 0x6A); wasm_local_set(body, i_loc)
    wasm_loop_end(body)

    wasm_local_get(body, pos_loc); wasm_i32_const(body, 1); buf_push(body, 0x6B); wasm_local_tee(body, pos_loc)
    wasm_i32_const(body, 46); wasm_mem_op(body, 0x3A, 0, 0) // '.'

    wasm_loop_hdr(body)
    wasm_local_get(body, pos_loc); wasm_i32_const(body, 1); buf_push(body, 0x6B); wasm_local_tee(body, pos_loc)
    wasm_local_get(body, whole_loc); wasm_i64_const(body, 10); wasm_op2(body, 0x82, 0xA7); wasm_i32_const(body, 48); buf_push(body, 0x6A)
    wasm_mem_op(body, 0x3A, 0, 0)
    wasm_local_get(body, whole_loc); wasm_i64_const(body, 10); buf_push(body, 0x80); wasm_local_tee(body, whole_loc)
    wasm_i64_const(body, 0); wasm_op3(body, 0x52, 0x0D, 0x00)
    wasm_op2(body, 0x0B, 0x0B)

    wasm_local_get(body, neg_loc); wasm_op2(body, 0x04, 0x40)
    wasm_local_get(body, pos_loc); wasm_i32_const(body, 1); buf_push(body, 0x6B); wasm_local_tee(body, pos_loc)
    wasm_i32_const(body, 45); wasm_mem_op(body, 0x3A, 0, 0)
    buf_push(body, 0x0B)
}

// `wfn_print_i64(val: i64) -> ()`
fn wasm_build_helper_print_i64(body: ByteBuf) {
    wasm_op2(body, 2, 1); buf_push(body, 0x7E)
    wasm_op2(body, 2, 0x7F)
    wasm_emit_format_i64_scratch(body, 0, 1, 2, 3)
    wasm_local_get(body, 2); wasm_i32_const(body, 64); wasm_local_get(body, 2); buf_push(body, 0x6B)
    wasm_call(body, wfn_print_str())
    buf_push(body, 0x0B)
}

// `wfn_print_dec(val: i64) -> ()`
fn wasm_build_helper_print_dec(body: ByteBuf) {
    // param 0=val(i64); locals: 1=cur(i64), 2=whole(i64), 3=frac(i64), 4=pos(i32), 5=neg(i32), 6=i(i32)
    wasm_op3(body, 2, 3, 0x7E)
    wasm_op2(body, 3, 0x7F)
    wasm_emit_format_dec_scratch(body, 0, 1, 2, 3, 4, 5, 6)
    wasm_local_get(body, 4); wasm_i32_const(body, 64); wasm_local_get(body, 4); buf_push(body, 0x6B)
    wasm_call(body, wfn_print_str())
    buf_push(body, 0x0B)
}

// `wfn_simd128_fma(dst_ptr: i32, src_ptr: i32, scale: f32, count: i32) -> ()`
// Genuine W3C WASM SIMD128 (`0xFD` prefix, `v128` 128-bit 4xf32 lanes) + scalar tail
fn wasm_build_helper_simd128_fma(body: ByteBuf) {
    // params: 0=dst(i32), 1=src(i32), 2=scale(f32), 3=count(i32); locals: 4=i, 5=vec_end, 6=off, 7=vscale(v128)
    wasm_op3(body, 2, 3, 0x7F)
    wasm_op2(body, 1, 0x7B)

    wasm_local_get(body, 2); wasm_simd_op(body, 19); wasm_local_set(body, 7) // f32x4.splat
    wasm_local_get(body, 3); wasm_i32_const(body, -4); buf_push(body, 0x71); wasm_local_set(body, 5)
    wasm_i32_const(body, 0); wasm_local_set(body, 4)

    wasm_loop_hdr(body)
    wasm_local_get(body, 4); wasm_local_get(body, 5); wasm_op3(body, 0x4E, 0x0D, 0x01)
    wasm_local_get(body, 4); wasm_i32_const(body, 2); buf_push(body, 0x74); wasm_local_set(body, 6)
    wasm_local_get(body, 0); wasm_local_get(body, 6); buf_push(body, 0x6A)
    wasm_local_get(body, 0); wasm_local_get(body, 6); buf_push(body, 0x6A)
    wasm_simd_op(body, 0); wasm_memarg(body, 0, 0)

    wasm_local_get(body, 1); wasm_local_get(body, 6); buf_push(body, 0x6A)
    wasm_simd_op(body, 0); wasm_memarg(body, 0, 0)
    wasm_local_get(body, 7)
    wasm_simd_op(body, 230) // f32x4.mul
    wasm_simd_op(body, 228) // f32x4.add
    wasm_simd_op(body, 11); wasm_memarg(body, 0, 0) // v128.store

    wasm_local_get(body, 4); wasm_i32_const(body, 4); buf_push(body, 0x6A); wasm_local_set(body, 4)
    wasm_loop_end(body)

    wasm_loop_hdr(body)
    wasm_local_get(body, 4); wasm_local_get(body, 3); wasm_op3(body, 0x4E, 0x0D, 0x01)

    wasm_local_get(body, 4); wasm_i32_const(body, 2); buf_push(body, 0x74); wasm_local_set(body, 6)
    wasm_local_get(body, 0); wasm_local_get(body, 6); buf_push(body, 0x6A)
    wasm_local_get(body, 0); wasm_local_get(body, 6); buf_push(body, 0x6A); wasm_mem_op(body, 0x2A, 0, 0)
    wasm_local_get(body, 1); wasm_local_get(body, 6); buf_push(body, 0x6A); wasm_mem_op(body, 0x2A, 0, 0)
    wasm_local_get(body, 2); wasm_op3(body, 0x94, 0x92, 0x38); wasm_memarg(body, 0, 0)

    wasm_local_get(body, 4); wasm_i32_const(body, 1); buf_push(body, 0x6A); wasm_local_set(body, 4)
    wasm_loop_end(body)
    buf_push(body, 0x0B)
}

// `wfn_simd128_mul(dst_ptr: i32, scale: f32, count: i32) -> ()`
fn wasm_build_helper_simd128_mul(body: ByteBuf) {
    // params: 0=dst(i32), 1=scale(f32), 2=count(i32); locals: 3=i, 4=vec_end, 5=off, 6=vscale(v128)
    wasm_op3(body, 2, 3, 0x7F)
    wasm_op2(body, 1, 0x7B)

    wasm_local_get(body, 1); wasm_simd_op(body, 19); wasm_local_set(body, 6)
    wasm_local_get(body, 2); wasm_i32_const(body, -4); buf_push(body, 0x71); wasm_local_set(body, 4)
    wasm_i32_const(body, 0); wasm_local_set(body, 3)

    wasm_loop_hdr(body)
    wasm_local_get(body, 3); wasm_local_get(body, 4); wasm_op3(body, 0x4E, 0x0D, 0x01)
    wasm_local_get(body, 3); wasm_i32_const(body, 2); buf_push(body, 0x74); wasm_local_set(body, 5)
    wasm_local_get(body, 0); wasm_local_get(body, 5); buf_push(body, 0x6A)
    wasm_local_get(body, 0); wasm_local_get(body, 5); buf_push(body, 0x6A)
    wasm_simd_op(body, 0); wasm_memarg(body, 0, 0)
    wasm_local_get(body, 6)
    wasm_simd_op(body, 230) // f32x4.mul
    wasm_simd_op(body, 11); wasm_memarg(body, 0, 0)
    wasm_local_get(body, 3); wasm_i32_const(body, 4); buf_push(body, 0x6A); wasm_local_set(body, 3)
    wasm_loop_end(body)

    wasm_loop_hdr(body)
    wasm_local_get(body, 3); wasm_local_get(body, 2); wasm_op3(body, 0x4E, 0x0D, 0x01)
    wasm_local_get(body, 3); wasm_i32_const(body, 2); buf_push(body, 0x74); wasm_local_set(body, 5)
    wasm_local_get(body, 0); wasm_local_get(body, 5); buf_push(body, 0x6A)
    wasm_local_get(body, 0); wasm_local_get(body, 5); buf_push(body, 0x6A); wasm_mem_op(body, 0x2A, 0, 0)
    wasm_local_get(body, 1); wasm_op2(body, 0x94, 0x38); wasm_memarg(body, 0, 0)
    wasm_local_get(body, 3); wasm_i32_const(body, 1); buf_push(body, 0x6A); wasm_local_set(body, 3)
    wasm_loop_end(body)
    buf_push(body, 0x0B)
}

// `wfn_clock_ns() -> i64`
fn wasm_build_helper_clock_ns(body: ByteBuf) {
    buf_push(body, 0)
    wasm_i32_const(body, 1); wasm_i64_const(body, 0); wasm_i32_const(body, 128)
    wasm_call(body, wfn_clock_time_get())
    buf_push(body, 0x1A)
    wasm_i32_const(body, 128); wasm_mem_op(body, 0x29, 3, 0)
    buf_push(body, 0x0B)
}

// `wfn_buf_new(cap: i64, elem_sz: i32) -> i64`
fn wasm_build_helper_buf_new(body: ByteBuf) {
    // params: 0=cap(i64), 1=elem_sz(i32); locals: 2=c32(i32), 3=hdr(i32), 4=data(i32)
    wasm_op3(body, 1, 3, 0x7F)

    wasm_get_wrap(body, 0); wasm_local_set(body, 2)
    wasm_local_get(body, 2); wasm_i32_const(body, 16); wasm_op3(body, 0x48, 0x04, 0x40)
    wasm_i32_const(body, 16); wasm_local_set(body, 2); buf_push(body, 0x0B)

    wasm_i32_const(body, 24); wasm_call(body, wfn_alloc()); wasm_local_set(body, 3)
    wasm_local_get(body, 2); wasm_local_get(body, 1); buf_push(body, 0x6C); wasm_call(body, wfn_alloc()); wasm_local_set(body, 4)

    wasm_local_get(body, 3); wasm_i64_const(body, 0); wasm_mem_op(body, 0x37, 3, 0)
    wasm_local_get(body, 3); wasm_local_get(body, 2); wasm_op2(body, 0xAD, 0x37); wasm_memarg(body, 3, 8)
    wasm_local_get(body, 3); wasm_local_get(body, 4); wasm_mem_op(body, 0x36, 2, 16)

    wasm_local_get(body, 3); wasm_op2(body, 0xAD, 0x0B)
}

// Emits ByteBuf load `[len, cap, data]` and capacity growth if `len + add > cap`
fn wasm_emit_buf_grow_bytes(body: ByteBuf, hdr: i64, add: i64, len: i64, cap: i64, data: i64, ncap: i64, ndata: i64, idx: i64) {
    wasm_get_mem(body, hdr, 0x28, 2, 0); wasm_local_set(body, len)
    wasm_get_mem(body, hdr, 0x28, 2, 8); wasm_local_set(body, cap)
    wasm_get_mem(body, hdr, 0x28, 2, 16); wasm_local_set(body, data)

    wasm_local_get(body, len); wasm_local_get(body, add); buf_push(body, 0x6A)
    wasm_local_get(body, cap); wasm_op3(body, 0x4B, 0x04, 0x40)
    wasm_local_get(body, cap); wasm_i32_const(body, 2); buf_push(body, 0x6C); wasm_local_set(body, ncap)
    wasm_local_get(body, ncap); wasm_local_get(body, len); wasm_local_get(body, add); wasm_op4(body, 0x6A, 0x49, 0x04, 0x40)
    wasm_local_get(body, len); wasm_local_get(body, add); buf_push(body, 0x6A); wasm_i32_const(body, 16); buf_push(body, 0x6A); wasm_local_set(body, ncap)
    buf_push(body, 0x0B)
    wasm_local_get(body, ncap); wasm_call(body, wfn_alloc()); wasm_local_set(body, ndata)
    wasm_i32_const(body, 0); wasm_local_set(body, idx)
    wasm_loop_hdr(body)
    wasm_local_get(body, idx); wasm_local_get(body, len); wasm_op3(body, 0x4F, 0x0D, 0x01)
    wasm_local_get(body, ndata); wasm_local_get(body, idx); buf_push(body, 0x6A)
    wasm_local_get(body, data); wasm_local_get(body, idx); buf_push(body, 0x6A)
    wasm_mem_op(body, 0x2D, 0, 0); wasm_mem_op(body, 0x3A, 0, 0)
    wasm_local_get(body, idx); wasm_i32_const(body, 1); buf_push(body, 0x6A); wasm_local_set(body, idx)
    wasm_loop_end(body)
    wasm_local_get(body, hdr); wasm_local_get(body, ncap); wasm_op2(body, 0xAD, 0x37); wasm_memarg(body, 3, 8)
    wasm_local_get(body, hdr); wasm_local_get(body, ndata); wasm_mem_op(body, 0x36, 2, 16)
    wasm_local_get(body, ndata); wasm_local_set(body, data)
    buf_push(body, 0x0B)
}

// `wfn_buf_push_w(hdr: i32, val: i64, w: i32) -> ()`
fn wasm_build_helper_buf_push_w(body: ByteBuf) {
    // params: 0=hdr(i32), 1=val(i64), 2=w(i32); locals: 3=len, 4=cap, 5=data, 6=ncap, 7=ndata, 8=i
    wasm_op3(body, 1, 6, 0x7F)
    wasm_emit_buf_grow_bytes(body, 0, 2, 3, 4, 5, 6, 7, 8)

    // Write w bytes at data + len
    wasm_local_get(body, 2); wasm_i32_const(body, 1); wasm_op3(body, 0x46, 0x04, 0x40)
    wasm_local_get(body, 5); wasm_local_get(body, 3); buf_push(body, 0x6A); wasm_local_get(body, 1); wasm_mem_op(body, 0x3C, 0, 0)
    buf_push(body, 0x05)
    wasm_local_get(body, 2); wasm_i32_const(body, 2); wasm_op3(body, 0x46, 0x04, 0x40)
    wasm_local_get(body, 5); wasm_local_get(body, 3); buf_push(body, 0x6A); wasm_local_get(body, 1); wasm_mem_op(body, 0x3D, 0, 0)
    buf_push(body, 0x05)
    wasm_local_get(body, 2); wasm_i32_const(body, 4); wasm_op3(body, 0x46, 0x04, 0x40)
    wasm_local_get(body, 5); wasm_local_get(body, 3); buf_push(body, 0x6A); wasm_local_get(body, 1); wasm_mem_op(body, 0x3E, 0, 0)
    buf_push(body, 0x05)
    wasm_local_get(body, 5); wasm_local_get(body, 3); buf_push(body, 0x6A); wasm_local_get(body, 1); wasm_mem_op(body, 0x37, 0, 0)
    wasm_op3(body, 0x0B, 0x0B, 0x0B)

    wasm_local_get(body, 0)
    wasm_local_get(body, 3); wasm_local_get(body, 2); wasm_op3(body, 0x6A, 0xAD, 0x37); wasm_memarg(body, 3, 0)
    buf_push(body, 0x0B)
}

// `wfn_ibuf_push(hdr: i32, val: i64) -> ()`
fn wasm_build_helper_ibuf_push(body: ByteBuf) {
    // params: 0=hdr(i32), 1=val(i64); locals: 2=len, 3=cap, 4=data, 5=ncap, 6=ndata, 7=i
    wasm_op3(body, 1, 6, 0x7F)

    wasm_get_mem(body, 0, 0x28, 2, 0); wasm_local_set(body, 2)
    wasm_get_mem(body, 0, 0x28, 2, 8); wasm_local_set(body, 3)
    wasm_get_mem(body, 0, 0x28, 2, 16); wasm_local_set(body, 4)

    wasm_local_get(body, 2); wasm_local_get(body, 3); wasm_op3(body, 0x4F, 0x04, 0x40)
    wasm_local_get(body, 3); wasm_i32_const(body, 2); buf_push(body, 0x6C); wasm_local_set(body, 5)
    wasm_local_get(body, 5); wasm_i32_const(body, 3); buf_push(body, 0x74); wasm_call(body, wfn_alloc()); wasm_local_set(body, 6)
    wasm_i32_const(body, 0); wasm_local_set(body, 7)
    wasm_loop_hdr(body)
    wasm_local_get(body, 7); wasm_local_get(body, 2); wasm_op3(body, 0x4F, 0x0D, 0x01)
    wasm_local_get(body, 6); wasm_local_get(body, 7); wasm_i32_const(body, 3); wasm_op2(body, 0x74, 0x6A)
    wasm_local_get(body, 4); wasm_local_get(body, 7); wasm_i32_const(body, 3); wasm_op2(body, 0x74, 0x6A)
    wasm_mem_op(body, 0x29, 3, 0); wasm_mem_op(body, 0x37, 3, 0)
    wasm_local_get(body, 7); wasm_i32_const(body, 1); buf_push(body, 0x6A); wasm_local_set(body, 7)
    wasm_loop_end(body)
    wasm_local_get(body, 0); wasm_local_get(body, 5); wasm_op2(body, 0xAD, 0x37); wasm_memarg(body, 3, 8)
    wasm_local_get(body, 0); wasm_local_get(body, 6); wasm_mem_op(body, 0x36, 2, 16)
    wasm_local_get(body, 6); wasm_local_set(body, 4)
    buf_push(body, 0x0B)

    wasm_local_get(body, 4); wasm_local_get(body, 2); wasm_i32_const(body, 3); wasm_op2(body, 0x74, 0x6A)
    wasm_local_get(body, 1); wasm_mem_op(body, 0x37, 3, 0)
    wasm_local_get(body, 0); wasm_local_get(body, 2); wasm_i32_const(body, 1); wasm_op3(body, 0x6A, 0xAD, 0x37); wasm_memarg(body, 3, 0)
    buf_push(body, 0x0B)
}

// `wfn_buf_push_bytes(hdr: i32, src: i32, slen: i32) -> ()`
fn wasm_build_helper_buf_push_bytes(body: ByteBuf) {
    // params: 0=hdr(i32), 1=src(i32), 2=slen(i32); locals: 3=len, 4=cap, 5=data, 6=ncap, 7=ndata, 8=i
    wasm_op3(body, 1, 6, 0x7F)

    wasm_local_get(body, 2); wasm_i32_const(body, 0); wasm_op4(body, 0x4C, 0x04, 0x40, 0x0F); buf_push(body, 0x0B)
    wasm_emit_buf_grow_bytes(body, 0, 2, 3, 4, 5, 6, 7, 8)

    wasm_i32_const(body, 0); wasm_local_set(body, 8)
    wasm_loop_hdr(body)
    wasm_local_get(body, 8); wasm_local_get(body, 2); wasm_op3(body, 0x4F, 0x0D, 0x01)
    wasm_local_get(body, 5); wasm_local_get(body, 3); buf_push(body, 0x6A); wasm_local_get(body, 8); buf_push(body, 0x6A)
    wasm_local_get(body, 1); wasm_local_get(body, 8); buf_push(body, 0x6A)
    wasm_mem_op(body, 0x2D, 0, 0); wasm_mem_op(body, 0x3A, 0, 0)
    wasm_local_get(body, 8); wasm_i32_const(body, 1); buf_push(body, 0x6A); wasm_local_set(body, 8)
    wasm_loop_end(body)

    wasm_local_get(body, 0); wasm_local_get(body, 3); wasm_local_get(body, 2); wasm_op3(body, 0x6A, 0xAD, 0x37); wasm_memarg(body, 3, 0)
    buf_push(body, 0x0B)
}

// `wfn_buf_push_i64(hdr: i32, val: i64) -> ()`
fn wasm_build_helper_buf_push_i64(body: ByteBuf) {
    wasm_op3(body, 2, 1, 0x7E); wasm_op2(body, 2, 0x7F)
    wasm_emit_format_i64_scratch(body, 1, 2, 3, 4)
    wasm_local_get(body, 0); wasm_local_get(body, 3)
    wasm_i32_const(body, 64); wasm_local_get(body, 3); buf_push(body, 0x6B)
    wasm_call(body, wfn_buf_push_bytes())
    buf_push(body, 0x0B)
}

// `wfn_buf_push_dec(hdr: i32, val: i64) -> ()`
fn wasm_build_helper_buf_push_dec(body: ByteBuf) {
    wasm_op3(body, 2, 3, 0x7E); wasm_op2(body, 3, 0x7F)
    wasm_emit_format_dec_scratch(body, 1, 2, 3, 4, 5, 6, 7)
    wasm_local_get(body, 0); wasm_local_get(body, 5)
    wasm_i32_const(body, 64); wasm_local_get(body, 5); buf_push(body, 0x6B)
    wasm_call(body, wfn_buf_push_bytes())
    buf_push(body, 0x0B)
}

// `wfn_str_eq(a: i64, b: i64) -> i64`
fn wasm_build_helper_str_eq(body: ByteBuf) {
    // params: 0=a(i64), 1=b(i64); locals: 2=pa(i32), 3=la(i32), 4=pb(i32), 5=i(i32)
    wasm_op3(body, 1, 4, 0x7F)

    wasm_local_get(body, 0); wasm_i64_const(body, 32); wasm_op2(body, 0x88, 0xA7); wasm_local_set(body, 3)
    wasm_local_get(body, 3); wasm_local_get(body, 1); wasm_i64_const(body, 32); wasm_op2(body, 0x88, 0xA7)
    wasm_op3(body, 0x47, 0x04, 0x40); wasm_i64_const(body, 0); wasm_op2(body, 0x0F, 0x0B)

    wasm_get_wrap(body, 0); wasm_local_set(body, 2)
    wasm_get_wrap(body, 1); wasm_local_set(body, 4)
    wasm_i32_const(body, 0); wasm_local_set(body, 5)

    wasm_loop_hdr(body)
    wasm_local_get(body, 5); wasm_local_get(body, 3); wasm_op3(body, 0x4F, 0x0D, 0x01)
    wasm_local_get(body, 2); wasm_local_get(body, 5); buf_push(body, 0x6A); wasm_mem_op(body, 0x2D, 0, 0)
    wasm_local_get(body, 4); wasm_local_get(body, 5); buf_push(body, 0x6A); wasm_mem_op(body, 0x2D, 0, 0)
    wasm_op3(body, 0x47, 0x04, 0x40); wasm_i64_const(body, 0); wasm_op2(body, 0x0F, 0x0B)
    wasm_local_get(body, 5); wasm_i32_const(body, 1); buf_push(body, 0x6A); wasm_local_set(body, 5)
    wasm_loop_end(body)

    wasm_i64_const(body, 1); buf_push(body, 0x0B)
}

// `wfn_str_concat(a: i64, b: i64) -> i64`
fn wasm_build_helper_str_concat(body: ByteBuf) {
    // params: 0=a(i64), 1=b(i64); locals: 2=pa, 3=la, 4=pb, 5=lb, 6=dst, 7=i
    wasm_op3(body, 1, 6, 0x7F)

    wasm_get_wrap(body, 0); wasm_local_set(body, 2)
    wasm_local_get(body, 0); wasm_i64_const(body, 32); wasm_op2(body, 0x88, 0xA7); wasm_local_set(body, 3)
    wasm_get_wrap(body, 1); wasm_local_set(body, 4)
    wasm_local_get(body, 1); wasm_i64_const(body, 32); wasm_op2(body, 0x88, 0xA7); wasm_local_set(body, 5)

    wasm_local_get(body, 3); wasm_local_get(body, 5); buf_push(body, 0x6A); wasm_i32_const(body, 1); buf_push(body, 0x6A)
    wasm_call(body, wfn_alloc()); wasm_local_set(body, 6)

    wasm_i32_const(body, 0); wasm_local_set(body, 7)
    wasm_loop_hdr(body)
    wasm_local_get(body, 7); wasm_local_get(body, 3); wasm_op3(body, 0x4F, 0x0D, 0x01)
    wasm_local_get(body, 6); wasm_local_get(body, 7); buf_push(body, 0x6A)
    wasm_local_get(body, 2); wasm_local_get(body, 7); buf_push(body, 0x6A)
    wasm_mem_op(body, 0x2D, 0, 0); wasm_mem_op(body, 0x3A, 0, 0)
    wasm_local_get(body, 7); wasm_i32_const(body, 1); buf_push(body, 0x6A); wasm_local_set(body, 7)
    wasm_loop_end(body)

    wasm_i32_const(body, 0); wasm_local_set(body, 7)
    wasm_loop_hdr(body)
    wasm_local_get(body, 7); wasm_local_get(body, 5); wasm_op3(body, 0x4F, 0x0D, 0x01)
    wasm_local_get(body, 6); wasm_local_get(body, 3); buf_push(body, 0x6A); wasm_local_get(body, 7); buf_push(body, 0x6A)
    wasm_local_get(body, 4); wasm_local_get(body, 7); buf_push(body, 0x6A)
    wasm_mem_op(body, 0x2D, 0, 0); wasm_mem_op(body, 0x3A, 0, 0)
    wasm_local_get(body, 7); wasm_i32_const(body, 1); buf_push(body, 0x6A); wasm_local_set(body, 7)
    wasm_loop_end(body)

    wasm_local_get(body, 6); wasm_local_get(body, 3); buf_push(body, 0x6A); wasm_local_get(body, 5); buf_push(body, 0x6A)
    wasm_i32_const(body, 0); wasm_mem_op(body, 0x3A, 0, 0)

    wasm_local_get(body, 6); buf_push(body, 0xAD)
    wasm_local_get(body, 3); wasm_local_get(body, 5); wasm_op2(body, 0x6A, 0xAD)
    wasm_i64_const(body, 32); wasm_op3(body, 0x86, 0x84, 0x0B)
}

// `wfn_table_fill_f32(ptr: i32, cnt: i32, val_bits: i64) -> ()` (SIMD128 `v128.store` + scalar tail)
fn wasm_build_helper_table_fill_f32(body: ByteBuf) {
    // params: 0=ptr(i32), 1=cnt(i32), 2=val_bits(i64); locals: 3=i, 4=vec_end, 5=vf(f32), 6=vs(v128)
    wasm_op3(body, 3, 2, 0x7F); wasm_op2(body, 1, 0x7D); wasm_op2(body, 1, 0x7B)

    wasm_local_get(body, 2); wasm_op2(body, 0xBF, 0xB6); wasm_local_tee(body, 5)
    wasm_simd_op(body, 19); wasm_local_set(body, 6) // f32x4.splat

    wasm_local_get(body, 1); wasm_i32_const(body, -4); buf_push(body, 0x71); wasm_local_set(body, 4)
    wasm_i32_const(body, 0); wasm_local_set(body, 3)

    wasm_loop_hdr(body)
    wasm_local_get(body, 3); wasm_local_get(body, 4); wasm_op3(body, 0x4E, 0x0D, 0x01)
    wasm_local_get(body, 0); wasm_local_get(body, 3); wasm_i32_const(body, 2); wasm_op2(body, 0x74, 0x6A)
    wasm_local_get(body, 6); wasm_simd_op(body, 11); wasm_memarg(body, 0, 0)
    wasm_local_get(body, 3); wasm_i32_const(body, 4); buf_push(body, 0x6A); wasm_local_set(body, 3)
    wasm_loop_end(body)

    wasm_loop_hdr(body)
    wasm_local_get(body, 3); wasm_local_get(body, 1); wasm_op3(body, 0x4E, 0x0D, 0x01)
    wasm_local_get(body, 0); wasm_local_get(body, 3); wasm_i32_const(body, 2); wasm_op2(body, 0x74, 0x6A)
    wasm_local_get(body, 5); wasm_mem_op(body, 0x38, 0, 0)
    wasm_local_get(body, 3); wasm_i32_const(body, 1); buf_push(body, 0x6A); wasm_local_set(body, 3)
    wasm_loop_end(body)
    buf_push(body, 0x0B)
}

// --- Type Inference ---

fn wasm_infer_expr_ty(wc: WasmCtx, enid: i64) -> i64 {
    if enid <= 0 { return ty_int() }
    k := ast_kind(wc.nodes, enid)
    if k == nk_float() { return ty_float() }
    if k == nk_dec() { return ty_dec() }
    if k == nk_str() or k == nk_secret_str() or k == nk_fstr() { return ty_str() }
    if k == nk_bool() { return ty_bool() }
    if k == nk_ident() or k == nk_move_ident() {
        soff := ast_get(wc.nodes, enid, 1)
        slen := ast_get(wc.nodes, enid, 2)
        lb := wasm_find_local(wc, soff, slen)
        if lb >= 0 {
            return ibuf_get(wc.locals, lb + 3)
        }
        cb := ct_find_global_const(wc.pool, wc.sym, soff, slen)
        if cb >= 0 {
            return ibuf_get(wc.sym, cb + 2)
        }
    }
    if k == nk_unary() {
        if ast_get(wc.nodes, enid, 1) == uop_neg() {
            return wasm_infer_expr_ty(wc, ast_get(wc.nodes, enid, 2))
        }
        return ty_bool()
    }
    if k == nk_binary() {
        op := ast_get(wc.nodes, enid, 1)
        lty := wasm_infer_expr_ty(wc, ast_get(wc.nodes, enid, 2))
        if op == op_or() and ty_tag(lty) == 13 {
            return ty_pay(lty)
        }
        if op >= op_eq() and op <= op_or() {
            return ty_bool()
        }
        rty := wasm_infer_expr_ty(wc, ast_get(wc.nodes, enid, 3))
        if ty_tag(lty) == ty_str() or ty_tag(rty) == ty_str() { return ty_str() }
        if ty_tag(lty) == ty_float() or ty_tag(rty) == ty_float() { return ty_float() }
        if ty_tag(lty) == ty_dec() or ty_tag(rty) == ty_dec() { return ty_dec() }
        return lty
    }
    if k == nk_or_return() {
        lty := wasm_infer_expr_ty(wc, ast_get(wc.nodes, enid, 1))
        if ty_tag(lty) == 13 {
            return ty_pay(lty)
        }
        return lty
    }
    if k == nk_cast() {
        ibuf_set(wc.sym, 13, ast_get(wc.nodes, enid, 2))
        return resolve_typespec(wc.pool, wc.nodes, wc.extra, wc.sym)
    }
    if k == nk_if_expr() {
        tb := ast_get(wc.nodes, enid, 2)
        if tb > 0 {
            return wasm_infer_expr_ty(wc, ast_get(wc.nodes, tb, 3))
        }
    }
    if k == nk_field() {
        bty := wasm_infer_expr_ty(wc, ast_get(wc.nodes, enid, 1))
        fsoff := ast_get(wc.nodes, enid, 2)
        fslen := ast_get(wc.nodes, enid, 3)
        if pool_str_eq_lit(wc.pool, fsoff, fslen, "len") and (ty_tag(bty) == 5 or ty_tag(bty) == 12) {
            return ty_int()
        }
        if ty_tag(bty) == 10 {
            fo := find_struct_field(wc.pool, wc.sym, ty_pay(bty), fsoff | (fslen << 32))
            if fo >= 0 {
                return ibuf_get(wc.sym, fo + 3)
            }
        }
    }
    if k == nk_table_alloc() {
        esoff := ast_get(wc.nodes, enid, 1)
        eslen := ast_get(wc.nodes, enid, 2)
        sidx := find_struct_idx(wc.pool, wc.sym, esoff, eslen)
        if sidx >= 0 { return ty_make(12, sidx) }
        return ty_make(12, 60001)
    }
    if k == nk_call() {
        csoff := ast_get(wc.nodes, enid, 1)
        cslen := ast_get(wc.nodes, enid, 2)
        aoff := ast_get(wc.nodes, enid, 3)
        acnt := ast_get(wc.nodes, enid, 4)
        sidx := find_struct_idx(wc.pool, wc.sym, csoff, cslen)
        if sidx >= 0 { return ty_make(10, sidx) }
        if pool_str_eq_lit(wc.pool, csoff, cslen, "table_get_f32") or pool_str_eq_lit(wc.pool, csoff, cslen, "sqrt_f64") or pool_str_eq_lit(wc.pool, csoff, cslen, "abs_f64") {
            return ty_float()
        }
        if pool_str_eq_lit(wc.pool, csoff, cslen, "buf_slice_str") or pool_str_eq_lit(wc.pool, csoff, cslen, "str_slice") {
            return ty_str()
        }
        if pool_str_eq_lit(wc.pool, csoff, cslen, "buf_new") { return ty_bytebuf() }
        if pool_str_eq_lit(wc.pool, csoff, cslen, "ibuf_new") { return ty_intbuf() }
        if pool_str_eq_lit(wc.pool, csoff, cslen, "ok") and acnt >= 1 {
            return ty_make(13, wasm_infer_expr_ty(wc, ast_get(wc.nodes, ibuf_get(wc.extra, aoff), 4)))
        }
        if pool_str_eq_lit(wc.pool, csoff, cslen, "err") { return ty_make(13, ty_int()) }
        fi := find_fn_idx(wc.pool, wc.sym, csoff, cslen)
        if fi >= 0 {
            return ibuf_get(wc.sym, ibuf_get(wc.sym, 7) + fi * 10 + 5)
        }
    }
    if k == nk_method_call() {
        msoff := ast_get(wc.nodes, enid, 2)
        mslen := ast_get(wc.nodes, enid, 3)
        fi := find_fn_idx(wc.pool, wc.sym, msoff, mslen)
        if fi >= 0 {
            return ibuf_get(wc.sym, ibuf_get(wc.sym, 7) + fi * 10 + 5)
        }
    }
    if k == nk_await() or k == nk_comptime_expr() {
        return wasm_infer_expr_ty(wc, ast_get(wc.nodes, enid, 1))
    }
    return ty_int()
}

// Prints expression value (`val_nid`) cleanly matching native `emit_print_value`
fn wasm_emit_print_val(wc: WasmCtx, c: ByteBuf, val_nid: i64) {
    vty := wasm_infer_expr_ty(wc, val_nid)
    mut tg := ty_tag(vty)
    if tg == 16 or tg == 22 { tg = ty_tag(ty_pay(vty)) }
    if tg == ty_str() {
        tstr := wasm_alloc_tmp(wc)
        wasm_emit_expr(wc, c, val_nid)
        wasm_local_set(c, tstr)
        wasm_local_get(c, tstr); buf_push(c, 0xA7)
        wasm_local_get(c, tstr); wasm_i64_const(c, 32); buf_push(c, 0x88); buf_push(c, 0xA7)
        wasm_call(c, wfn_print_str())
    } else if tg == ty_dec() {
        wasm_emit_expr(wc, c, val_nid)
        wasm_call(c, wfn_print_dec())
    } else if tg == ty_float() {
        wasm_emit_expr(wc, c, val_nid)
        wasm_emit_float_to_dec(c)
        wasm_call(c, wfn_print_dec())
    } else if tg == ty_bool() {
        tref := wasm_intern_lit(wc, "true")
        fref := wasm_intern_lit(wc, "false")
        wasm_emit_expr(wc, c, val_nid)
        wasm_i64_const(c, 0); wasm_op3(c, 0x52, 0x04, 0x40)
        wasm_i32_const(c, tref & 0xFFFFFFFF); wasm_i32_const(c, 4); wasm_call(c, wfn_print_str())
        buf_push(c, 0x05)
        wasm_i32_const(c, fref & 0xFFFFFFFF); wasm_i32_const(c, 5); wasm_call(c, wfn_print_str())
        buf_push(c, 0x0B)
    } else {
        wasm_emit_expr(wc, c, val_nid)
        wasm_call(c, wfn_print_i64())
    }
}

fn wasm_emit_fstr_expr(wc: WasmCtx, c: ByteBuf, enid: i64) {
    poff := ast_get(wc.nodes, enid, 1)
    pcnt := ast_get(wc.nodes, enid, 2)
    jb_tmp := wasm_alloc_tmp(wc)
    t_str := wasm_alloc_tmp(wc)
    wasm_i64_const(c, 64)
    wasm_i32_const(c, 1)
    wasm_call(c, wfn_buf_new())
    wasm_local_set(c, jb_tmp)

    mut pi := 0
    while pi < pcnt {
        pe := ibuf_get(wc.extra, poff + pi)
        if ast_kind(wc.nodes, pe) == nk_str() {
            ls_off := ast_get(wc.nodes, pe, 1)
            ls_len := ast_get(wc.nodes, pe, 2)
            if ls_len > 0 {
                pref := wasm_intern_slice(wc, ls_off, ls_len)
                wasm_get_wrap(c, jb_tmp)
                wasm_i32_const(c, pref & 0xFFFFFFFF)
                wasm_i32_const(c, ls_len)
                wasm_call(c, wfn_buf_push_bytes())
            }
        } else {
            mut pty := wasm_infer_expr_ty(wc, pe)
            if ty_tag(pty) == 16 or ty_tag(pty) == 22 { pty = ty_pay(pty) }
            ptg := ty_tag(pty)
            if ptg == ty_str() {
                wasm_emit_expr(wc, c, pe)
                wasm_local_set(c, t_str)
                wasm_get_wrap(c, jb_tmp)
                wasm_get_wrap(c, t_str)
                wasm_local_get(c, t_str); wasm_i64_const(c, 32); wasm_op2(c, 0x88, 0xA7)
                wasm_call(c, wfn_buf_push_bytes())
            } else if ptg == ty_dec() {
                wasm_get_wrap(c, jb_tmp)
                wasm_emit_expr(wc, c, pe)
                wasm_call(c, wfn_buf_push_dec())
            } else if ptg == ty_float() {
                wasm_get_wrap(c, jb_tmp)
                wasm_emit_expr(wc, c, pe)
                wasm_emit_float_to_dec(c)
                wasm_call(c, wfn_buf_push_dec())
            } else if ptg == ty_bool() {
                tref := wasm_intern_lit(wc, "true")
                fref := wasm_intern_lit(wc, "false")
                wasm_emit_expr(wc, c, pe)
                wasm_i64_const(c, 0); wasm_op3(c, 0x52, 0x04, 0x40)
                wasm_get_wrap(c, jb_tmp); wasm_i32_const(c, tref & 0xFFFFFFFF); wasm_i32_const(c, 4); wasm_call(c, wfn_buf_push_bytes())
                buf_push(c, 0x05)
                wasm_get_wrap(c, jb_tmp); wasm_i32_const(c, fref & 0xFFFFFFFF); wasm_i32_const(c, 5); wasm_call(c, wfn_buf_push_bytes())
                buf_push(c, 0x0B)
            } else {
                wasm_get_wrap(c, jb_tmp)
                wasm_emit_expr(wc, c, pe)
                wasm_call(c, wfn_buf_push_i64())
            }
        }
        pi += 1
    }

    // Pack `[hdr + 16]` (data_ptr) | (`[hdr + 0]` (len) << 32)
    wasm_wrap_mem(c, jb_tmp, 0x28, 2, 16)
    buf_push(c, 0xAD)
    wasm_wrap_mem(c, jb_tmp, 0x29, 3, 0)
    wasm_i64_const(c, 32); buf_push(c, 0x86); buf_push(c, 0x84)
}

fn wasm_emit_user_call_with_recv(wc: WasmCtx, c: ByteBuf, fi: i64, recv_nid: i64, aoff: i64, acnt: i64) {
    wfi := ibuf_get(wc.fn_map, fi)
    if wfi < 0 {
        wasm_i64_const(c, 0)
        return
    }
    fo := ibuf_get(wc.sym, 7) + fi * 10
    p_base := ibuf_get(wc.sym, fo + 3)
    p_cnt := ibuf_get(wc.sym, fo + 4)

    mut pi := 0
    while pi < p_cnt {
        if pi == 0 and recv_nid > 0 {
            wasm_emit_expr(wc, c, recv_nid)
        } else {
            po := p_base + pi * 6
            pn_soff := ibuf_get(wc.sym, po)
            pn_slen := ibuf_get(wc.sym, po + 1)
            def_nid := ibuf_get(wc.sym, po + 5)
            mut pos_slot := pi
            if recv_nid > 0 { pos_slot = pi - 1 }

            mut matched_ca := 0
            mut ai := 0
            while ai < acnt {
                ca := ibuf_get(wc.extra, aoff + ai)
                an_soff := ast_get(wc.nodes, ca, 2)
                an_slen := ast_get(wc.nodes, ca, 3)
                if an_soff >= 0 and an_slen == pn_slen and pool_str_eq2(wc.pool, an_soff, pn_slen, pn_soff) {
                    matched_ca = ca
                    break
                }
                ai += 1
            }
            if matched_ca == 0 and pos_slot >= 0 and pos_slot < acnt {
                cand := ibuf_get(wc.extra, aoff + pos_slot)
                if ast_get(wc.nodes, cand, 2) < 0 {
                    matched_ca = cand
                }
            }

            if matched_ca > 0 {
                wasm_emit_expr(wc, c, ast_get(wc.nodes, matched_ca, 4))
            } else if def_nid > 0 {
                wasm_emit_expr(wc, c, def_nid)
            } else {
                wasm_i64_const(c, 0)
            }
        }
        pi += 1
    }
    wasm_call(c, wfi)
}

fn wasm_emit_table_col_offset(wc: WasmCtx, c: ByteBuf, tbl_nid: i64, col_nid: i64, cnt_tmp: i64) {
    tty := wasm_infer_expr_ty(wc, tbl_nid)
    mut remapped_col := -1
    if ty_tag(tty) == 12 {
        tpay := ty_pay(tty)
        if tpay >= 0 and tpay < 60000 and is_const_int_expr(wc.pool, wc.nodes, wc.sym, col_nid) {
            remapped_col = soa_remap_col(wc.sym, tpay, eval_const_int_val(wc.pool, wc.nodes, wc.sym, col_nid))
        }
    }
    if remapped_col >= 0 {
        wasm_i64_const(c, remapped_col)
    } else {
        wasm_emit_expr(wc, c, col_nid)
    }
    wasm_local_get(c, cnt_tmp)
    buf_push(c, 0x7E) // col * cnt
    wasm_i64_const(c, 2); buf_push(c, 0x86) // * 4 bytes
}

// Emits bounds-checked ByteBuf/IntBuf element read or write leaving `i64` result on stack
fn wasm_emit_buf_elem_op(wc: WasmCtx, c: ByteBuf, aoff: i64, is_set: i64, is_ibuf: i64) {
    btmp := wasm_alloc_tmp(wc)
    itmp := wasm_alloc_tmp(wc)
    wasm_arg_set(wc, c, aoff, 0, btmp)
    wasm_arg_set(wc, c, aoff, 1, itmp)
    mut vtmp := 0
    if is_set != 0 {
        vtmp = wasm_alloc_tmp(wc)
        wasm_arg_set(wc, c, aoff, 2, vtmp)
    }
    wasm_local_get(c, itmp); wasm_wrap_mem(c, btmp, 0x29, 3, 0); wasm_trap_ge_u(c)
    wasm_wrap_mem(c, btmp, 0x28, 2, 16); wasm_get_wrap(c, itmp)
    if is_ibuf != 0 { wasm_i32_const(c, 3); buf_push(c, 0x74) }
    buf_push(c, 0x6A)
    if is_set != 0 {
        wasm_local_get(c, vtmp)
        if is_ibuf != 0 { wasm_mem_op(c, 0x37, 3, 0) } else { wasm_mem_op(c, 0x3C, 0, 0) }
        wasm_i64_const(c, 0)
    } else {
        if is_ibuf != 0 { wasm_mem_op(c, 0x29, 3, 0) } else { wasm_mem_op(c, 0x31, 0, 0) }
    }
}

// Emits Result heap box `[tag: i64, payload: i64]` (`tag==0` for ok, non-zero for err)
fn wasm_emit_ok_or_err(wc: WasmCtx, c: ByteBuf, val_nid: i64, is_err: i64) {
    vtmp := wasm_alloc_tmp(wc)
    rptr := wasm_alloc_tmp(wc)
    wasm_emit_expr(wc, c, val_nid)
    if is_err != 0 {
        wasm_local_tee(c, vtmp)
        wasm_op3(c, 0x50, 0x04, 0x40)
        wasm_i64_const(c, 1); wasm_local_set(c, vtmp)
        buf_push(c, 0x0B)
    } else {
        wasm_local_set(c, vtmp)
    }
    wasm_i32_const(c, 16); wasm_call(c, wfn_alloc()); buf_push(c, 0xAD); wasm_local_set(c, rptr)
    wasm_get_wrap(c, rptr)
    if is_err != 0 { wasm_local_get(c, vtmp) } else { wasm_i64_const(c, 0) }
    wasm_mem_op(c, 0x37, 3, 0)
    wasm_get_wrap(c, rptr)
    if is_err != 0 { wasm_i64_const(c, 0) } else { wasm_local_get(c, vtmp) }
    wasm_mem_op(c, 0x37, 3, 8)
    wasm_local_get(c, rptr)
}

// Emits WASM bytecode pushing exactly ONE `i64` onto the operand stack.
fn wasm_emit_expr(wc: WasmCtx, c: ByteBuf, enid: i64) {
    if enid <= 0 {
        wasm_i64_const(c, 0)
        return
    }
    k := ast_kind(wc.nodes, enid)
    if k == nk_int() or k == nk_dec() or k == nk_bool() or k == nk_float() {
        wasm_i64_const(c, ast_get(wc.nodes, enid, 1))
        return
    }
    if k == nk_str() or k == nk_secret_str() {
        pref := wasm_intern_slice(wc, ast_get(wc.nodes, enid, 1), ast_get(wc.nodes, enid, 2))
        wasm_i64_const(c, pref)
        return
    }
    if k == nk_fstr() {
        wasm_emit_fstr_expr(wc, c, enid)
        return
    }
    if k == nk_ident() or k == nk_move_ident() {
        soff := ast_get(wc.nodes, enid, 1)
        slen := ast_get(wc.nodes, enid, 2)
        lb := wasm_find_local(wc, soff, slen)
        if lb >= 0 {
            wasm_local_get(c, ibuf_get(wc.locals, lb + 2))
            return
        }
        cb := ct_find_global_const(wc.pool, wc.sym, soff, slen)
        if cb >= 0 {
            cty := ibuf_get(wc.sym, cb + 2)
            cval := ibuf_get(wc.sym, cb + 3)
            if ty_tag(cty) == ty_str() {
                wasm_i64_const(c, wasm_intern_slice(wc, cval, ibuf_get(wc.sym, cb + 4)))
            } else {
                wasm_i64_const(c, cval)
            }
            return
        }
        wasm_i64_const(c, 0)
        return
    }
    if k == nk_tuple() {
        eoff := ast_get(wc.nodes, enid, 1)
        ecnt := ast_get(wc.nodes, enid, 2)
        mut bytes := ecnt * 8
        if bytes < 16 { bytes = 16 }
        tptr := wasm_alloc_tmp(wc)
        wasm_i32_const(c, bytes); wasm_call(c, wfn_alloc()); buf_push(c, 0xAD)
        wasm_local_set(c, tptr)
        mut i := 0
        while i < ecnt {
            wasm_local_get(c, tptr); buf_push(c, 0xA7)
            wasm_emit_expr(wc, c, ibuf_get(wc.extra, eoff + i))
            buf_push(c, 0x37); wasm_memarg(c, 3, i * 8)
            i += 1
        }
        wasm_local_get(c, tptr)
        return
    }
    if k == nk_tuple_idx() {
        tptr := wasm_alloc_tmp(wc)
        wasm_emit_expr(wc, c, ast_get(wc.nodes, enid, 1))
        wasm_emit_ptr_field_load(c, tptr, ast_get(wc.nodes, enid, 2) * 8)
        return
    }
    if k == nk_field() {
        base_e := ast_get(wc.nodes, enid, 1)
        fsoff := ast_get(wc.nodes, enid, 2)
        fslen := ast_get(wc.nodes, enid, 3)
        bty := wasm_infer_expr_ty(wc, base_e)
        if pool_str_eq_lit(wc.pool, fsoff, fslen, "len") and (ty_tag(bty) == 5 or ty_tag(bty) == 12) {
            wasm_emit_expr(wc, c, base_e)
            wasm_i64_const(c, 32)
            buf_push(c, 0x88)
            return
        }
        if ty_tag(bty) == 10 {
            fo := find_struct_field(wc.pool, wc.sym, ty_pay(bty), fsoff | (fslen << 32))
            if fo >= 0 {
                sptr := wasm_alloc_tmp(wc)
                wasm_emit_expr(wc, c, base_e)
                wasm_emit_ptr_field_load(c, sptr, ibuf_get(wc.sym, fo + 2) * 8)
