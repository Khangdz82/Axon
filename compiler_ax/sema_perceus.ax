            ibuf_push(sym, tp_val)
            if is_const_int_expr(pool, nodes, sym, d0_s) { ibuf_push(sym, 0); ibuf_push(sym, eval_const_int_val(pool, nodes, sym, d0_s)) }
            else if ast_kind(nodes, d0_s) == nk_ident() { ibuf_push(sym, ast_get(nodes, d0_s, 2)); ibuf_push(sym, ast_get(nodes, d0_s, 1)) }
            else { ibuf_push(sym, 1); ibuf_push(sym, 0) }
            if is_const_int_expr(pool, nodes, sym, d1_s) { ibuf_push(sym, 0); ibuf_push(sym, eval_const_int_val(pool, nodes, sym, d1_s)) }
            else if ast_kind(nodes, d1_s) == nk_ident() { ibuf_push(sym, ast_get(nodes, d1_s, 2)); ibuf_push(sym, ast_get(nodes, d1_s, 1)) }
            else { ibuf_push(sym, 1); ibuf_push(sym, 0) }
            buf_free(move arg_tys)
            return ty_make(21, sdesc)
        }
        if pool_str_eq_lit(pool, csoff, cslen, "tensor_matmul") {
            if acnt != 2 {
                sema_record_err(sym, 404, sp)
                buf_free(move arg_tys)
                return ty_any()
            }
            mm_ty := verify_tensor_matmul_shapes(pool, sym, first_arg_ty, second_arg_ty)
            buf_free(move arg_tys)
            if mm_ty == 0 {
                sema_record_err(sym, 602, sp)
                return ty_any()
            }
            return mm_ty
        }
        if pool_str_eq_lit(pool, csoff, cslen, "all_reduce_sum") {
            if acnt != 1 {
                sema_record_err(sym, 404, sp)
            } else {
                ca0 := ibuf_get(extra, aoff)
                if ast_get(nodes, ca0, 1) != pmode_move() and ast_kind(nodes, ast_get(nodes, ca0, 4)) == nk_ident() {
                    sema_record_err(sym, 404, sp)
                }
            }
            buf_free(move arg_tys)
            return first_arg_ty
        }

        if pool_str_eq_lit(pool, csoff, cslen, "table_fill_f32") or pool_str_eq_lit(pool, csoff, cslen, "table_get_f32") {
            if acnt != 3 {
                sema_record_err(sym, 404, sp)
            } else {
                if ty_tag(first_arg_ty) == 12 {
                    ts_idx := ty_pay(first_arg_ty)
                    if ts_idx >= 0 and ts_idx < 60000 {
                        col_e := ast_get(nodes, ibuf_get(extra, aoff + 1), 4)
                        if is_const_int_expr(pool, nodes, sym, col_e) {
                            cval := eval_const_int_val(pool, nodes, sym, col_e)
                            s_off := ibuf_get(sym, 3) + ts_idx * 6
                            fcnt := ibuf_get(sym, s_off + 4)
                            if cval < 0 or cval >= fcnt {
                                sema_record_err(sym, 404, sp)
                            } else {
                                soa_mark_col_used(sym, ts_idx, cval)
                            }
                        } else {
                            soa_mark_dynamic_cols(sym, ts_idx)
                        }
                    }
                }
            }
            buf_free(move arg_tys)
            if pool_str_eq_lit(pool, csoff, cslen, "table_get_f32") {
                return ty_float()
            }
            return ty_unit()
        }

        if pool_str_eq_lit(pool, csoff, cslen, "assert") {
            if acnt < 1 or acnt > 2 { sema_record_err(sym, 404, sp) }
            buf_free(move arg_tys)
            return ty_unit()
        }
        if pool_str_eq_lit(pool, csoff, cslen, "exit_process") {
            if acnt != 1 { sema_record_err(sym, 404, sp) }
            buf_free(move arg_tys)
            return ty_unit()
        }

        // Struct Constructor Verification
        sidx := find_struct_idx(pool, sym, csoff, cslen)
        if sidx >= 0 {
            s_off := ibuf_get(sym, 3) + sidx * 6
            f_base := ibuf_get(sym, s_off + 3)
            f_cnt := ibuf_get(sym, s_off + 4)
            if acnt > f_cnt {
                sema_record_err(sym, 404, sp)
            } else {
                mut ai := 0
                while ai < acnt {
                    ca := ibuf_get(extra, aoff + ai)
                    an_soff := ast_get(nodes, ca, 2)
                    an_slen := ast_get(nodes, ca, 3)
                    aty := ibuf_get(arg_tys, ai)
                    if an_soff >= 0 {
                        fo := find_struct_field(pool, sym, sidx, an_soff | (an_slen << 32))
                        if fo < 0 {
                            sema_record_err(sym, 404, sp)
                        } else {
                            fty := ibuf_get(sym, fo + 3)
                            if ty_tag(aty) == 16 and ty_tag(fty) != 16 { sema_record_err(sym, 502, sp) }
                            else if not types_compatible(sym, fty, aty) { sema_record_err(sym, 401, sp) }
                        }
                    } else {
                        fo := f_base + ai * 4
                        fty := ibuf_get(sym, fo + 3)
                        if ty_tag(aty) == 16 and ty_tag(fty) != 16 { sema_record_err(sym, 502, sp) }
                        else if not types_compatible(sym, fty, aty) { sema_record_err(sym, 401, sp) }
                    }
                    ai += 1
                }
            }
            buf_free(move arg_tys)
            return ty_make(10, sidx)
        }

        // User / Stdlib Function Verification
        fidx := find_fn_idx(pool, sym, csoff, cslen)
        if fidx >= 0 {
            fret := verify_fn_call_sig(pool, nodes, extra, sym, locals, fidx, 0, aoff, acnt, arg_tys, sp)
            buf_free(move arg_tys)
            return fret
        }

        buf_free(move arg_tys)
        sema_record_err(sym, 403, sp)
        return ty_any()
    }

    return ty_any()
}

fn check_call_arg_node(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, locals: IntBuf, ca: i64) -> i64 {
    mode := ast_get(nodes, ca, 1)
    aexpr := ast_get(nodes, ca, 4)
    sp := ast_span(nodes, ca)
    if mode == pmode_move() and ast_kind(nodes, aexpr) == nk_ident() {
        soff := ast_get(nodes, aexpr, 1)
        slen := ast_get(nodes, aexpr, 2)
        lbase := local_find(pool, locals, soff, slen)
        if lbase >= 0 {
            if ibuf_get(locals, lbase + 4) > 0 {
                sema_record_err(sym, 201, sp)
            } else {
                ibuf_set(locals, lbase + 4, sp)
            }
            if ibuf_get(sym, 10) == 1 {
                ibuf_set(locals, lbase + 5, 1)
            }
            return ibuf_get(locals, lbase + 2)
        }
        sema_record_err(sym, 403, sp)
        return ty_any()
    }
    if mode == pmode_mut() and ast_kind(nodes, aexpr) == nk_ident() {
        soff := ast_get(nodes, aexpr, 1)
        slen := ast_get(nodes, aexpr, 2)
        lbase := local_find(pool, locals, soff, slen)
        if lbase >= 0 {
            lflags := ibuf_get(locals, lbase + 3)
            if ibuf_get(sym, 10) == 1 and (lflags & 4) != 0 and (lflags & 2) != 0 and ibuf_get(locals, lbase + 5) == 0 {
                sema_record_err(sym, 202, sp)
            }
        }
    }
    return check_expr_full(pool, nodes, extra, sym, locals, aexpr)
}

// --- SoA `Table[T]` Hardware AVX2 SIMD Loop & Temporal Polyhedral Tiling Planner ---
fn try_plan_foreach_simd(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, fe_nid: i64, tbl_ty: i64) {
    if ty_tag(tbl_ty) != 12 {
        return
    }
    s_idx := ty_pay(tbl_ty)
    if s_idx < 0 or s_idx >= 60000 {
        return
    }
    s_off := ibuf_get(sym, 3) + s_idx * 6
    f_base := ibuf_get(sym, s_off + 3)
    f_cnt := ibuf_get(sym, s_off + 4)
    if f_cnt <= 0 {
        return
    }
    mut fi := 0
    while fi < f_cnt {
        if ibuf_get(sym, f_base + fi * 4 + 3) != ty_float() {
            soa_mark_dynamic_cols(sym, s_idx)
            return
        }
        fi += 1
    }

    vsoff := ast_get(nodes, fe_nid, 1)
    vslen := ast_get(nodes, fe_nid, 2)
    body := ast_get(nodes, fe_nid, 4)
    st_off := ast_get(nodes, body, 1)
    st_cnt := ast_get(nodes, body, 2)
    if st_cnt <= 0 {
        return
    }

    ops_tmp := ibuf_new(64)
    mut si := 0
    while si < st_cnt {
        st := ibuf_get(extra, st_off + si)
        if ast_kind(nodes, st) != nk_assign() {
            soa_mark_dynamic_cols(sym, s_idx)
            return
        }
        aop := ast_get(nodes, st, 1)
        tgt := ast_get(nodes, st, 2)
        rhs := ast_get(nodes, st, 3)
        if ast_kind(nodes, tgt) != nk_field() {
            soa_mark_dynamic_cols(sym, s_idx)
            return
        }
        tbase := ast_get(nodes, tgt, 1)
        if ast_kind(nodes, tbase) != nk_ident() or ast_get(nodes, tbase, 2) != vslen {
            soa_mark_dynamic_cols(sym, s_idx)
            return
        }
        if not pool_str_eq2(pool, ast_get(nodes, tbase, 1), vslen, vsoff) {
            soa_mark_dynamic_cols(sym, s_idx)
            return
        }
        dst_col := find_struct_col_idx(pool, sym, s_idx, ast_get(nodes, tgt, 2) | (ast_get(nodes, tgt, 3) << 32))
        if dst_col < 0 {
            return
        }

        if (aop == aop_add() or aop == aop_sub()) and ast_kind(nodes, rhs) == nk_binary() and ast_get(nodes, rhs, 1) == op_mul() {
            rl := ast_get(nodes, rhs, 2)
            rr := ast_get(nodes, rhs, 3)
            if ast_kind(nodes, rl) == nk_field() {
                rb := ast_get(nodes, rl, 1)
                if ast_kind(nodes, rb) == nk_ident() and ast_get(nodes, rb, 2) == vslen and pool_str_eq2(pool, ast_get(nodes, rb, 1), vslen, vsoff) {
                    src_col := find_struct_col_idx(pool, sym, s_idx, ast_get(nodes, rl, 2) | (ast_get(nodes, rl, 3) << 32))
                    if src_col >= 0 {
                        soa_mark_col_used(sym, s_idx, dst_col)
                        soa_mark_col_used(sym, s_idx, src_col)
                        mut op_tag := 1
                        if aop == aop_sub() { op_tag = 4 }
                        ibuf_push(ops_tmp, op_tag)
                        ibuf_push(ops_tmp, dst_col)
                        ibuf_push(ops_tmp, src_col)
                        ibuf_push(ops_tmp, rr)
                    } else { return }
                } else { return }
            } else { return }
        } else if aop == aop_mul() {
            soa_mark_col_used(sym, s_idx, dst_col)
            ibuf_push(ops_tmp, 2)
            ibuf_push(ops_tmp, dst_col)
            ibuf_push(ops_tmp, 0)
            ibuf_push(ops_tmp, rhs)
        } else if (aop == aop_add() or aop == aop_sub()) and ast_kind(nodes, rhs) == nk_field() {
            rb := ast_get(nodes, rhs, 1)
            if ast_kind(nodes, rb) == nk_ident() and ast_get(nodes, rb, 2) == vslen and pool_str_eq2(pool, ast_get(nodes, rb, 1), vslen, vsoff) {
                src_col := find_struct_col_idx(pool, sym, s_idx, ast_get(nodes, rhs, 2) | (ast_get(nodes, rhs, 3) << 32))
                if src_col >= 0 {
                    soa_mark_col_used(sym, s_idx, dst_col)
                    soa_mark_col_used(sym, s_idx, src_col)
                    mut op_tag2 := 3
                    if aop == aop_sub() { op_tag2 = 5 }
                    ibuf_push(ops_tmp, op_tag2)
                    ibuf_push(ops_tmp, dst_col)
                    ibuf_push(ops_tmp, src_col)
                    ibuf_push(ops_tmp, 0)
                } else { return }
            } else { return }
        } else {
            soa_mark_dynamic_cols(sym, s_idx)
            return
        }
        si += 1
    }

    plan_off := ibuf_len(extra)
    ops_cnt := ibuf_len(ops_tmp) / 4
    ibuf_push(extra, s_idx)
    ibuf_push(extra, ops_cnt)
    mut k := 0
    while k < ibuf_len(ops_tmp) {
        ibuf_push(extra, ibuf_get(ops_tmp, k))
        k += 1
    }
    ast_set(nodes, fe_nid, 5, plan_off)
}

// Detects `while s < steps { for e in table { <simd> }; s += 1 }` for Register-Tiled Polyhedral Execution!
fn try_plan_temporal_while_simd(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, while_nid: i64) {
    cond := ast_get(nodes, while_nid, 1)
    wbody := ast_get(nodes, while_nid, 2)
    if ast_kind(nodes, cond) != nk_binary() or ast_get(nodes, cond, 1) != op_lt() {
        return
    }
    s_id := ast_get(nodes, cond, 2)
    steps_e := ast_get(nodes, cond, 3)
    if ast_kind(nodes, s_id) != nk_ident() {
        return
    }
    s_soff := ast_get(nodes, s_id, 1)
    s_slen := ast_get(nodes, s_id, 2)
    if scan_expr_var_use(pool, nodes, extra, steps_e, s_soff, s_slen, false) != 0 {
        return
    }
    if ast_get(nodes, wbody, 2) != 2 {
        return
    }
    b_off := ast_get(nodes, wbody, 1)
    st0 := ibuf_get(extra, b_off)
    st1 := ibuf_get(extra, b_off + 1)
    if ast_kind(nodes, st0) != nk_for_each() or ast_kind(nodes, st1) != nk_assign() {
        return
    }
    plan_off := ast_get(nodes, st0, 5)
    if plan_off <= 0 {
        return
    }
    if ast_kind(nodes, ast_get(nodes, st0, 3)) != nk_ident() {
        return
    }
    // Check `st1` is `s += 1`
    if ast_get(nodes, st1, 1) != aop_add() {
        return
    }
    inc_tgt := ast_get(nodes, st1, 2)
    inc_rhs := ast_get(nodes, st1, 3)
    if ast_kind(nodes, inc_tgt) != nk_ident() or ast_get(nodes, inc_tgt, 2) != s_slen {
        return
    }
    if not pool_str_eq2(pool, ast_get(nodes, inc_tgt, 1), s_slen, s_soff) {
        return
    }
    if not is_const_int_expr(pool, nodes, sym, inc_rhs) or eval_const_int_val(pool, nodes, sym, inc_rhs) != 1 {
        return
    }

    // Verify all ops are FMA/ADDCOL (`okind == 1` or `3`), scale expressions do not depend on `s`,
    // and columns are mutually hazard-free (`dst_i != src_i` and `dst_i` not read/written by `j != i`).
    ops_cnt := ibuf_get(extra, plan_off + 1)
    mut oi := 0
    while oi < ops_cnt {
        ob := plan_off + 2 + oi * 4
        okind := ibuf_get(extra, ob)
        dcol := ibuf_get(extra, ob + 1)
        scol := ibuf_get(extra, ob + 2)
        sce := ibuf_get(extra, ob + 3)
        if okind != 1 and okind != 3 {
            return
        }
        if dcol == scol {
            return
        }
        if sce > 0 and scan_expr_var_use(pool, nodes, extra, sce, s_soff, s_slen, false) != 0 {
            return
        }
        mut oj := 0
        while oj < ops_cnt {
            if oj != oi {
                ob2 := plan_off + 2 + oj * 4
                d2 := ibuf_get(extra, ob2 + 1)
                s2 := ibuf_get(extra, ob2 + 2)
                if dcol == d2 or dcol == s2 {
                    return
                }
            }
            oj += 1
        }
        oi += 1
    }

    ast_set(nodes, while_nid, 4, (st0 << 2) | 1)
}

fn block_diverges(nodes: IntBuf, extra: IntBuf, bnid: i64) -> bool {
    if bnid <= 0 {
        return false
    }
    off := ast_get(nodes, bnid, 1)
    cnt := ast_get(nodes, bnid, 2)
    if cnt <= 0 {
        return false
    }
    last_st := ibuf_get(extra, off + cnt - 1)
    lk := ast_kind(nodes, last_st)
    if lk == nk_return() or lk == nk_break() or lk == nk_continue() {
        return true
    }
    if lk == nk_if() {
        tb := ast_get(nodes, last_st, 2)
        eb := ast_get(nodes, last_st, 3)
        if eb > 0 and block_diverges(nodes, extra, tb) and block_diverges(nodes, extra, eb) {
            return true
        }
    }
    return false
}

fn block_returns_all_paths(nodes: IntBuf, extra: IntBuf, bnid: i64) -> bool {
    if bnid <= 0 {
        return false
    }
    if ast_get(nodes, bnid, 3) > 0 {
        return true
    }
    off := ast_get(nodes, bnid, 1)
    cnt := ast_get(nodes, bnid, 2)
    mut i := 0
    while i < cnt {
        st := ibuf_get(extra, off + i)
        sk := ast_kind(nodes, st)
        if sk == nk_return() {
            return true
        }
        if sk == nk_if() {
            tb := ast_get(nodes, st, 2)
            eb := ast_get(nodes, st, 3)
            if eb > 0 and block_returns_all_paths(nodes, extra, tb) and block_returns_all_paths(nodes, extra, eb) {
                return true
            }
        }
        i += 1
    }
    return false
}

fn check_stmt_full(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, locals: IntBuf, snid: i64) {
    k := ast_kind(nodes, snid)
    sp := ast_span(nodes, snid)

    if k == nk_comptime_const() or k == nk_comptime_block() {
        return
    }

    if k == nk_var_decl() {
        vsoff := ast_get(nodes, snid, 1)
        vslen := ast_get(nodes, snid, 2)
        is_mut := ast_get(nodes, snid, 3)
        ty_nid := ast_get(nodes, snid, 4)
        init_e := ast_get(nodes, snid, 5)
        init_ty := check_expr_full(pool, nodes, extra, sym, locals, init_e)
        mut final_ty := init_ty
        if ty_nid > 0 {
            ibuf_set(sym, 13, ty_nid)
            decl_ty := resolve_typespec(pool, nodes, extra, sym)
            if ty_tag(init_ty) == 16 and ty_tag(decl_ty) != 16 and ty_tag(decl_ty) != ty_any() {
                sema_record_err(sym, 502, sp)
            } else if not types_compatible(sym, decl_ty, init_ty) {
                sema_record_err(sym, 401, sp)
            }
            final_ty = decl_ty
        }
        if is_cap_type(pool, sym, final_ty) {
            ibuf_set(sym, 12, 1)
        }
        mut fl := 0
        if (is_mut & 1) != 0 { fl = 1 }
        local_push(locals, vsoff, vslen, final_ty | (fl << 40))
        return
    }

    if k == nk_tuple_destruct() {
        noff := ast_get(nodes, snid, 1)
        ncnt := ast_get(nodes, snid, 2)
        init_ty := check_expr_full(pool, nodes, extra, sym, locals, ast_get(nodes, snid, 3))
        mut i := 0
        while i < ncnt {
            ns_off := ibuf_get(extra, noff + i * 2)
            ns_len := ibuf_get(extra, noff + i * 2 + 1)
            mut et := ty_int()
            if ty_tag(init_ty) == 14 {
                doff := ty_pay(init_ty)
                if i < ibuf_get(sym, doff) {
                    et = ibuf_get(sym, doff + 1 + i)
                }
            }
            local_push(locals, ns_off, ns_len, et)
            i += 1
        }
        return
    }

    if k == nk_assign() {
        aop := ast_get(nodes, snid, 1)
        tgt := ast_get(nodes, snid, 2)
        rhs := ast_get(nodes, snid, 3)
        mut root := tgt
        while ast_kind(nodes, root) == nk_field() {
            root = ast_get(nodes, root, 1)
        }
        mut root_lbase := -1
        if ast_kind(nodes, root) == nk_ident() {
            root_lbase = local_find(pool, locals, ast_get(nodes, root, 1), ast_get(nodes, root, 2))
            if root_lbase >= 0 {
                lflags := ibuf_get(locals, root_lbase + 3)
                if (lflags & 1) == 0 {
                    sema_record_err(sym, 301, sp)
                }
            } else {
                sema_record_err(sym, 403, sp)
            }
        }
        // E0204: Enforce `par_for` Data-Race Freedom!
        par_wm := ibuf_get(sym, 24)
        if par_wm > 0 {
            mut idx_root := tgt
            while ast_kind(nodes, idx_root) == nk_field() or ast_kind(nodes, idx_root) == nk_index() {
                idx_root = ast_get(nodes, idx_root, 1)
            }
            if ast_kind(nodes, idx_root) == nk_ident() {
                irlb := local_find(pool, locals, ast_get(nodes, idx_root, 1), ast_get(nodes, idx_root, 2))
                if irlb >= 0 and irlb < par_wm {
                    mut disjoint_ok := false
                    if aop == aop_eq() and ast_kind(nodes, tgt) == nk_index() {
                        idxe := ast_get(nodes, tgt, 2)
                        if ast_kind(nodes, idxe) == nk_ident() {
                            xlb := local_find(pool, locals, ast_get(nodes, idxe, 1), ast_get(nodes, idxe, 2))
                            if xlb == par_wm {
                                disjoint_ok = true
                            }
                        }
                    }
                    if not disjoint_ok {
                        sema_record_err(sym, 204, sp)
                    }
                }
            }
        }
        rhs_ty := check_expr_full(pool, nodes, extra, sym, locals, rhs)
        mut tgt_ty := ty_any()
        if aop == aop_eq() and ast_kind(nodes, tgt) == nk_ident() and root_lbase >= 0 {
            ibuf_set(locals, root_lbase + 4, 0)
            tgt_ty = ibuf_get(locals, root_lbase + 2)
        } else {
            tgt_ty = check_expr_full(pool, nodes, extra, sym, locals, tgt)
        }
        if ty_tag(rhs_ty) == 16 and ty_tag(tgt_ty) != 16 and ty_tag(tgt_ty) != ty_any() {
            sema_record_err(sym, 502, sp)
        } else if not ((aop == aop_mul() or aop == aop_div()) and tgt_ty == ty_dec() and rhs_ty == ty_int()) {
            if not types_compatible(sym, tgt_ty, rhs_ty) {
                sema_record_err(sym, 401, sp)
            }
        }
        return
    }

    if k == nk_if() {
        ct := check_expr_full(pool, nodes, extra, sym, locals, ast_get(nodes, snid, 1))
        if not types_compatible(sym, ty_bool(), ct) {
            sema_record_err(sym, 401, sp)
        }
        tb := ast_get(nodes, snid, 2)
        eb := ast_get(nodes, snid, 3)
        lcnt := ibuf_len(locals) / 6
        snap := ibuf_new(lcnt + 4)
        mut li := 0
        while li < lcnt {
            ibuf_push(snap, ibuf_get(locals, li * 6 + 4))
            li += 1
        }
        check_block_full(pool, nodes, extra, sym, locals, tb)
        t_div := block_diverges(nodes, extra, tb)
        then_moves := ibuf_new(lcnt + 4)
        li = 0
        while li < lcnt {
            ibuf_push(then_moves, ibuf_get(locals, li * 6 + 4))
            ibuf_set(locals, li * 6 + 4, ibuf_get(snap, li))
            li += 1
        }
        if eb > 0 {
            check_block_full(pool, nodes, extra, sym, locals, eb)
            e_div := block_diverges(nodes, extra, eb)
            li = 0
            while li < lcnt {
                tm := ibuf_get(then_moves, li)
                em := ibuf_get(locals, li * 6 + 4)
                if t_div and e_div {
                    ibuf_set(locals, li * 6 + 4, ibuf_get(snap, li))
                } else if t_div {
                    ibuf_set(locals, li * 6 + 4, em)
                } else if e_div {
                    ibuf_set(locals, li * 6 + 4, tm)
                } else {
                    if tm > em { ibuf_set(locals, li * 6 + 4, tm) }
                    else { ibuf_set(locals, li * 6 + 4, em) }
                }
                li += 1
            }
        } else {
            if not t_div {
                li = 0
                while li < lcnt {
                    ibuf_set(locals, li * 6 + 4, ibuf_get(then_moves, li))
                    li += 1
                }
            }
        }
        buf_free(move snap)
        buf_free(move then_moves)
        return
    }

    if k == nk_while() {
        ct := check_expr_full(pool, nodes, extra, sym, locals, ast_get(nodes, snid, 1))
        if not types_compatible(sym, ty_bool(), ct) {
            sema_record_err(sym, 401, sp)
        }
        wbody := ast_get(nodes, snid, 2)
        outer_lcnt := ibuf_len(locals) / 6
        pre_moves := ibuf_new(outer_lcnt + 4)
        mut li := 0
        while li < outer_lcnt {
            ibuf_push(pre_moves, ibuf_get(locals, li * 6 + 4))
            li += 1
        }
        ibuf_set(sym, 14, ibuf_get(sym, 14) + 1)
        check_block_full(pool, nodes, extra, sym, locals, wbody)
        ibuf_set(sym, 14, ibuf_get(sym, 14) - 1)
        if not block_diverges(nodes, extra, wbody) {
            li = 0
            while li < outer_lcnt {
                if ibuf_get(pre_moves, li) == 0 and ibuf_get(locals, li * 6 + 4) > 0 {
                    sema_record_err(sym, 203, ibuf_get(locals, li * 6 + 4))
                }
                li += 1
            }
        }
        buf_free(move pre_moves)
        try_plan_temporal_while_simd(pool, nodes, extra, sym, snid)
        return
    }

    if k == nk_for_range() or k == nk_par_for_range() {
        vsoff := ast_get(nodes, snid, 1)
        vslen := ast_get(nodes, snid, 2)
        st_ty := check_expr_full(pool, nodes, extra, sym, locals, ast_get(nodes, snid, 3))
        en_ty := check_expr_full(pool, nodes, extra, sym, locals, ast_get(nodes, snid, 4))
        if not types_compatible(sym, ty_int(), st_ty) or not types_compatible(sym, ty_int(), en_ty) {
            sema_record_err(sym, 401, sp)
        }
        outer_lcnt := ibuf_len(locals) / 6
        pre_moves := ibuf_new(outer_lcnt + 4)
        mut li := 0
        while li < outer_lcnt {
            ibuf_push(pre_moves, ibuf_get(locals, li * 6 + 4))
            li += 1
        }
        prev_wm := ibuf_get(sym, 24)
        if k == nk_par_for_range() {
            ibuf_set(sym, 24, outer_lcnt * 6)
        }
        local_push(locals, vsoff, vslen, ty_int() | (1 << 40))
        fbody := ast_get(nodes, snid, 5)
        ibuf_set(sym, 14, ibuf_get(sym, 14) + 1)
        check_block_full(pool, nodes, extra, sym, locals, fbody)
        ibuf_set(sym, 14, ibuf_get(sym, 14) - 1)
        ibuf_set(sym, 24, prev_wm)
        ibuf_set(locals, outer_lcnt * 6 + 1, -1)
        if not block_diverges(nodes, extra, fbody) {
            li = 0
            while li < outer_lcnt {
                if ibuf_get(pre_moves, li) == 0 and ibuf_get(locals, li * 6 + 4) > 0 {
                    sema_record_err(sym, 203, ibuf_get(locals, li * 6 + 4))
                }
                li += 1
            }
        }
        buf_free(move pre_moves)
        return
    }

    if k == nk_for_each() or k == nk_par_for_each() {
        vsoff := ast_get(nodes, snid, 1)
        vslen := ast_get(nodes, snid, 2)
        cty := check_expr_full(pool, nodes, extra, sym, locals, ast_get(nodes, snid, 3))
        mut elem_ty := ty_int()
        if ty_tag(cty) == 12 {
            ep := ty_pay(cty)
            if ep == 60001 { elem_ty = ty_float() }
            else if ep == 60002 { elem_ty = ty_int() }
            else { elem_ty = ty_make(10, ep) }
        } else if cty != ty_any() {
            sema_record_err(sym, 401, sp)
        }
        outer_lcnt := ibuf_len(locals) / 6
        pre_moves := ibuf_new(outer_lcnt + 4)
        mut li := 0
        while li < outer_lcnt {
            ibuf_push(pre_moves, ibuf_get(locals, li * 6 + 4))
            li += 1
        }
        prev_wm := ibuf_get(sym, 24)
        if k == nk_par_for_each() {
            ibuf_set(sym, 24, outer_lcnt * 6)
        }
        local_push(locals, vsoff, vslen, elem_ty | (1 << 40))
        fbody := ast_get(nodes, snid, 4)
        ibuf_set(sym, 14, ibuf_get(sym, 14) + 1)
        check_block_full(pool, nodes, extra, sym, locals, fbody)
        ibuf_set(sym, 14, ibuf_get(sym, 14) - 1)
        ibuf_set(sym, 24, prev_wm)
        ibuf_set(locals, outer_lcnt * 6 + 1, -1)
        if not block_diverges(nodes, extra, fbody) {
            li = 0
            while li < outer_lcnt {
                if ibuf_get(pre_moves, li) == 0 and ibuf_get(locals, li * 6 + 4) > 0 {
                    sema_record_err(sym, 203, ibuf_get(locals, li * 6 + 4))
                }
                li += 1
            }
        }
        buf_free(move pre_moves)
        try_plan_foreach_simd(pool, nodes, extra, sym, snid, cty)
        return
    }

    if k == nk_return() {
        rv := ast_get(nodes, snid, 1)
        fn_ret := ibuf_get(sym, 11)
        if rv > 0 {
            rty := check_expr_full(pool, nodes, extra, sym, locals, rv)
            if ty_tag(rty) == 16 and ty_tag(fn_ret) != 16 and ty_tag(fn_ret) != ty_any() {
                sema_record_err(sym, 502, sp)
            } else if fn_ret == ty_unit() or not types_compatible(sym, fn_ret, rty) {
                sema_record_err(sym, 402, sp)
            }
        } else if fn_ret != ty_unit() {
            sema_record_err(sym, 402, sp)
        }
        return
    }

    if k == nk_break() or k == nk_continue() {
        if ibuf_get(sym, 14) <= 0 {
            sema_record_err(sym, 407, sp)
        }
        return
    }

    if k == nk_expr_stmt() {
        check_expr_full(pool, nodes, extra, sym, locals, ast_get(nodes, snid, 1))
    }
}

fn check_block_full(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, locals: IntBuf, bnid: i64) {
    if bnid <= 0 {
        return
    }
    saved_lcnt := ibuf_len(locals) / 6
    off := ast_get(nodes, bnid, 1)
    cnt := ast_get(nodes, bnid, 2)
    mut i := 0
    while i < cnt {
        check_stmt_full(pool, nodes, extra, sym, locals, ibuf_get(extra, off + i))
        i += 1
    }
    end_lcnt := ibuf_len(locals) / 6
    mut li := saved_lcnt
    while li < end_lcnt {
        ibuf_set(locals, li * 6 + 1, -1)
        li += 1
    }
}

// --- Static Perceus Liveness, Loop Self-FBIP In-Place Reuse & Deterministic Drop Planner ---
fn classify_owned_alloc(pool: ByteBuf, nodes: IntBuf, init_nid: i64) -> i64 {
    if init_nid <= 0 {
        return 0
    }
    k := ast_kind(nodes, init_nid)
    if k == nk_table_alloc() {
        return 3
    }
    if k == nk_call() {
        cs := ast_get(nodes, init_nid, 1)
        cl := ast_get(nodes, init_nid, 2)
        if pool_str_eq_lit(pool, cs, cl, "buf_new") { return 1 }
        if pool_str_eq_lit(pool, cs, cl, "ibuf_new") { return 2 }
    }
    return 0
}

fn scan_expr_var_use(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, enid: i64, target_soff: i64, target_slen: i64, in_ret: bool) -> i64 {
    if enid <= 0 {
        return 0
    }
    k := ast_kind(nodes, enid)
    if k == nk_ident() {
        if ast_get(nodes, enid, 2) == target_slen and pool_str_eq2(pool, ast_get(nodes, enid, 1), target_slen, target_soff) {
            if in_ret { return 3 }
            return 1
        }
        return 0
    }
    if k == nk_move_ident() {
        if ast_get(nodes, enid, 2) == target_slen and pool_str_eq2(pool, ast_get(nodes, enid, 1), target_slen, target_soff) {
            return 3
        }
        return 0
    }
    if k == nk_await() or k == nk_comptime_expr() {
        return scan_expr_var_use(pool, nodes, extra, ast_get(nodes, enid, 1), target_soff, target_slen, in_ret)
    }
    if k == nk_unary() or k == nk_cast() {
        mut child := ast_get(nodes, enid, 2)
        if k == nk_cast() { child = ast_get(nodes, enid, 1) }
        return scan_expr_var_use(pool, nodes, extra, child, target_soff, target_slen, in_ret)
    }
    if k == nk_binary() {
        m1 := scan_expr_var_use(pool, nodes, extra, ast_get(nodes, enid, 2), target_soff, target_slen, false)
        m2 := scan_expr_var_use(pool, nodes, extra, ast_get(nodes, enid, 3), target_soff, target_slen, false)
        return m1 | m2
    }
    if k == nk_or_return() {
        m1 := scan_expr_var_use(pool, nodes, extra, ast_get(nodes, enid, 1), target_soff, target_slen, in_ret)
        m2 := scan_expr_var_use(pool, nodes, extra, ast_get(nodes, enid, 2), target_soff, target_slen, true)
        return m1 | m2
    }
    if k == nk_field() or k == nk_tuple_idx() {
        return scan_expr_var_use(pool, nodes, extra, ast_get(nodes, enid, 1), target_soff, target_slen, false)
    }
    if k == nk_index() {
        m1 := scan_expr_var_use(pool, nodes, extra, ast_get(nodes, enid, 1), target_soff, target_slen, false)
        m2 := scan_expr_var_use(pool, nodes, extra, ast_get(nodes, enid, 2), target_soff, target_slen, false)
        return m1 | m2
    }
    if k == nk_table_alloc() {
        return scan_expr_var_use(pool, nodes, extra, ast_get(nodes, enid, 3), target_soff, target_slen, false)
    }
    if k == nk_tuple() or k == nk_fstr() {
        off := ast_get(nodes, enid, 1)
        cnt := ast_get(nodes, enid, 2)
        mut res := 0
        mut i := 0
        while i < cnt {
            res = res | scan_expr_var_use(pool, nodes, extra, ibuf_get(extra, off + i), target_soff, target_slen, in_ret)
            i += 1
        }
        return res
    }
    if k == nk_call() {
        cs := ast_get(nodes, enid, 1)
        cl := ast_get(nodes, enid, 2)
        aoff := ast_get(nodes, enid, 3)
        acnt := ast_get(nodes, enid, 4)
        mut is_ctor := false
        if cl > 0 {
            b0 := buf_get(pool, cs)
            if b0 >= 65 and b0 <= 90 { is_ctor = true }
        }
        if pool_str_eq_lit(pool, cs, cl, "ok") or pool_str_eq_lit(pool, cs, cl, "buf_free") {
            is_ctor = true
        }
        mut res := 0
        mut i := 0
        while i < acnt {
            ca := ibuf_get(extra, aoff + i)
            amode := ast_get(nodes, ca, 1)
            ae := ast_get(nodes, ca, 4)
            mut m := scan_expr_var_use(pool, nodes, extra, ae, target_soff, target_slen, in_ret and is_ctor)
            if (amode == pmode_move() or is_ctor) and (m & 1) != 0 {
                m = m | 2
            }
            res = res | m
            i += 1
        }
        return res
    }
    if k == nk_method_call() {
        mut res := scan_expr_var_use(pool, nodes, extra, ast_get(nodes, enid, 1), target_soff, target_slen, in_ret)
        aoff := ast_get(nodes, enid, 4)
        acnt := ast_get(nodes, enid, 5)
        mut i := 0
        while i < acnt {
            ca := ibuf_get(extra, aoff + i)
            res = res | scan_expr_var_use(pool, nodes, extra, ast_get(nodes, ca, 4), target_soff, target_slen, false)
            i += 1
        }
        return res
    }
    if k == nk_if_expr() {
        mut m := scan_expr_var_use(pool, nodes, extra, ast_get(nodes, enid, 1), target_soff, target_slen, false)
        tb := ast_get(nodes, enid, 2)
        m = m | scan_block_var_use(pool, nodes, extra, tb, target_soff, target_slen)
        m = m | scan_expr_var_use(pool, nodes, extra, ast_get(nodes, tb, 3), target_soff, target_slen, in_ret)
        eb := ast_get(nodes, enid, 3)
        if eb > 0 {
            m = m | scan_block_var_use(pool, nodes, extra, eb, target_soff, target_slen)
            m = m | scan_expr_var_use(pool, nodes, extra, ast_get(nodes, eb, 3), target_soff, target_slen, in_ret)
        }
        return m
    }
    if k == nk_spawn() {
        return scan_block_var_use(pool, nodes, extra, ast_get(nodes, enid, 1), target_soff, target_slen)
    }
    return 0
}

fn scan_stmt_var_use(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, snid: i64, target_soff: i64, target_slen: i64) -> i64 {
    k := ast_kind(nodes, snid)
    if k == nk_var_decl() {
        ie := ast_get(nodes, snid, 5)
        mut m := scan_expr_var_use(pool, nodes, extra, ie, target_soff, target_slen, false)
        if ast_kind(nodes, ie) == nk_ident() and (m & 1) != 0 {
            m = m | 2
        }
        return m
    }
    if k == nk_tuple_destruct() {
        return scan_expr_var_use(pool, nodes, extra, ast_get(nodes, snid, 3), target_soff, target_slen, false)
    }
    if k == nk_assign() {
        rhs_e := ast_get(nodes, snid, 3)
        m1 := scan_expr_var_use(pool, nodes, extra, ast_get(nodes, snid, 2), target_soff, target_slen, false)
        mut m2 := scan_expr_var_use(pool, nodes, extra, rhs_e, target_soff, target_slen, false)
        if ast_kind(nodes, rhs_e) == nk_ident() and (m2 & 1) != 0 {
            m2 = m2 | 2
        }
        return m1 | m2
    }
    if k == nk_if() {
        mut m := scan_expr_var_use(pool, nodes, extra, ast_get(nodes, snid, 1), target_soff, target_slen, false)
        m = m | scan_block_var_use(pool, nodes, extra, ast_get(nodes, snid, 2), target_soff, target_slen)
        eb := ast_get(nodes, snid, 3)
        if eb > 0 {
            m = m | scan_block_var_use(pool, nodes, extra, eb, target_soff, target_slen)
        }
        return m
    }
    if k == nk_while() {
        m1 := scan_expr_var_use(pool, nodes, extra, ast_get(nodes, snid, 1), target_soff, target_slen, false)
        m2 := scan_block_var_use(pool, nodes, extra, ast_get(nodes, snid, 2), target_soff, target_slen)
        return m1 | m2
    }
    if k == nk_for_range() or k == nk_par_for_range() {
        mut m := scan_expr_var_use(pool, nodes, extra, ast_get(nodes, snid, 3), target_soff, target_slen, false)
        m = m | scan_expr_var_use(pool, nodes, extra, ast_get(nodes, snid, 4), target_soff, target_slen, false)
        m = m | scan_block_var_use(pool, nodes, extra, ast_get(nodes, snid, 5), target_soff, target_slen)
        return m
    }
    if k == nk_for_each() or k == nk_par_for_each() {
        m1 := scan_expr_var_use(pool, nodes, extra, ast_get(nodes, snid, 3), target_soff, target_slen, false)
        m2 := scan_block_var_use(pool, nodes, extra, ast_get(nodes, snid, 4), target_soff, target_slen)
        return m1 | m2
    }
    if k == nk_return() {
        return scan_expr_var_use(pool, nodes, extra, ast_get(nodes, snid, 1), target_soff, target_slen, true)
    }
    if k == nk_expr_stmt() {
        return scan_expr_var_use(pool, nodes, extra, ast_get(nodes, snid, 1), target_soff, target_slen, false)
    }
    return 0
}

fn scan_block_var_use(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, bnid: i64, target_soff: i64, target_slen: i64) -> i64 {
    if bnid <= 0 {
        return 0
    }
    off := ast_get(nodes, bnid, 1)
    cnt := ast_get(nodes, bnid, 2)
    mut res := 0
    mut i := 0
    while i < cnt {
        res = res | scan_stmt_var_use(pool, nodes, extra, ibuf_get(extra, off + i), target_soff, target_slen)
        i += 1
    }
    return res
}

fn plan_block_perceus(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, body_nid: i64, in_loop: i64) {
    if body_nid <= 0 {
        return
    }
    st_off := ast_get(nodes, body_nid, 1)
    st_cnt := ast_get(nodes, body_nid, 2)

    owned := ibuf_new(st_cnt * 6 + 16)
    mut i := 0
    while i < st_cnt {
        st := ibuf_get(extra, st_off + i)
        sk := ast_kind(nodes, st)
        if sk == nk_var_decl() {
            ak := classify_owned_alloc(pool, nodes, ast_get(nodes, st, 5))
            if ak > 0 {
                vsoff := ast_get(nodes, st, 1)
                vslen := ast_get(nodes, st, 2)
                mut last_u := i
                mut esc := 0
                mut j := i + 1
                while j < st_cnt {
                    m := scan_stmt_var_use(pool, nodes, extra, ibuf_get(extra, st_off + j), vsoff, vslen)
                    if (m & 1) != 0 { last_u = j }
                    if (m & 2) != 0 { esc = 1 }
                    j += 1
                }
                ibuf_push(owned, i)
                ibuf_push(owned, st)
                ibuf_push(owned, ak)
                ibuf_push(owned, last_u)
                ibuf_push(owned, esc)
                ibuf_push(owned, 0)
            }
        } else if sk == nk_if() {
            plan_block_perceus(pool, nodes, extra, ast_get(nodes, st, 2), in_loop)
            eb := ast_get(nodes, st, 3)
            if eb > 0 {
                plan_block_perceus(pool, nodes, extra, eb, in_loop)
            }
        } else if sk == nk_while() {
            plan_block_perceus(pool, nodes, extra, ast_get(nodes, st, 2), 1)
        } else if sk == nk_for_range() or sk == nk_par_for_range() {
            plan_block_perceus(pool, nodes, extra, ast_get(nodes, st, 5), 1)
        } else if sk == nk_for_each() or sk == nk_par_for_each() {
            plan_block_perceus(pool, nodes, extra, ast_get(nodes, st, 4), 1)
        }
        i += 1
    }

    ocnt := ibuf_len(owned) / 6
    if in_loop == 1 {
        // Loop Self-FBIP Reuse: non-escaping allocations inside loops reuse their own stack slot across iterations!
        mut ni := 0
        while ni < ocnt {
            nb := ni * 6
            if ibuf_get(owned, nb + 4) == 0 {
                nid := ibuf_get(owned, nb + 1)
                ast_set(nodes, nid, 6, (nid << 2) | 1)
            }
            ni += 1
        }
        buf_free(move owned)
        return
    }

    mut ni := 0
    while ni < ocnt {
        nb := ni * 6
        n_stmt := ibuf_get(owned, nb)
        n_nid := ibuf_get(owned, nb + 1)
        n_ak := ibuf_get(owned, nb + 2)
        mut donor_nid := 0

        mut oi := 0
        while oi < ni {
            ob := oi * 6
            if ibuf_get(owned, ob + 2) == n_ak and ibuf_get(owned, ob + 4) == 0 and ibuf_get(owned, ob + 5) == 0 {
                if ibuf_get(owned, ob + 3) < n_stmt {
                    donor_nid = ibuf_get(owned, ob + 1)
                    ibuf_set(owned, ob + 5, 1)
                    break
                }
            }
            oi += 1
        }
        if donor_nid > 0 {
            ast_set(nodes, n_nid, 6, donor_nid << 2)
        }
        ni += 1
    }

    ni = 0
    while ni < ocnt {
        nb := ni * 6
        if ibuf_get(owned, nb + 4) == 0 and ibuf_get(owned, nb + 5) == 0 {
            nid := ibuf_get(owned, nb + 1)
            prev_tag := ast_get(nodes, nid, 6)
            ast_set(nodes, nid, 6, prev_tag | 1)
        }
        ni += 1
    }
    buf_free(move owned)
}

fn remap_simd_plans_in_block(nodes: IntBuf, extra: IntBuf, sym: IntBuf, bnid: i64) {
    if bnid <= 0 {
        return
    }
    off := ast_get(nodes, bnid, 1)
    cnt := ast_get(nodes, bnid, 2)
    mut i := 0
    while i < cnt {
        st := ibuf_get(extra, off + i)
        sk := ast_kind(nodes, st)
        if sk == nk_for_each() or sk == nk_par_for_each() {
            plan_off := ast_get(nodes, st, 5)
            if plan_off > 0 {
                s_idx := ibuf_get(extra, plan_off)
                ops_cnt := ibuf_get(extra, plan_off + 1)
                mut oi := 0
                while oi < ops_cnt {
                    ob := plan_off + 2 + oi * 4
                    okind := ibuf_get(extra, ob)
                    ibuf_set(extra, ob + 1, soa_remap_col(sym, s_idx, ibuf_get(extra, ob + 1)))
                    if okind == 1 or okind == 3 {
                        ibuf_set(extra, ob + 2, soa_remap_col(sym, s_idx, ibuf_get(extra, ob + 2)))
                    }
                    oi += 1
                }
            }
            remap_simd_plans_in_block(nodes, extra, sym, ast_get(nodes, st, 4))
        } else if sk == nk_if() {
            remap_simd_plans_in_block(nodes, extra, sym, ast_get(nodes, st, 2))
            remap_simd_plans_in_block(nodes, extra, sym, ast_get(nodes, st, 3))
        } else if sk == nk_while() {
            remap_simd_plans_in_block(nodes, extra, sym, ast_get(nodes, st, 2))
        } else if sk == nk_for_range() or sk == nk_par_for_range() {
            remap_simd_plans_in_block(nodes, extra, sym, ast_get(nodes, st, 5))
        }
        i += 1
    }
}

// --- Top-Level Semantic, Comptime, Taint, Effect, Perceus & Polyhedral SoA Entry Point ---
fn analyze_semantics_and_perceus(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf) -> bool {
    mut z := 0
    while z < 32 {
        ibuf_push(sym, 0)
        z += 1
    }

    prog := ibuf_get(nodes, 7)
    s_list_off := ast_get(nodes, prog, 3)
    s_cnt := ast_get(nodes, prog, 4)
    i_list_off := ast_get(nodes, prog, 5)
    i_cnt := ast_get(nodes, prog, 6)
    f_list_off := ibuf_get(nodes, 8)
    f_cnt := ibuf_get(nodes, 9)

    s_meta_base := ibuf_len(sym)
    ibuf_set(sym, 3, s_meta_base)
    ibuf_set(sym, 4, s_cnt)
    mut si := 0
    while si < s_cnt {
        snid := ibuf_get(extra, s_list_off + si)
        ibuf_push(sym, ast_get(nodes, snid, 1))
        ibuf_push(sym, ast_get(nodes, snid, 2))
        ibuf_push(sym, 1)
        ibuf_push(sym, 0)
        ibuf_push(sym, ast_get(nodes, snid, 4))
        ibuf_push(sym, snid)
        si += 1
    }

    i_meta_base := ibuf_len(sym)
    ibuf_set(sym, 5, i_meta_base)
    ibuf_set(sym, 6, i_cnt)
    mut ii := 0
    while ii < i_cnt {
        inid := ibuf_get(extra, i_list_off + ii)
        ibuf_push(sym, ast_get(nodes, inid, 1))
        ibuf_push(sym, ast_get(nodes, inid, 2))
        ibuf_push(sym, 2)
        ibuf_push(sym, inid)
        ii += 1
    }

    si = 0
    while si < s_cnt {
        s_off := s_meta_base + si * 6
        snid := ibuf_get(sym, s_off + 5)
        fl_off := ast_get(nodes, snid, 3)
        fl_cnt := ast_get(nodes, snid, 4)
        f_meta_base_s := ibuf_len(sym)
        ibuf_set(sym, s_off + 3, f_meta_base_s)
        mut fi := 0
        while fi < fl_cnt {
            fd := ibuf_get(extra, fl_off + fi)
            ft_nid := ast_get(nodes, fd, 3)
            if typespec_has_ref(nodes, extra, ft_nid) {
                sema_record_err(sym, 101, ast_span(nodes, fd))
            }
            ibuf_push(sym, ast_get(nodes, fd, 1))
            ibuf_push(sym, ast_get(nodes, fd, 2))
            ibuf_push(sym, 0)
            ibuf_push(sym, ty_int())
            fi += 1
        }
        si += 1
    }

    // Pre-register Function Headers & Raw Parameter Names BEFORE `execute_program_comptime`!
    f_meta_base := ibuf_len(sym)
    ibuf_set(sym, 7, f_meta_base)
    ibuf_set(sym, 8, f_cnt)
    mut fni := 0
    while fni < f_cnt {
        fnid := ibuf_get(extra, f_list_off + fni)
        mut z2 := 0
        while z2 < 10 {
            ibuf_push(sym, 0)
            z2 += 1
        }
        ibuf_set(sym, f_meta_base + fni * 10, ast_get(nodes, fnid, 1))
        ibuf_set(sym, f_meta_base + fni * 10 + 1, ast_get(nodes, fnid, 2))
        ibuf_set(sym, f_meta_base + fni * 10 + 2, fnid)
        fni += 1
    }

    fni = 0
    while fni < f_cnt {
        fo := f_meta_base + fni * 10
        fnid := ibuf_get(sym, fo + 2)
        pl_off := ast_get(nodes, fnid, 3)
        pl_cnt := ast_get(nodes, fnid, 4) & 0xFFFF
        flags := ushr64(ast_get(nodes, fnid, 6), 32)
        p_meta_base := ibuf_len(sym)
        mut pi := 0
        while pi < pl_cnt {
            pn := ibuf_get(extra, pl_off + pi)
            ibuf_push(sym, ast_get(nodes, pn, 1))
            ibuf_push(sym, ast_get(nodes, pn, 2))
            ibuf_push(sym, ast_get(nodes, pn, 3))
            ibuf_push(sym, ty_any())
            ibuf_push(sym, 0)
            ibuf_push(sym, ast_get(nodes, pn, 5))
            pi += 1
        }
        ibuf_set(sym, fo + 3, p_meta_base)
        ibuf_set(sym, fo + 4, pl_cnt)
        ibuf_set(sym, fo + 9, flags)
        fni += 1
    }

    // Build O(1) FNV-1a Hash Indexes for Functions (`sym[25], sym[28]`) & Structs (`sym[29], sym[30]`)
    mut fhcap := 32
    while fhcap < f_cnt * 2 + 16 {
        fhcap = fhcap * 2
    }
    fhbase := ibuf_len(sym)
    mut hi := 0
    while hi < fhcap {
        ibuf_push(sym, 0)
        hi += 1
    }
    fhmask := fhcap - 1
    ibuf_set(sym, 25, fhbase)
    ibuf_set(sym, 28, fhmask)
    fni = 0
    while fni < f_cnt {
        fo := f_meta_base + fni * 10
        n_soff := ibuf_get(sym, fo)
        n_slen := ibuf_get(sym, fo + 1)
        mut slot := pool_fnv_slice(pool, n_soff, n_slen) & fhmask
        while true {
            cur := ibuf_get(sym, fhbase + slot)
            if cur == 0 {
                ibuf_set(sym, fhbase + slot, fni + 1)
                break
            }
            co := f_meta_base + (cur - 1) * 10
            if ibuf_get(sym, co + 1) == n_slen and pool_str_eq2(pool, ibuf_get(sym, co), n_slen, n_soff) {
                break
            }
            slot = (slot + 1) & fhmask
        }
        fni += 1
    }

    mut shcap := 16
    while shcap < s_cnt * 2 + 8 {
        shcap = shcap * 2
    }
    shbase := ibuf_len(sym)
    hi = 0
    while hi < shcap {
        ibuf_push(sym, 0)
        hi += 1
    }
    shmask := shcap - 1
    ibuf_set(sym, 29, shbase)
    ibuf_set(sym, 30, shmask)
    si = 0
    while si < s_cnt {
        so := s_meta_base + si * 6
        s_soff := ibuf_get(sym, so)
        s_slen := ibuf_get(sym, so + 1)
        mut slot := pool_fnv_slice(pool, s_soff, s_slen) & shmask
        while true {
            cur := ibuf_get(sym, shbase + slot)
            if cur == 0 {
                ibuf_set(sym, shbase + slot, si + 1)
                break
            }
            co := s_meta_base + (cur - 1) * 6
            if ibuf_get(sym, co + 1) == s_slen and pool_str_eq2(pool, ibuf_get(sym, co), s_slen, s_soff) {
                break
            }
            slot = (slot + 1) & shmask
        }
        si += 1
    }

    // Execute Compile-Time VM (`comptime` constants, LUTs, `comptime_assert`, in-body `comptime` folding)
    execute_program_comptime(pool, nodes, extra, sym)

    // Resolve Struct Layouts (`comptime` constants are now available for `Tensor` shapes!)
    ibuf_set(sym, 27, 0)
    mut pass := 0
    mut max_s_slots := 1
    while pass < 2 {
        max_s_slots = 1
        si = 0
        while si < s_cnt {
            s_off := s_meta_base + si * 6
            snid := ibuf_get(sym, s_off + 5)
            fl_off := ast_get(nodes, snid, 3)
            fl_cnt := ast_get(nodes, snid, 4)
            f_meta_base_s := ibuf_get(sym, s_off + 3)
            mut cur_slot := 0
            mut fi := 0
            while fi < fl_cnt {
                fd := ibuf_get(extra, fl_off + fi)
                ibuf_set(sym, 13, ast_get(nodes, fd, 3))
                fty := resolve_typespec(pool, nodes, extra, sym)
                fo := f_meta_base_s + fi * 4
                ibuf_set(sym, fo + 2, cur_slot)
                ibuf_set(sym, fo + 3, fty)
                cur_slot += type_slots(sym, fty)
                fi += 1
            }
            if cur_slot < 1 { cur_slot = 1 }
            ibuf_set(sym, s_off + 2, cur_slot)
            if cur_slot > max_s_slots {
                max_s_slots = cur_slot
            }
            si += 1
        }
        pass += 1
    }
    if s_cnt > 0 {
        cyc_state := ibuf_new(s_cnt)
        si = 0
        while si < s_cnt { ibuf_push(cyc_state, 0); si += 1 }
        si = 0
        while si < s_cnt {
            if struct_has_value_cycle(sym, si, cyc_state) {
                snid := ibuf_get(sym, s_meta_base + si * 6 + 5)
                sema_record_err(sym, 408, ast_span(nodes, snid))
                break
            }
            si += 1
        }
        buf_free(move cyc_state)
    }
    ibuf_set(sym, 9, max_s_slots)
    ii = 0
    while ii < i_cnt {
        ibuf_set(sym, i_meta_base + ii * 4 + 2, 1 + max_s_slots)
        ii += 1
    }

    // Allocate SoA Dead-Column Elimination metadata tables (`sym[16..19]`)
    abase := ibuf_len(sym)
    ibuf_set(sym, 16, abase)
    si = 0
    while si < s_cnt {
        fc := ibuf_get(sym, s_meta_base + si * 6 + 4)
        if fc < 1 { ibuf_push(sym, 1) } else { ibuf_push(sym, fc) }
        si += 1
    }
    mbase_ptr := ibuf_len(sym)
    ibuf_set(sym, 17, mbase_ptr)
    si = 0
    while si < s_cnt {
        ibuf_push(sym, 0)
        si += 1
    }
    ubase_ptr := ibuf_len(sym)
    ibuf_set(sym, 18, ubase_ptr)
    si = 0
    while si < s_cnt {
        ibuf_push(sym, 0)
        si += 1
    }
    dbase := ibuf_len(sym)
    ibuf_set(sym, 19, dbase)
    si = 0
    while si < s_cnt {
        ibuf_push(sym, 0)
        si += 1
    }
    si = 0
    while si < s_cnt {
        fc := ibuf_get(sym, s_meta_base + si * 6 + 4)
        mp := ibuf_len(sym)
        ibuf_set(sym, mbase_ptr + si, mp)
        mut c := 0
        while c < fc {
            ibuf_push(sym, c)
            c += 1
        }
        up := ibuf_len(sym)
        ibuf_set(sym, ubase_ptr + si, up)
        c = 0
        while c < fc {
            ibuf_push(sym, 0)
            c += 1
        }
        si += 1
    }

    // Resolve Function Parameter & Return Types + ABI Layouts + Enforce E0102 (`&T` return)
    fni = 0
    while fni < f_cnt {
        fo := f_meta_base + fni * 10
        fnid := ibuf_get(sym, fo + 2)
        pl_off := ast_get(nodes, fnid, 3)
        raw_s4 := ast_get(nodes, fnid, 4)
        pl_cnt := raw_s4 & 0xFFFF
        fn_moff := ushr64(raw_s4, 16)
        ibuf_set(sym, 27, fn_moff)
        ret_nid := ast_get(nodes, fnid, 5)
        if typespec_has_ref(nodes, extra, ret_nid) {
            sema_record_err(sym, 102, ast_span(nodes, fnid))
        }
        ibuf_set(sym, 13, ret_nid)
        rty := resolve_typespec(pool, nodes, extra, sym)
        rslots := type_slots(sym, rty)

        p_meta_base := ibuf_get(sym, fo + 3)
        flags := ibuf_get(sym, fo + 9)
        mut arg_off := 0
        mut has_mut := false
        mut pi := 0
        while pi < pl_cnt {
            pn := ibuf_get(extra, pl_off + pi)
            pm := ast_get(nodes, pn, 3)
            ibuf_set(sym, 13, ast_get(nodes, pn, 4))
            pty := resolve_typespec(pool, nodes, extra, sym)
            pslots := type_slots(sym, pty)
            if pm == pmode_mut() {
                has_mut = true
            }
            po := p_meta_base + pi * 6
            ibuf_set(sym, po + 3, pty)
            ibuf_set(sym, po + 4, arg_off)
            arg_off += pslots
            pi += 1
        }
        mut fast_ok := 1
        if has_mut or arg_off > 6 or rslots > 2 or (flags & fnflag_extern()) != 0 {
            fast_ok = 0
        }
        if (flags & fnflag_export()) != 0 and (pl_cnt > 4 or arg_off > 4) {
            fast_ok = 0
        }

        ibuf_set(sym, fo + 5, rty)
        ibuf_set(sym, fo + 6, rslots)
        ibuf_set(sym, fo + 7, arg_off)
        ibuf_set(sym, fo + 8, fast_ok)
        fni += 1
    }
    ibuf_set(sym, 27, 0)

    // Populate 0-Arg Constant-Returning Function Table (`sym[15]`) for Whole-Program Constant Inlining!
    const_fn_base := ibuf_len(sym)
    ibuf_set(sym, 15, const_fn_base)
    fni = 0
    while fni < f_cnt * 3 {
        ibuf_push(sym, 0)
        fni += 1
    }
    fni = 0
    while fni < f_cnt {
        fo := f_meta_base + fni * 10
        fnid := ibuf_get(sym, fo + 2)
        pl_cnt := ibuf_get(sym, fo + 4)
        rty := ibuf_get(sym, fo + 5)
        flags := ibuf_get(sym, fo + 9)
        body_nid := ast_get(nodes, fnid, 6) & 0xFFFFFFFF
        if pl_cnt == 0 and (flags & (fnflag_shield() | fnflag_whitebox() | fnflag_extern() | fnflag_async())) == 0 and body_nid > 0 and not pool_str_eq_lit(pool, ibuf_get(sym, fo), ibuf_get(sym, fo + 1), "main") {
            if ast_get(nodes, body_nid, 2) == 1 {
                st0 := ibuf_get(extra, ast_get(nodes, body_nid, 1))
                if ast_kind(nodes, st0) == nk_return() {
                    rv := ast_get(nodes, st0, 1)
                    if rv > 0 {
                        rk := ast_kind(nodes, rv)
                        if rk == nk_int() or rk == nk_bool() or rk == nk_dec() or rk == nk_float() {
                            ibuf_set(sym, const_fn_base + fni * 3, 1)
                            ibuf_set(sym, const_fn_base + fni * 3 + 1, ast_get(nodes, rv, 1))
                            ibuf_set(sym, const_fn_base + fni * 3 + 2, rty)
                        } else if rk == nk_unary() and ast_get(nodes, rv, 1) == uop_neg() and ast_kind(nodes, ast_get(nodes, rv, 2)) == nk_int() {
                            ibuf_set(sym, const_fn_base + fni * 3, 1)
                            ibuf_set(sym, const_fn_base + fni * 3 + 1, 0 - ast_get(nodes, ast_get(nodes, rv, 2), 1))
                            ibuf_set(sym, const_fn_base + fni * 3 + 2, rty)
                        }
                    }
                }
            }
        }
        fni += 1
    }

    // Function-by-Function Rigorous Type, Ownership, Taint, Data-Race, Return-Path & Perceus Verification
    fni = 0
    while fni < f_cnt {
        fo := f_meta_base + fni * 10
        fnid := ibuf_get(sym, fo + 2)
        rty := ibuf_get(sym, fo + 5)
        flags := ibuf_get(sym, fo + 9)
        body_nid := ast_get(nodes, fnid, 6) & 0xFFFFFFFF
        fn_moff := ushr64(ast_get(nodes, fnid, 4), 16)
        if body_nid > 0 and (flags & fnflag_extern()) == 0 {
            fn_locals := ibuf_new(2048)
            ibuf_set(sym, 10, 0)
            ibuf_set(sym, 11, rty)
            ibuf_set(sym, 12, 0)
            ibuf_set(sym, 14, 0)
            ibuf_set(sym, 22, flags)
            ibuf_set(sym, 23, fni)
            ibuf_set(sym, 24, 0)
            mut is_main := 0
            if pool_str_eq_lit(pool, ibuf_get(sym, fo), ibuf_get(sym, fo + 1), "main") {
                is_main = 1
            }
            ibuf_set(sym, 26, is_main)
            ibuf_set(sym, 27, fn_moff)

            p_base := ibuf_get(sym, fo + 3)
            p_cnt := ibuf_get(sym, fo + 4)
            mut pi := 0
            while pi < p_cnt {
                po := p_base + pi * 6
                pm := ibuf_get(sym, po + 2)
                pty := ibuf_get(sym, po + 3)
                def_nid := ibuf_get(sym, po + 5)
                if def_nid > 0 {
                    dty := check_expr_full(pool, nodes, extra, sym, fn_locals, def_nid)
                    if not types_compatible(sym, pty, dty) {
                        sema_record_err(sym, 401, ast_span(nodes, fnid))
                    }
                }
                if is_cap_type(pool, sym, pty) {
                    ibuf_set(sym, 12, 1)
                }
                mut pfl := 0
                if pm == pmode_mut() { pfl = pfl | 1 }
                if pm == pmode_isolated() or pm == pmode_move() { pfl = pfl | 2 }
                local_push(fn_locals, ibuf_get(sym, po), ibuf_get(sym, po + 1), pty | (pfl << 40))
                pi += 1
            }

            check_block_full(pool, nodes, extra, sym, fn_locals, body_nid)
            if rty != ty_unit() and not block_returns_all_paths(nodes, extra, body_nid) {
                sema_record_err(sym, 405, ast_span(nodes, fnid))
            }
            plan_block_perceus(pool, nodes, extra, body_nid, 0)
            buf_free(move fn_locals)
        }
        fni += 1
    }
    ibuf_set(sym, 27, 0)

    // Finalize SoA Dead-Column Compaction & Remap All `for_each` / `par_for_each` SIMD Plans
    si = 0
    while si < s_cnt {
        fc := ibuf_get(sym, s_meta_base + si * 6 + 4)
        if fc > 0 and ibuf_get(sym, dbase + si) == 0 {
            uptr := ibuf_get(sym, ubase_ptr + si)
            mptr := ibuf_get(sym, mbase_ptr + si)
            mut phys := 0
            mut c := 0
            while c < fc {
                if ibuf_get(sym, uptr + c) == 1 {
                    ibuf_set(sym, mptr + c, phys)
                    phys += 1
                } else {
                    ibuf_set(sym, mptr + c, 0)
                }
                c += 1
            }
            if phys == 0 {
                phys = 1
            }
            ibuf_set(sym, abase + si, phys)
        }
        si += 1
    }

    fni = 0
    while fni < f_cnt {
        fo := f_meta_base + fni * 10
        fnid := ibuf_get(sym, fo + 2)
        body_nid := ast_get(nodes, fnid, 6) & 0xFFFFFFFF
        if body_nid > 0 {
            remap_simd_plans_in_block(nodes, extra, sym, body_nid)
        }
        fni += 1
    }

    // Transitive Call-Graph Verification of `@no_alloc` Functions (`E0601`)
    verify_program_no_alloc(pool, nodes, extra, sym)

    return ibuf_get(sym, 0) == 0
}
