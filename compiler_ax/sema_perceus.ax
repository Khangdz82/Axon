// Axon v7.0 Self-Hosted Compiler - Static Type, Capability, Taint, Perceus FBIP & Polyhedral SoA Verifier
// (`compiler_ax/sema_perceus.ax`) - 100% Pure Axon, Zero GC, Zero `'a` Lifetimes.

use compiler_ax::tokens_ast
use compiler_ax::comptime
use compiler_ax::sema_effects

// `sym` Header Layout (`0..31`):
//   [0] = err_count, [1] = first_err_span, [2] = first_err_code
//   [3] = s_meta_base, [4] = s_cnt
//   [5] = i_meta_base, [6] = i_cnt
//   [7] = f_meta_base, [8] = f_cnt
//   [9] = max_s_slots, [10] = in_spawn, [11] = cur_fn_ret_ty, [12] = has_cap_in_scope
//   [13] = scratch_tnid, [14] = loop_depth
//   [15] = const_fn_base (`3 * f_cnt`: `[is_const, const_val, const_ty]`)
//   [16] = soa_active_cols_base (`s_cnt`), [17] = soa_col_map_ptr_base (`s_cnt`)
//   [18] = soa_used_ptr_base (`s_cnt`), [19] = soa_dyn_base (`s_cnt`)
//   [20] = ct_consts_base, [21] = ct_consts_cnt
//   [22] = cur_fn_flags, [23] = cur_fn_idx
//   [24] = in_par_for_watermark, [25] = fn_hash_base, [26] = cur_fn_is_main, [27] = cur_fn_meta_off
//   [28] = fn_hash_mask, [29] = struct_hash_base, [30] = struct_hash_mask

fn find_struct_idx(pool: ByteBuf, sym: IntBuf, soff: i64, slen: i64) -> i64 {
    return sym_find_struct_idx(pool, sym, soff, slen)
}

fn find_iface_idx(pool: ByteBuf, sym: IntBuf, soff: i64, slen: i64) -> i64 {
    base := ibuf_get(sym, 5)
    cnt := ibuf_get(sym, 6)
    mut i := 0
    while i < cnt {
        off := base + i * 4
        if ibuf_get(sym, off + 1) == slen {
            if pool_str_eq2(pool, ibuf_get(sym, off), slen, soff) {
                return i
            }
        }
        i += 1
    }
    return -1
}

fn find_fn_idx(pool: ByteBuf, sym: IntBuf, soff: i64, slen: i64) -> i64 {
    return sym_find_fn_idx(pool, sym, soff, slen)
}

fn find_struct_method_idx(pool: ByteBuf, sym: IntBuf, sidx: i64, msoff: i64, mslen: i64) -> i64 {
    s_off := ibuf_get(sym, 3) + sidx * 6
    sn_soff := ibuf_get(sym, s_off)
    sn_slen := ibuf_get(sym, s_off + 1)
    want_len := sn_slen + 2 + mslen
    f_base := ibuf_get(sym, 7)
    hbase := ibuf_get(sym, 25)
    if hbase > 0 {
        mut h := pool_fnv_slice(pool, sn_soff, sn_slen)
        h = ((h ^ 95) *% 16777619) & 0xFFFFFFFF
        h = ((h ^ 95) *% 16777619) & 0xFFFFFFFF
        mut j := 0
        while j < mslen {
            h = ((h ^ buf_get(pool, msoff + j)) *% 16777619) & 0xFFFFFFFF
            j += 1
        }
        mask := ibuf_get(sym, 28)
        mut slot := h & mask
        while true {
            v := ibuf_get(sym, hbase + slot)
            if v == 0 {
                return -1
            }
            fi := v - 1
            fo := f_base + fi * 10
            if ibuf_get(sym, fo + 1) == want_len {
                fn_soff := ibuf_get(sym, fo)
                if buf_get(pool, fn_soff + sn_slen) == 95 and buf_get(pool, fn_soff + sn_slen + 1) == 95 {
                    if pool_str_eq2(pool, fn_soff, sn_slen, sn_soff) and pool_str_eq2(pool, fn_soff + sn_slen + 2, mslen, msoff) {
                        return fi
                    }
                }
            }
            slot = (slot + 1) & mask
        }
    }
    f_cnt := ibuf_get(sym, 8)
    mut fi := 0
    while fi < f_cnt {
        fo := f_base + fi * 10
        fn_soff := ibuf_get(sym, fo)
        fn_slen := ibuf_get(sym, fo + 1)
        if fn_slen == want_len {
            if buf_get(pool, fn_soff + sn_slen) == 95 and buf_get(pool, fn_soff + sn_slen + 1) == 95 {
                if pool_str_eq2(pool, fn_soff, sn_slen, sn_soff) and pool_str_eq2(pool, fn_soff + sn_slen + 2, mslen, msoff) {
                    return fi
                }
            }
        }
        fi += 1
    }
    return -1
}

fn find_struct_field(pool: ByteBuf, sym: IntBuf, s_idx: i64, fpacked: i64) -> i64 {
    fsoff := fpacked & 0xFFFFFFFF
    fslen := ushr64(fpacked, 32)
    s_off := ibuf_get(sym, 3) + s_idx * 6
    f_base := ibuf_get(sym, s_off + 3)
    f_cnt := ibuf_get(sym, s_off + 4)
    mut i := 0
    while i < f_cnt {
        foff := f_base + i * 4
        if ibuf_get(sym, foff + 1) == fslen {
            if pool_str_eq2(pool, ibuf_get(sym, foff), fslen, fsoff) {
                return foff
            }
        }
        i += 1
    }
    return -1
}

fn find_struct_col_idx(pool: ByteBuf, sym: IntBuf, s_idx: i64, fpacked: i64) -> i64 {
    fsoff := fpacked & 0xFFFFFFFF
    fslen := ushr64(fpacked, 32)
    s_off := ibuf_get(sym, 3) + s_idx * 6
    f_base := ibuf_get(sym, s_off + 3)
    f_cnt := ibuf_get(sym, s_off + 4)
    mut i := 0
    while i < f_cnt {
        foff := f_base + i * 4
        if ibuf_get(sym, foff + 1) == fslen {
            if pool_str_eq2(pool, ibuf_get(sym, foff), fslen, fsoff) {
                return i
            }
        }
        i += 1
    }
    return -1
}

fn soa_mark_col_used(sym: IntBuf, s_idx: i64, col_idx: i64) {
    s_cnt := ibuf_get(sym, 4)
    if s_idx < 0 or s_idx >= s_cnt {
        return
    }
    ubase_ptr := ibuf_get(sym, 18)
    if ubase_ptr <= 0 {
        return
    }
    s_off := ibuf_get(sym, 3) + s_idx * 6
    f_cnt := ibuf_get(sym, s_off + 4)
    if col_idx >= 0 and col_idx < f_cnt {
        uptr := ibuf_get(sym, ubase_ptr + s_idx)
        ibuf_set(sym, uptr + col_idx, 1)
    }
}

fn soa_mark_dynamic_cols(sym: IntBuf, s_idx: i64) {
    s_cnt := ibuf_get(sym, 4)
    if s_idx < 0 or s_idx >= s_cnt {
        return
    }
    dbase := ibuf_get(sym, 19)
    if dbase > 0 {
        ibuf_set(sym, dbase + s_idx, 1)
    }
}

fn soa_remap_col(sym: IntBuf, s_idx: i64, logical_col: i64) -> i64 {
    s_cnt := ibuf_get(sym, 4)
    if s_idx < 0 or s_idx >= s_cnt {
        return logical_col
    }
    mbase_ptr := ibuf_get(sym, 17)
    if mbase_ptr <= 0 {
        return logical_col
    }
    s_off := ibuf_get(sym, 3) + s_idx * 6
    f_cnt := ibuf_get(sym, s_off + 4)
    if logical_col >= 0 and logical_col < f_cnt {
        mptr := ibuf_get(sym, mbase_ptr + s_idx)
        return ibuf_get(sym, mptr + logical_col)
    }
    return logical_col
}

fn soa_active_col_count(sym: IntBuf, s_idx: i64) -> i64 {
    s_cnt := ibuf_get(sym, 4)
    if s_idx < 0 or s_idx >= s_cnt {
        return 1
    }
    abase := ibuf_get(sym, 16)
    if abase > 0 {
        ac := ibuf_get(sym, abase + s_idx)
        if ac >= 1 {
            return ac
        }
    }
    s_off := ibuf_get(sym, 3) + s_idx * 6
    fc := ibuf_get(sym, s_off + 4)
    if fc < 1 { return 1 }
    return fc
}

// --- Compile-Time Constant Folding & 0-Arg Constant Function Inlining ---
fn is_const_fn_idx(sym: IntBuf, fidx: i64) -> bool {
    cbase := ibuf_get(sym, 15)
    f_cnt := ibuf_get(sym, 8)
    if cbase <= 0 or fidx < 0 or fidx >= f_cnt {
        return false
    }
    return ibuf_get(sym, cbase + fidx * 3) == 1
}

fn const_fn_val(sym: IntBuf, fidx: i64) -> i64 {
    cbase := ibuf_get(sym, 15)
    return ibuf_get(sym, cbase + fidx * 3 + 1)
}

fn const_fn_ty(sym: IntBuf, fidx: i64) -> i64 {
    cbase := ibuf_get(sym, 15)
    return ibuf_get(sym, cbase + fidx * 3 + 2)
}

fn is_const_int_expr(pool: ByteBuf, nodes: IntBuf, sym: IntBuf, enid: i64) -> bool {
    if enid <= 0 {
        return false
    }
    k := ast_kind(nodes, enid)
    if k == nk_int() or k == nk_bool() {
        return true
    }
    if k == nk_ident() {
        goff := ct_find_global_const(pool, sym, ast_get(nodes, enid, 1), ast_get(nodes, enid, 2))
        if goff >= 0 {
            gty := ibuf_get(sym, goff + 2)
            return gty == ty_int() or gty == ty_bool()
        }
        return false
    }
    if k == nk_unary() {
        return is_const_int_expr(pool, nodes, sym, ast_get(nodes, enid, 2))
    }
    if k == nk_call() {
        if ast_get(nodes, enid, 4) != 0 {
            return false
        }
        fidx := find_fn_idx(pool, sym, ast_get(nodes, enid, 1), ast_get(nodes, enid, 2))
        if is_const_fn_idx(sym, fidx) {
            cty := const_fn_ty(sym, fidx)
            return cty == ty_int() or cty == ty_bool()
        }
        return false
    }
    if k == nk_binary() {
        op := ast_get(nodes, enid, 1)
        l := ast_get(nodes, enid, 2)
        r := ast_get(nodes, enid, 3)
        if not is_const_int_expr(pool, nodes, sym, l) or not is_const_int_expr(pool, nodes, sym, r) {
            return false
        }
        if op == op_div() or op == op_mod() {
            return eval_const_int_val(pool, nodes, sym, r) != 0
        }
        if op >= op_add() and op <= op_shr() {
            return true
        }
    }
    return false
}

fn eval_const_int_val(pool: ByteBuf, nodes: IntBuf, sym: IntBuf, enid: i64) -> i64 {
    k := ast_kind(nodes, enid)
    if k == nk_int() or k == nk_bool() {
        return ast_get(nodes, enid, 1)
    }
    if k == nk_ident() {
        goff := ct_find_global_const(pool, sym, ast_get(nodes, enid, 1), ast_get(nodes, enid, 2))
        if goff >= 0 {
            return ibuf_get(sym, goff + 3)
        }
        return 0
    }
    if k == nk_unary() {
        uop := ast_get(nodes, enid, 1)
        v := eval_const_int_val(pool, nodes, sym, ast_get(nodes, enid, 2))
        if uop == uop_neg() {
            return 0 -% v
        }
        if v == 0 { return 1 }
        return 0
    }
    if k == nk_call() {
        fidx := find_fn_idx(pool, sym, ast_get(nodes, enid, 1), ast_get(nodes, enid, 2))
        return const_fn_val(sym, fidx)
    }
    if k == nk_binary() {
        op := ast_get(nodes, enid, 1)
        lv := eval_const_int_val(pool, nodes, sym, ast_get(nodes, enid, 2))
        rv := eval_const_int_val(pool, nodes, sym, ast_get(nodes, enid, 3))
        if op == op_add() or op == op_wrap_add() { return lv +% rv }
        if op == op_sub() or op == op_wrap_sub() { return lv -% rv }
        if op == op_mul() or op == op_wrap_mul() { return lv *% rv }
        if op == op_div() and rv != 0 { return lv / rv }
        if op == op_mod() and rv != 0 { return lv % rv }
        if op == op_bit_and() { return lv & rv }
        if op == op_bit_or() { return lv | rv }
        if op == op_bit_xor() { return lv ^ rv }
        if op == op_shl() { return lv << (rv & 63) }
        if op == op_shr() { return lv >> (rv & 63) }
        if op == op_eq() { if lv == rv { return 1 } else { return 0 } }
        if op == op_neq() { if lv != rv { return 1 } else { return 0 } }
        if op == op_lt() { if lv < rv { return 1 } else { return 0 } }
        if op == op_lte() { if lv <= rv { return 1 } else { return 0 } }
        if op == op_gt() { if lv > rv { return 1 } else { return 0 } }
        if op == op_gte() { if lv >= rv { return 1 } else { return 0 } }
        if op == op_and() { if lv != 0 and rv != 0 { return 1 } else { return 0 } }
        if op == op_or() { if lv != 0 or rv != 0 { return 1 } else { return 0 } }
    }
    return 0
}

fn sema_record_err(sym: IntBuf, code: i64, sp: i64) {
    cnt := ibuf_get(sym, 0)
    if cnt == 0 {
        ibuf_set(sym, 1, sp)
        ibuf_set(sym, 2, code)
    }
    ibuf_set(sym, 0, cnt + 1)
}

fn type_slots(sym: IntBuf, ty: i64) -> i64 {
    tg := ty_tag(ty)
    pay := ty_pay(ty)
    if tg == 5 or tg == 12 or tg == 17 or tg == 18 or tg == 19 or tg == 21 {
        return 2
    }
    if tg == 20 {
        return 8
    }
    if tg == 16 or tg == 22 {
        return type_slots(sym, pay)
    }
    if tg == 10 {
        s_off := ibuf_get(sym, 3) + pay * 6
        sc := ibuf_get(sym, s_off + 2)
        if sc < 1 { return 1 }
        return sc
    }
    if tg == 11 {
        return 1 + ibuf_get(sym, 9)
    }
    if tg == 13 {
        return 1 + type_slots(sym, pay)
    }
    if tg == 14 {
        cnt := ibuf_get(sym, pay)
        mut tot := 0
        mut i := 0
        while i < cnt {
            tot += type_slots(sym, ibuf_get(sym, pay + 1 + i))
            i += 1
        }
        if tot < 1 { return 1 }
        return tot
    }
    return 1
}

fn struct_has_value_cycle(sym: IntBuf, s_idx: i64, state: IntBuf) -> bool {
    if s_idx < 0 or s_idx >= ibuf_len(state) {
        return false
    }
    st := ibuf_get(state, s_idx)
    if st == 1 { return true }
    if st == 2 { return false }
    ibuf_set(state, s_idx, 1)
    s_off := ibuf_get(sym, 3) + s_idx * 6
    fl_cnt := ibuf_get(sym, s_off + 4)
    f_meta_base_s := ibuf_get(sym, s_off + 3)
    mut fi := 0
    while fi < fl_cnt {
        fty := ibuf_get(sym, f_meta_base_s + fi * 4 + 3)
        if type_has_value_cycle(sym, fty, state) {
            ibuf_set(state, s_idx, 0)
            return true
        }
        fi += 1
    }
    ibuf_set(state, s_idx, 2)
    return false
}

fn type_has_value_cycle(sym: IntBuf, ty: i64, state: IntBuf) -> bool {
    tg := ty_tag(ty)
    pay := ty_pay(ty)
    if tg == 10 {
        return struct_has_value_cycle(sym, pay, state)
    }
    if tg == 13 or tg == 16 or tg == 22 {
        return type_has_value_cycle(sym, pay, state)
    }
    if tg == 14 {
        cnt := ibuf_get(sym, pay)
        mut i := 0
        while i < cnt {
            if type_has_value_cycle(sym, ibuf_get(sym, pay + 1 + i), state) {
                return true
            }
            i += 1
        }
    }
    return false
}

fn typespec_has_ref(nodes: IntBuf, extra: IntBuf, tnid: i64) -> bool {
    if tnid <= 0 {
        return false
    }
    k := ast_kind(nodes, tnid)
    if k == nk_ty_ref() {
        return true
    }
    if k == nk_ty_tainted() {
        return typespec_has_ref(nodes, extra, ast_get(nodes, tnid, 1))
    }
    if k == nk_ty_result() {
        return typespec_has_ref(nodes, extra, ast_get(nodes, tnid, 1)) or typespec_has_ref(nodes, extra, ast_get(nodes, tnid, 2))
    }
    if k == nk_ty_refined() {
        return typespec_has_ref(nodes, extra, ast_get(nodes, tnid, 1))
    }
    if k == nk_ty_tuple() {
        off := ast_get(nodes, tnid, 1)
        cnt := ast_get(nodes, tnid, 2)
        mut i := 0
        while i < cnt {
            if typespec_has_ref(nodes, extra, ibuf_get(extra, off + i)) {
                return true
            }
            i += 1
        }
    }
    return false
}

fn resolve_typespec(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf) -> i64 {
    tnid := ibuf_get(sym, 13)
    if tnid <= 0 {
        return ty_unit()
    }
    k := ast_kind(nodes, tnid)
    sp := ast_span(nodes, tnid)
    if k == nk_ty_unit() {
        return ty_unit()
    }
    if k == nk_ty_ref() or k == nk_ty_refined() {
        ibuf_set(sym, 13, ast_get(nodes, tnid, 1))
        return resolve_typespec(pool, nodes, extra, sym)
    }
    if k == nk_ty_tainted() {
        ibuf_set(sym, 13, ast_get(nodes, tnid, 1))
        in_ty := resolve_typespec(pool, nodes, extra, sym)
        return ty_make(16, in_ty)
    }
    if k == nk_ty_tensor() {
        return resolve_tensor_typespec(pool, nodes, extra, sym, tnid)
    }
    if k == nk_ty_result() {
        ibuf_set(sym, 13, ast_get(nodes, tnid, 1))
        ok_t := resolve_typespec(pool, nodes, extra, sym)
        return ty_make(13, ok_t)
    }
    if k == nk_ty_tuple() {
        off := ast_get(nodes, tnid, 1)
        cnt := ast_get(nodes, tnid, 2)
        desc_off := ibuf_len(sym)
        ibuf_push(sym, cnt)
        mut i := 0
        while i < cnt {
            ibuf_push(sym, ty_int())
            i += 1
        }
        i = 0
        while i < cnt {
            ibuf_set(sym, 13, ibuf_get(extra, off + i))
            et := resolve_typespec(pool, nodes, extra, sym)
            ibuf_set(sym, desc_off + 1 + i, et)
            i += 1
        }
        return ty_make(14, desc_off)
    }
    if k == nk_ty_table() {
        esoff := ast_get(nodes, tnid, 1)
        eslen := ast_get(nodes, tnid, 2)
        if pool_str_eq_lit(pool, esoff, eslen, "f32") {
            return ty_make(12, 60001)
        }
        if pool_str_eq_lit(pool, esoff, eslen, "i64") or pool_str_eq_lit(pool, esoff, eslen, "usize") or pool_str_eq_lit(pool, esoff, eslen, "f64") {
            return ty_make(12, 60002)
        }
        sidx := find_struct_idx(pool, sym, esoff, eslen)
        if sidx >= 0 {
            return ty_make(12, sidx)
        }
        sema_record_err(sym, 403, sp)
        return ty_make(12, 0)
    }
    if k == nk_ty_named() {
        soff := ast_get(nodes, tnid, 1)
        slen := ast_get(nodes, tnid, 2)
        if pool_str_eq_lit(pool, soff, slen, "i64") or pool_str_eq_lit(pool, soff, slen, "i32") or pool_str_eq_lit(pool, soff, slen, "i16") or pool_str_eq_lit(pool, soff, slen, "i8") {
            return ty_int()
        }
        if pool_str_eq_lit(pool, soff, slen, "u64") or pool_str_eq_lit(pool, soff, slen, "u32") or pool_str_eq_lit(pool, soff, slen, "u16") or pool_str_eq_lit(pool, soff, slen, "u8") or pool_str_eq_lit(pool, soff, slen, "usize") or pool_str_eq_lit(pool, soff, slen, "isize") or pool_str_eq_lit(pool, soff, slen, "byte") {
            return ty_int()
        }
        if pool_str_eq_lit(pool, soff, slen, "f64") or pool_str_eq_lit(pool, soff, slen, "f32") or pool_str_eq_lit(pool, soff, slen, "f16") or pool_str_eq_lit(pool, soff, slen, "bf16") {
            return ty_float()
        }
        if pool_str_eq_lit(pool, soff, slen, "dec") or pool_str_eq_lit(pool, soff, slen, "dec128") {
            return ty_dec()
        }
        if pool_str_eq_lit(pool, soff, slen, "bool") {
            return ty_bool()
        }
        if pool_str_eq_lit(pool, soff, slen, "str") {
            return ty_str()
        }
        if pool_str_eq_lit(pool, soff, slen, "void") {
            return ty_unit()
        }
        if pool_str_eq_lit(pool, soff, slen, "ByteBuf") {
            return ty_bytebuf()
        }
        if pool_str_eq_lit(pool, soff, slen, "IntBuf") {
            return ty_intbuf()
        }
        if pool_str_eq_lit(pool, soff, slen, "vec3") {
            return ty_vec3()
        }
        if pool_str_eq_lit(pool, soff, slen, "vec4") {
            return ty_vec4()
        }
        if pool_str_eq_lit(pool, soff, slen, "quat") {
            return ty_quat()
        }
        if pool_str_eq_lit(pool, soff, slen, "mat4") {
            return ty_mat4()
        }
        if pool_str_eq_lit(pool, soff, slen, "Any") {
            return ty_any()
        }
        // Check current function generic type parameter `[T]` if active
        moff := ibuf_get(sym, 27)
        if moff > 0 {
            goff := ibuf_get(extra, moff + 7)
            gcnt := ibuf_get(extra, moff + 8)
            mut gi := 0
            while gi < gcnt {
                gb := goff + gi * 4
                if ibuf_get(extra, gb) == 0 and ibuf_get(extra, gb + 2) == slen and pool_str_eq2(pool, ibuf_get(extra, gb + 1), slen, soff) {
                    return ty_any()
                }
                gi += 1
            }
        }
        iidx := find_iface_idx(pool, sym, soff, slen)
        if iidx >= 0 {
            return ty_make(11, iidx)
        }
        sidx := find_struct_idx(pool, sym, soff, slen)
        if sidx >= 0 {
            return ty_make(10, sidx)
        }
        sema_record_err(sym, 403, sp)
    }
    return ty_any()
}

fn types_compatible(sym: IntBuf, expected: i64, actual: i64) -> bool {
    et := ty_tag(expected)
    at := ty_tag(actual)
    if et == ty_any() or at == ty_any() {
        return true
    }
    if expected == actual {
        return true
    }
    if et == 11 and at == 10 {
        return true
    }
    if et == 13 and at == 13 {
        return types_compatible(sym, ty_pay(expected), ty_pay(actual))
    }
    if et == 16 and at == 16 {
        return types_compatible(sym, ty_pay(expected), ty_pay(actual))
    }
    if et == 22 and at == 22 {
        return types_compatible(sym, ty_pay(expected), ty_pay(actual))
    }
    if et == 21 and at == 21 {
        return true
    }
    if et == 14 and at == 14 {
        d1 := ty_pay(expected)
        d2 := ty_pay(actual)
        c1 := ibuf_get(sym, d1)
        c2 := ibuf_get(sym, d2)
        if c1 != c2 {
            return false
        }
        mut i := 0
        while i < c1 {
            if not types_compatible(sym, ibuf_get(sym, d1 + 1 + i), ibuf_get(sym, d2 + 1 + i)) {
                return false
            }
            i += 1
        }
        return true
    }
    return false
}

fn is_cap_type(pool: ByteBuf, sym: IntBuf, ty: i64) -> bool {
    if ty_tag(ty) == 10 {
        sidx := ty_pay(ty)
        soff := ibuf_get(sym, 3) + sidx * 6
        n_off := ibuf_get(sym, soff)
        n_len := ibuf_get(sym, soff + 1)
        if pool_str_eq_lit(pool, n_off, n_len, "RootCap") or pool_str_eq_lit(pool, n_off, n_len, "FsCap") or pool_str_eq_lit(pool, n_off, n_len, "NetCap") {
            return true
        }
    }
    return false
}

// --- Local Variable Scope Table (`locals: IntBuf`, 6 words per local) ---
fn local_find(pool: ByteBuf, locals: IntBuf, soff: i64, slen: i64) -> i64 {
    cnt := ibuf_len(locals) / 6
    mut i := cnt - 1
    while i >= 0 {
        base := i * 6
        if ibuf_get(locals, base + 1) == slen {
            if pool_str_eq2(pool, ibuf_get(locals, base), slen, soff) {
                return base
            }
        }
        i -= 1
    }
    return -1
}

fn local_push(locals: IntBuf, soff: i64, slen: i64, ty_and_flags: i64) {
    ibuf_push(locals, soff)
    ibuf_push(locals, slen)
    ibuf_push(locals, ty_and_flags & 0xFFFFFFFFFF)
    ibuf_push(locals, ushr64(ty_and_flags, 40))
    ibuf_push(locals, 0)
    ibuf_push(locals, 0)
}

fn substitute_tensor_ret_ty(pool: ByteBuf, sym: IntBuf, ret_ty: i64, sym_bindings: IntBuf) -> i64 {
    if ty_tag(ret_ty) != 21 or ibuf_len(sym_bindings) == 0 {
        return ret_ty
    }
    r_desc := ty_pay(ret_ty)
    dt := ibuf_get(sym, r_desc)
    rk := ibuf_get(sym, r_desc + 1)
    tp := ibuf_get(sym, r_desc + 2)
    bcnt := ibuf_len(sym_bindings) / 4

    new_desc := ibuf_len(sym)
    ibuf_push(sym, dt)
    ibuf_push(sym, rk)
    ibuf_push(sym, tp)
    mut d := 0
    while d < rk {
        mut dk := ibuf_get(sym, r_desc + 3 + d * 2)
        mut dv := ibuf_get(sym, r_desc + 3 + d * 2 + 1)
        if dk > 0 {
            mut bi := 0
            while bi < bcnt {
                bb := bi * 4
                if ibuf_get(sym, r_desc + 3 + d * 2) == ibuf_get(sym_bindings, bb) and pool_str_eq2(pool, dv, dk, ibuf_get(sym_bindings, bb + 1)) {
                    dk = ibuf_get(sym_bindings, bb + 2)
                    dv = ibuf_get(sym_bindings, bb + 3)
                    break
                }
                bi += 1
            }
        }
        ibuf_push(sym, dk)
        ibuf_push(sym, dv)
        d += 1
    }
    return ty_make(21, new_desc)
}

// Verifies function or method call arguments: arity, named params, `mut`/`move` modes, taint, symbolic shapes, and types.
// Returns the resolved return type of `fidx` (with symbolic tensor dimensions substituted if applicable).
fn verify_fn_call_sig(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, locals: IntBuf, fidx: i64, param_start: i64, aoff: i64, acnt: i64, arg_tys: IntBuf, sp: i64) -> i64 {
    f_off := ibuf_get(sym, 7) + fidx * 10
    p_base := ibuf_get(sym, f_off + 3)
    p_cnt := ibuf_get(sym, f_off + 4)
    raw_ret := ibuf_get(sym, f_off + 5)
    avail_params := p_cnt - param_start
    if acnt > avail_params {
        sema_record_err(sym, 404, sp)
        return raw_ret
    }

    // Verify every named argument corresponds to a real parameter name
    mut ai := 0
    while ai < acnt {
        ca := ibuf_get(extra, aoff + ai)
        an_soff := ast_get(nodes, ca, 2)
        an_slen := ast_get(nodes, ca, 3)
        if an_soff >= 0 {
            mut found_nm := false
            mut pi := param_start
            while pi < p_cnt {
                po := p_base + pi * 6
                if ibuf_get(sym, po + 1) == an_slen and pool_str_eq2(pool, ibuf_get(sym, po), an_slen, an_soff) {
                    found_nm = true
                    break
                }
                pi += 1
            }
            if not found_nm {
                sema_record_err(sym, 404, sp)
                return raw_ret
            }
        }
        ai += 1
    }

    sym_bindings := ibuf_new(32)

    // Verify each formal parameter gets a valid argument (or has a default value)
    mut pi := param_start
    while pi < p_cnt {
        po := p_base + pi * 6
        pn_soff := ibuf_get(sym, po)
        pn_slen := ibuf_get(sym, po + 1)
        p_mode := ibuf_get(sym, po + 2)
        p_ty := ibuf_get(sym, po + 3)
        def_nid := ibuf_get(sym, po + 5)

        mut matched_idx := -1
        ai = 0
        while ai < acnt {
            ca := ibuf_get(extra, aoff + ai)
            an_soff := ast_get(nodes, ca, 2)
            an_slen := ast_get(nodes, ca, 3)
            if an_soff >= 0 and an_slen == pn_slen and pool_str_eq2(pool, an_soff, pn_slen, pn_soff) {
                matched_idx = ai
                break
            }
            ai += 1
        }
        pos_idx := pi - param_start
        if matched_idx < 0 and pos_idx < acnt {
            cand := ibuf_get(extra, aoff + pos_idx)
            if ast_get(nodes, cand, 2) < 0 {
                matched_idx = pos_idx
            }
        }

        if matched_idx >= 0 {
            ca := ibuf_get(extra, aoff + matched_idx)
            amode := ast_get(nodes, ca, 1)
            aexpr := ast_get(nodes, ca, 4)
            aty := ibuf_get(arg_tys, matched_idx)
            if p_mode == pmode_mut() {
                if amode != pmode_mut() {
                    sema_record_err(sym, 404, sp)
                } else {
                    mut root := aexpr
                    while ast_kind(nodes, root) == nk_field() {
                        root = ast_get(nodes, root, 1)
                    }
                    if ast_kind(nodes, root) == nk_ident() {
                        rlb := local_find(pool, locals, ast_get(nodes, root, 1), ast_get(nodes, root, 2))
                        if rlb >= 0 {
                            if (ibuf_get(locals, rlb + 3) & 3) == 0 {
                                sema_record_err(sym, 301, sp)
                            }
                            par_wm := ibuf_get(sym, 24)
                            if par_wm > 0 and rlb < par_wm {
                                sema_record_err(sym, 204, sp)
                            }
                        }
                    }
                }
            }
            if p_mode == pmode_move() {
                if amode != pmode_move() and ast_kind(nodes, aexpr) == nk_ident() {
                    sema_record_err(sym, 404, sp)
                }
            }
            // E0502: Passing `tainted[T]` to untainted `T` parameter!
            if ty_tag(aty) == 16 and ty_tag(p_ty) != 16 and ty_tag(p_ty) != ty_any() {
                sema_record_err(sym, 502, sp)
            } else if ty_tag(p_ty) == 21 and ty_tag(aty) == 21 {
                if not unify_tensor_shapes(pool, sym, p_ty, aty, sym_bindings) {
                    sema_record_err(sym, 602, sp)
                }
            } else if not types_compatible(sym, p_ty, aty) {
                sema_record_err(sym, 401, sp)
            }
        } else if def_nid <= 0 {
            sema_record_err(sym, 404, sp)
        }
        pi += 1
    }

    final_ret := substitute_tensor_ret_ty(pool, sym, raw_ret, sym_bindings)
    buf_free(move sym_bindings)
    if (ibuf_get(sym, f_off + 9) & fnflag_async()) != 0 {
        return ty_make(22, final_ret)
    }
    return final_ret
}

fn check_expr_full(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, locals: IntBuf, enid: i64) -> i64 {
    if enid <= 0 {
        return ty_unit()
    }
    k := ast_kind(nodes, enid)
    sp := ast_span(nodes, enid)

    if k == nk_int() { return ty_int() }
    if k == nk_float() { return ty_float() }
    if k == nk_dec() { return ty_dec() }
    if k == nk_bool() { return ty_bool() }
    if k == nk_str() or k == nk_secret_str() { return ty_str() }

    if k == nk_fstr() {
        off := ast_get(nodes, enid, 1)
        cnt := ast_get(nodes, enid, 2)
        mut any_tainted := false
        mut i := 0
        while i < cnt {
            sub_t := check_expr_full(pool, nodes, extra, sym, locals, ibuf_get(extra, off + i))
            if ty_tag(sub_t) == 16 {
                any_tainted = true
            }
            i += 1
        }
        if any_tainted {
            return ty_make(16, ty_str())
        }
        return ty_str()
    }

    if k == nk_await() {
        if (ibuf_get(sym, 22) & fnflag_async()) == 0 and ibuf_get(sym, 26) == 0 {
            sema_record_err(sym, 605, sp)
        }
        it := check_expr_full(pool, nodes, extra, sym, locals, ast_get(nodes, enid, 1))
        if ty_tag(it) == 22 or ty_tag(it) == 15 {
            return ty_pay(it)
        }
        return it
    }

    if k == nk_ident() {
        soff := ast_get(nodes, enid, 1)
        slen := ast_get(nodes, enid, 2)
        lbase := local_find(pool, locals, soff, slen)
        if lbase >= 0 {
            if ibuf_get(locals, lbase + 4) > 0 {
                sema_record_err(sym, 201, sp)
            }
            lflags := ibuf_get(locals, lbase + 3)
            if ibuf_get(sym, 10) == 1 and (lflags & 4) != 0 and (lflags & 2) != 0 and ibuf_get(locals, lbase + 5) == 0 {
                sema_record_err(sym, 202, sp)
            }
            return ibuf_get(locals, lbase + 2)
        }
        // Global `comptime` / `@cImport` `#define` constant lookup!
        goff := ct_find_global_const(pool, sym, soff, slen)
        if goff >= 0 {
            return ibuf_get(sym, goff + 2)
        }
        // Function-level `[sym B, comptime D: usize]` constant/symbolic dimension lookup!
        moff := ibuf_get(sym, 27)
        if moff > 0 {
            gen_off := ibuf_get(extra, moff + 7)
            gen_cnt := ibuf_get(extra, moff + 8)
            mut gi := 0
            while gi < gen_cnt {
                gb := gen_off + gi * 4
                if ibuf_get(extra, gb) >= 1 and ibuf_get(extra, gb + 2) == slen and pool_str_eq2(pool, ibuf_get(extra, gb + 1), slen, soff) {
                    return ty_int()
                }
                gi += 1
            }
        }
        sema_record_err(sym, 403, sp)
        return ty_any()
    }

    if k == nk_move_ident() {
        soff := ast_get(nodes, enid, 1)
        slen := ast_get(nodes, enid, 2)
        lbase := local_find(pool, locals, soff, slen)
        if lbase >= 0 {
            if ibuf_get(locals, lbase + 4) > 0 {
                sema_record_err(sym, 201, sp)
            } else {
                ibuf_set(locals, lbase + 4, sp)
            }
            if ibuf_get(sym, 10) == 1 {
                ibuf_set(locals, lbase + 5, 1)
            }
            return ibuf_get(locals, lbase + 2)
        }
        sema_record_err(sym, 403, sp)
        return ty_any()
    }

    if k == nk_tuple() {
        off := ast_get(nodes, enid, 1)
        cnt := ast_get(nodes, enid, 2)
        desc_off := ibuf_len(sym)
        ibuf_push(sym, cnt)
        mut i := 0
        while i < cnt {
            ibuf_push(sym, ty_int())
            i += 1
        }
        i = 0
        while i < cnt {
            et := check_expr_full(pool, nodes, extra, sym, locals, ibuf_get(extra, off + i))
            ibuf_set(sym, desc_off + 1 + i, et)
            i += 1
        }
        return ty_make(14, desc_off)
    }

    if k == nk_unary() {
        uop := ast_get(nodes, enid, 1)
        it := check_expr_full(pool, nodes, extra, sym, locals, ast_get(nodes, enid, 2))
        if uop == uop_not() {
            return ty_bool()
        }
        return it
    }

    if k == nk_binary() {
        op := ast_get(nodes, enid, 1)
        lhs := ast_get(nodes, enid, 2)
        rhs := ast_get(nodes, enid, 3)
        lt := check_expr_full(pool, nodes, extra, sym, locals, lhs)
        rt := check_expr_full(pool, nodes, extra, sym, locals, rhs)

        // E0406: Compile-time constant division or modulo by zero!
        if op == op_div() or op == op_mod() {
            if is_const_int_expr(pool, nodes, sym, rhs) and eval_const_int_val(pool, nodes, sym, rhs) == 0 {
                sema_record_err(sym, 406, sp)
            }
            rk := ast_kind(nodes, rhs)
            if (rk == nk_float() or rk == nk_dec()) and ast_get(nodes, rhs, 1) == 0 {
                sema_record_err(sym, 406, sp)
            }
        }

        if op == op_or() {
            if ty_tag(lt) == 13 {
                ok_t := ty_pay(lt)
                if not types_compatible(sym, ok_t, rt) {
                    sema_record_err(sym, 401, sp)
                }
                return ok_t
            }
            return ty_bool()
        }
        if op >= op_eq() and op <= op_and() {
            return ty_bool()
        }
        // SIMD 3D Math operator types (`vec3`, `vec4`, `quat`, `mat4`)
        if lt == ty_mat4() and rt == ty_mat4() and op == op_mul() { return ty_mat4() }
        if lt == ty_mat4() and rt == ty_vec4() and op == op_mul() { return ty_vec4() }
        if lt == ty_quat() and rt == ty_quat() and op == op_mul() { return ty_quat() }
        if lt == ty_vec3() or rt == ty_vec3() { return ty_vec3() }
        if lt == ty_vec4() or rt == ty_vec4() { return ty_vec4() }

        // Taint propagation across `+`
        if ty_tag(lt) == 16 or ty_tag(rt) == 16 {
            return ty_make(16, ty_str())
        }
        if lt == ty_str() and rt == ty_str() and op == op_add() {
            return ty_str()
        }
        if lt == ty_dec() or rt == ty_dec() { return ty_dec() }
        if lt == ty_float() or rt == ty_float() { return ty_float() }
        return ty_int()
    }

    if k == nk_or_return() {
        lt := check_expr_full(pool, nodes, extra, sym, locals, ast_get(nodes, enid, 1))
        rv := ast_get(nodes, enid, 2)
        if rv > 0 {
            rv_ty := check_expr_full(pool, nodes, extra, sym, locals, rv)
            fn_ret := ibuf_get(sym, 11)
            if fn_ret != ty_unit() and not types_compatible(sym, fn_ret, rv_ty) {
                sema_record_err(sym, 402, sp)
            }
        }
        if ty_tag(lt) == 13 {
            return ty_pay(lt)
        }
        return lt
    }

    if k == nk_cast() {
        check_expr_full(pool, nodes, extra, sym, locals, ast_get(nodes, enid, 1))
        ibuf_set(sym, 13, ast_get(nodes, enid, 2))
        return resolve_typespec(pool, nodes, extra, sym)
    }

    if k == nk_field() {
        bt := check_expr_full(pool, nodes, extra, sym, locals, ast_get(nodes, enid, 1))
        fsoff := ast_get(nodes, enid, 2)
        fslen := ast_get(nodes, enid, 3)
        if pool_str_eq_lit(pool, fsoff, fslen, "len") and (ty_tag(bt) == 5 or ty_tag(bt) == 12 or ty_tag(bt) == 21 or bt == ty_any()) {
            return ty_int()
        }
        if bt == ty_vec3() or bt == ty_vec4() or bt == ty_quat() {
            if pool_str_eq_lit(pool, fsoff, fslen, "x") or pool_str_eq_lit(pool, fsoff, fslen, "y") or pool_str_eq_lit(pool, fsoff, fslen, "z") {
                return ty_float()
            }
            if (bt == ty_vec4() or bt == ty_quat()) and pool_str_eq_lit(pool, fsoff, fslen, "w") {
                return ty_float()
            }
            sema_record_err(sym, 403, sp)
            return ty_any()
        }
        if ty_tag(bt) == 10 {
            foff := find_struct_field(pool, sym, ty_pay(bt), fsoff | (fslen << 32))
            if foff >= 0 {
                return ibuf_get(sym, foff + 3)
            }
            sema_record_err(sym, 403, sp)
            return ty_any()
        }
        if bt != ty_any() {
            sema_record_err(sym, 403, sp)
        }
        return ty_any()
    }

    if k == nk_tuple_idx() {
        bt := check_expr_full(pool, nodes, extra, sym, locals, ast_get(nodes, enid, 1))
        idx := ast_get(nodes, enid, 2)
        if ty_tag(bt) == 14 {
            doff := ty_pay(bt)
            cnt := ibuf_get(sym, doff)
            if idx >= 0 and idx < cnt {
                return ibuf_get(sym, doff + 1 + idx)
            }
            sema_record_err(sym, 404, sp)
            return ty_any()
        }
        if bt != ty_any() {
            sema_record_err(sym, 403, sp)
        }
        return ty_int()
    }

    if k == nk_index() {
        bt := check_expr_full(pool, nodes, extra, sym, locals, ast_get(nodes, enid, 1))
        it := check_expr_full(pool, nodes, extra, sym, locals, ast_get(nodes, enid, 2))
        if not types_compatible(sym, ty_int(), it) {
            sema_record_err(sym, 401, sp)
        }
        if (ty_tag(bt) == 12 and ty_pay(bt) == 60001) or ty_tag(bt) == 21 {
            return ty_float()
        }
        return ty_int()
    }

    if k == nk_table_alloc() {
        esoff := ast_get(nodes, enid, 1)
        eslen := ast_get(nodes, enid, 2)
        cap_ty := check_expr_full(pool, nodes, extra, sym, locals, ast_get(nodes, enid, 3))
        if not types_compatible(sym, ty_int(), cap_ty) {
            sema_record_err(sym, 401, sp)
        }
        if pool_str_eq_lit(pool, esoff, eslen, "f32") {
            return ty_make(12, 60001)
        }
        if pool_str_eq_lit(pool, esoff, eslen, "i64") or pool_str_eq_lit(pool, esoff, eslen, "usize") or pool_str_eq_lit(pool, esoff, eslen, "f64") {
            return ty_make(12, 60002)
        }
        sidx := find_struct_idx(pool, sym, esoff, eslen)
        if sidx >= 0 {
            return ty_make(12, sidx)
        }
        sema_record_err(sym, 403, sp)
        return ty_make(12, 0)
    }

    if k == nk_spawn() {
        prev_spawn := ibuf_get(sym, 10)
        lcnt := ibuf_len(locals) / 6
        mut i := 0
        while i < lcnt {
            fl := ibuf_get(locals, i * 6 + 3)
            ibuf_set(locals, i * 6 + 3, fl | 4)
            i += 1
        }
        ibuf_set(sym, 10, 1)
        blk := ast_get(nodes, enid, 1)
        b_off := ast_get(nodes, blk, 1)
        b_cnt := ast_get(nodes, blk, 2)
        mut ret_inner := ty_int()
        i = 0
        while i < b_cnt {
            st := ibuf_get(extra, b_off + i)
            if ast_kind(nodes, st) == nk_return() {
                rv := ast_get(nodes, st, 1)
                if rv > 0 {
                    ret_inner = check_expr_full(pool, nodes, extra, sym, locals, rv)
                }
            } else {
                check_stmt_full(pool, nodes, extra, sym, locals, st)
            }
            i += 1
        }
        ibuf_set(sym, 10, prev_spawn)
        return ty_make(15, ret_inner)
    }

    if k == nk_if_expr() {
        ct := check_expr_full(pool, nodes, extra, sym, locals, ast_get(nodes, enid, 1))
        if not types_compatible(sym, ty_bool(), ct) {
            sema_record_err(sym, 401, sp)
        }
        tb := ast_get(nodes, enid, 2)
        check_block_full(pool, nodes, extra, sym, locals, tb)
        tt := check_expr_full(pool, nodes, extra, sym, locals, ast_get(nodes, tb, 3))
        eb := ast_get(nodes, enid, 3)
        if eb > 0 {
            check_block_full(pool, nodes, extra, sym, locals, eb)
            et := check_expr_full(pool, nodes, extra, sym, locals, ast_get(nodes, eb, 3))
            if not types_compatible(sym, tt, et) {
                sema_record_err(sym, 401, sp)
            }
        }
        return tt
    }

    if k == nk_method_call() {
        rt := check_expr_full(pool, nodes, extra, sym, locals, ast_get(nodes, enid, 1))
        msoff := ast_get(nodes, enid, 2)
        mslen := ast_get(nodes, enid, 3)
        aoff := ast_get(nodes, enid, 4)
        acnt := ast_get(nodes, enid, 5)
        arg_tys := ibuf_new(16)
        mut i := 0
        while i < acnt {
            ca := ibuf_get(extra, aoff + i)
            ibuf_push(arg_tys, check_call_arg_node(pool, nodes, extra, sym, locals, ca))
            i += 1
        }
        if pool_str_eq_lit(pool, msoff, mslen, "join") and (ty_tag(rt) == 15 or ty_tag(rt) == 22) {
            if acnt != 0 {
                sema_record_err(sym, 404, sp)
            }
            buf_free(move arg_tys)
            return ty_pay(rt)
        }
        if ty_tag(rt) == 10 {
            mf := find_struct_method_idx(pool, sym, ty_pay(rt), msoff, mslen)
            if mf >= 0 {
                mret := verify_fn_call_sig(pool, nodes, extra, sym, locals, mf, 1, aoff, acnt, arg_tys, sp)
                buf_free(move arg_tys)
                return mret
            }
            sema_record_err(sym, 403, sp)
            buf_free(move arg_tys)
            return ty_any()
        }
        if ty_tag(rt) == 11 {
            f_base := ibuf_get(sym, 7)
            f_cnt := ibuf_get(sym, 8)
            mut fi := 0
            while fi < f_cnt {
                fo := f_base + fi * 10
                fn_off := ibuf_get(sym, fo)
                fn_len := ibuf_get(sym, fo + 1)
                if fn_len > mslen + 2 {
                    tail_off := fn_off + fn_len - mslen
                    if buf_get(pool, tail_off - 1) == 95 and buf_get(pool, tail_off - 2) == 95 {
                        if pool_str_eq2(pool, tail_off, mslen, msoff) {
                            iret := verify_fn_call_sig(pool, nodes, extra, sym, locals, fi, 1, aoff, acnt, arg_tys, sp)
                            buf_free(move arg_tys)
                            return iret
                        }
                    }
                }
                fi += 1
            }
            sema_record_err(sym, 403, sp)
            buf_free(move arg_tys)
            return ty_any()
        }
