// Axon v7.0 Self-Hosted Compiler - Direct Multi-OS x86_64 + 3-Tier CPUID SIMD + Polyhedral + Multi-Core Codegen
// (`compiler_ax/codegen_x86_64.ax`) - 100% Pure Axon, Zero LLVM/Clang/GCC/Rustc.
// Emits Intel CET (`ENDBR64`), 4 KB Guard-Page Stack Probes, Zeroed Frames, Perceus Loop Self-FBIP,
// Dead-Column SoA Compaction, Runtime CPUID (`SSE2` / `AVX2+FMA3` / `AVX-512F EVEX`), Multi-Core `par_for`,
// Symbolic Tensor Binding `[sym B, sym S, comptime D]`, `@nan_guard`, C-ABI `.dll`/`.pyd` Exports & COFF Linking.

use compiler_ax::tokens_ast
use compiler_ax::comptime
use compiler_ax::sema_perceus
use compiler_ax::linker_pe
use compiler_ax::linker_unix_bare
use compiler_ax::codegen_runtime
use compiler_ax::codegen_calls

// Packed LValue layout: `(base_slot << 44) | (sub_off << 32) | (lval_ty & 0xFFFFFFFF)`
fn resolve_lval_ax(cg: CodegenCtx, vars: IntBuf, expr_nid: i64) -> i64 {
    if expr_nid <= 0 {
        return 0
    }
    k := ast_kind(cg.nodes, expr_nid)
    if k == nk_ident() {
        soff := ast_get(cg.nodes, expr_nid, 1)
        slen := ast_get(cg.nodes, expr_nid, 2)
        vb := cg_var_find(cg.pool, vars, soff, slen)
        if vb < 0 {
            return 0
        }
        vslot := ibuf_get(vars, vb + 2)
        vty := ibuf_get(vars, vb + 3)
        return (vslot << 44) | (vty & 0xFFFFFFFF)
    }
    if k == nk_field() {
        blv := resolve_lval_ax(cg, vars, ast_get(cg.nodes, expr_nid, 1))
        if blv == 0 {
            return 0
        }
        bslot := ushr64(blv, 44)
        boff := (ushr64(blv, 32)) & 0xFFF
        bty := blv & 0xFFFFFFFF
        if ty_tag(bty) == 10 {
            fsoff := ast_get(cg.nodes, expr_nid, 2)
            fslen := ast_get(cg.nodes, expr_nid, 3)
            fo := find_struct_field(cg.pool, cg.sym, ty_pay(bty), fsoff | (fslen << 32))
            if fo >= 0 {
                f_slot_off := ibuf_get(cg.sym, fo + 2)
                f_ty := ibuf_get(cg.sym, fo + 3)
                return (bslot << 44) | ((boff + f_slot_off) << 32) | (f_ty & 0xFFFFFFFF)
            }
        }
        return 0
    }
    if k == nk_tuple_idx() {
        blv := resolve_lval_ax(cg, vars, ast_get(cg.nodes, expr_nid, 1))
        if blv == 0 {
            return 0
        }
        bslot := ushr64(blv, 44)
        boff := (ushr64(blv, 32)) & 0xFFF
        bty := blv & 0xFFFFFFFF
        target_idx := ast_get(cg.nodes, expr_nid, 2)
        if ty_tag(bty) == 14 {
            doff := ty_pay(bty)
            cnt := ibuf_get(cg.sym, doff)
            mut off := 0
            mut i := 0
            while i < cnt {
                et := ibuf_get(cg.sym, doff + 1 + i)
                if i == target_idx {
                    return (bslot << 44) | ((boff + off) << 32) | (et & 0xFFFFFFFF)
                }
                off += type_slots(cg.sym, et)
                i += 1
            }
        }
        return 0
    }
    return 0
}

// Interns a `comptime` `IntBuf` or `ByteBuf` constant (`goff` in `cg.sym`) into `.rdata` as a zero-alloc buffer!
fn cg_intern_ct_lut(cg: CodegenCtx, goff: i64) -> i64 {
    icnt := ibuf_len(cg.interns) / 4
    mut i := 0
    while i < icnt {
        base := i * 4
        if ibuf_get(cg.interns, base) == 4 and ibuf_get(cg.interns, base + 1) == goff {
            return ibuf_get(cg.interns, base + 3)
        }
        i += 1
    }
    while (buf_len(cg.rdata) & 7) != 0 {
        buf_push(cg.rdata, 0)
    }
    roff := buf_len(cg.rdata)
    rty := ibuf_get(cg.sym, goff + 2)
    elen := ibuf_get(cg.sym, goff + 3)
    lut_off := ibuf_get(cg.sym, goff + 5)
    buf_push_u64(cg.rdata, elen)
    buf_push_u64(cg.rdata, elen)
    if rty == ty_intbuf() {
        mut k := 0
        while k < elen {
            buf_push_u64(cg.rdata, ibuf_get(cg.sym, lut_off + k))
            k += 1
        }
    } else {
        mut k := 0
        while k < elen {
            buf_push(cg.rdata, buf_get(cg.pool, lut_off + k))
            k += 1
        }
        buf_push(cg.rdata, 0)
    }
    ibuf_push(cg.interns, 4)
    ibuf_push(cg.interns, goff)
    ibuf_push(cg.interns, 0)
    ibuf_push(cg.interns, roff)
    return roff
}

fn emit_bounds_check_ax(cg: CodegenCtx, idx_slot: i64, tbl_slot: i64, idx_nid: i64) {
    if ast_kind(cg.nodes, idx_nid) == nk_ident() {
        el_slen := ibuf_get(cg.state, 13)
        if el_slen > 0 and ast_get(cg.nodes, idx_nid, 2) == el_slen {
            if pool_str_eq2(cg.pool, ast_get(cg.nodes, idx_nid, 1), el_slen, ibuf_get(cg.state, 12)) {
                return
            }
        }
    }
    c := cg.code
    mc_load_rax(c, idx_slot, 0)
    mc_cmp_rax_slot(c, tbl_slot, 1)
    cg_jmp_fn(cg, 0x83, h_sec_trap())
}

// Emits IEEE-754 `@nan_guard` check on `f64` bits in `RAX` (`(bits >> 52) & 0x7FF == 0x7FF` -> `h_nan_trap(line)`)
fn emit_nan_guard_rax(cg: CodegenCtx) {
    if (ibuf_get(cg.state, 18) & fnflag_nan_guard()) == 0 {
        return
    }
    c := cg.code
    mc_b3(c, 0x48, 0x89, 0xC2)       // MOV RDX, RAX
    mc_b4(c, 0x48, 0xC1, 0xEA, 0x34) // SHR RDX, 52
    mc_b2(c, 0x81, 0xE2); mc_u32(c, 0x7FF) // AND EDX, 0x7FF
    mc_b2(c, 0x81, 0xFA); mc_u32(c, 0x7FF) // CMP EDX, 0x7FF
    jne_ok := mc_jcc8(c, 0x75)
    mc_b1(c, 0xB9); mc_u32(c, ibuf_get(cg.state, 20))
    cg_call_fn(cg, h_nan_trap())
    mc_patch_jcc8(c, jne_ok, buf_len(c))
}

fn emit_int_binop_imm_ax(cg: CodegenCtx, lslot: i64, op: i64, imm: i64) -> i64 {
    if op == op_shl() or op == op_shr() {
        if imm < 0 or imm > 63 { return -1 }
    } else if op == op_mul() or op == op_wrap_mul() or op == op_add() or op == op_wrap_add() or op == op_sub() or op == op_wrap_sub() or op == op_bit_and() or op == op_bit_or() or op == op_bit_xor() or (op >= op_eq() and op <= op_gte()) {
        if imm < -2147483648 or imm > 2147483647 { return -1 }
    } else {
        return -1
    }

    c := cg.code
    dst := cg_alloc_slots(cg, 1)
    mc_load_rax(c, lslot, 0)

    if op == op_shl() {
        mc_b4(c, 0x48, 0xC1, 0xE0, imm)
    } else if op == op_shr() {
        mc_b4(c, 0x48, 0xC1, 0xF8, imm)
    } else if op == op_mul() or op == op_wrap_mul() {
        if imm >= -128 and imm <= 127 {
            mc_b4(c, 0x48, 0x6B, 0xC0, imm & 255)
        } else {
            mc_b3(c, 0x48, 0x69, 0xC0)
            mc_u32(c, imm)
        }
        if op == op_mul() and ibuf_get(cg.state, 0) == 1 {
            cg_jmp_fn(cg, 0x80, h_sec_trap())
        }
    } else {
        mut grp := 7
        if op == op_add() or op == op_wrap_add() { grp = 0 }
        else if op == op_bit_or() { grp = 1 }
        else if op == op_bit_and() { grp = 4 }
        else if op == op_sub() or op == op_wrap_sub() { grp = 5 }
        else if op == op_bit_xor() { grp = 6 }

        if grp == 7 and imm == 0 {
            mc_b3(c, 0x48, 0x85, 0xC0)
        } else if imm >= -128 and imm <= 127 {
            mc_b4(c, 0x48, 0x83, 0xC0 + (grp << 3), imm & 255)
        } else {
            mc_b2(c, 0x48, (grp << 3) | 5)
            mc_u32(c, imm)
        }
        if (op == op_add() or op == op_sub()) and ibuf_get(cg.state, 0) == 1 {
            cg_jmp_fn(cg, 0x80, h_sec_trap())
        }
        if op >= op_eq() and op <= op_gte() {
            mut setcc := 0x94
            if op == op_neq() { setcc = 0x95 }
            else if op == op_lt() { setcc = 0x9C }
            else if op == op_lte() { setcc = 0x9E }
            else if op == op_gt() { setcc = 0x9F }
            else if op == op_gte() { setcc = 0x9D }
            mc_b3(c, 0x0F, setcc, 0xC0)
            mc_b3(c, 0x0F, 0xB6, 0xC0)
        }
    }

    mc_store_rax(c, dst, 0)
    return dst
}

fn emit_scalar_binop_ax(cg: CodegenCtx, op: i64, lslot: i64, loff: i64, rslot: i64, roff: i64, common_ty: i64) -> i64 {
    c := cg.code
    dst := cg_alloc_slots(cg, 1)
    mc_load_rax(c, lslot, loff)
    mc_load_rcx(c, rslot, roff)

    if common_ty == ty_float() {
        mc_b4(c, 0x66, 0x48, 0x0F, 0x6E)
        mc_b1(c, 0xC0)
        mc_b4(c, 0x66, 0x48, 0x0F, 0x6E)
        mc_b1(c, 0xC9)
        if op == op_add() or op == op_wrap_add() {
            mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)
        } else if op == op_sub() or op == op_wrap_sub() {
            mc_b4(c, 0xF2, 0x0F, 0x5C, 0xC1)
        } else if op == op_mul() or op == op_wrap_mul() {
            mc_b4(c, 0xF2, 0x0F, 0x59, 0xC1)
        } else if op == op_div() {
            mc_b4(c, 0xF2, 0x0F, 0x5E, 0xC1)
        } else {
            mc_b4(c, 0x66, 0x0F, 0x2E, 0xC1)
            mut setcc := 0x94
            if op == op_neq() { setcc = 0x95 }
            else if op == op_lt() { setcc = 0x92 }
            else if op == op_lte() { setcc = 0x96 }
            else if op == op_gt() { setcc = 0x97 }
            else if op == op_gte() { setcc = 0x93 }
            mc_b3(c, 0x0F, setcc, 0xC0)
            mc_b3(c, 0x0F, 0xB6, 0xC0)
            mc_store_rax(c, dst, 0)
            return dst
        }
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E)
        mc_b1(c, 0xC0)
        emit_nan_guard_rax(cg)
        mc_store_rax(c, dst, 0)
        return dst
    }

    if common_ty == ty_dec() and (op == op_mul() or op == op_div()) {
        if op == op_mul() {
            mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
            mc_b3(c, 0x48, 0xC7, 0xC1)
            mc_u32(c, 10000)
            mc_b2(c, 0x48, 0x99)
            mc_b3(c, 0x48, 0xF7, 0xF9)
        } else {
            mc_b3(c, 0x48, 0x85, 0xC9)
            cg_jmp_fn(cg, 0x84, h_sec_trap())
            mc_b3(c, 0x48, 0x69, 0xC0)
            mc_u32(c, 10000)
            mc_b2(c, 0x48, 0x99)
            mc_b3(c, 0x48, 0xF7, 0xF9)
        }
        mc_store_rax(c, dst, 0)
        return dst
    }

    shd := ibuf_get(cg.state, 0)
    if op == op_add() {
        mc_b3(c, 0x48, 0x01, 0xC8)
        if shd == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
    } else if op == op_wrap_add() {
        mc_b3(c, 0x48, 0x01, 0xC8)
    } else if op == op_sub() {
        mc_b3(c, 0x48, 0x29, 0xC8)
        if shd == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
    } else if op == op_wrap_sub() {
        mc_b3(c, 0x48, 0x29, 0xC8)
    } else if op == op_mul() {
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
        if shd == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
    } else if op == op_wrap_mul() {
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
    } else if op == op_div() {
        mc_b3(c, 0x48, 0x85, 0xC9)
        cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b4(c, 0x48, 0x83, 0xF9, 0xFF)
        jne_ok := mc_jcc8(c, 0x75)
        mc_b2(c, 0x48, 0xBA)
        mc_u64(c, 1 << 63)
        mc_b3(c, 0x48, 0x39, 0xD0)
        cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_patch_jcc8(c, jne_ok, buf_len(c))
        mc_b2(c, 0x48, 0x99)
        mc_b3(c, 0x48, 0xF7, 0xF9)
    } else if op == op_mod() {
        mc_b3(c, 0x48, 0x85, 0xC9)
        cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b2(c, 0x31, 0xD2)
        mc_b4(c, 0x48, 0x83, 0xF9, 0xFF)
        je_mod_neg1 := mc_jcc8(c, 0x74)
        mc_b2(c, 0x48, 0x99)
        mc_b3(c, 0x48, 0xF7, 0xF9)
        mc_patch_jcc8(c, je_mod_neg1, buf_len(c))
        mc_b3(c, 0x48, 0x89, 0xD0)
    } else if op == op_bit_and() {
        mc_b3(c, 0x48, 0x21, 0xC8)
    } else if op == op_bit_or() {
        mc_b3(c, 0x48, 0x09, 0xC8)
    } else if op == op_bit_xor() {
        mc_b3(c, 0x48, 0x31, 0xC8)
    } else if op == op_shl() {
        mc_b3(c, 0x48, 0xD3, 0xE0)
    } else if op == op_shr() {
        mc_b3(c, 0x48, 0xD3, 0xF8)
    } else if op == op_and() {
        mc_b3(c, 0x48, 0x85, 0xC0)
        mc_b3(c, 0x0F, 0x95, 0xC0)
        mc_b3(c, 0x48, 0x85, 0xC9)
        mc_b3(c, 0x0F, 0x95, 0xC1)
        mc_b2(c, 0x20, 0xC8)
        mc_b3(c, 0x0F, 0xB6, 0xC0)
    } else if op == op_or() {
        mc_b3(c, 0x48, 0x09, 0xC8)
        mc_b3(c, 0x0F, 0x95, 0xC0)
        mc_b3(c, 0x0F, 0xB6, 0xC0)
    } else {
        mc_b3(c, 0x48, 0x39, 0xC8)
        mut setcc := 0x94
        if op == op_neq() { setcc = 0x95 }
        else if op == op_lt() { setcc = 0x9C }
        else if op == op_lte() { setcc = 0x9E }
        else if op == op_gt() { setcc = 0x9F }
        else if op == op_gte() { setcc = 0x9D }
        mc_b3(c, 0x0F, setcc, 0xC0)
        mc_b3(c, 0x0F, 0xB6, 0xC0)
    }

    mc_store_rax(c, dst, 0)
    return dst
}

// Emits fused `CMP` + inverted `Jcc rel32` for `if`/`while` conditions without allocating boolean scratch slots.
fn emit_cond_jump_false_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, cond_nid: i64) -> i64 {
    c := cg.code
    saved_slot := ibuf_get(cg.state, 4)
    saved_drops := ibuf_len(drops)

    if cond_nid > 0 and ast_kind(cg.nodes, cond_nid) == nk_binary() {
        op := ast_get(cg.nodes, cond_nid, 1)
        if op >= op_eq() and op <= op_gte() {
            lhs := ast_get(cg.nodes, cond_nid, 2)
            rhs := ast_get(cg.nodes, cond_nid, 3)
            lr := emit_expr_ax(cg, vars, drops, breaks, lhs)
            lty := er_ty(lr)
            if lty == ty_int() or lty == ty_bool() {
                mut inv_jcc := 0x85
                if op == op_neq() { inv_jcc = 0x84 }
                else if op == op_lt() { inv_jcc = 0x8D }
                else if op == op_lte() { inv_jcc = 0x8F }
                else if op == op_gt() { inv_jcc = 0x8E }
                else if op == op_gte() { inv_jcc = 0x8C }

                if is_nonshadowed_const_int(cg, vars, rhs) {
                    imm := eval_const_int_val(cg.pool, cg.nodes, cg.sym, rhs)
                    if imm >= -2147483648 and imm <= 2147483647 {
                        mc_load_rax(c, er_slot(lr), 0)
                        if imm == 0 {
                            mc_b3(c, 0x48, 0x85, 0xC0)
                        } else if imm >= -128 and imm <= 127 {
                            mc_b4(c, 0x48, 0x83, 0xF8, imm & 255)
                        } else {
                            mc_b2(c, 0x48, 0x3D)
                            mc_u32(c, imm)
                        }
                        if ibuf_len(drops) == saved_drops {
                            ibuf_set(cg.state, 4, saved_slot)
                        }
                        return mc_jcc32(c, inv_jcc)
                    }
                }

                rr := emit_expr_ax(cg, vars, drops, breaks, rhs)
                rty := er_ty(rr)
                if rty == ty_int() or rty == ty_bool() {
                    mc_load_rax(c, er_slot(lr), 0)
                    mc_cmp_rax_slot(c, er_slot(rr), 0)
                    if ibuf_len(drops) == saved_drops {
                        ibuf_set(cg.state, 4, saved_slot)
                    }
                    return mc_jcc32(c, inv_jcc)
                }

                dst := emit_scalar_binop_ax(cg, op, er_slot(lr), 0, er_slot(rr), 0, ty_int())
                mc_load_rax(c, dst, 0)
                mc_b3(c, 0x48, 0x85, 0xC0)
                if ibuf_len(drops) == saved_drops {
                    ibuf_set(cg.state, 4, saved_slot)
                }
                return mc_jcc32(c, 0x84)
            }
        }
    }

    cr := emit_expr_ax(cg, vars, drops, breaks, cond_nid)
    mc_load_rax(c, er_slot(cr), 0)
    mc_b3(c, 0x48, 0x85, 0xC0)
    if ibuf_len(drops) == saved_drops {
        ibuf_set(cg.state, 4, saved_slot)
    }
    return mc_jcc32(c, 0x84)
}

fn emit_perceus_drops_ax(cg: CodegenCtx, drops: IntBuf) {
    c := cg.code
    dcnt := ibuf_len(drops)
    mut i := 0
    while i < dcnt {
        ent := ibuf_get(drops, i)
        if ent > 0 {
            mc_load_rcx(c, ent, 0)
            mc_b2(c, 0x31, 0xC0)
            mc_store_rax(c, ent, 0)
            emit_free_raw_rcx(cg)
        }
        i += 1
    }
}

fn has_secret_wipes(drops: IntBuf) -> bool {
    dcnt := ibuf_len(drops)
    mut i := 0
    while i < dcnt {
        if ibuf_get(drops, i) < 0 {
            return true
        }
        i += 1
    }
    return false
}

fn emit_wipe_secrets_ax(cg: CodegenCtx, drops: IntBuf) {
    if not has_secret_wipes(drops) {
        return
    }
    c := cg.code
    mc_b2(c, 0x31, 0xC0)
    dcnt := ibuf_len(drops)
    mut i := 0
    while i < dcnt {
        ent := ibuf_get(drops, i)
        if ent < 0 {
            pk := 0 - ent
            bslot := pk >> 16
            scnt := pk & 0xFFFF
            mut s := 0
            while s < scnt {
                mc_store_rax(c, bslot, s)
                s += 1
            }
        }
        i += 1
    }
}

fn emit_writeback_mut_params_ax(cg: CodegenCtx, vars: IntBuf) {
    ab_slot := ibuf_get(cg.state, 5)
    if ibuf_get(cg.state, 9) == 1 or ab_slot <= 0 {
        return
    }
    c := cg.code
    fidx := ibuf_get(cg.state, 3)
    f_off := ibuf_get(cg.sym, 7) + fidx * 10
    p_base := ibuf_get(cg.sym, f_off + 3)
    p_cnt := ibuf_get(cg.sym, f_off + 4)

    mut pi := 0
    while pi < p_cnt {
        po := p_base + pi * 6
        if ibuf_get(cg.sym, po + 2) == pmode_mut() {
            vb := cg_var_find(cg.pool, vars, ibuf_get(cg.sym, po), ibuf_get(cg.sym, po + 1))
            if vb >= 0 {
                lslot := ibuf_get(vars, vb + 2)
                pty := ibuf_get(vars, vb + 3)
                pslots := type_slots(cg.sym, pty)
                arg_off := ibuf_get(cg.sym, po + 4)
                mc_load_r8(c, ab_slot, 0)
                mut s := 0
                while s < pslots {
                    mc_load_rax(c, lslot, s)
                    mc_r8_store_rax(c, (arg_off + s) * 8)
                    s += 1
                }
            }
        }
        pi += 1
    }
}

fn emit_return_from_slot_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, val_slot: i64, val_ty: i64) {
    c := cg.code
    emit_perceus_drops_ax(cg, drops)

    iret_slot := ibuf_get(cg.state, 22)
    if iret_slot > 0 {
        rslots := ibuf_get(cg.state, 24)
        mut copy_n := type_slots(cg.sym, val_ty)
        if copy_n > rslots { copy_n = rslots }
        mut s := 0
        while s < copy_n {
            mc_load_rax(c, val_slot, s)
            mc_store_rax(c, iret_slot, s)
            s += 1
        }
        emit_wipe_secrets_ax(cg, drops)
        depth_i := ibuf_get(cg.state, 25) - 1
        jpos := mc_jmp32(c)
        if depth_i >= 0 and depth_i < 4 {
            jcnt := ibuf_get(cg.state, 30 + depth_i)
            if jcnt < 16 {
                ibuf_set(cg.state, 34 + depth_i * 16 + jcnt, jpos)
                ibuf_set(cg.state, 30 + depth_i, jcnt + 1)
            }
        }
        return
    }

    emit_writeback_mut_params_ax(cg, vars)

    rslots := ibuf_get(cg.state, 8)
    if ibuf_get(cg.state, 9) == 1 {
        if rslots >= 2 {
            mc_load_rdx(c, val_slot, 1)
        }
        mc_load_rax(c, val_slot, 0)
    } else {
        rb_slot := ibuf_get(cg.state, 6)
        if rb_slot > 0 {
            mc_load_r8(c, rb_slot, 0)
            mut copy_n := type_slots(cg.sym, val_ty)
            if copy_n > rslots { copy_n = rslots }
            mut s := 0
            while s < copy_n {
                mc_load_rax(c, val_slot, s)
                mc_r8_store_rax(c, s * 8)
                s += 1
            }
            mc_load_rax(c, val_slot, 0)
        }
    }

    if has_secret_wipes(drops) {
        mc_b3(c, 0x49, 0x89, 0xC1)
        emit_wipe_secrets_ax(cg, drops)
        mc_b3(c, 0x4C, 0x89, 0xC8)
    }
    mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
    mc_b1(c, 0xC3)
}

// Appends unquoted raw `str` `(val_slot, 0..1)` into `ByteBuf` at `jb_slot`
fn emit_jbuf_append_raw_str(cg: CodegenCtx, jb_slot: i64, val_slot: i64) {
    c := cg.code
    mc_load_rcx(c, jb_slot, 0)
    mc_load_rdx(c, val_slot, 0)
    mc_load_r8(c, val_slot, 1)
    cg_call_fn(cg, h_jbuf_raw())
    mc_store_rax(c, jb_slot, 0)
}

fn emit_expr_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, enid: i64) -> i64 {
    c := cg.code
    if enid <= 0 {
        zs := cg_alloc_slots(cg, 1)
        mc_mov_rax_imm(c, 0)
        mc_store_rax(c, zs, 0)
        return er_pack(zs, ty_unit())
    }
    k := ast_kind(cg.nodes, enid)

    if k == nk_int() {
        s := cg_alloc_slots(cg, 1)
        mc_mov_rax_imm(c, ast_get(cg.nodes, enid, 1))
        mc_store_rax(c, s, 0)
        return er_pack(s, ty_int())
    }
    if k == nk_float() {
        s := cg_alloc_slots(cg, 1)
        mc_mov_rax_imm(c, ast_get(cg.nodes, enid, 1))
        mc_store_rax(c, s, 0)
        return er_pack(s, ty_float())
    }
    if k == nk_dec() {
        s := cg_alloc_slots(cg, 1)
        mc_mov_rax_imm(c, ast_get(cg.nodes, enid, 1))
        mc_store_rax(c, s, 0)
        return er_pack(s, ty_dec())
    }
    if k == nk_bool() {
        s := cg_alloc_slots(cg, 1)
        mc_mov_rax_imm(c, ast_get(cg.nodes, enid, 1))
        mc_store_rax(c, s, 0)
        return er_pack(s, ty_bool())
    }
    if k == nk_str() {
        soff := ast_get(cg.nodes, enid, 1)
        slen := ast_get(cg.nodes, enid, 2)
        roff := cg_intern_pool_slice(cg, soff, slen)
        s := cg_alloc_slots(cg, 2)
        cg_lea_rax_rdata(cg, roff)
        mc_store_rax(c, s, 0)
        mc_mov_rax_imm(c, slen)
        mc_store_rax(c, s, 1)
        return er_pack(s, ty_str())
    }
    if k == nk_secret_str() {
        soff := ast_get(cg.nodes, enid, 1)
        slen := ast_get(cg.nodes, enid, 2)
        site_id := ibuf_get(cg.state, 1) + 1
        ibuf_set(cg.state, 1, site_id)
        seed0 := ((0x5A ^ (site_id * 97) ^ (slen * 13)) & 255) | 1
        cipher_off := buf_len(cg.rdata)
        mut st := seed0
        mut i := 0
        while i < slen {
            pb := buf_get(cg.pool, soff + i)
            buf_push(cg.rdata, (pb ^ st) & 255)
            st = (st * 131 + 73 + i) & 255
            i += 1
        }
        mut bslots := (slen + 8) / 8
        if bslots < 1 { bslots = 1 }
        bslot := cg_alloc_slots(cg, bslots)
        lowest_slot := bslot + bslots - 1
        ibuf_push(drops, 0 - ((bslot << 16) | bslots))

        cg_lea_rax_rdata(cg, cipher_off)
        mc_b3(c, 0x49, 0x89, 0xC0)
        mc_lea_rax(c, lowest_slot, 0)
        mc_b3(c, 0x49, 0x89, 0xC1)
        if slen > 0 {
            mc_b2(c, 0x31, 0xC9)
            mc_b1(c, 0xBA)
            mc_u32(c, seed0)
            sloop := buf_len(c)
            mc_b4(c, 0x41, 0x0F, 0xB6, 0x04)
            mc_b1(c, 0x08)
            mc_b2(c, 0x31, 0xD0)
            mc_b4(c, 0x41, 0x88, 0x04, 0x09)
            mc_b2(c, 0x69, 0xD2)
            mc_u32(c, 131)
            mc_b3(c, 0x83, 0xC2, 73)
            mc_b2(c, 0x01, 0xCA)
            mc_b3(c, 0x0F, 0xB6, 0xD2)
            mc_b3(c, 0x48, 0xFF, 0xC1)
            mc_b3(c, 0x48, 0x81, 0xF9)
            mc_u32(c, slen)
            jb_sc := mc_jcc8(c, 0x72)
            mc_patch_jcc8(c, jb_sc, sloop)
        }
        res := cg_alloc_slots(cg, 2)
        mc_b3(c, 0x4C, 0x89, 0xC8)
        mc_store_rax(c, res, 0)
        mc_mov_rax_imm(c, slen)
        mc_store_rax(c, res, 1)
        return er_pack(res, ty_str())
    }
    if k == nk_fstr() {
        // Materialize first-class `f"..."` string value (propagating `tainted[str]` automatically!)
        poff := ast_get(cg.nodes, enid, 1)
        pcnt := ast_get(cg.nodes, enid, 2)
        jb_slot := cg_alloc_slots(cg, 1)
        mc_b2(c, 0x31, 0xC9)
        cg_call_fn(cg, h_buf_new())
        mc_store_rax(c, jb_slot, 0)

        mut is_tainted := false
        mut pi := 0
        while pi < pcnt {
            pe := ibuf_get(cg.extra, poff + pi)
            if ast_kind(cg.nodes, pe) == nk_str() {
                ls_off := ast_get(cg.nodes, pe, 1)
                ls_len := ast_get(cg.nodes, pe, 2)
                if ls_len > 0 {
                    roff := cg_intern_pool_slice(cg, ls_off, ls_len)
                    emit_jbuf_append_rdata(cg, jb_slot, roff, ls_len)
                }
            } else {
                pr := emit_expr_ax(cg, vars, drops, breaks, pe)
                mut pty := er_ty(pr)
                if ty_tag(pty) == 16 {
                    is_tainted = true
                    pty = ty_pay(pty)
                }
                if ty_tag(pty) == 5 {
                    emit_jbuf_append_raw_str(cg, jb_slot, er_slot(pr))
                } else {
                    emit_jbuf_append_i64(cg, jb_slot, er_slot(pr), 0)
                }
            }
            pi += 1
        }
        dst := cg_alloc_slots(cg, 2)
        mc_load_rax(c, jb_slot, 0)
        mc_b3(c, 0x48, 0x8B, 0x08) // RCX = len
        mc_b4(c, 0xC6, 0x44, 0x08, 0x10); mc_b1(c, 0) // null terminate
        mc_b4(c, 0x48, 0x8D, 0x40, 0x10)
        mc_store_rax(c, dst, 0)
        mc_b3(c, 0x48, 0x89, 0xC8)
        mc_store_rax(c, dst, 1)
        if is_tainted {
            return er_pack(dst, ty_make(16, ty_str()))
        }
        return er_pack(dst, ty_str())
    }
    if k == nk_ident() or k == nk_move_ident() {
        soff := ast_get(cg.nodes, enid, 1)
        slen := ast_get(cg.nodes, enid, 2)
        vb := cg_var_find(cg.pool, vars, soff, slen)
        if vb >= 0 {
            return er_pack(ibuf_get(vars, vb + 2), ibuf_get(vars, vb + 3))
        }
        goff := ct_find_global_const(cg.pool, cg.sym, soff, slen)
        if goff >= 0 {
            cty := ibuf_get(cg.sym, goff + 2)
            v1 := ibuf_get(cg.sym, goff + 3)
            v2 := ibuf_get(cg.sym, goff + 4)
            if cty == ty_str() {
                roff := cg_intern_pool_slice(cg, v1, v2)
                s := cg_alloc_slots(cg, 2)
                cg_lea_rax_rdata(cg, roff)
                mc_store_rax(c, s, 0)
                mc_mov_rax_imm(c, v2)
                mc_store_rax(c, s, 1)
                return er_pack(s, ty_str())
            }
            if cty == ty_intbuf() or cty == ty_bytebuf() {
                roff := cg_intern_ct_lut(cg, goff)
                s := cg_alloc_slots(cg, 1)
                cg_lea_rax_rdata(cg, roff)
                mc_store_rax(c, s, 0)
                return er_pack(s, cty)
            }
            s := cg_alloc_slots(cg, 1)
            mc_mov_rax_imm(c, v1)
            mc_store_rax(c, s, 0)
            return er_pack(s, cty)
        }
        zs := cg_alloc_slots(cg, 1)
        mc_mov_rax_imm(c, 0)
        mc_store_rax(c, zs, 0)
        return er_pack(zs, ty_int())
    }
    if k == nk_await() {
        ir := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 1))
        ity := er_ty(ir)
        if ty_tag(ity) == 22 or ty_tag(ity) == 15 {
            return er_pack(er_slot(ir), ty_pay(ity))
        }
        return ir
    }
    if k == nk_comptime_expr() {
        return emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 1))
    }
    if k == nk_call() {
        if ast_get(cg.nodes, enid, 4) == 0 {
            fidx := find_fn_idx(cg.pool, cg.sym, ast_get(cg.nodes, enid, 1), ast_get(cg.nodes, enid, 2))
            if is_const_fn_idx(cg.sym, fidx) {
                s := cg_alloc_slots(cg, 1)
                mc_mov_rax_imm(c, const_fn_val(cg.sym, fidx))
                mc_store_rax(c, s, 0)
                return er_pack(s, const_fn_ty(cg.sym, fidx))
            }
        }
        return emit_call_or_ctor(cg, vars, drops, breaks, enid)
    }
    if k == nk_tuple() {
        off := ast_get(cg.nodes, enid, 1)
        cnt := ast_get(cg.nodes, enid, 2)
        desc_off := ibuf_len(cg.sym)
        ibuf_push(cg.sym, cnt)
        mut i := 0
        while i < cnt {
            ibuf_push(cg.sym, ty_int())
            i += 1
        }
        ev := ibuf_new(32)
        mut tot := 0
        i = 0
        while i < cnt {
            er := emit_expr_ax(cg, vars, drops, breaks, ibuf_get(cg.extra, off + i))
            eslot := er_slot(er)
            ety := er_ty(er)
            ecnt := type_slots(cg.sym, ety)
            tot += ecnt
            ibuf_push(ev, eslot)
            ibuf_push(ev, ecnt)
            ibuf_set(cg.sym, desc_off + 1 + i, ety)
            i += 1
        }
        dst := cg_alloc_slots(cg, tot)
        mut cur := 0
        i = 0
        while i < cnt {
            es := ibuf_get(ev, i * 2)
            ec := ibuf_get(ev, i * 2 + 1)
            mut s := 0
            while s < ec {
                mc_load_rax(c, es, s)
                mc_store_rax(c, dst, cur + s)
                s += 1
            }
            cur += ec
            i += 1
        }
        buf_free(move ev)
        return er_pack(dst, ty_make(14, desc_off))
    }
    if k == nk_unary() {
        if is_nonshadowed_const_int(cg, vars, enid) {
            cval := eval_const_int_val(cg.pool, cg.nodes, cg.sym, enid)
            mut uty := ty_int()
            if ast_get(cg.nodes, enid, 1) == uop_not() { uty = ty_bool() }
            s := cg_alloc_slots(cg, 1)
            mc_mov_rax_imm(c, cval)
            mc_store_rax(c, s, 0)
            return er_pack(s, uty)
        }
        uop := ast_get(cg.nodes, enid, 1)
        ir := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 2))
        islot := er_slot(ir)
        ity := er_ty(ir)
        dst := cg_alloc_slots(cg, 1)
        mc_load_rax(c, islot, 0)
        if uop == uop_neg() {
            if ity == ty_float() {
                mc_b2(c, 0x48, 0xB9)
                mc_u64(c, 1 << 63)
                mc_b3(c, 0x48, 0x31, 0xC8)
            } else {
                mc_b3(c, 0x48, 0xF7, 0xD8)
            }
            mc_store_rax(c, dst, 0)
            return er_pack(dst, ity)
        }
        mc_b3(c, 0x48, 0x85, 0xC0)
        mc_b3(c, 0x0F, 0x94, 0xC0)
        mc_b3(c, 0x0F, 0xB6, 0xC0)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_bool())
    }
    if k == nk_binary() {
        op := ast_get(cg.nodes, enid, 1)
        if is_nonshadowed_const_int(cg, vars, enid) {
            cval := eval_const_int_val(cg.pool, cg.nodes, cg.sym, enid)
            mut cty := ty_int()
            if op >= op_eq() and op <= op_or() {
                cty = ty_bool()
            }
            s := cg_alloc_slots(cg, 1)
            mc_mov_rax_imm(c, cval)
            mc_store_rax(c, s, 0)
            return er_pack(s, cty)
        }

        lr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 2))
        lslot := er_slot(lr)
        lty := er_ty(lr)

        if op == op_or() and ty_tag(lty) == 13 {
            ok_ty := ty_pay(lty)
            ok_slots := type_slots(cg.sym, ok_ty)
            dst := cg_alloc_slots(cg, ok_slots)
            mc_load_rax(c, lslot, 0)
            mc_b3(c, 0x48, 0x85, 0xC0)
            jnz_err := mc_jcc32(c, 0x85)
            mut s := 0
            while s < ok_slots {
                mc_load_rax(c, lslot, 1 + s)
                mc_store_rax(c, dst, s)
                s += 1
            }
            jmp_d := mc_jmp32(c)
            mc_patch_rel32(c, jnz_err, buf_len(c))
            rr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 3))
            rslot := er_slot(rr)
            s = 0
            while s < ok_slots {
                mc_load_rax(c, rslot, s)
                mc_store_rax(c, dst, s)
                s += 1
            }
            mc_patch_rel32(c, jmp_d, buf_len(c))
            return er_pack(dst, ok_ty)
        }

        if op == op_or() {
            dst := cg_alloc_slots(cg, 1)
            mc_load_rax(c, lslot, 0)
            mc_b3(c, 0x48, 0x85, 0xC0)
            jnz_true := mc_jcc32(c, 0x85)
            rr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 3))
            rslot := er_slot(rr)
            mc_load_rax(c, rslot, 0)
            mc_b3(c, 0x48, 0x85, 0xC0)
            mc_b3(c, 0x0F, 0x95, 0xC0)
            mc_b3(c, 0x0F, 0xB6, 0xC0)
            mc_store_rax(c, dst, 0)
            jmp_d := mc_jmp32(c)
            mc_patch_rel32(c, jnz_true, buf_len(c))
            mc_mov_rax_imm(c, 1)
            mc_store_rax(c, dst, 0)
            mc_patch_rel32(c, jmp_d, buf_len(c))
            return er_pack(dst, ty_bool())
        }

        if op == op_and() {
            dst := cg_alloc_slots(cg, 1)
            mc_load_rax(c, lslot, 0)
            mc_b3(c, 0x48, 0x85, 0xC0)
            jz_false := mc_jcc32(c, 0x84)
            rr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 3))
            rslot := er_slot(rr)
            mc_load_rax(c, rslot, 0)
            mc_b3(c, 0x48, 0x85, 0xC0)
            mc_b3(c, 0x0F, 0x95, 0xC0)
            mc_b3(c, 0x0F, 0xB6, 0xC0)
            mc_store_rax(c, dst, 0)
            jmp_d := mc_jmp32(c)
            mc_patch_rel32(c, jz_false, buf_len(c))
            mc_mov_rax_imm(c, 0)
            mc_store_rax(c, dst, 0)
            mc_patch_rel32(c, jmp_d, buf_len(c))
            return er_pack(dst, ty_bool())
        }

        rhs_nid := ast_get(cg.nodes, enid, 3)
        if (lty == ty_int() or (lty == ty_bool() and op >= op_eq() and op <= op_gte())) and is_nonshadowed_const_int(cg, vars, rhs_nid) {
            imm := eval_const_int_val(cg.pool, cg.nodes, cg.sym, rhs_nid)
            ibuf_set(cg.state, 20, span_line(ast_span(cg.nodes, enid)))
            imm_dst := emit_int_binop_imm_ax(cg, lslot, op, imm)
            if imm_dst >= 0 {
                mut imm_rty := lty
                if op >= op_eq() and op <= op_gte() { imm_rty = ty_bool() }
                return er_pack(imm_dst, imm_rty)
            }
        }

        rr := emit_expr_ax(cg, vars, drops, breaks, rhs_nid)
        rslot := er_slot(rr)
        rty := er_ty(rr)

        // Hardware 128-bit `XMM` SIMD operators for `vec3`, `vec4`, and `mat4`
        if lty == ty_vec3() or lty == ty_vec4() {
            dst := cg_alloc_slots(cg, 2)
            if rty == lty {
                mc_load_xmm0_vec(c, lslot, 0)
                mc_load_xmm1_vec(c, rslot, 0)
            } else {
                mc_f64_slot_to_f32_eax(c, rslot)
                mc_b3(c, 0x0F, 0x28, 0xC8)
                mc_b4(c, 0x0F, 0xC6, 0xC9, 0x00)
                mc_load_xmm0_vec(c, lslot, 0)
            }
            if op == op_add() { mc_b3(c, 0x0F, 0x58, 0xC1) }
            else if op == op_sub() { mc_b3(c, 0x0F, 0x5C, 0xC1) }
            else { mc_b3(c, 0x0F, 0x59, 0xC1) }
            mc_store_xmm0_vec(c, dst, 0)
            return er_pack(dst, lty)
        }
        if lty == ty_mat4() and op == op_mul() {
            if rty == ty_vec4() {
                mc_load_xmm1_vec(c, rslot, 0)
                mc_emit_mat4_mul_xmm1(c, lslot)
                dst := cg_alloc_slots(cg, 2)
                mc_store_xmm0_vec(c, dst, 0)
                return er_pack(dst, ty_vec4())
            }
            if rty == ty_mat4() {
                dst := cg_alloc_slots(cg, 8)
                mut col := 0
                while col < 4 {
                    mc_load_xmm1_vec(c, rslot, col * 2)
                    mc_emit_mat4_mul_xmm1(c, lslot)
                    mc_store_xmm0_vec(c, dst, col * 2)
                    col += 1
                }
                return er_pack(dst, ty_mat4())
            }
        }

        mut base_l := lty
        if ty_tag(base_l) == 16 { base_l = ty_pay(base_l) }
        mut base_r := rty
        if ty_tag(base_r) == 16 { base_r = ty_pay(base_r) }
        any_taint := (ty_tag(lty) == 16 or ty_tag(rty) == 16)

        if base_l == ty_str() and base_r == ty_str() {
            if op == op_add() {
                // `str + str` concatenation (propagating `tainted[str]` if either side is tainted!)
                mc_load_rcx(c, lslot, 0)
                mc_load_rdx(c, lslot, 1)
                mc_load_r8(c, rslot, 0)
                mc_load_r9(c, rslot, 1)
                cg_call_fn(cg, h_str_concat())
                dst := cg_alloc_slots(cg, 2)
                mc_store_rax(c, dst, 0)
                mc_store_rdx(c, dst, 1)
                if any_taint {
                    return er_pack(dst, ty_make(16, ty_str()))
                }
                return er_pack(dst, ty_str())
            }
            if op == op_eq() or op == op_neq() {
                dst := cg_alloc_slots(cg, 1)
                mc_load_rcx(c, lslot, 0)
                mc_load_rdx(c, lslot, 1)
                mc_load_r8(c, rslot, 0)
                mc_load_r9(c, rslot, 1)
                cg_call_fn(cg, h_str_eq())
                if op == op_neq() {
                    mc_b4(c, 0x48, 0x83, 0xF0, 0x01)
                }
                mc_store_rax(c, dst, 0)
                return er_pack(dst, ty_bool())
            }
        }

        mut common_ty := ty_int()
        if base_l == ty_dec() or base_r == ty_dec() { common_ty = ty_dec() }
        else if base_l == ty_float() or base_r == ty_float() { common_ty = ty_float() }

        if common_ty == ty_dec() and (op == op_mul() or op == op_div()) and base_l != base_r {
            dst := cg_alloc_slots(cg, 1)
            mc_load_rax(c, lslot, 0)
            mc_load_rcx(c, rslot, 0)
            if op == op_mul() {
                mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
                if ibuf_get(cg.state, 0) == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
            } else {
                mc_b3(c, 0x48, 0x85, 0xC9)
                cg_jmp_fn(cg, 0x84, h_sec_trap())
                mc_b2(c, 0x48, 0x99)
                mc_b3(c, 0x48, 0xF7, 0xF9)
            }
            mc_store_rax(c, dst, 0)
            return er_pack(dst, ty_dec())
        }

        mut eff_l := lslot
        mut eff_r := rslot
        if common_ty == ty_float() {
            if base_l != ty_float() {
                eff_l = cg_alloc_slots(cg, 1)
                mc_load_rax(c, lslot, 0)
                mc_b4(c, 0xF2, 0x48, 0x0F, 0x2A); mc_b1(c, 0xC0) // CVTSI2SD XMM0, RAX
                mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0) // MOVQ RAX, XMM0
                mc_store_rax(c, eff_l, 0)
            }
            if base_r != ty_float() {
                eff_r = cg_alloc_slots(cg, 1)
                mc_load_rax(c, rslot, 0)
                mc_b4(c, 0xF2, 0x48, 0x0F, 0x2A); mc_b1(c, 0xC0) // CVTSI2SD XMM0, RAX
                mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0) // MOVQ RAX, XMM0
                mc_store_rax(c, eff_r, 0)
            }
        }

        mut res_ty := common_ty
        if op >= op_eq() and op <= op_or() {
            res_ty = ty_bool()
        } else if any_taint {
            res_ty = ty_make(16, common_ty)
        }
        ibuf_set(cg.state, 20, span_line(ast_span(cg.nodes, enid)))
        dst := emit_scalar_binop_ax(cg, op, eff_l, 0, eff_r, 0, common_ty)
        return er_pack(dst, res_ty)
    }
    if k == nk_or_return() {
        lr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 1))
        lslot := er_slot(lr)
        lty := er_ty(lr)
        rv_nid := ast_get(cg.nodes, enid, 2)
        if ty_tag(lty) == 13 {
            ok_ty := ty_pay(lty)
            ok_slots := type_slots(cg.sym, ok_ty)
            dst := cg_alloc_slots(cg, ok_slots)
            mc_load_rax(c, lslot, 0)
            mc_b3(c, 0x48, 0x85, 0xC0)
            jz_ok := mc_jcc32(c, 0x84)
            if rv_nid > 0 {
                rvr := emit_expr_ax(cg, vars, drops, breaks, rv_nid)
                emit_return_from_slot_ax(cg, vars, drops, er_slot(rvr), er_ty(rvr))
            } else {
                emit_return_from_slot_ax(cg, vars, drops, lslot, ibuf_get(cg.state, 7))
            }
            mc_patch_rel32(c, jz_ok, buf_len(c))
            mut s := 0
            while s < ok_slots {
                mc_load_rax(c, lslot, 1 + s)
                mc_store_rax(c, dst, s)
                s += 1
            }
            return er_pack(dst, ok_ty)
        }
        return lr
    }
    if k == nk_cast() {
        ir := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 1))
        islot := er_slot(ir)
        ity := er_ty(ir)
        ibuf_set(cg.sym, 13, ast_get(cg.nodes, enid, 2))
        target_ty := resolve_typespec(cg.pool, cg.nodes, cg.extra, cg.sym)
        dst := cg_alloc_slots(cg, 1)
        mc_load_rax(c, islot, 0)
        if ity == ty_int() and target_ty == ty_float() {
            mc_b4(c, 0xF2, 0x48, 0x0F, 0x2A)
            mc_b1(c, 0xC0)
            mc_b4(c, 0x66, 0x48, 0x0F, 0x7E)
            mc_b1(c, 0xC0)
        } else if ity == ty_float() and target_ty == ty_int() {
            mc_b4(c, 0x66, 0x48, 0x0F, 0x6E)
            mc_b1(c, 0xC0)
            mc_b4(c, 0xF2, 0x48, 0x0F, 0x2C)
            mc_b1(c, 0xC0)
        }
        mc_store_rax(c, dst, 0)
        return er_pack(dst, target_ty)
    }
    if k == nk_field() {
        br := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 1))
        bslot := er_slot(br)
        bty := er_ty(br)
        fsoff := ast_get(cg.nodes, enid, 2)
        fslen := ast_get(cg.nodes, enid, 3)
        if pool_str_eq_lit(cg.pool, fsoff, fslen, "len") {
            if ty_tag(bty) == 5 or ty_tag(bty) == 12 {
                dst := cg_alloc_slots(cg, 1)
                mc_load_rax(c, bslot, 1)
                mc_store_rax(c, dst, 0)
                return er_pack(dst, ty_int())
            }
            if ty_tag(bty) == 21 {
                dst := cg_alloc_slots(cg, 1)
                mc_load_rdx(c, bslot, 1)
                mc_b3(c, 0x48, 0x89, 0xD0); mc_b1(c, 0x25); mc_u32(c, 0xFFFFF)
                mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE9, 0x14); mc_b2(c, 0x81, 0xE1); mc_u32(c, 0xFFFFF)
                mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
                mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE9, 0x28); mc_b2(c, 0x81, 0xE1); mc_u32(c, 0xFFFFF)
                mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
                mc_store_rax(c, dst, 0)
                return er_pack(dst, ty_int())
            }
        }
        if bty == ty_vec3() or bty == ty_vec4() or bty == ty_quat() {
            dst := cg_alloc_slots(cg, 1)
            if pool_str_eq_lit(cg.pool, fsoff, fslen, "x") {
                mc_load_rax(c, bslot, 0)
            } else if pool_str_eq_lit(cg.pool, fsoff, fslen, "y") {
                mc_load_rax(c, bslot, 0)
                mc_b4(c, 0x48, 0xC1, 0xE8, 0x20)
            } else if pool_str_eq_lit(cg.pool, fsoff, fslen, "z") {
                mc_load_rax(c, bslot, 1)
            } else {
                mc_load_rax(c, bslot, 1)
                mc_b4(c, 0x48, 0xC1, 0xE8, 0x20)
            }
            mc_b4(c, 0x66, 0x0F, 0x6E, 0xC0)
            mc_b4(c, 0xF3, 0x0F, 0x5A, 0xC0)
            mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
            mc_store_rax(c, dst, 0)
            return er_pack(dst, ty_float())
        }
        if ty_tag(bty) == 10 {
            fo := find_struct_field(cg.pool, cg.sym, ty_pay(bty), fsoff | (fslen << 32))
            if fo >= 0 {
                f_off := ibuf_get(cg.sym, fo + 2)
                f_ty := ibuf_get(cg.sym, fo + 3)
                return er_pack(bslot + f_off, f_ty)
            }
        }
        return er_pack(bslot, ty_int())
    }
    if k == nk_tuple_idx() {
        br := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 1))
        bslot := er_slot(br)
        bty := er_ty(br)
        idx := ast_get(cg.nodes, enid, 2)
        if ty_tag(bty) == 14 {
            doff := ty_pay(bty)
            cnt := ibuf_get(cg.sym, doff)
            mut off := 0
            mut i := 0
            while i < cnt {
                et := ibuf_get(cg.sym, doff + 1 + i)
                ecnt := type_slots(cg.sym, et)
                if i == idx {
                    return er_pack(bslot + off, et)
                }
                off += ecnt
                i += 1
            }
        }
        return er_pack(bslot, ty_int())
    }
    if k == nk_index() {
        tr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 1))
        idx_nid := ast_get(cg.nodes, enid, 2)
        ir := emit_expr_ax(cg, vars, drops, breaks, idx_nid)
        tslot := er_slot(tr)
        tty := er_ty(tr)
        islot := er_slot(ir)
        dst := cg_alloc_slots(cg, 1)
        if tty == ty_intbuf() {
            mc_load_r8(c, tslot, 0)
            mc_load_rcx(c, islot, 0)
            mc_b3(c, 0x49, 0x3B, 0x08)
            cg_jmp_fn(cg, 0x83, h_sec_trap())
            mc_b4(c, 0x49, 0x8B, 0x44, 0xC8); mc_b1(c, 0x10)
            mc_store_rax(c, dst, 0)
            return er_pack(dst, ty_int())
        }
        if tty == ty_bytebuf() {
            mc_load_r8(c, tslot, 0)
            mc_load_rcx(c, islot, 0)
            mc_b3(c, 0x49, 0x3B, 0x08)
            cg_jmp_fn(cg, 0x83, h_sec_trap())
            mc_b4(c, 0x41, 0x0F, 0xB6, 0x44); mc_b2(c, 0x08, 0x10)
            mc_store_rax(c, dst, 0)
            return er_pack(dst, ty_int())
        }
        if ty_tag(tty) == 21 {
            mc_load_rdx(c, tslot, 1)
            mc_b3(c, 0x48, 0x89, 0xD0); mc_b1(c, 0x25); mc_u32(c, 0xFFFFF)
            mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE9, 0x14); mc_b2(c, 0x81, 0xE1); mc_u32(c, 0xFFFFF)
            mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
            mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE9, 0x28); mc_b2(c, 0x81, 0xE1); mc_u32(c, 0xFFFFF)
            mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1) // RAX = numel
            mc_load_rcx(c, islot, 0)
            mc_b3(c, 0x48, 0x39, 0xC1)
            cg_jmp_fn(cg, 0x83, h_sec_trap())
            mc_load_r8(c, tslot, 0)
            mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b2(c, 0x04, 0x88)
            mc_b4(c, 0xF3, 0x0F, 0x5A, 0xC0)
            mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
            mc_store_rax(c, dst, 0)
            return er_pack(dst, ty_float())
        }
        emit_bounds_check_ax(cg, islot, tslot, idx_nid)
        mc_load_r8(c, tslot, 0)
        mc_load_rcx(c, islot, 0)
        if ty_tag(tty) == 12 and ty_pay(tty) == 60001 {
            mc_b4(c, 0xF3, 0x41, 0x0F, 0x10)
            mc_b2(c, 0x04, 0x88)
            mc_b4(c, 0xF3, 0x0F, 0x5A, 0xC0)
            mc_b4(c, 0x66, 0x48, 0x0F, 0x7E)
            mc_b1(c, 0xC0)
            mc_store_rax(c, dst, 0)
            return er_pack(dst, ty_float())
        }
        mc_b4(c, 0x49, 0x8B, 0x04, 0xC8)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }
    if k == nk_table_alloc() {
        esoff := ast_get(cg.nodes, enid, 1)
        eslen := ast_get(cg.nodes, enid, 2)
        cr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 3))
        cslot := er_slot(cr)
        mut col_cnt := 1
        mut elem_bytes := 4
        mut t_pay := 60001
        if pool_str_eq_lit(cg.pool, esoff, eslen, "i64") or pool_str_eq_lit(cg.pool, esoff, eslen, "usize") or pool_str_eq_lit(cg.pool, esoff, eslen, "f64") {
            elem_bytes = 8
            t_pay = 60002
        } else if not pool_str_eq_lit(cg.pool, esoff, eslen, "f32") {
            sidx := find_struct_idx(cg.pool, cg.sym, esoff, eslen)
            if sidx >= 0 {
                t_pay = sidx
                col_cnt = soa_active_col_count(cg.sym, sidx)
            }
        }
        stride := col_cnt * elem_bytes
        mc_load_rax(c, cslot, 0)
        mc_b3(c, 0x48, 0x69, 0xD0)
        mc_u32(c, stride)
        mc_b3(c, 0x48, 0x81, 0xC2)
        mc_u32(c, 256)
        emit_alloc_raw_rax(cg)
        dst := cg_alloc_slots(cg, 2)
        mc_store_rax(c, dst, 0)
        mc_load_rax(c, cslot, 0)
        mc_store_rax(c, dst, 1)
        return er_pack(dst, ty_make(12, t_pay))
    }
    if k == nk_method_call() {
        return emit_method_call_ax(cg, vars, drops, breaks, enid)
    }
    if k == nk_if_expr() {
        jz_else := emit_cond_jump_false_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 1))
        tb := ast_get(cg.nodes, enid, 2)
        emit_block_ax(cg, vars, drops, breaks, tb)
        tr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, tb, 3))
        tslot := er_slot(tr)
        tty := er_ty(tr)
        rslots := type_slots(cg.sym, tty)
        dst := cg_alloc_slots(cg, rslots)
        mut s := 0
        while s < rslots {
            mc_load_rax(c, tslot, s)
            mc_store_rax(c, dst, s)
            s += 1
        }
        jmp_end := mc_jmp32(c)
        mc_patch_rel32(c, jz_else, buf_len(c))
        eb := ast_get(cg.nodes, enid, 3)
        if eb > 0 {
            emit_block_ax(cg, vars, drops, breaks, eb)
            er := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, eb, 3))
            eslot := er_slot(er)
            s = 0
            while s < rslots {
                mc_load_rax(c, eslot, s)
                mc_store_rax(c, dst, s)
                s += 1
            }
        }
        mc_patch_rel32(c, jmp_end, buf_len(c))
        return er_pack(dst, tty)
    }
    if k == nk_spawn() {
        blk := ast_get(cg.nodes, enid, 1)
        b_off := ast_get(cg.nodes, blk, 1)
        b_cnt := ast_get(cg.nodes, blk, 2)
        mut res_slot := cg_alloc_slots(cg, 1)
        mut res_ty := ty_int()
        mc_mov_rax_imm(c, 0)
        mc_store_rax(c, res_slot, 0)
        mut i := 0
        while i < b_cnt {
            st := ibuf_get(cg.extra, b_off + i)
            if ast_kind(cg.nodes, st) == nk_return() {
                rv := ast_get(cg.nodes, st, 1)
                if rv > 0 {
                    rr := emit_expr_ax(cg, vars, drops, breaks, rv)
                    res_slot = er_slot(rr)
                    res_ty = er_ty(rr)
                }
                break
            } else {
                emit_stmt_ax(cg, vars, drops, breaks, st)
            }
            i += 1
        }
        return er_pack(res_slot, ty_make(15, res_ty))
    }

    zs := cg_alloc_slots(cg, 1)
    mc_mov_rax_imm(c, 0)
    mc_store_rax(c, zs, 0)
    return er_pack(zs, ty_int())
}

// 3-Tier Runtime CPUID Dispatch SoA Loop Emitter (`for p in table`):
//   Tier 2 (`g_simd_tier == 2`): Hardware 512-bit `AVX-512F EVEX` (`ZMM0..ZMM2`, 64 bytes / 16 floats per inst!)
//   Tier 1 (`g_simd_tier == 1`): Hardware 256-bit `AVX2 + FMA3` (`YMM`, 4x-unrolled 128B + 32B loop)
//   Tier 0 (`g_simd_tier == 0`) + Exact Remainder Tail: Pure `SSE2` (`MOVSS`/`MULSS`/`ADDSS`, 0 VEX/EVEX bytes!)
fn emit_soa_simd_foreach_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, fe_nid: i64) {
    tr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, fe_nid, 3))
    tbl_slot := er_slot(tr)
    plan_off := ast_get(cg.nodes, fe_nid, 5)
    if plan_off <= 0 {
        return
    }
    c := cg.code
    ops_cnt := ibuf_get(cg.extra, plan_off + 1)
    mut oi := 0
    while oi < ops_cnt {
        obase := plan_off + 2 + oi * 4
        okind := ibuf_get(cg.extra, obase)
        dst_col := ibuf_get(cg.extra, obase + 1)
        src_col := ibuf_get(cg.extra, obase + 2)
        scale_e := ibuf_get(cg.extra, obase + 3)

        mut scale_slot := 0
        if scale_e > 0 {
            sr := emit_expr_ax(cg, vars, drops, breaks, scale_e)
            scale_slot = er_slot(sr)
        }

        is_fma := okind == 1 or okind == 3 or okind == 4 or okind == 5
        mc_b2(c, 0x56, 0x57) // PUSH RSI; PUSH RDI
        if scale_slot > 0 {
            mc_load_rax(c, scale_slot, 0)
            mc_b4(c, 0x66, 0x48, 0x0F, 0x6E); mc_b1(c, 0xC0)
            mc_b4(c, 0xF2, 0x0F, 0x5A, 0xC0) // XMM0.x = scale_f32 (pure SSE2!)
            if okind == 4 {
                mc_b4(c, 0x66, 0x0F, 0x7E, 0xC0) // MOVD EAX, XMM0
                mc_b1(c, 0x35); mc_u32(c, 0x80000000) // XOR EAX, signbit
                mc_b4(c, 0x66, 0x0F, 0x6E, 0xC0) // MOVD XMM0, EAX
            }
        } else {
            if okind == 5 {
                mc_b1(c, 0xB8); mc_u32(c, 0xBF800000) // -1.0f32
            } else {
                mc_b1(c, 0xB8); mc_u32(c, 0x3F800000) // +1.0f32
            }
            mc_b4(c, 0x66, 0x0F, 0x6E, 0xC0)
        }

        mc_load_r8(c, tbl_slot, 0)
        mc_load_rcx(c, tbl_slot, 1)
        mc_b4(c, 0x48, 0xC1, 0xE1, 0x02) // RCX = total_bytes (cap * 4)

        if is_fma {
            mc_b3(c, 0x48, 0x89, 0xC8)
            mc_b3(c, 0x48, 0x69, 0xC0); mc_u32(c, src_col)
            mc_b3(c, 0x4C, 0x01, 0xC0)
            mc_b3(c, 0x48, 0x89, 0xC6) // RSI = src_col_ptr
        }

        mc_b3(c, 0x48, 0x89, 0xC8)
        mc_b3(c, 0x48, 0x69, 0xC0); mc_u32(c, dst_col)
        mc_b3(c, 0x4C, 0x01, 0xC0)
        mc_b3(c, 0x48, 0x89, 0xC7) // RDI = dst_col_ptr

        mc_b3(c, 0x48, 0x85, 0xC9)
        jz_done := mc_jcc32(c, 0x84)

        // Load runtime CPUID `g_simd_tier` (`0=Scalar SSE2`, `1=AVX2+FMA3`, `2=AVX-512F`) into `R9`
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x49, 0x89, 0xC1)
        mc_b2(c, 0x31, 0xC0) // RAX = 0 (byte cursor)

        // --- Tier 2: AVX-512F 512-bit EVEX (`ZMM0..ZMM2`, 64 bytes = 16 floats/iter) ---
        mc_b4(c, 0x49, 0x83, 0xF9, 0x02)
        jne_avx2 := mc_jcc32(c, 0x85)
        // `VBROADCASTSS ZMM0, XMM0` (`62 F2 7D 48 18 C0`)
        mc_b4(c, 0x62, 0xF2, 0x7D, 0x48); mc_b2(c, 0x18, 0xC0)
        z512_top := buf_len(c)
        mc_b4(c, 0x48, 0x8D, 0x50, 0x40) // LEA RDX, [RAX + 64]
        mc_b3(c, 0x48, 0x39, 0xCA)       // CMP RDX, RCX
        ja_z512_done := mc_jcc8(c, 0x77)
        // `VMOVUPS ZMM2, [RDI + RAX]` (`62 F1 7C 48 10 14 07`)
        mc_b4(c, 0x62, 0xF1, 0x7C, 0x48); mc_b3(c, 0x10, 0x14, 0x07)
        if is_fma {
            // `VMOVUPS ZMM1, [RSI + RAX]` (`62 F1 7C 48 10 0C 06`)
            mc_b4(c, 0x62, 0xF1, 0x7C, 0x48); mc_b3(c, 0x10, 0x0C, 0x06)
            // `VFMADD231PS ZMM2, ZMM1, ZMM0` (`62 F2 75 48 B8 D0`)
            mc_b4(c, 0x62, 0xF2, 0x75, 0x48); mc_b2(c, 0xB8, 0xD0)
        } else {
            // `VMULPS ZMM2, ZMM2, ZMM0` (`62 F1 68 48 59 D0`)
            mc_b4(c, 0x62, 0xF1, 0x68, 0x48); mc_b2(c, 0x59, 0xD0)
        }
        // `VMOVUPS [RDI + RAX], ZMM2` (`62 F1 7C 48 11 14 07`)
        mc_b4(c, 0x62, 0xF1, 0x7C, 0x48); mc_b3(c, 0x11, 0x14, 0x07)
        mc_b4(c, 0x48, 0x83, 0xC0, 0x40) // ADD RAX, 64
        jmp_z512 := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_z512, z512_top)
        mc_patch_jcc8(c, ja_z512_done, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77) // VZEROUPPER
        jmp_to_scalar := mc_jmp32(c)

        // --- Tier 1: AVX2 + FMA3 (`YMM0..YMM4`, 128B 4x-Unrolled + 32B Loop) ---
        mc_patch_rel32(c, jne_avx2, buf_len(c))
        mc_b4(c, 0x49, 0x83, 0xF9, 0x01)
        jb_scalar := mc_jcc32(c, 0x82)

        mc_b4(c, 0xC4, 0xE2, 0x7D, 0x18); mc_b1(c, 0xC0) // VBROADCASTSS YMM0, XMM0
        if is_fma {
            u4_top := buf_len(c)
            mc_b3(c, 0x48, 0x8D, 0x90); mc_u32(c, 128) // LEA RDX, [RAX + 128]
            mc_b3(c, 0x48, 0x39, 0xCA)
            ja_tail32 := mc_jcc32(c, 0x87)

            mc_b4(c, 0xC5, 0xFC, 0x10, 0x0C); mc_b1(c, 0x06)
            mc_b4(c, 0xC5, 0xFC, 0x10, 0x14); mc_b1(c, 0x07)
            mc_b4(c, 0xC5, 0xFC, 0x10, 0x5C); mc_b2(c, 0x06, 0x20)
            mc_b4(c, 0xC5, 0xFC, 0x10, 0x64); mc_b2(c, 0x07, 0x20)
            mc_b4(c, 0xC4, 0xE2, 0x75, 0xB8); mc_b1(c, 0xD0)
            mc_b4(c, 0xC4, 0xE2, 0x65, 0xB8); mc_b1(c, 0xE0)
            mc_b4(c, 0xC5, 0xFC, 0x11, 0x14); mc_b1(c, 0x07)
            mc_b4(c, 0xC5, 0xFC, 0x11, 0x64); mc_b2(c, 0x07, 0x20)

            mc_b4(c, 0xC5, 0xFC, 0x10, 0x4C); mc_b2(c, 0x06, 0x40)
            mc_b4(c, 0xC5, 0xFC, 0x10, 0x54); mc_b2(c, 0x07, 0x40)
            mc_b4(c, 0xC5, 0xFC, 0x10, 0x5C); mc_b2(c, 0x06, 0x60)
            mc_b4(c, 0xC5, 0xFC, 0x10, 0x64); mc_b2(c, 0x07, 0x60)
            mc_b4(c, 0xC4, 0xE2, 0x75, 0xB8); mc_b1(c, 0xD0)
            mc_b4(c, 0xC4, 0xE2, 0x65, 0xB8); mc_b1(c, 0xE0)
            mc_b4(c, 0xC5, 0xFC, 0x11, 0x54); mc_b2(c, 0x07, 0x40)
            mc_b4(c, 0xC5, 0xFC, 0x11, 0x64); mc_b2(c, 0x07, 0x60)

            mc_b2(c, 0x48, 0x05); mc_u32(c, 128)
            jmp_u4 := mc_jmp32(c)
            mc_patch_rel32(c, jmp_u4, u4_top)

            mc_patch_rel32(c, ja_tail32, buf_len(c))
            simd_top := buf_len(c)
            mc_b4(c, 0x48, 0x8D, 0x50, 0x20)
            mc_b3(c, 0x48, 0x39, 0xCA)
            ja_avxd := mc_jcc8(c, 0x77)
            mc_b4(c, 0xC5, 0xFC, 0x10, 0x0C); mc_b1(c, 0x06)
            mc_b4(c, 0xC5, 0xFC, 0x10, 0x14); mc_b1(c, 0x07)
            mc_b4(c, 0xC4, 0xE2, 0x75, 0xB8); mc_b1(c, 0xD0)
            mc_b4(c, 0xC5, 0xFC, 0x11, 0x14); mc_b1(c, 0x07)
            mc_b4(c, 0x48, 0x83, 0xC0, 0x20)
            jb_top := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, jb_top, simd_top)
            mc_patch_jcc8(c, ja_avxd, buf_len(c))
        } else {
            simd_top := buf_len(c)
            mc_b4(c, 0x48, 0x8D, 0x50, 0x20)
            mc_b3(c, 0x48, 0x39, 0xCA)
            ja_avxd2 := mc_jcc8(c, 0x77)
            mc_b4(c, 0xC5, 0xFC, 0x10, 0x14); mc_b1(c, 0x07)
            mc_b4(c, 0xC5, 0xEC, 0x59, 0xD0)
            mc_b4(c, 0xC5, 0xFC, 0x11, 0x14); mc_b1(c, 0x07)
            mc_b4(c, 0x48, 0x83, 0xC0, 0x20)
            jb_top2 := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, jb_top2, simd_top)
            mc_patch_jcc8(c, ja_avxd2, buf_len(c))
        }
        mc_b3(c, 0xC5, 0xF8, 0x77) // VZEROUPPER

        // --- Tier 0 & Exact Tail: Pure SSE2 4-byte Scalar Loop (`while RAX < RCX`) ---
        mc_patch_rel32(c, jmp_to_scalar, buf_len(c))
        mc_patch_rel32(c, jb_scalar, buf_len(c))
        sc_top := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC8)
        jae_sc_done := mc_jcc8(c, 0x73)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x14); mc_b1(c, 0x07) // MOVSS XMM2, [RDI+RAX]
        if is_fma {
            mc_b4(c, 0xF3, 0x0F, 0x10, 0x0C); mc_b1(c, 0x06) // MOVSS XMM1, [RSI+RAX]
            mc_b4(c, 0xF3, 0x0F, 0x59, 0xC8)                 // MULSS XMM1, XMM0
            mc_b4(c, 0xF3, 0x0F, 0x58, 0xD1)                 // ADDSS XMM2, XMM1
        } else {
            mc_b4(c, 0xF3, 0x0F, 0x59, 0xD0)                 // MULSS XMM2, XMM0
        }
        mc_b4(c, 0xF3, 0x0F, 0x11, 0x14); mc_b1(c, 0x07) // MOVSS [RDI+RAX], XMM2
        mc_b4(c, 0x48, 0x83, 0xC0, 0x04)
        jmp_sc := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_sc, sc_top)
        mc_patch_jcc8(c, jae_sc_done, buf_len(c))

        mc_patch_rel32(c, jz_done, buf_len(c))
        mc_b2(c, 0x5F, 0x5E) // POP RDI; POP RSI
        oi += 1
    }
}

// Multi-Core OS-Thread Pool `par_for p in table` Emitter (`CreateThread` + `WaitForMultipleObjects` + `h_par_soa_worker`)!
fn emit_par_soa_foreach_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, fe_nid: i64) {
    plan_off := ast_get(cg.nodes, fe_nid, 5)
    if plan_off <= 0 or not cg_is_win64(cg) {
        emit_soa_simd_foreach_ax(cg, vars, drops, breaks, fe_nid)
        return
    }
    c := cg.code
    // Check `g_cpu_threads > 1` at runtime; if 1 core, run single-thread SIMD directly
    cg_mov_rax_data(cg, data_off_cpu_threads())
    mc_b4(c, 0x48, 0x83, 0xF8, 0x01)
    jle_single1 := mc_jcc32(c, 0x8E)

    tr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, fe_nid, 3))
    tbl_slot := er_slot(tr)
    mc_load_rax(c, tbl_slot, 1)
    mc_b2(c, 0x48, 0x3D); mc_u32(c, 4096)
    jb_single2 := mc_jcc32(c, 0x82)

    h_arr := cg_alloc_slots(cg, 16)
    h_lowest := h_arr + 15
    nt_slot := cg_alloc_slots(cg, 1)
    chunk_slot := cg_alloc_slots(cg, 1)
    tid_slot := cg_alloc_slots(cg, 1)

    cg_mov_rax_data(cg, data_off_cpu_threads())
    mc_store_rax(c, nt_slot, 0)
    mc_b3(c, 0x48, 0x89, 0xC1)
    mc_load_rax(c, tbl_slot, 1)
    mc_b2(c, 0x48, 0x99)
    mc_b3(c, 0x48, 0xF7, 0xF9) // RAX = N / T
    mc_store_rax(c, chunk_slot, 0)

    ops_cnt := ibuf_get(cg.extra, plan_off + 1)
    mut oi := 0
    while oi < ops_cnt {
        obase := plan_off + 2 + oi * 4
        okind := ibuf_get(cg.extra, obase)
        dst_col := ibuf_get(cg.extra, obase + 1)
        src_col := ibuf_get(cg.extra, obase + 2)
        scale_e := ibuf_get(cg.extra, obase + 3)

        mut scale_slot := 0
        if scale_e > 0 {
            sr := emit_expr_ax(cg, vars, drops, breaks, scale_e)
            scale_slot = er_slot(sr)
        }

        // Populate `.data + 0x40` (`src_col_ptr`, `dst_col_ptr`, `scale_f32`, `op_kind`, `[start, end] * T`)
        cg_lea_rax_data(cg, 0)
        mc_b3(c, 0x49, 0x89, 0xC2) // R10 = .data base

        mc_load_r8(c, tbl_slot, 0)
        mc_load_rcx(c, tbl_slot, 1)
        mc_b4(c, 0x48, 0xC1, 0xE1, 0x02) // RCX = N * 4
        mc_b3(c, 0x48, 0x89, 0xC8)
        mc_b3(c, 0x48, 0x69, 0xC0); mc_u32(c, src_col)
        mc_b3(c, 0x4C, 0x01, 0xC0)
        mc_b4(c, 0x49, 0x89, 0x42, 0x40) // [R10 + 0x40] = src_col_ptr

        mc_b3(c, 0x48, 0x89, 0xC8)
        mc_b3(c, 0x48, 0x69, 0xC0); mc_u32(c, dst_col)
        mc_b3(c, 0x4C, 0x01, 0xC0)
        mc_b4(c, 0x49, 0x89, 0x42, 0x48) // [R10 + 0x48] = dst_col_ptr

        if scale_slot > 0 {
            mc_f64_slot_to_f32_eax(c, scale_slot)
            if okind == 4 {
                mc_b1(c, 0x35); mc_u32(c, 0x80000000)
            }
        } else {
            if okind == 5 {
                mc_b1(c, 0xB8); mc_u32(c, 0xBF800000)
            } else {
                mc_b1(c, 0xB8); mc_u32(c, 0x3F800000)
            }
        }
        mc_b3(c, 0x48, 0x89, 0xC1) // RCX = scale_f32_bits
        cg_lea_rax_data(cg, 0)
        mc_b4(c, 0x48, 0x89, 0x48, 0x50) // [.data + 0x50] = scale_f32_bits
        mut eff_okind := okind
        if okind == 4 or okind == 5 { eff_okind = 1 }
        mc_mov_rax_imm(c, eff_okind)
        mc_b3(c, 0x48, 0x89, 0xC1)
        cg_lea_rax_data(cg, 0)
        mc_b4(c, 0x48, 0x89, 0x48, 0x58) // [.data + 0x58] = okind

        // Spawn `tid = 0 .. T - 1` OS threads
        mc_mov_rax_imm(c, 0); mc_store_rax(c, tid_slot, 0)
        sp_top := buf_len(c)
        mc_load_rax(c, tid_slot, 0)
        mc_cmp_rax_slot(c, nt_slot, 0)
        jge_sp_done := mc_jcc32(c, 0x8D)

        // Compute `start = tid * chunk`, `end = (tid + 1 == T) ? N : (tid + 1) * chunk`
        mc_load_rax(c, tid_slot, 0)
        mc_load_rcx(c, chunk_slot, 0)
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1) // RAX = start
        mc_b3(c, 0x49, 0x89, 0xC0)       // R8  = start
        mc_b3(c, 0x48, 0x01, 0xC8)       // RAX = start + chunk
        mc_b3(c, 0x49, 0x89, 0xC1)       // R9  = end
        mc_load_rax(c, tid_slot, 0)
        mc_b3(c, 0x48, 0xFF, 0xC0)
        mc_cmp_rax_slot(c, nt_slot, 0)
        jne_not_last := mc_jcc8(c, 0x75)
        mc_load_r9(c, tbl_slot, 1)       // last thread takes exact `N`
        mc_patch_jcc8(c, jne_not_last, buf_len(c))

        cg_lea_rax_data(cg, 0x60)
        mc_load_rcx(c, tid_slot, 0)
        mc_b4(c, 0x48, 0xC1, 0xE1, 0x04) // tid * 16
        mc_b3(c, 0x48, 0x01, 0xC8)
        mc_b3(c, 0x4C, 0x89, 0x00)       // [ctx + tid*16] = start
        mc_b4(c, 0x4C, 0x89, 0x48, 0x08) // [ctx + tid*16 + 8] = end

        // `CreateThread(NULL, 0, h_par_soa_worker, tid, 0, NULL)`
        mc_b4(c, 0x48, 0x83, 0xEC, 0x30)
        mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 0x20); mc_u32(c, 0)
        mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 0x28); mc_u32(c, 0)
        cg_lea_rax_fn(cg, h_par_soa_worker())
        mc_b3(c, 0x49, 0x89, 0xC0)       // R8 = lpStartAddress
        mc_load_r9(c, tid_slot, 0)       // R9 = tid
        mc_b2(c, 0x31, 0xC9)             // RCX = NULL
        mc_b2(c, 0x31, 0xD2)             // RDX = 0
        cg_call_iat(cg, iat_create_thread())
        mc_b4(c, 0x48, 0x83, 0xC4, 0x30)

        mc_b3(c, 0x49, 0x89, 0xC0) // R8 = thread_handle
        mc_lea_rax(c, h_lowest, 0)
        mc_load_rcx(c, tid_slot, 0)
        mc_b4(c, 0x4C, 0x89, 0x04, 0xC8) // handles[tid] = handle

        mc_load_rax(c, tid_slot, 0); mc_b3(c, 0x48, 0xFF, 0xC0); mc_store_rax(c, tid_slot, 0)
        jmp_sp := mc_jmp32(c); mc_patch_rel32(c, jmp_sp, sp_top)
        mc_patch_rel32(c, jge_sp_done, buf_len(c))

        // `WaitForMultipleObjects(T, &handles[0], TRUE, INFINITE)`
        mc_lea_rax(c, h_lowest, 0)
        mc_b3(c, 0x48, 0x89, 0xC2) // RDX = lpHandles
        mc_load_rcx(c, nt_slot, 0) // ECX = nCount
        mc_b3(c, 0x41, 0xB8, 0x01); mc_b3(c, 0x00, 0x00, 0x00) // R8D = 1 (TRUE)
        mc_b2(c, 0x41, 0xB9); mc_u32(c, 0xFFFFFFFF)            // R9D = INFINITE
        mc_b4(c, 0x48, 0x83, 0xEC, 0x20)
        cg_call_iat(cg, iat_wait_multiple())
        mc_b4(c, 0x48, 0x83, 0xC4, 0x20)

        // Close all `T` thread handles
        mc_mov_rax_imm(c, 0); mc_store_rax(c, tid_slot, 0)
        cl_top := buf_len(c)
        mc_load_rax(c, tid_slot, 0)
        mc_cmp_rax_slot(c, nt_slot, 0)
        jge_cl_done := mc_jcc8(c, 0x7D)
        mc_lea_rax(c, h_lowest, 0)
        mc_load_rcx(c, tid_slot, 0)
        mc_b4(c, 0x48, 0x8B, 0x0C, 0xC8)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x20)
        cg_call_iat(cg, iat_close_handle())
        mc_b4(c, 0x48, 0x83, 0xC4, 0x20)
        mc_load_rax(c, tid_slot, 0); mc_b3(c, 0x48, 0xFF, 0xC0); mc_store_rax(c, tid_slot, 0)
        jmp_cl := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_cl, cl_top)
        mc_patch_jcc8(c, jge_cl_done, buf_len(c))

        oi += 1
    }
    jmp_par_end := mc_jmp32(c)

    mc_patch_rel32(c, jle_single1, buf_len(c))
    mc_patch_rel32(c, jb_single2, buf_len(c))
    emit_soa_simd_foreach_ax(cg, vars, drops, breaks, fe_nid)
    mc_patch_rel32(c, jmp_par_end, buf_len(c))
}

// Polyhedral Register-Tiled (`YMM1..YMM8` = 64 floats / 256B per tile) Temporal AVX2 FMA3 Engine.
fn emit_temporal_tiled_simd_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, while_nid: i64, fe_nid: i64) {
    plan_off := ast_get(cg.nodes, fe_nid, 5)
    if plan_off <= 0 {
        return
    }
    cond := ast_get(cg.nodes, while_nid, 1)
    s_id := ast_get(cg.nodes, cond, 2)
    steps_e := ast_get(cg.nodes, cond, 3)
    svb := cg_var_find(cg.pool, vars, ast_get(cg.nodes, s_id, 1), ast_get(cg.nodes, s_id, 2))
    if svb < 0 {
        return
    }
    s_slot := ibuf_get(vars, svb + 2)
    c := cg.code

    steps_r := emit_expr_ax(cg, vars, drops, breaks, steps_e)
    steps_slot := er_slot(steps_r)
    trip_slot := cg_alloc_slots(cg, 1)

    mc_load_rax(c, steps_slot, 0)
    mc_load_rcx(c, s_slot, 0)
    mc_b3(c, 0x48, 0x29, 0xC8)
    mc_b3(c, 0x48, 0x85, 0xC0)
    jle_skip := mc_jcc32(c, 0x8E)
    mc_store_rax(c, trip_slot, 0)

    tr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, fe_nid, 3))
    tbl_slot := er_slot(tr)

    ops_cnt := ibuf_get(cg.extra, plan_off + 1)
    mut oi := 0
    while oi < ops_cnt {
        obase := plan_off + 2 + oi * 4
        dst_col := ibuf_get(cg.extra, obase + 1)
        src_col := ibuf_get(cg.extra, obase + 2)
        scale_e := ibuf_get(cg.extra, obase + 3)

        mut scale_slot := 0
        if scale_e > 0 {
            sr := emit_expr_ax(cg, vars, drops, breaks, scale_e)
            scale_slot = er_slot(sr)
        }

        mc_b2(c, 0x56, 0x57)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x30)
        mc_b4(c, 0xC5, 0xFA, 0x7F, 0x34); mc_b1(c, 0x24)
        mc_b4(c, 0xC5, 0xFA, 0x7F, 0x7C); mc_b2(c, 0x24, 0x10)
        mc_b4(c, 0xC5, 0x7A, 0x7F, 0x44); mc_b2(c, 0x24, 0x20)

        if scale_slot > 0 {
            mc_load_rax(c, scale_slot, 0)
            mc_b4(c, 0x66, 0x48, 0x0F, 0x6E); mc_b1(c, 0xC0)
            mc_b4(c, 0xF2, 0x0F, 0x5A, 0xC0)
        } else {
            mc_b1(c, 0xB8); mc_u32(c, 0x3F800000)
            mc_b4(c, 0x66, 0x0F, 0x6E, 0xC0)
        }
        mc_b4(c, 0xC4, 0xE2, 0x7D, 0x18); mc_b1(c, 0xC0)

        mc_load_rax(c, trip_slot, 0)
        mc_b3(c, 0x49, 0x89, 0xC2)

        mc_load_rax(c, tbl_slot, 0)
        mc_b3(c, 0x49, 0x89, 0xC3)
        mc_load_rcx(c, tbl_slot, 1)
        mc_b4(c, 0x48, 0xC1, 0xE1, 0x02)

        mc_b3(c, 0x48, 0x89, 0xC8)
        mc_b3(c, 0x48, 0x69, 0xC0); mc_u32(c, src_col)
        mc_b3(c, 0x4C, 0x01, 0xD8)
        mc_b3(c, 0x49, 0x89, 0xC0)

        mc_b3(c, 0x48, 0x89, 0xC8)
        mc_b3(c, 0x48, 0x69, 0xC0); mc_u32(c, dst_col)
        mc_b3(c, 0x4C, 0x01, 0xD8)
        mc_b3(c, 0x49, 0x89, 0xC1)

        mc_b2(c, 0x31, 0xC0)
        mc_b3(c, 0x48, 0x85, 0xC9)
        jz_op_done := mc_jcc32(c, 0x84)

        tile256_top := buf_len(c)
        mc_b3(c, 0x48, 0x8D, 0x90); mc_u32(c, 256)
        mc_b3(c, 0x48, 0x39, 0xCA)
        ja_tail32 := mc_jcc32(c, 0x87)

        mc_b3(c, 0x4C, 0x89, 0xC6)
        mc_b3(c, 0x48, 0x01, 0xC6)
        mc_b3(c, 0x48, 0x8D, 0x96); mc_u32(c, 128)
        mc_b3(c, 0x4C, 0x89, 0xCF)
        mc_b3(c, 0x48, 0x01, 0xC7)

        mc_b4(c, 0xC5, 0xFC, 0x10, 0x0F)
        mc_b4(c, 0xC5, 0xFC, 0x10, 0x57); mc_b1(c, 0x20)
        mc_b4(c, 0xC5, 0xFC, 0x10, 0x5F); mc_b1(c, 0x40)
        mc_b4(c, 0xC5, 0xFC, 0x10, 0x67); mc_b1(c, 0x60)
        mc_b4(c, 0xC5, 0xFC, 0x10, 0xAF); mc_u32(c, 128)
        mc_b4(c, 0xC5, 0xFC, 0x10, 0xB7); mc_u32(c, 160)
        mc_b4(c, 0xC5, 0xFC, 0x10, 0xBF); mc_u32(c, 192)
        mc_b4(c, 0xC5, 0x7C, 0x10, 0x87); mc_u32(c, 224)

        mc_b3(c, 0x4D, 0x89, 0xD3)
        step_top := buf_len(c)
        mc_b4(c, 0xC4, 0xE2, 0x7D, 0xB8); mc_b1(c, 0x0E)
        mc_b4(c, 0xC4, 0xE2, 0x7D, 0xB8); mc_b2(c, 0x56, 0x20)
        mc_b4(c, 0xC4, 0xE2, 0x7D, 0xB8); mc_b2(c, 0x5E, 0x40)
        mc_b4(c, 0xC4, 0xE2, 0x7D, 0xB8); mc_b2(c, 0x66, 0x60)
        mc_b4(c, 0xC4, 0xE2, 0x7D, 0xB8); mc_b1(c, 0x2A)
        mc_b4(c, 0xC4, 0xE2, 0x7D, 0xB8); mc_b2(c, 0x72, 0x20)
        mc_b4(c, 0xC4, 0xE2, 0x7D, 0xB8); mc_b2(c, 0x7A, 0x40)
        mc_b4(c, 0xC4, 0x62, 0x7D, 0xB8); mc_b2(c, 0x42, 0x60)
        mc_b3(c, 0x49, 0xFF, 0xCB)
        jnz_step := mc_jcc8(c, 0x75)
        mc_patch_jcc8(c, jnz_step, step_top)

        mc_b4(c, 0xC5, 0xFC, 0x11, 0x0F)
        mc_b4(c, 0xC5, 0xFC, 0x11, 0x57); mc_b1(c, 0x20)
        mc_b4(c, 0xC5, 0xFC, 0x11, 0x5F); mc_b1(c, 0x40)
        mc_b4(c, 0xC5, 0xFC, 0x11, 0x67); mc_b1(c, 0x60)
        mc_b4(c, 0xC5, 0xFC, 0x11, 0xAF); mc_u32(c, 128)
        mc_b4(c, 0xC5, 0xFC, 0x11, 0xB7); mc_u32(c, 160)
        mc_b4(c, 0xC5, 0xFC, 0x11, 0xBF); mc_u32(c, 192)
        mc_b4(c, 0xC5, 0x7C, 0x11, 0x87); mc_u32(c, 224)

        mc_b2(c, 0x48, 0x05); mc_u32(c, 256)
        jmp_t256 := mc_jmp32(c)
        mc_patch_rel32(c, jmp_t256, tile256_top)

        mc_patch_rel32(c, ja_tail32, buf_len(c))
        tail32_top := buf_len(c)
        mc_b4(c, 0x48, 0x8D, 0x50, 0x20)
        mc_b3(c, 0x48, 0x39, 0xCA)
        ja_tail4 := mc_jcc8(c, 0x77)
        mc_b3(c, 0x4C, 0x89, 0xC6)
        mc_b3(c, 0x48, 0x01, 0xC6)
        mc_b3(c, 0x4C, 0x89, 0xCF)
        mc_b3(c, 0x48, 0x01, 0xC7)
        mc_b4(c, 0xC5, 0xFC, 0x10, 0x0F)
        mc_b3(c, 0x4D, 0x89, 0xD3)
        t32_step := buf_len(c)
        mc_b4(c, 0xC4, 0xE2, 0x7D, 0xB8); mc_b1(c, 0x0E)
        mc_b3(c, 0x49, 0xFF, 0xCB)
        jnz_t32 := mc_jcc8(c, 0x75)
        mc_patch_jcc8(c, jnz_t32, t32_step)
        mc_b4(c, 0xC5, 0xFC, 0x11, 0x0F)
        mc_b4(c, 0x48, 0x83, 0xC0, 0x20)
        jmp_t32 := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_t32, tail32_top)

        mc_patch_jcc8(c, ja_tail4, buf_len(c))
        tail4_top := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC8)
        jae_done := mc_jcc8(c, 0x73)
        mc_b3(c, 0x4C, 0x89, 0xC6)
        mc_b3(c, 0x48, 0x01, 0xC6)
        mc_b3(c, 0x4C, 0x89, 0xCF)
        mc_b3(c, 0x48, 0x01, 0xC7)
        mc_b4(c, 0xC5, 0xFA, 0x10, 0x0E)
        mc_b4(c, 0xC5, 0xFA, 0x10, 0x17)
        mc_b3(c, 0x4D, 0x89, 0xD3)
        t4_step := buf_len(c)
        mc_b4(c, 0xC4, 0xE2, 0x79, 0xB9); mc_b1(c, 0xD1)
        mc_b3(c, 0x49, 0xFF, 0xCB)
        jnz_t4 := mc_jcc8(c, 0x75)
        mc_patch_jcc8(c, jnz_t4, t4_step)
        mc_b4(c, 0xC5, 0xFA, 0x11, 0x17)
        mc_b4(c, 0x48, 0x83, 0xC0, 0x04)
        jmp_t4 := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_t4, tail4_top)

        mc_patch_jcc8(c, jae_done, buf_len(c))
        mc_patch_rel32(c, jz_op_done, buf_len(c))

        mc_b4(c, 0xC5, 0xFA, 0x6F, 0x34); mc_b1(c, 0x24)
        mc_b4(c, 0xC5, 0xFA, 0x6F, 0x7C); mc_b2(c, 0x24, 0x10)
        mc_b4(c, 0xC5, 0x7A, 0x6F, 0x44); mc_b2(c, 0x24, 0x20)
        mc_b4(c, 0x48, 0x83, 0xC4, 0x30)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_b2(c, 0x5F, 0x5E)
        oi += 1
    }

    mc_load_rax(c, steps_slot, 0)
    mc_store_rax(c, s_slot, 0)
    mc_patch_rel32(c, jle_skip, buf_len(c))
}

fn emit_stmt_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, snid: i64) {
    c := cg.code
    k := ast_kind(cg.nodes, snid)

    if k == nk_comptime_block() {
        return
    }

    if k == nk_var_decl() {
        vsoff := ast_get(cg.nodes, snid, 1)
        vslen := ast_get(cg.nodes, snid, 2)
        ty_nid := ast_get(cg.nodes, snid, 4)
        init_e := ast_get(cg.nodes, snid, 5)
        ptag := ast_get(cg.nodes, snid, 6)
        donor_nid := ptag >> 2
        need_drop := ptag & 1

        // Perceus Linear FBIP & Loop Self-FBIP (`donor_nid == snid`) Zero-Syscall In-Place Reuse
        if donor_nid > 0 {
            mut donor_slot := 0
            mut self_reuse := false
            if donor_nid == snid {
                self_reuse = true
            } else {
                dvb := cg_var_find_by_nid(vars, donor_nid)
                if dvb >= 0 {
                    donor_slot = ibuf_get(vars, dvb + 2)
                }
            }
            if self_reuse or donor_slot > 0 {
                ik := ast_kind(cg.nodes, init_e)
                if ik == nk_call() {
                    cs := ast_get(cg.nodes, init_e, 1)
                    cl := ast_get(cg.nodes, init_e, 2)
                    aoff := ast_get(cg.nodes, init_e, 3)
                    acnt := ast_get(cg.nodes, init_e, 4)
                    if (pool_str_eq_lit(cg.pool, cs, cl, "buf_new") or pool_str_eq_lit(cg.pool, cs, cl, "ibuf_new")) and acnt == 1 {
                        cr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
                        cap_slot := er_slot(cr)
                        dst_slot := cg_alloc_slots(cg, 1)
                        if self_reuse {
                            donor_slot = dst_slot
                        }

                        mc_load_r8(c, donor_slot, 0)
                        mc_mov_rax_imm(c, 0)
                        mc_store_rax(c, donor_slot, 0)

                        mc_load_rcx(c, cap_slot, 0)
                        mc_b3(c, 0x4D, 0x85, 0xC0)
                        jz_slow := mc_jcc32(c, 0x84)
                        mc_b4(c, 0x49, 0x3B, 0x48, 0x08)
                        ja_free := mc_jcc32(c, 0x87)

                        mc_b3(c, 0x49, 0xC7, 0x00)
                        mc_u32(c, 0)
                        mc_b3(c, 0x4C, 0x89, 0xC0)
                        jmp_done := mc_jmp32(c)

                        mc_patch_rel32(c, ja_free, buf_len(c))
                        mc_b3(c, 0x4C, 0x89, 0xC1)
                        emit_free_raw_rcx(cg)

                        mc_patch_rel32(c, jz_slow, buf_len(c))
                        fr := emit_expr_ax(cg, vars, drops, breaks, init_e)
                        mc_load_rax(c, er_slot(fr), 0)

                        mc_patch_rel32(c, jmp_done, buf_len(c))
                        mc_store_rax(c, dst_slot, 0)

                        mut bty := ty_intbuf()
                        if pool_str_eq_lit(cg.pool, cs, cl, "buf_new") { bty = ty_bytebuf() }
                        ibuf_push(vars, vsoff)
                        ibuf_push(vars, vslen)
                        ibuf_push(vars, dst_slot)
                        ibuf_push(vars, bty)
                        ibuf_push(vars, snid)
                        if need_drop == 1 {
                            ibuf_push(drops, dst_slot)
                        }
                        return
                    }
                } else if ik == nk_table_alloc() {
                    cr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, init_e, 3))
                    cap_slot := er_slot(cr)
                    dst_slot := cg_alloc_slots(cg, 2)
                    if self_reuse {
                        donor_slot = dst_slot
                    }

                    mc_load_r8(c, donor_slot, 0)
                    mc_load_r9(c, donor_slot, 1)
                    mc_mov_rax_imm(c, 0)
                    mc_store_rax(c, donor_slot, 0)

                    mc_load_rcx(c, cap_slot, 0)
                    mc_b3(c, 0x4D, 0x85, 0xC0)
                    jz_slow := mc_jcc32(c, 0x84)
                    mc_b3(c, 0x4C, 0x39, 0xC9)
                    ja_free := mc_jcc32(c, 0x87)

                    mc_b3(c, 0x4C, 0x89, 0xC0)
                    jmp_done := mc_jmp32(c)

                    mc_patch_rel32(c, ja_free, buf_len(c))
                    mc_b3(c, 0x4C, 0x89, 0xC1)
                    emit_free_raw_rcx(cg)

                    mc_patch_rel32(c, jz_slow, buf_len(c))
                    fr := emit_expr_ax(cg, vars, drops, breaks, init_e)
                    mc_load_rax(c, er_slot(fr), 0)

                    mc_patch_rel32(c, jmp_done, buf_len(c))
                    mc_store_rax(c, dst_slot, 0)
                    mc_load_rax(c, cap_slot, 0)
                    mc_store_rax(c, dst_slot, 1)

                    tty := er_ty(fr)
                    ibuf_push(vars, vsoff)
                    ibuf_push(vars, vslen)
                    ibuf_push(vars, dst_slot)
                    ibuf_push(vars, tty)
                    ibuf_push(vars, snid)
                    if need_drop == 1 {
                        ibuf_push(drops, dst_slot)
                    }
                    return
                }
            }
        }

        saved_slot := ibuf_get(cg.state, 4)
        saved_drops := ibuf_len(drops)
        ir := emit_expr_ax(cg, vars, drops, breaks, init_e)
        mut init_slot := er_slot(ir)
        inferred_ty := er_ty(ir)
        mut final_ty := inferred_ty
        if ty_nid > 0 {
            ibuf_set(cg.sym, 13, ty_nid)
            final_ty = resolve_typespec(cg.pool, cg.nodes, cg.extra, cg.sym)
        }
        if ty_tag(final_ty) == 11 and ty_tag(inferred_ty) == 10 {
            p_slots := type_slots(cg.sym, final_ty)
            s_slots := type_slots(cg.sym, inferred_ty)
            packed := cg_alloc_slots(cg, p_slots)
            mc_mov_rax_imm(c, ty_pay(inferred_ty) + 1)
            mc_store_rax(c, packed, 0)
            mut u := 0
            while u < s_slots {
                if 1 + u < p_slots {
                    mc_load_rax(c, init_slot, u)
                    mc_store_rax(c, packed, 1 + u)
                }
                u += 1
            }
            init_slot = packed
        }
        slots := type_slots(cg.sym, final_ty)
        mut dst_slot := 0
        if ibuf_len(drops) == saved_drops {
            dst_slot = saved_slot + 1
            next_s := saved_slot + slots
            ibuf_set(cg.state, 4, next_s)
            if next_s > ibuf_get(cg.state, 14) {
                ibuf_set(cg.state, 14, next_s)
            }
        } else {
            dst_slot = cg_alloc_slots(cg, slots)
        }
        if dst_slot != init_slot {
            mut s := 0
            while s < slots {
                mc_load_rax(c, init_slot, s)
                mc_store_rax(c, dst_slot, s)
                s += 1
            }
        }
        ibuf_push(vars, vsoff)
        ibuf_push(vars, vslen)
        ibuf_push(vars, dst_slot)
        ibuf_push(vars, final_ty)
        ibuf_push(vars, snid)
        if need_drop == 1 {
            ibuf_push(drops, dst_slot)
        }
        return
    }

    if k == nk_tuple_destruct() {
        noff := ast_get(cg.nodes, snid, 1)
        ncnt := ast_get(cg.nodes, snid, 2)
        ir := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, snid, 3))
        islot := er_slot(ir)
        ity := er_ty(ir)
        mut cur_off := 0
        mut i := 0
        while i < ncnt {
            ns_off := ibuf_get(cg.extra, noff + i * 2)
            ns_len := ibuf_get(cg.extra, noff + i * 2 + 1)
            mut ety := ty_int()
            if ty_tag(ity) == 14 {
                doff := ty_pay(ity)
                if i < ibuf_get(cg.sym, doff) {
                    ety = ibuf_get(cg.sym, doff + 1 + i)
                }
            } else if ty_tag(ity) == 10 {
                s_off := ibuf_get(cg.sym, 3) + ty_pay(ity) * 6
                f_base := ibuf_get(cg.sym, s_off + 3)
                if i < ibuf_get(cg.sym, s_off + 4) {
                    ety = ibuf_get(cg.sym, f_base + i * 4 + 3)
                }
            }
            eslots := type_slots(cg.sym, ety)
            vslot := cg_alloc_slots(cg, eslots)
            mut s := 0
            while s < eslots {
                mc_load_rax(c, islot, cur_off + s)
                mc_store_rax(c, vslot, s)
                s += 1
            }
            cur_off += eslots
            ibuf_push(vars, ns_off)
            ibuf_push(vars, ns_len)
            ibuf_push(vars, vslot)
            ibuf_push(vars, ety)
            ibuf_push(vars, snid)
            i += 1
        }
        return
    }

    if k == nk_assign() {
        saved_slot := ibuf_get(cg.state, 4)
        saved_drops := ibuf_len(drops)
        aop := ast_get(cg.nodes, snid, 1)
        tgt := ast_get(cg.nodes, snid, 2)
        rhs := ast_get(cg.nodes, snid, 3)
        lv := resolve_lval_ax(cg, vars, tgt)
        if lv != 0 {
            bslot := ushr64(lv, 44)
            sub_off := (ushr64(lv, 32)) & 0xFFF
            lty := lv & 0xFFFFFFFF
            if (aop == aop_add() or aop == aop_sub()) and lty == ty_int() and ibuf_get(cg.state, 0) == 0 and is_nonshadowed_const_int(cg, vars, rhs) {
                imm := eval_const_int_val(cg.pool, cg.nodes, cg.sym, rhs)
                if imm == 1 {
                    mc_load_rax(c, bslot, sub_off)
                    if aop == aop_add() { mc_b3(c, 0x48, 0xFF, 0xC0) }
                    else { mc_b3(c, 0x48, 0xFF, 0xC8) }
                    mc_store_rax(c, bslot, sub_off)
                    return
                }
            }
            if aop == aop_eq() and (lty == ty_int() or lty == ty_bool()) and is_nonshadowed_const_int(cg, vars, rhs) {
                mc_mov_rax_imm(c, eval_const_int_val(cg.pool, cg.nodes, cg.sym, rhs))
                mc_store_rax(c, bslot, sub_off)
                return
            }
            rr := emit_expr_ax(cg, vars, drops, breaks, rhs)
            rslot := er_slot(rr)
            slots := type_slots(cg.sym, lty)
            if aop == aop_eq() {
                mut s := 0
                while s < slots {
                    mc_load_rax(c, rslot, s)
                    mc_store_rax(c, bslot, sub_off + s)
                    s += 1
                }
            } else {
                mut bop := op_add()
                if aop == aop_sub() { bop = op_sub() }
                else if aop == aop_mul() { bop = op_mul() }
                else if aop == aop_div() { bop = op_div() }
                ibuf_set(cg.state, 20, span_line(ast_span(cg.nodes, snid)))
                res_s := emit_scalar_binop_ax(cg, bop, bslot, sub_off, rslot, 0, lty)
                mc_load_rax(c, res_s, 0)
                mc_store_rax(c, bslot, sub_off)
            }
            if ibuf_len(drops) == saved_drops {
                ibuf_set(cg.state, 4, saved_slot)
            }
            return
        }
        if ast_kind(cg.nodes, tgt) == nk_index() {
            tr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, tgt, 1))
            idx_nid := ast_get(cg.nodes, tgt, 2)
            ir := emit_expr_ax(cg, vars, drops, breaks, idx_nid)
            rr := emit_expr_ax(cg, vars, drops, breaks, rhs)
            tslot := er_slot(tr)
            tty := er_ty(tr)
            islot := er_slot(ir)
            rslot := er_slot(rr)
            if ty_tag(tty) == 21 {
                mc_load_rdx(c, tslot, 1)
                mc_b3(c, 0x48, 0x89, 0xD0); mc_b1(c, 0x25); mc_u32(c, 0xFFFFF)
                mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE9, 0x14); mc_b2(c, 0x81, 0xE1); mc_u32(c, 0xFFFFF)
                mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
                mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE9, 0x28); mc_b2(c, 0x81, 0xE1); mc_u32(c, 0xFFFFF)
                mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
                mc_load_rcx(c, islot, 0)
                mc_b3(c, 0x48, 0x39, 0xC1)
                cg_jmp_fn(cg, 0x83, h_sec_trap())
                mc_f64_slot_to_f32_eax(c, rslot)
                mc_load_r8(c, tslot, 0)
                mc_load_rcx(c, islot, 0)
                mc_b4(c, 0x41, 0x89, 0x04, 0x88)
            } else {
                emit_bounds_check_ax(cg, islot, tslot, idx_nid)
                mc_load_r8(c, tslot, 0)
                mc_load_rcx(c, islot, 0)
                mc_load_rax(c, rslot, 0)
                if ty_tag(tty) == 12 and ty_pay(tty) == 60001 {
                    mc_b4(c, 0x66, 0x48, 0x0F, 0x6E)
                    mc_b1(c, 0xC0)
                    mc_b4(c, 0xF2, 0x0F, 0x5A, 0xC0)
                    mc_b4(c, 0xF3, 0x41, 0x0F, 0x11)
                    mc_b2(c, 0x04, 0x88)
                } else {
                    mc_b4(c, 0x49, 0x89, 0x04, 0xC8)
                }
            }
            if ibuf_len(drops) == saved_drops {
                ibuf_set(cg.state, 4, saved_slot)
            }
        }
        return
    }

    if k == nk_if() {
        jz_pos := emit_cond_jump_false_ax(cg, vars, drops, breaks, ast_get(cg.nodes, snid, 1))
        emit_block_ax(cg, vars, drops, breaks, ast_get(cg.nodes, snid, 2))
        eb := ast_get(cg.nodes, snid, 3)
        if eb <= 0 {
            mc_patch_rel32(c, jz_pos, buf_len(c))
        } else {
            jmp_end := mc_jmp32(c)
            mc_patch_rel32(c, jz_pos, buf_len(c))
            emit_block_ax(cg, vars, drops, breaks, eb)
            mc_patch_rel32(c, jmp_end, buf_len(c))
        }
        return
    }

    if k == nk_while() {
        tplan := ast_get(cg.nodes, snid, 4)
        if (tplan & 3) == 1 {
            // Respect `--simd=scalar` (`g_simd_tier == 0`) fallback!
            cg_mov_rax_data(cg, data_off_simd_tier())
            mc_b3(c, 0x48, 0x85, 0xC0)
            jz_no_tile := mc_jcc32(c, 0x84)
            emit_temporal_tiled_simd_ax(cg, vars, drops, breaks, snid, tplan >> 2)
            jmp_after_tile := mc_jmp32(c)
            mc_patch_rel32(c, jz_no_tile, buf_len(c))
            // Scalar fallback runs normal `while` loop (`emit_soa_simd_foreach_ax` Tier 0)
            prev_c0 := ibuf_get(cg.state, 10)
            prev_b0 := ibuf_get(cg.state, 11)
            bm0 := ibuf_len(breaks)
            lt0 := buf_len(c)
            jze0 := emit_cond_jump_false_ax(cg, vars, drops, breaks, ast_get(cg.nodes, snid, 1))
            ibuf_set(cg.state, 10, lt0)
            ibuf_set(cg.state, 11, bm0)
            emit_block_ax(cg, vars, drops, breaks, ast_get(cg.nodes, snid, 2))
            jbt0 := mc_jmp32(c)
            mc_patch_rel32(c, jbt0, lt0)
            mc_patch_rel32(c, jze0, buf_len(c))
            ibuf_set(cg.state, 10, prev_c0)
            ibuf_set(cg.state, 11, prev_b0)
            mc_patch_rel32(c, jmp_after_tile, buf_len(c))
            return
        }

        prev_cont := ibuf_get(cg.state, 10)
        prev_bmark := ibuf_get(cg.state, 11)
        bmark := ibuf_len(breaks)

        loop_top := buf_len(c)
        jz_exit := emit_cond_jump_false_ax(cg, vars, drops, breaks, ast_get(cg.nodes, snid, 1))

        ibuf_set(cg.state, 10, loop_top)
        ibuf_set(cg.state, 11, bmark)
        emit_block_ax(cg, vars, drops, breaks, ast_get(cg.nodes, snid, 2))

        jb_top := mc_jmp32(c)
        mc_patch_rel32(c, jb_top, loop_top)

        exit_pos := buf_len(c)
        mc_patch_rel32(c, jz_exit, exit_pos)
        mut bi := bmark
        while bi < ibuf_len(breaks) {
            bpos := ibuf_get(breaks, bi)
            if bpos > 0 {
                mc_patch_rel32(c, bpos, exit_pos)
                ibuf_set(breaks, bi, 0)
            }
            bi += 1
        }
        ibuf_set(cg.state, 10, prev_cont)
        ibuf_set(cg.state, 11, prev_bmark)
        return
    }

    if k == nk_for_range() or k == nk_par_for_range() {
        vsoff := ast_get(cg.nodes, snid, 1)
        vslen := ast_get(cg.nodes, snid, 2)
        end_nid := ast_get(cg.nodes, snid, 4)
        sr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, snid, 3))
        er := emit_expr_ax(cg, vars, drops, breaks, end_nid)
        iv_slot := cg_alloc_slots(cg, 1)
        mc_load_rax(c, er_slot(sr), 0)
        mc_store_rax(c, iv_slot, 0)
        saved_vcnt := ibuf_len(vars) / 5
        ibuf_push(vars, vsoff)
        ibuf_push(vars, vslen)
        ibuf_push(vars, iv_slot)
        ibuf_push(vars, ty_int())
        ibuf_push(vars, snid)

        prev_el_soff := ibuf_get(cg.state, 12)
        prev_el_slen := ibuf_get(cg.state, 13)
        if ast_kind(cg.nodes, end_nid) == nk_field() and pool_str_eq_lit(cg.pool, ast_get(cg.nodes, end_nid, 2), ast_get(cg.nodes, end_nid, 3), "len") {
            ibuf_set(cg.state, 12, vsoff)
            ibuf_set(cg.state, 13, vslen)
        }

        prev_cont := ibuf_get(cg.state, 10)
        prev_bmark := ibuf_get(cg.state, 11)
        bmark := ibuf_len(breaks)

        loop_top := buf_len(c)
        mc_load_rax(c, iv_slot, 0)
        mc_cmp_rax_slot(c, er_slot(er), 0)
        jge_exit := mc_jcc32(c, 0x8D)

        ibuf_set(cg.state, 11, bmark)
        cont_tramp_jmp := mc_jmp32(c)
        cont_target := buf_len(c)
        mc_load_rax(c, iv_slot, 0)
        mc_b3(c, 0x48, 0xFF, 0xC0)
        mc_store_rax(c, iv_slot, 0)
        jb_cont := mc_jmp32(c)
        mc_patch_rel32(c, jb_cont, loop_top)
        mc_patch_rel32(c, cont_tramp_jmp, buf_len(c))

        ibuf_set(cg.state, 10, cont_target)
        emit_block_ax(cg, vars, drops, breaks, ast_get(cg.nodes, snid, 5))

        mc_load_rax(c, iv_slot, 0)
        mc_b3(c, 0x48, 0xFF, 0xC0)
        mc_store_rax(c, iv_slot, 0)
        jb_top := mc_jmp32(c)
        mc_patch_rel32(c, jb_top, loop_top)

        exit_pos := buf_len(c)
        mc_patch_rel32(c, jge_exit, exit_pos)
        mut bi := bmark
        while bi < ibuf_len(breaks) {
            bpos := ibuf_get(breaks, bi)
            if bpos > 0 {
                mc_patch_rel32(c, bpos, exit_pos)
                ibuf_set(breaks, bi, 0)
            }
            bi += 1
        }

        ibuf_set(vars, saved_vcnt * 5 + 1, -1)
        ibuf_set(cg.state, 10, prev_cont)
        ibuf_set(cg.state, 11, prev_bmark)
        ibuf_set(cg.state, 12, prev_el_soff)
        ibuf_set(cg.state, 13, prev_el_slen)
        return
    }

    if k == nk_for_each() {
        emit_soa_simd_foreach_ax(cg, vars, drops, breaks, snid)
        return
    }

    if k == nk_par_for_each() {
        emit_par_soa_foreach_ax(cg, vars, drops, breaks, snid)
        return
    }

    if k == nk_return() {
        rv := ast_get(cg.nodes, snid, 1)
        if rv > 0 {
            rr := emit_expr_ax(cg, vars, drops, breaks, rv)
            emit_return_from_slot_ax(cg, vars, drops, er_slot(rr), er_ty(rr))
        } else {
            zs := cg_alloc_slots(cg, 1)
            mc_mov_rax_imm(c, 0)
            mc_store_rax(c, zs, 0)
            emit_return_from_slot_ax(cg, vars, drops, zs, ty_unit())
        }
        return
    }

    if k == nk_break() {
        bpos := mc_jmp32(c)
        ibuf_push(breaks, bpos)
        return
    }

    if k == nk_continue() {
        ctgt := ibuf_get(cg.state, 10)
        if ctgt >= 0 {
            cpos := mc_jmp32(c)
            mc_patch_rel32(c, cpos, ctgt)
        }
        return
    }

    if k == nk_expr_stmt() {
        saved_slot := ibuf_get(cg.state, 4)
        saved_drops := ibuf_len(drops)
        emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, snid, 1))
        if ibuf_len(drops) == saved_drops {
            ibuf_set(cg.state, 4, saved_slot)
        }
    }
}

fn emit_block_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, bnid: i64) {
    if bnid <= 0 {
        return
    }
    saved_vcnt := ibuf_len(vars) / 5
    saved_slot := ibuf_get(cg.state, 4)
    saved_drops := ibuf_len(drops)
    off := ast_get(cg.nodes, bnid, 1)
    cnt := ast_get(cg.nodes, bnid, 2)
    mut i := 0
    while i < cnt {
        emit_stmt_ax(cg, vars, drops, breaks, ibuf_get(cg.extra, off + i))
        i += 1
    }
    end_vcnt := ibuf_len(vars) / 5
    mut vi := saved_vcnt
    while vi < end_vcnt {
        ibuf_set(vars, vi * 5 + 1, -1)
        vi += 1
    }
    if ibuf_len(drops) == saved_drops {
        ibuf_set(cg.state, 4, saved_slot)
    }
}

fn compile_single_fn_ax(cg: CodegenCtx, fidx: i64) {
    c := cg.code
    f_off := ibuf_get(cg.sym, 7) + fidx * 10
    fn_soff := ibuf_get(cg.sym, f_off)
    fn_slen := ibuf_get(cg.sym, f_off + 1)
    fnid := ibuf_get(cg.sym, f_off + 2)
    p_base := ibuf_get(cg.sym, f_off + 3)
    p_cnt := ibuf_get(cg.sym, f_off + 4)
    ret_ty := ibuf_get(cg.sym, f_off + 5)
    ret_slots := ibuf_get(cg.sym, f_off + 6)
    fast_abi := ibuf_get(cg.sym, f_off + 8)
    fn_flags := ibuf_get(cg.sym, f_off + 9)
    body_nid := ast_get(cg.nodes, fnid, 6) & 0xFFFFFFFF

    ibuf_set(cg.state, 3, fidx)
    ibuf_set(cg.state, 4, 0)
    ibuf_set(cg.state, 5, 0)
    ibuf_set(cg.state, 6, 0)
    ibuf_set(cg.state, 7, ret_ty)
    ibuf_set(cg.state, 8, ret_slots)
    ibuf_set(cg.state, 9, fast_abi)
    ibuf_set(cg.state, 10, -1)
    ibuf_set(cg.state, 11, 0)
    ibuf_set(cg.state, 12, 0)
    ibuf_set(cg.state, 13, 0)
    ibuf_set(cg.state, 14, 0)
    ibuf_set(cg.state, 18, fn_flags)
    ibuf_set(cg.state, 22, 0)
    ibuf_set(cg.state, 23, 0)
    ibuf_set(cg.state, 24, 0)
    ibuf_set(cg.state, 25, 0)

    pl_off := ast_get(cg.nodes, fnid, 3)
    mut rpi := 0
    while rpi < p_cnt {
        pn := ibuf_get(cg.extra, pl_off + rpi)
        if ast_kind(cg.nodes, ast_get(cg.nodes, pn, 4)) == nk_ty_refined() {
            ibuf_set(cg.state, 12, ast_get(cg.nodes, pn, 1))
            ibuf_set(cg.state, 13, ast_get(cg.nodes, pn, 2))
        }
        rpi += 1
    }

    // Prolog: `ENDBR64; PUSH RBP; MOV RBP, RSP` + 4 KB Guard-Page Stack Probe (on Win64)
    mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
    mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
    mc_b1(c, 0xB8)
    frame_imm_pos := buf_len(c)
    mc_u32(c, 0)
    if cg_is_win64(cg) {
        probe_loop := buf_len(c)
        mc_b1(c, 0x3D)
        mc_u32(c, 0x1000)
        jb_done := mc_jcc8(c, 0x72)
        mc_b3(c, 0x48, 0x81, 0xEC)
        mc_u32(c, 0x1000)
        mc_b4(c, 0x80, 0x0C, 0x24, 0x00)
        mc_b1(c, 0x2D)
        mc_u32(c, 0x1000)
        jmp_prb := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_prb, probe_loop)
        mc_patch_jcc8(c, jb_done, buf_len(c))
    }
    mc_b3(c, 0x48, 0x29, 0xC4)

    ibuf_set(cg.state, 21, 0)
    vars := ibuf_new(65536)
    drops := ibuf_new(16384)
    breaks := ibuf_new(4096)

    if fast_abi == 1 {
        mut pi := 0
        while pi < p_cnt {
            po := p_base + pi * 6
            pty := ibuf_get(cg.sym, po + 3)
            pslots := type_slots(cg.sym, pty)
            arg_off := ibuf_get(cg.sym, po + 4)
            pslot := cg_alloc_slots(cg, pslots)
            mut s := 0
            while s < pslots {
                ridx := arg_off + s
                if ridx == 0 { mc_store_rcx(c, pslot, s) }
                else if ridx == 1 { mc_store_rdx(c, pslot, s) }
                else if ridx == 2 { mc_store_r8(c, pslot, s) }
                else if ridx == 3 { mc_store_r9(c, pslot, s) }
                else if ridx == 4 { mc_store_r10(c, pslot, s) }
                else { mc_store_r11(c, pslot, s) }
                s += 1
            }
            ibuf_push(vars, ibuf_get(cg.sym, po))
            ibuf_push(vars, ibuf_get(cg.sym, po + 1))
            ibuf_push(vars, pslot)
            ibuf_push(vars, pty)
            ibuf_push(vars, 0)
            pi += 1
        }
    } else {
        ab_slot := cg_alloc_slots(cg, 1)
        rb_slot := cg_alloc_slots(cg, 1)
        ibuf_set(cg.state, 5, ab_slot)
        ibuf_set(cg.state, 6, rb_slot)
        mc_store_rcx(c, ab_slot, 0)
        mc_store_rdx(c, rb_slot, 0)

        mut pi := 0
        while pi < p_cnt {
            po := p_base + pi * 6
            pty := ibuf_get(cg.sym, po + 3)
            pslots := type_slots(cg.sym, pty)
            arg_off := ibuf_get(cg.sym, po + 4)
            lslot := cg_alloc_slots(cg, pslots)
            mc_load_r8(c, ab_slot, 0)
            mut s := 0
            while s < pslots {
                mc_r8_load_rax(c, (arg_off + s) * 8)
                mc_store_rax(c, lslot, s)
                s += 1
            }
            ibuf_push(vars, ibuf_get(cg.sym, po))
            ibuf_push(vars, ibuf_get(cg.sym, po + 1))
            ibuf_push(vars, lslot)
            ibuf_push(vars, pty)
            ibuf_push(vars, 0)
            pi += 1
        }
    }

    // Bind Symbolic & Comptime Shape Dimensions `[sym B, sym S, comptime D: usize]` directly from `Tensor` descriptors!
    moff := ushr64(ast_get(cg.nodes, fnid, 4), 16)
    if moff > 0 {
        gen_off := ibuf_get(cg.extra, moff + 7)
        gen_cnt := ibuf_get(cg.extra, moff + 8)
        mut gi := 0
        while gi < gen_cnt {
            gb := gen_off + gi * 4
            g_soff := ibuf_get(cg.extra, gb + 1)
            g_slen := ibuf_get(cg.extra, gb + 2)
            def_e := ibuf_get(cg.extra, gb + 3)
            g_slot := cg_alloc_slots(cg, 1)
            mut bound_from_tensor := false

            mut vpi := 0
            while vpi < p_cnt and not bound_from_tensor {
                vb_off := vpi * 5
                v_slot := ibuf_get(vars, vb_off + 2)
                v_ty := ibuf_get(vars, vb_off + 3)
                if ty_tag(v_ty) == 21 {
                    td := ty_pay(v_ty)
                    rank := ibuf_get(cg.sym, td + 1)
                    mut ax := 0
                    while ax < rank {
                        dk := ibuf_get(cg.sym, td + 3 + ax * 2)
                        dv := ibuf_get(cg.sym, td + 4 + ax * 2)
                        if dk == g_slen and pool_str_eq2(cg.pool, dv, g_slen, g_soff) {
                            mc_load_rax(c, v_slot, 1)
                            if ax > 0 {
                                mc_b4(c, 0x48, 0xC1, 0xE8, ax * 20)
                            }
                            mc_b1(c, 0x25); mc_u32(c, 0xFFFFF)
                            mc_store_rax(c, g_slot, 0)
                            bound_from_tensor = true
                            break
                        }
                        ax += 1
                    }
                }
                vpi += 1
            }

            if not bound_from_tensor {
                mc_mov_rax_imm(c, def_e)
                mc_store_rax(c, g_slot, 0)
            }

            ibuf_push(vars, g_soff)
            ibuf_push(vars, g_slen)
            ibuf_push(vars, g_slot)
            ibuf_push(vars, ty_int())
            ibuf_push(vars, 0)
            gi += 1
        }
    }

    // Zero all non-parameter stack slots `(param_end_slot + 1) .. max_slot` via ERMSB `REP STOSQ`
    param_end_slot := ibuf_get(cg.state, 14)
    ibuf_set(cg.state, 21, cg_alloc_slots(cg, 1))
    mc_b1(c, 0x57)
    mc_b3(c, 0x48, 0x8D, 0xBD)
    zero_disp_pos := buf_len(c)
    mc_u32(c, 0)
    mc_b1(c, 0xB9)
    zero_cnt_pos := buf_len(c)
    mc_u32(c, 0)
    mc_b2(c, 0x31, 0xC0)
    mc_b3(c, 0xF3, 0x48, 0xAB)
    mc_b1(c, 0x5F)

    if (fn_flags & fnflag_shield()) != 0 and cg_is_win64(cg) and not pool_str_eq_lit(cg.pool, fn_soff, fn_slen, "main") {
        cg_call_fn(cg, h_shield_verify())
    }

    if body_nid > 0 {
        emit_block_ax(cg, vars, drops, breaks, body_nid)
    }

    emit_perceus_drops_ax(cg, drops)
    emit_writeback_mut_params_ax(cg, vars)
    emit_wipe_secrets_ax(cg, drops)
    mc_b2(c, 0x31, 0xC0)
    mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
    mc_b1(c, 0xC3)

    max_slot := ibuf_get(cg.state, 14)
    mut zero_cnt := max_slot - param_end_slot
    if zero_cnt < 0 { zero_cnt = 0 }
    mut zero_base_slot := max_slot
    if zero_base_slot < 1 { zero_base_slot = 1 }
    buf_put_u32(c, zero_disp_pos, 0 - (zero_base_slot * 8))
    buf_put_u32(c, zero_cnt_pos, zero_cnt)

    raw_bytes := max_slot * 8 + 96
    aligned_frame := align_up(raw_bytes, 16)
    buf_put_u32(c, frame_imm_pos, aligned_frame)

    buf_free(move breaks)
    buf_free(move drops)
    buf_free(move vars)
}

// Emits a Win64 C-ABI Trampoline for `@export` / `@py_export` functions (`XMM0..3 -> GPR`, `RAX -> XMM0` for `f64`)
fn emit_c_abi_export_wrapper(cg: CodegenCtx, fni: i64) -> i64 {
    c := cg.code
    mc_align16(c)
    w_start := buf_len(c)
    f_off := ibuf_get(cg.sym, 7) + fni * 10
    p_base := ibuf_get(cg.sym, f_off + 3)
    p_cnt := ibuf_get(cg.sym, f_off + 4)
    ret_ty := ibuf_get(cg.sym, f_off + 5)
    fast_abi := ibuf_get(cg.sym, f_off + 8)

    mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
    mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
    mc_b4(c, 0x48, 0x83, 0xEC, 0x60)

    if fast_abi == 1 {
        mut pi := 0
        while pi < p_cnt and pi < 4 {
            pty := ibuf_get(cg.sym, p_base + pi * 6 + 3)
            if pty == ty_float() {
                if pi == 0 { mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC1) }      // MOVQ RCX, XMM0
                else if pi == 1 { mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xCA) } // MOVQ RDX, XMM1
                else if pi == 2 { mc_b4(c, 0x66, 0x49, 0x0F, 0x7E); mc_b1(c, 0xD0) } // MOVQ R8,  XMM2
                else { mc_b4(c, 0x66, 0x49, 0x0F, 0x7E); mc_b1(c, 0xD9) }            // MOVQ R9,  XMM3
            }
            pi += 1
        }
        cg_call_fn(cg, fni)
    } else {
        // Pack up to 4 C-ABI scalar args into `[RBP - 0x40]` arg block, `[RBP - 0x50]` ret block
        mut pi := 0
        while pi < p_cnt and pi < 4 {
            pty := ibuf_get(cg.sym, p_base + pi * 6 + 3)
            disp := (0 - 0x40 + pi * 8) & 255
            if pty == ty_float() {
                if pi == 0 { mc_b4(c, 0xF2, 0x0F, 0x11, 0x45); mc_b1(c, disp) }
                else if pi == 1 { mc_b4(c, 0xF2, 0x0F, 0x11, 0x4D); mc_b1(c, disp) }
                else if pi == 2 { mc_b4(c, 0xF2, 0x0F, 0x11, 0x55); mc_b1(c, disp) }
                else { mc_b4(c, 0xF2, 0x0F, 0x11, 0x5D); mc_b1(c, disp) }
            } else {
                if pi == 0 { mc_b4(c, 0x48, 0x89, 0x4D, disp) }
                else if pi == 1 { mc_b4(c, 0x48, 0x89, 0x55, disp) }
                else if pi == 2 { mc_b4(c, 0x4C, 0x89, 0x45, disp) }
                else { mc_b4(c, 0x4C, 0x89, 0x4D, disp) }
            }
            pi += 1
        }
        mc_b4(c, 0x48, 0x8D, 0x4D, 0xC0) // LEA RCX, [RBP - 0x40]
        mc_b4(c, 0x48, 0x8D, 0x55, 0xB0) // LEA RDX, [RBP - 0x50]
        cg_call_fn(cg, fni)
    }

    if ret_ty == ty_float() {
        mc_b4(c, 0x66, 0x48, 0x0F, 0x6E); mc_b1(c, 0xC0) // MOVQ XMM0, RAX
    }
    mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
    mc_b1(c, 0xC3)
    ibuf_push(cg.fn_ranges, w_start)
    ibuf_push(cg.fn_ranges, buf_len(c))
    return w_start
}

// Emits native `@test` runner entry point at `.text + 0` when `axc test` is invoked!
fn emit_test_runner_entry(cg: CodegenCtx) {
    c := cg.code
    s_beg := buf_len(c)
    mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
    mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
    mc_b4(c, 0x48, 0x83, 0xEC, 0x40)

    cg_call_fn(cg, h_detect_cpuid())
    if ibuf_get(cg.state, 0) == 1 and cg_is_win64(cg) {
        cg_call_fn(cg, h_shield_verify())
    }

    p_hdr := cg_intern_lit(cg, "[TEST] ")
    p_ok := cg_intern_lit(cg, " ... PASS\n")
    p_sum1 := cg_intern_lit(cg, "[PASS] All Axon @test functions passed: ")
    p_nl := cg_intern_lit(cg, "\n")

    f_base := ibuf_get(cg.sym, 7)
    f_cnt := ibuf_get(cg.sym, 8)
    mut t_cnt := 0
    mut fni := 0
    while fni < f_cnt {
        fo := f_base + fni * 10
        flags := ibuf_get(cg.sym, fo + 9)
        if (flags & fnflag_test()) != 0 {
            fn_soff := ibuf_get(cg.sym, fo)
            fn_slen := ibuf_get(cg.sym, fo + 1)
            fn_roff := cg_intern_pool_slice(cg, fn_soff, fn_slen)

            cg_lea_rax_rdata(cg, p_hdr); mc_b3(c, 0x48, 0x89, 0xC1); mc_b1(c, 0xBA); mc_u32(c, 7); cg_call_fn(cg, h_print_bytes())
            cg_lea_rax_rdata(cg, fn_roff); mc_b3(c, 0x48, 0x89, 0xC1); mc_b1(c, 0xBA); mc_u32(c, fn_slen); cg_call_fn(cg, h_print_bytes())

            if ibuf_get(cg.sym, fo + 8) == 0 {
                mc_b4(c, 0x48, 0x8D, 0x4D, 0xE0)
                mc_b4(c, 0x48, 0x8D, 0x55, 0xE0)
            }
            cg_call_fn(cg, fni)

            cg_lea_rax_rdata(cg, p_ok); mc_b3(c, 0x48, 0x89, 0xC1); mc_b1(c, 0xBA); mc_u32(c, 10); cg_call_fn(cg, h_print_bytes())
            t_cnt += 1
        }
        fni += 1
    }

    cg_lea_rax_rdata(cg, p_sum1); mc_b3(c, 0x48, 0x89, 0xC1); mc_b1(c, 0xBA); mc_u32(c, 40); cg_call_fn(cg, h_print_bytes())
    mc_b1(c, 0xB9); mc_u32(c, t_cnt); cg_call_fn(cg, h_print_i64())
    cg_lea_rax_rdata(cg, p_nl); mc_b3(c, 0x48, 0x89, 0xC1); mc_b1(c, 0xBA); mc_u32(c, 1); cg_call_fn(cg, h_print_bytes())

    cg_emit_exit_imm(cg, 0)
    ibuf_push(cg.fn_ranges, s_beg)
    ibuf_push(cg.fn_ranges, buf_len(c))
}

fn enqueue_live_fn_ax(live: IntBuf, queue: IntBuf, fidx: i64) {
    if fidx >= 0 and ibuf_get(live, fidx) == 0 {
        ibuf_set(live, fidx, 1)
        ibuf_push(queue, fidx)
    }
}

fn scan_calls_expr_ax(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, live: IntBuf, queue: IntBuf, enid: i64) {
    if enid <= 0 {
        return
    }
    k := ast_kind(nodes, enid)
    if k == nk_unary() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 2))
        return
    }
    if k == nk_cast() or k == nk_field() or k == nk_tuple_idx() or k == nk_await() or k == nk_comptime_expr() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 1))
        return
    }
    if k == nk_binary() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 2))
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 3))
        return
    }
    if k == nk_or_return() or k == nk_index() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 1))
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 2))
        return
    }
    if k == nk_table_alloc() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 3))
        return
    }
    if k == nk_tuple() or k == nk_fstr() {
        off := ast_get(nodes, enid, 1)
        cnt := ast_get(nodes, enid, 2)
        mut i := 0
        while i < cnt {
            scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ibuf_get(extra, off + i))
            i += 1
        }
        return
    }
    if k == nk_spawn() {
        scan_calls_block_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 1))
        return
    }
    if k == nk_if_expr() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 1))
        tb := ast_get(nodes, enid, 2)
        scan_calls_block_ax(pool, nodes, extra, sym, live, queue, tb)
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, tb, 3))
        eb := ast_get(nodes, enid, 3)
        if eb > 0 {
            scan_calls_block_ax(pool, nodes, extra, sym, live, queue, eb)
            scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, eb, 3))
        }
        return
    }
    if k == nk_call() {
        cs := ast_get(nodes, enid, 1)
        cl := ast_get(nodes, enid, 2)
        aoff := ast_get(nodes, enid, 3)
        acnt := ast_get(nodes, enid, 4)
        fidx := find_fn_idx(pool, sym, cs, cl)
        if not (acnt == 0 and is_const_fn_idx(sym, fidx)) {
            enqueue_live_fn_ax(live, queue, fidx)
        }
        mut i := 0
        while i < acnt {
            scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, ibuf_get(extra, aoff + i), 4))
            i += 1
        }
        return
    }
    if k == nk_method_call() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 1))
        ms := ast_get(nodes, enid, 2)
        ml := ast_get(nodes, enid, 3)
        aoff := ast_get(nodes, enid, 4)
        acnt := ast_get(nodes, enid, 5)
        mut i := 0
        while i < acnt {
            scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, ibuf_get(extra, aoff + i), 4))
            i += 1
        }
        f_base := ibuf_get(sym, 7)
        f_cnt := ibuf_get(sym, 8)
        mut fi := 0
        while fi < f_cnt {
            fo := f_base + fi * 10
            fnoff := ibuf_get(sym, fo)
            fnlen := ibuf_get(sym, fo + 1)
            if fnlen > ml + 2 {
                tail := fnoff + fnlen - ml
                if buf_get(pool, tail - 1) == 95 and buf_get(pool, tail - 2) == 95 {
                    if pool_str_eq2(pool, tail, ml, ms) {
                        enqueue_live_fn_ax(live, queue, fi)
                    }
                }
            }
            fi += 1
        }
    }
}

fn scan_calls_stmt_ax(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, live: IntBuf, queue: IntBuf, snid: i64) {
    if snid <= 0 {
        return
    }
    k := ast_kind(nodes, snid)
    if k == nk_var_decl() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 5))
    } else if k == nk_tuple_destruct() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 3))
    } else if k == nk_assign() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 2))
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 3))
    } else if k == nk_if() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 1))
        scan_calls_block_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 2))
        scan_calls_block_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 3))
    } else if k == nk_while() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 1))
        scan_calls_block_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 2))
    } else if k == nk_for_range() or k == nk_par_for_range() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 3))
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 4))
        scan_calls_block_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 5))
    } else if k == nk_for_each() or k == nk_par_for_each() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 3))
        scan_calls_block_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 4))
    } else if k == nk_return() or k == nk_expr_stmt() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 1))
    }
}

fn scan_calls_block_ax(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, live: IntBuf, queue: IntBuf, bnid: i64) {
    if bnid <= 0 {
        return
    }
    off := ast_get(nodes, bnid, 1)
    cnt := ast_get(nodes, bnid, 2)
    mut i := 0
    while i < cnt {
        scan_calls_stmt_ax(pool, nodes, extra, sym, live, queue, ibuf_get(extra, off + i))
        i += 1
    }
}

fn mark_reachable_fns_ax(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, is_dll: bool, test_mode: bool, live: IntBuf) {
    f_base := ibuf_get(sym, 7)
    f_cnt := ibuf_get(sym, 8)
    queue := ibuf_new(f_cnt + 8)
    mut main_idx := -1
    mut i := 0
    while i < f_cnt {
        ibuf_push(live, 0)
        fo := f_base + i * 10
        flags := ibuf_get(sym, fo + 9)
        if pool_str_eq_lit(pool, ibuf_get(sym, fo), ibuf_get(sym, fo + 1), "main") {
            main_idx = i
        }
        if (flags & fnflag_export()) != 0 {
            enqueue_live_fn_ax(live, queue, i)
        }
        if test_mode and (flags & fnflag_test()) != 0 {
            enqueue_live_fn_ax(live, queue, i)
        }
        i += 1
    }
    if not is_dll and not test_mode {
        if main_idx >= 0 {
            enqueue_live_fn_ax(live, queue, main_idx)
        } else if ibuf_len(queue) == 0 {
            i = 0
            while i < f_cnt {
                if not is_const_fn_idx(sym, i) {
                    enqueue_live_fn_ax(live, queue, i)
                }
                i += 1
            }
        }
    }
    mut qi := 0
    while qi < ibuf_len(queue) {
        fidx := ibuf_get(queue, qi)
        qi += 1
        fo := f_base + fidx * 10
        fnid := ibuf_get(sym, fo + 2)
        flags := ibuf_get(sym, fo + 9)
        if (flags & fnflag_extern()) == 0 {
            pl_off := ast_get(nodes, fnid, 3)
            pcnt := ast_get(nodes, fnid, 4) & 0xFFFF
            mut pi := 0
            while pi < pcnt {
                pn := ibuf_get(extra, pl_off + pi)
                scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, pn, 5))
                pi += 1
            }
            body := ast_get(nodes, fnid, 6) & 0xFFFFFFFF
            scan_calls_block_ax(pool, nodes, extra, sym, live, queue, body)
        }
    }
    buf_free(move queue)
}

// Unified v7.0 x86_64 Native Compiler & Multi-OS Binary Builder (`PE32+ .exe/.dll/.pyd`, `ELF64`, `Mach-O 64`, `Unikernel`)!
// `simd_mode`: `-1 = Auto CPUID`, `0 = Scalar SSE2`, `1 = AVX2+FMA3`, `2 = AVX-512F EVEX`.
// `link_libs`: pairs `[path_soff, path_slen]` in `pool` for static Win64 COFF `.obj` / `!<arch>\n` `.lib` archives!
fn compile_module_x86_64_v7(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, target_id: i64, is_dll: bool, test_mode: bool, force_shield: bool, simd_mode: i64, link_libs: IntBuf, out_buf: ByteBuf, is_dce: bool = true) -> i64 {
    s_cnt := ibuf_get(sym, 4)
    f_base := ibuf_get(sym, 7)
    f_cnt := ibuf_get(sym, 8)
    live := ibuf_new(f_cnt + 8)
    mark_reachable_fns_ax(pool, nodes, extra, sym, is_dll, test_mode, live)

    mut os_mode := 0
    if target_id == tgt_win_x64() {
        if is_dll { os_mode = 1 } else { os_mode = 0 }
    } else if target_id == tgt_linux_x64() {
        os_mode = 2
    } else if target_id == tgt_macos_x64() {
        os_mode = 3
    } else {
        os_mode = 4
    }

    mut shield_on := 0
    if os_mode <= 1 {
        if force_shield {
            shield_on = 1
        } else {
            mut fi := 0
            while fi < f_cnt {
                if ibuf_get(live, fi) == 1 and (ibuf_get(sym, f_base + fi * 10 + 9) & (fnflag_shield() | fnflag_whitebox())) != 0 {
                    shield_on = 1
                    break
                }
                fi += 1
            }
        }
    }

    poly_seed := 0xA5A55A5AF00DCAFE ^ ((f_cnt *% 0x9E3779B97F4A7C15) +% (s_cnt *% 0xBF58476D1CE4E5B9) +% (buf_len(pool) *% 0x94D049BB133111EB))

    n_words := ibuf_len(nodes)
    mut code_cap := n_words * 64 + f_cnt * 2048 + 65536
    if code_cap < 65536 { code_cap = 65536 }
    mut rdata_cap := buf_len(pool) * 2 + 16384
    if rdata_cap < 16384 { rdata_cap = 16384 }
    mut fix_cap := code_cap / 4 + 8192
    if fix_cap < 8192 { fix_cap = 8192 }
    mut int_cap := f_cnt * 32 + 4096
    if int_cap < 4096 { int_cap = 4096 }

    code := buf_new(code_cap)
    rdata := buf_new(rdata_cap)
    fixups := ibuf_new(fix_cap)
    fn_ranges := ibuf_new(f_cnt * 4 + 256)
    interns := ibuf_new(int_cap)
    state_need := f_cnt + 280
    state := ibuf_new(state_need + 64)
    mut zi := 0
    while zi < state_need {
        ibuf_push(state, 0)
        zi += 1
    }
    ibuf_set(state, 0, shield_on)
    ibuf_set(state, 2, -1)
    ibuf_set(state, 15, poly_seed)
    ibuf_set(state, 16, os_mode)
    ibuf_set(state, 17, simd_mode)
    if test_mode { ibuf_set(state, 19, 1) }

    cg := CodegenCtx(pool, nodes, extra, sym, code, rdata, fixups, fn_ranges, interns, state)

    if test_mode {
        emit_test_runner_entry(cg)
    } else {
        emit_entry_only(cg)
    }

    mut emitted_fns := 0
    mut fni := 0
    while fni < f_cnt {
        fo := f_base + fni * 10
        flags := ibuf_get(sym, fo + 9)
        if ibuf_get(live, fni) == 1 and (flags & (fnflag_extern() | fnflag_comptime())) == 0 {
            mc_align16(cg.code)
            fn_start := buf_len(cg.code)
            ibuf_set(cg.state, 256 + fni, fn_start)
            compile_single_fn_ax(cg, fni)
            fn_end := buf_len(cg.code)
            ibuf_push(cg.fn_ranges, fn_start)
            ibuf_push(cg.fn_ranges, fn_end)
            emitted_fns += 1
        }
        fni += 1
    }

    // Emit C-ABI export trampolines (`@export` / `@py_export`)
    exports := ibuf_new(128)
    fni = 0
    while fni < f_cnt {
        fo := f_base + fni * 10
        flags := ibuf_get(sym, fo + 9)
        if (flags & fnflag_export()) != 0 {
            w_off := emit_c_abi_export_wrapper(cg, fni)
            ibuf_push(exports, ibuf_get(sym, fo))
            ibuf_push(exports, ibuf_get(sym, fo + 1))
            ibuf_push(exports, w_off)
        }
        fni += 1
    }

    emit_used_runtime_helpers(cg)

    // Merge Static Win64 COFF `.obj` / `!<arch>\n` `.lib` Libraries (`--link-lib`)
    coff_syms := ibuf_new(512)
    lib_cnt := ibuf_len(link_libs) / 2
    mut li := 0
    while li < lib_cnt {
        psoff := ibuf_get(link_libs, li * 2)
        pslen := ibuf_get(link_libs, li * 2 + 1)
        lpath := buf_slice_str(pool, psoff, psoff + pslen)
        raw_lib := fs_read_file(lpath) or buf_new(16)
        if buf_len(raw_lib) >= 20 {
            coff_link_archive_or_obj(pool, raw_lib, cg.code, cg.rdata, cg.fixups, coff_syms)
        }
        buf_free(move raw_lib)
        li += 1
    }
    if ibuf_len(coff_syms) > 0 {
        fni = 0
        while fni < f_cnt {
            fo := f_base + fni * 10
            flags := ibuf_get(sym, fo + 9)
            if (flags & fnflag_extern()) != 0 {
                fn_s := ibuf_get(sym, fo)
                fn_l := ibuf_get(sym, fo + 1)
                mut ci := 0
                while ci < ibuf_len(coff_syms) / 4 {
                    cb := ci * 4
                    if ibuf_get(coff_syms, cb + 2) == 1 and ibuf_get(coff_syms, cb + 1) == fn_l and pool_str_eq2(pool, ibuf_get(coff_syms, cb), fn_l, fn_s) {
                        ibuf_set(cg.state, 256 + fni, ibuf_get(coff_syms, cb + 3))
                        break
                    }
                    ci += 1
                }
            }
            fni += 1
        }
    }
    buf_free(move coff_syms)

    // Eliminate PE `.text` slack space when `@shield` is enabled by filling to 512-byte boundary with `0xCC` (`INT3`)
    if shield_on == 1 and buf_len(cg.code) > 0 {
        while (buf_len(cg.code) & 511) != 0 {
            buf_push(cg.code, 0xCC)
        }
    }
    shield_verified_len := buf_len(cg.code)
    shd_imm_pos := ibuf_get(cg.state, 2)
    if shd_imm_pos >= 0 {
        buf_put_u32(cg.code, shd_imm_pos, shield_verified_len)
    }

    // Build W^X `.data` RW initial image (`512` bytes, `g_cpu_threads = 1` initial default)
    data_sec := buf_new(512)
    mut dzi := 0
    while dzi < 512 {
        buf_push(data_sec, 0)
        dzi += 1
    }
    buf_put_u64(data_sec, data_off_cpu_threads(), 1)

    if os_mode <= 1 {
        // Win64 PE32+ `.exe` / `.dll` / `.pyd`
        ext_imports := ibuf_new(128)
        icnt := ibuf_len(cg.interns) / 4
        mut ii := 0
        while ii < icnt {
            ib := ii * 4
            if ibuf_get(cg.interns, ib) == 3 {
                pk_dll := ibuf_get(cg.interns, ib + 1)
                pk_fn := ibuf_get(cg.interns, ib + 2)
                ibuf_push(ext_imports, pk_dll & 0xFFFFFFFF)
                ibuf_push(ext_imports, ushr64(pk_dll, 32))
                ibuf_push(ext_imports, pk_fn & 0xFFFFFFFF)
                ibuf_push(ext_imports, ushr64(pk_fn, 32))
            }
            ii += 1
        }

        mut text_v_nz := buf_len(cg.code)
        if text_v_nz < 1 { text_v_nz = 1 }
        rdata_rva := pe_text_rva() + align_up(text_v_nz, 0x1000)
        rdata_full := buf_new(buf_len(cg.rdata) + 16384)
        pe_info := ibuf_new(128)
        prepare_pe_rdata_v7(pool, rdata_rva, ext_imports, exports, rdata_full, pe_info)

        user_rdata_rva := ibuf_get(pe_info, 4)
        rlen := buf_len(cg.rdata)
        mut ri := 0
        while ri < rlen {
            buf_push(rdata_full, buf_get(cg.rdata, ri))
            ri += 1
        }
        mut rfull_nz := buf_len(rdata_full)
        if rfull_nz < 1 { rfull_nz = 1 }
        data_rva := rdata_rva + align_up(rfull_nz, 0x1000)
        ibuf_set(pe_info, 5, data_rva)
        ibuf_set(pe_info, 12, poly_seed)
        mut dce_flag := 0
        if is_dce { dce_flag = 1 }
        ibuf_set(pe_info, 13, dce_flag)

        fxcnt := ibuf_len(cg.fixups) / 4
        mut xi := 0
        while xi < fxcnt {
            xb := xi * 4
            disp_pos := ibuf_get(cg.fixups, xb)
            next_rip := ibuf_get(cg.fixups, xb + 1)
            fxk := ibuf_get(cg.fixups, xb + 2)
            fxt := ibuf_get(cg.fixups, xb + 3)

            next_rip_rva := pe_text_rva() + next_rip
            mut target_rva := pe_text_rva()
            if fxk == fx_iat() {
                target_rva = pe_info_iat_rva(pe_info, fxt)
            } else if fxk == fx_rdata() {
                target_rva = user_rdata_rva + fxt
            } else if fxk == fx_shield() {
                target_rva = ibuf_get(pe_info, 2)
            } else if fxk == fx_fn() {
                if fxt >= 10000000 {
                    target_rva = pe_text_rva() + ibuf_get(cg.state, 150 + (fxt - 10000000))
                } else {
                    target_rva = pe_text_rva() + ibuf_get(cg.state, 256 + fxt)
                }
            } else if fxk == fx_data() {
                target_rva = data_rva + fxt
            }
            buf_put_u32(cg.code, disp_pos, target_rva - next_rip_rva)
            xi += 1
        }

        build_pe32_binary_v7(cg.code, shield_verified_len, rdata_full, data_sec, pe_info, cg.fn_ranges, is_dll, out_buf)
        buf_free(move pe_info)
        buf_free(move rdata_full)
        buf_free(move ext_imports)
    } else if os_mode == 2 {
        // Linux x86_64 `ELF64`
        lay := ibuf_new(8)
        elf64_compute_layout_aligned(buf_len(cg.code), buf_len(cg.rdata), 0x1000, lay)
        text_va := ibuf_get(lay, 0)
        rdata_va := ibuf_get(lay, 1)
        data_va := ibuf_get(lay, 2)
        buf_free(move lay)

        fxcnt := ibuf_len(cg.fixups) / 4
        mut xi := 0
        while xi < fxcnt {
            xb := xi * 4
            disp_pos := ibuf_get(cg.fixups, xb)
            next_rip := ibuf_get(cg.fixups, xb + 1)
            fxk := ibuf_get(cg.fixups, xb + 2)
            fxt := ibuf_get(cg.fixups, xb + 3)
            mut target_va := text_va
            if fxk == fx_rdata() { target_va = rdata_va + fxt }
            else if fxk == fx_fn() {
                if fxt >= 10000000 { target_va = text_va + ibuf_get(cg.state, 150 + (fxt - 10000000)) }
                else { target_va = text_va + ibuf_get(cg.state, 256 + fxt) }
            }
            else if fxk == fx_data() { target_va = data_va + fxt }
            buf_put_u32(cg.code, disp_pos, target_va - (text_va + next_rip))
            xi += 1
        }
        if is_dce {
            _elf_pruned := elf64_dce_strip_analysis(cg.code, cg.fn_ranges, true)
        }
        build_elf64_executable(cg.code, cg.rdata, data_sec, 62, out_buf)
    } else if os_mode == 3 {
        // macOS x86_64 `Mach-O 64`
        lay := ibuf_new(8)
        macho64_compute_layout(buf_len(cg.code), buf_len(cg.rdata), lay)
        text_va := ibuf_get(lay, 0)
        rdata_va := ibuf_get(lay, 1)
        data_va := ibuf_get(lay, 2)
        buf_free(move lay)

        fxcnt := ibuf_len(cg.fixups) / 4
        mut xi := 0
        while xi < fxcnt {
            xb := xi * 4
            disp_pos := ibuf_get(cg.fixups, xb)
            next_rip := ibuf_get(cg.fixups, xb + 1)
            fxk := ibuf_get(cg.fixups, xb + 2)
            fxt := ibuf_get(cg.fixups, xb + 3)
            mut target_va := text_va
            if fxk == fx_rdata() { target_va = rdata_va + fxt }
            else if fxk == fx_fn() {
                if fxt >= 10000000 { target_va = text_va + ibuf_get(cg.state, 150 + (fxt - 10000000)) }
                else { target_va = text_va + ibuf_get(cg.state, 256 + fxt) }
            }
            else if fxk == fx_data() { target_va = data_va + fxt }
            buf_put_u32(cg.code, disp_pos, target_va - (text_va + next_rip))
            xi += 1
        }
        build_macho64_executable(cg.code, cg.rdata, data_sec, false, out_buf)
    } else {
        // Bare-Metal / Unikernel `Multiboot2` x86_64
        lay := ibuf_new(8)
        unikernel_compute_layout(buf_len(cg.code), buf_len(cg.rdata), lay)
        text_va := ibuf_get(lay, 0)
        rdata_va := ibuf_get(lay, 1)
        data_va := ibuf_get(lay, 2)
        buf_free(move lay)

        fxcnt := ibuf_len(cg.fixups) / 4
        mut xi := 0
        while xi < fxcnt {
            xb := xi * 4
            disp_pos := ibuf_get(cg.fixups, xb)
            next_rip := ibuf_get(cg.fixups, xb + 1)
            fxk := ibuf_get(cg.fixups, xb + 2)
            fxt := ibuf_get(cg.fixups, xb + 3)
            mut target_va := text_va
            if fxk == fx_rdata() { target_va = rdata_va + fxt }
            else if fxk == fx_fn() {
                if fxt >= 10000000 { target_va = text_va + ibuf_get(cg.state, 150 + (fxt - 10000000)) }
                else { target_va = text_va + ibuf_get(cg.state, 256 + fxt) }
            }
            else if fxk == fx_data() { target_va = data_va + fxt }
            buf_put_u32(cg.code, disp_pos, target_va - (text_va + next_rip))
            xi += 1
        }
        build_unikernel_multiboot2(cg.code, cg.rdata, data_sec, out_buf)
    }

    buf_free(move data_sec)
    buf_free(move exports)
    buf_free(move live)
    buf_free(move state)
    buf_free(move interns)
    buf_free(move fn_ranges)
    buf_free(move fixups)
    buf_free(move rdata)
    buf_free(move code)
    return emitted_fns
}
