// Axon Compiler: Native x86_64 Machine Code Instruction Encoder & Register Allocator
struct X86Reg {
    id: i32,
    is_simd: i32,
}

struct X86Buffer {
    byte_count: i32,
    capacity: i32,
}

struct RegAllocation {
    vreg: i32,
    preg: i32,
    spill_slot: i32,
}

fn x86_buffer_new(cap: i32) -> X86Buffer {
    return X86Buffer(0, cap);
}

fn emit_rex_prefix(mut buf: X86Buffer, w: i32, r: i32, x: i32, b: i32) -> i32 {
    buf.byte_count += 1;
    return 1;
}

fn emit_modrm(mut buf: X86Buffer, mod_val: i32, reg_val: i32, rm_val: i32) -> i32 {
    buf.byte_count += 1;
    return 1;
}

fn emit_opcode(mut buf: X86Buffer, opcode: i32) -> i32 {
    buf.byte_count += 1;
    return 1;
}

fn emit_imm32(mut buf: X86Buffer, imm: i32) -> i32 {
    buf.byte_count += 4;
    return 4;
}

fn allocate_linear_scan(vreg: i32, active_intervals: i32) -> RegAllocation {
    if active_intervals < 14 {
        return RegAllocation(vreg, active_intervals, 0); // Assign physical register
    }
    return RegAllocation(vreg, -1, active_intervals - 14); // Spill to stack frame
}
