// Axon v7.0 Self-Hosted Compiler - Direct Multi-OS x86_64 + 3-Tier CPUID SIMD + Polyhedral + Multi-Core Codegen
// (`compiler_ax/codegen_x86_64.ax`) - 100% Pure Axon, Zero LLVM/Clang/GCC/Rustc.
// Emits Intel CET (`ENDBR64`), 4 KB Guard-Page Stack Probes, Zeroed Frames, Perceus Loop Self-FBIP,
// Dead-Column SoA Compaction, Runtime CPUID (`SSE2` / `AVX2+FMA3` / `AVX-512F EVEX`), Multi-Core `par_for`,
// Symbolic Tensor Binding `[sym B, sym S, comptime D]`, `@nan_guard`, C-ABI `.dll`/`.pyd` Exports & COFF Linking.

use compiler_ax::tokens_ast
use compiler_ax::comptime
use compiler_ax::sema_perceus
use compiler_ax::linker_pe
use compiler_ax::linker_unix_bare
use compiler_ax::codegen_runtime
use compiler_ax::codegen_calls

// Packed LValue layout: `(base_slot << 44) | (sub_off << 32) | (lval_ty & 0xFFFFFFFF)`
fn resolve_lval_ax(cg: CodegenCtx, vars: IntBuf, expr_nid: i64) -> i64 {
    if expr_nid <= 0 {
        return 0
    }
    k := ast_kind(cg.nodes, expr_nid)
    if k == nk_ident() {
        soff := ast_get(cg.nodes, expr_nid, 1)
        slen := ast_get(cg.nodes, expr_nid, 2)
        vb := cg_var_find(cg.pool, vars, soff, slen)
        if vb < 0 {
            return 0
        }
        vslot := ibuf_get(vars, vb + 2)
        vty := ibuf_get(vars, vb + 3)
        return (vslot << 44) | (vty & 0xFFFFFFFF)
    }
    if k == nk_field() {
        blv := resolve_lval_ax(cg, vars, ast_get(cg.nodes, expr_nid, 1))
        if blv == 0 {
            return 0
        }
        bslot := ushr64(blv, 44)
        boff := (ushr64(blv, 32)) & 0xFFF
        bty := blv & 0xFFFFFFFF
        if ty_tag(bty) == 10 {
            fsoff := ast_get(cg.nodes, expr_nid, 2)
            fslen := ast_get(cg.nodes, expr_nid, 3)
            fo := find_struct_field(cg.pool, cg.sym, ty_pay(bty), fsoff | (fslen << 32))
            if fo >= 0 {
                f_slot_off := ibuf_get(cg.sym, fo + 2)
                f_ty := ibuf_get(cg.sym, fo + 3)
                return (bslot << 44) | ((boff + f_slot_off) << 32) | (f_ty & 0xFFFFFFFF)
            }
        }
        return 0
    }
    if k == nk_tuple_idx() {
        blv := resolve_lval_ax(cg, vars, ast_get(cg.nodes, expr_nid, 1))
        if blv == 0 {
            return 0
        }
        bslot := ushr64(blv, 44)
        boff := (ushr64(blv, 32)) & 0xFFF
        bty := blv & 0xFFFFFFFF
        target_idx := ast_get(cg.nodes, expr_nid, 2)
        if ty_tag(bty) == 14 {
            doff := ty_pay(bty)
            cnt := ibuf_get(cg.sym, doff)
            mut off := 0
            mut i := 0
            while i < cnt {
                et := ibuf_get(cg.sym, doff + 1 + i)
                if i == target_idx {
                    return (bslot << 44) | ((boff + off) << 32) | (et & 0xFFFFFFFF)
                }
                off += type_slots(cg.sym, et)
                i += 1
            }
        }
        return 0
    }
    return 0
}

// Interns a `comptime` `IntBuf` or `ByteBuf` constant (`goff` in `cg.sym`) into `.rdata` as a zero-alloc buffer!
fn cg_intern_ct_lut(cg: CodegenCtx, goff: i64) -> i64 {
    icnt := ibuf_len(cg.interns) / 4
    mut i := 0
    while i < icnt {
        base := i * 4
        if ibuf_get(cg.interns, base) == 4 and ibuf_get(cg.interns, base + 1) == goff {
            return ibuf_get(cg.interns, base + 3)
        }
        i += 1
    }
    while (buf_len(cg.rdata) & 7) != 0 {
        buf_push(cg.rdata, 0)
    }
    roff := buf_len(cg.rdata)
    rty := ibuf_get(cg.sym, goff + 2)
    elen := ibuf_get(cg.sym, goff + 3)
    lut_off := ibuf_get(cg.sym, goff + 5)
    buf_push_u64(cg.rdata, elen)
    buf_push_u64(cg.rdata, elen)
    if rty == ty_intbuf() {
        mut k := 0
        while k < elen {
            buf_push_u64(cg.rdata, ibuf_get(cg.sym, lut_off + k))
            k += 1
        }
    } else {
        mut k := 0
        while k < elen {
            buf_push(cg.rdata, buf_get(cg.pool, lut_off + k))
            k += 1
        }
        buf_push(cg.rdata, 0)
    }
    ibuf_push(cg.interns, 4)
    ibuf_push(cg.interns, goff)
    ibuf_push(cg.interns, 0)
    ibuf_push(cg.interns, roff)
    return roff
}

fn emit_bounds_check_ax(cg: CodegenCtx, idx_slot: i64, tbl_slot: i64, idx_nid: i64) {
    c := cg.code
    mc_load_rax(c, idx_slot, 0)
    mc_cmp_rax_slot(c, tbl_slot, 1)
    cg_jmp_fn(cg, 0x83, h_sec_trap())
}

// Emits IEEE-754 `@nan_guard` check on `f64` bits in `RAX` (`(bits >> 52) & 0x7FF == 0x7FF` -> `h_nan_trap(line)`)
fn emit_nan_guard_rax(cg: CodegenCtx) {
    if (ibuf_get(cg.state, 18) & fnflag_nan_guard()) == 0 {
        return
    }
    c := cg.code
    mc_b3(c, 0x48, 0x89, 0xC2)       // MOV RDX, RAX
    mc_b4(c, 0x48, 0xC1, 0xEA, 0x34) // SHR RDX, 52
    mc_b2(c, 0x81, 0xE2); mc_u32(c, 0x7FF) // AND EDX, 0x7FF
    mc_b2(c, 0x81, 0xFA); mc_u32(c, 0x7FF) // CMP EDX, 0x7FF
    jne_ok := mc_jcc8(c, 0x75)
    mc_b1(c, 0xB9); mc_u32(c, ibuf_get(cg.state, 20))
    cg_call_fn(cg, h_nan_trap())
    mc_patch_jcc8(c, jne_ok, buf_len(c))
}

fn can_imm_binop_ax(op: i64, imm: i64) -> bool {
    if op == op_shl() or op == op_shr() {
        return imm >= 0 and imm <= 63
    }
    if op == op_mul() or op == op_wrap_mul() or op == op_add() or op == op_wrap_add() or op == op_sub() or op == op_wrap_sub() or op == op_bit_and() or op == op_bit_or() or op == op_bit_xor() or (op >= op_eq() and op <= op_gte()) {
        return imm >= -2147483648 and imm <= 2147483647
    }
    return false
}

fn emit_rax_cmp_setcc(c: ByteBuf, op: i64) {
    mut setcc := 0x94
    if op == op_neq() { setcc = 0x95 }
    else if op == op_lt() { setcc = 0x9C }
    else if op == op_lte() { setcc = 0x9E }
    else if op == op_gt() { setcc = 0x9F }
    else if op == op_gte() { setcc = 0x9D }
    mc_b3(c, 0x0F, setcc, 0xC0)
    mc_b3(c, 0x0F, 0xB6, 0xC0)
}

fn emit_rax_op_imm(cg: CodegenCtx, op: i64, imm: i64) {
    c := cg.code
    if op == op_shl() {
        mc_b4(c, 0x48, 0xC1, 0xE0, imm)
    } else if op == op_shr() {
        mc_b4(c, 0x48, 0xC1, 0xF8, imm)
    } else if op == op_mul() or op == op_wrap_mul() {
        if (op == op_wrap_mul() or ibuf_get(cg.state, 0) == 0) and imm == 2 {
            mc_b3(c, 0x48, 0x01, 0xC0) // ADD RAX, RAX
        } else if (op == op_wrap_mul() or ibuf_get(cg.state, 0) == 0) and (imm == 4 or imm == 8 or imm == 16) {
            mut sh := 2
            if imm == 8 { sh = 3 } else if imm == 16 { sh = 4 }
            mc_b4(c, 0x48, 0xC1, 0xE0, sh) // SHL RAX, sh
        } else if imm >= -128 and imm <= 127 {
            mc_b4(c, 0x48, 0x6B, 0xC0, imm & 255)
        } else {
            mc_b3(c, 0x48, 0x69, 0xC0)
            mc_u32(c, imm)
        }
        if op == op_mul() and ibuf_get(cg.state, 0) == 1 {
            cg_jmp_fn(cg, 0x80, h_sec_trap())
        }
    } else {
        mut grp := 7
        if op == op_add() or op == op_wrap_add() { grp = 0 }
        else if op == op_bit_or() { grp = 1 }
        else if op == op_bit_and() { grp = 4 }
        else if op == op_sub() or op == op_wrap_sub() { grp = 5 }
        else if op == op_bit_xor() { grp = 6 }

        if grp == 7 and imm == 0 {
            mc_b3(c, 0x48, 0x85, 0xC0)
        } else if grp == 4 and imm == 255 {
            mc_b3(c, 0x0F, 0xB6, 0xC0) // MOVZX EAX, AL (3B vs 6B `AND RAX, 0xFF`)
        } else if imm >= -128 and imm <= 127 {
            mc_b4(c, 0x48, 0x83, 0xC0 + (grp << 3), imm & 255)
        } else {
            mc_b2(c, 0x48, (grp << 3) | 5)
            mc_u32(c, imm)
        }
        if (op == op_add() or op == op_sub()) and ibuf_get(cg.state, 0) == 1 {
            cg_jmp_fn(cg, 0x80, h_sec_trap())
        }
        if op >= op_eq() and op <= op_gte() {
            emit_rax_cmp_setcc(c, op)
        }
    }
}

fn emit_int_binop_imm_ax(cg: CodegenCtx, lslot: i64, op: i64, imm: i64) -> i64 {
    if not can_imm_binop_ax(op, imm) { return -1 }
    c := cg.code
    dst := cg_alloc_slots(cg, 1)
    mc_load_rax(c, lslot, 0)
    emit_rax_op_imm(cg, op, imm)
    mc_store_rax(c, dst, 0)
    return dst
}

fn gpreg_hw(r: i64) -> i64 {
    if r == 1 { return 3 }  // RBX
    if r == 6 { return 6 }  // RSI (Win64 callee-saved)
    if r == 7 { return 7 }  // RDI (Win64 callee-saved)
    if r == 8 { return 2 }  // R10 (call-free volatile)
    if r == 9 { return 3 }  // R11 (call-free volatile)
    if r == 10 { return 0 } // R8  (call-free volatile)
    return r + 2            // R12(2)->4 .. R15(5)->7
}

fn gpreg_hi(r: i64) -> i64 {
    if r <= 1 or r == 6 or r == 7 { return 0 } // RBX, RSI, RDI
    return 1                                   // R12..R15, R10, R11, R8
}

fn cg_max_gpr(cg: CodegenCtx) -> i64 {
    if cg_is_win64(cg) { return 7 }
    return 5
}

fn mc_load_gpreg(c: ByteBuf, slot: i64, r: i64) {
    mc_rbp_slot(c, ((0x48 | (gpreg_hi(r) << 2)) << 16) | 0x8B00 | gpreg_hw(r), slot, 0)
}

fn mc_store_gpreg(c: ByteBuf, slot: i64, r: i64) {
    mc_rbp_slot(c, ((0x48 | (gpreg_hi(r) << 2)) << 16) | 0x8900 | gpreg_hw(r), slot, 0)
}

fn mc_mov_rax_gpreg(c: ByteBuf, r: i64) {
    mc_b3(c, 0x48 | gpreg_hi(r), 0x8B, 0xC0 | gpreg_hw(r))
}

fn mc_mov_gpreg_rax(c: ByteBuf, r: i64) {
    mc_b3(c, 0x48 | gpreg_hi(r), 0x89, 0xC0 | gpreg_hw(r))
}

fn mc_mov_rcx_gpreg(c: ByteBuf, r: i64) {
    mc_b3(c, 0x48 | gpreg_hi(r), 0x8B, 0xC8 | gpreg_hw(r))
}

fn mc_mov_rdx_gpreg(c: ByteBuf, r: i64) {
    mc_b3(c, 0x48 | gpreg_hi(r), 0x8B, 0xD0 | gpreg_hw(r))
}
fn mc_mov_r8_gpreg(c: ByteBuf, r: i64) {
    mc_b3(c, 0x4C | gpreg_hi(r), 0x8B, 0xC0 | gpreg_hw(r))
}
fn mc_mov_r9_gpreg(c: ByteBuf, r: i64) {
    mc_b3(c, 0x4C | gpreg_hi(r), 0x8B, 0xC8 | gpreg_hw(r))
}

fn mc_mov_gpreg_argreg(c: ByteBuf, r: i64, ridx: i64) {
    hi := gpreg_hi(r)
    hw := gpreg_hw(r)
    if ridx == 0 { mc_b3(c, 0x48 | hi, 0x89, 0xC8 | hw) }
    else if ridx == 1 { mc_b3(c, 0x48 | hi, 0x89, 0xD0 | hw) }
    else if ridx == 2 { mc_b3(c, 0x4C | hi, 0x89, 0xC0 | hw) }
    else if ridx == 3 { mc_b3(c, 0x4C | hi, 0x89, 0xC8 | hw) }
    else if ridx == 4 { mc_b3(c, 0x4C | hi, 0x89, 0xD0 | hw) }
    else { mc_b3(c, 0x4C | hi, 0x89, 0xD8 | hw) }
}

fn mc_cmp_rax_gpreg(c: ByteBuf, r: i64) {
    mc_b3(c, 0x48 | gpreg_hi(r), 0x3B, 0xC0 | gpreg_hw(r))
}

fn mc_cmp_gpreg_slot(c: ByteBuf, r: i64, slot: i64) {
    mc_rbp_slot(c, ((0x48 | (gpreg_hi(r) << 2)) << 16) | 0x3B00 | gpreg_hw(r), slot, 0)
}

fn mc_cmp_gpreg_gpreg(c: ByteBuf, lr: i64, rr: i64) {
    rex := 0x48 | (gpreg_hi(rr) << 2) | gpreg_hi(lr)
    modrm := 0xC0 | (gpreg_hw(rr) << 3) | gpreg_hw(lr)
    mc_b3(c, rex, 0x39, modrm)
}

fn mc_cmp_gpreg_imm(c: ByteBuf, r: i64, imm: i64) {
    hi := gpreg_hi(r)
    hw := gpreg_hw(r)
    if imm == 0 {
        mc_b3(c, 0x48 | (hi << 2) | hi, 0x85, 0xC0 | (hw << 3) | hw)
    } else if imm >= -128 and imm <= 127 {
        mc_b4(c, 0x48 | hi, 0x83, 0xF8 | hw, imm & 255)
    } else {
        mc_b3(c, 0x48 | hi, 0x81, 0xF8 | hw); mc_u32(c, imm)
    }
}

fn mc_mov_gpreg_imm(c: ByteBuf, r: i64, imm: i64) {
    hi := gpreg_hi(r)
    hw := gpreg_hw(r)
    if imm == 0 {
        modrm := 0xC0 | (hw << 3) | hw
        if hi != 0 { mc_b3(c, 0x45, 0x31, modrm) }
        else       { mc_b2(c, 0x31, modrm) }
    } else if imm >= -2147483648 and imm <= 2147483647 {
        mc_b3(c, 0x48 | hi, 0xC7, 0xC0 | hw); mc_u32(c, imm)
    } else {
        mc_mov_rax_imm(c, imm)
        mc_mov_gpreg_rax(c, r)
    }
}

fn mc_add_gpreg_slot(c: ByteBuf, r: i64, slot: i64) {
    disp := mc_slot_disp(slot, 0)
    mc_b2(c, 0x48 | (gpreg_hi(r) << 2), 0x03)
    if disp >= -128 and disp <= 127 {
        mc_b2(c, 0x45 | (gpreg_hw(r) << 3), disp & 255)
    } else {
        mc_b1(c, 0x85 | (gpreg_hw(r) << 3)); mc_u32(c, disp)
    }
}

fn mc_align16_nop(c: ByteBuf) {
    mut rem := (16 - (buf_len(c) & 15)) & 15
    while rem > 0 {
        if rem >= 9 {
            mc_b4(c, 0x66, 0x0F, 0x1F, 0x84); mc_b1(c, 0x00); mc_u32(c, 0)
            rem -= 9
        } else if rem == 8 {
            mc_b4(c, 0x0F, 0x1F, 0x84, 0x00); mc_u32(c, 0)
            rem = 0
        } else if rem == 7 {
            mc_b3(c, 0x0F, 0x1F, 0x80); mc_u32(c, 0)
            rem = 0
        } else if rem == 6 {
            mc_b4(c, 0x66, 0x0F, 0x1F, 0x44); mc_b2(c, 0x00, 0x00)
            rem = 0
        } else if rem == 5 {
            mc_b4(c, 0x0F, 0x1F, 0x44, 0x00); mc_b1(c, 0x00)
            rem = 0
        } else if rem == 4 {
            mc_b4(c, 0x0F, 0x1F, 0x40, 0x00)
            rem = 0
        } else if rem == 3 {
            mc_b3(c, 0x0F, 0x1F, 0x00)
            rem = 0
        } else if rem == 2 {
            mc_b2(c, 0x66, 0x90)
            rem = 0
        } else {
            mc_b1(c, 0x90)
            rem = 0
        }
    }
}

fn cg_fpromo_base(cg: CodegenCtx) -> i64 { return 256 + ibuf_get(cg.sym, 8) }
fn cg_gpromo_base(cg: CodegenCtx) -> i64 { return 256 + ibuf_get(cg.sym, 8) + 24 }

fn cg_get_gpr_slot(cg: CodegenCtx, r: i64) -> i64 {
    if r >= 1 and r <= 5 { return ibuf_get(cg.state, 230 + r) }
    if r == 6 { return ibuf_get(cg.state, cg_fpromo_base(cg) + 115) }
    if r == 7 { return ibuf_get(cg.state, cg_fpromo_base(cg) + 116) }
    if r == 8 { return ibuf_get(cg.state, cg_fpromo_base(cg) + 124) }
    if r == 9 { return ibuf_get(cg.state, cg_fpromo_base(cg) + 125) }
    if r == 10 { return ibuf_get(cg.state, cg_fpromo_base(cg) + 130) }
    return 0
}

fn cg_set_gpr_slot(cg: CodegenCtx, r: i64, slot: i64) {
    if r >= 1 and r <= 5 { ibuf_set(cg.state, 230 + r, slot) }
    else if r == 6 { ibuf_set(cg.state, cg_fpromo_base(cg) + 115, slot) }
    else if r == 7 { ibuf_set(cg.state, cg_fpromo_base(cg) + 116, slot) }
    else if r == 8 { ibuf_set(cg.state, cg_fpromo_base(cg) + 124, slot) }
    else if r == 9 { ibuf_set(cg.state, cg_fpromo_base(cg) + 125, slot) }
    else if r == 10 { ibuf_set(cg.state, cg_fpromo_base(cg) + 130, slot) }
}

fn cg_slot_reg(cg: CodegenCtx, slot: i64) -> i64 {
    mask := ibuf_get(cg.state, 98)
    if slot <= 0 or mask == 0 { return 0 }
    if ibuf_get(cg.state, 231) == slot { return 1 }
    if ibuf_get(cg.state, 232) == slot { return 2 }
    if ibuf_get(cg.state, 233) == slot { return 3 }
    if ibuf_get(cg.state, 234) == slot { return 4 }
    if ibuf_get(cg.state, 235) == slot { return 5 }
    fb := cg_fpromo_base(cg)
    if (mask & 0xC0) != 0 {
        if ibuf_get(cg.state, fb + 115) == slot { return 6 }
        if ibuf_get(cg.state, fb + 116) == slot { return 7 }
    }
    if (mask & 0x700) != 0 {
        if ibuf_get(cg.state, fb + 124) == slot { return 8 }
        if ibuf_get(cg.state, fb + 125) == slot { return 9 }
        if ibuf_get(cg.state, fb + 130) == slot { return 10 }
    }
    return 0
}

fn find_promo_reg_by_name(cg: CodegenCtx, soff: i64, slen: i64) -> i64 {
    mask := ibuf_get(cg.state, 98)
    if mask == 0 or ibuf_get(cg.state, 22) > 0 { return 0 }
    fb := cg_fpromo_base(cg)
    mut r := 1
    while r <= 10 {
        if (mask & (1 << r)) != 0 {
            mut csoff := 0
            mut cslen := 0
            if r <= 5 {
                csoff = ibuf_get(cg.state, 236 + (r - 1) * 2)
                cslen = ibuf_get(cg.state, 237 + (r - 1) * 2)
            } else if r <= 7 {
                csoff = ibuf_get(cg.state, fb + 117 + (r - 6) * 2)
                cslen = ibuf_get(cg.state, fb + 118 + (r - 6) * 2)
            } else if r <= 9 {
                csoff = ibuf_get(cg.state, fb + 126 + (r - 8) * 2)
                cslen = ibuf_get(cg.state, fb + 127 + (r - 8) * 2)
            } else {
                csoff = ibuf_get(cg.state, fb + 131)
                cslen = ibuf_get(cg.state, fb + 132)
            }
            if cslen == slen and pool_str_eq2(cg.pool, csoff, slen, soff) {
                return r
            }
        }
        r += 1
    }
    gb := cg_gpromo_base(cg)
    ecnt := ibuf_get(cg.state, gb)
    mut ei := 0
    while ei < ecnt {
        bo := gb + 1 + ei * 3
        er := ibuf_get(cg.state, bo + 2)
        if er > 0 {
            if ibuf_get(cg.state, bo + 1) == slen and pool_str_eq2(cg.pool, ibuf_get(cg.state, bo), slen, soff) {
                return er
            }
        }
        ei += 1
    }
    return 0
}

fn freg_hw(fr: i64) -> i64 {
    return (5 + fr) & 7 // fr=1..5 -> xreg 6..10 -> hw 6,7,0,1,2
}

fn freg_hi(fr: i64) -> i64 {
    if fr <= 2 { return 0 } // 6, 7
    return 1                // 8..10
}

fn mc_freg_mem_rbp(c: ByteBuf, pfx: i64, op2: i64, fr: i64, slot: i64) {
    if pfx != 0 { mc_b1(c, pfx) }
    if freg_hi(fr) != 0 { mc_b1(c, 0x44) }
    mc_b2(c, 0x0F, op2)
    disp := mc_slot_disp(slot, 0)
    hw := freg_hw(fr)
    if disp >= -128 and disp <= 127 {
        mc_b2(c, 0x45 | (hw << 3), disp & 255)
    } else {
        mc_b1(c, 0x85 | (hw << 3)); mc_u32(c, disp)
    }
}

fn mc_load_freg_ups(c: ByteBuf, slot: i64, fr: i64)  { mc_freg_mem_rbp(c, 0, 0x10, fr, slot) }
fn mc_store_freg_ups(c: ByteBuf, slot: i64, fr: i64) { mc_freg_mem_rbp(c, 0, 0x11, fr, slot) }
fn mc_load_freg_sd(c: ByteBuf, slot: i64, fr: i64)   { mc_freg_mem_rbp(c, 0xF2, 0x10, fr, slot) }
fn mc_store_freg_sd(c: ByteBuf, slot: i64, fr: i64)  { mc_freg_mem_rbp(c, 0xF2, 0x11, fr, slot) }

fn mc_mov_xmm0_freg(c: ByteBuf, fr: i64) {
    if freg_hi(fr) != 0 { mc_b1(c, 0x41) }
    mc_b3(c, 0x0F, 0x28, 0xC0 | freg_hw(fr))
}

fn mc_mov_freg_xmm0(c: ByteBuf, fr: i64) {
    if freg_hi(fr) != 0 { mc_b1(c, 0x44) }
    mc_b3(c, 0x0F, 0x28, 0xC0 | (freg_hw(fr) << 3))
}

fn mc_sse_xmm0_freg_op(c: ByteBuf, pfx: i64, op2: i64, fr: i64) {
    mc_b1(c, pfx)
    if freg_hi(fr) != 0 { mc_b1(c, 0x41) }
    mc_b3(c, 0x0F, op2, 0xC0 | freg_hw(fr))
}

fn mc_ucomisd_freg_xmm0(c: ByteBuf, fr: i64) {
    mc_b1(c, 0x66)
    if freg_hi(fr) != 0 { mc_b1(c, 0x44) }
    mc_b3(c, 0x0F, 0x2E, 0xC0 | (freg_hw(fr) << 3))
}

fn cg_set_freg_slot(cg: CodegenCtx, fr: i64, slot: i64) {
    if fr >= 1 and fr <= 5 { ibuf_set(cg.state, 162 + fr, slot) }
    else if fr >= 6 and fr <= 8 { ibuf_set(cg.state, cg_fpromo_base(cg) + (fr - 6), slot) }
}

fn cg_slot_freg(cg: CodegenCtx, slot: i64) -> i64 {
    if slot <= 0 or ibuf_get(cg.state, 161) == 0 { return 0 }
    if ibuf_get(cg.state, 163) == slot { return 1 }
    if ibuf_get(cg.state, 164) == slot { return 2 }
    if ibuf_get(cg.state, 165) == slot { return 3 }
    if ibuf_get(cg.state, 166) == slot { return 4 }
    if ibuf_get(cg.state, 167) == slot { return 5 }
    fb := cg_fpromo_base(cg)
    if ibuf_get(cg.state, fb) == slot { return 6 }
    if ibuf_get(cg.state, fb + 1) == slot { return 7 }
    if ibuf_get(cg.state, fb + 2) == slot { return 8 }
    return 0
}

fn find_promo_freg_by_name(cg: CodegenCtx, soff: i64, slen: i64) -> i64 {
    fmask := ibuf_get(cg.state, 161)
    if fmask == 0 or ibuf_get(cg.state, 22) > 0 { return 0 }
    fb := cg_fpromo_base(cg)
    mut fr := 1
    while fr <= 8 {
        if (fmask & (1 << fr)) != 0 {
            mut csoff := 0
            mut cslen := 0
            if fr <= 5 {
                csoff = ibuf_get(cg.state, 246 + (fr - 1) * 2)
                cslen = ibuf_get(cg.state, 247 + (fr - 1) * 2)
            } else {
                csoff = ibuf_get(cg.state, fb + 8 + (fr - 6) * 2)
                cslen = ibuf_get(cg.state, fb + 9 + (fr - 6) * 2)
            }
            if cslen == slen and pool_str_eq2(cg.pool, csoff, slen, soff) {
                return fr
            }
        }
        fr += 1
    }
    return 0
}

fn emit_restore_callee_regs_ax(cg: CodegenCtx) {
    if ibuf_get(cg.state, 22) > 0 { return }
    mask := ibuf_get(cg.state, 98)
    if mask != 0 {
        save_base := ibuf_get(cg.state, 99)
        max_r := cg_max_gpr(cg)
        mut idx := 0
        mut r := 1
        while r <= max_r {
            if (mask & (1 << r)) != 0 {
                mc_load_gpreg(cg.code, save_base + idx, r)
                idx += 1
            }
            r += 1
        }
    }
    fmask := ibuf_get(cg.state, 161)
    if fmask != 0 {
        fsave := ibuf_get(cg.state, 162)
        mut fidx := 0
        mut fr := 1
        while fr <= 8 {
            if (fmask & (1 << fr)) != 0 {
                mc_load_freg_ups(cg.code, fsave + fidx * 2 + 1, fr)
                fidx += 1
            }
            fr += 1
        }
    }
}

fn emit_rax_op_gpreg(cg: CodegenCtx, op: i64, r: i64) {
    c := cg.code
    shd := ibuf_get(cg.state, 0)
    hi := gpreg_hi(r)
    hw := gpreg_hw(r)
    if op == op_add() or op == op_wrap_add() {
        mc_b3(c, 0x48 | hi, 0x03, 0xC0 | hw)
        if op == op_add() and shd == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
    } else if op == op_sub() or op == op_wrap_sub() {
        mc_b3(c, 0x48 | hi, 0x2B, 0xC0 | hw)
        if op == op_sub() and shd == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
    } else if op == op_mul() or op == op_wrap_mul() {
        mc_b4(c, 0x48 | hi, 0x0F, 0xAF, 0xC0 | hw)
        if op == op_mul() and shd == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
    } else if op == op_bit_and() {
        mc_b3(c, 0x48 | hi, 0x23, 0xC0 | hw)
    } else if op == op_bit_or() {
        mc_b3(c, 0x48 | hi, 0x0B, 0xC0 | hw)
    } else if op == op_bit_xor() {
        mc_b3(c, 0x48 | hi, 0x33, 0xC0 | hw)
    } else if op == op_shl() {
        mc_mov_rcx_gpreg(c, r)
        mc_b3(c, 0x48, 0xD3, 0xE0)
    } else if op == op_shr() {
        mc_mov_rcx_gpreg(c, r)
        mc_b3(c, 0x48, 0xD3, 0xF8)
    } else {
        mc_cmp_rax_gpreg(c, r)
        emit_rax_cmp_setcc(c, op)
    }
}

fn emit_gpreg_addsub_imm(cg: CodegenCtx, r: i64, is_add: bool, imm: i64) {
    c := cg.code
    hi := gpreg_hi(r)
    hw := gpreg_hw(r)
    mut modrm_base := 0xE8
    if is_add { modrm_base = 0xC0 }
    if imm >= -128 and imm <= 127 {
        mc_b4(c, 0x48 | hi, 0x83, modrm_base | hw, imm & 255)
    } else {
        mc_b3(c, 0x48 | hi, 0x81, modrm_base | hw); mc_u32(c, imm)
    }
    if ibuf_get(cg.state, 0) != 0 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
}

fn scan_cand_find(pool: ByteBuf, cands: IntBuf, soff: i64, slen: i64) -> i64 {
    cnt := ibuf_len(cands) / 7
    mut i := 0
    while i < cnt {
        b := i * 7
        if ibuf_get(cands, b + 1) == slen and pool_str_eq2(pool, ibuf_get(cands, b), slen, soff) {
            return b
        }
        i += 1
    }
    return -1
}

fn scan_push_cand(cands: IntBuf, soff: i64, slen: i64, ok: i64, w: i64, fp: i64, be: i64) {
    if ibuf_len(cands) + 7 <= 8192 {
        ibuf_push(cands, soff)
        ibuf_push(cands, slen)
        ibuf_push(cands, ok)
        ibuf_push(cands, w)
        ibuf_push(cands, fp)
        ibuf_push(cands, be)
        ibuf_push(cands, fp) // last_use (tightened live-interval end)
    }
}

fn scan_extend_loop_lu(cands: IntBuf, lstart: i64, lend: i64) {
    mut ci := 0
    while ci < ibuf_len(cands) {
        if ibuf_get(cands, ci) >= 0 and ibuf_get(cands, ci + 4) < lstart and ibuf_get(cands, ci + 6) >= lstart {
            ibuf_set(cands, ci + 6, lend)
        }
        ci += 7
    }
}

fn scan_touch_all_open(cg: CodegenCtx, cands: IntBuf) {
    pos := scan_pos_next(cg)
    mut ci := 0
    while ci < ibuf_len(cands) {
        if ibuf_get(cands, ci) >= 0 {
            be := ibuf_get(cands, ci + 5)
            if be <= 0 or be == 999999999 {
                ibuf_set(cands, ci + 6, pos)
            }
        }
        ci += 7
    }
}

fn scan_pos_next(cg: CodegenCtx) -> i64 {
    idx := cg_fpromo_base(cg) + 121
    p := ibuf_get(cg.state, idx) + 1
    ibuf_set(cg.state, idx, p)
    return p
}

fn scan_infer_int_bool(cg: CodegenCtx, cands: IntBuf, nid: i64) -> bool {
    if nid <= 0 { return false }
    k := ast_kind(cg.nodes, nid)
    if k == nk_int() or k == nk_bool() { return true }
    p := cg.pool
    if k == nk_ident() or k == nk_move_ident() {
        soff := ast_get(cg.nodes, nid, 1)
        slen := ast_get(cg.nodes, nid, 2)
        cb := scan_cand_find(p, cands, soff, slen)
        if cb >= 0 { return ibuf_get(cands, cb + 2) == 1 }
        goff := ct_find_global_const(p, cg.sym, soff, slen)
        if goff >= 0 {
            cty := ibuf_get(cg.sym, goff + 2)
            return cty == ty_int() or cty == ty_bool()
        }
        return false
    }
    if k == nk_unary() {
        return scan_infer_int_bool(cg, cands, ast_get(cg.nodes, nid, 2))
    }
    if k == nk_binary() {
        op := ast_get(cg.nodes, nid, 1)
        if op == op_or() or op == op_and() or (op >= op_eq() and op <= op_gte()) {
            return scan_infer_int_bool(cg, cands, ast_get(cg.nodes, nid, 2)) and scan_infer_int_bool(cg, cands, ast_get(cg.nodes, nid, 3))
        }
        return scan_infer_int_bool(cg, cands, ast_get(cg.nodes, nid, 2)) and scan_infer_int_bool(cg, cands, ast_get(cg.nodes, nid, 3))
    }
    if k == nk_call() {
        cs := ast_get(cg.nodes, nid, 1)
        cl := ast_get(cg.nodes, nid, 2)
        if pool_str_eq_lit(p, cs, cl, "ushr64") or pool_str_eq_lit(p, cs, cl, "popcnt64") or pool_str_eq_lit(p, cs, cl, "ptr_read_u8") or pool_str_eq_lit(p, cs, cl, "ptr_read_i64") or pool_str_eq_lit(p, cs, cl, "mem_alloc_aligned") or pool_str_eq_lit(p, cs, cl, "str_len") or pool_str_eq_lit(p, cs, cl, "clock_ns") or pool_str_eq_lit(p, cs, cl, "ibuf_get") or pool_str_eq_lit(p, cs, cl, "buf_get") or pool_str_eq_lit(p, cs, cl, "ibuf_len") or pool_str_eq_lit(p, cs, cl, "buf_len") or pool_str_eq_lit(p, cs, cl, "str_byte") {
            return true
        }
        if find_struct_idx(p, cg.sym, cs, cl) >= 0 { return false }
        fidx := find_fn_idx(p, cg.sym, cs, cl)
        if fidx >= 0 {
            fo := ibuf_get(cg.sym, 7) + fidx * 10
            rty := ibuf_get(cg.sym, fo + 5)
            return rty == ty_int() or rty == ty_bool()
        }
    }
    return false
}

fn scan_infer_f64(cg: CodegenCtx, cands: IntBuf, nid: i64) -> bool {
    if nid <= 0 { return false }
    k := ast_kind(cg.nodes, nid)
    if k == nk_float() { return true }
    p := cg.pool
    if k == nk_ident() or k == nk_move_ident() {
        soff := ast_get(cg.nodes, nid, 1)
        slen := ast_get(cg.nodes, nid, 2)
        cb := scan_cand_find(p, cands, soff, slen)
        if cb >= 0 { return ibuf_get(cands, cb + 2) == 2 }
        goff := ct_find_global_const(p, cg.sym, soff, slen)
        if goff >= 0 { return ibuf_get(cg.sym, goff + 2) == ty_float() }
        return false
    }
    if k == nk_unary() {
        return ast_get(cg.nodes, nid, 1) == uop_neg() and scan_infer_f64(cg, cands, ast_get(cg.nodes, nid, 2))
    }
    if k == nk_binary() {
        op := ast_get(cg.nodes, nid, 1)
        if op == op_add() or op == op_wrap_add() or op == op_sub() or op == op_wrap_sub() or op == op_mul() or op == op_wrap_mul() or op == op_div() {
            return scan_infer_f64(cg, cands, ast_get(cg.nodes, nid, 2)) or scan_infer_f64(cg, cands, ast_get(cg.nodes, nid, 3))
        }
        return false
    }
    if k == nk_cast() {
        tn := ast_get(cg.nodes, nid, 2)
        if tn > 0 and ast_kind(cg.nodes, tn) == nk_ty_named() {
            return pool_str_eq_lit(p, ast_get(cg.nodes, tn, 1), ast_get(cg.nodes, tn, 2), "f64")
        }
        return false
    }
    if k == nk_call() {
        cs := ast_get(cg.nodes, nid, 1)
        cl := ast_get(cg.nodes, nid, 2)
        if pool_str_eq_lit(p, cs, cl, "ptr_read_f32") or pool_str_eq_lit(p, cs, cl, "ptr_read_f64") or pool_str_eq_lit(p, cs, cl, "sqrt_f64") or pool_str_eq_lit(p, cs, cl, "dlpack_dot_f32") { return true }
        if find_struct_idx(p, cg.sym, cs, cl) >= 0 { return false }
        fidx := find_fn_idx(p, cg.sym, cs, cl)
        if fidx >= 0 {
            fo := ibuf_get(cg.sym, 7) + fidx * 10
            return ibuf_get(cg.sym, fo + 5) == ty_float()
        }
    }
    return false
}

fn scan_is_immut_const_e(cg: CodegenCtx, cands: IntBuf, nid: i64) -> bool {
    if nid <= 0 { return false }
    k := ast_kind(cg.nodes, nid)
    if k == nk_int() { return true }
    if k == nk_ident() or k == nk_move_ident() {
        cb := scan_cand_find(cg.pool, cands, ast_get(cg.nodes, nid, 1), ast_get(cg.nodes, nid, 2))
        if cb >= 0 { return ibuf_get(cands, cb + 2) == 1 and ibuf_get(cands, cb + 3) == -3 }
        return false
    }
    if k == nk_binary() and ibuf_get(cg.state, 0) == 0 {
        op := ast_get(cg.nodes, nid, 1)
        if op == op_add() or op == op_sub() or op == op_mul() or op == op_bit_and() or op == op_bit_or() or op == op_bit_xor() or op == op_shl() or op == op_shr() {
            return scan_is_immut_const_e(cg, cands, ast_get(cg.nodes, nid, 2)) and scan_is_immut_const_e(cg, cands, ast_get(cg.nodes, nid, 3))
        }
    }
    return false
}

fn ldepth_weight_ax(d: i64) -> i64 {
    if d <= 0 { return 1 }
    if d == 1 { return 64 }
    if d == 2 { return 1024 }
    return 16384
}

fn ast_uses_ident_ax(cg: CodegenCtx, nid: i64, soff: i64, slen: i64) -> bool {
    if nid <= 0 { return false }
    k := ast_kind(cg.nodes, nid)
    if k == nk_ident() or k == nk_move_ident() {
        return ast_get(cg.nodes, nid, 2) == slen and pool_str_eq2(cg.pool, ast_get(cg.nodes, nid, 1), slen, soff)
    }
    if k == nk_int() or k == nk_float() or k == nk_bool() or k == nk_str() or k == nk_break() or k == nk_continue() { return false }
    if k == nk_var_decl() { return ast_uses_ident_ax(cg, ast_get(cg.nodes, nid, 5), soff, slen) }
    if k == nk_assign() { return ast_uses_ident_ax(cg, ast_get(cg.nodes, nid, 2), soff, slen) or ast_uses_ident_ax(cg, ast_get(cg.nodes, nid, 3), soff, slen) }
    if k == nk_binary() { return ast_uses_ident_ax(cg, ast_get(cg.nodes, nid, 2), soff, slen) or ast_uses_ident_ax(cg, ast_get(cg.nodes, nid, 3), soff, slen) }
    if k == nk_unary() { return ast_uses_ident_ax(cg, ast_get(cg.nodes, nid, 2), soff, slen) }
    if k == nk_expr_stmt() or k == nk_return() or k == nk_cast() { return ast_uses_ident_ax(cg, ast_get(cg.nodes, nid, 1), soff, slen) }
    if k == nk_if() or k == nk_if_expr() {
        return ast_uses_ident_ax(cg, ast_get(cg.nodes, nid, 1), soff, slen) or ast_uses_ident_ax(cg, ast_get(cg.nodes, nid, 2), soff, slen) or ast_uses_ident_ax(cg, ast_get(cg.nodes, nid, 3), soff, slen)
    }
    if k == nk_while() {
        return ast_uses_ident_ax(cg, ast_get(cg.nodes, nid, 1), soff, slen) or ast_uses_ident_ax(cg, ast_get(cg.nodes, nid, 2), soff, slen)
    }
    if k == nk_block() {
        off := ast_get(cg.nodes, nid, 1); cnt := ast_get(cg.nodes, nid, 2)
        mut i := 0
        while i < cnt {
            if ast_uses_ident_ax(cg, ibuf_get(cg.extra, off + i), soff, slen) { return true }
            i += 1
        }
        return ast_uses_ident_ax(cg, ast_get(cg.nodes, nid, 3), soff, slen)
    }
    if k == nk_call() {
        aoff := ast_get(cg.nodes, nid, 3); acnt := ast_get(cg.nodes, nid, 4)
        mut i := 0
        while i < acnt {
            if ast_uses_ident_ax(cg, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + i), 4), soff, slen) { return true }
            i += 1
        }
        return false
    }
    return true // Conservative for any other AST node
}

fn match_load_cmp_store_3_ax(cg: CodegenCtx, st_a: i64, st_b: i64, st_c: i64) -> bool {
    // Match `v := ptr_read_i64(A, src); if v <cmp> key { break }; ptr_write_i64(A, dst, v)`
    if ast_kind(cg.nodes, st_a) != nk_var_decl() or ast_get(cg.nodes, st_a, 3) != 0 or ast_get(cg.nodes, st_a, 4) > 0 or (ast_get(cg.nodes, st_a, 6) & 1) != 0 { return false }
    if ast_kind(cg.nodes, st_b) != nk_if() or ast_get(cg.nodes, st_b, 3) > 0 { return false }
    if ast_kind(cg.nodes, st_c) != nk_expr_stmt() { return false }
    vs := ast_get(cg.nodes, st_a, 1); vl := ast_get(cg.nodes, st_a, 2)
    ie := ast_get(cg.nodes, st_a, 5)
    if ie <= 0 or ast_kind(cg.nodes, ie) != nk_call() or ast_get(cg.nodes, ie, 4) != 2 { return false }
    if not pool_str_eq_lit(cg.pool, ast_get(cg.nodes, ie, 1), ast_get(cg.nodes, ie, 2), "ptr_read_i64") { return false }
    cb := ast_get(cg.nodes, st_b, 1); tbb := ast_get(cg.nodes, st_b, 2)
    if cb <= 0 or tbb <= 0 or ast_kind(cg.nodes, cb) != nk_binary() { return false }
    op_b := ast_get(cg.nodes, cb, 1)
    if op_b < op_eq() or op_b > op_gte() { return false }
    if ast_kind(cg.nodes, tbb) != nk_block() or ast_get(cg.nodes, tbb, 2) != 1 { return false }
    if ast_kind(cg.nodes, ibuf_get(cg.extra, ast_get(cg.nodes, tbb, 1))) != nk_break() { return false }
    bl := ast_get(cg.nodes, cb, 2)
    if bl <= 0 or ast_kind(cg.nodes, bl) != nk_ident() or ast_get(cg.nodes, bl, 2) != vl or not pool_str_eq2(cg.pool, ast_get(cg.nodes, bl, 1), vl, vs) { return false }
    wr := ast_get(cg.nodes, st_c, 1)
    if wr <= 0 or ast_kind(cg.nodes, wr) != nk_call() or ast_get(cg.nodes, wr, 4) != 3 { return false }
    if not pool_str_eq_lit(cg.pool, ast_get(cg.nodes, wr, 1), ast_get(cg.nodes, wr, 2), "ptr_write_i64") { return false }
    wa := ast_get(cg.nodes, wr, 3)
    ve := ast_get(cg.nodes, ibuf_get(cg.extra, wa + 2), 4)
    if ve <= 0 or ast_kind(cg.nodes, ve) != nk_ident() or ast_get(cg.nodes, ve, 2) != vl or not pool_str_eq2(cg.pool, ast_get(cg.nodes, ve, 1), vl, vs) { return false }
    return true
}

fn scan_walk_ast_ax(cg: CodegenCtx, cands: IntBuf, nid: i64, ldepth: i64) {
    if nid <= 0 { return }
    nodes := cg.nodes
    extra := cg.extra
    k := ast_kind(nodes, nid)
    if k == nk_secret_str() {
        ibuf_set(cg.state, 97, 1)
        return
    }
    if k == nk_ident() or k == nk_move_ident() {
        cb := scan_cand_find(cg.pool, cands, ast_get(nodes, nid, 1), ast_get(nodes, nid, 2))
        if cb >= 0 and ibuf_get(cands, cb + 3) >= 0 {
            w := ldepth_weight_ax(ldepth)
            ibuf_set(cands, cb + 3, ibuf_get(cands, cb + 3) + w)
            ibuf_set(cands, cb + 6, scan_pos_next(cg))
        }
        return
    }
    if k == nk_block() or k == nk_unsafe_block() {
        if k == nk_unsafe_block() {
            ub := ast_get(nodes, nid, 1)
            scan_walk_ast_ax(cg, cands, ub, ldepth)
            return
        }
        fb := cg_fpromo_base(cg)
        prev_blk := ibuf_get(cg.state, fb + 123)
        my_blk := scan_pos_next(cg)
        ibuf_set(cg.state, fb + 123, my_blk)
        off := ast_get(nodes, nid, 1)
        cnt := ast_get(nodes, nid, 2)
        tail_e := ast_get(nodes, nid, 3)
        mut i := 0
        while i < cnt {
            st_i := ibuf_get(extra, off + i)
            if i + 2 < cnt and match_load_cmp_store_3_ax(cg, st_i, ibuf_get(extra, off + i + 1), ibuf_get(extra, off + i + 2)) {
                vs := ast_get(nodes, st_i, 1); vl := ast_get(nodes, st_i, 2)
                mut dead_after := not ast_uses_ident_ax(cg, tail_e, vs, vl)
                mut j := i + 3
                while dead_after and j < cnt {
                    if ast_uses_ident_ax(cg, ibuf_get(extra, off + j), vs, vl) { dead_after = false }
                    j += 1
                }
                if dead_after {
                    // `v` stays in scratch RCX via `try_emit_load_cmp_store_3_ax`: walk operands, don't waste a GPR!
                    scan_walk_ast_ax(cg, cands, ast_get(nodes, st_i, 5), ldepth)
                    st_b := ibuf_get(extra, off + i + 1)
                    scan_walk_ast_ax(cg, cands, ast_get(nodes, ast_get(nodes, st_b, 1), 3), ldepth)
                    st_c := ibuf_get(extra, off + i + 2)
                    wa := ast_get(nodes, ast_get(nodes, st_c, 1), 3)
                    scan_walk_ast_ax(cg, cands, ast_get(nodes, ibuf_get(extra, wa), 4), ldepth)
                    scan_walk_ast_ax(cg, cands, ast_get(nodes, ibuf_get(extra, wa + 1), 4), ldepth)
                    i += 3
                    continue
                }
            }
            scan_walk_ast_ax(cg, cands, st_i, ldepth)
            i += 1
        }
        if tail_e > 0 {
            scan_walk_ast_ax(cg, cands, tail_e, ldepth)
        }
        bend := scan_pos_next(cg)
        mut ci := 0
        while ci < ibuf_len(cands) {
            if ibuf_get(cands, ci + 5) == 0 - my_blk {
                ibuf_set(cands, ci + 5, bend)
            }
            ci += 7
        }
        ibuf_set(cg.state, fb + 123, prev_blk)
        return
    }
    if k == nk_var_decl() {
        vsoff := ast_get(nodes, nid, 1)
        vslen := ast_get(nodes, nid, 2)
        ty_nid := ast_get(nodes, nid, 4)
        init_e := ast_get(nodes, nid, 5)
        ptag := ast_get(nodes, nid, 6)
        if (ptag & 1) != 0 { ibuf_set(cg.state, 97, 1) }
        scan_walk_ast_ax(cg, cands, init_e, ldepth)
        mut ok_scalar := 0
        if (ptag & 1) == 0 {
            if ty_nid > 0 {
                if ast_kind(nodes, ty_nid) == nk_ty_named() {
                    ts := ast_get(nodes, ty_nid, 1)
                    tl := ast_get(nodes, ty_nid, 2)
                    if pool_str_eq_lit(cg.pool, ts, tl, "i64") or pool_str_eq_lit(cg.pool, ts, tl, "bool") or pool_str_eq_lit(cg.pool, ts, tl, "isize") or pool_str_eq_lit(cg.pool, ts, tl, "usize") {
                        ok_scalar = 1
                    } else if pool_str_eq_lit(cg.pool, ts, tl, "f64") {
                        ok_scalar = 2
                    }
                }
            } else if scan_infer_int_bool(cg, cands, init_e) {
                ok_scalar = 1
            } else if scan_infer_f64(cg, cands, init_e) {
                ok_scalar = 2
            }
        }
        cur_blk := ibuf_get(cg.state, cg_fpromo_base(cg) + 123)
        cb := scan_cand_find(cg.pool, cands, vsoff, vslen)
        if cb >= 0 {
            if ibuf_get(cands, cb + 5) > 0 and ok_scalar != 0 and ibuf_get(cands, cb + 2) == ok_scalar and ibuf_get(cands, cb + 3) >= 0 and ibuf_len(cands) + 7 <= 8192 {
                // Disjoint sibling block: save prior tightened live interval as continuation record!
                mut eff_prev := ibuf_get(cands, cb + 6)
                if ibuf_get(cands, cb + 5) < eff_prev { eff_prev = ibuf_get(cands, cb + 5) }
                scan_push_cand(cands, 0 - 1 - cb, -1, 0, -1, ibuf_get(cands, cb + 4), eff_prev)
                nfp := scan_pos_next(cg)
                ibuf_set(cands, cb + 4, nfp)
                ibuf_set(cands, cb + 5, 0 - cur_blk)
                ibuf_set(cands, cb + 6, nfp)
                ibuf_set(cands, cb + 3, ibuf_get(cands, cb + 3) + ldepth_weight_ax(ldepth))
            } else {
                ibuf_set(cands, cb + 2, 0)
                ibuf_set(cands, cb + 3, -1) // Disqualify nested shadowing / type mismatch
            }
        } else {
            mut init_w := -1
            if ast_get(nodes, nid, 3) == 0 and (ptag & 1) == 0 and ok_scalar == 1 and scan_is_immut_const_e(cg, cands, init_e) {
                // Keep `ok_scalar = 1` so derived vars infer i64, but mark `weight = -3` (constant-folded, needs 0 GPRs!)
                init_w = -3
            } else if ok_scalar != 0 {
                init_w = ldepth_weight_ax(ldepth)
            }
            scan_push_cand(cands, vsoff, vslen, ok_scalar, init_w, scan_pos_next(cg), 0 - cur_blk)
            if ok_scalar == 0 { scan_push_call_barrier(cg, cands) }
        }
        return
    }
    if k == nk_tuple_destruct() {
        noff := ast_get(nodes, nid, 1)
        ncnt := ast_get(nodes, nid, 2)
        scan_walk_ast_ax(cg, cands, ast_get(nodes, nid, 3), ldepth)
        scan_push_call_barrier(cg, cands)
        mut i := 0
        while i < ncnt {
            ns := ibuf_get(extra, noff + i * 2)
            nl := ibuf_get(extra, noff + i * 2 + 1)
            cb := scan_cand_find(cg.pool, cands, ns, nl)
            if cb >= 0 { ibuf_set(cands, cb + 3, -1) }
            else { scan_push_cand(cands, ns, nl, 0, -1, 0, 999999999) }
            i += 1
        }
        return
    }
    if k == nk_assign() {
        aop := ast_get(nodes, nid, 1)
        tgt := ast_get(nodes, nid, 2)
        rhs := ast_get(nodes, nid, 3)
        scan_walk_ast_ax(cg, cands, rhs, ldepth)
        tk := ast_kind(nodes, tgt)
        if tk == nk_ident() or tk == nk_move_ident() {
            cb := scan_cand_find(cg.pool, cands, ast_get(nodes, tgt, 1), ast_get(nodes, tgt, 2))
            if cb >= 0 and ibuf_get(cands, cb + 3) >= 0 {
                cur_blk_a := ibuf_get(cg.state, cg_fpromo_base(cg) + 123)
                if aop == aop_eq() and ldepth == 0 and (ast_kind(nodes, rhs) == nk_int() or ast_kind(nodes, rhs) == nk_bool()) and ibuf_get(cands, cb + 5) == 0 - cur_blk_a and ibuf_len(cands) + 7 <= 8192 {
                    // Unconditional top-level literal kill (`u = 0`): split live range so dead gap frees the GPR!
                    scan_push_cand(cands, 0 - 1 - cb, -1, 0, -1, ibuf_get(cands, cb + 4), ibuf_get(cands, cb + 6))
                    nfp := scan_pos_next(cg)
                    ibuf_set(cands, cb + 4, nfp)
                    ibuf_set(cands, cb + 6, nfp)
                } else {
                    ibuf_set(cands, cb + 6, scan_pos_next(cg))
                }
                if aop == aop_eq() or aop == aop_add() or aop == aop_sub() or aop == aop_mul() {
                    ibuf_set(cands, cb + 3, ibuf_get(cands, cb + 3) + ldepth_weight_ax(ldepth))
                }
            }
        } else {
            scan_walk_ast_ax(cg, cands, tgt, ldepth)
            scan_push_call_barrier(cg, cands)
        }
        return
    }
    if k == nk_if() or k == nk_if_expr() {
        scan_walk_ast_ax(cg, cands, ast_get(nodes, nid, 1), ldepth)
        tb := ast_get(nodes, nid, 2)
        eb := ast_get(nodes, nid, 3)
        scan_walk_ast_ax(cg, cands, tb, ldepth)
        scan_walk_ast_ax(cg, cands, eb, ldepth)
        return
    }
    if k == nk_while() {
        if ast_get(nodes, nid, 4) != 0 {
            scan_push_call_barrier(cg, cands)
        }
        lstart := scan_pos_next(cg)
        mut next_d := ldepth + 1
        if ldepth >= 1 {
            cond := ast_get(nodes, nid, 1)
            if cond > 0 and ast_kind(nodes, cond) == nk_binary() {
                cop := ast_get(nodes, cond, 1)
                crhs := ast_get(nodes, cond, 3)
                if (cop == op_lt() or cop == op_lte()) and crhs > 0 and ast_kind(nodes, crhs) == nk_int() {
                    lim := ast_get(nodes, crhs, 1)
                    if lim >= 0 and lim <= 32 { next_d = ldepth }
                }
            }
        }
        scan_walk_ast_ax(cg, cands, ast_get(nodes, nid, 1), next_d)
        scan_walk_ast_ax(cg, cands, ast_get(nodes, nid, 2), next_d)
        scan_extend_loop_lu(cands, lstart, scan_pos_next(cg))
        return
    }
    if k == nk_for_range() or k == nk_par_for_range() {
        if k == nk_par_for_range() { scan_push_call_barrier(cg, cands) }
        vs := ast_get(nodes, nid, 1); vl := ast_get(nodes, nid, 2)
        cb := scan_cand_find(cg.pool, cands, vs, vl)
        if cb >= 0 { ibuf_set(cands, cb + 3, -1) }
        else { scan_push_cand(cands, vs, vl, 0, -1, 0, 999999999) }
        scan_walk_ast_ax(cg, cands, ast_get(nodes, nid, 3), ldepth)
        scan_walk_ast_ax(cg, cands, ast_get(nodes, nid, 4), ldepth)
        lstart := scan_pos_next(cg)
        scan_walk_ast_ax(cg, cands, ast_get(nodes, nid, 5), ldepth + 1)
        scan_extend_loop_lu(cands, lstart, scan_pos_next(cg))
        return
    }
    if k == nk_for_each() or k == nk_par_for_each() {
        ibuf_set(cg.state, 96, 1)
        scan_push_call_barrier(cg, cands)
        vs := ast_get(nodes, nid, 1); vl := ast_get(nodes, nid, 2)
        cb := scan_cand_find(cg.pool, cands, vs, vl)
        if cb >= 0 { ibuf_set(cands, cb + 3, -1) }
        else { scan_push_cand(cands, vs, vl, 0, -1, 0, 999999999) }
        scan_walk_ast_ax(cg, cands, ast_get(nodes, nid, 3), ldepth)
        lstart := scan_pos_next(cg)
        scan_walk_ast_ax(cg, cands, ast_get(nodes, nid, 4), ldepth + 1)
        scan_extend_loop_lu(cands, lstart, scan_pos_next(cg))
        return
    }
    if k == nk_return() or k == nk_expr_stmt() or k == nk_comptime_expr() or k == nk_await() or k == nk_spawn() or k == nk_cast() {
        if k == nk_await() or k == nk_spawn() { scan_push_call_barrier(cg, cands) }
        scan_walk_ast_ax(cg, cands, ast_get(nodes, nid, 1), ldepth)
        if k == nk_return() { scan_push_call_barrier(cg, cands) }
        return
    }
    if k == nk_unary() or k == nk_or_return() {
        if k == nk_unary() { scan_walk_ast_ax(cg, cands, ast_get(nodes, nid, 2), ldepth) }
        else {
            scan_push_call_barrier(cg, cands)
            scan_walk_ast_ax(cg, cands, ast_get(nodes, nid, 1), ldepth)
            scan_walk_ast_ax(cg, cands, ast_get(nodes, nid, 2), ldepth)
        }
        return
    }
    if k == nk_binary() {
        bl := ast_get(nodes, nid, 2); br := ast_get(nodes, nid, 3)
        scan_walk_ast_ax(cg, cands, bl, ldepth)
        scan_walk_ast_ax(cg, cands, br, ldepth)
        if not (scan_infer_int_bool(cg, cands, bl) or scan_infer_f64(cg, cands, bl)) {
            scan_push_call_barrier(cg, cands)
            if ldepth > 0 { ibuf_set(cg.state, 96, 1) }
        }
        return
    }
    if k == nk_in_range() {
        scan_walk_ast_ax(cg, cands, ast_get(nodes, nid, 2), ldepth)
        scan_walk_ast_ax(cg, cands, ast_get(nodes, nid, 3), ldepth)
        scan_walk_ast_ax(cg, cands, ast_get(nodes, nid, 4), ldepth)
        return
    }
    if k == nk_table_alloc() {
        scan_push_call_barrier(cg, cands)
        scan_walk_ast_ax(cg, cands, ast_get(nodes, nid, 3), ldepth)
        return
    }
    if k == nk_field() or k == nk_tuple_idx() or k == nk_index() {
        scan_walk_ast_ax(cg, cands, ast_get(nodes, nid, 1), ldepth)
        if k == nk_index() { scan_walk_ast_ax(cg, cands, ast_get(nodes, nid, 2), ldepth) }
        scan_push_call_barrier(cg, cands)
        return
    }
    if k == nk_call() or k == nk_method_call() {
        mut is_safe_inline := false
        if k == nk_call() {
            cs := ast_get(nodes, nid, 1); cl := ast_get(nodes, nid, 2)
            if pool_str_eq_lit(cg.pool, cs, cl, "ushr64") or pool_str_eq_lit(cg.pool, cs, cl, "popcnt64") or pool_str_eq_lit(cg.pool, cs, cl, "ptr_read_u8") or pool_str_eq_lit(cg.pool, cs, cl, "ptr_read_i64") or pool_str_eq_lit(cg.pool, cs, cl, "ptr_write_u8") or pool_str_eq_lit(cg.pool, cs, cl, "ptr_write_i64") or pool_str_eq_lit(cg.pool, cs, cl, "ptr_read_f32") or pool_str_eq_lit(cg.pool, cs, cl, "ptr_write_f32") or pool_str_eq_lit(cg.pool, cs, cl, "ptr_write_f64") or pool_str_eq_lit(cg.pool, cs, cl, "ptr_read_f64") or pool_str_eq_lit(cg.pool, cs, cl, "sqrt_f64") or pool_str_eq_lit(cg.pool, cs, cl, "ibuf_get") or pool_str_eq_lit(cg.pool, cs, cl, "buf_get") or pool_str_eq_lit(cg.pool, cs, cl, "ibuf_len") or pool_str_eq_lit(cg.pool, cs, cl, "buf_len") or pool_str_eq_lit(cg.pool, cs, cl, "str_len") or pool_str_eq_lit(cg.pool, cs, cl, "buf_put_u32") or pool_str_eq_lit(cg.pool, cs, cl, "buf_put_u64") or pool_str_eq_lit(cg.pool, cs, cl, "buf_fill_u32") {
                is_safe_inline = true
            } else if ldepth > 0 and not (pool_str_eq_lit(cg.pool, cs, cl, "mem_find_u16") or pool_str_eq_lit(cg.pool, cs, cl, "mem_parse_u64")) {
                ibuf_set(cg.state, 96, 1)
            }
        } else if ldepth > 0 {
            ibuf_set(cg.state, 96, 1)
        }
        mut aoff := 0; mut acnt := 0
        if k == nk_call() { aoff = ast_get(nodes, nid, 3); acnt = ast_get(nodes, nid, 4) }
        else { scan_walk_ast_ax(cg, cands, ast_get(nodes, nid, 1), ldepth); aoff = ast_get(nodes, nid, 4); acnt = ast_get(nodes, nid, 5) }
        mut i := 0
        while i < acnt {
            ca := ibuf_get(extra, aoff + i)
            ae := ast_get(nodes, ca, 4)
            if ast_get(nodes, ca, 1) == pmode_mut() and (ast_kind(nodes, ae) == nk_ident() or ast_kind(nodes, ae) == nk_move_ident()) {
                cb := scan_cand_find(cg.pool, cands, ast_get(nodes, ae, 1), ast_get(nodes, ae, 2))
                if cb >= 0 { ibuf_set(cands, cb + 3, -1) }
            } else {
                scan_walk_ast_ax(cg, cands, ae, ldepth)
            }
            i += 1
        }
        if not is_safe_inline {
            scan_push_call_barrier(cg, cands)
        }
        return
    }
    if k == nk_tuple() {
        off := ast_get(nodes, nid, 1); cnt := ast_get(nodes, nid, 2)
        mut i := 0
        while i < cnt { scan_walk_ast_ax(cg, cands, ibuf_get(extra, off + i), ldepth); i += 1 }
        scan_push_call_barrier(cg, cands)
        return
    }
    if k == nk_fstr() {
        scan_push_call_barrier(cg, cands)
        off := ast_get(nodes, nid, 1); cnt := ast_get(nodes, nid, 2)
        mut i := 0
        while i < cnt {
            scan_walk_ast_ax(cg, cands, ibuf_get(extra, off + i), ldepth)
            i += 1
        }
        return
    }
    if k != nk_int() and k != nk_float() and k != nk_bool() and k != nk_str() and k != nk_dec() and k != nk_break() and k != nk_continue() {
        scan_touch_all_open(cg, cands)
        scan_push_call_barrier(cg, cands)
        if ldepth > 0 { ibuf_set(cg.state, 96, 1) }
    }
}

fn scan_push_call_barrier(cg: CodegenCtx, cands: IntBuf) {
    if ibuf_get(cg.state, 96) != 0 or ibuf_get(cg.state, 97) != 0 { return }
    if ibuf_len(cands) + 7 <= 8192 {
        scan_push_cand(cands, -2, -2, 0, -1, scan_pos_next(cg), 0)
    } else {
        ibuf_set(cg.state, 96, 1)
    }
}

fn scan_has_call_in_range(cands: IntBuf, fp: i64, be: i64) -> bool {
    mut i := 0
    while i < ibuf_len(cands) {
        if ibuf_get(cands, i) == -2 and ibuf_get(cands, i + 1) == -2 {
            cp := ibuf_get(cands, i + 4)
            if cp >= fp and cp <= be { return true }
        }
        i += 7
    }
    return false
}

fn scan_promo_vars_ax(cg: CodegenCtx, p_base: i64, p_cnt: i64, body_nid: i64) {
    ibuf_set(cg.state, 96, 0)
    ibuf_set(cg.state, 97, 0)
    ibuf_set(cg.state, 98, 0)
    ibuf_set(cg.state, 99, 0)
    ibuf_set(cg.state, 161, 0)
    ibuf_set(cg.state, 162, 0)
    mut zi := 0
    while zi < 15 { ibuf_set(cg.state, 231 + zi, 0); zi += 1 }
    zi = 0
    while zi < 5 { ibuf_set(cg.state, 163 + zi, 0); zi += 1 }
    zi = 0
    while zi < 10 { ibuf_set(cg.state, 246 + zi, 0); zi += 1 }
    fb := cg_fpromo_base(cg)
    zi = 0
    while zi < 140 { ibuf_set(cg.state, fb + zi, 0); zi += 1 }
    if body_nid <= 0 { return }

    cands := ibuf_new(8192)
    mut pi := 0
    while pi < p_cnt {
        po := p_base + pi * 6
        pmode := ibuf_get(cg.sym, po + 2)
        pty := ibuf_get(cg.sym, po + 3)
        mut ok := 0
        mut w := -1
        if pmode != pmode_mut() {
            if pty == ty_int() or pty == ty_bool() {
                ok = 1; w = 1
            } else if pty == ty_float() {
                ok = 2; w = 1
            }
        }
        scan_push_cand(cands, ibuf_get(cg.sym, po), ibuf_get(cg.sym, po + 1), ok, w, 0, 999999999)
        pi += 1
    }

    scan_walk_ast_ax(cg, cands, body_nid, 0)

    // Linear-scan / loop-extended last-use GPR promotion -> call-free volatile `R10, R11` + callee-saved `RBX, R12..R15` (+ `RSI, RDI` on Win64!)
    max_gpr := cg_max_gpr(cg)
    allow_vol := ibuf_get(cg.state, 96) == 0 and ibuf_get(cg.state, 97) == 0
    mut min_gpr_w := 16
    if ast_kind(cg.nodes, body_nid) == nk_block() and ast_get(cg.nodes, body_nid, 2) <= 10 {
        min_gpr_w = 3
    }
    cnt := ibuf_len(cands) / 7
    gb := cg_gpromo_base(cg)
    r_ivs := ibuf_new(2048) // `[reg, first_pos, eff_end]`
    mut mask := 0
    mut prim_cnt := 0
    mut total_pick := 0
    while total_pick < 30 {
        mut best_b := -1
        mut best_w := min_gpr_w
        mut i := 0
        while i < cnt {
            b := i * 7
            w := ibuf_get(cands, b + 3)
            if ibuf_get(cands, b + 2) == 1 and w > best_w {
                best_w = w
                best_b = b
            }
            i += 1
        }
        if best_b < 0 { break }
        ibuf_set(cands, best_b + 3, -2)
        fp := ibuf_get(cands, best_b + 4)
        mut be := ibuf_get(cands, best_b + 6) // tightened loop-extended last_use!
        blk_e := ibuf_get(cands, best_b + 5)
        if blk_e > 0 and blk_e < be { be = blk_e }
        if be < fp { be = fp }
        cont_tag := 0 - 1 - best_b
        mut can_vol := allow_vol and fp > 0 and not scan_has_call_in_range(cands, fp, be)
        if can_vol {
            mut cv := 0
            while cv < ibuf_len(cands) {
                if ibuf_get(cands, cv) == cont_tag {
                    cfp := ibuf_get(cands, cv + 4)
                    mut cbe := ibuf_get(cands, cv + 5)
                    if cbe <= 0 { cbe = 999999999 }
                    if scan_has_call_in_range(cands, cfp, cbe) { can_vol = false; break }
                }
                cv += 7
            }
        }
        mut chosen_r := 0
        mut try_idx := 0
        mut max_try := max_gpr
        if can_vol { max_try = max_gpr + 3 }
        while try_idx < max_try {
            // Try volatile R10(8), R11(9), R8(10) FIRST for call-free locals so callee-saved regs stay free for cross-call vars!
            mut r := try_idx + 1
            if can_vol {
                if try_idx == 0 { r = 8 }
                else if try_idx == 1 { r = 9 }
                else if try_idx == 2 { r = 10 }
                else { r = try_idx - 2 }
            }
            mut fits := true
            mut iv := 0
            while iv < ibuf_len(r_ivs) {
                if ibuf_get(r_ivs, iv) == r {
                    af := ibuf_get(r_ivs, iv + 1)
                    ae := ibuf_get(r_ivs, iv + 2)
                    if not (be < af or ae < fp) {
                        fits = false
                        break
                    }
                    mut ci := 0
                    while ci < ibuf_len(cands) {
                        if ibuf_get(cands, ci) == cont_tag {
                            cfp := ibuf_get(cands, ci + 4)
                            mut cbe := ibuf_get(cands, ci + 5)
                            if cbe <= 0 { cbe = 999999999 }
                            if not (cbe < af or ae < cfp) {
                                fits = false
                                break
                            }
                        }
                        ci += 7
                    }
                    if not fits { break }
                }
                iv += 3
            }
            if fits {
                chosen_r = r
                break
            }
            try_idx += 1
        }
        if chosen_r > 0 {
            ibuf_push(r_ivs, chosen_r)
            ibuf_push(r_ivs, fp)
            ibuf_push(r_ivs, be)
            mut ci2 := 0
            while ci2 < ibuf_len(cands) {
                if ibuf_get(cands, ci2) == cont_tag {
                    ibuf_push(r_ivs, chosen_r)
                    ibuf_push(r_ivs, ibuf_get(cands, ci2 + 4))
                    mut cbe2 := ibuf_get(cands, ci2 + 5)
                    if cbe2 <= 0 { cbe2 = 999999999 }
                    ibuf_push(r_ivs, cbe2)
                }
                ci2 += 7
            }
            if (mask & (1 << chosen_r)) == 0 {
                if chosen_r <= 5 {
                    ibuf_set(cg.state, 236 + (chosen_r - 1) * 2, ibuf_get(cands, best_b))
                    ibuf_set(cg.state, 237 + (chosen_r - 1) * 2, ibuf_get(cands, best_b + 1))
                } else if chosen_r <= 7 {
                    ibuf_set(cg.state, fb + 117 + (chosen_r - 6) * 2, ibuf_get(cands, best_b))
                    ibuf_set(cg.state, fb + 118 + (chosen_r - 6) * 2, ibuf_get(cands, best_b + 1))
                } else if chosen_r <= 9 {
                    ibuf_set(cg.state, fb + 126 + (chosen_r - 8) * 2, ibuf_get(cands, best_b))
                    ibuf_set(cg.state, fb + 127 + (chosen_r - 8) * 2, ibuf_get(cands, best_b + 1))
                } else {
                    ibuf_set(cg.state, fb + 131, ibuf_get(cands, best_b))
                    ibuf_set(cg.state, fb + 132, ibuf_get(cands, best_b + 1))
                }
                mask = mask | (1 << chosen_r)
                prim_cnt += 1
            } else {
                ecnt := ibuf_get(cg.state, gb)
                if ecnt < 30 {
                    eo := gb + 1 + ecnt * 3
                    ibuf_set(cg.state, eo, ibuf_get(cands, best_b))
                    ibuf_set(cg.state, eo + 1, ibuf_get(cands, best_b + 1))
                    ibuf_set(cg.state, eo + 2, chosen_r)
                    ibuf_set(cg.state, gb, ecnt + 1)
                }
            }
            total_pick += 1
        } else if prim_cnt >= max_gpr {
            // Still check remaining disjoint inner-loop candidates even if top-level saturated!
            total_pick += 1
        }
    }
    buf_free(move r_ivs)
    ibuf_set(cg.state, 98, mask)

    // Pick top 8 loop-hot `f64` variables -> `XMM6..XMM13` (only when loop calls cannot clobber XMM6..13!)
    if ibuf_get(cg.state, 96) == 0 {
        mut fmask := 0
        mut freg := 1
        while freg <= 8 {
            mut best_b := -1
            mut best_w := 64
            mut i := 0
            while i < cnt {
                b := i * 7
                w := ibuf_get(cands, b + 3)
                if ibuf_get(cands, b + 2) == 2 and w > best_w {
                    best_w = w
                    best_b = b
                }
                i += 1
            }
            if best_b < 0 { break }
            ibuf_set(cands, best_b + 3, -2)
            if freg <= 5 {
                ibuf_set(cg.state, 246 + (freg - 1) * 2, ibuf_get(cands, best_b))
                ibuf_set(cg.state, 247 + (freg - 1) * 2, ibuf_get(cands, best_b + 1))
            } else {
                ibuf_set(cg.state, fb + 8 + (freg - 6) * 2, ibuf_get(cands, best_b))
                ibuf_set(cg.state, fb + 9 + (freg - 6) * 2, ibuf_get(cands, best_b + 1))
            }
            fmask = fmask | (1 << freg)
            freg += 1
        }
        ibuf_set(cg.state, 161, fmask)
    }
    buf_free(move cands)
}

fn emit_rax_op_slot(cg: CodegenCtx, op: i64, rslot: i64) {
    rr := cg_slot_reg(cg, rslot)
    if rr > 0 {
        emit_rax_op_gpreg(cg, op, rr)
        return
    }
    c := cg.code
    shd := ibuf_get(cg.state, 0)
    if op == op_add() or op == op_wrap_add() {
        mc_rbp_slot(c, 0x480300, rslot, 0)
        if op == op_add() and shd == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
    } else if op == op_sub() or op == op_wrap_sub() {
        mc_rbp_slot(c, 0x482B00, rslot, 0)
        if op == op_sub() and shd == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
    } else if op == op_mul() or op == op_wrap_mul() {
        mc_load_rcx(c, rslot, 0)
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
        if op == op_mul() and shd == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
    } else if op == op_bit_and() {
        mc_rbp_slot(c, 0x482300, rslot, 0)
    } else if op == op_bit_or() {
        mc_rbp_slot(c, 0x480B00, rslot, 0)
    } else if op == op_bit_xor() {
        mc_rbp_slot(c, 0x483300, rslot, 0)
    } else if op == op_shl() {
        mc_load_rcx(c, rslot, 0)
        mc_b3(c, 0x48, 0xD3, 0xE0)
    } else if op == op_shr() {
        mc_load_rcx(c, rslot, 0)
        mc_b3(c, 0x48, 0xD3, 0xF8)
    } else {
        mc_cmp_rax_slot(c, rslot, 0)
        emit_rax_cmp_setcc(c, op)
    }
}

fn emit_rax_op_rcx(cg: CodegenCtx, op: i64) {
    c := cg.code
    shd := ibuf_get(cg.state, 0)
    if op == op_add() or op == op_wrap_add() {
        mc_b3(c, 0x48, 0x01, 0xC8)
        if op == op_add() and shd == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
    } else if op == op_sub() or op == op_wrap_sub() {
        mc_b3(c, 0x48, 0x29, 0xC8)
        if op == op_sub() and shd == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
    } else if op == op_mul() or op == op_wrap_mul() {
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
        if op == op_mul() and shd == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
    } else if op == op_bit_and() {
        mc_b3(c, 0x48, 0x21, 0xC8)
    } else if op == op_bit_or() {
        mc_b3(c, 0x48, 0x09, 0xC8)
    } else if op == op_bit_xor() {
        mc_b3(c, 0x48, 0x31, 0xC8)
    } else if op == op_shl() {
        mc_b3(c, 0x48, 0xD3, 0xE0)
    } else if op == op_shr() {
        mc_b3(c, 0x48, 0xD3, 0xF8)
    } else {
        mc_b3(c, 0x48, 0x39, 0xC8)
        emit_rax_cmp_setcc(c, op)
    }
}

fn local_scalar_slot_ax(cg: CodegenCtx, vars: IntBuf, nid: i64) -> i64 {
    if nid <= 0 { return 0 }
    k := ast_kind(cg.nodes, nid)
    if k == nk_ident() or k == nk_move_ident() {
        vb := cg_var_find(cg.pool, vars, ast_get(cg.nodes, nid, 1), ast_get(cg.nodes, nid, 2))
        if vb >= 0 {
            vty := ibuf_get(vars, vb + 3)
            if vty == ty_int() or vty == ty_bool() {
                return ibuf_get(vars, vb + 2)
            }
        }
    }
    return 0
}

fn is_pure_i64_op_ax(op: i64) -> bool {
    if op == op_add() or op == op_wrap_add() or op == op_sub() or op == op_wrap_sub() or op == op_mul() or op == op_wrap_mul() {
        return true
    }
    if op == op_bit_and() or op == op_bit_or() or op == op_bit_xor() or op == op_shl() or op == op_shr() {
        return true
    }
    return op >= op_eq() and op <= op_gte()
}

// Returns `ty_int()` or `ty_bool()` iff `nid` evaluates purely as an unboxed 64-bit value with zero temp-slot allocations needed for `RAX` emission.
fn pure_i64_ty_ax(cg: CodegenCtx, vars: IntBuf, nid: i64) -> i64 {
    if nid <= 0 { return 0 }
    k := ast_kind(cg.nodes, nid)
    if k == nk_int() { return ty_int() }
    if k == nk_bool() { return ty_bool() }
    if k == nk_ident() or k == nk_move_ident() {
        soff := ast_get(cg.nodes, nid, 1)
        slen := ast_get(cg.nodes, nid, 2)
        vb := cg_var_find(cg.pool, vars, soff, slen)
        if vb >= 0 {
            vty := ibuf_get(vars, vb + 3)
            if vty == ty_int() or vty == ty_bool() { return vty }
            return 0
        }
        goff := ct_find_global_const(cg.pool, cg.sym, soff, slen)
        if goff >= 0 {
            cty := ibuf_get(cg.sym, goff + 2)
            if cty == ty_int() or cty == ty_bool() { return cty }
        }
        return 0
    }
    if k == nk_unary() {
        uop := ast_get(cg.nodes, nid, 1)
        sty := pure_i64_ty_ax(cg, vars, ast_get(cg.nodes, nid, 2))
        if sty == 0 { return 0 }
        if uop == uop_neg() {
            if sty == ty_int() { return ty_int() }
            return 0
        }
        return ty_bool()
    }
    if k == nk_binary() {
        op := ast_get(cg.nodes, nid, 1)
        if not is_pure_i64_op_ax(op) { return 0 }
        lty := pure_i64_ty_ax(cg, vars, ast_get(cg.nodes, nid, 2))
        if lty == 0 { return 0 }
        rty := pure_i64_ty_ax(cg, vars, ast_get(cg.nodes, nid, 3))
        if rty == 0 { return 0 }
        if op >= op_eq() and op <= op_gte() {
            if lty == rty { return ty_bool() }
            return 0
        }
        if op == op_bit_and() or op == op_bit_or() or op == op_bit_xor() {
            if lty == rty { return lty }
            return 0
        }
        if lty == ty_int() and rty == ty_int() { return ty_int() }
        return 0
    }
    if k == nk_field() {
        fsoff := ast_get(cg.nodes, nid, 2)
        fslen := ast_get(cg.nodes, nid, 3)
        if pool_str_eq_lit(cg.pool, fsoff, fslen, "len") and local_str_slot_ax(cg, vars, ast_get(cg.nodes, nid, 1)) > 0 {
            return ty_int()
        }
        return 0
    }
    if k == nk_index() {
        if local_buf_slot_ax(cg, vars, ast_get(cg.nodes, nid, 1)) > 0 and pure_i64_ty_ax(cg, vars, ast_get(cg.nodes, nid, 2)) == ty_int() {
            return ty_int()
        }
        return 0
    }
    if k == nk_call() {
        csoff := ast_get(cg.nodes, nid, 1)
        cslen := ast_get(cg.nodes, nid, 2)
        aoff := ast_get(cg.nodes, nid, 3)
        acnt := ast_get(cg.nodes, nid, 4)
        p := cg.pool
        if cg_var_find(p, vars, csoff, cslen) >= 0 { return 0 }
        if pool_str_eq_lit(p, csoff, cslen, "ushr64") and acnt == 2 {
            c0 := ibuf_get(cg.extra, aoff)
            c1 := ibuf_get(cg.extra, aoff + 1)
            if ast_get(cg.nodes, c0, 2) < 0 and ast_get(cg.nodes, c1, 2) < 0 {
                e0 := ast_get(cg.nodes, c0, 4)
                e1 := ast_get(cg.nodes, c1, 4)
                if pure_i64_ty_ax(cg, vars, e0) == ty_int() and is_nonshadowed_const_int(cg, vars, e1) {
                    sh := eval_const_int_val(p, cg.nodes, cg.sym, e1)
                    if sh >= 0 and sh <= 63 { return ty_int() }
                }
            }
            return 0
        }
        if pool_str_eq_lit(p, csoff, cslen, "popcnt64") and acnt == 1 {
            c0 := ibuf_get(cg.extra, aoff)
            if ast_get(cg.nodes, c0, 2) < 0 and pure_i64_ty_ax(cg, vars, ast_get(cg.nodes, c0, 4)) == ty_int() {
                return ty_int()
            }
            return 0
        }
        if (pool_str_eq_lit(p, csoff, cslen, "ptr_read_u8") or pool_str_eq_lit(p, csoff, cslen, "ptr_read_i64")) and acnt == 2 {
            c0 := ibuf_get(cg.extra, aoff)
            c1 := ibuf_get(cg.extra, aoff + 1)
            if ast_get(cg.nodes, c0, 2) < 0 and ast_get(cg.nodes, c1, 2) < 0 {
                if pure_i64_ty_ax(cg, vars, ast_get(cg.nodes, c0, 4)) == ty_int() and pure_i64_ty_ax(cg, vars, ast_get(cg.nodes, c1, 4)) == ty_int() {
                    return ty_int()
                }
            }
            return 0
        }
        if (pool_str_eq_lit(p, csoff, cslen, "ibuf_len") or pool_str_eq_lit(p, csoff, cslen, "buf_len")) and acnt == 1 {
            c0 := ibuf_get(cg.extra, aoff)
            if ast_get(cg.nodes, c0, 2) < 0 and local_buf_slot_ax(cg, vars, ast_get(cg.nodes, c0, 4)) > 0 {
                return ty_int()
            }
            return 0
        }
        if pool_str_eq_lit(p, csoff, cslen, "str_len") and acnt == 1 {
            c0 := ibuf_get(cg.extra, aoff)
            if ast_get(cg.nodes, c0, 2) < 0 and local_str_slot_ax(cg, vars, ast_get(cg.nodes, c0, 4)) > 0 {
                return ty_int()
            }
            return 0
        }
        if pool_str_eq_lit(p, csoff, cslen, "len") and acnt == 1 {
            c0 := ibuf_get(cg.extra, aoff)
            if ast_get(cg.nodes, c0, 2) < 0 {
                e0 := ast_get(cg.nodes, c0, 4)
                if local_str_slot_ax(cg, vars, e0) > 0 or local_buf_slot_ax(cg, vars, e0) > 0 {
                    return ty_int()
                }
            }
            return 0
        }
        if (pool_str_eq_lit(p, csoff, cslen, "ibuf_get") or pool_str_eq_lit(p, csoff, cslen, "buf_get")) and acnt == 2 {
            c0 := ibuf_get(cg.extra, aoff)
            c1 := ibuf_get(cg.extra, aoff + 1)
            if ast_get(cg.nodes, c0, 2) < 0 and ast_get(cg.nodes, c1, 2) < 0 {
                if local_buf_slot_ax(cg, vars, ast_get(cg.nodes, c0, 4)) > 0 and pure_i64_ty_ax(cg, vars, ast_get(cg.nodes, c1, 4)) == ty_int() {
                    return ty_int()
                }
            }
            return 0
        }
        if find_struct_idx(p, cg.sym, csoff, cslen) >= 0 { return 0 }
        fidx := find_fn_idx(p, cg.sym, csoff, cslen)
        if fidx < 0 { return 0 }
        if acnt == 0 and is_const_fn_idx(cg.sym, fidx) {
            cty := const_fn_ty(cg.sym, fidx)
            if cty == ty_int() or cty == ty_bool() { return cty }
            return 0
        }
        // Single-arg fast_abi self-recursive / non-inlined scalar call `f(x)` straight into RAX
        if acnt == 1 and fidx == ibuf_get(cg.state, 3) {
            f_off := ibuf_get(cg.sym, 7) + fidx * 10
            p_base := ibuf_get(cg.sym, f_off + 3)
            p_cnt := ibuf_get(cg.sym, f_off + 4)
            r_ty := ibuf_get(cg.sym, f_off + 5)
            fast_abi := ibuf_get(cg.sym, f_off + 8)
            fn_flags := ibuf_get(cg.sym, f_off + 9)
            if fast_abi == 1 and p_cnt == 1 and (fn_flags & (fnflag_extern() | fnflag_comptime() | fnflag_async())) == 0 {
                if (r_ty == ty_int() or r_ty == ty_bool()) and ibuf_get(cg.sym, p_base + 2) != pmode_mut() {
                    p_ty := ibuf_get(cg.sym, p_base + 3)
                    ca := ibuf_get(cg.extra, aoff)
                    if ast_get(cg.nodes, ca, 2) < 0 and (p_ty == ty_int() or p_ty == ty_bool()) {
                        if pure_i64_ty_ax(cg, vars, ast_get(cg.nodes, ca, 4)) == p_ty {
                            return r_ty
                        }
                    }
                }
            }
        }
        return 0
    }
    return 0
}

fn local_buf_slot_ax(cg: CodegenCtx, vars: IntBuf, nid: i64) -> i64 {
    if nid <= 0 { return 0 }
    k := ast_kind(cg.nodes, nid)
    if k == nk_ident() or k == nk_move_ident() {
        vb := cg_var_find(cg.pool, vars, ast_get(cg.nodes, nid, 1), ast_get(cg.nodes, nid, 2))
        if vb >= 0 {
            vty := ibuf_get(vars, vb + 3)
            if vty == ty_intbuf() or vty == ty_bytebuf() {
                return ibuf_get(vars, vb + 2)
            }
        }
    }
    return 0
}

fn local_buf_ty_ax(cg: CodegenCtx, vars: IntBuf, nid: i64) -> i64 {
    if nid <= 0 { return 0 }
    k := ast_kind(cg.nodes, nid)
    if k == nk_ident() or k == nk_move_ident() {
        vb := cg_var_find(cg.pool, vars, ast_get(cg.nodes, nid, 1), ast_get(cg.nodes, nid, 2))
        if vb >= 0 {
            vty := ibuf_get(vars, vb + 3)
            if vty == ty_intbuf() or vty == ty_bytebuf() { return vty }
        }
    }
    return 0
}

fn local_str_slot_ax(cg: CodegenCtx, vars: IntBuf, nid: i64) -> i64 {
    if nid <= 0 { return 0 }
    k := ast_kind(cg.nodes, nid)
    if k == nk_ident() or k == nk_move_ident() {
        vb := cg_var_find(cg.pool, vars, ast_get(cg.nodes, nid, 1), ast_get(cg.nodes, nid, 2))
        if vb >= 0 {
            vty := ibuf_get(vars, vb + 3)
            if vty == ty_str() or ty_tag(vty) == 12 {
                return ibuf_get(vars, vb + 2)
            }
        }
    }
    return 0
}

fn expr_has_real_call_ax(cg: CodegenCtx, nid: i64) -> bool {
    if nid <= 0 { return false }
    k := ast_kind(cg.nodes, nid)
    if k == nk_field() { return false }
    if k == nk_index() { return expr_has_real_call_ax(cg, ast_get(cg.nodes, nid, 2)) }
    if k == nk_unary() {
        return expr_has_real_call_ax(cg, ast_get(cg.nodes, nid, 2))
    }
    if k == nk_binary() {
        return expr_has_real_call_ax(cg, ast_get(cg.nodes, nid, 2)) or expr_has_real_call_ax(cg, ast_get(cg.nodes, nid, 3))
    }
    if k == nk_call() {
        csoff := ast_get(cg.nodes, nid, 1)
        cslen := ast_get(cg.nodes, nid, 2)
        aoff := ast_get(cg.nodes, nid, 3)
        acnt := ast_get(cg.nodes, nid, 4)
        p := cg.pool
        if pool_str_eq_lit(p, csoff, cslen, "ushr64") or pool_str_eq_lit(p, csoff, cslen, "popcnt64") or pool_str_eq_lit(p, csoff, cslen, "ptr_read_u8") or pool_str_eq_lit(p, csoff, cslen, "ptr_read_i64") or pool_str_eq_lit(p, csoff, cslen, "ibuf_len") or pool_str_eq_lit(p, csoff, cslen, "buf_len") or pool_str_eq_lit(p, csoff, cslen, "ibuf_get") or pool_str_eq_lit(p, csoff, cslen, "buf_get") or pool_str_eq_lit(p, csoff, cslen, "str_len") or pool_str_eq_lit(p, csoff, cslen, "len") {
            mut i := 0
            while i < acnt {
                ca := ibuf_get(cg.extra, aoff + i)
                if expr_has_real_call_ax(cg, ast_get(cg.nodes, ca, 4)) { return true }
                i += 1
            }
            return false
        }
        return true
    }
    return false
}

fn emit_rax_op_r9p(cg: CodegenCtx, op: i64, depth: i64) {
    c := cg.code
    shd := ibuf_get(cg.state, 0)
    mr := 0xC1 + depth // R9=0xC1, R10=0xC2, R11=0xC3
    if op == op_add() or op == op_wrap_add() {
        mc_b3(c, 0x49, 0x03, mr)
        if op == op_add() and shd == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
    } else if op == op_mul() or op == op_wrap_mul() {
        mc_b4(c, 0x49, 0x0F, 0xAF, mr)
        if op == op_mul() and shd == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
    } else if op == op_bit_and() {
        mc_b3(c, 0x49, 0x23, mr)
    } else if op == op_bit_or() {
        mc_b3(c, 0x49, 0x0B, mr)
    } else if op == op_bit_xor() {
        mc_b3(c, 0x49, 0x33, mr)
    } else {
        mc_b3(c, 0x48, 0x89, 0xC1) // RCX = rhs
        mc_b3(c, 0x49, 0x8B, mr)   // RAX = R(9+depth) (lhs)
        emit_rax_op_rcx(cg, op)
    }
}

// Fuses `RAX <op>= [base_reg + idx_reg*8 (+ disp8)]` for `ptr_read_i64(ptr_var, idx_var)` in promoted GPRs (0 spill, 0 load!).
fn try_emit_rax_op_ptr_read_i64(cg: CodegenCtx, vars: IntBuf, op: i64, mem_nid: i64) -> bool {
    if mem_nid <= 0 or ast_kind(cg.nodes, mem_nid) != nk_call() or ast_get(cg.nodes, mem_nid, 4) != 2 { return false }
    if not pool_str_eq_lit(cg.pool, ast_get(cg.nodes, mem_nid, 1), ast_get(cg.nodes, mem_nid, 2), "ptr_read_i64") { return false }
    mut opc := 0
    if op == op_bit_xor() { opc = 0x33 }
    else if op == op_add() or op == op_wrap_add() { opc = 0x03 }
    else if op == op_sub() or op == op_wrap_sub() { opc = 0x2B }
    else if op == op_bit_and() { opc = 0x23 }
    else if op == op_bit_or() { opc = 0x0B }
    else { return false }
    aoff := ast_get(cg.nodes, mem_nid, 3)
    e0 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
    e1 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4)
    isl := local_scalar_slot_ax(cg, vars, e1)
    pr_p := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, e0))
    pr_i := cg_slot_reg(cg, isl)
    if pr_p <= 0 or pr_i <= 0 { return false }
    c := cg.code
    b_hw := gpreg_hw(pr_p); b_hi := gpreg_hi(pr_p)
    x_hw := gpreg_hw(pr_i); x_hi := gpreg_hi(pr_i)
    mut disp := 0
    uoff := ibuf_get(cg.state, 24)
    if uoff > 0 and isl == ibuf_get(cg.state, cg_fpromo_base(cg) + 122) {
        disp = uoff * 8
    }
    mut modrm := 0x04
    if b_hw == 5 or disp != 0 { modrm = 0x44 }
    mc_b4(c, 0x48 | (x_hi << 1) | b_hi, opc, modrm, (3 << 6) | (x_hw << 3) | b_hw)
    if b_hw == 5 or disp != 0 { mc_b1(c, disp & 255) }
    if (op == op_add() or op == op_sub()) and ibuf_get(cg.state, 0) == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
    return true
}

fn emit_int_expr_depth_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, enid: i64, depth: i64) {
    c := cg.code
    p := cg.pool
    k := ast_kind(cg.nodes, enid)

    if is_folded_const_int_ax(cg, vars, enid) {
        mc_mov_rax_imm(c, eval_folded_const_int_ax(cg, vars, enid))
        return
    }
    if k == nk_int() or k == nk_bool() {
        mc_mov_rax_imm(c, ast_get(cg.nodes, enid, 1))
        return
    }
    if k == nk_ident() or k == nk_move_ident() {
        soff := ast_get(cg.nodes, enid, 1)
        slen := ast_get(cg.nodes, enid, 2)
        vb := cg_var_find(p, vars, soff, slen)
        if vb >= 0 {
            vs := ibuf_get(vars, vb + 2)
            pr := cg_slot_reg(cg, vs)
            if pr > 0 { mc_mov_rax_gpreg(c, pr) }
            else        { mc_load_rax(c, vs, 0) }
            return
        }
        goff := ct_find_global_const(p, cg.sym, soff, slen)
        mc_mov_rax_imm(c, ibuf_get(cg.sym, goff + 3))
        return
    }
    if k == nk_field() {
        ssl := local_str_slot_ax(cg, vars, ast_get(cg.nodes, enid, 1))
        mc_load_rax(c, ssl, 1)
        return
    }
    if k == nk_index() {
        b_nid := ast_get(cg.nodes, enid, 1)
        i_nid := ast_get(cg.nodes, enid, 2)
        bsl := local_buf_slot_ax(cg, vars, b_nid)
        is_ib := local_buf_ty_ax(cg, vars, b_nid) == ty_intbuf()
        if is_folded_const_int_ax(cg, vars, i_nid) {
            idx := eval_folded_const_int_ax(cg, vars, i_nid)
            mc_load_rcx(c, bsl, 0)
            mc_b3(c, 0x48, 0x85, 0xC9); cg_jmp_fn(cg, 0x84, h_sec_trap())
            if is_ib and idx >= 0 and idx <= 13 {
                mc_b4(c, 0x48, 0x83, 0x39, idx); cg_jmp_fn(cg, 0x86, h_sec_trap())
                mc_b4(c, 0x48, 0x8B, 0x41, 16 + idx * 8)
                return
            }
            if not is_ib and idx >= 0 and idx <= 111 {
                mc_b4(c, 0x48, 0x83, 0x39, idx); cg_jmp_fn(cg, 0x86, h_sec_trap())
                mc_b4(c, 0x0F, 0xB6, 0x41, 16 + idx)
                return
            }
            mc_mov_reg_imm(c, 1, idx)
        } else {
            emit_int_expr_depth_ax(cg, vars, drops, breaks, i_nid, depth)
            mc_b3(c, 0x48, 0x89, 0xC2)
            mc_load_rcx(c, bsl, 0)
            mc_b3(c, 0x48, 0x85, 0xC9); cg_jmp_fn(cg, 0x84, h_sec_trap())
        }
        mc_b3(c, 0x48, 0x3B, 0x11); cg_jmp_fn(cg, 0x83, h_sec_trap())
        if is_ib { mc_b4(c, 0x48, 0x8B, 0x44, 0xD1); mc_b1(c, 0x10) }
        else     { mc_b4(c, 0x0F, 0xB6, 0x44, 0x11); mc_b1(c, 0x10) }
        return
    }
    if k == nk_unary() {
        uop := ast_get(cg.nodes, enid, 1)
        emit_int_expr_depth_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 2), depth)
        if uop == uop_neg() {
            mc_b3(c, 0x48, 0xF7, 0xD8)
            if ibuf_get(cg.state, 0) == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
        } else {
            mc_b3(c, 0x48, 0x85, 0xC0)
            mc_b3(c, 0x0F, 0x94, 0xC0)
            mc_b3(c, 0x0F, 0xB6, 0xC0)
        }
        return
    }
    if k == nk_binary() {
        op := ast_get(cg.nodes, enid, 1)
        lhs := ast_get(cg.nodes, enid, 2)
        rhs := ast_get(cg.nodes, enid, 3)
        if (op == op_add() or op == op_wrap_add()) and (op == op_wrap_add() or ibuf_get(cg.state, 0) == 0) {
            mut pr_l := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, lhs))
            mut pr_r := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, rhs))
            if pr_l > 0 and pr_r > 0 {
                if gpreg_hw(pr_r) == 4 { tmp_r := pr_l; pr_l = pr_r; pr_r = tmp_r }
                if gpreg_hw(pr_r) != 4 {
                    b_hw := gpreg_hw(pr_l); b_hi := gpreg_hi(pr_l)
                    x_hw := gpreg_hw(pr_r); x_hi := gpreg_hi(pr_r)
                    mut modrm := 0x04
                    if b_hw == 5 { modrm = 0x44 }
                    mc_b4(c, 0x48 | (x_hi << 1) | b_hi, 0x8D, modrm, (x_hw << 3) | b_hw)
                    if b_hw == 5 { mc_b1(c, 0) } // 1-insn `LEA RAX, [pr_l + pr_r]`!
                    return
                }
            }
        }
        if is_folded_const_int_ax(cg, vars, rhs) {
            imm := eval_folded_const_int_ax(cg, vars, rhs)
            if (op == op_add() or op == op_wrap_add()) and (op == op_wrap_add() or ibuf_get(cg.state, 0) == 0) and imm >= -128 and imm <= 127 and ast_kind(cg.nodes, lhs) == nk_binary() {
                lop := ast_get(cg.nodes, lhs, 1)
                if (lop == op_mul() or lop == op_wrap_mul()) and is_folded_const_int_ax(cg, vars, ast_get(cg.nodes, lhs, 3)) {
                    mk := eval_folded_const_int_ax(cg, vars, ast_get(cg.nodes, lhs, 3))
                    if mk == 2 or mk == 3 {
                        pr_x := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, lhs, 2)))
                        if pr_x > 0 and gpreg_hw(pr_x) != 4 {
                            xhw := gpreg_hw(pr_x); xhi := gpreg_hi(pr_x)
                            mut sc := 0
                            if mk == 3 { sc = 1 }
                            mc_b4(c, 0x48 | (xhi << 1) | xhi, 0x8D, 0x44, (sc << 6) | (xhw << 3) | xhw)
                            mc_b1(c, imm & 255) // LEA RAX, [pr_x + pr_x*(1|2) + imm8]
                            return
                        }
                    }
                }
            }
            if op == op_bit_and() and imm == 255 and ast_kind(cg.nodes, lhs) == nk_call() and pool_str_eq_lit(p, ast_get(cg.nodes, lhs, 1), ast_get(cg.nodes, lhs, 2), "ptr_read_u8") {
                emit_int_expr_depth_ax(cg, vars, drops, breaks, lhs, depth)
                return
            }
            if op == op_bit_and() and imm == 255 and ast_kind(cg.nodes, lhs) == nk_binary() and ast_get(cg.nodes, lhs, 1) == op_bit_xor() {
                xl := ast_get(cg.nodes, lhs, 2)
                xr := ast_get(cg.nodes, lhs, 3)
                mut u8_n := 0
                mut pr_x := 0
                if xl > 0 and ast_kind(cg.nodes, xl) == nk_call() and pool_str_eq_lit(p, ast_get(cg.nodes, xl, 1), ast_get(cg.nodes, xl, 2), "ptr_read_u8") {
                    pr_x = cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, xr))
                    if pr_x > 0 { u8_n = xl }
                } else if xr > 0 and ast_kind(cg.nodes, xr) == nk_call() and pool_str_eq_lit(p, ast_get(cg.nodes, xr, 1), ast_get(cg.nodes, xr, 2), "ptr_read_u8") {
                    pr_x = cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, xl))
                    if pr_x > 0 { u8_n = xr }
                }
                if u8_n > 0 {
                    emit_int_expr_depth_ax(cg, vars, drops, breaks, u8_n, depth)
                    if gpreg_hi(pr_x) != 0 { mc_b1(c, 0x44) }
                    else if gpreg_hw(pr_x) >= 4 { mc_b1(c, 0x40) }
                    mc_b2(c, 0x30, 0xC0 | (gpreg_hw(pr_x) << 3))
                    return
                }
            }
            if can_imm_binop_ax(op, imm) {
                emit_int_expr_depth_ax(cg, vars, drops, breaks, lhs, depth)
                emit_rax_op_imm(cg, op, imm)
                return
            }
        }
        r_var_slot := local_scalar_slot_ax(cg, vars, rhs)
        if r_var_slot > 0 {
            emit_int_expr_depth_ax(cg, vars, drops, breaks, lhs, depth)
            emit_rax_op_slot(cg, op, r_var_slot)
            return
        }
        is_comm := op == op_add() or op == op_wrap_add() or op == op_mul() or op == op_wrap_mul() or op == op_bit_and() or op == op_bit_or() or op == op_bit_xor()
        if is_comm {
            l_var_slot := local_scalar_slot_ax(cg, vars, lhs)
            if l_var_slot > 0 {
                emit_int_expr_depth_ax(cg, vars, drops, breaks, rhs, depth)
                emit_rax_op_slot(cg, op, l_var_slot)
                return
            }
        }
        if rhs > 0 and ast_kind(cg.nodes, rhs) == nk_call() and ast_get(cg.nodes, rhs, 4) == 2 and pool_str_eq_lit(p, ast_get(cg.nodes, rhs, 1), ast_get(cg.nodes, rhs, 2), "ptr_read_i64") {
            raoff := ast_get(cg.nodes, rhs, 3)
            rp_p := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, raoff), 4)))
            rp_i := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, raoff + 1), 4)))
            if rp_p > 0 and rp_i > 0 and (op == op_bit_xor() or op == op_add() or op == op_wrap_add() or op == op_sub() or op == op_wrap_sub() or op == op_bit_and() or op == op_bit_or()) {
                emit_int_expr_depth_ax(cg, vars, drops, breaks, lhs, depth)
                try_emit_rax_op_ptr_read_i64(cg, vars, op, rhs)
                return
            }
        }
        mut max_d := 3
        if (ibuf_get(cg.state, 98) & 0x300) != 0 { max_d = 1 }
        if depth < max_d and not expr_has_real_call_ax(cg, rhs) {
            emit_int_expr_depth_ax(cg, vars, drops, breaks, lhs, depth)
            mc_b3(c, 0x49, 0x89, 0xC1 + depth) // MOV R(9+depth), RAX
            emit_int_expr_depth_ax(cg, vars, drops, breaks, rhs, depth + 1)
            emit_rax_op_r9p(cg, op, depth)
            return
        }
        // Fallback spill across calls / deep nesting
        emit_int_expr_depth_ax(cg, vars, drops, breaks, lhs, depth)
        lt := cg_alloc_slots(cg, 1)
        mc_store_rax(c, lt, 0)
        emit_int_expr_depth_ax(cg, vars, drops, breaks, rhs, depth)
        if is_comm {
            emit_rax_op_slot(cg, op, lt)
        } else {
            mc_b3(c, 0x48, 0x89, 0xC1)
            mc_load_rax(c, lt, 0)
            emit_rax_op_rcx(cg, op)
        }
        return
    }
    // `nk_call()` cases pre-validated by `pure_i64_ty_ax`
    csoff := ast_get(cg.nodes, enid, 1)
    cslen := ast_get(cg.nodes, enid, 2)
    aoff := ast_get(cg.nodes, enid, 3)
    acnt := ast_get(cg.nodes, enid, 4)
    if pool_str_eq_lit(p, csoff, cslen, "ushr64") {
        e0 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
        e1 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4)
        sh := eval_const_int_val(p, cg.nodes, cg.sym, e1)
        emit_int_expr_depth_ax(cg, vars, drops, breaks, e0, depth)
        if sh > 0 {
            mc_b4(c, 0x48, 0xC1, 0xE8, sh)
        }
        return
    }
    if pool_str_eq_lit(p, csoff, cslen, "popcnt64") {
        emit_int_expr_depth_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4), depth)
        mc_b4(c, 0xF3, 0x48, 0x0F, 0xB8); mc_b1(c, 0xC0)
        return
    }
    if (pool_str_eq_lit(p, csoff, cslen, "ibuf_len") or pool_str_eq_lit(p, csoff, cslen, "buf_len")) and acnt == 1 {
        bsl := local_buf_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        mc_load_rax(c, bsl, 0)
        mc_b3(c, 0x48, 0x8B, 0x00)
        return
    }
    if pool_str_eq_lit(p, csoff, cslen, "str_len") and acnt == 1 {
        ssl := local_str_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        mc_load_rax(c, ssl, 1)
        return
    }
    if pool_str_eq_lit(p, csoff, cslen, "len") and acnt == 1 {
        e0 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
        ssl := local_str_slot_ax(cg, vars, e0)
        if ssl > 0 {
            mc_load_rax(c, ssl, 1)
        } else {
            bsl := local_buf_slot_ax(cg, vars, e0)
            mc_load_rax(c, bsl, 0)
            mc_b3(c, 0x48, 0x8B, 0x00)
        }
        return
    }
    if (pool_str_eq_lit(p, csoff, cslen, "ibuf_get") or pool_str_eq_lit(p, csoff, cslen, "buf_get")) and acnt == 2 {
        is_ib := pool_str_eq_lit(p, csoff, cslen, "ibuf_get")
        bsl := local_buf_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        e1 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4)
        if is_folded_const_int_ax(cg, vars, e1) {
            idx := eval_folded_const_int_ax(cg, vars, e1)
            mc_load_rcx(c, bsl, 0)
            mc_b3(c, 0x48, 0x85, 0xC9); cg_jmp_fn(cg, 0x84, h_sec_trap())
            if is_ib and idx >= 0 and idx <= 13 {
                mc_b4(c, 0x48, 0x83, 0x39, idx); cg_jmp_fn(cg, 0x86, h_sec_trap())
                mc_b4(c, 0x48, 0x8B, 0x41, 16 + idx * 8)
                return
            }
            if not is_ib and idx >= 0 and idx <= 111 {
                mc_b4(c, 0x48, 0x83, 0x39, idx); cg_jmp_fn(cg, 0x86, h_sec_trap())
                mc_b4(c, 0x0F, 0xB6, 0x41, 16 + idx)
                return
            }
            mc_mov_reg_imm(c, 1, idx)
        } else {
            pr_i := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, e1))
            if pr_i > 0 {
                mc_mov_rdx_gpreg(c, pr_i)
            } else {
                emit_int_expr_depth_ax(cg, vars, drops, breaks, e1, depth)
                mc_b3(c, 0x48, 0x89, 0xC2) // MOV RDX, RAX
            }
            mc_load_rcx(c, bsl, 0)
            mc_b3(c, 0x48, 0x85, 0xC9); cg_jmp_fn(cg, 0x84, h_sec_trap())
        }
        mc_b3(c, 0x48, 0x3B, 0x11); cg_jmp_fn(cg, 0x83, h_sec_trap())
        if is_ib { mc_b4(c, 0x48, 0x8B, 0x44, 0xD1); mc_b1(c, 0x10) }
        else     { mc_b4(c, 0x0F, 0xB6, 0x44, 0x11); mc_b1(c, 0x10) }
        return
    }
    if pool_str_eq_lit(p, csoff, cslen, "ptr_read_u8") or pool_str_eq_lit(p, csoff, cslen, "ptr_read_i64") {
        is_qword := pool_str_eq_lit(p, csoff, cslen, "ptr_read_i64")
        e0 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
        e1 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4)
        if is_nonshadowed_const_int(cg, vars, e1) {
            idx := eval_const_int_val(p, cg.nodes, cg.sym, e1)
            p_var := local_scalar_slot_ax(cg, vars, e0)
            pr_p := cg_slot_reg(cg, p_var)
            if pr_p > 0 and is_qword and idx == 0 {
                b_hw := gpreg_hw(pr_p); b_hi := gpreg_hi(pr_p)
                if b_hw == 4 { mc_b4(c, 0x48 | b_hi, 0x8B, 0x04, 0x24) }
                else if b_hw == 5 { mc_b4(c, 0x48 | b_hi, 0x8B, 0x45, 0x00) }
                else { mc_b3(c, 0x48 | b_hi, 0x8B, b_hw) }
                return
            }
            if pr_p > 0 {
                mc_mov_rcx_gpreg(c, pr_p)
            } else {
                emit_int_expr_depth_ax(cg, vars, drops, breaks, e0, depth)
                mc_b3(c, 0x48, 0x89, 0xC1)
            }
            if is_qword {
                if idx == 0 { mc_b3(c, 0x48, 0x8B, 0x01) }
                else if idx >= -15 and idx <= 15 { mc_b4(c, 0x48, 0x8B, 0x41, (idx * 8) & 255) }
                else { mc_mov_reg_imm(c, 1, idx); mc_b4(c, 0x48, 0x8B, 0x04, 0xD1) }
            } else {
                if idx == 0 { mc_b3(c, 0x0F, 0xB6, 0x01) }
                else if idx >= -128 and idx <= 127 { mc_b4(c, 0x0F, 0xB6, 0x41, idx & 255) }
                else { mc_mov_reg_imm(c, 1, idx); mc_b4(c, 0x0F, 0xB6, 0x04, 0x11) }
            }
            return
        }
        idx_slot := local_scalar_slot_ax(cg, vars, e1)
        if idx_slot > 0 {
            ptr_slot := local_scalar_slot_ax(cg, vars, e0)
            pr_p := cg_slot_reg(cg, ptr_slot)
            pr_i := cg_slot_reg(cg, idx_slot)
            if pr_p > 0 and pr_i > 0 {
                // Direct 1-instruction SIB `[base_reg + idx_reg (+ disp8)]` / `[base_reg + idx_reg*8 (+ disp8)]`!
                b_hw := gpreg_hw(pr_p); b_hi := gpreg_hi(pr_p)
                x_hw := gpreg_hw(pr_i); x_hi := gpreg_hi(pr_i)
                mut scale := 0
                if is_qword { scale = 3 }
                mut disp := 0
                uoff := ibuf_get(cg.state, 24)
                if uoff > 0 and idx_slot == ibuf_get(cg.state, cg_fpromo_base(cg) + 122) {
                    if is_qword { disp = uoff * 8 } else { disp = uoff }
                }
                mut rex := 0x40 | (x_hi << 1) | b_hi
                if is_qword { rex = rex | 0x08 }
                if rex != 0x40 { mc_b1(c, rex) }
                if is_qword { mc_b1(c, 0x8B) } else { mc_b2(c, 0x0F, 0xB6) }
                mut modrm := 0x04
                if b_hw == 5 or disp != 0 { modrm = 0x44 } // R13 base or deferred unroll offset requires disp8
                mc_b2(c, modrm, (scale << 6) | (x_hw << 3) | b_hw)
                if b_hw == 5 or disp != 0 { mc_b1(c, disp & 255) }
                return
            }
            if pr_p == 0 and ptr_slot > 0 and pr_i > 0 and is_qword and gpreg_hw(pr_i) != 4 and (ibuf_get(cg.state, 24) == 0 or idx_slot != ibuf_get(cg.state, cg_fpromo_base(cg) + 122)) {
                mc_load_rcx(c, ptr_slot, 0)
                mc_b4(c, 0x48 | (gpreg_hi(pr_i) << 1), 0x8B, 0x04, 0xC1 | (gpreg_hw(pr_i) << 3))
                return
            }
            if pr_p > 0 {
                mc_mov_rcx_gpreg(c, pr_p)
            } else if ptr_slot > 0 {
                mc_load_rcx(c, ptr_slot, 0)
            } else {
                emit_int_expr_depth_ax(cg, vars, drops, breaks, e0, depth)
                mc_b3(c, 0x48, 0x89, 0xC1)
            }
            if pr_i > 0 { mc_mov_rdx_gpreg(c, pr_i) }
            else        { mc_load_rdx(c, idx_slot, 0) }
        } else {
            ptr_slot := local_scalar_slot_ax(cg, vars, e0)
            if ptr_slot > 0 {
                emit_int_expr_depth_ax(cg, vars, drops, breaks, e1, depth)
                pr_p := cg_slot_reg(cg, ptr_slot)
                if pr_p > 0 and is_qword {
                    b_hw := gpreg_hw(pr_p); b_hi := gpreg_hi(pr_p)
                    mut modrm := 0x04
                    if b_hw == 5 { modrm = 0x44 }
                    mc_b4(c, 0x48 | b_hi, 0x8B, modrm, 0xC0 | b_hw)
                    if b_hw == 5 { mc_b1(c, 0) }
                    return
                }
                if pr_p == 0 {
                    mc_load_rcx(c, ptr_slot, 0)
                    if is_qword { mc_b4(c, 0x48, 0x8B, 0x04, 0xC1) }
                    else        { mc_b4(c, 0x0F, 0xB6, 0x04, 0x01) }
                    return
                }
                mc_b3(c, 0x48, 0x89, 0xC2)
                mc_mov_rcx_gpreg(c, pr_p)
            } else {
                emit_int_expr_depth_ax(cg, vars, drops, breaks, e0, depth)
                pt := cg_alloc_slots(cg, 1)
                mc_store_rax(c, pt, 0)
                emit_int_expr_depth_ax(cg, vars, drops, breaks, e1, depth)
                mc_b3(c, 0x48, 0x89, 0xC2)
                mc_load_rcx(c, pt, 0)
            }
        }
        if is_qword { mc_b4(c, 0x48, 0x8B, 0x04, 0xD1) }
        else        { mc_b4(c, 0x0F, 0xB6, 0x04, 0x11) }
        return
    }
    fidx := find_fn_idx(p, cg.sym, csoff, cslen)
    if acnt == 0 and is_const_fn_idx(cg.sym, fidx) {
        mc_mov_rax_imm(c, const_fn_val(cg.sym, fidx))
        return
    }
    aexpr := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
    emit_int_expr_depth_ax(cg, vars, drops, breaks, aexpr, 0)
    mc_b3(c, 0x48, 0x89, 0xC1)
    cg_call_fn(cg, fidx)
}

fn emit_int_expr_to_rax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, enid: i64) {
    emit_int_expr_depth_ax(cg, vars, drops, breaks, enid, 0)
}

// Emits `[pfx, 0x0F, op2] XMM0, [RIP + roff]` (or VEX equivalent when `cg.state[25] != 0`) via `.rdata` interning.
fn mc_sse_xmm0_rdata(cg: CodegenCtx, pfx: i64, op2: i64, bits: i64, align16: bool) {
    roff := cg_intern_u64_rdata(cg, bits, align16)
    if ibuf_get(cg.state, 25) == 1 and (pfx == 0xF2 or pfx == 0x66) {
        mut pp := 3
        if pfx == 0x66 { pp = 1 }
        mc_vex3(cg.code, 0, 0, 0, 1, 0, 0, 0, pp, op2)
        mc_b1(cg.code, 0x05)
    } else {
        mc_b4(cg.code, pfx, 0x0F, op2, 0x05)
    }
    dp := buf_len(cg.code)
    buf_push_u32(cg.code, 0)
    nr := buf_len(cg.code)
    cg_add_fixup(cg.fixups, dp, nr, fx_rdata() | (roff << 8))
}

fn local_f64_slot_ax(cg: CodegenCtx, vars: IntBuf, nid: i64) -> i64 {
    if nid <= 0 { return 0 }
    k := ast_kind(cg.nodes, nid)
    if k == nk_ident() or k == nk_move_ident() {
        vb := cg_var_find(cg.pool, vars, ast_get(cg.nodes, nid, 1), ast_get(cg.nodes, nid, 2))
        if vb >= 0 and ibuf_get(vars, vb + 3) == ty_float() {
            return ibuf_get(vars, vb + 2)
        }
    }
    return 0
}

fn const_f64_rdata_ok(cg: CodegenCtx, vars: IntBuf, nid: i64) -> bool {
    if nid <= 0 { return false }
    k := ast_kind(cg.nodes, nid)
    if k == nk_float() { return true }
    if k == nk_ident() {
        soff := ast_get(cg.nodes, nid, 1)
        slen := ast_get(cg.nodes, nid, 2)
        if cg_var_find(cg.pool, vars, soff, slen) >= 0 { return false }
        goff := ct_find_global_const(cg.pool, cg.sym, soff, slen)
        if goff >= 0 and ibuf_get(cg.sym, goff + 2) == ty_float() { return true }
    }
    return false
}

fn const_f64_bits_ax(cg: CodegenCtx, nid: i64) -> i64 {
    if ast_kind(cg.nodes, nid) == nk_float() {
        return ast_get(cg.nodes, nid, 1)
    }
    goff := ct_find_global_const(cg.pool, cg.sym, ast_get(cg.nodes, nid, 1), ast_get(cg.nodes, nid, 2))
    return ibuf_get(cg.sym, goff + 3)
}

fn pure_f64_ty_ax(cg: CodegenCtx, vars: IntBuf, nid: i64) -> bool {
    if nid <= 0 { return false }
    if const_f64_rdata_ok(cg, vars, nid) or local_f64_slot_ax(cg, vars, nid) > 0 { return true }
    k := ast_kind(cg.nodes, nid)
    if k == nk_cast() {
        tn := ast_get(cg.nodes, nid, 2)
        if tn > 0 and ast_kind(cg.nodes, tn) == nk_ty_named() and pool_str_eq_lit(cg.pool, ast_get(cg.nodes, tn, 1), ast_get(cg.nodes, tn, 2), "f64") {
            return local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, nid, 1)) > 0
        }
        return false
    }
    if k == nk_unary() {
        return ast_get(cg.nodes, nid, 1) == uop_neg() and pure_f64_ty_ax(cg, vars, ast_get(cg.nodes, nid, 2))
    }
    if k == nk_binary() {
        op := ast_get(cg.nodes, nid, 1)
        if op == op_add() or op == op_wrap_add() or op == op_sub() or op == op_wrap_sub() or op == op_mul() or op == op_wrap_mul() or op == op_div() {
            return pure_f64_ty_ax(cg, vars, ast_get(cg.nodes, nid, 2)) and pure_f64_ty_ax(cg, vars, ast_get(cg.nodes, nid, 3))
        }
    }
    if k == nk_call() {
        cs := ast_get(cg.nodes, nid, 1); cl := ast_get(cg.nodes, nid, 2)
        aoff := ast_get(cg.nodes, nid, 3); acnt := ast_get(cg.nodes, nid, 4)
        if acnt == 1 and pool_str_eq_lit(cg.pool, cs, cl, "sqrt_f64") {
            return pure_f64_ty_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        }
        if acnt == 2 and (pool_str_eq_lit(cg.pool, cs, cl, "ptr_read_f64") or pool_str_eq_lit(cg.pool, cs, cl, "ptr_read_f32")) {
            e0 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
            e1 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4)
            if local_scalar_slot_ax(cg, vars, e0) > 0 {
                if local_scalar_slot_ax(cg, vars, e1) > 0 or is_folded_const_int_ax(cg, vars, e1) { return true }
                if ast_kind(cg.nodes, e1) == nk_binary() {
                    bop := ast_get(cg.nodes, e1, 1)
                    if (bop == op_add() or bop == op_wrap_add()) and local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, e1, 2)) > 0 and (local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, e1, 3)) > 0 or is_folded_const_int_ax(cg, vars, ast_get(cg.nodes, e1, 3))) {
                        return true
                    }
                }
            }
        }
    }
    return false
}

fn f64_op2_code(op: i64) -> i64 {
    if op == op_add() or op == op_wrap_add() { return 0x58 }
    if op == op_sub() or op == op_wrap_sub() { return 0x5C }
    if op == op_mul() or op == op_wrap_mul() { return 0x59 }
    return 0x5E
}

// Evaluates pure `f64` tree directly into `XMM0` using `XMM2..XMM4` expression stack (0 GPR<->XMM crossings!).
fn emit_f64_expr_depth_ax(cg: CodegenCtx, vars: IntBuf, enid: i64, depth: i64) {
    c := cg.code
    vex := ibuf_get(cg.state, 25) == 1
    if const_f64_rdata_ok(cg, vars, enid) {
        bits := const_f64_bits_ax(cg, enid)
        if bits == 0 {
            if vex { mc_vex2(c, 0, 0, 1, 0x57, 0xC0) } // VXORPD XMM0, XMM0, XMM0
            else   { mc_b4(c, 0x66, 0x0F, 0x57, 0xC0) } // XORPD XMM0, XMM0 (+0.0, 0-cycle!)
        } else {
            mc_sse_xmm0_rdata(cg, 0xF2, 0x10, bits, false)
        }
        return
    }
    slot := local_f64_slot_ax(cg, vars, enid)
    if slot > 0 {
        fr_s := cg_slot_freg(cg, slot)
        if fr_s > 0 {
            if vex { mc_vex_movaps_rr(c, 0, 5 + fr_s) }
            else   { mc_mov_xmm0_freg(c, fr_s) }
        } else {
            mc_sse_xmm0_slot(c, 0xF2, 0x10, slot, 0)
        }
        return
    }
    k := ast_kind(cg.nodes, enid)
    if k == nk_cast() {
        isl := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, enid, 1))
        ir := cg_slot_reg(cg, isl)
        if ir > 0 {
            if vex {
                mc_vex2(c, 0, 0, 1, 0x57, 0xC0) // VXORPD XMM0, XMM0, XMM0 (break false dependency!)
                mc_vex3(c, 0, 0, gpreg_hi(ir), 1, 1, 0, 0, 3, 0x2A); mc_b1(c, 0xC0 | gpreg_hw(ir)) // VCVTSI2SD XMM0, XMM0, gpreg
            } else {
                mc_b4(c, 0xF2, 0x48 | gpreg_hi(ir), 0x0F, 0x2A); mc_b1(c, 0xC0 | gpreg_hw(ir)) // CVTSI2SD XMM0, gpreg
            }
        } else {
            mc_load_rax(c, isl, 0)
            if vex {
                mc_vex2(c, 0, 0, 1, 0x57, 0xC0)
                mc_vex3(c, 0, 0, 0, 1, 1, 0, 0, 3, 0x2A); mc_b1(c, 0xC0) // VCVTSI2SD XMM0, XMM0, RAX
            } else {
                mc_b4(c, 0xF2, 0x48, 0x0F, 0x2A); mc_b1(c, 0xC0) // CVTSI2SD XMM0, RAX
            }
        }
        return
    }
    if k == nk_unary() {
        emit_f64_expr_depth_ax(cg, vars, ast_get(cg.nodes, enid, 2), depth)
        mc_sse_xmm0_rdata(cg, 0x66, 0x57, 1 << 63, true) // [V]XORPD XMM0, [signbit128]
        return
    }
    if k == nk_call() {
        cs := ast_get(cg.nodes, enid, 1); cl := ast_get(cg.nodes, enid, 2)
        aoff := ast_get(cg.nodes, enid, 3)
        if pool_str_eq_lit(cg.pool, cs, cl, "sqrt_f64") {
            emit_f64_expr_depth_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4), depth)
            if vex { mc_vex2(c, 0, 0, 3, 0x51, 0xC0) } // VSQRTSD XMM0, XMM0, XMM0
            else   { mc_b4(c, 0xF2, 0x0F, 0x51, 0xC0) } // SQRTSD XMM0, XMM0
            return
        }
        // `ptr_read_f64` / `ptr_read_f32` -> direct `[V]MOVSD/MOVSS XMM0, [RCX + RDX*8/4]` (0 GPR<->XMM crossing!)
        is_f32 := pool_str_eq_lit(cg.pool, cs, cl, "ptr_read_f32")
        e0 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
        e1 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4)
        psl := local_scalar_slot_ax(cg, vars, e0)
        pr_p := cg_slot_reg(cg, psl)
        if pr_p > 0 { mc_mov_rcx_gpreg(c, pr_p) } else { mc_load_rcx(c, psl, 0) }
        if is_folded_const_int_ax(cg, vars, e1) {
            mc_mov_reg_imm(c, 1, eval_folded_const_int_ax(cg, vars, e1))
        } else if ast_kind(cg.nodes, e1) == nk_binary() {
            s_a := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, e1, 2))
            ra := cg_slot_reg(cg, s_a)
            if ra > 0 { mc_mov_rdx_gpreg(c, ra) } else { mc_load_rdx(c, s_a, 0) }
            e_rhs := ast_get(cg.nodes, e1, 3)
            if is_folded_const_int_ax(cg, vars, e_rhs) {
                imm_b := eval_folded_const_int_ax(cg, vars, e_rhs)
                if imm_b >= -128 and imm_b <= 127 {
                    mc_b4(c, 0x48, 0x83, 0xC2, imm_b & 255)
                } else {
                    mc_b3(c, 0x48, 0x81, 0xC2); mc_u32(c, imm_b)
                }
            } else {
                s_b := local_scalar_slot_ax(cg, vars, e_rhs)
                rb := cg_slot_reg(cg, s_b)
                if rb > 0 {
                    mc_b3(c, 0x48 | (gpreg_hi(rb) << 2), 0x01, 0xC2 | (gpreg_hw(rb) << 3)) // ADD RDX, rb
                } else {
                    mc_load_rax(c, s_b, 0)
                    mc_b3(c, 0x48, 0x01, 0xC2) // ADD RDX, RAX
                }
            }
        } else {
            isl := local_scalar_slot_ax(cg, vars, e1)
            ri := cg_slot_reg(cg, isl)
            if ri > 0 { mc_mov_rdx_gpreg(c, ri) } else { mc_load_rdx(c, isl, 0) }
        }
        if is_f32 {
            mc_b4(c, 0xF3, 0x0F, 0x10, 0x04); mc_b1(c, 0x91) // MOVSS XMM0, [RCX + RDX*4]
            mc_b4(c, 0xF3, 0x0F, 0x5A, 0xC0)                 // CVTSS2SD XMM0, XMM0
        } else if vex {
            mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x04, 0xD1) // VMOVSD XMM0, [RCX + RDX*8]
        } else {
            mc_b4(c, 0xF2, 0x0F, 0x10, 0x04); mc_b1(c, 0xD1)              // MOVSD  XMM0, [RCX + RDX*8]
        }
        return
    }
    op := ast_get(cg.nodes, enid, 1)
    lhs := ast_get(cg.nodes, enid, 2)
    rhs := ast_get(cg.nodes, enid, 3)
    op2 := f64_op2_code(op)
    if const_f64_rdata_ok(cg, vars, rhs) {
        rbits := const_f64_bits_ax(cg, rhs)
        emit_f64_expr_depth_ax(cg, vars, lhs, depth)
        if (op == op_mul() or op == op_wrap_mul()) and rbits == 0x4000000000000000 {
            if vex { mc_vex_sd_rrr(c, 0x58, 0, 0, 0) }
            else   { mc_b4(c, 0xF2, 0x0F, 0x58, 0xC0) } // [V]ADDSD XMM0, XMM0 (x * 2.0)
        } else if op == op_div() and (rbits & 0x800FFFFFFFFFFFFF) == 0 {
            exp := (ushr64(rbits, 52)) & 0x7FF
            if exp >= 2 and exp <= 2045 {
                // Bit-exact IEEE-754 power-of-2 reciprocal multiply (`MULSD` 4c vs `DIVSD` 14c!)
                mc_sse_xmm0_rdata(cg, 0xF2, 0x59, (2046 - exp) << 52, false)
            } else {
                mc_sse_xmm0_rdata(cg, 0xF2, op2, rbits, false)
            }
        } else {
            mc_sse_xmm0_rdata(cg, 0xF2, op2, rbits, false)
        }
        return
    }
    if (op == op_mul() or op == op_wrap_mul()) and const_f64_rdata_ok(cg, vars, lhs) and const_f64_bits_ax(cg, lhs) == 0x4000000000000000 {
        emit_f64_expr_depth_ax(cg, vars, rhs, depth)
        if vex { mc_vex_sd_rrr(c, 0x58, 0, 0, 0) }
        else   { mc_b4(c, 0xF2, 0x0F, 0x58, 0xC0) } // [V]ADDSD XMM0, XMM0 (2.0 * x)
        return
    }
    rslot := local_f64_slot_ax(cg, vars, rhs)
    if rslot > 0 {
        emit_f64_expr_depth_ax(cg, vars, lhs, depth)
        fr_r := cg_slot_freg(cg, rslot)
        if fr_r > 0 {
            if vex { mc_vex_sd_rrr(c, op2, 0, 0, 5 + fr_r) }
            else   { mc_sse_xmm0_freg_op(c, 0xF2, op2, fr_r) }
        } else {
            mc_sse_xmm0_slot(c, 0xF2, op2, rslot, 0)
        }
        return
    }
    is_comm := op == op_add() or op == op_wrap_add() or op == op_mul() or op == op_wrap_mul()
    if is_comm {
        if const_f64_rdata_ok(cg, vars, lhs) {
            lbits := const_f64_bits_ax(cg, lhs)
            emit_f64_expr_depth_ax(cg, vars, rhs, depth)
            if (op == op_mul() or op == op_wrap_mul()) and lbits == 0x4000000000000000 {
                if vex { mc_vex_sd_rrr(c, 0x58, 0, 0, 0) }
                else   { mc_b4(c, 0xF2, 0x0F, 0x58, 0xC0) } // [V]ADDSD XMM0, XMM0 (2.0 * x)
            } else {
                mc_sse_xmm0_rdata(cg, 0xF2, op2, lbits, false)
            }
            return
        }
        lslot := local_f64_slot_ax(cg, vars, lhs)
        if lslot > 0 {
            emit_f64_expr_depth_ax(cg, vars, rhs, depth)
            fr_l := cg_slot_freg(cg, lslot)
            if fr_l > 0 {
                if vex { mc_vex_sd_rrr(c, op2, 0, 0, 5 + fr_l) }
                else   { mc_sse_xmm0_freg_op(c, 0xF2, op2, fr_l) }
            } else {
                mc_sse_xmm0_slot(c, 0xF2, op2, lslot, 0)
            }
            return
        }
    }
    if depth < 3 {
        emit_f64_expr_depth_ax(cg, vars, lhs, depth)
        if vex { mc_vex_movaps_rr(c, 2 + depth, 0) }
        else   { mc_b3(c, 0x0F, 0x28, 0xD0 + depth * 8) } // [V]MOVAPS XMM(2+depth), XMM0
        emit_f64_expr_depth_ax(cg, vars, rhs, depth + 1)
        if is_comm {
            if vex { mc_vex_sd_rrr(c, op2, 0, 0, 2 + depth) }
            else   { mc_b4(c, 0xF2, 0x0F, op2, 0xC2 + depth) }
        } else {
            if vex {
                mc_vex_sd_rrr(c, op2, 0, 2 + depth, 0)
            } else {
                mc_b3(c, 0x0F, 0x28, 0xC8)              // MOVAPS XMM1, XMM0
                mc_b3(c, 0x0F, 0x28, 0xC2 + depth)      // MOVAPS XMM0, XMM(2+depth)
                mc_b4(c, 0xF2, 0x0F, op2, 0xC1)         // <OP>SD XMM0, XMM1
            }
        }
        return
    }
    emit_f64_expr_depth_ax(cg, vars, lhs, depth)
    lt := cg_alloc_slots(cg, 1)
    mc_sse_xmm0_slot(c, 0xF2, 0x11, lt, 0)
    emit_f64_expr_depth_ax(cg, vars, rhs, depth)
    if is_comm {
        mc_sse_xmm0_slot(c, 0xF2, op2, lt, 0)
    } else {
        mc_b4(c, 0xF2, 0x0F, 0x10, 0xC8) // MOVSD XMM1, XMM0
        mc_sse_xmm0_slot(c, 0xF2, 0x10, lt, 0)
        mc_b4(c, 0xF2, 0x0F, op2, 0xC1)
    }
}

fn emit_f64_expr_to_xmm0(cg: CodegenCtx, vars: IntBuf, enid: i64) {
    emit_f64_expr_depth_ax(cg, vars, enid, 0)
}

// 3-operand VEX scalar `f64` + FMA3 codegen helpers (used only under runtime CPUID `g_simd_tier >= 2`!)
fn mc_vex_sd_rrr(c: ByteBuf, op: i64, dst: i64, src1: i64, src2: i64) {
    mc_vex3(c, dst >> 3, 0, src2 >> 3, 1, 0, src1, 0, 3, op)
    mc_b1(c, 0xC0 | ((dst & 7) << 3) | (src2 & 7))
}

fn mc_vex_fmadd213sd_rrr(c: ByteBuf, dst: i64, src1: i64, src2: i64) {
    // VEX.LIG.66.0F38.W1 A9 /r -> dst = dst * src1 + src2
    mc_vex3(c, dst >> 3, 0, src2 >> 3, 2, 1, src1, 0, 1, 0xA9)
    mc_b1(c, 0xC0 | ((dst & 7) << 3) | (src2 & 7))
}

fn mc_vex_movaps_rr(c: ByteBuf, dst: i64, src: i64) {
    if dst == src { return }
    mc_vex3(c, dst >> 3, 0, src >> 3, 1, 0, 0, 0, 0, 0x28)
    mc_b1(c, 0xC0 | ((dst & 7) << 3) | (src & 7))
}

fn mc_vex_ucomisd_rdata(cg: CodegenCtx, src_hw: i64, bits: i64) {
    roff := cg_intern_u64_rdata(cg, bits, false)
    mc_vex3(cg.code, src_hw >> 3, 0, 0, 1, 0, 0, 0, 1, 0x2E)
    mc_b1(cg.code, 0x05 | ((src_hw & 7) << 3))
    dp := buf_len(cg.code)
    buf_push_u32(cg.code, 0)
    cg_add_fixup(cg.fixups, dp, buf_len(cg.code), fx_rdata() | (roff << 8))
}

fn mc_vex_movsd_rdata(cg: CodegenCtx, dst_hw: i64, bits: i64) {
    roff := cg_intern_u64_rdata(cg, bits, false)
    mc_vex3(cg.code, dst_hw >> 3, 0, 0, 1, 0, 0, 0, 3, 0x10)
    mc_b1(cg.code, 0x05 | ((dst_hw & 7) << 3))
    dp := buf_len(cg.code)
    buf_push_u32(cg.code, 0)
    cg_add_fixup(cg.fixups, dp, buf_len(cg.code), fx_rdata() | (roff << 8))
}

fn local_f64_hw_ax(cg: CodegenCtx, vars: IntBuf, nid: i64) -> i64 {
    sl := local_f64_slot_ax(cg, vars, nid)
    if sl <= 0 { return -1 }
    fr := cg_slot_freg(cg, sl)
    if fr <= 0 { return -1 }
    return 5 + fr
}

// Emits pure `f64` tree directly into `XMM(dst_hw)` via 3-operand VEX + FMA3 (0 `XMM0` move bounces!).
fn emit_f64_to_hw_vex(cg: CodegenCtx, vars: IntBuf, enid: i64, dst_hw: i64) {
    c := cg.code
    if const_f64_rdata_ok(cg, vars, enid) and const_f64_bits_ax(cg, enid) == 0 {
        mc_vex3(c, dst_hw >> 3, 0, dst_hw >> 3, 1, 0, dst_hw, 0, 1, 0x57)
        mc_b1(c, 0xC0 | ((dst_hw & 7) << 3) | (dst_hw & 7)) // VXORPD XMM(dst), XMM(dst), XMM(dst)
        return
    }
    ehw := local_f64_hw_ax(cg, vars, enid)
    if ehw >= 0 {
        mc_vex_movaps_rr(c, dst_hw, ehw)
        return
    }
    if ast_kind(cg.nodes, enid) == nk_binary() {
        op := ast_get(cg.nodes, enid, 1)
        lhs := ast_get(cg.nodes, enid, 2)
        rhs := ast_get(cg.nodes, enid, 3)
        op2 := f64_op2_code(op)
        // FMA3 fusion: `(a * b) + c` -> `VFMADD213SD` directly into `dst_hw`!
        if (op == op_add() or op == op_wrap_add()) and ast_kind(cg.nodes, lhs) == nk_binary() {
            lop := ast_get(cg.nodes, lhs, 1)
            c_hw := local_f64_hw_ax(cg, vars, rhs)
            if (lop == op_mul() or lop == op_wrap_mul()) and c_hw >= 0 and c_hw != dst_hw {
                ma := ast_get(cg.nodes, lhs, 2)
                mb := ast_get(cg.nodes, lhs, 3)
                ma_hw := local_f64_hw_ax(cg, vars, ma)
                mb_hw := local_f64_hw_ax(cg, vars, mb)
                if mb_hw == dst_hw {
                    emit_f64_to_hw_vex(cg, vars, ma, 0)
                    mc_vex_fmadd213sd_rrr(c, dst_hw, 0, c_hw)
                    return
                }
                if ma_hw == dst_hw {
                    emit_f64_to_hw_vex(cg, vars, mb, 0)
                    mc_vex_fmadd213sd_rrr(c, dst_hw, 0, c_hw)
                    return
                }
                if ma_hw >= 0 and mb_hw >= 0 and dst_hw != mb_hw {
                    mc_vex_movaps_rr(c, dst_hw, ma_hw)
                    mc_vex_fmadd213sd_rrr(c, dst_hw, mb_hw, c_hw)
                    return
                }
            }
        }
        // `2.0 * x` / `x * 2.0` -> 1-insn `VADDSD dst_hw, x_hw, x_hw`
        if op == op_mul() or op == op_wrap_mul() {
            if const_f64_rdata_ok(cg, vars, lhs) and const_f64_bits_ax(cg, lhs) == 0x4000000000000000 {
                rhw := local_f64_hw_ax(cg, vars, rhs)
                if rhw >= 0 { mc_vex_sd_rrr(c, 0x58, dst_hw, rhw, rhw); return }
            }
            if const_f64_rdata_ok(cg, vars, rhs) and const_f64_bits_ax(cg, rhs) == 0x4000000000000000 {
                lhw := local_f64_hw_ax(cg, vars, lhs)
                if lhw >= 0 { mc_vex_sd_rrr(c, 0x58, dst_hw, lhw, lhw); return }
            }
        }
        lhw := local_f64_hw_ax(cg, vars, lhs)
        rhw := local_f64_hw_ax(cg, vars, rhs)
        if lhw >= 0 and rhw >= 0 {
            mc_vex_sd_rrr(c, op2, dst_hw, lhw, rhw)
            return
        }
        if rhw >= 0 and rhw != 0 {
            emit_f64_to_hw_vex(cg, vars, lhs, 0)
            mc_vex_sd_rrr(c, op2, dst_hw, 0, rhw)
            return
        }
    }
    emit_f64_expr_depth_ax(cg, vars, enid, 0)
    if dst_hw != 0 { mc_vex_movaps_rr(c, dst_hw, 0) }
}

// Emits `[pfx, 0x0F, op2] XMM0, [RBP + disp]` (or `MOVSD [RBP + disp], XMM0` with `op2 = 0x11`)
fn mc_sse_xmm0_slot(code: ByteBuf, pfx: i64, op2: i64, slot: i64, sub_off: i64) {
    disp := mc_slot_disp(slot, sub_off)
    if disp >= -128 and disp <= 127 {
        mc_b4(code, pfx, 0x0F, op2, 0x45)
        mc_b1(code, disp & 255)
    } else {
        mc_b4(code, pfx, 0x0F, op2, 0x85)
        mc_u32(code, disp)
    }
}

fn emit_scalar_binop_ax(cg: CodegenCtx, op: i64, lslot: i64, loff: i64, rslot: i64, roff: i64, common_ty: i64) -> i64 {
    c := cg.code
    dst := cg_alloc_slots(cg, 1)

    if common_ty == ty_float() {
        // Pure XMM0 memory-operand path: zero GPR<->XMM domain crossings.
        mc_sse_xmm0_slot(c, 0xF2, 0x10, lslot, loff) // MOVSD XMM0, [RBP+l]
        if op == op_add() or op == op_wrap_add() {
            mc_sse_xmm0_slot(c, 0xF2, 0x58, rslot, roff) // ADDSD XMM0, [RBP+r]
        } else if op == op_sub() or op == op_wrap_sub() {
            mc_sse_xmm0_slot(c, 0xF2, 0x5C, rslot, roff) // SUBSD XMM0, [RBP+r]
        } else if op == op_mul() or op == op_wrap_mul() {
            mc_sse_xmm0_slot(c, 0xF2, 0x59, rslot, roff) // MULSD XMM0, [RBP+r]
        } else if op == op_div() {
            mc_sse_xmm0_slot(c, 0xF2, 0x5E, rslot, roff) // DIVSD XMM0, [RBP+r]
        } else {
            mc_sse_xmm0_slot(c, 0x66, 0x2E, rslot, roff) // UCOMISD XMM0, [RBP+r]
            mut setcc := 0x94
            if op == op_neq() { setcc = 0x95 }
            else if op == op_lt() { setcc = 0x92 }
            else if op == op_lte() { setcc = 0x96 }
            else if op == op_gt() { setcc = 0x97 }
            else if op == op_gte() { setcc = 0x93 }
            mc_b3(c, 0x0F, setcc, 0xC0)
            // IEEE-754 NaN handling: UCOMISD sets PF=1, ZF=1, CF=1 on NaN.
            // `==`, `<`, `<=` must return false when PF=1; `!=` must return true when PF=1.
            if op == op_eq() or op == op_lt() or op == op_lte() {
                mc_b3(c, 0x0F, 0x9B, 0xC2) // SETNP DL
                mc_b2(c, 0x20, 0xD0)       // AND AL, DL
            } else if op == op_neq() {
                mc_b3(c, 0x0F, 0x9A, 0xC2) // SETP DL
                mc_b2(c, 0x08, 0xD0)       // OR AL, DL
            }
            mc_b3(c, 0x0F, 0xB6, 0xC0)
            mc_store_rax(c, dst, 0)
            return dst
        }
        mc_sse_xmm0_slot(c, 0xF2, 0x11, dst, 0) // MOVSD [RBP+dst], XMM0
        if (ibuf_get(cg.state, 18) & fnflag_nan_guard()) != 0 {
            mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
            emit_nan_guard_rax(cg)
        }
        return dst
    }

    mc_load_rax(c, lslot, loff)
    shd := ibuf_get(cg.state, 0)
    if common_ty == ty_dec() and (op == op_mul() or op == op_div()) {
        mc_load_rcx(c, rslot, roff)
        if op == op_mul() {
            mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
            if shd == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
            mc_b3(c, 0x48, 0xC7, 0xC1)
            mc_u32(c, 10000)
            mc_b2(c, 0x48, 0x99)
            mc_b3(c, 0x48, 0xF7, 0xF9)
        } else {
            mc_b3(c, 0x48, 0x85, 0xC9)
            cg_jmp_fn(cg, 0x84, h_sec_trap())
            mc_b3(c, 0x48, 0x69, 0xC0)
            mc_u32(c, 10000)
            if shd == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
            mc_b4(c, 0x48, 0x83, 0xF9, 0xFF)
            jne_dok := mc_jcc8(c, 0x75)
            mc_b2(c, 0x48, 0xBA)
            mc_u64(c, 1 << 63)
            mc_b3(c, 0x48, 0x39, 0xD0)
            cg_jmp_fn(cg, 0x84, h_sec_trap())
            mc_patch_jcc8(c, jne_dok, buf_len(c))
            mc_b2(c, 0x48, 0x99)
            mc_b3(c, 0x48, 0xF7, 0xF9)
        }
        mc_store_rax(c, dst, 0)
        return dst
    }
    if op == op_add() {
        mc_rbp_slot(c, 0x480300, rslot, roff)
        if shd == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
    } else if op == op_wrap_add() {
        mc_rbp_slot(c, 0x480300, rslot, roff)
    } else if op == op_sub() {
        mc_rbp_slot(c, 0x482B00, rslot, roff)
        if shd == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
    } else if op == op_wrap_sub() {
        mc_rbp_slot(c, 0x482B00, rslot, roff)
    } else if op == op_mul() {
        mc_load_rcx(c, rslot, roff)
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
        if shd == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
    } else if op == op_wrap_mul() {
        mc_load_rcx(c, rslot, roff)
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
    } else if op == op_div() {
        mc_load_rcx(c, rslot, roff)
        mc_b3(c, 0x48, 0x85, 0xC9)
        cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b4(c, 0x48, 0x83, 0xF9, 0xFF)
        jne_ok := mc_jcc8(c, 0x75)
        mc_b2(c, 0x48, 0xBA)
        mc_u64(c, 1 << 63)
        mc_b3(c, 0x48, 0x39, 0xD0)
        cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_patch_jcc8(c, jne_ok, buf_len(c))
        mc_b2(c, 0x48, 0x99)
        mc_b3(c, 0x48, 0xF7, 0xF9)
    } else if op == op_mod() {
        mc_load_rcx(c, rslot, roff)
        mc_b3(c, 0x48, 0x85, 0xC9)
        cg_jmp_fn(cg, 0x84, h_sec_trap())
        mc_b2(c, 0x31, 0xD2)
        mc_b4(c, 0x48, 0x83, 0xF9, 0xFF)
        je_mod_neg1 := mc_jcc8(c, 0x74)
        mc_b2(c, 0x48, 0x99)
        mc_b3(c, 0x48, 0xF7, 0xF9)
        mc_patch_jcc8(c, je_mod_neg1, buf_len(c))
        mc_b3(c, 0x48, 0x89, 0xD0)
    } else if op == op_pow() {
        mc_b3(c, 0x48, 0x89, 0xC1)
        mc_load_rdx(c, rslot, roff)
        cg_call_fn(cg, h_pow_i64())
    } else if op == op_bit_and() {
        mc_rbp_slot(c, 0x482300, rslot, roff)
    } else if op == op_bit_or() {
        mc_rbp_slot(c, 0x480B00, rslot, roff)
    } else if op == op_bit_xor() {
        mc_rbp_slot(c, 0x483300, rslot, roff)
    } else if op == op_shl() {
        mc_load_rcx(c, rslot, roff)
        mc_b3(c, 0x48, 0xD3, 0xE0)
    } else if op == op_shr() {
        mc_load_rcx(c, rslot, roff)
        mc_b3(c, 0x48, 0xD3, 0xF8)
    } else if op == op_and() {
        mc_load_rcx(c, rslot, roff)
        mc_b3(c, 0x48, 0x85, 0xC0)
        mc_b3(c, 0x0F, 0x95, 0xC0)
        mc_b3(c, 0x48, 0x85, 0xC9)
        mc_b3(c, 0x0F, 0x95, 0xC1)
        mc_b2(c, 0x20, 0xC8)
        mc_b3(c, 0x0F, 0xB6, 0xC0)
    } else if op == op_or() {
        mc_rbp_slot(c, 0x480B00, rslot, roff)
        mc_b3(c, 0x0F, 0x95, 0xC0)
        mc_b3(c, 0x0F, 0xB6, 0xC0)
    } else {
        mc_cmp_rax_slot(c, rslot, roff)
        mut setcc := 0x94
        if op == op_neq() { setcc = 0x95 }
        else if op == op_lt() { setcc = 0x9C }
        else if op == op_lte() { setcc = 0x9E }
        else if op == op_gt() { setcc = 0x9F }
        else if op == op_gte() { setcc = 0x9D }
        mc_b3(c, 0x0F, setcc, 0xC0)
        mc_b3(c, 0x0F, 0xB6, 0xC0)
    }

    mc_store_rax(c, dst, 0)
    return dst
}

fn mc_jcc32_cond(c: ByteBuf, false_cc: i64, jump_if_true: bool) -> i64 {
    if jump_if_true { return mc_jcc32(c, false_cc ^ 1) }
    return mc_jcc32(c, false_cc)
}

// Emits `CMP`/`TEST` flags for pure `i64`/`bool` comparison `lhs op rhs`; returns `inv_jcc` (0 if not pure i64).
fn emit_cmp_i64_flags_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, op: i64, lhs: i64, rhs: i64) -> i64 {
    plty := pure_i64_ty_ax(cg, vars, lhs)
    if plty == 0 or pure_i64_ty_ax(cg, vars, rhs) != plty { return 0 }
    c := cg.code
    mut inv_jcc := 0x85
    if op == op_neq() { inv_jcc = 0x84 }
    else if op == op_lt() { inv_jcc = 0x8D }
    else if op == op_lte() { inv_jcc = 0x8F }
    else if op == op_gt() { inv_jcc = 0x8E }
    else if op == op_gte() { inv_jcc = 0x8C }
    if is_folded_const_int_ax(cg, vars, rhs) {
        imm := eval_folded_const_int_ax(cg, vars, rhs)
        if imm >= -2147483648 and imm <= 2147483647 {
            l_slot := local_scalar_slot_ax(cg, vars, lhs)
            l_reg := cg_slot_reg(cg, l_slot)
            if l_reg > 0 {
                mc_cmp_gpreg_imm(c, l_reg, imm)
            } else {
                emit_int_expr_to_rax(cg, vars, drops, breaks, lhs)
                if imm == 0 {
                    mc_b3(c, 0x48, 0x85, 0xC0)
                } else if imm >= -128 and imm <= 127 {
                    mc_b4(c, 0x48, 0x83, 0xF8, imm & 255)
                } else {
                    mc_b2(c, 0x48, 0x3D); mc_u32(c, imm)
                }
            }
            return inv_jcc
        }
    }
    r_slot := local_scalar_slot_ax(cg, vars, rhs)
    if r_slot > 0 {
        l_slot := local_scalar_slot_ax(cg, vars, lhs)
        l_reg := cg_slot_reg(cg, l_slot)
        r_reg := cg_slot_reg(cg, r_slot)
        if l_reg > 0 and r_reg > 0 {
            mc_cmp_gpreg_gpreg(c, l_reg, r_reg)
        } else if r_reg > 0 {
            emit_int_expr_to_rax(cg, vars, drops, breaks, lhs)
            mc_cmp_rax_gpreg(c, r_reg)
        } else if l_reg > 0 {
            mc_cmp_gpreg_slot(c, l_reg, r_slot)
        } else {
            emit_int_expr_to_rax(cg, vars, drops, breaks, lhs)
            mc_cmp_rax_slot(c, r_slot, 0)
        }
        return inv_jcc
    }
    // Direct memory-operand `CMP l_reg/RAX, [p + i*8]` when `rhs` is `ptr_read_i64(p, i)`!
    if rhs > 0 and ast_kind(cg.nodes, rhs) == nk_call() and ast_get(cg.nodes, rhs, 4) == 2 and pool_str_eq_lit(cg.pool, ast_get(cg.nodes, rhs, 1), ast_get(cg.nodes, rhs, 2), "ptr_read_i64") {
        ra := ast_get(cg.nodes, rhs, 3)
        psl_r := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, ra), 4))
        isl_r := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, ra + 1), 4))
        pr_p := cg_slot_reg(cg, psl_r)
        pr_i := cg_slot_reg(cg, isl_r)
        iv_ok_c := ibuf_get(cg.state, 24) == 0 or isl_r != ibuf_get(cg.state, cg_fpromo_base(cg) + 122)
        if iv_ok_c and pr_p > 0 and pr_i > 0 {
            b_hw := gpreg_hw(pr_p); b_hi := gpreg_hi(pr_p)
            x_hw := gpreg_hw(pr_i); x_hi := gpreg_hi(pr_i)
            sib := 0xC0 | (x_hw << 3) | b_hw
            l_reg := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, lhs))
            if l_reg > 0 {
                mut modrm := 0x04 | (gpreg_hw(l_reg) << 3)
                if b_hw == 5 { modrm = 0x44 | (gpreg_hw(l_reg) << 3) }
                mc_b4(c, 0x48 | (gpreg_hi(l_reg) << 2) | (x_hi << 1) | b_hi, 0x3B, modrm, sib)
                if b_hw == 5 { mc_b1(c, 0) }
            } else {
                emit_int_expr_to_rax(cg, vars, drops, breaks, lhs)
                mut modrm := 0x04
                if b_hw == 5 { modrm = 0x44 }
                mc_b4(c, 0x48 | (x_hi << 1) | b_hi, 0x3B, modrm, sib)
                if b_hw == 5 { mc_b1(c, 0) }
            }
            return inv_jcc
        }
        if iv_ok_c and psl_r > 0 and isl_r > 0 {
            l_reg := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, lhs))
            if l_reg > 0 {
                if pr_p > 0 { mc_mov_rcx_gpreg(c, pr_p) } else { mc_load_rcx(c, psl_r, 0) }
                if pr_i > 0 and gpreg_hw(pr_i) != 4 {
                    mc_b4(c, 0x48 | (gpreg_hi(l_reg) << 2) | (gpreg_hi(pr_i) << 1), 0x3B, 0x04 | (gpreg_hw(l_reg) << 3), 0xC1 | (gpreg_hw(pr_i) << 3))
                } else {
                    if pr_i > 0 { mc_mov_rdx_gpreg(c, pr_i) } else { mc_load_rdx(c, isl_r, 0) }
                    mc_b4(c, 0x48 | (gpreg_hi(l_reg) << 2), 0x3B, 0x04 | (gpreg_hw(l_reg) << 3), 0xD1) // CMP l_reg, [RCX + RDX*8]
                }
                return inv_jcc
            }
            if pr_i > 0 and gpreg_hw(pr_i) != 4 {
                emit_int_expr_to_rax(cg, vars, drops, breaks, lhs)
                if pr_p > 0 { mc_mov_rcx_gpreg(c, pr_p) } else { mc_load_rcx(c, psl_r, 0) }
                mc_b4(c, 0x48 | (gpreg_hi(pr_i) << 1), 0x3B, 0x04, 0xC1 | (gpreg_hw(pr_i) << 3)) // CMP RAX, [RCX + pr_i*8]
                return inv_jcc
            }
        }
    }
    if not expr_has_real_call_ax(cg, rhs) {
        emit_int_expr_to_rax(cg, vars, drops, breaks, lhs)
        mc_b3(c, 0x49, 0x89, 0xC1) // MOV R9, RAX (lhs)
        emit_int_expr_depth_ax(cg, vars, drops, breaks, rhs, 1)
        mc_b3(c, 0x49, 0x39, 0xC1) // CMP R9, RAX (lhs - rhs)
        return inv_jcc
    }
    emit_int_expr_to_rax(cg, vars, drops, breaks, lhs)
    lt := cg_alloc_slots(cg, 1)
    mc_store_rax(c, lt, 0)
    emit_int_expr_to_rax(cg, vars, drops, breaks, rhs)
    mc_b3(c, 0x48, 0x89, 0xC1)
    mc_load_rax(c, lt, 0)
    mc_b3(c, 0x48, 0x39, 0xC8)
    return inv_jcc
}

// Branchless `CMOVcc` if-conversion for `if cmp { v = y }` and `if guard and cmp { v = y }`!
fn try_emit_cmov_if_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, cn_if: i64, tb: i64) -> bool {
    if cn_if <= 0 or ast_kind(cg.nodes, cn_if) != nk_binary() { return false }
    if ast_kind(cg.nodes, tb) != nk_block() or ast_get(cg.nodes, tb, 2) != 1 { return false }
    st0 := ibuf_get(cg.extra, ast_get(cg.nodes, tb, 1))
    if ast_kind(cg.nodes, st0) != nk_assign() or ast_get(cg.nodes, st0, 1) != aop_eq() { return false }
    v_slot := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, st0, 2))
    pr_v := cg_slot_reg(cg, v_slot)
    if pr_v <= 0 { return false }
    y_nid := ast_get(cg.nodes, st0, 3)
    pr_y := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, y_nid))
    y_is_imm := pr_y <= 0 and is_folded_const_int_ax(cg, vars, y_nid)
    mut y_imm := 0
    if y_is_imm {
        y_imm = eval_folded_const_int_ax(cg, vars, y_nid)
        if y_imm < -2147483648 or y_imm > 2147483647 { return false }
    } else if pr_y <= 0 {
        return false
    }

    cop := ast_get(cg.nodes, cn_if, 1)
    mut cmp_n := 0
    mut guard_n := 0
    if cop >= op_eq() and cop <= op_gte() {
        cmp_n = cn_if
    } else if cop == op_and() {
        c2 := ast_get(cg.nodes, cn_if, 3)
        if c2 > 0 and ast_kind(cg.nodes, c2) == nk_binary() and ast_get(cg.nodes, c2, 1) >= op_eq() and ast_get(cg.nodes, c2, 1) <= op_gte() {
            guard_n = ast_get(cg.nodes, cn_if, 2)
            cmp_n = c2
        }
    }
    if cmp_n <= 0 { return false }
    cl := ast_get(cg.nodes, cmp_n, 2); cr := ast_get(cg.nodes, cmp_n, 3)
    plty := pure_i64_ty_ax(cg, vars, cl)
    if plty == 0 or pure_i64_ty_ax(cg, vars, cr) != plty { return false }

    c := cg.code
    saved_slot := ibuf_get(cg.state, 4)
    saved_drops := ibuf_len(drops)
    mut jf_guard := -1
    if guard_n > 0 { jf_guard = emit_cond_jump_false_ax(cg, vars, drops, breaks, guard_n) }
    inv_jcc := emit_cmp_i64_flags_ax(cg, vars, drops, breaks, ast_get(cg.nodes, cmp_n, 1), cl, cr)
    cmov_cc := ((inv_jcc ^ 1) - 0x80) + 0x40 // 0x84->0x44 (CMOVE), 0x8C->0x4C (CMOVL), etc.
    if pr_y > 0 {
        mc_b4(c, 0x48 | (gpreg_hi(pr_v) << 2) | gpreg_hi(pr_y), 0x0F, cmov_cc, 0xC0 | (gpreg_hw(pr_v) << 3) | gpreg_hw(pr_y))
    } else {
        mc_b3(c, 0x48, 0xC7, 0xC1); mc_u32(c, y_imm) // MOV RCX, sign_ext(y_imm) (does not touch EFLAGS!)
        mc_b4(c, 0x48 | (gpreg_hi(pr_v) << 2), 0x0F, cmov_cc, 0xC1 | (gpreg_hw(pr_v) << 3))
    }
    if jf_guard >= 0 { mc_patch_rel32(c, jf_guard, buf_len(c)) }
    if ibuf_len(drops) == saved_drops { ibuf_set(cg.state, 4, saved_slot) }
    return true
}

// Emits fused `CMP`/`UCOMISD` + `Jcc rel32` for `if`/`while` conditions without allocating boolean scratch slots.
fn emit_cond_branch_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, cond_nid: i64, jump_if_true: bool) -> i64 {
    c := cg.code
    saved_slot := ibuf_get(cg.state, 4)
    saved_drops := ibuf_len(drops)

    if cond_nid > 0 and ast_kind(cg.nodes, cond_nid) == nk_binary() {
        op := ast_get(cg.nodes, cond_nid, 1)
        if op >= op_eq() and op <= op_gte() {
            lhs := ast_get(cg.nodes, cond_nid, 2)
            rhs := ast_get(cg.nodes, cond_nid, 3)
            inv_jcc := emit_cmp_i64_flags_ax(cg, vars, drops, breaks, op, lhs, rhs)
            if inv_jcc != 0 {
                if ibuf_len(drops) == saved_drops { ibuf_set(cg.state, 4, saved_slot) }
                return mc_jcc32_cond(c, inv_jcc, jump_if_true)
            }
            if pure_f64_ty_ax(cg, vars, lhs) and pure_f64_ty_ax(cg, vars, rhs) {
                if op == op_gt() or op == op_gte() {
                    if ibuf_get(cg.state, 25) == 1 and const_f64_rdata_ok(cg, vars, rhs) {
                        emit_f64_to_hw_vex(cg, vars, lhs, 0)
                        cbits := const_f64_bits_ax(cg, rhs)
                        if cbits != 0 and cbits == ibuf_get(cg.state, 23) {
                            mc_vex3(c, 0, 0, 0, 1, 0, 0, 0, 1, 0x2E); mc_b1(c, 0xC5) // VUCOMISD XMM0, XMM5 (hoisted!)
                        } else {
                            mc_vex_ucomisd_rdata(cg, 0, cbits)
                        }
                        if ibuf_len(drops) == saved_drops { ibuf_set(cg.state, 4, saved_slot) }
                        if op == op_gt() { return mc_jcc32_cond(c, 0x86, jump_if_true) }
                        return mc_jcc32_cond(c, 0x82, jump_if_true)
                    }
                    emit_f64_expr_to_xmm0(cg, vars, lhs)
                    if const_f64_rdata_ok(cg, vars, rhs) {
                        mc_sse_xmm0_rdata(cg, 0x66, 0x2E, const_f64_bits_ax(cg, rhs), false)
                    } else {
                        rf_slot := local_f64_slot_ax(cg, vars, rhs)
                        if rf_slot > 0 {
                            rff := cg_slot_freg(cg, rf_slot)
                            if rff > 0 { mc_sse_xmm0_freg_op(c, 0x66, 0x2E, rff) }
                            else       { mc_sse_xmm0_slot(c, 0x66, 0x2E, rf_slot, 0) }
                        } else {
                            mc_b3(c, 0x0F, 0x28, 0xD0) // MOVAPS XMM2, XMM0
                            emit_f64_expr_to_xmm0(cg, vars, rhs)
                            mc_b4(c, 0x66, 0x0F, 0x2E, 0xD0) // UCOMISD XMM2, XMM0
                        }
                    }
                    if ibuf_len(drops) == saved_drops { ibuf_set(cg.state, 4, saved_slot) }
                    if op == op_gt() { return mc_jcc32_cond(c, 0x86, jump_if_true) }
                    return mc_jcc32_cond(c, 0x82, jump_if_true)
                } else if op == op_lt() or op == op_lte() {
                    emit_f64_expr_to_xmm0(cg, vars, rhs)
                    if const_f64_rdata_ok(cg, vars, lhs) {
                        mc_sse_xmm0_rdata(cg, 0x66, 0x2E, const_f64_bits_ax(cg, lhs), false)
                    } else {
                        lf_slot := local_f64_slot_ax(cg, vars, lhs)
                        if lf_slot > 0 {
                            lff := cg_slot_freg(cg, lf_slot)
                            if lff > 0 { mc_sse_xmm0_freg_op(c, 0x66, 0x2E, lff) }
                            else       { mc_sse_xmm0_slot(c, 0x66, 0x2E, lf_slot, 0) }
                        } else {
                            mc_b3(c, 0x0F, 0x28, 0xD0) // MOVAPS XMM2, XMM0
                            emit_f64_expr_to_xmm0(cg, vars, lhs)
                            mc_b4(c, 0x66, 0x0F, 0x2E, 0xD0) // UCOMISD XMM2, XMM0
                        }
                    }
                    if ibuf_len(drops) == saved_drops { ibuf_set(cg.state, 4, saved_slot) }
                    if op == op_lt() { return mc_jcc32_cond(c, 0x86, jump_if_true) }
                    return mc_jcc32_cond(c, 0x82, jump_if_true)
                }
            }
            lr := emit_expr_ax(cg, vars, drops, breaks, lhs)
            lty := er_ty(lr)
            if lty == ty_int() or lty == ty_bool() {
                mut inv_jcc := 0x85
                if op == op_neq() { inv_jcc = 0x84 }
                else if op == op_lt() { inv_jcc = 0x8D }
                else if op == op_lte() { inv_jcc = 0x8F }
                else if op == op_gt() { inv_jcc = 0x8E }
                else if op == op_gte() { inv_jcc = 0x8C }

                if is_folded_const_int_ax(cg, vars, rhs) {
                    imm := eval_folded_const_int_ax(cg, vars, rhs)
                    if imm >= -2147483648 and imm <= 2147483647 {
                        mc_load_rax(c, er_slot(lr), 0)
                        if imm == 0 {
                            mc_b3(c, 0x48, 0x85, 0xC0)
                        } else if imm >= -128 and imm <= 127 {
                            mc_b4(c, 0x48, 0x83, 0xF8, imm & 255)
                        } else {
                            mc_b2(c, 0x48, 0x3D)
                            mc_u32(c, imm)
                        }
                        if ibuf_len(drops) == saved_drops {
                            ibuf_set(cg.state, 4, saved_slot)
                        }
                        return mc_jcc32_cond(c, inv_jcc, jump_if_true)
                    }
                }

                rr := emit_expr_ax(cg, vars, drops, breaks, rhs)
                rty := er_ty(rr)
                if rty == ty_int() or rty == ty_bool() {
                    mc_load_rax(c, er_slot(lr), 0)
                    mc_cmp_rax_slot(c, er_slot(rr), 0)
                    if ibuf_len(drops) == saved_drops {
                        ibuf_set(cg.state, 4, saved_slot)
                    }
                    return mc_jcc32_cond(c, inv_jcc, jump_if_true)
                }

                dst := emit_scalar_binop_ax(cg, op, er_slot(lr), 0, er_slot(rr), 0, ty_int())
                mc_load_rax(c, dst, 0)
                mc_b3(c, 0x48, 0x85, 0xC0)
                if ibuf_len(drops) == saved_drops {
                    ibuf_set(cg.state, 4, saved_slot)
                }
                return mc_jcc32_cond(c, 0x84, jump_if_true)
            } else if lty == ty_float() {
                rr := emit_expr_ax(cg, vars, drops, breaks, rhs)
                if er_ty(rr) == ty_float() {
                    if op == op_gt() or op == op_gte() {
                        mc_sse_xmm0_slot(c, 0xF2, 0x10, er_slot(lr), 0)
                        mc_sse_xmm0_slot(c, 0x66, 0x2E, er_slot(rr), 0)
                        if ibuf_len(drops) == saved_drops { ibuf_set(cg.state, 4, saved_slot) }
                        if op == op_gt() { return mc_jcc32_cond(c, 0x86, jump_if_true) } // JBE (false or NaN)
                        return mc_jcc32_cond(c, 0x82, jump_if_true) // JB (false or NaN)
                    } else if op == op_lt() or op == op_lte() {
                        // Swap operands: (l < r) == (r > l); (l <= r) == (r >= l) -> single JBE/JB NaN-safe!
                        mc_sse_xmm0_slot(c, 0xF2, 0x10, er_slot(rr), 0)
                        mc_sse_xmm0_slot(c, 0x66, 0x2E, er_slot(lr), 0)
                        if ibuf_len(drops) == saved_drops { ibuf_set(cg.state, 4, saved_slot) }
                        if op == op_lt() { return mc_jcc32_cond(c, 0x86, jump_if_true) } // JBE
                        return mc_jcc32_cond(c, 0x82, jump_if_true) // JB
                    }
                    mc_sse_xmm0_slot(c, 0xF2, 0x10, er_slot(lr), 0)
                    mc_sse_xmm0_slot(c, 0x66, 0x2E, er_slot(rr), 0)
                    if op == op_eq() {
                        mc_b3(c, 0x0F, 0x94, 0xC0) // SETE AL
                        mc_b3(c, 0x0F, 0x9B, 0xC2) // SETNP DL
                        mc_b2(c, 0x20, 0xD0)       // AND AL, DL
                    } else {
                        mc_b3(c, 0x0F, 0x95, 0xC0) // SETNE AL
                        mc_b3(c, 0x0F, 0x9A, 0xC2) // SETP DL
                        mc_b2(c, 0x08, 0xD0)       // OR AL, DL
                    }
                    mc_b2(c, 0x84, 0xC0) // TEST AL, AL
                    if ibuf_len(drops) == saved_drops { ibuf_set(cg.state, 4, saved_slot) }
                    return mc_jcc32_cond(c, 0x84, jump_if_true)
                }
                dst := emit_scalar_binop_ax(cg, op, er_slot(lr), 0, er_slot(rr), 0, ty_float())
                mc_load_rax(c, dst, 0)
                mc_b3(c, 0x48, 0x85, 0xC0)
                if ibuf_len(drops) == saved_drops { ibuf_set(cg.state, 4, saved_slot) }
                return mc_jcc32_cond(c, 0x84, jump_if_true)
            }
        }
    }

    cr := emit_expr_ax(cg, vars, drops, breaks, cond_nid)
    mc_load_rax(c, er_slot(cr), 0)
    mc_b3(c, 0x48, 0x85, 0xC0)
    if ibuf_len(drops) == saved_drops {
        ibuf_set(cg.state, 4, saved_slot)
    }
    return mc_jcc32_cond(c, 0x84, jump_if_true)
}

fn emit_cond_jump_false_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, cond_nid: i64) -> i64 {
    return emit_cond_branch_ax(cg, vars, drops, breaks, cond_nid, false)
}

fn emit_perceus_drops_ax(cg: CodegenCtx, drops: IntBuf) {
    c := cg.code
    dcnt := ibuf_len(drops)
    mut i := 0
    while i < dcnt {
        ent := ibuf_get(drops, i)
        if ent > 0 {
            mc_load_rcx(c, ent, 0)
            mc_b2(c, 0x31, 0xC0)
            mc_store_rax(c, ent, 0)
            emit_free_raw_rcx(cg)
        }
        i += 1
    }
}

fn has_secret_wipes(drops: IntBuf) -> bool {
    dcnt := ibuf_len(drops)
    mut i := 0
    while i < dcnt {
        if ibuf_get(drops, i) < 0 {
            return true
        }
        i += 1
    }
    return false
}

fn emit_wipe_secrets_ax(cg: CodegenCtx, drops: IntBuf) {
    if not has_secret_wipes(drops) {
        return
    }
    c := cg.code
    mc_b2(c, 0x31, 0xC0)
    dcnt := ibuf_len(drops)
    mut i := 0
    while i < dcnt {
        ent := ibuf_get(drops, i)
        if ent < 0 {
            pk := 0 - ent
            bslot := pk >> 16
            scnt := pk & 0xFFFF
            mut s := 0
            while s < scnt {
                mc_store_rax(c, bslot, s)
                s += 1
            }
        }
        i += 1
    }
}

fn emit_writeback_mut_params_ax(cg: CodegenCtx, vars: IntBuf) {
    ab_slot := ibuf_get(cg.state, 5)
    if ibuf_get(cg.state, 9) == 1 or ab_slot <= 0 {
        return
    }
    c := cg.code
    fidx := ibuf_get(cg.state, 3)
    f_off := ibuf_get(cg.sym, 7) + fidx * 10
    p_base := ibuf_get(cg.sym, f_off + 3)
    p_cnt := ibuf_get(cg.sym, f_off + 4)

    mut pi := 0
    while pi < p_cnt {
        po := p_base + pi * 6
        if ibuf_get(cg.sym, po + 2) == pmode_mut() {
            vb := cg_var_find(cg.pool, vars, ibuf_get(cg.sym, po), ibuf_get(cg.sym, po + 1))
            if vb >= 0 {
                lslot := ibuf_get(vars, vb + 2)
                pty := ibuf_get(vars, vb + 3)
                pslots := type_slots(cg.sym, pty)
                arg_off := ibuf_get(cg.sym, po + 4)
                mc_load_r8(c, ab_slot, 0)
                mut s := 0
                while s < pslots {
                    mc_load_rax(c, lslot, s)
                    mc_r8_store_rax(c, (arg_off + s) * 8)
                    s += 1
                }
            }
        }
        pi += 1
    }
}

fn emit_return_from_slot_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, val_slot: i64, val_ty: i64) {
    c := cg.code
    emit_perceus_drops_ax(cg, drops)

    iret_slot := ibuf_get(cg.state, 22)
    if iret_slot > 0 {
        rslots := ibuf_get(cg.state, 24)
        mut copy_n := type_slots(cg.sym, val_ty)
        if copy_n > rslots { copy_n = rslots }
        mut s := 0
        while s < copy_n {
            mc_load_rax(c, val_slot, s)
            mc_store_rax(c, iret_slot, s)
            s += 1
        }
        emit_wipe_secrets_ax(cg, drops)
        depth_i := ibuf_get(cg.state, 25) - 1
        jpos := mc_jmp32(c)
        if depth_i >= 0 and depth_i < 4 {
            jcnt := ibuf_get(cg.state, 30 + depth_i)
            if jcnt < 16 {
                ibuf_set(cg.state, 34 + depth_i * 16 + jcnt, jpos)
                ibuf_set(cg.state, 30 + depth_i, jcnt + 1)
            }
        }
        return
    }

    emit_writeback_mut_params_ax(cg, vars)

    rslots := ibuf_get(cg.state, 8)
    if ibuf_get(cg.state, 9) == 1 {
        if rslots >= 2 {
            mc_load_rdx(c, val_slot, 1)
        }
        mc_load_rax(c, val_slot, 0)
    } else {
        rb_slot := ibuf_get(cg.state, 6)
        if rb_slot > 0 {
            mc_load_r8(c, rb_slot, 0)
            mut copy_n := type_slots(cg.sym, val_ty)
            if copy_n > rslots { copy_n = rslots }
            mut s := 0
            while s < copy_n {
                mc_load_rax(c, val_slot, s)
                mc_r8_store_rax(c, s * 8)
                s += 1
            }
            mc_load_rax(c, val_slot, 0)
        }
    }

    if has_secret_wipes(drops) {
        mc_b3(c, 0x49, 0x89, 0xC1)
        emit_wipe_secrets_ax(cg, drops)
        mc_b3(c, 0x4C, 0x89, 0xC8)
    }
    emit_restore_callee_regs_ax(cg)
    mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
    mc_b1(c, 0xC3)
}

// Appends unquoted raw `str` `(val_slot, 0..1)` into `ByteBuf` at `jb_slot`
fn emit_jbuf_append_raw_str(cg: CodegenCtx, jb_slot: i64, val_slot: i64) {
    c := cg.code
    mc_load_rcx(c, jb_slot, 0)
    mc_load_rdx(c, val_slot, 0)
    mc_load_r8(c, val_slot, 1)
    cg_call_fn(cg, h_jbuf_raw())
    mc_store_rax(c, jb_slot, 0)
}

fn emit_expr_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, enid: i64) -> i64 {
    c := cg.code
    if enid <= 0 {
        zs := cg_alloc_slots(cg, 1)
        mc_mov_rax_imm(c, 0)
        mc_store_rax(c, zs, 0)
        return er_pack(zs, ty_unit())
    }
    k := ast_kind(cg.nodes, enid)

    if k == nk_int() {
        s := cg_alloc_slots(cg, 1)
        mc_mov_rax_imm(c, ast_get(cg.nodes, enid, 1))
        mc_store_rax(c, s, 0)
        return er_pack(s, ty_int())
    }
    if k == nk_float() {
        s := cg_alloc_slots(cg, 1)
        mc_mov_rax_imm(c, ast_get(cg.nodes, enid, 1))
        mc_store_rax(c, s, 0)
        return er_pack(s, ty_float())
    }
    if k == nk_dec() {
        s := cg_alloc_slots(cg, 1)
        mc_mov_rax_imm(c, ast_get(cg.nodes, enid, 1))
        mc_store_rax(c, s, 0)
        return er_pack(s, ty_dec())
    }
    if k == nk_bool() {
        s := cg_alloc_slots(cg, 1)
        mc_mov_rax_imm(c, ast_get(cg.nodes, enid, 1))
        mc_store_rax(c, s, 0)
        return er_pack(s, ty_bool())
    }
    if k == nk_str() {
        soff := ast_get(cg.nodes, enid, 1)
        slen := ast_get(cg.nodes, enid, 2)
        roff := cg_intern_pool_slice(cg, soff, slen)
        s := cg_alloc_slots(cg, 2)
        cg_lea_rax_rdata(cg, roff)
        mc_store_rax(c, s, 0)
        mc_mov_rax_imm(c, slen)
        mc_store_rax(c, s, 1)
        return er_pack(s, ty_str())
    }
    if k == nk_secret_str() {
        soff := ast_get(cg.nodes, enid, 1)
        slen := ast_get(cg.nodes, enid, 2)
        site_id := ibuf_get(cg.state, 1) + 1
        ibuf_set(cg.state, 1, site_id)
        seed0 := ((0x5A ^ (site_id * 97) ^ (slen * 13)) & 255) | 1
        cipher_off := buf_len(cg.rdata)
        mut st := seed0
        mut i := 0
        while i < slen {
            pb := buf_get(cg.pool, soff + i)
            buf_push(cg.rdata, (pb ^ st) & 255)
            st = (st * 131 + 73 + i) & 255
            i += 1
        }
        mut bslots := (slen + 8) / 8
        if bslots < 1 { bslots = 1 }
        bslot := cg_alloc_slots(cg, bslots)
        lowest_slot := bslot + bslots - 1
        ibuf_push(drops, 0 - ((bslot << 16) | bslots))

        cg_lea_rax_rdata(cg, cipher_off)
        mc_b3(c, 0x49, 0x89, 0xC0)
        mc_lea_rax(c, lowest_slot, 0)
        mc_b3(c, 0x49, 0x89, 0xC1)
        if slen > 0 {
            mc_b2(c, 0x31, 0xC9)
            mc_b1(c, 0xBA)
            mc_u32(c, seed0)
            sloop := buf_len(c)
            mc_b4(c, 0x41, 0x0F, 0xB6, 0x04)
            mc_b1(c, 0x08)
            mc_b2(c, 0x31, 0xD0)
            mc_b4(c, 0x41, 0x88, 0x04, 0x09)
            mc_b2(c, 0x69, 0xD2)
            mc_u32(c, 131)
            mc_b3(c, 0x83, 0xC2, 73)
            mc_b2(c, 0x01, 0xCA)
            mc_b3(c, 0x0F, 0xB6, 0xD2)
            mc_b3(c, 0x48, 0xFF, 0xC1)
            mc_b3(c, 0x48, 0x81, 0xF9)
            mc_u32(c, slen)
            jb_sc := mc_jcc8(c, 0x72)
            mc_patch_jcc8(c, jb_sc, sloop)
        }
        res := cg_alloc_slots(cg, 2)
        mc_b3(c, 0x4C, 0x89, 0xC8)
        mc_store_rax(c, res, 0)
        mc_mov_rax_imm(c, slen)
        mc_store_rax(c, res, 1)
        return er_pack(res, ty_str())
    }
    if k == nk_fstr() {
        // Materialize first-class `f"..."` string value (propagating `tainted[str]` automatically!)
        poff := ast_get(cg.nodes, enid, 1)
        pcnt := ast_get(cg.nodes, enid, 2)
        jb_slot := cg_alloc_slots(cg, 1)
        mc_b2(c, 0x31, 0xC9)
        cg_call_fn(cg, h_buf_new())
        mc_store_rax(c, jb_slot, 0)

        mut is_tainted := false
        mut pi := 0
        while pi < pcnt {
            pe := ibuf_get(cg.extra, poff + pi)
            if ast_kind(cg.nodes, pe) == nk_str() {
                ls_off := ast_get(cg.nodes, pe, 1)
                ls_len := ast_get(cg.nodes, pe, 2)
                if ls_len > 0 {
                    roff := cg_intern_pool_slice(cg, ls_off, ls_len)
                    emit_jbuf_append_rdata(cg, jb_slot, roff, ls_len)
                }
            } else {
                pr := emit_expr_ax(cg, vars, drops, breaks, pe)
                mut pty := er_ty(pr)
                if ty_tag(pty) == 16 {
                    is_tainted = true
                    pty = ty_pay(pty)
                }
                if ty_tag(pty) == 5 {
                    emit_jbuf_append_raw_str(cg, jb_slot, er_slot(pr))
                } else {
                    emit_jbuf_append_i64(cg, jb_slot, er_slot(pr), 0)
                }
            }
            pi += 1
        }
        dst := cg_alloc_slots(cg, 2)
        mc_load_rax(c, jb_slot, 0)
        mc_b3(c, 0x48, 0x8B, 0x08) // RCX = len
        mc_b4(c, 0xC6, 0x44, 0x08, 0x10); mc_b1(c, 0) // null terminate
        mc_b4(c, 0x48, 0x8D, 0x40, 0x10)
        mc_store_rax(c, dst, 0)
        mc_b3(c, 0x48, 0x89, 0xC8)
        mc_store_rax(c, dst, 1)
        if is_tainted {
            return er_pack(dst, ty_make(16, ty_str()))
        }
        return er_pack(dst, ty_str())
    }
    if k == nk_ident() or k == nk_move_ident() {
        soff := ast_get(cg.nodes, enid, 1)
        slen := ast_get(cg.nodes, enid, 2)
        vb := cg_var_find(cg.pool, vars, soff, slen)
        if vb >= 0 {
            vs := ibuf_get(vars, vb + 2)
            pr := cg_slot_reg(cg, vs)
            if pr > 0 { mc_store_gpreg(c, vs, pr) }
            pfr := cg_slot_freg(cg, vs)
            if pfr > 0 { mc_store_freg_sd(c, vs, pfr) }
            return er_pack(vs, ibuf_get(vars, vb + 3))
        }
        goff := ct_find_global_const(cg.pool, cg.sym, soff, slen)
        if goff >= 0 {
            cty := ibuf_get(cg.sym, goff + 2)
            v1 := ibuf_get(cg.sym, goff + 3)
            v2 := ibuf_get(cg.sym, goff + 4)
            if cty == ty_str() {
                roff := cg_intern_pool_slice(cg, v1, v2)
                s := cg_alloc_slots(cg, 2)
                cg_lea_rax_rdata(cg, roff)
                mc_store_rax(c, s, 0)
                mc_mov_rax_imm(c, v2)
                mc_store_rax(c, s, 1)
                return er_pack(s, ty_str())
            }
            if cty == ty_intbuf() or cty == ty_bytebuf() {
                roff := cg_intern_ct_lut(cg, goff)
                s := cg_alloc_slots(cg, 1)
                cg_lea_rax_rdata(cg, roff)
                mc_store_rax(c, s, 0)
                return er_pack(s, cty)
            }
            s := cg_alloc_slots(cg, 1)
            mc_mov_rax_imm(c, v1)
            mc_store_rax(c, s, 0)
            return er_pack(s, cty)
        }
        if pool_str_eq_lit(cg.pool, soff, slen, "None") or pool_str_eq_lit(cg.pool, soff, slen, "nil") or pool_str_eq_lit(cg.pool, soff, slen, "null") {
            s := cg_alloc_slots(cg, 1)
            mc_mov_rax_imm(c, 0)
            mc_store_rax(c, s, 0)
            return er_pack(s, ty_unit())
        }
        zs := cg_alloc_slots(cg, 1)
        mc_mov_rax_imm(c, 0)
        mc_store_rax(c, zs, 0)
        return er_pack(zs, ty_int())
    }
    if k == nk_await() {
        ir := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 1))
        ity := er_ty(ir)
        if ty_tag(ity) == 22 or ty_tag(ity) == 15 {
            return er_pack(er_slot(ir), ty_pay(ity))
        }
        return ir
    }
    if k == nk_comptime_expr() {
        return emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 1))
    }
    if k == nk_call() {
        if ast_get(cg.nodes, enid, 4) == 0 {
            fidx := find_fn_idx(cg.pool, cg.sym, ast_get(cg.nodes, enid, 1), ast_get(cg.nodes, enid, 2))
            if is_const_fn_idx(cg.sym, fidx) {
                s := cg_alloc_slots(cg, 1)
                mc_mov_rax_imm(c, const_fn_val(cg.sym, fidx))
                mc_store_rax(c, s, 0)
                return er_pack(s, const_fn_ty(cg.sym, fidx))
            }
        }
        return emit_call_or_ctor(cg, vars, drops, breaks, enid)
    }
    if k == nk_tuple() {
        off := ast_get(cg.nodes, enid, 1)
        cnt := ast_get(cg.nodes, enid, 2)
        desc_off := ibuf_len(cg.sym)
        ibuf_push(cg.sym, cnt)
        mut i := 0
        while i < cnt {
            ibuf_push(cg.sym, ty_int())
            i += 1
        }
        ev := ibuf_new(32)
        mut tot := 0
        i = 0
        while i < cnt {
            er := emit_expr_ax(cg, vars, drops, breaks, ibuf_get(cg.extra, off + i))
            eslot := er_slot(er)
            ety := er_ty(er)
            ecnt := type_slots(cg.sym, ety)
            tot += ecnt
            ibuf_push(ev, eslot)
            ibuf_push(ev, ecnt)
            ibuf_set(cg.sym, desc_off + 1 + i, ety)
            i += 1
        }
        dst := cg_alloc_slots(cg, tot)
        mut cur := 0
        i = 0
        while i < cnt {
            es := ibuf_get(ev, i * 2)
            ec := ibuf_get(ev, i * 2 + 1)
            mut s := 0
            while s < ec {
                mc_load_rax(c, es, s)
                mc_store_rax(c, dst, cur + s)
                s += 1
            }
            cur += ec
            i += 1
        }
        buf_free(move ev)
        return er_pack(dst, ty_make(14, desc_off))
    }
    if k == nk_unary() {
        if is_nonshadowed_const_int(cg, vars, enid) {
            cval := eval_const_int_val(cg.pool, cg.nodes, cg.sym, enid)
            mut uty := ty_int()
            if ast_get(cg.nodes, enid, 1) == uop_not() { uty = ty_bool() }
            s := cg_alloc_slots(cg, 1)
            mc_mov_rax_imm(c, cval)
            mc_store_rax(c, s, 0)
            return er_pack(s, uty)
        }
        uop := ast_get(cg.nodes, enid, 1)
        ir := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 2))
        islot := er_slot(ir)
        ity := er_ty(ir)
        dst := cg_alloc_slots(cg, 1)
        mc_load_rax(c, islot, 0)
        if uop == uop_neg() {
            if ity == ty_float() {
                mc_b2(c, 0x48, 0xB9)
                mc_u64(c, 1 << 63)
                mc_b3(c, 0x48, 0x31, 0xC8)
            } else {
                mc_b3(c, 0x48, 0xF7, 0xD8)
                if ibuf_get(cg.state, 0) == 1 {
                    cg_jmp_fn(cg, 0x80, h_sec_trap())
                }
            }
            mc_store_rax(c, dst, 0)
            return er_pack(dst, ity)
        }
        mc_b3(c, 0x48, 0x85, 0xC0)
        mc_b3(c, 0x0F, 0x94, 0xC0)
        mc_b3(c, 0x0F, 0xB6, 0xC0)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_bool())
    }
    if k == nk_binary() {
        op := ast_get(cg.nodes, enid, 1)
        if is_nonshadowed_const_int(cg, vars, enid) {
            cval := eval_const_int_val(cg.pool, cg.nodes, cg.sym, enid)
            mut cty := ty_int()
            if op >= op_eq() and op <= op_or() {
                cty = ty_bool()
            }
            s := cg_alloc_slots(cg, 1)
            mc_mov_rax_imm(c, cval)
            mc_store_rax(c, s, 0)
            return er_pack(s, cty)
        }
        pure_ty := pure_i64_ty_ax(cg, vars, enid)
        if pure_ty != 0 {
            saved_t := ibuf_get(cg.state, 4)
            emit_int_expr_to_rax(cg, vars, drops, breaks, enid)
            ibuf_set(cg.state, 4, saved_t)
            dst := cg_alloc_slots(cg, 1)
            mc_store_rax(c, dst, 0)
            return er_pack(dst, pure_ty)
        }
        if pure_f64_ty_ax(cg, vars, enid) {
            saved_tf := ibuf_get(cg.state, 4)
            emit_f64_expr_to_xmm0(cg, vars, enid)
            ibuf_set(cg.state, 4, saved_tf)
            dst := cg_alloc_slots(cg, 1)
            mc_sse_xmm0_slot(c, 0xF2, 0x11, dst, 0)
            if (ibuf_get(cg.state, 18) & fnflag_nan_guard()) != 0 {
                ibuf_set(cg.state, 20, span_line(ast_span(cg.nodes, enid)))
                mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
                emit_nan_guard_rax(cg)
            }
            return er_pack(dst, ty_float())
        }

        lr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 2))
        lslot := er_slot(lr)
        lty := er_ty(lr)

        if op == op_or() and ty_tag(lty) == 13 {
            ok_ty := ty_pay(lty)
            ok_slots := type_slots(cg.sym, ok_ty)
            dst := cg_alloc_slots(cg, ok_slots)
            mc_load_rax(c, lslot, 0)
            mc_b3(c, 0x48, 0x85, 0xC0)
            jnz_err := mc_jcc32(c, 0x85)
            mut s := 0
            while s < ok_slots {
                mc_load_rax(c, lslot, 1 + s)
                mc_store_rax(c, dst, s)
                s += 1
            }
            jmp_d := mc_jmp32(c)
            mc_patch_rel32(c, jnz_err, buf_len(c))
            rr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 3))
            rslot := er_slot(rr)
            s = 0
            while s < ok_slots {
                mc_load_rax(c, rslot, s)
                mc_store_rax(c, dst, s)
                s += 1
            }
            mc_patch_rel32(c, jmp_d, buf_len(c))
            return er_pack(dst, ok_ty)
        }

        if op == op_or() {
            dst := cg_alloc_slots(cg, 1)
            mc_load_rax(c, lslot, 0)
            mc_b3(c, 0x48, 0x85, 0xC0)
            jnz_true := mc_jcc32(c, 0x85)
            rr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 3))
            rslot := er_slot(rr)
            mc_load_rax(c, rslot, 0)
            mc_b3(c, 0x48, 0x85, 0xC0)
            mc_b3(c, 0x0F, 0x95, 0xC0)
            mc_b3(c, 0x0F, 0xB6, 0xC0)
            mc_store_rax(c, dst, 0)
            jmp_d := mc_jmp32(c)
            mc_patch_rel32(c, jnz_true, buf_len(c))
            mc_mov_rax_imm(c, 1)
            mc_store_rax(c, dst, 0)
            mc_patch_rel32(c, jmp_d, buf_len(c))
            return er_pack(dst, ty_bool())
        }

        if op == op_and() {
            dst := cg_alloc_slots(cg, 1)
            mc_load_rax(c, lslot, 0)
            mc_b3(c, 0x48, 0x85, 0xC0)
            jz_false := mc_jcc32(c, 0x84)
            rr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 3))
            rslot := er_slot(rr)
            mc_load_rax(c, rslot, 0)
            mc_b3(c, 0x48, 0x85, 0xC0)
            mc_b3(c, 0x0F, 0x95, 0xC0)
            mc_b3(c, 0x0F, 0xB6, 0xC0)
            mc_store_rax(c, dst, 0)
            jmp_d := mc_jmp32(c)
            mc_patch_rel32(c, jz_false, buf_len(c))
            mc_mov_rax_imm(c, 0)
            mc_store_rax(c, dst, 0)
            mc_patch_rel32(c, jmp_d, buf_len(c))
            return er_pack(dst, ty_bool())
        }

        rhs_nid := ast_get(cg.nodes, enid, 3)
        if (lty == ty_int() or (lty == ty_bool() and op >= op_eq() and op <= op_gte())) and is_nonshadowed_const_int(cg, vars, rhs_nid) {
            imm := eval_const_int_val(cg.pool, cg.nodes, cg.sym, rhs_nid)
            ibuf_set(cg.state, 20, span_line(ast_span(cg.nodes, enid)))
            imm_dst := emit_int_binop_imm_ax(cg, lslot, op, imm)
            if imm_dst >= 0 {
                mut imm_rty := lty
                if op >= op_eq() and op <= op_gte() { imm_rty = ty_bool() }
                return er_pack(imm_dst, imm_rty)
            }
        }

        rr := emit_expr_ax(cg, vars, drops, breaks, rhs_nid)
        rslot := er_slot(rr)
        rty := er_ty(rr)

        // Hardware 128-bit `XMM` SIMD operators for `vec3`, `vec4`, and `mat4`
        if lty == ty_vec3() or lty == ty_vec4() {
            dst := cg_alloc_slots(cg, 2)
            if rty == lty {
                mc_load_xmm0_vec(c, lslot, 0)
                mc_load_xmm1_vec(c, rslot, 0)
            } else {
                mc_f64_slot_to_f32_eax(c, rslot)
                mc_b3(c, 0x0F, 0x28, 0xC8)
                mc_b4(c, 0x0F, 0xC6, 0xC9, 0x00)
                mc_load_xmm0_vec(c, lslot, 0)
            }
            if op == op_add() { mc_b3(c, 0x0F, 0x58, 0xC1) }
            else if op == op_sub() { mc_b3(c, 0x0F, 0x5C, 0xC1) }
            else { mc_b3(c, 0x0F, 0x59, 0xC1) }
            mc_store_xmm0_vec(c, dst, 0)
            return er_pack(dst, lty)
        }
        if lty == ty_mat4() and op == op_mul() {
            if rty == ty_vec4() {
                mc_load_xmm1_vec(c, rslot, 0)
                mc_emit_mat4_mul_xmm1(c, lslot)
                dst := cg_alloc_slots(cg, 2)
                mc_store_xmm0_vec(c, dst, 0)
                return er_pack(dst, ty_vec4())
            }
            if rty == ty_mat4() {
                dst := cg_alloc_slots(cg, 8)
                mut col := 0
                while col < 4 {
                    mc_load_xmm1_vec(c, rslot, col * 2)
                    mc_emit_mat4_mul_xmm1(c, lslot)
                    mc_store_xmm0_vec(c, dst, col * 2)
                    col += 1
                }
                return er_pack(dst, ty_mat4())
            }
        }

        mut base_l := lty
        if ty_tag(base_l) == 16 { base_l = ty_pay(base_l) }
        mut base_r := rty
        if ty_tag(base_r) == 16 { base_r = ty_pay(base_r) }
        any_taint := (ty_tag(lty) == 16 or ty_tag(rty) == 16)

        if base_l == ty_str() and base_r == ty_str() {
            if op == op_add() {
                // `str + str` concatenation (propagating `tainted[str]` if either side is tainted!)
                mc_load_rcx(c, lslot, 0)
                mc_load_rdx(c, lslot, 1)
                mc_load_r8(c, rslot, 0)
                mc_load_r9(c, rslot, 1)
                cg_call_fn(cg, h_str_concat())
                dst := cg_alloc_slots(cg, 2)
                mc_store_rax(c, dst, 0)
                mc_store_rdx(c, dst, 1)
                if any_taint {
                    return er_pack(dst, ty_make(16, ty_str()))
                }
                return er_pack(dst, ty_str())
            }
            if op == op_eq() or op == op_neq() {
                dst := cg_alloc_slots(cg, 1)
                mc_load_rcx(c, lslot, 0)
                mc_load_rdx(c, lslot, 1)
                mc_load_r8(c, rslot, 0)
                mc_load_r9(c, rslot, 1)
                cg_call_fn(cg, h_str_eq())
                if op == op_neq() {
                    mc_b4(c, 0x48, 0x83, 0xF0, 0x01)
                }
                mc_store_rax(c, dst, 0)
                return er_pack(dst, ty_bool())
            }
        }

        mut common_ty := ty_int()
        if base_l == ty_dec() or base_r == ty_dec() { common_ty = ty_dec() }
        else if base_l == ty_float() or base_r == ty_float() { common_ty = ty_float() }

        if common_ty == ty_dec() and (op == op_mul() or op == op_div()) and base_l != base_r {
            dst := cg_alloc_slots(cg, 1)
            mc_load_rax(c, lslot, 0)
            mc_load_rcx(c, rslot, 0)
            if op == op_mul() {
                mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
                if ibuf_get(cg.state, 0) == 1 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
            } else {
                mc_b3(c, 0x48, 0x85, 0xC9)
                cg_jmp_fn(cg, 0x84, h_sec_trap())
                mc_b2(c, 0x48, 0x99)
                mc_b3(c, 0x48, 0xF7, 0xF9)
            }
            mc_store_rax(c, dst, 0)
            return er_pack(dst, ty_dec())
        }

        mut eff_l := lslot
        mut eff_r := rslot
        if common_ty == ty_float() {
            if base_l != ty_float() {
                eff_l = cg_alloc_slots(cg, 1)
                mc_load_rax(c, lslot, 0)
                mc_b4(c, 0xF2, 0x48, 0x0F, 0x2A); mc_b1(c, 0xC0) // CVTSI2SD XMM0, RAX
                mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0) // MOVQ RAX, XMM0
                mc_store_rax(c, eff_l, 0)
            }
            if base_r != ty_float() {
                eff_r = cg_alloc_slots(cg, 1)
                mc_load_rax(c, rslot, 0)
                mc_b4(c, 0xF2, 0x48, 0x0F, 0x2A); mc_b1(c, 0xC0) // CVTSI2SD XMM0, RAX
                mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0) // MOVQ RAX, XMM0
                mc_store_rax(c, eff_r, 0)
            }
        }

        mut res_ty := common_ty
        if op >= op_eq() and op <= op_or() {
            res_ty = ty_bool()
        } else if any_taint {
            res_ty = ty_make(16, common_ty)
        }
        ibuf_set(cg.state, 20, span_line(ast_span(cg.nodes, enid)))
        dst := emit_scalar_binop_ax(cg, op, eff_l, 0, eff_r, 0, common_ty)
        return er_pack(dst, res_ty)
    }
    if k == nk_in_range() {
        is_not := ast_get(cg.nodes, enid, 1)
        vr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 2))
        lor := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 3))
        hir := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 4))
        mut vty := er_ty(vr)
        if ty_tag(vty) == 16 or ty_tag(vty) == 22 { vty = ty_pay(vty) }
        mut loty := er_ty(lor)
        if ty_tag(loty) == 16 or ty_tag(loty) == 22 { loty = ty_pay(loty) }
        mut hity := er_ty(hir)
        if ty_tag(hity) == 16 or ty_tag(hity) == 22 { hity = ty_pay(hity) }
        mut common_ty := ty_int()
        if vty == ty_dec() or loty == ty_dec() or hity == ty_dec() { common_ty = ty_dec() }
        else if vty == ty_float() or loty == ty_float() or hity == ty_float() { common_ty = ty_float() }
        mut eff_v := er_slot(vr)
        mut eff_lo := er_slot(lor)
        mut eff_hi := er_slot(hir)
        if common_ty == ty_float() {
            if vty != ty_float() {
                eff_v = cg_alloc_slots(cg, 1)
                mc_load_rax(c, er_slot(vr), 0)
                mc_b4(c, 0xF2, 0x48, 0x0F, 0x2A); mc_b1(c, 0xC0)
                mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
                mc_store_rax(c, eff_v, 0)
            }
            if loty != ty_float() {
                eff_lo = cg_alloc_slots(cg, 1)
                mc_load_rax(c, er_slot(lor), 0)
                mc_b4(c, 0xF2, 0x48, 0x0F, 0x2A); mc_b1(c, 0xC0)
                mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
                mc_store_rax(c, eff_lo, 0)
            }
            if hity != ty_float() {
                eff_hi = cg_alloc_slots(cg, 1)
                mc_load_rax(c, er_slot(hir), 0)
                mc_b4(c, 0xF2, 0x48, 0x0F, 0x2A); mc_b1(c, 0xC0)
                mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
                mc_store_rax(c, eff_hi, 0)
            }
        }
        c1 := emit_scalar_binop_ax(cg, op_gte(), eff_v, 0, eff_lo, 0, common_ty)
        c2 := emit_scalar_binop_ax(cg, op_lt(), eff_v, 0, eff_hi, 0, common_ty)
        dst := cg_alloc_slots(cg, 1)
        mc_load_rax(c, c1, 0)
        mc_load_rcx(c, c2, 0)
        mc_b3(c, 0x48, 0x21, 0xC8)
        if is_not != 0 {
            mc_b4(c, 0x48, 0x83, 0xF0, 0x01)
        }
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_bool())
    }
    if k == nk_or_return() {
        lr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 1))
        lslot := er_slot(lr)
        lty := er_ty(lr)
        rv_nid := ast_get(cg.nodes, enid, 2)
        if ty_tag(lty) == 13 {
            ok_ty := ty_pay(lty)
            ok_slots := type_slots(cg.sym, ok_ty)
            dst := cg_alloc_slots(cg, ok_slots)
            mc_load_rax(c, lslot, 0)
            mc_b3(c, 0x48, 0x85, 0xC0)
            jz_ok := mc_jcc32(c, 0x84)
            if rv_nid > 0 {
                rvr := emit_expr_ax(cg, vars, drops, breaks, rv_nid)
                emit_return_from_slot_ax(cg, vars, drops, er_slot(rvr), er_ty(rvr))
            } else {
                emit_return_from_slot_ax(cg, vars, drops, lslot, ibuf_get(cg.state, 7))
            }
            mc_patch_rel32(c, jz_ok, buf_len(c))
            mut s := 0
            while s < ok_slots {
                mc_load_rax(c, lslot, 1 + s)
                mc_store_rax(c, dst, s)
                s += 1
            }
            return er_pack(dst, ok_ty)
        }
        return lr
    }
    if k == nk_cast() {
        ir := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 1))
        islot := er_slot(ir)
        ity := er_ty(ir)
        ibuf_set(cg.sym, 13, ast_get(cg.nodes, enid, 2))
        target_ty := resolve_typespec(cg.pool, cg.nodes, cg.extra, cg.sym)
        dst := cg_alloc_slots(cg, 1)
        mc_load_rax(c, islot, 0)
        if ity == ty_int() and target_ty == ty_float() {
            mc_b4(c, 0xF2, 0x48, 0x0F, 0x2A)
            mc_b1(c, 0xC0)
            mc_b4(c, 0x66, 0x48, 0x0F, 0x7E)
            mc_b1(c, 0xC0)
        } else if ity == ty_float() and target_ty == ty_int() {
            mc_b4(c, 0x66, 0x48, 0x0F, 0x6E)
            mc_b1(c, 0xC0)
            mc_b4(c, 0xF2, 0x48, 0x0F, 0x2C)
            mc_b1(c, 0xC0)
        }
        mc_store_rax(c, dst, 0)
        return er_pack(dst, target_ty)
    }
    if k == nk_field() {
        br := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 1))
        bslot := er_slot(br)
        bty := er_ty(br)
        fsoff := ast_get(cg.nodes, enid, 2)
        fslen := ast_get(cg.nodes, enid, 3)
        if pool_str_eq_lit(cg.pool, fsoff, fslen, "len") {
            if ty_tag(bty) == 5 or ty_tag(bty) == 12 {
                dst := cg_alloc_slots(cg, 1)
                mc_load_rax(c, bslot, 1)
                mc_store_rax(c, dst, 0)
                return er_pack(dst, ty_int())
            }
            if ty_tag(bty) == 21 {
                dst := cg_alloc_slots(cg, 1)
                mc_load_rdx(c, bslot, 1)
                mc_b3(c, 0x48, 0x89, 0xD0); mc_b1(c, 0x25); mc_u32(c, 0xFFFFF)
                mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE9, 0x14); mc_b2(c, 0x81, 0xE1); mc_u32(c, 0xFFFFF)
                mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
                mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE9, 0x28); mc_b2(c, 0x81, 0xE1); mc_u32(c, 0xFFFFF)
                mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
                mc_store_rax(c, dst, 0)
                return er_pack(dst, ty_int())
            }
        }
        if bty == ty_vec3() or bty == ty_vec4() or bty == ty_quat() {
            dst := cg_alloc_slots(cg, 1)
            if pool_str_eq_lit(cg.pool, fsoff, fslen, "x") {
                mc_load_rax(c, bslot, 0)
            } else if pool_str_eq_lit(cg.pool, fsoff, fslen, "y") {
                mc_load_rax(c, bslot, 0)
                mc_b4(c, 0x48, 0xC1, 0xE8, 0x20)
            } else if pool_str_eq_lit(cg.pool, fsoff, fslen, "z") {
                mc_load_rax(c, bslot, 1)
            } else {
                mc_load_rax(c, bslot, 1)
                mc_b4(c, 0x48, 0xC1, 0xE8, 0x20)
            }
            mc_b4(c, 0x66, 0x0F, 0x6E, 0xC0)
            mc_b4(c, 0xF3, 0x0F, 0x5A, 0xC0)
            mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
            mc_store_rax(c, dst, 0)
            return er_pack(dst, ty_float())
        }
        if ty_tag(bty) == 10 {
            fo := find_struct_field(cg.pool, cg.sym, ty_pay(bty), fsoff | (fslen << 32))
            if fo >= 0 {
                f_off := ibuf_get(cg.sym, fo + 2)
                f_ty := ibuf_get(cg.sym, fo + 3)
                return er_pack(bslot + f_off, f_ty)
            }
        }
        return er_pack(bslot, ty_int())
    }
    if k == nk_tuple_idx() {
        br := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 1))
        bslot := er_slot(br)
        bty := er_ty(br)
        idx := ast_get(cg.nodes, enid, 2)
        if ty_tag(bty) == 14 {
            doff := ty_pay(bty)
            cnt := ibuf_get(cg.sym, doff)
            mut off := 0
            mut i := 0
            while i < cnt {
                et := ibuf_get(cg.sym, doff + 1 + i)
                ecnt := type_slots(cg.sym, et)
                if i == idx {
                    return er_pack(bslot + off, et)
                }
                off += ecnt
                i += 1
            }
        }
        return er_pack(bslot, ty_int())
    }
    if k == nk_index() {
        tr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 1))
        idx_nid := ast_get(cg.nodes, enid, 2)
        ir := emit_expr_ax(cg, vars, drops, breaks, idx_nid)
        tslot := er_slot(tr)
        tty := er_ty(tr)
        islot := er_slot(ir)
        dst := cg_alloc_slots(cg, 1)
        if tty == ty_intbuf() {
            mc_load_r8(c, tslot, 0)
            mc_b3(c, 0x4D, 0x85, 0xC0)
            cg_jmp_fn(cg, 0x84, h_sec_trap())
            mc_load_rcx(c, islot, 0)
            mc_b3(c, 0x49, 0x3B, 0x08)
            cg_jmp_fn(cg, 0x83, h_sec_trap())
            mc_b4(c, 0x49, 0x8B, 0x44, 0xC8); mc_b1(c, 0x10)
            mc_store_rax(c, dst, 0)
            return er_pack(dst, ty_int())
        }
        if tty == ty_bytebuf() {
            mc_load_r8(c, tslot, 0)
            mc_b3(c, 0x4D, 0x85, 0xC0)
            cg_jmp_fn(cg, 0x84, h_sec_trap())
            mc_load_rcx(c, islot, 0)
            mc_b3(c, 0x49, 0x3B, 0x08)
            cg_jmp_fn(cg, 0x83, h_sec_trap())
            mc_b4(c, 0x41, 0x0F, 0xB6, 0x44); mc_b2(c, 0x08, 0x10)
            mc_store_rax(c, dst, 0)
            return er_pack(dst, ty_int())
        }
        if ty_tag(tty) == 21 {
            mc_load_rdx(c, tslot, 1)
            mc_b3(c, 0x48, 0x89, 0xD0); mc_b1(c, 0x25); mc_u32(c, 0xFFFFF)
            mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE9, 0x14); mc_b2(c, 0x81, 0xE1); mc_u32(c, 0xFFFFF)
            mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
            mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE9, 0x28); mc_b2(c, 0x81, 0xE1); mc_u32(c, 0xFFFFF)
            mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1) // RAX = numel
            mc_load_rcx(c, islot, 0)
            mc_b3(c, 0x48, 0x39, 0xC1)
            cg_jmp_fn(cg, 0x83, h_sec_trap())
            mc_load_r8(c, tslot, 0)
            mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b2(c, 0x04, 0x88)
            mc_b4(c, 0xF3, 0x0F, 0x5A, 0xC0)
            mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
            mc_store_rax(c, dst, 0)
            return er_pack(dst, ty_float())
        }
        emit_bounds_check_ax(cg, islot, tslot, idx_nid)
        mc_load_r8(c, tslot, 0)
        mc_load_rcx(c, islot, 0)
        if ty_tag(tty) == 12 and ty_pay(tty) == 60001 {
            mc_b4(c, 0xF3, 0x41, 0x0F, 0x10)
            mc_b2(c, 0x04, 0x88)
            mc_b4(c, 0xF3, 0x0F, 0x5A, 0xC0)
            mc_b4(c, 0x66, 0x48, 0x0F, 0x7E)
            mc_b1(c, 0xC0)
            mc_store_rax(c, dst, 0)
            return er_pack(dst, ty_float())
        }
        mc_b4(c, 0x49, 0x8B, 0x04, 0xC8)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }
    if k == nk_table_alloc() {
        esoff := ast_get(cg.nodes, enid, 1)
        eslen := ast_get(cg.nodes, enid, 2)
        cr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 3))
        cslot := er_slot(cr)
        mut col_cnt := 1
        mut elem_bytes := 4
        mut t_pay := 60001
        if pool_str_eq_lit(cg.pool, esoff, eslen, "i64") or pool_str_eq_lit(cg.pool, esoff, eslen, "usize") or pool_str_eq_lit(cg.pool, esoff, eslen, "f64") {
            elem_bytes = 8
            t_pay = 60002
        } else if not pool_str_eq_lit(cg.pool, esoff, eslen, "f32") {
            sidx := find_struct_idx(cg.pool, cg.sym, esoff, eslen)
            if sidx >= 0 {
                t_pay = sidx
                col_cnt = soa_active_col_count(cg.sym, sidx)
            }
        }
        mut stride := col_cnt * elem_bytes
        if stride < 4 { stride = 4 }
        max_tbl_cnt := (1073741824 - 256) / stride
        mc_load_rax(c, cslot, 0)
        mc_b2(c, 0x48, 0xBA)
        mc_u64(c, max_tbl_cnt)
        mc_b3(c, 0x48, 0x39, 0xD0)
        cg_jmp_fn(cg, 0x87, h_sec_trap())
        mc_b3(c, 0x48, 0x69, 0xD0)
        mc_u32(c, stride)
        mc_b3(c, 0x48, 0x81, 0xC2)
        mc_u32(c, 256)
        emit_alloc_raw_rax(cg)
        dst := cg_alloc_slots(cg, 2)
        mc_store_rax(c, dst, 0)
        mc_load_rax(c, cslot, 0)
        mc_store_rax(c, dst, 1)
        return er_pack(dst, ty_make(12, t_pay))
    }
    if k == nk_method_call() {
        return emit_method_call_ax(cg, vars, drops, breaks, enid)
    }
    if k == nk_if_expr() {
        jz_else := emit_cond_jump_false_ax(cg, vars, drops, breaks, ast_get(cg.nodes, enid, 1))
        tb := ast_get(cg.nodes, enid, 2)
        emit_block_ax(cg, vars, drops, breaks, tb)
        tr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, tb, 3))
        tslot := er_slot(tr)
        tty := er_ty(tr)
        rslots := type_slots(cg.sym, tty)
        dst := cg_alloc_slots(cg, rslots)
        mut s := 0
        while s < rslots {
            mc_load_rax(c, tslot, s)
            mc_store_rax(c, dst, s)
            s += 1
        }
        jmp_end := mc_jmp32(c)
        mc_patch_rel32(c, jz_else, buf_len(c))
        eb := ast_get(cg.nodes, enid, 3)
        if eb > 0 {
            emit_block_ax(cg, vars, drops, breaks, eb)
            er := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, eb, 3))
            eslot := er_slot(er)
            s = 0
            while s < rslots {
                mc_load_rax(c, eslot, s)
                mc_store_rax(c, dst, s)
                s += 1
            }
        }
        mc_patch_rel32(c, jmp_end, buf_len(c))
        return er_pack(dst, tty)
    }
    if k == nk_unsafe_block() {
        blk := ast_get(cg.nodes, enid, 1)
        emit_block_ax(cg, vars, drops, breaks, blk)
        tail_e := ast_get(cg.nodes, blk, 3)
        if tail_e > 0 {
            return emit_expr_ax(cg, vars, drops, breaks, tail_e)
        }
        zs_u := cg_alloc_slots(cg, 1)
        mc_mov_rax_imm(c, 0)
        mc_store_rax(c, zs_u, 0)
        return er_pack(zs_u, ty_unit())
    }
    if k == nk_spawn() {
        blk := ast_get(cg.nodes, enid, 1)
        b_off := ast_get(cg.nodes, blk, 1)
        b_cnt := ast_get(cg.nodes, blk, 2)
        mut res_slot := cg_alloc_slots(cg, 1)
        mut res_ty := ty_int()
        mc_mov_rax_imm(c, 0)
        mc_store_rax(c, res_slot, 0)
        mut i := 0
        while i < b_cnt {
            st := ibuf_get(cg.extra, b_off + i)
            if ast_kind(cg.nodes, st) == nk_return() {
                rv := ast_get(cg.nodes, st, 1)
                if rv > 0 {
                    rr := emit_expr_ax(cg, vars, drops, breaks, rv)
                    res_slot = er_slot(rr)
                    res_ty = er_ty(rr)
                }
                break
            } else {
                emit_stmt_ax(cg, vars, drops, breaks, st)
            }
            i += 1
        }
        return er_pack(res_slot, ty_make(15, res_ty))
    }

    zs := cg_alloc_slots(cg, 1)
    mc_mov_rax_imm(c, 0)
    mc_store_rax(c, zs, 0)
    return er_pack(zs, ty_int())
}

// 3-Tier Runtime CPUID Dispatch SoA Loop Emitter (`for p in table`):
//   Tier 2 (`g_simd_tier == 2`): Hardware 512-bit `AVX-512F EVEX` (`ZMM0..ZMM2`, 64 bytes / 16 floats per inst!)
//   Tier 1 (`g_simd_tier == 1`): Hardware 256-bit `AVX2 + FMA3` (`YMM`, 4x-unrolled 128B + 32B loop)
//   Tier 0 (`g_simd_tier == 0`) + Exact Remainder Tail: Pure `SSE2` (`MOVSS`/`MULSS`/`ADDSS`, 0 VEX/EVEX bytes!)
fn emit_soa_simd_foreach_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, fe_nid: i64) {
    tr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, fe_nid, 3))
    tbl_slot := er_slot(tr)
    plan_off := ast_get(cg.nodes, fe_nid, 5)
    if plan_off <= 0 {
        return
    }
    c := cg.code
    ops_cnt := ibuf_get(cg.extra, plan_off + 1)
    mut oi := 0
    while oi < ops_cnt {
        obase := plan_off + 2 + oi * 4
        okind := ibuf_get(cg.extra, obase)
        dst_col := ibuf_get(cg.extra, obase + 1)
        src_col := ibuf_get(cg.extra, obase + 2)
        scale_e := ibuf_get(cg.extra, obase + 3)

        mut scale_slot := 0
        if scale_e > 0 {
            sr := emit_expr_ax(cg, vars, drops, breaks, scale_e)
            scale_slot = er_slot(sr)
        }

        is_fma := okind == 1 or okind == 3 or okind == 4 or okind == 5
        mc_b2(c, 0x56, 0x57) // PUSH RSI; PUSH RDI
        if scale_slot > 0 {
            mc_load_rax(c, scale_slot, 0)
            mc_b4(c, 0x66, 0x48, 0x0F, 0x6E); mc_b1(c, 0xC0)
            mc_b4(c, 0xF2, 0x0F, 0x5A, 0xC0) // XMM0.x = scale_f32 (pure SSE2!)
            if okind == 4 {
                mc_b4(c, 0x66, 0x0F, 0x7E, 0xC0) // MOVD EAX, XMM0
                mc_b1(c, 0x35); mc_u32(c, 0x80000000) // XOR EAX, signbit
                mc_b4(c, 0x66, 0x0F, 0x6E, 0xC0) // MOVD XMM0, EAX
            }
        } else {
            if okind == 5 {
                mc_b1(c, 0xB8); mc_u32(c, 0xBF800000) // -1.0f32
            } else {
                mc_b1(c, 0xB8); mc_u32(c, 0x3F800000) // +1.0f32
            }
            mc_b4(c, 0x66, 0x0F, 0x6E, 0xC0)
        }

        mc_load_r8(c, tbl_slot, 0)
        mc_load_rcx(c, tbl_slot, 1)
        mc_b4(c, 0x48, 0xC1, 0xE1, 0x02) // RCX = total_bytes (cap * 4)

        if is_fma {
            mc_b3(c, 0x48, 0x89, 0xC8)
            mc_b3(c, 0x48, 0x69, 0xC0); mc_u32(c, src_col)
            mc_b3(c, 0x4C, 0x01, 0xC0)
            mc_b3(c, 0x48, 0x89, 0xC6) // RSI = src_col_ptr
        }

        mc_b3(c, 0x48, 0x89, 0xC8)
        mc_b3(c, 0x48, 0x69, 0xC0); mc_u32(c, dst_col)
        mc_b3(c, 0x4C, 0x01, 0xC0)
        mc_b3(c, 0x48, 0x89, 0xC7) // RDI = dst_col_ptr

        mc_b3(c, 0x48, 0x85, 0xC9)
        jz_done := mc_jcc32(c, 0x84)

        // Load runtime CPUID `g_simd_tier` (`0=Scalar SSE2`, `1=AVX2+FMA3`, `2=AVX-512F`) into `R9`
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x49, 0x89, 0xC1)
        mc_b2(c, 0x31, 0xC0) // RAX = 0 (byte cursor)

        // --- Tier 2: AVX-512F 512-bit EVEX (`ZMM0..ZMM2`, 64 bytes = 16 floats/iter) ---
        mc_b4(c, 0x49, 0x83, 0xF9, 0x02)
        jne_avx2 := mc_jcc32(c, 0x85)
        // `VBROADCASTSS ZMM0, XMM0` (`62 F2 7D 48 18 C0`)
        mc_b4(c, 0x62, 0xF2, 0x7D, 0x48); mc_b2(c, 0x18, 0xC0)
        z512_top := buf_len(c)
        mc_b4(c, 0x48, 0x8D, 0x50, 0x40) // LEA RDX, [RAX + 64]
        mc_b3(c, 0x48, 0x39, 0xCA)       // CMP RDX, RCX
        ja_z512_done := mc_jcc8(c, 0x77)
        // `VMOVUPS ZMM2, [RDI + RAX]` (`62 F1 7C 48 10 14 07`)
        mc_b4(c, 0x62, 0xF1, 0x7C, 0x48); mc_b3(c, 0x10, 0x14, 0x07)
        if is_fma {
            // `VMOVUPS ZMM1, [RSI + RAX]` (`62 F1 7C 48 10 0C 06`)
            mc_b4(c, 0x62, 0xF1, 0x7C, 0x48); mc_b3(c, 0x10, 0x0C, 0x06)
            // `VFMADD231PS ZMM2, ZMM1, ZMM0` (`62 F2 75 48 B8 D0`)
            mc_b4(c, 0x62, 0xF2, 0x75, 0x48); mc_b2(c, 0xB8, 0xD0)
        } else {
            // `VMULPS ZMM2, ZMM2, ZMM0` (`62 F1 6C 48 59 D0`, EVEX.P1 bit2 must be 1!)
            mc_b4(c, 0x62, 0xF1, 0x6C, 0x48); mc_b2(c, 0x59, 0xD0)
        }
        // `VMOVUPS [RDI + RAX], ZMM2` (`62 F1 7C 48 11 14 07`)
        mc_b4(c, 0x62, 0xF1, 0x7C, 0x48); mc_b3(c, 0x11, 0x14, 0x07)
        mc_b4(c, 0x48, 0x83, 0xC0, 0x40) // ADD RAX, 64
        jmp_z512 := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_z512, z512_top)
        mc_patch_jcc8(c, ja_z512_done, buf_len(c))
        mc_b3(c, 0xC5, 0xF8, 0x77) // VZEROUPPER
        jmp_to_scalar := mc_jmp32(c)

        // --- Tier 1: AVX2 + FMA3 (`YMM0..YMM4`, 128B 4x-Unrolled + 32B Loop) ---
        mc_patch_rel32(c, jne_avx2, buf_len(c))
        mc_b4(c, 0x49, 0x83, 0xF9, 0x01)
        jb_scalar := mc_jcc32(c, 0x82)

        mc_b4(c, 0xC4, 0xE2, 0x7D, 0x18); mc_b1(c, 0xC0) // VBROADCASTSS YMM0, XMM0
        if is_fma {
            u4_top := buf_len(c)
            mc_b3(c, 0x48, 0x8D, 0x90); mc_u32(c, 128) // LEA RDX, [RAX + 128]
            mc_b3(c, 0x48, 0x39, 0xCA)
            ja_tail32 := mc_jcc32(c, 0x87)

            mc_b4(c, 0xC5, 0xFC, 0x10, 0x0C); mc_b1(c, 0x06)
            mc_b4(c, 0xC5, 0xFC, 0x10, 0x14); mc_b1(c, 0x07)
            mc_b4(c, 0xC5, 0xFC, 0x10, 0x5C); mc_b2(c, 0x06, 0x20)
            mc_b4(c, 0xC5, 0xFC, 0x10, 0x64); mc_b2(c, 0x07, 0x20)
            mc_b4(c, 0xC4, 0xE2, 0x75, 0xB8); mc_b1(c, 0xD0)
            mc_b4(c, 0xC4, 0xE2, 0x65, 0xB8); mc_b1(c, 0xE0)
            mc_b4(c, 0xC5, 0xFC, 0x11, 0x14); mc_b1(c, 0x07)
            mc_b4(c, 0xC5, 0xFC, 0x11, 0x64); mc_b2(c, 0x07, 0x20)

            mc_b4(c, 0xC5, 0xFC, 0x10, 0x4C); mc_b2(c, 0x06, 0x40)
            mc_b4(c, 0xC5, 0xFC, 0x10, 0x54); mc_b2(c, 0x07, 0x40)
            mc_b4(c, 0xC5, 0xFC, 0x10, 0x5C); mc_b2(c, 0x06, 0x60)
            mc_b4(c, 0xC5, 0xFC, 0x10, 0x64); mc_b2(c, 0x07, 0x60)
            mc_b4(c, 0xC4, 0xE2, 0x75, 0xB8); mc_b1(c, 0xD0)
            mc_b4(c, 0xC4, 0xE2, 0x65, 0xB8); mc_b1(c, 0xE0)
            mc_b4(c, 0xC5, 0xFC, 0x11, 0x54); mc_b2(c, 0x07, 0x40)
            mc_b4(c, 0xC5, 0xFC, 0x11, 0x64); mc_b2(c, 0x07, 0x60)

            mc_b2(c, 0x48, 0x05); mc_u32(c, 128)
            jmp_u4 := mc_jmp32(c)
            mc_patch_rel32(c, jmp_u4, u4_top)

            mc_patch_rel32(c, ja_tail32, buf_len(c))
            simd_top := buf_len(c)
            mc_b4(c, 0x48, 0x8D, 0x50, 0x20)
            mc_b3(c, 0x48, 0x39, 0xCA)
            ja_avxd := mc_jcc8(c, 0x77)
            mc_b4(c, 0xC5, 0xFC, 0x10, 0x0C); mc_b1(c, 0x06)
            mc_b4(c, 0xC5, 0xFC, 0x10, 0x14); mc_b1(c, 0x07)
            mc_b4(c, 0xC4, 0xE2, 0x75, 0xB8); mc_b1(c, 0xD0)
            mc_b4(c, 0xC5, 0xFC, 0x11, 0x14); mc_b1(c, 0x07)
            mc_b4(c, 0x48, 0x83, 0xC0, 0x20)
            jb_top := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, jb_top, simd_top)
            mc_patch_jcc8(c, ja_avxd, buf_len(c))
        } else {
            simd_top := buf_len(c)
            mc_b4(c, 0x48, 0x8D, 0x50, 0x20)
            mc_b3(c, 0x48, 0x39, 0xCA)
            ja_avxd2 := mc_jcc8(c, 0x77)
            mc_b4(c, 0xC5, 0xFC, 0x10, 0x14); mc_b1(c, 0x07)
            mc_b4(c, 0xC5, 0xEC, 0x59, 0xD0)
            mc_b4(c, 0xC5, 0xFC, 0x11, 0x14); mc_b1(c, 0x07)
            mc_b4(c, 0x48, 0x83, 0xC0, 0x20)
            jb_top2 := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, jb_top2, simd_top)
            mc_patch_jcc8(c, ja_avxd2, buf_len(c))
        }
        mc_b3(c, 0xC5, 0xF8, 0x77) // VZEROUPPER

        // --- Tier 0 & Exact Tail: Pure SSE2 4-byte Scalar Loop (`while RAX < RCX`) ---
        mc_patch_rel32(c, jmp_to_scalar, buf_len(c))
        mc_patch_rel32(c, jb_scalar, buf_len(c))
        sc_top := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC8)
        jae_sc_done := mc_jcc8(c, 0x73)
        mc_b4(c, 0xF3, 0x0F, 0x10, 0x14); mc_b1(c, 0x07) // MOVSS XMM2, [RDI+RAX]
        if is_fma {
            mc_b4(c, 0xF3, 0x0F, 0x10, 0x0C); mc_b1(c, 0x06) // MOVSS XMM1, [RSI+RAX]
            mc_b4(c, 0xF3, 0x0F, 0x59, 0xC8)                 // MULSS XMM1, XMM0
            mc_b4(c, 0xF3, 0x0F, 0x58, 0xD1)                 // ADDSS XMM2, XMM1
        } else {
            mc_b4(c, 0xF3, 0x0F, 0x59, 0xD0)                 // MULSS XMM2, XMM0
        }
        mc_b4(c, 0xF3, 0x0F, 0x11, 0x14); mc_b1(c, 0x07) // MOVSS [RDI+RAX], XMM2
        mc_b4(c, 0x48, 0x83, 0xC0, 0x04)
        jmp_sc := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_sc, sc_top)
        mc_patch_jcc8(c, jae_sc_done, buf_len(c))

        mc_patch_rel32(c, jz_done, buf_len(c))
        mc_b2(c, 0x5F, 0x5E) // POP RDI; POP RSI
        oi += 1
    }
}

// Multi-Core OS-Thread Pool `par_for p in table` Emitter (`CreateThread` + `WaitForMultipleObjects` + `h_par_soa_worker`)!
fn emit_par_soa_foreach_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, fe_nid: i64) {
    plan_off := ast_get(cg.nodes, fe_nid, 5)
    if plan_off <= 0 or not cg_is_win64(cg) {
        emit_soa_simd_foreach_ax(cg, vars, drops, breaks, fe_nid)
        return
    }
    c := cg.code
    // Check `g_cpu_threads > 1` at runtime; if 1 core, run single-thread SIMD directly
    cg_mov_rax_data(cg, data_off_cpu_threads())
    mc_b4(c, 0x48, 0x83, 0xF8, 0x01)
    jle_single1 := mc_jcc32(c, 0x8E)

    tr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, fe_nid, 3))
    tbl_slot := er_slot(tr)
    mc_load_rax(c, tbl_slot, 1)
    mc_b2(c, 0x48, 0x3D); mc_u32(c, 4096)
    jb_single2 := mc_jcc32(c, 0x82)

    h_arr := cg_alloc_slots(cg, 16)
    h_lowest := h_arr + 15
    nt_slot := cg_alloc_slots(cg, 1)
    chunk_slot := cg_alloc_slots(cg, 1)
    tid_slot := cg_alloc_slots(cg, 1)

    cg_mov_rax_data(cg, data_off_cpu_threads())
    mc_store_rax(c, nt_slot, 0)
    mc_b3(c, 0x48, 0x89, 0xC1)
    mc_load_rax(c, tbl_slot, 1)
    mc_b2(c, 0x48, 0x99)
    mc_b3(c, 0x48, 0xF7, 0xF9) // RAX = N / T
    mc_store_rax(c, chunk_slot, 0)

    ops_cnt := ibuf_get(cg.extra, plan_off + 1)
    mut oi := 0
    while oi < ops_cnt {
        obase := plan_off + 2 + oi * 4
        okind := ibuf_get(cg.extra, obase)
        dst_col := ibuf_get(cg.extra, obase + 1)
        src_col := ibuf_get(cg.extra, obase + 2)
        scale_e := ibuf_get(cg.extra, obase + 3)

        mut scale_slot := 0
        if scale_e > 0 {
            sr := emit_expr_ax(cg, vars, drops, breaks, scale_e)
            scale_slot = er_slot(sr)
        }

        // Populate `.data + 0x40` (`src_col_ptr`, `dst_col_ptr`, `scale_f32`, `op_kind`, `[start, end] * T`)
        cg_lea_rax_data(cg, 0)
        mc_b3(c, 0x49, 0x89, 0xC2) // R10 = .data base

        mc_load_r8(c, tbl_slot, 0)
        mc_load_rcx(c, tbl_slot, 1)
        mc_b4(c, 0x48, 0xC1, 0xE1, 0x02) // RCX = N * 4
        mc_b3(c, 0x48, 0x89, 0xC8)
        mc_b3(c, 0x48, 0x69, 0xC0); mc_u32(c, src_col)
        mc_b3(c, 0x4C, 0x01, 0xC0)
        mc_b4(c, 0x49, 0x89, 0x42, 0x40) // [R10 + 0x40] = src_col_ptr

        mc_b3(c, 0x48, 0x89, 0xC8)
        mc_b3(c, 0x48, 0x69, 0xC0); mc_u32(c, dst_col)
        mc_b3(c, 0x4C, 0x01, 0xC0)
        mc_b4(c, 0x49, 0x89, 0x42, 0x48) // [R10 + 0x48] = dst_col_ptr

        if scale_slot > 0 {
            mc_f64_slot_to_f32_eax(c, scale_slot)
            if okind == 4 {
                mc_b1(c, 0x35); mc_u32(c, 0x80000000)
            }
        } else {
            if okind == 5 {
                mc_b1(c, 0xB8); mc_u32(c, 0xBF800000)
            } else {
                mc_b1(c, 0xB8); mc_u32(c, 0x3F800000)
            }
        }
        mc_b3(c, 0x48, 0x89, 0xC1) // RCX = scale_f32_bits
        cg_lea_rax_data(cg, 0)
        mc_b4(c, 0x48, 0x89, 0x48, 0x50) // [.data + 0x50] = scale_f32_bits
        mut eff_okind := okind
        if okind == 4 or okind == 5 { eff_okind = 1 }
        mc_mov_rax_imm(c, eff_okind)
        mc_b3(c, 0x48, 0x89, 0xC1)
        cg_lea_rax_data(cg, 0)
        mc_b4(c, 0x48, 0x89, 0x48, 0x58) // [.data + 0x58] = okind

        // Spawn `tid = 0 .. T - 1` OS threads
        mc_mov_rax_imm(c, 0); mc_store_rax(c, tid_slot, 0)
        sp_top := buf_len(c)
        mc_load_rax(c, tid_slot, 0)
        mc_cmp_rax_slot(c, nt_slot, 0)
        jge_sp_done := mc_jcc32(c, 0x8D)

        // Compute `start = tid * chunk`, `end = (tid + 1 == T) ? N : (tid + 1) * chunk`
        mc_load_rax(c, tid_slot, 0)
        mc_load_rcx(c, chunk_slot, 0)
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1) // RAX = start
        mc_b3(c, 0x49, 0x89, 0xC0)       // R8  = start
        mc_b3(c, 0x48, 0x01, 0xC8)       // RAX = start + chunk
        mc_b3(c, 0x49, 0x89, 0xC1)       // R9  = end
        mc_load_rax(c, tid_slot, 0)
        mc_b3(c, 0x48, 0xFF, 0xC0)
        mc_cmp_rax_slot(c, nt_slot, 0)
        jne_not_last := mc_jcc8(c, 0x75)
        mc_load_r9(c, tbl_slot, 1)       // last thread takes exact `N`
        mc_patch_jcc8(c, jne_not_last, buf_len(c))

        cg_lea_rax_data(cg, 0x60)
        mc_load_rcx(c, tid_slot, 0)
        mc_b4(c, 0x48, 0xC1, 0xE1, 0x04) // tid * 16
        mc_b3(c, 0x48, 0x01, 0xC8)
        mc_b3(c, 0x4C, 0x89, 0x00)       // [ctx + tid*16] = start
        mc_b4(c, 0x4C, 0x89, 0x48, 0x08) // [ctx + tid*16 + 8] = end

        // `CreateThread(NULL, 0, h_par_soa_worker, tid, 0, NULL)`
        mc_b4(c, 0x48, 0x83, 0xEC, 0x30)
        mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 0x20); mc_u32(c, 0)
        mc_b4(c, 0x48, 0xC7, 0x44, 0x24); mc_b1(c, 0x28); mc_u32(c, 0)
        cg_lea_rax_fn(cg, h_par_soa_worker())
        mc_b3(c, 0x49, 0x89, 0xC0)       // R8 = lpStartAddress
        mc_load_r9(c, tid_slot, 0)       // R9 = tid
        mc_b2(c, 0x31, 0xC9)             // RCX = NULL
        mc_b2(c, 0x31, 0xD2)             // RDX = 0
        cg_call_iat(cg, iat_create_thread())
        mc_b4(c, 0x48, 0x83, 0xC4, 0x30)

        mc_b3(c, 0x49, 0x89, 0xC0) // R8 = thread_handle
        mc_lea_rax(c, h_lowest, 0)
        mc_load_rcx(c, tid_slot, 0)
        mc_b4(c, 0x4C, 0x89, 0x04, 0xC8) // handles[tid] = handle

        mc_load_rax(c, tid_slot, 0); mc_b3(c, 0x48, 0xFF, 0xC0); mc_store_rax(c, tid_slot, 0)
        jmp_sp := mc_jmp32(c); mc_patch_rel32(c, jmp_sp, sp_top)
        mc_patch_rel32(c, jge_sp_done, buf_len(c))

        // `WaitForMultipleObjects(T, &handles[0], TRUE, INFINITE)`
        mc_lea_rax(c, h_lowest, 0)
        mc_b3(c, 0x48, 0x89, 0xC2) // RDX = lpHandles
        mc_load_rcx(c, nt_slot, 0) // ECX = nCount
        mc_b3(c, 0x41, 0xB8, 0x01); mc_b3(c, 0x00, 0x00, 0x00) // R8D = 1 (TRUE)
        mc_b2(c, 0x41, 0xB9); mc_u32(c, 0xFFFFFFFF)            // R9D = INFINITE
        mc_b4(c, 0x48, 0x83, 0xEC, 0x20)
        cg_call_iat(cg, iat_wait_multiple())
        mc_b4(c, 0x48, 0x83, 0xC4, 0x20)

        // Close all `T` thread handles
        mc_mov_rax_imm(c, 0); mc_store_rax(c, tid_slot, 0)
        cl_top := buf_len(c)
        mc_load_rax(c, tid_slot, 0)
        mc_cmp_rax_slot(c, nt_slot, 0)
        jge_cl_done := mc_jcc8(c, 0x7D)
        mc_lea_rax(c, h_lowest, 0)
        mc_load_rcx(c, tid_slot, 0)
        mc_b4(c, 0x48, 0x8B, 0x0C, 0xC8)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x20)
        cg_call_iat(cg, iat_close_handle())
        mc_b4(c, 0x48, 0x83, 0xC4, 0x20)
        mc_load_rax(c, tid_slot, 0); mc_b3(c, 0x48, 0xFF, 0xC0); mc_store_rax(c, tid_slot, 0)
        jmp_cl := mc_jcc8(c, 0xEB); mc_patch_jcc8(c, jmp_cl, cl_top)
        mc_patch_jcc8(c, jge_cl_done, buf_len(c))

        oi += 1
    }
    jmp_par_end := mc_jmp32(c)

    mc_patch_rel32(c, jle_single1, buf_len(c))
    mc_patch_rel32(c, jb_single2, buf_len(c))
    emit_soa_simd_foreach_ax(cg, vars, drops, breaks, fe_nid)
    mc_patch_rel32(c, jmp_par_end, buf_len(c))
}

// Polyhedral Register-Tiled (`YMM1..YMM8` = 64 floats / 256B per tile) Temporal AVX2 FMA3 Engine.
fn emit_temporal_tiled_simd_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, while_nid: i64, fe_nid: i64) {
    plan_off := ast_get(cg.nodes, fe_nid, 5)
    if plan_off <= 0 {
        return
    }
    cond := ast_get(cg.nodes, while_nid, 1)
    s_id := ast_get(cg.nodes, cond, 2)
    steps_e := ast_get(cg.nodes, cond, 3)
    svb := cg_var_find(cg.pool, vars, ast_get(cg.nodes, s_id, 1), ast_get(cg.nodes, s_id, 2))
    if svb < 0 {
        return
    }
    s_slot := ibuf_get(vars, svb + 2)
    c := cg.code

    steps_r := emit_expr_ax(cg, vars, drops, breaks, steps_e)
    steps_slot := er_slot(steps_r)
    trip_slot := cg_alloc_slots(cg, 1)

    mc_load_rax(c, steps_slot, 0)
    mc_load_rcx(c, s_slot, 0)
    mc_b3(c, 0x48, 0x29, 0xC8)
    mc_b3(c, 0x48, 0x85, 0xC0)
    jle_skip := mc_jcc32(c, 0x8E)
    mc_store_rax(c, trip_slot, 0)

    tr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, fe_nid, 3))
    tbl_slot := er_slot(tr)

    ops_cnt := ibuf_get(cg.extra, plan_off + 1)
    mut oi := 0
    while oi < ops_cnt {
        obase := plan_off + 2 + oi * 4
        dst_col := ibuf_get(cg.extra, obase + 1)
        src_col := ibuf_get(cg.extra, obase + 2)
        scale_e := ibuf_get(cg.extra, obase + 3)

        mut scale_slot := 0
        if scale_e > 0 {
            sr := emit_expr_ax(cg, vars, drops, breaks, scale_e)
            scale_slot = er_slot(sr)
        }

        mc_b2(c, 0x56, 0x57)
        mc_b4(c, 0x48, 0x83, 0xEC, 0x30)
        mc_b4(c, 0xC5, 0xFA, 0x7F, 0x34); mc_b1(c, 0x24)
        mc_b4(c, 0xC5, 0xFA, 0x7F, 0x7C); mc_b2(c, 0x24, 0x10)
        mc_b4(c, 0xC5, 0x7A, 0x7F, 0x44); mc_b2(c, 0x24, 0x20)

        if scale_slot > 0 {
            mc_load_rax(c, scale_slot, 0)
            mc_b4(c, 0x66, 0x48, 0x0F, 0x6E); mc_b1(c, 0xC0)
            mc_b4(c, 0xF2, 0x0F, 0x5A, 0xC0)
        } else {
            mc_b1(c, 0xB8); mc_u32(c, 0x3F800000)
            mc_b4(c, 0x66, 0x0F, 0x6E, 0xC0)
        }
        mc_b4(c, 0xC4, 0xE2, 0x7D, 0x18); mc_b1(c, 0xC0)

        mc_load_rax(c, trip_slot, 0)
        mc_b3(c, 0x49, 0x89, 0xC2)

        mc_load_rax(c, tbl_slot, 0)
        mc_b3(c, 0x49, 0x89, 0xC3)
        mc_load_rcx(c, tbl_slot, 1)
        mc_b4(c, 0x48, 0xC1, 0xE1, 0x02)

        mc_b3(c, 0x48, 0x89, 0xC8)
        mc_b3(c, 0x48, 0x69, 0xC0); mc_u32(c, src_col)
        mc_b3(c, 0x4C, 0x01, 0xD8)
        mc_b3(c, 0x49, 0x89, 0xC0)

        mc_b3(c, 0x48, 0x89, 0xC8)
        mc_b3(c, 0x48, 0x69, 0xC0); mc_u32(c, dst_col)
        mc_b3(c, 0x4C, 0x01, 0xD8)
        mc_b3(c, 0x49, 0x89, 0xC1)

        mc_b2(c, 0x31, 0xC0)
        mc_b3(c, 0x48, 0x85, 0xC9)
        jz_op_done := mc_jcc32(c, 0x84)

        tile256_top := buf_len(c)
        mc_b3(c, 0x48, 0x8D, 0x90); mc_u32(c, 256)
        mc_b3(c, 0x48, 0x39, 0xCA)
        ja_tail32 := mc_jcc32(c, 0x87)

        mc_b3(c, 0x4C, 0x89, 0xC6)
        mc_b3(c, 0x48, 0x01, 0xC6)
        mc_b3(c, 0x48, 0x8D, 0x96); mc_u32(c, 128)
        mc_b3(c, 0x4C, 0x89, 0xCF)
        mc_b3(c, 0x48, 0x01, 0xC7)

        mc_b4(c, 0xC5, 0xFC, 0x10, 0x0F)
        mc_b4(c, 0xC5, 0xFC, 0x10, 0x57); mc_b1(c, 0x20)
        mc_b4(c, 0xC5, 0xFC, 0x10, 0x5F); mc_b1(c, 0x40)
        mc_b4(c, 0xC5, 0xFC, 0x10, 0x67); mc_b1(c, 0x60)
        mc_b4(c, 0xC5, 0xFC, 0x10, 0xAF); mc_u32(c, 128)
        mc_b4(c, 0xC5, 0xFC, 0x10, 0xB7); mc_u32(c, 160)
        mc_b4(c, 0xC5, 0xFC, 0x10, 0xBF); mc_u32(c, 192)
        mc_b4(c, 0xC5, 0x7C, 0x10, 0x87); mc_u32(c, 224)

        mc_b3(c, 0x4D, 0x89, 0xD3)
        step_top := buf_len(c)
        mc_b4(c, 0xC4, 0xE2, 0x7D, 0xB8); mc_b1(c, 0x0E)
        mc_b4(c, 0xC4, 0xE2, 0x7D, 0xB8); mc_b2(c, 0x56, 0x20)
        mc_b4(c, 0xC4, 0xE2, 0x7D, 0xB8); mc_b2(c, 0x5E, 0x40)
        mc_b4(c, 0xC4, 0xE2, 0x7D, 0xB8); mc_b2(c, 0x66, 0x60)
        mc_b4(c, 0xC4, 0xE2, 0x7D, 0xB8); mc_b1(c, 0x2A)
        mc_b4(c, 0xC4, 0xE2, 0x7D, 0xB8); mc_b2(c, 0x72, 0x20)
        mc_b4(c, 0xC4, 0xE2, 0x7D, 0xB8); mc_b2(c, 0x7A, 0x40)
        mc_b4(c, 0xC4, 0x62, 0x7D, 0xB8); mc_b2(c, 0x42, 0x60)
        mc_b3(c, 0x49, 0xFF, 0xCB)
        jnz_step := mc_jcc8(c, 0x75)
        mc_patch_jcc8(c, jnz_step, step_top)

        mc_b4(c, 0xC5, 0xFC, 0x11, 0x0F)
        mc_b4(c, 0xC5, 0xFC, 0x11, 0x57); mc_b1(c, 0x20)
        mc_b4(c, 0xC5, 0xFC, 0x11, 0x5F); mc_b1(c, 0x40)
        mc_b4(c, 0xC5, 0xFC, 0x11, 0x67); mc_b1(c, 0x60)
        mc_b4(c, 0xC5, 0xFC, 0x11, 0xAF); mc_u32(c, 128)
        mc_b4(c, 0xC5, 0xFC, 0x11, 0xB7); mc_u32(c, 160)
        mc_b4(c, 0xC5, 0xFC, 0x11, 0xBF); mc_u32(c, 192)
        mc_b4(c, 0xC5, 0x7C, 0x11, 0x87); mc_u32(c, 224)

        mc_b2(c, 0x48, 0x05); mc_u32(c, 256)
        jmp_t256 := mc_jmp32(c)
        mc_patch_rel32(c, jmp_t256, tile256_top)

        mc_patch_rel32(c, ja_tail32, buf_len(c))
        tail32_top := buf_len(c)
        mc_b4(c, 0x48, 0x8D, 0x50, 0x20)
        mc_b3(c, 0x48, 0x39, 0xCA)
        ja_tail4 := mc_jcc8(c, 0x77)
        mc_b3(c, 0x4C, 0x89, 0xC6)
        mc_b3(c, 0x48, 0x01, 0xC6)
        mc_b3(c, 0x4C, 0x89, 0xCF)
        mc_b3(c, 0x48, 0x01, 0xC7)
        mc_b4(c, 0xC5, 0xFC, 0x10, 0x0F)
        mc_b3(c, 0x4D, 0x89, 0xD3)
        t32_step := buf_len(c)
        mc_b4(c, 0xC4, 0xE2, 0x7D, 0xB8); mc_b1(c, 0x0E)
        mc_b3(c, 0x49, 0xFF, 0xCB)
        jnz_t32 := mc_jcc8(c, 0x75)
        mc_patch_jcc8(c, jnz_t32, t32_step)
        mc_b4(c, 0xC5, 0xFC, 0x11, 0x0F)
        mc_b4(c, 0x48, 0x83, 0xC0, 0x20)
        jmp_t32 := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_t32, tail32_top)

        mc_patch_jcc8(c, ja_tail4, buf_len(c))
        tail4_top := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC8)
        jae_done := mc_jcc8(c, 0x73)
        mc_b3(c, 0x4C, 0x89, 0xC6)
        mc_b3(c, 0x48, 0x01, 0xC6)
        mc_b3(c, 0x4C, 0x89, 0xCF)
        mc_b3(c, 0x48, 0x01, 0xC7)
        mc_b4(c, 0xC5, 0xFA, 0x10, 0x0E)
        mc_b4(c, 0xC5, 0xFA, 0x10, 0x17)
        mc_b3(c, 0x4D, 0x89, 0xD3)
        t4_step := buf_len(c)
        mc_b4(c, 0xC4, 0xE2, 0x79, 0xB9); mc_b1(c, 0xD1)
        mc_b3(c, 0x49, 0xFF, 0xCB)
        jnz_t4 := mc_jcc8(c, 0x75)
        mc_patch_jcc8(c, jnz_t4, t4_step)
        mc_b4(c, 0xC5, 0xFA, 0x11, 0x17)
        mc_b4(c, 0x48, 0x83, 0xC0, 0x04)
        jmp_t4 := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_t4, tail4_top)

        mc_patch_jcc8(c, jae_done, buf_len(c))
        mc_patch_rel32(c, jz_op_done, buf_len(c))

        mc_b4(c, 0xC5, 0xFA, 0x6F, 0x34); mc_b1(c, 0x24)
        mc_b4(c, 0xC5, 0xFA, 0x6F, 0x7C); mc_b2(c, 0x24, 0x10)
        mc_b4(c, 0xC5, 0x7A, 0x6F, 0x44); mc_b2(c, 0x24, 0x20)
        mc_b4(c, 0x48, 0x83, 0xC4, 0x30)
        mc_b3(c, 0xC5, 0xF8, 0x77)
        mc_b2(c, 0x5F, 0x5E)
        oi += 1
    }

    mc_load_rax(c, steps_slot, 0)
    mc_store_rax(c, s_slot, 0)
    mc_patch_rel32(c, jle_skip, buf_len(c))
}

fn emit_stmt_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, snid: i64) {
    c := cg.code
    k := ast_kind(cg.nodes, snid)

    if k == nk_comptime_block() {
        return
    }
    if k == nk_unsafe_block() {
        emit_block_ax(cg, vars, drops, breaks, ast_get(cg.nodes, snid, 1))
        return
    }

    if k == nk_var_decl() {
        vsoff := ast_get(cg.nodes, snid, 1)
        vslen := ast_get(cg.nodes, snid, 2)
        ty_nid := ast_get(cg.nodes, snid, 4)
        init_e := ast_get(cg.nodes, snid, 5)
        ptag := ast_get(cg.nodes, snid, 6)
        donor_nid := ptag >> 2
        need_drop := ptag & 1

        // Perceus Linear FBIP & Loop Self-FBIP (`donor_nid == snid`) Zero-Syscall In-Place Reuse
        if donor_nid > 0 {
            mut donor_slot := 0
            mut self_reuse := false
            if donor_nid == snid {
                self_reuse = true
            } else {
                dvb := cg_var_find_by_nid(vars, donor_nid)
                if dvb >= 0 {
                    donor_slot = ibuf_get(vars, dvb + 2)
                }
            }
            if self_reuse or donor_slot > 0 {
                ik := ast_kind(cg.nodes, init_e)
                if ik == nk_call() {
                    cs := ast_get(cg.nodes, init_e, 1)
                    cl := ast_get(cg.nodes, init_e, 2)
                    aoff := ast_get(cg.nodes, init_e, 3)
                    acnt := ast_get(cg.nodes, init_e, 4)
                    if (pool_str_eq_lit(cg.pool, cs, cl, "buf_new") or pool_str_eq_lit(cg.pool, cs, cl, "ibuf_new")) and acnt == 1 {
                        cap_e := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
                        mut dst_slot := 0
                        if self_reuse and is_folded_const_int_ax(cg, vars, cap_e) {
                            cap_imm := eval_folded_const_int_ax(cg, vars, cap_e)
                            is_bb := pool_str_eq_lit(cg.pool, cs, cl, "buf_new")
                            // Perceus Escape-Analysis Stack-Buffer Promotion:
                            // `self_reuse` + `need_drop == 1` statically guarantees non-escaping, single-owner lifetime!
                            if need_drop == 1 and ((not is_bb and cap_imm >= 1 and cap_imm <= 32) or (is_bb and cap_imm >= 1 and cap_imm <= 128)) {
                                mut data_slots := cap_imm
                                if is_bb { data_slots = (cap_imm + 7) / 8 }
                                total_buf_slots := 2 + data_slots
                                low_slot := ibuf_get(cg.state, 14) + total_buf_slots
                                dst_slot = low_slot + 1
                                ibuf_set(cg.state, 14, dst_slot)
                                if dst_slot > ibuf_get(cg.state, 4) { ibuf_set(cg.state, 4, dst_slot) }
                                // LEA RAX, [RBP - low_slot*8]; [RAX]=0 (len); [RAX+8]=cap_imm (cap); [dst_slot]=RAX
                                mc_b3(c, 0x48, 0x8D, 0x85); mc_u32(c, 0 - low_slot * 8)
                                mc_b3(c, 0x48, 0xC7, 0x00); mc_u32(c, 0)
                                mc_b4(c, 0x48, 0xC7, 0x40, 0x08); mc_u32(c, cap_imm)
                                mc_store_rax(c, dst_slot, 0)
                                mut bty := ty_intbuf()
                                if is_bb { bty = ty_bytebuf() }
                                ibuf_push(vars, vsoff); ibuf_push(vars, vslen); ibuf_push(vars, dst_slot); ibuf_push(vars, bty); ibuf_push(vars, snid)
                                // Stack-allocated: zero heap alloc, zero free, zero drop entry!
                                return
                            }
                            if cap_imm >= 0 and cap_imm <= 0x7FFFFFFF {
                                // Allocate a fresh high-water slot guaranteed zero-initialized by the prologue!
                                max_s := ibuf_get(cg.state, 14) + 1
                                ibuf_set(cg.state, 14, max_s)
                                if max_s > ibuf_get(cg.state, 4) { ibuf_set(cg.state, 4, max_s) }
                                dst_slot = max_s
                                mc_load_r8(c, dst_slot, 0)
                                mc_b3(c, 0x4D, 0x85, 0xC0)
                                jz_slow := mc_jcc32(c, 0x84)
                                if cap_imm <= 127 {
                                    mc_b4(c, 0x49, 0x83, 0x78, 0x08); mc_b1(c, cap_imm) // CMP QWORD PTR [R8+8], imm8
                                } else {
                                    mc_b4(c, 0x49, 0x81, 0x78, 0x08); mc_u32(c, cap_imm) // CMP QWORD PTR [R8+8], imm32
                                }
                                jb_free := mc_jcc32(c, 0x82)
                                mc_b3(c, 0x49, 0xC7, 0x00); mc_u32(c, 0) // MOV QWORD PTR [R8], 0
                                jmp_done := mc_jmp32(c)

                                mc_patch_rel32(c, jb_free, buf_len(c))
                                mc_b2(c, 0x31, 0xC0)
                                mc_store_rax(c, dst_slot, 0)
                                mc_b3(c, 0x4C, 0x89, 0xC1)
                                emit_free_raw_rcx(cg)

                                mc_patch_rel32(c, jz_slow, buf_len(c))
                                fr := emit_expr_ax(cg, vars, drops, breaks, init_e)
                                mc_load_rax(c, er_slot(fr), 0)
                                mc_store_rax(c, dst_slot, 0)
                                mc_patch_rel32(c, jmp_done, buf_len(c))

                                mut bty := ty_intbuf()
                                if pool_str_eq_lit(cg.pool, cs, cl, "buf_new") { bty = ty_bytebuf() }
                                ibuf_push(vars, vsoff); ibuf_push(vars, vslen); ibuf_push(vars, dst_slot); ibuf_push(vars, bty); ibuf_push(vars, snid)
                                if need_drop == 1 { ibuf_push(drops, dst_slot) }
                                return
                            }
                        }
                        cr := emit_expr_ax(cg, vars, drops, breaks, cap_e)
                        cap_slot := er_slot(cr)
                        if self_reuse {
                            max_s := ibuf_get(cg.state, 14) + 1
                            ibuf_set(cg.state, 14, max_s)
                            if max_s > ibuf_get(cg.state, 4) { ibuf_set(cg.state, 4, max_s) }
                            dst_slot = max_s
                            donor_slot = dst_slot
                        } else {
                            dst_slot = cg_alloc_slots(cg, 1)
                        }

                        mc_load_r8(c, donor_slot, 0)
                        mc_mov_rax_imm(c, 0)
                        mc_store_rax(c, donor_slot, 0)

                        mc_load_rcx(c, cap_slot, 0)
                        mc_b3(c, 0x4D, 0x85, 0xC0)
                        jz_slow := mc_jcc32(c, 0x84)
                        mc_b4(c, 0x49, 0x3B, 0x48, 0x08)
                        ja_free := mc_jcc32(c, 0x87)

                        mc_b3(c, 0x49, 0xC7, 0x00)
                        mc_u32(c, 0)
                        mc_b3(c, 0x4C, 0x89, 0xC0)
                        jmp_done := mc_jmp32(c)

                        mc_patch_rel32(c, ja_free, buf_len(c))
                        mc_b3(c, 0x4C, 0x89, 0xC1)
                        emit_free_raw_rcx(cg)

                        mc_patch_rel32(c, jz_slow, buf_len(c))
                        fr := emit_expr_ax(cg, vars, drops, breaks, init_e)
                        mc_load_rax(c, er_slot(fr), 0)

                        mc_patch_rel32(c, jmp_done, buf_len(c))
                        mc_store_rax(c, dst_slot, 0)

                        mut bty := ty_intbuf()
                        if pool_str_eq_lit(cg.pool, cs, cl, "buf_new") { bty = ty_bytebuf() }
                        ibuf_push(vars, vsoff)
                        ibuf_push(vars, vslen)
                        ibuf_push(vars, dst_slot)
                        ibuf_push(vars, bty)
                        ibuf_push(vars, snid)
                        if need_drop == 1 {
                            ibuf_push(drops, dst_slot)
                        }
                        return
                    }
                } else if ik == nk_table_alloc() {
                    cr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, init_e, 3))
                    cap_slot := er_slot(cr)
                    dst_slot := cg_alloc_slots(cg, 2)
                    if self_reuse {
                        donor_slot = dst_slot
                    }

                    mc_load_r8(c, donor_slot, 0)
                    mc_load_r9(c, donor_slot, 1)
                    mc_mov_rax_imm(c, 0)
                    mc_store_rax(c, donor_slot, 0)

                    mc_load_rcx(c, cap_slot, 0)
                    mc_b3(c, 0x4D, 0x85, 0xC0)
                    jz_slow := mc_jcc32(c, 0x84)
                    mc_b3(c, 0x4C, 0x39, 0xC9)
                    ja_free := mc_jcc32(c, 0x87)

                    mc_b3(c, 0x4C, 0x89, 0xC0)
                    jmp_done := mc_jmp32(c)

                    mc_patch_rel32(c, ja_free, buf_len(c))
                    mc_b3(c, 0x4C, 0x89, 0xC1)
                    emit_free_raw_rcx(cg)

                    mc_patch_rel32(c, jz_slow, buf_len(c))
                    fr := emit_expr_ax(cg, vars, drops, breaks, init_e)
                    mc_load_rax(c, er_slot(fr), 0)

                    mc_patch_rel32(c, jmp_done, buf_len(c))
                    mc_store_rax(c, dst_slot, 0)
                    mc_load_rax(c, cap_slot, 0)
                    mc_store_rax(c, dst_slot, 1)

                    tty := er_ty(fr)
                    ibuf_push(vars, vsoff)
                    ibuf_push(vars, vslen)
                    ibuf_push(vars, dst_slot)
                    ibuf_push(vars, tty)
                    ibuf_push(vars, snid)
                    if need_drop == 1 {
                        ibuf_push(drops, dst_slot)
                    }
                    return
                }
            }
        }

        saved_slot := ibuf_get(cg.state, 4)
        saved_drops := ibuf_len(drops)
        if need_drop == 0 {
            pure_vty := pure_i64_ty_ax(cg, vars, init_e)
            if pure_vty != 0 {
                mut decl_ty := pure_vty
                if ty_nid > 0 {
                    ibuf_set(cg.sym, 13, ty_nid)
                    decl_ty = resolve_typespec(cg.pool, cg.nodes, cg.extra, cg.sym)
                }
                if decl_ty == pure_vty {
                    dst_slot := cg_alloc_slots(cg, 1)
                    pr_d := find_promo_reg_by_name(cg, vsoff, vslen)
                    mut emitted_direct := false
                    if pr_d > 0 and (decl_ty == ty_int() or decl_ty == ty_bool()) {
                        pr_s := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, init_e))
                        if pr_s > 0 {
                            cg_set_gpr_slot(cg, pr_d, dst_slot)
                            if pr_d != pr_s {
                                mc_b3(c, 0x48 | (gpreg_hi(pr_s) << 2) | gpreg_hi(pr_d), 0x89, 0xC0 | (gpreg_hw(pr_s) << 3) | gpreg_hw(pr_d))
                            }
                            emitted_direct = true
                        } else if decl_ty == ty_int() and is_folded_const_int_ax(cg, vars, init_e) {
                            cg_set_gpr_slot(cg, pr_d, dst_slot)
                            mc_mov_gpreg_imm(c, pr_d, eval_folded_const_int_ax(cg, vars, init_e))
                            emitted_direct = true
                        } else if ast_kind(cg.nodes, init_e) == nk_call() and ast_get(cg.nodes, init_e, 4) == 2 and pool_str_eq_lit(cg.pool, ast_get(cg.nodes, init_e, 1), ast_get(cg.nodes, init_e, 2), "ptr_read_i64") {
                            ra := ast_get(cg.nodes, init_e, 3)
                            pe0 := ast_get(cg.nodes, ibuf_get(cg.extra, ra), 4)
                            pe1 := ast_get(cg.nodes, ibuf_get(cg.extra, ra + 1), 4)
                            psl := local_scalar_slot_ax(cg, vars, pe0)
                            isl := local_scalar_slot_ax(cg, vars, pe1)
                            pr_p := cg_slot_reg(cg, psl)
                            pr_i := cg_slot_reg(cg, isl)
                            d_hw := gpreg_hw(pr_d); d_hi := gpreg_hi(pr_d)
                            if pr_p > 0 and pr_i > 0 {
                                cg_set_gpr_slot(cg, pr_d, dst_slot)
                                b_hw := gpreg_hw(pr_p); b_hi := gpreg_hi(pr_p)
                                x_hw := gpreg_hw(pr_i); x_hi := gpreg_hi(pr_i)
                                mut disp := 0
                                uoff := ibuf_get(cg.state, 24)
                                if uoff > 0 and isl == ibuf_get(cg.state, cg_fpromo_base(cg) + 122) { disp = uoff * 8 }
                                mut modrm := 0x04 | (d_hw << 3)
                                if b_hw == 5 or disp != 0 { modrm = 0x44 | (d_hw << 3) }
                                mc_b4(c, 0x48 | (d_hi << 2) | (x_hi << 1) | b_hi, 0x8B, modrm, 0xC0 | (x_hw << 3) | b_hw)
                                if b_hw == 5 or disp != 0 { mc_b1(c, disp & 255) }
                                emitted_direct = true
                            } else if pr_p > 0 and is_nonshadowed_const_int(cg, vars, pe1) and eval_const_int_val(cg.pool, cg.nodes, cg.sym, pe1) == 0 {
                                cg_set_gpr_slot(cg, pr_d, dst_slot)
                                b_hw := gpreg_hw(pr_p); b_hi := gpreg_hi(pr_p)
                                if b_hw == 4 { mc_b4(c, 0x48 | (d_hi << 2) | b_hi, 0x8B, 0x04 | (d_hw << 3), 0x24) }
                                else if b_hw == 5 { mc_b4(c, 0x48 | (d_hi << 2) | b_hi, 0x8B, 0x45 | (d_hw << 3), 0x00) }
                                else { mc_b3(c, 0x48 | (d_hi << 2) | b_hi, 0x8B, (d_hw << 3) | b_hw) }
                                emitted_direct = true
                            } else if psl > 0 and pr_p == 0 and pr_i == 0 and (ibuf_get(cg.state, 24) == 0 or isl != ibuf_get(cg.state, cg_fpromo_base(cg) + 122)) {
                                emit_int_expr_to_rax(cg, vars, drops, breaks, pe1)
                                cg_set_gpr_slot(cg, pr_d, dst_slot)
                                mc_load_rcx(c, psl, 0)
                                mc_b4(c, 0x48 | (d_hi << 2), 0x8B, 0x04 | (d_hw << 3), 0xC1) // MOV pr_d, [RCX + RAX*8]
                                emitted_direct = true
                            }
                        } else if ast_kind(cg.nodes, init_e) == nk_call() and ast_get(cg.nodes, init_e, 4) == 2 and pool_str_eq_lit(cg.pool, ast_get(cg.nodes, init_e, 1), ast_get(cg.nodes, init_e, 2), "ushr64") and ibuf_get(cg.state, 0) == 0 {
                            ua := ast_get(cg.nodes, init_e, 3)
                            ue0 := ast_get(cg.nodes, ibuf_get(cg.extra, ua), 4)
                            ue1 := ast_get(cg.nodes, ibuf_get(cg.extra, ua + 1), 4)
                            if is_folded_const_int_ax(cg, vars, ue1) and ast_kind(cg.nodes, ue0) == nk_binary() {
                                sh := eval_folded_const_int_ax(cg, vars, ue1) & 63
                                uop := ast_get(cg.nodes, ue0, 1)
                                ul := ast_get(cg.nodes, ue0, 2); ur := ast_get(cg.nodes, ue0, 3)
                                if sh > 0 and (uop == op_add() or uop == op_sub() or uop == op_wrap_add() or uop == op_wrap_sub()) and is_folded_const_int_ax(cg, vars, ur) {
                                    mut uimm := eval_folded_const_int_ax(cg, vars, ur)
                                    if uop == op_sub() or uop == op_wrap_sub() { uimm = 0 - uimm }
                                    pr_x := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, ul))
                                    if pr_x > 0 and uimm >= -128 and uimm <= 127 {
                                        cg_set_gpr_slot(cg, pr_d, dst_slot)
                                        d_hw := gpreg_hw(pr_d); d_hi := gpreg_hi(pr_d)
                                        xhw := gpreg_hw(pr_x); xhi := gpreg_hi(pr_x)
                                        if xhw == 4 {
                                            mc_b4(c, 0x48 | (d_hi << 2) | xhi, 0x8D, 0x44 | (d_hw << 3), 0x24)
                                            mc_b1(c, uimm & 255)
                                        } else {
                                            mc_b4(c, 0x48 | (d_hi << 2) | xhi, 0x8D, 0x40 | (d_hw << 3) | xhw, uimm & 255)
                                        }
                                        if sh == 1 { mc_b3(c, 0x48 | d_hi, 0xD1, 0xE8 | d_hw) }
                                        else       { mc_b4(c, 0x48 | d_hi, 0xC1, 0xE8 | d_hw, sh) }
                                        emitted_direct = true
                                    }
                                }
                            }
                        } else if ast_kind(cg.nodes, init_e) == nk_binary() and ibuf_get(cg.state, 0) == 0 {
                            bop := ast_get(cg.nodes, init_e, 1)
                            bl := ast_get(cg.nodes, init_e, 2); br := ast_get(cg.nodes, init_e, 3)
                            if (bop == op_add() or bop == op_wrap_add()) and is_folded_const_int_ax(cg, vars, br) {
                                bimm := eval_folded_const_int_ax(cg, vars, br)
                                if bimm >= -128 and bimm <= 127 {
                                    pr_l := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, bl))
                                    if pr_l > 0 {
                                        cg_set_gpr_slot(cg, pr_d, dst_slot)
                                        d_hw := gpreg_hw(pr_d); d_hi := gpreg_hi(pr_d)
                                        l_hw := gpreg_hw(pr_l); l_hi := gpreg_hi(pr_l)
                                        if l_hw == 4 {
                                            mc_b4(c, 0x48 | (d_hi << 2) | l_hi, 0x8D, 0x44 | (d_hw << 3), 0x24)
                                            mc_b1(c, bimm & 255)
                                        } else {
                                            mc_b4(c, 0x48 | (d_hi << 2) | l_hi, 0x8D, 0x40 | (d_hw << 3) | l_hw, bimm & 255)
                                        }
                                        emitted_direct = true
                                    } else if ast_kind(cg.nodes, bl) == nk_binary() and (ast_get(cg.nodes, bl, 1) == op_mul() or ast_get(cg.nodes, bl, 1) == op_wrap_mul()) and is_folded_const_int_ax(cg, vars, ast_get(cg.nodes, bl, 3)) and eval_folded_const_int_ax(cg, vars, ast_get(cg.nodes, bl, 3)) == 2 {
                                        pr_x := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, bl, 2)))
                                        if pr_x > 0 and gpreg_hw(pr_x) != 4 {
                                            cg_set_gpr_slot(cg, pr_d, dst_slot)
                                            d_hw := gpreg_hw(pr_d); d_hi := gpreg_hi(pr_d)
                                            xhw := gpreg_hw(pr_x); xhi := gpreg_hi(pr_x)
                                            if xhw == 5 {
                                                mc_b4(c, 0x48 | (d_hi << 2) | (xhi << 1) | xhi, 0x8D, 0x44 | (d_hw << 3), (xhw << 3) | xhw)
                                                mc_b1(c, bimm & 255)
                                            } else if bimm != 0 {
                                                // Fast 2-comp `LEA RDX, [pr_x+pr_x]` (1 cyc) + `LEA pr_d, [RDX+imm8]` (1 cyc), leaving `RDX = 2*pr_x`!
                                                mc_b4(c, 0x48 | (xhi << 1) | xhi, 0x8D, 0x14, (xhw << 3) | xhw)
                                                mc_b4(c, 0x48 | (d_hi << 2), 0x8D, 0x42 | (d_hw << 3), bimm & 255)
                                            } else {
                                                mc_b4(c, 0x48 | (d_hi << 2) | (xhi << 1) | xhi, 0x8D, 0x04 | (d_hw << 3), (xhw << 3) | xhw)
                                            }
                                            emitted_direct = true
                                        }
                                    }
                                }
                            } else if (bop == op_mul() or bop == op_wrap_mul()) and is_folded_const_int_ax(cg, vars, br) {
                                m_imm := eval_folded_const_int_ax(cg, vars, br)
                                mut msh := 0
                                if m_imm == 2 { msh = 1 } else if m_imm == 4 { msh = 2 } else if m_imm == 8 { msh = 3 } else if m_imm == 16 { msh = 4 }
                                if msh > 0 {
                                    pr_l := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, bl))
                                    if pr_l > 0 {
                                        cg_set_gpr_slot(cg, pr_d, dst_slot)
                                        if pr_d != pr_l {
                                            mc_b3(c, 0x48 | (gpreg_hi(pr_l) << 2) | gpreg_hi(pr_d), 0x89, 0xC0 | (gpreg_hw(pr_l) << 3) | gpreg_hw(pr_d))
                                        }
                                        if msh == 1 { mc_b3(c, 0x48 | gpreg_hi(pr_d), 0xD1, 0xE0 | gpreg_hw(pr_d)) }
                                        else        { mc_b4(c, 0x48 | gpreg_hi(pr_d), 0xC1, 0xE0 | gpreg_hw(pr_d), msh) }
                                        emitted_direct = true
                                    }
                                }
                            }
                        }
                    }
                    if not emitted_direct {
                        emit_int_expr_to_rax(cg, vars, drops, breaks, init_e)
                        if ibuf_len(drops) == saved_drops {
                            ibuf_set(cg.state, 4, saved_slot)
                            dst_slot_r := cg_alloc_slots(cg, 1)
                            if dst_slot_r != dst_slot {
                                ibuf_set(cg.state, 4, dst_slot)
                            }
                        }
                        if pr_d > 0 and (decl_ty == ty_int() or decl_ty == ty_bool()) {
                            cg_set_gpr_slot(cg, pr_d, dst_slot)
                            mc_mov_gpreg_rax(c, pr_d)
                        } else {
                            mc_store_rax(c, dst_slot, 0)
                        }
                    }
                    ibuf_push(vars, vsoff)
                    ibuf_push(vars, vslen)
                    ibuf_push(vars, dst_slot)
                    ibuf_push(vars, decl_ty)
                    ibuf_push(vars, snid)
                    return
                }
            }
            if pure_f64_ty_ax(cg, vars, init_e) {
                mut decl_fty := ty_float()
                if ty_nid > 0 {
                    ibuf_set(cg.sym, 13, ty_nid)
                    decl_fty = resolve_typespec(cg.pool, cg.nodes, cg.extra, cg.sym)
                }
                if decl_fty == ty_float() {
                    fr_d := find_promo_freg_by_name(cg, vsoff, vslen)
                    if ibuf_get(cg.state, 25) == 1 and fr_d > 0 {
                        emit_f64_to_hw_vex(cg, vars, init_e, 5 + fr_d)
                        if ibuf_len(drops) == saved_drops { ibuf_set(cg.state, 4, saved_slot) }
                        dst_slot := cg_alloc_slots(cg, 1)
                        cg_set_freg_slot(cg, fr_d, dst_slot)
                        ibuf_push(vars, vsoff); ibuf_push(vars, vslen); ibuf_push(vars, dst_slot); ibuf_push(vars, ty_float()); ibuf_push(vars, snid)
                        return
                    }
                    emit_f64_expr_to_xmm0(cg, vars, init_e)
                    if ibuf_len(drops) == saved_drops {
                        ibuf_set(cg.state, 4, saved_slot)
                    }
                    dst_slot := cg_alloc_slots(cg, 1)
                    if fr_d > 0 {
                        cg_set_freg_slot(cg, fr_d, dst_slot)
                        mc_mov_freg_xmm0(c, fr_d)
                    } else {
                        mc_sse_xmm0_slot(c, 0xF2, 0x11, dst_slot, 0)
                    }
                    if (ibuf_get(cg.state, 18) & fnflag_nan_guard()) != 0 {
                        ibuf_set(cg.state, 20, span_line(ast_span(cg.nodes, snid)))
                        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
                        emit_nan_guard_rax(cg)
                    }
                    ibuf_push(vars, vsoff)
                    ibuf_push(vars, vslen)
                    ibuf_push(vars, dst_slot)
                    ibuf_push(vars, ty_float())
                    ibuf_push(vars, snid)
                    return
                }
            }
        }
        ir := emit_expr_ax(cg, vars, drops, breaks, init_e)
        mut init_slot := er_slot(ir)
        inferred_ty := er_ty(ir)
        mut final_ty := inferred_ty
        if ty_nid > 0 {
            ibuf_set(cg.sym, 13, ty_nid)
            final_ty = resolve_typespec(cg.pool, cg.nodes, cg.extra, cg.sym)
        }
        if ty_tag(final_ty) == 11 and ty_tag(inferred_ty) == 10 {
            p_slots := type_slots(cg.sym, final_ty)
            s_slots := type_slots(cg.sym, inferred_ty)
            packed := cg_alloc_slots(cg, p_slots)
            mc_mov_rax_imm(c, ty_pay(inferred_ty) + 1)
            mc_store_rax(c, packed, 0)
            mut u := 0
            while u < s_slots {
                if 1 + u < p_slots {
                    mc_load_rax(c, init_slot, u)
                    mc_store_rax(c, packed, 1 + u)
                }
                u += 1
            }
            init_slot = packed
        }
        slots := type_slots(cg.sym, final_ty)
        mut dst_slot := 0
        if ibuf_len(drops) == saved_drops {
            dst_slot = saved_slot + 1
            next_s := saved_slot + slots
            ibuf_set(cg.state, 4, next_s)
            if next_s > ibuf_get(cg.state, 14) {
                ibuf_set(cg.state, 14, next_s)
            }
        } else {
            dst_slot = cg_alloc_slots(cg, slots)
        }
        if dst_slot != init_slot {
            mut s := 0
            while s < slots {
                mc_load_rax(c, init_slot, s)
                mc_store_rax(c, dst_slot, s)
                s += 1
            }
        }
        ibuf_push(vars, vsoff)
        ibuf_push(vars, vslen)
        ibuf_push(vars, dst_slot)
        ibuf_push(vars, final_ty)
        ibuf_push(vars, snid)
        if need_drop == 1 {
            ibuf_push(drops, dst_slot)
        } else if ibuf_get(cg.state, 22) == 0 and (final_ty == ty_int() or final_ty == ty_bool()) {
            pr_f := find_promo_reg_by_name(cg, vsoff, vslen)
            if pr_f > 0 {
                cg_set_gpr_slot(cg, pr_f, dst_slot)
                mc_load_gpreg(c, dst_slot, pr_f)
            }
        } else if ibuf_get(cg.state, 22) == 0 and final_ty == ty_float() {
            fr_f := find_promo_freg_by_name(cg, vsoff, vslen)
            if fr_f > 0 {
                cg_set_freg_slot(cg, fr_f, dst_slot)
                mc_load_freg_sd(c, dst_slot, fr_f)
            }
        }
        return
    }

    if k == nk_tuple_destruct() {
        noff := ast_get(cg.nodes, snid, 1)
        ncnt := ast_get(cg.nodes, snid, 2)
        ir := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, snid, 3))
        islot := er_slot(ir)
        ity := er_ty(ir)
        mut cur_off := 0
        mut i := 0
        while i < ncnt {
            ns_off := ibuf_get(cg.extra, noff + i * 2)
            ns_len := ibuf_get(cg.extra, noff + i * 2 + 1)
            mut ety := ty_int()
            if ty_tag(ity) == 14 {
                doff := ty_pay(ity)
                if i < ibuf_get(cg.sym, doff) {
                    ety = ibuf_get(cg.sym, doff + 1 + i)
                }
            } else if ty_tag(ity) == 10 {
                s_off := ibuf_get(cg.sym, 3) + ty_pay(ity) * 6
                f_base := ibuf_get(cg.sym, s_off + 3)
                if i < ibuf_get(cg.sym, s_off + 4) {
                    ety = ibuf_get(cg.sym, f_base + i * 4 + 3)
                }
            }
            eslots := type_slots(cg.sym, ety)
            vslot := cg_alloc_slots(cg, eslots)
            mut s := 0
            while s < eslots {
                mc_load_rax(c, islot, cur_off + s)
                mc_store_rax(c, vslot, s)
                s += 1
            }
            cur_off += eslots
            ibuf_push(vars, ns_off)
            ibuf_push(vars, ns_len)
            ibuf_push(vars, vslot)
            ibuf_push(vars, ety)
            ibuf_push(vars, snid)
            i += 1
        }
        return
    }

    if k == nk_assign() {
        saved_slot := ibuf_get(cg.state, 4)
        saved_drops := ibuf_len(drops)
        aop := ast_get(cg.nodes, snid, 1)
        tgt := ast_get(cg.nodes, snid, 2)
        rhs := ast_get(cg.nodes, snid, 3)
        lv := resolve_lval_ax(cg, vars, tgt)
        if lv != 0 {
            bslot := ushr64(lv, 44)
            sub_off := (ushr64(lv, 32)) & 0xFFF
            lty := lv & 0xFFFFFFFF
            mut pr := 0
            if sub_off == 0 { pr = cg_slot_reg(cg, bslot) }
            if (aop == aop_add() or aop == aop_sub()) and lty == ty_int() and is_folded_const_int_ax(cg, vars, rhs) {
                imm := eval_folded_const_int_ax(cg, vars, rhs)
                if imm >= -2147483647 and imm <= 2147483647 {
                    if pr > 0 {
                        emit_gpreg_addsub_imm(cg, pr, aop == aop_add(), imm)
                    } else {
                        mc_load_rax(c, bslot, sub_off)
                        if imm == 1 {
                            if aop == aop_add() { mc_b3(c, 0x48, 0xFF, 0xC0) }
                            else { mc_b3(c, 0x48, 0xFF, 0xC8) }
                        } else if imm >= -128 and imm <= 127 {
                            if aop == aop_add() { mc_b4(c, 0x48, 0x83, 0xC0, imm & 255) }
                            else { mc_b4(c, 0x48, 0x83, 0xE8, imm & 255) }
                        } else {
                            if aop == aop_add() { mc_b2(c, 0x48, 0x05); mc_u32(c, imm & 0xFFFFFFFF) }
                            else { mc_b2(c, 0x48, 0x2D); mc_u32(c, imm & 0xFFFFFFFF) }
                        }
                        if ibuf_get(cg.state, 0) != 0 {
                            cg_jmp_fn(cg, 0x80, h_sec_trap())
                        }
                        mc_store_rax(c, bslot, sub_off)
                    }
                    return
                }
            }
            if aop == aop_eq() and (lty == ty_int() or lty == ty_bool()) and is_folded_const_int_ax(cg, vars, rhs) {
                imm_v := eval_folded_const_int_ax(cg, vars, rhs)
                if pr > 0 {
                    mc_mov_gpreg_imm(c, pr, imm_v)
                } else {
                    mc_mov_rax_imm(c, imm_v)
                    mc_store_rax(c, bslot, sub_off)
                }
                return
            }
            if aop == aop_eq() and pr > 0 and (lty == ty_int() or lty == ty_bool()) {
                pr_rs := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, rhs))
                if pr_rs > 0 {
                    if pr != pr_rs {
                        mc_b3(c, 0x48 | (gpreg_hi(pr_rs) << 2) | gpreg_hi(pr), 0x89, 0xC0 | (gpreg_hw(pr_rs) << 3) | gpreg_hw(pr))
                    }
                    return
                }
            }
            if (aop == aop_eq() or aop == aop_add() or aop == aop_sub() or aop == aop_mul()) and (lty == ty_int() or lty == ty_bool()) {
                // In-place 1-insn GPR ARX & bitwise ops: `x = x ^ y`, `x = (x + k) & mask`, `x = (x +% y) & 0xFFFFFFFF`, `ROL`
                if aop == aop_eq() and pr > 0 and lty == ty_int() and ast_kind(cg.nodes, rhs) == nk_binary() {
                    rop0 := ast_get(cg.nodes, rhs, 1)
                    rl0 := ast_get(cg.nodes, rhs, 2)
                    rr0 := ast_get(cg.nodes, rhs, 3)
                    if rop0 == op_bit_and() and ibuf_get(cg.state, 0) == 0 and is_folded_const_int_ax(cg, vars, rr0) and rl0 > 0 and ast_kind(cg.nodes, rl0) == nk_binary() and (ast_get(cg.nodes, rl0, 1) == op_add() or ast_get(cg.nodes, rl0, 1) == op_wrap_add()) {
                        m_imm := eval_folded_const_int_ax(cg, vars, rr0)
                        if m_imm >= 0 and m_imm <= 2147483647 and local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, rl0, 2)) == bslot and is_folded_const_int_ax(cg, vars, ast_get(cg.nodes, rl0, 3)) {
                            a_imm := eval_folded_const_int_ax(cg, vars, ast_get(cg.nodes, rl0, 3))
                            if a_imm >= -128 and a_imm <= 127 {
                                mc_b4(c, 0x48 | gpreg_hi(pr), 0x83, 0xC0 | gpreg_hw(pr), a_imm & 255)
                                mc_b3(c, 0x48 | gpreg_hi(pr), 0x81, 0xE0 | gpreg_hw(pr)); mc_u32(c, m_imm)
                                if ibuf_len(drops) == saved_drops { ibuf_set(cg.state, 4, saved_slot) }
                                return
                            }
                        }
                    }
                    if rop0 == op_bit_xor() or rop0 == op_bit_and() or rop0 == op_bit_or() or rop0 == op_wrap_add() {
                        mut yr := 0
                        if local_scalar_slot_ax(cg, vars, rl0) == bslot { yr = cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, rr0)) }
                        else if local_scalar_slot_ax(cg, vars, rr0) == bslot { yr = cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, rl0)) }
                        if yr > 0 {
                            mut opc0 := 0x31
                            if rop0 == op_bit_and() { opc0 = 0x21 }
                            else if rop0 == op_bit_or() { opc0 = 0x09 }
                            else if rop0 == op_wrap_add() { opc0 = 0x01 }
                            mc_b3(c, 0x48 | (gpreg_hi(yr) << 2) | gpreg_hi(pr), opc0, 0xC0 | (gpreg_hw(yr) << 3) | gpreg_hw(pr))
                            if ibuf_len(drops) == saved_drops { ibuf_set(cg.state, 4, saved_slot) }
                            return
                        }
                    }
                    if rop0 == op_bit_and() and is_folded_const_int_ax(cg, vars, rr0) and eval_folded_const_int_ax(cg, vars, rr0) == 0xFFFFFFFF and rl0 > 0 and ast_kind(cg.nodes, rl0) == nk_binary() {
                        iop := ast_get(cg.nodes, rl0, 1)
                        il := ast_get(cg.nodes, rl0, 2)
                        ir := ast_get(cg.nodes, rl0, 3)
                        // `(x +% y) & 0xFFFFFFFF` -> 1-insn `ADD pr32, yr32` (wraps mod 2^32 and zero-extends!)
                        if iop == op_wrap_add() {
                            mut yr := 0
                            if local_scalar_slot_ax(cg, vars, il) == bslot { yr = cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, ir)) }
                            else if local_scalar_slot_ax(cg, vars, ir) == bslot { yr = cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, il)) }
                            if yr > 0 {
                                rex32 := 0x40 | (gpreg_hi(yr) << 2) | gpreg_hi(pr)
                                if rex32 != 0x40 { mc_b1(c, rex32) }
                                mc_b2(c, 0x01, 0xC0 | (gpreg_hw(yr) << 3) | gpreg_hw(pr))
                                if ibuf_len(drops) == saved_drops { ibuf_set(cg.state, 4, saved_slot) }
                                return
                            }
                        }
                        // `((x << k) | ushr64(x, 32-k)) & 0xFFFFFFFF` -> 1-insn hardware `ROL pr32, k`!
                        if iop == op_bit_or() and il > 0 and ir > 0 and ast_kind(cg.nodes, il) == nk_binary() and ast_get(cg.nodes, il, 1) == op_shl() and ast_kind(cg.nodes, ir) == nk_call() and pool_str_eq_lit(cg.pool, ast_get(cg.nodes, ir, 1), ast_get(cg.nodes, ir, 2), "ushr64") and ast_get(cg.nodes, ir, 4) == 2 {
                            sh_x := ast_get(cg.nodes, il, 2)
                            sh_k := ast_get(cg.nodes, il, 3)
                            uaoff := ast_get(cg.nodes, ir, 3)
                            ux := ast_get(cg.nodes, ibuf_get(cg.extra, uaoff), 4)
                            uk := ast_get(cg.nodes, ibuf_get(cg.extra, uaoff + 1), 4)
                            if local_scalar_slot_ax(cg, vars, sh_x) == bslot and local_scalar_slot_ax(cg, vars, ux) == bslot and is_folded_const_int_ax(cg, vars, sh_k) and is_folded_const_int_ax(cg, vars, uk) {
                                kl := eval_folded_const_int_ax(cg, vars, sh_k)
                                kr := eval_folded_const_int_ax(cg, vars, uk)
                                if kl >= 1 and kl <= 31 and kl + kr == 32 {
                                    if gpreg_hi(pr) != 0 { mc_b1(c, 0x41) }
                                    mc_b3(c, 0xC1, 0xC0 | gpreg_hw(pr), kl & 31) // ROL pr32, kl
                                    if ibuf_len(drops) == saved_drops { ibuf_set(cg.state, 4, saved_slot) }
                                    return
                                }
                            }
                        }
                    }
                }
                // In-place `x = ushr64(x, sh) <op> ptr_read_i64(base, idx)` -> 2 insns: `SHR reg, sh; <OP> reg, [base + idx*8]`
                if aop == aop_eq() and pr > 0 and lty == ty_int() and ast_kind(cg.nodes, rhs) == nk_binary() {
                    rop := ast_get(cg.nodes, rhs, 1)
                    mut ropc := 0
                    if rop == op_bit_xor() { ropc = 0x33 }
                    else if rop == op_bit_and() { ropc = 0x23 }
                    else if rop == op_bit_or() { ropc = 0x0B }
                    else if rop == op_wrap_add() or (rop == op_add() and ibuf_get(cg.state, 0) == 0) { ropc = 0x03 }
                    if ropc != 0 {
                        rl := ast_get(cg.nodes, rhs, 2)
                        rr := ast_get(cg.nodes, rhs, 3)
                        mut sh_n := 0
                        mut rd_n := 0
                        if rl > 0 and rr > 0 and ast_kind(cg.nodes, rl) == nk_call() and ast_kind(cg.nodes, rr) == nk_call() {
                            if pool_str_eq_lit(cg.pool, ast_get(cg.nodes, rl, 1), ast_get(cg.nodes, rl, 2), "ushr64") and pool_str_eq_lit(cg.pool, ast_get(cg.nodes, rr, 1), ast_get(cg.nodes, rr, 2), "ptr_read_i64") {
                                sh_n = rl; rd_n = rr
                            } else if pool_str_eq_lit(cg.pool, ast_get(cg.nodes, rr, 1), ast_get(cg.nodes, rr, 2), "ushr64") and pool_str_eq_lit(cg.pool, ast_get(cg.nodes, rl, 1), ast_get(cg.nodes, rl, 2), "ptr_read_i64") {
                                sh_n = rr; rd_n = rl
                            }
                        }
                        if sh_n > 0 and ast_get(cg.nodes, sh_n, 4) == 2 and ast_get(cg.nodes, rd_n, 4) == 2 {
                            saoff := ast_get(cg.nodes, sh_n, 3)
                            se0 := ast_get(cg.nodes, ibuf_get(cg.extra, saoff), 4)
                            se1 := ast_get(cg.nodes, ibuf_get(cg.extra, saoff + 1), 4)
                            raoff := ast_get(cg.nodes, rd_n, 3)
                            re0 := ast_get(cg.nodes, ibuf_get(cg.extra, raoff), 4)
                            re1 := ast_get(cg.nodes, ibuf_get(cg.extra, raoff + 1), 4)
                            if local_scalar_slot_ax(cg, vars, se0) == bslot and is_folded_const_int_ax(cg, vars, se1) {
                                sh_amt := eval_folded_const_int_ax(cg, vars, se1)
                                bsl := local_scalar_slot_ax(cg, vars, re0)
                                isl := local_scalar_slot_ax(cg, vars, re1)
                                br := cg_slot_reg(cg, bsl)
                                ir := cg_slot_reg(cg, isl)
                                iv_ok := ibuf_get(cg.state, 24) == 0 or isl != ibuf_get(cg.state, cg_fpromo_base(cg) + 122)
                                if sh_amt >= 0 and sh_amt <= 63 and br > 0 and ir > 0 and br != pr and ir != pr and iv_ok {
                                    if sh_amt == 1 {
                                        mc_b3(c, 0x48 | gpreg_hi(pr), 0xD1, 0xE8 | gpreg_hw(pr))
                                    } else if sh_amt > 1 {
                                        mc_b4(c, 0x48 | gpreg_hi(pr), 0xC1, 0xE8 | gpreg_hw(pr), sh_amt & 63)
                                    }
                                    rex := 0x48 | (gpreg_hi(pr) << 2) | (gpreg_hi(ir) << 1) | gpreg_hi(br)
                                    b_hw := gpreg_hw(br)
                                    sib := 0xC0 | (gpreg_hw(ir) << 3) | b_hw
                                    if b_hw == 5 {
                                        mc_b4(c, rex, ropc, 0x44 | (gpreg_hw(pr) << 3), sib)
                                        mc_b1(c, 0)
                                    } else {
                                        mc_b4(c, rex, ropc, 0x04 | (gpreg_hw(pr) << 3), sib)
                                    }
                                    if ibuf_len(drops) == saved_drops { ibuf_set(cg.state, 4, saved_slot) }
                                    return
                                }
                            }
                        }
                    }
                }
                pr_rhs := pure_i64_ty_ax(cg, vars, rhs)
                if pr_rhs == lty or (lty == ty_int() and pr_rhs == ty_int()) {
                    emit_int_expr_to_rax(cg, vars, drops, breaks, rhs)
                    if pr > 0 {
                        if aop == aop_eq() {
                            mc_mov_gpreg_rax(c, pr)
                        } else {
                            if aop == aop_add() { mc_b3(c, 0x48 | gpreg_hi(pr), 0x01, 0xC0 | gpreg_hw(pr)) }
                            else if aop == aop_sub() { mc_b3(c, 0x48 | gpreg_hi(pr), 0x29, 0xC0 | gpreg_hw(pr)) }
                            else { mc_b4(c, 0x48 | (gpreg_hi(pr) << 2), 0x0F, 0xAF, 0xC0 | (gpreg_hw(pr) << 3)) }
                            if ibuf_get(cg.state, 0) != 0 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
                        }
                    } else if aop == aop_eq() {
                        mc_store_rax(c, bslot, sub_off)
                    } else {
                        mc_b3(c, 0x48, 0x89, 0xC1) // RCX = rhs
                        mc_load_rax(c, bslot, sub_off)
                        if aop == aop_add() { mc_b3(c, 0x48, 0x01, 0xC8) }
                        else if aop == aop_sub() { mc_b3(c, 0x48, 0x29, 0xC8) }
                        else { mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1) }
                        if ibuf_get(cg.state, 0) != 0 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
                        mc_store_rax(c, bslot, sub_off)
                    }
                    if ibuf_len(drops) == saved_drops { ibuf_set(cg.state, 4, saved_slot) }
                    return
                }
            }
            if lty == ty_float() and (aop == aop_eq() or aop == aop_add() or aop == aop_sub() or aop == aop_mul()) and pure_f64_ty_ax(cg, vars, rhs) {
                mut pfr := 0
                if sub_off == 0 { pfr = cg_slot_freg(cg, bslot) }
                if ibuf_get(cg.state, 25) == 1 and pfr > 0 and aop == aop_eq() {
                    emit_f64_to_hw_vex(cg, vars, rhs, 5 + pfr)
                    if ibuf_len(drops) == saved_drops { ibuf_set(cg.state, 4, saved_slot) }
                    return
                }
                emit_f64_expr_to_xmm0(cg, vars, rhs)
                if pfr > 0 {
                    if aop == aop_eq() {
                        mc_mov_freg_xmm0(c, pfr)
                    } else {
                        mc_b3(c, 0x0F, 0x28, 0xC8) // MOVAPS XMM1, XMM0 (rhs)
                        mc_mov_xmm0_freg(c, pfr)
                        if aop == aop_add() { mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1) }
                        else if aop == aop_sub() { mc_b4(c, 0xF2, 0x0F, 0x5C, 0xC1) }
                        else { mc_b4(c, 0xF2, 0x0F, 0x59, 0xC1) }
                        mc_mov_freg_xmm0(c, pfr)
                    }
                } else if aop == aop_eq() {
                    mc_sse_xmm0_slot(c, 0xF2, 0x11, bslot, sub_off)
                } else {
                    mc_b3(c, 0x0F, 0x28, 0xC8) // MOVAPS XMM1, XMM0 (rhs)
                    mc_sse_xmm0_slot(c, 0xF2, 0x10, bslot, sub_off)
                    if aop == aop_add() { mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1) }
                    else if aop == aop_sub() { mc_b4(c, 0xF2, 0x0F, 0x5C, 0xC1) }
                    else { mc_b4(c, 0xF2, 0x0F, 0x59, 0xC1) }
                    mc_sse_xmm0_slot(c, 0xF2, 0x11, bslot, sub_off)
                }
                if (ibuf_get(cg.state, 18) & fnflag_nan_guard()) != 0 {
                    ibuf_set(cg.state, 20, span_line(ast_span(cg.nodes, snid)))
                    mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
                    emit_nan_guard_rax(cg)
                }
                if ibuf_len(drops) == saved_drops { ibuf_set(cg.state, 4, saved_slot) }
                return
            }
            mut pfr_fb := 0
            if sub_off == 0 { pfr_fb = cg_slot_freg(cg, bslot) }
            if pr > 0 and aop != aop_eq() {
                mc_store_gpreg(c, bslot, pr)
            }
            if pfr_fb > 0 and aop != aop_eq() {
                mc_store_freg_sd(c, bslot, pfr_fb)
            }
            rr := emit_expr_ax(cg, vars, drops, breaks, rhs)
            rslot := er_slot(rr)
            slots := type_slots(cg.sym, lty)
            if aop == aop_eq() {
                mut s := 0
                while s < slots {
                    mc_load_rax(c, rslot, s)
                    mc_store_rax(c, bslot, sub_off + s)
                    s += 1
                }
            } else if lty == ty_int() and (aop == aop_add() or aop == aop_sub() or aop == aop_mul()) {
                mc_load_rax(c, bslot, sub_off)
                mc_load_rcx(c, rslot, 0)
                if aop == aop_add() { mc_b3(c, 0x48, 0x01, 0xC8) }
                else if aop == aop_sub() { mc_b3(c, 0x48, 0x29, 0xC8) }
                else { mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1) }
                if ibuf_get(cg.state, 0) != 0 {
                    cg_jmp_fn(cg, 0x80, h_sec_trap())
                }
                mc_store_rax(c, bslot, sub_off)
            } else {
                mut bop := op_add()
                if aop == aop_sub() { bop = op_sub() }
                else if aop == aop_mul() { bop = op_mul() }
                else if aop == aop_div() { bop = op_div() }
                else if aop == aop_mod() { bop = op_mod() }
                else if aop == aop_pow() { bop = op_pow() }
                ibuf_set(cg.state, 20, span_line(ast_span(cg.nodes, snid)))
                res_s := emit_scalar_binop_ax(cg, bop, bslot, sub_off, rslot, 0, lty)
                mc_load_rax(c, res_s, 0)
                mc_store_rax(c, bslot, sub_off)
            }
            if pr > 0 { mc_load_gpreg(c, bslot, pr) }
            if pfr_fb > 0 { mc_load_freg_sd(c, bslot, pfr_fb) }
            if ibuf_len(drops) == saved_drops {
                ibuf_set(cg.state, 4, saved_slot)
            }
            return
        }
        if ast_kind(cg.nodes, tgt) == nk_index() {
            b_nid := ast_get(cg.nodes, tgt, 1)
            idx_nid := ast_get(cg.nodes, tgt, 2)
            bsl := local_buf_slot_ax(cg, vars, b_nid)
            if aop == aop_eq() and bsl > 0 and pure_i64_ty_ax(cg, vars, idx_nid) == ty_int() and pure_i64_ty_ax(cg, vars, rhs) == ty_int() {
                is_ib := local_buf_ty_ax(cg, vars, b_nid) == ty_intbuf()
                if is_folded_const_int_ax(cg, vars, idx_nid) {
                    idx := eval_folded_const_int_ax(cg, vars, idx_nid)
                    if (is_ib and idx >= 0 and idx <= 13) or (not is_ib and idx >= 0 and idx <= 111) {
                        if is_folded_const_int_ax(cg, vars, rhs) {
                            mc_mov_reg_imm(c, 2, eval_folded_const_int_ax(cg, vars, rhs))
                        } else {
                            emit_int_expr_to_rax(cg, vars, drops, breaks, rhs)
                            mc_b3(c, 0x49, 0x89, 0xC0) // MOV R8, RAX
                        }
                        mc_load_rcx(c, bsl, 0)
                        mc_b3(c, 0x48, 0x85, 0xC9); cg_jmp_fn(cg, 0x84, h_sec_trap())
                        mc_b4(c, 0x48, 0x83, 0x39, idx); cg_jmp_fn(cg, 0x86, h_sec_trap())
                        if is_ib { mc_b4(c, 0x4C, 0x89, 0x41, 16 + idx * 8) }
                        else     { mc_b4(c, 0x44, 0x88, 0x41, 16 + idx) }
                        if ibuf_len(drops) == saved_drops { ibuf_set(cg.state, 4, saved_slot) }
                        return
                    }
                }
                pr_i := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, idx_nid))
                if pr_i > 0 {
                    if is_folded_const_int_ax(cg, vars, rhs) {
                        mc_mov_reg_imm(c, 2, eval_folded_const_int_ax(cg, vars, rhs))
                    } else {
                        emit_int_expr_to_rax(cg, vars, drops, breaks, rhs)
                        mc_b3(c, 0x49, 0x89, 0xC0)
                    }
                    mc_mov_rdx_gpreg(c, pr_i)
                    mc_load_rcx(c, bsl, 0)
                    mc_b3(c, 0x48, 0x85, 0xC9); cg_jmp_fn(cg, 0x84, h_sec_trap())
                    mc_b3(c, 0x48, 0x3B, 0x11); cg_jmp_fn(cg, 0x83, h_sec_trap())
                    if is_ib { mc_b4(c, 0x4C, 0x89, 0x44, 0xD1); mc_b1(c, 0x10) }
                    else     { mc_b4(c, 0x44, 0x88, 0x44, 0x11); mc_b1(c, 0x10) }
                    if ibuf_len(drops) == saved_drops { ibuf_set(cg.state, 4, saved_slot) }
                    return
                }
            }
            tr := emit_expr_ax(cg, vars, drops, breaks, b_nid)
            ir := emit_expr_ax(cg, vars, drops, breaks, idx_nid)
            rr := emit_expr_ax(cg, vars, drops, breaks, rhs)
            tslot := er_slot(tr)
            tty := er_ty(tr)
            islot := er_slot(ir)
            rslot := er_slot(rr)
            if tty == ty_intbuf() {
                mc_load_r8(c, tslot, 0)
                mc_b3(c, 0x4D, 0x85, 0xC0)
                cg_jmp_fn(cg, 0x84, h_sec_trap())
                mc_load_rcx(c, islot, 0)
                mc_b3(c, 0x49, 0x3B, 0x08)
                cg_jmp_fn(cg, 0x83, h_sec_trap())
                mc_load_rax(c, rslot, 0)
                mc_b4(c, 0x49, 0x89, 0x44, 0xC8); mc_b1(c, 0x10)
            } else if tty == ty_bytebuf() {
                mc_load_r8(c, tslot, 0)
                mc_b3(c, 0x4D, 0x85, 0xC0)
                cg_jmp_fn(cg, 0x84, h_sec_trap())
                mc_load_rcx(c, islot, 0)
                mc_b3(c, 0x49, 0x3B, 0x08)
                cg_jmp_fn(cg, 0x83, h_sec_trap())
                mc_load_rax(c, rslot, 0)
                mc_b4(c, 0x41, 0x88, 0x44, 0x08); mc_b1(c, 0x10)
            } else if ty_tag(tty) == 21 {
                mc_load_rdx(c, tslot, 1)
                mc_b3(c, 0x48, 0x89, 0xD0); mc_b1(c, 0x25); mc_u32(c, 0xFFFFF)
                mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE9, 0x14); mc_b2(c, 0x81, 0xE1); mc_u32(c, 0xFFFFF)
                mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
                mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE9, 0x28); mc_b2(c, 0x81, 0xE1); mc_u32(c, 0xFFFFF)
                mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
                mc_load_rcx(c, islot, 0)
                mc_b3(c, 0x48, 0x39, 0xC1)
                cg_jmp_fn(cg, 0x83, h_sec_trap())
                mc_f64_slot_to_f32_eax(c, rslot)
                mc_load_r8(c, tslot, 0)
                mc_load_rcx(c, islot, 0)
                mc_b4(c, 0x41, 0x89, 0x04, 0x88)
            } else {
                emit_bounds_check_ax(cg, islot, tslot, idx_nid)
                mc_load_r8(c, tslot, 0)
                mc_load_rcx(c, islot, 0)
                mc_load_rax(c, rslot, 0)
                if ty_tag(tty) == 12 and ty_pay(tty) == 60001 {
                    mc_b4(c, 0x66, 0x48, 0x0F, 0x6E)
                    mc_b1(c, 0xC0)
                    mc_b4(c, 0xF2, 0x0F, 0x5A, 0xC0)
                    mc_b4(c, 0xF3, 0x41, 0x0F, 0x11)
                    mc_b2(c, 0x04, 0x88)
                } else {
                    mc_b4(c, 0x49, 0x89, 0x04, 0xC8)
                }
            }
            if ibuf_len(drops) == saved_drops {
                ibuf_set(cg.state, 4, saved_slot)
            }
        }
        return
    }

    if k == nk_if() {
        tb := ast_get(cg.nodes, snid, 2)
        eb := ast_get(cg.nodes, snid, 3)
        if eb <= 0 and ast_kind(cg.nodes, tb) == nk_block() and ast_get(cg.nodes, tb, 2) == 1 {
            st0 := ibuf_get(cg.extra, ast_get(cg.nodes, tb, 1))
            stk0 := ast_kind(cg.nodes, st0)
            if stk0 == nk_break() {
                jtrue := emit_cond_branch_ax(cg, vars, drops, breaks, ast_get(cg.nodes, snid, 1), true)
                ibuf_push(breaks, jtrue)
                return
            }
            if stk0 == nk_continue() {
                ctgt := ibuf_get(cg.state, 10)
                if ctgt == -2 {
                    jtrue := emit_cond_branch_ax(cg, vars, drops, breaks, ast_get(cg.nodes, snid, 1), true)
                    ibuf_push(breaks, 0 - jtrue)
                    return
                } else if ctgt >= 0 {
                    jtrue := emit_cond_branch_ax(cg, vars, drops, breaks, ast_get(cg.nodes, snid, 1), true)
                    mc_patch_rel32(c, jtrue, ctgt)
                    return
                }
            }
            // Branchless `CMOV` conditional max/min store: `if cand > ptr_read_i64(dp, c) { ptr_write_i64(dp, c, cand) }`
            if stk0 == nk_expr_stmt() {
                es := ast_get(cg.nodes, st0, 1)
                cn := ast_get(cg.nodes, snid, 1)
                if es > 0 and ast_kind(cg.nodes, es) == nk_call() and ast_get(cg.nodes, es, 4) == 3 and pool_str_eq_lit(cg.pool, ast_get(cg.nodes, es, 1), ast_get(cg.nodes, es, 2), "ptr_write_i64") and cn > 0 and ast_kind(cg.nodes, cn) == nk_binary() {
                    cop := ast_get(cg.nodes, cn, 1)
                    if cop == op_gt() or cop == op_lt() {
                        cl := ast_get(cg.nodes, cn, 2); cr := ast_get(cg.nodes, cn, 3)
                        if cr > 0 and ast_kind(cg.nodes, cr) == nk_call() and ast_get(cg.nodes, cr, 4) == 2 and pool_str_eq_lit(cg.pool, ast_get(cg.nodes, cr, 1), ast_get(cg.nodes, cr, 2), "ptr_read_i64") {
                            wa := ast_get(cg.nodes, es, 3)
                            wp := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, wa), 4))
                            wi := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, wa + 1), 4))
                            wv := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, wa + 2), 4))
                            ra := ast_get(cg.nodes, cr, 3)
                            rp := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, ra), 4))
                            ri := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, ra + 1), 4))
                            cv := local_scalar_slot_ax(cg, vars, cl)
                            if wp > 0 and wp == rp and wi > 0 and wi == ri and wv > 0 and wv == cv {
                                pr_p := cg_slot_reg(cg, wp); pr_i := cg_slot_reg(cg, wi); pr_v := cg_slot_reg(cg, wv)
                                if pr_v > 0 { mc_mov_rcx_gpreg(c, pr_v) } else { mc_load_rcx(c, wv, 0) }
                                if pr_p > 0 and pr_i > 0 {
                                    b_hw := gpreg_hw(pr_p); b_hi := gpreg_hi(pr_p)
                                    x_hw := gpreg_hw(pr_i); x_hi := gpreg_hi(pr_i)
                                    sib := 0xC0 | (x_hw << 3) | b_hw
                                    mut modrm := 0x04
                                    if b_hw == 5 { modrm = 0x44 }
                                    rex := 0x48 | (x_hi << 1) | b_hi
                                    mc_b4(c, rex, 0x8B, modrm, sib); if b_hw == 5 { mc_b1(c, 0) }
                                    mc_b3(c, 0x48, 0x39, 0xC1)
                                    if cop == op_gt() { mc_b4(c, 0x48, 0x0F, 0x4F, 0xC1) }
                                    else              { mc_b4(c, 0x48, 0x0F, 0x4C, 0xC1) }
                                    mc_b4(c, rex, 0x89, modrm, sib); if b_hw == 5 { mc_b1(c, 0) }
                                    return
                                }
                                if pr_p > 0 { mc_mov_r9_gpreg(c, pr_p) } else { mc_load_r9(c, wp, 0) }
                                if pr_i > 0 { mc_mov_rdx_gpreg(c, pr_i) } else { mc_load_rdx(c, wi, 0) }
                                mc_b4(c, 0x49, 0x8B, 0x04, 0xD1) // MOV RAX, [R9 + RDX*8]
                                mc_b3(c, 0x48, 0x39, 0xC1)       // CMP RCX, RAX
                                if cop == op_gt() { mc_b4(c, 0x48, 0x0F, 0x4F, 0xC1) } // CMOVG RAX, RCX
                                else              { mc_b4(c, 0x48, 0x0F, 0x4C, 0xC1) } // CMOVL RAX, RCX
                                mc_b4(c, 0x49, 0x89, 0x04, 0xD1) // MOV [R9 + RDX*8], RAX
                                return
                            }
                        }
                    }
                }
            }
        }
        cn_if := ast_get(cg.nodes, snid, 1)
        if eb <= 0 and try_emit_cmov_if_ax(cg, vars, drops, breaks, cn_if, tb) {
            return
        }
        mut jz_pos := -1
        mut jz_pos2 := -1
        if cn_if > 0 and ast_kind(cg.nodes, cn_if) == nk_binary() and (ast_get(cg.nodes, cn_if, 1) == op_and() or ast_get(cg.nodes, cn_if, 1) == op_or()) {
            cl_if := ast_get(cg.nodes, cn_if, 2); cr_if := ast_get(cg.nodes, cn_if, 3)
            if ast_get(cg.nodes, cn_if, 1) == op_and() {
                jz_pos = emit_cond_jump_false_ax(cg, vars, drops, breaks, cl_if)
                jz_pos2 = emit_cond_jump_false_ax(cg, vars, drops, breaks, cr_if)
            } else {
                jt1 := emit_cond_branch_ax(cg, vars, drops, breaks, cl_if, true)
                jz_pos = emit_cond_jump_false_ax(cg, vars, drops, breaks, cr_if)
                mc_patch_rel32(c, jt1, buf_len(c))
            }
        } else {
            jz_pos = emit_cond_jump_false_ax(cg, vars, drops, breaks, cn_if)
        }
        emit_block_ax(cg, vars, drops, breaks, tb)
        if eb <= 0 {
            mc_patch_rel32(c, jz_pos, buf_len(c))
            if jz_pos2 >= 0 { mc_patch_rel32(c, jz_pos2, buf_len(c)) }
        } else {
            jmp_end := mc_jmp32(c)
            mc_patch_rel32(c, jz_pos, buf_len(c))
            if jz_pos2 >= 0 { mc_patch_rel32(c, jz_pos2, buf_len(c)) }
            emit_block_ax(cg, vars, drops, breaks, eb)
            mc_patch_rel32(c, jmp_end, buf_len(c))
        }
        return
    }

    if k == nk_while() {
        tplan := ast_get(cg.nodes, snid, 4)
        if (tplan & 3) == 1 {
            // Respect `--simd=scalar` (`g_simd_tier == 0`) fallback!
            cg_mov_rax_data(cg, data_off_simd_tier())
            mc_b3(c, 0x48, 0x85, 0xC0)
            jz_no_tile := mc_jcc32(c, 0x84)
            emit_temporal_tiled_simd_ax(cg, vars, drops, breaks, snid, tplan >> 2)
            jmp_after_tile := mc_jmp32(c)
            mc_patch_rel32(c, jz_no_tile, buf_len(c))
            // Scalar fallback runs normal `while` loop (`emit_soa_simd_foreach_ax` Tier 0)
            prev_c0 := ibuf_get(cg.state, 10)
            prev_b0 := ibuf_get(cg.state, 11)
            bm0 := ibuf_len(breaks)
            lt0 := buf_len(c)
            jze0 := emit_cond_jump_false_ax(cg, vars, drops, breaks, ast_get(cg.nodes, snid, 1))
            ibuf_set(cg.state, 10, lt0)
            ibuf_set(cg.state, 11, bm0)
            emit_block_ax(cg, vars, drops, breaks, ast_get(cg.nodes, snid, 2))
            jbt0 := mc_jmp32(c)
            mc_patch_rel32(c, jbt0, lt0)
            mc_patch_rel32(c, jze0, buf_len(c))
            ibuf_set(cg.state, 10, prev_c0)
            ibuf_set(cg.state, 11, prev_b0)
            mc_patch_rel32(c, jmp_after_tile, buf_len(c))
            return
        }

        if ibuf_get(cg.state, 25) == 0 and ibuf_get(cg.state, 17) != 0 and ibuf_get(cg.state, 161) != 0 and (ibuf_get(cg.state, 18) & fnflag_nan_guard()) == 0 {
            wbody := ast_get(cg.nodes, snid, 2)
            if not scan_ast_has_call_ax(cg, wbody) and scan_nested_f64_while_ax(cg, wbody) {
                cg_mov_rax_data(cg, data_off_simd_tier())
                mc_b3(c, 0x48, 0x85, 0xC0) // TEST RAX, RAX (tier >= 1: AVX2 + FMA3)
                jz_sse2_outer := mc_jcc32(c, 0x84)
                ibuf_set(cg.state, 25, 1)
                mut outer_hoist := false
                if ibuf_get(cg.state, 23) == 0 {
                    hbits := find_deep_f64_cmp_const_ax(cg, vars, wbody)
                    if hbits != 0 {
                        mc_vex_movsd_rdata(cg, 5, hbits)
                        ibuf_set(cg.state, 23, hbits)
                        outer_hoist = true
                    }
                }
                emit_while_core_ax(cg, vars, drops, breaks, snid)
                if outer_hoist { ibuf_set(cg.state, 23, 0) }
                jmp_outer_done := mc_jmp32(c)
                mc_patch_rel32(c, jz_sse2_outer, buf_len(c))
                ibuf_set(cg.state, 25, 2)
                emit_while_core_ax(cg, vars, drops, breaks, snid)
                ibuf_set(cg.state, 25, 0)
                mc_patch_rel32(c, jmp_outer_done, buf_len(c))
                return
            }
        }
        emit_while_core_ax(cg, vars, drops, breaks, snid)
        return
    }

    if k == nk_for_range() or k == nk_par_for_range() {
        vsoff := ast_get(cg.nodes, snid, 1)
        vslen := ast_get(cg.nodes, snid, 2)
        end_nid := ast_get(cg.nodes, snid, 4)
        sr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, snid, 3))
        er := emit_expr_ax(cg, vars, drops, breaks, end_nid)
        iv_slot := cg_alloc_slots(cg, 1)
        mc_load_rax(c, er_slot(sr), 0)
        mc_store_rax(c, iv_slot, 0)
        saved_vcnt := ibuf_len(vars) / 5
        ibuf_push(vars, vsoff)
        ibuf_push(vars, vslen)
        ibuf_push(vars, iv_slot)
        ibuf_push(vars, ty_int())
        ibuf_push(vars, snid)

        prev_el_soff := ibuf_get(cg.state, 12)
        prev_el_slen := ibuf_get(cg.state, 13)
        // Always retain runtime bounds checking (no unsound name-based elision)

        prev_cont := ibuf_get(cg.state, 10)
        prev_bmark := ibuf_get(cg.state, 11)
        bmark := ibuf_len(breaks)

        loop_top := buf_len(c)
        mc_load_rax(c, iv_slot, 0)
        mc_cmp_rax_slot(c, er_slot(er), 0)
        jge_exit := mc_jcc32(c, 0x8D)

        ibuf_set(cg.state, 11, bmark)
        cont_tramp_jmp := mc_jmp32(c)
        cont_target := buf_len(c)
        mc_load_rax(c, iv_slot, 0)
        mc_b3(c, 0x48, 0xFF, 0xC0)
        mc_store_rax(c, iv_slot, 0)
        jb_cont := mc_jmp32(c)
        mc_patch_rel32(c, jb_cont, loop_top)
        mc_patch_rel32(c, cont_tramp_jmp, buf_len(c))

        ibuf_set(cg.state, 10, cont_target)
        emit_block_ax(cg, vars, drops, breaks, ast_get(cg.nodes, snid, 5))

        mc_load_rax(c, iv_slot, 0)
        mc_b3(c, 0x48, 0xFF, 0xC0)
        mc_store_rax(c, iv_slot, 0)
        jb_top := mc_jmp32(c)
        mc_patch_rel32(c, jb_top, loop_top)

        exit_pos := buf_len(c)
        mc_patch_rel32(c, jge_exit, exit_pos)
        mut bi := bmark
        while bi < ibuf_len(breaks) {
            bpos := ibuf_get(breaks, bi)
            if bpos > 0 {
                mc_patch_rel32(c, bpos, exit_pos)
                ibuf_set(breaks, bi, 0)
            }
            bi += 1
        }

        ibuf_set(vars, saved_vcnt * 5 + 1, -1)
        ibuf_set(cg.state, 10, prev_cont)
        ibuf_set(cg.state, 11, prev_bmark)
        ibuf_set(cg.state, 12, prev_el_soff)
        ibuf_set(cg.state, 13, prev_el_slen)
        return
    }

    if k == nk_for_each() {
        emit_soa_simd_foreach_ax(cg, vars, drops, breaks, snid)
        return
    }

    if k == nk_par_for_each() {
        emit_par_soa_foreach_ax(cg, vars, drops, breaks, snid)
        return
    }

    if k == nk_return() {
        rv := ast_get(cg.nodes, snid, 1)
        if rv > 0 {
            if ibuf_get(cg.state, 22) == 0 and ibuf_get(cg.state, 9) == 1 and ibuf_get(cg.state, 8) == 1 and ibuf_len(drops) == 0 {
                if pure_i64_ty_ax(cg, vars, rv) != 0 {
                    emit_int_expr_to_rax(cg, vars, drops, breaks, rv)
                    emit_restore_callee_regs_ax(cg)
                    mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
                    mc_b1(c, 0xC3)
                    return
                }
                if pure_f64_ty_ax(cg, vars, rv) and ibuf_get(cg.state, 7) == ty_float() {
                    emit_f64_expr_to_xmm0(cg, vars, rv)
                    mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0) // MOVQ RAX, XMM0
                    if (ibuf_get(cg.state, 18) & fnflag_nan_guard()) != 0 {
                        ibuf_set(cg.state, 20, span_line(ast_span(cg.nodes, snid)))
                        emit_nan_guard_rax(cg)
                    }
                    emit_restore_callee_regs_ax(cg)
                    mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
                    mc_b1(c, 0xC3)
                    return
                }
            }
            rr := emit_expr_ax(cg, vars, drops, breaks, rv)
            emit_return_from_slot_ax(cg, vars, drops, er_slot(rr), er_ty(rr))
        } else {
            zs := cg_alloc_slots(cg, 1)
            mc_mov_rax_imm(c, 0)
            mc_store_rax(c, zs, 0)
            emit_return_from_slot_ax(cg, vars, drops, zs, ty_unit())
        }
        return
    }

    if k == nk_break() {
        bpos := mc_jmp32(c)
        ibuf_push(breaks, bpos)
        return
    }

    if k == nk_continue() {
        ctgt := ibuf_get(cg.state, 10)
        if ctgt == -2 {
            cpos := mc_jmp32(c)
            ibuf_push(breaks, 0 - cpos)
        } else if ctgt >= 0 {
            cpos := mc_jmp32(c)
            mc_patch_rel32(c, cpos, ctgt)
        }
        return
    }

    if k == nk_expr_stmt() {
        saved_slot := ibuf_get(cg.state, 4)
        saved_drops := ibuf_len(drops)
        emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, snid, 1))
        if ibuf_len(drops) == saved_drops {
            ibuf_set(cg.state, 4, saved_slot)
        }
    }
}

// Value-forwarding dual-CMOV fusion for binary-heap / min-index sift-down:
// `if guard and A[r] < A[l] { sm = r }; if key <= A[sm] { break }; ptr_write_i64(A, p, ptr_read_i64(A, sm))`
// Computes `sm` and `RCX = A[sm]` in parallel via dual `CMOVcc`, eliminating 2 redundant loads and halving the critical path!
fn try_emit_heap_sift_3_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, st_a: i64, st_b: i64, st_c: i64, sm_eq_l: bool, r_is_l1: bool, rdx_is_2p: bool) -> bool {
    if ast_kind(cg.nodes, st_a) != nk_if() or ast_get(cg.nodes, st_a, 3) > 0 { return false }
    if ast_kind(cg.nodes, st_b) != nk_if() or ast_get(cg.nodes, st_b, 3) > 0 { return false }
    if ast_kind(cg.nodes, st_c) != nk_expr_stmt() { return false }

    // Match st_a: `if guard and ptr_read_i64(A, r) < ptr_read_i64(A, l) { sm = r }`
    ca := ast_get(cg.nodes, st_a, 1); tba := ast_get(cg.nodes, st_a, 2)
    if ca <= 0 or tba <= 0 or ast_kind(cg.nodes, ca) != nk_binary() or ast_get(cg.nodes, ca, 1) != op_and() { return false }
    if ast_kind(cg.nodes, tba) != nk_block() or ast_get(cg.nodes, tba, 2) != 1 { return false }
    asgn := ibuf_get(cg.extra, ast_get(cg.nodes, tba, 1))
    if ast_kind(cg.nodes, asgn) != nk_assign() or ast_get(cg.nodes, asgn, 1) != aop_eq() { return false }
    sm_slot := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, asgn, 2))
    r_slot := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, asgn, 3))
    pr_sm := cg_slot_reg(cg, sm_slot); pr_r := cg_slot_reg(cg, r_slot)
    if pr_sm <= 0 or pr_r <= 0 { return false }

    guard_n := ast_get(cg.nodes, ca, 2); cmp_a := ast_get(cg.nodes, ca, 3)
    if cmp_a <= 0 or ast_kind(cg.nodes, cmp_a) != nk_binary() { return false }
    op_a := ast_get(cg.nodes, cmp_a, 1)
    if op_a != op_lt() and op_a != op_gt() { return false }
    rd_r := ast_get(cg.nodes, cmp_a, 2); rd_l := ast_get(cg.nodes, cmp_a, 3)
    if rd_r <= 0 or rd_l <= 0 or ast_kind(cg.nodes, rd_r) != nk_call() or ast_kind(cg.nodes, rd_l) != nk_call() { return false }
    if ast_get(cg.nodes, rd_r, 4) != 2 or ast_get(cg.nodes, rd_l, 4) != 2 { return false }
    if not pool_str_eq_lit(cg.pool, ast_get(cg.nodes, rd_r, 1), ast_get(cg.nodes, rd_r, 2), "ptr_read_i64") { return false }
    if not pool_str_eq_lit(cg.pool, ast_get(cg.nodes, rd_l, 1), ast_get(cg.nodes, rd_l, 2), "ptr_read_i64") { return false }
    ra_r := ast_get(cg.nodes, rd_r, 3); ra_l := ast_get(cg.nodes, rd_l, 3)
    a_slot := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, ra_r), 4))
    if a_slot <= 0 or local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, ra_l), 4)) != a_slot { return false }
    if local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, ra_r + 1), 4)) != r_slot { return false }
    l_slot := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, ra_l + 1), 4))
    pr_a := cg_slot_reg(cg, a_slot); pr_l := cg_slot_reg(cg, l_slot)
    if pr_a <= 0 or pr_l <= 0 { return false }

    // Match st_b: `if key <= ptr_read_i64(A, sm) { break }` (or `>=`, `<`, `>`)
    cb := ast_get(cg.nodes, st_b, 1); tbb := ast_get(cg.nodes, st_b, 2)
    if cb <= 0 or tbb <= 0 or ast_kind(cg.nodes, cb) != nk_binary() { return false }
    if ast_kind(cg.nodes, tbb) != nk_block() or ast_get(cg.nodes, tbb, 2) != 1 { return false }
    if ast_kind(cg.nodes, ibuf_get(cg.extra, ast_get(cg.nodes, tbb, 1))) != nk_break() { return false }
    op_b := ast_get(cg.nodes, cb, 1)
    if op_b < op_eq() or op_b > op_gte() { return false }
    key_slot := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, cb, 2))
    pr_key := cg_slot_reg(cg, key_slot)
    if pr_key <= 0 { return false }
    rd_sm := ast_get(cg.nodes, cb, 3)
    if rd_sm <= 0 or ast_kind(cg.nodes, rd_sm) != nk_call() or ast_get(cg.nodes, rd_sm, 4) != 2 { return false }
    if not pool_str_eq_lit(cg.pool, ast_get(cg.nodes, rd_sm, 1), ast_get(cg.nodes, rd_sm, 2), "ptr_read_i64") { return false }
    ra_sm := ast_get(cg.nodes, rd_sm, 3)
    if local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, ra_sm), 4)) != a_slot { return false }
    if local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, ra_sm + 1), 4)) != sm_slot { return false }

    // Match st_c: `ptr_write_i64(A, p, ptr_read_i64(A, sm))`
    wr := ast_get(cg.nodes, st_c, 1)
    if wr <= 0 or ast_kind(cg.nodes, wr) != nk_call() or ast_get(cg.nodes, wr, 4) != 3 { return false }
    if not pool_str_eq_lit(cg.pool, ast_get(cg.nodes, wr, 1), ast_get(cg.nodes, wr, 2), "ptr_write_i64") { return false }
    wa := ast_get(cg.nodes, wr, 3)
    if local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, wa), 4)) != a_slot { return false }
    p_slot := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, wa + 1), 4))
    pr_p := cg_slot_reg(cg, p_slot)
    if pr_p <= 0 { return false }
    rd_c := ast_get(cg.nodes, ibuf_get(cg.extra, wa + 2), 4)
    if rd_c <= 0 or ast_kind(cg.nodes, rd_c) != nk_call() or ast_get(cg.nodes, rd_c, 4) != 2 { return false }
    if not pool_str_eq_lit(cg.pool, ast_get(cg.nodes, rd_c, 1), ast_get(cg.nodes, rd_c, 2), "ptr_read_i64") { return false }
    ra_c := ast_get(cg.nodes, rd_c, 3)
    if local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, ra_c), 4)) != a_slot { return false }
    if local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, ra_c + 1), 4)) != sm_slot { return false }

    // Emit dual-CMOV sift step!
    c := cg.code
    b_hw := gpreg_hw(pr_a); b_hi := gpreg_hi(pr_a)
    mut m_base := 0x04
    if b_hw == 5 { m_base = 0x44 }
    mut cm_cc := 0x4C            // CMOVL
    if op_a == op_gt() { cm_cc = 0x4F }

    mut can_preload := false
    if sm_eq_l and guard_n > 0 and ast_kind(cg.nodes, guard_n) == nk_binary() {
        gop := ast_get(cg.nodes, guard_n, 1)
        if gop >= op_eq() and gop <= op_gte() {
            gl := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, guard_n, 2)))
            gr := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, guard_n, 3)))
            if gl > 0 and (gr > 0 or is_folded_const_int_ax(cg, vars, ast_get(cg.nodes, guard_n, 3))) {
                can_preload = true
            }
        }
    }

    if can_preload {
        if rdx_is_2p and r_is_l1 {
            // 7-cycle critical path: launch `RCX = A[2*p + 1]` and `RAX = A[2*p + 2]` directly from `RDX = 2*p`!
            mc_b4(c, 0x48 | b_hi, 0x8B, 0x4C, 0xD0 | b_hw); mc_b1(c, 8)
            jf_guard := emit_cond_jump_false_ax(cg, vars, drops, breaks, guard_n)
            mc_b4(c, 0x48 | b_hi, 0x8B, 0x44, 0xD0 | b_hw); mc_b1(c, 16)
            mc_b3(c, 0x48, 0x39, 0xC8)
            mc_b4(c, 0x48 | (gpreg_hi(pr_sm) << 2) | gpreg_hi(pr_r), 0x0F, cm_cc, 0xC0 | (gpreg_hw(pr_sm) << 3) | gpreg_hw(pr_r))
            mc_b4(c, 0x48, 0x0F, cm_cc, 0xC8)
            mc_patch_rel32(c, jf_guard, buf_len(c))
        } else {
            // Jump-free pre-load: `RCX = A[l]` (== A[sm]) BEFORE guard branch -> starts load 2 cycles early & kills hot JMP!
            mc_b4(c, 0x48 | (gpreg_hi(pr_l) << 1) | b_hi, 0x8B, m_base | 0x08, 0xC0 | (gpreg_hw(pr_l) << 3) | b_hw)
            if b_hw == 5 { mc_b1(c, 0) }
            jf_guard := emit_cond_jump_false_ax(cg, vars, drops, breaks, guard_n)
            if r_is_l1 and gpreg_hw(pr_l) != 4 {
                mc_b4(c, 0x48 | (gpreg_hi(pr_l) << 1) | b_hi, 0x8B, 0x44, 0xC0 | (gpreg_hw(pr_l) << 3) | b_hw)
                mc_b1(c, 8)
            } else {
                mc_b4(c, 0x48 | (gpreg_hi(pr_r) << 1) | b_hi, 0x8B, m_base, 0xC0 | (gpreg_hw(pr_r) << 3) | b_hw)
                if b_hw == 5 { mc_b1(c, 0) } // MOV RAX, [A + r*8]
            }
            mc_b3(c, 0x48, 0x39, 0xC8)   // CMP RAX, RCX
            mc_b4(c, 0x48 | (gpreg_hi(pr_sm) << 2) | gpreg_hi(pr_r), 0x0F, cm_cc, 0xC0 | (gpreg_hw(pr_sm) << 3) | gpreg_hw(pr_r))
            mc_b4(c, 0x48, 0x0F, cm_cc, 0xC8) // CMOVcc RCX, RAX
            mc_patch_rel32(c, jf_guard, buf_len(c))
        }
    } else {
        jf_guard := emit_cond_jump_false_ax(cg, vars, drops, breaks, guard_n)
        // Hot path (2 children exist): load A[r] -> RAX, A[l] -> RCX, compare, dual CMOV sm & RCX!
        mc_b4(c, 0x48 | (gpreg_hi(pr_r) << 1) | b_hi, 0x8B, m_base, 0xC0 | (gpreg_hw(pr_r) << 3) | b_hw)
        if b_hw == 5 { mc_b1(c, 0) } // MOV RAX, [A + r*8]
        mc_b4(c, 0x48 | (gpreg_hi(pr_l) << 1) | b_hi, 0x8B, m_base | 0x08, 0xC0 | (gpreg_hw(pr_l) << 3) | b_hw)
        if b_hw == 5 { mc_b1(c, 0) } // MOV RCX, [A + l*8]
        mc_b3(c, 0x48, 0x39, 0xC8)   // CMP RAX, RCX
        mc_b4(c, 0x48 | (gpreg_hi(pr_sm) << 2) | gpreg_hi(pr_r), 0x0F, cm_cc, 0xC0 | (gpreg_hw(pr_sm) << 3) | gpreg_hw(pr_r))
        mc_b4(c, 0x48, 0x0F, cm_cc, 0xC8)
        jmp_have := mc_jmp32(c)
        mc_patch_rel32(c, jf_guard, buf_len(c))
        mc_b4(c, 0x48 | (gpreg_hi(pr_sm) << 1) | b_hi, 0x8B, m_base | 0x08, 0xC0 | (gpreg_hw(pr_sm) << 3) | b_hw)
        if b_hw == 5 { mc_b1(c, 0) } // MOV RCX, [A + sm*8]
        mc_patch_rel32(c, jmp_have, buf_len(c))
    }

    // `if key op_b RCX { break }` — ZERO memory load!
    mc_b3(c, 0x48 | (gpreg_hi(pr_key) << 2), 0x3B, 0xC1 | (gpreg_hw(pr_key) << 3)) // CMP pr_key, RCX
    mut inv_b := 0x85
    if op_b == op_neq() { inv_b = 0x84 }
    else if op_b == op_lt() { inv_b = 0x8D }
    else if op_b == op_lte() { inv_b = 0x8F }
    else if op_b == op_gt() { inv_b = 0x8E }
    else if op_b == op_gte() { inv_b = 0x8C }
    jbrk := mc_jcc32_cond(c, inv_b, true)
    ibuf_push(breaks, jbrk)

    // `ptr_write_i64(A, p, RCX)` — ZERO memory load!
    mc_b4(c, 0x48 | (gpreg_hi(pr_p) << 1) | b_hi, 0x89, m_base | 0x08, 0xC0 | (gpreg_hw(pr_p) << 3) | b_hw)
    if b_hw == 5 { mc_b1(c, 0) } // MOV [A + p*8], RCX
    return true
}

fn try_emit_shared_idx_loads_2_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, st_a: i64, st_b: i64) -> bool {
    if ibuf_get(cg.state, 0) != 0 or ibuf_get(cg.state, 22) != 0 { return false }
    if ast_kind(cg.nodes, st_a) != nk_var_decl() or ast_kind(cg.nodes, st_b) != nk_var_decl() { return false }
    if ast_get(cg.nodes, st_a, 4) > 0 or ast_get(cg.nodes, st_b, 4) > 0 { return false }
    if (ast_get(cg.nodes, st_a, 6) & 1) != 0 or (ast_get(cg.nodes, st_b, 6) & 1) != 0 { return false }

    v1s := ast_get(cg.nodes, st_a, 1); v1l := ast_get(cg.nodes, st_a, 2)
    v2s := ast_get(cg.nodes, st_b, 1); v2l := ast_get(cg.nodes, st_b, 2)
    if v1l == v2l and pool_str_eq2(cg.pool, v1s, v1l, v2s) { return false }
    pr_d1 := find_promo_reg_by_name(cg, v1s, v1l)
    pr_d2 := find_promo_reg_by_name(cg, v2s, v2l)
    if pr_d1 <= 0 or pr_d2 <= 0 or pr_d1 == pr_d2 { return false }

    ie1 := ast_get(cg.nodes, st_a, 5); ie2 := ast_get(cg.nodes, st_b, 5)
    if ie1 <= 0 or ie2 <= 0 or ast_kind(cg.nodes, ie1) != nk_call() or ast_get(cg.nodes, ie1, 4) != 2 { return false }
    if not pool_str_eq_lit(cg.pool, ast_get(cg.nodes, ie1, 1), ast_get(cg.nodes, ie1, 2), "ptr_read_i64") { return false }

    ra1 := ast_get(cg.nodes, ie1, 3)
    p1_e := ast_get(cg.nodes, ibuf_get(cg.extra, ra1), 4)
    idx1 := ast_get(cg.nodes, ibuf_get(cg.extra, ra1 + 1), 4)
    psl1 := local_scalar_slot_ax(cg, vars, p1_e)
    if psl1 <= 0 or idx1 <= 0 or ast_kind(cg.nodes, idx1) != nk_binary() { return false }
    iop1 := ast_get(cg.nodes, idx1, 1)
    if iop1 != op_add() and iop1 != op_wrap_add() { return false }
    x1_e := ast_get(cg.nodes, idx1, 2); y1_e := ast_get(cg.nodes, idx1, 3)
    xsl1 := local_scalar_slot_ax(cg, vars, x1_e)
    ysl1 := local_scalar_slot_ax(cg, vars, y1_e)
    if xsl1 <= 0 or ysl1 <= 0 { return false }

    mut rd2 := ie2
    mut add_e := 0
    if ast_kind(cg.nodes, ie2) == nk_binary() and (ast_get(cg.nodes, ie2, 1) == op_add() or ast_get(cg.nodes, ie2, 1) == op_wrap_add()) {
        l2 := ast_get(cg.nodes, ie2, 2); r2 := ast_get(cg.nodes, ie2, 3)
        if r2 > 0 and ast_kind(cg.nodes, r2) == nk_call() and ast_get(cg.nodes, r2, 4) == 2 and pool_str_eq_lit(cg.pool, ast_get(cg.nodes, r2, 1), ast_get(cg.nodes, r2, 2), "ptr_read_i64") {
            rd2 = r2; add_e = l2
        } else if l2 > 0 and ast_kind(cg.nodes, l2) == nk_call() and ast_get(cg.nodes, l2, 4) == 2 and pool_str_eq_lit(cg.pool, ast_get(cg.nodes, l2, 1), ast_get(cg.nodes, l2, 2), "ptr_read_i64") {
            rd2 = l2; add_e = r2
        } else {
            return false
        }
    } else if ast_kind(cg.nodes, ie2) != nk_call() or ast_get(cg.nodes, ie2, 4) != 2 or not pool_str_eq_lit(cg.pool, ast_get(cg.nodes, ie2, 1), ast_get(cg.nodes, ie2, 2), "ptr_read_i64") {
        return false
    }

    ra2 := ast_get(cg.nodes, rd2, 3)
    p2_e := ast_get(cg.nodes, ibuf_get(cg.extra, ra2), 4)
    idx2 := ast_get(cg.nodes, ibuf_get(cg.extra, ra2 + 1), 4)
    psl2 := local_scalar_slot_ax(cg, vars, p2_e)
    if psl2 <= 0 or idx2 <= 0 or ast_kind(cg.nodes, idx2) != nk_binary() { return false }
    iop2 := ast_get(cg.nodes, idx2, 1)
    if iop2 != op_add() and iop2 != op_wrap_add() { return false }
    x2_e := ast_get(cg.nodes, idx2, 2); y2_e := ast_get(cg.nodes, idx2, 3)
    if local_scalar_slot_ax(cg, vars, x2_e) != xsl1 or local_scalar_slot_ax(cg, vars, y2_e) != ysl1 { return false }
    if ast_get(cg.nodes, p2_e, 2) == v1l and pool_str_eq2(cg.pool, ast_get(cg.nodes, p2_e, 1), v1l, v1s) { return false }
    if ast_get(cg.nodes, x2_e, 2) == v1l and pool_str_eq2(cg.pool, ast_get(cg.nodes, x2_e, 1), v1l, v1s) { return false }
    if ast_get(cg.nodes, y2_e, 2) == v1l and pool_str_eq2(cg.pool, ast_get(cg.nodes, y2_e, 1), v1l, v1s) { return false }

    mut asl := 0
    if add_e > 0 {
        asl = local_scalar_slot_ax(cg, vars, add_e)
        if asl <= 0 { return false }
        if ast_get(cg.nodes, add_e, 2) == v1l and pool_str_eq2(cg.pool, ast_get(cg.nodes, add_e, 1), v1l, v1s) { return false }
    }

    pr_p1 := cg_slot_reg(cg, psl1)
    pr_p2 := cg_slot_reg(cg, psl2)
    pr_a := cg_slot_reg(cg, asl)
    if pr_p2 == pr_d1 or (pr_a > 0 and pr_a == pr_d1) { return false }

    // Emit shared-index CSE pair: compute `idx1` ONCE into RAX, then load BOTH `pr_d1` and `pr_d2`!
    c := cg.code
    emit_int_expr_to_rax(cg, vars, drops, breaks, idx1)

    s1 := cg_alloc_slots(cg, 1)
    cg_set_gpr_slot(cg, pr_d1, s1)
    d1_hw := gpreg_hw(pr_d1); d1_hi := gpreg_hi(pr_d1)
    if pr_p1 > 0 {
        b1_hw := gpreg_hw(pr_p1); b1_hi := gpreg_hi(pr_p1)
        mut m1 := 0x04 | (d1_hw << 3)
        if b1_hw == 5 { m1 = 0x44 | (d1_hw << 3) }
        mc_b4(c, 0x48 | (d1_hi << 2) | b1_hi, 0x8B, m1, 0xC0 | b1_hw)
        if b1_hw == 5 { mc_b1(c, 0) }
    } else {
        mc_load_rcx(c, psl1, 0)
        mc_b4(c, 0x48 | (d1_hi << 2), 0x8B, 0x04 | (d1_hw << 3), 0xC1)
    }
    ibuf_push(vars, v1s); ibuf_push(vars, v1l); ibuf_push(vars, s1); ibuf_push(vars, ty_int()); ibuf_push(vars, st_a)

    s2 := cg_alloc_slots(cg, 1)
    cg_set_gpr_slot(cg, pr_d2, s2)
    d2_hw := gpreg_hw(pr_d2); d2_hi := gpreg_hi(pr_d2)
    if pr_p2 > 0 {
        b2_hw := gpreg_hw(pr_p2); b2_hi := gpreg_hi(pr_p2)
        mut m2 := 0x04 | (d2_hw << 3)
        if b2_hw == 5 { m2 = 0x44 | (d2_hw << 3) }
        mc_b4(c, 0x48 | (d2_hi << 2) | b2_hi, 0x8B, m2, 0xC0 | b2_hw)
        if b2_hw == 5 { mc_b1(c, 0) }
    } else {
        mc_load_rcx(c, psl2, 0)
        mc_b4(c, 0x48 | (d2_hi << 2), 0x8B, 0x04 | (d2_hw << 3), 0xC1)
    }
    if asl > 0 {
        if pr_a > 0 {
            mc_b3(c, 0x48 | (gpreg_hi(pr_a) << 2) | d2_hi, 0x01, 0xC0 | (gpreg_hw(pr_a) << 3) | d2_hw)
        } else {
            mc_add_gpreg_slot(c, pr_d2, asl)
        }
    }
    ibuf_push(vars, v2s); ibuf_push(vars, v2l); ibuf_push(vars, s2); ibuf_push(vars, ty_int()); ibuf_push(vars, st_b)
    return true
}

fn try_emit_load_cmp_store_3_ax(cg: CodegenCtx, vars: IntBuf, breaks: IntBuf, st_a: i64, st_b: i64, st_c: i64) -> bool {
    if not match_load_cmp_store_3_ax(cg, st_a, st_b, st_c) { return false }
    ie := ast_get(cg.nodes, st_a, 5)
    ra := ast_get(cg.nodes, ie, 3)
    a_slot := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, ra), 4))
    src_slot := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, ra + 1), 4))
    cb := ast_get(cg.nodes, st_b, 1)
    op_b := ast_get(cg.nodes, cb, 1)
    key_slot := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, cb, 3))
    wa := ast_get(cg.nodes, ast_get(cg.nodes, st_c, 1), 3)
    if local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, wa), 4)) != a_slot { return false }
    dst_slot := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, wa + 1), 4))
    pr_a := cg_slot_reg(cg, a_slot); pr_src := cg_slot_reg(cg, src_slot)
    pr_key := cg_slot_reg(cg, key_slot); pr_dst := cg_slot_reg(cg, dst_slot)
    if pr_a <= 0 or pr_src <= 0 or pr_key <= 0 or pr_dst <= 0 { return false }
    if gpreg_hw(pr_src) == 4 or gpreg_hw(pr_dst) == 4 { return false }

    c := cg.code
    b_hw := gpreg_hw(pr_a); b_hi := gpreg_hi(pr_a)
    mut m_base := 0x04
    if b_hw == 5 { m_base = 0x44 }
    // `RCX = A[src]` (scratch register — ZERO promoted GPR consumed!)
    mc_b4(c, 0x48 | (gpreg_hi(pr_src) << 1) | b_hi, 0x8B, m_base | 0x08, 0xC0 | (gpreg_hw(pr_src) << 3) | b_hw)
    if b_hw == 5 { mc_b1(c, 0) }
    // `if RCX op_b pr_key { break }`
    mc_b3(c, 0x48 | (gpreg_hi(pr_key) << 2), 0x39, 0xC1 | (gpreg_hw(pr_key) << 3)) // CMP RCX, pr_key
    mut inv_b := 0x85
    if op_b == op_neq() { inv_b = 0x84 }
    else if op_b == op_lt() { inv_b = 0x8D }
    else if op_b == op_lte() { inv_b = 0x8F }
    else if op_b == op_gt() { inv_b = 0x8E }
    else if op_b == op_gte() { inv_b = 0x8C }
    jbrk := mc_jcc32_cond(c, inv_b, true)
    ibuf_push(breaks, jbrk)
    // `A[dst] = RCX`
    mc_b4(c, 0x48 | (gpreg_hi(pr_dst) << 1) | b_hi, 0x89, m_base | 0x08, 0xC0 | (gpreg_hw(pr_dst) << 3) | b_hw)
    if b_hw == 5 { mc_b1(c, 0) }
    return true
}

fn emit_block_slice_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, off: i64, cnt: i64) {
    saved_vcnt := ibuf_len(vars) / 5
    saved_slot := ibuf_get(cg.state, 4)
    saved_drops := ibuf_len(drops)
    mut i := 0
    while i < cnt {
        mut handled := false
        if i + 2 < cnt {
            st_a := ibuf_get(cg.extra, off + i)
            st_b := ibuf_get(cg.extra, off + i + 1)
            st_c := ibuf_get(cg.extra, off + i + 2)
            mut sm_eq_l := false
            mut r_is_l1 := false
            mut rdx_is_2p := false
            if i >= 2 and ast_kind(cg.nodes, st_a) == nk_if() {
                sp2 := ibuf_get(cg.extra, off + i - 2)
                sp1 := ibuf_get(cg.extra, off + i - 1)
                if ast_kind(cg.nodes, sp2) == nk_var_decl() and ast_kind(cg.nodes, sp1) == nk_var_decl() {
                    // Check `sp2` is `mut sm := l` and `sp1` defines a different var (`r := l + 1`)
                    if ast_kind(cg.nodes, ast_get(cg.nodes, sp2, 5)) == nk_ident() {
                        sm_s := ast_get(cg.nodes, sp2, 1); sm_l := ast_get(cg.nodes, sp2, 2)
                        p1_s := ast_get(cg.nodes, sp1, 1); p1_l := ast_get(cg.nodes, sp1, 2)
                        if not (sm_l == p1_l and pool_str_eq2(cg.pool, sm_s, sm_l, p1_s)) {
                            tba := ast_get(cg.nodes, st_a, 2)
                            ca := ast_get(cg.nodes, st_a, 1)
                            if tba > 0 and ca > 0 and ast_kind(cg.nodes, tba) == nk_block() and ast_get(cg.nodes, tba, 2) == 1 and ast_kind(cg.nodes, ca) == nk_binary() {
                                asgn := ibuf_get(cg.extra, ast_get(cg.nodes, tba, 1))
                                cmp_a := ast_get(cg.nodes, ca, 3)
                                if ast_kind(cg.nodes, asgn) == nk_assign() and cmp_a > 0 and ast_kind(cg.nodes, cmp_a) == nk_binary() {
                                    rd_l := ast_get(cg.nodes, cmp_a, 3)
                                    if rd_l > 0 and ast_kind(cg.nodes, rd_l) == nk_call() and ast_get(cg.nodes, rd_l, 4) == 2 {
                                        sm_t := ast_get(cg.nodes, asgn, 2)
                                        r_t := ast_get(cg.nodes, asgn, 3)
                                        l_e := ast_get(cg.nodes, ibuf_get(cg.extra, ast_get(cg.nodes, rd_l, 3) + 1), 4)
                                        init_l := ast_get(cg.nodes, sp2, 5)
                                        if ast_kind(cg.nodes, sm_t) == nk_ident() and ast_kind(cg.nodes, l_e) == nk_ident() {
                                            if ast_get(cg.nodes, sm_t, 2) == sm_l and pool_str_eq2(cg.pool, ast_get(cg.nodes, sm_t, 1), sm_l, sm_s) and ast_get(cg.nodes, l_e, 2) == ast_get(cg.nodes, init_l, 2) and pool_str_eq2(cg.pool, ast_get(cg.nodes, l_e, 1), ast_get(cg.nodes, l_e, 2), ast_get(cg.nodes, init_l, 1)) {
                                                sm_eq_l = true
                                                p1_ie := ast_get(cg.nodes, sp1, 5)
                                                if ast_kind(cg.nodes, r_t) == nk_ident() and ast_get(cg.nodes, r_t, 2) == p1_l and pool_str_eq2(cg.pool, ast_get(cg.nodes, r_t, 1), p1_l, p1_s) and p1_ie > 0 and ast_kind(cg.nodes, p1_ie) == nk_binary() and (ast_get(cg.nodes, p1_ie, 1) == op_add() or ast_get(cg.nodes, p1_ie, 1) == op_wrap_add()) {
                                                    p1_bl := ast_get(cg.nodes, p1_ie, 2); p1_br := ast_get(cg.nodes, p1_ie, 3)
                                                    if p1_bl > 0 and ast_kind(cg.nodes, p1_bl) == nk_ident() and ast_get(cg.nodes, p1_bl, 2) == ast_get(cg.nodes, l_e, 2) and pool_str_eq2(cg.pool, ast_get(cg.nodes, p1_bl, 1), ast_get(cg.nodes, p1_bl, 2), ast_get(cg.nodes, l_e, 1)) and is_folded_const_int_ax(cg, vars, p1_br) and eval_folded_const_int_ax(cg, vars, p1_br) == 1 {
                                                        r_is_l1 = true
                                                        if i >= 4 and ibuf_get(cg.state, 0) == 0 and cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, sm_t)) > 0 and cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, r_t)) > 0 and cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, l_e)) > 0 {
                                                            sp4 := ibuf_get(cg.extra, off + i - 4)
                                                            sp3 := ibuf_get(cg.extra, off + i - 3)
                                                            if ast_kind(cg.nodes, sp4) == nk_var_decl() and ast_get(cg.nodes, sp4, 2) == ast_get(cg.nodes, l_e, 2) and pool_str_eq2(cg.pool, ast_get(cg.nodes, sp4, 1), ast_get(cg.nodes, l_e, 2), ast_get(cg.nodes, l_e, 1)) and ast_kind(cg.nodes, sp3) == nk_if() and ast_get(cg.nodes, sp3, 3) == 0 {
                                                                p4_ie := ast_get(cg.nodes, sp4, 5)
                                                                p3_c := ast_get(cg.nodes, sp3, 1); p3_tb := ast_get(cg.nodes, sp3, 2)
                                                                if p4_ie > 0 and ast_kind(cg.nodes, p4_ie) == nk_binary() and (ast_get(cg.nodes, p4_ie, 1) == op_add() or ast_get(cg.nodes, p4_ie, 1) == op_wrap_add()) and is_folded_const_int_ax(cg, vars, ast_get(cg.nodes, p4_ie, 3)) and eval_folded_const_int_ax(cg, vars, ast_get(cg.nodes, p4_ie, 3)) == 1 and p3_c > 0 and ast_kind(cg.nodes, p3_c) == nk_binary() and p3_tb > 0 and ast_kind(cg.nodes, p3_tb) == nk_block() and ast_get(cg.nodes, p3_tb, 2) == 1 and ast_kind(cg.nodes, ibuf_get(cg.extra, ast_get(cg.nodes, p3_tb, 1))) == nk_break() {
                                                                    p4_bl := ast_get(cg.nodes, p4_ie, 2)
                                                                    if p4_bl > 0 and ast_kind(cg.nodes, p4_bl) == nk_binary() and (ast_get(cg.nodes, p4_bl, 1) == op_mul() or ast_get(cg.nodes, p4_bl, 1) == op_wrap_mul()) and is_folded_const_int_ax(cg, vars, ast_get(cg.nodes, p4_bl, 3)) and eval_folded_const_int_ax(cg, vars, ast_get(cg.nodes, p4_bl, 3)) == 2 {
                                                                        pr_p4 := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, p4_bl, 2)))
                                                                        pr_3l := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, p3_c, 2)))
                                                                        pr_3r := cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, p3_c, 3)))
                                                                        if pr_p4 > 0 and gpreg_hw(pr_p4) != 4 and gpreg_hw(pr_p4) != 5 and pr_3l > 0 and (pr_3r > 0 or is_folded_const_int_ax(cg, vars, ast_get(cg.nodes, p3_c, 3))) {
                                                                            rdx_is_2p = true
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if try_emit_heap_sift_3_ax(cg, vars, drops, breaks, st_a, st_b, st_c, sm_eq_l, r_is_l1, rdx_is_2p) {
                i += 3
                handled = true
            } else if ast_kind(cg.nodes, st_a) == nk_var_decl() {
                vs := ast_get(cg.nodes, st_a, 1); vl := ast_get(cg.nodes, st_a, 2)
                mut dead_after := true
                mut j := i + 3
                while dead_after and j < cnt {
                    if ast_uses_ident_ax(cg, ibuf_get(cg.extra, off + j), vs, vl) { dead_after = false }
                    j += 1
                }
                if dead_after and try_emit_load_cmp_store_3_ax(cg, vars, breaks, st_a, st_b, st_c) {
                    i += 3
                    handled = true
                }
            }
        }
        if not handled and i + 1 < cnt and try_emit_shared_idx_loads_2_ax(cg, vars, drops, breaks, ibuf_get(cg.extra, off + i), ibuf_get(cg.extra, off + i + 1)) {
            i += 2
            handled = true
        }
        if not handled {
            emit_stmt_ax(cg, vars, drops, breaks, ibuf_get(cg.extra, off + i))
            i += 1
        }
    }
    end_vcnt := ibuf_len(vars) / 5
    mut vi := saved_vcnt
    while vi < end_vcnt {
        ibuf_set(vars, vi * 5 + 1, -1)
        pop_slot := ibuf_get(vars, vi * 5 + 2)
        if ibuf_get(cg.state, 98) != 0 {
            pr_pop := cg_slot_reg(cg, pop_slot)
            if pr_pop > 0 { cg_set_gpr_slot(cg, pr_pop, 0) }
        }
        if ibuf_get(cg.state, 161) != 0 {
            pfr_pop := cg_slot_freg(cg, pop_slot)
            if pfr_pop > 0 { cg_set_freg_slot(cg, pfr_pop, 0) }
        }
        vi += 1
    }
    if ibuf_len(drops) == saved_drops {
        ibuf_set(cg.state, 4, saved_slot)
    }
}

fn emit_block_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, bnid: i64) {
    if bnid <= 0 { return }
    emit_block_slice_ax(cg, vars, drops, breaks, ast_get(cg.nodes, bnid, 1), ast_get(cg.nodes, bnid, 2))
}

fn scan_unroll_body_ok_ax(cg: CodegenCtx, nid: i64, idx_soff: i64, idx_slen: i64, lim_soff: i64, lim_slen: i64) -> bool {
    if nid <= 0 { return true }
    k := ast_kind(cg.nodes, nid)
    if k == nk_int() or k == nk_float() or k == nk_bool() or k == nk_ident() or k == nk_move_ident() or k == nk_break() {
        return true
    }
    if k == nk_block() {
        off := ast_get(cg.nodes, nid, 1)
        cnt := ast_get(cg.nodes, nid, 2)
        mut i := 0
        while i < cnt {
            if not scan_unroll_body_ok_ax(cg, ibuf_get(cg.extra, off + i), idx_soff, idx_slen, lim_soff, lim_slen) { return false }
            i += 1
        }
        return true
    }
    if k == nk_var_decl() {
        if (ast_get(cg.nodes, nid, 6) & 1) != 0 { return false }
        vs := ast_get(cg.nodes, nid, 1); vl := ast_get(cg.nodes, nid, 2)
        if vl == idx_slen and pool_str_eq2(cg.pool, vs, vl, idx_soff) { return false }
        if lim_slen > 0 and vl == lim_slen and pool_str_eq2(cg.pool, vs, vl, lim_soff) { return false }
        return scan_unroll_body_ok_ax(cg, ast_get(cg.nodes, nid, 5), idx_soff, idx_slen, lim_soff, lim_slen)
    }
    if k == nk_assign() {
        tgt := ast_get(cg.nodes, nid, 2)
        if tgt <= 0 { return false }
        tk := ast_kind(cg.nodes, tgt)
        if tk != nk_ident() and tk != nk_move_ident() { return false }
        ts := ast_get(cg.nodes, tgt, 1); tl := ast_get(cg.nodes, tgt, 2)
        if tl == idx_slen and pool_str_eq2(cg.pool, ts, tl, idx_soff) { return false }
        if lim_slen > 0 and tl == lim_slen and pool_str_eq2(cg.pool, ts, tl, lim_soff) { return false }
        return scan_unroll_body_ok_ax(cg, ast_get(cg.nodes, nid, 3), idx_soff, idx_slen, lim_soff, lim_slen)
    }
    if k == nk_if() {
        if not scan_unroll_body_ok_ax(cg, ast_get(cg.nodes, nid, 1), idx_soff, idx_slen, lim_soff, lim_slen) { return false }
        if not scan_unroll_body_ok_ax(cg, ast_get(cg.nodes, nid, 2), idx_soff, idx_slen, lim_soff, lim_slen) { return false }
        return scan_unroll_body_ok_ax(cg, ast_get(cg.nodes, nid, 3), idx_soff, idx_slen, lim_soff, lim_slen)
    }
    if k == nk_expr_stmt() or k == nk_cast() {
        return scan_unroll_body_ok_ax(cg, ast_get(cg.nodes, nid, 1), idx_soff, idx_slen, lim_soff, lim_slen)
    }
    if k == nk_unary() {
        return scan_unroll_body_ok_ax(cg, ast_get(cg.nodes, nid, 2), idx_soff, idx_slen, lim_soff, lim_slen)
    }
    if k == nk_binary() {
        return scan_unroll_body_ok_ax(cg, ast_get(cg.nodes, nid, 2), idx_soff, idx_slen, lim_soff, lim_slen) and scan_unroll_body_ok_ax(cg, ast_get(cg.nodes, nid, 3), idx_soff, idx_slen, lim_soff, lim_slen)
    }
    if k == nk_call() {
        cs := ast_get(cg.nodes, nid, 1); cl := ast_get(cg.nodes, nid, 2)
        p := cg.pool
        pure_bi := pool_str_eq_lit(p, cs, cl, "ushr64") or pool_str_eq_lit(p, cs, cl, "popcnt64") or pool_str_eq_lit(p, cs, cl, "ptr_read_u8") or pool_str_eq_lit(p, cs, cl, "ptr_read_i64") or pool_str_eq_lit(p, cs, cl, "ptr_write_u8") or pool_str_eq_lit(p, cs, cl, "ptr_write_i64") or pool_str_eq_lit(p, cs, cl, "ptr_read_f32") or pool_str_eq_lit(p, cs, cl, "ptr_write_f32") or pool_str_eq_lit(p, cs, cl, "ptr_read_f64") or pool_str_eq_lit(p, cs, cl, "ptr_write_f64") or pool_str_eq_lit(p, cs, cl, "sqrt_f64")
        if not pure_bi { return false }
        aoff := ast_get(cg.nodes, nid, 3); acnt := ast_get(cg.nodes, nid, 4)
        mut i := 0
        while i < acnt {
            ca := ibuf_get(cg.extra, aoff + i)
            if not scan_unroll_body_ok_ax(cg, ast_get(cg.nodes, ca, 4), idx_soff, idx_slen, lim_soff, lim_slen) { return false }
            i += 1
        }
        return true
    }
    return false
}

fn scan_ast_has_f64_ax(cg: CodegenCtx, nid: i64) -> bool {
    if nid <= 0 { return false }
    k := ast_kind(cg.nodes, nid)
    if k == nk_float() { return true }
    if k == nk_block() {
        off := ast_get(cg.nodes, nid, 1); cnt := ast_get(cg.nodes, nid, 2)
        mut i := 0
        while i < cnt {
            if scan_ast_has_f64_ax(cg, ibuf_get(cg.extra, off + i)) { return true }
            i += 1
        }
        return false
    }
    if k == nk_var_decl() { return scan_ast_has_f64_ax(cg, ast_get(cg.nodes, nid, 5)) }
    if k == nk_assign() { return scan_ast_has_f64_ax(cg, ast_get(cg.nodes, nid, 3)) }
    if k == nk_if() { return scan_ast_has_f64_ax(cg, ast_get(cg.nodes, nid, 1)) or scan_ast_has_f64_ax(cg, ast_get(cg.nodes, nid, 2)) }
    if k == nk_binary() { return scan_ast_has_f64_ax(cg, ast_get(cg.nodes, nid, 2)) or scan_ast_has_f64_ax(cg, ast_get(cg.nodes, nid, 3)) }
    if k == nk_unary() { return scan_ast_has_f64_ax(cg, ast_get(cg.nodes, nid, 2)) }
    if k == nk_call() {
        cs := ast_get(cg.nodes, nid, 1); cl := ast_get(cg.nodes, nid, 2)
        if pool_str_eq_lit(cg.pool, cs, cl, "ptr_read_f64") or pool_str_eq_lit(cg.pool, cs, cl, "ptr_write_f64") or pool_str_eq_lit(cg.pool, cs, cl, "ptr_read_f32") or pool_str_eq_lit(cg.pool, cs, cl, "ptr_write_f32") or pool_str_eq_lit(cg.pool, cs, cl, "sqrt_f64") { return true }
    }
    return false
}

fn find_loop_f64_cmp_const_ax(cg: CodegenCtx, vars: IntBuf, off: i64, cnt: i64) -> i64 {
    mut i := 0
    while i < cnt {
        st := ibuf_get(cg.extra, off + i)
        if st > 0 and ast_kind(cg.nodes, st) == nk_if() {
            c0 := ast_get(cg.nodes, st, 1)
            if c0 > 0 and ast_kind(cg.nodes, c0) == nk_binary() {
                op := ast_get(cg.nodes, c0, 1)
                rhs := ast_get(cg.nodes, c0, 3)
                if (op == op_gt() or op == op_gte()) and const_f64_rdata_ok(cg, vars, rhs) {
                    b := const_f64_bits_ax(cg, rhs)
                    if b != 0 { return b }
                }
            }
        }
        i += 1
    }
    return 0
}

fn scan_ast_has_call_ax(cg: CodegenCtx, nid: i64) -> bool {
    if nid <= 0 { return false }
    k := ast_kind(cg.nodes, nid)
    if k == nk_call() or k == nk_return() { return true }
    if k == nk_block() {
        off := ast_get(cg.nodes, nid, 1); cnt := ast_get(cg.nodes, nid, 2)
        mut i := 0
        while i < cnt {
            if scan_ast_has_call_ax(cg, ibuf_get(cg.extra, off + i)) { return true }
            i += 1
        }
        return false
    }
    if k == nk_while() { return scan_ast_has_call_ax(cg, ast_get(cg.nodes, nid, 1)) or scan_ast_has_call_ax(cg, ast_get(cg.nodes, nid, 2)) }
    if k == nk_if() { return scan_ast_has_call_ax(cg, ast_get(cg.nodes, nid, 1)) or scan_ast_has_call_ax(cg, ast_get(cg.nodes, nid, 2)) or scan_ast_has_call_ax(cg, ast_get(cg.nodes, nid, 3)) }
    if k == nk_var_decl() { return scan_ast_has_call_ax(cg, ast_get(cg.nodes, nid, 5)) }
    if k == nk_assign() { return scan_ast_has_call_ax(cg, ast_get(cg.nodes, nid, 3)) }
    if k == nk_binary() { return scan_ast_has_call_ax(cg, ast_get(cg.nodes, nid, 2)) or scan_ast_has_call_ax(cg, ast_get(cg.nodes, nid, 3)) }
    if k == nk_unary() { return scan_ast_has_call_ax(cg, ast_get(cg.nodes, nid, 2)) }
    if k == nk_cast() or k == nk_expr_stmt() { return scan_ast_has_call_ax(cg, ast_get(cg.nodes, nid, 1)) }
    return false
}

fn scan_nested_f64_while_ax(cg: CodegenCtx, nid: i64) -> bool {
    if nid <= 0 { return false }
    k := ast_kind(cg.nodes, nid)
    if k == nk_while() {
        wb := ast_get(cg.nodes, nid, 2)
        if scan_ast_has_f64_ax(cg, wb) or scan_nested_f64_while_ax(cg, wb) { return true }
        return false
    }
    if k == nk_block() {
        off := ast_get(cg.nodes, nid, 1); cnt := ast_get(cg.nodes, nid, 2)
        mut i := 0
        while i < cnt {
            if scan_nested_f64_while_ax(cg, ibuf_get(cg.extra, off + i)) { return true }
            i += 1
        }
        return false
    }
    if k == nk_if() {
        return scan_nested_f64_while_ax(cg, ast_get(cg.nodes, nid, 2)) or scan_nested_f64_while_ax(cg, ast_get(cg.nodes, nid, 3))
    }
    return false
}

fn find_deep_f64_cmp_const_ax(cg: CodegenCtx, vars: IntBuf, nid: i64) -> i64 {
    if nid <= 0 { return 0 }
    k := ast_kind(cg.nodes, nid)
    if k == nk_while() {
        wb := ast_get(cg.nodes, nid, 2)
        if wb > 0 and ast_kind(cg.nodes, wb) == nk_block() {
            b := find_loop_f64_cmp_const_ax(cg, vars, ast_get(cg.nodes, wb, 1), ast_get(cg.nodes, wb, 2))
            if b != 0 { return b }
        }
        return find_deep_f64_cmp_const_ax(cg, vars, wb)
    }
    if k == nk_block() {
        off := ast_get(cg.nodes, nid, 1); cnt := ast_get(cg.nodes, nid, 2)
        mut i := 0
        while i < cnt {
            b := find_deep_f64_cmp_const_ax(cg, vars, ibuf_get(cg.extra, off + i))
            if b != 0 { return b }
            i += 1
        }
    }
    return 0
}

// Auto-vectorizes 4-wide AVX2 FMA `f64` AXPY loops (`while j < n { cv := ptr_read_f64(c, o1+j); bv := ptr_read_f64(b, o2+j); ptr_write_f64(c, o1+j, cv + s * bv); j += 1 }`)
fn try_emit_avx2_f64_axpy_while_ax(cg: CodegenCtx, vars: IntBuf, snid: i64) -> bool {
    if ibuf_get(cg.state, 17) == 0 or (ibuf_get(cg.state, 18) & fnflag_nan_guard()) != 0 { return false }
    cond := ast_get(cg.nodes, snid, 1)
    bnid := ast_get(cg.nodes, snid, 2)
    if cond <= 0 or bnid <= 0 or ast_kind(cg.nodes, cond) != nk_binary() or ast_get(cg.nodes, cond, 1) != op_lt() { return false }
    if ast_kind(cg.nodes, bnid) != nk_block() or ast_get(cg.nodes, bnid, 2) != 4 { return false }
    j_nid := ast_get(cg.nodes, cond, 2); n_nid := ast_get(cg.nodes, cond, 3)
    j_slot := local_scalar_slot_ax(cg, vars, j_nid)
    if j_slot <= 0 or immut_local_const_int_node(cg, vars, j_nid) > 0 { return false }
    j_soff := ast_get(cg.nodes, j_nid, 1); j_slen := ast_get(cg.nodes, j_nid, 2)
    n_is_imm := is_folded_const_int_ax(cg, vars, n_nid)
    mut n_imm := 0
    mut n_slot := 0
    if n_is_imm { n_imm = eval_folded_const_int_ax(cg, vars, n_nid) }
    else { n_slot = local_scalar_slot_ax(cg, vars, n_nid); if n_slot <= 0 { return false } }

    boff := ast_get(cg.nodes, bnid, 1)
    s0 := ibuf_get(cg.extra, boff); s1 := ibuf_get(cg.extra, boff + 1)
    s2 := ibuf_get(cg.extra, boff + 2); s3 := ibuf_get(cg.extra, boff + 3)
    if ast_kind(cg.nodes, s0) != nk_var_decl() or ast_kind(cg.nodes, s1) != nk_var_decl() or ast_kind(cg.nodes, s2) != nk_expr_stmt() or ast_kind(cg.nodes, s3) != nk_assign() { return false }
    if ast_get(cg.nodes, s3, 1) != aop_add() or not ast_is_ident_lit(cg, ast_get(cg.nodes, s3, 2), j_soff, j_slen) { return false }
    inc_n := ast_get(cg.nodes, s3, 3)
    if inc_n <= 0 or ast_kind(cg.nodes, inc_n) != nk_int() or ast_get(cg.nodes, inc_n, 1) != 1 { return false }

    // s0: `cv := ptr_read_f64(c, o1 + j)`, s1: `bv := ptr_read_f64(b, o2 + j)`
    e0 := ast_get(cg.nodes, s0, 5); e1 := ast_get(cg.nodes, s1, 5); e2 := ast_get(cg.nodes, s2, 1)
    if e0 <= 0 or e1 <= 0 or e2 <= 0 or ast_kind(cg.nodes, e0) != nk_call() or ast_kind(cg.nodes, e1) != nk_call() or ast_kind(cg.nodes, e2) != nk_call() { return false }
    if ast_get(cg.nodes, e0, 4) != 2 or ast_get(cg.nodes, e1, 4) != 2 or ast_get(cg.nodes, e2, 4) != 3 { return false }
    if not pool_str_eq_lit(cg.pool, ast_get(cg.nodes, e0, 1), ast_get(cg.nodes, e0, 2), "ptr_read_f64") { return false }
    if not pool_str_eq_lit(cg.pool, ast_get(cg.nodes, e1, 1), ast_get(cg.nodes, e1, 2), "ptr_read_f64") { return false }
    if not pool_str_eq_lit(cg.pool, ast_get(cg.nodes, e2, 1), ast_get(cg.nodes, e2, 2), "ptr_write_f64") { return false }

    c_slot := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, ast_get(cg.nodes, e0, 3)), 4))
    b_slot := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, ast_get(cg.nodes, e1, 3)), 4))
    wc_slot := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, ast_get(cg.nodes, e2, 3)), 4))
    if c_slot <= 0 or b_slot <= 0 or wc_slot != c_slot { return false }

    ci_n := ast_get(cg.nodes, ibuf_get(cg.extra, ast_get(cg.nodes, e0, 3) + 1), 4)
    bi_n := ast_get(cg.nodes, ibuf_get(cg.extra, ast_get(cg.nodes, e1, 3) + 1), 4)
    wi_n := ast_get(cg.nodes, ibuf_get(cg.extra, ast_get(cg.nodes, e2, 3) + 1), 4)
    if ast_kind(cg.nodes, ci_n) != nk_binary() or ast_kind(cg.nodes, bi_n) != nk_binary() or ast_kind(cg.nodes, wi_n) != nk_binary() { return false }
    if ast_get(cg.nodes, ci_n, 1) != op_add() or ast_get(cg.nodes, bi_n, 1) != op_add() or ast_get(cg.nodes, wi_n, 1) != op_add() { return false }
    if not ast_is_ident_lit(cg, ast_get(cg.nodes, ci_n, 3), j_soff, j_slen) or not ast_is_ident_lit(cg, ast_get(cg.nodes, bi_n, 3), j_soff, j_slen) or not ast_is_ident_lit(cg, ast_get(cg.nodes, wi_n, 3), j_soff, j_slen) { return false }
    o1_slot := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ci_n, 2))
    o2_slot := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, bi_n, 2))
    wo1_slot := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, wi_n, 2))
    if o1_slot <= 0 or o2_slot <= 0 or wo1_slot != o1_slot { return false }

    // s2 val: `cv + aik * bv`
    val_n := ast_get(cg.nodes, ibuf_get(cg.extra, ast_get(cg.nodes, e2, 3) + 2), 4)
    if val_n <= 0 or ast_kind(cg.nodes, val_n) != nk_binary() or ast_get(cg.nodes, val_n, 1) != op_add() { return false }
    cv_s := ast_get(cg.nodes, s0, 1); cv_l := ast_get(cg.nodes, s0, 2)
    bv_s := ast_get(cg.nodes, s1, 1); bv_l := ast_get(cg.nodes, s1, 2)
    if not ast_is_ident_lit(cg, ast_get(cg.nodes, val_n, 2), cv_s, cv_l) { return false }
    mul_n := ast_get(cg.nodes, val_n, 3)
    if mul_n <= 0 or ast_kind(cg.nodes, mul_n) != nk_binary() or ast_get(cg.nodes, mul_n, 1) != op_mul() { return false }
    if not ast_is_ident_lit(cg, ast_get(cg.nodes, mul_n, 3), bv_s, bv_l) { return false }
    s_slot := local_f64_slot_ax(cg, vars, ast_get(cg.nodes, mul_n, 2))
    if s_slot <= 0 { return false }

    // Preserve live promoted R10(8)/R11(9)/R8(10) across AVX2 vectorizer if active!
    c := cg.code
    pr_j := cg_slot_reg(cg, j_slot)
    sv10 := cg_get_gpr_slot(cg, 8) > 0 and pr_j != 8
    sv11 := cg_get_gpr_slot(cg, 9) > 0 and pr_j != 9
    sv8 := cg_get_gpr_slot(cg, 10) > 0 and pr_j != 10
    mut s10 := 0; mut s11 := 0; mut s8 := 0
    if sv10 { s10 = cg_alloc_slots(cg, 1); mc_store_gpreg(c, s10, 8) }
    if sv11 { s11 = cg_alloc_slots(cg, 1); mc_store_gpreg(c, s11, 9) }
    if sv8 { s8 = cg_alloc_slots(cg, 1); mc_store_gpreg(c, s8, 10) }

    // Emit runtime CPUID guard (`g_simd_tier >= 1`): if 0, fall back cleanly to scalar loop!
    cg_mov_rax_data(cg, data_off_simd_tier())
    mc_b3(c, 0x48, 0x85, 0xC0)
    jz_scalar := mc_jcc32(c, 0x84)

    // Setup: R8 = c_ptr + o1*8, R9 = b_ptr + o2*8, RCX = j, R10 = n, YMM2 = broadcast(s)
    pr_c := cg_slot_reg(cg, c_slot); pr_o1 := cg_slot_reg(cg, o1_slot)
    if pr_c > 0 { mc_mov_r8_gpreg(c, pr_c) } else { mc_load_r8(c, c_slot, 0) }
    if pr_o1 == 10 { mc_load_rax(c, s8, 0) } else if pr_o1 > 0 { mc_mov_rax_gpreg(c, pr_o1) } else { mc_load_rax(c, o1_slot, 0) }
    mc_b4(c, 0x4D, 0x8D, 0x04, 0xC0) // LEA R8, [R8 + RAX*8]

    pr_b := cg_slot_reg(cg, b_slot); pr_o2 := cg_slot_reg(cg, o2_slot)
    if pr_b == 10 { mc_load_r9(c, s8, 0) } else if pr_b > 0 { mc_mov_r9_gpreg(c, pr_b) } else { mc_load_r9(c, b_slot, 0) }
    if pr_o2 == 10 { mc_load_rax(c, s8, 0) } else if pr_o2 > 0 { mc_mov_rax_gpreg(c, pr_o2) } else { mc_load_rax(c, o2_slot, 0) }
    mc_b4(c, 0x4D, 0x8D, 0x0C, 0xC1) // LEA R9, [R9 + RAX*8]

    if pr_j == 10 { mc_load_rcx(c, s8, 0) } else if pr_j > 0 { mc_mov_rcx_gpreg(c, pr_j) } else { mc_load_rcx(c, j_slot, 0) }
    if n_is_imm {
        mc_mov_rax_imm(c, n_imm)
        mc_b3(c, 0x49, 0x89, 0xC2) // MOV R10, RAX
    } else {
        pr_n := cg_slot_reg(cg, n_slot)
        if pr_n == 10 { mc_load_rax(c, s8, 0) } else if pr_n > 0 { mc_mov_rax_gpreg(c, pr_n) } else { mc_load_rax(c, n_slot, 0) }
        mc_b3(c, 0x49, 0x89, 0xC2) // MOV R10, RAX
    }

    fr_s := cg_slot_freg(cg, s_slot)
    if fr_s > 0 { mc_vex_movaps_rr(c, 0, 5 + fr_s) } else { mc_sse_xmm0_slot(c, 0xF2, 0x10, s_slot, 0) }
    mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x19); mc_b1(c, 0xD0) // VBROADCASTSD YMM2, XMM0

    // 2x-unrolled 8-wide AVX2 FMA (64B full cache line per iteration!) + 4-wide + 1-wide tail
    mc_b4(c, 0x4D, 0x8D, 0x5A, 0xF8) // LEA R11, [R10 - 8]
    mc_b3(c, 0x4C, 0x39, 0xD9)       // CMP RCX, R11
    jg_lp4 := mc_jcc8(c, 0x7F)
    mc_align16_nop(c)
    lp8 := buf_len(c)
    mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xC8)       // VMOVUPD YMM0, [R8 + RCX*8]
    mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b3(c, 0x4C, 0xC8, 0x20) // VMOVUPD YMM1, [R8 + RCX*8 + 32]
    mc_vex3(c, 0, 0, 1, 2, 1, 2, 1, 1, 0xB8); mc_b2(c, 0x04, 0xC9)       // VFMADD231PD YMM0, YMM2, [R9 + RCX*8]
    mc_vex3(c, 0, 0, 1, 2, 1, 2, 1, 1, 0xB8); mc_b3(c, 0x4C, 0xC9, 0x20) // VFMADD231PD YMM1, YMM2, [R9 + RCX*8 + 32]
    mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x04, 0xC8)       // VMOVUPD [R8 + RCX*8], YMM0
    mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b3(c, 0x4C, 0xC8, 0x20) // VMOVUPD [R8 + RCX*8 + 32], YMM1
    mc_b4(c, 0x48, 0x83, 0xC1, 0x08)                                     // ADD RCX, 8
    mc_b3(c, 0x4C, 0x39, 0xD9)                                           // CMP RCX, R11
    jle_lp8 := mc_jcc8(c, 0x7E)
    mc_patch_jcc8(c, jle_lp8, lp8)
    mc_patch_jcc8(c, jg_lp4, buf_len(c))

    mc_b4(c, 0x4D, 0x8D, 0x5A, 0xFC) // LEA R11, [R10 - 4]
    mc_b3(c, 0x4C, 0x39, 0xD9)       // CMP RCX, R11
    jg_tail := mc_jcc8(c, 0x7F)
    lp4 := buf_len(c)
    mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xC8) // VMOVUPD YMM0, [R8 + RCX*8]
    mc_vex3(c, 0, 0, 1, 2, 1, 2, 1, 1, 0xB8); mc_b2(c, 0x04, 0xC9) // VFMADD231PD YMM0, YMM2, [R9 + RCX*8]
    mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x11); mc_b2(c, 0x04, 0xC8) // VMOVUPD [R8 + RCX*8], YMM0
    mc_b4(c, 0x48, 0x83, 0xC1, 0x04)                               // ADD RCX, 4
    mc_b3(c, 0x4C, 0x39, 0xD9)                                     // CMP RCX, R11
    jle_lp4 := mc_jcc8(c, 0x7E)
    mc_patch_jcc8(c, jle_lp4, lp4)

    mc_patch_jcc8(c, jg_tail, buf_len(c))
    mc_b3(c, 0x4C, 0x39, 0xD1) // CMP RCX, R10
    jge_done := mc_jcc8(c, 0x7D)
    lp1 := buf_len(c)
    mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x10); mc_b2(c, 0x04, 0xC8) // VMOVSD XMM0, [R8 + RCX*8]
    mc_vex3(c, 0, 0, 1, 2, 1, 2, 0, 1, 0xB9); mc_b2(c, 0x04, 0xC9) // VFMADD231SD XMM0, XMM2, [R9 + RCX*8]
    mc_vex3(c, 0, 0, 1, 1, 0, 0, 0, 3, 0x11); mc_b2(c, 0x04, 0xC8) // VMOVSD [R8 + RCX*8], XMM0
    mc_b3(c, 0x48, 0xFF, 0xC1)                                     // INC RCX
    mc_b3(c, 0x4C, 0x39, 0xD1)                                     // CMP RCX, R10
    jl_lp1 := mc_jcc8(c, 0x7C)
    mc_patch_jcc8(c, jl_lp1, lp1)

    mc_patch_jcc8(c, jge_done, buf_len(c))
    mc_b3(c, 0xC5, 0xF8, 0x77) // VZEROUPPER
    if pr_j > 0 { mc_b3(c, 0x48 | gpreg_hi(pr_j), 0x89, 0xC8 | gpreg_hw(pr_j)) } // MOV pr_j, RCX
    else { mc_b3(c, 0x48, 0x89, 0xC8); mc_store_rax(c, j_slot, 0) }
    jmp_end := mc_jmp32(c)
    mc_patch_rel32(c, jz_scalar, buf_len(c))
    // Scalar fallback (`--simd=scalar` or pre-AVX2 CPU)
    if pr_c > 0 { mc_mov_r8_gpreg(c, pr_c) } else { mc_load_r8(c, c_slot, 0) }
    if pr_o1 > 0 { mc_mov_rax_gpreg(c, pr_o1) } else { mc_load_rax(c, o1_slot, 0) }
    mc_b4(c, 0x4D, 0x8D, 0x04, 0xC0)
    if pr_b > 0 { mc_mov_r9_gpreg(c, pr_b) } else { mc_load_r9(c, b_slot, 0) }
    if pr_o2 > 0 { mc_mov_rax_gpreg(c, pr_o2) } else { mc_load_rax(c, o2_slot, 0) }
    mc_b4(c, 0x4D, 0x8D, 0x0C, 0xC1)
    if pr_j > 0 { mc_mov_rcx_gpreg(c, pr_j) } else { mc_load_rcx(c, j_slot, 0) }
    if n_is_imm { mc_mov_rax_imm(c, n_imm); mc_b3(c, 0x49, 0x89, 0xC2) }
    else { pr_n := cg_slot_reg(cg, n_slot); if pr_n > 0 { mc_mov_rax_gpreg(c, pr_n) } else { mc_load_rax(c, n_slot, 0) }; mc_b3(c, 0x49, 0x89, 0xC2) }
    if fr_s > 0 { mc_mov_xmm0_freg(c, fr_s) } else { mc_sse_xmm0_slot(c, 0xF2, 0x10, s_slot, 0) }
    mc_b3(c, 0x0F, 0x28, 0xD0) // MOVAPS XMM2, XMM0
    mc_b3(c, 0x4C, 0x39, 0xD1)
    jge_sd := mc_jcc8(c, 0x7D)
    lps := buf_len(c)
    mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x04, 0xC9) // MOVSD XMM0, [R9 + RCX*8]
    mc_b4(c, 0xF2, 0x0F, 0x59, 0xC2)                       // MULSD XMM0, XMM2
    mc_b4(c, 0xF2, 0x41, 0x0F, 0x58); mc_b2(c, 0x04, 0xC8) // ADDSD XMM0, [R8 + RCX*8]
    mc_b4(c, 0xF2, 0x41, 0x0F, 0x11); mc_b2(c, 0x04, 0xC8) // MOVSD [R8 + RCX*8], XMM0
    mc_b3(c, 0x48, 0xFF, 0xC1)
    mc_b3(c, 0x4C, 0x39, 0xD1)
    jl_lps := mc_jcc8(c, 0x7C)
    mc_patch_jcc8(c, jl_lps, lps)
    mc_patch_jcc8(c, jge_sd, buf_len(c))
    if pr_j > 0 { mc_b3(c, 0x48 | gpreg_hi(pr_j), 0x89, 0xC8 | gpreg_hw(pr_j)) }
    else { mc_b3(c, 0x48, 0x89, 0xC8); mc_store_rax(c, j_slot, 0) }
    mc_patch_rel32(c, jmp_end, buf_len(c))
    if sv10 { mc_load_gpreg(c, s10, 8) }
    if sv11 { mc_load_gpreg(c, s11, 9) }
    if sv8 { mc_load_gpreg(c, s8, 10) }
    return true
}

// Auto-vectorizes 4-wide AVX2 64-bit countdown DP max/min loops:
// `while c >= w { cand := ptr_read_i64(dp, c - w) + v; if cand > ptr_read_i64(dp, c) { ptr_write_i64(dp, c, cand) }; c -= 1 }`
fn try_emit_avx2_dp_max_while_ax(cg: CodegenCtx, vars: IntBuf, snid: i64) -> bool {
    if ibuf_get(cg.state, 17) == 0 { return false }
    cond := ast_get(cg.nodes, snid, 1)
    bnid := ast_get(cg.nodes, snid, 2)
    if cond <= 0 or bnid <= 0 or ast_kind(cg.nodes, cond) != nk_binary() or ast_get(cg.nodes, cond, 1) != op_gte() { return false }
    if ast_kind(cg.nodes, bnid) != nk_block() or ast_get(cg.nodes, bnid, 2) != 3 { return false }

    c_nid := ast_get(cg.nodes, cond, 2); w_nid := ast_get(cg.nodes, cond, 3)
    c_slot := local_scalar_slot_ax(cg, vars, c_nid)
    w_slot := local_scalar_slot_ax(cg, vars, w_nid)
    if c_slot <= 0 or w_slot <= 0 or c_slot == w_slot or immut_local_const_int_node(cg, vars, c_nid) > 0 { return false }
    c_soff := ast_get(cg.nodes, c_nid, 1); c_slen := ast_get(cg.nodes, c_nid, 2)
    w_soff := ast_get(cg.nodes, w_nid, 1); w_slen := ast_get(cg.nodes, w_nid, 2)

    boff := ast_get(cg.nodes, bnid, 1)
    s0 := ibuf_get(cg.extra, boff); s1 := ibuf_get(cg.extra, boff + 1); s2 := ibuf_get(cg.extra, boff + 2)
    if ast_kind(cg.nodes, s0) != nk_var_decl() or ast_kind(cg.nodes, s1) != nk_if() or ast_kind(cg.nodes, s2) != nk_assign() { return false }
    if ast_get(cg.nodes, s1, 3) > 0 { return false }

    // s2: `c -= 1`
    if ast_get(cg.nodes, s2, 1) != aop_sub() or not ast_is_ident_lit(cg, ast_get(cg.nodes, s2, 2), c_soff, c_slen) { return false }
    dec_n := ast_get(cg.nodes, s2, 3)
    if dec_n <= 0 or ast_kind(cg.nodes, dec_n) != nk_int() or ast_get(cg.nodes, dec_n, 1) != 1 { return false }

    // s0: `cand := ptr_read_i64(dp, c - w) + v` (preserve --shield overflow trap on non-wrapping +)
    cand_soff := ast_get(cg.nodes, s0, 1); cand_slen := ast_get(cg.nodes, s0, 2)
    e0 := ast_get(cg.nodes, s0, 5)
    if e0 <= 0 or ast_kind(cg.nodes, e0) != nk_binary() { return false }
    e0_op := ast_get(cg.nodes, e0, 1)
    if e0_op != op_add() and e0_op != op_wrap_add() { return false }
    if e0_op == op_add() and ibuf_get(cg.state, 0) != 0 { return false }
    mut rd_n := ast_get(cg.nodes, e0, 2)
    mut v_n := ast_get(cg.nodes, e0, 3)
    if ast_kind(cg.nodes, rd_n) != nk_call() {
        tmp_n := rd_n; rd_n = v_n; v_n = tmp_n
    }
    if rd_n <= 0 or ast_kind(cg.nodes, rd_n) != nk_call() or ast_get(cg.nodes, rd_n, 4) != 2 { return false }
    if not pool_str_eq_lit(cg.pool, ast_get(cg.nodes, rd_n, 1), ast_get(cg.nodes, rd_n, 2), "ptr_read_i64") { return false }
    v_slot := local_scalar_slot_ax(cg, vars, v_n)
    if v_slot <= 0 or v_slot == c_slot { return false }

    ra0 := ast_get(cg.nodes, rd_n, 3)
    dp_slot := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, ra0), 4))
    idx_n := ast_get(cg.nodes, ibuf_get(cg.extra, ra0 + 1), 4)
    if dp_slot <= 0 or idx_n <= 0 or ast_kind(cg.nodes, idx_n) != nk_binary() or ast_get(cg.nodes, idx_n, 1) != op_sub() { return false }
    if not ast_is_ident_lit(cg, ast_get(cg.nodes, idx_n, 2), c_soff, c_slen) or not ast_is_ident_lit(cg, ast_get(cg.nodes, idx_n, 3), w_soff, w_slen) { return false }

    // s1: `if cand > ptr_read_i64(dp, c) { ptr_write_i64(dp, c, cand) }` (or `<` for min-DP)
    icond := ast_get(cg.nodes, s1, 1); itb := ast_get(cg.nodes, s1, 2)
    if icond <= 0 or itb <= 0 or ast_kind(cg.nodes, icond) != nk_binary() or ast_kind(cg.nodes, itb) != nk_block() or ast_get(cg.nodes, itb, 2) != 1 { return false }
    iop := ast_get(cg.nodes, icond, 1)
    if iop != op_gt() and iop != op_lt() { return false }
    is_min := iop == op_lt()
    if not ast_is_ident_lit(cg, ast_get(cg.nodes, icond, 2), cand_soff, cand_slen) { return false }
    rd2 := ast_get(cg.nodes, icond, 3)
    if rd2 <= 0 or ast_kind(cg.nodes, rd2) != nk_call() or ast_get(cg.nodes, rd2, 4) != 2 { return false }
    if not pool_str_eq_lit(cg.pool, ast_get(cg.nodes, rd2, 1), ast_get(cg.nodes, rd2, 2), "ptr_read_i64") { return false }
    ra2 := ast_get(cg.nodes, rd2, 3)
    if local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, ra2), 4)) != dp_slot { return false }
    if not ast_is_ident_lit(cg, ast_get(cg.nodes, ibuf_get(cg.extra, ra2 + 1), 4), c_soff, c_slen) { return false }

    wst := ibuf_get(cg.extra, ast_get(cg.nodes, itb, 1))
    if ast_kind(cg.nodes, wst) != nk_expr_stmt() { return false }
    wr := ast_get(cg.nodes, wst, 1)
    if wr <= 0 or ast_kind(cg.nodes, wr) != nk_call() or ast_get(cg.nodes, wr, 4) != 3 { return false }
    if not pool_str_eq_lit(cg.pool, ast_get(cg.nodes, wr, 1), ast_get(cg.nodes, wr, 2), "ptr_write_i64") { return false }
    wa := ast_get(cg.nodes, wr, 3)
    if local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, wa), 4)) != dp_slot { return false }
    if not ast_is_ident_lit(cg, ast_get(cg.nodes, ibuf_get(cg.extra, wa + 1), 4), c_soff, c_slen) { return false }
    if not ast_is_ident_lit(cg, ast_get(cg.nodes, ibuf_get(cg.extra, wa + 2), 4), cand_soff, cand_slen) { return false }

    // Shared setup: R9=dp, R11=w, R8=dp-w*8, RCX=c, RDX=v (read all inputs before writing R11!)
    c := cg.code
    pr_dp := cg_slot_reg(cg, dp_slot); pr_w := cg_slot_reg(cg, w_slot)
    pr_c := cg_slot_reg(cg, c_slot); pr_v := cg_slot_reg(cg, v_slot)
    sv10 := cg_get_gpr_slot(cg, 8) > 0 and pr_c != 8
    sv11 := cg_get_gpr_slot(cg, 9) > 0 and pr_c != 9
    sv8 := cg_get_gpr_slot(cg, 10) > 0 and pr_c != 10
    mut s10 := 0; mut s11 := 0; mut s8 := 0
    if sv10 { s10 = cg_alloc_slots(cg, 1); mc_store_gpreg(c, s10, 8) }
    if sv11 { s11 = cg_alloc_slots(cg, 1); mc_store_gpreg(c, s11, 9) }
    if sv8 { s8 = cg_alloc_slots(cg, 1); mc_store_gpreg(c, s8, 10) }
    if pr_dp > 0 { mc_mov_r9_gpreg(c, pr_dp) } else { mc_load_r9(c, dp_slot, 0) }
    if pr_c > 0 { mc_mov_rcx_gpreg(c, pr_c) } else { mc_load_rcx(c, c_slot, 0) }
    if pr_v > 0 { mc_mov_rdx_gpreg(c, pr_v) } else { mc_load_rdx(c, v_slot, 0) }
    if pr_w > 0 { mc_mov_rax_gpreg(c, pr_w) } else { mc_load_rax(c, w_slot, 0) }
    mc_b3(c, 0x49, 0x89, 0xC3)       // MOV R11, RAX (w)
    mc_b3(c, 0x48, 0xF7, 0xD8)       // NEG RAX (-w)
    mc_b4(c, 0x4D, 0x8D, 0x04, 0xC1) // LEA R8, [R9 + RAX*8] (dp - w*8)

    // Runtime CPUID guard + `w >= 4` alias-freedom guard
    cg_mov_rax_data(cg, data_off_simd_tier())
    mc_b3(c, 0x48, 0x85, 0xC0)
    jz_scalar := mc_jcc32(c, 0x84)
    mc_b4(c, 0x49, 0x83, 0xFB, 0x04) // CMP R11, 4
    jl_w_small := mc_jcc32(c, 0x8C)
    mc_b4(c, 0x4D, 0x8D, 0x53, 0x03) // LEA R10, [R11 + 3]
    mc_b3(c, 0x4C, 0x39, 0xD1)       // CMP RCX, R10
    jl_tail_pre := mc_jcc32(c, 0x8C)

    // Broadcast v (RDX) -> YMM2
    mc_vex3(c, 0, 0, 0, 1, 1, 0, 0, 1, 0x6E); mc_b1(c, 0xC2) // VMOVQ XMM0, RDX
    mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x59); mc_b1(c, 0xD0) // VPBROADCASTQ YMM2, XMM0

    mc_align16_nop(c)
    lp4 := buf_len(c)
    mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x4C, 0xC8, 0xE8) // VMOVDQU YMM1, [R8 + RCX*8 - 24]
    mc_vex3(c, 0, 0, 0, 1, 0, 1, 1, 1, 0xD4); mc_b1(c, 0xCA)             // VPADDQ  YMM1, YMM1, YMM2
    mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x6F); mc_b3(c, 0x44, 0xC9, 0xE8) // VMOVDQU YMM0, [R9 + RCX*8 - 24]
    if is_min {
        mc_vex3(c, 0, 0, 0, 2, 0, 0, 1, 1, 0x37); mc_b1(c, 0xD9)         // VPCMPGTQ YMM3, YMM0, YMM1
    } else {
        mc_vex3(c, 0, 0, 0, 2, 0, 1, 1, 1, 0x37); mc_b1(c, 0xD8)         // VPCMPGTQ YMM3, YMM1, YMM0
    }
    mc_vex3(c, 0, 0, 0, 3, 0, 0, 1, 1, 0x4B); mc_b2(c, 0xC1, 0x30)       // VBLENDVPD YMM0, YMM0, YMM1, YMM3
    mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 2, 0x7F); mc_b3(c, 0x44, 0xC9, 0xE8) // VMOVDQU [R9 + RCX*8 - 24], YMM0
    mc_b4(c, 0x48, 0x83, 0xE9, 0x04)                                     // SUB RCX, 4
    mc_b3(c, 0x4C, 0x39, 0xD1)                                           // CMP RCX, R10
    jge_lp4 := mc_jcc8(c, 0x7D)
    mc_patch_jcc8(c, jge_lp4, lp4)
    mc_b3(c, 0xC5, 0xF8, 0x77)                                           // VZEROUPPER

    // Branchless CMOVG/CMOVL scalar tail (shared with `w < 4` & `--simd=scalar`)
    tail_pos := buf_len(c)
    mc_patch_rel32(c, jz_scalar, tail_pos)
    mc_patch_rel32(c, jl_w_small, tail_pos)
    mc_patch_rel32(c, jl_tail_pre, tail_pos)
    mc_b3(c, 0x4C, 0x39, 0xD9) // CMP RCX, R11
    jl_done := mc_jcc8(c, 0x7C)
    lp1 := buf_len(c)
    mc_b4(c, 0x49, 0x8B, 0x04, 0xC8) // MOV RAX, [R8 + RCX*8]
    mc_b3(c, 0x48, 0x01, 0xD0)       // ADD RAX, RDX
    mc_b4(c, 0x4D, 0x8B, 0x14, 0xC9) // MOV R10, [R9 + RCX*8]
    mc_b3(c, 0x4C, 0x39, 0xD0)       // CMP RAX, R10
    if is_min { mc_b4(c, 0x4C, 0x0F, 0x4C, 0xD0) } // CMOVL R10, RAX
    else      { mc_b4(c, 0x4C, 0x0F, 0x4F, 0xD0) } // CMOVG R10, RAX
    mc_b4(c, 0x4D, 0x89, 0x14, 0xC9) // MOV [R9 + RCX*8], R10
    mc_b3(c, 0x48, 0xFF, 0xC9)       // DEC RCX
    mc_b3(c, 0x4C, 0x39, 0xD9)       // CMP RCX, R11
    jge_lp1 := mc_jcc8(c, 0x7D)
    mc_patch_jcc8(c, jge_lp1, lp1)
    mc_patch_jcc8(c, jl_done, buf_len(c))
    if pr_c > 0 { mc_b3(c, 0x48 | gpreg_hi(pr_c), 0x89, 0xC8 | gpreg_hw(pr_c)) }
    else { mc_b3(c, 0x48, 0x89, 0xC8); mc_store_rax(c, c_slot, 0) }
    if sv10 { mc_load_gpreg(c, s10, 8) }
    if sv11 { mc_load_gpreg(c, s11, 9) }
    if sv8 { mc_load_gpreg(c, s8, 10) }
    return true
}

fn mc_xmm_rbp_op(c: ByteBuf, pfx: i64, op2: i64, xreg: i64, slot: i64) {
    if pfx != 0 { mc_b1(c, pfx) }
    if (xreg >> 3) != 0 { mc_b1(c, 0x44) }
    mc_b2(c, 0x0F, op2)
    disp := 0 - slot * 8
    hw := xreg & 7
    if disp >= -128 and disp <= 127 { mc_b2(c, 0x45 | (hw << 3), disp & 255) }
    else { mc_b1(c, 0x85 | (hw << 3)); mc_u32(c, disp) }
}

fn mc_vbroadcastsd_rbp(c: ByteBuf, ydst: i64, slot: i64) {
    mc_vex3(c, ydst >> 3, 0, 0, 2, 0, 0, 1, 1, 0x19)
    disp := 0 - slot * 8
    hw := ydst & 7
    if disp >= -128 and disp <= 127 { mc_b2(c, 0x45 | (hw << 3), disp & 255) }
    else { mc_b1(c, 0x85 | (hw << 3)); mc_u32(c, disp) }
}

fn mc_vbroadcastsd_rdata(cg: CodegenCtx, ydst: i64, roff: i64) {
    mc_vex3(cg.code, ydst >> 3, 0, 0, 2, 0, 0, 1, 1, 0x19)
    mc_b1(cg.code, 0x05 | ((ydst & 7) << 3))
    dp := buf_len(cg.code); buf_push_u32(cg.code, 0)
    cg_add_fixup(cg.fixups, dp, buf_len(cg.code), fx_rdata() | (roff << 8))
}

fn mc_addsd_fslot_xmm(cg: CodegenCtx, f_slot: i64, src_xmm: i64) {
    c := cg.code
    fr := cg_slot_freg(cg, f_slot)
    if fr > 0 {
        dst := 5 + fr
        mc_b1(c, 0xF2)
        if (dst >> 3) != 0 { mc_b1(c, 0x44) }
        mc_b3(c, 0x0F, 0x58, 0xC0 | ((dst & 7) << 3) | src_xmm)
    } else {
        mc_xmm_rbp_op(c, 0xF2, 0x58, src_xmm, f_slot)
        mc_xmm_rbp_op(c, 0xF2, 0x11, src_xmm, f_slot)
    }
}

fn mc_subsd_xmm_fslot(cg: CodegenCtx, dst_xmm: i64, f_slot: i64) {
    c := cg.code
    fr := cg_slot_freg(cg, f_slot)
    if fr > 0 {
        sreg := 5 + fr
        mc_b1(c, 0xF2)
        if (sreg >> 3) != 0 { mc_b1(c, 0x41) }
        mc_b3(c, 0x0F, 0x5C, 0xC0 | (dst_xmm << 3) | (sreg & 7))
    } else {
        mc_xmm_rbp_op(c, 0xF2, 0x5C, dst_xmm, f_slot)
    }
}

fn match_nbody_diff_ax(cg: CodegenCtx, vars: IntBuf, st: i64, b_soff: i64, b_slen: i64) -> i64 {
    if ast_kind(cg.nodes, st) != nk_var_decl() { return 0 }
    ie := ast_get(cg.nodes, st, 5)
    if ie <= 0 or ast_kind(cg.nodes, ie) != nk_binary() or ast_get(cg.nodes, ie, 1) != op_sub() { return 0 }
    rd := ast_get(cg.nodes, ie, 2); av := ast_get(cg.nodes, ie, 3)
    if rd <= 0 or ast_kind(cg.nodes, rd) != nk_call() or ast_get(cg.nodes, rd, 4) != 2 { return 0 }
    if not pool_str_eq_lit(cg.pool, ast_get(cg.nodes, rd, 1), ast_get(cg.nodes, rd, 2), "ptr_read_f64") { return 0 }
    ra := ast_get(cg.nodes, rd, 3)
    psl := local_scalar_slot_ax(cg, vars, ast_get(cg.nodes, ibuf_get(cg.extra, ra), 4))
    if psl <= 0 or not ast_is_ident_lit(cg, ast_get(cg.nodes, ibuf_get(cg.extra, ra + 1), 4), b_soff, b_slen) { return 0 }
    asl := local_f64_slot_ax(cg, vars, av)
    if asl <= 0 { return 0 }
    return psl | (asl << 32)
}

fn match_nbody_sq_ax(cg: CodegenCtx, nid: i64, s_soff: i64, s_slen: i64) -> bool {
    if nid <= 0 or ast_kind(cg.nodes, nid) != nk_binary() or ast_get(cg.nodes, nid, 1) != op_mul() { return false }
    return ast_is_ident_lit(cg, ast_get(cg.nodes, nid, 2), s_soff, s_slen) and ast_is_ident_lit(cg, ast_get(cg.nodes, nid, 3), s_soff, s_slen)
}

fn match_nbody_acc_ax(cg: CodegenCtx, vars: IntBuf, st: i64, d_soff: i64, d_slen: i64, inv_soff: i64, inv_slen: i64) -> i64 {
    if ast_kind(cg.nodes, st) != nk_assign() { return 0 }
    aop := ast_get(cg.nodes, st, 1); tgt := ast_get(cg.nodes, st, 2); rhs := ast_get(cg.nodes, st, 3)
    fsl := local_f64_slot_ax(cg, vars, tgt)
    if fsl <= 0 or rhs <= 0 { return 0 }
    mut mul_n := 0
    if aop == aop_add() {
        mul_n = rhs
    } else if aop == aop_eq() and ast_kind(cg.nodes, rhs) == nk_binary() and ast_get(cg.nodes, rhs, 1) == op_add() {
        t_soff := ast_get(cg.nodes, tgt, 1); t_slen := ast_get(cg.nodes, tgt, 2)
        if ast_is_ident_lit(cg, ast_get(cg.nodes, rhs, 2), t_soff, t_slen) { mul_n = ast_get(cg.nodes, rhs, 3) }
        else if ast_is_ident_lit(cg, ast_get(cg.nodes, rhs, 3), t_soff, t_slen) { mul_n = ast_get(cg.nodes, rhs, 2) }
    }
    if mul_n <= 0 or ast_kind(cg.nodes, mul_n) != nk_binary() or ast_get(cg.nodes, mul_n, 1) != op_mul() { return 0 }
    ml := ast_get(cg.nodes, mul_n, 2); mr := ast_get(cg.nodes, mul_n, 3)
    if (ast_is_ident_lit(cg, ml, d_soff, d_slen) and ast_is_ident_lit(cg, mr, inv_soff, inv_slen)) or (ast_is_ident_lit(cg, mr, d_soff, d_slen) and ast_is_ident_lit(cg, ml, inv_soff, inv_slen)) {
        return fsl
    }
    return 0
}

// Auto-vectorizes 4-wide AVX2+FMA3 3D inverse-cube pairwise force reduction loops (`N-Body` / Coulomb / Gravity)
fn try_emit_avx2_nbody_while_ax(cg: CodegenCtx, vars: IntBuf, snid: i64) -> bool {
    if ibuf_get(cg.state, 17) == 0 or (ibuf_get(cg.state, 18) & fnflag_nan_guard()) != 0 { return false }
    cond := ast_get(cg.nodes, snid, 1)
    bnid := ast_get(cg.nodes, snid, 2)
    if cond <= 0 or bnid <= 0 or ast_kind(cg.nodes, cond) != nk_binary() or ast_get(cg.nodes, cond, 1) != op_lt() { return false }
    if ast_kind(cg.nodes, bnid) != nk_block() or ast_get(cg.nodes, bnid, 2) != 2 { return false }

    b_nid := ast_get(cg.nodes, cond, 2); n_nid := ast_get(cg.nodes, cond, 3)
    b_slot := local_scalar_slot_ax(cg, vars, b_nid)
    if b_slot <= 0 or immut_local_const_int_node(cg, vars, b_nid) > 0 { return false }
    b_soff := ast_get(cg.nodes, b_nid, 1); b_slen := ast_get(cg.nodes, b_nid, 2)
    n_is_imm := is_folded_const_int_ax(cg, vars, n_nid)
    mut n_imm := 0; mut n_slot := 0
    if n_is_imm { n_imm = eval_folded_const_int_ax(cg, vars, n_nid) }
    else { n_slot = local_scalar_slot_ax(cg, vars, n_nid); if n_slot <= 0 { return false } }

    boff := ast_get(cg.nodes, bnid, 1)
    s_if := ibuf_get(cg.extra, boff); s_inc := ibuf_get(cg.extra, boff + 1)
    if ast_kind(cg.nodes, s_if) != nk_if() or ast_get(cg.nodes, s_if, 3) > 0 or ast_kind(cg.nodes, s_inc) != nk_assign() { return false }
    if ast_get(cg.nodes, s_inc, 1) != aop_add() or not ast_is_ident_lit(cg, ast_get(cg.nodes, s_inc, 2), b_soff, b_slen) { return false }
    inc_n := ast_get(cg.nodes, s_inc, 3)
    if inc_n <= 0 or ast_kind(cg.nodes, inc_n) != nk_int() or ast_get(cg.nodes, inc_n, 1) != 1 { return false }

    // `if a != b { ... }` (8 statements)
    icond := ast_get(cg.nodes, s_if, 1); itb := ast_get(cg.nodes, s_if, 2)
    if icond <= 0 or itb <= 0 or ast_kind(cg.nodes, icond) != nk_binary() or ast_get(cg.nodes, icond, 1) != op_neq() { return false }
    mut a_nid := 0
    if ast_is_ident_lit(cg, ast_get(cg.nodes, icond, 3), b_soff, b_slen) { a_nid = ast_get(cg.nodes, icond, 2) }
    else if ast_is_ident_lit(cg, ast_get(cg.nodes, icond, 2), b_soff, b_slen) { a_nid = ast_get(cg.nodes, icond, 3) }
    a_slot := local_scalar_slot_ax(cg, vars, a_nid)
    if a_slot <= 0 or a_slot == b_slot { return false }
    if ast_kind(cg.nodes, itb) != nk_block() or ast_get(cg.nodes, itb, 2) != 8 { return false }

    ioff := ast_get(cg.nodes, itb, 1)
    st0 := ibuf_get(cg.extra, ioff); st1 := ibuf_get(cg.extra, ioff + 1); st2 := ibuf_get(cg.extra, ioff + 2)
    st3 := ibuf_get(cg.extra, ioff + 3); st4 := ibuf_get(cg.extra, ioff + 4)
    st5 := ibuf_get(cg.extra, ioff + 5); st6 := ibuf_get(cg.extra, ioff + 6); st7 := ibuf_get(cg.extra, ioff + 7)

    mx := match_nbody_diff_ax(cg, vars, st0, b_soff, b_slen)
    my := match_nbody_diff_ax(cg, vars, st1, b_soff, b_slen)
    mz := match_nbody_diff_ax(cg, vars, st2, b_soff, b_slen)
    if mx == 0 or my == 0 or mz == 0 { return false }
    px_slot := mx & 0xFFFFFFFF; ax_slot := ushr64(mx, 32)
    py_slot := my & 0xFFFFFFFF; ay_slot := ushr64(my, 32)
    pz_slot := mz & 0xFFFFFFFF; az_slot := ushr64(mz, 32)
    dx_s := ast_get(cg.nodes, st0, 1); dx_l := ast_get(cg.nodes, st0, 2)
    dy_s := ast_get(cg.nodes, st1, 1); dy_l := ast_get(cg.nodes, st1, 2)
    dz_s := ast_get(cg.nodes, st2, 1); dz_l := ast_get(cg.nodes, st2, 2)

    // st3: `d2 := dx*dx + dy*dy + dz*dz + eps` (eps literal > 0.0)
    if ast_kind(cg.nodes, st3) != nk_var_decl() { return false }
    d2_s := ast_get(cg.nodes, st3, 1); d2_l := ast_get(cg.nodes, st3, 2)
    d2_e := ast_get(cg.nodes, st3, 5)
    if d2_e <= 0 or ast_kind(cg.nodes, d2_e) != nk_binary() or ast_get(cg.nodes, d2_e, 1) != op_add() { return false }
    eps_n := ast_get(cg.nodes, d2_e, 3)
    if eps_n <= 0 or ast_kind(cg.nodes, eps_n) != nk_float() { return false }
    eps_bits := ast_get(cg.nodes, eps_n, 1)
    if eps_bits <= 0 or eps_bits >= 0x7FF0000000000000 { return false }
    t2 := ast_get(cg.nodes, d2_e, 2)
    if t2 <= 0 or ast_kind(cg.nodes, t2) != nk_binary() or ast_get(cg.nodes, t2, 1) != op_add() { return false }
    if not match_nbody_sq_ax(cg, ast_get(cg.nodes, t2, 3), dz_s, dz_l) { return false }
    t1 := ast_get(cg.nodes, t2, 2)
    if t1 <= 0 or ast_kind(cg.nodes, t1) != nk_binary() or ast_get(cg.nodes, t1, 1) != op_add() { return false }
    if not match_nbody_sq_ax(cg, ast_get(cg.nodes, t1, 2), dx_s, dx_l) or not match_nbody_sq_ax(cg, ast_get(cg.nodes, t1, 3), dy_s, dy_l) { return false }

    // st4: `inv := num_lit / (d2 * sqrt_f64(d2))`
    if ast_kind(cg.nodes, st4) != nk_var_decl() { return false }
    inv_s := ast_get(cg.nodes, st4, 1); inv_l := ast_get(cg.nodes, st4, 2)
    inv_e := ast_get(cg.nodes, st4, 5)
    if inv_e <= 0 or ast_kind(cg.nodes, inv_e) != nk_binary() or ast_get(cg.nodes, inv_e, 1) != op_div() { return false }
    num_n := ast_get(cg.nodes, inv_e, 2); den_n := ast_get(cg.nodes, inv_e, 3)
    if num_n <= 0 or ast_kind(cg.nodes, num_n) != nk_float() { return false }
    num_bits := ast_get(cg.nodes, num_n, 1)
    if den_n <= 0 or ast_kind(cg.nodes, den_n) != nk_binary() or ast_get(cg.nodes, den_n, 1) != op_mul() { return false }
    mut sq_c := 0
    if ast_is_ident_lit(cg, ast_get(cg.nodes, den_n, 2), d2_s, d2_l) { sq_c = ast_get(cg.nodes, den_n, 3) }
    else if ast_is_ident_lit(cg, ast_get(cg.nodes, den_n, 3), d2_s, d2_l) { sq_c = ast_get(cg.nodes, den_n, 2) }
    if sq_c <= 0 or ast_kind(cg.nodes, sq_c) != nk_call() or ast_get(cg.nodes, sq_c, 4) != 1 { return false }
    if not pool_str_eq_lit(cg.pool, ast_get(cg.nodes, sq_c, 1), ast_get(cg.nodes, sq_c, 2), "sqrt_f64") { return false }
    if not ast_is_ident_lit(cg, ast_get(cg.nodes, ibuf_get(cg.extra, ast_get(cg.nodes, sq_c, 3)), 4), d2_s, d2_l) { return false }

    fx_slot := match_nbody_acc_ax(cg, vars, st5, dx_s, dx_l, inv_s, inv_l)
    fy_slot := match_nbody_acc_ax(cg, vars, st6, dy_s, dy_l, inv_s, inv_l)
    fz_slot := match_nbody_acc_ax(cg, vars, st7, dz_s, dz_l, inv_s, inv_l)
    if fx_slot <= 0 or fy_slot <= 0 or fz_slot <= 0 { return false }

    // Intern rdata constants: eps, num, iota[0,1,2,3], four[4,4,4,4]
    roff_eps := cg_intern_u64_rdata(cg, eps_bits, false)
    roff_num := cg_intern_u64_rdata(cg, num_bits, false)
    while (buf_len(cg.rdata) & 31) != 0 { buf_push(cg.rdata, 0) }
    roff_iota := buf_len(cg.rdata)
    buf_push_u64(cg.rdata, 0); buf_push_u64(cg.rdata, 1); buf_push_u64(cg.rdata, 2); buf_push_u64(cg.rdata, 3)
    roff_four := buf_len(cg.rdata)
    buf_push_u64(cg.rdata, 4); buf_push_u64(cg.rdata, 4); buf_push_u64(cg.rdata, 4); buf_push_u64(cg.rdata, 4)

    // Shared volatile GPR setup: R8=px, R9=py, R10=pz, RCX=b, RDX=n, RAX=a (preserve R10/R11 if live!)
    c := cg.code
    pr_px := cg_slot_reg(cg, px_slot); pr_py := cg_slot_reg(cg, py_slot); pr_pz := cg_slot_reg(cg, pz_slot)
    pr_b := cg_slot_reg(cg, b_slot); pr_a := cg_slot_reg(cg, a_slot)
    sv10 := cg_get_gpr_slot(cg, 8) > 0 and pr_b != 8
    sv11 := cg_get_gpr_slot(cg, 9) > 0 and pr_b != 9
    sv8 := cg_get_gpr_slot(cg, 10) > 0 and pr_b != 10
    mut s10 := 0; mut s11 := 0; mut s8 := 0
    if sv10 { s10 = cg_alloc_slots(cg, 1); mc_store_gpreg(c, s10, 8) }
    if sv11 { s11 = cg_alloc_slots(cg, 1); mc_store_gpreg(c, s11, 9) }
    if sv8 { s8 = cg_alloc_slots(cg, 1); mc_store_gpreg(c, s8, 10) }
    if pr_px > 0 { mc_mov_r8_gpreg(c, pr_px) } else { mc_load_r8(c, px_slot, 0) }
    if pr_py == 10 { mc_load_r9(c, s8, 0) } else if pr_py > 0 { mc_mov_r9_gpreg(c, pr_py) } else { mc_load_r9(c, py_slot, 0) }
    if pr_b == 10 { mc_load_rcx(c, s8, 0) } else if pr_b > 0 { mc_mov_rcx_gpreg(c, pr_b) } else { mc_load_rcx(c, b_slot, 0) }
    if n_is_imm {
        mc_mov_rax_imm(c, n_imm); mc_b3(c, 0x48, 0x89, 0xC2) // MOV RDX, RAX
    } else {
        pr_n := cg_slot_reg(cg, n_slot)
        if pr_n == 10 { mc_load_rdx(c, s8, 0) } else if pr_n > 0 { mc_mov_rdx_gpreg(c, pr_n) } else { mc_load_rdx(c, n_slot, 0) }
    }
    if pr_pz == 10 { mc_load_rax(c, s8, 0) } else if pr_pz > 0 { mc_mov_rax_gpreg(c, pr_pz) } else { mc_load_rax(c, pz_slot, 0) }
    mc_b3(c, 0x49, 0x89, 0xC2) // MOV R10, RAX
    if pr_a == 8 { mc_load_rax(c, s10, 0) } else if pr_a == 9 { mc_load_rax(c, s11, 0) } else if pr_a == 10 { mc_load_rax(c, s8, 0) }
    else if pr_a > 0 { mc_mov_rax_gpreg(c, pr_a) } else { mc_load_rax(c, a_slot, 0) }

    // Runtime CPUID guard (`g_simd_tier >= 1`) + `b <= n - 4`
    mc_b4(c, 0x4C, 0x8D, 0x5A, 0xFC) // LEA R11, [RDX - 4]
    mc_b3(c, 0x4C, 0x39, 0xD9)       // CMP RCX, R11
    jg_skip_vec := mc_jcc32(c, 0x8F)
    cg_mov_rax_data(cg, data_off_simd_tier())
    mc_b3(c, 0x48, 0x85, 0xC0)
    jz_scalar := mc_jcc32(c, 0x84)
    if pr_a == 8 { mc_load_rax(c, s10, 0) } else if pr_a == 9 { mc_load_rax(c, s11, 0) } else if pr_a == 10 { mc_load_rax(c, s8, 0) }
    else if pr_a > 0 { mc_mov_rax_gpreg(c, pr_a) } else { mc_load_rax(c, a_slot, 0) }

    // Save XMM6..XMM15 in RBP frame (preserves Win64 callee-saved XMMs & outer promoted f64 vars!)
    save_xmm := cg_alloc_slots(cg, 20)
    mut si := 0
    while si < 10 {
        mc_xmm_rbp_op(c, 0, 0x11, 6 + si, save_xmm + si * 2 + 1)
        si += 1
    }
    fr_ax := cg_slot_freg(cg, ax_slot); fr_ay := cg_slot_freg(cg, ay_slot); fr_az := cg_slot_freg(cg, az_slot)
    if fr_ax > 0 { mc_vbroadcastsd_rbp(c, 6, save_xmm + (fr_ax - 1) * 2 + 1) } else { mc_vbroadcastsd_rbp(c, 6, ax_slot) }
    if fr_ay > 0 { mc_vbroadcastsd_rbp(c, 7, save_xmm + (fr_ay - 1) * 2 + 1) } else { mc_vbroadcastsd_rbp(c, 7, ay_slot) }
    if fr_az > 0 { mc_vbroadcastsd_rbp(c, 8, save_xmm + (fr_az - 1) * 2 + 1) } else { mc_vbroadcastsd_rbp(c, 8, az_slot) }
    mc_vbroadcastsd_rdata(cg, 9, roff_eps)
    mc_vbroadcastsd_rdata(cg, 10, roff_num)
    // Zero accumulators YMM11, YMM12, YMM13
    mc_vex3(c, 1, 0, 1, 1, 0, 11, 1, 1, 0x57); mc_b1(c, 0xDB) // VXORPD YMM11, YMM11, YMM11
    mc_vex3(c, 1, 0, 1, 1, 0, 12, 1, 1, 0x57); mc_b1(c, 0xE4) // VXORPD YMM12, YMM12, YMM12
    mc_vex3(c, 1, 0, 1, 1, 0, 13, 1, 1, 0x57); mc_b1(c, 0xED) // VXORPD YMM13, YMM13, YMM13
    // YMM14 = [b, b+1, b+2, b+3], YMM15 = [a, a, a, a]
    mc_vex3(c, 1, 0, 0, 1, 1, 0, 0, 1, 0x6E); mc_b1(c, 0xF1) // VMOVQ XMM14, RCX
    mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x59); mc_b1(c, 0xF6) // VPBROADCASTQ YMM14, XMM14
    mc_vex3(c, 1, 0, 0, 1, 0, 14, 1, 1, 0xD4); mc_b1(c, 0x35)
    dp_iota := buf_len(c); buf_push_u32(c, 0)
    cg_add_fixup(cg.fixups, dp_iota, buf_len(c), fx_rdata() | (roff_iota << 8))
    mc_vex3(c, 1, 0, 0, 1, 1, 0, 0, 1, 0x6E); mc_b1(c, 0xF8) // VMOVQ XMM15, RAX
    mc_vex3(c, 1, 0, 1, 2, 0, 0, 1, 1, 0x59); mc_b1(c, 0xFF) // VPBROADCASTQ YMM15, XMM15

    mc_align16_nop(c)
    lp4 := buf_len(c)
    mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x04, 0xC8) // VMOVUPD YMM0, [R8 + RCX*8]
    mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x5C); mc_b1(c, 0xC6)       // VSUBPD  YMM0, YMM0, YMM6
    mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x0C, 0xC9) // VMOVUPD YMM1, [R9 + RCX*8]
    mc_vex3(c, 0, 0, 0, 1, 0, 1, 1, 1, 0x5C); mc_b1(c, 0xCF)       // VSUBPD  YMM1, YMM1, YMM7
    mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x10); mc_b2(c, 0x14, 0xCA) // VMOVUPD YMM2, [R10 + RCX*8]
    mc_vex3(c, 0, 0, 1, 1, 0, 2, 1, 1, 0x5C); mc_b1(c, 0xD0)       // VSUBPD  YMM2, YMM2, YMM8
    mc_vex3(c, 0, 0, 1, 1, 0, 0, 1, 1, 0x28); mc_b1(c, 0xD9)       // VMOVAPD YMM3, YMM9 (eps)
    mc_vex3(c, 0, 0, 0, 2, 1, 0, 1, 1, 0xB8); mc_b1(c, 0xD8)       // VFMADD231PD YMM3, YMM0, YMM0
    mc_vex3(c, 0, 0, 0, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xD9)       // VFMADD231PD YMM3, YMM1, YMM1
    mc_vex3(c, 0, 0, 0, 2, 1, 2, 1, 1, 0xB8); mc_b1(c, 0xDA)       // VFMADD231PD YMM3, YMM2, YMM2
    mc_vex3(c, 0, 0, 0, 1, 0, 0, 1, 1, 0x51); mc_b1(c, 0xE3)       // VSQRTPD YMM4, YMM3
    mc_vex3(c, 0, 0, 0, 1, 0, 4, 1, 1, 0x59); mc_b1(c, 0xE3)       // VMULPD  YMM4, YMM4, YMM3
    mc_vex3(c, 0, 0, 0, 1, 0, 10, 1, 1, 0x5E); mc_b1(c, 0xE4)      // VDIVPD  YMM4, YMM10, YMM4
    mc_vex3(c, 0, 0, 1, 2, 0, 14, 1, 1, 0x29); mc_b1(c, 0xEF)      // VPCMPEQQ YMM5, YMM14, YMM15
    mc_vex3(c, 0, 0, 0, 1, 0, 5, 1, 1, 0x55); mc_b1(c, 0xE4)       // VANDNPD YMM4, YMM5, YMM4 (mask b==a)
    mc_vex3(c, 1, 0, 0, 1, 0, 14, 1, 1, 0xD4); mc_b1(c, 0x35)      // VPADDQ  YMM14, YMM14, [RIP+four]
    dp_four := buf_len(c); buf_push_u32(c, 0)
    cg_add_fixup(cg.fixups, dp_four, buf_len(c), fx_rdata() | (roff_four << 8))
    mc_vex3(c, 1, 0, 0, 2, 1, 0, 1, 1, 0xB8); mc_b1(c, 0xDC)       // VFMADD231PD YMM11, YMM0, YMM4
    mc_vex3(c, 1, 0, 0, 2, 1, 1, 1, 1, 0xB8); mc_b1(c, 0xE4)       // VFMADD231PD YMM12, YMM1, YMM4
    mc_vex3(c, 1, 0, 0, 2, 1, 2, 1, 1, 0xB8); mc_b1(c, 0xEC)       // VFMADD231PD YMM13, YMM2, YMM4
    mc_b4(c, 0x48, 0x83, 0xC1, 0x04)                               // ADD RCX, 4
    mc_b3(c, 0x4C, 0x39, 0xD9)                                     // CMP RCX, R11
    jle_lp4 := mc_jcc32(c, 0x8E)
    mc_patch_rel32(c, jle_lp4, lp4)

    // Horizontal reduce YMM11->XMM0, YMM12->XMM1, YMM13->XMM2
    mut hi_k := 0
    while hi_k < 3 {
        s_ymm := 11 + hi_k
        mc_vex3(c, 1, 0, 0, 3, 0, 0, 1, 1, 0x19); mc_b2(c, 0xC3 | ((s_ymm & 7) << 3), 1)
        mc_vex3(c, 0, 0, 0, 1, 0, s_ymm, 0, 1, 0x58); mc_b1(c, 0xC3 | (hi_k << 3))
        mc_vex3(c, 0, 0, 0, 1, 0, hi_k, 0, 1, 0x15); mc_b1(c, 0xD8 | hi_k)
        mc_vex3(c, 0, 0, 0, 1, 0, hi_k, 0, 3, 0x58); mc_b1(c, 0xC3 | (hi_k << 3))
        hi_k += 1
    }
    mc_b3(c, 0xC5, 0xF8, 0x77) // VZEROUPPER

    // Restore XMM6..XMM15, then add XMM0/1/2 -> fx/fy/fz
    si = 0
    while si < 10 {
        mc_xmm_rbp_op(c, 0, 0x10, 6 + si, save_xmm + si * 2 + 1)
        si += 1
    }
    mc_addsd_fslot_xmm(cg, fx_slot, 0)
    mc_addsd_fslot_xmm(cg, fy_slot, 1)
    mc_addsd_fslot_xmm(cg, fz_slot, 2)

    // Scalar SSE2 tail (shared with `b > n - 4` and `--simd=scalar`)
    mc_patch_rel32(c, jz_scalar, buf_len(c))
    if pr_a == 8 { mc_load_rax(c, s10, 0) } else if pr_a == 9 { mc_load_rax(c, s11, 0) }
    else if pr_a > 0 { mc_mov_rax_gpreg(c, pr_a) } else { mc_load_rax(c, a_slot, 0) }
    mc_patch_rel32(c, jg_skip_vec, buf_len(c))
    mc_b3(c, 0x48, 0x39, 0xD1) // CMP RCX, RDX
    jge_done := mc_jcc32(c, 0x8D)
    lps := buf_len(c)
    mc_b3(c, 0x48, 0x39, 0xC1) // CMP RCX, RAX (b == a)
    je_skip := mc_jcc32(c, 0x84)
    mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x04, 0xC8) // MOVSD XMM0, [R8 + RCX*8]
    mc_subsd_xmm_fslot(cg, 0, ax_slot)
    mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0xC9) // MOVSD XMM1, [R9 + RCX*8]
    mc_subsd_xmm_fslot(cg, 1, ay_slot)
    mc_b4(c, 0xF2, 0x41, 0x0F, 0x10); mc_b2(c, 0x14, 0xCA) // MOVSD XMM2, [R10 + RCX*8]
    mc_subsd_xmm_fslot(cg, 2, az_slot)
    mc_b3(c, 0x0F, 0x28, 0xD8); mc_b4(c, 0xF2, 0x0F, 0x59, 0xD8) // XMM3 = dx*dx
    mc_b3(c, 0x0F, 0x28, 0xE1); mc_b4(c, 0xF2, 0x0F, 0x59, 0xE1); mc_b4(c, 0xF2, 0x0F, 0x58, 0xDC) // += dy*dy
    mc_b3(c, 0x0F, 0x28, 0xE2); mc_b4(c, 0xF2, 0x0F, 0x59, 0xE2); mc_b4(c, 0xF2, 0x0F, 0x58, 0xDC) // += dz*dz
    mc_b4(c, 0xF2, 0x0F, 0x58, 0x1D); dp_se := buf_len(c); buf_push_u32(c, 0) // ADDSD XMM3, [RIP+eps]
    cg_add_fixup(cg.fixups, dp_se, buf_len(c), fx_rdata() | (roff_eps << 8))
    mc_b4(c, 0xF2, 0x0F, 0x51, 0xE3) // SQRTSD XMM4, XMM3
    mc_b4(c, 0xF2, 0x0F, 0x59, 0xE3) // MULSD  XMM4, XMM3
    mc_b4(c, 0xF2, 0x0F, 0x10, 0x2D); dp_sn := buf_len(c); buf_push_u32(c, 0) // MOVSD XMM5, [RIP+num]
    cg_add_fixup(cg.fixups, dp_sn, buf_len(c), fx_rdata() | (roff_num << 8))
    mc_b4(c, 0xF2, 0x0F, 0x5E, 0xEC) // DIVSD  XMM5, XMM4
    mc_b4(c, 0xF2, 0x0F, 0x59, 0xC5); mc_addsd_fslot_xmm(cg, fx_slot, 0)
    mc_b4(c, 0xF2, 0x0F, 0x59, 0xCD); mc_addsd_fslot_xmm(cg, fy_slot, 1)
    mc_b4(c, 0xF2, 0x0F, 0x59, 0xD5); mc_addsd_fslot_xmm(cg, fz_slot, 2)
    mc_patch_rel32(c, je_skip, buf_len(c))
    mc_b3(c, 0x48, 0xFF, 0xC1) // INC RCX
    mc_b3(c, 0x48, 0x39, 0xD1) // CMP RCX, RDX
    jl_lps := mc_jcc32(c, 0x8C)
    mc_patch_rel32(c, jl_lps, lps)
    mc_patch_rel32(c, jge_done, buf_len(c))
    if pr_b > 0 { mc_b3(c, 0x48 | gpreg_hi(pr_b), 0x89, 0xC8 | gpreg_hw(pr_b)) }
    else { mc_b3(c, 0x48, 0x89, 0xC8); mc_store_rax(c, b_slot, 0) }
    if sv10 { mc_load_gpreg(c, s10, 8) }
    if sv11 { mc_load_gpreg(c, s11, 9) }
    if sv8 { mc_load_gpreg(c, s8, 10) }
    return true
}

fn emit_while_core_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, snid: i64) {
    c := cg.code
    if try_emit_avx2_f64_axpy_while_ax(cg, vars, snid) {
        return
    }
    if try_emit_avx2_dp_max_while_ax(cg, vars, snid) {
        return
    }
    if try_emit_avx2_nbody_while_ax(cg, vars, snid) {
        return
    }
    if try_emit_unrolled4_while_ax(cg, vars, drops, breaks, snid) {
        return
    }
    prev_cont := ibuf_get(cg.state, 10)
    prev_bmark := ibuf_get(cg.state, 11)
    bmark := ibuf_len(breaks)

    // Bottom-tested loop rotation + 16-byte loop header alignment: `JMP cond; .align 16; body: ...; cond: Jcc body`
    wcond := ast_get(cg.nodes, snid, 1)
    is_while_true := wcond > 0 and ast_kind(cg.nodes, wcond) == nk_bool() and ast_get(cg.nodes, wcond, 1) == 1
    mut jmp_cond := -1
    if not is_while_true { jmp_cond = mc_jmp32(c) }
    mc_align16_nop(c)
    body_pos := buf_len(c)
    ibuf_set(cg.state, 10, -2) // forward `continue` mode via negative offsets in `breaks`
    ibuf_set(cg.state, 11, bmark)
    emit_block_ax(cg, vars, drops, breaks, ast_get(cg.nodes, snid, 2))

    cond_pos := buf_len(c)
    if jmp_cond >= 0 { mc_patch_rel32(c, jmp_cond, cond_pos) }
    mut ci := bmark
    while ci < ibuf_len(breaks) {
        ent := ibuf_get(breaks, ci)
        if ent < 0 {
            if is_while_true { mc_patch_rel32(c, 0 - ent, body_pos) }
            else             { mc_patch_rel32(c, 0 - ent, cond_pos) }
            ibuf_set(breaks, ci, 0)
        }
        ci += 1
    }
    if is_while_true {
        jback := mc_jmp32(c)
        mc_patch_rel32(c, jback, body_pos)
    } else {
        jtrue_body := emit_cond_branch_ax(cg, vars, drops, breaks, wcond, true)
        mc_patch_rel32(c, jtrue_body, body_pos)
    }

    exit_pos := buf_len(c)
    mut bi := bmark
    while bi < ibuf_len(breaks) {
        bpos := ibuf_get(breaks, bi)
        if bpos > 0 {
            mc_patch_rel32(c, bpos, exit_pos)
            ibuf_set(breaks, bi, 0)
        }
        bi += 1
    }
    ibuf_set(cg.state, 10, prev_cont)
    ibuf_set(cg.state, 11, prev_bmark)
}

fn scan_iv_defer_ok_ax(cg: CodegenCtx, vars: IntBuf, nid: i64, idx_soff: i64, idx_slen: i64) -> bool {
    if nid <= 0 { return true }
    k := ast_kind(cg.nodes, nid)
    if k == nk_ident() or k == nk_move_ident() {
        return not (ast_get(cg.nodes, nid, 2) == idx_slen and pool_str_eq2(cg.pool, ast_get(cg.nodes, nid, 1), idx_slen, idx_soff))
    }
    if k == nk_int() or k == nk_float() or k == nk_bool() or k == nk_break() { return true }
    if k == nk_block() {
        off := ast_get(cg.nodes, nid, 1); cnt := ast_get(cg.nodes, nid, 2)
        mut i := 0
        while i < cnt {
            if not scan_iv_defer_ok_ax(cg, vars, ibuf_get(cg.extra, off + i), idx_soff, idx_slen) { return false }
            i += 1
        }
        return true
    }
    if k == nk_var_decl() { return scan_iv_defer_ok_ax(cg, vars, ast_get(cg.nodes, nid, 5), idx_soff, idx_slen) }
    if k == nk_assign() { return scan_iv_defer_ok_ax(cg, vars, ast_get(cg.nodes, nid, 3), idx_soff, idx_slen) }
    if k == nk_if() {
        return scan_iv_defer_ok_ax(cg, vars, ast_get(cg.nodes, nid, 1), idx_soff, idx_slen) and scan_iv_defer_ok_ax(cg, vars, ast_get(cg.nodes, nid, 2), idx_soff, idx_slen) and scan_iv_defer_ok_ax(cg, vars, ast_get(cg.nodes, nid, 3), idx_soff, idx_slen)
    }
    if k == nk_expr_stmt() or k == nk_cast() { return scan_iv_defer_ok_ax(cg, vars, ast_get(cg.nodes, nid, 1), idx_soff, idx_slen) }
    if k == nk_unary() { return scan_iv_defer_ok_ax(cg, vars, ast_get(cg.nodes, nid, 2), idx_soff, idx_slen) }
    if k == nk_binary() {
        return scan_iv_defer_ok_ax(cg, vars, ast_get(cg.nodes, nid, 2), idx_soff, idx_slen) and scan_iv_defer_ok_ax(cg, vars, ast_get(cg.nodes, nid, 3), idx_soff, idx_slen)
    }
    if k == nk_call() {
        cs := ast_get(cg.nodes, nid, 1); cl := ast_get(cg.nodes, nid, 2)
        aoff := ast_get(cg.nodes, nid, 3); acnt := ast_get(cg.nodes, nid, 4)
        if acnt == 2 and (pool_str_eq_lit(cg.pool, cs, cl, "ptr_read_u8") or pool_str_eq_lit(cg.pool, cs, cl, "ptr_read_i64")) {
            e0 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
            e1 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4)
            if ast_is_ident_lit(cg, e1, idx_soff, idx_slen) {
                if cg_slot_reg(cg, local_scalar_slot_ax(cg, vars, e0)) > 0 {
                    return scan_iv_defer_ok_ax(cg, vars, e0, idx_soff, idx_slen)
                }
                return false
            }
        }
        mut i := 0
        while i < acnt {
            ca := ibuf_get(cg.extra, aoff + i)
            if not scan_iv_defer_ok_ax(cg, vars, ast_get(cg.nodes, ca, 4), idx_soff, idx_slen) { return false }
            i += 1
        }
        return true
    }
    return false
}

fn emit_unrolled4_body_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, cond: i64, boff: i64, cnt: i64, st_last: i64, idx_slot: i64, use_imm: bool, lim_imm: i64, lim_slot: i64, defer_iv: bool) {
    c := cg.code
    idx_reg := cg_slot_reg(cg, idx_slot)
    // Hoist loop-invariant FP64 compare constant (e.g. `4.0`) into `XMM5` when in VEX+FMA3 mode!
    mut did_hoist := false
    if ibuf_get(cg.state, 25) == 1 and ibuf_get(cg.state, 23) == 0 {
        hbits := find_loop_f64_cmp_const_ax(cg, vars, boff, cnt - 1)
        if hbits != 0 {
            mc_vex_movsd_rdata(cg, 5, hbits)
            ibuf_set(cg.state, 23, hbits)
            did_hoist = true
        }
    }
    u_brks := ibuf_new(32)
    mut jmp_cmp4 := 0
    mut jge_skip4 := 0
    if use_imm and idx_reg > 0 {
        mc_cmp_gpreg_imm(c, idx_reg, lim_imm - 3)
        jge_skip4 = mc_jcc32(c, 0x8D)
        mc_align16_nop(c) // NOP-pad fall-through to 16-byte loop alignment!
    } else {
        jmp_cmp4 = mc_jmp32(c)
        mc_align16(c)
    }
    body4_pos := buf_len(c)
    mut u := 0
    while u < 4 {
        b_start := ibuf_len(breaks)
        if defer_iv and u > 0 {
            ibuf_set(cg.state, 24, u)
            ibuf_set(cg.state, cg_fpromo_base(cg) + 122, idx_slot)
        }
        emit_block_slice_ax(cg, vars, drops, breaks, boff, cnt - 1)
        if defer_iv and u > 0 {
            ibuf_set(cg.state, 24, 0)
            ibuf_set(cg.state, cg_fpromo_base(cg) + 122, 0)
            mut bi := b_start
            while bi < ibuf_len(breaks) {
                bp := ibuf_get(breaks, bi)
                if bp > 0 and ibuf_len(u_brks) + 2 <= 32 {
                    ibuf_push(u_brks, bp)
                    ibuf_push(u_brks, u)
                    ibuf_set(breaks, bi, 0)
                }
                bi += 1
            }
        }
        if not defer_iv {
            emit_stmt_ax(cg, vars, drops, breaks, st_last)
        }
        u += 1
    }
    if defer_iv {
        emit_gpreg_addsub_imm(cg, idx_reg, true, 4)
    }
    cmp4_pos := buf_len(c)
    if jmp_cmp4 > 0 { mc_patch_rel32(c, jmp_cmp4, cmp4_pos) }
    if use_imm {
        lim3 := lim_imm - 3
        if idx_reg > 0 {
            mc_cmp_gpreg_imm(c, idx_reg, lim3)
        } else {
            mc_load_rax(c, idx_slot, 0)
            if lim3 == 0 { mc_b3(c, 0x48, 0x85, 0xC0) }
            else if lim3 >= -128 and lim3 <= 127 { mc_b4(c, 0x48, 0x83, 0xF8, lim3 & 255) }
            else { mc_b2(c, 0x48, 0x3D); mc_u32(c, lim3) }
        }
        jl_b4 := mc_jcc32(c, 0x8C)
        mc_patch_rel32(c, jl_b4, body4_pos)
    } else {
        lim_reg := cg_slot_reg(cg, lim_slot)
        if lim_reg > 0 { mc_mov_rax_gpreg(c, lim_reg) }
        else           { mc_load_rax(c, lim_slot, 0) }
        mc_b4(c, 0x48, 0x83, 0xE8, 0x03)
        jo_tail := mc_jcc8(c, 0x70)
        if idx_reg > 0 { mc_cmp_rax_gpreg(c, idx_reg) }
        else           { mc_cmp_rax_slot(c, idx_slot, 0) }
        jg_b4 := mc_jcc32(c, 0x8F)
        mc_patch_rel32(c, jg_b4, body4_pos)
        mc_patch_jcc8(c, jo_tail, buf_len(c))
    }

    // 1x remainder tail loop (`0..3` iterations)
    if jge_skip4 > 0 { mc_patch_rel32(c, jge_skip4, buf_len(c)) }
    jmp_cmp1 := mc_jmp32(c)
    body1_pos := buf_len(c)
    emit_block_slice_ax(cg, vars, drops, breaks, boff, cnt - 1)
    emit_stmt_ax(cg, vars, drops, breaks, st_last)
    mc_patch_rel32(c, jmp_cmp1, buf_len(c))
    jtrue1 := emit_cond_branch_ax(cg, vars, drops, breaks, cond, true)
    mc_patch_rel32(c, jtrue1, body1_pos)

    // Cold exit stubs for early `break` at unroll step `u = 1..3` (exact induction var recovery!)
    if ibuf_len(u_brks) > 0 {
        jmp_skip_st := mc_jmp32(c)
        mut su := 1
        while su <= 3 {
            mut has_su := false
            mut ui := 0
            while ui < ibuf_len(u_brks) {
                if ibuf_get(u_brks, ui + 1) == su { has_su = true; break }
                ui += 2
            }
            if has_su {
                st_pos := buf_len(c)
                ui = 0
                while ui < ibuf_len(u_brks) {
                    if ibuf_get(u_brks, ui + 1) == su {
                        mc_patch_rel32(c, ibuf_get(u_brks, ui), st_pos)
                    }
                    ui += 2
                }
                emit_gpreg_addsub_imm(cg, idx_reg, true, su)
                ibuf_push(breaks, mc_jmp32(c))
            }
            su += 1
        }
        mc_patch_rel32(c, jmp_skip_st, buf_len(c))
    }
    buf_free(move u_brks)
    if did_hoist { ibuf_set(cg.state, 23, 0) }
}

fn try_emit_unrolled4_while_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, snid: i64) -> bool {
    cond := ast_get(cg.nodes, snid, 1)
    bnid := ast_get(cg.nodes, snid, 2)
    if cond <= 0 or bnid <= 0 or ast_kind(cg.nodes, cond) != nk_binary() or ast_get(cg.nodes, cond, 1) != op_lt() { return false }
    if ast_kind(cg.nodes, bnid) != nk_block() { return false }
    cnt := ast_get(cg.nodes, bnid, 2)
    if cnt < 2 or cnt > 16 { return false }
    lhs := ast_get(cg.nodes, cond, 2)
    rhs := ast_get(cg.nodes, cond, 3)
    if lhs <= 0 or (ast_kind(cg.nodes, lhs) != nk_ident() and ast_kind(cg.nodes, lhs) != nk_move_ident()) { return false }
    idx_slot := local_scalar_slot_ax(cg, vars, lhs)
    if idx_slot <= 0 or immut_local_const_int_node(cg, vars, lhs) > 0 { return false }
    idx_soff := ast_get(cg.nodes, lhs, 1); idx_slen := ast_get(cg.nodes, lhs, 2)
    vb_i := cg_var_find(cg.pool, vars, idx_soff, idx_slen)
    if vb_i < 0 or ibuf_get(vars, vb_i + 3) != ty_int() { return false }

    mut lim_imm := 0
    mut use_imm := false
    mut lim_slot := 0
    mut lim_soff := 0
    mut lim_slen := 0
    if is_folded_const_int_ax(cg, vars, rhs) {
        lim_imm = eval_folded_const_int_ax(cg, vars, rhs)
        if lim_imm < -2147483645 or lim_imm > 2147483647 { return false }
        use_imm = true
    } else {
        lim_slot = local_scalar_slot_ax(cg, vars, rhs)
        if lim_slot <= 0 { return false }
        lim_soff = ast_get(cg.nodes, rhs, 1); lim_slen = ast_get(cg.nodes, rhs, 2)
        if lim_slen == idx_slen and pool_str_eq2(cg.pool, lim_soff, lim_slen, idx_soff) { return false }
    }

    boff := ast_get(cg.nodes, bnid, 1)
    st_last := ibuf_get(cg.extra, boff + cnt - 1)
    if st_last <= 0 or ast_kind(cg.nodes, st_last) != nk_assign() or ast_get(cg.nodes, st_last, 1) != aop_add() { return false }
    if not ast_is_ident_lit(cg, ast_get(cg.nodes, st_last, 2), idx_soff, idx_slen) { return false }
    inc_r := ast_get(cg.nodes, st_last, 3)
    if inc_r <= 0 or ast_kind(cg.nodes, inc_r) != nk_int() or ast_get(cg.nodes, inc_r, 1) != 1 { return false }

    mut si := 0
    while si < cnt - 1 {
        if not scan_unroll_body_ok_ax(cg, ibuf_get(cg.extra, boff + si), idx_soff, idx_slen, lim_soff, lim_slen) {
            return false
        }
        si += 1
    }

    c := cg.code
    prev_cont := ibuf_get(cg.state, 10)
    prev_bmark := ibuf_get(cg.state, 11)
    bmark := ibuf_len(breaks)
    ibuf_set(cg.state, 10, -1)
    ibuf_set(cg.state, 11, bmark)

    mut has_f64 := false
    if ibuf_get(cg.state, 17) != 0 and ibuf_get(cg.state, 161) != 0 and (ibuf_get(cg.state, 18) & fnflag_nan_guard()) == 0 {
        mut fi := 0
        while fi < cnt - 1 {
            if scan_ast_has_f64_ax(cg, ibuf_get(cg.extra, boff + fi)) { has_f64 = true; break }
            fi += 1
        }
    }
    mut defer_iv := cg_slot_reg(cg, idx_slot) > 0
    if defer_iv {
        mut di := 0
        while di < cnt - 1 {
            if not scan_iv_defer_ok_ax(cg, vars, ibuf_get(cg.extra, boff + di), idx_soff, idx_slen) {
                defer_iv = false
                break
            }
            di += 1
        }
    }
    if has_f64 and ibuf_get(cg.state, 25) == 0 {
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_b3(c, 0x48, 0x85, 0xC0) // TEST RAX, RAX (tier >= 1: AVX2 + FMA3)
        jl_sse2 := mc_jcc32(c, 0x84)
        ibuf_set(cg.state, 25, 1)
        emit_unrolled4_body_ax(cg, vars, drops, breaks, cond, boff, cnt, st_last, idx_slot, use_imm, lim_imm, lim_slot, defer_iv)
        ibuf_set(cg.state, 25, 0)
        jmp_done := mc_jmp32(c)
        mc_patch_rel32(c, jl_sse2, buf_len(c))
        emit_unrolled4_body_ax(cg, vars, drops, breaks, cond, boff, cnt, st_last, idx_slot, use_imm, lim_imm, lim_slot, defer_iv)
        mc_patch_rel32(c, jmp_done, buf_len(c))
    } else {
        emit_unrolled4_body_ax(cg, vars, drops, breaks, cond, boff, cnt, st_last, idx_slot, use_imm, lim_imm, lim_slot, defer_iv)
    }

    exit_pos := buf_len(c)
    mut bi := bmark
    while bi < ibuf_len(breaks) {
        bpos := ibuf_get(breaks, bi)
        if bpos > 0 {
            mc_patch_rel32(c, bpos, exit_pos)
            ibuf_set(breaks, bi, 0)
        }
        bi += 1
    }
    ibuf_set(cg.state, 10, prev_cont)
    ibuf_set(cg.state, 11, prev_bmark)
    return true
}

fn ast_is_ident_lit(cg: CodegenCtx, nid: i64, soff: i64, slen: i64) -> bool {
    if nid <= 0 { return false }
    k := ast_kind(cg.nodes, nid)
    if k != nk_ident() and k != nk_move_ident() { return false }
    return ast_get(cg.nodes, nid, 2) == slen and pool_str_eq2(cg.pool, ast_get(cg.nodes, nid, 1), slen, soff)
}

fn ast_is_self_sub_call(cg: CodegenCtx, nid: i64, fn_soff: i64, fn_slen: i64, p_soff: i64, p_slen: i64, d: i64) -> bool {
    if nid <= 0 or ast_kind(cg.nodes, nid) != nk_call() { return false }
    if ast_get(cg.nodes, nid, 2) != fn_slen or ast_get(cg.nodes, nid, 4) != 1 { return false }
    if not pool_str_eq2(cg.pool, ast_get(cg.nodes, nid, 1), fn_slen, fn_soff) { return false }
    arg_e := ast_get(cg.nodes, ibuf_get(cg.extra, ast_get(cg.nodes, nid, 3)), 4)
    if arg_e <= 0 or ast_kind(cg.nodes, arg_e) != nk_binary() or ast_get(cg.nodes, arg_e, 1) != op_sub() { return false }
    lhs := ast_get(cg.nodes, arg_e, 2)
    rhs := ast_get(cg.nodes, arg_e, 3)
    return ast_is_ident_lit(cg, lhs, p_soff, p_slen) and rhs > 0 and ast_kind(cg.nodes, rhs) == nk_int() and ast_get(cg.nodes, rhs, 1) == d
}

// Shrink-wrapping + binary self-recursive accumulator tail-call transformation:
// `[if p <= 1 { return p }; return self(p-1) + self(p-2)]` -> leaf 3-insn fast-return + register accumulator loop!
fn try_emit_fast_rec_fn_ax(cg: CodegenCtx, fidx: i64, fn_soff: i64, fn_slen: i64, p_base: i64, p_cnt: i64, ret_ty: i64, fast_abi: i64, fn_flags: i64, body_nid: i64) -> bool {
    if fast_abi != 1 or p_cnt != 1 or ret_ty != ty_int() or body_nid <= 0 { return false }
    if (fn_flags & (fnflag_shield() | fnflag_nan_guard() | fnflag_whitebox())) != 0 { return false }
    if ibuf_get(cg.sym, p_base + 2) == pmode_mut() or ibuf_get(cg.sym, p_base + 3) != ty_int() { return false }
    if ast_kind(cg.nodes, body_nid) != nk_block() or ast_get(cg.nodes, body_nid, 2) != 2 { return false }
    p_soff := ibuf_get(cg.sym, p_base)
    p_slen := ibuf_get(cg.sym, p_base + 1)
    boff := ast_get(cg.nodes, body_nid, 1)
    s0 := ibuf_get(cg.extra, boff)
    s1 := ibuf_get(cg.extra, boff + 1)
    if s0 <= 0 or s1 <= 0 or ast_kind(cg.nodes, s0) != nk_if() or ast_get(cg.nodes, s0, 3) > 0 { return false }
    if ast_kind(cg.nodes, s1) != nk_return() { return false }
    c0 := ast_get(cg.nodes, s0, 1)
    tb0 := ast_get(cg.nodes, s0, 2)
    if c0 <= 0 or ast_kind(cg.nodes, c0) != nk_binary() or tb0 <= 0 or ast_kind(cg.nodes, tb0) != nk_block() or ast_get(cg.nodes, tb0, 2) != 1 { return false }
    cop := ast_get(cg.nodes, c0, 1)
    cl := ast_get(cg.nodes, c0, 2)
    cr := ast_get(cg.nodes, c0, 3)
    mut base_ok := false
    if cop == op_lte() and ast_is_ident_lit(cg, cl, p_soff, p_slen) and cr > 0 and ast_kind(cg.nodes, cr) == nk_int() and ast_get(cg.nodes, cr, 1) == 1 { base_ok = true }
    else if cop == op_lt() and ast_is_ident_lit(cg, cl, p_soff, p_slen) and cr > 0 and ast_kind(cg.nodes, cr) == nk_int() and ast_get(cg.nodes, cr, 1) == 2 { base_ok = true }
    if not base_ok { return false }
    rs0 := ibuf_get(cg.extra, ast_get(cg.nodes, tb0, 1))
    if rs0 <= 0 or ast_kind(cg.nodes, rs0) != nk_return() or not ast_is_ident_lit(cg, ast_get(cg.nodes, rs0, 1), p_soff, p_slen) { return false }
    re1 := ast_get(cg.nodes, s1, 1)
    if re1 <= 0 or ast_kind(cg.nodes, re1) != nk_binary() or ast_get(cg.nodes, re1, 1) != op_add() { return false }
    rl := ast_get(cg.nodes, re1, 2)
    rr := ast_get(cg.nodes, re1, 3)
    pair_ok := (ast_is_self_sub_call(cg, rl, fn_soff, fn_slen, p_soff, p_slen, 1) and ast_is_self_sub_call(cg, rr, fn_soff, fn_slen, p_soff, p_slen, 2)) or (ast_is_self_sub_call(cg, rl, fn_soff, fn_slen, p_soff, p_slen, 2) and ast_is_self_sub_call(cg, rr, fn_soff, fn_slen, p_soff, p_slen, 1))
    if not pair_ok { return false }

    c := cg.code
    shd := ibuf_get(cg.state, 0)
    // Leaf shrink-wrapped fastpath (`n <= 1` -> `MOV RAX, RCX; RET`, 0 frame overhead!)
    mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)             // ENDBR64
    mc_b4(c, 0x48, 0x83, 0xF9, 0x01)             // CMP RCX, 1
    jg_enter := mc_jcc8(c, 0x7F)                 // JG enter_frame
    mc_b3(c, 0x48, 0x89, 0xC8)                   // MOV RAX, RCX
    mc_b1(c, 0xC3)                               // RET
    mc_patch_jcc8(c, jg_enter, buf_len(c))
    mc_b4(c, 0x55, 0x48, 0x89, 0xE5)             // PUSH RBP; MOV RBP, RSP
    mc_b4(c, 0x48, 0x83, 0xEC, 0x30)             // SUB RSP, 48 (16B aligned)
    mc_b4(c, 0x48, 0x89, 0x5D, 0xF8)             // MOV [RBP-8], RBX
    mc_b4(c, 0x4C, 0x89, 0x65, 0xF0)             // MOV [RBP-16], R12
    mc_b3(c, 0x48, 0x89, 0xCB)                   // MOV RBX, RCX (n)
    mc_b3(c, 0x45, 0x31, 0xE4)                   // XOR R12D, R12D (acc = 0)
    lp := buf_len(c)
    mc_b4(c, 0x48, 0x8D, 0x4B, 0xFF)             // LEA RCX, [RBX - 1]
    cg_call_fn(cg, fidx)
    mc_b3(c, 0x49, 0x01, 0xC4)                   // ADD R12, RAX
    if shd != 0 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
    mc_b4(c, 0x48, 0x83, 0xEB, 0x02)             // SUB RBX, 2
    mc_b4(c, 0x48, 0x83, 0xFB, 0x01)             // CMP RBX, 1
    jg_lp := mc_jcc8(c, 0x7F)                    // JG lp
    mc_patch_jcc8(c, jg_lp, lp)
    mc_b3(c, 0x4C, 0x89, 0xE0)                   // MOV RAX, R12
    mc_b3(c, 0x48, 0x01, 0xD8)                   // ADD RAX, RBX
    if shd != 0 { cg_jmp_fn(cg, 0x80, h_sec_trap()) }
    mc_b4(c, 0x48, 0x8B, 0x5D, 0xF8)             // MOV RBX, [RBP-8]
    mc_b4(c, 0x4C, 0x8B, 0x65, 0xF0)             // MOV R12, [RBP-16]
    mc_b2(c, 0xC9, 0xC3)                         // LEAVE; RET
    return true
}

fn compile_single_fn_ax(cg: CodegenCtx, fidx: i64) {
    c := cg.code
    f_off := ibuf_get(cg.sym, 7) + fidx * 10
    fn_soff := ibuf_get(cg.sym, f_off)
    fn_slen := ibuf_get(cg.sym, f_off + 1)
    fnid := ibuf_get(cg.sym, f_off + 2)
    p_base := ibuf_get(cg.sym, f_off + 3)
    p_cnt := ibuf_get(cg.sym, f_off + 4)
    ret_ty := ibuf_get(cg.sym, f_off + 5)
    ret_slots := ibuf_get(cg.sym, f_off + 6)
    fast_abi := ibuf_get(cg.sym, f_off + 8)
    fn_flags := ibuf_get(cg.sym, f_off + 9)
    body_nid := ast_get(cg.nodes, fnid, 6) & 0xFFFFFFFF

    ibuf_set(cg.state, 3, fidx)
    ibuf_set(cg.state, 4, 0)
    ibuf_set(cg.state, 5, 0)
    ibuf_set(cg.state, 6, 0)
    ibuf_set(cg.state, 7, ret_ty)
    ibuf_set(cg.state, 8, ret_slots)
    ibuf_set(cg.state, 9, fast_abi)
    ibuf_set(cg.state, 10, -1)
    ibuf_set(cg.state, 11, 0)
    ibuf_set(cg.state, 12, 0)
    ibuf_set(cg.state, 13, 0)
    ibuf_set(cg.state, 14, 0)
    ibuf_set(cg.state, 18, fn_flags)
    ibuf_set(cg.state, 22, 0)
    ibuf_set(cg.state, 23, 0)
    ibuf_set(cg.state, 24, 0)
    ibuf_set(cg.state, 25, 0)

    if try_emit_fast_rec_fn_ax(cg, fidx, fn_soff, fn_slen, p_base, p_cnt, ret_ty, fast_abi, fn_flags, body_nid) {
        return
    }

    // Prolog: `ENDBR64; PUSH RBP; MOV RBP, RSP` + compact 13B frame setup (`SUB RSP, imm32; NOP6` or `CALL h_chkstk`)
    mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
    mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
    mc_b1(c, 0xB8)
    frame_imm_pos := buf_len(c)
    mc_u32(c, 0)
    mut chk_fix_idx := -1
    if cg_is_win64(cg) {
        chk_fix_idx = ibuf_len(cg.fixups)
        buf_push(c, 0xE8)
        chk_dp := buf_len(c)
        buf_push_u32(c, 0)
        cg_add_fixup(cg.fixups, chk_dp, buf_len(c), fx_fn() | (h_chkstk() << 8))
    }
    mc_b3(c, 0x48, 0x29, 0xC4)

    ibuf_set(cg.state, 21, 0)
    scan_promo_vars_ax(cg, p_base, p_cnt, body_nid)
    promo_mask := ibuf_get(cg.state, 98)
    if promo_mask != 0 {
        max_r := cg_max_gpr(cg)
        mut k_save := 0
        mut sr := 1
        while sr <= max_r {
            if (promo_mask & (1 << sr)) != 0 { k_save += 1 }
            sr += 1
        }
        save_base := cg_alloc_slots(cg, k_save)
        ibuf_set(cg.state, 99, save_base)
        mut si := 0
        sr = 1
        while sr <= max_r {
            if (promo_mask & (1 << sr)) != 0 {
                mc_store_gpreg(c, save_base + si, sr)
                si += 1
            }
            sr += 1
        }
    }
    fpromo_mask := ibuf_get(cg.state, 161)
    if fpromo_mask != 0 {
        mut kf_save := 0
        mut fr := 1
        while fr <= 8 {
            if (fpromo_mask & (1 << fr)) != 0 { kf_save += 1 }
            fr += 1
        }
        fsave_base := cg_alloc_slots(cg, kf_save * 2)
        ibuf_set(cg.state, 162, fsave_base)
        mut fsi := 0
        fr = 1
        while fr <= 8 {
            if (fpromo_mask & (1 << fr)) != 0 {
                mc_store_freg_ups(c, fsave_base + fsi * 2 + 1, fr)
                fsi += 1
            }
            fr += 1
        }
    }

    vars := ibuf_new(65536)
    drops := ibuf_new(16384)
    breaks := ibuf_new(4096)

    if fast_abi == 1 {
        mut pi := 0
        while pi < p_cnt {
            po := p_base + pi * 6
            pn_soff := ibuf_get(cg.sym, po)
            pn_slen := ibuf_get(cg.sym, po + 1)
            pty := ibuf_get(cg.sym, po + 3)
            pslots := type_slots(cg.sym, pty)
            arg_off := ibuf_get(cg.sym, po + 4)
            pslot := cg_alloc_slots(cg, pslots)
            pr_p := find_promo_reg_by_name(cg, pn_soff, pn_slen)
            if pr_p > 0 and pslots == 1 and (pty == ty_int() or pty == ty_bool()) {
                cg_set_gpr_slot(cg, pr_p, pslot)
                mc_mov_gpreg_argreg(c, pr_p, arg_off)
            } else {
                mut s := 0
                while s < pslots {
                    ridx := arg_off + s
                    if ridx == 0 { mc_store_rcx(c, pslot, s) }
                    else if ridx == 1 { mc_store_rdx(c, pslot, s) }
                    else if ridx == 2 { mc_store_r8(c, pslot, s) }
                    else if ridx == 3 { mc_store_r9(c, pslot, s) }
                    else if ridx == 4 { mc_store_r10(c, pslot, s) }
                    else { mc_store_r11(c, pslot, s) }
                    s += 1
                }
            }
            ibuf_push(vars, pn_soff)
            ibuf_push(vars, pn_slen)
            ibuf_push(vars, pslot)
            ibuf_push(vars, pty)
            ibuf_push(vars, 0)
            if pslots == 1 and pty == ty_float() {
                fr_p := find_promo_freg_by_name(cg, pn_soff, pn_slen)
                if fr_p > 0 {
                    cg_set_freg_slot(cg, fr_p, pslot)
                    mc_load_freg_sd(c, pslot, fr_p)
                }
            }
            pi += 1
        }
    } else {
        ab_slot := cg_alloc_slots(cg, 1)
        rb_slot := cg_alloc_slots(cg, 1)
        ibuf_set(cg.state, 5, ab_slot)
        ibuf_set(cg.state, 6, rb_slot)
        mc_store_rcx(c, ab_slot, 0)
        mc_store_rdx(c, rb_slot, 0)

        mut pi := 0
        while pi < p_cnt {
            po := p_base + pi * 6
            pn_soff := ibuf_get(cg.sym, po)
            pn_slen := ibuf_get(cg.sym, po + 1)
            pty := ibuf_get(cg.sym, po + 3)
            pslots := type_slots(cg.sym, pty)
            arg_off := ibuf_get(cg.sym, po + 4)
            lslot := cg_alloc_slots(cg, pslots)
            mc_load_r8(c, ab_slot, 0)
            mut s := 0
            while s < pslots {
                mc_r8_load_rax(c, (arg_off + s) * 8)
                mc_store_rax(c, lslot, s)
                s += 1
            }
            pr_p := find_promo_reg_by_name(cg, pn_soff, pn_slen)
            if pr_p > 0 and pslots == 1 and (pty == ty_int() or pty == ty_bool()) {
                cg_set_gpr_slot(cg, pr_p, lslot)
                mc_load_gpreg(c, lslot, pr_p)
            }
            ibuf_push(vars, pn_soff)
            ibuf_push(vars, pn_slen)
            ibuf_push(vars, lslot)
            ibuf_push(vars, pty)
            ibuf_push(vars, 0)
            pi += 1
        }
    }

    // Bind Symbolic & Comptime Shape Dimensions `[sym B, sym S, comptime D: usize]` directly from `Tensor` descriptors!
    moff := ushr64(ast_get(cg.nodes, fnid, 4), 16)
    if moff > 0 {
        gen_off := ibuf_get(cg.extra, moff + 7)
        gen_cnt := ibuf_get(cg.extra, moff + 8)
        mut gi := 0
        while gi < gen_cnt {
            gb := gen_off + gi * 4
            g_soff := ibuf_get(cg.extra, gb + 1)
            g_slen := ibuf_get(cg.extra, gb + 2)
            def_e := ibuf_get(cg.extra, gb + 3)
            g_slot := cg_alloc_slots(cg, 1)
            mut bound_from_tensor := false

            mut vpi := 0
            while vpi < p_cnt and not bound_from_tensor {
                vb_off := vpi * 5
                v_slot := ibuf_get(vars, vb_off + 2)
                v_ty := ibuf_get(vars, vb_off + 3)
                if ty_tag(v_ty) == 21 {
                    td := ty_pay(v_ty)
                    rank := ibuf_get(cg.sym, td + 1)
                    mut ax := 0
                    while ax < rank {
                        dk := ibuf_get(cg.sym, td + 3 + ax * 2)
                        dv := ibuf_get(cg.sym, td + 4 + ax * 2)
                        if dk == g_slen and pool_str_eq2(cg.pool, dv, g_slen, g_soff) {
                            mc_load_rax(c, v_slot, 1)
                            if ax > 0 {
                                mc_b4(c, 0x48, 0xC1, 0xE8, ax * 20)
                            }
                            mc_b1(c, 0x25); mc_u32(c, 0xFFFFF)
                            mc_store_rax(c, g_slot, 0)
                            bound_from_tensor = true
                            break
                        }
                        ax += 1
                    }
                }
                vpi += 1
            }

            if not bound_from_tensor {
                mc_mov_rax_imm(c, def_e)
                mc_store_rax(c, g_slot, 0)
            }

            ibuf_push(vars, g_soff)
            ibuf_push(vars, g_slen)
            ibuf_push(vars, g_slot)
            ibuf_push(vars, ty_int())
            ibuf_push(vars, 0)
            gi += 1
        }
    }

    // Zero non-parameter stack slots ONLY when function AST may produce Perceus drops/secrets!
    param_end_slot := ibuf_get(cg.state, 14)
    ibuf_set(cg.state, 21, cg_alloc_slots(cg, 1))
    need_zero_slots := ibuf_get(cg.state, 97) != 0
    mut zero_start_pos := 0
    mut zero_disp_pos := 0
    mut zero_cnt_pos := 0
    mut zero_end_pos := 0
    if need_zero_slots {
        zero_start_pos = buf_len(c)
        mc_b1(c, 0x57)
        mc_b3(c, 0x48, 0x8D, 0xBD)
        zero_disp_pos = buf_len(c)
        mc_u32(c, 0)
        mc_b1(c, 0xB9)
        zero_cnt_pos = buf_len(c)
        mc_u32(c, 0)
        mc_b2(c, 0x31, 0xC0)
        mc_b3(c, 0xF3, 0x48, 0xAB)
        mc_b1(c, 0x5F)
        zero_end_pos = buf_len(c)
    }

    if (fn_flags & fnflag_shield()) != 0 and cg_is_win64(cg) and not pool_str_eq_lit(cg.pool, fn_soff, fn_slen, "main") {
        // Shield v5: Scattered inline PEB Anti-Debug + 8-Byte Dual-Dword MBA Polymorphic Anti-Patch Guard!
        // Verifies `[0..4) ^ [4..8)` (`0xFA1E0FF3 ^ 0xE5894855 = 0x1F9747A6`) of `h_shield_verify`, blocking both +0 and +4 5-byte JMP detours.
        mc_b4(c, 0x65, 0x48, 0x8B, 0x04); mc_b1(c, 0x25); mc_u32(c, 0x60) // MOV RAX, GS:[0x60]
        mc_b4(c, 0x80, 0x78, 0x02, 0x00)                                  // CMP BYTE PTR [RAX+2], 0
        je_dbg_ok := mc_jcc8(c, 0x74)
        mc_b2(c, 0x0F, 0x0B)                                              // UD2
        mc_patch_jcc8(c, je_dbg_ok, buf_len(c))
        k_mba := (ibuf_get(cg.state, 15) ^ ((fidx + 1) *% 0x9E3779B97F4A7C15)) & 0xFFFFFFFF
        exp_mba := (0x1F9747A6 ^ k_mba) +% ((0x1F9747A6 & k_mba) * 2)
        mc_b3(c, 0x48, 0x8D, 0x05)                                        // LEA RAX, [RIP + h_shield_verify]
        dp_sv := buf_len(c)
        mc_u32(c, 0)
        cg_add_fixup(cg.fixups, dp_sv, buf_len(c), fx_fn() | (h_shield_verify() << 8))
        mc_b2(c, 0x8B, 0x08)                                              // MOV ECX, DWORD PTR [RAX]
        mc_b3(c, 0x33, 0x48, 0x04)                                        // XOR ECX, DWORD PTR [RAX + 4]
        mc_b3(c, 0x48, 0x89, 0xCA)                                        // MOV RDX, RCX
        mc_b2(c, 0x41, 0xB8); mc_u32(c, k_mba)                            // MOV R8D, k_mba
        mc_b3(c, 0x4C, 0x31, 0xC1)                                        // XOR RCX, R8
        mc_b3(c, 0x4C, 0x21, 0xC2)                                        // AND RDX, R8
        mc_b4(c, 0x48, 0x8D, 0x0C, 0x51)                                  // LEA RCX, [RCX + RDX*2]
        mc_b2(c, 0x49, 0xB8); mc_u64(c, exp_mba)                          // MOV R8, exp_mba
        mc_b3(c, 0x4C, 0x39, 0xC1)                                        // CMP RCX, R8
        je_sv_ok := mc_jcc8(c, 0x74)
        mc_b2(c, 0x0F, 0x0B)                                              // UD2
        mc_patch_jcc8(c, je_sv_ok, buf_len(c))
        cg_call_fn(cg, h_shield_verify())
    }

    if body_nid > 0 {
        emit_block_ax(cg, vars, drops, breaks, body_nid)
    }

    emit_perceus_drops_ax(cg, drops)
    emit_writeback_mut_params_ax(cg, vars)
    emit_wipe_secrets_ax(cg, drops)
    emit_restore_callee_regs_ax(cg)
    mc_b2(c, 0x31, 0xC0)
    mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
    mc_b1(c, 0xC3)

    max_slot := ibuf_get(cg.state, 14)
    mut zero_cnt := max_slot - param_end_slot
    if zero_cnt < 0 { zero_cnt = 0 }
    if need_zero_slots {
        if ibuf_len(drops) == 0 or zero_cnt == 0 {
            buf_set(c, zero_start_pos, 0xEB)
            buf_set(c, zero_start_pos + 1, (zero_end_pos - (zero_start_pos + 2)) & 255)
            mut np := zero_start_pos + 2
            while np < zero_end_pos {
                buf_set(c, np, 0x90)
                np += 1
            }
        } else {
            mut zero_base_slot := max_slot
            if zero_base_slot < 1 { zero_base_slot = 1 }
            buf_put_u32(c, zero_disp_pos, 0 - (zero_base_slot * 8))
            buf_put_u32(c, zero_cnt_pos, zero_cnt)
        }
    }

    raw_bytes := max_slot * 8 + 96
    aligned_frame := align_up(raw_bytes, 16)
    if cg_is_win64(cg) {
        if aligned_frame < 4096 {
            ibuf_set(cg.fixups, chk_fix_idx + 2, 0)
            p0 := frame_imm_pos - 1
            buf_set(c, p0, 0x48)
            buf_set(c, p0 + 1, 0x81)
            buf_set(c, p0 + 2, 0xEC)
            buf_put_u32(c, p0 + 3, aligned_frame)
            buf_set(c, p0 + 7, 0x66)
            buf_set(c, p0 + 8, 0x0F)
            buf_set(c, p0 + 9, 0x1F)
            buf_set(c, p0 + 10, 0x44)
            buf_set(c, p0 + 11, 0x00)
            buf_set(c, p0 + 12, 0x00)
        } else {
            cg_mark_helper_used(cg, h_chkstk())
            buf_put_u32(c, frame_imm_pos, aligned_frame)
        }
    } else {
        buf_put_u32(c, frame_imm_pos, aligned_frame)
    }

    buf_free(move breaks)
    buf_free(move drops)
    buf_free(move vars)
}

// Emits a Win64 C-ABI Trampoline for `@export` / `@py_export` functions (`XMM0..3 -> GPR`, `RAX -> XMM0` for `f64`)
fn emit_c_abi_export_wrapper(cg: CodegenCtx, fni: i64) -> i64 {
    c := cg.code
    mc_align16(c)
    w_start := buf_len(c)
    f_off := ibuf_get(cg.sym, 7) + fni * 10
    p_base := ibuf_get(cg.sym, f_off + 3)
    p_cnt := ibuf_get(cg.sym, f_off + 4)
    ret_ty := ibuf_get(cg.sym, f_off + 5)
    fast_abi := ibuf_get(cg.sym, f_off + 8)

    mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
    mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
    mc_b4(c, 0x48, 0x83, 0xEC, 0x60)

    if fast_abi == 1 {
        mut pi := 0
        while pi < p_cnt and pi < 4 {
            pty := ibuf_get(cg.sym, p_base + pi * 6 + 3)
            if pty == ty_float() {
                if pi == 0 { mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC1) }      // MOVQ RCX, XMM0
                else if pi == 1 { mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xCA) } // MOVQ RDX, XMM1
                else if pi == 2 { mc_b4(c, 0x66, 0x49, 0x0F, 0x7E); mc_b1(c, 0xD0) } // MOVQ R8,  XMM2
                else { mc_b4(c, 0x66, 0x49, 0x0F, 0x7E); mc_b1(c, 0xD9) }            // MOVQ R9,  XMM3
            }
            pi += 1
        }
        cg_call_fn(cg, fni)
    } else {
        // Pack up to 4 C-ABI scalar args into `[RBP - 0x40]` arg block, `[RBP - 0x50]` ret block
        mut pi := 0
        while pi < p_cnt and pi < 4 {
            pty := ibuf_get(cg.sym, p_base + pi * 6 + 3)
            disp := (0 - 0x40 + pi * 8) & 255
            if pty == ty_float() {
                if pi == 0 { mc_b4(c, 0xF2, 0x0F, 0x11, 0x45); mc_b1(c, disp) }
                else if pi == 1 { mc_b4(c, 0xF2, 0x0F, 0x11, 0x4D); mc_b1(c, disp) }
                else if pi == 2 { mc_b4(c, 0xF2, 0x0F, 0x11, 0x55); mc_b1(c, disp) }
                else { mc_b4(c, 0xF2, 0x0F, 0x11, 0x5D); mc_b1(c, disp) }
            } else {
                if pi == 0 { mc_b4(c, 0x48, 0x89, 0x4D, disp) }
                else if pi == 1 { mc_b4(c, 0x48, 0x89, 0x55, disp) }
                else if pi == 2 { mc_b4(c, 0x4C, 0x89, 0x45, disp) }
                else { mc_b4(c, 0x4C, 0x89, 0x4D, disp) }
            }
            pi += 1
        }
        mc_b4(c, 0x48, 0x8D, 0x4D, 0xC0) // LEA RCX, [RBP - 0x40]
        mc_b4(c, 0x48, 0x8D, 0x55, 0xB0) // LEA RDX, [RBP - 0x50]
        cg_call_fn(cg, fni)
    }

    if ret_ty == ty_float() {
        mc_b4(c, 0x66, 0x48, 0x0F, 0x6E); mc_b1(c, 0xC0) // MOVQ XMM0, RAX
    }
    mc_b4(c, 0x48, 0x89, 0xEC, 0x5D)
    mc_b1(c, 0xC3)
    ibuf_push(cg.fn_ranges, w_start)
    ibuf_push(cg.fn_ranges, buf_len(c))
    return w_start
}

// Emits native `@test` runner entry point at `.text + 0` when `axc test` is invoked!
fn emit_test_runner_entry(cg: CodegenCtx) {
    c := cg.code
    s_beg := buf_len(c)
    mc_b4(c, 0xF3, 0x0F, 0x1E, 0xFA)
    mc_b4(c, 0x55, 0x48, 0x89, 0xE5)
    mc_b4(c, 0x48, 0x83, 0xEC, 0x40)

    cg_call_fn(cg, h_detect_cpuid())
    if ibuf_get(cg.state, 0) == 1 and cg_is_win64(cg) {
        cg_call_fn(cg, h_shield_verify())
    }

    p_hdr := cg_intern_lit(cg, "[TEST] ")
    p_ok := cg_intern_lit(cg, " ... PASS\n")
    p_sum1 := cg_intern_lit(cg, "[PASS] All Axon @test functions passed: ")
    p_nl := cg_intern_lit(cg, "\n")

    f_base := ibuf_get(cg.sym, 7)
    f_cnt := ibuf_get(cg.sym, 8)
    mut t_cnt := 0
    mut fni := 0
    while fni < f_cnt {
        fo := f_base + fni * 10
        flags := ibuf_get(cg.sym, fo + 9)
        if (flags & fnflag_test()) != 0 {
            fn_soff := ibuf_get(cg.sym, fo)
            fn_slen := ibuf_get(cg.sym, fo + 1)
            fn_roff := cg_intern_pool_slice(cg, fn_soff, fn_slen)

            cg_lea_rax_rdata(cg, p_hdr); mc_b3(c, 0x48, 0x89, 0xC1); mc_b1(c, 0xBA); mc_u32(c, 7); cg_call_fn(cg, h_print_bytes())
            cg_lea_rax_rdata(cg, fn_roff); mc_b3(c, 0x48, 0x89, 0xC1); mc_b1(c, 0xBA); mc_u32(c, fn_slen); cg_call_fn(cg, h_print_bytes())

            if ibuf_get(cg.sym, fo + 8) == 0 {
                mc_b4(c, 0x48, 0x8D, 0x4D, 0xE0)
                mc_b4(c, 0x48, 0x8D, 0x55, 0xE0)
            }
            cg_call_fn(cg, fni)

            cg_lea_rax_rdata(cg, p_ok); mc_b3(c, 0x48, 0x89, 0xC1); mc_b1(c, 0xBA); mc_u32(c, 10); cg_call_fn(cg, h_print_bytes())
            t_cnt += 1
        }
        fni += 1
    }

    cg_lea_rax_rdata(cg, p_sum1); mc_b3(c, 0x48, 0x89, 0xC1); mc_b1(c, 0xBA); mc_u32(c, 40); cg_call_fn(cg, h_print_bytes())
    mc_b1(c, 0xB9); mc_u32(c, t_cnt); cg_call_fn(cg, h_print_i64())
    cg_lea_rax_rdata(cg, p_nl); mc_b3(c, 0x48, 0x89, 0xC1); mc_b1(c, 0xBA); mc_u32(c, 1); cg_call_fn(cg, h_print_bytes())

    cg_emit_exit_imm(cg, 0)
    ibuf_push(cg.fn_ranges, s_beg)
    ibuf_push(cg.fn_ranges, buf_len(c))
}

fn enqueue_live_fn_ax(live: IntBuf, queue: IntBuf, fidx: i64) {
    if fidx >= 0 and ibuf_get(live, fidx) == 0 {
        ibuf_set(live, fidx, 1)
        ibuf_push(queue, fidx)
    }
}

fn scan_calls_expr_ax(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, live: IntBuf, queue: IntBuf, enid: i64) {
    if enid <= 0 {
        return
    }
    k := ast_kind(nodes, enid)
    if k == nk_unary() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 2))
        return
    }
    if k == nk_cast() or k == nk_field() or k == nk_tuple_idx() or k == nk_await() or k == nk_comptime_expr() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 1))
        return
    }
    if k == nk_binary() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 2))
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 3))
        return
    }
    if k == nk_in_range() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 2))
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 3))
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 4))
        return
    }
    if k == nk_or_return() or k == nk_index() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 1))
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 2))
        return
    }
    if k == nk_table_alloc() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 3))
        return
    }
    if k == nk_tuple() or k == nk_fstr() {
        off := ast_get(nodes, enid, 1)
        cnt := ast_get(nodes, enid, 2)
        mut i := 0
        while i < cnt {
            scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ibuf_get(extra, off + i))
            i += 1
        }
        return
    }
    if k == nk_spawn() {
        scan_calls_block_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 1))
        return
    }
    if k == nk_unsafe_block() {
        ub := ast_get(nodes, enid, 1)
        scan_calls_block_ax(pool, nodes, extra, sym, live, queue, ub)
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, ub, 3))
        return
    }
    if k == nk_if_expr() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 1))
        tb := ast_get(nodes, enid, 2)
        scan_calls_block_ax(pool, nodes, extra, sym, live, queue, tb)
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, tb, 3))
        eb := ast_get(nodes, enid, 3)
        if eb > 0 {
            scan_calls_block_ax(pool, nodes, extra, sym, live, queue, eb)
            scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, eb, 3))
        }
        return
    }
    if k == nk_call() {
        cs := ast_get(nodes, enid, 1)
        cl := ast_get(nodes, enid, 2)
        aoff := ast_get(nodes, enid, 3)
        acnt := ast_get(nodes, enid, 4)
        fidx := find_fn_idx(pool, sym, cs, cl)
        if not (acnt == 0 and is_const_fn_idx(sym, fidx)) {
            enqueue_live_fn_ax(live, queue, fidx)
        }
        mut i := 0
        while i < acnt {
            scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, ibuf_get(extra, aoff + i), 4))
            i += 1
        }
        return
    }
    if k == nk_method_call() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, enid, 1))
        ms := ast_get(nodes, enid, 2)
        ml := ast_get(nodes, enid, 3)
        aoff := ast_get(nodes, enid, 4)
        acnt := ast_get(nodes, enid, 5)
        mut i := 0
        while i < acnt {
            scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, ibuf_get(extra, aoff + i), 4))
            i += 1
        }
        f_base := ibuf_get(sym, 7)
        f_cnt := ibuf_get(sym, 8)
        mut fi := 0
        while fi < f_cnt {
            fo := f_base + fi * 10
            fnoff := ibuf_get(sym, fo)
            fnlen := ibuf_get(sym, fo + 1)
            if fnlen > ml + 2 {
                tail := fnoff + fnlen - ml
                if buf_get(pool, tail - 1) == 95 and buf_get(pool, tail - 2) == 95 {
                    if pool_str_eq2(pool, tail, ml, ms) {
                        enqueue_live_fn_ax(live, queue, fi)
                    }
                }
            }
            fi += 1
        }
    }
}

fn scan_calls_stmt_ax(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, live: IntBuf, queue: IntBuf, snid: i64) {
    if snid <= 0 {
        return
    }
    k := ast_kind(nodes, snid)
    if k == nk_var_decl() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 5))
    } else if k == nk_tuple_destruct() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 3))
    } else if k == nk_assign() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 2))
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 3))
    } else if k == nk_if() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 1))
        scan_calls_block_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 2))
        scan_calls_block_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 3))
    } else if k == nk_while() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 1))
        scan_calls_block_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 2))
    } else if k == nk_for_range() or k == nk_par_for_range() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 3))
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 4))
        scan_calls_block_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 5))
    } else if k == nk_unsafe_block() {
        scan_calls_block_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 1))
    } else if k == nk_for_each() or k == nk_par_for_each() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 3))
        scan_calls_block_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 4))
    } else if k == nk_return() or k == nk_expr_stmt() {
        scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, snid, 1))
    }
}

fn scan_calls_block_ax(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, live: IntBuf, queue: IntBuf, bnid: i64) {
    if bnid <= 0 {
        return
    }
    off := ast_get(nodes, bnid, 1)
    cnt := ast_get(nodes, bnid, 2)
    mut i := 0
    while i < cnt {
        scan_calls_stmt_ax(pool, nodes, extra, sym, live, queue, ibuf_get(extra, off + i))
        i += 1
    }
}

fn mark_reachable_fns_ax(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, is_dll: bool, test_mode: bool, live: IntBuf) {
    f_base := ibuf_get(sym, 7)
    f_cnt := ibuf_get(sym, 8)
    queue := ibuf_new(f_cnt + 8)
    mut main_idx := -1
    mut i := 0
    while i < f_cnt {
        ibuf_push(live, 0)
        fo := f_base + i * 10
        flags := ibuf_get(sym, fo + 9)
        if pool_str_eq_lit(pool, ibuf_get(sym, fo), ibuf_get(sym, fo + 1), "main") {
            main_idx = i
        }
        if (flags & fnflag_export()) != 0 {
            enqueue_live_fn_ax(live, queue, i)
        }
        if test_mode and (flags & fnflag_test()) != 0 {
            enqueue_live_fn_ax(live, queue, i)
        }
        i += 1
    }
    if not is_dll and not test_mode {
        if main_idx >= 0 {
            enqueue_live_fn_ax(live, queue, main_idx)
        } else if ibuf_len(queue) == 0 {
            i = 0
            while i < f_cnt {
                if not is_const_fn_idx(sym, i) {
                    enqueue_live_fn_ax(live, queue, i)
                }
                i += 1
            }
        }
    }
    mut qi := 0
    while qi < ibuf_len(queue) {
        fidx := ibuf_get(queue, qi)
        qi += 1
        fo := f_base + fidx * 10
        fnid := ibuf_get(sym, fo + 2)
        flags := ibuf_get(sym, fo + 9)
        if (flags & fnflag_extern()) == 0 {
            pl_off := ast_get(nodes, fnid, 3)
            pcnt := ast_get(nodes, fnid, 4) & 0xFFFF
            mut pi := 0
            while pi < pcnt {
                pn := ibuf_get(extra, pl_off + pi)
                scan_calls_expr_ax(pool, nodes, extra, sym, live, queue, ast_get(nodes, pn, 5))
                pi += 1
            }
            body := ast_get(nodes, fnid, 6) & 0xFFFFFFFF
            scan_calls_block_ax(pool, nodes, extra, sym, live, queue, body)
        }
    }
    buf_free(move queue)
}

// Unified v7.0 x86_64 Native Compiler & Multi-OS Binary Builder (`PE32+ .exe/.dll/.pyd`, `ELF64`, `Mach-O 64`, `Unikernel`)!
// `simd_mode`: `-1 = Auto CPUID`, `0 = Scalar SSE2`, `1 = AVX2+FMA3`, `2 = AVX-512F EVEX`.
// `link_libs`: pairs `[path_soff, path_slen]` in `pool` for static Win64 COFF `.obj` / `!<arch>\n` `.lib` archives!
fn compile_module_x86_64_v7(pool: ByteBuf, nodes: IntBuf, extra: IntBuf, sym: IntBuf, target_id: i64, is_dll: bool, test_mode: bool, force_shield: bool, simd_mode: i64, link_libs: IntBuf, out_buf: ByteBuf, is_dce: bool = true, is_gui: bool = false) -> i64 {
    s_cnt := ibuf_get(sym, 4)
    f_base := ibuf_get(sym, 7)
    f_cnt := ibuf_get(sym, 8)
    live := ibuf_new(f_cnt + 8)
    mark_reachable_fns_ax(pool, nodes, extra, sym, is_dll, test_mode, live)

    mut os_mode := 0
    if target_id == tgt_win_x64() {
        if is_dll { os_mode = 1 } else { os_mode = 0 }
    } else if target_id == tgt_linux_x64() {
        os_mode = 2
    } else if target_id == tgt_macos_x64() {
        os_mode = 3
    } else {
        os_mode = 4
    }

    mut shield_on := 0
    if force_shield {
        shield_on = 1
    } else {
        mut fi := 0
        while fi < f_cnt {
            if ibuf_get(live, fi) == 1 and (ibuf_get(sym, f_base + fi * 10 + 9) & (fnflag_shield() | fnflag_whitebox())) != 0 {
                shield_on = 1
                break
            }
            fi += 1
        }
    }

    poly_seed := 0xA5A55A5AF00DCAFE ^ ((f_cnt *% 0x9E3779B97F4A7C15) +% (s_cnt *% 0xBF58476D1CE4E5B9) +% (buf_len(pool) *% 0x94D049BB133111EB))

    n_words := ibuf_len(nodes)
    mut code_cap := n_words * 64 + f_cnt * 2048 + 65536
    if code_cap < 65536 { code_cap = 65536 }
    mut rdata_cap := buf_len(pool) * 2 + 16384
    if rdata_cap < 16384 { rdata_cap = 16384 }
    mut fix_cap := code_cap / 4 + 8192
    if fix_cap < 8192 { fix_cap = 8192 }
    mut int_cap := f_cnt * 32 + 4096
    if int_cap < 4096 { int_cap = 4096 }

    code := buf_new(code_cap)
    rdata := buf_new(rdata_cap)
    fixups := ibuf_new(fix_cap)
    fn_ranges := ibuf_new(f_cnt * 4 + 256)
    interns := ibuf_new(int_cap)
    state_need := f_cnt + 400
    state := ibuf_new(state_need + 64)
    mut zi := 0
    while zi < state_need {
        ibuf_push(state, 0)
        zi += 1
    }
    ibuf_set(state, 0, shield_on)
    ibuf_set(state, 2, -1)
    ibuf_set(state, 15, poly_seed)
    ibuf_set(state, 16, os_mode)
    ibuf_set(state, 17, simd_mode)
    if test_mode { ibuf_set(state, 19, 1) }
    if is_gui { ibuf_set(state, 240, 1) }

    cg := CodegenCtx(pool, nodes, extra, sym, code, rdata, fixups, fn_ranges, interns, state)

    if test_mode {
        emit_test_runner_entry(cg)
    } else {
        emit_entry_only(cg)
    }

    mut emitted_fns := 0
    fn_sym_meta := ibuf_new(f_cnt * 3 + 32)
    mut fni := 0
    while fni < f_cnt {
        fo := f_base + fni * 10
        flags := ibuf_get(sym, fo + 9)
        if ibuf_get(live, fni) == 1 and (flags & (fnflag_extern() | fnflag_comptime())) == 0 {
            mc_align16(cg.code)
            fn_start := buf_len(cg.code)
            fix_mark := ibuf_len(cg.fixups)
            ibuf_set(cg.state, 256 + fni, fn_start)
            compile_single_fn_ax(cg, fni)
            // If this function jumps to `h_sec_trap`, route all trap Jccs through a 5-byte
            // local `CALL h_sec_trap` stub BEFORE `fn_end` so `[RSP]` pinpoints `#0` with 0 fast-path cost!
            fix_end := ibuf_len(cg.fixups)
            mut has_trap_jmp := false
            mut fk := fix_mark
            while fk < fix_end {
                if ibuf_get(cg.fixups, fk + 2) == fx_fn() and ibuf_get(cg.fixups, fk + 3) == h_sec_trap() {
                    dpos := ibuf_get(cg.fixups, fk)
                    if dpos >= 2 and buf_get(cg.code, dpos - 2) == 0x0F {
                        has_trap_jmp = true
                        break
                    }
                }
                fk += 4
            }
            if has_trap_jmp {
                stub_off := buf_len(cg.code)
                cg_call_fn(cg, h_sec_trap())
                fk = fix_mark
                while fk < fix_end {
                    if ibuf_get(cg.fixups, fk + 2) == fx_fn() and ibuf_get(cg.fixups, fk + 3) == h_sec_trap() {
                        dpos := ibuf_get(cg.fixups, fk)
                        if dpos >= 2 and buf_get(cg.code, dpos - 2) == 0x0F {
                            mc_patch_rel32(cg.code, dpos, stub_off)
                            ibuf_set(cg.fixups, fk + 2, 0)
                        }
                    }
                    fk += 4
                }
            }
            fn_end := buf_len(cg.code)
            ibuf_push(cg.fn_ranges, fn_start)
            ibuf_push(cg.fn_ranges, fn_end)
            ibuf_push(fn_sym_meta, fn_start)
            ibuf_push(fn_sym_meta, fn_end)
            ibuf_push(fn_sym_meta, fni)
            emitted_fns += 1
        }
        fni += 1
    }

    // Export symbol map metadata to `sym[33..34]` for `--emit-map`
    map_base := ibuf_len(sym)
    mut mi := 0
    while mi < ibuf_len(fn_sym_meta) {
        ibuf_push(sym, ibuf_get(fn_sym_meta, mi))
        mi += 1
    }
    ibuf_set(sym, 33, map_base)
    ibuf_set(sym, 34, emitted_fns)

    // Emit C-ABI export trampolines (`@export` / `@py_export`)
    exports := ibuf_new(128)
    fni = 0
    while fni < f_cnt {
        fo := f_base + fni * 10
        flags := ibuf_get(sym, fo + 9)
        if (flags & fnflag_export()) != 0 {
            w_off := emit_c_abi_export_wrapper(cg, fni)
            ibuf_push(exports, ibuf_get(sym, fo))
            ibuf_push(exports, ibuf_get(sym, fo + 1))
            ibuf_push(exports, w_off)
        }
        fni += 1
    }

    // Emit PIE-safe `.rdata` function symbol table for runtime stack backtraces (`h_sec_trap`)
    if cg_is_helper_used(cg, h_sec_trap()) and emitted_fns > 0 {
        name_roffs := ibuf_new(emitted_fns + 4)
        mut si_bt := 0
        while si_bt < emitted_fns {
            bfni := ibuf_get(fn_sym_meta, si_bt * 3 + 2)
            bfo := f_base + bfni * 10
            nroff := cg_intern_pool_slice(cg, ibuf_get(sym, bfo), ibuf_get(sym, bfo + 1))
            ibuf_push(name_roffs, nroff)
            si_bt += 1
        }
        while (buf_len(cg.rdata) & 3) != 0 { buf_push(cg.rdata, 0) }
        if buf_len(cg.rdata) == 0 { buf_push_u32(cg.rdata, 0) }
        symtab_off := buf_len(cg.rdata)
        si_bt = 0
        while si_bt < emitted_fns {
            bfni := ibuf_get(fn_sym_meta, si_bt * 3 + 2)
            bfo := f_base + bfni * 10
            buf_push_u32(cg.rdata, ibuf_get(fn_sym_meta, si_bt * 3))
            buf_push_u32(cg.rdata, ibuf_get(fn_sym_meta, si_bt * 3 + 1))
            buf_push_u32(cg.rdata, ibuf_get(name_roffs, si_bt))
            buf_push_u32(cg.rdata, ibuf_get(sym, bfo + 1))
            si_bt += 1
        }
        buf_push_u32(cg.rdata, 0); buf_push_u32(cg.rdata, 0)
        buf_push_u32(cg.rdata, 0); buf_push_u32(cg.rdata, 0)
        ibuf_set(cg.state, 22, symtab_off)
        buf_free(move name_roffs)
    }
    buf_free(move fn_sym_meta)

    emit_used_runtime_helpers(cg)

    // Merge Static Win64 COFF `.obj` / `!<arch>\n` `.lib` Libraries (`--link-lib`)
    coff_syms := ibuf_new(512)
    lib_cnt := ibuf_len(link_libs) / 2
    mut li := 0
    while li < lib_cnt {
        psoff := ibuf_get(link_libs, li * 2)
        pslen := ibuf_get(link_libs, li * 2 + 1)
        lpath := buf_slice_str(pool, psoff, psoff + pslen)
        raw_lib := fs_read_file(lpath) or buf_new(16)
        if buf_len(raw_lib) >= 20 {
            coff_link_archive_or_obj(pool, raw_lib, cg.code, cg.rdata, cg.fixups, coff_syms)
        }
        buf_free(move raw_lib)
        li += 1
    }
    if ibuf_len(coff_syms) > 0 {
        fni = 0
        while fni < f_cnt {
            fo := f_base + fni * 10
            flags := ibuf_get(sym, fo + 9)
            if (flags & fnflag_extern()) != 0 {
                fn_s := ibuf_get(sym, fo)
                fn_l := ibuf_get(sym, fo + 1)
                mut ci := 0
                while ci < ibuf_len(coff_syms) / 4 {
                    cb := ci * 4
                    if ibuf_get(coff_syms, cb + 2) == 1 and ibuf_get(coff_syms, cb + 1) == fn_l and pool_str_eq2(pool, ibuf_get(coff_syms, cb), fn_l, fn_s) {
                        ibuf_set(cg.state, 256 + fni, ibuf_get(coff_syms, cb + 3))
                        break
                    }
                    ci += 1
                }
            }
            fni += 1
        }
    }
    buf_free(move coff_syms)

    // Eliminate PE `.text` slack space when `@shield` is enabled by filling to 512-byte boundary with `0xCC` (`INT3`)
    if os_mode <= 1 and shield_on == 1 and buf_len(cg.code) > 0 {
        while (buf_len(cg.code) & 511) != 0 {
            buf_push(cg.code, 0xCC)
        }
    }
    shield_verified_len := buf_len(cg.code)
    shd_imm_pos := ibuf_get(cg.state, 2)
    if shd_imm_pos >= 0 {
        buf_put_u32(cg.code, shd_imm_pos, shield_verified_len)
    }

    // Build W^X `.data` RW initial image (`512` bytes, `g_cpu_threads = 1` initial default)
    data_sec := buf_new(512)
    mut dzi := 0
    while dzi < 512 {
        buf_push(data_sec, 0)
        dzi += 1
    }
    buf_put_u64(data_sec, data_off_cpu_threads(), 1)

    if os_mode <= 1 {
        // Win64 PE32+ `.exe` / `.dll` / `.pyd`
        ext_imports := ibuf_new(128)
        icnt := ibuf_len(cg.interns) / 4
        mut ii := 0
        while ii < icnt {
            ib := ii * 4
            if ibuf_get(cg.interns, ib) == 3 {
                pk_dll := ibuf_get(cg.interns, ib + 1)
                pk_fn := ibuf_get(cg.interns, ib + 2)
                ibuf_push(ext_imports, pk_dll & 0xFFFFFFFF)
                ibuf_push(ext_imports, ushr64(pk_dll, 32))
                ibuf_push(ext_imports, pk_fn & 0xFFFFFFFF)
                ibuf_push(ext_imports, ushr64(pk_fn, 32))
            }
            ii += 1
        }

        mut text_v_nz := buf_len(cg.code)
        if text_v_nz < 1 { text_v_nz = 1 }
        rdata_rva := pe_text_rva() + align_up(text_v_nz, 0x1000)
        rdata_full := buf_new(buf_len(cg.rdata) + 16384)
        pe_info := ibuf_new(128)
        prepare_pe_rdata_v7(pool, rdata_rva, ext_imports, exports, rdata_full, pe_info)

        user_rdata_rva := ibuf_get(pe_info, 4)
        rlen := buf_len(cg.rdata)
        mut ri := 0
        while ri < rlen {
            buf_push(rdata_full, buf_get(cg.rdata, ri))
            ri += 1
        }
        mut rfull_nz := buf_len(rdata_full)
        if rfull_nz < 1 { rfull_nz = 1 }
        data_rva := rdata_rva + align_up(rfull_nz, 0x1000)
        ibuf_set(pe_info, 5, data_rva)
        ibuf_set(pe_info, 12, poly_seed)
        mut dce_flag := 0
        if is_dce { dce_flag = 1 }
        ibuf_set(pe_info, 13, dce_flag)

        fxcnt := ibuf_len(cg.fixups) / 4
        mut xi := 0
        while xi < fxcnt {
            xb := xi * 4
            disp_pos := ibuf_get(cg.fixups, xb)
            next_rip := ibuf_get(cg.fixups, xb + 1)
            fxk := ibuf_get(cg.fixups, xb + 2)
            if fxk == 0 { xi += 1; continue }
            fxt := ibuf_get(cg.fixups, xb + 3)

            next_rip_rva := pe_text_rva() + next_rip
            mut target_rva := pe_text_rva()
            if fxk == fx_iat() {
                target_rva = pe_info_iat_rva(pe_info, fxt)
            } else if fxk == fx_rdata() {
                target_rva = user_rdata_rva + fxt
            } else if fxk == fx_shield() {
                target_rva = ibuf_get(pe_info, 2)
            } else if fxk == fx_fn() {
                if fxt >= 10000000 {
                    target_rva = pe_text_rva() + ibuf_get(cg.state, 170 + (fxt - 10000000))
                } else {
                    target_rva = pe_text_rva() + ibuf_get(cg.state, 256 + fxt)
                }
            } else if fxk == fx_data() {
                target_rva = data_rva + fxt
            }
            buf_put_u32(cg.code, disp_pos, target_rva - next_rip_rva)
            xi += 1
        }

        build_pe32_binary_v7(cg.code, shield_verified_len, rdata_full, data_sec, pe_info, cg.fn_ranges, is_dll, out_buf, is_gui)
        buf_free(move pe_info)
        buf_free(move rdata_full)
        buf_free(move ext_imports)
    } else if os_mode == 2 {
        // Linux x86_64 `ELF64`
        lay := ibuf_new(8)
        elf64_compute_layout_aligned(buf_len(cg.code), buf_len(cg.rdata), 0x1000, lay)
        text_va := ibuf_get(lay, 0)
        rdata_va := ibuf_get(lay, 1)
        data_va := ibuf_get(lay, 2)
        buf_free(move lay)

        fxcnt := ibuf_len(cg.fixups) / 4
        mut xi := 0
        while xi < fxcnt {
            xb := xi * 4
            disp_pos := ibuf_get(cg.fixups, xb)
            next_rip := ibuf_get(cg.fixups, xb + 1)
            fxk := ibuf_get(cg.fixups, xb + 2)
            if fxk == 0 { xi += 1; continue }
            fxt := ibuf_get(cg.fixups, xb + 3)
            mut target_va := text_va
            if fxk == fx_rdata() { target_va = rdata_va + fxt }
            else if fxk == fx_fn() {
                if fxt >= 10000000 { target_va = text_va + ibuf_get(cg.state, 170 + (fxt - 10000000)) }
                else { target_va = text_va + ibuf_get(cg.state, 256 + fxt) }
            }
            else if fxk == fx_data() { target_va = data_va + fxt }
            buf_put_u32(cg.code, disp_pos, target_va - (text_va + next_rip))
            xi += 1
        }
        if is_dce {
            _elf_pruned := elf64_dce_strip_analysis(cg.code, cg.fn_ranges, true)
        }
        build_elf64_executable(cg.code, cg.rdata, data_sec, 62, out_buf)
    } else if os_mode == 3 {
        // macOS x86_64 `Mach-O 64`
        lay := ibuf_new(8)
        macho64_compute_layout(buf_len(cg.code), buf_len(cg.rdata), lay)
        text_va := ibuf_get(lay, 0)
        rdata_va := ibuf_get(lay, 1)
        data_va := ibuf_get(lay, 2)
        buf_free(move lay)

        fxcnt := ibuf_len(cg.fixups) / 4
        mut xi := 0
        while xi < fxcnt {
            xb := xi * 4
            disp_pos := ibuf_get(cg.fixups, xb)
            next_rip := ibuf_get(cg.fixups, xb + 1)
            fxk := ibuf_get(cg.fixups, xb + 2)
            if fxk == 0 { xi += 1; continue }
            fxt := ibuf_get(cg.fixups, xb + 3)
            mut target_va := text_va
            if fxk == fx_rdata() { target_va = rdata_va + fxt }
            else if fxk == fx_fn() {
                if fxt >= 10000000 { target_va = text_va + ibuf_get(cg.state, 170 + (fxt - 10000000)) }
                else { target_va = text_va + ibuf_get(cg.state, 256 + fxt) }
            }
            else if fxk == fx_data() { target_va = data_va + fxt }
            buf_put_u32(cg.code, disp_pos, target_va - (text_va + next_rip))
            xi += 1
        }
        build_macho64_executable(cg.code, cg.rdata, data_sec, false, out_buf)
    } else {
        // Bare-Metal / Unikernel `Multiboot2` or Freestanding x86_64
        lay := ibuf_new(8)
        if target_id == tgt_unikernel_x64() {
            unikernel_compute_layout(buf_len(cg.code), buf_len(cg.rdata), lay)
        } else {
            freestanding_compute_layout(buf_len(cg.code), buf_len(cg.rdata), lay)
        }
        text_va := ibuf_get(lay, 0)
        rdata_va := ibuf_get(lay, 1)
        data_va := ibuf_get(lay, 2)
        buf_free(move lay)

        fxcnt := ibuf_len(cg.fixups) / 4
        mut xi := 0
        while xi < fxcnt {
            xb := xi * 4
            disp_pos := ibuf_get(cg.fixups, xb)
            next_rip := ibuf_get(cg.fixups, xb + 1)
            fxk := ibuf_get(cg.fixups, xb + 2)
            if fxk == 0 { xi += 1; continue }
            fxt := ibuf_get(cg.fixups, xb + 3)
            mut target_va := text_va
            if fxk == fx_rdata() { target_va = rdata_va + fxt }
            else if fxk == fx_fn() {
                if fxt >= 10000000 { target_va = text_va + ibuf_get(cg.state, 170 + (fxt - 10000000)) }
                else { target_va = text_va + ibuf_get(cg.state, 256 + fxt) }
            }
            else if fxk == fx_data() { target_va = data_va + fxt }
            buf_put_u32(cg.code, disp_pos, target_va - (text_va + next_rip))
            xi += 1
        }
        if target_id == tgt_unikernel_x64() {
            build_unikernel_multiboot2(cg.code, cg.rdata, data_sec, out_buf)
        } else {
            build_freestanding_x64_kernel(cg.code, cg.rdata, data_sec, out_buf)
        }
    }

    buf_free(move data_sec)
    buf_free(move exports)
    buf_free(move live)
    buf_free(move state)
    buf_free(move interns)
    buf_free(move fn_ranges)
    buf_free(move fixups)
    buf_free(move rdata)
    buf_free(move code)
    return emitted_fns
}
