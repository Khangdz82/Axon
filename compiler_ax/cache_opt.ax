// Axon Compiler: Cache-Oblivious Tiling & Non-Temporal Streaming Stores
// Optimizes memory hierarchy: L1 (32 KB), L2 (512 KB), streaming directly to RAM when size > L3.

struct CacheTilingConfig {
    l1_block_bytes: i32,  // 32768 (32 KB L1d)
    l2_block_bytes: i32,  // 524288 (512 KB L2)
    l3_threshold: i64,    // 8388608 (8 MB L3 cutoff for non-temporal stores)
    use_streaming_store: i32,
}

fn cache_opt_init() -> CacheTilingConfig {
    return CacheTilingConfig(32768, 524288, 8388608, 0);
}

/// Computes optimal loop tile size for matrix/table operations
fn compute_tile_size(elem_bytes: i32, total_elems: i64) -> i32 {
    let l1_capacity = 32768 / elem_bytes;
    if total_elems <= (l1_capacity as i64) {
        return total_elems as i32; // Fits entirely in L1
    }
    // Block size fits 1/4 of L1 to leave room for input/output registers
    return l1_capacity / 4;
}

/// Decides whether to emit Non-Temporal Streaming Stores (VMOVNTPS / STNP)
fn should_use_streaming_store(total_bytes: i64) -> i32 {
    // If working set exceeds 8 MB (L3 cache boundary), bypass cache hierarchy
    if total_bytes >= 8388608 {
        return 1; // VMOVNTPS on x86_64, STNP on ARM64
    }
    return 0; // Standard cached store
}
