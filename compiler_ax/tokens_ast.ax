// --- Resolved Semantic Type Tags ---
// Encoded as `tag + (payload << 8)`:
//   1 = Int, 2 = Float, 3 = Dec, 4 = Bool, 5 = Str, 6 = Unit, 7 = Any,
//   8 = ByteBuf, 9 = IntBuf,
//   10 = Struct(struct_idx), 11 = Interface(iface_idx), 12 = Table(elem_code),
//   13 = Result(ok_ty_packed), 14 = Tuple(tuple_desc_off), 15 = Job(inner_ty),
//   16 = Tainted(inner_ty), 17 = Vec3, 18 = Vec4, 19 = Quat, 20 = Mat4,
//   21 = Tensor(tensor_desc_off), 22 = Coro(inner_ty)
fn ty_int() -> i64     { return 1 }
fn ty_float() -> i64   { return 2 }
fn ty_dec() -> i64     { return 3 }
fn ty_bool() -> i64    { return 4 }
fn ty_str() -> i64     { return 5 }
fn ty_unit() -> i64    { return 6 }
fn ty_any() -> i64     { return 7 }
fn ty_bytebuf() -> i64 { return 8 }
fn ty_intbuf() -> i64  { return 9 }
fn ty_vec3() -> i64    { return 17 }
fn ty_vec4() -> i64    { return 18 }
fn ty_quat() -> i64    { return 19 }
fn ty_mat4() -> i64    { return 20 }
fn ty_tag(t: i64) -> i64 { return t & 255 }
fn ty_pay(t: i64) -> i64 { return (t >> 8) & 0xFFFFFF }
fn ty_make(tag: i64, pay: i64) -> i64 { return (tag & 255) | (pay << 8) }

// --- Target OS & Architecture Identifiers ---
fn tgt_win_x64() -> i64        { return 0 }
fn tgt_linux_x64() -> i64      { return 1 }
fn tgt_macos_x64() -> i64      { return 2 }
fn tgt_linux_arm64() -> i64    { return 3 }
fn tgt_macos_arm64() -> i64    { return 4 }
fn tgt_wasm32() -> i64         { return 5 }
fn tgt_unikernel_x64() -> i64  { return 6 }
fn tgt_freestanding_x64() -> i64 { return 7 }
fn tgt_riscv64() -> i64        { return 8 }
fn tgt_spirv() -> i64          { return 9 }
fn tgt_ptx() -> i64            { return 10 }

// --- Unsigned 64-bit Logical Right Shift & Alignment Utilities ---
fn ushr64(x: i64, k: i64) -> i64 {
    if k <= 0 {
        return x
    }
    if k >= 64 {
        return 0
    }
    step1 := (x >> 1) & 0x7FFFFFFFFFFFFFFF
    if k == 1 {
        return step1
    }
    return step1 >> (k - 1)
}

fn align_up(val: i64, align: i64) -> i64 {
    return (val + align - 1) & (0 - align)
}

// --- Packed Source Span (`line | (col << 20) | (file_id << 36)`) ---
fn span_pack(line: i64, col: i64, file_id: i64) -> i64 {
    mut ln := line & 0xFFFFF
    if ln <= 0 { ln = 1 }
    mut cl := col & 0xFFFF
    if cl <= 0 { cl = 1 }
    return ln | (cl << 20) | ((file_id & 0xFFFF) << 36)
}

fn span_line(sp: i64) -> i64 {
    ln := sp & 0xFFFFF
    if ln <= 0 { return 1 }
    return ln
}

fn span_col(sp: i64) -> i64 {
    cl := (sp >> 20) & 0xFFFF
    if cl <= 0 { return 1 }
    return cl
}

fn span_file(sp: i64) -> i64 {
    return ushr64(sp, 36) & 0xFFFF
}

// --- String Pool & Byte Comparison Helpers ---
fn pool_str_eq_lit(pool: ByteBuf, off: i64, slen: i64, lit: str) -> bool {
    if slen != str_len(lit) {
        return false
    }
    s := buf_slice_str(pool, off, off + slen)
    return s == lit
}

fn pool_str_eq2(pool: ByteBuf, off1: i64, len1: i64, off2: i64) -> bool {
    if off1 == off2 {
        return true
    }
    mut i := 0
    while i < len1 {
        if buf_get(pool, off1 + i) != buf_get(pool, off2 + i) {
            return false
        }
        i += 1
    }
    return true
}

fn pool_fnv_slice(pool: ByteBuf, soff: i64, slen: i64) -> i64 {
    mut h := 2166136261
    mut i := 0
    while i < slen {
        h = ((h ^ buf_get(pool, soff + i)) *% 16777619) & 0xFFFFFFFF
        i += 1
    }
    return h
}

fn sym_find_fn_idx(pool: ByteBuf, sym: IntBuf, soff: i64, slen: i64) -> i64 {
    base := ibuf_get(sym, 7)
    hbase := ibuf_get(sym, 25)
    if hbase > 0 {
        mask := ibuf_get(sym, 28)
        mut slot := pool_fnv_slice(pool, soff, slen) & mask
        while true {
            v := ibuf_get(sym, hbase + slot)
            if v == 0 {
                return -1
            }
            fi := v - 1
            off := base + fi * 10
            if ibuf_get(sym, off + 1) == slen and pool_str_eq2(pool, ibuf_get(sym, off), slen, soff) {
                return fi
            }
            slot = (slot + 1) & mask
        }
    }
    cnt := ibuf_get(sym, 8)
    mut i := 0
    while i < cnt {
        off := base + i * 10
        if ibuf_get(sym, off + 1) == slen and pool_str_eq2(pool, ibuf_get(sym, off), slen, soff) {
            return i
        }
        i += 1
    }
    return -1
}

fn sym_find_struct_idx(pool: ByteBuf, sym: IntBuf, soff: i64, slen: i64) -> i64 {
    base := ibuf_get(sym, 3)
    hbase := ibuf_get(sym, 29)
    if hbase > 0 {
        mask := ibuf_get(sym, 30)
        mut slot := pool_fnv_slice(pool, soff, slen) & mask
        while true {
            v := ibuf_get(sym, hbase + slot)
            if v == 0 {
                return -1
            }
            si := v - 1
            off := base + si * 6
            if ibuf_get(sym, off + 1) == slen and pool_str_eq2(pool, ibuf_get(sym, off), slen, soff) {
                return si
            }
            slot = (slot + 1) & mask
        }
    }
    cnt := ibuf_get(sym, 4)
    mut i := 0
    while i < cnt {
        off := base + i * 6
        if ibuf_get(sym, off + 1) == slen and pool_str_eq2(pool, ibuf_get(sym, off), slen, soff) {
            return i
        }
        i += 1
    }
    return -1
}

fn pool_intern_str(pool: ByteBuf, s: str) -> i64 {
    off := buf_len(pool)
    buf_push_str(pool, s)
    return off
}

// --- Token Stream Helpers (5 words per token in `toks: IntBuf`) ---
// [tid*5 + 0] = kind, [+1] = str_off, [+2] = str_len, [+3] = num_val, [+4] = packed_span
fn tok_count(toks: IntBuf) -> i64 {
    return ibuf_len(toks) / 5
}

fn tok_push(toks: IntBuf, kind: i64, soff: i64, slen: i64) -> i64 {
    tid := ibuf_len(toks) / 5
    ibuf_push(toks, kind)
    ibuf_push(toks, soff)
    ibuf_push(toks, slen)
    ibuf_push(toks, 0)
    ibuf_push(toks, 1)
    return tid
}

fn tok_set_meta(toks: IntBuf, tid: i64, num_val: i64, span: i64) {
    base := tid * 5
    ibuf_set(toks, base + 3, num_val)
    ibuf_set(toks, base + 4, span)
}

fn tok_kind(toks: IntBuf, tid: i64) -> i64 {
    return ibuf_get(toks, tid * 5)
}

fn tok_soff(toks: IntBuf, tid: i64) -> i64 {
    return ibuf_get(toks, tid * 5 + 1)
}

fn tok_slen(toks: IntBuf, tid: i64) -> i64 {
    return ibuf_get(toks, tid * 5 + 2)
}

fn tok_num(toks: IntBuf, tid: i64) -> i64 {
    return ibuf_get(toks, tid * 5 + 3)
}

fn tok_span(toks: IntBuf, tid: i64) -> i64 {
    return ibuf_get(toks, tid * 5 + 4)
}

fn tok_line(toks: IntBuf, tid: i64) -> i64 {
    return span_line(ibuf_get(toks, tid * 5 + 4))
}

fn tok_col(toks: IntBuf, tid: i64) -> i64 {
    return span_col(ibuf_get(toks, tid * 5 + 4))
}

// --- Flat AST Arena Helpers (8 words per node in `nodes: IntBuf`) ---
// Node 0 & Node 1 (indices 0..15) store parser state header:
//   [0] = cur_tok, [1] = total_toks, [2] = err_count, [3] = err_span,
//   [4] = attr_flags, [5] = cur_impl_soff, [6] = cur_impl_slen, [7] = prog_root_id,
//   [8] = funcs_off, [9] = funcs_cnt, [10] = cimports_off, [11] = cimports_cnt,
//   [12] = comptime_off, [13] = comptime_cnt, [14] = cur_fn_meta_off, [15] = cur_file_id
fn ast_init(nodes: IntBuf) {
    mut i := 0
    while i < 16 {
        ibuf_push(nodes, 0)
        i += 1
    }
}

fn ast_alloc(nodes: IntBuf, kind: i64, span: i64) -> i64 {
    nid := ibuf_len(nodes) / 8
    ibuf_push(nodes, kind)
    ibuf_push(nodes, 0)
    ibuf_push(nodes, 0)
    ibuf_push(nodes, 0)
    ibuf_push(nodes, 0)
    ibuf_push(nodes, 0)
    ibuf_push(nodes, 0)
    ibuf_push(nodes, span)
    return nid
}

fn ast_kind(nodes: IntBuf, nid: i64) -> i64 {
    return ibuf_get(nodes, nid * 8)
}

fn ast_get(nodes: IntBuf, nid: i64, slot: i64) -> i64 {
    return ibuf_get(nodes, nid * 8 + slot)
}

fn ast_set(nodes: IntBuf, nid: i64, slot: i64, val: i64) {
    ibuf_set(nodes, nid * 8 + slot, val)
}

fn ast_span(nodes: IntBuf, nid: i64) -> i64 {
    return ibuf_get(nodes, nid * 8 + 7)
}

fn ast_line(nodes: IntBuf, nid: i64) -> i64 {
    return span_line(ibuf_get(nodes, nid * 8 + 7))
}

fn ast_col(nodes: IntBuf, nid: i64) -> i64 {
    return span_col(ibuf_get(nodes, nid * 8 + 7))
}
