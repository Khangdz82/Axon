// Axon Compiler: Human-Centric Diagnostics & Auto-Fix Engine
/// Structured Diagnostic Message with Fix Suggestion
struct Diagnostic {
    err_code: i32,
    line: i32,
    col: i32,
    severity: i32, // 1: error, 2: warning, 3: suggestion
    has_auto_fix: i32,
}

/// Auto-fix patch replacement
struct AutoFixPatch {
    span_start: i32,
    span_end: i32,
    replacement_id: i32,
}

/// Formats human-friendly error explaining the violation and actionable remedy
fn diagnostic_create(code: i32, line: i32, col: i32) -> Diagnostic {
    let has_fix = 1;
    return Diagnostic(code, line, col, 1, has_fix);
}

/// Generates suggestion for common beginner mistakes:
/// Code 101: Missing 'mut' on modified parameter
/// Code 102: Missing 'isolated' on spawned closure capture
/// Code 103: Returning reference forbidden (Second-Class Ref)
fn diagnostic_get_suggestion(code: i32) -> i32 {
    if code == 101 {
        // Suggest: prepend 'mut' to parameter declaration
        return 1;
    }
    if code == 102 {
        // Suggest: mark binding as 'isolated' to transfer ownership across threads
        return 2;
    }
    if code == 103 {
        // Suggest: return owned value or pass output buffer as 'mut' reference
        return 3;
    }
    return 0;
}

/// Applies automated fix patch when user runs `axc fix`
fn apply_auto_fix(mut diag: Diagnostic) -> i32 {
    if diag.has_auto_fix == 1 {
        return 1; // Successfully applied fix
    }
    return 0;
}
