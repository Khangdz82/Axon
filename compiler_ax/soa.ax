// Axon Compiler: Native Structure-of-Arrays (SoA) Lowering
struct SoAColumn {
    field_id: i32,
    elem_size: i32,
    alignment: i32,
    offset_in_header: i32,
}

struct SoATableLayout {
    struct_id: i32,
    column_count: i32,
    total_header_size: i32,
}

fn create_soa_layout(struct_id: i32, col_count: i32) -> SoATableLayout {
    let header_size = 16 + (col_count * 8);
    return SoATableLayout(struct_id, col_count, header_size);
}

fn calc_column_offset(col_index: i32) -> i32 {
    let offset = 16 + (col_index * 8);
    return offset;
}
