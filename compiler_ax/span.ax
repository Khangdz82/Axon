// Axon Compiler: Source Span & Diagnostics
struct ByteSpan {
    start: i32,
    end: i32,
    file_id: i32,
}

struct SourceLoc {
    line: i32,
    col: i32,
}

fn span_new(start: i32, end: i32, file_id: i32) -> ByteSpan {
    return ByteSpan(start, end, file_id);
}

fn span_merge(a: ByteSpan, b: ByteSpan) -> ByteSpan {
    let s = a.start;
    let e = b.end;
    return ByteSpan(s, e, a.file_id);
}

fn span_contains(span: ByteSpan, offset: i32) -> i32 {
    if offset < span.start {
        return 0;
    }
    if offset >= span.end {
        return 0;
    }
    return 1;
}
