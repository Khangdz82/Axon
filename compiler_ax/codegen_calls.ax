// Axon v7.0 Self-Hosted Compiler - Intrinsics, Safe Buffers, SIMD Math3D, DLPack, IOCP, Tensor & C-ABI FFI
// (`compiler_ax/codegen_calls.ax`) - 100% Pure Axon, Zero Stubs.

use compiler_ax::tokens_ast
use compiler_ax::sema_perceus
use compiler_ax::linker_pe
use compiler_ax::codegen_runtime
use compiler_ax::codegen_x86_64

fn er_pack(slot: i64, ty: i64) -> i64 {
    return (slot << 36) | (ty & 0xFFFFFFFFF)
}

fn er_slot(r: i64) -> i64 {
    return ushr64(r, 36)
}

fn er_ty(r: i64) -> i64 {
    return r & 0xFFFFFFFFF
}

fn cg_alloc_slots(cg: CodegenCtx, count: i64) -> i64 {
    mut n := count
    if n < 1 { n = 1 }
    cur := ibuf_get(cg.state, 4)
    next := cur + n
    ibuf_set(cg.state, 4, next)
    if next > ibuf_get(cg.state, 14) {
        ibuf_set(cg.state, 14, next)
    }
    return cur + 1
}

fn cg_var_find(pool: ByteBuf, vars: IntBuf, soff: i64, slen: i64) -> i64 {
    cnt := ibuf_len(vars) / 5
    mut i := cnt - 1
    while i >= 0 {
        b := i * 5
        if ibuf_get(vars, b + 1) == slen and pool_str_eq2(pool, ibuf_get(vars, b), slen, soff) {
            return b
        }
        i -= 1
    }
    return -1
}

fn cg_var_find_by_nid(vars: IntBuf, decl_nid: i64) -> i64 {
    cnt := ibuf_len(vars) / 5
    mut i := cnt - 1
    while i >= 0 {
        b := i * 5
        if ibuf_get(vars, b + 4) == decl_nid {
            return b
        }
        i -= 1
    }
    return -1
}

// --- Pure-SSE2 128-bit `vec3`/`vec4`/`quat` (`4 x f32` in 2 stack slots) Helpers ---
// Slot `(s, 0)` = `x_f32 | (y_f32 << 32)`, Slot `(s, 1)` = `z_f32 | (w_f32 << 32)`.
fn mc_load_xmm0_vec(c: ByteBuf, slot: i64, sub_base: i64) {
    mc_load_rax(c, slot, sub_base)
    mc_b4(c, 0x66, 0x48, 0x0F, 0x6E); mc_b1(c, 0xC0) // MOVQ XMM0, RAX
    mc_load_rax(c, slot, sub_base + 1)
    mc_b4(c, 0x66, 0x48, 0x0F, 0x6E); mc_b1(c, 0xD0) // MOVQ XMM2, RAX
    mc_b4(c, 0x66, 0x0F, 0x6C, 0xC2)                 // PUNPCKLQDQ XMM0, XMM2
}

fn mc_load_xmm1_vec(c: ByteBuf, slot: i64, sub_base: i64) {
    mc_load_rax(c, slot, sub_base)
    mc_b4(c, 0x66, 0x48, 0x0F, 0x6E); mc_b1(c, 0xC8) // MOVQ XMM1, RAX
    mc_load_rax(c, slot, sub_base + 1)
    mc_b4(c, 0x66, 0x48, 0x0F, 0x6E); mc_b1(c, 0xD0) // MOVQ XMM2, RAX
    mc_b4(c, 0x66, 0x0F, 0x6C, 0xCA)                 // PUNPCKLQDQ XMM1, XMM2
}

fn mc_store_xmm0_vec(c: ByteBuf, slot: i64, sub_base: i64) {
    mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0) // MOVQ RAX, XMM0
    mc_store_rax(c, slot, sub_base)
    mc_b3(c, 0x0F, 0x28, 0xD0)                       // MOVAPS XMM2, XMM0
    mc_b4(c, 0x66, 0x0F, 0x6D, 0xD2)                 // PUNPCKHQDQ XMM2, XMM2
    mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xD0) // MOVQ RAX, XMM2
    mc_store_rax(c, slot, sub_base + 1)
}

// Converts `f64` slot into `f32` bits in `EAX` (zero-extended in `RAX`)
fn mc_f64_slot_to_f32_eax(c: ByteBuf, slot: i64) {
    mc_load_rax(c, slot, 0)
    mc_b4(c, 0x66, 0x48, 0x0F, 0x6E); mc_b1(c, 0xC0) // MOVQ XMM0, RAX
    mc_b4(c, 0xF2, 0x0F, 0x5A, 0xC0)                 // CVTSD2SS XMM0, XMM0
    mc_b4(c, 0x66, 0x0F, 0x7E, 0xC0)                 // MOVD EAX, XMM0
}

// Emits `XMM0 = M * XMM1` where `M` is an 8-slot `mat4` at `mslot` (`4` columns x `2` slots)
fn mc_emit_mat4_mul_xmm1(c: ByteBuf, mslot: i64) {
    // Save `v` in `XMM3`
    mc_b3(c, 0x0F, 0x28, 0xD9) // MOVAPS XMM3, XMM1
    // col0 * v.xxxx -> XMM4
    mc_load_xmm0_vec(c, mslot, 0)
    mc_b3(c, 0x0F, 0x28, 0xCB)       // MOVAPS XMM1, XMM3
    mc_b4(c, 0x0F, 0xC6, 0xC9, 0x00) // SHUFPS XMM1, XMM1, 0x00
    mc_b3(c, 0x0F, 0x59, 0xC1)       // MULPS XMM0, XMM1
    mc_b3(c, 0x0F, 0x28, 0xE0)       // MOVAPS XMM4, XMM0
    // + col1 * v.yyyy
    mc_load_xmm0_vec(c, mslot, 2)
    mc_b3(c, 0x0F, 0x28, 0xCB)
    mc_b4(c, 0x0F, 0xC6, 0xC9, 0x55) // SHUFPS 0x55
    mc_b3(c, 0x0F, 0x59, 0xC1)
    mc_b3(c, 0x0F, 0x58, 0xE0)       // ADDPS XMM4, XMM0
    // + col2 * v.zzzz
    mc_load_xmm0_vec(c, mslot, 4)
    mc_b3(c, 0x0F, 0x28, 0xCB)
    mc_b4(c, 0x0F, 0xC6, 0xC9, 0xAA) // SHUFPS 0xAA
    mc_b3(c, 0x0F, 0x59, 0xC1)
    mc_b3(c, 0x0F, 0x58, 0xE0)
    // + col3 * v.wwww
    mc_load_xmm0_vec(c, mslot, 6)
    mc_b3(c, 0x0F, 0x28, 0xCB)
    mc_b4(c, 0x0F, 0xC6, 0xC9, 0xFF) // SHUFPS 0xFF
    mc_b3(c, 0x0F, 0x59, 0xC1)
    mc_b3(c, 0x0F, 0x58, 0xC4)       // ADDPS XMM0, XMM4
}

fn expr_has_shadowed_ident(cg: CodegenCtx, vars: IntBuf, enid: i64) -> bool {
    if enid <= 0 {
        return false
    }
    k := ast_kind(cg.nodes, enid)
    if k == nk_ident() {
        return cg_var_find(cg.pool, vars, ast_get(cg.nodes, enid, 1), ast_get(cg.nodes, enid, 2)) >= 0
    }
    if k == nk_unary() {
        return expr_has_shadowed_ident(cg, vars, ast_get(cg.nodes, enid, 2))
    }
    if k == nk_binary() {
        return expr_has_shadowed_ident(cg, vars, ast_get(cg.nodes, enid, 2)) or expr_has_shadowed_ident(cg, vars, ast_get(cg.nodes, enid, 3))
    }
    return false
}

fn is_nonshadowed_const_int(cg: CodegenCtx, vars: IntBuf, enid: i64) -> bool {
    if not is_const_int_expr(cg.pool, cg.nodes, cg.sym, enid) {
        return false
    }
    return not expr_has_shadowed_ident(cg, vars, enid)
}

fn emit_fast_val_arg(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, enid: i64) -> i64 {
    if is_nonshadowed_const_int(cg, vars, enid) {
        return -1
    }
    r := emit_expr_ax(cg, vars, drops, breaks, enid)
    return er_slot(r)
}

fn emit_load_or_imm_reg(cg: CodegenCtx, slot: i64, enid: i64, ridx: i64) {
    if slot < 0 {
        mc_mov_reg_imm(cg.code, ridx, eval_const_int_val(cg.pool, cg.nodes, cg.sym, enid))
        return
    }
    if ridx == 0 { mc_load_rcx(cg.code, slot, 0) }
    else if ridx == 1 { mc_load_rdx(cg.code, slot, 0) }
    else if ridx == 2 { mc_load_r8(cg.code, slot, 0) }
    else if ridx == 3 { mc_load_r9(cg.code, slot, 0) }
    else if ridx == 4 { mc_load_r10(cg.code, slot, 0) }
    else { mc_load_r11(cg.code, slot, 0) }
}

fn emit_alloc_raw_rax(cg: CodegenCtx) {
    // Input: `RDX = size_bytes`; Output: `RAX = allocated_ptr`
    c := cg.code
    mc_b3(c, 0x48, 0x89, 0xD1) // RCX = size_bytes
    cg_call_fn(cg, h_alloc_mem())
}

fn emit_free_raw_rcx(cg: CodegenCtx) {
    // Input: `RCX = ptr`
    cg_call_fn(cg, h_free_mem())
}

fn emit_print_value(cg: CodegenCtx, slot: i64, ty: i64) {
    c := cg.code
    mut tg := ty_tag(ty)
    if tg == 16 or tg == 22 {
        tg = ty_tag(ty_pay(ty))
    }
    if tg == 5 {
        mc_load_rax(c, slot, 1)
        mc_b3(c, 0x48, 0x89, 0xC2)
        mc_load_rax(c, slot, 0)
        mc_b3(c, 0x48, 0x89, 0xC1)
        cg_call_fn(cg, h_print_bytes())
        return
    }
    if tg == 3 {
        mc_load_rax(c, slot, 0)
        mc_b3(c, 0x48, 0x89, 0xC1)
        cg_call_fn(cg, h_print_dec())
        return
    }
    if tg == 2 {
        mc_load_rax(c, slot, 0)
        mc_b4(c, 0x66, 0x48, 0x0F, 0x6E)
        mc_b1(c, 0xC0)
        mc_b1(c, 0xB8)
        mc_u32(c, 10000)
        mc_b4(c, 0xF2, 0x48, 0x0F, 0x2A)
        mc_b1(c, 0xC8)
        mc_b4(c, 0xF2, 0x0F, 0x59, 0xC1)
        mc_b4(c, 0xF2, 0x48, 0x0F, 0x2C)
        mc_b1(c, 0xC8)
        cg_call_fn(cg, h_print_dec())
        return
    }
    if tg == 4 {
        t_off := cg_intern_lit(cg, "true")
        f_off := cg_intern_lit(cg, "false")
        mc_load_rax(c, slot, 0)
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_f := mc_jcc8(c, 0x74)
        cg_lea_rax_rdata(cg, t_off)
        mc_b1(c, 0xBA)
        mc_u32(c, 4)
        j_end := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jz_f, buf_len(c))
        cg_lea_rax_rdata(cg, f_off)
        mc_b1(c, 0xBA)
        mc_u32(c, 5)
        mc_patch_jcc8(c, j_end, buf_len(c))
        mc_b3(c, 0x48, 0x89, 0xC1)
        cg_call_fn(cg, h_print_bytes())
        return
    }
    mc_load_rax(c, slot, 0)
    mc_b3(c, 0x48, 0x89, 0xC1)
    cg_call_fn(cg, h_print_i64())
}

// Appends literal `lit` into `ByteBuf` stored at `jb_slot` (`[jb_slot] -> [len, cap, data...]`)
fn emit_jbuf_append_rdata(cg: CodegenCtx, jb_slot: i64, roff: i64, rlen: i64) {
    if rlen <= 0 { return }
    c := cg.code
    mc_load_rcx(c, jb_slot, 0)
    cg_lea_reg_rdata(cg, 1, roff)
    mc_mov_reg_imm(c, 2, rlen)
    cg_call_fn(cg, h_jbuf_raw())
    mc_store_rax(c, jb_slot, 0)
}

fn emit_jbuf_append_i64(cg: CodegenCtx, jb_slot: i64, val_slot: i64, sub_off: i64) {
    c := cg.code
    mc_load_rcx(c, jb_slot, 0)
    mc_load_rdx(c, val_slot, sub_off)
    cg_call_fn(cg, h_jbuf_i64())
    mc_store_rax(c, jb_slot, 0)
}

fn emit_jbuf_append_str(cg: CodegenCtx, jb_slot: i64, val_slot: i64, sub_off: i64) {
    c := cg.code
    mc_load_rcx(c, jb_slot, 0)
    mc_load_rdx(c, val_slot, sub_off)
    mc_load_r8(c, val_slot, sub_off + 1)
    cg_call_fn(cg, h_jbuf_qstr())
    mc_store_rax(c, jb_slot, 0)
}

// Compile-Time Zero-Reflection Struct -> JSON Code Generator (`to_json(val)`)
fn emit_to_json_intrinsic(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, arg_e: i64) -> i64 {
    c := cg.code
    vr := emit_expr_ax(cg, vars, drops, breaks, arg_e)
    vslot := er_slot(vr)
    vty := er_ty(vr)

    jb_slot := cg_alloc_slots(cg, 1)
    mc_b2(c, 0x31, 0xC9)
    cg_call_fn(cg, h_buf_new())
    mc_store_rax(c, jb_slot, 0)

    if ty_tag(vty) == 10 {
        sidx := ty_pay(vty)
        s_off := ibuf_get(cg.sym, 3) + sidx * 6
        f_base := ibuf_get(cg.sym, s_off + 3)
        f_cnt := ibuf_get(cg.sym, s_off + 4)
        lb_off := cg_intern_lit(cg, "{")
        rb_off := cg_intern_lit(cg, "}")
        cm_off := cg_intern_lit(cg, ",")
        qt_off := cg_intern_lit(cg, "\"")
        cl_off := cg_intern_lit(cg, "\":")
        tr_off := cg_intern_lit(cg, "true")
        fl_off := cg_intern_lit(cg, "false")

        emit_jbuf_append_rdata(cg, jb_slot, lb_off, 1)
        mut fi := 0
        while fi < f_cnt {
            if fi > 0 {
                emit_jbuf_append_rdata(cg, jb_slot, cm_off, 1)
            }
            fo := f_base + fi * 4
            fn_soff := ibuf_get(cg.sym, fo)
            fn_slen := ibuf_get(cg.sym, fo + 1)
            f_sub := ibuf_get(cg.sym, fo + 2)
            f_ty := ibuf_get(cg.sym, fo + 3)

            emit_jbuf_append_rdata(cg, jb_slot, qt_off, 1)
            fn_roff := cg_intern_pool_slice(cg, fn_soff, fn_slen)
            emit_jbuf_append_rdata(cg, jb_slot, fn_roff, fn_slen)
            emit_jbuf_append_rdata(cg, jb_slot, cl_off, 2)

            ftg := ty_tag(f_ty)
            if ftg == 5 {
                emit_jbuf_append_str(cg, jb_slot, vslot, f_sub)
            } else if ftg == 4 {
                mc_load_rax(c, vslot, f_sub)
                mc_b3(c, 0x48, 0x85, 0xC0)
                jz_f := mc_jcc32(c, 0x84)
                emit_jbuf_append_rdata(cg, jb_slot, tr_off, 4)
                jmp_b := mc_jmp32(c)
                mc_patch_rel32(c, jz_f, buf_len(c))
                emit_jbuf_append_rdata(cg, jb_slot, fl_off, 5)
                mc_patch_rel32(c, jmp_b, buf_len(c))
            } else {
                emit_jbuf_append_i64(cg, jb_slot, vslot, f_sub)
            }
            fi += 1
        }
        emit_jbuf_append_rdata(cg, jb_slot, rb_off, 1)
    } else if ty_tag(vty) == 5 {
        emit_jbuf_append_str(cg, jb_slot, vslot, 0)
    } else {
        emit_jbuf_append_i64(cg, jb_slot, vslot, 0)
    }

    // Null-terminate `[jb + 16 + len] = 0` and return `(jb + 16, len)` as `str`
    dst := cg_alloc_slots(cg, 2)
    mc_load_rax(c, jb_slot, 0)
    mc_b3(c, 0x48, 0x8B, 0x08) // RCX = len
    mc_b4(c, 0xC6, 0x44, 0x08, 0x10); mc_b1(c, 0)
    mc_b4(c, 0x48, 0x8D, 0x40, 0x10)
    mc_store_rax(c, dst, 0)
    mc_b3(c, 0x48, 0x89, 0xC8)
    mc_store_rax(c, dst, 1)
    return er_pack(dst, ty_str())
}

// Emits v7.0 domain intrinsics (CPUID, Taint, Bare-Metal, Atomics, IOCP, DLPack, Math3D, Symbolic Tensors)
fn try_emit_v7_domain_intrinsic(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, call_nid: i64) -> i64 {
    c := cg.code
    p := cg.pool
    csoff := ast_get(cg.nodes, call_nid, 1)
    cslen := ast_get(cg.nodes, call_nid, 2)
    aoff := ast_get(cg.nodes, call_nid, 3)
    acnt := ast_get(cg.nodes, call_nid, 4)

    // 1. Compile-time / Hardware / CPUID / GPU-index intrinsics
    if pool_str_eq_lit(p, csoff, cslen, "comptime_assert") {
        zs := cg_alloc_slots(cg, 1)
        mc_mov_rax_imm(c, 0)
        mc_store_rax(c, zs, 0)
        return er_pack(zs, ty_unit())
    }
    if pool_str_eq_lit(p, csoff, cslen, "cpu_pause") {
        mc_b2(c, 0xF3, 0x90) // PAUSE
        zs := cg_alloc_slots(cg, 1)
        return er_pack(zs, ty_unit())
    }
    if pool_str_eq_lit(p, csoff, cslen, "cpu_simd_tier") and acnt == 0 {
        dst := cg_alloc_slots(cg, 1)
        cg_mov_rax_data(cg, data_off_simd_tier())
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }
    if pool_str_eq_lit(p, csoff, cslen, "cpu_threads") and acnt == 0 {
        dst := cg_alloc_slots(cg, 1)
        cg_mov_rax_data(cg, data_off_cpu_threads())
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }
    if pool_str_eq_lit(p, csoff, cslen, "gpu_thread_x") or pool_str_eq_lit(p, csoff, cslen, "gpu_block_x") or pool_str_eq_lit(p, csoff, cslen, "gpu_global_id") {
        dst := cg_alloc_slots(cg, 1)
        mc_mov_rax_imm(c, 0)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }
    if pool_str_eq_lit(p, csoff, cslen, "gpu_block_dim_x") {
        dst := cg_alloc_slots(cg, 1)
        mc_mov_rax_imm(c, 256)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }
    if pool_str_eq_lit(p, csoff, cslen, "to_json") and acnt == 1 {
        return emit_to_json_intrinsic(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
    }

    // 2. Cybersecurity `tainted[str]` wrappers & sinks
    if (pool_str_eq_lit(p, csoff, cslen, "taint_str") or pool_str_eq_lit(p, csoff, cslen, "env_input_tainted")) and acnt == 1 {
        sr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        return er_pack(er_slot(sr), ty_make(16, ty_str()))
    }
    if (pool_str_eq_lit(p, csoff, cslen, "trusted_str_unwrap") or pool_str_eq_lit(p, csoff, cslen, "tainted_raw_str")) and acnt == 1 {
        sr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        return er_pack(er_slot(sr), ty_str())
    }
    if pool_str_eq_lit(p, csoff, cslen, "sql_exec") and acnt == 1 {
        sr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        dst := cg_alloc_slots(cg, 1)
        mc_load_rax(c, er_slot(sr), 1)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }
    if (pool_str_eq_lit(p, csoff, cslen, "shell_exec") or pool_str_eq_lit(p, csoff, cslen, "os_exec")) and acnt == 1 {
        sr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        dst := cg_alloc_slots(cg, 1)
        mc_load_rcx(c, er_slot(sr), 0)
        mc_load_rdx(c, er_slot(sr), 1)
        cg_call_fn(cg, h_os_exec())
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }
    if pool_str_eq_lit(p, csoff, cslen, "stdin_read_line") and acnt == 1 {
        br := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        dst := cg_alloc_slots(cg, 1)
        mc_load_rcx(c, er_slot(br), 0)
        cg_call_fn(cg, h_stdin_read_line())
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }

    // 3. C-String & Aligned Memory & Bare-Metal Hardware Port/MMIO Intrinsics
    if pool_str_eq_lit(p, csoff, cslen, "c_str_ptr") and acnt == 1 {
        sr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        dst := cg_alloc_slots(cg, 1)
        mc_load_rax(c, er_slot(sr), 0)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }
    if pool_str_eq_lit(p, csoff, cslen, "str_from_cstr") and acnt == 1 {
        pr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        dst := cg_alloc_slots(cg, 2)
        mc_load_rax(c, er_slot(pr), 0)
        mc_store_rax(c, dst, 0)
        mc_b2(c, 0x31, 0xC9)
        mc_b3(c, 0x48, 0x85, 0xC0)
        jz_n := mc_jcc8(c, 0x74)
        slp := buf_len(c)
        mc_b4(c, 0x80, 0x3C, 0x08, 0x00)
        je_n := mc_jcc8(c, 0x74)
        mc_b3(c, 0x48, 0xFF, 0xC1)
        jmp_n := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_n, slp)
        mc_patch_jcc8(c, jz_n, buf_len(c))
        mc_patch_jcc8(c, je_n, buf_len(c))
        mc_b3(c, 0x48, 0x89, 0xC8)
        mc_store_rax(c, dst, 1)
        return er_pack(dst, ty_str())
