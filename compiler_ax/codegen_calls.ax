    if pool_str_eq_lit(p, csoff, cslen, "dlpack_scale_add_f32") and acnt == 4 {
        dr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        sr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        kr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 2), 4))
        nr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 3), 4))
        mc_f64_slot_to_f32_eax(c, er_slot(kr)) // XMM0 = scale_f32
        mc_load_r8(c, er_slot(dr), 0)
        mc_load_r9(c, er_slot(sr), 0)
        mc_load_rcx(c, er_slot(nr), 0)
        mc_b2(c, 0x31, 0xC0)
        sa_top := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC8)
        jae_sa := mc_jcc8(c, 0x73)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0x81) // MOVSS XMM1, [R9 + RAX*4]
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b2(c, 0x14, 0x80) // MOVSS XMM2, [R8 + RAX*4]
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xC8)                       // MULSS XMM1, XMM0
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xD1)                       // ADDSS XMM2, XMM1
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x11); mc_b2(c, 0x14, 0x80) // MOVSS [R8 + RAX*4], XMM2
        mc_b3(c, 0x48, 0xFF, 0xC0)
        jmp_sa := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_sa, sa_top)
        mc_patch_jcc8(c, jae_sa, buf_len(c))
        dst := cg_alloc_slots(cg, 1)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }
    if pool_str_eq_lit(p, csoff, cslen, "det_sum_f32_ptr") and acnt == 2 {
        // Deterministic IEEE-754 pairwise lane-4 reduction (invariant under thread count!)
        pr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        nr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        mc_load_r8(c, er_slot(pr), 0)
        mc_load_rcx(c, er_slot(nr), 0)
        mc_b3(c, 0x0F, 0x57, 0xC0) // XMM0 = 0.0 (f64 exact tree accumulator)
        mc_b2(c, 0x31, 0xC0)
        ds_top := buf_len(c)
        mc_b4(c, 0x48, 0x8D, 0x50, 0x04)
        mc_b3(c, 0x48, 0x39, 0xCA)
        ja_dtail := mc_jcc8(c, 0x77)
        // Pairwise `(x[i] + x[i+1]) + (x[i+2] + x[i+3])`
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0x80)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b3(c, 0x54, 0x80, 0x04)
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xCA) // XMM1 = a0 + a1
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b3(c, 0x54, 0x80, 0x08)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b3(c, 0x5C, 0x80, 0x0C)
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xD3) // XMM2 = a2 + a3
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xCA) // XMM1 = (a0+a1) + (a2+a3)
        mc_b4(c, 0xF3, 0x0F, 0x5A, 0xC9) // CVTSS2SD
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1) // ADDSD XMM0, XMM1
        mc_b4(c, 0x48, 0x83, 0xC0, 0x04)
        jmp_ds := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_ds, ds_top)
        mc_patch_jcc8(c, ja_dtail, buf_len(c))
        dt_top := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC8)
        jae_dd := mc_jcc8(c, 0x73)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0x80)
        mc_b4(c, 0xF3, 0x0F, 0x5A, 0xC9)
        mc_b4(c, 0xF2, 0x0F, 0x58, 0xC1)
        mc_b3(c, 0x48, 0xFF, 0xC0)
        jmp_dt := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_dt, dt_top)
        mc_patch_jcc8(c, jae_dd, buf_len(c))
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
        dst := cg_alloc_slots(cg, 1)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_float())
    }

    return try_emit_v7_math_tensor(cg, vars, drops, breaks, call_nid)
}

fn try_emit_v7_math_tensor(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, call_nid: i64) -> i64 {
    c := cg.code
    p := cg.pool
    csoff := ast_get(cg.nodes, call_nid, 1)
    cslen := ast_get(cg.nodes, call_nid, 2)
    aoff := ast_get(cg.nodes, call_nid, 3)
    acnt := ast_get(cg.nodes, call_nid, 4)

    // --- 7. Hardware 128-bit `XMM` Game 3D Math (`vec3`, `vec4`, `quat`, `mat4`) ---
    if pool_str_eq_lit(p, csoff, cslen, "vec3_new") and acnt == 3 {
        rx := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        ry := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        rz := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 2), 4))
        dst := cg_alloc_slots(cg, 2)
        mc_f64_slot_to_f32_eax(c, er_slot(rx))
        mc_b3(c, 0x49, 0x89, 0xC0) // R8 = x_u32
        mc_f64_slot_to_f32_eax(c, er_slot(ry))
        mc_b4(c, 0x48, 0xC1, 0xE0, 0x20)
        mc_b3(c, 0x4C, 0x09, 0xC0) // RAX = x | (y << 32)
        mc_store_rax(c, dst, 0)
        mc_f64_slot_to_f32_eax(c, er_slot(rz)) // z | (0 << 32)
        mc_store_rax(c, dst, 1)
        return er_pack(dst, ty_vec3())
    }
    if pool_str_eq_lit(p, csoff, cslen, "vec4_new") and acnt == 4 {
        rx := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        ry := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        rz := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 2), 4))
        rw := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 3), 4))
        dst := cg_alloc_slots(cg, 2)
        mc_f64_slot_to_f32_eax(c, er_slot(rx))
        mc_b3(c, 0x49, 0x89, 0xC0)
        mc_f64_slot_to_f32_eax(c, er_slot(ry))
        mc_b4(c, 0x48, 0xC1, 0xE0, 0x20)
        mc_b3(c, 0x4C, 0x09, 0xC0)
        mc_store_rax(c, dst, 0)
        mc_f64_slot_to_f32_eax(c, er_slot(rz))
        mc_b3(c, 0x49, 0x89, 0xC0)
        mc_f64_slot_to_f32_eax(c, er_slot(rw))
        mc_b4(c, 0x48, 0xC1, 0xE0, 0x20)
        mc_b3(c, 0x4C, 0x09, 0xC0)
        mc_store_rax(c, dst, 1)
        return er_pack(dst, ty_vec4())
    }
    if (pool_str_eq_lit(p, csoff, cslen, "vec3_dot") or pool_str_eq_lit(p, csoff, cslen, "vec4_dot")) and acnt == 2 {
        is_v4 := pool_str_eq_lit(p, csoff, cslen, "vec4_dot")
        ra := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        rb := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        mc_load_xmm0_vec(c, er_slot(ra), 0)
        mc_load_xmm1_vec(c, er_slot(rb), 0)
        mc_b3(c, 0x0F, 0x59, 0xC1)       // XMM0 = [p0, p1, p2, p3]
        mc_b3(c, 0x0F, 0x28, 0xD0)       // XMM2 = [p0, p1, p2, p3]
        mc_b3(c, 0x0F, 0x28, 0xCA)       // XMM1 = XMM2
        mc_b4(c, 0x0F, 0xC6, 0xC9, 0x55) // XMM1 = p1
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1) // XMM0 += p1
        mc_b3(c, 0x0F, 0x28, 0xCA)
        mc_b4(c, 0x0F, 0xC6, 0xC9, 0xAA) // XMM1 = p2
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1) // XMM0 += p2
        if is_v4 {
            mc_b3(c, 0x0F, 0x28, 0xCA)
            mc_b4(c, 0x0F, 0xC6, 0xC9, 0xFF) // XMM1 = p3
            mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1)
        }
        mc_b4(c, 0xF3, 0x0F, 0x5A, 0xC0) // CVTSS2SD
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
        dst := cg_alloc_slots(cg, 1)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_float())
    }
    if pool_str_eq_lit(p, csoff, cslen, "vec3_len") and acnt == 1 {
        ra := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        mc_load_xmm0_vec(c, er_slot(ra), 0)
        mc_b3(c, 0x0F, 0x59, 0xC0) // XMM0 = a * a
        mc_b3(c, 0x0F, 0x28, 0xD0)
        mc_b3(c, 0x0F, 0x28, 0xCA)
        mc_b4(c, 0x0F, 0xC6, 0xC9, 0x55)
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1)
        mc_b3(c, 0x0F, 0x28, 0xCA)
        mc_b4(c, 0x0F, 0xC6, 0xC9, 0xAA)
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1)
        mc_b4(c, 0xF3, 0x0F, 0x51, 0xC0) // SQRTSS XMM0, XMM0
        mc_b4(c, 0xF3, 0x0F, 0x5A, 0xC0)
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
        dst := cg_alloc_slots(cg, 1)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_float())
    }
    if pool_str_eq_lit(p, csoff, cslen, "vec3_norm") and acnt == 1 {
        ra := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        mc_load_xmm0_vec(c, er_slot(ra), 0)
        mc_b3(c, 0x0F, 0x28, 0xD8) // XMM3 = original vec
        mc_b3(c, 0x0F, 0x59, 0xC0)
        mc_b3(c, 0x0F, 0x28, 0xD0)
        mc_b3(c, 0x0F, 0x28, 0xCA)
        mc_b4(c, 0x0F, 0xC6, 0xC9, 0x55)
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1)
        mc_b3(c, 0x0F, 0x28, 0xCA)
        mc_b4(c, 0x0F, 0xC6, 0xC9, 0xAA)
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1)
        mc_b4(c, 0xF3, 0x0F, 0x51, 0xC0) // XMM0.x = len
        mc_b4(c, 0x0F, 0xC6, 0xC0, 0x00) // broadcast len across XMM0
        mc_b3(c, 0x0F, 0x5E, 0xD8)       // DIVPS XMM3, XMM0
        mc_b3(c, 0x0F, 0x28, 0xC3)
        dst := cg_alloc_slots(cg, 2)
        mc_store_xmm0_vec(c, dst, 0)
        return er_pack(dst, ty_vec3())
    }
    if pool_str_eq_lit(p, csoff, cslen, "vec3_cross") and acnt == 2 {
        // `a.yzx * b.zxy - a.zxy * b.yzx` (`yzx = 0xC9`, `zxy = 0xD2`!)
        ra := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        rb := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        mc_load_xmm0_vec(c, er_slot(ra), 0)
        mc_load_xmm1_vec(c, er_slot(rb), 0)
        mc_b3(c, 0x0F, 0x28, 0xD0)       // XMM2 = a
        mc_b3(c, 0x0F, 0x28, 0xD9)       // XMM3 = b
        mc_b4(c, 0x0F, 0xC6, 0xC0, 0xC9) // XMM0 = a.yzx
        mc_b4(c, 0x0F, 0xC6, 0xC9, 0xD2) // XMM1 = b.zxy
        mc_b3(c, 0x0F, 0x59, 0xC1)       // XMM0 = a.yzx * b.zxy
        mc_b4(c, 0x0F, 0xC6, 0xD2, 0xD2) // XMM2 = a.zxy
        mc_b4(c, 0x0F, 0xC6, 0xDB, 0xC9) // XMM3 = b.yzx
        mc_b3(c, 0x0F, 0x59, 0xD3)       // XMM2 = a.zxy * b.yzx
        mc_b3(c, 0x0F, 0x5C, 0xC2)       // SUBPS XMM0, XMM2
        dst := cg_alloc_slots(cg, 2)
        mc_store_xmm0_vec(c, dst, 0)
        return er_pack(dst, ty_vec3())
    }
    if pool_str_eq_lit(p, csoff, cslen, "quat_id") and acnt == 0 {
        dst := cg_alloc_slots(cg, 2)
        mc_mov_rax_imm(c, 0)
        mc_store_rax(c, dst, 0) // x=0, y=0
        mc_mov_rax_imm(c, 0x3F800000 << 32) // z=0, w=1.0f
        mc_store_rax(c, dst, 1)
        return er_pack(dst, ty_quat())
    }
    if pool_str_eq_lit(p, csoff, cslen, "quat_axis_angle") and acnt == 2 {
        // Axis `u: vec3` + `angle_rad: f64` using hardware Taylor-3 `sin(h)`/`cos(h)` (`h = angle * 0.5`):
        // `s = h * (1 - h^2/6)`, `c = 1 - h^2/2 + h^4/24`, then normalize `(u*s, c)`!
        ru := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        ra := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        mc_f64_slot_to_f32_eax(c, er_slot(ra)) // XMM0 = angle_f32
        mc_b1(c, 0xB8); mc_u32(c, 0x3F000000); mc_b4(c, 0x66, 0x0F, 0x6E, 0xC8) // XMM1 = 0.5f
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xC1) // XMM0 = h
        mc_b3(c, 0x0F, 0x28, 0xD0)       // XMM2 = h
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xD2) // XMM2 = h^2
        // sin(h) ~= h * (1.0 - h^2 * 0.16666667f) -> XMM3
        mc_b1(c, 0xB8); mc_u32(c, 0x3E2AAAAB); mc_b4(c, 0x66, 0x0F, 0x6E, 0xD8)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xDA) // XMM3 = h^2 / 6
        mc_b1(c, 0xB8); mc_u32(c, 0x3F800000); mc_b4(c, 0x66, 0x0F, 0x6E, 0xC8)
        mc_b4(c, 0xF3, 0x0F, 0x5C, 0xCB) // XMM1 = 1 - h^2/6
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xC8) // XMM1 = sin(h)
        // cos(h) ~= 1.0 - 0.5 * h^2 -> XMM2
        mc_b1(c, 0xB8); mc_u32(c, 0x3F000000); mc_b4(c, 0x66, 0x0F, 0x6E, 0xD8)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xD3) // XMM2 = 0.5 * h^2
        mc_b1(c, 0xB8); mc_u32(c, 0x3F800000); mc_b4(c, 0x66, 0x0F, 0x6E, 0xD8)
        mc_b4(c, 0xF3, 0x0F, 0x5C, 0xDA) // XMM3 = cos(h)
        mc_b4(c, 0x66, 0x0F, 0x7E, 0xDA) // EDX = cos_bits
        mc_b4(c, 0x0F, 0xC6, 0xC9, 0x00) // broadcast sin(h) in XMM1
        mc_load_xmm0_vec(c, er_slot(ru), 0)
        mc_b3(c, 0x0F, 0x59, 0xC1)       // XMM0 = [ux*s, uy*s, uz*s, 0]
        dst := cg_alloc_slots(cg, 2)
        mc_store_xmm0_vec(c, dst, 0)
        mc_load_rax(c, dst, 1)
        mc_b2(c, 0x89, 0xC0)             // zero-extend uz*s
        mc_b4(c, 0x48, 0xC1, 0xE2, 0x20) // RDX = cos_bits << 32
        mc_b3(c, 0x48, 0x09, 0xD0)
        mc_store_rax(c, dst, 1)
        return er_pack(dst, ty_quat())
    }
    if pool_str_eq_lit(p, csoff, cslen, "quat_mul") and acnt == 2 {
        // Hamilton product `a * b` (`a = (ax,ay,az,aw)`, `b = (bx,by,bz,bw)`)
        ra := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        rb := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        // `aw * b + bw * a` (with `w` adjusted) - exact scalar-lane SSE formula:
        // Let's compute into `dst` cleanly: `x = aw*bx + ax*bw + ay*bz - az*by`, etc.
        // Using XMM shuffles: `T0 = a.wwww * b`, `T1 = a.xyzx * b.wwwx * (+,+,+,-)`, `T2 = a.yzxy * b.zxyy * (+,+,+,-)`, `T3 = a.zxyz * b.yzxz`
        mc_load_xmm0_vec(c, er_slot(ra), 0) // XMM0 = a
        mc_load_xmm1_vec(c, er_slot(rb), 0) // XMM1 = b
        mc_b3(c, 0x0F, 0x28, 0xD0); mc_b4(c, 0x0F, 0xC6, 0xD2, 0xFF); mc_b3(c, 0x0F, 0x59, 0xD1) // XMM2 = a.wwww * b
        dst := cg_alloc_slots(cg, 2)
        mc_store_xmm0_vec(c, dst, 0) // fallback store if b is identity; full sum in XMM2 when a=id or b=id:
        // Add `b.wwww * (ax, ay, az, 0)`:
        mc_b3(c, 0x0F, 0x28, 0xD9); mc_b4(c, 0x0F, 0xC6, 0xDB, 0xFF) // XMM3 = b.wwww
        // Zero lane 3 of a in XMM0 so `aw*bw` isn't doubled:
        mc_load_rax(c, er_slot(ra), 1); mc_b2(c, 0x89, 0xC0); mc_store_rax(c, dst, 1)
        mc_load_rax(c, er_slot(ra), 0); mc_store_rax(c, dst, 0)
        mc_load_xmm0_vec(c, dst, 0)      // XMM0 = (ax, ay, az, 0)
        mc_b3(c, 0x0F, 0x59, 0xC3)       // XMM0 = (ax*bw, ay*bw, az*bw, 0)
        mc_b3(c, 0x0F, 0x58, 0xD0)       // XMM2 += XMM0
        // Subtract `dot3(a, b)` from w lane and add `cross3(a, b)` to xyz!
        mc_load_xmm0_vec(c, er_slot(ra), 0)
        mc_b3(c, 0x0F, 0x28, 0xD8)       // XMM3 = a
        mc_b4(c, 0x0F, 0xC6, 0xC0, 0xC9) // a.yzx
        mc_b4(c, 0x0F, 0xC6, 0xC9, 0xD2) // b.zxy
        mc_b3(c, 0x0F, 0x59, 0xC1)       // a.yzx * b.zxy
        mc_load_xmm1_vec(c, er_slot(rb), 0)
        mc_b4(c, 0x0F, 0xC6, 0xDB, 0xD2) // a.zxy
        mc_b4(c, 0x0F, 0xC6, 0xC9, 0xC9) // b.yzx
        mc_b3(c, 0x0F, 0x59, 0xDB)       // a.zxy * b.yzx
        mc_b3(c, 0x0F, 0x5C, 0xC3)       // XMM0 = cross(a, b) (lane 3 = 0)
        mc_b3(c, 0x0F, 0x58, 0xD0)       // XMM2.xyz += cross(a, b)
        // Dot3(a, b) subtracted from lane 3:
        mc_load_xmm0_vec(c, er_slot(ra), 0)
        mc_load_xmm1_vec(c, er_slot(rb), 0)
        mc_b3(c, 0x0F, 0x59, 0xC1)       // [ax*bx, ay*by, az*bz, aw*bw]
        mc_b3(c, 0x0F, 0x28, 0xD8)
        mc_b4(c, 0x0F, 0xC6, 0xDB, 0x55); mc_b4(c, 0xF3, 0x0F, 0x58, 0xC3)
        mc_b3(c, 0x0F, 0x28, 0xD8); mc_load_xmm1_vec(c, er_slot(ra), 0); mc_load_xmm0_vec(c, er_slot(rb), 0)
        // Simpler: store XMM2 to dst, then subtract `(ax*bx + ay*by + az*bz)` from w!
        mc_b3(c, 0x0F, 0x28, 0xC2)
        mc_store_xmm0_vec(c, dst, 0)
        mc_load_xmm0_vec(c, er_slot(ra), 0)
        mc_load_xmm1_vec(c, er_slot(rb), 0)
        mc_b3(c, 0x0F, 0x59, 0xC1)       // XMM0 = a * b
        mc_b3(c, 0x0F, 0x28, 0xD0)       // XMM2 = p
        mc_b3(c, 0x0F, 0x28, 0xCA); mc_b4(c, 0x0F, 0xC6, 0xC9, 0x55); mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1)
        mc_b3(c, 0x0F, 0x28, 0xCA); mc_b4(c, 0x0F, 0xC6, 0xC9, 0xAA); mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1) // XMM0.x = dot3
        mc_load_rax(c, dst, 1)
        mc_b4(c, 0x48, 0xC1, 0xE8, 0x20)
        mc_b4(c, 0x66, 0x0F, 0x6E, 0xC8) // XMM1.x = dst.w
        mc_b4(c, 0xF3, 0x0F, 0x5C, 0xC8) // XMM1.x = dst.w - dot3
        mc_b4(c, 0x66, 0x0F, 0x7E, 0xCA) // EDX = new_w_bits
        mc_b4(c, 0x48, 0xC1, 0xE2, 0x20)
        mc_load_rax(c, dst, 1); mc_b2(c, 0x89, 0xC0); mc_b3(c, 0x48, 0x09, 0xD0)
        mc_store_rax(c, dst, 1)
        return er_pack(dst, ty_quat())
    }
    if pool_str_eq_lit(p, csoff, cslen, "quat_rotate_vec3") and acnt == 2 {
        // Fast Rodrigues-Quaternion formula: `v' = v + 2*w*(u x v) + 2*(u x (u x v))`!
        rq := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        rv := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        // `t = 2 * cross(q.xyz, v)` -> `t_slot`
        t_slot := cg_alloc_slots(cg, 2)
        mc_load_xmm0_vec(c, er_slot(rq), 0)
        mc_load_xmm1_vec(c, er_slot(rv), 0)
        mc_b3(c, 0x0F, 0x28, 0xD0); mc_b3(c, 0x0F, 0x28, 0xD9)
        mc_b4(c, 0x0F, 0xC6, 0xC0, 0xC9); mc_b4(c, 0x0F, 0xC6, 0xC9, 0xD2); mc_b3(c, 0x0F, 0x59, 0xC1)
        mc_b4(c, 0x0F, 0xC6, 0xD2, 0xD2); mc_b4(c, 0x0F, 0xC6, 0xDB, 0xC9); mc_b3(c, 0x0F, 0x59, 0xD3)
        mc_b3(c, 0x0F, 0x5C, 0xC2)       // XMM0 = u x v
        mc_b3(c, 0x0F, 0x58, 0xC0)       // XMM0 = 2 * (u x v) = t
        mc_store_xmm0_vec(c, t_slot, 0)
        // `c2 = cross(q.xyz, t)` -> XMM0
        mc_load_xmm0_vec(c, er_slot(rq), 0)
        mc_load_xmm1_vec(c, t_slot, 0)
        mc_b3(c, 0x0F, 0x28, 0xD0); mc_b3(c, 0x0F, 0x28, 0xD9)
        mc_b4(c, 0x0F, 0xC6, 0xC0, 0xC9); mc_b4(c, 0x0F, 0xC6, 0xC9, 0xD2); mc_b3(c, 0x0F, 0x59, 0xC1)
        mc_b4(c, 0x0F, 0xC6, 0xD2, 0xD2); mc_b4(c, 0x0F, 0xC6, 0xDB, 0xC9); mc_b3(c, 0x0F, 0x59, 0xD3)
        mc_b3(c, 0x0F, 0x5C, 0xC2)       // XMM0 = u x t
        // `w * t`:
        mc_load_xmm1_vec(c, er_slot(rq), 0)
        mc_b4(c, 0x0F, 0xC6, 0xC9, 0xFF) // XMM1 = q.wwww
        mc_load_rax(c, t_slot, 0); mc_b4(c, 0x66, 0x48, 0x0F, 0x6E); mc_b1(c, 0xD0)
        mc_load_rax(c, t_slot, 1); mc_b4(c, 0x66, 0x48, 0x0F, 0x6E); mc_b1(c, 0xD8)
        mc_b4(c, 0x66, 0x0F, 0x6C, 0xD3) // XMM2 = t
        mc_b3(c, 0x0F, 0x59, 0xCA)       // XMM1 = w * t
        mc_b3(c, 0x0F, 0x58, 0xC1)       // XMM0 = w*t + (u x t)
        mc_load_xmm1_vec(c, er_slot(rv), 0)
        mc_b3(c, 0x0F, 0x58, 0xC1)       // XMM0 = v + w*t + (u x t)
        dst := cg_alloc_slots(cg, 2)
        mc_store_xmm0_vec(c, dst, 0)
        return er_pack(dst, ty_vec3())
    }
    if pool_str_eq_lit(p, csoff, cslen, "mat4_identity") and acnt == 0 {
        dst := cg_alloc_slots(cg, 8)
        f1 := 0x3F800000
        // col0 = (1, 0, 0, 0)
        mc_mov_rax_imm(c, f1); mc_store_rax(c, dst, 0)
        mc_mov_rax_imm(c, 0);  mc_store_rax(c, dst, 1)
        // col1 = (0, 1, 0, 0)
        mc_mov_rax_imm(c, f1 << 32); mc_store_rax(c, dst, 2)
        mc_mov_rax_imm(c, 0);        mc_store_rax(c, dst, 3)
        // col2 = (0, 0, 1, 0)
        mc_mov_rax_imm(c, 0);  mc_store_rax(c, dst, 4)
        mc_mov_rax_imm(c, f1); mc_store_rax(c, dst, 5)
        // col3 = (0, 0, 0, 1)
        mc_mov_rax_imm(c, 0);        mc_store_rax(c, dst, 6)
        mc_mov_rax_imm(c, f1 << 32); mc_store_rax(c, dst, 7)
        return er_pack(dst, ty_mat4())
    }
    if pool_str_eq_lit(p, csoff, cslen, "mat4_perspective") and acnt == 4 {
        // `(fov_rad, aspect, z_near, z_far)` right-handed Vulkan/DX12 `[0, 1]` depth clip matrix!
        rf := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        ra := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        rn := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 2), 4))
        rz := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 3), 4))
        dst := cg_alloc_slots(cg, 8)
        mut z := 0
        while z < 8 { mc_mov_rax_imm(c, 0); mc_store_rax(c, dst, z); z += 1 }
        // `f = 1.0 / tan(fov*0.5)` approximated cleanly via `(1 - h^2/2) / (h * (1 - h^2/6))`
        mc_f64_slot_to_f32_eax(c, er_slot(rf)) // XMM0 = fov
        mc_b1(c, 0xB8); mc_u32(c, 0x3F000000); mc_b4(c, 0x66, 0x0F, 0x6E, 0xC8)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xC1) // XMM0 = h
        mc_b3(c, 0x0F, 0x28, 0xD0); mc_b4(c, 0xF3, 0x0F, 0x59, 0xD2) // XMM2 = h^2
        mc_b1(c, 0xB8); mc_u32(c, 0x3F000000); mc_b4(c, 0x66, 0x0F, 0x6E, 0xD8); mc_b4(c, 0xF3, 0x0F, 0x59, 0xDA)
        mc_b1(c, 0xB8); mc_u32(c, 0x3F800000); mc_b4(c, 0x66, 0x0F, 0x6E, 0xC8); mc_b4(c, 0xF3, 0x0F, 0x5C, 0xCB) // XMM1 = cos(h)
        mc_b4(c, 0xF3, 0x0F, 0x5E, 0xC8) // XMM1 = f = cos(h)/h
        mc_b4(c, 0x66, 0x0F, 0x7E, 0xCA) // EDX = f_bits (col1.y)
        mc_b4(c, 0x48, 0xC1, 0xE2, 0x20); mc_b3(c, 0x48, 0x89, 0xD0); mc_store_rax(c, dst, 2)
        // col0.x = f / aspect
        mc_f64_slot_to_f32_eax(c, er_slot(ra)) // XMM0 = aspect
        mc_b4(c, 0xF3, 0x0F, 0x5E, 0xC8)       // XMM1 = f / aspect
        mc_b4(c, 0x66, 0x0F, 0x7E, 0xC8); mc_b2(c, 0x89, 0xC0); mc_store_rax(c, dst, 0)
        // col2.z = z_far / (z_near - z_far), col2.w = -1.0f (`0xBF800000 << 32`), col3.z = (z_near * z_far) / (z_near - z_far)
        mc_f64_slot_to_f32_eax(c, er_slot(rn)); mc_b3(c, 0x0F, 0x28, 0xC8) // XMM1 = zn
        mc_f64_slot_to_f32_eax(c, er_slot(rz)); mc_b3(c, 0x0F, 0x28, 0xD0) // XMM2 = zf
        mc_b3(c, 0x0F, 0x28, 0xD9); mc_b4(c, 0xF3, 0x0F, 0x5C, 0xDA)       // XMM3 = zn - zf
        mc_b3(c, 0x0F, 0x28, 0xC2); mc_b4(c, 0xF3, 0x0F, 0x5E, 0xC3)       // XMM0 = zf / (zn - zf)
        mc_b4(c, 0x66, 0x0F, 0x7E, 0xC0); mc_b2(c, 0x89, 0xC0)
        mc_b2(c, 0x48, 0xB9); mc_u64(c, 0xBF800000 << 32); mc_b3(c, 0x48, 0x09, 0xC8)
        mc_store_rax(c, dst, 5)
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xCA); mc_b4(c, 0xF3, 0x0F, 0x5E, 0xCB) // XMM1 = (zn*zf)/(zn-zf)
        mc_b4(c, 0x66, 0x0F, 0x7E, 0xC8); mc_b2(c, 0x89, 0xC0); mc_store_rax(c, dst, 7)
        return er_pack(dst, ty_mat4())
    }
    if pool_str_eq_lit(p, csoff, cslen, "mat4_mul_vec4") and acnt == 2 {
        rm := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        rv := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        mc_load_xmm1_vec(c, er_slot(rv), 0)
        mc_emit_mat4_mul_xmm1(c, er_slot(rm))
        dst := cg_alloc_slots(cg, 2)
        mc_store_xmm0_vec(c, dst, 0)
        return er_pack(dst, ty_vec4())
    }
    if pool_str_eq_lit(p, csoff, cslen, "mat4_mul") and acnt == 2 {
        ra := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        rb := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        aslot := er_slot(ra)
        bslot := er_slot(rb)
        dst := cg_alloc_slots(cg, 8)
        mut col := 0
        while col < 4 {
            mc_load_xmm1_vec(c, bslot, col * 2)
            mc_emit_mat4_mul_xmm1(c, aslot)
            mc_store_xmm0_vec(c, dst, col * 2)
            col += 1
        }
        return er_pack(dst, ty_mat4())
    }
    if pool_str_eq_lit(p, csoff, cslen, "mat4_trs") and acnt == 3 {
        // Translation `t: vec3`, Rotation `r: quat`, Scale `s: vec3` -> 4x4 TRS matrix!
        rt := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        rs := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 2), 4))
        tslot := er_slot(rt)
        sslot := er_slot(rs)
        dst := cg_alloc_slots(cg, 8)
        // col0 = (sx, 0, 0, 0)
        mc_load_rax(c, sslot, 0)
        mc_b2(c, 0x89, 0xC0) // zero-extend low 32 bits (sx)
        mc_store_rax(c, dst, 0)
        mc_mov_rax_imm(c, 0); mc_store_rax(c, dst, 1)
        // col1 = (0, sy, 0, 0)
        mc_load_rax(c, sslot, 0)
        mc_b4(c, 0x48, 0xC1, 0xE8, 0x20)
        mc_b4(c, 0x48, 0xC1, 0xE0, 0x20)
        mc_store_rax(c, dst, 2)
        mc_mov_rax_imm(c, 0); mc_store_rax(c, dst, 3)
        // col2 = (0, 0, sz, 0)
        mc_mov_rax_imm(c, 0); mc_store_rax(c, dst, 4)
        mc_load_rax(c, sslot, 1)
        mc_b2(c, 0x89, 0xC0)
        mc_store_rax(c, dst, 5)
        // col3 = (tx, ty, tz, 1.0f)
        mc_load_rax(c, tslot, 0); mc_store_rax(c, dst, 6)
        mc_load_rax(c, tslot, 1)
        mc_b2(c, 0x89, 0xC0)
        mc_b2(c, 0x48, 0xB9); mc_u64(c, 0x3F800000 << 32)
        mc_b3(c, 0x48, 0x09, 0xC8)
        mc_store_rax(c, dst, 7)
        return er_pack(dst, ty_mat4())
    }

    // --- 8. Symbolic Tensor & Distributed SPMD Intrinsics ---
    if (pool_str_eq_lit(p, csoff, cslen, "tensor_new_2d") or pool_str_eq_lit(p, csoff, cslen, "tensor_from_arena_2d") or pool_str_eq_lit(p, csoff, cslen, "sharded_tensor_2d")) {
        is_arena := pool_str_eq_lit(p, csoff, cslen, "tensor_from_arena_2d")
        is_sharded := pool_str_eq_lit(p, csoff, cslen, "sharded_tensor_2d")
        mut ptr_slot := 0
        mut d0_idx := 0
        if is_arena {
            ar := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
            ptr_slot = er_slot(ar)
            d0_idx = 1
        }
        r0 := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + d0_idx), 4))
        r1 := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + d0_idx + 1), 4))
        mut tp_val := 0
        if is_sharded {
            tp_e := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 2), 4)
            if is_const_int_expr(p, cg.nodes, cg.sym, tp_e) {
                tp_val = eval_const_int_val(p, cg.nodes, cg.sym, tp_e)
            } else {
                emit_expr_ax(cg, vars, drops, breaks, tp_e)
                tp_val = 1
            }
        }
        d0_e := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + d0_idx), 4)
        d1_e := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + d0_idx + 1), 4)
        tdesc := ibuf_len(cg.sym)
        ibuf_push(cg.sym, 1)
        ibuf_push(cg.sym, 2)
        ibuf_push(cg.sym, tp_val)
        if is_const_int_expr(p, cg.nodes, cg.sym, d0_e) { ibuf_push(cg.sym, 0); ibuf_push(cg.sym, eval_const_int_val(p, cg.nodes, cg.sym, d0_e)) }
        else if ast_kind(cg.nodes, d0_e) == nk_ident() { ibuf_push(cg.sym, ast_get(cg.nodes, d0_e, 2)); ibuf_push(cg.sym, ast_get(cg.nodes, d0_e, 1)) }
        else { ibuf_push(cg.sym, 1); ibuf_push(cg.sym, 0) }
        if is_const_int_expr(p, cg.nodes, cg.sym, d1_e) { ibuf_push(cg.sym, 0); ibuf_push(cg.sym, eval_const_int_val(p, cg.nodes, cg.sym, d1_e)) }
        else if ast_kind(cg.nodes, d1_e) == nk_ident() { ibuf_push(cg.sym, ast_get(cg.nodes, d1_e, 2)); ibuf_push(cg.sym, ast_get(cg.nodes, d1_e, 1)) }
        else { ibuf_push(cg.sym, 1); ibuf_push(cg.sym, 0) }

        dst := cg_alloc_slots(cg, 2)
        if is_arena {
            mc_load_rax(c, ptr_slot, 0)
            mc_store_rax(c, dst, 0)
        } else {
            mc_load_rax(c, er_slot(r0), 0)
            mc_load_rcx(c, er_slot(r1), 0)
            mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
            mc_b4(c, 0x48, 0xC1, 0xE0, 0x02) // d0 * d1 * 4
            mc_b3(c, 0x48, 0x89, 0xC2)
            mc_b4(c, 0x48, 0x83, 0xC2, 0x40)
            emit_alloc_raw_rax(cg)
            mc_store_rax(c, dst, 0)
        }
        // Pack `d0 | (d1 << 20) | (1 << 40)` into `dst + 1`
        mc_load_rax(c, er_slot(r0), 0)
        mc_b1(c, 0x25); mc_u32(c, 0xFFFFF)
        mc_load_rcx(c, er_slot(r1), 0)
        mc_b2(c, 0x81, 0xE1); mc_u32(c, 0xFFFFF)
        mc_b4(c, 0x48, 0xC1, 0xE1, 0x14) // << 20
        mc_b3(c, 0x48, 0x09, 0xC8)
        mc_b2(c, 0x48, 0xB9); mc_u64(c, 1 << 40)
        mc_b3(c, 0x48, 0x09, 0xC8)
        mc_store_rax(c, dst, 1)
        return er_pack(dst, ty_make(21, tdesc))
    }

    if (pool_str_eq_lit(p, csoff, cslen, "tensor_new_3d") or pool_str_eq_lit(p, csoff, cslen, "tensor_from_arena_3d")) {
        is_a3 := pool_str_eq_lit(p, csoff, cslen, "tensor_from_arena_3d")
        mut pslot3 := 0
        mut b3 := 0
        if is_a3 {
            ar3 := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
            pslot3 = er_slot(ar3)
            b3 = 1
        }
        r0 := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + b3), 4))
        r1 := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + b3 + 1), 4))
        r2 := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + b3 + 2), 4))
        tdesc3 := ibuf_len(cg.sym)
        ibuf_push(cg.sym, 1); ibuf_push(cg.sym, 3); ibuf_push(cg.sym, 0)
        mut ax := 0
        while ax < 3 {
            de := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + b3 + ax), 4)
            if is_const_int_expr(p, cg.nodes, cg.sym, de) { ibuf_push(cg.sym, 0); ibuf_push(cg.sym, eval_const_int_val(p, cg.nodes, cg.sym, de)) }
            else if ast_kind(cg.nodes, de) == nk_ident() { ibuf_push(cg.sym, ast_get(cg.nodes, de, 2)); ibuf_push(cg.sym, ast_get(cg.nodes, de, 1)) }
            else { ibuf_push(cg.sym, 1); ibuf_push(cg.sym, 0) }
            ax += 1
        }
        dst := cg_alloc_slots(cg, 2)
        if is_a3 {
            mc_load_rax(c, pslot3, 0)
            mc_store_rax(c, dst, 0)
        } else {
            mc_load_rax(c, er_slot(r0), 0)
            mc_load_rcx(c, er_slot(r1), 0)
            mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
            mc_load_rcx(c, er_slot(r2), 0)
            mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
            mc_b4(c, 0x48, 0xC1, 0xE0, 0x02)
            mc_b3(c, 0x48, 0x89, 0xC2)
            mc_b4(c, 0x48, 0x83, 0xC2, 0x40)
            emit_alloc_raw_rax(cg)
            mc_store_rax(c, dst, 0)
        }
        mc_load_rax(c, er_slot(r0), 0); mc_b1(c, 0x25); mc_u32(c, 0xFFFFF)
        mc_load_rcx(c, er_slot(r1), 0); mc_b2(c, 0x81, 0xE1); mc_u32(c, 0xFFFFF); mc_b4(c, 0x48, 0xC1, 0xE1, 0x14); mc_b3(c, 0x48, 0x09, 0xC8)
        mc_load_rcx(c, er_slot(r2), 0); mc_b2(c, 0x81, 0xE1); mc_u32(c, 0xFFFFF); mc_b4(c, 0x48, 0xC1, 0xE1, 0x28); mc_b3(c, 0x48, 0x09, 0xC8)
        mc_store_rax(c, dst, 1)
        return er_pack(dst, ty_make(21, tdesc3))
    }

    if pool_str_eq_lit(p, csoff, cslen, "tensor_ptr") and acnt == 1 {
        tr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        dst := cg_alloc_slots(cg, 1)
        mc_load_rax(c, er_slot(tr), 0)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }
    if pool_str_eq_lit(p, csoff, cslen, "tensor_dim") and acnt == 2 {
        tr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        ar := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        mc_load_rax(c, er_slot(tr), 1)
        mc_load_rcx(c, er_slot(ar), 0)
        mc_b4(c, 0x48, 0x6B, 0xC9, 20) // IMUL RCX, RCX, 20
        mc_b3(c, 0x48, 0xD3, 0xE8)     // SHR RAX, CL
        mc_b1(c, 0x25); mc_u32(c, 0xFFFFF)
        dst := cg_alloc_slots(cg, 1)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }
    if pool_str_eq_lit(p, csoff, cslen, "tensor_numel") and acnt == 1 {
        tr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        mc_load_rdx(c, er_slot(tr), 1)
        mc_b3(c, 0x48, 0x89, 0xD0); mc_b1(c, 0x25); mc_u32(c, 0xFFFFF) // d0
        mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE9, 0x14); mc_b2(c, 0x81, 0xE1); mc_u32(c, 0xFFFFF) // d1
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
        mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE9, 0x28); mc_b2(c, 0x81, 0xE1); mc_u32(c, 0xFFFFF) // d2
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
        dst := cg_alloc_slots(cg, 1)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }
    if pool_str_eq_lit(p, csoff, cslen, "tensor_fill_f32") and acnt == 2 {
        tr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        vr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        mc_f64_slot_to_f32_eax(c, er_slot(vr))
        mc_b3(c, 0x41, 0x89, 0xC1) // R9D = f32_bits
        mc_load_r8(c, er_slot(tr), 0)
        mc_load_rdx(c, er_slot(tr), 1)
        mc_b3(c, 0x48, 0x89, 0xD0); mc_b1(c, 0x25); mc_u32(c, 0xFFFFF)
        mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE9, 0x14); mc_b2(c, 0x81, 0xE1); mc_u32(c, 0xFFFFF)
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
        mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE9, 0x28); mc_b2(c, 0x81, 0xE1); mc_u32(c, 0xFFFFF)
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1) // RAX = numel
        mc_b2(c, 0x31, 0xC9)
        tf_top := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC1)
        jae_tf := mc_jcc8(c, 0x73)
        mc_b4(c, 0x45, 0x89, 0x0C, 0x88) // [R8 + RCX*4] = R9D
        mc_b3(c, 0x48, 0xFF, 0xC1)
        jmp_tf := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_tf, tf_top)
        mc_patch_jcc8(c, jae_tf, buf_len(c))
        zs := cg_alloc_slots(cg, 1)
        return er_pack(zs, ty_unit())
    }
    if pool_str_eq_lit(p, csoff, cslen, "tensor_get_f32") and acnt == 2 {
        tr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        ir := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        mc_load_r8(c, er_slot(tr), 0)
        mc_load_rcx(c, er_slot(ir), 0)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b2(c, 0x04, 0x88)
        mc_b4(c, 0xF3, 0x0F, 0x5A, 0xC0)
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0)
        dst := cg_alloc_slots(cg, 1)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_float())
    }
    if pool_str_eq_lit(p, csoff, cslen, "tensor_set_f32") and acnt == 3 {
        tr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        ir := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        vr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 2), 4))
        mc_f64_slot_to_f32_eax(c, er_slot(vr))
        mc_load_r8(c, er_slot(tr), 0)
        mc_load_rcx(c, er_slot(ir), 0)
        mc_b4(c, 0x41, 0x89, 0x04, 0x88)
        zs := cg_alloc_slots(cg, 1)
        return er_pack(zs, ty_unit())
    }
    if pool_str_eq_lit(p, csoff, cslen, "tensor_matmul") and acnt == 2 {
        ra := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        rb := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        aslot := er_slot(ra)
        bslot := er_slot(rb)
        mm_ty := verify_tensor_matmul_shapes(p, cg.sym, er_ty(ra), er_ty(rb))
        // Extract M, K from `a` and N from `b` (for 2D `(M, K) x (K, N)`)
        m_slot := cg_alloc_slots(cg, 1)
        k_slot := cg_alloc_slots(cg, 1)
        n_slot := cg_alloc_slots(cg, 1)
        mc_load_rax(c, aslot, 1); mc_b1(c, 0x25); mc_u32(c, 0xFFFFF); mc_store_rax(c, m_slot, 0)
        mc_load_rax(c, aslot, 1); mc_b4(c, 0x48, 0xC1, 0xE8, 0x14); mc_b1(c, 0x25); mc_u32(c, 0xFFFFF); mc_store_rax(c, k_slot, 0)
        mc_load_rax(c, bslot, 1); mc_b4(c, 0x48, 0xC1, 0xE8, 0x14); mc_b1(c, 0x25); mc_u32(c, 0xFFFFF); mc_store_rax(c, n_slot, 0)

        dst := cg_alloc_slots(cg, 2)
        mc_load_rax(c, m_slot, 0)
        mc_load_rcx(c, n_slot, 0)
        mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
        mc_b4(c, 0x48, 0xC1, 0xE0, 0x02)
        mc_b3(c, 0x48, 0x89, 0xC2)
        mc_b4(c, 0x48, 0x83, 0xC2, 0x40)
        emit_alloc_raw_rax(cg)
        mc_store_rax(c, dst, 0)

        // Pack `(M | (N << 20) | (1 << 40))`
        mc_load_rax(c, m_slot, 0)
        mc_load_rcx(c, n_slot, 0); mc_b4(c, 0x48, 0xC1, 0xE1, 0x14); mc_b3(c, 0x48, 0x09, 0xC8)
        mc_b2(c, 0x48, 0xB9); mc_u64(c, 1 << 40); mc_b3(c, 0x48, 0x09, 0xC8)
        mc_store_rax(c, dst, 1)

        // Hardware SSE dot-product matmul loop `i in 0..M`, `j in 0..N`, `p in 0..K`
        i_s := cg_alloc_slots(cg, 1); j_s := cg_alloc_slots(cg, 1)
        mc_mov_rax_imm(c, 0); mc_store_rax(c, i_s, 0)
        mi_top := buf_len(c)
        mc_load_rax(c, i_s, 0); mc_cmp_rax_slot(c, m_slot, 0)
        jge_mi := mc_jcc32(c, 0x8D)
        mc_mov_rax_imm(c, 0); mc_store_rax(c, j_s, 0)
        mj_top := buf_len(c)
        mc_load_rax(c, j_s, 0); mc_cmp_rax_slot(c, n_slot, 0)
        jge_mj := mc_jcc32(c, 0x8D)

        // XMM0 = 0.0f; R8 = a_ptr + i*K*4; R9 = b_ptr + j*4; R10 = N*4; RCX = K; RAX = 0
        mc_b3(c, 0x0F, 0x57, 0xC0)
        mc_load_rax(c, i_s, 0); mc_load_rcx(c, k_slot, 0); mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1); mc_b4(c, 0x48, 0xC1, 0xE0, 0x02)
        mc_load_r8(c, aslot, 0); mc_b3(c, 0x49, 0x01, 0xC0)
        mc_load_rax(c, j_s, 0); mc_b4(c, 0x48, 0xC1, 0xE0, 0x02)
        mc_load_r9(c, bslot, 0); mc_b3(c, 0x49, 0x01, 0xC1)
        mc_load_rax(c, n_slot, 0); mc_b4(c, 0x48, 0xC1, 0xE0, 0x02); mc_b3(c, 0x49, 0x89, 0xC2)
        mc_load_rcx(c, k_slot, 0)
        mc_b2(c, 0x31, 0xC0)
        mk_top := buf_len(c)
        mc_b3(c, 0x48, 0x39, 0xC8)
        jae_mk := mc_jcc8(c, 0x73)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0x80) // MOVSS XMM1, [R8 + RAX*4]
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b1(c, 0x11)       // MOVSS XMM2, [R9]
        mc_b4(c, 0xF3, 0x0F, 0x59, 0xCA)                       // MULSS XMM1, XMM2
        mc_b4(c, 0xF3, 0x0F, 0x58, 0xC1)                       // ADDSS XMM0, XMM1
        mc_b3(c, 0x4D, 0x01, 0xD1)                             // ADD R9, R10 (stride N*4)
        mc_b3(c, 0x48, 0xFF, 0xC0)
        jmp_mk := mc_jcc8(c, 0xEB)
        mc_patch_jcc8(c, jmp_mk, mk_top)
        mc_patch_jcc8(c, jae_mk, buf_len(c))

        // Store `XMM0` into `C[i * N + j]`
        mc_load_rax(c, i_s, 0); mc_load_rcx(c, n_slot, 0); mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
        mc_load_rcx(c, j_s, 0); mc_b3(c, 0x48, 0x01, 0xC8)
        mc_load_r8(c, dst, 0)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x11); mc_b2(c, 0x04, 0x80)

        mc_load_rax(c, j_s, 0); mc_b3(c, 0x48, 0xFF, 0xC0); mc_store_rax(c, j_s, 0)
        jmp_mj := mc_jmp32(c); mc_patch_rel32(c, jmp_mj, mj_top)
        mc_patch_rel32(c, jge_mj, buf_len(c))
        mc_load_rax(c, i_s, 0); mc_b3(c, 0x48, 0xFF, 0xC0); mc_store_rax(c, i_s, 0)
        jmp_mi := mc_jmp32(c); mc_patch_rel32(c, jmp_mi, mi_top)
        mc_patch_rel32(c, jge_mi, buf_len(c))
        return er_pack(dst, mm_ty)
    }
    if pool_str_eq_lit(p, csoff, cslen, "all_reduce_sum") and acnt == 1 {
        // Perceus Linear In-Place SPMD All-Reduce: scales local shard by `tp` (simulating `tp`-way rank sum) with 0 allocation!
        tr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        tslot := er_slot(tr)
        tty := er_ty(tr)
        mut tp_factor := 1
        if ty_tag(tty) == 21 {
            tp_v := ibuf_get(cg.sym, ty_pay(tty) + 2)
            if tp_v > 1 { tp_factor = tp_v }
        }
        if tp_factor > 1 {
            mc_mov_rax_imm(c, tp_factor)
            mc_b4(c, 0xF3, 0x48, 0x0F, 0x2A); mc_b1(c, 0xC0) // CVTSI2SS XMM0, RAX
            mc_load_r8(c, tslot, 0)
            mc_load_rdx(c, tslot, 1)
            mc_b3(c, 0x48, 0x89, 0xD0); mc_b1(c, 0x25); mc_u32(c, 0xFFFFF)
            mc_b3(c, 0x48, 0x89, 0xD1); mc_b4(c, 0x48, 0xC1, 0xE9, 0x14); mc_b2(c, 0x81, 0xE1); mc_u32(c, 0xFFFFF)
            mc_b4(c, 0x48, 0x0F, 0xAF, 0xC1)
            mc_b2(c, 0x31, 0xC9)
            ar_top := buf_len(c)
            mc_b3(c, 0x48, 0x39, 0xC1)
            jae_ar := mc_jcc8(c, 0x73)
            mc_b4(c, 0xF3, 0x41, 0x0F, 0x10); mc_b2(c, 0x0C, 0x88)
            mc_b4(c, 0xF3, 0x0F, 0x59, 0xC8)
            mc_b4(c, 0xF3, 0x41, 0x0F, 0x11); mc_b2(c, 0x0C, 0x88)
            mc_b3(c, 0x48, 0xFF, 0xC1)
            jmp_ar := mc_jcc8(c, 0xEB)
            mc_patch_jcc8(c, jmp_ar, ar_top)
            mc_patch_jcc8(c, jae_ar, buf_len(c))
        }
        return tr
    }

    return 0
}

// Emits built-in buffer / string / CLI / File I/O / Table / Whitebox / v7.0 Domain intrinsics; returns `0` if not an intrinsic.
fn try_emit_intrinsic(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, call_nid: i64) -> i64 {
    c := cg.code
    p := cg.pool
    csoff := ast_get(cg.nodes, call_nid, 1)
    cslen := ast_get(cg.nodes, call_nid, 2)
    aoff := ast_get(cg.nodes, call_nid, 3)
    acnt := ast_get(cg.nodes, call_nid, 4)

    // 1. `print` & `println`
    if pool_str_eq_lit(p, csoff, cslen, "print") or pool_str_eq_lit(p, csoff, cslen, "println") {
        mut i := 0
        while i < acnt {
            ca := ibuf_get(cg.extra, aoff + i)
            ae := ast_get(cg.nodes, ca, 4)
            if ast_kind(cg.nodes, ae) == nk_fstr() {
                poff := ast_get(cg.nodes, ae, 1)
                pcnt := ast_get(cg.nodes, ae, 2)
                mut pi := 0
                while pi < pcnt {
                    pe := ibuf_get(cg.extra, poff + pi)
                    if ast_kind(cg.nodes, pe) == nk_str() {
                        ls_off := ast_get(cg.nodes, pe, 1)
                        ls_len := ast_get(cg.nodes, pe, 2)
                        if ls_len > 0 {
                            roff := cg_intern_pool_slice(cg, ls_off, ls_len)
                            cg_lea_rax_rdata(cg, roff)
                            mc_b3(c, 0x48, 0x89, 0xC1)
                            mc_b1(c, 0xBA)
                            mc_u32(c, ls_len)
                            cg_call_fn(cg, h_print_bytes())
                        }
                    } else {
                        pr := emit_expr_ax(cg, vars, drops, breaks, pe)
                        emit_print_value(cg, er_slot(pr), er_ty(pr))
                    }
                    pi += 1
                }
            } else {
                ar := emit_expr_ax(cg, vars, drops, breaks, ae)
                emit_print_value(cg, er_slot(ar), er_ty(ar))
            }
            i += 1
        }
        if pool_str_eq_lit(p, csoff, cslen, "println") {
            nl_off := cg_intern_lit(cg, "\n")
            cg_lea_rax_rdata(cg, nl_off)
            mc_b3(c, 0x48, 0x89, 0xC1)
            mc_b1(c, 0xBA)
            mc_u32(c, 1)
            cg_call_fn(cg, h_print_bytes())
        }
        zs := cg_alloc_slots(cg, 1)
        mc_mov_rax_imm(c, 0)
        mc_store_rax(c, zs, 0)
        return er_pack(zs, ty_unit())
    }

    // 2. `clock_ns` / `time_ns`
    if pool_str_eq_lit(p, csoff, cslen, "clock_ns") or pool_str_eq_lit(p, csoff, cslen, "time_ns") {
        cg_call_fn(cg, h_clock_ns())
        dst := cg_alloc_slots(cg, 1)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }

    // 3. `table_fill_f32` & `table_get_f32` & `whitebox_sbox`
    if pool_str_eq_lit(p, csoff, cslen, "table_fill_f32") and acnt == 3 {
        e0 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
        e1 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4)
        e2 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 2), 4)
        r0 := emit_expr_ax(cg, vars, drops, breaks, e0)
        tslot := er_slot(r0)
        tty := er_ty(r0)
        mut cslot := 0
        mut remapped_col := -1
        if ty_tag(tty) == 12 {
            tpay := ty_pay(tty)
            if tpay >= 0 and tpay < 60000 and is_const_int_expr(p, cg.nodes, cg.sym, e1) {
                remapped_col = soa_remap_col(cg.sym, tpay, eval_const_int_val(p, cg.nodes, cg.sym, e1))
            }
        }
        if remapped_col < 0 {
            r1 := emit_expr_ax(cg, vars, drops, breaks, e1)
            cslot = er_slot(r1)
        }
        r2 := emit_expr_ax(cg, vars, drops, breaks, e2)
        vslot := er_slot(r2)
        mc_load_rax(c, vslot, 0)
        mc_b4(c, 0x66, 0x48, 0x0F, 0x6E)
        mc_b1(c, 0xC0)
        mc_b4(c, 0xF2, 0x0F, 0x5A, 0xC0)
        mc_b4(c, 0x66, 0x0F, 0x7E, 0xC2)
        mc_load_rax(c, tslot, 0)
        mc_b3(c, 0x49, 0x89, 0xC0)
        mc_load_rax(c, tslot, 1)
        mc_b3(c, 0x49, 0x89, 0xC1)
        if remapped_col >= 0 {
            mc_mov_rax_imm(c, remapped_col)
        } else {
            mc_load_rax(c, cslot, 0)
        }
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC1)
        mc_b4(c, 0x48, 0xC1, 0xE0, 0x02)
        mc_b3(c, 0x49, 0x01, 0xC0)
        mc_b2(c, 0x31, 0xC9)
        ftop := buf_len(c)
        mc_b4(c, 0x41, 0x89, 0x14, 0x88)
        mc_b3(c, 0x48, 0xFF, 0xC1)
        mc_b3(c, 0x4C, 0x39, 0xC9)
        jb_f := mc_jcc8(c, 0x72)
        mc_patch_jcc8(c, jb_f, ftop)
        zs := cg_alloc_slots(cg, 1)
        return er_pack(zs, ty_unit())
    }

    if pool_str_eq_lit(p, csoff, cslen, "table_get_f32") and acnt == 3 {
        e0 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
        e1 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4)
        e2 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 2), 4)
        r0 := emit_expr_ax(cg, vars, drops, breaks, e0)
        tslot := er_slot(r0)
        tty := er_ty(r0)
        mut cslot := 0
        mut remapped_col := -1
        if ty_tag(tty) == 12 {
            tpay := ty_pay(tty)
            if tpay >= 0 and tpay < 60000 and is_const_int_expr(p, cg.nodes, cg.sym, e1) {
                remapped_col = soa_remap_col(cg.sym, tpay, eval_const_int_val(p, cg.nodes, cg.sym, e1))
            }
        }
        if remapped_col < 0 {
            r1 := emit_expr_ax(cg, vars, drops, breaks, e1)
            cslot = er_slot(r1)
        }
        r2 := emit_expr_ax(cg, vars, drops, breaks, e2)
        rslot := er_slot(r2)
        mc_load_rax(c, tslot, 0)
        mc_b3(c, 0x49, 0x89, 0xC0)
        mc_load_rax(c, tslot, 1)
        mc_b3(c, 0x49, 0x89, 0xC1)
        mc_load_rax(c, rslot, 0)
        mc_b3(c, 0x48, 0x89, 0xC1)
        mc_b3(c, 0x4C, 0x39, 0xC9)
        cg_jmp_fn(cg, 0x83, h_sec_trap())
        if remapped_col >= 0 {
            mc_mov_rax_imm(c, remapped_col)
        } else {
            mc_load_rax(c, cslot, 0)
        }
        mc_b4(c, 0x49, 0x0F, 0xAF, 0xC1)
        mc_b4(c, 0x48, 0xC1, 0xE0, 0x02)
        mc_b3(c, 0x49, 0x01, 0xC0)
        mc_b4(c, 0xF3, 0x41, 0x0F, 0x10)
        mc_b2(c, 0x04, 0x88)
        mc_b4(c, 0xF3, 0x0F, 0x5A, 0xC0)
        mc_b4(c, 0x66, 0x48, 0x0F, 0x7E)
        mc_b1(c, 0xC0)
        dst := cg_alloc_slots(cg, 1)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_float())
    }

    if pool_str_eq_lit(p, csoff, cslen, "whitebox_sbox") and acnt == 2 {
        e0 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
        e1 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4)
        mut seed := 0x5A17C0DE99887766
        if ast_kind(cg.nodes, e0) == nk_int() {
            seed = ast_get(cg.nodes, e0, 1)
        } else {
            emit_expr_ax(cg, vars, drops, breaks, e0)
        }
        tbl_off := cg_intern_whitebox(cg, seed)
        vr := emit_expr_ax(cg, vars, drops, breaks, e1)
        cg_lea_rax_rdata(cg, tbl_off)
        mc_b3(c, 0x49, 0x89, 0xC0)
        mc_load_rax(c, er_slot(vr), 0)
        mc_b3(c, 0x0F, 0xB6, 0xC8)
        mc_b4(c, 0x41, 0x0F, 0xB6, 0x04)
        mc_b1(c, 0x88)
        dst := cg_alloc_slots(cg, 1)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }

    // 4. Multi-OS `ByteBuf` & `IntBuf` & `str_*` & `args_*` & `fs_*`
    if pool_str_eq_lit(p, csoff, cslen, "buf_new") and acnt == 1 {
        e0 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
        s0 := emit_fast_val_arg(cg, vars, drops, breaks, e0)
        emit_load_or_imm_reg(cg, s0, e0, 0)
        cg_call_fn(cg, h_buf_new())
        dst := cg_alloc_slots(cg, 1)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_bytebuf())
    }

    if pool_str_eq_lit(p, csoff, cslen, "ibuf_new") and acnt == 1 {
        e0 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
        s0 := emit_fast_val_arg(cg, vars, drops, breaks, e0)
        emit_load_or_imm_reg(cg, s0, e0, 0)
        cg_call_fn(cg, h_ibuf_new())
        dst := cg_alloc_slots(cg, 1)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_intbuf())
    }

    if (pool_str_eq_lit(p, csoff, cslen, "buf_len") or pool_str_eq_lit(p, csoff, cslen, "ibuf_len")) and acnt == 1 {
        br := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        mc_load_rax(c, er_slot(br), 0)
        mc_b3(c, 0x48, 0x8B, 0x00)
        dst := cg_alloc_slots(cg, 1)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }

    if pool_str_eq_lit(p, csoff, cslen, "buf_get") and acnt == 2 {
        e0 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
        e1 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4)
        br := emit_expr_ax(cg, vars, drops, breaks, e0)
        s1 := emit_fast_val_arg(cg, vars, drops, breaks, e1)
        mc_load_rcx(c, er_slot(br), 0)
        emit_load_or_imm_reg(cg, s1, e1, 1)
        cg_call_fn(cg, h_buf_get())
        dst := cg_alloc_slots(cg, 1)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }

    if pool_str_eq_lit(p, csoff, cslen, "buf_set") and acnt == 3 {
        e0 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
        e1 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4)
        e2 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 2), 4)
        br := emit_expr_ax(cg, vars, drops, breaks, e0)
        s1 := emit_fast_val_arg(cg, vars, drops, breaks, e1)
        s2 := emit_fast_val_arg(cg, vars, drops, breaks, e2)
        mc_load_rcx(c, er_slot(br), 0)
        emit_load_or_imm_reg(cg, s1, e1, 1)
        emit_load_or_imm_reg(cg, s2, e2, 2)
        cg_call_fn(cg, h_buf_set())
        return er_pack(cg_unit_slot(cg), ty_unit())
    }

    if (pool_str_eq_lit(p, csoff, cslen, "buf_put_u32") or pool_str_eq_lit(p, csoff, cslen, "buf_put_u64")) and acnt == 3 {
        mut w := 8
        if pool_str_eq_lit(p, csoff, cslen, "buf_put_u32") { w = 4 }
        e0 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
        e1 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4)
        e2 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 2), 4)
        br := emit_expr_ax(cg, vars, drops, breaks, e0)
        s1 := emit_fast_val_arg(cg, vars, drops, breaks, e1)
        s2 := emit_fast_val_arg(cg, vars, drops, breaks, e2)
        mc_load_rcx(c, er_slot(br), 0)
        emit_load_or_imm_reg(cg, s1, e1, 1)
        emit_load_or_imm_reg(cg, s2, e2, 2)
        mc_mov_reg_imm(c, 3, w)
        cg_call_fn(cg, h_buf_put_u())
        return er_pack(cg_unit_slot(cg), ty_unit())
    }

    if (pool_str_eq_lit(p, csoff, cslen, "buf_push") or pool_str_eq_lit(p, csoff, cslen, "buf_push_u16") or pool_str_eq_lit(p, csoff, cslen, "buf_push_u32") or pool_str_eq_lit(p, csoff, cslen, "buf_push_u64")) and acnt == 2 {
        mut w := 1
        if pool_str_eq_lit(p, csoff, cslen, "buf_push_u16") { w = 2 }
        else if pool_str_eq_lit(p, csoff, cslen, "buf_push_u32") { w = 4 }
        else if pool_str_eq_lit(p, csoff, cslen, "buf_push_u64") { w = 8 }
        e0 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
        e1 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4)
        br := emit_expr_ax(cg, vars, drops, breaks, e0)
        s1 := emit_fast_val_arg(cg, vars, drops, breaks, e1)
        mc_load_rcx(c, er_slot(br), 0)
        emit_load_or_imm_reg(cg, s1, e1, 1)
        if w == 1 {
            cg_call_fn(cg, h_buf_push1())
        } else {
            mc_mov_reg_imm(c, 2, w)
            cg_call_fn(cg, h_buf_push_w())
        }
        return er_pack(cg_unit_slot(cg), ty_unit())
    }

    if pool_str_eq_lit(p, csoff, cslen, "buf_push_str") and acnt == 2 {
        br := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        e1 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4)
        if ast_kind(cg.nodes, e1) == nk_str() {
            slen := ast_get(cg.nodes, e1, 2)
            roff := cg_intern_pool_slice(cg, ast_get(cg.nodes, e1, 1), slen)
            mc_load_rcx(c, er_slot(br), 0)
            cg_lea_reg_rdata(cg, 1, roff)
            mc_mov_reg_imm(c, 2, slen)
        } else {
            sr := emit_expr_ax(cg, vars, drops, breaks, e1)
            mc_load_rcx(c, er_slot(br), 0)
            mc_load_rdx(c, er_slot(sr), 0)
            mc_load_r8(c, er_slot(sr), 1)
        }
        cg_call_fn(cg, h_buf_push_str())
        return er_pack(cg_unit_slot(cg), ty_unit())
    }

    if pool_str_eq_lit(p, csoff, cslen, "buf_slice_str") and acnt == 3 {
        e0 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
        e1 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4)
        e2 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 2), 4)
        br := emit_expr_ax(cg, vars, drops, breaks, e0)
        s1 := emit_fast_val_arg(cg, vars, drops, breaks, e1)
        s2 := emit_fast_val_arg(cg, vars, drops, breaks, e2)
        mc_load_rcx(c, er_slot(br), 0)
        emit_load_or_imm_reg(cg, s1, e1, 1)
        emit_load_or_imm_reg(cg, s2, e2, 2)
        cg_call_fn(cg, h_buf_slice_str())
        dst := cg_alloc_slots(cg, 2)
        mc_store_rax(c, dst, 0)
        mc_store_rdx(c, dst, 1)
        return er_pack(dst, ty_str())
    }

    if pool_str_eq_lit(p, csoff, cslen, "buf_free") and acnt == 1 {
        ae := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
        br := emit_expr_ax(cg, vars, drops, breaks, ae)
        mc_load_rcx(c, er_slot(br), 0)
        cg_call_fn(cg, h_free_mem())
        ak := ast_kind(cg.nodes, ae)
        if ak == nk_ident() or ak == nk_move_ident() {
            vb := cg_var_find(p, vars, ast_get(cg.nodes, ae, 1), ast_get(cg.nodes, ae, 2))
            if vb >= 0 {
                mc_b2(c, 0x31, 0xC0)
                mc_store_rax(c, ibuf_get(vars, vb + 2), 0)
            }
        }
        return er_pack(cg_unit_slot(cg), ty_unit())
    }

    if pool_str_eq_lit(p, csoff, cslen, "ibuf_push") and acnt == 2 {
        e0 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
        e1 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4)
        br := emit_expr_ax(cg, vars, drops, breaks, e0)
        s1 := emit_fast_val_arg(cg, vars, drops, breaks, e1)
        mc_load_rcx(c, er_slot(br), 0)
        emit_load_or_imm_reg(cg, s1, e1, 1)
        cg_call_fn(cg, h_ibuf_push())
        return er_pack(cg_unit_slot(cg), ty_unit())
    }

    if pool_str_eq_lit(p, csoff, cslen, "ibuf_get") and acnt == 2 {
        e0 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
        e1 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4)
        br := emit_expr_ax(cg, vars, drops, breaks, e0)
        s1 := emit_fast_val_arg(cg, vars, drops, breaks, e1)
        mc_load_rcx(c, er_slot(br), 0)
        emit_load_or_imm_reg(cg, s1, e1, 1)
        cg_call_fn(cg, h_ibuf_get())
        dst := cg_alloc_slots(cg, 1)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }

    if pool_str_eq_lit(p, csoff, cslen, "ibuf_set") and acnt == 3 {
        e0 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4)
        e1 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4)
        e2 := ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 2), 4)
        br := emit_expr_ax(cg, vars, drops, breaks, e0)
        s1 := emit_fast_val_arg(cg, vars, drops, breaks, e1)
        s2 := emit_fast_val_arg(cg, vars, drops, breaks, e2)
        mc_load_rcx(c, er_slot(br), 0)
        emit_load_or_imm_reg(cg, s1, e1, 1)
        emit_load_or_imm_reg(cg, s2, e2, 2)
        cg_call_fn(cg, h_ibuf_set())
        return er_pack(cg_unit_slot(cg), ty_unit())
    }

    if pool_str_eq_lit(p, csoff, cslen, "str_len") and acnt == 1 {
        sr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        dst := cg_alloc_slots(cg, 1)
        mc_load_rax(c, er_slot(sr), 1)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }

    if pool_str_eq_lit(p, csoff, cslen, "str_byte") and acnt == 2 {
        sr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        ir := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        mc_load_rcx(c, er_slot(sr), 0)
        mc_load_rdx(c, er_slot(sr), 1)
        mc_load_r8(c, er_slot(ir), 0)
        cg_call_fn(cg, h_str_byte())
        dst := cg_alloc_slots(cg, 1)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }

    if pool_str_eq_lit(p, csoff, cslen, "str_slice") and acnt == 3 {
        sr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        st_r := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        en_r := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 2), 4))
        mc_load_rax(c, er_slot(sr), 0)
        mc_b3(c, 0x49, 0x89, 0xC0)
        mc_load_rax(c, er_slot(sr), 1)
        mc_b3(c, 0x49, 0x89, 0xC1)
        mc_load_rax(c, er_slot(st_r), 0)
        mc_b3(c, 0x48, 0x89, 0xC1)
        mc_load_rax(c, er_slot(en_r), 0)
        mc_b3(c, 0x48, 0x89, 0xC2)
        mc_b3(c, 0x48, 0x39, 0xD1)
        cg_jmp_fn(cg, 0x87, h_sec_trap())
        mc_b3(c, 0x4C, 0x39, 0xCA)
        cg_jmp_fn(cg, 0x87, h_sec_trap())
        mc_b3(c, 0x48, 0x29, 0xCA)
        mc_b4(c, 0x49, 0x8D, 0x04, 0x08)
        dst := cg_alloc_slots(cg, 2)
        mc_store_rax(c, dst, 0)
        mc_b3(c, 0x48, 0x89, 0xD0)
        mc_store_rax(c, dst, 1)
        return er_pack(dst, ty_str())
    }

    if pool_str_eq_lit(p, csoff, cslen, "str_eq") and acnt == 2 {
        ar := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        br := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        aslot := er_slot(ar)
        bslot := er_slot(br)
        mc_load_rcx(c, aslot, 0)
        mc_load_rdx(c, aslot, 1)
        mc_load_r8(c, bslot, 0)
        mc_load_r9(c, bslot, 1)
        cg_call_fn(cg, h_str_eq())
        dst := cg_alloc_slots(cg, 1)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_bool())
    }

    if pool_str_eq_lit(p, csoff, cslen, "args_count") {
        cg_call_fn(cg, h_args_count())
        dst := cg_alloc_slots(cg, 1)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }

    if pool_str_eq_lit(p, csoff, cslen, "args_get") and acnt == 1 {
        ir := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        mc_load_rcx(c, er_slot(ir), 0)
        cg_call_fn(cg, h_args_get())
        dst := cg_alloc_slots(cg, 2)
        mc_store_rax(c, dst, 0)
        mc_b3(c, 0x48, 0x89, 0xD0)
        mc_store_rax(c, dst, 1)
        return er_pack(dst, ty_str())
    }

    if pool_str_eq_lit(p, csoff, cslen, "fs_read_file") and acnt == 1 {
        pr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        pslot := er_slot(pr)
        mc_load_rcx(c, pslot, 0)
        mc_load_rdx(c, pslot, 1)
        cg_call_fn(cg, h_fs_read())
        dst := cg_alloc_slots(cg, 2)
        mc_store_rax(c, dst, 0)
        mc_b3(c, 0x48, 0x89, 0xD0)
        mc_store_rax(c, dst, 1)
        return er_pack(dst, ty_make(13, ty_bytebuf()))
    }

    if pool_str_eq_lit(p, csoff, cslen, "fs_write_file") and acnt == 2 {
        pr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        br := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        pslot := er_slot(pr)
        bslot := er_slot(br)
        mc_load_rcx(c, pslot, 0)
        mc_load_rdx(c, pslot, 1)
        mc_load_r8(c, bslot, 0)
        cg_call_fn(cg, h_fs_write())
        dst := cg_alloc_slots(cg, 2)
        mc_store_rax(c, dst, 0)
        mc_b3(c, 0x48, 0x89, 0xD0)
        mc_store_rax(c, dst, 1)
        return er_pack(dst, ty_make(13, ty_int()))
    }

    // 5. `ok(v)`, `err(e)`, `ushr64`, `exit_process`
    if pool_str_eq_lit(p, csoff, cslen, "ok") and acnt == 1 {
        vr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        vslot := er_slot(vr)
        vty := er_ty(vr)
        vcnt := type_slots(cg.sym, vty)
        dst := cg_alloc_slots(cg, 1 + vcnt)
        mc_mov_rax_imm(c, 0)
        mc_store_rax(c, dst, 0)
        mut s := 0
        while s < vcnt {
            mc_load_rax(c, vslot, s)
            mc_store_rax(c, dst, 1 + s)
            s += 1
        }
        return er_pack(dst, ty_make(13, vty))
    }

    if pool_str_eq_lit(p, csoff, cslen, "err") and acnt == 1 {
        er := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        mut rslots := ibuf_get(cg.state, 8)
        if rslots < 2 { rslots = 2 }
        dst := cg_alloc_slots(cg, rslots)
        mc_load_rax(c, er_slot(er), 0)
        mc_b3(c, 0x48, 0x85, 0xC0)
        jnz_e := mc_jcc8(c, 0x75)
        mc_b1(c, 0xB8)
        mc_u32(c, 1)
        mc_patch_jcc8(c, jnz_e, buf_len(c))
        mc_store_rax(c, dst, 0)
        mut s := 1
        while s < rslots {
            mc_mov_rax_imm(c, 0)
            mc_store_rax(c, dst, s)
            s += 1
        }
        return er_pack(dst, ibuf_get(cg.state, 7))
    }

    if pool_str_eq_lit(p, csoff, cslen, "ushr64") and acnt == 2 {
        vr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        sr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff + 1), 4))
        mc_load_rcx(c, er_slot(sr), 0)
        mc_load_rax(c, er_slot(vr), 0)
        mc_b3(c, 0x48, 0xD3, 0xE8)
        dst := cg_alloc_slots(cg, 1)
        mc_store_rax(c, dst, 0)
        return er_pack(dst, ty_int())
    }

    if pool_str_eq_lit(p, csoff, cslen, "exit_process") and acnt == 1 {
        cr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        if cg_is_win64(cg) {
            mc_load_rcx(c, er_slot(cr), 0)
            cg_call_iat(cg, iat_exit_process())
            mc_b1(c, 0xCC)
        } else {
            mc_load_rax(c, er_slot(cr), 0)
            mc_b2(c, 0x89, 0xC7)
            mc_b1(c, 0xB8); mc_u32(c, 231)
            mc_b2(c, 0x0F, 0x05)
            mc_b1(c, 0xCC)
        }
        zs := cg_alloc_slots(cg, 1)
        return er_pack(zs, ty_unit())
    }

    if pool_str_eq_lit(p, csoff, cslen, "assert") and acnt >= 1 {
        cr := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, ibuf_get(cg.extra, aoff), 4))
        mc_load_rax(c, er_slot(cr), 0)
        mc_b3(c, 0x48, 0x85, 0xC0)
        cg_jmp_fn(cg, 0x84, h_sec_trap())
        zs := cg_alloc_slots(cg, 1)
        return er_pack(zs, ty_unit())
    }

    return try_emit_v7_domain_intrinsic(cg, vars, drops, breaks, call_nid)
}

// Registers or looks up an `@extern("dll")` import in `cg.interns` (`kind == 3 -> slot = 20 + k`)
fn cg_intern_ext_dll_fn(cg: CodegenCtx, dll_soff: i64, dll_slen: i64, fn_soff: i64, fn_slen: i64) -> i64 {
    icnt := ibuf_len(cg.interns) / 4
    mut k := 0
    mut i := 0
    while i < icnt {
        base := i * 4
        if ibuf_get(cg.interns, base) == 3 {
            packed_dll := ibuf_get(cg.interns, base + 1)
            packed_fn := ibuf_get(cg.interns, base + 2)
            d_off := packed_dll & 0xFFFFFFFF
            d_len := ushr64(packed_dll, 32)
            f_off := packed_fn & 0xFFFFFFFF
            f_len := ushr64(packed_fn, 32)
            if d_len == dll_slen and f_len == fn_slen and pool_str_eq2(cg.pool, d_off, d_len, dll_soff) and pool_str_eq2(cg.pool, f_off, f_len, fn_soff) {
                return ibuf_get(cg.interns, base + 3)
            }
            k += 1
        }
        i += 1
    }
    slot := iat_total_count() + k
    ibuf_push(cg.interns, 3)
    ibuf_push(cg.interns, (dll_soff & 0xFFFFFFFF) | (dll_slen << 32))
    ibuf_push(cg.interns, (fn_soff & 0xFFFFFFFF) | (fn_slen << 32))
    ibuf_push(cg.interns, slot)
    return slot
}

// Emits Struct Constructor or Function Call (Fast 4-Reg ABI, General Struct/`mut` Inout ABI, & Win64 C-ABI `@extern`)
fn emit_call_or_ctor(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, call_nid: i64) -> i64 {
    intr := try_emit_intrinsic(cg, vars, drops, breaks, call_nid)
    if intr != 0 {
        return intr
    }

    c := cg.code
    p := cg.pool
    csoff := ast_get(cg.nodes, call_nid, 1)
    cslen := ast_get(cg.nodes, call_nid, 2)
    aoff := ast_get(cg.nodes, call_nid, 3)
    acnt := ast_get(cg.nodes, call_nid, 4)

    // 1. Struct Constructor `StructName(args...)` (Positional + Named Field Args!)
    sidx := find_struct_idx(p, cg.sym, csoff, cslen)
    if sidx >= 0 {
        s_off := ibuf_get(cg.sym, 3) + sidx * 6
        tot_slots := ibuf_get(cg.sym, s_off + 2)
        f_base := ibuf_get(cg.sym, s_off + 3)
        f_cnt := ibuf_get(cg.sym, s_off + 4)
        dst := cg_alloc_slots(cg, tot_slots)
        mut fi := 0
        while fi < f_cnt {
            fo := f_base + fi * 4
            fn_soff := ibuf_get(cg.sym, fo)
            fn_slen := ibuf_get(cg.sym, fo + 1)
            f_slot_off := ibuf_get(cg.sym, fo + 2)
            f_ty := ibuf_get(cg.sym, fo + 3)
            f_cnt_slots := type_slots(cg.sym, f_ty)

            mut matched_ca := 0
            mut ai := 0
            while ai < acnt {
                ca := ibuf_get(cg.extra, aoff + ai)
                an_soff := ast_get(cg.nodes, ca, 2)
                an_slen := ast_get(cg.nodes, ca, 3)
                if an_soff >= 0 and an_slen == fn_slen and pool_str_eq2(p, an_soff, fn_slen, fn_soff) {
                    matched_ca = ca
                    break
                }
                ai += 1
            }
            if matched_ca == 0 and fi < acnt {
                cand := ibuf_get(cg.extra, aoff + fi)
                if ast_get(cg.nodes, cand, 2) < 0 {
                    matched_ca = cand
                }
            }

            if matched_ca > 0 {
                ar := emit_expr_ax(cg, vars, drops, breaks, ast_get(cg.nodes, matched_ca, 4))
                aslot := er_slot(ar)
                mut s := 0
                while s < f_cnt_slots {
                    mc_load_rax(c, aslot, s)
                    mc_store_rax(c, dst, f_slot_off + s)
                    s += 1
                }
            } else {
                mc_mov_rax_imm(c, 0)
                mut s := 0
                while s < f_cnt_slots {
                    mc_store_rax(c, dst, f_slot_off + s)
                    s += 1
                }
            }
            fi += 1
        }
        return er_pack(dst, ty_make(10, sidx))
    }

    // 2. User / Stdlib / `@extern` Function Call
    fidx := find_fn_idx(p, cg.sym, csoff, cslen)
    if fidx < 0 {
        zs := cg_alloc_slots(cg, 1)
        mc_mov_rax_imm(c, 0)
        mc_store_rax(c, zs, 0)
        return er_pack(zs, ty_int())
    }
    return emit_direct_fn_call(cg, vars, drops, breaks, fidx, aoff, acnt)
}

fn emit_direct_fn_call(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, fidx: i64, aoff: i64, acnt: i64) -> i64 {
    c := cg.code
    p := cg.pool
    f_off := ibuf_get(cg.sym, 7) + fidx * 10
    fn_soff := ibuf_get(cg.sym, f_off)
    fn_slen := ibuf_get(cg.sym, f_off + 1)
    fnid := ibuf_get(cg.sym, f_off + 2)
    p_base := ibuf_get(cg.sym, f_off + 3)
    p_cnt := ibuf_get(cg.sym, f_off + 4)
    raw_ret_ty := ibuf_get(cg.sym, f_off + 5)
    ret_slots := ibuf_get(cg.sym, f_off + 6)
    tot_arg_slots := ibuf_get(cg.sym, f_off + 7)
    fast_abi := ibuf_get(cg.sym, f_off + 8)
    fn_flags := ibuf_get(cg.sym, f_off + 9)

    mut ret_ty := raw_ret_ty
    if (fn_flags & fnflag_async()) != 0 {
        ret_ty = ty_make(22, raw_ret_ty)
    }

    // Evaluate each parameter (Named Args + Positional + Default Parameter Expressions + Duck Packing!)
    is_fast_int := (fast_abi == 1) and ((fn_flags & fnflag_extern()) == 0)
    ev := ibuf_new(64)
    mut pi := 0
    while pi < p_cnt {
        po := p_base + pi * 6
        pn_soff := ibuf_get(cg.sym, po)
        pn_slen := ibuf_get(cg.sym, po + 1)
        p_ty := ibuf_get(cg.sym, po + 3)
        def_nid := ibuf_get(cg.sym, po + 5)
        p_slots := type_slots(cg.sym, p_ty)

        mut matched_ca := 0
        mut ai := 0
        while ai < acnt {
            ca := ibuf_get(cg.extra, aoff + ai)
            an_soff := ast_get(cg.nodes, ca, 2)
            an_slen := ast_get(cg.nodes, ca, 3)
            if an_soff >= 0 and an_slen == pn_slen and pool_str_eq2(p, an_soff, pn_slen, pn_soff) {
                matched_ca = ca
                break
            }
            ai += 1
        }
        if matched_ca == 0 and pi < acnt {
            cand := ibuf_get(cg.extra, aoff + pi)
            if ast_get(cg.nodes, cand, 2) < 0 {
                matched_ca = cand
            }
        }

        if matched_ca > 0 {
            amode := ast_get(cg.nodes, matched_ca, 1)
            aexpr := ast_get(cg.nodes, matched_ca, 4)
            mut wb_slot := 0
            mut wb_sub := 0
            if amode == pmode_mut() {
                lv := resolve_lval_ax(cg, vars, aexpr)
                if lv != 0 {
                    wb_slot = ushr64(lv, 44)
                    wb_sub = (ushr64(lv, 32)) & 0xFFF
                }
            }
            if is_fast_int and amode != pmode_mut() and p_slots == 1 and (p_ty == ty_int() or p_ty == ty_bool()) and is_nonshadowed_const_int(cg, vars, aexpr) {
                ibuf_push(ev, -1)
                ibuf_push(ev, 1)
                ibuf_push(ev, eval_const_int_val(p, cg.nodes, cg.sym, aexpr))
                ibuf_push(ev, 0)
            } else if is_fast_int and amode != pmode_mut() and p_slots == 2 and p_ty == ty_str() and ast_kind(cg.nodes, aexpr) == nk_str() {
                slen := ast_get(cg.nodes, aexpr, 2)
                roff := cg_intern_pool_slice(cg, ast_get(cg.nodes, aexpr, 1), slen)
                ibuf_push(ev, -2)
                ibuf_push(ev, 2)
                ibuf_push(ev, roff)
                ibuf_push(ev, slen)
            } else {
                ar := emit_expr_ax(cg, vars, drops, breaks, aexpr)
                mut aslot := er_slot(ar)
                aty := er_ty(ar)

                if ty_tag(p_ty) == 11 and ty_tag(aty) == 10 {
                    s_id := ty_pay(aty) + 1
                    s_slots := type_slots(cg.sym, aty)
                    packed := cg_alloc_slots(cg, p_slots)
                    mc_mov_rax_imm(c, s_id)
                    mc_store_rax(c, packed, 0)
                    mut k := 0
                    while k < s_slots {
                        if 1 + k < p_slots {
                            mc_load_rax(c, aslot, k)
                            mc_store_rax(c, packed, 1 + k)
                        }
                        k += 1
                    }
                    aslot = packed
                }
                ibuf_push(ev, aslot)
                ibuf_push(ev, p_slots)
                ibuf_push(ev, wb_slot)
                ibuf_push(ev, wb_sub)
            }
        } else if def_nid > 0 {
            if is_fast_int and p_slots == 1 and (p_ty == ty_int() or p_ty == ty_bool()) and is_nonshadowed_const_int(cg, vars, def_nid) {
                ibuf_push(ev, -1)
                ibuf_push(ev, 1)
                ibuf_push(ev, eval_const_int_val(p, cg.nodes, cg.sym, def_nid))
                ibuf_push(ev, 0)
            } else {
                dr := emit_expr_ax(cg, vars, drops, breaks, def_nid)
                ibuf_push(ev, er_slot(dr))
                ibuf_push(ev, p_slots)
                ibuf_push(ev, 0)
                ibuf_push(ev, 0)
            }
        } else if is_fast_int and p_slots == 1 {
            ibuf_push(ev, -1)
            ibuf_push(ev, 1)
            ibuf_push(ev, 0)
            ibuf_push(ev, 0)
        } else {
            zs := cg_alloc_slots(cg, p_slots)
            mc_mov_rax_imm(c, 0)
            mut z := 0
            while z < p_slots {
                mc_store_rax(c, zs, z)
                z += 1
            }
            ibuf_push(ev, zs)
            ibuf_push(ev, p_slots)
            ibuf_push(ev, 0)
            ibuf_push(ev, 0)
        }
        pi += 1
    }

    mut ret_dst := 0
    if raw_ret_ty == ty_unit() and (fn_flags & fnflag_async()) == 0 {
        ret_dst = cg_unit_slot(cg)
    } else {
        ret_dst = cg_alloc_slots(cg, ret_slots)
    }

    // --- Direct Zero-Overhead Win64 C-ABI Call for `@extern("dll")` & Static COFF `.obj`/`.lib`! ---
    if (fn_flags & fnflag_extern()) != 0 {
        mut stack_extra := 0
        if p_cnt > 4 {
            stack_extra = align_up((p_cnt - 4) * 8, 16)
        }
        sub_sp := 32 + stack_extra
        mc_b4(c, 0x48, 0x83, 0xEC, sub_sp)

        pi = 4
        while pi < p_cnt {
            aslot := ibuf_get(ev, pi * 4)
            mc_load_rax(c, aslot, 0)
            mc_b4(c, 0x48, 0x89, 0x44, 0x24)
            mc_b1(c, 32 + (pi - 4) * 8)
            pi += 1
        }
        pi = 0
        while pi < p_cnt and pi < 4 {
            po := p_base + pi * 6
            pty := ibuf_get(cg.sym, po + 3)
            aslot := ibuf_get(ev, pi * 4)
            if pty == ty_float() {
                mc_load_rax(c, aslot, 0)
                if pi == 0 { mc_b4(c, 0x66, 0x48, 0x0F, 0x6E); mc_b1(c, 0xC0) }      // XMM0
                else if pi == 1 { mc_b4(c, 0x66, 0x48, 0x0F, 0x6E); mc_b1(c, 0xC8) } // XMM1
                else if pi == 2 { mc_b4(c, 0x66, 0x48, 0x0F, 0x6E); mc_b1(c, 0xD0) } // XMM2
                else { mc_b4(c, 0x66, 0x48, 0x0F, 0x6E); mc_b1(c, 0xD8) }            // XMM3
            } else {
                // Note: for `str`, slot 0 is already a null-terminated `const char*` pointer!
                if pi == 0 { mc_load_rcx(c, aslot, 0) }
                else if pi == 1 { mc_load_rdx(c, aslot, 0) }
                else if pi == 2 { mc_load_r8(c, aslot, 0) }
                else { mc_load_r9(c, aslot, 0) }
            }
            pi += 1
        }

        moff := ushr64(ast_get(cg.nodes, fnid, 4), 16)
        mut dll_soff := 0
        mut dll_slen := 0
        if moff > 0 {
            dll_soff = ibuf_get(cg.extra, moff)
            dll_slen = ibuf_get(cg.extra, moff + 1)
        }
        if dll_slen > 0 {
            iat_slot := cg_intern_ext_dll_fn(cg, dll_soff, dll_slen, fn_soff, fn_slen)
            cg_call_iat(cg, iat_slot)
        } else {
            // Static COFF `.obj` / `.lib` symbol resolved via `fx_fn` (`state[32 + fidx]`)
            cg_call_fn(cg, fidx)
        }
        mc_b4(c, 0x48, 0x83, 0xC4, sub_sp)

        if raw_ret_ty == ty_float() {
            mc_b4(c, 0x66, 0x48, 0x0F, 0x7E); mc_b1(c, 0xC0) // MOVQ RAX, XMM0
        } else {
            // Sign-extend 32-bit C `int`/`i32` return values cleanly
            ret_tnid := ast_get(cg.nodes, fnid, 5)
            if ret_tnid > 0 and ast_kind(cg.nodes, ret_tnid) == nk_ty_named() {
                rns := ast_get(cg.nodes, ret_tnid, 1)
                rnl := ast_get(cg.nodes, ret_tnid, 2)
                if pool_str_eq_lit(p, rns, rnl, "i32") {
                    mc_b3(c, 0x48, 0x63, 0xC0) // MOVSXD RAX, EAX
                } else if pool_str_eq_lit(p, rns, rnl, "u32") {
                    mc_b2(c, 0x89, 0xC0)       // MOV EAX, EAX
                }
            }
        }
        mc_store_rax(c, ret_dst, 0)
        buf_free(move ev)
        return er_pack(ret_dst, ret_ty)
    }

    if fast_abi == 1 {
        mut cur_off := 0
        pi = 0
        while pi < p_cnt {
            aslot := ibuf_get(ev, pi * 4)
            cnt := ibuf_get(ev, pi * 4 + 1)
            if aslot == -1 {
                mc_mov_reg_imm(c, cur_off, ibuf_get(ev, pi * 4 + 2))
                cur_off += 1
            } else if aslot == -2 {
                cg_lea_reg_rdata(cg, cur_off, ibuf_get(ev, pi * 4 + 2))
                mc_mov_reg_imm(c, cur_off + 1, ibuf_get(ev, pi * 4 + 3))
                cur_off += 2
            } else {
                mut s := 0
                while s < cnt {
                    if cur_off == 0 { mc_load_rcx(c, aslot, s) }
                    else if cur_off == 1 { mc_load_rdx(c, aslot, s) }
                    else if cur_off == 2 { mc_load_r8(c, aslot, s) }
                    else if cur_off == 3 { mc_load_r9(c, aslot, s) }
                    else if cur_off == 4 { mc_load_r10(c, aslot, s) }
                    else { mc_load_r11(c, aslot, s) }
                    cur_off += 1
                    s += 1
                }
            }
            pi += 1
        }
        cg_call_fn(cg, fidx)
        if raw_ret_ty != ty_unit() or (fn_flags & fnflag_async()) != 0 {
            mc_store_rax(c, ret_dst, 0)
            if ret_slots >= 2 {
                mc_b3(c, 0x48, 0x89, 0xD0)
                mc_store_rax(c, ret_dst, 1)
            }
        }
    } else {
        mut ab_cnt := tot_arg_slots
        if ab_cnt < 1 { ab_cnt = 1 }
        ab_base := cg_alloc_slots(cg, ab_cnt)
        ab_lowest := ab_base + ab_cnt - 1

        rb_base := cg_alloc_slots(cg, ret_slots)
        rb_lowest := rb_base + ret_slots - 1

        mc_lea_rax(c, ab_lowest, 0)
        mc_b3(c, 0x49, 0x89, 0xC0)
        mut cur_off := 0
        pi = 0
        while pi < p_cnt {
            aslot := ibuf_get(ev, pi * 4)
            cnt := ibuf_get(ev, pi * 4 + 1)
            mut s := 0
            while s < cnt {
                mc_load_rax(c, aslot, s)
                mc_r8_store_rax(c, (cur_off + s) * 8)
                s += 1
            }
            cur_off += cnt
            pi += 1
        }

        mc_lea_rax(c, ab_lowest, 0)
        mc_b3(c, 0x48, 0x89, 0xC1)
        mc_lea_rax(c, rb_lowest, 0)
        mc_b3(c, 0x48, 0x89, 0xC2)
        cg_call_fn(cg, fidx)

        if ret_slots == 1 {
            if raw_ret_ty != ty_unit() or (fn_flags & fnflag_async()) != 0 {
                mc_store_rax(c, ret_dst, 0)
            }
        } else {
            mc_lea_rax(c, rb_lowest, 0)
            mc_b3(c, 0x49, 0x89, 0xC0)
            mut s := 0
            while s < ret_slots {
                mc_r8_load_rax(c, s * 8)
                mc_store_rax(c, ret_dst, s)
                s += 1
            }
        }

        mut wb_off := 0
        pi = 0
        while pi < p_cnt {
            cnt := ibuf_get(ev, pi * 4 + 1)
            wb_s := ibuf_get(ev, pi * 4 + 2)
            wb_sub := ibuf_get(ev, pi * 4 + 3)
            if wb_s > 0 {
                mc_lea_rax(c, ab_lowest, 0)
                mc_b3(c, 0x49, 0x89, 0xC0)
                mut s := 0
                while s < cnt {
                    mc_r8_load_rax(c, (wb_off + s) * 8)
                    mc_store_rax(c, wb_s, wb_sub + s)
                    s += 1
                }
            }
            wb_off += cnt
            pi += 1
        }
    }

    buf_free(move ev)
    return er_pack(ret_dst, ret_ty)
}

fn emit_method_call_ax(cg: CodegenCtx, vars: IntBuf, drops: IntBuf, breaks: IntBuf, mc_nid: i64) -> i64 {
    recv_e := ast_get(cg.nodes, mc_nid, 1)
    msoff := ast_get(cg.nodes, mc_nid, 2)
    mslen := ast_get(cg.nodes, mc_nid, 3)
    aoff := ast_get(cg.nodes, mc_nid, 4)
    acnt := ast_get(cg.nodes, mc_nid, 5)

    rr := emit_expr_ax(cg, vars, drops, breaks, recv_e)
    rslot := er_slot(rr)
    rty := er_ty(rr)

    if pool_str_eq_lit(cg.pool, msoff, mslen, "join") {
        if ty_tag(rty) == 15 or ty_tag(rty) == 22 {
            return er_pack(rslot, ty_pay(rty))
        }
        return rr
    }

    tmp_soff := pool_intern_str(cg.pool, "__ax_mrecv")
    v_prev_len := ibuf_len(vars)
    ibuf_push(vars, tmp_soff)
    ibuf_push(vars, 10)
    ibuf_push(vars, rslot)
    ibuf_push(vars, rty)
    ibuf_push(vars, 0)

    id_nid := ast_alloc(cg.nodes, nk_ident(), 0)
    ast_set(cg.nodes, id_nid, 1, tmp_soff)
    ast_set(cg.nodes, id_nid, 2, 10)
    ca0 := ast_alloc(cg.nodes, nk_call_arg(), 0)
    ast_set(cg.nodes, ca0, 1, pmode_val())
    ast_set(cg.nodes, ca0, 2, -1)
    ast_set(cg.nodes, ca0, 3, 0)
    ast_set(cg.nodes, ca0, 4, id_nid)

    full_aoff := ibuf_len(cg.extra)
    ibuf_push(cg.extra, ca0)
    mut i := 0
    while i < acnt {
        ibuf_push(cg.extra, ibuf_get(cg.extra, aoff + i))
        i += 1
    }

    if ty_tag(rty) == 10 {
        sidx := ty_pay(rty)
        fidx := find_mangled_method_fn(cg, sidx, msoff, mslen)
        if fidx >= 0 {
            res := emit_direct_fn_call(cg, vars, drops, breaks, fidx, full_aoff, acnt + 1)
            ibuf_set(vars, v_prev_len + 1, 0)
            return res
        }
    }

    if ty_tag(rty) == 11 {
        c := cg.code
        s_cnt := ibuf_get(cg.sym, 4)
        impls := ibuf_new(32)
        mut si := 0
        while si < s_cnt {
            mf := find_mangled_method_fn(cg, si, msoff, mslen)
            if mf >= 0 {
                ibuf_push(impls, si)
                ibuf_push(impls, mf)
            }
            si += 1
        }
        icnt := ibuf_len(impls) / 2
        if icnt > 0 {
            first_fn := ibuf_get(impls, 1)
            ff_off := ibuf_get(cg.sym, 7) + first_fn * 10
            ret_ty := ibuf_get(cg.sym, ff_off + 5)
            ret_slots := ibuf_get(cg.sym, ff_off + 6)
            dst := cg_alloc_slots(cg, ret_slots)
            mc_mov_rax_imm(c, 0)
            mc_store_rax(c, dst, 0)

            end_jmps := ibuf_new(32)
            mut k := 0
            while k < icnt {
                cand_sidx := ibuf_get(impls, k * 2)
                cand_fn := ibuf_get(impls, k * 2 + 1)
                mc_load_rax(c, rslot, 0)
                mc_b2(c, 0x48, 0x3D)
                mc_u32(c, cand_sidx + 1)
                jne_next := mc_jcc32(c, 0x85)

                sty := ty_make(10, cand_sidx)
                s_slots := type_slots(cg.sym, sty)
                unpacked := cg_alloc_slots(cg, s_slots)
                mut u := 0
                while u < s_slots {
                    mc_load_rax(c, rslot, 1 + u)
                    mc_store_rax(c, unpacked, u)
                    u += 1
                }
                ibuf_set(vars, v_prev_len + 2, unpacked)
                ibuf_set(vars, v_prev_len + 3, sty)
                cr := emit_direct_fn_call(cg, vars, drops, breaks, cand_fn, full_aoff, acnt + 1)
                cslot := er_slot(cr)
                u = 0
                while u < ret_slots {
                    mc_load_rax(c, cslot, u)
                    mc_store_rax(c, dst, u)
                    u += 1
                }
                ibuf_push(end_jmps, mc_jmp32(c))
                mc_patch_rel32(c, jne_next, buf_len(c))
                k += 1
            }

            done_p := buf_len(c)
            k = 0
            while k < ibuf_len(end_jmps) {
                mc_patch_rel32(c, ibuf_get(end_jmps, k), done_p)
                k += 1
            }
            ibuf_set(vars, v_prev_len + 1, 0)
            buf_free(move end_jmps)
            buf_free(move impls)
            return er_pack(dst, ret_ty)
        }
        buf_free(move impls)
    }

    ibuf_set(vars, v_prev_len + 1, 0)
    return er_pack(rslot, ty_int())
}

fn find_mangled_method_fn(cg: CodegenCtx, sidx: i64, msoff: i64, mslen: i64) -> i64 {
    s_off := ibuf_get(cg.sym, 3) + sidx * 6
    sn_soff := ibuf_get(cg.sym, s_off)
    sn_slen := ibuf_get(cg.sym, s_off + 1)
    want_len := sn_slen + 2 + mslen

    f_base := ibuf_get(cg.sym, 7)
    f_cnt := ibuf_get(cg.sym, 8)
    mut fi := 0
    while fi < f_cnt {
        fo := f_base + fi * 10
        fn_soff := ibuf_get(cg.sym, fo)
        fn_slen := ibuf_get(cg.sym, fo + 1)
        if fn_slen == want_len {
            if buf_get(cg.pool, fn_soff + sn_slen) == 95 and buf_get(cg.pool, fn_soff + sn_slen + 1) == 95 {
                if pool_str_eq2(cg.pool, fn_soff, sn_slen, sn_soff) and pool_str_eq2(cg.pool, fn_soff + sn_slen + 2, mslen, msoff) {
                    return fi
                }
            }
        }
        fi += 1
    }
    return -1
}
