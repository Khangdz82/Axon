// Axon Compiler: Direct Mach-O 64-bit Binary Packaging (Zero External Linker)
// Strict W^X Enforcement, PIE (MH_PIE), and Apple Silicon Hardware Hardening.

struct MachOHeader {
    magic: i32,         // 0xFEEDFACF (-17958193)
    cputype: i32,       // 0x0100000C (ARM64) or 0x01000007 (x86_64)
    cpusubtype: i32,
    filetype: i32,      // 2 (MH_EXECUTE)
    ncmds: i32,
    sizeofcmds: i32,
    flags: i32,         // MH_PIE (0x200000) | MH_TWOLEVEL (0x80) | MH_DYLDLINK (0x4)
}

struct SegmentCommand64 {
    cmd: i32,           // 0x19 (LC_SEGMENT_64)
    cmdsize: i32,
    vmaddr: i64,
    vmsize: i64,
    fileoff: i64,
    filesize: i64,
    maxprot: i32,       // VM_PROT (never VM_PROT_WRITE | VM_PROT_EXECUTE)
    initprot: i32,
}

fn create_macho_header(is_arm64: i32) -> MachOHeader {
    // flags: 0x200085 (MH_PIE | MH_TWOLEVEL | MH_DYLDLINK | MH_NOUNDEFS)
    let pie_flags = 2097285;
    if is_arm64 == 1 {
        return MachOHeader(-17958193, 16777228, 0, 2, 4, 384, pie_flags);
    }
    return MachOHeader(-17958193, 16777223, 3, 2, 4, 384, pie_flags);
}

/// Creates __TEXT segment: VM_PROT_READ | VM_PROT_EXECUTE (1 | 4 = 5). Strict W^X: NO VM_PROT_WRITE
fn create_macho_text_segment(vmaddr: i64, vmsize: i64, fileoff: i64, filesize: i64) -> SegmentCommand64 {
    return SegmentCommand64(25, 72, vmaddr, vmsize, fileoff, filesize, 5, 5);
}

/// Creates __DATA segment: VM_PROT_READ | VM_PROT_WRITE (1 | 2 = 3). Strict W^X: NO VM_PROT_EXECUTE
fn create_macho_data_segment(vmaddr: i64, vmsize: i64, fileoff: i64, filesize: i64) -> SegmentCommand64 {
    return SegmentCommand64(25, 72, vmaddr, vmsize, fileoff, filesize, 3, 3);
}

/// Verifies strict W^X conformance on Mach-O segment: returns 1 if valid, 0 if violation
fn verify_macho_segment_wx(seg: SegmentCommand64) -> i32 {
    let has_w = if (seg.initprot & 2) != 0 { 1 } else { 0 };
    let has_x = if (seg.initprot & 4) != 0 { 1 } else { 0 };
    if has_w == 1 and has_x == 1 {
        return 0; // W^X Violation
    }
    return 1; // Strict W^X compliant
}
