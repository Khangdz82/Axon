// Axon Compiler: Direct Mach-O 64-bit Binary Packaging (Zero External Linker)
struct MachOHeader {
    magic: i32,         // 0xFEEDFACF
    cputype: i32,       // 0x0100000C (ARM64) or 0x01000007 (x86_64)
    cpusubtype: i32,
    filetype: i32,      // 2 (MH_EXECUTE)
    ncmds: i32,
    sizeofcmds: i32,
    flags: i32,
}

struct SegmentCommand64 {
    cmd: i32,           // 0x19 (LC_SEGMENT_64)
    cmdsize: i32,
    vmaddr: i64,
    vmsize: i64,
    fileoff: i64,
    filesize: i64,
}

fn create_macho_header(is_arm64: i32) -> MachOHeader {
    if is_arm64 == 1 {
        return MachOHeader(-17958193, 16777228, 0, 2, 2, 256, 131072);
    }
    return MachOHeader(-17958193, 16777223, 3, 2, 2, 256, 131072);
}
