// Axon Compiler: High-Performance Lexer
struct Token {
    kind: i32,
    start: i32,
    end: i32,
    val_int: i64,
}

struct Lexer {
    cursor: i32,
    len: i32,
    file_id: i32,
    token_count: i32,
}

fn lexer_new(len: i32, file_id: i32) -> Lexer {
    return Lexer(0, len, file_id, 0);
}

fn is_alpha(c: i32) -> i32 {
    if c >= 65 and c <= 90 {
        return 1;
    }
    if c >= 97 and c <= 122 {
        return 1;
    }
    if c == 95 {
        return 1;
    }
    return 0;
}

fn is_digit(c: i32) -> i32 {
    if c >= 48 and c <= 57 {
        return 1;
    }
    return 0;
}

/// Identifies zero-cost Pythonic keywords: and, or, not, is, in, with
fn is_pythonic_keyword(kw_id: i32) -> i32 {
    // 10: and, 11: or, 12: not, 13: is, 14: in, 15: with, 16: fstring
    if kw_id >= 10 and kw_id <= 16 {
        return 1;
    }
    return 0;
}

fn lex_next_token(mut lex: Lexer, current_byte: i32) -> Token {
    let start = lex.cursor;
    lex.cursor += 1;
    lex.token_count += 1;
    return Token(1, start, lex.cursor, 0);
}
