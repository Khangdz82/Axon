// Axon Compiler: Distributed Collective Communication & Tensor Sharding (`@shard`)
// Automatically partitions tensor dimensions across multi-GPU/multi-node device meshes
// and emits collective communication primitives (All-Reduce, All-Gather, Reduce-Scatter, All-to-All).

struct DeviceMesh {
    rows: i32,
    cols: i32,
    total_devices: i32,
    local_rank: i32,
}

struct ShardDescriptor {
    tensor_id: i32,
    shard_axis: i32,        // 0: Row / Data Parallelism, 1: Col / Tensor Parallelism
    mesh_dim: i32,
    local_elements: i64,
    collective_op: i32,     // 1: All-Reduce, 2: All-Gather, 3: Reduce-Scatter, 4: All-to-All
}

fn device_mesh_new(rows: i32, cols: i32, rank: i32) -> DeviceMesh {
    let total = rows * cols;
    return DeviceMesh(rows, cols, total, rank);
}

/// Computes local slice bounds for @shard(axis: 0) on a Tensor
fn shard_tensor_dimension(global_elements: i64, axis: i32, devices: i32, rank: i32) -> ShardDescriptor {
    let local_count = global_elements / (devices as i64);
    // Axis 0 requires All-Reduce on backward, Axis 1 requires All-Gather on forward
    let collective = if axis == 0 { 1 } else { 2 };
    return ShardDescriptor(1, axis, devices, local_count, collective);
}
