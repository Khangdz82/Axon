// Axon Compiler: Direct ELF64 Binary Packaging (Zero External Linker)
// Strict W^X Enforcement, PIE, Full RELRO, DWARF .eh_frame Stack Unwind, and .note.gnu.build-id.

struct Elf64Header {
    magic: i32,         // 0x464C457F ('\x7fELF')
    elf_class: i32,     // 2 (64-bit)
    endianness: i32,    // 1 (little-endian)
    os_abi: i32,        // 0 (System V)
    elf_type: i32,      // 3 (ET_DYN for Position-Independent Executable PIE / Full ASLR)
    machine: i32,       // 62 (0x3E: x86_64) or 183 (0xB7: aarch64)
    entry_point: i64,
}

struct ProgramHeader {
    p_type: i32,        // 1: PT_LOAD, 4: PT_NOTE, 0x6474E550: PT_GNU_EH_FRAME, 0x6474E552: PT_GNU_RELRO
    p_flags: i32,       // 1: PF_X, 2: PF_W, 4: PF_R (Strict W^X: never PF_W | PF_X)
    p_offset: i64,
    p_vaddr: i64,
    p_filesz: i64,
    p_memsz: i64,
    p_align: i64,
}

struct ElfBuildIdNote {
    namesz: i32,        // 4 ("GNU\0")
    descsz: i32,        // 20 (BLAKE3 / SHA-1 digest)
    note_type: i32,     // 3 (NT_GNU_BUILD_ID)
}

fn create_elf64_header(entry_addr: i64) -> Elf64Header {
    return Elf64Header(1179403647, 2, 1, 0, 3, 62, entry_addr);
}

/// Creates code segment: PF_R | PF_X (4 | 1 = 5). Strict W^X: NO PF_W
fn create_load_segment(offset: i64, vaddr: i64, size: i64) -> ProgramHeader {
    return ProgramHeader(1, 5, offset, vaddr, size, size, 4096);
}

/// Creates read-only data segment: PF_R (4)
fn create_rodata_segment(offset: i64, vaddr: i64, size: i64) -> ProgramHeader {
    return ProgramHeader(1, 4, offset, vaddr, size, size, 4096);
}

/// Creates writable data segment: PF_R | PF_W (4 | 2 = 6). Strict W^X: NO PF_X
fn create_data_segment(offset: i64, vaddr: i64, size: i64) -> ProgramHeader {
    return ProgramHeader(1, 6, offset, vaddr, size, size, 4096);
}

/// Creates Full RELRO segment (PT_GNU_RELRO = 0x6474E552): protects GOT / relocation tables
fn create_relro_segment(offset: i64, vaddr: i64, size: i64) -> ProgramHeader {
    return ProgramHeader(1685382482, 4, offset, vaddr, size, size, 4096);
}

/// Creates standard Linux .eh_frame unwind segment (PT_GNU_EH_FRAME = 0x6474E550)
fn create_eh_frame_segment(offset: i64, vaddr: i64, size: i64) -> ProgramHeader {
    return ProgramHeader(1685382480, 4, offset, vaddr, size, size, 4096);
}

/// Creates NT_GNU_BUILD_ID note segment (PT_NOTE = 4)
fn create_build_id_segment(offset: i64, vaddr: i64) -> ProgramHeader {
    return ProgramHeader(4, 4, offset, vaddr, 36, 36, 4);
}

/// Verifies strict W^X conformance on ELF program header: returns 1 if valid, 0 if violation
fn verify_elf_segment_wx(ph: ProgramHeader) -> i32 {
    let has_w = if (ph.p_flags & 2) != 0 { 1 } else { 0 };
    let has_x = if (ph.p_flags & 1) != 0 { 1 } else { 0 };
    if has_w == 1 and has_x == 1 {
        return 0; // W^X Violation
    }
    return 1; // Strict W^X compliant
}
