// Axon Compiler: Refinement Types Bounds Check Elision
struct BoundConstraint {
    var_id: i32,
    limit_var_id: i32,
    is_strict_lt: i32,
}

struct RefinementSolver {
    elided_checks: i32,
    checked_bounds: i32,
}

fn solver_new() -> RefinementSolver {
    return RefinementSolver(0, 0);
}

fn can_elide_bounds_check(c: BoundConstraint, accessed_var: i32, len_var: i32) -> i32 {
    if c.var_id == accessed_var {
        if c.limit_var_id == len_var {
            if c.is_strict_lt == 1 {
                return 1; // Statically proven 0 <= idx < len
            }
        }
    }
    return 0; // Must emit runtime bounds check
}

fn record_bounds_decision(mut s: RefinementSolver, is_elided: i32) {
    if is_elided == 1 {
        s.elided_checks += 1;
    } else {
        s.checked_bounds += 1;
    }
}
