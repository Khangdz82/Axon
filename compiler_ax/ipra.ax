// Axon Compiler: Interprocedural Register Allocation (IPRA) & Cold Error Path Splitting
// Bypasses OS ABI calling conventions for internal functions; moves unlikely error paths to .text.cold.

struct IpraFunctionLayout {
    fn_id: i32,
    is_exported: i32,
    registers_used: i32,
    hot_text_bytes: i32,
    cold_text_bytes: i32,
}

fn ipra_analyze_function(fn_id: i32, is_exported: i32, block_count: i32) -> IpraFunctionLayout {
    if is_exported == 1 {
        // Must strictly conform to OS ABI (Windows x64 / System V)
        return IpraFunctionLayout(fn_id, 1, 4, block_count * 32, 0);
    }
    
    // Internal function: utilize all available integer + vector registers
    // Split error paths to .text.cold to maximize L1i instruction cache hits
    let hot_blocks = if block_count > 2 { block_count - 1 } else { block_count };
    let cold_blocks = block_count - hot_blocks;
    
    return IpraFunctionLayout(fn_id, 0, 14, hot_blocks * 24, cold_blocks * 20);
}

fn is_cold_block(branch_probability_pct: i32) -> i32 {
    // Branch taken probability < 5% considered cold error path
    if branch_probability_pct <= 5 {
        return 1; // Emit into .text.cold section
    }
    return 0; // Emit into .text primary section
}
