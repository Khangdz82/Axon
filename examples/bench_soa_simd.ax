// Axon v6.0 Physical Head-to-Head Benchmark (`examples/bench_soa_simd.ax`)
// Workload: 1,048,576 64-byte entities (16 x f32) x 200 simulation steps
//           = 209,715,200 entity updates (838,860,800 FLOPs).
// Demonstrates Python-simple code compiling directly to Dead-Column Compacted SoA + Temporal Register-Tiled AVX2 FMA3.

struct Entity {
    px: f32
    vx: f32
    py: f32
    vy: f32
    pz: f32
    vz: f32
    mass: f32
    drag: f32
    heat: f32
    shield: f32
    armor: f32
    energy: f32
    team: f32
    state: f32
    timer: f32
    pad: f32
}

@shield
fn main() -> i32 {
    n := 1048576
    steps := 200
    entities := Table[Entity]::with_capacity(n)
    table_fill_f32(entities, 0, 1.0)
    table_fill_f32(entities, 1, 0.25)
    table_fill_f32(entities, 2, 2.0)
    table_fill_f32(entities, 3, 0.50)

    dt := 0.5
    t0 := clock_ns()
    mut s := 0
    while s < steps {
        for e in entities {
            e.px += e.vx * dt
            e.py += e.vy * dt
        }
        s += 1
    }
    elapsed_us := (clock_ns() - t0) / 1000

    last_px := table_get_f32(entities, 0, n - 1)
    last_py := table_get_f32(entities, 2, n - 1)
    println(f"[AXON v6.0 SoA+AVX2] N={n}, steps={steps} -> px={last_px}, py={last_py} in {elapsed_us} us")

    if last_px != 26.0 or last_py != 52.0 {
        return 1
    }
    return 0
}
