// Axon v6.0 Enterprise Cloud & FinTech Benchmark (`examples/bench_enterprise_suite.ax`)
// Workload: 5,000,000 per-request packet buffer allocations (4 KB each = 20 GB logical heap traffic)
//           + exact fixed-scale financial decimal (`dec`) settlement + JSON/Map verification.

use std::os
use std::collections
use std::json
use std::decimal

@shield
fn process_fintech_stream(requests: i64) -> dec {
    mut ledger_total := 0.00d
    unit_price := 19.95d
    mut i := 0
    while i < requests {
        // Idiomatic per-request buffer: Perceus Loop Self-FBIP reuses 4 KB in-place (0 syscalls, 0 GC!)
        pkt := buf_new(4096)
        qty := (i & 7) + 1
        tag := (i *% 31 +% 7) & 255
        buf_push(pkt, tag)
        buf_push(pkt, qty)

        line_amt := unit_price * qty
        if (buf_get(pkt, 0) & 1) == 0 {
            ledger_total = ledger_total + line_amt
        } else {
            ledger_total = ledger_total + (line_amt - 0.05d)
        }
        i += 1
    }
    return ledger_total
}

@shield
fn main() -> i32 {
    // Warm metadata route table + JSON config once using stdlib
    routes := map_new(64)
    map_put(routes, fnv1a_64("/v1/settle"), 200)
    cfg := "{\"service\":\"axon-fintech\",\"batch\":5000000}"
    requests := json_get_i64(cfg, "batch") or 0
    if map_get(routes, fnv1a_64("/v1/settle"), 0) != 200 or requests != 5000000 {
        return 1
    }

    t0 := clock_ns()
    settled := process_fintech_stream(requests)
    elapsed_us := (clock_ns() - t0) / 1000

    println(f"[AXON v6.0 Enterprise+FinTech] {requests} packets settled -> total=${settled} in {elapsed_us} us")
    if settled <= 0.00d {
        return 2
    }
    return 0
}
