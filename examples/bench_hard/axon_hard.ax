// Hard Multi-Language Benchmark Suite — Axon v1.0.0 Native Zero-GC
// 6 Real-World Hard Workloads: N-Body FP64, MatMul64, ARX Crypto Mix, Dijkstra Min-Heap, 0/1 Knapsack DP, HashMap 200K

fn bench_nbody() -> (f64, i64) {
    n := 256
    steps := 40
    dt := 0.01
    unsafe {
        px := mem_alloc_aligned(n * 8 + 64)
        py := mem_alloc_aligned(n * 8 + 64)
        pz := mem_alloc_aligned(n * 8 + 64)
        vx := mem_alloc_aligned(n * 8 + 64)
        vy := mem_alloc_aligned(n * 8 + 64)
        vz := mem_alloc_aligned(n * 8 + 64)
        mut i := 0
        while i < n {
            fi := i as f64
            ptr_write_f64(px, i, fi * 0.1 + 1.0)
            ptr_write_f64(py, i, fi * 0.2 - 0.5)
            ptr_write_f64(pz, i, fi * 0.05)
            ptr_write_f64(vx, i, 0.0)
            ptr_write_f64(vy, i, 0.0)
            ptr_write_f64(vz, i, 0.0)
            i += 1
        }
        t0 := clock_ns()
        mut s := 0
        while s < steps {
            mut a := 0
            while a < n {
                ax := ptr_read_f64(px, a)
                ay := ptr_read_f64(py, a)
                az := ptr_read_f64(pz, a)
                mut fx := 0.0
                mut fy := 0.0
                mut fz := 0.0
                mut b := 0
                while b < n {
                    if a != b {
                        dx := ptr_read_f64(px, b) - ax
                        dy := ptr_read_f64(py, b) - ay
                        dz := ptr_read_f64(pz, b) - az
                        d2 := dx * dx + dy * dy + dz * dz + 0.01
                        inv := 1.0 / (d2 * sqrt_f64(d2))
                        fx = fx + dx * inv
                        fy = fy + dy * inv
                        fz = fz + dz * inv
                    }
                    b += 1
                }
                ptr_write_f64(vx, a, ptr_read_f64(vx, a) + fx * dt)
                ptr_write_f64(vy, a, ptr_read_f64(vy, a) + fy * dt)
                ptr_write_f64(vz, a, ptr_read_f64(vz, a) + fz * dt)
                a += 1
            }
            mut k := 0
            while k < n {
                ptr_write_f64(px, k, ptr_read_f64(px, k) + ptr_read_f64(vx, k) * dt)
                ptr_write_f64(py, k, ptr_read_f64(py, k) + ptr_read_f64(vy, k) * dt)
                ptr_write_f64(pz, k, ptr_read_f64(pz, k) + ptr_read_f64(vz, k) * dt)
                k += 1
            }
            s += 1
        }
        elapsed := (clock_ns() - t0) as f64 / 1000000.0
        mut sum := 0.0
        i = 0
        while i < n {
            sum = sum + ptr_read_f64(px, i) + ptr_read_f64(py, i)
            i += 1
        }
        chk := (sum + 0.5) as i64
        mem_free_aligned(px); mem_free_aligned(py); mem_free_aligned(pz)
        mem_free_aligned(vx); mem_free_aligned(vy); mem_free_aligned(vz)
        return (elapsed, chk)
    }
}

fn bench_matmul64() -> (f64, i64) {
    n := 192
    nn := n * n
    unsafe {
        a := mem_alloc_aligned(nn * 8 + 64)
        b := mem_alloc_aligned(nn * 8 + 64)
        c := mem_alloc_aligned(nn * 8 + 64)
        mut idx := 0
        while idx < nn {
            ptr_write_f64(a, idx, ((idx % 17) as f64) * 0.25)
            ptr_write_f64(b, idx, ((idx % 13) as f64) * 0.5)
            ptr_write_f64(c, idx, 0.0)
            idx += 1
        }
        t0 := clock_ns()
        mut i := 0
        while i < n {
            in_off := i * n
            mut k := 0
            while k < n {
                aik := ptr_read_f64(a, in_off + k)
                kn_off := k * n
                mut j := 0
                while j < n {
                    cv := ptr_read_f64(c, in_off + j)
                    bv := ptr_read_f64(b, kn_off + j)
                    ptr_write_f64(c, in_off + j, cv + aik * bv)
                    j += 1
                }
                k += 1
            }
            i += 1
        }
        elapsed := (clock_ns() - t0) as f64 / 1000000.0
        chk := (ptr_read_f64(c, 0) + ptr_read_f64(c, nn - 1)) as i64
        mem_free_aligned(a); mem_free_aligned(b); mem_free_aligned(c)
        return (elapsed, chk)
    }
}

fn bench_arx_crypto() -> (f64, i64) {
    rounds := 2000000
    t0 := clock_ns()
    mut a := 0x61707865
    mut b := 0x3320646E
    mut c := 0x79622D32
    mut d := 0x6B206574
    mut i := 0
    while i < rounds {
        a = (a +% b) & 0xFFFFFFFF
        d = d ^ a
        d = ((d << 16) | ushr64(d, 16)) & 0xFFFFFFFF
        c = (c +% d) & 0xFFFFFFFF
        b = b ^ c
        b = ((b << 12) | ushr64(b, 20)) & 0xFFFFFFFF
        a = (a +% b) & 0xFFFFFFFF
        d = d ^ a
        d = ((d << 8) | ushr64(d, 24)) & 0xFFFFFFFF
        c = (c +% d) & 0xFFFFFFFF
        b = b ^ c
        b = ((b << 7) | ushr64(b, 25)) & 0xFFFFFFFF
        i += 1
    }
    elapsed := (clock_ns() - t0) as f64 / 1000000.0
    chk := (a ^ b ^ c ^ d) & 0xFFFFFFFF
    return (elapsed, chk)
}

fn bench_dijkstra() -> (f64, i64) {
    nv := 10000
    deg := 8
    ne := nv * deg
    inf := 1000000000000
    unsafe {
        to := mem_alloc_aligned(ne * 8 + 64)
        wt := mem_alloc_aligned(ne * 8 + 64)
        dist := mem_alloc_aligned(nv * 8 + 64)
        hp_d := mem_alloc_aligned((ne + 16) * 8 + 64)
        hp_u := mem_alloc_aligned((ne + 16) * 8 + 64)
        mut seed := 1234567
        mut u := 0
        while u < nv {
            mut e := 0
            while e < deg {
                seed = (seed *% 1103515245 +% 12345) & 0x7FFFFFFF
                dst := (u + 1 + (seed % 97)) % nv
                w := 1 + (ushr64(seed, 8) % 100)
                ptr_write_i64(to, u * deg + e, dst)
                ptr_write_i64(wt, u * deg + e, w)
                e += 1
            }
            ptr_write_i64(dist, u, inf)
            u += 1
        }
        t0 := clock_ns()
        ptr_write_i64(dist, 0, 0)
        mut hsz := 1
        ptr_write_i64(hp_d, 0, 0)
        ptr_write_i64(hp_u, 0, 0)
        while hsz > 0 {
            d := ptr_read_i64(hp_d, 0)
            cur := ptr_read_i64(hp_u, 0)
            hsz -= 1
            if hsz > 0 {
                ld := ptr_read_i64(hp_d, hsz)
                lu := ptr_read_i64(hp_u, hsz)
                mut p := 0
                while true {
                    l := p * 2 + 1
                    if l >= hsz { break }
                    mut sm := l
                    r := l + 1
                    if r < hsz and ptr_read_i64(hp_d, r) < ptr_read_i64(hp_d, l) { sm = r }
                    if ld <= ptr_read_i64(hp_d, sm) { break }
                    ptr_write_i64(hp_d, p, ptr_read_i64(hp_d, sm))
                    ptr_write_i64(hp_u, p, ptr_read_i64(hp_u, sm))
                    p = sm
                }
                ptr_write_i64(hp_d, p, ld)
                ptr_write_i64(hp_u, p, lu)
            }
            if d > ptr_read_i64(dist, cur) { continue }
            base := cur * deg
            mut e := 0
            while e < deg {
                nxt := ptr_read_i64(to, base + e)
                nd := d + ptr_read_i64(wt, base + e)
                if nd < ptr_read_i64(dist, nxt) {
                    ptr_write_i64(dist, nxt, nd)
                    mut idx := hsz
                    hsz += 1
                    while idx > 0 {
                        par := ushr64(idx - 1, 1)
                        pd := ptr_read_i64(hp_d, par)
                        if pd <= nd { break }
                        ptr_write_i64(hp_d, idx, pd)
                        ptr_write_i64(hp_u, idx, ptr_read_i64(hp_u, par))
                        idx = par
                    }
                    ptr_write_i64(hp_d, idx, nd)
                    ptr_write_i64(hp_u, idx, nxt)
                }
                e += 1
            }
        }
        elapsed := (clock_ns() - t0) as f64 / 1000000.0
        mut chk := 0
        u = 0
        while u < nv {
            chk += ptr_read_i64(dist, u)
            u += 1
        }
        mem_free_aligned(to); mem_free_aligned(wt); mem_free_aligned(dist)
        mem_free_aligned(hp_d); mem_free_aligned(hp_u)
        return (elapsed, chk)
    }
}

fn bench_knapsack() -> (f64, i64) {
    n_items := 200
    cap := 15000
    unsafe {
        dp := mem_alloc_aligned((cap + 1) * 8 + 64)
        wt := mem_alloc_aligned(n_items * 8 + 64)
        vl := mem_alloc_aligned(n_items * 8 + 64)
        mut i := 0
        while i <= cap { ptr_write_i64(dp, i, 0); i += 1 }
        mut seed := 9876543
        i = 0
        while i < n_items {
            seed = (seed *% 1103515245 +% 12345) & 0x7FFFFFFF
            ptr_write_i64(wt, i, 10 + (seed % 300))
            ptr_write_i64(vl, i, 5 + (ushr64(seed, 8) % 500))
            i += 1
        }
        t0 := clock_ns()
        i = 0
        while i < n_items {
            w := ptr_read_i64(wt, i)
            v := ptr_read_i64(vl, i)
            mut c := cap
            while c >= w {
                cand := ptr_read_i64(dp, c - w) + v
                if cand > ptr_read_i64(dp, c) {
                    ptr_write_i64(dp, c, cand)
                }
                c -= 1
            }
            i += 1
        }
        elapsed := (clock_ns() - t0) as f64 / 1000000.0
        chk := ptr_read_i64(dp, cap)
        mem_free_aligned(dp); mem_free_aligned(wt); mem_free_aligned(vl)
        return (elapsed, chk)
    }
}

fn bench_hashmap() -> (f64, i64) {
    n := 200000
    cap := 524288
    mask := cap - 1
    unsafe {
        keys := mem_alloc_aligned(cap * 8 + 64)
        vals := mem_alloc_aligned(cap * 8 + 64)
        mut i := 0
        while i < cap { ptr_write_i64(keys, i, 0); i += 1 }
        t0 := clock_ns()
        i = 1
        while i <= n {
            k := (i *% 2654435761) & 0x7FFFFFFF
            mut k1 := k
            if k1 == 0 { k1 = 1 }
            mut slot := ((k1 *% 11400714819323198485) >> 45) & mask
            while true {
                ek := ptr_read_i64(keys, slot)
                if ek == 0 or ek == k1 {
                    ptr_write_i64(keys, slot, k1)
                    ptr_write_i64(vals, slot, i * 3 + 7)
                    break
                }
                slot = (slot + 1) & mask
            }
            i += 1
        }
        mut acc := 0
        i = 1
        while i <= n {
            k := (i *% 2654435761) & 0x7FFFFFFF
            mut k1 := k
            if k1 == 0 { k1 = 1 }
            mut slot := ((k1 *% 11400714819323198485) >> 45) & mask
            while true {
                ek := ptr_read_i64(keys, slot)
                if ek == k1 {
                    acc += ptr_read_i64(vals, slot)
                    break
                }
                if ek == 0 { break }
                slot = (slot + 1) & mask
            }
            i += 1
        }
        elapsed := (clock_ns() - t0) as f64 / 1000000.0
        mem_free_aligned(keys); mem_free_aligned(vals)
        return (elapsed, acc)
    }
}

fn main() {
    (t_nb, c_nb) := bench_nbody()
    (t_mm, c_mm) := bench_matmul64()
    (t_arx, c_arx) := bench_arx_crypto()
    (t_dij, c_dij) := bench_dijkstra()
    (t_kp, c_kp) := bench_knapsack()
    (t_hm, c_hm) := bench_hashmap()
    println(f"{{\"lang\": \"Axon v1.0 (Native Zero-GC)\", \"nbody\": {t_nb}, \"matmul64\": {t_mm}, \"arx\": {t_arx}, \"dijkstra\": {t_dij}, \"knapsack\": {t_kp}, \"hashmap\": {t_hm}, \"chk\": [{c_nb}, {c_mm}, {c_arx}, {c_dij}, {c_kp}, {c_hm}]}}")
}
