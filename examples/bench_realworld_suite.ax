// Axon v8.0 Extended Real-World Benchmark Suite (`examples/bench_realworld_suite.ax`)
// Directly comparable head-to-head with Python 3.11 (`examples/bench_realworld_baseline.py`)
// Workloads:
//   R1: Lossless Fast Byte Compression (LZ4-style 1MB telemetry buffer, 20 rounds)
//   R2: Regex Pattern Matching (50,000 log records matching timestamps and status)
//   R3: Game Engine ECS Simulation (100,000 entities x 50 frames of movement & gravity)
//   R4: Software Triangle Z-Buffer Rasterization (1,000 triangles on 800x600 framebuffer)
//   R5: Polyphonic Audio DSP Synthesis (441,000 samples / 10s audio with ADSR envelope)
//   R6: Zero-Allocation JSON Scanning (50,000 microservice payloads)
//   R7: Cryptographic Hashing / Whitebox MAC (50,000 transaction tokens)

use std::compress
use std::regex
use std::game_ecs
use std::game_render
use std::audio
use std::json
use std::crypto
use std::os

fn bench_r1_compress() {
    println("================================================================================")
    println(" WORKLOAD R1: Lossless Data Compression (1MB buffer x 20 rounds)")
    println("================================================================================")
    
    // Build ~1MB repeating log payload
    mut b := buf_new(1050000)
    chunk := "2026-11-19T22:20:00.123Z [INFO] worker-42: processed transaction id=9876543 status=OK latency=45us\n"
    c_len := str_len(chunk)
    mut i := 0
    while i < 10500 {
        mut j := 0
        while j < c_len {
            buf_push(b, str_byte(chunk, j))
            j += 1
        }
        i += 1
    }
    raw_len := buf_len(b)
    mb_raw := (raw_len as f64) / 1048576.0

    // Warmup
    c_warm := compress_bytes(b)
    buf_free(move c_warm)

    reps := 20
    t0 := clock_ns()
    mut comp_len := 0
    mut r := 0
    while r < reps {
        c_out := compress_bytes(b)
        comp_len = buf_len(c_out)
        buf_free(move c_out)
        r += 1
    }
    t_comp := (clock_ns() - t0) / 1000 / reps
    comp_mb_s := (mb_raw * 1000000.0) / (if t_comp > 0 { t_comp as f64 } else { 1.0 })
    ratio := (raw_len as f64) / (comp_len as f64)
    ms_mb := (t_comp as f64) / 1000.0
    println(f" [R1.1] Axon LZ4 Streaming      : {ms_mb} ms/MB | {comp_mb_s} MB/s | ratio={ratio}x | size={comp_len} B")
    buf_free(move b)
}

fn bench_r2_regex() {
    println("================================================================================")
    println(" WORKLOAD R2: Regex Log Extraction (50,000 log records)")
    println("================================================================================")
    rx := regex_compile("^[0-9]+-[0-9]+-[0-9]+ \\[INFO\\]") or return
    sample_line := "2026-11-19 [INFO] worker: processed batch request successfully"
    reps := 50000

    // Warmup
    _ := rx_exec_at(rx.code, sample_line, 0)

    t0 := clock_ns()
    mut matches := 0
    mut i := 0
    while i < reps {
        matched_len := rx_exec_at(rx.code, sample_line, 0)
        if matched_len >= 0 {
            matches += 1
        }
        i += 1
    }
    t_reg := (clock_ns() - t0) / 1000
    t_reg_f := if t_reg > 0 { t_reg as f64 } else { 1.0 }
    qps := ((reps as f64) * 1000000.0) / t_reg_f
    us_per := t_reg_f / (reps as f64)
    ms_tot := t_reg_f / 1000.0
    println(f" [R2.1] Axon Regex NFA Match    : {ms_tot} ms total | {us_per} us/line | {qps} lines/sec | matches={matches}")
}

fn bench_r3_ecs() {
    println("================================================================================")
    println(" WORKLOAD R3: Game ECS Simulation (100,000 entities x 50 frames)")
    println("================================================================================")
    num_entities := 100000
    frames := 50
    mut world := ecs_world_new(num_entities + 100)
    m_pv := comp_position() | comp_velocity()

    mut i := 0
    while i < num_entities {
        e := ecs_spawn(world, m_pv)
        ecs_set_position(world, e, 0.0, 100.0, 0.0)
        ecs_set_velocity(world, e, 1.5, -0.5, 0.0)
        i += 1
    }

    t0 := clock_ns()
    mut f := 0
    while f < frames {
        _moved := ecs_system_movement(world, 0.016)
        _grav := ecs_system_gravity(world, 0.0, -9.81, 0.0, 0.016)
        f += 1
    }
    t_ecs := (clock_ns() - t0) / 1000
    t_ecs_f := if t_ecs > 0 { t_ecs as f64 } else { 1.0 }
    fps := ((frames as f64) * 1000000.0) / t_ecs_f
    ms_frame := (t_ecs_f / (frames as f64)) / 1000.0
    ms_tot := t_ecs_f / 1000.0
    updates_sec := (((num_entities as f64) * (frames as f64)) * 1000000.0) / t_ecs_f
    println(f" [R3.1] Axon SoA Archetype ECS  : {ms_tot} ms total | {ms_frame} ms/frame ({fps} FPS) | {updates_sec} updates/s")
    ecs_world_free(move world)
}

fn bench_r4_rasterizer() {
    println("================================================================================")
    println(" WORKLOAD R4: Software Triangle Z-Buffer Rasterization (1,000 triangles, 800x600)")
    println("================================================================================")
    width := 800
    height := 600
    mut fb := fb_new(width, height)
    fb_clear(fb, 0xFF000000, 1.0)

    reps := 1000
    tri_color := 0xFF55AAFF

    t0 := clock_ns()
    mut r := 0
    while r < reps {
        fb_draw_triangle_depth(fb, 100.0, 100.0, 0.2, 400.0, 150.0, 0.5, 250.0, 450.0, 0.8, tri_color)
        r += 1
    }
    t_rast := (clock_ns() - t0) / 1000
    t_rast_f := if t_rast > 0 { t_rast as f64 } else { 1.0 }
    tri_sec := ((reps as f64) * 1000000.0) / t_rast_f
    ms_tot := t_rast_f / 1000.0
    chk_pixel := fb_get_pixel(fb, 250, 200)
    println(f" [R4.1] Axon Z-Buffer Raster    : {ms_tot} ms ({reps} triangles) | {tri_sec} tri/sec | chk_px={chk_pixel}")
    fb_free(move fb)
}

fn bench_r5_audio() {
    println("================================================================================")
    println(" WORKLOAD R5: Polyphonic Audio DSP Synthesis (441,000 samples / 10s audio)")
    println("================================================================================")
    sample_rate := 44100
    duration_s := 10.0
    total_samples := 441000

    t0 := clock_ns()
    // 2-voice chord synthesis + ADSR
    mut wave1 := buf_new(total_samples * 2 + 100)
    mut wave2 := buf_new(total_samples * 2 + 100)
    _s1 := audio_synth_sine(wave1, 440.0, duration_s, 0.5, sample_rate)
    _s2 := audio_synth_sine(wave2, 554.37, duration_s, 0.5, sample_rate)
    audio_mix(wave1, wave2, 0.5)
    audio_apply_adsr(wave1, 0.1, 0.2, 0.7, 0.5, sample_rate)

    t_dsp := (clock_ns() - t0) / 1000
    t_dsp_f := if t_dsp > 0 { t_dsp as f64 } else { 1.0 }
    sps := ((total_samples as f64) * 1000000.0) / t_dsp_f
    ms_tot := t_dsp_f / 1000.0
    rt_factor := (duration_s * 1000000.0) / t_dsp_f
    sample_val := (buf_get(wave1, 22050 * 2) & 255) | ((buf_get(wave1, 22050 * 2 + 1) & 255) << 8)
    println(f" [R5.1] Axon Native Audio DSP  : {ms_tot} ms ({total_samples} samples) | {sps} samples/s | {rt_factor}x faster than realtime | sample={sample_val}")
    buf_free(move wave1)
    buf_free(move wave2)
}

fn bench_r6_json() {
    println("================================================================================")
    println(" WORKLOAD R6: JSON Extraction (50,000 microservice payloads)")
    println("================================================================================")
    payload := "{\"id\":\"req_87654321\",\"status\":\"success\",\"user\":{\"name\":\"Alice\",\"tier\":\"pro\"},\"amount\":125,\"items\":[101,102,103]}"
    reps := 50000

    t0 := clock_ns()
    mut total_amount := 0
    mut i := 0
    while i < reps {
        v := json_get_i64(payload, "amount") or 0
        total_amount += v
        i += 1
    }
    t_json := (clock_ns() - t0) / 1000
    t_json_f := if t_json > 0 { t_json as f64 } else { 1.0 }
    qps := ((reps as f64) * 1000000.0) / t_json_f
    us_req := t_json_f / (reps as f64)
    ms_tot := t_json_f / 1000.0
    println(f" [R6.1] Axon Zero-Alloc JSON    : {ms_tot} ms | {us_req} us/payload | {qps} req/s | sum={total_amount}")
}

fn bench_r7_crypto() {
    println("================================================================================")
    println(" WORKLOAD R7: Cryptographic Hashing (50,000 transaction tokens)")
    println("================================================================================")
    token := "tx_hash_0123456789abcdef_transfer_amount=50000_from=alice_to=bob"
    reps := 50000

    t0 := clock_ns()
    mut h_sum := 0
    mut i := 0
    while i < reps {
        h := whitebox_mac_str(token)
        h_sum = (h_sum + h) & 0xFFFFFFFF
        i += 1
    }
    t_sha := (clock_ns() - t0) / 1000
    t_sha_f := if t_sha > 0 { t_sha as f64 } else { 1.0 }
    qps := ((reps as f64) * 1000000.0) / t_sha_f
    us_hash := t_sha_f / (reps as f64)
    ms_tot := t_sha_f / 1000.0
    println(f" [R7.1] Axon Whitebox MAC Hash  : {ms_tot} ms | {us_hash} us/hash | {qps} ops/sec | chk={h_sum}")
}

fn main() -> i64 {
    println("")
    println("################################################################################")
    println(" AXON v8.0 EXTENDED REAL-WORLD BENCHMARK SUITE")
    println(" Platform: Intel Core i5-10400F @ 2.90GHz (x64) | Zero-GC Perceus")
    println("################################################################################")
    println("")
    bench_r1_compress()
    bench_r2_regex()
    bench_r3_ecs()
    bench_r4_rasterizer()
    bench_r5_audio()
    bench_r6_json()
    bench_r7_crypto()
    println("")
    println("################################################################################")
    println(" AXON EXTENDED RUN COMPLETE")
    println("################################################################################")
    println("")
    return 0
}
