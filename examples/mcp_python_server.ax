// Ready-to-run Pure Axon MCP Server for Deep Python Library Inspection (`examples/mcp_python_server.ax`)
// Usage:
//   axc run examples/mcp_python_server.ax -- --dir path/to/python_pkg
//   axc run examples/mcp_python_server.ax -- --venv requests
//   axc build examples/mcp_python_server.ax -o pylib_mcp.exe --shield

use std::str
use std::cli
use std::mcp
use std::mcp_python

fn main() -> i32 {
    mut pm := py_mcp_server_new("axon-pylib-mcp", "1.0.0")
    argc := args_count()
    mut loaded := 0
    mut explicit_source := false
    mut http_port := 0
    mut i := 1
    while i < argc {
        arg := args_get(i)
        if str_eq(arg, "--dir") and i + 1 < argc {
            explicit_source = true
            loaded += py_mcp_add_dir(mut pm, args_get(i + 1), "", 1500)
            i += 2
            continue
        }
        if str_eq(arg, "--venv") and i + 1 < argc {
            explicit_source = true
            loaded += py_mcp_add_venv_package(mut pm, args_get(i + 1), 1200)
            i += 2
            continue
        }
        if str_eq(arg, "--discover") {
            explicit_source = true
            loaded += py_mcp_discover_env(mut pm, 24, 300)
            i += 1
            continue
        }
        if str_eq(arg, "--http") and i + 1 < argc {
            p_cand := parse_i64(args_get(i + 1)) or -1
            if p_cand < 1 or p_cand > 65535 {
                py_mcp_server_free(move pm)
                return 2
            }
            http_port = p_cand
            i += 2
            continue
        }
        i += 1
    }
    if not explicit_source and loaded == 0 {
        _ := py_mcp_discover_env(mut pm, 16, 200)
    }
    rc := if http_port > 0 {
        py_mcp_serve_http(mut pm, "127.0.0.1", http_port, 0)
    } else {
        py_mcp_serve_stdio(mut pm)
    }
    py_mcp_server_free(move pm)
    return rc
}
