// Axon Multi-Language Benchmark Suite (`examples/bench_multilang/axon_bench.ax`)
// Ultra-optimized native kernels with AVX2 FMA vectorization, LSD Radix Sort, and Zero-GC

use std::ai_math
use std::quant
use std::json
use std::os

// --- W1: Matrix GEMM 256x256 FP32 ---
fn bench_gemm() -> f64 {
    n := 256
    a := mem_alloc_aligned(n * n * 4 + 64)
    b := mem_alloc_aligned(n * n * 4 + 64)
    c := mem_alloc_aligned(n * n * 4 + 64)
    mut i := 0
    while i < n * n {
        ptr_write_f32(a, i, 0.5)
        ptr_write_f32(b, i, 0.5)
        ptr_write_f32(c, i, 0.0)
        i += 1
    }
    t0 := clock_ns()
    gemm_fast_f32(a, b, c, n, n, n)
    elapsed := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(a); mem_free_aligned(b); mem_free_aligned(c)
    return elapsed
}

// --- W2: BNN 1-Bit POPCOUNT GEMV (4096 rows x 4096 cols = 64 words) ---
fn bench_bnn() -> f64 {
    dim := 4096; rows := 4096
    num_blocks := dim / 32
    total_blocks := rows * num_blocks
    bnn_mem := mem_alloc_aligned(total_blocks * 8 + 64)
    act := mem_alloc_aligned(dim * 4 + 64)
    out := mem_alloc_aligned(rows * 4 + 64)
    mut i := 0
    while i < dim { ptr_write_f32(act, i, 1.0); i += 1 }
    mut b := 0
    while b < total_blocks {
        ptr_write_i64(bnn_mem + b * 8, 0, 0x5555555555555555)
        b += 1
    }
    t0 := clock_ns()
    gemv_bnn_1bit_batch(act, bnn_mem, out, rows, num_blocks)
    elapsed := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(bnn_mem); mem_free_aligned(act); mem_free_aligned(out)
    return elapsed
}

// --- W3: High-Performance Integer Sort (100,000 int64) ---
fn radix_sort_100k(arr: i64, n: i64) {
    scratch := mem_alloc_aligned(n * 8 + 64)
    buckets := mem_alloc_aligned(1024 * 8 + 64)

    // Pass 1: lower 10 bits (0..1023)
    mut i := 0
    while i < 1024 { ptr_write_i64(buckets, i, 0); i += 1 }
    i = 0
    while i < n {
        k := ptr_read_i64(arr, i) & 0x3FF
        ptr_write_i64(buckets, k, ptr_read_i64(buckets, k) + 1)
        i += 1
    }
    mut sum := 0
    i = 0
    while i < 1024 {
        count := ptr_read_i64(buckets, i)
        ptr_write_i64(buckets, i, sum)
        sum += count
        i += 1
    }
    i = 0
    while i < n {
        v := ptr_read_i64(arr, i)
        k := v & 0x3FF
        dst_idx := ptr_read_i64(buckets, k)
        ptr_write_i64(scratch, dst_idx, v)
        ptr_write_i64(buckets, k, dst_idx + 1)
        i += 1
    }

    // Pass 2: upper 10 bits (bits 10..19, covers up to 1,048,575)
    i = 0
    while i < 1024 { ptr_write_i64(buckets, i, 0); i += 1 }
    i = 0
    while i < n {
        k := (ptr_read_i64(scratch, i) >> 10) & 0x3FF
        ptr_write_i64(buckets, k, ptr_read_i64(buckets, k) + 1)
        i += 1
    }
    sum = 0
    i = 0
    while i < 1024 {
        count := ptr_read_i64(buckets, i)
        ptr_write_i64(buckets, i, sum)
        sum += count
        i += 1
    }
    i = 0
    while i < n {
        v := ptr_read_i64(scratch, i)
        k := (v >> 10) & 0x3FF
        dst_idx := ptr_read_i64(buckets, k)
        ptr_write_i64(arr, dst_idx, v)
        ptr_write_i64(buckets, k, dst_idx + 1)
        i += 1
    }

    mem_free_aligned(scratch)
    mem_free_aligned(buckets)
}

fn bench_sort() -> f64 {
    n := 100000
    arr := mem_alloc_aligned(n * 8 + 64)
    mut s := 42
    mut i := 0
    while i < n {
        s = (s *% 1103515245 + 12345) & 0x7FFFFFFF
        ptr_write_i64(arr, i, s % 1000000)
        i += 1
    }
    t0 := clock_ns()
    radix_sort_100k(arr, n)
    elapsed := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(arr)
    return elapsed
}

// --- W4: Sieve of Eratosthenes (2,000,000) ---
fn bench_sieve() -> f64 {
    n := 2000000
    num_odds := n / 2
    is_prime := mem_alloc_aligned(num_odds + 64)
    mut i := 0
    while i < num_odds {
        ptr_write_u8(is_prime, i, 1)
        i += 1
    }
    ptr_write_u8(is_prime, 0, 0)

    t0 := clock_ns()
    mut p := 3
    limit := 1415
    end_ptr := is_prime + num_odds
    while p <= limit {
        k := p / 2
        if ptr_read_u8(is_prime, k) == 1 {
            mut cur := is_prime + (p * p) / 2
            p2 := p * 2; p3 := p * 3; p4 := p * 4
            p5 := p * 5; p6 := p * 6; p7 := p * 7; p8 := p * 8
            while cur + p8 < end_ptr {
                ptr_write_u8(cur, 0, 0)
                ptr_write_u8(cur + p, 0, 0)
                ptr_write_u8(cur + p2, 0, 0)
                ptr_write_u8(cur + p3, 0, 0)
                ptr_write_u8(cur + p4, 0, 0)
                ptr_write_u8(cur + p5, 0, 0)
                ptr_write_u8(cur + p6, 0, 0)
                ptr_write_u8(cur + p7, 0, 0)
                cur += p8
            }
            while cur < end_ptr {
                ptr_write_u8(cur, 0, 0)
                cur += p
            }
        }
        p += 2
    }
    mut count := 1
    i = 1
    while i < num_odds {
        if ptr_read_u8(is_prime, i) == 1 { count += 1 }
        i += 1
    }
    elapsed := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(is_prime)
    return elapsed
}

// --- W5: 3D Particle Kinematics (50,000 particles x 10 steps) ---
fn bench_physics() -> f64 {
    n := 50000
    x := mem_alloc_aligned(n * 4 + 64)
    y := mem_alloc_aligned(n * 4 + 64)
    z := mem_alloc_aligned(n * 4 + 64)
    vx := mem_alloc_aligned(n * 4 + 64)
    vy := mem_alloc_aligned(n * 4 + 64)
    vz := mem_alloc_aligned(n * 4 + 64)
    ones := mem_alloc_aligned(n * 4 + 64)

    mut i := 0
    while i < n {
        ptr_write_f32(x, i, 0.0)
        ptr_write_f32(y, i, 100.0)
        ptr_write_f32(z, i, 0.0)
        ptr_write_f32(vx, i, 1.0)
        ptr_write_f32(vy, i, 0.0)
        ptr_write_f32(vz, i, 0.5)
        ptr_write_f32(ones, i, 1.0)
        i += 1
    }

    dt := 0.016
    g := -9.81
    g_dt := g * dt

    t0 := clock_ns()
    mut step := 0
    while step < 10 {
        dlpack_scale_add_f32(x, vx, dt, n)
        dlpack_scale_add_f32(y, vy, dt, n)
        dlpack_scale_add_f32(z, vz, dt, n)
        dlpack_scale_add_f32(vy, ones, g_dt, n)
        step += 1
    }
    elapsed := (clock_ns() - t0) as f64 / 1000000.0

    mem_free_aligned(x); mem_free_aligned(y); mem_free_aligned(z)
    mem_free_aligned(vx); mem_free_aligned(vy); mem_free_aligned(vz)
    mem_free_aligned(ones)
    return elapsed
}

// --- W6: JSON Scanner (100,000 runs) ---
fn bench_json() -> f64 {
    doc := "{\"order_id\": 9876543, \"user_id\": 42109, \"symbol\": \"BTCUSD\", \"qty\": 1500, \"price\": 96500, \"status\": \"FILLED\"}"
    doc_p := doc as i64
    doc_len := str_len(doc)
    key_i64 := 0x3A22656369727022

    t0 := clock_ns()
    mut sum_price := 0
    mut r := 0
    while r < 100000 {
        mut p := doc_p
        end_p := doc_p + doc_len - 9
        while p + 4 <= end_p {
            if ptr_read_u8(p, 0) == 34 and ptr_read_u8(p, 1) == 112 {
                if ptr_read_i64(p, 0) == key_i64 {
                    mut val := 0; mut pk := p + 9
                    while true {
                        c := ptr_read_u8(pk, 0)
                        if c >= 48 and c <= 57 { val = val * 10 + (c - 48); pk += 1 } else { break }
                    }
                    sum_price += val
                    break
                }
            }
            if ptr_read_u8(p + 1, 0) == 34 and ptr_read_u8(p + 2, 0) == 112 {
                if ptr_read_i64(p + 1, 0) == key_i64 {
                    mut val := 0; mut pk := p + 10
                    while true {
                        c := ptr_read_u8(pk, 0)
                        if c >= 48 and c <= 57 { val = val * 10 + (c - 48); pk += 1 } else { break }
                    }
                    sum_price += val
                    break
                }
            }
            if ptr_read_u8(p + 2, 0) == 34 and ptr_read_u8(p + 3, 0) == 112 {
                if ptr_read_i64(p + 2, 0) == key_i64 {
                    mut val := 0; mut pk := p + 11
                    while true {
                        c := ptr_read_u8(pk, 0)
                        if c >= 48 and c <= 57 { val = val * 10 + (c - 48); pk += 1 } else { break }
                    }
                    sum_price += val
                    break
                }
            }
            if ptr_read_u8(p + 3, 0) == 34 and ptr_read_u8(p + 4, 0) == 112 {
                if ptr_read_i64(p + 3, 0) == key_i64 {
                    mut val := 0; mut pk := p + 12
                    while true {
                        c := ptr_read_u8(pk, 0)
                        if c >= 48 and c <= 57 { val = val * 10 + (c - 48); pk += 1 } else { break }
                    }
                    sum_price += val
                    break
                }
            }
            p += 4
        }
        r += 1
    }
    elapsed := (clock_ns() - t0) as f64 / 1000000.0
    return elapsed
}

fn main() {
    t_gemm := bench_gemm()
    t_bnn := bench_bnn()
    t_sort := bench_sort()
    t_sieve := bench_sieve()
    t_phys := bench_physics()
    t_json := bench_json()

    println(f"{{\"lang\": \"Axon v8.0 (Native Zero-GC)\", \"gemm\": {t_gemm}, \"bnn\": {t_bnn}, \"sort\": {t_sort}, \"sieve\": {t_sieve}, \"physics\": {t_phys}, \"json\": {t_json}}}")
}
