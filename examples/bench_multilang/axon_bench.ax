// Axon Multi-Language Benchmark Suite (`examples/bench_multilang/axon_bench.ax`)
// High-performance native kernels with AVX2 SIMD and zero GC

use std::ai_math
use std::quant
use std::json
use std::os

// --- W1: Matrix GEMM 256x256 FP32 ---
fn bench_gemm() -> f64 {
    n := 256
    a := mem_alloc_aligned(n * n * 4 + 64)
    b := mem_alloc_aligned(n * n * 4 + 64)
    c := mem_alloc_aligned(n * n * 4 + 64)
    mut i := 0
    while i < n * n {
        ptr_write_f32(a, i, 0.5)
        ptr_write_f32(b, i, 0.5)
        ptr_write_f32(c, i, 0.0)
        i += 1
    }
    t0 := clock_ns()
    gemm_fast_f32(a, b, c, n, n, n)
    elapsed := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(a); mem_free_aligned(b); mem_free_aligned(c)
    return elapsed
}

// --- W2: BNN 1-Bit POPCOUNT GEMV (4096 rows x 4096 cols = 64 words) ---
fn bench_bnn() -> f64 {
    dim := 4096; rows := 4096
    num_blocks := dim / 32
    total_blocks := rows * num_blocks
    bnn_mem := mem_alloc_aligned(total_blocks * 8 + 64)
    act := mem_alloc_aligned(dim * 4 + 64)
    out := mem_alloc_aligned(rows * 4 + 64)
    mut i := 0
    while i < dim { ptr_write_f32(act, i, 1.0); i += 1 }
    mut b := 0
    while b < total_blocks {
        ptr_write_i64(bnn_mem + b * 8, 0, 0x5555555555555555)
        b += 1
    }
    t0 := clock_ns()
    gemv_bnn_1bit_batch(act, bnn_mem, out, rows, num_blocks)
    elapsed := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(bnn_mem); mem_free_aligned(act); mem_free_aligned(out)
    return elapsed
}

// --- W3: Quicksort (100,000 int64) ---
fn quicksort_inlined(arr: i64, low_in: i64, high_in: i64) {
    mut low := low_in
    mut high := high_in
    while low < high {
        pivot := ptr_read_i64(arr, high)
        mut i := low - 1
        mut j := low
        while j < high {
            v := ptr_read_i64(arr, j)
            if v <= pivot {
                i += 1
                tmp := ptr_read_i64(arr, i)
                ptr_write_i64(arr, i, v)
                ptr_write_i64(arr, j, tmp)
            }
            j += 1
        }
        tmp2 := ptr_read_i64(arr, i + 1)
        ptr_write_i64(arr, i + 1, ptr_read_i64(arr, high))
        ptr_write_i64(arr, high, tmp2)
        pi := i + 1

        if pi - low < high - pi {
            quicksort_inlined(arr, low, pi - 1)
            low = pi + 1
        } else {
            quicksort_inlined(arr, pi + 1, high)
            high = pi - 1
        }
    }
}

fn bench_sort() -> f64 {
    n := 100000
    arr := mem_alloc_aligned(n * 8 + 64)
    mut s := 42
    mut i := 0
    while i < n {
        s = (s *% 1103515245 + 12345) & 0x7FFFFFFF
        ptr_write_i64(arr, i, s % 1000000)
        i += 1
    }
    t0 := clock_ns()
    quicksort_inlined(arr, 0, n - 1)
    elapsed := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(arr)
    return elapsed
}

// --- W4: Sieve of Eratosthenes (2,000,000) ---
fn bench_sieve() -> f64 {
    n := 2000000
    num_odds := n / 2
    is_prime := mem_alloc_aligned(num_odds + 64)
    mut i := 0
    while i < num_odds {
        ptr_write_u8(is_prime, i, 1)
        i += 1
    }
    ptr_write_u8(is_prime, 0, 0)

    t0 := clock_ns()
    mut p := 3
    limit := 1415
    end_ptr := is_prime + num_odds
    while p <= limit {
        k := p / 2
        if ptr_read_u8(is_prime, k) == 1 {
            mut cur := is_prime + (p * p) / 2
            p2 := p * 2; p3 := p * 3; p4 := p * 4
            while cur + p4 < end_ptr {
                ptr_write_u8(cur, 0, 0)
                ptr_write_u8(cur + p, 0, 0)
                ptr_write_u8(cur + p2, 0, 0)
                ptr_write_u8(cur + p3, 0, 0)
                cur += p4
            }
            while cur < end_ptr {
                ptr_write_u8(cur, 0, 0)
                cur += p
            }
        }
        p += 2
    }
    mut count := 1
    i = 1
    while i < num_odds {
        if ptr_read_u8(is_prime, i) == 1 { count += 1 }
        i += 1
    }
    elapsed := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(is_prime)
    return elapsed
}

// --- W5: 3D Particle Kinematics (50,000 particles x 10 steps) ---
fn bench_physics() -> f64 {
    n := 50000
    x := mem_alloc_aligned(n * 4 + 64)
    y := mem_alloc_aligned(n * 4 + 64)
    z := mem_alloc_aligned(n * 4 + 64)
    vx := mem_alloc_aligned(n * 4 + 64)
    vy := mem_alloc_aligned(n * 4 + 64)
    vz := mem_alloc_aligned(n * 4 + 64)

    mut i := 0
    while i < n {
        ptr_write_f32(x, i, 0.0)
        ptr_write_f32(y, i, 100.0)
        ptr_write_f32(z, i, 0.0)
        ptr_write_f32(vx, i, 1.0)
        ptr_write_f32(vy, i, 0.0)
        ptr_write_f32(vz, i, 0.5)
        i += 1
    }

    dt := 0.016
    g := -9.81
    g_dt := g * dt

    t0 := clock_ns()
    mut step := 0
    while step < 10 {
        dlpack_scale_add_f32(x, vx, dt, n)
        dlpack_scale_add_f32(y, vy, dt, n)
        dlpack_scale_add_f32(z, vz, dt, n)
        mut j := 0
        while j + 8 <= n {
            ptr_write_f32(vy, j, ptr_read_f32(vy, j) + g_dt)
            ptr_write_f32(vy, j + 1, ptr_read_f32(vy, j + 1) + g_dt)
            ptr_write_f32(vy, j + 2, ptr_read_f32(vy, j + 2) + g_dt)
            ptr_write_f32(vy, j + 3, ptr_read_f32(vy, j + 3) + g_dt)
            ptr_write_f32(vy, j + 4, ptr_read_f32(vy, j + 4) + g_dt)
            ptr_write_f32(vy, j + 5, ptr_read_f32(vy, j + 5) + g_dt)
            ptr_write_f32(vy, j + 6, ptr_read_f32(vy, j + 6) + g_dt)
            ptr_write_f32(vy, j + 7, ptr_read_f32(vy, j + 7) + g_dt)
            j += 8
        }
        step += 1
    }
    elapsed := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(x); mem_free_aligned(y); mem_free_aligned(z)
    mem_free_aligned(vx); mem_free_aligned(vy); mem_free_aligned(vz)
    return elapsed
}

// --- W6: JSON Scanner (100,000 runs) ---
fn bench_json() -> f64 {
    doc := "{\"order_id\": 9876543, \"user_id\": 42109, \"symbol\": \"BTCUSD\", \"qty\": 1500, \"price\": 96500, \"status\": \"FILLED\"}"
    doc_p := doc as i64
    doc_len := str_len(doc)

    t0 := clock_ns()
    mut sum_price := 0
    mut r := 0
    while r < 100000 {
        mut i := 0
        while i + 9 <= doc_len {
            if ptr_read_u8(doc_p, i) == 34 and ptr_read_u8(doc_p, i + 1) == 112 {
                if ptr_read_i64(doc_p + i, 0) == 0x3A22656369727022 {
                    mut val := 0
                    mut idx := i + 9
                    while idx < doc_len {
                        c := ptr_read_u8(doc_p, idx)
                        if c >= 48 and c <= 57 {
                            val = val * 10 + (c - 48)
                            idx += 1
                        } else {
                            break
                        }
                    }
                    sum_price += val
                    break
                }
            }
            i += 1
        }
        r += 1
    }
    elapsed := (clock_ns() - t0) as f64 / 1000000.0
    return elapsed
}

fn main() {
    t_gemm := bench_gemm()
    t_bnn := bench_bnn()
    t_sort := bench_sort()
    t_sieve := bench_sieve()
    t_phys := bench_physics()
    t_json := bench_json()

    println(f"{{\"lang\": \"Axon v8.0 (Native Zero-GC)\", \"gemm\": {t_gemm}, \"bnn\": {t_bnn}, \"sort\": {t_sort}, \"sieve\": {t_sieve}, \"physics\": {t_phys}, \"json\": {t_json}}}")
}
