// Axon Multi-Language Benchmark Suite (`examples/bench_multilang/axon_bench.ax`)

use std::ai_math
use std::quant
use std::json
use std::os

// --- W1: Matrix GEMM 256x256 FP32 ---
fn bench_gemm() -> f64 {
    n := 256
    a := mem_alloc_aligned(n * n * 4 + 64)
    b := mem_alloc_aligned(n * n * 4 + 64)
    c := mem_alloc_aligned(n * n * 4 + 64)
    mut i := 0
    while i < n * n {
        ptr_write_f32(a, i, 0.5)
        ptr_write_f32(b, i, 0.5)
        ptr_write_f32(c, i, 0.0)
        i += 1
    }
    t0 := clock_ns()
    gemm_fast_f32(a, b, c, n, n, n)
    elapsed := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(a); mem_free_aligned(b); mem_free_aligned(c)
    return elapsed
}

// --- W2: BNN 1-Bit POPCOUNT GEMV (4096 rows x 4096 cols = 64 words) ---
fn bench_bnn() -> f64 {
    dim := 4096; rows := 4096
    num_blocks := dim / 32
    total_blocks := rows * num_blocks
    bnn_mem := mem_alloc_aligned(total_blocks * 8 + 64)
    act := mem_alloc_aligned(dim * 4 + 64)
    out := mem_alloc_aligned(rows * 4 + 64)
    mut i := 0
    while i < dim { ptr_write_f32(act, i, 1.0); i += 1 }
    mut b := 0
    while b < total_blocks {
        ptr_write_i64(bnn_mem + b * 8, 0, 0x5555555555555555)
        b += 1
    }
    t0 := clock_ns()
    gemv_bnn_1bit_batch(act, bnn_mem, out, rows, num_blocks)
    elapsed := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(bnn_mem); mem_free_aligned(act); mem_free_aligned(out)
    return elapsed
}

// --- W3: Quicksort (100,000 int64) ---
fn partition_ints(arr: i64, low: i64, high: i64) -> i64 {
    pivot := ptr_read_i64(arr, high)
    mut i := low - 1
    mut j := low
    while j < high {
        if ptr_read_i64(arr, j) <= pivot {
            i += 1
            tmp := ptr_read_i64(arr, i)
            ptr_write_i64(arr, i, ptr_read_i64(arr, j))
            ptr_write_i64(arr, j, tmp)
        }
        j += 1
    }
    tmp2 := ptr_read_i64(arr, i + 1)
    ptr_write_i64(arr, i + 1, ptr_read_i64(arr, high))
    ptr_write_i64(arr, high, tmp2)
    return i + 1
}

fn quicksort_ints(arr: i64, low: i64, high: i64) {
    if low < high {
        pi := partition_ints(arr, low, high)
        quicksort_ints(arr, low, pi - 1)
        quicksort_ints(arr, pi + 1, high)
    }
}

fn bench_sort() -> f64 {
    n := 100000
    arr := mem_alloc_aligned(n * 8 + 64)
    mut s := 42
    mut i := 0
    while i < n {
        s = (s *% 1103515245 + 12345) & 0x7FFFFFFF
        ptr_write_i64(arr, i, s % 1000000)
        i += 1
    }
    t0 := clock_ns()
    quicksort_ints(arr, 0, n - 1)
    elapsed := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(arr)
    return elapsed
}

// --- W4: Sieve of Eratosthenes (2,000,000) ---
fn bench_sieve() -> f64 {
    n := 2000000
    is_prime := mem_alloc_aligned(n + 64)
    mut i := 0
    while i <= n {
        ptr_write_u8(is_prime, i, 1)
        i += 1
    }
    ptr_write_u8(is_prime, 0, 0)
    ptr_write_u8(is_prime, 1, 0)

    t0 := clock_ns()
    mut p := 2
    while p * p <= n {
        if ptr_read_u8(is_prime, p) == 1 {
            mut m := p * p
            p2 := p * 2; p3 := p * 3; p4 := p * 4
            while m + p3 <= n {
                ptr_write_u8(is_prime, m, 0)
                ptr_write_u8(is_prime, m + p, 0)
                ptr_write_u8(is_prime, m + p2, 0)
                ptr_write_u8(is_prime, m + p3, 0)
                m += p4
            }
            while m <= n {
                ptr_write_u8(is_prime, m, 0)
                m += p
            }
        }
        p += 1
    }
    mut count := 0
    i = 2
    while i <= n {
        if ptr_read_u8(is_prime, i) == 1 {
            count += 1
        }
        i += 1
    }
    elapsed := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(is_prime)
    return elapsed
}

// --- W5: 3D Particle Kinematics (50,000 particles x 10 steps) ---
fn bench_physics() -> f64 {
    n := 50000
    p := mem_alloc_aligned(n * 24 + 64)
    mut i := 0
    while i < n {
        base := i * 6
        ptr_write_f32(p, base, 0.0); ptr_write_f32(p, base + 1, 100.0); ptr_write_f32(p, base + 2, 0.0)
        ptr_write_f32(p, base + 3, 1.0); ptr_write_f32(p, base + 4, 0.0); ptr_write_f32(p, base + 5, 0.5)
        i += 1
    }
    dt := 0.016
    g := -9.81
    g_dt := g * dt

    t0 := clock_ns()
    mut step := 0
    while step < 10 {
        mut cur_p := p
        end_p := p + n * 24
        while cur_p < end_p {
            x := ptr_read_f32(cur_p, 0); y := ptr_read_f32(cur_p, 1); z := ptr_read_f32(cur_p, 2)
            vx := ptr_read_f32(cur_p, 3); vy := ptr_read_f32(cur_p, 4); vz := ptr_read_f32(cur_p, 5)
            ptr_write_f32(cur_p, 0, x + vx * dt)
            ptr_write_f32(cur_p, 1, y + vy * dt)
            ptr_write_f32(cur_p, 2, z + vz * dt)
            ptr_write_f32(cur_p, 4, vy + g_dt)
            cur_p += 24
        }
        step += 1
    }
    elapsed := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(p)
    return elapsed
}

// --- W6: JSON Scanner (100,000 runs) ---
fn bench_json() -> f64 {
    doc := "{\"order_id\": 9876543, \"user_id\": 42109, \"symbol\": \"BTCUSD\", \"qty\": 1500, \"price\": 96500, \"status\": \"FILLED\"}"
    doc_p := doc as i64
    doc_len := str_len(doc)
    key := "\"price\": "
    key_p := key as i64
    key_len := str_len(key)

    t0 := clock_ns()
    mut sum_price := 0
    mut r := 0
    while r < 100000 {
        mut i := 0
        while i <= doc_len - key_len {
            if ptr_read_u8(doc_p, i) == 34 and ptr_read_u8(doc_p, i + 1) == 112 {
                mut match := true
                mut k := 0
                while k < key_len {
                    if ptr_read_u8(doc_p, i + k) != ptr_read_u8(key_p, k) {
                        match = false
                        break
                    }
                    k += 1
                }
                if match {
                    mut val := 0
                    mut idx := i + key_len
                    while idx < doc_len {
                        c := ptr_read_u8(doc_p, idx)
                        if c >= 48 and c <= 57 {
                            val = val * 10 + (c - 48)
                            idx += 1
                        } else {
                            break
                        }
                    }
                    sum_price += val
                    break
                }
            }
            i += 1
        }
        r += 1
    }
    elapsed := (clock_ns() - t0) as f64 / 1000000.0
    return elapsed
}

fn main() {
    t_gemm := bench_gemm()
    t_bnn := bench_bnn()
    t_sort := bench_sort()
    t_sieve := bench_sieve()
    t_phys := bench_physics()
    t_json := bench_json()

    println(f"{{\"lang\": \"Axon v8.0 (Native Zero-GC)\", \"gemm\": {t_gemm}, \"bnn\": {t_bnn}, \"sort\": {t_sort}, \"sieve\": {t_sieve}, \"physics\": {t_phys}, \"json\": {t_json}}}")
}
