struct Particle {
    pos_x: f32,
    pos_y: f32,
    vel_x: f32,
    vel_y: f32,
    mass:  f32,
}

fn integrate_physics(mut particles: Table[Particle], dt: f32) {
    for p in particles {
        p.pos_x += p.vel_x * dt;
        p.pos_y += p.vel_y * dt;
    }
}

fn main() {
    let particles = Aether_Table_Particle_create(1000);
    integrate_physics(mut particles, 0.016);
    Aether_Table_Particle_free(mut particles);
}
