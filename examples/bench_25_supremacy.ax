// --- C10: 3D Rigid Body Kinematics ---
fn c10_rigid_body_3d() -> f64 {
    n := 20000
    p := mem_alloc_aligned(n * 64 + 64)
    mut i := 0
    while i < n {
        base := i * 16
        ptr_write_f32(p, base, 0.0); ptr_write_f32(p, base + 1, 10.0); ptr_write_f32(p, base + 2, 0.0)
        ptr_write_f32(p, base + 3, 1.0); ptr_write_f32(p, base + 4, 0.0); ptr_write_f32(p, base + 5, 0.0)
        ptr_write_f32(p, base + 6, 1.0); ptr_write_f32(p, base + 7, 0.0); ptr_write_f32(p, base + 8, 0.0); ptr_write_f32(p, base + 9, 0.0)
        ptr_write_f32(p, base + 10, 0.1); ptr_write_f32(p, base + 11, 0.2); ptr_write_f32(p, base + 12, 0.05)
        i += 1
    }
    dt := 0.016
    h_dt := 0.008
    t0 := clock_ns()
    i = 0
    while i < n {
        base := i * 16
        ptr_write_f32(p, base, ptr_read_f32(p, base) + ptr_read_f32(p, base + 3) * dt)
        ptr_write_f32(p, base + 1, ptr_read_f32(p, base + 1) + ptr_read_f32(p, base + 4) * dt)
        ptr_write_f32(p, base + 2, ptr_read_f32(p, base + 2) + ptr_read_f32(p, base + 5) * dt)
        qw := ptr_read_f32(p, base + 6); qx := ptr_read_f32(p, base + 7)
        qy := ptr_read_f32(p, base + 8); qz := ptr_read_f32(p, base + 9)
        wx := ptr_read_f32(p, base + 10); wy := ptr_read_f32(p, base + 11); wz := ptr_read_f32(p, base + 12)
        d_qw := h_dt * (0.0 - wx * qx - wy * qy - wz * qz)
        d_qx := h_dt * (wx * qw + wy * qz - wz * qy)
        d_qy := h_dt * (0.0 - wx * qz + wy * qw + wz * qx)
        d_qz := h_dt * (wx * qy - wy * qx + wz * qw)
        nw := qw + d_qw; nx := qx + d_qx; ny := qy + d_qy; nz := qz + d_qz
        inv_n := 1.0 / sqrt_f64(nw*nw + nx*nx + ny*ny + nz*nz)
        ptr_write_f32(p, base + 6, nw * inv_n); ptr_write_f32(p, base + 7, nx * inv_n)
        ptr_write_f32(p, base + 8, ny * inv_n); ptr_write_f32(p, base + 9, nz * inv_n)
        i += 1
    }
    t := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(p)
    return t
}

// --- C11: Audio DSP Synthesis ---
fn c11_audio_dsp() -> f64 {
    sample_rate := 44100; total_samples := 441000
    mut w1 := buf_new(total_samples * 2 + 100)
    mut w2 := buf_new(total_samples * 2 + 100)
    t0 := clock_ns()
    _s1 := audio_synth_sine(w1, 440.0, 10.0, 0.5, sample_rate)
    _s2 := audio_synth_sine(w2, 554.37, 10.0, 0.5, sample_rate)
    audio_mix(w1, w2, 0.5)
    audio_apply_adsr(w1, 0.1, 0.2, 0.7, 0.5, sample_rate)
    t := (clock_ns() - t0) as f64 / 1000000.0
    buf_free(move w1); buf_free(move w2)
    return t
}

