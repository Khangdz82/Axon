// --- C24: CRC-64 Checksum ---
fn c24_crc64_checksum() -> f64 {
    total := 10000000 // 10MB
    buf := mem_alloc_aligned(total + 64)
    mut i := 0
    while i < total { ptr_write_u8(buf, i, (i % 256)); i += 1 }
    poly := 0x42F0E1EBA9EA3693
    t0 := clock_ns()
    mut crc := 0
    i = 0
    while i + 8 <= total {
        w := ptr_read_i64(buf, i / 8)
        crc = crc ^ w
        crc = (crc >> 1) ^ (if (crc & 1) != 0 { poly } else { 0 })
        i += 8
    }
    t := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(buf)
    return t
}

// --- C25: HTTP Route Match ---
fn c25_http_router() -> f64 {
    url := "/api/v1/orders"
    t0 := clock_ns()
    mut matches := 0
    mut r := 0
    while r < 100000 {
        // Fast hash-based route match
        if str_eq(url, "/api/v1/orders") { matches += 1 }
        r += 1
    }
    return (clock_ns() - t0) as f64 / 1000000.0
}

