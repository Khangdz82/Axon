// --- C01: FlashAttention-2 ---
fn c01_flash_attn() -> f64 {
    seq_len := 512; head_dim := 64
    total := seq_len * head_dim * 4 + 64
    q := mem_alloc_aligned(total); k := mem_alloc_aligned(total)
    v := mem_alloc_aligned(total); out := mem_alloc_aligned(total)
    mut i := 0
    while i < seq_len * head_dim {
        ptr_write_f32(q, i, 0.1); ptr_write_f32(k, i, 0.1)
        ptr_write_f32(v, i, 1.0); ptr_write_f32(out, i, 0.0)
        i += 1
    }
    t0 := clock_ns()
    flash_attention_2_tiled(q, k, v, out, seq_len, head_dim)
    t := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(q); mem_free_aligned(k); mem_free_aligned(v); mem_free_aligned(out)
    return t
}

// --- C02: BitNet b1.58 Ternary GEMV ---
fn c02_bitnet_ternary() -> f64 {
    dim := 4096; rows := 4096
    num_blocks := dim / 32
    total_blocks := rows * num_blocks
    bitnet_mem := mem_alloc_aligned(total_blocks * 12 + 64)
    act := mem_alloc_aligned(dim * 4 + 64)
    out := mem_alloc_aligned(rows * 4 + 64)
    mut i := 0
    while i < dim { ptr_write_f32(act, i, 1.0); i += 1 }
    mut b := 0
    while b < total_blocks {
        b_addr := bitnet_mem + b * 12
        ptr_write_f32(b_addr, 0, 0.5) // scale
        ptr_write_i64(b_addr + 4, 0, 0x5555555555555555) // ternary bits
        b += 1
    }
    t0 := clock_ns()
    gemv_bitnet_158_batch(act, bitnet_mem, out, rows, num_blocks)
    t := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(bitnet_mem); mem_free_aligned(act); mem_free_aligned(out)
    return t
}

// --- C03: BNN 1-Bit POPCOUNT GEMV ---
fn c03_bnn_1bit() -> f64 {
    dim := 4096; rows := 4096
    num_blocks := dim / 32
    total_blocks := rows * num_blocks
    bnn_mem := mem_alloc_aligned(total_blocks * 8 + 64)
    act := mem_alloc_aligned(dim * 4 + 64)
    out := mem_alloc_aligned(rows * 4 + 64)
    mut i := 0
    while i < dim { ptr_write_f32(act, i, 1.0); i += 1 }
    mut b := 0
    while b < total_blocks {
        ptr_write_i64(bnn_mem + b * 8, 0, 0x5555555555555555)
        b += 1
    }
    t0 := clock_ns()
    gemv_bnn_1bit_batch(act, bnn_mem, out, rows, num_blocks)
    t := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(bnn_mem); mem_free_aligned(act); mem_free_aligned(out)
    return t
}

// --- C04: RMSNorm + RoPE Activation ---
fn c04_rmsnorm_rope() -> f64 {
    dim := 4096
    x := mem_alloc_aligned(dim * 4 + 64)
    w_norm := mem_alloc_aligned(dim * 4 + 64)
    mut i := 0
    while i < dim { ptr_write_f32(x, i, 0.5); ptr_write_f32(w_norm, i, 1.0); i += 1 }
    t0 := clock_ns()
    mut step := 0
    while step < 50 {
        mut sum_sq := 0.0
        i = 0
        while i < dim { v := ptr_read_f32(x, i); sum_sq += v * v; i += 1 }
        rsqrt := 1.0 / sqrt_f64(sum_sq / (dim as f64) + 0.00001)
        i = 0
        while i < dim {
            ptr_write_f32(x, i, ptr_read_f32(x, i) * rsqrt * ptr_read_f32(w_norm, i))
            i += 1
        }
        i = 0
        while i < dim {
            theta := 1.0 / pow_f64(10000.0, (i as f64) / (dim as f64))
            cos_t := cos_f64(theta); sin_t := sin_f64(theta)
            x0 := ptr_read_f32(x, i); x1 := ptr_read_f32(x, i + 1)
            ptr_write_f32(x, i, x0 * cos_t - x1 * sin_t)
            ptr_write_f32(x, i + 1, x0 * sin_t + x1 * cos_t)
            i += 2
        }
        step += 1
    }
    t := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(x); mem_free_aligned(w_norm)
    return t
}

// --- C05: BPE Tokenizer Encoding ---
fn c05_bpe_tokenizer() -> f64 {
    sample := "the quick brown fox jumps over the lazy dog and neural engine tokenization"
    s_len := str_len(sample)
    t0 := clock_ns()
    mut reps := 0
    while reps < 5000 {
        mut i := 0
        mut merges := 0
        while i + 1 < s_len {
            c0 := str_byte(sample, i)
            c1 := str_byte(sample, i + 1)
            if (c0 == 116 and c1 == 104) or (c0 == 105 and c1 == 110) or (c0 == 101 and c1 == 114) {
                merges += 1
                i += 2
            } else {
                i += 1
            }
        }
        reps += 1
    }
    return (clock_ns() - t0) as f64 / 1000000.0
}

// --- C06: FAISS Flat-L2 Vector Search ---
fn c06_vector_search() -> f64 {
    num_vecs := 10000; dim := 64
    db := mem_alloc_aligned(num_vecs * dim * 4 + 64)
    query := mem_alloc_aligned(dim * 4 + 64)
    mut i := 0
    while i < dim { ptr_write_f32(query, i, 0.5); i += 1 }
    mut v := 0
    while v < num_vecs {
        val := ((v % 10) as f64) * 0.1
        i = 0
        while i < dim { ptr_write_f32(db, v * dim + i, val); i += 1 }
        v += 1
    }
    t0 := clock_ns()
    mut q_iter := 0
    while q_iter < 10 {
        mut best_d := 1000000000.0
        mut best_v := -1
        v = 0
        while v < num_vecs {
            base := v * dim
            mut d := 0.0
            i = 0
            while i < dim {
                diff := ptr_read_f32(db, base + i) - ptr_read_f32(query, i)
                d += diff * diff
                i += 1
            }
            if d < best_d { best_d = d; best_v = v }
            v += 1
        }
        q_iter += 1
    }
    t := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(db); mem_free_aligned(query)
    return t
}

// --- C07: Game ECS Simulation ---
fn c07_ecs_movement() -> f64 {
    n := 100000; frames := 50
    mut world := ecs_world_new(n + 100)
    m_pv := comp_position() | comp_velocity()
    mut i := 0
    while i < n {
        e := ecs_spawn(world, m_pv)
        ecs_set_position(world, e, 0.0, 100.0, 0.0)
        ecs_set_velocity(world, e, 1.5, -0.5, 0.0)
        i += 1
    }
    t0 := clock_ns()
    mut f := 0
    while f < frames {
        _moved := ecs_system_movement(world, 0.016)
        _grav := ecs_system_gravity(world, 0.0, -9.81, 0.0, 0.016)
        f += 1
    }
    t := (clock_ns() - t0) as f64 / 1000000.0
    ecs_world_free(move world)
    return t
}

// --- C08: 2D SAT Polygon Collision ---
fn c08_sat_collision() -> f64 {
    v_a := mem_alloc_aligned(64); v_b := mem_alloc_aligned(64)
    ptr_write_f32(v_a, 0, 0.0); ptr_write_f32(v_a, 1, 0.0)
    ptr_write_f32(v_a, 2, 10.0); ptr_write_f32(v_a, 3, 0.0)
    ptr_write_f32(v_a, 4, 10.0); ptr_write_f32(v_a, 5, 10.0)
    ptr_write_f32(v_a, 6, 0.0); ptr_write_f32(v_a, 7, 10.0)
    ptr_write_f32(v_b, 0, 5.0); ptr_write_f32(v_b, 1, 5.0)
    ptr_write_f32(v_b, 2, 15.0); ptr_write_f32(v_b, 3, 5.0)
    ptr_write_f32(v_b, 4, 15.0); ptr_write_f32(v_b, 5, 15.0)
    ptr_write_f32(v_b, 6, 5.0); ptr_write_f32(v_b, 7, 15.0)
    t0 := clock_ns()
    mut r := 0
    while r < 10000 {
        _hit := phys2d_sat_polygon_vs_polygon(v_a, 4, v_b, 4)
        r += 1
    }
    t := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(v_a); mem_free_aligned(v_b)
    return t
}

