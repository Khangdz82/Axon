// --- C14: LZ4 Block Compression ---
fn c14_lz4_compress() -> f64 {
    mut b := buf_new(1050000)
    chunk := "2026-11-19T22:20:00.123Z [INFO] worker-42: processed transaction id=9876543 status=OK latency=45us\n"
    c_len := str_len(chunk)
    mut i := 0
    while i < 10500 {
        mut j := 0
        while j < c_len { buf_push(b, str_byte(chunk, j)); j += 1 }
        i += 1
    }
    t0 := clock_ns()
    mut r := 0
    while r < 20 {
        c := compress_bytes(b)
        buf_free(move c)
        r += 1
    }
    t := ((clock_ns() - t0) / 20) as f64 / 1000000.0
    buf_free(move b)
    return t
}

// --- C15: LZ4 Block Decompression ---
fn c15_lz4_decompress() -> f64 {
    mut b := buf_new(1050000)
    chunk := "2026-11-19T22:20:00.123Z [INFO] worker-42: processed transaction id=9876543 status=OK latency=45us\n"
    c_len := str_len(chunk)
    mut i := 0
    while i < 10500 {
        mut j := 0
        while j < c_len { buf_push(b, str_byte(chunk, j)); j += 1 }
        i += 1
    }
    comp := compress_bytes(b)
    buf_free(move b)
    t0 := clock_ns()
    mut r := 0
    while r < 20 {
        d := decompress_bytes(comp) or return -1.0
        buf_free(move d)
        r += 1
    }
    t := ((clock_ns() - t0) / 20) as f64 / 1000000.0
    buf_free(move comp)
    return t
}

// --- C16: Regex DFA Match ---
fn c16_regex_dfa() -> f64 {
    rx := regex_compile("^[0-9]+-[0-9]+-[0-9]+ \\[INFO\\]") or return -1.0
    line := "2026-11-19 [INFO] worker: processed batch request successfully"
    t0 := clock_ns()
    mut matches := 0
    mut r := 0
    while r < 100000 {
        if rx_exec_at(rx.code, line, 0) >= 0 { matches += 1 }
        r += 1
    }
    return (clock_ns() - t0) as f64 / 1000000.0
}

// --- C17: CSV Column Parsing & Sum ---
fn c17_csv_parse() -> f64 {
    row := "1001,Alice,Electronics,1250,95.50,PAID,true\n"
    r_len := str_len(row)
    mut b := buf_new(r_len * 50000 + 64)
    mut r := 0
    while r < 50000 {
        mut j := 0
        while j < r_len { buf_push(b, str_byte(row, j)); j += 1 }
        r += 1
    }
    b_len := buf_len(b)
    b_ptr := b as i64 + 16
    t0 := clock_ns()
    mut tot := 0.0
    mut pos := 0
    while pos < b_len {
        // Fast skip 3 commas
        mut comma_cnt := 0
        while pos < b_len and comma_cnt < 3 {
            if ptr_read_u8(b_ptr + pos, 0) == 44 { comma_cnt += 1 }
            pos += 1
        }
        // Read qty integer
        mut qty := 0
        while pos < b_len and ptr_read_u8(b_ptr + pos, 0) != 44 {
            ch := ptr_read_u8(b_ptr + pos, 0)
            if ch >= 48 and ch <= 57 { qty = qty * 10 + (ch - 48) }
            pos += 1
        }
        pos += 1 // skip comma
        // Read price
        mut price := 0
        while pos < b_len and ptr_read_u8(b_ptr + pos, 0) != 44 {
            ch := ptr_read_u8(b_ptr + pos, 0)
            if ch >= 48 and ch <= 57 { price = price * 10 + (ch - 48) }
            pos += 1
        }
        tot += (qty as f64) * ((price as f64) * 0.01)
        // Skip to next line
        while pos < b_len and ptr_read_u8(b_ptr + pos, 0) != 10 { pos += 1 }
        pos += 1
    }
    t := (clock_ns() - t0) as f64 / 1000000.0
    buf_free(move b)
    return t
}

// --- C18: FinTech HFT Settlement ---
fn c18_fintech_hft() -> f64 {
    t0 := clock_ns()
    mut tot := 0
    mut i := 0
    while i < 5000000 {
        shares := (i % 100) + 1
        price := 10000 + (i % 500)
        val := shares * price
        fee := (val * 5) / 10000
        tot += val - fee
        i += 1
    }
    return (clock_ns() - t0) as f64 / 1000000.0
}

// --- C19: Lock-Free SPSC RingBuffer ---
fn c19_spsc_ringbuf() -> f64 {
    ring := spsc_new(1024)
    t0 := clock_ns()
    mut i := 0
    while i < 5000000 {
        _p := spsc_try_push(ring, i)
        _g := spsc_try_pop(ring) or 0
        i += 1
    }
    t := (clock_ns() - t0) as f64 / 1000000.0
    spsc_free(move ring)
    return t
}

// --- C20: SIMD Vector FMA ---
fn c20_simd_vector_fma() -> f64 {
    n := 500000
    a := mem_alloc_aligned(n * 4 + 64); b := mem_alloc_aligned(n * 4 + 64)
    mut i := 0
    while i < n { ptr_write_f32(a, i, 1.0); ptr_write_f32(b, i, 0.5); i += 1 }
    t0 := clock_ns()
    mut step := 0
    while step < 20 {
        dlpack_scale_add_f32(a, b, 0.016, n)
        step += 1
    }
    t := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(a); mem_free_aligned(b)
    return t
}

// --- C21: Matrix GEMM ---
fn c21_matrix_gemm() -> f64 {
    n := 256
    a := mem_alloc_aligned(n * n * 4 + 64)
    b := mem_alloc_aligned(n * n * 4 + 64)
    c := mem_alloc_aligned(n * n * 4 + 64)
    mut i := 0
    while i < n * n { ptr_write_f32(a, i, 0.5); ptr_write_f32(b, i, 0.5); ptr_write_f32(c, i, 0.0); i += 1 }
    t0 := clock_ns()
    mut r := 0
    while r < n {
        a_row := a + r * n * 4
        c_row := c + r * n * 4
        mut k := 0
        while k < n {
            aik := ptr_read_f32(a_row, k)
            b_row := b + k * n * 4
            dlpack_scale_add_f32(c_row, b_row, aik, n)
            k += 1
        }
        r += 1
    }
    t := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(a); mem_free_aligned(b); mem_free_aligned(c)
    return t
}

// --- C22: Integer QuickSort ---
fn partition_ints(arr: i64, low: i64, high: i64) -> i64 {
    pivot := ptr_read_i64(arr, high)
    mut i := low - 1
    mut j := low
    while j < high {
        if ptr_read_i64(arr, j) <= pivot {
            i += 1
            tmp := ptr_read_i64(arr, i)
            ptr_write_i64(arr, i, ptr_read_i64(arr, j))
            ptr_write_i64(arr, j, tmp)
        }
        j += 1
    }
    tmp2 := ptr_read_i64(arr, i + 1)
    ptr_write_i64(arr, i + 1, ptr_read_i64(arr, high))
    ptr_write_i64(arr, high, tmp2)
    return i + 1
}

fn quicksort_ints(arr: i64, low: i64, high: i64) {
    if low < high {
        pi := partition_ints(arr, low, high)
        quicksort_ints(arr, low, pi - 1)
        quicksort_ints(arr, pi + 1, high)
    }
}

fn c22_integer_sort() -> f64 {
    n := 100000
    arr := mem_alloc_aligned(n * 8 + 64)
    mut s := 42
    mut i := 0
    while i < n {
        s = (s *% 1103515245 + 12345) & 0x7FFFFFFF
        ptr_write_i64(arr, i, s % 1000000)
        i += 1
    }
    t0 := clock_ns()
    quicksort_ints(arr, 0, n - 1)
    t := (clock_ns() - t0) as f64 / 1000000.0
    mem_free_aligned(arr)
    return t
}

