struct Particle {
    pos_x: f32,
    pos_y: f32,
    vel_x: f32,
    vel_y: f32,
    mass:  f32,
}

fn integrate_physics(mut particles: Table[Particle], dt: f32) {
    for p in particles {
        p.pos_x += p.vel_x * dt;
        p.pos_y += p.vel_y * dt;
    }
}

fn simulate_world(isolated world_data: Table[Particle]) -> Table[Particle] {
    let worker = spawn {
        integrate_physics(mut world_data, 0.016);
        return move world_data;
    };

    return worker.join();
}
