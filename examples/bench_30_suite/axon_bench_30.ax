// Axon v1.0.0 — 30 Real-World Production Benchmarks (`examples/bench_30_suite/axon_bench_30.ax`)
// Tier 1 (B01..B10): Easy       — Core Ergonomics, Fast Start, Basic Desktop UI & Memory Pools
// Tier 2 (B11..B20): Medium     — Reactive Desktop UI/UX, Virtual Lists, Caching, AI Kernels & ECS
// Tier 3 (B21..B30): Hard/Extr. — Full Desktop Workspace, Paged-KV Flash-Attn, DDA Raycast, A*, 0-Leak Soak

use std::os
use std::str
use std::ui
use std::ui_render
use std::ui_layout
