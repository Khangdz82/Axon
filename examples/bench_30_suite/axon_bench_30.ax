// B11: HTML5 DOM Parse + CSS Selector Match + Flexbox Layout Solver (300 complex desktop trees)
fn bench_11_ui_dom_flexbox() -> (f64, i64) {
    html_doc := ui_component_navbar("Axon Desktop Studio", "v1.0.0") +
                "<div class=\"flex flex-row gap-4 p-4\">" +
                ui_component_stat_box("FPS", "240") +
                ui_component_stat_box("Frame Time", "0.18 ms") +
                ui_component_stat_box("Heap Churn", "0 B") +
                "</div>" +
                ui_component_card("c1", "Compiler Engine", "Sub-ms native x86_64/ARM64 build", "Build Now", "count += 1") +
                ui_component_card("c2", "AI PagedKV", "Zero-fragmentation LLM serving", "Launch", "count += 1")
    sheet := css_parse_stylesheet(".card { padding: 16px; } .btn { background: #2563eb; }")
    t0 := stopwatch_ns()
    mut chk := 0
    mut i := 0
    while i < 300 {
        tree := html_parse(html_doc) or dom_tree_new(html_doc)
        lt := layout_compute(tree, sheet, 1280, 720)
        chk += layout_get_w(lt, 1) + layout_get_h(lt, 2) + tree.count
        buf_free(move lt.boxes)
        i += 1
    }
    return (elapsed_ms(t0), chk)
}

// B12: Zero-Virtual-DOM Reactive Signal Updates & Surgical Dirty-Rect Patching (10,000 updates)
fn bench_12_ui_reactive_signals() -> (f64, i64) {
    html_code := "<div class=\"p-4 bg-slate-900\">" +
                 "<h1 id=\"counter\" class=\"text-white\">Tokens: {{tokens}} tok/s</h1>" +
                 "<p id=\"status\" class=\"text-blue-400\">Ready</p>" +
                 "</div>"
    mut app := ui_window_html("Reactive Signal Bench", 640, 240, html_code)
    _ := ui_signal(mut app, "tokens", 0)
    _ := ui_bind_signal(mut app, "tokens", "counter", 1, "Tokens: ", " tok/s")
    _ := ui_render(mut app)
    t0 := stopwatch_ns()
    mut chk := 0
    mut i := 1
    while i <= 2000 {
        if ui_signal_update_and_patch(mut app, "tokens", i) {
            chk += 1
        }
        i += 1
    }
    chk += ui_signal_get(app, "tokens")
    ms := elapsed_ms(t0)
    canvas_free(move app.canvas)
    signal_graph_free(move app.signals)
    return (ms, chk)
}

// B13: Virtualized 100,000-Row Desktop Data Table Smooth 120Hz Scroll & Hit-Test (500 scroll frames)
fn bench_13_ui_virtual_list_100k() -> (f64, i64) {
    total_rows := 100000
    row_h := 28
    viewport_h := 560
    mut app := ui_app_new("100k Virtual Table", 640, viewport_h)
    t0 := stopwatch_ns()
    mut chk := 0
    mut frame := 0
    while frame < 500 {
        scroll_top := (frame * 197) % ((total_rows - 25) * row_h)
        first := ui_virtual_list_first(scroll_top, row_h)
        vis := ui_virtual_list_visible(total_rows, scroll_top, row_h, viewport_h)
        chk += first + vis
        if (frame & 31) == 0 {
            vhtml := ui_virtual_list_html("row", total_rows, scroll_top, row_h, viewport_h)
            _ := ui_set_html(mut app, vhtml)
            hit := ui_hit_test(app, 120, 80)
            chk += hit
        }
        frame += 1
    }
    ms := elapsed_ms(t0)
    canvas_free(move app.canvas)
    signal_graph_free(move app.signals)
    return (ms, chk)
}

// B14: 120Hz Physical Spring + Cubic Easing Animation Solver for 1,000 UI Widgets (200 frames = 200,000 steps)
fn bench_14_ui_spring_120hz() -> (f64, i64) {
    t0 := stopwatch_ns()
    dt := 1.0 / 120.0
    mut total_chk := 0
    mut w := 0
    while w < 1000 {
        mut pos := 0.0
        mut vel := 0.0
        target := 100.0 + (w as f64) * 0.5
        mut f := 0
        while f < 200 {
            (np, nv) := ui_spring_step(pos, target, vel, 180.0, 22.0, dt)
            pos = np
            vel = nv
            f += 1
        }
        eased := ui_ease_out_cubic(0.75)
        col := ui_lerp_color(0xFF0F172A, 0xFF3B82F6, 192)
        total_chk += (pos as i64) + ((eased * 100.0) as i64) + (col & 255)
        w += 1
    }
    return (elapsed_ms(t0), total_chk)
}

// B15: O(1) LRU Cache under Skewed/Hot-Key Workload (100,000 operations)
fn bench_15_cache_lru() -> (f64, i64) {
    cache := lru_new(2048)
    t0 := stopwatch_ns()
    mut chk := 0
    mut i := 1
    while i <= 100000 {
        // 80% hot keys (0..511), 20% cold keys (0..16383)
        key := if (i & 3) != 0 { i & 511 } else { (i * 17) & 16383 }
        v := lru_get(cache, key, -1)
        if v < 0 {
            lru_put(cache, key, key * 3 + 7)
        } else {
            chk += (v & 255)
        }
        i += 1
    }
    chk += lru_hits(cache)
    ms := elapsed_ms(t0)
    lru_free(move cache)
    return (ms, chk)
}

// B16: 64-Bit Multi-Hash Bloom Filter Membership Screening (200,000 operations)
fn bench_16_cache_bloom() -> (f64, i64) {
    bf := bloom_new(262144)
    t0 := stopwatch_ns()
    mut i := 1
    while i <= 20000 {
        bloom_add(bf, i * 13 + 7)
        i += 1
    }
    mut hits := 0
    mut q := 1
    while q <= 180000 {
        if bloom_may_contain(bf, q * 13 + 7) {
            hits += 1
        }
        q += 1
    }
    ms := elapsed_ms(t0)
    bloom_free(move bf)
    return (ms, hits)
}

// B17: LLM RMSNorm + Rotary Position Embedding (RoPE) on 4096-dim Hidden State (1,000 tokens)
fn bench_17_ai_rmsnorm_rope() -> (f64, i64) {
    unsafe {
    dim := 4096
    x := mem_alloc_aligned(dim * 4 + 64)
    w := mem_alloc_aligned(dim * 4 + 64)
    out := mem_alloc_aligned(dim * 4 + 64)
    mut i := 0
    while i < dim {
        ptr_write_f32(x, i, ((i % 31) as f64) * 0.05 - 0.75)
        ptr_write_f32(w, i, 1.0 + ((i % 7) as f64) * 0.01)
        i += 1
    }
    t0 := stopwatch_ns()
    mut step := 0
    while step < 1000 {
        ai_rmsnorm_f32(out, x, w, dim, 0.00001)
        ai_rope_inplace_f32(out, 128, step)
        step += 1
    }
    ms := elapsed_ms(t0)
    chk := ((g2_abs(ptr_read_f32(out, 0)) + g2_abs(ptr_read_f32(out, 127))) * 10000.0) as i64 + 4096
    mem_free_aligned(x); mem_free_aligned(w); mem_free_aligned(out)
    return (ms, chk)
    }
}

// B18: LLM SwiGLU FFN Gate + Numerically Stable Softmax + Top-1 Argmax Sampler (1,000 tokens × 1024 vocab)
fn bench_18_ai_swiglu_softmax() -> (f64, i64) {
    unsafe {
    dim := 1024
    gate := mem_alloc_aligned(dim * 4 + 64)
    up := mem_alloc_aligned(dim * 4 + 64)
    out := mem_alloc_aligned(dim * 4 + 64)
    mut i := 0
    while i < dim {
        ptr_write_f32(gate, i, ((i % 41) as f64) * 0.1 - 2.0)
        ptr_write_f32(up, i, ((i % 19) as f64) * 0.1 + 0.5)
        i += 1
    }
    t0 := stopwatch_ns()
    mut chk := 0
    mut step := 0
    while step < 1000 {
        ai_swiglu_f32(out, gate, up, dim)
        ai_softmax_inplace_f32(out, dim)
        best := ai_argmax_f32(out, dim)
        chk += best + 1
        step += 1
    }
    ms := elapsed_ms(t0)
    mem_free_aligned(gate); mem_free_aligned(up); mem_free_aligned(out)
    return (ms, chk)
    }
}

// B19: Archetype ECS Spawn, Component Setup & 3D Velocity Integration (10,000 entities × 20 steps)
fn bench_19_game_ecs_archetype() -> (f64, i64) {
    world := ecs_world_new(16384)
    t0 := stopwatch_ns()
    mask := comp_position() | comp_velocity()
    mut i := 0
    while i < 10000 {
        eid := ecs_spawn(world, mask)
        ecs_set_position(world, eid, (i as f64) * 0.1, 10.0, 0.0)
        ecs_set_velocity(world, eid, 1.5, -0.5, 0.25)
        i += 1
    }
    mut step := 0
    while step < 20 {
        _ := ecs_system_movement(world, 0.016)
        step += 1
    }
    chk := ecs_count_matching(world, mask, 0) + ((ecs_get_pos_x(world, 100) * 100.0) as i64)
    ms := elapsed_ms(t0)
    ecs_world_free(move world)
    return (ms, chk)
}

// B20: 2D Spatial-Hash Broadphase & Circle Collision Detection (1,000 bodies × 25 frames)
fn bench_20_game_spatial_hash() -> (f64, i64) {
    unsafe {
    n := 1000
    grid := g2_spatial_new(16.0, 2048, n)
    px := mem_alloc_aligned(n * 8 + 64)
    py := mem_alloc_aligned(n * 8 + 64)
    mut i := 0
    while i < n {
        ptr_write_f64(px, i, ((i * 37) % 900) as f64)
        ptr_write_f64(py, i, ((i * 53) % 900) as f64)
        i += 1
    }
    t0 := stopwatch_ns()
    mut total_Broadphase := 0
    mut frame := 0
    while frame < 25 {
        g2_spatial_clear(grid)
        i = 0
        while i < n {
            x := ptr_read_f64(px, i) + 1.25
            y := ptr_read_f64(py, i) + 0.75
            ptr_write_f64(px, i, x)
            ptr_write_f64(py, i, y)
            g2_spatial_insert(grid, i, x, y)
            i += 1
        }
        mut q := 0
        while q < 200 {
            qx := ptr_read_f64(px, q * 5)
            qy := ptr_read_f64(py, q * 5)
            total_Broadphase += g2_spatial_query_cell_3x3(grid, qx, qy, 64)
            q += 1
        }
        frame += 1
    }
    ms := elapsed_ms(t0)
    g2_spatial_free(move grid)
    mem_free_aligned(px); mem_free_aligned(py)
    return (ms, total_Broadphase + n)
    }
}

