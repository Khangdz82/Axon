// ============================================================================
// TIER 1: EASY (B01 .. B10)
// ============================================================================

// B01: Prelude integer parsing, FNV-1a string hashing & clamp/math helpers (50,000 ops)
fn bench_01_prelude() -> (f64, i64) {
    t0 := stopwatch_ns()
    mut chk := 0
    mut i := 0
    while i < 50000 {
        v := parse_int_or("  -482719  ", 0)
        h := fnv1a_hash_str("axon_desktop_ui_v1")
        c := clamp_i64(v + i, -100000, 100000)
        chk = (chk +% c +% (h & 0xFFFF)) & 0x7FFFFFFFFFFFFFFF
        i += 1
    }
    s_b := format_bytes(10485760)
    s_d := format_duration_us(4500)
    chk += str_len(s_b) + str_len(s_d)
    return (elapsed_ms(t0), chk)
}

// B02: Civil Calendar & ISO-8601 timestamp roundtrips (50,000 dates)
fn bench_02_datetime() -> (f64, i64) {
    t0 := stopwatch_ns()
    base_dt := dt_parse_iso8601("2026-11-21T18:45:30Z")
    mut chk := base_dt.year + base_dt.month * 100 + base_dt.day
    mut i := 0
    while i < 50000 {
        dt := dt_from_unix(1700000000 + i * 3661)
        ts := dt_to_unix(dt.year, dt.month, dt.day, dt.hour, dt.minute, dt.second)
        dow := dt_day_of_week(ts)
        chk += (dt.year + dt.month + dt.day + dow)
        i += 1
    }
    iso := dt_format_iso8601(base_dt)
    chk += str_len(iso)
    return (elapsed_ms(t0), chk)
}

// B03: TOML + `.env` production config parsing & typed lookup (1,000 parses)
fn bench_03_toml_config() -> (f64, i64) {
    cfg := "# Production Desktop & AI Config\n" +
           "export APP_ENV = \"production\"\n" +
           "[window]\n" +
           "title = \"Axon Studio Pro\"\n" +
           "width = 1920\n" +
           "height = 1080\n" +
           "vsync = true\n" +
           "[ai]\n" +
           "context_len = 32_768\n" +
           "batch_size = 64\n"
    t0 := stopwatch_ns()
    mut chk := 0
    mut i := 0
    while i < 1000 {
        doc := toml_parse(cfg)
        w := toml_get_i64(doc, "window", "width", 0)
        h := toml_get_i64(doc, "window", "height", 0)
        ctx := toml_get_i64(doc, "ai", "context_len", 0)
        vs := if toml_get_bool(doc, "window", "vsync", false) { 1 } else { 0 }
        chk += w + h + ctx + vs
        toml_free(move doc)
        i += 1
    }
    return (elapsed_ms(t0), chk)
}

// B04: RFC-4180 CSV tabular parsing & numeric column aggregation (2,500 rows)
fn bench_04_csv_analytics() -> (f64, i64) {
    row_s := "101,\"Axon Desktop Pro\",240,12,9950\n102,\"Zero-GC Engine\",360,8,14200\n103,\"Native UI Kit\",480,4,18900\n104,\"AI PagedKV\",512,16,22100\n105,\"ECS Physics\",600,6,31000\n"
    mut big_csv := "id,name,fps,latency_us,score\n"
    mut k := 0
    while k < 50 {
        big_csv = big_csv + row_s
        k += 1
    }
    t0 := stopwatch_ns()
    mut chk := 0
    mut iter := 0
    while iter < 10 {
        tbl := csv_parse(big_csv)
        chk += csv_sum_col_i64(tbl, 2, 1) + csv_sum_col_i64(tbl, 4, 1)
        csv_free(move tbl)
        iter += 1
    }
    return (elapsed_ms(t0), chk)
}

// B05: Desktop UI Opaque Rectangle & Span Rasterization (5,000 rects on 800x600 canvas)
fn bench_05_ui_canvas_rect() -> (f64, i64) {
    canv := canvas_new(800, 600)
    t0 := stopwatch_ns()
    canvas_clear(canv, 0xFF0F172A)
    mut i := 0
    while i < 5000 {
        rx := (i * 37) % 700
        ry := (i * 23) % 500
        col := 0xFF000000 | ((i * 97) & 0x00FFFFFF)
        canvas_draw_rect(canv, rx, ry, 96, 48, col)
        i += 1
    }
    ms := elapsed_ms(t0)
    chk := (buf_get(canv.pixels, 120000) & 255) + (buf_get(canv.pixels, 480000) & 255) + 5000
    canvas_free(move canv)
    return (ms, chk)
}

// B06: 3-Zone Chord-Accelerated Anti-Aliased Rounded Cards & Borders (2,000 cards)
fn bench_06_ui_rounded_cards() -> (f64, i64) {
    canv := canvas_new(800, 600)
    t0 := stopwatch_ns()
    mut i := 0
    while i < 2000 {
        rx := (i * 41) % 560
        ry := (i * 29) % 420
        canvas_draw_rounded_rect(canv, rx, ry, 220, 140, 12, 0xFF1E293B)
        canvas_draw_border(canv, rx, ry, 220, 140, 2, 0xFF3B82F6)
        i += 1
    }
    ms := elapsed_ms(t0)
    chk := (buf_get(canv.pixels, 200000) & 255) + 2000
    canvas_free(move canv)
    return (ms, chk)
}

// B07: Crisp 5x7 Bitmap Font Text Rasterization for Code Editor / HUD (2,500 lines = 60,000 chars)
fn bench_07_ui_text_glyphs() -> (f64, i64) {
    canv := canvas_new(800, 600)
    t0 := stopwatch_ns()
    mut i := 0
    while i < 2500 {
        tx := 12 + (i % 4) * 180
        ty := 12 + ((i / 4) % 50) * 10
        canvas_draw_text(canv, tx, ty, "AXON UI 240FPS 0.1MS OK!", 0xFFE2E8F0, 1)
        i += 1
    }
    ms := elapsed_ms(t0)
    chk := (buf_get(canv.pixels, (14 * 800 + 14) * 4) & 255) + 60000
    canvas_free(move canv)
    return (ms, chk)
}

// B08: Per-Frame Bump Arena (`FrameArena`) 500,000 allocations + O(1) resets (0 leaks)
fn bench_08_mem_frame_arena() -> (f64, i64) {
    arena := frame_arena_new(1048576)
    t0 := stopwatch_ns()
    mut chk := 0
    mut frame := 0
    while frame < 500 {
        frame_arena_reset(arena)
        mut j := 0
        while j < 1000 {
            p := frame_arena_alloc(arena, 256)
            if p != 0 { chk += 1 }
            j += 1
        }
        frame += 1
    }
    ms := elapsed_ms(t0)
    frame_arena_free(move arena)
    return (ms, chk)
}

// B09: Fixed-Slab `ObjectPool` 200,000 acquire/release ops + Double-Release Protection
fn bench_09_mem_object_pool() -> (f64, i64) {
    pool := obj_pool_new(64, 1024)
    t0 := stopwatch_ns()
    mut chk := 0
    mut cycle := 0
    while cycle < 400 {
        mut k := 0
        while k < 250 {
            id := obj_pool_acquire(pool)
            if id >= 0 { chk += id + 1 }
            k += 1
        }
        k = 0
        while k < 250 {
            if obj_pool_release(pool, k) { chk += 1 }
            k += 1
        }
        cycle += 1
    }
    // Verify double-release protection blocks invalid release
    blocked := if not obj_pool_release(pool, 0) { 1 } else { 0 }
    chk += blocked + obj_pool_active_count(pool)
    ms := elapsed_ms(t0)
    obj_pool_free(move pool)
    return (ms, chk)
}

// B10: 2D Game Vector Transforms, Lerp, Reflection & Fast Minimax Trig (200,000 ops)
fn bench_10_game_vec2_math() -> (f64, i64) {
    t0 := stopwatch_ns()
    mut p := v2(10.0, 20.0)
    mut v := v2(1.5, -0.75)
    n := v2(0.0, 1.0)
    mut i := 0
    while i < 200000 {
        v = v2_rot(v, 0.001)
        p = v2_add(p, v2_scale(v, 0.016))
        if p.y < 0.0 {
            v = v2_reflect(v, n)
            p = v2_lerp(p, v2(10.0, 20.0), 0.1)
        }
        i += 1
    }
    chk := ((g2_abs(p.x) + g2_abs(p.y)) * 1000.0) as i64 + 200000
    return (elapsed_ms(t0), chk)
}

