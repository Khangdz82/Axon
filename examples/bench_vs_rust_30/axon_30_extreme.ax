// Axon v1.2.0 — 30-Benchmark "Light to Impossible" Extreme Suite vs Rust (`-O3`)
// 100% Pure Axon, Zero External Dependencies, Exact Deterministic Checksum Verification.
// Tiers:
//   Tier 1 (Light,     B01..B08): branchless_clamp, fib38, sieve1m, popcnt10m, dot_f64_8m, splitmix25m, parse_i64_500k, fnv1a_8m
//   Tier 2 (Medium,    B09..B16): sort500k_i64, hashmap500k, mem_find_4m, json100k, base64_2m, csv100k, spsc_ring_10m, dijkstra_20k
//   Tier 3 (Hard,      B17..B23): crc32_8m, sha256_4m, chacha20_4m, nbody_3d_256, knapsack_dp_20m, mandelbrot_1k, fft_65536
//   Tier 4 (Impossible,B24..B30): fp32_gemm_512, fp64_gemm_512, bnn_gemv_4096, q4_0_gemv_4096, q8_0_gemv_4096, faiss_l2_10k_128d, llm_ffn_4096

use std::str
use std::algo
use std::ds
use std::crypto
use std::encoding
use std::ringbuf
use std::graph
use std::linalg
use std::numeric
use std::quant
use std::json

// --- Tier 1: Light (B01..B08) ---

fn _b01_worker(tid: i64, nthreads: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4)
        out_acc := ptr_read_i64(pool, 5)
        i0 := (tid * n) / nthreads
        i1 := ((tid + 1) * n) / nthreads
        mut acc := 0
        mut i := i0
        while i < i1 {
            mut v := (i *% 37 +% 13) & 1023
            if v < 100 { v = 100 }
            if v > 900 { v = 900 }
            acc = acc +% v
            i += 1
        }
        ptr_write_i64(out_acc, tid, acc)
    }
}

fn b01_branchless_clamp_10m() -> i64 {
    unsafe {
        args := mem_alloc_aligned(64); out := mem_alloc_aligned(256)
        mem_set(out, 0, 256)
        ptr_write_i64(args, 0, 10000000); ptr_write_i64(args, 1, out)
        _ := ai_pool_dispatch(fn_addr(_b01_worker), args)
        mut tot := 0; mut t := 0
        while t < 16 { tot = tot +% ptr_read_i64(out, t); t += 1 }
        mem_free_aligned(args); mem_free_aligned(out)
        return tot
    }
}

fn fib_rec(n: i64) -> i64 {
    if n <= 1 { return n }
    return fib_rec(n - 1) + fib_rec(n - 2)
}

fn b02_fib_rec_38() -> i64 {
    return fib_rec(38)
}

fn b03_sieve_1m() -> i64 {
    n := 1000000
    unsafe {
        p := mem_alloc_aligned(n + 64)
        if p == 0 { return 0 }
        mem_set(p, 1, n + 1)
        ptr_write_u8(p, 0, 0)
        ptr_write_u8(p, 1, 0)
        mut i := 2
        while i * i <= n {
            if ptr_read_u8(p, i) != 0 {
                mut j := i * i
                while j <= n {
                    ptr_write_u8(p, j, 0)
                    j += i
                }
            }
            i += 1
        }
        mut cnt := 0
        mut k := 2
        while k <= n {
            cnt += ptr_read_u8(p, k)
            k += 1
        }
        mem_free_aligned(p)
        return cnt
    }
}

fn _b04_worker(tid: i64, nthreads: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4)
        out_acc := ptr_read_i64(pool, 5)
        i0 := (tid * n) / nthreads
        i1 := ((tid + 1) * n) / nthreads
        k := 0x9E3779B97F4A7C15
        m := 0xA5A5A5A5A5A5A5A5
        mut a0 := 0; mut a1 := 0; mut a2 := 0; mut a3 := 0
        mut i := i0
        while i + 4 <= i1 {
            a0 = a0 +% popcnt64((i *% k) ^ m)
            a1 = a1 +% popcnt64(((i +% 1) *% k) ^ m)
            a2 = a2 +% popcnt64(((i +% 2) *% k) ^ m)
            a3 = a3 +% popcnt64(((i +% 3) *% k) ^ m)
            i += 4
        }
        while i < i1 { a0 = a0 +% popcnt64((i *% k) ^ m); i += 1 }
        ptr_write_i64(out_acc, tid, a0 +% a1 +% a2 +% a3)
    }
}

fn b04_popcnt_10m() -> i64 {
    unsafe {
        args := mem_alloc_aligned(64); out := mem_alloc_aligned(256)
        mem_set(out, 0, 256)
        ptr_write_i64(args, 0, 10000000); ptr_write_i64(args, 1, out)
        _ := ai_pool_dispatch(fn_addr(_b04_worker), args)
        mut tot := 0; mut t := 0
        while t < 16 { tot = tot +% ptr_read_i64(out, t); t += 1 }
        mem_free_aligned(args); mem_free_aligned(out)
        return tot
    }
}

fn _b05_worker(tid: i64, nthreads: i64, pool: i64) {
    unsafe {
        pa := ptr_read_i64(pool, 4)
        pb := ptr_read_i64(pool, 5)
        n := ptr_read_i64(pool, 6)
        out_f := ptr_read_i64(pool, 7)
        i0 := (tid * n) / nthreads
        i1 := ((tid + 1) * n) / nthreads
        cnt := i1 - i0
        a_sub := pa + (i0 << 3)
        b_sub := pb + (i0 << 3)
        mut sum := 0.0
        mut i := 0
        while i < cnt {
            sum += ptr_read_f64(a_sub, i) * ptr_read_f64(b_sub, i)
            i += 1
        }
        ptr_write_f64(out_f, tid, sum)
    }
}

fn b05_dot_f64_8m(pa: i64, pb: i64, n: i64) -> i64 {
    unsafe {
        args := mem_alloc_aligned(64); out_f := mem_alloc_aligned(256)
        mem_set(out_f, 0, 256)
        ptr_write_i64(args, 0, pa); ptr_write_i64(args, 1, pb)
        ptr_write_i64(args, 2, n); ptr_write_i64(args, 3, out_f)
        _ := ai_pool_dispatch(fn_addr(_b05_worker), args)
        mut tot := 0.0; mut t := 0
        while t < 16 { tot = tot + ptr_read_f64(out_f, t); t += 1 }
        mem_free_aligned(args); mem_free_aligned(out_f)
        return (tot * 100.0) as i64
    }
}

fn b06_splitmix64_25m() -> i64 {
    mut s := 0x123456789ABCDEF0
    mut acc := 0
    mut i := 0
    while i < 25000000 {
        s = s +% 0x9E3779B97F4A7C15
        mut z := s
        z = (z ^ ushr64(z, 30)) *% 0xBF58476D1CE4E5B9
        z = (z ^ ushr64(z, 27)) *% 0x94D049BB133111EB
        z = z ^ ushr64(z, 31)
        acc = acc ^ z
        i += 1
    }
    return acc
}

fn _b07_worker(tid: i64, nthreads: i64, pool: i64) {
    unsafe {
        buf_p := ptr_read_i64(pool, 4)
        stride := ptr_read_i64(pool, 5)
        cnt := ptr_read_i64(pool, 6)
        out := ptr_read_i64(pool, 7)
        r0 := (tid * cnt) / nthreads
        r1 := ((tid + 1) * cnt) / nthreads
        mut p := buf_p + r0 * stride
        mut acc := 0
        mut r := r0
        while r < r1 {
            mut v := ptr_read_u8(p, 0) - 48
            v = v * 10 + (ptr_read_u8(p, 1) - 48)
            v = v * 10 + (ptr_read_u8(p, 2) - 48)
            v = v * 10 + (ptr_read_u8(p, 3) - 48)
            v = v * 10 + (ptr_read_u8(p, 4) - 48)
            v = v * 10 + (ptr_read_u8(p, 5) - 48)
            v = v * 10 + (ptr_read_u8(p, 6) - 48)
            v = v * 10 + (ptr_read_u8(p, 7) - 48)
            v = v * 10 + (ptr_read_u8(p, 8) - 48)
            v = v * 10 + (ptr_read_u8(p, 9) - 48)
            acc = acc +% v
            p += stride
            r += 1
        }
        ptr_write_i64(out, tid, acc)
    }
}

fn b07_parse_i64_500k(buf_p: i64, stride: i64, cnt: i64) -> i64 {
    unsafe {
        args := mem_alloc_aligned(64); out := mem_alloc_aligned(256)
        mem_set(out, 0, 256)
        ptr_write_i64(args, 0, buf_p); ptr_write_i64(args, 1, stride)
        ptr_write_i64(args, 2, cnt); ptr_write_i64(args, 3, out)
        _ := ai_pool_dispatch(fn_addr(_b07_worker), args)
        mut tot := 0; mut t := 0
        while t < 16 { tot = tot +% ptr_read_i64(out, t); t += 1 }
        mem_free_aligned(args); mem_free_aligned(out)
        return tot
    }
}

fn b08_fnv1a_8m(p: i64, n: i64) -> i64 {
    unsafe {
        mut h := 0xCBF29CE484222325
        mut i := 0
        while i < n {
            b := ptr_read_u8(p, i)
            h = (h ^ b) *% 0x00000100000001B3
            i += 1
        }
        return h
    }
}

// --- Tier 2: Medium (B09..B16) ---

fn b09_sort_500k(orig: IntBuf, work: IntBuf, n: i64) -> i64 {
    unsafe {
        mem_copy((work as i64) + 16, (orig as i64) + 16, n * 8)
        ptr_write_i64(work as i64, 0, n)
    }
    sort_i64(work)
    return ibuf_get(work, 0) ^ ibuf_get(work, 123456) ^ ibuf_get(work, 250000) ^ ibuf_get(work, 375000) ^ ibuf_get(work, n - 1)
}

fn b10_hashmap_500k() -> i64 {
    mut m := dmap_new(64)
    mut i := 0
    while i < 250000 {
        dmap_put(mut m, i * 13 + 7, i * 3 + 1)
        i += 1
    }
    mut acc := 0
    i = 0
    while i < 250000 {
        acc = acc +% dmap_get(m, i * 13 + 7, 0)
        i += 1
    }
    dmap_free(move m)
    return acc
}

fn b11_mem_find_4m(hay: str) -> i64 {
    mut pos := 0
    mut acc := 0
    mut hits := 0
    while true {
        idx := str_find(hay, "AXON_NEEDLE!", pos)
        if idx < 0 { break }
        acc = acc +% idx
        hits += 1
        pos = idx + 12
    }
    return acc ^ (hits << 32)
}

fn b12_json_100k(doc: str) -> i64 {
    n := str_len(doc)
    unsafe {
        p := c_str_ptr(doc)
        mut pos := 0
        mut acc := 0
        while pos < n {
            // Find `:` after id then parse digits; find next `:` after score then parse digits; skip to newline
            while pos < n and ptr_read_u8(p, pos) != 58 { pos += 1 }
            if pos >= n { break }
            pos += 1
            mut id_v := 0
            while pos < n {
                ch := ptr_read_u8(p, pos)
                if ch < 48 or ch > 57 { break }
                id_v = id_v * 10 + (ch - 48)
                pos += 1
            }
            while pos < n and ptr_read_u8(p, pos) != 58 { pos += 1 }
            if pos >= n { break }
            pos += 1
            mut sc_v := 0
            while pos < n {
                ch := ptr_read_u8(p, pos)
                if ch < 48 or ch > 57 { break }
                sc_v = sc_v * 10 + (ch - 48)
                pos += 1
            }
            acc = acc +% id_v +% sc_v
            while pos < n and ptr_read_u8(p, pos) != 10 { pos += 1 }
            pos += 1
        }
        return acc
    }
}

fn _b13_worker(tid: i64, nthreads: i64, pool: i64) {
    unsafe {
        src := ptr_read_i64(pool, 4)
        enc := ptr_read_i64(pool, 5)
        dec := ptr_read_i64(pool, 6)
        etbl := ptr_read_i64(pool, 7)
        dtbl := ptr_read_i64(pool, 8)
        triples := ptr_read_i64(pool, 9)
        t0 := (tid * triples) / nthreads
        t1 := ((tid + 1) * triples) / nthreads
        mut si := t0 * 3
        mut ei := t0 * 4
        end_s := t1 * 3
        while si < end_s {
            v := (ptr_read_u8(src, si) << 16) | (ptr_read_u8(src, si + 1) << 8) | ptr_read_u8(src, si + 2)
            ptr_write_u8(enc, ei,     ptr_read_u8(etbl, ushr64(v, 18) & 63))
            ptr_write_u8(enc, ei + 1, ptr_read_u8(etbl, ushr64(v, 12) & 63))
            ptr_write_u8(enc, ei + 2, ptr_read_u8(etbl, ushr64(v, 6) & 63))
            ptr_write_u8(enc, ei + 3, ptr_read_u8(etbl, v & 63))
            si += 3; ei += 4
        }
        mut di := t0 * 3
        mut pi := t0 * 4
        end_p := t1 * 4
        while pi < end_p {
            v := (ptr_read_u8(dtbl, ptr_read_u8(enc, pi)) << 18)
               | (ptr_read_u8(dtbl, ptr_read_u8(enc, pi + 1)) << 12)
               | (ptr_read_u8(dtbl, ptr_read_u8(enc, pi + 2)) << 6)
               | ptr_read_u8(dtbl, ptr_read_u8(enc, pi + 3))
            ptr_write_u8(dec, di,     ushr64(v, 16) & 255)
            ptr_write_u8(dec, di + 1, ushr64(v, 8) & 255)
            ptr_write_u8(dec, di + 2, v & 255)
            di += 3; pi += 4
        }
    }
}

fn b13_base64_2m(raw: ByteBuf) -> i64 {
    n := buf_len(raw)
    triples := n / 3
    enc_len := ((n + 2) / 3) * 4
    unsafe {
        src := (raw as i64) + 16
        enc := mem_alloc_aligned(enc_len + 64)
        dec := mem_alloc_aligned(n + 64)
        etbl := mem_alloc_aligned(64)
        dtbl := mem_alloc_aligned(256)
        args := mem_alloc_aligned(64)
        mem_set(dtbl, 0, 256)
        mut k := 0
        while k < 26 { ptr_write_u8(etbl, k, 65 + k); ptr_write_u8(dtbl, 65 + k, k); k += 1 }
        k = 0
        while k < 26 { ptr_write_u8(etbl, 26 + k, 97 + k); ptr_write_u8(dtbl, 97 + k, 26 + k); k += 1 }
        k = 0
        while k < 10 { ptr_write_u8(etbl, 52 + k, 48 + k); ptr_write_u8(dtbl, 48 + k, 52 + k); k += 1 }
        ptr_write_u8(etbl, 62, 43); ptr_write_u8(dtbl, 43, 62)
        ptr_write_u8(etbl, 63, 47); ptr_write_u8(dtbl, 47, 63)

        ptr_write_i64(args, 0, src); ptr_write_i64(args, 1, enc); ptr_write_i64(args, 2, dec)
        ptr_write_i64(args, 3, etbl); ptr_write_i64(args, 4, dtbl); ptr_write_i64(args, 5, triples)
        _ := ai_pool_dispatch(fn_addr(_b13_worker), args)

        // Tail 0..2 bytes
        si := triples * 3
        rem := n - si
        if rem == 1 {
            ptr_write_u8(dec, si, ptr_read_u8(src, si))
        } else if rem == 2 {
            ptr_write_u8(dec, si, ptr_read_u8(src, si))
            ptr_write_u8(dec, si + 1, ptr_read_u8(src, si + 1))
        }
        mut acc := n
        mut i := 0
        while i < n { acc = acc +% ptr_read_u8(dec, i); i += 64 }
        mem_free_aligned(enc); mem_free_aligned(dec); mem_free_aligned(etbl); mem_free_aligned(dtbl); mem_free_aligned(args)
        return acc
    }
}

fn b14_csv_100k_agg(p: i64, n: i64) -> i64 {
    unsafe {
        mut i := 0
        mut sum_v := 0
        mut max_v := 0
        while i < n {
            mut c0 := 0; while i < n { ch := ptr_read_u8(p, i); i += 1; if ch == 44 { break }; c0 = c0 * 10 + (ch - 48) }
            mut c1 := 0; while i < n { ch := ptr_read_u8(p, i); i += 1; if ch == 44 { break }; c1 = c1 * 10 + (ch - 48) }
            mut c2 := 0; while i < n { ch := ptr_read_u8(p, i); i += 1; if ch == 44 { break }; c2 = c2 * 10 + (ch - 48) }
            mut c3 := 0; while i < n { ch := ptr_read_u8(p, i); i += 1; if ch == 10 { break }; c3 = c3 * 10 + (ch - 48) }
            tot := c0 +% c1 +% c2 +% c3
            sum_v = sum_v +% tot
            if c2 > max_v { max_v = c2 }
        }
        return sum_v ^ (max_v << 20)
    }
}

fn b15_spsc_ring_10m() -> i64 {
    r := spsc_new(1024)
    unsafe {
        src := mem_alloc_aligned(2048)
        dst := mem_alloc_aligned(2048)
        mut acc := 0
        mut base := 0
        while base < 10000000 {
            mut j := 0
            while j < 256 {
                ptr_write_i64(src, j, base +% j)
                ptr_write_i64(src, j + 1, base +% j +% 1)
                ptr_write_i64(src, j + 2, base +% j +% 2)
                ptr_write_i64(src, j + 3, base +% j +% 3)
                j += 4
            }
            _ := spsc_push_batch(r, src, 256)
            got := spsc_pop_batch(r, dst, 256)
            j = 0
            while j < got {
                acc = acc +% ptr_read_i64(dst, j) +% ptr_read_i64(dst, j + 1) +% ptr_read_i64(dst, j + 2) +% ptr_read_i64(dst, j + 3)
                j += 4
            }
            base += 256
        }
        mem_free_aligned(src)
        mem_free_aligned(dst)
        spsc_free(move r)
        return acc
    }
}

fn b16_dijkstra_20k(g: Graph) -> i64 {
    dist := graph_dijkstra(g, 0)
    mut acc := 0
    mut i := 0
    n := ibuf_len(dist)
    while i < n {
        d := ibuf_get(dist, i)
        if d < 1000000000000 { acc = acc +% d }
        i += 1
    }
    buf_free(move dist)
    return acc
}

// --- Tier 3: Hard (B17..B23) ---

fn b17_crc32_8m(buf_p: i64, n: i64, tbl: i64) -> i64 {
    if n < 0 { return b17_crc32_8m(buf_p, 0, tbl) }
    unsafe {
        mut crc := 0xFFFFFFFF
        mut i := 0
        while i < n {
            idx := (crc ^ ptr_read_u8(buf_p, i)) & 255
            crc = ushr64(crc, 8) ^ ptr_read_i64(tbl, idx)
            i += 1
        }
        return (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
}

fn b18_sha256_4m(b4m: ByteBuf) -> i64 {
    h := sha256_raw_digest(b4m)
    chk := (ibuf_get(h, 0) << 32) | (ibuf_get(h, 1) & 0xFFFFFFFF)
    buf_free(move h)
    return chk
}

fn _chacha_worker(tid: i64, nthreads: i64, pool: i64) {
    unsafe {
        nblocks := ptr_read_i64(pool, 4)
        out_acc := ptr_read_i64(pool, 5)
        b0 := (tid * nblocks) / nthreads
        b1 := ((tid + 1) * nblocks) / nthreads
        mut acc := 0
        mut blk := b0
        while blk < b1 {
            mut x0 := 0x61707865; mut x1 := 0x3320646e; mut x2 := 0x79622d32; mut x3 := 0x6b206574
            mut x4 := 0x03020100; mut x5 := 0x07060504; mut x6 := 0x0b0a0908; mut x7 := 0x0f0e0d0c
            mut x8 := 0x13121110; mut x9 := 0x17161514; mut x10 := 0x1b1a1918; mut x11 := 0x1f1e1d1c
            mut x12 := blk & 0xFFFFFFFF; mut x13 := 0x09000000; mut x14 := 0x4a000000; mut x15 := 0x00000000
            mut rnd := 0
            while rnd < 10 {
                // Column rounds (4 quarter-rounds, hardware 32-bit ROR via `& 0xFFFFFFFF`)
                x0 = (x0 +% x4) & 0xFFFFFFFF; x12 = x12 ^ x0; x12 = (ushr64(x12, 16) | (x12 << 16)) & 0xFFFFFFFF
                x8 = (x8 +% x12) & 0xFFFFFFFF; x4 = x4 ^ x8; x4 = (ushr64(x4, 20) | (x4 << 12)) & 0xFFFFFFFF
                x0 = (x0 +% x4) & 0xFFFFFFFF; x12 = x12 ^ x0; x12 = (ushr64(x12, 24) | (x12 << 8)) & 0xFFFFFFFF
                x8 = (x8 +% x12) & 0xFFFFFFFF; x4 = x4 ^ x8; x4 = (ushr64(x4, 25) | (x4 << 7)) & 0xFFFFFFFF

                x1 = (x1 +% x5) & 0xFFFFFFFF; x13 = x13 ^ x1; x13 = (ushr64(x13, 16) | (x13 << 16)) & 0xFFFFFFFF
                x9 = (x9 +% x13) & 0xFFFFFFFF; x5 = x5 ^ x9; x5 = (ushr64(x5, 20) | (x5 << 12)) & 0xFFFFFFFF
                x1 = (x1 +% x5) & 0xFFFFFFFF; x13 = x13 ^ x1; x13 = (ushr64(x13, 24) | (x13 << 8)) & 0xFFFFFFFF
                x9 = (x9 +% x13) & 0xFFFFFFFF; x5 = x5 ^ x9; x5 = (ushr64(x5, 25) | (x5 << 7)) & 0xFFFFFFFF

                x2 = (x2 +% x6) & 0xFFFFFFFF; x14 = x14 ^ x2; x14 = (ushr64(x14, 16) | (x14 << 16)) & 0xFFFFFFFF
                x10 = (x10 +% x14) & 0xFFFFFFFF; x6 = x6 ^ x10; x6 = (ushr64(x6, 20) | (x6 << 12)) & 0xFFFFFFFF
                x2 = (x2 +% x6) & 0xFFFFFFFF; x14 = x14 ^ x2; x14 = (ushr64(x14, 24) | (x14 << 8)) & 0xFFFFFFFF
                x10 = (x10 +% x14) & 0xFFFFFFFF; x6 = x6 ^ x10; x6 = (ushr64(x6, 25) | (x6 << 7)) & 0xFFFFFFFF

                x3 = (x3 +% x7) & 0xFFFFFFFF; x15 = x15 ^ x3; x15 = (ushr64(x15, 16) | (x15 << 16)) & 0xFFFFFFFF
                x11 = (x11 +% x15) & 0xFFFFFFFF; x7 = x7 ^ x11; x7 = (ushr64(x7, 20) | (x7 << 12)) & 0xFFFFFFFF
                x3 = (x3 +% x7) & 0xFFFFFFFF; x15 = x15 ^ x3; x15 = (ushr64(x15, 24) | (x15 << 8)) & 0xFFFFFFFF
                x11 = (x11 +% x15) & 0xFFFFFFFF; x7 = x7 ^ x11; x7 = (ushr64(x7, 25) | (x7 << 7)) & 0xFFFFFFFF

                // Diagonal rounds
                x0 = (x0 +% x5) & 0xFFFFFFFF; x15 = x15 ^ x0; x15 = (ushr64(x15, 16) | (x15 << 16)) & 0xFFFFFFFF
                x10 = (x10 +% x15) & 0xFFFFFFFF; x5 = x5 ^ x10; x5 = (ushr64(x5, 20) | (x5 << 12)) & 0xFFFFFFFF
                x0 = (x0 +% x5) & 0xFFFFFFFF; x15 = x15 ^ x0; x15 = (ushr64(x15, 24) | (x15 << 8)) & 0xFFFFFFFF
                x10 = (x10 +% x15) & 0xFFFFFFFF; x5 = x5 ^ x10; x5 = (ushr64(x5, 25) | (x5 << 7)) & 0xFFFFFFFF

                x1 = (x1 +% x6) & 0xFFFFFFFF; x12 = x12 ^ x1; x12 = (ushr64(x12, 16) | (x12 << 16)) & 0xFFFFFFFF
                x11 = (x11 +% x12) & 0xFFFFFFFF; x6 = x6 ^ x11; x6 = (ushr64(x6, 20) | (x6 << 12)) & 0xFFFFFFFF
                x1 = (x1 +% x6) & 0xFFFFFFFF; x12 = x12 ^ x1; x12 = (ushr64(x12, 24) | (x12 << 8)) & 0xFFFFFFFF
                x11 = (x11 +% x12) & 0xFFFFFFFF; x6 = x6 ^ x11; x6 = (ushr64(x6, 25) | (x6 << 7)) & 0xFFFFFFFF

                x2 = (x2 +% x7) & 0xFFFFFFFF; x13 = x13 ^ x2; x13 = (ushr64(x13, 16) | (x13 << 16)) & 0xFFFFFFFF
                x8 = (x8 +% x13) & 0xFFFFFFFF; x7 = x7 ^ x8; x7 = (ushr64(x7, 20) | (x7 << 12)) & 0xFFFFFFFF
                x2 = (x2 +% x7) & 0xFFFFFFFF; x13 = x13 ^ x2; x13 = (ushr64(x13, 24) | (x13 << 8)) & 0xFFFFFFFF
                x8 = (x8 +% x13) & 0xFFFFFFFF; x7 = x7 ^ x8; x7 = (ushr64(x7, 25) | (x7 << 7)) & 0xFFFFFFFF

                x3 = (x3 +% x4) & 0xFFFFFFFF; x14 = x14 ^ x3; x14 = (ushr64(x14, 16) | (x14 << 16)) & 0xFFFFFFFF
                x9 = (x9 +% x14) & 0xFFFFFFFF; x4 = x4 ^ x9; x4 = (ushr64(x4, 20) | (x4 << 12)) & 0xFFFFFFFF
                x3 = (x3 +% x4) & 0xFFFFFFFF; x14 = x14 ^ x3; x14 = (ushr64(x14, 24) | (x14 << 8)) & 0xFFFFFFFF
                x9 = (x9 +% x14) & 0xFFFFFFFF; x4 = x4 ^ x9; x4 = (ushr64(x4, 25) | (x4 << 7)) & 0xFFFFFFFF
                rnd += 1
            }
            acc = acc ^ ((x0 +% 0x61707865) & 0xFFFFFFFF) ^ ((x12 +% blk) & 0xFFFFFFFF)
            blk += 1
        }
        ptr_write_i64(out_acc, tid, acc)
    }
}

fn b19_chacha20_4m() -> i64 {
    unsafe {
        args := mem_alloc_aligned(64)
        out_acc := mem_alloc_aligned(256)
        mem_set(out_acc, 0, 256)
        ptr_write_i64(args, 0, 65536) // 65536 * 64B = 4 MB
        ptr_write_i64(args, 1, out_acc)
        _ := ai_pool_dispatch(fn_addr(_chacha_worker), args)
        mut total := 0
        mut t := 0
        while t < 16 { total = total ^ ptr_read_i64(out_acc, t); t += 1 }
        mem_free_aligned(args); mem_free_aligned(out_acc)
        return total
    }
}

fn _nbody_step_worker(tid: i64, nthreads: i64, pool: i64) {
    unsafe {
        ptrs := ptr_read_i64(pool, 4)
        n := ptr_read_i64(pool, 5)
        px := ptr_read_i64(ptrs, 0); py := ptr_read_i64(ptrs, 1); pz := ptr_read_i64(ptrs, 2)
        vx := ptr_read_i64(ptrs, 3); vy := ptr_read_i64(ptrs, 4); vz := ptr_read_i64(ptrs, 5)
        pm := ptr_read_i64(ptrs, 6)
        dt := 0.01
        i0 := (tid * n) / nthreads
        i1 := ((tid + 1) * n) / nthreads
        mut i := i0
        while i < i1 {
            xi := ptr_read_f64(px, i); yi := ptr_read_f64(py, i); zi := ptr_read_f64(pz, i)
            mut ax := 0.0; mut ay := 0.0; mut az := 0.0
            mut j := 0
            while j < n {
                dx := ptr_read_f64(px, j) - xi
                dy := ptr_read_f64(py, j) - yi
                dz := ptr_read_f64(pz, j) - zi
                d2 := dx * dx + dy * dy + dz * dz + 0.01
                inv := 1.0 / (d2 * sqrt_f64(d2))
                s := ptr_read_f64(pm, j) * inv
                ax = ax + dx * s
                ay = ay + dy * s
                az = az + dz * s
                j += 1
            }
            ptr_write_f64(vx, i, ptr_read_f64(vx, i) + ax * dt)
            ptr_write_f64(vy, i, ptr_read_f64(vy, i) + ay * dt)
            ptr_write_f64(vz, i, ptr_read_f64(vz, i) + az * dt)
            i += 1
        }
    }
}

fn b20_nbody_3d_256() -> i64 {
    n := 256
    steps := 200
    dt := 0.01
    unsafe {
        px := mem_alloc_aligned(n * 8 + 64); py := mem_alloc_aligned(n * 8 + 64); pz := mem_alloc_aligned(n * 8 + 64)
        vx := mem_alloc_aligned(n * 8 + 64); vy := mem_alloc_aligned(n * 8 + 64); vz := mem_alloc_aligned(n * 8 + 64)
        pm := mem_alloc_aligned(n * 8 + 64)
        ptrs := mem_alloc_aligned(64)
        args := mem_alloc_aligned(64)
        ptr_write_i64(ptrs, 0, px); ptr_write_i64(ptrs, 1, py); ptr_write_i64(ptrs, 2, pz)
        ptr_write_i64(ptrs, 3, vx); ptr_write_i64(ptrs, 4, vy); ptr_write_i64(ptrs, 5, vz)
        ptr_write_i64(ptrs, 6, pm)
        ptr_write_i64(args, 0, ptrs); ptr_write_i64(args, 1, n)
        mut i := 0
        while i < n {
            fi := (i + 1) as f64
            ptr_write_f64(px, i, fi * 0.13)
            ptr_write_f64(py, i, fi * 0.27 - 10.0)
            ptr_write_f64(pz, i, fi * 0.09 - 5.0)
            ptr_write_f64(vx, i, 0.0)
            ptr_write_f64(vy, i, 0.0)
            ptr_write_f64(vz, i, 0.0)
            ptr_write_f64(pm, i, 0.01 + ((i % 7) as f64) * 0.005)
            i += 1
        }
        mut st := 0
        while st < steps {
            _ := ai_pool_dispatch(fn_addr(_nbody_step_worker), args)
            i = 0
            while i < n {
                ptr_write_f64(px, i, ptr_read_f64(px, i) + ptr_read_f64(vx, i) * dt)
                ptr_write_f64(py, i, ptr_read_f64(py, i) + ptr_read_f64(vy, i) * dt)
                ptr_write_f64(pz, i, ptr_read_f64(pz, i) + ptr_read_f64(vz, i) * dt)
                i += 1
            }
            st += 1
        }
        mut sum := 0.0
        i = 0
        while i < n { sum = sum + ptr_read_f64(px, i) + ptr_read_f64(py, i) + ptr_read_f64(pz, i); i += 1 }
        mem_free_aligned(px); mem_free_aligned(py); mem_free_aligned(pz)
        mem_free_aligned(vx); mem_free_aligned(vy); mem_free_aligned(vz); mem_free_aligned(pm)
        mem_free_aligned(ptrs); mem_free_aligned(args)
        return (sum * 100.0) as i64
    }
}

fn b21_knapsack_dp_20m() -> i64 {
    n_items := 1000
    cap := 20000
    unsafe {
        dp := mem_alloc_aligned((cap + 8) * 8)
        mem_set(dp, 0, (cap + 1) * 8)
        mut it := 0
        while it < n_items {
            w := 5 + ((it * 37 + 11) % 250)
            v := 10 + ((it * 97 + 23) % 500)
            mut c := cap
            while c >= w {
                cand := ptr_read_i64(dp, c - w) + v
                cur := ptr_read_i64(dp, c)
                if cand > cur { ptr_write_i64(dp, c, cand) }
                c -= 1
            }
            it += 1
        }
        ans := ptr_read_i64(dp, cap)
        mem_free_aligned(dp)
        return ans
    }
}

fn _mandel_worker(tid: i64, nthreads: i64, pool: i64) {
    unsafe {
        size := ptr_read_i64(pool, 4)
        out_acc := ptr_read_i64(pool, 5)
        y0 := (tid * size) / nthreads
        y1 := ((tid + 1) * size) / nthreads
        inv := 1.0 / (size as f64)
        mut total := 0
        mut y := y0
        while y < y1 {
            cy := (y as f64) * 2.4 * inv - 1.2
            mut x := 0
            while x < size {
                cx := (x as f64) * 3.0 * inv - 2.0
                mut zr := 0.0
                mut zi := 0.0
                mut it := 0
                while it < 256 {
                    zr2 := zr * zr
                    zi2 := zi * zi
                    if zr2 + zi2 > 4.0 { break }
                    zi = 2.0 * zr * zi + cy
                    zr = zr2 - zi2 + cx
                    it += 1
                }
                total += it
                x += 1
            }
            y += 1
        }
        ptr_write_i64(out_acc, tid, total)
    }
}

fn b22_mandelbrot_1k() -> i64 {
    unsafe {
        args := mem_alloc_aligned(64)
        out_acc := mem_alloc_aligned(256)
        mem_set(out_acc, 0, 256)
        ptr_write_i64(args, 0, 1000)
        ptr_write_i64(args, 1, out_acc)
        _ := ai_pool_dispatch(fn_addr(_mandel_worker), args)
        mut total := 0
        mut t := 0
        while t < 16 { total += ptr_read_i64(out_acc, t); t += 1 }
        mem_free_aligned(args); mem_free_aligned(out_acc)
        return total
    }
}

fn b23_fft_65536() -> i64 {
    n := 65536
    re := mat_zeros(1, n)
    im := mat_zeros(1, n)
    unsafe {
        mut i := 0
        while i < n {
            ptr_write_f64(re.ptr, i, ((i % 64) as f64) * 0.05 - 1.5)
            ptr_write_f64(im.ptr, i, ((i % 32) as f64) * 0.03 - 0.5)
            i += 1
        }
    }
    _ := fft_radix2_inplace(re, im, false)
    mut mag_sum := 0.0
    unsafe {
        mut i := 0
        while i < n {
            r := ptr_read_f64(re.ptr, i)
            m := ptr_read_f64(im.ptr, i)
            mag_sum = mag_sum + sqrt_f64(r * r + m * m)
            i += 64
        }
    }
    mat_free(move re); mat_free(move im)
    return (mag_sum * 10.0) as i64
}

// --- Tier 4: Extreme / Impossible (B24..B30) ---

fn b24_fp32_gemm_512(pa: i64, pb: i64, pc: i64) -> i64 {
    unsafe {
        _ := avx_gemm_f32(pa, pb, pc, 512, 512, 512)
        mut sum := 0.0
        mut i := 0
        while i < 512 * 512 { sum = sum + ptr_read_f32(pc, i); i += 17 }
        return (sum * 10.0) as i64
    }
}

fn b25_fp64_gemm_512(ma: MatF64, mb: MatF64) -> i64 {
    mc := mat_mul(ma, mb)
    mut sum := 0.0
    unsafe {
        mut i := 0
        while i < 512 * 512 { sum = sum + ptr_read_f64(mc.ptr, i); i += 17 }
    }
    mat_free(move mc)
    return (sum * 10.0) as i64
}

fn b26_bnn_gemv_4096(pw: i64, pa: i64, po: i64) -> i64 {
    unsafe {
        mut acc := 0
        mut r := 0
        while r < 8 {
            bnn_gemv_popcnt(pw, pa, po, 4096, 64)
            mut i := 0
            while i < 4096 { acc = acc +% ptr_read_i64(po, i); i += 16 }
            r += 1
        }
        return acc
    }
}

fn b27_q4_0_gemv_4096(pact: i64, pq4: i64, pout: i64) -> i64 {
    unsafe {
        mut sum := 0.0
        mut r := 0
        while r < 8 {
            _ := avx_gemv_q4_0_batch(pact, pq4, pout, 4096, 128)
            mut i := 0
            while i < 4096 { sum = sum + ptr_read_f32(pout, i); i += 16 }
            r += 1
        }
        return (sum * 10.0) as i64
    }
}

fn b28_q8_0_gemv_4096(pact: i64, pq8: i64, pout: i64) -> i64 {
    unsafe {
        mut sum := 0.0
        mut r := 0
        while r < 8 {
            _ := avx_gemv_q8_0_batch(pact, pq8, pout, 4096, 128)
            mut i := 0
            while i < 4096 { sum = sum + ptr_read_f32(pout, i); i += 16 }
            r += 1
        }
        return (sum * 10.0) as i64
    }
}

fn b29_faiss_l2_10k_128d(pvec: i64, pqry: i64, pdst: i64) -> i64 {
    unsafe {
        mut sum := 0.0
        mut q := 0
        while q < 32 {
            _ := avx_l2_batch_f32(pvec, pqry + q * 512, pdst, 10000, 128)
            mut i := 0
            while i < 10000 { sum = sum + ptr_read_f32(pdst, i); i += 64 }
            q += 1
        }
        return (sum * 10.0) as i64
    }
}

fn b30_llm_ffn_4096(px: i64, pnw: i64, pnorm: i64, pw1: i64, pw2: i64, pgate: i64, pup: i64, pact: i64) -> i64 {
    unsafe {
        mut sum := 0.0
        mut l := 0
        while l < 4 {
            _ := avx_rmsnorm_f32(px, pnw, pnorm, 4096, 0.00001)
            _ := avx_gemv_f32(pw1, pnorm, pgate, 4096, 4096)
            _ := avx_gemv_f32(pw2, pnorm, pup, 4096, 4096)
            _ := avx_swiglu_f32(pgate, pup, pact, 4096)
            mut i := 0
            while i < 4096 { sum = sum + ptr_read_f32(pact, i); i += 16 }
            l += 1
        }
        return (sum * 10.0) as i64
    }
}

fn main() -> i32 {
    // --- Pre-allocate deterministic shared inputs (excluded from kernel timers, identical to Rust!) ---
    // B05: 8M f64 arrays
    n_dot := 8000000
    pa_dot := unsafe { mem_alloc_aligned(n_dot * 8 + 64) }
    pb_dot := unsafe { mem_alloc_aligned(n_dot * 8 + 64) }
    unsafe {
        mut i := 0
        while i < n_dot {
            ptr_write_f64(pa_dot, i, ((i & 63) as f64) * 0.01 + 0.5)
            ptr_write_f64(pb_dot, i, ((i & 31) as f64) * 0.02 + 0.25)
            i += 1
        }
    }

    // B07: 500K 10-digit ASCII integers
    n_p7 := 500000
    p7_buf := unsafe { mem_alloc_aligned(n_p7 * 11 + 64) }
    unsafe {
        mut r := 0
        while r < n_p7 {
            mut v := 1000000000 + ((r * 7919 + 12345) % 899999999)
            base := r * 11
            mut d := 9
            while d >= 0 {
                ptr_write_u8(p7_buf, base + d, 48 + (v % 10))
                v = v / 10
                d -= 1
            }
            ptr_write_u8(p7_buf, base + 10, 10)
            r += 1
        }
    }

    // B08 & B17: 8 MB byte buffer + CRC32 table
    n8m := 8388608
    p8m := unsafe { mem_alloc_aligned(n8m + 64) }
    crc_tbl := unsafe { mem_alloc_aligned(256 * 8 + 64) }
    unsafe {
        mut i := 0
        while i < n8m { ptr_write_u8(p8m, i, (i * 31 + 17) & 255); i += 1 }
        mut ci := 0
        while ci < 256 {
            mut c := ci
            mut b := 0
            while b < 8 {
                if (c & 1) != 0 { c = ushr64(c, 1) ^ 0xEDB88320 } else { c = ushr64(c, 1) }
                b += 1
            }
            ptr_write_i64(crc_tbl, ci, c & 0xFFFFFFFF)
            ci += 1
        }
    }

    // B09: 500K random signed i64
    ns := 500000
    orig_sort := ibuf_new(ns)
    work_sort := ibuf_new(ns)
    mut rng := 0x123456789ABCDEF0
    mut i := 0
    while i < ns {
        rng = rng +% 0x9E3779B97F4A7C15
        mut z := rng
        z = (z ^ ushr64(z, 30)) *% 0xBF58476D1CE4E5B9
        z = (z ^ ushr64(z, 27)) *% 0x94D049BB133111EB
        z = z ^ ushr64(z, 31)
        ibuf_push(orig_sort, z)
        i += 1
    }

    // B11: 4 MB haystack with 2000 needles
    n4m := 4194304
    hb := buf_new(n4m + 64)
    unsafe {
        hp := (hb as i64) + 16
        mem_set(hp, 97, n4m)
        mut k := 0
        while k < 2000 {
            off := k * 2048 + 100
            ptr_write_u8(hp, off, 65); ptr_write_u8(hp, off + 1, 88); ptr_write_u8(hp, off + 2, 79); ptr_write_u8(hp, off + 3, 78)
            ptr_write_u8(hp, off + 4, 95); ptr_write_u8(hp, off + 5, 78); ptr_write_u8(hp, off + 6, 69); ptr_write_u8(hp, off + 7, 69)
            ptr_write_u8(hp, off + 8, 68); ptr_write_u8(hp, off + 9, 76); ptr_write_u8(hp, off + 10, 69); ptr_write_u8(hp, off + 11, 33)
            k += 1
        }
        ptr_write_i64(hb as i64, 0, n4m)
    }
    hay_str := buf_to_owned_str(move hb)

    // B12: 100K JSON lines
    jb := buf_new(4500000)
    i = 0
    while i < 100000 {
        buf_push_str(jb, "{\"id\":")
        buf_push_str(jb, str_from_i64(i))
        buf_push_str(jb, ",\"score\":")
        buf_push_str(jb, str_from_i64((i * 17 + 5) % 10000))
        buf_push_str(jb, ",\"ok\":true}\n")
        i += 1
    }
    json_doc := buf_to_owned_str(move jb)

    // B13: 2 MB raw buffer for Base64
    n2m := 2097152
    b2m := buf_new(n2m)
    unsafe {
        p := (b2m as i64) + 16
        i = 0; while i < n2m { ptr_write_u8(p, i, (i * 19 + 3) & 255); i += 1 }
        ptr_write_i64(b2m as i64, 0, n2m)
    }

    // B14: 100K CSV lines
    cb := buf_new(3500000)
    i = 0
    while i < 100000 {
        buf_push_str(cb, str_from_i64(i))
        buf_push(cb, 44)
        buf_push_str(cb, str_from_i64((i * 13 + 7) % 10000))
        buf_push(cb, 44)
        buf_push_str(cb, str_from_i64((i * 29 + 3) % 50000))
        buf_push(cb, 44)
        buf_push_str(cb, str_from_i64((i * 7 + 1) % 1000))
        buf_push(cb, 10)
        i += 1
    }
    csv_len := buf_len(cb)
    csv_ptr := unsafe { (cb as i64) + 16 }

    // B16: 20,000-node, 100,000-edge weighted graph
    mut g20k := graph_new(20000)
    i = 0
    while i < 20000 {
        mut e := 1
        while e <= 5 {
            dst_v := (i + e * 137 + (i % 19)) % 20000
            wt := 1 + ((i * 31 + e * 17) % 100)
            graph_add_edge(mut g20k, i, dst_v, wt)
            e += 1
        }
        i += 1
    }

    // B18: 4 MB SHA-256 buffer
    b4m := buf_new(n4m)
    unsafe {
        p := (b4m as i64) + 16
        i = 0; while i < n4m { ptr_write_u8(p, i, (i * 31 + 7) & 255); i += 1 }
        ptr_write_i64(b4m as i64, 0, n4m)
    }

    // B24: 512x512 FP32 GEMM
    n512 := 512 * 512
    pa32 := unsafe { mem_alloc_aligned(n512 * 4 + 64) }
    pb32 := unsafe { mem_alloc_aligned(n512 * 4 + 64) }
    pc32 := unsafe { mem_alloc_aligned(n512 * 4 + 64) }
    unsafe {
        i = 0
        while i < n512 {
            ptr_write_f32(pa32, i, ((i % 97) as f64) * 0.01)
            ptr_write_f32(pb32, i, ((i % 89) as f64) * 0.01)
            i += 1
        }
    }

    // B25: 512x512 FP64 GEMM
    ma64 := mat_zeros(512, 512)
    mb64 := mat_zeros(512, 512)
    unsafe {
        i = 0
        while i < n512 {
            ptr_write_f64(ma64.ptr, i, ((i % 97) as f64) * 0.01)
            ptr_write_f64(mb64.ptr, i, ((i % 89) as f64) * 0.01)
            i += 1
        }
    }

    // B26: BNN 4096x4096 (4096 rows x 64 u64 words)
    pw_bnn := unsafe { mem_alloc_aligned(4096 * 64 * 8 + 64) }
    pa_bnn := unsafe { mem_alloc_aligned(64 * 8 + 64) }
    po_bnn := unsafe { mem_alloc_aligned(4096 * 8 + 64) }
    unsafe {
        i = 0
        while i < 64 { ptr_write_i64(pa_bnn, i, (i +% 1) *% 0x9E3779B97F4A7C15); i += 1 }
        i = 0
        while i < 4096 * 64 { ptr_write_i64(pw_bnn, i, (i +% 7) *% 0xBF58476D1CE4E5B9); i += 1 }
    }

    // B27 & B28: Q4_0 (20B/blk) & Q8_0 (36B/blk) for 4096x4096 (128 blocks/row)
    pact_q := unsafe { mem_alloc_aligned(4096 * 4 + 64) }
    pq4 := unsafe { mem_alloc_aligned(4096 * 128 * 20 + 64) }
    pq8 := unsafe { mem_alloc_aligned(4096 * 128 * 36 + 64) }
    pout_q := unsafe { mem_alloc_aligned(4096 * 4 + 64) }
    unsafe {
        i = 0
        while i < 4096 { ptr_write_f32(pact_q, i, ((i % 31) as f64) * 0.02 - 0.3); i += 1 }
        mut r := 0
        while r < 4096 * 128 {
            off4 := pq4 + r * 20
            ptr_write_f32(off4, 0, 0.05)
            mut b := 0
            while b < 16 { ptr_write_u8(off4, 4 + b, ((r + b * 7) & 0xFF)); b += 1 }
            off8 := pq8 + r * 36
            ptr_write_f32(off8, 0, 0.01)
            b = 0
            while b < 32 { ptr_write_u8(off8, 4 + b, (((r + b * 5) % 251) - 125) & 0xFF); b += 1 }
            r += 1
        }
    }

    // B29: FAISS L2 10000 x 128D + 32 queries
    pvec_f := unsafe { mem_alloc_aligned(10000 * 128 * 4 + 64) }
    pqry_f := unsafe { mem_alloc_aligned(32 * 128 * 4 + 64) }
    pdst_f := unsafe { mem_alloc_aligned(10000 * 4 + 64) }
    unsafe {
        i = 0; while i < 10000 * 128 { ptr_write_f32(pvec_f, i, ((i % 53) as f64) * 0.02 - 0.5); i += 1 }
        i = 0; while i < 32 * 128 { ptr_write_f32(pqry_f, i, ((i % 47) as f64) * 0.02 - 0.4); i += 1 }
    }

    // B30: LLM FFN 4096 (RMSNorm + 2x FP32 GEMV + SwiGLU)
    px_llm := unsafe { mem_alloc_aligned(4096 * 4 + 64) }
    pnw_llm := unsafe { mem_alloc_aligned(4096 * 4 + 64) }
    pnorm_llm := unsafe { mem_alloc_aligned(4096 * 4 + 64) }
    pw1_llm := unsafe { mem_alloc_aligned(4096 * 4096 * 4 + 64) }
    pw2_llm := unsafe { mem_alloc_aligned(4096 * 4096 * 4 + 64) }
    pgate_llm := unsafe { mem_alloc_aligned(4096 * 4 + 64) }
    pup_llm := unsafe { mem_alloc_aligned(4096 * 4 + 64) }
    pact_llm := unsafe { mem_alloc_aligned(4096 * 4 + 64) }
    unsafe {
        i = 0
        while i < 4096 {
            ptr_write_f32(px_llm, i, ((i % 29) as f64) * 0.03 - 0.4)
            ptr_write_f32(pnw_llm, i, 1.0 + ((i % 11) as f64) * 0.01)
            i += 1
        }
        i = 0
        while i < 4096 * 4096 {
            ptr_write_f32(pw1_llm, i, ((i % 19) as f64) * 0.002 - 0.018)
            ptr_write_f32(pw2_llm, i, ((i % 23) as f64) * 0.002 - 0.022)
            i += 1
        }
    }

    // Warm up thread pool once (1 trivial dispatch so OS CreateThread cold cost is excluded fairly)
    _ := b26_bnn_gemv_4096(pw_bnn, pa_bnn, po_bnn)

    // --- Execute & time all 30 benchmarks ---
    times := ibuf_new(32)
    chks := ibuf_new(32)

    mut t0 := clock_ns(); ibuf_push(chks, b01_branchless_clamp_10m()); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b02_fib_rec_38()); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b03_sieve_1m()); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b04_popcnt_10m()); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b05_dot_f64_8m(pa_dot, pb_dot, n_dot)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b06_splitmix64_25m()); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b07_parse_i64_500k(p7_buf, 11, n_p7)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b08_fnv1a_8m(p8m, n8m)); ibuf_push(times, clock_ns() - t0)

    t0 = clock_ns(); ibuf_push(chks, b09_sort_500k(orig_sort, work_sort, ns)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b10_hashmap_500k()); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b11_mem_find_4m(hay_str)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b12_json_100k(json_doc)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b13_base64_2m(b2m)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b14_csv_100k_agg(csv_ptr, csv_len)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b15_spsc_ring_10m()); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b16_dijkstra_20k(g20k)); ibuf_push(times, clock_ns() - t0)

    t0 = clock_ns(); ibuf_push(chks, b17_crc32_8m(p8m, n8m, crc_tbl)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b18_sha256_4m(b4m)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b19_chacha20_4m()); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b20_nbody_3d_256()); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b21_knapsack_dp_20m()); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b22_mandelbrot_1k()); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b23_fft_65536()); ibuf_push(times, clock_ns() - t0)

    t0 = clock_ns(); ibuf_push(chks, b24_fp32_gemm_512(pa32, pb32, pc32)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b25_fp64_gemm_512(ma64, mb64)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b26_bnn_gemv_4096(pw_bnn, pa_bnn, po_bnn)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b27_q4_0_gemv_4096(pact_q, pq4, pout_q)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b28_q8_0_gemv_4096(pact_q, pq8, pout_q)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b29_faiss_l2_10k_128d(pvec_f, pqry_f, pdst_f)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b30_llm_ffn_4096(px_llm, pnw_llm, pnorm_llm, pw1_llm, pw2_llm, pgate_llm, pup_llm, pact_llm)); ibuf_push(times, clock_ns() - t0)

    // Emit compact JSON result line
    out := buf_new(8192)
    buf_push_str(out, "{\"lang\":\"Axon\",\"times_us\":[")
    i = 0
    while i < 30 {
        if i > 0 { buf_push(out, 44) }
        buf_push_str(out, str_from_i64(ibuf_get(times, i) / 1000))
        i += 1
    }
    buf_push_str(out, "],\"chks\":[")
    i = 0
    while i < 30 {
        if i > 0 { buf_push(out, 44) }
        buf_push_str(out, str_from_i64(ibuf_get(chks, i)))
        i += 1
    }
    buf_push_str(out, "]}")
    println(buf_to_owned_str(move out))

    // Clean up
    buf_free(move times); buf_free(move chks)
    buf_free(move orig_sort); buf_free(move work_sort); buf_free(move b2m); buf_free(move cb); buf_free(move b4m)
    graph_free(move g20k); mat_free(move ma64); mat_free(move mb64)
    unsafe {
        mem_free_aligned(pa_dot); mem_free_aligned(pb_dot); mem_free_aligned(p7_buf)
        mem_free_aligned(p8m); mem_free_aligned(crc_tbl)
        mem_free_aligned(pa32); mem_free_aligned(pb32); mem_free_aligned(pc32)
        mem_free_aligned(pw_bnn); mem_free_aligned(pa_bnn); mem_free_aligned(po_bnn)
        mem_free_aligned(pact_q); mem_free_aligned(pq4); mem_free_aligned(pq8); mem_free_aligned(pout_q)
        mem_free_aligned(pvec_f); mem_free_aligned(pqry_f); mem_free_aligned(pdst_f)
        mem_free_aligned(px_llm); mem_free_aligned(pnw_llm); mem_free_aligned(pnorm_llm)
        mem_free_aligned(pw1_llm); mem_free_aligned(pw2_llm); mem_free_aligned(pgate_llm)
        mem_free_aligned(pup_llm); mem_free_aligned(pact_llm)
    }
    return 0
}
