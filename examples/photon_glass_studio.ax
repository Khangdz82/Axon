// ==============================================================================
// AXON PHOTON GLASS STUDIO — Pure Native Desktop UI written in HTML + CSS + JS + Tailwind
// Zero Web Server, Zero Browser, Zero Electron — 100% Native Direct2D + DirectWrite!
// Run: bin/axc.exe run examples/photon_glass_studio.ax
// Build GUI (0 console): bin/axc.exe build examples/photon_glass_studio.ax --gui -o photon_studio.exe
// ==============================================================================

use std::ui
use std::gui
use std::str

fn build_photon_studio_html() -> str {
    return "<!DOCTYPE html><html><head><style>\n" +
        ":root {\n" +
        "  --surface: #070B14;\n" +
        "  --glass: rgba(15, 23, 42, 0.72);\n" +
        "  --rim: rgba(148, 163, 184, 0.16);\n" +
        "  --accent: #6366f1;\n" +
        "}\n" +
        "@keyframes pulse-ring { 0% { opacity: 0.6; } 100% { opacity: 1.0; } }\n" +
        "body { background: linear-gradient(135deg, #050811 0%, #0B1120 50%, #0F172A 100%); color: #F8FAFC; font-family: 'Segoe UI', sans-serif; }\n" +
        ".nav-item { padding: 8px 12px; border-radius: 10px; color: #94A3B8; cursor: pointer; }\n" +
        ".nav-item:hover { background: rgba(99, 102, 241, 0.14); color: #F8FAFC; }\n" +
        ".nav-active { background: linear-gradient(90deg, rgba(99,102,241,0.28), rgba(139,92,246,0.12)); color: #E0E7FF; border: 1px solid rgba(129,140,248,0.35); }\n" +
        ".glass-card { background: var(--glass); border: 1px solid var(--rim); border-radius: 16px; }\n" +
        ".glass-card:hover { border-color: rgba(129, 140, 248, 0.45); }\n" +
        ".action-btn { background: linear-gradient(135deg, #6366F1, #8B5CF6); color: #FFFFFF; border-radius: 10px; cursor: pointer; }\n" +
        ".action-btn:hover { background: linear-gradient(135deg, #4F46E5, #7C3AED); }\n" +
        ".ghost-btn { background: rgba(30, 41, 59, 0.75); border: 1px solid rgba(148, 163, 184, 0.22); color: #E2E8F0; border-radius: 10px; cursor: pointer; }\n" +
        ".ghost-btn:hover { background: rgba(51, 65, 85, 0.90); border-color: rgba(148, 163, 184, 0.45); }\n" +
        "@media (max-width: 960px) { .sidebar-col { display: none; } }\n" +
        "</style></head>" +
        "<body class='flex flex-col h-screen overflow-hidden'>" +

        // Top Glass Navigation Header
        "<header class='flex items-center justify-between px-5 py-3 bg-[#090E1A]/90 backdrop-blur-xl border-b border-slate-800/80 shrink-0'>" +
        "  <div class='flex items-center gap-3'>" +
        "    <div class='size-8 rounded-xl bg-gradient-to-br from-indigo-500 via-violet-500 to-fuchsia-500 shadow-lg shadow-indigo-500/30 flex items-center justify-center font-bold text-white text-sm'>A</div>" +
        "    <div class='flex flex-col'>" +
        "      <span class='text-sm font-bold bg-clip-text text-transparent bg-gradient-to-r from-sky-400 via-indigo-400 to-fuchsia-400'>Axon Photon Glass Studio</span>" +
        "      <span class='text-[11px] text-slate-400'>100% Native Direct2D + DirectWrite — Zero WebView • Zero Electron</span>" +
        "    </div>" +
        "  </div>" +
        "  <div class='flex items-center gap-3'>" +
        "    <input id='cmd-input' class='w-64 px-3 py-1.5 rounded-lg bg-slate-900/80 border border-slate-700/80 text-xs text-slate-100 focus:border-indigo-400' placeholder='Search components or commands...' />" +
        "    <span id='engine-pill' class='px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-400/30 text-emerald-300 text-[11px] font-semibold'>0.00% IDLE CPU</span>" +
        "    <button id='btn-boost' class='action-btn px-4 py-1.5 text-xs font-semibold shadow-lg shadow-indigo-500/30' onclick='runBenchmark()'>Run Pulse</button>" +
        "  </div>" +
        "</header>" +

        // Main Workspace Shell
        "<div class='flex flex-1 overflow-hidden'>" +

        // Left Glass Sidebar
        "<aside class='sidebar-col w-56 bg-[#070B14]/85 border-r border-slate-800/80 p-3 flex flex-col gap-1.5 shrink-0'>" +
        "  <div class='text-[10px] font-bold uppercase tracking-wider text-slate-500 px-3 py-1'>Workspace</div>" +
        "  <div id='tab-overview' class='nav-item nav-active text-xs font-medium' onclick='selectTab(1)'>Overview & Telemetry</div>" +
        "  <div id='tab-shaders' class='nav-item text-xs font-medium' onclick='selectTab(2)'>Glass & Gradients</div>" +
        "  <div id='tab-webview' class='nav-item text-xs font-medium' onclick='selectTab(3)'>Lean WebView Host</div>" +
        "  <div id='tab-signals' class='nav-item text-xs font-medium' onclick='selectTab(4)'>Zero-VDOM Signals</div>" +
        "  <div class='mt-auto p-3 rounded-xl bg-gradient-to-br from-indigo-950/90 via-slate-900/90 to-fuchsia-950/70 border border-indigo-500/30 backdrop-blur-md'>" +
        "    <div class='text-xs font-semibold text-indigo-200'>Memory Footprint</div>" +
        "    <div id='mem-badge' class='text-lg font-bold text-white mt-1'>~4.2 MB RSS</div>" +
        "    <div class='text-[11px] text-slate-400 mt-0.5 truncate'>Lazy Canvas + O(1) LUT + Zero Leaks</div>" +
        "  </div>" +
        "</aside>" +

        // Main Scrollable Canvas
        "<main class='flex-1 p-5 overflow-y-auto flex flex-col gap-5'>" +

        // Hero Glass Banner
        "<section class='p-5 rounded-2xl bg-gradient-to-r from-indigo-950/85 via-slate-900/90 to-cyan-950/75 backdrop-blur-xl border border-indigo-400/25 shadow-xl shadow-indigo-500/20 flex items-center justify-between gap-4'>" +
        "  <div class='flex flex-col gap-1.5 flex-1'>" +
        "    <div class='flex items-center gap-2'>" +
        "      <span class='px-2.5 py-0.5 rounded-full bg-fuchsia-500/20 border border-fuchsia-400/35 text-fuchsia-300 text-[10px] font-bold uppercase tracking-wide'>Photon-D2D v2</span>" +
        "      <span class='px-2.5 py-0.5 rounded-full bg-cyan-500/15 border border-cyan-400/30 text-cyan-300 text-[10px] font-semibold'>Tailwind v4 + CSS3 Native</span>" +
        "    </div>" +
        "    <h1 id='hero-title' class='text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-sky-200 to-indigo-300'>Web-Standard Aesthetics at Native Metal Speed</h1>" +
        "    <p id='hero-sub' class='text-xs text-slate-300 leading-relaxed'>Written 100% in HTML, CSS3, JS & Tailwind CSS — compiled to a standalone native Windows/Linux/macOS executable with hardware Direct2D/DirectWrite compositing.</p>" +
        "  </div>" +
        "  <div class='flex items-center gap-2 shrink-0'>" +
        "    <button id='btn-accent' class='ghost-btn px-3.5 py-2 text-xs font-medium' onclick='cycleTheme()'>Switch Accent</button>" +
        "    <button id='btn-deploy' class='action-btn px-4 py-2 text-xs font-semibold shadow-lg shadow-violet-500/30' onclick='incrementDeploy()'>Deploy Build</button>" +
        "  </div>" +
        "</section>" +

        // 4-Column Responsive KPI Grid
        "<section class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4'>" +
        "  <div class='glass-card backdrop-blur-lg p-4 shadow-lg shadow-sky-500/10 flex flex-col gap-1'>" +
        "    <span class='text-[11px] font-medium uppercase tracking-wide text-slate-400'>Style Cascade</span>" +
        "    <span id='kpi-style' class='text-2xl font-bold text-sky-400'>O(1) Top-Down</span>" +
        "    <span class='text-[11px] text-emerald-400'>~9x fewer ancestor walks</span>" +
        "  </div>" +
        "  <div class='glass-card backdrop-blur-lg p-4 shadow-lg shadow-emerald-500/10 flex flex-col gap-1'>" +
        "    <span class='text-[11px] font-medium uppercase tracking-wide text-slate-400'>Idle Power</span>" +
        "    <span id='kpi-cpu' class='text-2xl font-bold text-emerald-400'>0.00% CPU</span>" +
        "    <span class='text-[11px] text-slate-400'>Zero spin-loop MsgWait</span>" +
        "  </div>" +
        "  <div class='glass-card backdrop-blur-lg p-4 shadow-lg shadow-fuchsia-500/10 flex flex-col gap-1'>" +
        "    <span class='text-[11px] font-medium uppercase tracking-wide text-slate-400'>Tailwind Palette</span>" +
        "    <span id='kpi-colors' class='text-2xl font-bold text-fuchsia-400'>242 Colors</span>" +
        "    <span class='text-[11px] text-slate-400'>22 families + /opacity + hsl()</span>" +
        "  </div>" +
        "  <div class='glass-card backdrop-blur-lg p-4 shadow-lg shadow-amber-500/10 flex flex-col gap-1'>" +
        "    <span class='text-[11px] font-medium uppercase tracking-wide text-slate-400'>Active Pulses</span>" +
        "    <span id='kpi-pulses' class='text-2xl font-bold text-amber-400'>1</span>" +
        "    <span id='kpi-status' class='text-[11px] text-lime-400'>Engine ready & optimal</span>" +
        "  </div>" +
        "</section>" +

        // Bottom 2-Column Showcase Cards
        "<section class='grid grid-cols-1 lg:grid-cols-2 gap-4'>" +
        "  <div class='glass-card backdrop-blur-md p-4 flex flex-col gap-3'>" +
        "    <div class='flex items-center justify-between'>" +
        "      <h2 class='text-sm font-semibold text-white'>Hardware D2D Visual Pipeline</h2>" +
        "      <span class='px-2 py-0.5 rounded-md bg-indigo-500/20 text-indigo-300 text-[10px] font-mono'>ClearType + AA</span>" +
        "    </div>" +
        "    <div class='flex flex-col gap-2 text-xs text-slate-300'>" +
        "      <div class='p-2.5 rounded-xl bg-slate-800/60 border border-slate-700/60 flex justify-between items-center'>" +
        "        <span>Hollow AA Rounded Borders & Rings</span>" +
        "        <span class='text-emerald-400 font-mono text-[11px]'>GeometryGroup</span>" +
        "      </div>" +
        "      <div class='p-2.5 rounded-xl bg-slate-800/60 border border-slate-700/60 flex justify-between items-center'>" +
        "        <span>8-Dir Linear + Radial + Clip-Text Gradients</span>" +
        "        <span class='text-sky-400 font-mono text-[11px]'>GPU Brushes</span>" +
        "      </div>" +
        "      <div class='p-2.5 rounded-xl bg-slate-800/60 border border-slate-700/60 flex justify-between items-center'>" +
        "        <span>Color LUT (256 f32) + Persistent BitBlt</span>" +
        "        <span class='text-fuchsia-400 font-mono text-[11px]'>0 malloc/frame</span>" +
        "      </div>" +
        "    </div>" +
        "  </div>" +

        "  <div class='glass-card backdrop-blur-md p-4 flex flex-col gap-3'>" +
        "    <div class='flex items-center justify-between'>" +
        "      <h2 class='text-sm font-semibold text-white'>Ultra-Lean WebView & IPC Host</h2>" +
        "      <span class='px-2 py-0.5 rounded-md bg-teal-500/20 text-teal-300 text-[10px] font-mono'>Job Object</span>" +
        "    </div>" +
        "    <div class='flex flex-col gap-2 text-xs text-slate-300'>" +
        "      <div class='p-2.5 rounded-xl bg-slate-800/60 border border-slate-700/60 flex justify-between items-center'>" +
        "        <span>Zero-Orphan Process Tree Teardown</span>" +
        "        <span class='text-teal-300 font-mono text-[11px]'>KILL_ON_CLOSE</span>" +
        "      </div>" +
        "      <div class='p-2.5 rounded-xl bg-slate-800/60 border border-slate-700/60 flex justify-between items-center'>" +
        "        <span>Pre-baked Index + ETag 304 + Binary Static</span>" +
        "        <span class='text-amber-300 font-mono text-[11px]'>0.05ms IPC</span>" +
        "      </div>" +
        "      <div class='p-2.5 rounded-xl bg-slate-800/60 border border-slate-700/60 flex justify-between items-center'>" +
        "        <span>Native Win32 Profile Cleanup (0 cmd flash)</span>" +
        "        <span class='text-rose-300 font-mono text-[11px]'>--no-proxy</span>" +
        "      </div>" +
        "    </div>" +
        "  </div>" +
        "</section>" +

        "</main></div>" +

        // Interactive Pure-JS Logic
        "<script>\n" +
        "let pulses = 1;\n" +
        "let deploys = 0;\n" +
        "let theme_idx = 0;\n" +
        "function runBenchmark() {\n" +
        "  pulses += 1;\n" +
        "  document.getElementById('kpi-pulses').innerText = '' + pulses;\n" +
        "  document.getElementById('kpi-status').innerText = 'Pulse #' + pulses + ' synced in <1ms';\n" +
        "}\n" +
        "function incrementDeploy() {\n" +
        "  deploys += 1;\n" +
        "  document.getElementById('engine-pill').innerText = 'BUILD #' + deploys + ' READY';\n" +
        "}\n" +
        "function cycleTheme() {\n" +
        "  theme_idx += 1;\n" +
        "  if (theme_idx > 2) { theme_idx = 0; }\n" +
        "  if (theme_idx == 1) {\n" +
        "    document.getElementById('hero-title').innerText = 'Emerald Aurora Mode — Zero Overhead';\n" +
        "    document.getElementById('kpi-style').style.color = '#34d399';\n" +
        "  } else if (theme_idx == 2) {\n" +
        "    document.getElementById('hero-title').innerText = 'Rose Plasma Mode — Native Direct2D';\n" +
        "    document.getElementById('kpi-style').style.color = '#fb7185';\n" +
        "  } else {\n" +
        "    document.getElementById('hero-title').innerText = 'Web-Standard Aesthetics at Native Metal Speed';\n" +
        "    document.getElementById('kpi-style').style.color = '#38bdf8';\n" +
        "  }\n" +
        "}\n" +
        "function selectTab(id) {\n" +
        "  if (id == 1) { document.getElementById('hero-sub').innerText = 'Overview & Telemetry: O(1) top-down style cascade, 0.00% idle CPU, lazy 4MB canvas savings.'; }\n" +
        "  if (id == 2) { document.getElementById('hero-sub').innerText = 'Glass & Gradients: backdrop-blur specular glassmorphism, 8-dir & radial gradients, hollow AA borders.'; }\n" +
        "  if (id == 3) { document.getElementById('hero-sub').innerText = 'Lean WebView Host: Win32 Job Object teardown, --no-proxy instant boot, ETag 304 & binary static serving.'; }\n" +
        "  if (id == 4) { document.getElementById('hero-sub').innerText = 'Zero-VDOM Signals: direct O(1) DOM slot patching with zero CPU canvas churn on Photon-D2D.'; }\n" +
        "}\n" +
        "</script></body></html>"
}

fn main() -> i32 {
    html := build_photon_studio_html()
    mut app := ui_window_html("Axon Photon Glass Studio — Native HTML/CSS/JS/Tailwind", 1280, 800, html)
    _ := gui_run_ui_app(mut app)
    ui_app_free(move app)
    return 0
}
