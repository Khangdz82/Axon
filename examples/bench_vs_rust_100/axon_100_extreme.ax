    aabb_buf := mem_alloc_aligned(aabb_n * 6 * 8 + 64)
    i = 0
    while i < aabb_n {
        fx := (((i * 37) % 1000) as f64) * 0.1; fy := (((i * 73) % 1000) as f64) * 0.1; fz := (((i * 19) % 1000) as f64) * 0.1
        ptr_write_f64(aabb_buf, i, fx); ptr_write_f64(aabb_buf + aabb_n * 8, i, fx + 8.5)
        ptr_write_f64(aabb_buf + aabb_n * 16, i, fy); ptr_write_f64(aabb_buf + aabb_n * 24, i, fy + 8.5)
        ptr_write_f64(aabb_buf + aabb_n * 32, i, fz); ptr_write_f64(aabb_buf + aabb_n * 40, i, fz + 8.5)
