        }
        i += 1
    }
    _w32(dag_rp, 32000, de)

    fw_d := mem_alloc_aligned(160 * 160 * 8 + 64)
    pr_n := 16000
    pr_rp := mem_alloc_aligned((pr_n + 4) * 8); pr_ci := mem_alloc_aligned(pr_n * 6 * 4 + 64)
    pr_od := mem_alloc_aligned(pr_n * 8 + 64); mem_set(pr_od, 0, pr_n * 8)
    pr_a := mem_alloc_aligned(pr_n * 8 + 64); pr_b := mem_alloc_aligned(pr_n * 8 + 64)
    i = 0
    while i < pr_n {
        ptr_write_i64(pr_rp, i, i * 6)
        mut e := 0
        while e < 6 {
            c := (i * 29 + e * 71 + 5) % pr_n
            _w32(pr_ci, i * 6 + e, c)
            ptr_write_f64(pr_od, c, ptr_read_f64(pr_od, c) + 1.0)
            e += 1
        }
        i += 1
    }
    ptr_write_i64(pr_rp, pr_n, pr_n * 6)
    i = 0
    while i < pr_n {
        od := ptr_read_f64(pr_od, i)
        if od == 0.0 { ptr_write_f64(pr_od, i, 1.0) } else { ptr_write_f64(pr_od, i, 1.0 / od) }
        i += 1
    }
    knap_dp := mem_alloc_aligned(10008 * 8)

    // D6 Crypto inputs
    b2m_c := mem_alloc_aligned(2097152 + 64)
    i = 0; while i < 2097152 { ptr_write_u8(b2m_c, i, (i * 31 + 17) & 255); i += 1 }
    crc_tbl := mem_alloc_aligned(256 * 8 + 64)
    i = 0
    while i < 256 {
        mut c := i; mut b := 0
        while b < 8 { if (c & 1) != 0 { c = ushr64(c, 1) ^ 0xEDB88320 } else { c = ushr64(c, 1) }; b += 1 }
        ptr_write_i64(crc_tbl, i, c); i += 1
    }
    b512k_sha := mem_alloc_aligned(524288 + 64)
    i = 0; while i < 524288 { ptr_write_u8(b512k_sha, i, (i * 19 + 3) & 255); i += 1 }
    words_256k := mem_alloc_aligned(262144 * 8 + 64)
    i = 0; while i < 262144 { ptr_write_i64(words_256k, i, i *% 0x9E3779B97F4A7C15 +% 0x1234567); i += 1 }
    hmac_256k := mem_alloc_aligned(262144 + 64)
    i = 0; while i < 262144 { ptr_write_u8(hmac_256k, i, (i * 13 + 5) & 255); i += 1 }

    // D7 Signal inputs
    fft_re := mat_zeros(1, 16384); fft_im := mat_zeros(1, 16384)
    dct_data := mem_alloc_aligned(192 * 64 * 8 + 64); dct_cos := mem_alloc_aligned(64 * 64 * 8 + 64)
    i = 0; while i < 192 * 64 { ptr_write_f64(dct_data, i, ((i & 63) as f64) * 0.04 - 1.2); i += 1 }
    mut dk := 0
    while dk < 64 {
        mut dn := 0
        while dn < 64 { ptr_write_f64(dct_cos, dk * 64 + dn, num_cos(num_pi() / 64.0 * ((dn as f64) + 0.5) * (dk as f64))); dn += 1 }
        dk += 1
    }
    fir_x := mem_alloc_aligned(131136 * 8 + 64); fir_h := mem_alloc_aligned(64 * 8 + 64)
    i = 0; while i < 131136 { ptr_write_f64(fir_x, i, ((i & 63) as f64) * 0.03 - 1.0); i += 1 }
    i = 0; while i < 64 { mut df := i - 32; if df < 0 { df = 0 - df }; ptr_write_f64(fir_h, i, 1.0 / (1.0 + (df as f64))); i += 1 }
    gl_x := mem_alloc_aligned(64); gl_w := mem_alloc_aligned(64)
    ptr_write_f64(gl_x, 0, 0.09501250983763744); ptr_write_f64(gl_x, 1, 0.28160355077925891)
    ptr_write_f64(gl_x, 2, 0.45801677765722738); ptr_write_f64(gl_x, 3, 0.61787624440264375)
    ptr_write_f64(gl_x, 4, 0.75540440835500303); ptr_write_f64(gl_x, 5, 0.86563120238783174)
    ptr_write_f64(gl_x, 6, 0.94457502307323258); ptr_write_f64(gl_x, 7, 0.98940093499164993)
    ptr_write_f64(gl_w, 0, 0.18945061045506850); ptr_write_f64(gl_w, 1, 0.18260341504492359)
    ptr_write_f64(gl_w, 2, 0.16915651939500254); ptr_write_f64(gl_w, 3, 0.14959598881657673)
    ptr_write_f64(gl_w, 4, 0.12462897125553387); ptr_write_f64(gl_w, 5, 0.09515851168249278)
    ptr_write_f64(gl_w, 6, 0.06225352393864789); ptr_write_f64(gl_w, 7, 0.02715245941175409)
    img_256 := mem_alloc_aligned(256 * 256 * 8 + 64)
    i = 0; while i < 65536 { ptr_write_f64(img_256, i, ((i & 127) as f64) * 0.02); i += 1 }

    // D8 Physics/Graphics inputs
    nb_buf := mem_alloc_aligned(96 * 10 * 8 + 20480)
    sph_buf := mem_alloc_aligned(1024)
