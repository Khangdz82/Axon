        buf_push_str(ub, "&b="); buf_push_str(ub, str_from_i64((i * 13) % 5000))
        buf_push_str(ub, "&c="); buf_push_str(ub, str_from_i64((i * 7) % 999)); buf_push(ub, 10)
        i += 1
    }
    url_p := (ub as i64) + 16; url_n := buf_len(ub)

    // D4 DS inputs
    orig_sort := ibuf_new(48008); work_sort := ibuf_new(48008)
    mut s_rng := 0x123456789ABCDEF0; i = 0
    while i < 48000 { s_rng = s_rng *% 6364136223846793005 +% 1442695040888963407; ibuf_push(orig_sort, ushr64(s_rng, 1)); i += 1 }
    sorted_64k := mem_alloc_aligned(65536 * 8 + 64); bsearch_q := mem_alloc_aligned(80000 * 8 + 64)
    i = 0; while i < 65536 { ptr_write_i64(sorted_64k, i, i * 3 + 1); i += 1 }
    i = 0; while i < 80000 { ptr_write_i64(bsearch_q, i, ((i *% 37 +% 11) & 65535) * 3 + (i & 3)); i += 1 }
    topk_500k := mem_alloc_aligned(500000 * 8 + 64); topk_dst := mem_alloc_aligned(500000 * 8 + 64)
    i = 0; while i < 500000 { ptr_write_i64(topk_500k, i, ((i *% 2654435761) ^ ushr64(i, 3)) & 0x7FFFFFFF); i += 1 }
    bs_a := mem_alloc_aligned(65536 * 8 + 64); bs_b := mem_alloc_aligned(65536 * 8 + 64); bs_c := mem_alloc_aligned(65536 * 8 + 64)
    i = 0
    while i < 65536 {
        ptr_write_i64(bs_a, i, i *% 0x9E3779B97F4A7C15)
        ptr_write_i64(bs_b, i, i *% 0xBF58476D1CE4E5B9)
        ptr_write_i64(bs_c, i, i *% 0x94D049BB133111EB)
        i += 1
    }
    bloom_bits := mem_alloc_aligned(1024 * 8 + 64); mem_set(bloom_bits, 0, 1024 * 8)
    i = 0
    while i < 8000 {
        h1 := i *% 0x9E3779B97F4A7C15; h2 := (h1 ^ ushr64(h1, 30)) *% 0xBF58476D1CE4E5B9
        k0 := h1 & 65535; k1 := h2 & 65535; k2 := (h1 +% h2) & 65535
        ptr_write_i64(bloom_bits, ushr64(k0, 6), ptr_read_i64(bloom_bits, ushr64(k0, 6)) | (1 << (k0 & 63)))
        ptr_write_i64(bloom_bits, ushr64(k1, 6), ptr_read_i64(bloom_bits, ushr64(k1, 6)) | (1 << (k1 & 63)))
        ptr_write_i64(bloom_bits, ushr64(k2, 6), ptr_read_i64(bloom_bits, ushr64(k2, 6)) | (1 << (k2 & 63)))
        i += 1
    }
    bloom_q := mem_alloc_aligned(200000 * 8 + 64)
    i = 0; while i < 200000 { ptr_write_i64(bloom_q, i, i & 16383); i += 1 }

    // D5 Graph & DP inputs
    mut g6k := graph_new(6000, 36000)
    i = 0
    while i < 6000 {
        mut e := 0
        while e < 6 { graph_add_edge(mut g6k, i, (i * 31 + e * 97 + 13) % 6000, 1 + ((i + e * 7) % 100)); e += 1 }
        i += 1
    }
    bfs_rp := mem_alloc_aligned(16008 * 4); bfs_ci := mem_alloc_aligned(64008 * 4)
    bfs_dist := mem_alloc_aligned(32008 * 4); bfs_q := mem_alloc_aligned(32008 * 4)
    i = 0
    while i < 16000 {
        _w32(bfs_rp, i, i * 4)
        mut e := 0; while e < 4 { _w32(bfs_ci, i * 4 + e, (i * 13 + e * 47 + 7) % 16000); e += 1 }
        i += 1
    }
    _w32(bfs_rp, 16000, 64000)

    dag_rp := mem_alloc_aligned(32008 * 4); dag_ci := mem_alloc_aligned(128008 * 4)
    mut de := 0; i = 0
    while i < 32000 {
        _w32(dag_rp, i, de)
