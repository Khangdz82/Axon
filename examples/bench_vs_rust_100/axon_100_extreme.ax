fn b031_sort_i64(orig: IntBuf, work: IntBuf, n: i64) -> i64 {
    unsafe {
        mem_copy((work as i64) + 16, (orig as i64) + 16, n * 8)
        ptr_write_i64(work as i64, 0, n)
    }
    sort_i64(work)
    return ibuf_get(work, 0) ^ ibuf_get(work, n / 4) ^ ibuf_get(work, n / 2) ^ ibuf_get(work, (n * 3) / 4) ^ ibuf_get(work, n - 1)
}

fn b032_hashmap(n: i64) -> i64 {
    mut m := dmap_new(64)
    mut i := 0
    while i < n { dmap_put(mut m, i * 13 + 7, i * 3 + 1); i += 1 }
    mut acc := 0; i = 0
    while i < n { acc = acc +% dmap_get(m, i * 13 + 7, 0); i += 1 }
    dmap_free(move m)
    return acc
}

fn b033_spsc_ring(total: i64) -> i64 {
    r := spsc_new(1024)
    unsafe {
        bp := r.base_ptr
        data := bp + 128
        total_pad := (total + 255) & (-256)
        mut acc := 0; mut base := 0
        while base < total_pad {
            h := ptr_read_i64(bp, 0)
            t := atomic_load_i64(bp, 8)
            mut n := 1024 - (h - t)
            if base + n > total_pad { n = total_pad - base }
            pos := h & 1023
            _ := avx_iota_i64(data + (pos << 3), base, n)
            atomic_store_rel_i64(bp, 0, h +% n)
            t2 := ptr_read_i64(bp, 8)
            h2 := atomic_load_i64(bp, 0)
            got := h2 - t2
            p2 := t2 & 1023
            acc = acc +% avx_prefix_sum_i64(data + (p2 << 3), 0, got, 0)
            atomic_store_rel_i64(bp, 8, t2 +% got)
            base += n
        }
        spsc_free(move r)
        return acc
    }
}

