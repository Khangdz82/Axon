        while e < 8 {
            c0 := (i * 13 + e * 97 + 7) % sp_n
            c1 := (i * 13 + (e + 1) * 97 + 7) % sp_n
            ptr_write_i64(sp_ci, (i * 8 + e) >> 1, c0 | (c1 << 32))
            ptr_write_f64(sp_val, i * 8 + e, 0.1 + (e as f64) * 0.05)
            ptr_write_f64(sp_val, i * 8 + e + 1, 0.1 + ((e + 1) as f64) * 0.05)
            e += 2
        }
        i += 1
    }
