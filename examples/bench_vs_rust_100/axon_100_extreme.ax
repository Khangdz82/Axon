    b512k := mem_alloc_aligned(524288 + 64)
    b64_enc := mem_alloc_aligned(700000 + 64); b64_dec := mem_alloc_aligned(524288 + 64)
    b64_etbl := mem_alloc_aligned(64); b64_dtbl := mem_alloc_aligned(256); mem_set(b64_dtbl, 0, 256)
    i = 0; while i < 26 { ptr_write_u8(b64_etbl, i, 65 + i); ptr_write_u8(b64_dtbl, 65 + i, i); i += 1 }
    i = 0; while i < 26 { ptr_write_u8(b64_etbl, 26 + i, 97 + i); ptr_write_u8(b64_dtbl, 97 + i, 26 + i); i += 1 }
    i = 0; while i < 10 { ptr_write_u8(b64_etbl, 52 + i, 48 + i); ptr_write_u8(b64_dtbl, 48 + i, 52 + i); i += 1 }
    ptr_write_u8(b64_etbl, 62, 43); ptr_write_u8(b64_dtbl, 43, 62); ptr_write_u8(b64_etbl, 63, 47); ptr_write_u8(b64_dtbl, 47, 63)
    i = 0; while i < 524288 { ptr_write_u8(b512k, i, (i * 37 + 11) & 255); i += 1 }

