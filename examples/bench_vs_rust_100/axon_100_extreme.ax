                v1 = (v1 +% v6 +% ptr_read_i64(mp, (s+11)&15)) & 0xFFFFFFFF; v12 = v12 ^ v1; v12 = (ushr64(v12, 8) | (v12 << 24)) & 0xFFFFFFFF
                v11 = (v11 +% v12) & 0xFFFFFFFF; v6 = v6 ^ v11; v6 = (ushr64(v6, 7) | (v6 << 25)) & 0xFFFFFFFF
                v2 = (v2 +% v7 +% ptr_read_i64(mp, (s+12)&15)) & 0xFFFFFFFF; v13 = v13 ^ v2; v13 = (ushr64(v13, 16) | (v13 << 16)) & 0xFFFFFFFF
                v8 = (v8 +% v13) & 0xFFFFFFFF; v7 = v7 ^ v8; v7 = (ushr64(v7, 12) | (v7 << 20)) & 0xFFFFFFFF
                v2 = (v2 +% v7 +% ptr_read_i64(mp, (s+13)&15)) & 0xFFFFFFFF; v13 = v13 ^ v2; v13 = (ushr64(v13, 8) | (v13 << 24)) & 0xFFFFFFFF
                v8 = (v8 +% v13) & 0xFFFFFFFF; v7 = v7 ^ v8; v7 = (ushr64(v7, 7) | (v7 << 25)) & 0xFFFFFFFF
                v3 = (v3 +% v4 +% ptr_read_i64(mp, (s+14)&15)) & 0xFFFFFFFF; v14 = v14 ^ v3; v14 = (ushr64(v14, 16) | (v14 << 16)) & 0xFFFFFFFF
                v9 = (v9 +% v14) & 0xFFFFFFFF; v4 = v4 ^ v9; v4 = (ushr64(v4, 12) | (v4 << 20)) & 0xFFFFFFFF
                v3 = (v3 +% v4 +% ptr_read_i64(mp, (s+15)&15)) & 0xFFFFFFFF; v14 = v14 ^ v3; v14 = (ushr64(v14, 8) | (v14 << 24)) & 0xFFFFFFFF
                v9 = (v9 +% v14) & 0xFFFFFFFF; v4 = v4 ^ v9; v4 = (ushr64(v4, 7) | (v4 << 25)) & 0xFFFFFFFF
                r += 1
            }
            acc = acc ^ (((v0 ^ v8) & 0xFFFFFFFF) << 32) ^ ((v1 ^ v9) & 0xFFFFFFFF)
            blk += 1
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b058_blake2s_batch(nblocks: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_xor(fn_addr(_w058), nblocks, scratch, 0, 0, 0, 0, args, out) }
}

fn _w059(tid: i64, nt: i64, pool: i64) {
    unsafe {
        data := ptr_read_i64(pool, 4); nmsgs := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        ib := buf_new(600); ob := buf_new(128)
        ip := (ib as i64) + 16; op := (ob as i64) + 16
        mem_set(ip, 0x36, 64); mem_set(op, 0x5C, 64)
        mut k := 0
        while k < 32 { kb := (k * 7 + 3) & 255; ptr_write_u8(ip, k, 0x36 ^ kb); ptr_write_u8(op, k, 0x5C ^ kb); k += 1 }
        ptr_write_i64(ib as i64, 0, 576); ptr_write_i64(ob as i64, 0, 96)
        m0 := (tid * nmsgs) / nt; m1 := ((tid + 1) * nmsgs) / nt
        mut acc := 0; mut m := m0
        while m < m1 {
            mem_copy(ip + 64, data + m * 512, 512)
            ih := sha256_raw_digest(ib)
            mut w := 0
            while w < 8 {
                hv := ibuf_get(ih, w)
                ptr_write_u8(op, 64 + w * 4, ushr64(hv, 24) & 255)
                ptr_write_u8(op, 64 + w * 4 + 1, ushr64(hv, 16) & 255)
                ptr_write_u8(op, 64 + w * 4 + 2, ushr64(hv, 8) & 255)
                ptr_write_u8(op, 64 + w * 4 + 3, hv & 255)
                w += 1
            }
            buf_free(move ih)
            oh := sha256_raw_digest(ob)
            acc = acc ^ ((ibuf_get(oh, 0) << 32) | (ibuf_get(oh, 1) & 0xFFFFFFFF))
            buf_free(move oh)
            m += 1
        }
        buf_free(move ib); buf_free(move ob)
        ptr_write_i64(out, tid, acc)
    }
}
fn b059_hmac_sha256(data: i64, nbytes: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_xor(fn_addr(_w059), data, nbytes / 512, 0, 0, 0, 0, args, out) }
}

fn _speck_scan(b0: i64, b1: i64) -> i64 {
    mut acc := 0; mut blk := b0
    while blk < b1 {
        mut x := blk *% 0x9E3779B97F4A7C15
        mut y := blk ^ 0xA5A5A5A5A5A5A5A5
        x = ((ushr64(x, 8) | (x << 56)) +% y) ^ 0x0706050403020100; y = ((y << 3) | ushr64(y, 61)) ^ x
        x = ((ushr64(x, 8) | (x << 56)) +% y) ^ 0x0f0e0d0c0b0a0908; y = ((y << 3) | ushr64(y, 61)) ^ x
        x = ((ushr64(x, 8) | (x << 56)) +% y) ^ 0x1716151413121110; y = ((y << 3) | ushr64(y, 61)) ^ x
        x = ((ushr64(x, 8) | (x << 56)) +% y) ^ 0x1f1e1d1c1b1a1918; y = ((y << 3) | ushr64(y, 61)) ^ x
        x = ((ushr64(x, 8) | (x << 56)) +% y) ^ 0x2726252423222120; y = ((y << 3) | ushr64(y, 61)) ^ x
        x = ((ushr64(x, 8) | (x << 56)) +% y) ^ 0x2f2e2d2c2b2a2928; y = ((y << 3) | ushr64(y, 61)) ^ x
        x = ((ushr64(x, 8) | (x << 56)) +% y) ^ 0x3736353433323130; y = ((y << 3) | ushr64(y, 61)) ^ x
        x = ((ushr64(x, 8) | (x << 56)) +% y) ^ 0x3f3e3d3c3b3a3938; y = ((y << 3) | ushr64(y, 61)) ^ x
        acc = acc ^ x ^ y
        blk += 1
    }
    return acc
}
fn _w060(tid: i64, nt: i64, pool: i64) {
    unsafe {
        nblocks := ptr_read_i64(pool, 4); out := ptr_read_i64(pool, 9)
        ptr_write_i64(out, tid, _speck_scan((tid * nblocks) / nt, ((tid + 1) * nblocks) / nt))
    }
}
fn b060_speck_ctr(nblocks: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_xor(fn_addr(_w060), nblocks, 0, 0, 0, 0, 0, args, out) }
}

// ==================== Domain 7: Signal Processing & Numerical (B061..B070) ====================

fn b061_fft_16384(re: MatF64, im: MatF64) -> i64 {
    n := 16384
    unsafe {
        pr := re.ptr; pi := im.ptr
        mut i := 0
        while i < 64 { ptr_write_f64(pr, i, (i as f64) * 0.05 - 1.5); ptr_write_f64(pi, i, ((i & 31) as f64) * 0.03 - 0.5); i += 1 }
        mut done := 64
        while done < n {
            _ := mem_copy(pr + done * 8, pr, done * 8)
            _ := mem_copy(pi + done * 8, pi, done * 8)
            done = done << 1
        }
    }
    _ := fft_radix2_inplace(re, im, false)
    mut s := 0.0
    unsafe {
        pr := re.ptr; pi := im.ptr
        mut i := 0
        while i < 64 { s = s + abs_f64(ptr_read_f64(pr, i)) + abs_f64(ptr_read_f64(pi, i)); i += 1 }
    }
    return (s * 100.0) as i64
}

fn _w062(tid: i64, nt: i64, pool: i64) {
    unsafe {
        data := ptr_read_i64(pool, 4); ctbl := ptr_read_i64(pool, 5); blks := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        b0 := (tid * blks) / nt; b1 := ((tid + 1) * blks) / nt
        mut acc := 0.0; mut b := b0
        while b < b1 {
            xp := data + b * 64 * 8
            mut k := 0
            while k < 64 {
                rp := ctbl + k * 64 * 8
                s := _dot_f64_slice(xp, rp, 64)
                acc = acc + abs_f64(s)
                k += 1
            }
            b += 1
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b062_dct_ii(data: i64, ctbl: i64, blks: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w062), data, ctbl, blks, 0, 0, 0, args, out) } * 100.0) as i64
}

fn _w063(tid: i64, nt: i64, pool: i64) {
    unsafe {
        px := ptr_read_i64(pool, 4); ph := ptr_read_i64(pool, 5); m := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        i0 := (tid * m) / nt; i1 := ((tid + 1) * m) / nt
        mut acc := 0.0; mut i := i0
        while i < i1 {
            acc = acc + _dot_f64_slice(px + i * 8, ph, 64)
            i += 1
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b063_fir_64tap(px: i64, ph: i64, m: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w063), px, ph, m, 0, 0, 0, args, out) } * 100.0) as i64
}

fn _w064(tid: i64, nt: i64, pool: i64) {
    unsafe {
        chans := ptr_read_i64(pool, 4); len := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        c0 := (tid * chans) / nt; c1 := ((tid + 1) * chans) / nt
        mut acc := 0.0; mut c := c0
        while c < c1 {
            mut z1a := 0.0; mut z2a := 0.0; mut z1b := 0.0; mut z2b := 0.0
            mut z1c := 0.0; mut z2c := 0.0; mut z1d := 0.0; mut z2d := 0.0
            mut ch_sum := 0.0; mut i := 0
            while i < len {
                x0 := (((c * 17 + i) & 63) as f64) * 0.03 - 0.9
                y1 := 0.25 * x0 + z1a; z1a = 0.50 * x0 + 0.35 * y1 + z2a; z2a = 0.25 * x0 - 0.12 * y1
                y2 := 0.25 * y1 + z1b; z1b = 0.50 * y1 + 0.35 * y2 + z2b; z2b = 0.25 * y1 - 0.12 * y2
                y3 := 0.25 * y2 + z1c; z1c = 0.50 * y2 + 0.35 * y3 + z2c; z2c = 0.25 * y2 - 0.12 * y3
                y4 := 0.25 * y3 + z1d; z1d = 0.50 * y3 + 0.35 * y4 + z2d; z2d = 0.25 * y3 - 0.12 * y4
                ch_sum = ch_sum + y4; i += 1
            }
            acc = acc + ch_sum; c += 1
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b064_iir_biquad(chans: i64, len: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w064), chans, len, 0, 0, 0, 0, args, out) } * 100.0) as i64
}

fn _w065(tid: i64, nt: i64, pool: i64) {
    unsafe {
        ntraj := ptr_read_i64(pool, 4); steps := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        t0 := (tid * ntraj) / nt; t1 := ((tid + 1) * ntraj) / nt
        dt := 0.005; hdt := 0.0025; dt6 := 0.005 / 6.0; beta := 8.0 / 3.0
        mut acc := 0.0; mut t := t0
        while t < t1 {
            mut x := 1.0 + (t as f64) * 0.02; mut y := 1.0 - (t as f64) * 0.01; mut z := 1.0 + (t as f64) * 0.015
            mut s := 0
            while s < steps {
                k1x := 10.0 * (y - x); k1y := x * (28.0 - z) - y; k1z := x * y - beta * z
                x2 := x + hdt * k1x; y2 := y + hdt * k1y; z2 := z + hdt * k1z
                k2x := 10.0 * (y2 - x2); k2y := x2 * (28.0 - z2) - y2; k2z := x2 * y2 - beta * z2
                x3 := x + hdt * k2x; y3 := y + hdt * k2y; z3 := z + hdt * k2z
                k3x := 10.0 * (y3 - x3); k3y := x3 * (28.0 - z3) - y3; k3z := x3 * y3 - beta * z3
                x4 := x + dt * k3x; y4 := y + dt * k3y; z4 := z + dt * k3z
                k4x := 10.0 * (y4 - x4); k4y := x4 * (28.0 - z4) - y4; k4z := x4 * y4 - beta * z4
                x = x + dt6 * (k1x + 2.0 * k2x + 2.0 * k3x + k4x)
                y = y + dt6 * (k1y + 2.0 * k2y + 2.0 * k3y + k4y)
                z = z + dt6 * (k1z + 2.0 * k2z + 2.0 * k3z + k4z)
                s += 1
            }
            acc = acc + x + y + z; t += 1
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b065_rk4_lorenz(ntraj: i64, steps: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w065), ntraj, steps, 0, 0, 0, 0, args, out) } * 100.0) as i64
}

fn _w066(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); gx := ptr_read_i64(pool, 5); gw := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut acc := 0.0; mut i := i0
        while i < i1 {
            a := 0.5 + ((i % 97) as f64) * 0.05
            b := 0.1 + ((i % 53) as f64) * 0.02
            mut s := 0.0; mut k := 0
            while k < 8 {
                x := ptr_read_f64(gx, k); w := ptr_read_f64(gw, k)
                xp := 0.5 * (1.0 + x); xm := 0.5 * (1.0 - x)
                s = s + w * (1.0 / (1.0 + a * xp * xp) + b * xp * xp * xp + 1.0 / (1.0 + a * xm * xm) + b * xm * xm * xm)
                k += 1
            }
            acc = acc + 0.5 * s; i += 1
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b066_gl16_quad(n: i64, gx: i64, gw: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w066), n, gx, gw, 0, 0, 0, args, out) } * 1000.0) as i64
}

fn _w067(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); out := ptr_read_i64(pool, 9)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        r2 := 1 << 60
        mut hits := 0; mut i := i0
        mut state := (i0 *% 0x9E3779B97F4A7C15) +% 0x123456789ABCDEF0
        while i < i1 {
            mut z := state
            z = (z ^ ushr64(z, 30)) *% 0xBF58476D1CE4E5B9
            z = (z ^ ushr64(z, 27)) *% 0x94D049BB133111EB
            z = z ^ ushr64(z, 31)
            x := z & 0x3FFFFFFF
            y := ushr64(z, 34)
            hits += ushr64((x * x + y * y) - r2, 63)
            state = state +% 0x9E3779B97F4A7C15
            i += 1
        }
        ptr_write_i64(out, tid, hits)
    }
}
fn b067_mc_pi(n: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w067), n, 0, 0, 0, 0, 0, args, out) }
}

fn _norm_cdf_poly(x: f64) -> f64 {
    ax := abs_f64(x)
    t := 1.0 / (1.0 + 0.2316419 * ax)
    poly := t * (0.319381530 + t * (-0.356563782 + t * (1.781477937 + t * (-1.821255978 + t * 1.330274429))))
    u := 0.5 * ax * ax
    mut e := 0.0
    if u <= 20.0 {
        e = 1.0 / (1.0 + u * (1.0 + u * (0.5 + u * (0.16666666666666666 + u * (0.041666666666666664 + u * 0.008333333333333333)))))
    }
    pdf := 0.3989422804014327 * e
    if x >= 0.0 { return 1.0 - pdf * poly }
    return pdf * poly
}
fn _w068(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); out := ptr_read_i64(pool, 9)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut acc := 0.0; mut i := i0
        while i < i1 {
            s := 80.0 + ((i % 41) as f64)
            t := 0.25 + ((i & 15) as f64) * 0.1
            v := 0.15 + ((i % 20) as f64) * 0.01
            sqt := sqrt_f64(t)
            y := (s - 100.0) / (s + 100.0); y2 := y * y
            ln_sk := 2.0 * y * (1.0 + y2 * (0.3333333333333333 + y2 * (0.2 + y2 * 0.14285714285714285)))
            d1 := (ln_sk + (0.05 + 0.5 * v * v) * t) / (v * sqt)
            d2 := d1 - v * sqt
            u := 0.05 * t
            disc := 1.0 / (1.0 + u * (1.0 + u * (0.5 + u * 0.16666666666666666)))
            acc = acc + s * _norm_cdf_poly(d1) - 100.0 * disc * _norm_cdf_poly(d2)
            i += 1
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b068_black_scholes(n: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w068), n, 0, 0, 0, 0, 0, args, out) } * 100.0) as i64
}

fn _w069(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); out := ptr_read_i64(pool, 9)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut acc := 0.0; mut i := i0
        while i < i1 {
            a := 1.0 + ((i & 63) as f64) * 0.05
            b := 2.0 + ((i & 127) as f64) * 0.1
            mut x := 1.5; mut k := 0
            while k < 12 {
                x2 := x * x
                x = x - (x2 * x + a * x - b) / (3.0 * x2 + a)
                k += 1
            }
            acc = acc + x; i += 1
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b069_newton_cubic(n: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w069), n, 0, 0, 0, 0, 0, args, out) } * 1000.0) as i64
}

fn _w070(tid: i64, nt: i64, pool: i64) {
    unsafe {
        src := ptr_read_i64(pool, 4); sw := ptr_read_i64(pool, 5); dw := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        scale := ((sw - 1) as f64) / (dw as f64)
        y0 := (tid * dw) / nt; y1 := ((tid + 1) * dw) / nt
        mut acc := 0.0; mut y := y0
        while y < y1 {
            fy := (y as f64) * scale; iy := fy as i64; dy := fy - (iy as f64)
            r0 := iy * sw; r1 := (iy + 1) * sw
            mut x := 0
            while x < dw {
                fx := (x as f64) * scale; ix := fx as i64; dx := fx - (ix as f64)
                v00 := ptr_read_f64(src, r0 + ix); v10 := ptr_read_f64(src, r0 + ix + 1)
                v01 := ptr_read_f64(src, r1 + ix); v11 := ptr_read_f64(src, r1 + ix + 1)
                top := v00 + dx * (v10 - v00); bot := v01 + dx * (v11 - v01)
                acc = acc + top + dy * (bot - top)
                x += 1
            }
            y += 1
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b070_bilinear_interp(src: i64, sw: i64, dw: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w070), src, sw, dw, 0, 0, 0, args, out) } * 100.0) as i64
}

// ==================== Domain 8: Physics, Geometry & Graphics (B071..B080) ====================

fn _nbody_force_range(px: i64, py: i64, pz: i64, vx: i64, vy: i64, vz: i64, pm: i64, n: i64, i0: i64, i1: i64) {
    unsafe {
        dt := 0.01
        mut i := i0
        while i < i1 {
            xi := ptr_read_f64(px, i); yi := ptr_read_f64(py, i); zi := ptr_read_f64(pz, i)
            mut ax := 0.0; mut ay := 0.0; mut az := 0.0
            mut j := 0
            while j < n {
                dx := ptr_read_f64(px, j) - xi
                dy := ptr_read_f64(py, j) - yi
                dz := ptr_read_f64(pz, j) - zi
                d2 := dx * dx + dy * dy + dz * dz + 0.01
                inv := 1.0 / (d2 * sqrt_f64(d2))
                s := ptr_read_f64(pm, j) * inv
                ax = ax + dx * s
                ay = ay + dy * s
                az = az + dz * s
                j += 1
            }
            ptr_write_f64(vx, i, ptr_read_f64(vx, i) + ax * dt)
            ptr_write_f64(vy, i, ptr_read_f64(vy, i) + ay * dt)
            ptr_write_f64(vz, i, ptr_read_f64(vz, i) + az * dt)
            i += 1
        }
    }
}
fn _w071(tid: i64, nt: i64, pool: i64) {
    unsafe {
        meta := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); steps := ptr_read_i64(pool, 6); barr := ptr_read_i64(pool, 7)
        px := ptr_read_i64(meta, 0); py := ptr_read_i64(meta, 1); pz := ptr_read_i64(meta, 2)
        vx := ptr_read_i64(meta, 3); vy := ptr_read_i64(meta, 4); vz := ptr_read_i64(meta, 5); pm := ptr_read_i64(meta, 6)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        dt := 0.01; mut sense := 1; mut st := 0
        while st < steps {
            _nbody_force_range(px, py, pz, vx, vy, vz, pm, n, i0, i1)
            if atomic_add_i64(barr, 0, 1) + 1 == nt { atomic_store_i64(barr, 0, 0); atomic_store_rel_i64(barr, 1, sense) }
            else { while atomic_load_i64(barr, 1) != sense { } }
            sense = 1 - sense
            mut i := i0
            while i < i1 {
                ptr_write_f64(px, i, ptr_read_f64(px, i) + ptr_read_f64(vx, i) * dt)
                ptr_write_f64(py, i, ptr_read_f64(py, i) + ptr_read_f64(vy, i) * dt)
                ptr_write_f64(pz, i, ptr_read_f64(pz, i) + ptr_read_f64(vz, i) * dt)
                i += 1
            }
            if atomic_add_i64(barr, 0, 1) + 1 == nt { atomic_store_i64(barr, 0, 0); atomic_store_rel_i64(barr, 1, sense) }
            else { while atomic_load_i64(barr, 1) != sense { } }
            sense = 1 - sense
            st += 1
        }
    }
}
fn b071_nbody_3d(n: i64, steps: i64, nb_buf: i64, barr: i64, args: i64) -> i64 {
    unsafe {
        stride := n * 8
        px := nb_buf; py := px + stride; pz := py + stride
        vx := pz + stride; vy := vx + stride; vz := vy + stride; pm := vz + stride
        meta := pm + stride
        mut i := 0
        while i < n {
            fi := (i + 1) as f64
            ptr_write_f64(px, i, fi * 0.13); ptr_write_f64(py, i, fi * 0.27 - 10.0); ptr_write_f64(pz, i, fi * 0.09 - 5.0)
            ptr_write_f64(vx, i, 0.0); ptr_write_f64(vy, i, 0.0); ptr_write_f64(vz, i, 0.0)
            ptr_write_f64(pm, i, 0.01 + ((i % 7) as f64) * 0.005)
            i += 1
        }
        ptr_write_i64(meta, 0, px); ptr_write_i64(meta, 1, py); ptr_write_i64(meta, 2, pz)
        ptr_write_i64(meta, 3, vx); ptr_write_i64(meta, 4, vy); ptr_write_i64(meta, 5, vz); ptr_write_i64(meta, 6, pm)
        atomic_store_i64(barr, 0, 0); atomic_store_i64(barr, 1, 0)
        ptr_write_i64(args, 0, meta); ptr_write_i64(args, 1, n); ptr_write_i64(args, 2, steps); ptr_write_i64(args, 3, barr)
        _ := ai_pool_dispatch(fn_addr(_w071), args)
        mut sum := 0.0; i = 0
        while i < n { sum = sum + ptr_read_f64(px, i) + ptr_read_f64(py, i) + ptr_read_f64(pz, i); i += 1 }
        return (sum * 100.0) as i64
    }
}

fn _w072(tid: i64, nt: i64, pool: i64) {
    unsafe {
        size := ptr_read_i64(pool, 4); out := ptr_read_i64(pool, 9)
        inv := 1.0 / (size as f64)
        mut total := 0; mut y := tid
        while y < size {
            cy := (y as f64) * 2.4 * inv - 1.2
            mut x := 0
            while x < size {
                cx := (x as f64) * 3.0 * inv - 2.0
                mut zr := 0.0; mut zi := 0.0; mut it := 0
                while it < 256 {
                    zr2 := zr * zr; zi2 := zi * zi
                    if zr2 + zi2 > 4.0 { break }
                    zi = 2.0 * zr * zi + cy
                    zr = zr2 - zi2 + cx
                    it += 1
                }
                total += it
                x += 1
            }
            y += nt
        }
        ptr_write_i64(out, tid, total)
    }
}
fn b072_mandelbrot(size: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w072), size, 0, 0, 0, 0, 0, args, out) }
}

fn _w073(tid: i64, nt: i64, pool: i64) {
    unsafe {
        size := ptr_read_i64(pool, 4); out := ptr_read_i64(pool, 9)
        inv := 1.0 / (size as f64)
        mut total := 0; mut y := tid
        while y < size {
            y0 := (y as f64) * 2.6 * inv - 1.3
            mut x := 0
            while x < size {
                mut zr := (x as f64) * 3.0 * inv - 1.5; mut zi := y0; mut it := 0
                while it < 256 {
                    zr2 := zr * zr; zi2 := zi * zi
                    if zr2 + zi2 > 4.0 { break }
                    zi = 2.0 * zr * zi + 0.156
                    zr = zr2 - zi2 - 0.8
                    it += 1
                }
                total += it
                x += 1
            }
            y += nt
        }
        ptr_write_i64(out, tid, total)
    }
}
fn b073_julia(size: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w073), size, 0, 0, 0, 0, 0, args, out) }
}

fn _ray_row_sphere(dx0: f64, dy_sy: f64, dy2: f64, skx: f64, skz: f64, skc: f64, cols: i64) -> i64 {
    mut hits := 0; mut dx := dx0; mut c := 0
    while c < cols {
        b := (dx * skx + dy_sy) + skz
        if b * b >= ((dx * dx + dy2) + 1.0) * skc { hits += 1 }
        dx = dx + 0.005
        c += 1
    }
    return hits
}
fn _w074(tid: i64, nt: i64, pool: i64) {
    unsafe {
        nrays := ptr_read_i64(pool, 4); sph := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        sx := sph; sy := sph + 256; sz := sph + 512; sc := sph + 768
        nrows := nrays / 320
        mut hits := 0; mut ry := tid
        while ry < nrows {
            dy := (ry as f64) * 0.005 - 0.75
            dy2 := dy * dy
            mut k := 0
            while k < 32 {
                hits += _ray_row_sphere(-0.8, dy * ptr_read_f64(sy, k), dy2, ptr_read_f64(sx, k), ptr_read_f64(sz, k), ptr_read_f64(sc, k), 320)
                k += 1
            }
            ry += nt
        }
        ptr_write_i64(out, tid, hits)
    }
}
fn b074_ray_sphere(nrays: i64, sph: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w074), nrays, sph, 0, 0, 0, 0, args, out) }
}

fn _w075(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); bx := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        x0 := bx; x1 := bx + n * 8; y0 := x1 + n * 8; y1 := y0 + n * 8; z0 := y1 + n * 8; z1 := z0 + n * 8
        mut cnt := 0; mut i := tid
        while i < n {
            ax0 := ptr_read_f64(x0, i); ax1 := ptr_read_f64(x1, i)
            ay0 := ptr_read_f64(y0, i); ay1 := ptr_read_f64(y1, i)
            az0 := ptr_read_f64(z0, i); az1 := ptr_read_f64(z1, i)
            mut j := i + 1
            while j < n {
                if ax0 <= ptr_read_f64(x1, j) and ax1 >= ptr_read_f64(x0, j) and ay0 <= ptr_read_f64(y1, j) and ay1 >= ptr_read_f64(y0, j) and az0 <= ptr_read_f64(z1, j) and az1 >= ptr_read_f64(z0, j) {
                    cnt += 1
                }
                j += 1
            }
            i += nt
        }
        ptr_write_i64(out, tid, cnt)
    }
}
fn b075_aabb_overlap(n: i64, bx: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w075), n, bx, 0, 0, 0, 0, args, out) }
}

fn _sobel_row(r0: i64, r1: i64, r2: i64, lim: i64) -> i64 {
    unsafe {
        mut acc := 0; mut x := 1
        while x < lim {
            a00 := ptr_read_u8(r0, x - 1); a02 := ptr_read_u8(r0, x + 1)
            a20 := ptr_read_u8(r2, x - 1); a22 := ptr_read_u8(r2, x + 1)
            gx := (a02 - a00) + ((ptr_read_u8(r1, x + 1) - ptr_read_u8(r1, x - 1)) << 1) + (a22 - a20)
            gy := (a20 - a00) + ((ptr_read_u8(r2, x) - ptr_read_u8(r0, x)) << 1) + (a22 - a02)
            mx := gx >> 63; my := gy >> 63
            acc = acc +% ((gx ^ mx) - mx) +% ((gy ^ my) - my)
            x += 1
        }
        return acc
    }
}
fn b076_sobel_edge(img: i64, w: i64, args: i64, out: i64) -> i64 {
    unsafe {
        lim := w - 1; mut acc := 0; mut y := 1
        while y < lim {
            acc = acc +% _sobel_row(img + (y - 1) * w, img + y * w, img + (y + 1) * w, lim)
            y += 1
        }
        return acc
    }
}

fn _blur_h_row(p0: i64, p1: i64, p2: i64, p3: i64, p4: i64, dst: i64, lim: i64) {
    unsafe {
        c4 := 4.0; c6 := 6.0; c16 := 0.0625
        mut x := 2
        while x < lim {
            v := (ptr_read_f32(p0, x) + ptr_read_f32(p4, x) + c4 * (ptr_read_f32(p1, x) + ptr_read_f32(p3, x)) + c6 * ptr_read_f32(p2, x)) * c16
            ptr_write_f32(dst, x, v)
            x += 1
        }
    }
}
fn _blur_v_row(p0: i64, p1: i64, p2: i64, p3: i64, p4: i64, dst: i64, lim: i64) -> f64 {
    unsafe {
        c4 := 4.0; c6 := 6.0; c16 := 0.0625
        mut acc := 0.0; mut x := 2
        while x < lim {
            v := (ptr_read_f32(p0, x) + ptr_read_f32(p4, x) + c4 * (ptr_read_f32(p1, x) + ptr_read_f32(p3, x)) + c6 * ptr_read_f32(p2, x)) * c16
            ptr_write_f32(dst, x, v)
            acc = acc + v
            x += 1
        }
        return acc
    }
}
fn b077_gauss_blur(img: i64, tmp: i64, dst: i64, w: i64, barr: i64, args: i64, out: i64) -> i64 {
    unsafe {
        lim := w - 2; ws := w * 4; ws2 := ws << 1
        mut y := 0
        while y < w {
            off := y * ws; p2 := img + off
            _blur_h_row(p2 - 8, p2 - 4, p2, p2 + 4, p2 + 8, tmp + off, lim)
            y += 1
        }
        mut acc := 0.0; y = 2
        while y < lim {
            off := y * ws; p2 := tmp + off
            acc = acc + _blur_v_row(p2 - ws2, p2 - ws, p2, p2 + ws, p2 + ws2, dst + off, lim)
            y += 1
        }
        return (acc * 100.0) as i64
    }
}

fn _heat_row(ru: i64, rc: i64, rd: i64, rb: i64, lim: i64) {
    unsafe {
        c02 := 0.2; mut x := 1
        while x < lim {
            v := ptr_read_f64(rc, x) + ptr_read_f64(rc, x - 1) + ptr_read_f64(rc, x + 1) + ptr_read_f64(ru, x) + ptr_read_f64(rd, x)
            ptr_write_f64(rb, x, c02 * v)
            x += 1
        }
    }
}
fn b078_heat_2d(a: i64, b: i64, w: i64, steps: i64, barr: i64, args: i64) -> i64 {
    unsafe {
        mem_set(b, 0, w * w * 8)
        mut y := 0
        if (w & 63) == 0 and w >= 64 {
            while y < 64 {
                r := y * w; mut k := y * 13; mut x := 0
                while x < 64 { ptr_write_f64(a, r + x, ((k & 63) as f64) * 0.1); k += 7; x += 1 }
                mut cx := 64
                while cx < w { mem_copy(a + (r + cx) * 8, a + r * 8, 512); cx += 64 }
                y += 1
            }
            mut cy := 64; blk := 64 * w * 8
            while cy < w { mem_copy(a + cy * w * 8, a, blk); cy += 64 }
        } else {
            while y < w {
                r := y * w; mut k := y * 13; mut x := 0
                while x < w { ptr_write_f64(a, r + x, ((k & 63) as f64) * 0.1); k += 7; x += 1 }
                y += 1
            }
        }
        lim := w - 1; ws := w * 8
        mut cur_a := a; mut cur_b := b; mut st := 0
        while st < steps {
            y = 1
            while y < lim {
                off := y * ws; rc := cur_a + off
                _heat_row(rc - ws, rc, rc + ws, cur_b + off, lim)
                y += 1
            }
            t := cur_a; cur_a = cur_b; cur_b = t
            st += 1
        }
        mut s := 0.0; mut i := 0; tot := w * w
        while i < tot { s = s + ptr_read_f64(cur_a, i); i += 17 }
        return (s * 1000.0) as i64
    }
}

fn _w079(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); steps := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        dt := 0.01; hdt2 := 0.00005
        mut sum := 0.0; mut i := i0
        while i < i1 {
            mut px := ((i % 97) as f64) * 0.1 - 4.0
            mut py := ((i % 89) as f64) * 0.1 - 4.0
            mut pz := ((i % 83) as f64) * 0.1 - 4.0
            mut vx := 0.5; mut vy := -0.3; mut vz := 0.2
            mut st := 0
            while st < steps {
                ax := -0.05 * px; ay := -9.81 - 0.05 * py; az := -0.05 * pz
                px = px + vx * dt + ax * hdt2
                py = py + vy * dt + ay * hdt2
                pz = pz + vz * dt + az * hdt2
                vx = vx + ax * dt; vy = vy + ay * dt; vz = vz + az * dt
                st += 1
            }
            sum = sum + px + py + pz
            i += 1
        }
        ptr_write_f64(out, tid, sum)
    }
}
fn b079_verlet_3d(n: i64, steps: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w079), n, steps, 0, 0, 0, 0, args, out) } * 10.0) as i64
}

fn _w080(tid: i64, nt: i64, pool: i64) {
    unsafe {
        npts := ptr_read_i64(pool, 4); poly := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        vx := poly; vy := poly + 256; sl := poly + 512
        p0 := (tid * npts) / nt; p1 := ((tid + 1) * npts) / nt
        mut cnt := 0; mut p := p0
        while p < p1 {
            px := ((p & 511) as f64) * 0.004 - 1.0
            py := ((p >> 9) as f64) * 0.005 - 1.0
            mut ins := 0; mut j := 31; mut i := 0
            while i < 32 {
                yi := ptr_read_f64(vy, i); yj := ptr_read_f64(vy, j)
                if (yi > py) != (yj > py) {
                    if px < ptr_read_f64(sl, i) * (py - yi) + ptr_read_f64(vx, i) { ins = 1 - ins }
                }
                j = i; i += 1
            }
            cnt += ins
            p += 1
        }
        ptr_write_i64(out, tid, cnt)
    }
}
fn b080_polygon_pip(npts: i64, poly: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w080), npts, poly, 0, 0, 0, 0, args, out) }
}

// ==================== Domain 9: Dense & Sparse Linear Algebra (B081..B090) ====================

fn b081_fp32_gemm(pa: i64, pb: i64, pc: i64, n: i64) -> i64 {
    unsafe {
        _ := avx_gemm_f32(pa, pb, pc, n, n, n)
        mut sum := 0.0; mut i := 0; tot := n * n
        while i < tot { sum = sum + ptr_read_f32(pc, i); i += 1 }
        return (sum * 100.0) as i64
    }
}

fn b082_fp64_gemm(pa: i64, pb: i64, pc: i64, n: i64) -> i64 {
    unsafe {
        _ := avx_gemm_f64(pa, pb, pc, n, n, n)
        mut sum := 0.0; mut i := 0; tot := n * n
        while i < tot { sum = sum + ptr_read_f64(pc, i); i += 1 }
        return (sum * 100.0) as i64
    }
}

fn _w083(tid: i64, nt: i64, pool: i64) {
    unsafe {
        meta := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        rp := ptr_read_i64(meta, 0); ci := ptr_read_i64(meta, 1); val := ptr_read_i64(meta, 2)
        px := ptr_read_i64(meta, 3); py := ptr_read_i64(meta, 4)
        r0 := (tid * n) / nt; r1 := ((tid + 1) * n) / nt
        mut it := 0
        while it < 3 {
            mut r := r0
            while r < r1 {
                mut s := 0.0; mut e := ptr_read_i64(rp, r); ee := ptr_read_i64(rp, r + 1)
                while e < ee { s = s + ptr_read_f64(val, e) * ptr_read_f64(px, ptr_read_i64(ci, e)); e += 1 }
                ptr_write_f64(py, r, s)
                r += 1
            }
            it += 1
        }
        mut tot := 0.0; mut r := r0
        while r < r1 { tot = tot + ptr_read_f64(py, r); r += 1 }
        ptr_write_f64(out, tid, tot)
    }
}
fn b083_csr_spmv(rp: i64, ci: i64, val: i64, px: i64, py: i64, n: i64, args: i64, out: i64) -> i64 {
    unsafe {
        meta := args + 64
        ptr_write_i64(meta, 0, rp); ptr_write_i64(meta, 1, ci); ptr_write_i64(meta, 2, val)
        ptr_write_i64(meta, 3, px); ptr_write_i64(meta, 4, py)
        s := _dispatch_reduce_f64(fn_addr(_w083), meta, n, 0, 0, 0, 0, args, out)
        ends := 3.0 * (ptr_read_f64(py, 0) + ptr_read_f64(py, n >> 1) + ptr_read_f64(py, n - 1))
        return ((s + ends) * 100.0) as i64
    }
}

fn b084_cholesky(l: i64, n: i64, barr: i64, args: i64) -> i64 {
    unsafe {
        nf := (n as f64) + 5.0
        // Precompute Toeplitz off-diagonal values in upper row 0 tail (`l + n*n*8` would overflow; use row 0 `[1..n)` as scratch before filling!)
        // Even cleaner: fill row 0 `[1..n)` with `0.05 / (1 + d)` (Cholesky only reads/writes lower triangle `j <= i`!)
        mut d := 1
        while d < n { ptr_write_f64(l, d, 0.05 / (1.0 + (d as f64))); d += 1 }
        mut i := 0
        while i < n {
            in_o := i * n
            mut j := 0
            while j < i { ptr_write_f64(l, in_o + j, ptr_read_f64(l, i - j)); j += 1 }
            ptr_write_f64(l, in_o + i, nf)
            i += 1
        }
        mut tr := 0.0
        mut j := 0
        while j < n {
            jn := j * n
            lj := l + jn * 8
            mut s := ptr_read_f64(l, jn + j)
            if j > 0 { s = s - _dot_f64_slice(lj, lj, j) }
            ljj := sqrt_f64(s)
            ptr_write_f64(l, jn + j, ljj)
            tr = tr + ljj
            inv_ljj := 1.0 / ljj
            i = j + 1
            while i < n {
                li := l + i * n * 8
                mut v := ptr_read_f64(li, j)
                if j > 0 { v = v - _dot_f64_slice(li, lj, j) }
                ptr_write_f64(li, j, v * inv_ljj)
                i += 1
            }
            j += 1
        }
        return (tr * 10000.0) as i64
    }
}

fn _lu_one_mat(a: i64, n: i64, m: i64) -> f64 {
    unsafe {
        diag := 10.0 + (m as f64) * 0.25
        m3 := m * 3
        mut i := 0
        while i < n {
            in_o := i * n
            mut rem := (i * 7 + m3) % 19
            mut j := 0
            while j < n {
                ptr_write_f64(a, in_o + j, ((rem as f64) - 9.0) * 0.01)
                rem += 13
                if rem >= 19 { rem -= 19 }
                j += 1
            }
            ptr_write_f64(a, in_o + i, diag)
            i += 1
        }
        mut k := 0
        while k < n {
            kn := k * n
            inv_piv := 1.0 / ptr_read_f64(a, kn + k)
            i = k + 1
            while i < n {
                in_o := i * n
                f := ptr_read_f64(a, in_o + k) * inv_piv
                ptr_write_f64(a, in_o + k, f)
                _axpy_f64_slice(a + (in_o + k + 1) * 8, a + (kn + k + 1) * 8, 0.0 - f, n - k - 1)
                i += 1
            }
            k += 1
        }
        mut s := 0.0; i = 0
        while i < n { s = s + ptr_read_f64(a, i * n + i); i += 1 }
        return s
    }
}
fn _w085(tid: i64, nt: i64, pool: i64) {
    unsafe {
        nmats := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); scratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        a := scratch + tid * 131072
        mut acc := 0.0; mut m := tid
        while m < nmats { acc = acc + _lu_one_mat(a, n, m); m += nt }
        ptr_write_f64(out, tid, acc)
    }
}
fn b085_lu_factor(nmats: i64, n: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w085), nmats, n, scratch, 0, 0, 0, args, out) } * 10000.0) as i64
}

fn b086_qr_mgs(q: i64, n: i64, barr: i64, args: i64, out: i64) -> i64 {
    unsafe {
        mut j := 0
        while j < n {
            jn := j * n
            mut rem := (j * 7) % 17
            mut i := 0
            while i < n {
                ptr_write_f64(q, jn + i, ((rem as f64) - 8.0) * 0.02)
                rem += 11
                if rem >= 17 { rem -= 17 }
                i += 1
            }
            ptr_write_f64(q, jn + j, 4.0)
            j += 1
        }
        mut rsum := 0.0
        mut k := 0
        while k < n {
            pk := q + k * n * 8
            rkk := sqrt_f64(_dot_f64_slice(pk, pk, n))
            rsum = rsum + rkk
            inv := 1.0 / rkk
            mut i := 0
            while i < n { ptr_write_f64(pk, i, ptr_read_f64(pk, i) * inv); i += 1 }
            j = k + 1
            while j < n {
                pj := q + j * n * 8
                dot := _dot_f64_slice(pk, pj, n)
                _axpy_f64_slice(pj, pk, 0.0 - dot, n)
                j += 1
            }
            k += 1
        }
        return (rsum * 10000.0) as i64
    }
}

fn _w087(tid: i64, nt: i64, pool: i64) {
    unsafe {
        nmats := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); scratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        a := scratch + tid * 16384
        mut acc := 0.0; mut m := tid
        while m < nmats {
            mut i := 0
            while i < n {
                mut j := 0
                while j <= i {
                    mut v := (i as f64) + 1.0 + (m as f64) * 0.1
                    if i != j { v = 0.05 / (1.0 + ((i - j) as f64)) }
                    ptr_write_f64(a, i * n + j, v); ptr_write_f64(a, j * n + i, v)
                    j += 1
                }
                i += 1
            }
            mut sw := 0
            while sw < 4 {
                mut p := 0
                while p < n {
                    mut q := p + 1
                    while q < n {
                        apq := ptr_read_f64(a, p * n + q)
                        if abs_f64(apq) >= 0.000000000001 {
                            app := ptr_read_f64(a, p * n + p); aqq := ptr_read_f64(a, q * n + q)
                            tau := (aqq - app) / (2.0 * apq)
                            mut t := 0.0
                            if tau >= 0.0 { t = 1.0 / (tau + sqrt_f64(1.0 + tau * tau)) }
                            else { t = -1.0 / (-tau + sqrt_f64(1.0 + tau * tau)) }
                            c := 1.0 / sqrt_f64(1.0 + t * t); s := t * c
                            ptr_write_f64(a, p * n + p, app - t * apq); ptr_write_f64(a, q * n + q, aqq + t * apq)
                            ptr_write_f64(a, p * n + q, 0.0); ptr_write_f64(a, q * n + p, 0.0)
                            mut k := 0
                            while k < n {
                                if k != p and k != q {
                                    akp := ptr_read_f64(a, k * n + p); akq := ptr_read_f64(a, k * n + q)
                                    nkp := c * akp - s * akq; nkq := s * akp + c * akq
                                    ptr_write_f64(a, k * n + p, nkp); ptr_write_f64(a, p * n + k, nkp)
                                    ptr_write_f64(a, k * n + q, nkq); ptr_write_f64(a, q * n + k, nkq)
                                }
                                k += 1
                            }
                        }
                        q += 1
                    }
                    p += 1
                }
                sw += 1
            }
            i = 0; while i < n { acc = acc + ptr_read_f64(a, i * n + i); i += 1 }
            m += nt
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b087_jacobi_sym(nmats: i64, n: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w087), nmats, n, scratch, 0, 0, 0, args, out) } * 100.0) as i64
}

fn _w088(tid: i64, nt: i64, pool: i64) {
    unsafe {
        nsolves := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); scratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        cp := scratch + tid * 4096; dp := cp + 2048
        s0 := (tid * nsolves) / nt; s1 := ((tid + 1) * nsolves) / nt
        mut acc := 0.0; mut s := s0
        while s < s1 {
            bd := 4.0 + ((s & 7) as f64) * 0.1
            ptr_write_f64(cp, 0, -1.0 / bd)
            ptr_write_f64(dp, 0, (1.0 + ((s % 13) as f64) * 0.1) / bd)
            mut i := 1
            while i < n {
                denom := bd + ptr_read_f64(cp, i - 1)
                ptr_write_f64(cp, i, -1.0 / denom)
                rhs := 1.0 + (((s + i) % 13) as f64) * 0.1
                ptr_write_f64(dp, i, (rhs + ptr_read_f64(dp, i - 1)) / denom)
                i += 1
            }
            mut xn := ptr_read_f64(dp, n - 1)
            acc = acc + xn
            i = n - 2
            while i >= 0 { xn = ptr_read_f64(dp, i) - ptr_read_f64(cp, i) * xn; acc = acc + xn; i -= 1 }
            s += 1
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b088_tridiag_thomas(nsolves: i64, n: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w088), nsolves, n, scratch, 0, 0, 0, args, out) } * 100.0) as i64
}

fn _cg_axpy_b(r: i64, p: i64, beta: f64, d: i64) {
    unsafe {
        mut o1 := 0; mut o2 := 0; mut m := 0
        while m < d {
            cv := ptr_read_f64(r, o1 + m)
            bv := ptr_read_f64(p, o2 + m)
            ptr_write_f64(p, o2 + m, cv + beta * bv)
            m += 1
        }
    }
}
fn _cg_ap_interior(rc: i64, ru: i64, rd: i64, rb: i64, start: i64, lim: i64) {
    unsafe {
        mut x := start
        while x < lim {
            v := 6.0 * ptr_read_f64(rc, x) - ptr_read_f64(rc, x - 1) - ptr_read_f64(rc, x + 1) - 0.5 * (ptr_read_f64(ru, x) + ptr_read_f64(rd, x))
            ptr_write_f64(rb, x, v)
            x += 1
        }
    }
}
fn b089_cg_sparse(cg_buf: i64, n: i64, iters: i64, barr: i64, args: i64, out: i64) -> i64 {
    unsafe {
        stride := n * 8
        x := cg_buf; r := x + stride; p := r + stride; ap := p + stride
        mem_set(x, 0, stride)
        mut rem := 0; mut i := 0
        while i < n {
            b := 1.0 + (rem as f64) * 0.05
            ptr_write_f64(r, i, b); ptr_write_f64(p, i, b)
            rem += 1; if rem == 19 { rem = 0 }
            i += 1
        }
        mut rsold := _dot_f64_slice(r, r, n)
        hi_mid := n - 64
        mut it := 0
        while it < iters {
            i = 0
            while i < 64 {
                mut v := 6.0 * ptr_read_f64(p, i)
                if i > 0 { v = v - ptr_read_f64(p, i - 1) }
                v = v - ptr_read_f64(p, i + 1) - 0.5 * ptr_read_f64(p, i + 64)
                ptr_write_f64(ap, i, v); i += 1
            }
            _cg_ap_interior(p, p - 512, p + 512, ap, 64, hi_mid)
            i = hi_mid
            while i < n {
                mut v := 6.0 * ptr_read_f64(p, i) - ptr_read_f64(p, i - 1) - 0.5 * ptr_read_f64(p, i - 64)
                if i + 1 < n { v = v - ptr_read_f64(p, i + 1) }
                ptr_write_f64(ap, i, v); i += 1
            }
            pap := _dot_f64_slice(p, ap, n)
            alpha := rsold / pap
            _axpy_f64_slice(x, p, alpha, n)
            _axpy_f64_slice(r, ap, 0.0 - alpha, n)
            rsnew := _dot_f64_slice(r, r, n)
            _cg_axpy_b(r, p, rsnew / rsold, n)
            rsold = rsnew
            it += 1
        }
        mut s := 0.0; i = 0
        while i < n { s = s + ptr_read_f64(x, i); i += 1 }
        return (s * 100.0) as i64
    }
}

fn _w090(tid: i64, nt: i64, pool: i64) {
    unsafe {
        pa := ptr_read_i64(pool, 4); px := ptr_read_i64(pool, 5); py := ptr_read_i64(pool, 6); n := ptr_read_i64(pool, 7)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        // 4 steps alpha = 0.25, 0.35, 0.45, 0.55; execute all 4 steps per row in L1!
        mut i := i0
        while i < i1 {
            rn := i * n
            xi := ptr_read_f64(px, i)
            mem_set(pa + rn * 8, 0, n * 8)
            mut st := 0
            while st < 4 {
                ax := (0.25 + (st as f64) * 0.1) * xi
                _axpy_f64_slice(pa + rn * 8, py, ax, n)
                st += 1
            }
            i += 1
        }
    }
}
fn b090_outer_rank1(pa: i64, px: i64, py: i64, n: i64, args: i64) -> i64 {
    unsafe {
        ptr_write_i64(args, 0, pa); ptr_write_i64(args, 1, px); ptr_write_i64(args, 2, py); ptr_write_i64(args, 3, n)
        _ := ai_pool_dispatch(fn_addr(_w090), args)
        mut s := 0.0; mut i := 0; tot := n * n
        while i < tot { s = s + ptr_read_f64(pa, i); i += 31 }
        return (s * 1000.0) as i64
    }
}

// ==================== Domain 10: Impossible AI, Quantized LLM & Vector DB (B091..B100) ====================

fn b091_bnn_gemv(pw: i64, pa: i64, po: i64) -> i64 {
    unsafe {
        bnn_gemv_popcnt(pw, pa, po, 4096, 64)
        mut acc := 0; mut i := 0
        while i < 4096 { acc = acc +% ptr_read_i64(po, i); i += 1 }
        return acc
    }
}

fn b092_q4_0_gemv(pact: i64, pq4: i64, pout: i64, rows: i64, cols: i64, reps: i64) -> i64 {
    unsafe {
        nblocks := cols >> 5
        mut tot := 0.0; mut rep := 0
        while rep < reps {
            _ := avx_gemv_q4_0_batch(pact, pq4, pout, rows, nblocks)
            mut i := 0
            while i < rows { tot = tot + ptr_read_f32(pout, i); i += 1 }
            rep += 1
        }
        return (tot * 10.0) as i64
    }
}

fn b093_q8_0_gemv(pact: i64, pq8: i64, pout: i64, rows: i64, cols: i64) -> i64 {
    unsafe {
        _ := avx_gemv_q8_0_batch(pact, pq8, pout, rows, cols >> 5)
        mut tot := 0.0; mut i := 0
        while i < rows { tot = tot + ptr_read_f32(pout, i); i += 1 }
        return (tot * 10.0) as i64
    }
}

fn _w094(tid: i64, nt: i64, pool: i64) {
    unsafe {
        pact := ptr_read_i64(pool, 4); pw := ptr_read_i64(pool, 5); rows := ptr_read_i64(pool, 6); cols := ptr_read_i64(pool, 7); out := ptr_read_i64(pool, 9)
        r0 := (tid * rows) / nt; r1 := ((tid + 1) * rows) / nt
        mut tot := 0.0; mut r := r0
        while r < r1 {
            rp := pw + r * cols
            mut s := 0.0; mut c := 0
            while c < cols {
                w := ptr_read_u8(rp, c)
                if w == 2 { s = s + ptr_read_f32(pact, c) }
                else if w == 0 { s = s - ptr_read_f32(pact, c) }
                c += 1
            }
            tot = tot + s
            r += 1
        }
        ptr_write_f64(out, tid, tot)
    }
}
fn b094_bitnet_158(pact: i64, pw: i64, rows: i64, cols: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w094), pact, pw, rows, cols, 0, 0, args, out) } * 10.0) as i64
}

fn b095_faiss_l2(pvecs: i64, pqrys: i64, pdsts: i64, nvecs: i64, nq: i64, dim: i64) -> i64 {
    unsafe {
        mut acc := 0.0; mut q := 0
        while q < nq {
            _ := avx_l2_batch_f32(pvecs, pqrys + q * dim * 4, pdsts, nvecs, dim)
            mut best := 1000000000000.0; mut bid := 0; mut i := 0
            while i < nvecs {
                d := ptr_read_f32(pdsts, i)
                if d < best { best = d; bid = i }
                i += 1
            }
            acc = acc + best + (bid as f64) * 0.001
            q += 1
        }
        return (acc * 100.0) as i64
    }
}

fn _w096(tid: i64, nt: i64, pool: i64) {
    unsafe {
        pvecs := ptr_read_i64(pool, 4); pqrys := ptr_read_i64(pool, 5); nvecs := ptr_read_i64(pool, 6); nq := ptr_read_i64(pool, 7); bmat := ptr_read_i64(pool, 8)
        i0 := (tid * nvecs) / nt; i1 := ((tid + 1) * nvecs) / nt
        tb := bmat + tid * 64
        mut q := 0
        while q < nq { ptr_write_f64(tb, q, -1000000000.0); q += 1 }
        mut i := i0
        while i < i1 {
            vv := pvecs + i * 64 * 4
            mut vn := 0.0; mut k := 0
            while k < 64 { a := ptr_read_f32(vv, k); vn = vn + a * a; k += 1 }
            vinv := 1.0 / sqrt_f64(vn)
            q = 0
            while q < nq {
                qv := pqrys + q * 64 * 4
                mut dot := 0.0; k = 0
                while k < 64 { dot = dot + ptr_read_f32(vv, k) * ptr_read_f32(qv, k); k += 1 }
                sim := dot * vinv
                if sim > ptr_read_f64(tb, q) { ptr_write_f64(tb, q, sim) }
                q += 1
            }
            i += 1
        }
    }
}
fn b096_cosine_topk(pvecs: i64, pqrys: i64, nvecs: i64, nq: i64, dim: i64, scratch: i64, args: i64) -> i64 {
    unsafe {
        mut t := 0
        while t < 16 * 8 { ptr_write_f64(scratch, t, -1000000000.0); t += 1 }
        ptr_write_i64(args, 0, pvecs); ptr_write_i64(args, 1, pqrys); ptr_write_i64(args, 2, nvecs); ptr_write_i64(args, 3, nq); ptr_write_i64(args, 4, scratch)
        _ := ai_pool_dispatch(fn_addr(_w096), args)
        mut acc := 0.0; mut q := 0
        while q < nq {
            qv := pqrys + q * dim * 4
            mut qn := 0.0; mut k := 0
            while k < dim { v := ptr_read_f32(qv, k); qn = qn + v * v; k += 1 }
            qinv := 1.0 / sqrt_f64(qn)
            mut best := -1000000000.0; t = 0
            while t < 16 { v := ptr_read_f64(scratch + t * 64, q); if v > best { best = v }; t += 1 }
            acc = acc + best * qinv
            q += 1
        }
        return (acc * 10000.0) as i64
    }
}

fn b097_llm_ffn(px: i64, pnw: i64, pnorm: i64, pw1: i64, pw2: i64, pgate: i64, pup: i64, pact: i64, n: i64) -> i64 {
    unsafe {
        dims := (n << 32) | n
        _ := avx_rmsnorm_f32(px, pnw, pnorm, n, 0.00001)
        _ := avx_gemv2_f32(pw1, pw2, pnorm, pgate, pup, dims)
        _ := avx_swiglu_f32(pgate, pup, pact, n)
        mut tot := 0.0; mut i := 0
        while i < n { tot = tot + ptr_read_f32(pact, i); i += 1 }
        return (tot * 1000.0) as i64
    }
}

fn _fast_exp_neg(u: f64) -> f64 {
    if u > 20.0 { return 0.0 }
    return 1.0 / (1.0 + u * (1.0 + u * (0.5 + u * (0.16666666666666666 + u * (0.041666666666666664 + u * 0.008333333333333333)))))
}
fn _w098(tid: i64, nt: i64, pool: i64) {
    unsafe {
        mat := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); scratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        rtmp := scratch + tid * 4096
        r0 := (tid * n) / nt; r1 := ((tid + 1) * n) / nt
        mut acc := 0.0; mut r := r0
        while r < r1 {
            row := mat + r * n * 8
            mut mx := -1000000000000000000.0; mut c := 0
            while c < n { v := ptr_read_f64(row, c); if v > mx { mx = v }; c += 1 }
            mut s := 0.0; c = 0
            while c < n { e := _fast_exp_neg(mx - ptr_read_f64(row, c)); ptr_write_f64(rtmp, c, e); s = s + e; c += 1 }
            inv := 1.0 / s; c = 0
            while c < n { acc = acc + ptr_read_f64(rtmp, c) * inv * (((c % 17) as f64) + 1.0); c += 1 }
            r += 1
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b098_softmax_2d(mat: i64, n: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w098), mat, n, scratch, 0, 0, 0, args, out) } * 1000.0) as i64
}

fn _axpy_f64_slice(dst: i64, src: i64, w: f64, d: i64) {
    unsafe {
        mut o1 := 0; mut o2 := 0; mut m := 0
        while m < d {
            cv := ptr_read_f64(dst, o1 + m)
            bv := ptr_read_f64(src, o2 + m)
            ptr_write_f64(dst, o1 + m, cv + w * bv)
            m += 1
        }
    }
}
fn _w099(tid: i64, nt: i64, pool: i64) {
    unsafe {
        meta := ptr_read_i64(pool, 4); seq := ptr_read_i64(pool, 5); d := ptr_read_i64(pool, 6); scratch := ptr_read_i64(pool, 7); out := ptr_read_i64(pool, 9)
        pq := ptr_read_i64(meta, 0); pk := ptr_read_i64(meta, 1); pv := ptr_read_i64(meta, 2)
        sc_buf := scratch + tid * 4096
        o_buf := sc_buf + 2048
        tot_rows := 4 * seq
        r0 := (tid * tot_rows) / nt; r1 := ((tid + 1) * tot_rows) / nt
        scale := 1.0 / sqrt_f64(d as f64)
        mut acc := 0.0; mut hi := r0
        while hi < r1 {
            h := hi / seq; i := hi - h * seq
            base := h * seq * d
            qi := pq + (base + i * d) * 8
            mut mx := -1000000000000000000.0; mut j := 0
            while j < seq {
                kj := pk + (base + j * d) * 8
                sc := _dot_f64_slice(qi, kj, d) * scale
                ptr_write_f64(sc_buf, j, sc)
                if sc > mx { mx = sc }
                j += 1
            }
            mut se := 0.0; j = 0
            while j < seq { e := _fast_exp_neg(mx - ptr_read_f64(sc_buf, j)); ptr_write_f64(sc_buf, j, e); se = se + e; j += 1 }
            inv := 1.0 / se
            mem_set(o_buf, 0, d * 8)
            j = 0
            while j < seq {
                _axpy_f64_slice(o_buf, pv + (base + j * d) * 8, ptr_read_f64(sc_buf, j) * inv, d)
                j += 1
            }
            mut m := 0
            while m < d { acc = acc + ptr_read_f64(o_buf, m); m += 1 }
            hi += 1
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b099_flash_attn(pq: i64, pk: i64, pv: i64, seq: i64, d: i64, scratch: i64, args: i64, out: i64) -> i64 {
    unsafe {
        meta := args + 64
        ptr_write_i64(meta, 0, pq); ptr_write_i64(meta, 1, pk); ptr_write_i64(meta, 2, pv)
        return (_dispatch_reduce_f64(fn_addr(_w099), meta, seq, d, scratch, 0, 0, args, out) * 1000.0) as i64
    }
}

fn _w100_step(tid: i64, nt: i64, pool: i64) {
    unsafe {
        pts := ptr_read_i64(pool, 4); cent := ptr_read_i64(pool, 5); tsums := ptr_read_i64(pool, 6); tcnts := ptr_read_i64(pool, 7); npts := ptr_read_i64(pool, 8)
        cnorm := cent + 4096
        sbase := tsums + tid * 4096
        cbase := tcnts + tid * 128
        mem_set(sbase, 0, 4096); mem_set(cbase, 0, 128)
        i0 := (tid * npts) / nt; i1 := ((tid + 1) * npts) / nt
        mut i := i0
        while i < i1 {
            p := pts + i * 256
            mut best := 1000000000000.0; mut bid := 0; mut c := 0
            while c < 16 {
                d := ptr_read_f64(cnorm, c) - 2.0 * _dot_f64_slice(p, cent + c * 256, 32)
                if d < best { best = d; bid = c }
                c += 1
            }
            ptr_write_i64(cbase, bid, ptr_read_i64(cbase, bid) + 1)
            _axpy_f64_slice(sbase + bid * 256, p, 1.0, 32)
            i += 1
        }
    }
}
fn b100_kmeans_lloyd(pts: i64, cent: i64, tsums: i64, tcnts: i64, npts: i64, iters: i64, args: i64) -> i64 {
    unsafe {
        mem_copy(cent, pts, 4096)
        cnorm := cent + 4096
        mut it := 0
        while it < iters {
            mut c := 0
            while c < 16 {
                cv := cent + c * 256
                ptr_write_f64(cnorm, c, _dot_f64_slice(cv, cv, 32))
                c += 1
            }
            mem_set(tcnts, 0, 16 * 128)
            ptr_write_i64(args, 0, pts); ptr_write_i64(args, 1, cent); ptr_write_i64(args, 2, tsums); ptr_write_i64(args, 3, tcnts); ptr_write_i64(args, 4, npts)
            _ := ai_pool_dispatch(fn_addr(_w100_step), args)
            c = 0
            while c < 16 {
                mut cnt := 0; mut t := 0
                while t < 16 { cnt += ptr_read_i64(tcnts + t * 128, c); t += 1 }
                if cnt > 0 {
                    inv := 1.0 / (cnt as f64)
                    mut m := 0
                    while m < 32 {
                        mut sm := 0.0; t = 0
                        while t < 16 {
                            if ptr_read_i64(tcnts + t * 128, c) > 0 {
                                sm = sm + ptr_read_f64(tsums + t * 4096 + c * 256, m)
                            }
                            t += 1
                        }
                        ptr_write_f64(cent, c * 32 + m, sm * inv)
                        m += 1
                    }
                }
                c += 1
            }
            it += 1
        }
        mut s := 0.0; mut k := 0
        while k < 512 { s = s + ptr_read_f64(cent, k); k += 1 }
        return (s * 1000.0) as i64
    }
}

// ==================== Main Harness (100 Benchmarks) ====================

fn main() -> i64 {
    unsafe {
    // Reusable worker dispatch buffers + barrier + per-thread scratch (3.2 MB)
    args := mem_alloc_aligned(128)
    out  := mem_alloc_aligned(1024)
    barr := mem_alloc_aligned(128)
    scratch := mem_alloc_aligned(16 * 196608 + 65536)

    // D1 Morton LUT + Mat4x4 inputs
    morton_lut := mem_alloc_aligned(1024 * 8 + 64)
    mut i := 0
    while i < 1024 {
        mut v := i
        v = (v ^ (v << 16)) & 0xFF0000FF; v = (v ^ (v << 8)) & 0x0300F00F
        v = (v ^ (v << 4)) & 0x030C30C3; v = (v ^ (v << 2)) & 0x09249249
        ptr_write_i64(morton_lut, i, v); i += 1
    }
    mat4_a := mem_alloc_aligned(32000 * 16 * 8 + 64); mat4_b := mem_alloc_aligned(32000 * 16 * 8 + 64)
    i = 0
    while i < 32000 * 16 {
        ptr_write_i64(mat4_a, i, ((i * 7 + 3) & 31) - 15)
        ptr_write_i64(mat4_b, i, ((i * 11 + 5) & 31) - 15)
        i += 1
    }

    // D2 SIMD shared arrays
    a_f64_1m := mem_alloc_aligned(1000000 * 8 + 64)
    b_f64_1m := mem_alloc_aligned(1000000 * 8 + 64)
    x_f32_1m := mem_alloc_aligned(1000000 * 4 + 64)
    y_f32_1m := mem_alloc_aligned(1000000 * 4 + 64)
    d_f32_1m := mem_alloc_aligned(1000000 * 4 + 64)
    src_i64_512k := mem_alloc_aligned(524288 * 8 + 64)
    dst_i64_512k := mem_alloc_aligned(524288 * 8 + 64)
    data_2m := mem_alloc_aligned(2000000 + 64)
    arr_i64_2m := mem_alloc_aligned(2000000 * 8 + 64)
    mat512_src := mem_alloc_aligned(512 * 512 * 8 + 64)
    mat512_dst := mem_alloc_aligned(512 * 512 * 8 + 64)
    i = 0
    while i < 1000000 {
        ptr_write_f64(a_f64_1m, i, ((i % 97) as f64) * 0.01 - 0.5)
