    while i < 100 {
        if i > 0 { buf_push(jout, 44) }
        buf_push_str(jout, str_from_i64(ibuf_get(times, i) / 1000))
        i += 1
    }
    buf_push_str(jout, "],\"chks\":[")
    i = 0
    while i < 100 {
        if i > 0 { buf_push(jout, 44) }
        buf_push_str(jout, str_from_i64(ibuf_get(chks, i)))
        i += 1
    }
    buf_push_str(jout, "]}")
    println(buf_to_owned_str(move jout))

    buf_free(move times); buf_free(move chks)
    buf_free(move jb); buf_free(move cb); buf_free(move ub); buf_free(move orig_sort); buf_free(move work_sort)
    graph_free(move g6k); mat_free(move fft_re); mat_free(move fft_im)
    mem_free_aligned(args); mem_free_aligned(out); mem_free_aligned(barr); mem_free_aligned(scratch)
    mem_free_aligned(morton_lut); mem_free_aligned(mat4_a); mem_free_aligned(mat4_b)
    mem_free_aligned(a_f64_1m); mem_free_aligned(b_f64_1m); mem_free_aligned(x_f32_1m); mem_free_aligned(y_f32_1m); mem_free_aligned(d_f32_1m)
    mem_free_aligned(src_i64_512k); mem_free_aligned(dst_i64_512k); mem_free_aligned(data_2m); mem_free_aligned(arr_i64_2m)
