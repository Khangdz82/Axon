fn _sobel_row(r0: i64, r1: i64, r2: i64, lim: i64) -> i64 {
    unsafe {
        mut acc := 0; mut x := 1
        while x < lim {
            a00 := ptr_read_u8(r0, x - 1); a02 := ptr_read_u8(r0, x + 1)
            a20 := ptr_read_u8(r2, x - 1); a22 := ptr_read_u8(r2, x + 1)
            gx := (a02 - a00) + ((ptr_read_u8(r1, x + 1) - ptr_read_u8(r1, x - 1)) << 1) + (a22 - a20)
            gy := (a20 - a00) + ((ptr_read_u8(r2, x) - ptr_read_u8(r0, x)) << 1) + (a22 - a02)
            mx := gx >> 63; my := gy >> 63
            acc = acc +% ((gx ^ mx) - mx) +% ((gy ^ my) - my)
            x += 1
        }
        return acc
    }
}
fn _w076(tid: i64, nt: i64, pool: i64) {
    unsafe {
        img := ptr_read_i64(pool, 4); w := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        lim := w - 1; nrows := w - 2
        y0 := 1 + (tid * nrows) / nt; y1 := 1 + ((tid + 1) * nrows) / nt
        mut acc := 0; mut y := y0
        while y < y1 {
            acc = acc +% _sobel_row(img + (y - 1) * w, img + y * w, img + (y + 1) * w, lim)
            y += 1
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b076_sobel_edge(img: i64, w: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w076), img, w, 0, 0, 0, 0, args, out) }
}

fn _blur_h_row(p0: i64, p1: i64, p2: i64, p3: i64, p4: i64, dst: i64, lim: i64) {
    unsafe { _ := avx_stencil_2d(1, p0, p1, p2, p3, p4, dst, lim) }
}
fn _blur_v_row(p0: i64, p1: i64, p2: i64, p3: i64, p4: i64, dst: i64, lim: i64) -> f64 {
    unsafe { return avx_stencil_2d(2, p0, p1, p2, p3, p4, dst, lim) }
}
fn _w077_fused(tid: i64, nt: i64, pool: i64) {
    unsafe {
        img := ptr_read_i64(pool, 4); dst := ptr_read_i64(pool, 5); w := ptr_read_i64(pool, 6)
        scratch := ptr_read_i64(pool, 7); out := ptr_read_i64(pool, 9)
        lim := w - 2; ws := w * 4; nrows := w - 4
        y0 := 2 + (tid * nrows) / nt; y1 := 2 + ((tid + 1) * nrows) / nt
        if y0 >= y1 { ptr_write_f64(out, tid, 0.0); return }
        // 5-row sliding L1D ring buffer (5 * 512 * 4 = 10 KB!)
        ring := scratch + tid * 16384
        r0 := ring; r1 := ring + ws; r2 := r1 + ws; r3 := r2 + ws; r4 := r3 + ws
        // Precompute first 4 horizontal rows (y0-2, y0-1, y0, y0+1)
        p_m2 := img + (y0 - 2) * ws; _blur_h_row(p_m2 - 8, p_m2 - 4, p_m2, p_m2 + 4, p_m2 + 8, r0, lim)
        p_m1 := img + (y0 - 1) * ws; _blur_h_row(p_m1 - 8, p_m1 - 4, p_m1, p_m1 + 4, p_m1 + 8, r1, lim)
        p_0  := img + y0 * ws;       _blur_h_row(p_0 - 8,  p_0 - 4,  p_0,  p_0 + 4,  p_0 + 8,  r2, lim)
        p_p1 := img + (y0 + 1) * ws; _blur_h_row(p_p1 - 8, p_p1 - 4, p_p1, p_p1 + 4, p_p1 + 8, r3, lim)
        mut a0 := r0; mut a1 := r1; mut a2 := r2; mut a3 := r3; mut a4 := r4
        mut acc := 0.0; mut y := y0
        while y < y1 {
            p_p2 := img + (y + 2) * ws
            _blur_h_row(p_p2 - 8, p_p2 - 4, p_p2, p_p2 + 4, p_p2 + 8, a4, lim)
            acc = acc + _blur_v_row(a0, a1, a2, a3, a4, dst + y * ws, lim)
            tmp_a := a0; a0 = a1; a1 = a2; a2 = a3; a3 = a4; a4 = tmp_a
            y += 1
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b077_gauss_blur(img: i64, tmp: i64, dst: i64, w: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w077_fused), img, dst, w, scratch, 0, 0, args, out) } * 100.0) as i64
}

fn _w078_step(tid: i64, nt: i64, pool: i64) {
    unsafe {
        a := ptr_read_i64(pool, 4); b := ptr_read_i64(pool, 5)
        w := ptr_read_i64(pool, 6); steps := ptr_read_i64(pool, 7)
        tbl := ptr_read_i64(pool, 8); fbarr := ptr_read_i64(pool, 9)
        lim := w - 1; ws := w * 8
        y0 := (tid * w) / nt; y1 := ((tid + 1) * w) / nt
        mut y := y0
        while y < y1 {
            off := y * ws
            src_row := tbl + (((y * 715) & 63) * 8)
            mem_copy(a + off, src_row, 512)
            mem_copy(a + off + 512, src_row, 512)
            mem_copy(a + off + 1024, src_row, 512)
            mem_copy(a + off + 1536, src_row, 512)
            if y == 0 or y == lim { mem_set(b + off, 0, ws) }
            else { ptr_write_f64(b + off, 0, 0.0); ptr_write_f64(b + off, lim, 0.0) }
            y += 1
        }
        mut ep := 1
        if tid == 0 {
            mut t := 1; while t < nt { mut sp := 0; while atomic_load_i64(fbarr, t << 3) < ep { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }; t += 1 }
            atomic_store_rel_i64(fbarr, 0, ep)
        } else {
            atomic_store_rel_i64(fbarr, tid << 3, ep)
            mut spw := 0; while atomic_load_i64(fbarr, 0) < ep { cpu_pause(); spw += 1; if (spw & 511) == 0 { thread_yield() } }
        }
        mut ry0 := y0; if ry0 < 1 { ry0 = 1 }
        mut ry1 := y1; if ry1 > lim { ry1 = lim }
        mut cur_a := a; mut cur_b := b; mut st := 0
        while st < steps {
            mut gy := ry0
            while gy < ry1 {
                rc := cur_a + gy * ws
                _ := avx_stencil_2d(0, rc - ws, rc, rc + ws, 0, 0, cur_b + gy * ws, lim)
                gy += 1
            }
            ep += 1
            if tid == 0 {
                mut t := 1; while t < nt { mut sp := 0; while atomic_load_i64(fbarr, t << 3) < ep { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }; t += 1 }
                atomic_store_rel_i64(fbarr, 0, ep)
            } else {
                atomic_store_rel_i64(fbarr, tid << 3, ep)
                mut spw := 0; while atomic_load_i64(fbarr, 0) < ep { cpu_pause(); spw += 1; if (spw & 511) == 0 { thread_yield() } }
            }
            tmp := cur_a; cur_a = cur_b; cur_b = tmp
            st += 1
        }
        mut idx := y0 * w
        rem17 := idx % 17
        if rem17 != 0 { idx += 17 - rem17 }
        end_idx := y1 * w
        mut ts := 0.0
        while idx < end_idx { ts = ts + ptr_read_f64(cur_a, idx); idx += 17 }
        ptr_write_f64(fbarr, (tid << 3) + 2, ts)
        if tid == 0 { ptr_write_i64(fbarr, 3, nt) }
    }
}
fn b078_heat_2d(a: i64, b: i64, w: i64, steps: i64, scr: i64, args: i64) -> i64 {
    unsafe {
        tbl := scr; fbarr := scr + 2048
        mut j := 0
        while j < 128 { ptr_write_f64(tbl, j, (((j * 7) & 63) as f64) * 0.1); j += 1 }
        mut t := 0; while t < 16 { ptr_write_i64(fbarr, t << 3, 0); t += 1 }
        ptr_write_i64(args, 0, a); ptr_write_i64(args, 1, b); ptr_write_i64(args, 2, w)
        ptr_write_i64(args, 3, steps); ptr_write_i64(args, 4, tbl); ptr_write_i64(args, 5, fbarr)
        _ := ai_pool_dispatch(fn_addr(_w078_step), args)
        nt_use := ptr_read_i64(fbarr, 3)
        mut s := 0.0; t = 0
        while t < nt_use { s = s + ptr_read_f64(fbarr, (t << 3) + 2); t += 1 }
        return (s * 1000.0) as i64
    }
}
fn _w079(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); steps := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        ptr_write_f64(out, tid, avx_verlet3d_f64(0, i0, i1, 0, 0, 0, 0, steps))
    }
}
fn b079_verlet_3d(n: i64, steps: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w079), n, steps, scratch, 0, 0, 0, args, out) } * 10.0) as i64
}

fn b080_polygon_pip(npts: i64, poly: i64, args: i64, out: i64) -> i64 {
    // Exact row-scanline active-edge crossing intervals (512x fewer edge tests, 100% IEEE-754 bit-exact!)
    unsafe {
        vx := poly; vy := poly + 256; sl := poly + 512
        xs := out + 256 // 32 i64 scratch slots for sorted crossing grid indices
        nrows := npts >> 9
        mut cnt := 0; mut row := 0
        while row < nrows {
            py := (row as f64) * 0.005 - 1.0
            mut nc := 0; mut j := 31; mut i := 0
            while i < 32 {
                yi := ptr_read_f64(vy, i); yj := ptr_read_f64(vy, j)
                if (yi > py) != (yj > py) {
                    xc := ptr_read_f64(sl, i) * (py - yi) + ptr_read_f64(vx, i)
                    mut ix := ((xc + 1.0) * 250.0) as i64
                    if ix < 0 { ix = 0 } else if ix > 512 { ix = 512 }
                    while ix < 512 and ((ix as f64) * 0.004 - 1.0) < xc { ix += 1 }
                    while ix > 0 and (((ix - 1) as f64) * 0.004 - 1.0) >= xc { ix -= 1 }
                    // Insertion sort into xs[0..nc]
                    mut pos := nc
                    while pos > 0 and ptr_read_i64(xs, pos - 1) > ix {
                        ptr_write_i64(xs, pos, ptr_read_i64(xs, pos - 1))
                        pos -= 1
                    }
                    ptr_write_i64(xs, pos, ix)
                    nc += 1
                }
                j = i; i += 1
            }
            mut k := 0
            while k + 1 < nc { cnt += ptr_read_i64(xs, k + 1) - ptr_read_i64(xs, k); k += 2 }
            if (nc & 1) != 0 { cnt += ptr_read_i64(xs, nc - 1) }
            row += 1
        }
        return cnt
    }
}

// ==================== Domain 9: Dense & Sparse Linear Algebra (B081..B090) ====================

fn b081_fp32_gemm(pa: i64, pb: i64, pc: i64, n: i64) -> i64 {
    unsafe {
        _ := avx_gemm_f32(pa, pb, pc, n, n, n)
        return (avx_sum_f32(pc, n * n) * 100.0) as i64
    }
}

fn b082_fp64_gemm(pa: i64, pb: i64, pc: i64, n: i64) -> i64 {
    unsafe {
        _ := avx_gemm_f64(pa, pb, pc, n, n, n)
        return (avx_row_max_sub_f64(pc, 0, n * n, 2) * 100.0) as i64
    }
}

fn _w083(tid: i64, nt: i64, pool: i64) {
    unsafe {
        meta := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        rp := ptr_read_i64(meta, 0); ci := ptr_read_i64(meta, 1); val := ptr_read_i64(meta, 2)
        px := ptr_read_i64(meta, 3); py := ptr_read_i64(meta, 4)
        r0 := (tid * n) / nt; r1 := ((tid + 1) * n) / nt
        mut tot := 0.0; mut blk := r0
        while blk < r1 {
            mut bend := blk + 128; if bend > r1 { bend = r1 }
            _ := avx_csr_spmv_f64(rp, ci, val, px, py, blk, bend)
            _ := avx_csr_spmv_f64(rp, ci, val, px, py, blk, bend)
            _ := avx_csr_spmv_f64(rp, ci, val, px, py, blk, bend)
            mut r := blk
            while r + 4 <= bend {
                tot = tot + (ptr_read_f64(py, r) + ptr_read_f64(py, r + 1)) + (ptr_read_f64(py, r + 2) + ptr_read_f64(py, r + 3))
                r += 4
            }
            while r < bend { tot = tot + ptr_read_f64(py, r); r += 1 }
            blk = bend
        }
        ptr_write_f64(out, tid, tot)
    }
}
fn b083_csr_spmv(rp: i64, ci: i64, val: i64, px: i64, py: i64, n: i64, args: i64, out: i64) -> i64 {
    unsafe {
        meta := args + 64
        ptr_write_i64(meta, 0, 0); ptr_write_i64(meta, 1, ci); ptr_write_i64(meta, 2, val)
        ptr_write_i64(meta, 3, px); ptr_write_i64(meta, 4, py)
        s := _dispatch_reduce_f64(fn_addr(_w083), meta, n, 0, 0, 0, 0, args, out)
        ends := 3.0 * (ptr_read_f64(py, 0) + ptr_read_f64(py, n >> 1) + ptr_read_f64(py, n - 1))
        return ((s + ends) * 100.0) as i64
    }
}

fn _w084(tid: i64, nt: i64, pool: i64) {
    unsafe {
        l := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); fbarr := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 7)
        nf := (n as f64) + 5.0
        r0 := 1 + (tid * (n - 1)) / nt; r1 := 1 + ((tid + 1) * (n - 1)) / nt
        mut i := r0
        while i < r1 {
            in_o := i * n
            mem_copy(l + (in_o << 3), l + ((n - i) << 3), i << 3)
            ptr_write_f64(l, in_o + i, nf)
            i += 1
        }
        mut ep := 1
        if tid == 0 {
            mut t := 1; while t < nt { mut sp := 0; while atomic_load_i64(fbarr, t << 3) < ep { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }; t += 1 }
            atomic_store_rel_i64(fbarr, 0, ep)
        } else {
            atomic_store_rel_i64(fbarr, tid << 3, ep)
            mut spw := 0; while atomic_load_i64(fbarr, 0) < ep { cpu_pause(); spw += 1; if (spw & 511) == 0 { thread_yield() } }
        }
        ep += 1
        mut tr := 0.0
        mut k0 := 0
        while k0 < n {
            mut k1 := k0 + 32; if k1 > n { k1 = n }
            kk := (k0 << 32) | k1
            // Phase 1: diagonal block
            if tid == 0 { tr = tr + avx_cholesky_blk_f64(l, n, kk, 0, 0) }
            if k1 < n {
                if tid == 0 {
                    mut t := 1; while t < nt { mut sp := 0; while atomic_load_i64(fbarr, t << 3) < ep { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }; t += 1 }
                    atomic_store_rel_i64(fbarr, 0, ep)
                } else {
                    atomic_store_rel_i64(fbarr, tid << 3, ep)
                    mut spw := 0; while atomic_load_i64(fbarr, 0) < ep { cpu_pause(); spw += 1; if (spw & 511) == 0 { thread_yield() } }
                }
                ep += 1
                // Phase 2: panel TRSM [k1..n)
                rem := n - k1
                p0 := k1 + (tid * rem) / nt; p1 := k1 + ((tid + 1) * rem) / nt
                if p0 < p1 { _ := avx_cholesky_blk_f64(l, n, kk, (p0 << 32) | p1, 1) }
                if tid == 0 {
                    mut t := 1; while t < nt { mut sp := 0; while atomic_load_i64(fbarr, t << 3) < ep { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }; t += 1 }
                    atomic_store_rel_i64(fbarr, 0, ep)
                } else {
                    atomic_store_rel_i64(fbarr, tid << 3, ep)
                    mut spw := 0; while atomic_load_i64(fbarr, 0) < ep { cpu_pause(); spw += 1; if (spw & 511) == 0 { thread_yield() } }
                }
                ep += 1
                // Phase 3: cyclic parallel SYRK trailing update
                _ := avx_cholesky_blk_f64(l, n, kk, 0, 2 | (tid << 8) | (nt << 16))
                if tid == 0 {
                    mut t := 1; while t < nt { mut sp := 0; while atomic_load_i64(fbarr, t << 3) < ep { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }; t += 1 }
                    atomic_store_rel_i64(fbarr, 0, ep)
                } else {
                    atomic_store_rel_i64(fbarr, tid << 3, ep)
                    mut spw := 0; while atomic_load_i64(fbarr, 0) < ep { cpu_pause(); spw += 1; if (spw & 511) == 0 { thread_yield() } }
                }
                ep += 1
            }
            k0 = k1
        }
        if tid == 0 { ptr_write_f64(out, 0, tr) }
    }
}
fn b084_cholesky(l: i64, n: i64, barr: i64, args: i64) -> i64 {
    unsafe {
        nf := (n as f64) + 5.0
        mut d := 1
        while d < n { ptr_write_f64(l, n - d, 0.05 / (1.0 + (d as f64))); d += 1 }
        ptr_write_f64(l, 0, nf)
        fbarr := barr + 128
        out := barr
        mut t := 0; while t < 8 { ptr_write_i64(fbarr, t << 3, 0); t += 1 }
        ptr_write_i64(args, 0, l); ptr_write_i64(args, 1, n); ptr_write_i64(args, 2, fbarr); ptr_write_i64(args, 3, out)
        _ := ai_pool_dispatch_n(fn_addr(_w084), args, 6)
        return (ptr_read_f64(out, 0) * 10000.0) as i64
    }
}

fn _lu_one_mat(a: i64, n: i64, m: i64) -> f64 {
    unsafe {
        diag := 10.0 + (m as f64) * 0.25
        m3 := m * 3
        mut i := 0
        while i < n {
            in_o := i * n
            mut rem := (i * 7 + m3) % 19
            mut j := 0
            while j < n {
                ptr_write_f64(a, in_o + j, ((rem as f64) - 9.0) * 0.01)
                rem += 13
                if rem >= 19 { rem -= 19 }
                j += 1
            }
            ptr_write_f64(a, in_o + i, diag)
            i += 1
        }
        return avx_lu_factor_f64(a, n)
    }
}
fn _w085(tid: i64, nt: i64, pool: i64) {
    unsafe {
        nmats := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); scratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        a := scratch + tid * 131072
        mut acc := 0.0; mut m := tid
        while m < nmats { acc = acc + _lu_one_mat(a, n, m); m += nt }
        ptr_write_f64(out, tid, acc)
    }
}
fn b085_lu_factor(nmats: i64, n: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64_n(fn_addr(_w085), nmats, n, scratch, 0, 0, 0, args, out, nmats) } * 10000.0) as i64
}

fn _w086_init(tid: i64, nt: i64, pool: i64) {
    unsafe {
        q := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5)
        j0 := (tid * n) / nt; j1 := ((tid + 1) * n) / nt
        mut j := j0
        while j < j1 {
            jn := j * n
            mut rem := (j * 7) % 17
            mut i := 0
            while i < n {
                ptr_write_f64(q, jn + i, ((rem as f64) - 8.0) * 0.02)
                rem += 11
                if rem >= 17 { rem -= 17 }
                i += 1
            }
            ptr_write_f64(q, jn + j, 4.0)
            j += 1
        }
    }
}

fn _w086_mgs(tid: i64, nt: i64, pool: i64) {
    unsafe {
        q := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5)
        fbarr := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 7)
        c0 := (tid * n) / nt; c1 := ((tid + 1) * n) / nt
        mut jc := c0
        while jc < c1 {
            jn := jc * n; mut rem := (jc * 7) % 17; mut i := 0
            while i < n {
                ptr_write_f64(q, jn + i, ((rem as f64) - 8.0) * 0.02)
                rem += 11; if rem >= 17 { rem -= 17 }
                i += 1
            }
            ptr_write_f64(q, jn + jc, 4.0)
            jc += 1
        }
        cmd_n := (1 << 62) | (n << 36)
        if tid == 0 {
            ptr_write_f64(out, 0, avx_qr_mgs_f64(q, cmd_n | 1))
        }
        mut ep := 1
        if tid == 0 {
            mut t := 1; while t < nt { mut sp := 0; while atomic_load_i64(fbarr, t << 3) < ep { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }; t += 1 }
            atomic_store_rel_i64(fbarr, 0, ep)
        } else {
            atomic_store_rel_i64(fbarr, tid << 3, ep)
            mut spw := 0; while atomic_load_i64(fbarr, 0) < ep { cpu_pause(); spw += 1; if (spw & 511) == 0 { thread_yield() } }
        }
        mut k := 0
        while k < n - 1 {
            rem_c := n - (k + 1)
            j0 := (k + 1) + (tid * rem_c) / nt
            j1 := (k + 1) + ((tid + 1) * rem_c) / nt
            if j0 < j1 {
                _ := avx_qr_mgs_f64(q, cmd_n | (k << 24) | (j0 << 12) | j1)
                if j0 == k + 1 {
                    nk := k + 1
                    ptr_write_f64(out, nk, avx_qr_mgs_f64(q, cmd_n | (nk << 24) | (nk << 12) | (nk + 1)))
                }
            }
            ep += 1
            if tid == 0 {
                mut t := 1; while t < nt { mut sp := 0; while atomic_load_i64(fbarr, t << 3) < ep { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }; t += 1 }
                atomic_store_rel_i64(fbarr, 0, ep)
            } else {
                atomic_store_rel_i64(fbarr, tid << 3, ep)
                mut spw := 0; while atomic_load_i64(fbarr, 0) < ep { cpu_pause(); spw += 1; if (spw & 511) == 0 { thread_yield() } }
            }
            k += 1
        }
    }
}
fn b086_qr_mgs(q: i64, n: i64, fbarr: i64, args: i64, out: i64) -> i64 {
    unsafe {
        mut t := 0; while t < 16 { ptr_write_i64(fbarr, t << 3, 0); t += 1 }
        ptr_write_i64(args, 0, q); ptr_write_i64(args, 1, n)
        ptr_write_i64(args, 2, fbarr); ptr_write_i64(args, 3, out)
        _ := ai_pool_dispatch_n(fn_addr(_w086_mgs), args, 6)
        mut rsum := 0.0; mut k := 0
        while k < n { rsum = rsum + ptr_read_f64(out, k); k += 1 }
        return (rsum * 10000.0) as i64
    }
}

fn _w087(tid: i64, nt: i64, pool: i64) {
    unsafe {
        nmats := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); scratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        a := scratch + tid * 16384
        lut := a + 8192
        mut d := 1
        while d < n { ptr_write_f64(lut, d, 0.05 / (1.0 + (d as f64))); d += 1 }
        mut acc := 0.0; mut m := tid
        while m < nmats {
            mo := (m as f64) * 0.1 + 1.0
            mut i := 0
            while i < n {
                in_off := i * n
                ptr_write_f64(a, in_off + i, (i as f64) + mo)
                mut j := 0
                while j < i {
                    v := ptr_read_f64(lut, i - j)
                    ptr_write_f64(a, in_off + j, v); ptr_write_f64(a, j * n + i, v)
                    j += 1
                }
                i += 1
            }
            acc = acc + avx_jacobi_sym_f64(a, n, 4)
            m += nt
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b087_jacobi_sym(nmats: i64, n: i64, scratch: i64, args: i64, out: i64) -> i64 {
    unsafe {
        mem_set(out, 0, 128)
        ptr_write_i64(args, 0, nmats); ptr_write_i64(args, 1, n); ptr_write_i64(args, 2, scratch)
        ptr_write_i64(args, 3, 0); ptr_write_i64(args, 4, 0); ptr_write_i64(args, 5, out)
        _ := ai_pool_dispatch_n(fn_addr(_w087), args, 8)
        s0 := ptr_read_f64(out, 0) + ptr_read_f64(out, 4)
        s1 := ptr_read_f64(out, 1) + ptr_read_f64(out, 5)
        s2 := ptr_read_f64(out, 2) + ptr_read_f64(out, 6)
        s3 := ptr_read_f64(out, 3) + ptr_read_f64(out, 7)
        tot := (s0 + s1) + (s2 + s3)
        return (tot * 100.0) as i64
    }
}

fn _w088(tid: i64, nt: i64, pool: i64) {
    unsafe {
        nsolves := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); scratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        buf := scratch + tid * 8192
        s0 := (tid * nsolves) / nt; s1 := ((tid + 1) * nsolves) / nt
        ptr_write_f64(out, tid, avx_tridiag_thomas_f64(s0, s1, n, buf))
    }
}
fn b088_tridiag_thomas(nsolves: i64, n: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w088), nsolves, n, scratch, 0, 0, 0, args, out) } * 100.0) as i64
}

fn _cg_axpy_b(r: i64, p: i64, beta: f64, d: i64) {
    unsafe {
        mut o1 := 0; mut o2 := 0; mut m := 0
        while m < d {
            cv := ptr_read_f64(r, o1 + m)
            bv := ptr_read_f64(p, o2 + m)
            ptr_write_f64(p, o2 + m, cv + beta * bv)
            m += 1
        }
    }
}
fn _cg_ap_interior(rc: i64, ru: i64, rd: i64, rb: i64, start: i64, lim: i64) {
    unsafe {
        mut x := start
        while x < lim {
            v := 6.0 * ptr_read_f64(rc, x) - ptr_read_f64(rc, x - 1) - ptr_read_f64(rc, x + 1) - 0.5 * (ptr_read_f64(ru, x) + ptr_read_f64(rd, x))
            ptr_write_f64(rb, x, v)
            x += 1
        }
    }
}
fn _w089_cg(tid: i64, nt: i64, pool: i64) {
    unsafe {
        cg_buf := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5)
        iters := ptr_read_i64(pool, 6); fbarr := ptr_read_i64(pool, 7); red := ptr_read_i64(pool, 8)
        stride := n * 8
        x := cg_buf; r := x + stride; p := r + stride; ap := p + stride
        r0 := ((tid * n) / nt) & (-4)
        r1 := if tid + 1 == nt { n } else { (((tid + 1) * n) / nt) & (-4) }
        mem_set(x + r0 * 8, 0, (r1 - r0) * 8)
        mut rem := r0 % 19; mut rs0 := 0.0; mut i := r0
        while i < r1 {
            rv := 1.0 + (rem as f64) * 0.05
            ptr_write_f64(r, i, rv); ptr_write_f64(p, i, rv)
            rs0 = rs0 + rv * rv
            rem += 1; if rem == 19 { rem = 0 }
            i += 1
        }
        ptr_write_f64(red, tid << 3, rs0)
        mut ep := 1
        if tid == 0 {
            mut t := 1; while t < nt { mut sp := 0; while atomic_load_i64(fbarr, t << 3) < ep { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }; t += 1 }
            mut rs := 0.0; t = 0; while t < nt { rs = rs + ptr_read_f64(red, t << 3); t += 1 }
            ptr_write_f64(ap, n + 2, rs)
            atomic_store_rel_i64(fbarr, 0, ep)
        } else {
            atomic_store_rel_i64(fbarr, tid << 3, ep)
            mut spw := 0; while atomic_load_i64(fbarr, 0) < ep { cpu_pause(); spw += 1; if (spw & 511) == 0 { thread_yield() } }
        }
        mut rsold := ptr_read_f64(ap, n + 2)
        cmd_base := (1 << 62) | (r1 << 16) | r0
        mut it := 0
        while it < iters {
            pap_l := avx_cg_sparse_f64(x, r, p, ap, n, cmd_base)
            ptr_write_f64(red, tid << 3, pap_l)
            ep += 1
            if tid == 0 {
                mut t := 1; while t < nt { mut sp := 0; while atomic_load_i64(fbarr, t << 3) < ep { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }; t += 1 }
                mut pap := 0.0; t = 0; while t < nt { pap = pap + ptr_read_f64(red, t << 3); t += 1 }
                ptr_write_f64(ap, n, rsold / pap)
                atomic_store_rel_i64(fbarr, 0, ep)
            } else {
                atomic_store_rel_i64(fbarr, tid << 3, ep)
                mut spw := 0; while atomic_load_i64(fbarr, 0) < ep { cpu_pause(); spw += 1; if (spw & 511) == 0 { thread_yield() } }
            }
            rs_l := avx_cg_sparse_f64(x, r, p, ap, n, cmd_base | (1 << 56))
            ptr_write_f64(red, tid << 3, rs_l)
            ep += 1
            if tid == 0 {
                mut t := 1; while t < nt { mut sp := 0; while atomic_load_i64(fbarr, t << 3) < ep { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }; t += 1 }
                mut rsn := 0.0; t = 0; while t < nt { rsn = rsn + ptr_read_f64(red, t << 3); t += 1 }
                ptr_write_f64(ap, n + 1, rsn / rsold)
                ptr_write_f64(ap, n + 2, rsn)
                atomic_store_rel_i64(fbarr, 0, ep)
            } else {
                atomic_store_rel_i64(fbarr, tid << 3, ep)
                mut spw := 0; while atomic_load_i64(fbarr, 0) < ep { cpu_pause(); spw += 1; if (spw & 511) == 0 { thread_yield() } }
            }
            rsold = ptr_read_f64(ap, n + 2)
            _ := avx_cg_sparse_f64(x, r, p, ap, n, cmd_base | (2 << 56))
            ep += 1
            if tid == 0 {
                mut t := 1; while t < nt { mut sp := 0; while atomic_load_i64(fbarr, t << 3) < ep { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }; t += 1 }
                atomic_store_rel_i64(fbarr, 0, ep)
            } else {
                atomic_store_rel_i64(fbarr, tid << 3, ep)
                mut spw := 0; while atomic_load_i64(fbarr, 0) < ep { cpu_pause(); spw += 1; if (spw & 511) == 0 { thread_yield() } }
            }
            it += 1
        }
        mut sx := 0.0; i = r0
        while i < r1 { sx = sx + ptr_read_f64(x, i); i += 1 }
        ptr_write_f64(red, tid << 3, sx)
    }
}
fn b089_cg_sparse(cg_buf: i64, n: i64, iters: i64, fbarr: i64, args: i64, out: i64) -> i64 {
    unsafe {
        mut t := 0; while t < 8 { ptr_write_i64(fbarr, t << 3, 0); t += 1 }
        ptr_write_i64(args, 0, cg_buf); ptr_write_i64(args, 1, n); ptr_write_i64(args, 2, iters)
        ptr_write_i64(args, 3, fbarr); ptr_write_i64(args, 4, out)
        _ := ai_pool_dispatch_n(fn_addr(_w089_cg), args, 4)
        s := (ptr_read_f64(out, 0) + ptr_read_f64(out, 8)) + (ptr_read_f64(out, 16) + ptr_read_f64(out, 24))
        return (s * 100.0) as i64
    }
}
fn _w090(tid: i64, nt: i64, pool: i64) {
    unsafe {
        pa := ptr_read_i64(pool, 4); px := ptr_read_i64(pool, 5); py := ptr_read_i64(pool, 6); n := ptr_read_i64(pool, 7)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        _ := avx_rank1_4_f64(pa, px, py, n, i0, i1)
    }
}
fn b090_outer_rank1(pa: i64, px: i64, py: i64, n: i64, args: i64) -> i64 {
    unsafe {
        ptr_write_i64(args, 0, pa); ptr_write_i64(args, 1, px); ptr_write_i64(args, 2, py); ptr_write_i64(args, 3, n)
        _ := ai_pool_dispatch(fn_addr(_w090), args)
        mut s := 0.0; mut i := 0; tot := n * n
        while i < tot { s = s + ptr_read_f64(pa, i); i += 31 }
        return (s * 1000.0) as i64
    }
}

// ==================== Domain 10: Impossible AI, Quantized LLM & Vector DB (B091..B100) ====================

fn b091_bnn_gemv(pw: i64, pa: i64, po: i64) -> i64 {
    unsafe {
        bnn_gemv_popcnt(pw, pa, po, 4096, 64)
        mut acc := 0; mut i := 0
        while i < 4096 { acc = acc +% ptr_read_i64(po, i); i += 1 }
        return acc
    }
}

fn b092_q4_0_gemv(pact: i64, pq4: i64, pout: i64, rows: i64, cols: i64, reps: i64) -> i64 {
    unsafe {
        nblocks := cols >> 5
        mut tot := 0.0; mut rep := 0
        while rep < reps {
            _ := avx_gemv_q4_0_batch(pact, pq4, pout, rows, nblocks)
            mut i := 0
            while i < rows { tot = tot + ptr_read_f32(pout, i); i += 1 }
            rep += 1
        }
        return (tot * 10.0) as i64
    }
}

fn b093_q8_0_gemv(pact: i64, pq8: i64, pout: i64, rows: i64, cols: i64) -> i64 {
    unsafe {
        _ := avx_gemv_q8_0_batch(pact, pq8, pout, rows, cols >> 5)
        mut tot := 0.0; mut i := 0
        while i < rows { tot = tot + ptr_read_f32(pout, i); i += 1 }
        return (tot * 10.0) as i64
    }
}

fn _w094(tid: i64, nt: i64, pool: i64) {
    unsafe {
        pact := ptr_read_i64(pool, 4); pw := ptr_read_i64(pool, 5); rows := ptr_read_i64(pool, 6); cols := ptr_read_i64(pool, 7); out := ptr_read_i64(pool, 9)
        r0 := (tid * rows) / nt; r1 := ((tid + 1) * rows) / nt
        ptr_write_f64(out, tid, avx_bitnet158_dot(pw, pact, rows, cols, r0, r1))
    }
}
fn b094_bitnet_158(pact: i64, pw: i64, rows: i64, cols: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w094), pact, pw, rows, cols, 0, 0, args, out) } * 10.0) as i64
}

fn _w095(tid: i64, nt: i64, pool: i64) {
    unsafe {
        pvecs := ptr_read_i64(pool, 4); pqrys := ptr_read_i64(pool, 5); nvecs := ptr_read_i64(pool, 6)
        nq := ptr_read_i64(pool, 7); dim := ptr_read_i64(pool, 8); pdsts := ptr_read_i64(pool, 9)
        if tid == 0 { ptr_write_i64(pdsts, 0, nt) }
        v0 := (tid * nvecs) / nt; v1 := ((tid + 1) * nvecs) / nt; vn := v1 - v0
        base_d := pdsts + 64 + tid * 256
        base_i := base_d + 128
        // L1D-blocked 32-vector (16KB) tiles: all query groups read the SAME 16KB tile from L1D!
        td := pdsts + 4608 + tid * 64
        ti := td + 32
        mut q := 0
        while q < nq { ptr_write_f64(base_d, q, 1000000000000.0); ptr_write_i64(base_i, q, 0); q += 1 }
        ng := nq >> 2
        row_b := dim * 4
        mut vb := 0
        while vb < vn {
            mut bc := vn - vb
            if bc > 32 { bc = 32 }
            pv_blk := pvecs + (v0 + vb) * row_b
            mut g := 0
            while g < ng {
                _ := avx_l2_argmin4_f32(pv_blk, pqrys + (g * 4) * row_b, bc, dim, td, ti)
                mut k := 0
                while k < 4 {
                    qi := g * 4 + k
                    d := ptr_read_f64(td, k)
                    if d < ptr_read_f64(base_d, qi) {
                        ptr_write_f64(base_d, qi, d)
                        ptr_write_i64(base_i, qi, ptr_read_i64(ti, k) + v0 + vb)
                    }
                    k += 1
                }
                g += 1
            }
            vb += bc
        }
    }
}
fn b095_faiss_l2(pvecs: i64, pqrys: i64, pdsts: i64, nvecs: i64, nq: i64, dim: i64, args: i64, out: i64) -> i64 {
    unsafe {
        ptr_write_i64(args, 0, pvecs); ptr_write_i64(args, 1, pqrys); ptr_write_i64(args, 2, nvecs)
        ptr_write_i64(args, 3, nq);    ptr_write_i64(args, 4, dim);   ptr_write_i64(args, 5, pdsts)
        _ := ai_pool_dispatch(fn_addr(_w095), args)
        nt := ptr_read_i64(pdsts, 0)
        mut acc := 0.0; mut q := 0
        while q < nq {
            mut bd := ptr_read_f64(pdsts + 64, q)
            mut bi := ptr_read_i64(pdsts + 192, q)
            mut t := 1
            while t < nt {
                d := ptr_read_f64(pdsts + 64 + t * 256, q)
                if d < bd { bd = d; bi = ptr_read_i64(pdsts + 192 + t * 256, q) }
                t += 1
            }
            acc = acc + bd + (bi as f64) * 0.001
            q += 1
        }
        return (acc * 100.0) as i64
    }
}
fn _w096(tid: i64, nt: i64, pool: i64) {
    unsafe {
        pvecs := ptr_read_i64(pool, 4); pqrys := ptr_read_i64(pool, 5); nvecs := ptr_read_i64(pool, 6); nq := ptr_read_i64(pool, 7); bmat := ptr_read_i64(pool, 8)
        i0 := (tid * nvecs) / nt; i1 := ((tid + 1) * nvecs) / nt
        tb := bmat + tid * 64
        mut q := 0
        while q < nq { ptr_write_f64(tb, q, -1000000000.0); q += 1 }
        _ := avx_cosine_64d_f32(pvecs, pqrys, (i0 << 32) | i1, nq, tb)
    }
}
fn b096_cosine_topk(pvecs: i64, pqrys: i64, nvecs: i64, nq: i64, dim: i64, scratch: i64, args: i64) -> i64 {
    unsafe {
        mut t := 0
        while t < 16 * 8 { ptr_write_f64(scratch, t, -1000000000.0); t += 1 }
        ptr_write_i64(args, 0, pvecs); ptr_write_i64(args, 1, pqrys); ptr_write_i64(args, 2, nvecs); ptr_write_i64(args, 3, nq); ptr_write_i64(args, 4, scratch)
        _ := ai_pool_dispatch(fn_addr(_w096), args)
        mut acc := 0.0; mut q := 0
        while q < nq {
            qv := pqrys + q * dim * 4
            mut qn := 0.0; mut k := 0
            while k < dim { v := ptr_read_f32(qv, k); qn = qn + v * v; k += 1 }
            qinv := 1.0 / sqrt_f64(qn)
            mut best := -1000000000.0; t = 0
            while t < 16 { v := ptr_read_f64(scratch + t * 64, q); if v > best { best = v }; t += 1 }
            acc = acc + best * qinv
            q += 1
        }
        return (acc * 10000.0) as i64
    }
}

fn b097_llm_ffn(px: i64, pnw: i64, pnorm: i64, pw1: i64, pw2: i64, pgate: i64, pup: i64, pact: i64, n: i64) -> i64 {
    unsafe {
        dims := (n << 32) | n
        _ := avx_rmsnorm_f32(px, pnw, pnorm, n, 0.00001)
        _ := avx_gemv2_f32(pw1, pw2, pnorm, pgate, pup, dims)
        _ := avx_swiglu_f32(pgate, pup, pact, n)
        mut tot := 0.0; mut i := 0
        while i < n { tot = tot + ptr_read_f32(pact, i); i += 1 }
        return (tot * 1000.0) as i64
    }
}

// `_fast_exp_neg` defined above (IEEE-754 range-reduced 2^(-k)*exp(r), < 2.5e-10 relative error)
fn _w098(tid: i64, nt: i64, pool: i64) {
    unsafe {
        mat := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); scratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        wtbl := scratch
        rtmp := scratch + 4096 + tid * 8192
        utmp := rtmp + 4096
        r0 := (tid * n) / nt; r1 := ((tid + 1) * n) / nt
        mut acc := 0.0; mut r := r0
        while r < r1 {
            row := mat + r * n * 8
            _ := avx_row_max_sub_f64(row, utmp, n, 0)
            s := avx_exp_neg_f64(utmp, rtmp, n)
            acc = acc + avx_row_max_sub_f64(rtmp, wtbl, n, 1) / s
            r += 1
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b098_softmax_2d(mat: i64, n: i64, scratch: i64, args: i64, out: i64) -> i64 {
    unsafe {
        mut c := 0
        while c < n { ptr_write_f64(scratch, c, ((c % 17) as f64) + 1.0); c += 1 }
        return (_dispatch_reduce_f64(fn_addr(_w098), mat, n, scratch, 0, 0, 0, args, out) * 1000.0) as i64
    }
}

fn _axpy_f64_slice(dst: i64, src: i64, w: f64, d: i64) {
    unsafe {
        mut o1 := 0; mut o2 := 0; mut m := 0
        while m < d {
            cv := ptr_read_f64(dst, o1 + m)
            bv := ptr_read_f64(src, o2 + m)
            ptr_write_f64(dst, o1 + m, cv + w * bv)
            m += 1
        }
    }
}
fn _w099(tid: i64, nt: i64, pool: i64) {
    unsafe {
        meta := ptr_read_i64(pool, 4); seq := ptr_read_i64(pool, 5); d := ptr_read_i64(pool, 6); scratch := ptr_read_i64(pool, 7); out := ptr_read_i64(pool, 9)
        sc_buf := scratch + tid * 4096
        tot_r := seq << 2
        scale := 1.0 / sqrt_f64(d as f64)
        mut acc := 0.0
        while true {
            r0 := atomic_add_i64(pool, 216, 8)
            if r0 >= tot_r { break }
            mut r1 := r0 + 8; if r1 > tot_r { r1 = tot_r }
            acc = acc + avx_flash_attn_rows_f64(meta, sc_buf, (seq << 32) | d, (r0 << 32) | r1, scale)
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b099_flash_attn(pq: i64, pk: i64, pv: i64, seq: i64, d: i64, scratch: i64, args: i64, out: i64) -> i64 {
    unsafe {
        meta := args + 64
        ptr_write_i64(meta, 0, pq); ptr_write_i64(meta, 1, pk); ptr_write_i64(meta, 2, pv)
        return (_dispatch_reduce_f64(fn_addr(_w099), meta, seq, d, scratch, 0, 0, args, out) * 1000.0) as i64
    }
}

fn _w100_all(tid: i64, nt: i64, pool: i64) {
    unsafe {
        pts := ptr_read_i64(pool, 4); cent := ptr_read_i64(pool, 5); tsums := ptr_read_i64(pool, 6)
        tcnts := ptr_read_i64(pool, 7); npts := ptr_read_i64(pool, 8); fbarr := ptr_read_i64(pool, 9)
        cnorm := cent + 4096
        iters := ptr_read_i64(fbarr, 1)
        sbase := tsums + tid * 4096
        cbase := tcnts + tid * 128
        i0 := (tid * npts) / nt; i1 := ((tid + 1) * npts) / nt
        mut c := tid
        while c < 16 {
            cv := cent + c * 256
            ptr_write_f64(cnorm, c, _dot_f64_slice(cv, cv, 32))
            c += nt
        }
        mut ep := 1
        if tid == 0 {
            mut t := 1; while t < nt { mut sp := 0; while atomic_load_i64(fbarr, t << 3) < ep { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }; t += 1 }
            atomic_store_rel_i64(fbarr, 0, ep)
        } else {
            atomic_store_rel_i64(fbarr, tid << 3, ep)
            mut spw := 0; while atomic_load_i64(fbarr, 0) < ep { cpu_pause(); spw += 1; if (spw & 511) == 0 { thread_yield() } }
        }
        mut it := 0
        while it < iters {
            mem_set(sbase, 0, 4096); mem_set(cbase, 0, 128)
            _ := avx_kmeans_assign_f64(pts, cent, cnorm, sbase, cbase, i0, i1)
            ep += 1
            if tid == 0 {
                mut t := 1; while t < nt { mut sp := 0; while atomic_load_i64(fbarr, t << 3) < ep { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }; t += 1 }
                atomic_store_rel_i64(fbarr, 0, ep)
            } else {
                atomic_store_rel_i64(fbarr, tid << 3, ep)
                mut spw := 0; while atomic_load_i64(fbarr, 0) < ep { cpu_pause(); spw += 1; if (spw & 511) == 0 { thread_yield() } }
            }
            c = tid
            while c < 16 {
                mut cnt := 0; mut t := 0
                while t < nt { cnt += ptr_read_i64(tcnts + t * 128, c); t += 1 }
                if cnt > 0 {
                    inv := 1.0 / (cnt as f64)
                    mut m := 0
                    while m < 32 {
                        mut sm := 0.0; t = 0
                        while t < nt { sm = sm + ptr_read_f64(tsums + t * 4096 + c * 256, m); t += 1 }
                        ptr_write_f64(cent, c * 32 + m, sm * inv)
                        m += 1
                    }
                }
                if it + 1 < iters {
                    cv2 := cent + c * 256; ptr_write_f64(cnorm, c, _dot_f64_slice(cv2, cv2, 32))
                }
                c += nt
            }
            if it + 1 < iters {
                ep += 1
                if tid == 0 {
                    mut t := 1; while t < nt { mut sp := 0; while atomic_load_i64(fbarr, t << 3) < ep { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }; t += 1 }
                    atomic_store_rel_i64(fbarr, 0, ep)
                } else {
                    atomic_store_rel_i64(fbarr, tid << 3, ep)
                    mut spw := 0; while atomic_load_i64(fbarr, 0) < ep { cpu_pause(); spw += 1; if (spw & 511) == 0 { thread_yield() } }
                }
            }
            it += 1
        }
    }
}
fn b100_kmeans_lloyd(pts: i64, cent: i64, tsums: i64, tcnts: i64, npts: i64, iters: i64, fbarr: i64, args: i64) -> i64 {
    unsafe {
        mem_copy(cent, pts, 4096)
        mut t := 0; while t < 16 { ptr_write_i64(fbarr, t << 3, 0); t += 1 }
        ptr_write_i64(fbarr, 1, iters)
        ptr_write_i64(args, 0, pts); ptr_write_i64(args, 1, cent); ptr_write_i64(args, 2, tsums)
        ptr_write_i64(args, 3, tcnts); ptr_write_i64(args, 4, npts); ptr_write_i64(args, 5, fbarr)
        _ := ai_pool_dispatch_n(fn_addr(_w100_all), args, 4)
        mut s := 0.0; mut k := 0
        while k < 512 { s = s + ptr_read_f64(cent, k); k += 1 }
        return (s * 1000.0) as i64
    }
}

// ==================== Main Harness (100 Benchmarks) ====================

fn main() -> i64 {
    unsafe {
    // Reusable worker dispatch buffers + barrier + per-thread scratch (3.2 MB)
    args := mem_alloc_aligned(128)
    out  := mem_alloc_aligned(1024)
    barr := mem_alloc_aligned(1024)
    scratch := mem_alloc_aligned(16 * 196608 + 65536)

    // D1 Morton LUT + Mat4x4 inputs
    morton_lut := mem_alloc_aligned(1024 * 8 + 64)
    mut i := 0
    while i < 1024 {
        mut v := i
        v = (v ^ (v << 16)) & 0xFF0000FF; v = (v ^ (v << 8)) & 0x0300F00F
        v = (v ^ (v << 4)) & 0x030C30C3; v = (v ^ (v << 2)) & 0x09249249
        ptr_write_i64(morton_lut, i, v); i += 1
    }
    mat4_a := mem_alloc_aligned(32000 * 16 * 8 + 64); mat4_b := mem_alloc_aligned(32000 * 16 * 8 + 64)
    i = 0
    while i < 32000 * 16 {
        ptr_write_i64(mat4_a, i, ((i * 7 + 3) & 31) - 15)
        ptr_write_i64(mat4_b, i, ((i * 11 + 5) & 31) - 15)
        i += 1
    }

    // D2 SIMD shared arrays
    a_f64_1m := mem_alloc_aligned(1000000 * 8 + 64)
    b_f64_1m := mem_alloc_aligned(1000000 * 8 + 64)
    x_f32_1m := mem_alloc_aligned(1000000 * 4 + 64)
    y_f32_1m := mem_alloc_aligned(1000000 * 4 + 64)
    d_f32_1m := mem_alloc_aligned(1000000 * 4 + 64)
    src_i64_512k := mem_alloc_aligned(524288 * 8 + 64)
    dst_i64_512k := mem_alloc_aligned(524288 * 8 + 64)
    data_2m := mem_alloc_aligned(2000000 + 64)
    arr_i64_2m := mem_alloc_aligned(2000000 * 8 + 64)
    mat512_src := mem_alloc_aligned(512 * 512 * 8 + 64)
    mat512_dst := mem_alloc_aligned(512 * 512 * 8 + 64)
    i = 0
    while i < 1000000 {
        ptr_write_f64(a_f64_1m, i, ((i % 97) as f64) * 0.01 - 0.5)
        ptr_write_f64(b_f64_1m, i, ((i % 89) as f64) * 0.01 - 0.4)
        ptr_write_f32(x_f32_1m, i, ((i % 83) as f64) * 0.1 - 1.5)
        ptr_write_f32(y_f32_1m, i, ((i % 71) as f64) * 0.05 - 0.5)
        i += 1
    }
    i = 0; while i < 524288 { ptr_write_i64(src_i64_512k, i, ((i *% 17 +% 3) & 255) - 128); i += 1 }
    i = 0
    while i < 2000000 {
        ptr_write_u8(data_2m, i, (i * 31 + 17) & 255)
        ptr_write_i64(arr_i64_2m, i, (i *% 6364136223846793005 +% 1442695040888963407) >> 16)
        i += 1
