    i = 0; while i < 6 { ptr_write_u8(hex_tbl, 10 + i, 97 + i); ptr_write_u8(hex_dtbl, 97 + i, 10 + i); i += 1 }
    i = 0; while i < 524288 { ptr_write_u8(b512k_hex, i, (i * 29 + 7) & 255); i += 1 }

