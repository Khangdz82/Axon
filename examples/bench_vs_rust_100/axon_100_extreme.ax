fn _fnv1a_slice(p: i64, n: i64) -> i64 {
    unsafe {
        mut h := 0xCBF29CE484222325; mut i := 0
        while i < n { h = (h ^ ptr_read_u8(p, i)) *% 0x00000100000001B3; i += 1 }
        return h
    }
}
fn _w051(tid: i64, nt: i64, pool: i64) {
    unsafe {
        p := ptr_read_i64(pool, 4); nchunks := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        c0 := (tid * nchunks) / nt; c1 := ((tid + 1) * nchunks) / nt
        mut acc := 0; mut c := c0
        while c < c1 { acc = acc ^ _fnv1a_slice(p + c * 512, 512); c += 1 }
        ptr_write_i64(out, tid, acc)
    }
}
fn b051_fnv1a_batch(p: i64, nbytes: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_xor(fn_addr(_w051), p, nbytes / 512, 0, 0, 0, 0, args, out) }
}

fn b052_crc32(buf_p: i64, n: i64, tbl: i64) -> i64 {
    if n < 0 { return b052_crc32(buf_p, 0, tbl) }
    unsafe {
        mut crc := 0xFFFFFFFF; mut i := 0
        while i < n {
            idx := (crc ^ ptr_read_u8(buf_p, i)) & 255
            crc = ushr64(crc, 8) ^ ptr_read_i64(tbl, idx)
            i += 1
        }
        return (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
}

fn _sha256_ptr_words(data_p: i64, len: i64, out_h: i64) {
    // Reuses compiler hardware-accelerated `sha256_raw_digest` via stack-zero ByteBuf header trick?
    // Even safer: wrap a small ByteBuf copy OR direct `sha256_raw_digest`!
    b := buf_new(len + 16)
    unsafe {
        mem_copy((b as i64) + 16, data_p, len)
        ptr_write_i64(b as i64, 0, len)
    }
    h := sha256_raw_digest(b)
    unsafe {
        mut i := 0
        while i < 8 { ptr_write_i64(out_h, i, ibuf_get(h, i)); i += 1 }
    }
    buf_free(move h); buf_free(move b)
}
fn _w053(tid: i64, nt: i64, pool: i64) {
    unsafe {
        p := ptr_read_i64(pool, 4); nblks := ptr_read_i64(pool, 5); hscratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        hb := hscratch + tid * 128
        mut acc := 0; mut b := tid
        while b < nblks {
            _sha256_ptr_words(p + b * 16384, 16384, hb)
            acc = acc ^ ((ptr_read_i64(hb, 0) << 32) | (ptr_read_i64(hb, 1) & 0xFFFFFFFF))
            b += nt
        }
        ptr_write_i64(out, tid, acc)
    }
}
