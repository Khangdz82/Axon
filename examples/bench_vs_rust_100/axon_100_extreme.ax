    mut hp := 1000
    while hp + 12 < 2000000 {
        ptr_write_u8(hay_2m, hp, 65); ptr_write_u8(hay_2m, hp+1, 88); ptr_write_u8(hay_2m, hp+2, 79); ptr_write_u8(hay_2m, hp+3, 78)
        ptr_write_u8(hay_2m, hp+4, 95); ptr_write_u8(hay_2m, hp+5, 78); ptr_write_u8(hay_2m, hp+6, 69); ptr_write_u8(hay_2m, hp+7, 69)
        ptr_write_u8(hay_2m, hp+8, 68); ptr_write_u8(hay_2m, hp+9, 76); ptr_write_u8(hay_2m, hp+10, 69); ptr_write_u8(hay_2m, hp+11, 33)
        hp += 4096
    }
    jb := buf_new(30000 * 32)
    i = 0
    while i < 30000 {
        buf_push_str(jb, "{\"id\":"); buf_push_str(jb, str_from_i64(i))
        buf_push_str(jb, ",\"val\":"); buf_push_str(jb, str_from_i64((i * 7 + 3) % 10000)); buf_push_str(jb, "}\n")
        i += 1
