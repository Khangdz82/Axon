    q4_2k := mem_alloc_aligned(2048 * 64 * 20 + 64); q8_2k := mem_alloc_aligned(2048 * 64 * 36 + 64)
    i = 0; while i < 2048 { ptr_write_f32(act_2k, i, ((i % 31) as f64) * 0.02 - 0.3); i += 1 }
    mut qr := 0
    while qr < 2048 * 64 {
        off4 := q4_2k + qr * 20; ptr_write_f32(off4, 0, 0.05)
        mut bb := 0; while bb < 16 { ptr_write_u8(off4, 4 + bb, (qr + bb * 7) & 255); bb += 1 }
        off8 := q8_2k + qr * 36; ptr_write_f32(off8, 0, 0.01)
        bb = 0; while bb < 32 { ptr_write_u8(off8, 4 + bb, (((qr + bb * 5) % 251) - 125) & 255); bb += 1 }
        qr += 1
    }
    bitnet_w := mem_alloc_aligned(2048 * 2048 + 64)
    i = 0; while i < 2048 * 2048 { ptr_write_u8(bitnet_w, i, i % 3); i += 1 }
    faiss_v := mem_alloc_aligned(5000 * 128 * 4 + 64); faiss_q := mem_alloc_aligned(16 * 128 * 4 + 64); faiss_d := mem_alloc_aligned(5000 * 4 + 64)
    i = 0; while i < 5000 * 128 { ptr_write_f32(faiss_v, i, ((i % 53) as f64) * 0.02 - 0.5); i += 1 }
    i = 0; while i < 16 * 128 { ptr_write_f32(faiss_q, i, ((i % 47) as f64) * 0.02 - 0.4); i += 1 }
    cos_v := mem_alloc_aligned(4096 * 64 * 4 + 64); cos_q := mem_alloc_aligned(8 * 64 * 4 + 64)
    i = 0; while i < 4096 * 64 { ptr_write_f32(cos_v, i, ((i % 43) as f64) * 0.02 - 0.4 + 0.05); i += 1 }
    i = 0; while i < 8 * 64 { ptr_write_f32(cos_q, i, ((i % 37) as f64) * 0.02 - 0.3 + 0.05); i += 1 }
    llm_x := mem_alloc_aligned(1024 * 4 + 64); llm_nw := mem_alloc_aligned(1024 * 4 + 64); llm_norm := mem_alloc_aligned(1024 * 4 + 64)
    llm_w1 := mem_alloc_aligned(1024 * 1024 * 4 + 64); llm_w2 := mem_alloc_aligned(1024 * 1024 * 4 + 64)
    llm_gate := mem_alloc_aligned(1024 * 4 + 64); llm_up := mem_alloc_aligned(1024 * 4 + 64); llm_act := mem_alloc_aligned(1024 * 4 + 64)
    i = 0; while i < 1024 { ptr_write_f32(llm_x, i, ((i % 29) as f64) * 0.03 - 0.4); ptr_write_f32(llm_nw, i, 1.0 + ((i % 11) as f64) * 0.01); i += 1 }
    i = 0; while i < 1024 * 1024 { ptr_write_f32(llm_w1, i, ((i % 19) as f64) * 0.002 - 0.018); ptr_write_f32(llm_w2, i, ((i % 23) as f64) * 0.002 - 0.022); i += 1 }
    sm_mat := mem_alloc_aligned(384 * 384 * 8 + 64)
    i = 0; while i < 384 * 384 { ptr_write_f64(sm_mat, i, ((i % 61) as f64) * 0.05 - 1.5); i += 1 }
    att_q := mem_alloc_aligned(4 * 128 * 64 * 8 + 64); att_k := mem_alloc_aligned(4 * 128 * 64 * 8 + 64); att_v := mem_alloc_aligned(4 * 128 * 64 * 8 + 64)
    i = 0
    while i < 4 * 128 * 64 {
        ptr_write_f64(att_q, i, ((i % 37) as f64) * 0.03 - 0.5)
        ptr_write_f64(att_k, i, ((i % 41) as f64) * 0.03 - 0.6)
        ptr_write_f64(att_v, i, ((i % 43) as f64) * 0.03 - 0.6)
        i += 1
    }
