            h2 = (h2 ^ ushr64(h2, 33)) *% 0xff51afd7ed558ccd; h2 = (h2 ^ ushr64(h2, 33)) *% 0xc4ceb9fe1a85ec53; h2 = h2 ^ ushr64(h2, 33)
