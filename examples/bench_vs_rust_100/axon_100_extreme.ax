            mut v3 := 0x7465646279746573 ^ 0x0f0e0d0c0b0a0908
            base := mid << 5
            mut k := 0
            while k < 32 {
                m := ptr_read_i64(words, base + k)
                v3 = v3 ^ m
                mut r := 0
                while r < 2 {
                    v0 = v0 +% v1; v1 = (v1 << 13) | ushr64(v1, 51); v1 = v1 ^ v0; v0 = (v0 << 32) | ushr64(v0, 32)
                    v2 = v2 +% v3; v3 = (v3 << 16) | ushr64(v3, 48); v3 = v3 ^ v2
                    v0 = v0 +% v3; v3 = (v3 << 21) | ushr64(v3, 43); v3 = v3 ^ v0
                    v2 = v2 +% v1; v1 = (v1 << 17) | ushr64(v1, 47); v1 = v1 ^ v2; v2 = (v2 << 32) | ushr64(v2, 32)
                    r += 1
                }
                v0 = v0 ^ m
                k += 1
            }
            v2 = v2 ^ 255
            mut r := 0
            while r < 4 {
                v0 = v0 +% v1; v1 = (v1 << 13) | ushr64(v1, 51); v1 = v1 ^ v0; v0 = (v0 << 32) | ushr64(v0, 32)
                v2 = v2 +% v3; v3 = (v3 << 16) | ushr64(v3, 48); v3 = v3 ^ v2
                v0 = v0 +% v3; v3 = (v3 << 21) | ushr64(v3, 43); v3 = v3 ^ v0
                v2 = v2 +% v1; v1 = (v1 << 17) | ushr64(v1, 47); v1 = v1 ^ v2; v2 = (v2 << 32) | ushr64(v2, 32)
                r += 1
