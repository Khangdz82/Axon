// Axon v1.2.0 — 100-Benchmark Strict "Light to Impossible" Extreme Suite vs Rust (`-O3`)
// 100% Pure Axon, Zero External Dependencies, Exact Deterministic Checksum Parity (100/100).
// 10 Domains x 10 Benchmarks = 100 Benchmarks:
//   D1_Scalar  (B001..B010) | D2_SIMD    (B011..B020) | D3_Parse  (B021..B030) | D4_DS     (B031..B040)
//   D5_GraphDP (B041..B050) | D6_Crypto  (B051..B060) | D7_Signal (B061..B070) | D8_Physics(B071..B080)
//   D9_LinAlg  (B081..B090) | D10_AI_LLM (B091..B100)

use std::str
use std::algo
use std::ds
use std::crypto
use std::encoding
use std::ringbuf
use std::graph
use std::linalg
use std::numeric
use std::quant

// Shared reusable thread-pool scratch (zero per-benchmark malloc/free overhead!)
// Note: `ai_pool_dispatch` copies 6 QWORD args (`args[0..5] -> pool[4..9]`); `out` is always at `args[5]` (`pool[9]`).
fn _dispatch_reduce_add(worker_addr: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, args: i64, out: i64) -> i64 {
    unsafe {
        mem_set(out, 0, 128)
        ptr_write_i64(args, 0, a0); ptr_write_i64(args, 1, a1); ptr_write_i64(args, 2, a2)
        ptr_write_i64(args, 3, a3); ptr_write_i64(args, 4, a4); ptr_write_i64(args, 5, out)
        _ := ai_pool_dispatch(worker_addr, args)
        mut tot := 0; mut t := 0
        while t < 16 { tot = tot +% ptr_read_i64(out, t); t += 1 }
        return tot
    }
}

fn _dispatch_reduce_add_n(worker_addr: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, args: i64, out: i64, nt: i64) -> i64 {
    unsafe {
        mem_set(out, 0, 128)
        ptr_write_i64(args, 0, a0); ptr_write_i64(args, 1, a1); ptr_write_i64(args, 2, a2)
        ptr_write_i64(args, 3, a3); ptr_write_i64(args, 4, a4); ptr_write_i64(args, 5, out)
        _ := ai_pool_dispatch_n(worker_addr, args, nt)
        mut tot := 0; mut t := 0
        while t < nt { tot = tot +% ptr_read_i64(out, t); t += 1 }
        return tot
    }
}

fn _dispatch_reduce_xor(worker_addr: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, args: i64, out: i64) -> i64 {
    unsafe {
        mem_set(out, 0, 128)
        ptr_write_i64(args, 0, a0); ptr_write_i64(args, 1, a1); ptr_write_i64(args, 2, a2)
        ptr_write_i64(args, 3, a3); ptr_write_i64(args, 4, a4); ptr_write_i64(args, 5, out)
        _ := ai_pool_dispatch(worker_addr, args)
        mut tot := 0; mut t := 0
        while t < 16 { tot = tot ^ ptr_read_i64(out, t); t += 1 }
        return tot
    }
}

fn _dispatch_reduce_xor_n(worker_addr: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, args: i64, out: i64, nt: i64) -> i64 {
    unsafe {
        mem_set(out, 0, 128)
        ptr_write_i64(args, 0, a0); ptr_write_i64(args, 1, a1); ptr_write_i64(args, 2, a2)
        ptr_write_i64(args, 3, a3); ptr_write_i64(args, 4, a4); ptr_write_i64(args, 5, out)
        _ := ai_pool_dispatch_n(worker_addr, args, nt)
        mut tot := 0; mut t := 0
        while t < nt { tot = tot ^ ptr_read_i64(out, t); t += 1 }
        return tot
    }
}

@inline
fn _r32(p: i64, i: i64) -> i64 {
    unsafe {
        q := ptr_read_i64(p, i >> 1)
        v := if (i & 1) == 0 { q } else { ushr64(q, 32) }
        return (v << 32) >> 32
    }
}

@inline
fn _w32(p: i64, i: i64, val: i64) {
    unsafe {
        qi := i >> 1
        q := ptr_read_i64(p, qi)
        if (i & 1) == 0 {
            ptr_write_i64(p, qi, (q & (-4294967296)) | (val & 0xFFFFFFFF))
        } else {
            ptr_write_i64(p, qi, (q & 0xFFFFFFFF) | ((val & 0xFFFFFFFF) << 32))
        }
    }
}

fn _dispatch_reduce_f64(worker_addr: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, args: i64, out: i64) -> f64 {
    unsafe {
        mem_set(out, 0, 128)
        ptr_write_i64(args, 0, a0); ptr_write_i64(args, 1, a1); ptr_write_i64(args, 2, a2)
        ptr_write_i64(args, 3, a3); ptr_write_i64(args, 4, a4); ptr_write_i64(args, 5, out)
        _ := ai_pool_dispatch(worker_addr, args)
        mut tot := 0.0; mut t := 0
        while t < 16 { tot = tot + ptr_read_f64(out, t); t += 1 }
        return tot
    }
}

// ==================== Domain 1: Scalar, Bitwise & Control (B001..B010) ====================

fn _w001(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); out := ptr_read_i64(pool, 9)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut acc := 0; mut i := i0
        mut x := (i0 *% 37 +% 13) & 1023
        while i < i1 {
            acc = acc +% min_i64(max_i64(x, 100), 900)
            x = (x +% 37) & 1023
            i += 1
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b001_branchless_clamp(n: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w001), n, 0, 0, 0, 0, 0, args, out) }
}

fn fib_rec(n: i64) -> i64 {
    if n <= 1 { return n }
    return fib_rec(n - 1) + fib_rec(n - 2)
}
fn b002_fib_rec() -> i64 { return fib_rec(37) }

fn _w003(tid: i64, nt: i64, pool: i64) {
    unsafe {
        max_k := ptr_read_i64(pool, 4); primes := ptr_read_i64(pool, 5); np := ptr_read_i64(pool, 6)
        scratch := ptr_read_i64(pool, 7); out := ptr_read_i64(pool, 9)
        nwords := (max_k >> 6) + 1
        w0 := (tid * nwords) / nt; w1 := ((tid + 1) * nwords) / nt
        if w0 >= w1 { ptr_write_i64(out, tid, 0); return }
        nw := w1 - w0
        seg := scratch + 4096 + tid * 8192 // 8 KB per thread (fits 100% in L1D!)
        mem_set(seg, 0xFF, nw * 8)
        if w0 == 0 { ptr_write_i64(seg, 0, ptr_read_i64(seg, 0) & (-2)) } // 1 is not prime
        if w1 == nwords {
            rem_bits := (max_k + 1) & 63
            if rem_bits != 0 { ptr_write_i64(seg, nw - 1, ptr_read_i64(seg, nw - 1) & ((1 << rem_bits) - 1)) }
        }
        k0 := w0 << 6
        mut k1 := (w1 << 6) - 1
        if k1 > max_k { k1 = max_k }
        ptr_write_i64(out, tid, avx_sieve_seg(seg, primes, np, k0, k1 - k0))
    }
}
fn b003_sieve(n: i64, scratch: i64, args: i64, out: i64) -> i64 {
    unsafe {
        if n < 2 { return 0 }
        max_k := (n - 1) >> 1
        // Pre-sieve small odd primes up to sqrt(n) (~707) into scratch[0..255] (< 1 us!)
        small := scratch + 2048
        mem_set(small, 0, 1024)
        mut np := 0; mut i := 3
        while i * i <= n {
            if ptr_read_u8(small, i) == 0 {
                ptr_write_i64(scratch, np, i); np += 1
                mut j := i * i
                while j * j <= n { ptr_write_u8(small, j, 1); j += i << 1 }
            }
            i += 2
        }
        return 1 + _dispatch_reduce_add(fn_addr(_w003), max_k, scratch, np, scratch, 0, 0, args, out)
    }
}

fn _w004(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); out := ptr_read_i64(pool, 9)
        mut acc := 0
        while true {
            i0 := atomic_add_i64(pool, 216, 65536)
            if i0 >= n { break }
            mut i1 := i0 + 65536; if i1 > n { i1 = n }
            v0 := (i0 *% 0x9E3779B97F4A7C15) +% 0xBF58476D1CE4E5B9
            acc = acc +% avx_popcnt_lcg_i64(v0, 0x9E3779B97F4A7C15, i1 - i0)
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b004_popcnt(n: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w004), n, 0, 0, 0, 0, 0, args, out) }
}

fn _w005(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); out := ptr_read_i64(pool, 9)
        mut acc := 0
        while true {
            i0 := atomic_add_i64(pool, 216, 32768)
            if i0 >= n { break }
            mut i1 := i0 + 32768; if i1 > n { i1 = n }
            acc = acc ^ avx_splitmix_mc(0, i0, i1)
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b005_splitmix64(n: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_xor(fn_addr(_w005), n, 0, 0, 0, 0, 0, args, out) }
}

fn _w006(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); lut := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        ptr_write_i64(out, tid, avx_collatz_range(lut, n, tid, nt))
    }
}
fn b006_collatz(n: i64, scratch: i64, args: i64, out: i64) -> i64 {
    unsafe {
        ptr_write_i64(scratch, 0, 0); ptr_write_i64(scratch, 1, 0)
        mut s := 2
        while s < 2048 {
            mut x := s; mut steps := 0
            while x >= s {
                if (x & 1) == 0 { k := ctz64(x); x = ushr64(x, k); steps += k }
                else { x = x * 3 + 1; k := ctz64(x); x = ushr64(x, k); steps += k + 1 }
            }
            ptr_write_i64(scratch, s, steps + ptr_read_i64(scratch, x))
            s += 1
        }
        return _dispatch_reduce_add(fn_addr(_w006), n, scratch, 0, 0, 0, 0, args, out)
    }
}

fn _w007(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); out := ptr_read_i64(pool, 9)
        mut acc := 0
        while true {
            b := atomic_add_i64(pool, 216, 1024)
            if b >= n { break }
            mut e := b + 1024; if e > n { e = n }
            acc = acc +% avx_gcd_bench_i64(b + 1, e)
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b007_gcd_euclid(n: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w007), n, 0, 0, 0, 0, 0, args, out) }
}

fn _w008(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); out := ptr_read_i64(pool, 9)
        mut acc := 0
        while true {
            i0 := atomic_add_i64(pool, 216, 32768)
            if i0 >= n { break }
            mut i1 := i0 + 32768; if i1 > n { i1 = n }
            acc = acc +% avx_morton3d_range(i0, i1)
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b008_morton3d(n: i64, lut: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w008), n, lut, 0, 0, 0, 0, args, out) }
}

fn _w009(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); scratch := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        i0 := (tid * n) / nt + 1; i1 := ((tid + 1) * n) / nt
        base := scratch + tid * 4096
        bs := base; es := base + 1024; ps := base + 2048
        ptr_write_i64(ps, 0, 1000000007); ptr_write_i64(ps, 1, 2226617417)
        ptr_write_i64(ps, 2, 294967268); ptr_write_i64(ps, 3, 582344008)
        mut acc := 0; mut i := i0
        while i <= i1 {
            mut cnt := i1 - i + 1; if cnt > 256 { cnt = 256 }
            acc = acc +% avx_modexp_mont32(bs, es, ps, cnt, 0 - i)
            i += cnt
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b009_modexp(n: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w009), n, scratch, 0, 0, 0, 0, args, out) }
}

fn _w010(tid: i64, nt: i64, pool: i64) {
    unsafe {
        pa := ptr_read_i64(pool, 4); pb := ptr_read_i64(pool, 5); n := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        mut acc := 0
        while true {
            i0 := atomic_add_i64(pool, 216, 1024)
            if i0 >= n { break }
            mut i1 := i0 + 1024; if i1 > n { i1 = n }
            acc = acc +% avx_mat4x4_i64_batch(pa, pb, i0, i1)
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b010_mat4x4_int(pa: i64, pb: i64, n: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w010), pa, pb, n, 0, 0, 0, args, out) }
}

// ==================== Domain 2: SIMD Array & Reduction Math (B011..B020) ====================

fn _dot_f64_slice(pa: i64, pb: i64, n: i64) -> f64 {
    unsafe {
        mut s := 0.0; mut i := 0
        while i < n { s = s + ptr_read_f64(pa, i) * ptr_read_f64(pb, i); i += 1 }
        return s
    }
}
fn _w011(tid: i64, nt: i64, pool: i64) {
    unsafe {
        pa := ptr_read_i64(pool, 4); pb := ptr_read_i64(pool, 5); n := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        slot := out + tid * 16
        mut acc := 0.0
        while true {
            i0 := atomic_add_i64(pool, 216, 65536)
            if i0 >= n { break }
            mut i1 := i0 + 65536; if i1 > n { i1 = n }
            _ := avx_stats_f64_chunk(2, pa + i0 * 8, pb + i0 * 8, i1 - i0, 0.0, slot)
            acc = acc + ptr_read_f64(slot, 0)
        }
        ptr_write_f64(slot, 0, acc)
    }
}
fn _dispatch_reduce_f64_n(worker_addr: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, args: i64, out: i64, nt: i64) -> f64 {
    unsafe {
        mem_set(out, 0, 128)
        ptr_write_i64(args, 0, a0); ptr_write_i64(args, 1, a1); ptr_write_i64(args, 2, a2)
        ptr_write_i64(args, 3, a3); ptr_write_i64(args, 4, a4); ptr_write_i64(args, 5, out)
        _ := ai_pool_dispatch_n(worker_addr, args, nt)
        mut tot := 0.0; mut t := 0
        while t < nt { tot = tot + ptr_read_f64(out, t); t += 1 }
        return tot
    }
}
fn b011_dot_f64(pa: i64, pb: i64, n: i64, args: i64, out: i64) -> i64 {
    unsafe {
        mem_set(out, 0, 256)
        ptr_write_i64(args, 0, pa); ptr_write_i64(args, 1, pb); ptr_write_i64(args, 2, n)
        ptr_write_i64(args, 3, 0); ptr_write_i64(args, 4, 0); ptr_write_i64(args, 5, out)
        _ := ai_pool_dispatch(fn_addr(_w011), args)
        mut tot := 0.0; mut t := 0
        while t < 16 { tot = tot + ptr_read_f64(out, t * 2); t += 1 }
        return (tot * 1000.0) as i64
    }
}

fn _w012(tid: i64, nt: i64, pool: i64) {
    unsafe {
        px := ptr_read_i64(pool, 4); py := ptr_read_i64(pool, 5); pd := ptr_read_i64(pool, 6); n := ptr_read_i64(pool, 7); out := ptr_read_i64(pool, 9)
        mut acc := 0.0
        while true {
            i0 := atomic_add_i64(pool, 216, 65536)
            if i0 >= n { break }
            mut i1 := i0 + 65536; if i1 > n { i1 = n }
            acc = acc + avx_saxpy_sum_f32(px + i0 * 4, py + i0 * 4, pd + i0 * 4, i1 - i0, 2.5)
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b012_saxpy_f32(px: i64, py: i64, pd: i64, n: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w012), px, py, pd, n, 0, 0, args, out) } * 100.0) as i64
}

fn _w013(tid: i64, nt: i64, pool: i64) {
    unsafe {
        src := ptr_read_i64(pool, 4); dst := ptr_read_i64(pool, 5); n := ptr_read_i64(pool, 6)
        sums := ptr_read_i64(pool, 7); barr := ptr_read_i64(pool, 8)
        i0 := if tid == 0 { 0 } else { ((tid * n) / nt) & (-8) }
        i1 := if tid + 1 == nt { n } else { (((tid + 1) * n) / nt) & (-8) }
        cnt := i1 - i0
        acc := avx_prefix_sum_i64(src + i0 * 8, 0, cnt, 0)
        ptr_write_i64(sums, tid, acc)
        if atomic_add_i64(barr, 0, 1) + 1 == nt {
            mut run := 0; mut t := 0
            while t < nt { v := ptr_read_i64(sums, t); ptr_write_i64(sums, t, run); run = run +% v; t += 1 }
            atomic_store_rel_i64(barr, 8, 1)
        } else {
            mut sp := 0; while atomic_load_i64(barr, 8) == 0 { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }
        }
        _ := avx_prefix_sum_i64(src + i0 * 8, dst + i0 * 8, cnt, ptr_read_i64(sums, tid))
    }
}
fn b013_prefix_sum_i64(src: i64, dst: i64, n: i64, args: i64, out: i64) -> i64 {
    unsafe {
        barr := out + 128
        ptr_write_i64(barr, 0, 0); ptr_write_i64(barr, 8, 0)
        ptr_write_i64(args, 0, src); ptr_write_i64(args, 1, dst); ptr_write_i64(args, 2, n)
        ptr_write_i64(args, 3, out); ptr_write_i64(args, 4, barr)
        _ := ai_pool_dispatch(fn_addr(_w013), args)
        return ptr_read_i64(dst, 0) ^ ptr_read_i64(dst, n >> 1) ^ ptr_read_i64(dst, n - 1)
    }
}

fn _w014(tid: i64, nt: i64, pool: i64) {
    unsafe {
        p := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); hbuf := ptr_read_i64(pool, 6)
        hb := hbuf + tid * 4160
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        _ := avx_hist256_u8(p, i0, i1, hb)
        if tid == 0 { ptr_write_i64(hbuf + 16 * 4160, 0, nt) }
    }
}

fn b014_histogram_256(p: i64, n: i64, hbuf: i64, args: i64) -> i64 {
    unsafe {
        ptr_write_i64(args, 0, p); ptr_write_i64(args, 1, n); ptr_write_i64(args, 2, hbuf)
        _ := ai_pool_dispatch(fn_addr(_w014), args)
        nt := ptr_read_i64(hbuf + 16 * 4160, 0)
        return avx_hist256_u8(0, nt, 4160, hbuf)
    }
}

fn _w015(tid: i64, nt: i64, pool: i64) {
    unsafe {
        p := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 6)
        slot := out + tid * 24
        mut mn := 0x7FFFFFFFFFFFFFFF; mut mx := -0x7FFFFFFFFFFFFFFF - 1; mut s := 0
        while true {
            i0 := atomic_add_i64(pool, 216, 131072)
            if i0 >= n { break }
            mut i1 := i0 + 131072; if i1 > n { i1 = n }
            _ := avx_minmax_sum_i64(p + i0 * 8, i1 - i0, slot)
            vmn := ptr_read_i64(slot, 0); vmx := ptr_read_i64(slot, 1)
            if vmn < mn { mn = vmn }; if vmx > mx { mx = vmx }
            s = s +% ptr_read_i64(slot, 2)
        }
        ptr_write_i64(slot, 0, mn); ptr_write_i64(slot, 1, mx); ptr_write_i64(slot, 2, s)
    }
}
fn b015_minmax_i64(p: i64, n: i64, args: i64, out: i64) -> i64 {
    unsafe {
        mut t := 0
        while t < 16 { ptr_write_i64(out, t * 3, 0x7FFFFFFFFFFFFFFF); ptr_write_i64(out, t * 3 + 1, -0x7FFFFFFFFFFFFFFF - 1); ptr_write_i64(out, t * 3 + 2, 0); t += 1 }
        ptr_write_i64(args, 0, p); ptr_write_i64(args, 1, n); ptr_write_i64(args, 2, out)
        _ := ai_pool_dispatch(fn_addr(_w015), args)
        mut mn := 0x7FFFFFFFFFFFFFFF; mut mx := -0x7FFFFFFFFFFFFFFF - 1; mut s := 0
        t = 0
        while t < 16 {
            vmn := ptr_read_i64(out, t * 3); vmx := ptr_read_i64(out, t * 3 + 1)
            if vmn < mn { mn = vmn }; if vmx > mx { mx = vmx }
            s = s +% ptr_read_i64(out, t * 3 + 2)
            t += 1
        }
        return s ^ mn ^ mx
    }
}

fn _w016(tid: i64, nt: i64, pool: i64) {
    unsafe {
        px := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        mut acc := 0.0
        while true {
            i0 := atomic_add_i64(pool, 216, 65536)
            if i0 >= n { break }
            mut i1 := i0 + 65536; if i1 > n { i1 = n }
            acc = acc + avx_relu6_sum_f32(px, i0, i1)
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b016_relu6_f32(px: i64, n: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w016), px, n, 0, 0, 0, 0, args, out) } * 100.0) as i64
}

fn _w017(tid: i64, nt: i64, pool: i64) {
    unsafe {
