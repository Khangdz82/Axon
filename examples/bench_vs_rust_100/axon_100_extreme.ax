    km_sums := mem_alloc_aligned(16 * 16 * 32 * 8 + 64); km_cnts := mem_alloc_aligned(16 * 16 * 8 + 64)
    i = 0; while i < 1536 * 32 { ptr_write_f64(km_pts, i, (((i * 17 + 13) % 1009) as f64) * 0.002 - 1.0); i += 1 }

    times := ibuf_new(112)
    chks  := ibuf_new(112)
    mut t0 := 0

    // Commit physical pages of already-allocated output buffers (prevents multi-thread OS demand-zero page-fault contention)
    mut pfi := 0
    while pfi < 1000000 { ptr_write_f32(d_f32_1m, pfi, 0.0); pfi += 1024 }
    pfi = 0; while pfi < 524288 { ptr_write_i64(dst_i64_512k, pfi, 0); pfi += 512 }
    pfi = 0; while pfi < 512 * 512 { ptr_write_f64(mat512_dst, pfi, 0.0); pfi += 512 }
    pfi = 0; while pfi < 500000 { ptr_write_i64(topk_dst, pfi, 0); pfi += 512 }
    pfi = 0; while pfi < 512 * 512 { ptr_write_f32(blur_tmp, pfi, 0.0); ptr_write_f32(blur_dst, pfi, 0.0); pfi += 1024 }
    pfi = 0; while pfi < 256 * 256 { ptr_write_f64(heat_b, pfi, 0.0); pfi += 512 }
    pfi = 0; while pfi < 384 * 384 { ptr_write_f32(c384, pfi, 0.0); pfi += 1024 }
    pfi = 0; while pfi < 256 * 256 { ptr_write_f64(c256, pfi, 0.0); pfi += 512 }
    pfi = 0; while pfi < 400000 { ptr_write_i64(scratch, pfi, 0); pfi += 512 }
    pfi = 0; while pfi < 5000 { ptr_write_f32(faiss_d, pfi, 0.0); pfi += 1024 }
    pfi = 0; while pfi < 32768 { ptr_write_f64(cg_buf, pfi, 0.0); pfi += 512 }
    pfi = 0; while pfi < 512 * 512 { ptr_write_f64(rk_a, pfi, 0.0); pfi += 512 }
    pfi = 0; while pfi < 700000 { ptr_write_u8(b64_enc, pfi, 0); pfi += 4096 }
    pfi = 0; while pfi < 524288 { ptr_write_u8(b64_dec, pfi, 0); ptr_write_u8(hex_dec, pfi, 0); pfi += 4096 }
    pfi = 0; while pfi < 1048576 { ptr_write_u8(hex_enc, pfi, 0); pfi += 4096 }
    pfi = 0; while pfi < 16000 { ptr_write_i64(bfs_dist, pfi, 0); ptr_write_i64(bfs_q, pfi, 0); pfi += 512 }
    pfi = 0; while pfi < 32000 { ptr_write_f64(sp_y, pfi, 0.0); pfi += 512 }
    pfi = 0; while pfi < 16000 { ptr_write_f64(pr_a, pfi, 0.0); ptr_write_f64(pr_b, pfi, 0.0); pfi += 512 }
    pfi = 0; while pfi < 160 * 160 { ptr_write_f64(chol_l, pfi, 0.0); ptr_write_i64(fw_d, pfi, 0); pfi += 512 }
    pfi = 0; while pfi < 128 * 128 { ptr_write_f64(qr_q, pfi, 0.0); pfi += 512 }
    pfi = 0; while pfi < 256 * 256 { ptr_write_f64(heat_a, pfi, 0.0); pfi += 512 }
    pfi = 0; while pfi < 48000 { ptr_write_i64((work_sort as i64) + 16, pfi, 0); pfi += 512 }
    pfi = 0; while pfi < 8192 { ptr_write_f64(km_sums, pfi, 0.0); pfi += 512 }

    // Warm up thread pool AFTER page-fault pre-commit so all workers are 100% booted & spinning hot for B001!
