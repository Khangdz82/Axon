fn _w066(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); gx := ptr_read_i64(pool, 5); gw := ptr_read_i64(pool, 6); scratch := ptr_read_i64(pool, 7); out := ptr_read_i64(pool, 9)
        tb := scratch + tid * 4096
        a_arr := tb; b_arr := tb + 2048
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut r97 := i0 % 97; mut r53 := i0 % 53
        mut acc := 0.0; mut i := i0
        while i < i1 {
            mut m := i1 - i; if m > 256 { m = 256 }
            mut j := 0
            while j < m {
                ptr_write_f64(a_arr, j, 0.5 + (r97 as f64) * 0.05)
                ptr_write_f64(b_arr, j, 0.1 + (r53 as f64) * 0.02)
                r97 += 1; if r97 == 97 { r97 = 0 }
                r53 += 1; if r53 == 53 { r53 = 0 }
                j += 1
            }
            acc = acc + avx_gl16_poly_f64(a_arr, b_arr, gx, gw, m)
            i += m
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b066_gl16_quad(n: i64, gx: i64, gw: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w066), n, gx, gw, scratch, 0, 0, args, out) } * 1000.0) as i64
}

fn _w067(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); out := ptr_read_i64(pool, 9)
        mut acc := 0
        while true {
            i0 := atomic_add_i64(pool, 216, 32768)
            if i0 >= n { break }
            mut i1 := i0 + 32768; if i1 > n { i1 = n }
            acc = acc +% avx_splitmix_mc(1, i0, i1)
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b067_mc_pi(n: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w067), n, 0, 0, 0, 0, 0, args, out) }
}

@inline
fn _fast_exp_neg(u: f64) -> f64 {
    if u > 50.0 { return 0.0 }
    k := (u * 1.4426950408889634 + 0.5) as i64
    r := (k as f64) * 0.6931471805599453 - u
    p := 1.0 + r * (1.0 + r * (0.5 + r * (0.16666666666666666 + r * (0.041666666666666664
        + r * (0.008333333333333333 + r * (0.001388888888888889
        + r * (0.0001984126984126984 + r * 0.000024801587301587302)))))))
    return f64_from_bits((1023 - k) << 52) * p
}

fn _norm_cdf_poly(x: f64) -> f64 {
    ax := abs_f64(x)
    t := 1.0 / (1.0 + 0.2316419 * ax)
    poly := t * (0.319381530 + t * (-0.356563782 + t * (1.781477937 + t * (-1.821255978 + t * 1.330274429))))
    pdf := 0.3989422804014327 * _fast_exp_neg(0.5 * ax * ax)
    if x >= 0.0 { return 1.0 - pdf * poly }
    return pdf * poly
}
fn _w068(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); scratch := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        tb := scratch + tid * 8192
        ln_tbl := tb; sqt_tbl := tb + 512; disc_tbl := tb + 768
        s_a := tb + 1024; t_a := tb + 2048; v_a := tb + 3072
        lnsk_a := tb + 4096; sqt_a := tb + 5120; disc_a := tb + 6144
        mut k := 0
        while k < 41 {
            s := 80.0 + (k as f64)
            y := (s - 100.0) / (s + 100.0); y2 := y * y
            ptr_write_f64(ln_tbl, k, 2.0 * y * (1.0 + y2 * (0.3333333333333333 + y2 * (0.2 + y2 * (0.14285714285714285 + y2 * (0.1111111111111111 + y2 * 0.09090909090909091))))))
            k += 1
        }
        k = 0
        while k < 16 {
            t := 0.25 + (k as f64) * 0.1
            ptr_write_f64(sqt_tbl, k, sqrt_f64(t))
            ptr_write_f64(s_a, k, 0.05 * t)
            k += 1
        }
        _ := avx_exp_neg_f64(s_a, disc_tbl, 16)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut r41 := i0 % 41; mut r20 := i0 % 20
        mut acc := 0.0; mut i := i0
        while i < i1 {
            mut m := i1 - i; if m > 128 { m = 128 }
            mut j := 0
            while j < m {
                ti := (i + j) & 15
                ptr_write_f64(s_a, j, 80.0 + (r41 as f64))
                ptr_write_f64(t_a, j, 0.25 + (ti as f64) * 0.1)
                ptr_write_f64(v_a, j, 0.15 + (r20 as f64) * 0.01)
                ptr_write_f64(lnsk_a, j, ptr_read_f64(ln_tbl, r41))
                ptr_write_f64(sqt_a, j, ptr_read_f64(sqt_tbl, ti))
                ptr_write_f64(disc_a, j, ptr_read_f64(disc_tbl, ti))
                r41 += 1; if r41 == 41 { r41 = 0 }
                r20 += 1; if r20 == 20 { r20 = 0 }
                j += 1
            }
            acc = acc + avx_black_scholes_f64(s_a, t_a, v_a, lnsk_a, sqt_a, disc_a, m)
            i += m
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b068_black_scholes(n: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w068), n, scratch, 0, 0, 0, 0, args, out) } * 100.0) as i64
}

fn _w069(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); scratch := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        tb := scratch + tid * 2048
        a_arr := tb; b_arr := tb + 1024
        mut j := 0
        while j < 128 {
            ptr_write_f64(a_arr, j, 1.0 + ((j & 63) as f64) * 0.05)
            ptr_write_f64(b_arr, j, 2.0 + (j as f64) * 0.1)
            j += 1
        }
        nb := n >> 7
        b0 := (tid * nb) / nt; b1 := ((tid + 1) * nb) / nt
        mut acc := 0.0; mut b := b0
        while b < b1 {
            acc = acc + avx_newton_cubic_f64(a_arr, b_arr, 128, 12)
            b += 1
        }
        rem := n & 127
        if tid == 0 and rem > 0 {
            acc = acc + avx_newton_cubic_f64(a_arr, b_arr, rem, 12)
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b069_newton_cubic(n: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w069), n, scratch, 0, 0, 0, 0, args, out) } * 1000.0) as i64
}

fn _w070(tid: i64, nt: i64, pool: i64) {
    unsafe {
        src := ptr_read_i64(pool, 4); sw := ptr_read_i64(pool, 5); dw := ptr_read_i64(pool, 6)
        ix_p := ptr_read_i64(pool, 7); dx_p := ptr_read_i64(pool, 8); out := ptr_read_i64(pool, 9)
        scale := ((sw - 1) as f64) / (dw as f64)
        y0 := (tid * dw) / nt; y1 := ((tid + 1) * dw) / nt
        ptr_write_f64(out, tid, avx_bilinear_rows_f64(src, ix_p, dx_p, sw, dw, y0, y1, scale))
    }
}
fn b070_bilinear_interp(src: i64, sw: i64, dw: i64, scratch: i64, args: i64, out: i64) -> i64 {
    unsafe {
        scale := ((sw - 1) as f64) / (dw as f64)
        ix_p := scratch; dx_p := scratch + dw * 8
        mut x := 0
        while x < dw {
            fx := (x as f64) * scale; ix := fx as i64
            ptr_write_i64(ix_p, x, ix); ptr_write_f64(dx_p, x, fx - (ix as f64))
            x += 1
        }
        return (_dispatch_reduce_f64(fn_addr(_w070), src, sw, dw, ix_p, dx_p, 0, args, out) * 100.0) as i64
    }
}

// ==================== Domain 8: Physics, Geometry & Graphics (B071..B080) ====================

fn _nbody_force_range(px: i64, py: i64, pz: i64, vx: i64, vy: i64, vz: i64, pm: i64, n: i64, i0: i64, i1: i64) {
    unsafe {
        dt := 0.01
        mut i := i0
        while i < i1 {
            xi := ptr_read_f64(px, i); yi := ptr_read_f64(py, i); zi := ptr_read_f64(pz, i)
            mut ax := 0.0; mut ay := 0.0; mut az := 0.0
            mut j := 0
            while j < n {
                dx := ptr_read_f64(px, j) - xi
                dy := ptr_read_f64(py, j) - yi
                dz := ptr_read_f64(pz, j) - zi
                d2 := dx * dx + dy * dy + dz * dz + 0.01
                inv := 1.0 / (d2 * sqrt_f64(d2))
                s := ptr_read_f64(pm, j) * inv
                ax = ax + dx * s
                ay = ay + dy * s
                az = az + dz * s
                j += 1
            }
            ptr_write_f64(vx, i, ptr_read_f64(vx, i) + ax * dt)
            ptr_write_f64(vy, i, ptr_read_f64(vy, i) + ay * dt)
            ptr_write_f64(vz, i, ptr_read_f64(vz, i) + az * dt)
            i += 1
        }
    }
}
fn _w071(tid: i64, nt: i64, pool: i64) {
    unsafe {
        meta := ptr_read_i64(pool, 4); barr := ptr_read_i64(pool, 5)
        n := ptr_read_i64(pool, 6); steps := ptr_read_i64(pool, 7)
        _ := avx_nbody_par_f64(meta, barr, n, steps, tid, nt)
    }
}

fn b071_nbody_3d(n: i64, steps: i64, nb_buf: i64, barr: i64, args: i64) -> i64 {
    unsafe {
        stride := n * 8
        px := nb_buf; py := px + stride; pz := py + stride
        vx := pz + stride; vy := vx + stride; vz := vy + stride; pm := vz + stride
        npx := pm + stride; npy := npx + stride; npz := npy + stride
        meta := npz + stride
        fbarr := meta + 128 // 8 x 64B cache-line-isolated lock-free barrier flags inside nb_buf!
        mut i := 0
        while i < n {
            fi := (i + 1) as f64
            ptr_write_f64(px, i, fi * 0.13); ptr_write_f64(py, i, fi * 0.27 - 10.0); ptr_write_f64(pz, i, fi * 0.09 - 5.0)
            ptr_write_f64(vx, i, 0.0); ptr_write_f64(vy, i, 0.0); ptr_write_f64(vz, i, 0.0)
            ptr_write_f64(pm, i, 0.01 + ((i % 7) as f64) * 0.005)
            i += 1
        }
        ptr_write_i64(meta, 0, px); ptr_write_i64(meta, 1, py); ptr_write_i64(meta, 2, pz)
        ptr_write_i64(meta, 3, vx); ptr_write_i64(meta, 4, vy); ptr_write_i64(meta, 5, vz); ptr_write_i64(meta, 6, pm)
        ptr_write_i64(meta, 7, npx); ptr_write_i64(meta, 8, npy); ptr_write_i64(meta, 9, npz)
        ptr_write_i64(meta, 10, meta + 1024) // Enable Symmetric Newton's 3rd Law (j > i) 2x-faster AVX2 fastpath!
        mut t := 0
        while t < 8 { ptr_write_i64(fbarr + t * 64, 0, 0); t += 1 }
        ptr_write_i64(args, 0, meta); ptr_write_i64(args, 1, fbarr); ptr_write_i64(args, 2, n); ptr_write_i64(args, 3, steps)
        _ := ai_pool_dispatch_n(fn_addr(_w071), args, 6)
        fx := if (steps & 1) == 0 { px } else { npx }
        fy := if (steps & 1) == 0 { py } else { npy }
        fz := if (steps & 1) == 0 { pz } else { npz }
        mut sum := 0.0; i = 0
        while i < n { sum = sum + ptr_read_f64(fx, i) + ptr_read_f64(fy, i) + ptr_read_f64(fz, i); i += 1 }
        return (sum * 100.0) as i64
    }
}

fn _w072(tid: i64, nt: i64, pool: i64) {
    unsafe {
        size := ptr_read_i64(pool, 4); out := ptr_read_i64(pool, 9)
        ptr_write_i64(out, tid, avx_julia_rows_f64(size, tid, nt, (3 << 32) | 256))
    }
}
fn b072_mandelbrot(size: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w072), size, 0, 0, 0, 0, 0, args, out) }
}

fn _julia_pt(zr0: f64, zi0: f64) -> i64 {
    mut zr := zr0; mut zi := zi0; mut it := 0
    while it < 256 {
        zr2 := zr * zr; zi2 := zi * zi
        if zr2 + zi2 > 4.0 { break }
        zi = 2.0 * zr * zi + 0.156
        zr = zr2 - zi2 - 0.8
        it += 1
    }
    return it
}
fn _w073(tid: i64, nt: i64, pool: i64) {
    unsafe {
        size := ptr_read_i64(pool, 4); out := ptr_read_i64(pool, 9)
        mut tot := avx_julia_rows_f64(size, tid, nt, (2 << 32) | 256)
        // Exact x=0 column edge correction for central symmetry (x,y)<->(size-x,size-y) (111 pixels across nt threads!)
        if (size & 1) == 0 {
            half := size >> 1
            inv := 1.0 / (size as f64)
            mut y := 1 + tid
            while y < half {
                y0 := ((y as f64) * 2.6) * inv - 1.3
                y0_opp := (((size - y) as f64) * 2.6) * inv - 1.3
                tot += _julia_pt(-1.5, y0_opp) - _julia_pt(-1.5, y0)
                y += nt
            }
        }
        ptr_write_i64(out, tid, tot)
    }
}
fn b073_julia(size: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w073), size, 0, 0, 0, 0, 0, args, out) }
}

fn _ray_row_sphere(dx0: f64, dy_sy: f64, dy2: f64, skx: f64, skz: f64, skc: f64, cols: i64) -> i64 {
    mut hits := 0; mut dx := dx0; mut c := 0
    while c < cols {
        b := (dx * skx + dy_sy) + skz
        if b * b >= ((dx * dx + dy2) + 1.0) * skc { hits += 1 }
        dx = dx + 0.005
        c += 1
    }
    return hits
}
fn _w074(tid: i64, nt: i64, pool: i64) {
    unsafe {
        nrays := ptr_read_i64(pool, 4); sph := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        nrows := nrays / 320
        mut hits := 0; mut ry := tid
        while ry < nrows {
            dy := (ry as f64) * 0.005 - 0.75
            hits += avx_ray_row_spheres_f64(sph, f64_to_bits(dy), 320, 32)
            ry += nt
        }
        ptr_write_i64(out, tid, hits)
    }
}
fn b074_ray_sphere(nrays: i64, sph: i64, args: i64, out: i64) -> i64 {
