fn _w064(tid: i64, nt: i64, pool: i64) {
    unsafe {
        chans := ptr_read_i64(pool, 4); len := ptr_read_i64(pool, 5); scratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        ng := chans >> 2
        g0 := (tid * ng) / nt; g1 := ((tid + 1) * ng) / nt
        base := scratch + tid * 4096
        x4 := base; st := base + 2048; co := base + 2368
        ptr_write_f64(co, 0, 0.25); ptr_write_f64(co, 1, 0.50); ptr_write_f64(co, 2, 0.25)
        ptr_write_f64(co, 3, 0.35); ptr_write_f64(co, 4, -0.12)
        mut acc := 0.0; mut g := g0
        while g < g1 {
            c0 := g << 2
            k0 := c0 * 17; k1 := (c0 + 1) * 17; k2 := (c0 + 2) * 17; k3 := (c0 + 3) * 17
            mut i := 0
            while i < 64 {
                ptr_write_f64(x4, i * 4,     (((k0 + i) & 63) as f64) * 0.03 - 0.9)
                ptr_write_f64(x4, i * 4 + 1, (((k1 + i) & 63) as f64) * 0.03 - 0.9)
                ptr_write_f64(x4, i * 4 + 2, (((k2 + i) & 63) as f64) * 0.03 - 0.9)
                ptr_write_f64(x4, i * 4 + 3, (((k3 + i) & 63) as f64) * 0.03 - 0.9)
                i += 1
            }
            mem_set(st, 0, 256)
            mut rem := len
            while rem >= 64 {
                acc = acc + avx_biquad4_f64(x4, st, 64, co)
                rem -= 64
            }
            if rem > 0 { acc = acc + avx_biquad4_f64(x4, st, rem, co) }
            g += 1
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b064_iir_biquad(chans: i64, len: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w064), chans, len, scratch, 0, 0, 0, args, out) } * 100.0) as i64
}

fn _w065(tid: i64, nt: i64, pool: i64) {
    unsafe {
        ntraj := ptr_read_i64(pool, 4); steps := ptr_read_i64(pool, 5); scratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        ng := ntraj >> 2
        g0 := (tid * ng) / nt; g1 := ((tid + 1) * ng) / nt
        cnt := g1 - g0
        if cnt <= 0 { ptr_write_f64(out, tid, 0.0); return }
        base := scratch + tid * 4096
        pa := base; xyz := base + 64
        ptr_write_f64(pa, 0, 10.0); ptr_write_f64(pa, 1, 28.0); ptr_write_f64(pa, 2, 8.0 / 3.0)
        ptr_write_f64(pa, 3, 0.005); ptr_write_f64(pa, 4, 0.0025); ptr_write_f64(pa, 5, 0.005 / 6.0)
        mut g := 0
        while g < cnt {
            tbase := (g0 + g) << 2
            gb := xyz + g * 96
            mut l := 0
            while l < 4 {
                tf := (tbase + l) as f64
                ptr_write_f64(gb, l, 1.0 + tf * 0.02)
                ptr_write_f64(gb + 32, l, 1.0 - tf * 0.01)
                ptr_write_f64(gb + 64, l, 1.0 + tf * 0.015)
                l += 1
            }
            g += 1
        }
        ptr_write_f64(out, tid, avx_lorenz_rk4_f64(xyz, cnt, steps, pa))
    }
}
fn b065_rk4_lorenz(ntraj: i64, steps: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w065), ntraj, steps, scratch, 0, 0, 0, args, out) } * 100.0) as i64
