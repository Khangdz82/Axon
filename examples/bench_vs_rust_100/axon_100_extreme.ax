        ptr_write_f64(poly_buf + 512, i, sl)
        pj = i; i += 1
    }

    // D9 LinAlg inputs
    a384 := mem_alloc_aligned(384 * 384 * 4 + 64); b384 := mem_alloc_aligned(384 * 384 * 4 + 64); c384 := mem_alloc_aligned(384 * 384 * 4 + 64)
    i = 0; while i < 384 * 384 { ptr_write_f32(a384, i, ((i % 37) as f64) * 0.01 - 0.18); ptr_write_f32(b384, i, ((i % 41) as f64) * 0.01 - 0.20); i += 1 }
    a256 := mem_alloc_aligned(256 * 256 * 8 + 64); b256 := mem_alloc_aligned(256 * 256 * 8 + 64); c256 := mem_alloc_aligned(256 * 256 * 8 + 64)
    i = 0; while i < 256 * 256 { ptr_write_f64(a256, i, ((i % 37) as f64) * 0.01 - 0.18); ptr_write_f64(b256, i, ((i % 41) as f64) * 0.01 - 0.20); i += 1 }
    sp_n := 32768
    sp_rp := mem_alloc_aligned((sp_n + 4) * 8); sp_ci := mem_alloc_aligned(sp_n * 8 * 4 + 64)
    sp_val := mem_alloc_aligned(sp_n * 8 * 8 + 64); sp_x := mem_alloc_aligned(sp_n * 8 + 64); sp_y := mem_alloc_aligned(sp_n * 8 + 64)
    i = 0
    while i < sp_n {
        ptr_write_i64(sp_rp, i, i * 8)
        ptr_write_f64(sp_x, i, ((i % 53) as f64) * 0.02 - 0.5)
