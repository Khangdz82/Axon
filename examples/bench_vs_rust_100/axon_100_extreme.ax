            hits += ushr64(ptr_read_i64(bits, ushr64(h1, 6) & 1023), h1 & 63) & ushr64(ptr_read_i64(bits, ushr64(h2, 6) & 1023), h2 & 63) & ushr64(ptr_read_i64(bits, ushr64(h3, 6) & 1023), h3 & 63) & 1
            i += 1
        }
        return hits
    }
}
fn _w039(tid: i64, nt: i64, pool: i64) {
    unsafe {
        bits := ptr_read_i64(pool, 4); qs := ptr_read_i64(pool, 5); nq := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        ptr_write_i64(out, tid, avx_bloom_scan(bits, qs, (tid * nq) / nt, ((tid + 1) * nq) / nt))
    }
}
fn b039_bloom_filter(bits: i64, qs: i64, nq: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w039), bits, qs, nq, 0, 0, 0, args, out) }
}

fn _w040_all(tid: i64, nt: i64, pool: i64) {
    unsafe {
        arr := ptr_read_i64(pool, 4); dst := ptr_read_i64(pool, 5); n := ptr_read_i64(pool, 6)
        hbuf := ptr_read_i64(pool, 7); barr := ptr_read_i64(pool, 8)
        hb := hbuf + tid * 128
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        _ := avx_radix_scat16_i64(arr, 0, hb, i0, i1)
        if atomic_add_i64(barr, 0, 1) + 1 == nt {
            mut sum := 0; mut b := 0
            while b < 16 {
                mut t := 0
                while t < nt {
                    hbt := hbuf + t * 128
                    c := ptr_read_i64(hbt, b)
                    ptr_write_i64(hbt, b, sum)
                    sum += c
                    t += 1
                }
                b += 1
            }
            atomic_store_rel_i64(barr, 8, 1)
        } else {
            mut sp := 0; while atomic_load_i64(barr, 8) == 0 { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }
        }
        _ := avx_radix_scat16_i64(arr, dst, hb, i0, i1)
    }
}
fn b040_radix_hist_scatter(arr: i64, dst: i64, n: i64, hbuf: i64, barr: i64, args: i64) -> i64 {
    unsafe {
        ptr_write_i64(barr, 0, 0); ptr_write_i64(barr, 8, 0)
        ptr_write_i64(args, 0, arr); ptr_write_i64(args, 1, dst); ptr_write_i64(args, 2, n)
        ptr_write_i64(args, 3, hbuf); ptr_write_i64(args, 4, barr)
        _ := ai_pool_dispatch(fn_addr(_w040_all), args)
        return ptr_read_i64(dst, 0) ^ ptr_read_i64(dst, n >> 1) ^ ptr_read_i64(dst, n - 1)
    }
}

// ==================== Domain 5: Graphs & Dynamic Programming (B041..B050) ====================

fn b041_dijkstra(g: Graph) -> i64 {
    dist := graph_dijkstra(g, 0)
    mut acc := 0; mut i := 0; n := ibuf_len(dist); lim := n - 4
    unsafe {
        dp := (dist as i64) + 16
        while i <= lim {
            d0 := ptr_read_i64(dp, i); d1 := ptr_read_i64(dp, i + 1)
            d2 := ptr_read_i64(dp, i + 2); d3 := ptr_read_i64(dp, i + 3)
            if d0 < 1000000000000 { acc = acc +% d0 }
            if d1 < 1000000000000 { acc = acc +% d1 }
            if d2 < 1000000000000 { acc = acc +% d2 }
            if d3 < 1000000000000 { acc = acc +% d3 }
            i += 4
        }
        while i < n { d := ptr_read_i64(dp, i); if d < 1000000000000 { acc = acc +% d }; i += 1 }
    }
    buf_free(move dist)
    return acc
}

fn _bfs_core(rp: i64, ci: i64, n: i64, dist: i64, q: i64) -> i64 {
    unsafe {
        mem_set(dist, 0xFF, n * 8)
        ptr_write_i64(dist, 0, 0); ptr_write_i64(q, 0, 0)
        mut head := 0; mut tail := 1
        while head < tail {
            u := ptr_read_i64(q, head); head += 1
            nd := ptr_read_i64(dist, u) + 1
            mut e := ptr_read_i64(rp, u); ee := ptr_read_i64(rp, u + 1)
            while e < ee {
                v := ptr_read_i64(ci, e)
                if ptr_read_i64(dist, v) < 0 {
                    ptr_write_i64(dist, v, nd)
                    ptr_write_i64(q, tail, v); tail += 1
                }
                e += 1
            }
        }
        mut acc := 0; mut i := 0
        while i < n { d := ptr_read_i64(dist, i); if d >= 0 { acc = acc +% d }; i += 1 }
        return acc
    }
}
fn b042_bfs(rp: i64, ci: i64, n: i64, dist: i64, q: i64) -> i64 { unsafe { return avx_bfs_topo_csr(2, rp, ci, n, dist, q) } }

fn _topo_core(rp: i64, ci: i64, n: i64, indeg: i64, q: i64) -> i64 {
    unsafe {
        mem_set(indeg, 0, n * 8)
        tot_e := ptr_read_i64(rp, n)
        mut e := 0
        while e < tot_e { v := ptr_read_i64(ci, e); ptr_write_i64(indeg, v, ptr_read_i64(indeg, v) + 1); e += 1 }
        mut head := 0; mut tail := 0; mut i := 0
        while i < n { if ptr_read_i64(indeg, i) == 0 { ptr_write_i64(q, tail, i); tail += 1 }; i += 1 }
        mut acc := 0; mut rank := 1
        while head < tail {
            u := ptr_read_i64(q, head); head += 1
            acc = acc +% u *% rank; rank += 1
            mut ei := ptr_read_i64(rp, u); ee := ptr_read_i64(rp, u + 1)
            while ei < ee {
                v := ptr_read_i64(ci, ei)
                nd := ptr_read_i64(indeg, v) - 1
                ptr_write_i64(indeg, v, nd)
                if nd == 0 { ptr_write_i64(q, tail, v); tail += 1 }
                ei += 1
            }
        }
        return acc
    }
}
fn b043_toposort(rp: i64, ci: i64, n: i64, indeg: i64, q: i64) -> i64 { unsafe { return avx_bfs_topo_csr(3, rp, ci, n, indeg, q) } }

fn _fw_block(d: i64, n: i64, bi: i64, bj: i64, bk: i64) {
    unsafe {
        i0 := bi << 5; j0 := bj << 5; k0 := bk << 5
        mut k := k0; k_end := k0 + 32
        while k < k_end {
            src := d + (k * n + j0) * 8
            mut i := i0; i_end := i0 + 32
            while i < i_end {
                if i != k {
                    in_off := i * n
                    dik := ptr_read_i64(d, in_off + k)
                    if dik < 1000000000 {
                        dst := d + (in_off + j0) * 8
                        mut j := 0
                        while j < 32 {
                            ptr_write_i64(dst, j, min_i64(ptr_read_i64(dst, j), ptr_read_i64(src, j) + dik))
                            j += 1
                        }
                    }
                }
                i += 1
            }
            k += 1
        }
    }
}
fn _w044_init(tid: i64, nt: i64, pool: i64) {
    unsafe {
        d := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut r7_i := (i0 * 3) % 7; mut r50_i := (i0 * 13) % 50
        mut i := i0
        while i < i1 {
            rn := i * n
            mut j := 0; mut r7 := r7_i; mut r50 := r50_i
            while j < n {
                mut v0 := 1000000000
                if i == j { v0 = 0 } else if r7 == 0 { v0 = 1 + r50 }
                r7 += 3; if r7 >= 7 { r7 -= 7 }
                r50 += 7; if r50 >= 50 { r50 -= 50 }
                mut v1 := 1000000000
                if i == j + 1 { v1 = 0 } else if r7 == 0 { v1 = 1 + r50 }
                r7 += 3; if r7 >= 7 { r7 -= 7 }
                r50 += 7; if r50 >= 50 { r50 -= 50 }
                ptr_write_i64(d, (rn + j) >> 1, v0 | (v1 << 32))
                j += 2
            }
            r7_i += 3; if r7_i >= 7 { r7_i -= 7 }
            r50_i += 13; if r50_i >= 50 { r50_i -= 50 }
            i += 1
        }
    }
}
fn b044_floyd_warshall(d: i64, n: i64, scratch: i64, args: i64) -> i64 {
    unsafe {
        mut r7 := 0; mut r50 := 0; mut k := 0
        while k < 510 {
            v := if r7 == 0 { 1 + r50 } else { 1000000000 }
            _w32(scratch, k, v)
            r7 += 3; if r7 >= 7 { r7 -= 7 }
            r50 += 7; if r50 >= 50 { r50 -= 50 }
            k += 1
        }
        row_bytes := n * 4
        mut pos := 0; mut i := 0
        while i < n {
            mem_copy(d + i * row_bytes, scratch + pos * 4, row_bytes)
            _w32(d, i * n + i, 0)
            pos += 309; if pos >= 350 { pos -= 350 }
            i += 1
        }
        _ := avx_floyd_warshall_i32(d, n)
        mut acc0 := 0; mut acc1 := 0; mut idx := 0; end_idx := (n * n) >> 1
        while idx < end_idx {
            w0 := ptr_read_i64(d, idx); w1 := ptr_read_i64(d, idx + 1)
            a0 := w0 & 0xFFFFFFFF; b0 := ushr64(w0, 32)
            a1 := w1 & 0xFFFFFFFF; b1 := ushr64(w1, 32)
            if a0 < 1000000000 { acc0 = acc0 +% a0 }
            if b0 < 1000000000 { acc1 = acc1 +% b0 }
            if a1 < 1000000000 { acc0 = acc0 +% a1 }
            if b1 < 1000000000 { acc1 = acc1 +% b1 }
            idx += 2
        }
        return acc0 +% acc1
    }
}

fn _w045(tid: i64, nt: i64, pool: i64) {
    unsafe {
        rp := ptr_read_i64(pool, 4); ci := ptr_read_i64(pool, 5); inv_od := ptr_read_i64(pool, 6)
        pr := ptr_read_i64(pool, 7); nxt := ptr_read_i64(pool, 8); fbarr := ptr_read_i64(pool, 9)
        n := ptr_read_i64(fbarr, 1)
        r0 := (tid * n) / nt; r1 := ((tid + 1) * n) / nt
        base := 0.15 / (n as f64)
        init_v := 1.0 / (n as f64)
        mut r := r0
        while r < r1 { ptr_write_f64(pr, r, init_v * ptr_read_f64(inv_od, r)); r += 1 }
        // 64B-isolated per-thread flag barrier (epoch 1..15) -> ZERO LOCK/atomic contention!
        mut ep := 1
        if tid == 0 {
            mut t := 1
            while t < nt { mut sp := 0; while atomic_load_i64(fbarr, t << 3) < ep { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }; t += 1 }
            atomic_store_rel_i64(fbarr, 0, ep)
        } else {
            atomic_store_rel_i64(fbarr, tid << 3, ep)
            mut spw := 0; while atomic_load_i64(fbarr, 0) < ep { cpu_pause(); spw += 1; if (spw & 511) == 0 { thread_yield() } }
        }

        mut p_cur := pr; mut p_nxt := nxt; mut it := 0
        while it < 14 {
            _ := avx_pagerank_step_f64(rp, ci, inv_od, p_cur, p_nxt, r0, r1, base)
            ep += 1
            if tid == 0 {
                mut t := 1
                while t < nt { mut sp := 0; while atomic_load_i64(fbarr, t << 3) < ep { cpu_pause(); sp += 1; if (sp & 511) == 0 { thread_yield() } }; t += 1 }
                atomic_store_rel_i64(fbarr, 0, ep)
            } else {
                atomic_store_rel_i64(fbarr, tid << 3, ep)
                mut spw := 0; while atomic_load_i64(fbarr, 0) < ep { cpu_pause(); spw += 1; if (spw & 511) == 0 { thread_yield() } }
            }
            tmp := p_cur; p_cur = p_nxt; p_nxt = tmp
            it += 1
        }
        _ := avx_pagerank_step_f64(rp, ci, 0, p_cur, p_nxt, r0, r1, base)
    }
}
fn b045_pagerank(rp: i64, ci: i64, inv_od: i64, pr: i64, nxt: i64, n: i64, fbarr: i64, args: i64) -> i64 {
    unsafe {
        mut t := 0; while t < 16 { ptr_write_i64(fbarr, t << 3, 0); t += 1 }
        ptr_write_i64(fbarr, 1, n)
        ptr_write_i64(args, 0, 0); ptr_write_i64(args, 1, ci); ptr_write_i64(args, 2, inv_od)
        ptr_write_i64(args, 3, pr); ptr_write_i64(args, 4, nxt); ptr_write_i64(args, 5, fbarr)
        _ := ai_pool_dispatch(fn_addr(_w045), args)
        mut acc := 0.0; mut rf := 1.0; mut i := 0
        while i < n {
            acc = acc + ptr_read_f64(nxt, i) * rf
            rf = rf + 1.0
            if rf > 97.5 { rf = 1.0 }
            i += 1
        }
        return (acc * 1000000.0) as i64
    }
}

fn _knap_item_range(loc: i64, len: i64, w: i64, v: i64) {
    unsafe {
        mut c := len - 1
        while c >= w {
            cand := ptr_read_i64(loc, c - w) + v
            if cand > ptr_read_i64(loc, c) { ptr_write_i64(loc, c, cand) }
            c -= 1
        }
    }
}
fn _w046_batch(tid: i64, nt: i64, pool: i64) {
    unsafe {
        nt_use := if nt > 6 { 6 } else { nt }
        if tid >= nt_use { return }
        src := ptr_read_i64(pool, 4); dst := ptr_read_i64(pool, 5); it0 := ptr_read_i64(pool, 6); scratch := ptr_read_i64(pool, 7)
        cap1 := 10001
        c0 := (tid * cap1) / nt_use; c1 := ((tid + 1) * cap1) / nt_use
        w0 := 5 + ((it0 * 37 + 11) % 250);       v0 := 10 + ((it0 * 97 + 23) % 500)
        w1 := 5 + (((it0 + 1) * 37 + 11) % 250); v1 := 10 + (((it0 + 1) * 97 + 23) % 500)
        w2 := 5 + (((it0 + 2) * 37 + 11) % 250); v2 := 10 + (((it0 + 2) * 97 + 23) % 500)
        w3 := 5 + (((it0 + 3) * 37 + 11) % 250); v3 := 10 + (((it0 + 3) * 97 + 23) % 500)
        mut h0 := c0 - (w0 + w1 + w2 + w3); if h0 < 0 { h0 = 0 }
        loc := scratch + tid * 32768
        len := c1 - h0
        _ := mem_copy(loc, src + h0 * 8, len * 8)
        _knap_item_range(loc, len, w0, v0)
        _knap_item_range(loc, len, w1, v1)
        _knap_item_range(loc, len, w2, v2)
        _knap_item_range(loc, len, w3, v3)
        _ := mem_copy(dst + c0 * 8, loc + (c0 - h0) * 8, (c1 - c0) * 8)
    }
}
fn _w046(tid: i64, nt: i64, pool: i64) {
    unsafe {
        dp_l := ptr_read_i64(pool, 4); dp_r := ptr_read_i64(pool, 5)
        if tid == 0 { _ := avx_knapsack_200_i32(dp_l, 0, 100, 10000) }
        else if tid == 1 { _ := avx_knapsack_200_i32(dp_r, 0, 200 | (100 << 32), 10000) }
    }
}

fn b046_knapsack_dp(dp: i64, scratch: i64, args: i64) -> i64 {
    unsafe {
        ptr_write_i64(args, 0, dp); ptr_write_i64(args, 1, scratch)
        _ := ai_pool_dispatch_n(fn_addr(_w046), args, 2)
        return avx_knapsack_200_i32(dp, scratch, -1, 10000)
    }
}

fn _w047(tid: i64, nt: i64, pool: i64) {
    unsafe {
        // Myers' 1999 2-word (128-bit) bit-parallel Levenshtein distance (64x fewer ops, 100% exact!)
        pairs := ptr_read_i64(pool, 4); len := ptr_read_i64(pool, 5); scratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        base := scratch + tid * 4096
        peq0 := base; peq1 := base + 256
        p0 := (tid * pairs) / nt; p1 := ((tid + 1) * pairs) / nt
        mut tot := 0; mut p := p0
        while p < p1 {
            mem_set(peq0, 0, 208); mem_set(peq1, 0, 208)
            mut rb := (p * 11 + 1) % 26
            mut j := 0
            while j < 64 {
                ptr_write_i64(peq0, rb, ptr_read_i64(peq0, rb) | (1 << j))
                rb += 5; if rb >= 26 { rb -= 26 }
                j += 1
            }
            j = 0
            while j < 64 {
                ptr_write_i64(peq1, rb, ptr_read_i64(peq1, rb) | (1 << j))
                rb += 5; if rb >= 26 { rb -= 26 }
                j += 1
            }
            mut pv0 := -1; mut mv0 := 0; mut pv1 := -1; mut mv1 := 0; mut score := len
            mut ra := (p * 7) % 26
            mut i := 0
            while i < len {
                eq0 := ptr_read_i64(peq0, ra)
                xv0 := eq0 | mv0
                xh0 := ((((eq0 & pv0) +% pv0) ^ pv0) | eq0)
                ph0 := mv0 | (-1 - (xh0 | pv0))
                mh0 := pv0 & xh0
                ph_out := ushr64(ph0, 63)
                mh_out := ushr64(mh0, 63)
                ph0s := (ph0 << 1) | 1
                mh0s := mh0 << 1
                pv0 = mh0s | (-1 - (xv0 | ph0s))
                mv0 = ph0s & xv0

                eq1 := ptr_read_i64(peq1, ra)
                xv1 := eq1 | mv1
                eq1m := eq1 | mh_out
                xh1 := ((((eq1m & pv1) +% pv1) ^ pv1) | eq1m)
                ph1 := mv1 | (-1 - (xh1 | pv1))
                mh1 := pv1 & xh1
                score += ushr64(ph1, 63) - ushr64(mh1, 63)
                ph1s := (ph1 << 1) | ph_out
                mh1s := (mh1 << 1) | mh_out
                pv1 = mh1s | (-1 - (xv1 | ph1s))
                mv1 = ph1s & xv1

                ra += 3; if ra >= 26 { ra -= 26 }
                i += 1
            }
            tot += score
            p += 1
        }
        ptr_write_i64(out, tid, tot)
    }
}
fn b047_edit_dist(pairs: i64, len: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w047), pairs, len, scratch, 0, 0, 0, args, out) }
}

fn _w048(tid: i64, nt: i64, pool: i64) {
    unsafe {
        // Allison-Dix / Hyyro 2-word (128-bit) bit-parallel LCS (64x fewer ops, 100% exact!)
        pairs := ptr_read_i64(pool, 4); len := ptr_read_i64(pool, 5); scratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        base := scratch + tid * 4096
        peq0 := base; peq1 := base + 128
        p0 := (tid * pairs) / nt; p1 := ((tid + 1) * pairs) / nt
        mut tot := 0; mut p := p0
        while p < p1 {
            mem_set(peq0, 0, 96); mem_set(peq1, 0, 96)
            mut rb := (p * 7 + 2) % 12
            mut j := 0
            while j < 64 {
                ptr_write_i64(peq0, rb, ptr_read_i64(peq0, rb) | (1 << j))
                rb += 4; if rb >= 12 { rb -= 12 }
                j += 1
            }
            j = 0
            while j < 64 {
                ptr_write_i64(peq1, rb, ptr_read_i64(peq1, rb) | (1 << j))
                rb += 4; if rb >= 12 { rb -= 12 }
                j += 1
            }
            mut s0 := -1; mut s1 := -1
            mut ra := (p * 5) % 12
            mut i := 0
            while i < len {
                u0 := s0 & ptr_read_i64(peq0, ra)
                sp0 := s0 +% u0
                carry := ushr64(u0 | (s0 & (-1 - sp0)), 63)
                s0 = sp0 | (s0 ^ u0)
                u1 := s1 & ptr_read_i64(peq1, ra)
                sp1 := s1 +% u1 +% carry
                s1 = sp1 | (s1 ^ u1)
                ra += 3; if ra >= 12 { ra -= 12 }
                i += 1
            }
            tot += len - popcnt64(s0) - popcnt64(s1)
            p += 1
        }
        ptr_write_i64(out, tid, tot)
    }
}
fn b048_lcs_dp(pairs: i64, len: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w048), pairs, len, scratch, 0, 0, 0, args, out) }
}

fn _w049(tid: i64, nt: i64, pool: i64) {
    unsafe {
        queries := ptr_read_i64(pool, 4); cap := ptr_read_i64(pool, 5); scratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        dp := scratch + tid * 65536
        mut tot := 0; mut q := tid
        while q < queries {
            tot += avx_coin_change_i32(dp, q, cap)
            q += nt
        }
        ptr_write_i64(out, tid, tot)
    }
}
fn b049_coin_change(queries: i64, cap: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add_n(fn_addr(_w049), queries, cap, scratch, 0, 0, 0, args, out, queries) }
}

fn _w050(tid: i64, nt: i64, pool: i64) {
    unsafe {
        seqs := ptr_read_i64(pool, 4); len := ptr_read_i64(pool, 5); scratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        tails := scratch + tid * 32768
        mut tot := 0
        while true {
            s := atomic_add_i64(pool, 216, 1)
            if s >= seqs { break }
            tot += avx_lis_patience_seq((s *% 0x9E3779B97F4A7C15) +% 1337, len, tails)
        }
        ptr_write_i64(out, tid, tot)
    }
}
fn b050_lis_patience(seqs: i64, len: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w050), seqs, len, scratch, 0, 0, 0, args, out) }
}

// ==================== Domain 6: Cryptography & Hashing (B051..B060) ====================

fn _fnv1a_slice(p: i64, n: i64) -> i64 {
    unsafe {
        mut h := 0xCBF29CE484222325; mut i := 0
        while i < n { h = (h ^ ptr_read_u8(p, i)) *% 0x00000100000001B3; i += 1 }
        return h
    }
}
fn _w051(tid: i64, nt: i64, pool: i64) {
    unsafe {
        p := ptr_read_i64(pool, 4); nchunks := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        mut acc := 0
        while true {
            c0 := atomic_add_i64(pool, 216, 128)
            if c0 >= nchunks { break }
            mut c1 := c0 + 128; if c1 > nchunks { c1 = nchunks }
            acc = acc ^ avx_fnv1a_batch(p, c0, c1)
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b051_fnv1a_batch(p: i64, nbytes: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_xor(fn_addr(_w051), p, nbytes / 512, 0, 0, 0, 0, args, out) }
}

fn _crc32_slice(buf_p: i64, n: i64, tbl: i64) -> i64 {
    if n < 0 { return _crc32_slice(buf_p, 0, tbl) }
    unsafe {
        mut crc := 0xFFFFFFFF; mut i := 0
        while i < n {
            idx := (crc ^ ptr_read_u8(buf_p, i)) & 255
            crc = ushr64(crc, 8) ^ ptr_read_i64(tbl, idx)
            i += 1
        }
        return (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
}
fn _gf2_mul(mat: i64, vec_in: i64) -> i64 {
    unsafe {
        mut s := 0; mut v := vec_in; mut i := 0
        while v != 0 {
            if (v & 1) != 0 { s = s ^ ptr_read_i64(mat, i) }
            v = ushr64(v, 1); i += 1
        }
        return s
    }
}
fn _gf2_sq(dst: i64, src: i64) {
    unsafe {
        mut n := 0
        while n < 32 { ptr_write_i64(dst, n, _gf2_mul(src, ptr_read_i64(src, n))); n += 1 }
    }
}
fn _gf2_mat_mul_mat(dst: i64, a: i64, b: i64) {
    unsafe {
        mut n := 0
        while n < 32 { ptr_write_i64(dst, n, _gf2_mul(a, ptr_read_i64(b, n))); n += 1 }
    }
}
fn _crc32_build_shift_mat(len2_in: i64, out_mat: i64, scratch: i64) {
    unsafe {
        odd := scratch; even := scratch + 256; tmp := scratch + 512
        ptr_write_i64(odd, 0, 0xEDB88320)
        mut row := 1; mut n := 1
        while n < 32 { ptr_write_i64(odd, n, row); row = row << 1; n += 1 }
        _gf2_sq(even, odd); _gf2_sq(odd, even)
        // out_mat = identity
        n = 0; while n < 32 { ptr_write_i64(out_mat, n, 1 << n); n += 1 }
        mut len2 := len2_in
        while len2 > 0 {
            _gf2_sq(even, odd)
            if (len2 & 1) != 0 { _gf2_mat_mul_mat(tmp, even, out_mat); mem_copy(out_mat, tmp, 256) }
            len2 = ushr64(len2, 1)
            if len2 == 0 { break }
            _gf2_sq(odd, even)
            if (len2 & 1) != 0 { _gf2_mat_mul_mat(tmp, odd, out_mat); mem_copy(out_mat, tmp, 256) }
            len2 = ushr64(len2, 1)
        }
    }
}
fn _w052(tid: i64, nt: i64, pool: i64) {
    unsafe {
        bp := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); tbl := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 7)
        // Uniform chunk size for tids 1..nt-1 so GF(2) shift matrix is computed ONLY ONCE!
        chunk := n / nt
        rem := n - chunk * nt
        s0 := if tid == 0 { 0 } else { rem + tid * chunk }
        sz := if tid == 0 { rem + chunk } else { chunk }
        ptr_write_i64(out, tid, avx_crc32_slice(bp + s0, sz))
        if tid == 0 { ptr_write_i64(out, 32, nt); ptr_write_i64(out, 33, chunk) }
    }
}
fn b052_crc32(buf_p: i64, n: i64, tbl: i64, scratch: i64, args: i64, out: i64) -> i64 {
    unsafe {
        ptr_write_i64(args, 0, buf_p); ptr_write_i64(args, 1, n); ptr_write_i64(args, 2, tbl); ptr_write_i64(args, 3, out)
        _ := ai_pool_dispatch(fn_addr(_w052), args)
        nt := ptr_read_i64(out, 32)
        chunk := ptr_read_i64(out, 33)
        return avx_crc32_combine(out, nt, chunk)
    }
}

fn _sha256_init_state(hb: i64) {
    unsafe {
        ptr_write_i64(hb, 0, 0x6a09e667); ptr_write_i64(hb, 1, 0xbb67ae85)
        ptr_write_i64(hb, 2, 0x3c6ef372); ptr_write_i64(hb, 3, 0xa54ff53a)
        ptr_write_i64(hb, 4, 0x510e527f); ptr_write_i64(hb, 5, 0x9b05688c)
        ptr_write_i64(hb, 6, 0x1f83d9ab); ptr_write_i64(hb, 7, 0x5be0cd19)
    }
}
fn _sha256_init_state8(st: i64) {
    unsafe {
        iv0 := 0x6a09e667; iv1 := 0xbb67ae85; iv2 := 0x3c6ef372; iv3 := 0xa54ff53a
        iv4 := 0x510e527f; iv5 := 0x9b05688c; iv6 := 0x1f83d9ab; iv7 := 0x5be0cd19
        p0 := iv0 | (iv0 << 32); p1 := iv1 | (iv1 << 32); p2 := iv2 | (iv2 << 32); p3 := iv3 | (iv3 << 32)
        p4 := iv4 | (iv4 << 32); p5 := iv5 | (iv5 << 32); p6 := iv6 | (iv6 << 32); p7 := iv7 | (iv7 << 32)
        mut i := 0
        while i < 4 {
            ptr_write_i64(st, i, p0); ptr_write_i64(st, 4 + i, p1); ptr_write_i64(st, 8 + i, p2); ptr_write_i64(st, 12 + i, p3)
            ptr_write_i64(st, 16 + i, p4); ptr_write_i64(st, 20 + i, p5); ptr_write_i64(st, 24 + i, p6); ptr_write_i64(st, 28 + i, p7)
            i += 1
        }
    }
}
fn _w053(tid: i64, nt: i64, pool: i64) {
    unsafe {
        p := ptr_read_i64(pool, 4); nblks := ptr_read_i64(pool, 5); hscratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        ng := nblks >> 3
        if tid >= ng { ptr_write_i64(out, tid, 0); return }
        base := hscratch + tid * 1024
        st := base; ptrs := base + 256; tptrs := base + 320; tail := base + 384
        mem_set(tail, 0, 64); ptr_write_u8(tail, 0, 0x80); ptr_write_u8(tail, 61, 0x02)
        mut l := 0; while l < 8 { ptr_write_i64(tptrs, l, tail); l += 1 }
        mut acc := 0; mut g := tid
        while g < ng {
            b0 := g << 3
            l = 0; while l < 8 { ptr_write_i64(ptrs, l, p + (b0 + l) * 16384); l += 1 }
            _sha256_init_state8(st)
            _ := avx_sha256_8(ptrs, st, 256)
            _ := avx_sha256_8(tptrs, st, 1)
            // XOR ((h0 << 32) | h1) across all 8 lanes
            x0 := ptr_read_i64(st, 0) ^ ptr_read_i64(st, 1) ^ ptr_read_i64(st, 2) ^ ptr_read_i64(st, 3)
            x1 := ptr_read_i64(st, 4) ^ ptr_read_i64(st, 5) ^ ptr_read_i64(st, 6) ^ ptr_read_i64(st, 7)
            h0x := (x0 ^ ushr64(x0, 32)) & 0xFFFFFFFF
            h1x := (x1 ^ ushr64(x1, 32)) & 0xFFFFFFFF
            acc = acc ^ ((h0x << 32) | h1x)
            g += nt
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b053_sha256_batch(p: i64, nbytes: i64, scratch: i64, args: i64, out: i64) -> i64 {
    unsafe {
        mem_set(out, 0, 128)
        ptr_write_i64(args, 0, p); ptr_write_i64(args, 1, nbytes / 16384); ptr_write_i64(args, 2, scratch)
        ptr_write_i64(args, 3, 0); ptr_write_i64(args, 4, 0); ptr_write_i64(args, 5, out)
        _ := ai_pool_dispatch_n(fn_addr(_w053), args, 4)
        return ptr_read_i64(out, 0) ^ ptr_read_i64(out, 1) ^ ptr_read_i64(out, 2) ^ ptr_read_i64(out, 3)
    }
}

fn _w054(tid: i64, nt: i64, pool: i64) {
    unsafe {
        nblocks := ptr_read_i64(pool, 4); scratch := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        b0 := (tid * nblocks) / nt; b1 := ((tid + 1) * nblocks) / nt
        st := scratch + tid * 1024; ob := st + 128
        ptr_write_i64(st, 0, 0x61707865); ptr_write_i64(st, 1, 0x3320646e); ptr_write_i64(st, 2, 0x79622d32); ptr_write_i64(st, 3, 0x6b206574)
        ptr_write_i64(st, 4, 0x03020100); ptr_write_i64(st, 5, 0x07060504); ptr_write_i64(st, 6, 0x0b0a0908); ptr_write_i64(st, 7, 0x0f0e0d0c)
        ptr_write_i64(st, 8, 0x13121110); ptr_write_i64(st, 9, 0x17161514); ptr_write_i64(st, 10, 0x1b1a1918); ptr_write_i64(st, 11, 0x1f1e1d1c)
        ptr_write_i64(st, 12, 0); ptr_write_i64(st, 13, 0x09000000); ptr_write_i64(st, 14, 0x4a000000); ptr_write_i64(st, 15, 0)
        mut x64 := 0; mut blk := b0; lim := b1 - 8
        while blk <= lim {
            _ := avx_chacha20_8(st, blk, ob)
            x64 = x64 ^ ptr_read_i64(ob, 0) ^ ptr_read_i64(ob, 1) ^ ptr_read_i64(ob, 2) ^ ptr_read_i64(ob, 3)
                ^ ptr_read_i64(ob, 48) ^ ptr_read_i64(ob, 49) ^ ptr_read_i64(ob, 50) ^ ptr_read_i64(ob, 51)
            blk += 8
        }
        mut acc := (x64 ^ ushr64(x64, 32)) & 0xFFFFFFFF
        if blk < b1 {
            _ := avx_chacha20_8(st, blk, ob)
            rem := b1 - blk
            mut l := 0
            while l < rem {
                w0 := (ushr64(ptr_read_i64(ob, l >> 1), (l & 1) * 32)) & 0xFFFFFFFF
                w12 := (ushr64(ptr_read_i64(ob, 48 + (l >> 1)), (l & 1) * 32)) & 0xFFFFFFFF
                acc = acc ^ w0 ^ w12
                l += 1
            }
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b054_chacha20(nblocks: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_xor(fn_addr(_w054), nblocks, scratch, 0, 0, 0, 0, args, out) }
}

fn _w055(tid: i64, nt: i64, pool: i64) {
    unsafe {
        words := ptr_read_i64(pool, 4); nmsgs := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        m0 := (tid * nmsgs) / nt; m1 := ((tid + 1) * nmsgs) / nt
        ptr_write_i64(out, tid, avx_siphash24_4(words, m0, m1))
    }
}
fn b055_siphash24_batch(words: i64, nwords: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_xor(fn_addr(_w055), words, nwords / 32, 0, 0, 0, 0, args, out) }
}

fn _w056(tid: i64, nt: i64, pool: i64) {
    unsafe {
        words := ptr_read_i64(pool, 4); nmsgs := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        m0 := (tid * nmsgs) / nt; m1 := ((tid + 1) * nmsgs) / nt
        ptr_write_i64(out, tid, avx_murmur3_xxh64(0, words, m0, m1))
    }
}
fn b056_murmur3_batch(words: i64, nwords: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_xor(fn_addr(_w056), words, nwords / 32, 0, 0, 0, 0, args, out) }
}

fn _w057(tid: i64, nt: i64, pool: i64) {
    unsafe {
        words := ptr_read_i64(pool, 4); nmsgs := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        m0 := (tid * nmsgs) / nt; m1 := ((tid + 1) * nmsgs) / nt
        ptr_write_i64(out, tid, avx_murmur3_xxh64(1, words, m0, m1))
    }
}
fn b057_xxhash64_batch(words: i64, nwords: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_xor(fn_addr(_w057), words, nwords / 64, 0, 0, 0, 0, args, out) }
}

fn _w058(tid: i64, nt: i64, pool: i64) {
    unsafe {
        nblocks := ptr_read_i64(pool, 4); scratch := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        base := scratch + tid * 2048
        h8 := base; sig := base + 64; msg := base + 256; ob := base + 768
        ptr_write_i64(h8, 0, 0x6a09e667 ^ 0x01010020); ptr_write_i64(h8, 1, 0xbb67ae85)
        ptr_write_i64(h8, 2, 0x3c6ef372); ptr_write_i64(h8, 3, 0xa54ff53a)
        ptr_write_i64(h8, 4, 0x510e527f); ptr_write_i64(h8, 5, 0x9b05688c)
        ptr_write_i64(h8, 6, 0x1f83d9ab); ptr_write_i64(h8, 7, 0x5be0cd19)
        mut r := 0
        while r < 10 {
            s := (r * 3) & 15; mut j := 0
            while j < 16 { ptr_write_u8(sig, r * 16 + j, (s + j) & 15); j += 1 }
            r += 1
        }
        b0 := (tid * nblocks) / nt; b1 := ((tid + 1) * nblocks) / nt
        c_step := (17 *% 0x9E3779B9) & 0xFFFFFFFF
        c_kstep := (31 *% 0x9E3779B9) & 0xFFFFFFFF
        mut hi64 := 0; mut lo64 := 0; mut blk := b0; lim := b1 - 8
        while blk <= lim {
            mut b_base := (blk *% c_step) & 0xFFFFFFFF
            mut k := 0
            while k < 16 {
                v0 := b_base; v1 := (v0 +% c_step) & 0xFFFFFFFF
                v2 := (v1 +% c_step) & 0xFFFFFFFF; v3 := (v2 +% c_step) & 0xFFFFFFFF
                v4 := (v3 +% c_step) & 0xFFFFFFFF; v5 := (v4 +% c_step) & 0xFFFFFFFF
                v6 := (v5 +% c_step) & 0xFFFFFFFF; v7 := (v6 +% c_step) & 0xFFFFFFFF
                ptr_write_i64(msg, k * 4,     v0 | (v1 << 32))
                ptr_write_i64(msg, k * 4 + 1, v2 | (v3 << 32))
                ptr_write_i64(msg, k * 4 + 2, v4 | (v5 << 32))
                ptr_write_i64(msg, k * 4 + 3, v6 | (v7 << 32))
                b_base = (b_base +% c_kstep) & 0xFFFFFFFF
                k += 1
            }
            _ := avx_blake2s_8(h8, msg, sig, 64, 0xFFFFFFFF, ob)
            hi64 = hi64 ^ ptr_read_i64(ob, 0) ^ ptr_read_i64(ob, 1) ^ ptr_read_i64(ob, 2) ^ ptr_read_i64(ob, 3)
            lo64 = lo64 ^ ptr_read_i64(ob, 4) ^ ptr_read_i64(ob, 5) ^ ptr_read_i64(ob, 6) ^ ptr_read_i64(ob, 7)
            blk += 8
        }
        mut acc := (((hi64 ^ ushr64(hi64, 32)) & 0xFFFFFFFF) << 32) ^ ((lo64 ^ ushr64(lo64, 32)) & 0xFFFFFFFF)
        if blk < b1 {
            mut b_base := (blk *% c_step) & 0xFFFFFFFF
            mut k := 0
            while k < 16 {
                v0 := b_base; v1 := (v0 +% c_step) & 0xFFFFFFFF
                v2 := (v1 +% c_step) & 0xFFFFFFFF; v3 := (v2 +% c_step) & 0xFFFFFFFF
                v4 := (v3 +% c_step) & 0xFFFFFFFF; v5 := (v4 +% c_step) & 0xFFFFFFFF
                v6 := (v5 +% c_step) & 0xFFFFFFFF; v7 := (v6 +% c_step) & 0xFFFFFFFF
                ptr_write_i64(msg, k * 4,     v0 | (v1 << 32))
                ptr_write_i64(msg, k * 4 + 1, v2 | (v3 << 32))
                ptr_write_i64(msg, k * 4 + 2, v4 | (v5 << 32))
                ptr_write_i64(msg, k * 4 + 3, v6 | (v7 << 32))
                b_base = (b_base +% c_kstep) & 0xFFFFFFFF
                k += 1
            }
            _ := avx_blake2s_8(h8, msg, sig, 64, 0xFFFFFFFF, ob)
            rem := b1 - blk; mut l := 0
            while l < rem {
                w0 := (ushr64(ptr_read_i64(ob, l >> 1), (l & 1) * 32)) & 0xFFFFFFFF
                w1 := (ushr64(ptr_read_i64(ob, 4 + (l >> 1)), (l & 1) * 32)) & 0xFFFFFFFF
                acc = acc ^ (w0 << 32) ^ w1
                l += 1
            }
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b058_blake2s_batch(nblocks: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_xor(fn_addr(_w058), nblocks, scratch, 0, 0, 0, 0, args, out) }
}

fn _w059(tid: i64, nt: i64, pool: i64) {
    unsafe {
        data := ptr_read_i64(pool, 4); nmsgs := ptr_read_i64(pool, 5); scratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        base := scratch + tid * 2048
        hip := base; hop := base + 64; st := base + 128; ptrs := base + 384; pptrs := base + 448; optrs := base + 512
        pad := base + 576; ob8 := base + 640 // 8 x 64B outer blocks = 512B
        mem_set(pad, 0x36, 64); mem_set(ob8, 0x5C, 64)
        mut k := 0
        while k < 32 { kb := (k * 7 + 3) & 255; ptr_write_u8(pad, k, 0x36 ^ kb); ptr_write_u8(ob8, k, 0x5C ^ kb); k += 1 }
        _sha256_init_state(hip); _ := sha256_compress_blocks_ptr(hip, pad, 1)
        _sha256_init_state(hop); _ := sha256_compress_blocks_ptr(hop, ob8, 1)
        // Inner tail block for 576 bytes = 4608 bits (0x1200)
        mem_set(pad, 0, 64); ptr_write_u8(pad, 0, 0x80); ptr_write_u8(pad, 62, 0x12)
        // 8 outer block templates (32B inner hash + 0x80 + 768 bits = 0x0300)
        mut l := 0
        while l < 8 {
            ob := ob8 + l * 64
            mem_set(ob, 0, 64); ptr_write_u8(ob, 32, 0x80); ptr_write_u8(ob, 62, 0x03)
            ptr_write_i64(pptrs, l, pad)
            ptr_write_i64(optrs, l, ob)
            l += 1
        }
        // Broadcast hip and hop into 256B lane-major templates at base+1280 and base+1536
        hip8 := base + 1280; hop8 := base + 1536
        mut w := 0
        while w < 8 {
            vi := ptr_read_i64(hip, w) & 0xFFFFFFFF; pi := vi | (vi << 32)
            vo := ptr_read_i64(hop, w) & 0xFFFFFFFF; po := vo | (vo << 32)
            ptr_write_i64(hip8, w * 4, pi); ptr_write_i64(hip8, w * 4 + 1, pi); ptr_write_i64(hip8, w * 4 + 2, pi); ptr_write_i64(hip8, w * 4 + 3, pi)
            ptr_write_i64(hop8, w * 4, po); ptr_write_i64(hop8, w * 4 + 1, po); ptr_write_i64(hop8, w * 4 + 2, po); ptr_write_i64(hop8, w * 4 + 3, po)
            w += 1
        }
        ng := nmsgs >> 3
        g0 := (tid * ng) / nt; g1 := ((tid + 1) * ng) / nt
        mut acc := 0; mut g := g0
        while g < g1 {
            m0 := g << 3
            l = 0; while l < 8 { ptr_write_i64(ptrs, l, data + (m0 + l) * 512); l += 1 }
            mem_copy(st, hip8, 256)
            _ := avx_sha256_8(ptrs, st, 8)
            _ := avx_sha256_8(pptrs, st, 1)
            // Unpack 8 x 8 u32 BE words from lane-major st into ob8[l*64 + w*4]
            w = 0
            while w < 8 {
                mut pair := 0
                while pair < 4 {
                    qw := ptr_read_i64(st, w * 4 + pair)
                    v0 := qw & 0xFFFFFFFF; v1 := ushr64(qw, 32)
                    ob0 := ob8 + (pair * 2) * 64 + w * 4
                    ptr_write_u8(ob0, 0, ushr64(v0, 24) & 255); ptr_write_u8(ob0, 1, ushr64(v0, 16) & 255)
                    ptr_write_u8(ob0, 2, ushr64(v0, 8) & 255);  ptr_write_u8(ob0, 3, v0 & 255)
                    ob1 := ob8 + (pair * 2 + 1) * 64 + w * 4
                    ptr_write_u8(ob1, 0, ushr64(v1, 24) & 255); ptr_write_u8(ob1, 1, ushr64(v1, 16) & 255)
                    ptr_write_u8(ob1, 2, ushr64(v1, 8) & 255);  ptr_write_u8(ob1, 3, v1 & 255)
                    pair += 1
                }
                w += 1
            }
            mem_copy(st, hop8, 256)
            _ := avx_sha256_8(optrs, st, 1)
            x0 := ptr_read_i64(st, 0) ^ ptr_read_i64(st, 1) ^ ptr_read_i64(st, 2) ^ ptr_read_i64(st, 3)
            x1 := ptr_read_i64(st, 4) ^ ptr_read_i64(st, 5) ^ ptr_read_i64(st, 6) ^ ptr_read_i64(st, 7)
            h0x := (x0 ^ ushr64(x0, 32)) & 0xFFFFFFFF
            h1x := (x1 ^ ushr64(x1, 32)) & 0xFFFFFFFF
            acc = acc ^ ((h0x << 32) | h1x)
            g += 1
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b059_hmac_sha256(data: i64, nbytes: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_xor(fn_addr(_w059), data, nbytes / 512, scratch, 0, 0, 0, args, out) }
}

fn _w060(tid: i64, nt: i64, pool: i64) {
    unsafe {
        nblocks := ptr_read_i64(pool, 4); scratch := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        rk := scratch + tid * 128
        ptr_write_i64(rk, 0, 0x0706050403020100); ptr_write_i64(rk, 1, 0x0f0e0d0c0b0a0908)
        ptr_write_i64(rk, 2, 0x1716151413121110); ptr_write_i64(rk, 3, 0x1f1e1d1c1b1a1918)
        ptr_write_i64(rk, 4, 0x2726252423222120); ptr_write_i64(rk, 5, 0x2f2e2d2c2b2a2928)
        ptr_write_i64(rk, 6, 0x3736353433323130); ptr_write_i64(rk, 7, 0x3f3e3d3c3b3a3938)
        ptr_write_i64(out, tid, avx_speck128_4((tid * nblocks) / nt, ((tid + 1) * nblocks) / nt, rk, 8))
    }
}
fn b060_speck_ctr(nblocks: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_xor(fn_addr(_w060), nblocks, scratch, 0, 0, 0, 0, args, out) }
}

// ==================== Domain 7: Signal Processing & Numerical (B061..B070) ====================

fn b061_fft_16384(re: MatF64, im: MatF64) -> i64 {
    n := 16384
    unsafe {
        pr := re.ptr; pi := im.ptr
        mut i := 0
        while i < 64 { ptr_write_f64(pr, i, (i as f64) * 0.05 - 1.5); ptr_write_f64(pi, i, ((i & 31) as f64) * 0.03 - 0.5); i += 1 }
        mut done := 64
        while done < n {
            _ := mem_copy(pr + done * 8, pr, done * 8)
            _ := mem_copy(pi + done * 8, pi, done * 8)
            done = done << 1
        }
    }
    _ := fft_radix2_inplace(re, im, false)
    mut s := 0.0
    unsafe {
        pr := re.ptr; pi := im.ptr
        mut i := 0
        while i < 64 { s = s + abs_f64(ptr_read_f64(pr, i)) + abs_f64(ptr_read_f64(pi, i)); i += 1 }
    }
    return (s * 100.0) as i64
}

fn _w062(tid: i64, nt: i64, pool: i64) {
    unsafe {
        data := ptr_read_i64(pool, 4); ctbl := ptr_read_i64(pool, 5); blks := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        b0 := (tid * blks) / nt; b1 := ((tid + 1) * blks) / nt
        mut acc := 0.0; mut b := b0
        while b < b1 {
            xp := data + b * 64 * 8
            mut k := 0
            while k < 64 {
                rp := ctbl + k * 64 * 8
                s := _dot_f64_slice(xp, rp, 64)
                acc = acc + abs_f64(s)
                k += 1
            }
            b += 1
        }
        ptr_write_f64(out, tid, acc)
    }
}
fn b062_dct_ii(data: i64, ctbl: i64, blks: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w062), data, ctbl, blks, 0, 0, 0, args, out) } * 100.0) as i64
