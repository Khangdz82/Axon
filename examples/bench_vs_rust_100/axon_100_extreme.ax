    t0 = clock_ns(); ibuf_push(chks, b033_spsc_ring(1000000)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b034_bsearch(sorted_64k, 65536, bsearch_q, 80000, args, out)); ibuf_push(times, clock_ns() - t0)
