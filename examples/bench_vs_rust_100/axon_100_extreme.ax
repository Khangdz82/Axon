    i = 0; while i < 512 { ptr_write_f64(rk_x, i, ((i % 29) as f64) * 0.02 - 0.3); ptr_write_f64(rk_y, i, ((i % 31) as f64) * 0.02 - 0.3); i += 1 }

    // D10 AI/LLM inputs
    bnn_w := mem_alloc_aligned(4096 * 64 * 8 + 64); bnn_a := mem_alloc_aligned(64 * 8 + 64); bnn_o := mem_alloc_aligned(4096 * 8 + 64)
    i = 0; while i < 4096 * 64 { ptr_write_i64(bnn_w, i, i *% 0x9E3779B97F4A7C15); i += 1 }
