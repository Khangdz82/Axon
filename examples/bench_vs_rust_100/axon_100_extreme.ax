fn _w050(tid: i64, nt: i64, pool: i64) {
    unsafe {
        seqs := ptr_read_i64(pool, 4); len := ptr_read_i64(pool, 5); scratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        tails := scratch + tid * 65536
        mut tot := 0; mut s := tid
        while s < seqs {
            mut tsz := 0
            mut x := (s *% 0x9E3779B97F4A7C15) +% 1337
            mut i := 0
            while i < len {
                x = x *% 6364136223846793005 +% 1442695040888963407
                v := ushr64(x, 33)
                mut lo := 0; mut hi := tsz
                while lo < hi {
                    mid := ushr64(lo + hi, 1)
                    if ptr_read_i64(tails, mid) < v { lo = mid + 1 } else { hi = mid }
                }
                ptr_write_i64(tails, lo, v)
                if lo == tsz { tsz += 1 }
                i += 1
            }
            tot += tsz
            s += nt
        }
        ptr_write_i64(out, tid, tot)
    }
}
