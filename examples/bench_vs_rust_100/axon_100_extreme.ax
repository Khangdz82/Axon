// Axon v1.2.0 — 100-Benchmark Strict "Light to Impossible" Extreme Suite vs Rust (`-O3`)
// 100% Pure Axon, Zero External Dependencies, Exact Deterministic Checksum Parity (100/100).
// 10 Domains x 10 Benchmarks = 100 Benchmarks:
//   D1_Scalar  (B001..B010) | D2_SIMD    (B011..B020) | D3_Parse  (B021..B030) | D4_DS     (B031..B040)
//   D5_GraphDP (B041..B050) | D6_Crypto  (B051..B060) | D7_Signal (B061..B070) | D8_Physics(B071..B080)
//   D9_LinAlg  (B081..B090) | D10_AI_LLM (B091..B100)

use std::str
use std::algo
use std::ds
use std::crypto
use std::encoding
use std::ringbuf
use std::graph
use std::linalg
use std::numeric
use std::quant

// Shared reusable thread-pool scratch (zero per-benchmark malloc/free overhead!)
// Note: `ai_pool_dispatch` copies 6 QWORD args (`args[0..5] -> pool[4..9]`); `out` is always at `args[5]` (`pool[9]`).
fn _dispatch_reduce_add(worker_addr: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, args: i64, out: i64) -> i64 {
    unsafe {
        mem_set(out, 0, 128)
        ptr_write_i64(args, 0, a0); ptr_write_i64(args, 1, a1); ptr_write_i64(args, 2, a2)
        ptr_write_i64(args, 3, a3); ptr_write_i64(args, 4, a4); ptr_write_i64(args, 5, out)
        _ := ai_pool_dispatch(worker_addr, args)
        mut tot := 0; mut t := 0
        while t < 16 { tot = tot +% ptr_read_i64(out, t); t += 1 }
        return tot
    }
}

fn _dispatch_reduce_xor(worker_addr: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, args: i64, out: i64) -> i64 {
    unsafe {
        mem_set(out, 0, 128)
        ptr_write_i64(args, 0, a0); ptr_write_i64(args, 1, a1); ptr_write_i64(args, 2, a2)
        ptr_write_i64(args, 3, a3); ptr_write_i64(args, 4, a4); ptr_write_i64(args, 5, out)
        _ := ai_pool_dispatch(worker_addr, args)
        mut tot := 0; mut t := 0
        while t < 16 { tot = tot ^ ptr_read_i64(out, t); t += 1 }
        return tot
    }
}

fn _dispatch_reduce_f64(worker_addr: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, args: i64, out: i64) -> f64 {
    unsafe {
        mem_set(out, 0, 128)
        ptr_write_i64(args, 0, a0); ptr_write_i64(args, 1, a1); ptr_write_i64(args, 2, a2)
        ptr_write_i64(args, 3, a3); ptr_write_i64(args, 4, a4); ptr_write_i64(args, 5, out)
        _ := ai_pool_dispatch(worker_addr, args)
        mut tot := 0.0; mut t := 0
        while t < 16 { tot = tot + ptr_read_f64(out, t); t += 1 }
        return tot
    }
}

// ==================== Domain 1: Scalar, Bitwise & Control (B001..B010) ====================

fn _w001(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); out := ptr_read_i64(pool, 9)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut acc0 := 0; mut acc1 := 0
        mut x0 := (i0 *% 37 +% 13) & 1023
        mut x1 := (x0 +% 37) & 1023
        mut i := i0; lim := i1 - 2
        while i <= lim {
            mut v0 := x0; if v0 < 100 { v0 = 100 }; if v0 > 900 { v0 = 900 }; acc0 = acc0 +% v0; x0 = (x0 +% 74) & 1023
            mut v1 := x1; if v1 < 100 { v1 = 100 }; if v1 > 900 { v1 = 900 }; acc1 = acc1 +% v1; x1 = (x1 +% 74) & 1023
            i += 2
        }
        mut acc := acc0 +% acc1
        while i < i1 {
            mut v := x0; if v < 100 { v = 100 }; if v > 900 { v = 900 }
            acc = acc +% v; x0 = (x0 +% 37) & 1023; i += 1
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b001_branchless_clamp(n: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w001), n, 0, 0, 0, 0, 0, args, out) }
}

fn fib_rec(n: i64) -> i64 {
    if n <= 1 { return n }
    return fib_rec(n - 1) + fib_rec(n - 2)
}
fn b002_fib_rec() -> i64 { return fib_rec(37) }

fn b003_sieve(n: i64) -> i64 {
    unsafe {
        p := mem_alloc_aligned(n + 64)
        mem_set(p, 1, n + 1); ptr_write_u8(p, 0, 0); ptr_write_u8(p, 1, 0)
        if n >= 4 { mem_stride_zero_u8(p, 4, 2, n) }
        mut i := 3
        while i * i <= n {
            if ptr_read_u8(p, i) != 0 { mem_stride_zero_u8(p, i * i, i << 1, n) }
            i += 2
        }
        mut cnt := 0; mut k := 2; lim := n + 1
        while k < lim { cnt += ptr_read_u8(p, k); k += 1 }
        mem_free_aligned(p)
        return cnt
    }
}

fn _w004(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); out := ptr_read_i64(pool, 9)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut acc := 0; mut i := i0
        mut v := (i0 *% 0x9E3779B97F4A7C15) +% 0xBF58476D1CE4E5B9
        while i < i1 {
            acc = acc +% popcnt64(v)
            v = v +% 0x9E3779B97F4A7C15
            i += 1
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b004_popcnt(n: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w004), n, 0, 0, 0, 0, 0, args, out) }
}

fn _w005(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); out := ptr_read_i64(pool, 9)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut acc := 0; mut i := i0
        mut state := (i0 *% 0x9E3779B97F4A7C15) +% 0x123456789ABCDEF0
        while i < i1 {
            mut z := state
            z = (z ^ ushr64(z, 30)) *% 0xBF58476D1CE4E5B9
            z = (z ^ ushr64(z, 27)) *% 0x94D049BB133111EB
            acc = acc ^ z ^ ushr64(z, 31)
            state = state +% 0x9E3779B97F4A7C15
            i += 1
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b005_splitmix64(n: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_xor(fn_addr(_w005), n, 0, 0, 0, 0, 0, args, out) }
}

fn _w006(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); out := ptr_read_i64(pool, 9)
        mut total := 0
        mut s := tid + 1
        while s <= n {
            mut x := s; mut steps := 0
            while x != 1 {
                if (x & 1) == 0 { x = ushr64(x, 1); steps += 1 }
                else { x = ushr64(x * 3 + 1, 1); steps += 2 }
            }
            total = total +% steps
            s += nt
        }
        ptr_write_i64(out, tid, total)
    }
}
fn b006_collatz(n: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w006), n, 0, 0, 0, 0, 0, args, out) }
}

fn _w007(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); out := ptr_read_i64(pool, 9)
        i0 := (tid * n) / nt + 1; i1 := ((tid + 1) * n) / nt
        mut acc := 0; mut i := i0
        while i <= i1 {
            mut a := ((i *% 2654435761) & 0xFFFFF) + 1
            mut b := ((i *% 2246822519) & 0xFFFFF) + 1
            while b != 0 { t := a % b; a = b; b = t }
            acc = acc +% a
            i += 1
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b007_gcd_euclid(n: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w007), n, 0, 0, 0, 0, 0, args, out) }
}

fn _w008(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); lut := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut x := (i0 *% 13 +% 5) & 1023
        mut y := (i0 *% 29 +% 11) & 1023
        mut z := (i0 *% 47 +% 19) & 1023
        mut acc := 0; mut i := i0
        while i < i1 {
            acc = acc +% (ptr_read_i64(lut, x) | (ptr_read_i64(lut, y) << 1) | (ptr_read_i64(lut, z) << 2))
            x = (x + 13) & 1023; y = (y + 29) & 1023; z = (z + 47) & 1023
            i += 1
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b008_morton3d(n: i64, lut: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w008), n, lut, 0, 0, 0, 0, args, out) }
}

fn _w009(tid: i64, nt: i64, pool: i64) {
    unsafe {
        n := ptr_read_i64(pool, 4); out := ptr_read_i64(pool, 9)
        i0 := (tid * n) / nt + 1; i1 := ((tid + 1) * n) / nt
        m := 1000000007
        mut acc := 0; mut i := i0
        while i <= i1 {
            mut base := (i * 31 + 17) % m
            mut exp := (i * 19 + 1234567) & 0x3FFFFFFF
            mut res := 1
            while exp > 0 {
                if (exp & 1) != 0 { res = (res * base) % m }
                base = (base * base) % m
                exp = ushr64(exp, 1)
            }
            acc = acc +% res
            i += 1
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b009_modexp(n: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w009), n, 0, 0, 0, 0, 0, args, out) }
}

fn _w010(tid: i64, nt: i64, pool: i64) {
    unsafe {
        pa := ptr_read_i64(pool, 4); pb := ptr_read_i64(pool, 5); n := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut acc := 0; mut k := i0
        while k < i1 {
            a := pa + (k << 7); b := pb + (k << 7)
            mut s := 0; mut r := 0
            while r < 4 {
                a0 := ptr_read_i64(a, r * 4); a1 := ptr_read_i64(a, r * 4 + 1)
                a2 := ptr_read_i64(a, r * 4 + 2); a3 := ptr_read_i64(a, r * 4 + 3)
                r7 := r * 7
                mut c := 0
                while c < 4 {
                    v := a0 * ptr_read_i64(b, c) + a1 * ptr_read_i64(b, 4 + c) + a2 * ptr_read_i64(b, 8 + c) + a3 * ptr_read_i64(b, 12 + c)
                    if r == c { s = s +% v }
                    s = s +% (v ^ (r7 + c))
                    c += 1
                }
                r += 1
            }
            acc = acc +% s
            k += 1
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b010_mat4x4_int(pa: i64, pb: i64, n: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w010), pa, pb, n, 0, 0, 0, args, out) }
}

// ==================== Domain 2: SIMD Array & Reduction Math (B011..B020) ====================

fn _dot_f64_slice(pa: i64, pb: i64, n: i64) -> f64 {
    unsafe {
        mut s := 0.0; mut i := 0
        while i < n { s = s + ptr_read_f64(pa, i) * ptr_read_f64(pb, i); i += 1 }
        return s
    }
}
fn _w011(tid: i64, nt: i64, pool: i64) {
    unsafe {
        pa := ptr_read_i64(pool, 4); pb := ptr_read_i64(pool, 5); n := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        ptr_write_f64(out, tid, _dot_f64_slice(pa + i0 * 8, pb + i0 * 8, i1 - i0))
    }
}
fn b011_dot_f64(pa: i64, pb: i64, n: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w011), pa, pb, n, 0, 0, 0, args, out) } * 1000.0) as i64
}

fn _w012(tid: i64, nt: i64, pool: i64) {
    unsafe {
        px := ptr_read_i64(pool, 4); py := ptr_read_i64(pool, 5); pd := ptr_read_i64(pool, 6); n := ptr_read_i64(pool, 7); out := ptr_read_i64(pool, 9)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut s := 0.0; mut i := i0
        while i < i1 {
            v := 2.5 * ptr_read_f32(px, i) + ptr_read_f32(py, i)
            ptr_write_f32(pd, i, v)
            s = s + v
            i += 1
        }
        ptr_write_f64(out, tid, s)
    }
}
fn b012_saxpy_f32(px: i64, py: i64, pd: i64, n: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w012), px, py, pd, n, 0, 0, args, out) } * 100.0) as i64
}

fn _w013_p1(tid: i64, nt: i64, pool: i64) {
    unsafe {
        src := ptr_read_i64(pool, 4); dst := ptr_read_i64(pool, 5); n := ptr_read_i64(pool, 6); sums := ptr_read_i64(pool, 7)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut acc := 0; mut i := i0
        while i < i1 { acc = acc +% ptr_read_i64(src, i); ptr_write_i64(dst, i, acc); i += 1 }
        ptr_write_i64(sums, tid, acc)
    }
}
fn _w013_p2(tid: i64, nt: i64, pool: i64) {
    unsafe {
        if tid == 0 { return }
        dst := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); offs := ptr_read_i64(pool, 6)
        add := ptr_read_i64(offs, tid)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut i := i0
        while i < i1 { ptr_write_i64(dst, i, ptr_read_i64(dst, i) +% add); i += 1 }
    }
}
fn b013_prefix_sum_i64(src: i64, dst: i64, n: i64, args: i64, out: i64) -> i64 {
    unsafe {
        mem_set(out, 0, 128)
        ptr_write_i64(args, 0, src); ptr_write_i64(args, 1, dst); ptr_write_i64(args, 2, n); ptr_write_i64(args, 3, out)
        _ := ai_pool_dispatch(fn_addr(_w013_p1), args)
        mut run := 0; mut t := 0
        while t < 16 { v := ptr_read_i64(out, t); ptr_write_i64(out, t, run); run = run +% v; t += 1 }
        ptr_write_i64(args, 0, dst); ptr_write_i64(args, 1, n); ptr_write_i64(args, 2, out)
        _ := ai_pool_dispatch(fn_addr(_w013_p2), args)
        return ptr_read_i64(dst, 0) ^ ptr_read_i64(dst, n >> 1) ^ ptr_read_i64(dst, n - 1)
    }
}

fn _w014(tid: i64, nt: i64, pool: i64) {
    unsafe {
        p := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); hbuf := ptr_read_i64(pool, 6)
        hb := hbuf + tid * 2048
        mem_set(hb, 0, 2048)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut i := i0; lim := i1 - 4
        while i <= lim {
            b0 := ptr_read_u8(p, i); ptr_write_i64(hb, b0, ptr_read_i64(hb, b0) + 1)
            b1 := ptr_read_u8(p, i + 1); ptr_write_i64(hb, b1, ptr_read_i64(hb, b1) + 1)
            b2 := ptr_read_u8(p, i + 2); ptr_write_i64(hb, b2, ptr_read_i64(hb, b2) + 1)
            b3 := ptr_read_u8(p, i + 3); ptr_write_i64(hb, b3, ptr_read_i64(hb, b3) + 1)
            i += 4
        }
        while i < i1 { b := ptr_read_u8(p, i); ptr_write_i64(hb, b, ptr_read_i64(hb, b) + 1); i += 1 }
    }
}
fn b014_histogram_256(p: i64, n: i64, hbuf: i64, args: i64) -> i64 {
    unsafe {
        mem_set(hbuf, 0, 16 * 2048)
        ptr_write_i64(args, 0, p); ptr_write_i64(args, 1, n); ptr_write_i64(args, 2, hbuf)
        _ := ai_pool_dispatch(fn_addr(_w014), args)
        mut acc := 0; mut b := 0
        while b < 256 {
            mut c := 0; mut t := 0
            while t < 16 { c += ptr_read_i64(hbuf + t * 2048, b); t += 1 }
            acc = acc +% c *% (b + 1)
            b += 1
        }
        return acc
    }
}

fn _w015(tid: i64, nt: i64, pool: i64) {
    unsafe {
        p := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 6)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut mn := 0x7FFFFFFFFFFFFFFF; mut mx := -0x7FFFFFFFFFFFFFFF - 1; mut s := 0
        mut i := i0
        while i < i1 {
            v := ptr_read_i64(p, i)
            if v < mn { mn = v }
            if v > mx { mx = v }
            s = s +% v
            i += 1
        }
        ptr_write_i64(out, tid * 3, mn)
        ptr_write_i64(out, tid * 3 + 1, mx)
        ptr_write_i64(out, tid * 3 + 2, s)
    }
}
fn b015_minmax_i64(p: i64, n: i64, args: i64, out: i64) -> i64 {
    unsafe {
        mut t := 0
        while t < 16 { ptr_write_i64(out, t * 3, 0x7FFFFFFFFFFFFFFF); ptr_write_i64(out, t * 3 + 1, -0x7FFFFFFFFFFFFFFF - 1); ptr_write_i64(out, t * 3 + 2, 0); t += 1 }
        ptr_write_i64(args, 0, p); ptr_write_i64(args, 1, n); ptr_write_i64(args, 2, out)
        _ := ai_pool_dispatch(fn_addr(_w015), args)
        mut mn := 0x7FFFFFFFFFFFFFFF; mut mx := -0x7FFFFFFFFFFFFFFF - 1; mut s := 0
        t = 0
        while t < 16 {
            vmn := ptr_read_i64(out, t * 3); vmx := ptr_read_i64(out, t * 3 + 1)
            if vmn < mn { mn = vmn }; if vmx > mx { mx = vmx }
            s = s +% ptr_read_i64(out, t * 3 + 2)
            t += 1
        }
        return s ^ mn ^ mx
    }
}

fn _w016(tid: i64, nt: i64, pool: i64) {
    unsafe {
        px := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut s := 0.0; mut i := i0
        while i < i1 {
            mut v := ptr_read_f32(px, i)
            if v < 0.0 { v = 0.0 } else if v > 6.0 { v = 6.0 }
            s = s + v; i += 1
        }
        ptr_write_f64(out, tid, s)
    }
}
fn b016_relu6_f32(px: i64, n: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w016), px, n, 0, 0, 0, 0, args, out) } * 100.0) as i64
}

fn _w017(tid: i64, nt: i64, pool: i64) {
    unsafe {
        pa := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 6)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut l1 := 0.0; mut l2 := 0.0; mut i := i0
        while i < i1 {
            v := ptr_read_f64(pa, i)
            l1 = l1 + abs_f64(v); l2 = l2 + v * v
            i += 1
        }
        ptr_write_f64(out, tid * 2, l1); ptr_write_f64(out, tid * 2 + 1, l2)
    }
}
fn b017_l1_l2_f64(pa: i64, n: i64, args: i64, out: i64) -> i64 {
    unsafe {
        mem_set(out, 0, 256)
        ptr_write_i64(args, 0, pa); ptr_write_i64(args, 1, n); ptr_write_i64(args, 2, out)
        _ := ai_pool_dispatch(fn_addr(_w017), args)
        mut l1 := 0.0; mut l2 := 0.0; mut t := 0
        while t < 16 { l1 = l1 + ptr_read_f64(out, t * 2); l2 = l2 + ptr_read_f64(out, t * 2 + 1); t += 1 }
        return ((l1 + sqrt_f64(l2)) * 100.0) as i64
    }
}

fn _w018(tid: i64, nt: i64, pool: i64) {
    unsafe {
        px := ptr_read_i64(pool, 4); pd := ptr_read_i64(pool, 5); m := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        i0 := (tid * m) / nt; i1 := ((tid + 1) * m) / nt
        mut s := 0.0; mut i := i0
        while i < i1 {
            v := 0.05 * (ptr_read_f32(px, i) + ptr_read_f32(px, i + 8))
               + 0.10 * (ptr_read_f32(px, i + 1) + ptr_read_f32(px, i + 7))
               + 0.12 * (ptr_read_f32(px, i + 2) + ptr_read_f32(px, i + 6))
               + 0.15 * (ptr_read_f32(px, i + 3) + ptr_read_f32(px, i + 5))
               + 0.16 * ptr_read_f32(px, i + 4)
            ptr_write_f32(pd, i, v)
            s = s + v
            i += 1
        }
        ptr_write_f64(out, tid, s)
    }
}
fn b018_conv1d_k9_f32(px: i64, pd: i64, n: i64, args: i64, out: i64) -> i64 {
    return (unsafe { _dispatch_reduce_f64(fn_addr(_w018), px, pd, n - 8, 0, 0, 0, args, out) } * 100.0) as i64
}

fn _w019_p1(tid: i64, nt: i64, pool: i64) {
    unsafe {
        pa := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut s := 0.0; mut i := i0
        while i < i1 { s = s + ptr_read_f64(pa, i); i += 1 }
        ptr_write_f64(out, tid, s)
    }
}
fn _w019_p2(tid: i64, nt: i64, pool: i64) {
    unsafe {
        pa := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); pmean := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        mean := ptr_read_f64(pmean, 0)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut v := 0.0; mut i := i0
        while i < i1 { d := ptr_read_f64(pa, i) - mean; v = v + d * d; i += 1 }
        ptr_write_f64(out, tid, v)
    }
}
fn b019_variance_f64(pa: i64, n: i64, args: i64, out: i64) -> i64 {
    unsafe {
        sum := _dispatch_reduce_f64(fn_addr(_w019_p1), pa, n, 0, 0, 0, 0, args, out)
        mean := sum / (n as f64)
        ptr_write_f64(out, 16, mean)
        var := _dispatch_reduce_f64(fn_addr(_w019_p2), pa, n, out + 128, 0, 0, 0, args, out)
        return ((var / (n as f64)) * 1000000.0) as i64
    }
}

fn _w020(tid: i64, nt: i64, pool: i64) {
    unsafe {
        src := ptr_read_i64(pool, 4); dst := ptr_read_i64(pool, 5); n := ptr_read_i64(pool, 6)
        tiles := n >> 5
        t0 := (tid * tiles) / nt; t1 := ((tid + 1) * tiles) / nt
        mut tr := t0
        while tr < t1 {
            r0 := tr << 5
            mut c0 := 0
            while c0 < n {
                mut r := r0; r_end := r0 + 32
                while r < r_end {
                    rn := r * n
                    mut c := c0; c_end := c0 + 32
                    while c < c_end {
                        ptr_write_f64(dst, c * n + r, ptr_read_f64(src, rn + c))
                        c += 1
                    }
                    r += 1
                }
                c0 += 32
            }
            tr += 1
        }
    }
}
fn b020_mat_transpose_512(src: i64, dst: i64, n: i64, args: i64) -> i64 {
    unsafe {
        ptr_write_i64(args, 0, src); ptr_write_i64(args, 1, dst); ptr_write_i64(args, 2, n)
        _ := ai_pool_dispatch(fn_addr(_w020), args)
        mut s := 0.0; mut i := 0; tot := n * n
        while i < tot { s = s + ptr_read_f64(dst, i); i += 257 }
        return (s * 1000.0) as i64
    }
}

// ==================== Domain 3: Parsing, Text & Serialization (B021..B030) ====================

fn _w021(tid: i64, nt: i64, pool: i64) {
    unsafe {
        bp := ptr_read_i64(pool, 4); stride := ptr_read_i64(pool, 5); cnt := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        r0 := (tid * cnt) / nt; r1 := ((tid + 1) * cnt) / nt
        mut p := bp + r0 * stride; mut acc := 0; mut r := r0
        while r < r1 {
            mut v := ptr_read_u8(p, 0) - 48
            v = v * 10 + (ptr_read_u8(p, 1) - 48); v = v * 10 + (ptr_read_u8(p, 2) - 48)
            v = v * 10 + (ptr_read_u8(p, 3) - 48); v = v * 10 + (ptr_read_u8(p, 4) - 48)
            v = v * 10 + (ptr_read_u8(p, 5) - 48); v = v * 10 + (ptr_read_u8(p, 6) - 48)
            v = v * 10 + (ptr_read_u8(p, 7) - 48); v = v * 10 + (ptr_read_u8(p, 8) - 48)
            v = v * 10 + (ptr_read_u8(p, 9) - 48)
            acc = acc +% v; p += stride; r += 1
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b021_parse_i64(bp: i64, stride: i64, cnt: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w021), bp, stride, cnt, 0, 0, 0, args, out) }
}

fn _w022(tid: i64, nt: i64, pool: i64) {
    unsafe {
        hp := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); out_a := ptr_read_i64(pool, 6); out_h := ptr_read_i64(pool, 7)
        s0 := (tid * n) / nt; s1 := ((tid + 1) * n) / nt
        mut acc := 0; mut hits := 0; mut pos := s0
        mut lim := s1 + 11; if lim > n { lim = n }
        while pos < s1 {
            rem := lim - pos; if rem < 12 { break }
            rel := mem_find_u16(hp + pos, rem, 0x5841)
            if rel < 0 { break }
            idx := pos + rel; if idx >= s1 { break }
            if idx + 12 <= n and ptr_read_u8(hp, idx + 2) == 79 and ptr_read_u8(hp, idx + 3) == 78 and ptr_read_u8(hp, idx + 4) == 95 and ptr_read_u8(hp, idx + 5) == 78 and ptr_read_u8(hp, idx + 6) == 69 and ptr_read_u8(hp, idx + 7) == 69 and ptr_read_u8(hp, idx + 8) == 68 and ptr_read_u8(hp, idx + 9) == 76 and ptr_read_u8(hp, idx + 10) == 69 and ptr_read_u8(hp, idx + 11) == 33 {
                acc = acc +% idx; hits += 1; pos = idx + 12
            } else { pos = idx + 1 }
        }
        ptr_write_i64(out_a, tid, acc); ptr_write_i64(out_h, tid, hits)
    }
}
fn b022_mem_find(hp: i64, n: i64, args: i64, out: i64) -> i64 {
    unsafe {
        mem_set(out, 0, 256)
        ptr_write_i64(args, 0, hp); ptr_write_i64(args, 1, n); ptr_write_i64(args, 2, out); ptr_write_i64(args, 3, out + 128)
        _ := ai_pool_dispatch(fn_addr(_w022), args)
        mut acc := 0; mut hits := 0; mut t := 0
        while t < 16 { acc = acc +% ptr_read_i64(out, t); hits += ptr_read_i64(out + 128, t); t += 1 }
        return acc ^ (hits << 32)
    }
}

fn _w023(tid: i64, nt: i64, pool: i64) {
    unsafe {
        p := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        mut pos := (tid * n) / nt; mut end := ((tid + 1) * n) / nt
        if tid > 0 { while pos < n and ptr_read_u8(p, pos - 1) != 10 { pos += 1 } }
        if tid + 1 < nt { while end < n and ptr_read_u8(p, end - 1) != 10 { end += 1 } }
        mut acc := 0
        while pos < end {
            while pos < end and ptr_read_u8(p, pos) != 58 { pos += 1 }
            if pos >= end { break }
            pos += 1
            mut id := 0
            while pos < end { d := ptr_read_u8(p, pos) - 48; if d < 0 or d > 9 { break }; id = id * 10 + d; pos += 1 }
            while pos < end and ptr_read_u8(p, pos) != 58 { pos += 1 }
            if pos >= end { break }
            pos += 1
            mut val := 0
            while pos < end { d := ptr_read_u8(p, pos) - 48; if d < 0 or d > 9 { break }; val = val * 10 + d; pos += 1 }
            while pos < end and ptr_read_u8(p, pos) != 10 { pos += 1 }
            pos += 1
            acc = acc +% id +% val
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b023_json_parse(p: i64, n: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w023), p, n, 0, 0, 0, 0, args, out) }
}

fn _w024(tid: i64, nt: i64, pool: i64) {
    unsafe {
        src := ptr_read_i64(pool, 4); enc := ptr_read_i64(pool, 5); dec := ptr_read_i64(pool, 6)
        etbl := ptr_read_i64(pool, 7); dtbl := ptr_read_i64(pool, 8); triples := ptr_read_i64(pool, 9)
        t0 := (tid * triples) / nt; t1 := ((tid + 1) * triples) / nt
        mut si := t0 * 3; mut ei := t0 * 4; end_s := t1 * 3
        while si < end_s {
            v := (ptr_read_u8(src, si) << 16) | (ptr_read_u8(src, si + 1) << 8) | ptr_read_u8(src, si + 2)
            ptr_write_u8(enc, ei, ptr_read_u8(etbl, ushr64(v, 18) & 63))
            ptr_write_u8(enc, ei + 1, ptr_read_u8(etbl, ushr64(v, 12) & 63))
            ptr_write_u8(enc, ei + 2, ptr_read_u8(etbl, ushr64(v, 6) & 63))
            ptr_write_u8(enc, ei + 3, ptr_read_u8(etbl, v & 63))
            si += 3; ei += 4
        }
        mut di := t0 * 3; mut pi := t0 * 4; end_p := t1 * 4
        while pi < end_p {
            v := (ptr_read_u8(dtbl, ptr_read_u8(enc, pi)) << 18)
               | (ptr_read_u8(dtbl, ptr_read_u8(enc, pi + 1)) << 12)
               | (ptr_read_u8(dtbl, ptr_read_u8(enc, pi + 2)) << 6)
               | ptr_read_u8(dtbl, ptr_read_u8(enc, pi + 3))
            ptr_write_u8(dec, di, ushr64(v, 16) & 255)
            ptr_write_u8(dec, di + 1, ushr64(v, 8) & 255)
            ptr_write_u8(dec, di + 2, v & 255)
            di += 3; pi += 4
        }
    }
}
fn b024_base64_rt(src: i64, enc: i64, dec: i64, etbl: i64, dtbl: i64, n: i64, args: i64) -> i64 {
    unsafe {
        triples := n / 3
        ptr_write_i64(args, 0, src); ptr_write_i64(args, 1, enc); ptr_write_i64(args, 2, dec)
        ptr_write_i64(args, 3, etbl); ptr_write_i64(args, 4, dtbl); ptr_write_i64(args, 5, triples)
        _ := ai_pool_dispatch(fn_addr(_w024), args)
        mut si := triples * 3
        while si < n { ptr_write_u8(dec, si, ptr_read_u8(src, si)); si += 1 }
        mut acc := n; mut i := 0
        while i < n { acc = acc +% ptr_read_u8(dec, i); i += 64 }
        return acc
    }
}

fn _w025(tid: i64, nt: i64, pool: i64) {
    unsafe {
        p := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); out_s := ptr_read_i64(pool, 6); out_m := ptr_read_i64(pool, 7)
        mut i := (tid * n) / nt; mut end := ((tid + 1) * n) / nt
        if tid > 0 { while i < n and ptr_read_u8(p, i - 1) != 10 { i += 1 } }
        if tid + 1 < nt { while end < n and ptr_read_u8(p, end - 1) != 10 { end += 1 } }
        mut sum_v := 0; mut max_v := 0
        while i < end {
            mut c0 := 0; while i < end { ch := ptr_read_u8(p, i); i += 1; if ch == 44 { break }; c0 = c0 * 10 + (ch - 48) }
            mut c1 := 0; while i < end { ch := ptr_read_u8(p, i); i += 1; if ch == 44 { break }; c1 = c1 * 10 + (ch - 48) }
            mut c2 := 0; while i < end { ch := ptr_read_u8(p, i); i += 1; if ch == 44 { break }; c2 = c2 * 10 + (ch - 48) }
            mut c3 := 0; while i < end { ch := ptr_read_u8(p, i); i += 1; if ch == 10 { break }; c3 = c3 * 10 + (ch - 48) }
            sum_v = sum_v +% c0 +% c1 +% c2 +% c3
            if c2 > max_v { max_v = c2 }
        }
        ptr_write_i64(out_s, tid, sum_v); ptr_write_i64(out_m, tid, max_v)
    }
}
fn b025_csv_agg(p: i64, n: i64, args: i64, out: i64) -> i64 {
    unsafe {
        mem_set(out, 0, 256)
        ptr_write_i64(args, 0, p); ptr_write_i64(args, 1, n); ptr_write_i64(args, 2, out); ptr_write_i64(args, 3, out + 128)
        _ := ai_pool_dispatch(fn_addr(_w025), args)
        mut sv := 0; mut mv := 0; mut t := 0
        while t < 16 { sv = sv +% ptr_read_i64(out, t); m := ptr_read_i64(out + 128, t); if m > mv { mv = m }; t += 1 }
        return sv ^ (mv << 20)
    }
}

fn _w026(tid: i64, nt: i64, pool: i64) {
    unsafe {
        src := ptr_read_i64(pool, 4); enc := ptr_read_i64(pool, 5); dec := ptr_read_i64(pool, 6)
        htbl := ptr_read_i64(pool, 7); dtbl := ptr_read_i64(pool, 8); n := ptr_read_i64(pool, 9)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut i := i0
        while i < i1 {
            b := ptr_read_u8(src, i)
            ptr_write_u8(enc, i << 1, ptr_read_u8(htbl, ushr64(b, 4)))
            ptr_write_u8(enc, (i << 1) + 1, ptr_read_u8(htbl, b & 15))
            i += 1
        }
        i = i0
        while i < i1 {
            h := ptr_read_u8(dtbl, ptr_read_u8(enc, i << 1))
            l := ptr_read_u8(dtbl, ptr_read_u8(enc, (i << 1) + 1))
            ptr_write_u8(dec, i, (h << 4) | l)
            i += 1
        }
    }
}
fn b026_hex_rt(src: i64, enc: i64, dec: i64, htbl: i64, dtbl: i64, n: i64, args: i64) -> i64 {
    unsafe {
        ptr_write_i64(args, 0, src); ptr_write_i64(args, 1, enc); ptr_write_i64(args, 2, dec)
        ptr_write_i64(args, 3, htbl); ptr_write_i64(args, 4, dtbl); ptr_write_i64(args, 5, n)
        _ := ai_pool_dispatch(fn_addr(_w026), args)
        mut acc := 0; mut i := 0
        while i < n { acc = acc +% ptr_read_u8(dec, i); i += 32 }
        return acc
    }
}

fn _w027(tid: i64, nt: i64, pool: i64) {
    unsafe {
        p := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 6)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut cps := 0; mut asc := 0; mut i := i0
        while i < i1 {
            b := ptr_read_u8(p, i)
            if (b & 0xC0) != 0x80 { cps += 1 }
            if b < 0x80 { asc += 1 }
            i += 1
        }
        ptr_write_i64(out, tid * 2, cps); ptr_write_i64(out, tid * 2 + 1, asc)
    }
}
fn b027_utf8_count(p: i64, n: i64, args: i64, out: i64) -> i64 {
    unsafe {
        mem_set(out, 0, 256)
        ptr_write_i64(args, 0, p); ptr_write_i64(args, 1, n); ptr_write_i64(args, 2, out)
        _ := ai_pool_dispatch(fn_addr(_w027), args)
        mut cps := 0; mut asc := 0; mut t := 0
        while t < 16 { cps += ptr_read_i64(out, t * 2); asc += ptr_read_i64(out, t * 2 + 1); t += 1 }
        return cps ^ (asc << 1)
    }
}

fn _w028(tid: i64, nt: i64, pool: i64) {
    unsafe {
        data := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); scratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        nchunks := (n + 65535) / 65536
        enc := scratch + tid * 196608
        dec := enc + 131072
        mut acc := 0; mut cid := tid
        while cid < nchunks {
            c0 := cid * 65536; mut c1 := c0 + 65536; if c1 > n { c1 = n }
            mut ei := 0; mut i := c0
            while i < c1 {
                v := ptr_read_u8(data, i); mut run := 1
                while i + run < c1 and run < 255 and ptr_read_u8(data, i + run) == v { run += 1 }
                ptr_write_u8(enc, ei, run); ptr_write_u8(enc, ei + 1, v)
                ei += 2; i += run
            }
            mut di := 0; mut p := 0
            while p < ei {
                cnt := ptr_read_u8(enc, p); v := ptr_read_u8(enc, p + 1)
                mem_set(dec + di, v, cnt)
                di += cnt; p += 2
            }
            acc = acc +% ei +% ptr_read_u8(dec, 0) +% ptr_read_u8(dec, di - 1)
            cid += nt
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b028_rle_rt(data: i64, n: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w028), data, n, scratch, 0, 0, 0, args, out) }
}

fn _w029(tid: i64, nt: i64, pool: i64) {
    unsafe {
        vals := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); scratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        nblks := (n + 16383) / 16384
        buf := scratch + tid * 196608
        mut acc := 0; mut bid := tid
        while bid < nblks {
            b0 := bid * 16384; mut b1 := b0 + 16384; if b1 > n { b1 = n }
            mut pos := 0; mut i := b0
            while i < b1 {
                mut v := ptr_read_i64(vals, i)
                while v >= 128 { ptr_write_u8(buf, pos, (v & 127) | 128); pos += 1; v = ushr64(v, 7) }
                ptr_write_u8(buf, pos, v); pos += 1
                i += 1
            }
            mut p := 0
            while p < pos {
                mut res := 0; mut sh := 0
                while true {
                    b := ptr_read_u8(buf, p); p += 1
                    res = res | ((b & 127) << sh)
                    if (b & 128) == 0 { break }
                    sh += 7
                }
                acc = acc +% res
            }
            bid += nt
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b029_varint_pb(vals: i64, n: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w029), vals, n, scratch, 0, 0, 0, args, out) }
}

fn _w030(tid: i64, nt: i64, pool: i64) {
    unsafe {
        p := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); out := ptr_read_i64(pool, 9)
        mut i := (tid * n) / nt; mut end := ((tid + 1) * n) / nt
        if tid > 0 { while i < n and ptr_read_u8(p, i - 1) != 10 { i += 1 } }
        if tid + 1 < nt { while end < n and ptr_read_u8(p, end - 1) != 10 { end += 1 } }
        mut acc := 0
        while i < end {
            while i < end { ch := ptr_read_u8(p, i); if ch == 61 or ch == 10 { break }; i += 1 }
            if i >= end { break }
            if ptr_read_u8(p, i) == 10 { i += 1; continue }
            i += 1
            mut v := 0
            while i < end { d := ptr_read_u8(p, i) - 48; if d < 0 or d > 9 { break }; v = v * 10 + d; i += 1 }
            acc = acc +% v
            if i < end { ch2 := ptr_read_u8(p, i); if ch2 == 38 or ch2 == 10 { i += 1 } }
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b030_url_query(p: i64, n: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w030), p, n, 0, 0, 0, 0, args, out) }
}

// ==================== Domain 4: Sorting & Data Structures (B031..B040) ====================

fn b031_sort_i64(orig: IntBuf, work: IntBuf, n: i64) -> i64 {
    unsafe {
        mem_copy((work as i64) + 16, (orig as i64) + 16, n * 8)
        ptr_write_i64(work as i64, 0, n)
    }
    sort_i64(work)
    return ibuf_get(work, 0) ^ ibuf_get(work, n / 4) ^ ibuf_get(work, n / 2) ^ ibuf_get(work, (n * 3) / 4) ^ ibuf_get(work, n - 1)
}

fn b032_hashmap(n: i64) -> i64 {
    mut m := dmap_new(64)
    mut i := 0
    while i < n { dmap_put(mut m, i * 13 + 7, i * 3 + 1); i += 1 }
    mut acc := 0; i = 0
    while i < n { acc = acc +% dmap_get(m, i * 13 + 7, 0); i += 1 }
    dmap_free(move m)
    return acc
}

fn b033_spsc_ring(total: i64) -> i64 {
    r := spsc_new(1024)
    unsafe {
        bp := r.base_ptr
        data := bp + 128
        io := mem_alloc_aligned(4096)
        src := io; dst := io + 2048
        mut acc := 0; mut base := 0
        while base < total {
            mut j := 0
            while j < 256 { ptr_write_i64(src, j, base + j); j += 1 }
            h := ptr_read_i64(bp, 0)
            t := atomic_load_i64(bp, 8)
            mut n := 1024 - (h - t)
            if n > 256 { n = 256 }
            pos := h & 1023
            _ := mem_copy(data + (pos << 3), src, n << 3)
            atomic_store_rel_i64(bp, 0, h +% n)
            t2 := ptr_read_i64(bp, 8)
            h2 := atomic_load_i64(bp, 0)
            mut got := h2 - t2
            if got > 256 { got = 256 }
            p2 := t2 & 1023
            _ := mem_copy(dst, data + (p2 << 3), got << 3)
            atomic_store_rel_i64(bp, 8, t2 +% got)
            j = 0
            while j < got { acc += ptr_read_i64(dst, j); j += 1 }
            base += 256
        }
        mem_free_aligned(io)
        spsc_free(move r)
        return acc
    }
}

fn _w034(tid: i64, nt: i64, pool: i64) {
    unsafe {
        arr := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); qs := ptr_read_i64(pool, 6); nq := ptr_read_i64(pool, 7); out := ptr_read_i64(pool, 9)
        q0 := (tid * nq) / nt; q1 := ((tid + 1) * nq) / nt
        mut acc := 0; mut i := q0
        while i < q1 {
            q := ptr_read_i64(qs, i)
            mut lo := 0; mut hi := n
            while lo < hi {
                mid := lo + ushr64(hi - lo, 1)
                if ptr_read_i64(arr, mid) < q { lo = mid + 1 } else { hi = mid }
            }
            acc = acc +% lo
            i += 1
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b034_bsearch(arr: i64, n: i64, qs: i64, nq: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w034), arr, n, qs, nq, 0, 0, args, out) }
}

fn _w035(tid: i64, nt: i64, pool: i64) {
    unsafe {
        shards := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); ops := ptr_read_i64(pool, 6); scratch := ptr_read_i64(pool, 7); out := ptr_read_i64(pool, 9)
        par := scratch + tid * 65536
        rnk := par + n * 8
        mask := n - 1
        mut acc := 0; mut sh := tid
        while sh < shards {
            mut i := 0; while i < n { ptr_write_i64(par, i, i); i += 1 }
            mem_set(rnk, 0, n)
            sh13 := sh * 13 + 11; sh29 := sh * 29 + 23
            mut op := 0
            while op < ops {
                mut a := (op *% 37 +% sh13) & mask
                mut b := (op *% 97 +% sh29) & mask
                while true { pa := ptr_read_i64(par, a); if pa == a { break }; gpa := ptr_read_i64(par, pa); ptr_write_i64(par, a, gpa); a = gpa }
                while true { pb := ptr_read_i64(par, b); if pb == b { break }; gpb := ptr_read_i64(par, pb); ptr_write_i64(par, b, gpb); b = gpb }
                if a != b {
                    ra := ptr_read_u8(rnk, a); rb := ptr_read_u8(rnk, b)
                    if ra < rb { ptr_write_i64(par, a, b) }
                    else { ptr_write_i64(par, b, a); if ra == rb { ptr_write_u8(rnk, a, ra + 1) } }
                    acc += 1
                }
                op += 1
            }
            sh += nt
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b035_dsu(shards: i64, n: i64, ops: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w035), shards, n, ops, scratch, 0, 0, args, out) }
}

fn _w036(tid: i64, nt: i64, pool: i64) {
    unsafe {
        shards := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); ops := ptr_read_i64(pool, 6); scratch := ptr_read_i64(pool, 7); out := ptr_read_i64(pool, 9)
        bit := scratch + tid * 65536
        mask := n - 1
        mut acc := 0; mut sh := tid
        while sh < shards {
            mem_set(bit, 0, (n + 1) * 8)
            sh11 := sh * 11; sh19 := sh * 19
            mut i := 1
            while i <= ops {
                mut idx := ((i * 37 + sh11) & mask) + 1
                delta := ((i + sh) & 15) + 1
                while idx <= n { ptr_write_i64(bit, idx, ptr_read_i64(bit, idx) +% delta); idx += idx & (0 - idx) }
                mut q := ((i * 53 + sh19) & mask) + 1
                mut s := 0
                while q > 0 { s = s +% ptr_read_i64(bit, q); q -= q & (0 - q) }
                acc = acc +% s
                i += 1
            }
            sh += nt
        }
        ptr_write_i64(out, tid, acc)
    }
}
fn b036_fenwick(shards: i64, n: i64, ops: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w036), shards, n, ops, scratch, 0, 0, args, out) }
}

fn _w037(tid: i64, nt: i64, pool: i64) {
    unsafe {
        arr := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); hpool := ptr_read_i64(pool, 6)
        hp := hpool + tid * 512
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut sz := 0; mut i := i0
        while i < i1 {
            v := ptr_read_i64(arr, i)
            if sz < 64 {
                mut pi := sz; sz += 1
                while pi > 0 {
                    par := ushr64(pi - 1, 1); pv := ptr_read_i64(hp, par)
                    if pv <= v { break }
                    ptr_write_i64(hp, pi, pv); pi = par
                }
                ptr_write_i64(hp, pi, v)
            } else if v > ptr_read_i64(hp, 0) {
                mut idx := 0
                while true {
                    l := (idx << 1) + 1; if l >= 64 { break }
                    mut sm := l; mut sv := ptr_read_i64(hp, l)
                    r := l + 1
                    if r < 64 { rv := ptr_read_i64(hp, r); if rv < sv { sm = r; sv = rv } }
                    if v <= sv { break }
                    ptr_write_i64(hp, idx, sv); idx = sm
                }
                ptr_write_i64(hp, idx, v)
            }
            i += 1
        }
    }
}
fn b037_topk_heap(arr: i64, n: i64, hpool: i64, args: i64) -> i64 {
    unsafe {
        mem_set(hpool, 0, 16 * 512)
        ptr_write_i64(args, 0, arr); ptr_write_i64(args, 1, n); ptr_write_i64(args, 2, hpool)
        _ := ai_pool_dispatch(fn_addr(_w037), args)
        // Merge 16 * 64 candidates into final top-64 min-heap
        fhp := hpool + 16 * 512
        mut sz := 0; mut k := 0
        while k < 16 * 64 {
            v := ptr_read_i64(hpool, k)
            if sz < 64 {
                mut pi := sz; sz += 1
                while pi > 0 { par := ushr64(pi - 1, 1); pv := ptr_read_i64(fhp, par); if pv <= v { break }; ptr_write_i64(fhp, pi, pv); pi = par }
                ptr_write_i64(fhp, pi, v)
            } else if v > ptr_read_i64(fhp, 0) {
                mut idx := 0
                while true {
                    l := (idx << 1) + 1; if l >= 64 { break }
                    mut sm := l; mut sv := ptr_read_i64(fhp, l)
                    r := l + 1; if r < 64 { rv := ptr_read_i64(fhp, r); if rv < sv { sm = r; sv = rv } }
                    if v <= sv { break }
                    ptr_write_i64(fhp, idx, sv); idx = sm
                }
                ptr_write_i64(fhp, idx, v)
            }
            k += 1
        }
        mut tot := 0; k = 0
        while k < 64 { tot = tot +% ptr_read_i64(fhp, k); k += 1 }
        return tot
    }
}

fn _w038(tid: i64, nt: i64, pool: i64) {
    unsafe {
        pa := ptr_read_i64(pool, 4); pb := ptr_read_i64(pool, 5); pc := ptr_read_i64(pool, 6); n := ptr_read_i64(pool, 7); out := ptr_read_i64(pool, 9)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut cnt := 0; mut i := i0
        while i < i1 { cnt += popcnt64((ptr_read_i64(pa, i) & ptr_read_i64(pb, i)) ^ ptr_read_i64(pc, i)); i += 1 }
        ptr_write_i64(out, tid, cnt)
    }
}
fn b038_bitset_popcnt(pa: i64, pb: i64, pc: i64, n: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w038), pa, pb, pc, n, 0, 0, args, out) }
}

fn _bloom_scan(bits: i64, qs: i64, q0: i64, q1: i64) -> i64 {
    unsafe {
        m1 := 0x9E3779B97F4A7C15; m2 := 0xBF58476D1CE4E5B9
        mut hits := 0; mut i := q0; lim2 := q1 - 1
        while i < lim2 {
            a1 := ptr_read_i64(qs, i) *% m1; a2 := (a1 ^ ushr64(a1, 30)) *% m2; a3 := a1 +% a2
            b1 := ptr_read_i64(qs, i + 1) *% m1; b2 := (b1 ^ ushr64(b1, 30)) *% m2; b3 := b1 +% b2
            wa := ushr64(ptr_read_i64(bits, ushr64(a1, 6) & 1023), a1 & 63) & ushr64(ptr_read_i64(bits, ushr64(a2, 6) & 1023), a2 & 63) & ushr64(ptr_read_i64(bits, ushr64(a3, 6) & 1023), a3 & 63) & 1
            wb := ushr64(ptr_read_i64(bits, ushr64(b1, 6) & 1023), b1 & 63) & ushr64(ptr_read_i64(bits, ushr64(b2, 6) & 1023), b2 & 63) & ushr64(ptr_read_i64(bits, ushr64(b3, 6) & 1023), b3 & 63) & 1
            hits += wa + wb
            i += 2
        }
        while i < q1 {
            h1 := ptr_read_i64(qs, i) *% m1; h2 := (h1 ^ ushr64(h1, 30)) *% m2; h3 := h1 +% h2
            hits += ushr64(ptr_read_i64(bits, ushr64(h1, 6) & 1023), h1 & 63) & ushr64(ptr_read_i64(bits, ushr64(h2, 6) & 1023), h2 & 63) & ushr64(ptr_read_i64(bits, ushr64(h3, 6) & 1023), h3 & 63) & 1
            i += 1
        }
        return hits
    }
}
fn _w039(tid: i64, nt: i64, pool: i64) {
    unsafe {
        bits := ptr_read_i64(pool, 4); qs := ptr_read_i64(pool, 5); nq := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        ptr_write_i64(out, tid, _bloom_scan(bits, qs, (tid * nq) / nt, ((tid + 1) * nq) / nt))
    }
}
fn b039_bloom_filter(bits: i64, qs: i64, nq: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w039), bits, qs, nq, 0, 0, 0, args, out) }
}

fn _w040_p1(tid: i64, nt: i64, pool: i64) {
    unsafe {
        arr := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); hbuf := ptr_read_i64(pool, 6)
        hb := hbuf + tid * 128
        mem_set(hb, 0, 128)
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut i := i0
        while i < i1 { b := ptr_read_i64(arr, i) & 15; ptr_write_i64(hb, b, ptr_read_i64(hb, b) + 1); i += 1 }
    }
}
fn _w040_p2(tid: i64, nt: i64, pool: i64) {
    unsafe {
        arr := ptr_read_i64(pool, 4); dst := ptr_read_i64(pool, 5); n := ptr_read_i64(pool, 6); obuf := ptr_read_i64(pool, 7)
        ob := obuf + tid * 128
        i0 := (tid * n) / nt; i1 := ((tid + 1) * n) / nt
        mut i := i0
        while i < i1 {
            v := ptr_read_i64(arr, i); b := v & 15
            pos := ptr_read_i64(ob, b); ptr_write_i64(ob, b, pos + 1)
            ptr_write_i64(dst, pos, v)
            i += 1
        }
    }
}
fn b040_radix_hist_scatter(arr: i64, dst: i64, n: i64, hbuf: i64, args: i64) -> i64 {
    unsafe {
        mem_set(hbuf, 0, 16 * 128)
        ptr_write_i64(args, 0, arr); ptr_write_i64(args, 1, n); ptr_write_i64(args, 2, hbuf)
        _ := ai_pool_dispatch(fn_addr(_w040_p1), args)
        mut sum := 0; mut b := 0
        while b < 16 {
            mut t := 0
            while t < 16 {
                hb := hbuf + t * 128
                c := ptr_read_i64(hb, b)
                ptr_write_i64(hb, b, sum)
                sum += c
                t += 1
            }
            b += 1
        }
        ptr_write_i64(args, 0, arr); ptr_write_i64(args, 1, dst); ptr_write_i64(args, 2, n); ptr_write_i64(args, 3, hbuf)
        _ := ai_pool_dispatch(fn_addr(_w040_p2), args)
        return ptr_read_i64(dst, 0) ^ ptr_read_i64(dst, n >> 1) ^ ptr_read_i64(dst, n - 1)
    }
}

// ==================== Domain 5: Graphs & Dynamic Programming (B041..B050) ====================

fn b041_dijkstra(g: Graph) -> i64 {
    dist := graph_dijkstra(g, 0)
    mut acc := 0; mut i := 0; n := ibuf_len(dist)
    while i < n { d := ibuf_get(dist, i); if d < 1000000000000 { acc = acc +% d }; i += 1 }
    buf_free(move dist)
    return acc
}

fn _bfs_core(rp: i64, ci: i64, n: i64, dist: i64, q: i64) -> i64 {
    unsafe {
        mem_set(dist, 0xFF, n * 8)
        ptr_write_i64(dist, 0, 0); ptr_write_i64(q, 0, 0)
        mut head := 0; mut tail := 1
        while head < tail {
            u := ptr_read_i64(q, head); head += 1
            nd := ptr_read_i64(dist, u) + 1
            mut e := ptr_read_i64(rp, u); ee := ptr_read_i64(rp, u + 1)
            while e < ee {
                v := ptr_read_i64(ci, e)
                if ptr_read_i64(dist, v) < 0 {
                    ptr_write_i64(dist, v, nd)
                    ptr_write_i64(q, tail, v); tail += 1
                }
                e += 1
            }
        }
        mut acc := 0; mut i := 0
        while i < n { d := ptr_read_i64(dist, i); if d >= 0 { acc = acc +% d }; i += 1 }
        return acc
    }
}
fn b042_bfs(rp: i64, ci: i64, n: i64, dist: i64, q: i64) -> i64 { return _bfs_core(rp, ci, n, dist, q) }

fn _topo_core(rp: i64, ci: i64, n: i64, indeg: i64, q: i64) -> i64 {
    unsafe {
        mem_set(indeg, 0, n * 8)
        tot_e := ptr_read_i64(rp, n)
        mut e := 0
        while e < tot_e { v := ptr_read_i64(ci, e); ptr_write_i64(indeg, v, ptr_read_i64(indeg, v) + 1); e += 1 }
        mut head := 0; mut tail := 0; mut i := 0
        while i < n { if ptr_read_i64(indeg, i) == 0 { ptr_write_i64(q, tail, i); tail += 1 }; i += 1 }
        mut acc := 0; mut rank := 1
        while head < tail {
            u := ptr_read_i64(q, head); head += 1
            acc = acc +% u *% rank; rank += 1
            mut ei := ptr_read_i64(rp, u); ee := ptr_read_i64(rp, u + 1)
            while ei < ee {
                v := ptr_read_i64(ci, ei)
                nd := ptr_read_i64(indeg, v) - 1
                ptr_write_i64(indeg, v, nd)
                if nd == 0 { ptr_write_i64(q, tail, v); tail += 1 }
                ei += 1
            }
        }
        return acc
    }
}
fn b043_toposort(rp: i64, ci: i64, n: i64, indeg: i64, q: i64) -> i64 { return _topo_core(rp, ci, n, indeg, q) }

fn _fw_rows_range(d: i64, n: i64, k: i64, r0: i64, r1: i64) {
    unsafe {
        kn := k * n
        mut i := r0
        while i < r1 {
            in_off := i * n
            dik := ptr_read_i64(d, in_off + k)
            if dik < 1000000000 {
                mut j := 0
                while j < n {
                    cand := dik + ptr_read_i64(d, kn + j)
                    if cand < ptr_read_i64(d, in_off + j) { ptr_write_i64(d, in_off + j, cand) }
                    j += 1
                }
            }
            i += 1
        }
    }
}
fn _w044(tid: i64, nt: i64, pool: i64) {
    unsafe {
        d := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); barr := ptr_read_i64(pool, 6)
        r0 := (tid * n) / nt; r1 := ((tid + 1) * n) / nt
        mut sense := 1; mut k := 0
        while k < n {
            _fw_rows_range(d, n, k, r0, r1)
            if atomic_add_i64(barr, 0, 1) + 1 == nt {
                atomic_store_i64(barr, 0, 0)
                atomic_store_rel_i64(barr, 1, sense)
            } else {
                while atomic_load_i64(barr, 1) != sense { }
            }
            sense = 1 - sense
            k += 1
        }
    }
}
fn b044_floyd_warshall(d: i64, n: i64, barr: i64, args: i64) -> i64 {
    unsafe {
        mut i := 0
        while i < n {
            mut j := 0
            while j < n {
                mut v := 1000000000
                if i == j { v = 0 }
                else if ((i * 17 + j * 31) % 7) == 0 { v = 1 + ((i * 13 + j * 7) % 50) }
                ptr_write_i64(d, i * n + j, v)
                j += 1
            }
            i += 1
        }
        atomic_store_i64(barr, 0, 0); atomic_store_i64(barr, 1, 0)
        ptr_write_i64(args, 0, d); ptr_write_i64(args, 1, n); ptr_write_i64(args, 2, barr)
        _ := ai_pool_dispatch(fn_addr(_w044), args)
        mut acc := 0; mut idx := 0; tot := n * n
        while idx < tot { v := ptr_read_i64(d, idx); if v < 1000000000 { acc = acc +% v }; idx += 1 }
        return acc
    }
}

fn _pr_step_range(rp: i64, ci: i64, od: i64, pr: i64, nxt: i64, r0: i64, r1: i64, base: f64) {
    unsafe {
        mut r := r0
        while r < r1 {
            mut s := 0.0
            mut e := ptr_read_i64(rp, r); ee := ptr_read_i64(rp, r + 1)
            while e < ee {
                c := ptr_read_i64(ci, e)
                s = s + ptr_read_f64(pr, c) * ptr_read_f64(od, c)
                e += 1
            }
            ptr_write_f64(nxt, r, base + 0.85 * s)
            r += 1
        }
    }
}
fn _w045(tid: i64, nt: i64, pool: i64) {
    unsafe {
        meta := ptr_read_i64(pool, 4); n := ptr_read_i64(pool, 5); barr := ptr_read_i64(pool, 6)
        rp := ptr_read_i64(meta, 0); ci := ptr_read_i64(meta, 1); od := ptr_read_i64(meta, 2)
        pr := ptr_read_i64(meta, 3); nxt := ptr_read_i64(meta, 4)
        r0 := (tid * n) / nt; r1 := ((tid + 1) * n) / nt
        base := 0.15 / (n as f64)
        mut p_cur := pr; mut p_nxt := nxt; mut sense := 1; mut it := 0
        while it < 15 {
            _pr_step_range(rp, ci, od, p_cur, p_nxt, r0, r1, base)
            if atomic_add_i64(barr, 0, 1) + 1 == nt {
                atomic_store_i64(barr, 0, 0); atomic_store_rel_i64(barr, 1, sense)
            } else {
                while atomic_load_i64(barr, 1) != sense { }
            }
            sense = 1 - sense
            tmp := p_cur; p_cur = p_nxt; p_nxt = tmp
            it += 1
        }
    }
}
fn b045_pagerank(rp: i64, ci: i64, inv_od: i64, pr: i64, nxt: i64, n: i64, barr: i64, args: i64) -> i64 {
    unsafe {
        init_v := 1.0 / (n as f64)
        mut i := 0; while i < n { ptr_write_f64(pr, i, init_v); i += 1 }
        atomic_store_i64(barr, 0, 0); atomic_store_i64(barr, 1, 0)
        meta := args + 64
        ptr_write_i64(meta, 0, rp); ptr_write_i64(meta, 1, ci); ptr_write_i64(meta, 2, inv_od)
        ptr_write_i64(meta, 3, pr); ptr_write_i64(meta, 4, nxt)
        ptr_write_i64(args, 0, meta); ptr_write_i64(args, 1, n); ptr_write_i64(args, 2, barr)
        _ := ai_pool_dispatch(fn_addr(_w045), args)
        // 15 steps is odd -> final vector is in `nxt`
        mut acc := 0.0; i = 0
        while i < n { acc = acc + ptr_read_f64(nxt, i) * (((i % 97) as f64) + 1.0); i += 1 }
        return (acc * 1000000.0) as i64
    }
}

fn b046_knapsack_dp(dp: i64) -> i64 {
    cap := 10000
    unsafe {
        mem_set(dp, 0, (cap + 1) * 8)
        mut it := 0
        while it < 200 {
            w := 5 + ((it * 37 + 11) % 250)
            v := 10 + ((it * 97 + 23) % 500)
            mut c := cap
            while c >= w {
                cand := ptr_read_i64(dp, c - w) + v
                if cand > ptr_read_i64(dp, c) { ptr_write_i64(dp, c, cand) }
                c -= 1
            }
            it += 1
        }
        return ptr_read_i64(dp, cap)
    }
}

fn _w047(tid: i64, nt: i64, pool: i64) {
    unsafe {
        pairs := ptr_read_i64(pool, 4); len := ptr_read_i64(pool, 5); scratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        base := scratch + tid * 4096
        pa := base; pb := base + 256; mut prev := base + 512; mut curr := base + 2048
        p0 := (tid * pairs) / nt; p1 := ((tid + 1) * pairs) / nt
        mut tot := 0; mut p := p0
        while p < p1 {
            mut i := 0
            while i < len {
                ptr_write_u8(pa, i, (p * 7 + i * 3) % 26)
                ptr_write_u8(pb, i, (p * 11 + i * 5 + 1) % 26)
                i += 1
            }
            mut j := 0; while j <= len { ptr_write_i64(prev, j, j); j += 1 }
            i = 1
            while i <= len {
                ptr_write_i64(curr, 0, i)
                ca := ptr_read_u8(pa, i - 1)
                j = 1
                while j <= len {
                    mut d := ptr_read_i64(prev, j) + 1
                    d2 := ptr_read_i64(curr, j - 1) + 1
                    if d2 < d { d = d2 }
                    mut d3 := ptr_read_i64(prev, j - 1)
                    if ca != ptr_read_u8(pb, j - 1) { d3 += 1 }
                    if d3 < d { d = d3 }
                    ptr_write_i64(curr, j, d)
                    j += 1
                }
                tmp := prev; prev = curr; curr = tmp
                i += 1
            }
            tot += ptr_read_i64(prev, len)
            p += 1
        }
        ptr_write_i64(out, tid, tot)
    }
}
fn b047_edit_dist(pairs: i64, len: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w047), pairs, len, scratch, 0, 0, 0, args, out) }
}

fn _w048(tid: i64, nt: i64, pool: i64) {
    unsafe {
        pairs := ptr_read_i64(pool, 4); len := ptr_read_i64(pool, 5); scratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        base := scratch + tid * 4096
        pa := base; pb := base + 256; mut prev := base + 512; mut curr := base + 2048
        p0 := (tid * pairs) / nt; p1 := ((tid + 1) * pairs) / nt
        mut tot := 0; mut p := p0
        while p < p1 {
            mut i := 0
            while i < len {
                ptr_write_u8(pa, i, (p * 5 + i * 3) % 12)
                ptr_write_u8(pb, i, (p * 7 + i * 4 + 2) % 12)
                i += 1
            }
            mem_set(prev, 0, (len + 1) * 8)
            i = 1
            while i <= len {
                ptr_write_i64(curr, 0, 0)
                ca := ptr_read_u8(pa, i - 1)
                mut j := 1
                while j <= len {
                    if ca == ptr_read_u8(pb, j - 1) {
                        ptr_write_i64(curr, j, ptr_read_i64(prev, j - 1) + 1)
                    } else {
                        mut m := ptr_read_i64(prev, j)
                        v2 := ptr_read_i64(curr, j - 1)
                        if v2 > m { m = v2 }
                        ptr_write_i64(curr, j, m)
                    }
                    j += 1
                }
                tmp := prev; prev = curr; curr = tmp
                i += 1
            }
            tot += ptr_read_i64(prev, len)
            p += 1
        }
        ptr_write_i64(out, tid, tot)
    }
}
fn b048_lcs_dp(pairs: i64, len: i64, scratch: i64, args: i64, out: i64) -> i64 {
    return unsafe { _dispatch_reduce_add(fn_addr(_w048), pairs, len, scratch, 0, 0, 0, args, out) }
}

fn _w049(tid: i64, nt: i64, pool: i64) {
    unsafe {
        queries := ptr_read_i64(pool, 4); cap := ptr_read_i64(pool, 5); scratch := ptr_read_i64(pool, 6); out := ptr_read_i64(pool, 9)
        dp := scratch + tid * 196608
        mut tot := 0; mut q := tid
        while q < queries {
            mem_set(dp, 0x3F, (cap + 1) * 8)
            ptr_write_i64(dp, 0, 0)
            mut ci := 0
            while ci < 32 {
                coin := 1 + ((ci * 17 + q * 3) % 97)
                mut a := coin
                while a <= cap {
                    cand := ptr_read_i64(dp, a - coin) + 1
                    if cand < ptr_read_i64(dp, a) { ptr_write_i64(dp, a, cand) }
                    a += 1
                }
                ci += 1
            }
            tot += ptr_read_i64(dp, cap)
            q += nt
        }
        ptr_write_i64(out, tid, tot)
    }
}
