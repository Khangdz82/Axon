    llm_gate := mem_alloc_aligned(1024 * 4 + 64); llm_up := mem_alloc_aligned(1024 * 4 + 64); llm_act := mem_alloc_aligned(1024 * 4 + 64)
    i = 0; while i < 1024 { ptr_write_f32(llm_x, i, ((i % 29) as f64) * 0.03 - 0.4); ptr_write_f32(llm_nw, i, 1.0 + ((i % 11) as f64) * 0.01); i += 1 }
    i = 0; while i < 1024 * 1024 { ptr_write_f32(llm_w1, i, ((i % 19) as f64) * 0.002 - 0.018); ptr_write_f32(llm_w2, i, ((i % 23) as f64) * 0.002 - 0.022); i += 1 }
    sm_mat := mem_alloc_aligned(384 * 384 * 8 + 64)
    i = 0; while i < 384 * 384 { ptr_write_f64(sm_mat, i, ((i % 61) as f64) * 0.05 - 1.5); i += 1 }
    att_q := mem_alloc_aligned(4 * 128 * 64 * 8 + 64); att_k := mem_alloc_aligned(4 * 128 * 64 * 8 + 64); att_v := mem_alloc_aligned(4 * 128 * 64 * 8 + 64)
    i = 0
    while i < 4 * 128 * 64 {
        ptr_write_f64(att_q, i, ((i % 37) as f64) * 0.03 - 0.5)
        ptr_write_f64(att_k, i, ((i % 41) as f64) * 0.03 - 0.6)
        ptr_write_f64(att_v, i, ((i % 43) as f64) * 0.03 - 0.6)
        i += 1
    }
    km_pts := mem_alloc_aligned(1536 * 32 * 8 + 64); km_cent := mem_alloc_aligned(16 * 32 * 8 + 256)
    km_sums := mem_alloc_aligned(16 * 16 * 32 * 8 + 64); km_cnts := mem_alloc_aligned(16 * 16 * 8 + 64)
    i = 0; while i < 1536 * 32 { ptr_write_f64(km_pts, i, (((i * 17 + 13) % 1009) as f64) * 0.002 - 1.0); i += 1 }

    // Warm up thread pool once (1 trivial dispatch so OS CreateThread cold cost is excluded fairly)
    _ := b091_bnn_gemv(bnn_w, bnn_a, bnn_o)

    times := ibuf_new(112)
    chks  := ibuf_new(112)
    mut t0 := 0

    // Domain 1 (B001..B010)
    t0 = clock_ns(); ibuf_push(chks, b001_branchless_clamp(4000000, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b002_fib_rec()); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b003_sieve(500000)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b004_popcnt(4000000, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b005_splitmix64(3000000, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b006_collatz(32000, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b007_gcd_euclid(64000, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b008_morton3d(4000000, morton_lut, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b009_modexp(48000, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b010_mat4x4_int(mat4_a, mat4_b, 32000, args, out)); ibuf_push(times, clock_ns() - t0)

    // Domain 2 (B011..B020)
    t0 = clock_ns(); ibuf_push(chks, b011_dot_f64(a_f64_1m, b_f64_1m, 1000000, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b012_saxpy_f32(x_f32_1m, y_f32_1m, d_f32_1m, 1000000, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b013_prefix_sum_i64(src_i64_512k, dst_i64_512k, 524288, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b014_histogram_256(data_2m, 2000000, scratch, args)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b015_minmax_i64(arr_i64_2m, 2000000, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b016_relu6_f32(x_f32_1m, 1000000, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b017_l1_l2_f64(a_f64_1m, 1000000, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b018_conv1d_k9_f32(x_f32_1m, d_f32_1m, 524288, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b019_variance_f64(a_f64_1m, 1000000, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b020_mat_transpose_512(mat512_src, mat512_dst, 512, args)); ibuf_push(times, clock_ns() - t0)

    // Domain 3 (B021..B030)
    t0 = clock_ns(); ibuf_push(chks, b021_parse_i64(p21_buf, 11, cnt_p21, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b022_mem_find(hay_2m, 2000000, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b023_json_parse(json_p, json_n, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b024_base64_rt(b512k, b64_enc, b64_dec, b64_etbl, b64_dtbl, 524288, args)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b025_csv_agg(csv_p, csv_n, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b026_hex_rt(b512k_hex, hex_enc, hex_dec, hex_tbl, hex_dtbl, 524288, args)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b027_utf8_count(utf8_2m, 2000000, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b028_rle_rt(rle_512k, 524288, scratch, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b029_varint_pb(varint_250k, 250000, scratch, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b030_url_query(url_p, url_n, args, out)); ibuf_push(times, clock_ns() - t0)

    // Domain 4 (B031..B040)
    t0 = clock_ns(); ibuf_push(chks, b031_sort_i64(orig_sort, work_sort, 48000)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b032_hashmap(12000)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b033_spsc_ring(1000000)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b034_bsearch(sorted_64k, 65536, bsearch_q, 80000, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b035_dsu(8, 4096, 16000, scratch, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b036_fenwick(8, 4096, 16000, scratch, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b037_topk_heap(topk_500k, 500000, scratch, args)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b038_bitset_popcnt(bs_a, bs_b, bs_c, 65536, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b039_bloom_filter(bloom_bits, bloom_q, 200000, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b040_radix_hist_scatter(topk_500k, topk_dst, 500000, scratch, args)); ibuf_push(times, clock_ns() - t0)

    // Domain 5 (B041..B050)
    t0 = clock_ns(); ibuf_push(chks, b041_dijkstra(g6k)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b042_bfs(bfs_rp, bfs_ci, 16000, bfs_dist, bfs_q)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b043_toposort(dag_rp, dag_ci, 32000, bfs_dist, bfs_q)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b044_floyd_warshall(fw_d, 160, barr, args)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b045_pagerank(pr_rp, pr_ci, pr_od, pr_a, pr_b, pr_n, barr, args)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b046_knapsack_dp(knap_dp)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b047_edit_dist(96, 128, scratch, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b048_lcs_dp(96, 128, scratch, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b049_coin_change(8, 12000, scratch, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b050_lis_patience(32, 2048, scratch, args, out)); ibuf_push(times, clock_ns() - t0)

    // Domain 6 (B051..B060)
    t0 = clock_ns(); ibuf_push(chks, b051_fnv1a_batch(b2m_c, 2097152, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b052_crc32(b2m_c, 2097152, crc_tbl)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b053_sha256_batch(b512k_sha, 524288, scratch, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b054_chacha20(16384, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b055_siphash24_batch(words_256k, 262144, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b056_murmur3_batch(words_256k, 262144, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b057_xxhash64_batch(words_256k, 262144, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b058_blake2s_batch(8192, scratch, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b059_hmac_sha256(hmac_256k, 262144, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b060_speck_ctr(262144, args, out)); ibuf_push(times, clock_ns() - t0)

    // Domain 7 (B061..B070)
    t0 = clock_ns(); ibuf_push(chks, b061_fft_16384(fft_re, fft_im)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b062_dct_ii(dct_data, dct_cos, 192, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b063_fir_64tap(fir_x, fir_h, 131072, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b064_iir_biquad(64, 4096, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b065_rk4_lorenz(128, 1000, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b066_gl16_quad(32768, gl_x, gl_w, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b067_mc_pi(4000000, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b068_black_scholes(48000, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b069_newton_cubic(48000, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b070_bilinear_interp(img_256, 256, 512, args, out)); ibuf_push(times, clock_ns() - t0)

    // Domain 8 (B071..B080)
    t0 = clock_ns(); ibuf_push(chks, b071_nbody_3d(96, 50, nb_buf, barr, args)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b072_mandelbrot(320, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b073_julia(224, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b074_ray_sphere(48000, sph_buf, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b075_aabb_overlap(1024, aabb_buf, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b076_sobel_edge(sobel_img, 512, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b077_gauss_blur(blur_img, blur_tmp, blur_dst, 512, barr, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b078_heat_2d(heat_a, heat_b, 256, 16, barr, args)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b079_verlet_3d(65536, 12, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b080_polygon_pip(64000, poly_buf, args, out)); ibuf_push(times, clock_ns() - t0)

    // Domain 9 (B081..B090)
    t0 = clock_ns(); ibuf_push(chks, b081_fp32_gemm(a384, b384, c384, 384)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b082_fp64_gemm(a256, b256, c256, 256)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b083_csr_spmv(sp_rp, sp_ci, sp_val, sp_x, sp_y, sp_n, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b084_cholesky(chol_l, 160, barr, args)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b085_lu_factor(8, 96, scratch, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b086_qr_mgs(qr_q, 128, barr, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b087_jacobi_sym(8, 32, scratch, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b088_tridiag_thomas(2048, 128, scratch, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b089_cg_sparse(cg_buf, 8192, 16, barr, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b090_outer_rank1(rk_a, rk_x, rk_y, 512, args)); ibuf_push(times, clock_ns() - t0)

    // Domain 10 (B091..B100)
    t0 = clock_ns(); ibuf_push(chks, b091_bnn_gemv(bnn_w, bnn_a, bnn_o)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b092_q4_0_gemv(act_2k, q4_2k, pout_2k, 2048, 2048, 2)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b093_q8_0_gemv(act_2k, q8_2k, pout_2k, 2048, 2048)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b094_bitnet_158(act_2k, bitnet_w, 2048, 2048, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b095_faiss_l2(faiss_v, faiss_q, faiss_d, 5000, 16, 128)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b096_cosine_topk(cos_v, cos_q, 4096, 8, 64, scratch, args)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b097_llm_ffn(llm_x, llm_nw, llm_norm, llm_w1, llm_w2, llm_gate, llm_up, llm_act, 1024)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b098_softmax_2d(sm_mat, 384, scratch, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b099_flash_attn(att_q, att_k, att_v, 128, 64, scratch, args, out)); ibuf_push(times, clock_ns() - t0)
    t0 = clock_ns(); ibuf_push(chks, b100_kmeans_lloyd(km_pts, km_cent, km_sums, km_cnts, 1536, 4, args)); ibuf_push(times, clock_ns() - t0)

    jout := buf_new(16384)
    buf_push_str(jout, "{\"lang\":\"Axon\",\"times_us\":[")
    i = 0
    while i < 100 {
        if i > 0 { buf_push(jout, 44) }
        buf_push_str(jout, str_from_i64(ibuf_get(times, i) / 1000))
        i += 1
    }
    buf_push_str(jout, "],\"chks\":[")
    i = 0
    while i < 100 {
        if i > 0 { buf_push(jout, 44) }
        buf_push_str(jout, str_from_i64(ibuf_get(chks, i)))
        i += 1
    }
    buf_push_str(jout, "]}")
    println(buf_to_owned_str(move jout))

    buf_free(move times); buf_free(move chks)
    buf_free(move jb); buf_free(move cb); buf_free(move ub); buf_free(move orig_sort); buf_free(move work_sort)
    graph_free(move g6k); mat_free(move fft_re); mat_free(move fft_im)
    mem_free_aligned(args); mem_free_aligned(out); mem_free_aligned(barr); mem_free_aligned(scratch)
    mem_free_aligned(morton_lut); mem_free_aligned(mat4_a); mem_free_aligned(mat4_b)
    mem_free_aligned(a_f64_1m); mem_free_aligned(b_f64_1m); mem_free_aligned(x_f32_1m); mem_free_aligned(y_f32_1m); mem_free_aligned(d_f32_1m)
    mem_free_aligned(src_i64_512k); mem_free_aligned(dst_i64_512k); mem_free_aligned(data_2m); mem_free_aligned(arr_i64_2m)
    mem_free_aligned(mat512_src); mem_free_aligned(mat512_dst); mem_free_aligned(p21_buf); mem_free_aligned(hay_2m)
    mem_free_aligned(b512k); mem_free_aligned(b64_enc); mem_free_aligned(b64_dec); mem_free_aligned(b64_etbl); mem_free_aligned(b64_dtbl)
    mem_free_aligned(b512k_hex); mem_free_aligned(hex_enc); mem_free_aligned(hex_dec); mem_free_aligned(hex_tbl); mem_free_aligned(hex_dtbl)
    mem_free_aligned(utf8_2m); mem_free_aligned(rle_512k); mem_free_aligned(varint_250k)
    mem_free_aligned(sorted_64k); mem_free_aligned(bsearch_q); mem_free_aligned(topk_500k); mem_free_aligned(topk_dst)
    mem_free_aligned(bs_a); mem_free_aligned(bs_b); mem_free_aligned(bs_c); mem_free_aligned(bloom_bits); mem_free_aligned(bloom_q)
    mem_free_aligned(bfs_rp); mem_free_aligned(bfs_ci); mem_free_aligned(bfs_dist); mem_free_aligned(bfs_q)
    mem_free_aligned(dag_rp); mem_free_aligned(dag_ci); mem_free_aligned(fw_d)
    mem_free_aligned(pr_rp); mem_free_aligned(pr_ci); mem_free_aligned(pr_od); mem_free_aligned(pr_a); mem_free_aligned(pr_b); mem_free_aligned(knap_dp)
    mem_free_aligned(b2m_c); mem_free_aligned(crc_tbl); mem_free_aligned(b512k_sha); mem_free_aligned(words_256k); mem_free_aligned(hmac_256k)
    mem_free_aligned(dct_data); mem_free_aligned(dct_cos); mem_free_aligned(fir_x); mem_free_aligned(fir_h)
    mem_free_aligned(gl_x); mem_free_aligned(gl_w); mem_free_aligned(img_256)
    mem_free_aligned(nb_buf); mem_free_aligned(sph_buf); mem_free_aligned(aabb_buf)
    mem_free_aligned(sobel_img); mem_free_aligned(blur_img); mem_free_aligned(blur_tmp); mem_free_aligned(blur_dst)
    mem_free_aligned(heat_a); mem_free_aligned(heat_b); mem_free_aligned(poly_buf)
    mem_free_aligned(a384); mem_free_aligned(b384); mem_free_aligned(c384); mem_free_aligned(a256); mem_free_aligned(b256); mem_free_aligned(c256)
    mem_free_aligned(sp_rp); mem_free_aligned(sp_ci); mem_free_aligned(sp_val); mem_free_aligned(sp_x); mem_free_aligned(sp_y)
    mem_free_aligned(chol_l); mem_free_aligned(qr_q); mem_free_aligned(cg_buf)
    mem_free_aligned(rk_a); mem_free_aligned(rk_x); mem_free_aligned(rk_y)
    mem_free_aligned(bnn_w); mem_free_aligned(bnn_a); mem_free_aligned(bnn_o)
    mem_free_aligned(act_2k); mem_free_aligned(pout_2k); mem_free_aligned(q4_2k); mem_free_aligned(q8_2k); mem_free_aligned(bitnet_w)
    mem_free_aligned(faiss_v); mem_free_aligned(faiss_q); mem_free_aligned(faiss_d); mem_free_aligned(cos_v); mem_free_aligned(cos_q)
    mem_free_aligned(llm_x); mem_free_aligned(llm_nw); mem_free_aligned(llm_norm); mem_free_aligned(llm_w1); mem_free_aligned(llm_w2)
    mem_free_aligned(llm_gate); mem_free_aligned(llm_up); mem_free_aligned(llm_act)
    mem_free_aligned(sm_mat); mem_free_aligned(att_q); mem_free_aligned(att_k); mem_free_aligned(att_v)
    mem_free_aligned(km_pts); mem_free_aligned(km_cent); mem_free_aligned(km_sums); mem_free_aligned(km_cnts)
    return 0
    }
}
