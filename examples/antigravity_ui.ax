// Axon Showcase: Antigravity Agentic IDE Desktop Clone (`examples/antigravity_ui.ax`)
// High-fidelity replica of Google DeepMind's Antigravity AI Assistant interface.
// Powered by Axon's Ultra-Lean Chromium WebView Host (`std/webview.ax`).
// Features:
// - 3-column IDE layout: Navigation & Sessions | Agent Trajectory & Input | Artifacts & Swarms
// - DeepMind purple/blue/cyan gradient branding & dark theme (slate-950/900/800)
// - Collapsible "Thinking Process" accordion with execution timing
// - Expandable tool call pills (`run_command`, `read_file`, `write_file`)
// - Slash commands bar (`/goal`, `/plan`, `/boost`, `/learn`, `/schedule`, `/browser`)
// - Live Axon Backend API IPC (`/api/chat`, `/api/status`, `/api/close`)
// - Subagent swarm status roster (7 auditors)
// - Resource monitor badge: RAM ~40MB, 0 junk files in cwd, auto-cleanup on exit.

use std::webview
use std::str
use std::sys

fn antigravity_html_page() -> str {
    mut h := "<!doctype html><html lang='en' class='dark'><head><meta charset='utf-8'/>"
    h = h + "<meta name='viewport' content='width=device-width, initial-scale=1.0'/>"
    h = h + "<title>Antigravity — Google DeepMind Agentic IDE</title>"
    h = h + "<script src='https://cdn.tailwindcss.com'></script>"
    h = h + "<style>"
    h = h + "body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }"
    h = h + "::-webkit-scrollbar { width: 5px; height: 5px; }"
    h = h + "::-webkit-scrollbar-track { background: #0b0f19; }"
    h = h + "::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 4px; }"
    h = h + "::-webkit-scrollbar-thumb:hover { background: #334155; }"
    h = h + ".brand-gradient { background: linear-gradient(135deg, #a855f7 0%, #38bdf8 50%, #34d399 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }"
    h = h + ".brand-bg-gradient { background: linear-gradient(135deg, #a855f7 0%, #38bdf8 50%, #34d399 100%); }"
    h = h + ".glow-border { box-shadow: 0 0 20px rgba(56, 189, 248, 0.15); }"
    h = h + ".code-font { font-family: 'JetBrains Mono', 'Cascadia Code', Consolas, monospace; }"
    h = h + "</style></head>"
    h = h + "<body class='bg-[#080c14] text-slate-100 flex flex-col h-screen overflow-hidden select-none'>"

    // --- TOP BAR ---
    h = h + "<header class='h-11 bg-[#0d131f] border-b border-slate-800/80 px-3 flex items-center justify-between text-xs shrink-0'>"
    h = h + "<div class='flex items-center gap-2.5'>"
    h = h + "<div class='w-6 h-6 rounded-lg brand-bg-gradient flex items-center justify-center shadow-lg shadow-purple-500/20'>"
    h = h + "<svg class='w-3.5 h-3.5 text-slate-950 font-black' fill='currentColor' viewBox='0 0 24 24'><path d='M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5'/></svg>"
    h = h + "</div>"
    h = h + "<span class='font-bold text-sm tracking-tight brand-gradient'>Antigravity</span>"
    h = h + "<span class='px-1.5 py-0.5 rounded text-[10px] bg-purple-950/70 border border-purple-800/50 text-purple-300 font-medium'>2.0 DeepMind</span>"
    h = h + "<div class='h-3 w-px bg-slate-800 mx-1'></div>"
    h = h + "<div class='flex items-center gap-1.5 px-2 py-1 rounded-md bg-slate-900 border border-slate-800 text-slate-300'>"
    h = h + "<svg class='w-3.5 h-3.5 text-sky-400' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z'/></svg>"
    h = h + "<span class='code-font text-[11px] text-slate-200'>Languague</span>"
    h = h + "<span class='text-[10px] text-slate-500'>master [7f4c5c7]</span>"
    h = h + "</div></div>"

    h = h + "<div class='flex items-center gap-3'>"
    h = h + "<div class='flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-slate-900 border border-slate-800 text-[11px]'>"
    h = h + "<span class='w-2 h-2 rounded-full bg-emerald-400 animate-pulse'></span>"
    h = h + "<span class='text-slate-300 font-medium'>Gemini 2.5 Pro</span>"
    h = h + "<span class='text-slate-500'>|</span>"
    h = h + "<span class='text-sky-400 font-medium'>Axon Native</span>"
    h = h + "</div>"
    h = h + "<div class='flex items-center gap-2 text-[11px] text-slate-400'>"
    h = h + "<span class='px-2 py-0.5 rounded bg-emerald-950/60 border border-emerald-800/50 text-emerald-300 font-mono'>RAM: 38.4 MB</span>"
    h = h + "<span class='px-2 py-0.5 rounded bg-sky-950/60 border border-sky-800/50 text-sky-300 font-mono'>0 Junk Files</span>"
    h = h + "</div>"
    h = h + "<button onclick='window.closeApp()' class='px-2 py-1 rounded hover:bg-rose-950/50 text-slate-400 hover:text-rose-400 transition-colors' title='Close'>"
    h = h + "<svg class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M6 18L18 6M6 6l12 12'/></svg>"
    h = h + "</button></div></header>"

    // --- MAIN 3-COLUMN WORKSPACE ---
    h = h + "<div class='flex flex-1 overflow-hidden'>"

    // COLUMN 1: LEFT ACTIVITY BAR & CONVERSATION SESSIONS (260px)
    h = h + "<aside class='w-64 bg-[#0a0f19] border-r border-slate-800/70 flex flex-col shrink-0'>"
    h = h + "<div class='p-2.5 border-b border-slate-800/60 flex items-center justify-between'>"
    h = h + "<span class='text-xs font-semibold text-slate-300 uppercase tracking-wider'>Sessions</span>"
    h = h + "<button onclick='window.newSession()' class='p-1 rounded hover:bg-slate-800 text-slate-400 hover:text-slate-100 transition-colors' title='New Session'>"
    h = h + "<svg class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 4v16m8-8H4'/></svg>"
    h = h + "</button></div>"

    h = h + "<div class='flex-1 overflow-y-auto p-2 space-y-1 text-xs'>"
    h = h + "<div class='p-2.5 rounded-lg bg-slate-900 border border-sky-500/40 text-slate-100 glow-border cursor-pointer flex flex-col gap-1'>"
    h = h + "<div class='flex items-center justify-between'><span class='font-semibold text-sky-300 truncate'>Antigravity UI Clone Test</span><span class='text-[10px] text-slate-500'>16:06</span></div>"
    h = h + "<p class='text-[11px] text-slate-400 truncate'>code thử 1 file UI UI antigravity làm càng giống càng tốt...</p>"
    h = h + "<div class='flex items-center gap-1.5 mt-1'><span class='w-1.5 h-1.5 rounded-full bg-emerald-400'></span><span class='text-[10px] text-slate-400'>Active • 7 Subagents</span></div>"
    h = h + "</div>"

    h = h + "<div class='p-2.5 rounded-lg hover:bg-slate-900/60 text-slate-300 cursor-pointer flex flex-col gap-1 transition-colors'>"
    h = h + "<div class='flex items-center justify-between'><span class='font-medium text-slate-300 truncate'>Tối ưu nhân Chromium</span><span class='text-[10px] text-slate-500'>15:50</span></div>"
    h = h + "<p class='text-[11px] text-slate-500 truncate'>Tối ưu std/webview.ax, dọn sạch %TEMP%, 64MB V8 heap...</p></div>"

    h = h + "<div class='p-2.5 rounded-lg hover:bg-slate-900/60 text-slate-300 cursor-pointer flex flex-col gap-1 transition-colors'>"
    h = h + "<div class='flex items-center justify-between'><span class='font-medium text-slate-300 truncate'>Deep Security Wave 3</span><span class='text-[10px] text-slate-500'>Hôm qua</span></div>"
    h = h + "<p class='text-[11px] text-slate-500 truncate'>Vá 9 module AI/ML/Math, thêm tests/pass/46...</p></div>"

    h = h + "<div class='p-2.5 rounded-lg hover:bg-slate-900/60 text-slate-300 cursor-pointer flex flex-col gap-1 transition-colors'>"
    h = h + "<div class='flex items-center justify-between'><span class='font-medium text-slate-300 truncate'>AI Agent Harness Suite</span><span class='text-[10px] text-slate-500'>22/11</span></div>"
    h = h + "<p class='text-[11px] text-slate-500 truncate'>Context budgeter, tool calling, ReAct swarm loop...</p></div>"
    h = h + "</div>"

    h = h + "<div class='p-2.5 border-t border-slate-800/70 bg-[#070b12] flex items-center gap-2'>"
    h = h + "<div class='w-7 h-7 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-xs font-bold text-sky-400'>A</div>"
    h = h + "<div class='flex-1 truncate'><div class='text-xs font-medium text-slate-200'>Admin</div><div class='text-[10px] text-slate-500'>Pro Plan • Unlimited</div></div>"
    h = h + "<span class='w-2 h-2 rounded-full bg-emerald-400'></span>"
    h = h + "</div></aside>"

    // COLUMN 2: CENTER AGENT CONVERSATION & EXECUTION TRAJECTORY (flex-1)
    h = h + "<main class='flex-1 flex flex-col bg-[#080c14] overflow-hidden'>"
    h = h + "<div id='chat-flow' class='flex-1 overflow-y-auto p-4 space-y-4'>"

    // Assistant Identity Header
    h = h + "<div class='p-4 rounded-xl bg-gradient-to-r from-purple-950/30 via-slate-900/40 to-sky-950/30 border border-slate-800/80 flex items-start gap-3'>"
    h = h + "<div class='w-8 h-8 rounded-lg brand-bg-gradient flex items-center justify-center shrink-0 shadow-md'>"
    h = h + "<svg class='w-4 h-4 text-slate-950 font-black' fill='currentColor' viewBox='0 0 24 24'><path d='M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5'/></svg></div>"
    h = h + "<div class='flex-1'>"
    h = h + "<div class='flex items-center gap-2'><span class='font-bold text-sm text-slate-100'>Antigravity</span><span class='text-xs text-purple-400 font-medium'>Google DeepMind Assistant</span></div>"
    h = h + "<p class='text-xs text-slate-400 mt-1'>Autonomous agentic systems developer. Connected to workspace <span class='code-font text-sky-400'>c:\\Users\\Admin\\Downloads\\Languague</span> (93 stdlib modules, 38,684 lines pure Axon).</p>"
    h = h + "</div></div>"

    // User Message Bubble
    h = h + "<div class='flex justify-end gap-2.5'>"
    h = h + "<div class='max-w-2xl bg-sky-950/40 border border-sky-800/60 rounded-2xl rounded-tr-none px-4 py-2.5 text-sm text-slate-100 shadow-sm'>"
    h = h + "<p>code thử 1 file UI UI antigravity làm càng giống càng tốt dây là test</p>"
    h = h + "<div class='text-[10px] text-sky-400/70 text-right mt-1'>16:06:59</div></div>"
    h = h + "<div class='w-7 h-7 rounded-full bg-sky-600 text-white font-bold flex items-center justify-center text-xs shrink-0'>U</div>"
    h = h + "</div>"

    // Assistant Response & Trajectory
    h = h + "<div class='flex items-start gap-2.5'>"
    h = h + "<div class='w-7 h-7 rounded-lg brand-bg-gradient flex items-center justify-center text-slate-950 text-xs font-black shrink-0'>A</div>"
    h = h + "<div class='flex-1 space-y-3'>"

    // Thinking Accordion
    h = h + "<div class='rounded-lg bg-slate-900/70 border border-slate-800 text-xs overflow-hidden'>"
    h = h + "<button onclick='window.toggleThinking()' class='w-full px-3 py-2 flex items-center justify-between text-slate-400 hover:text-slate-200 transition-colors'>"
    h = h + "<span class='flex items-center gap-2'><svg id='think-chevron' class='w-3.5 h-3.5 text-purple-400 transition-transform' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7'/></svg>"
    h = h + "<span class='font-medium text-slate-300'>Thinking Process</span><span class='text-[11px] text-slate-500'>(4.1s • 12 steps analyzed)</span></span>"
    h = h + "<span class='px-1.5 py-0.5 rounded text-[10px] bg-purple-950/60 text-purple-300 border border-purple-800/50'>Completed</span></button>"
    h = h + "<div id='think-body' class='px-3 py-2 border-t border-slate-800/60 text-slate-400 space-y-1.5 text-[11px] font-mono bg-[#060a12]'>"
    h = h + "<div>• User requested an authentic Antigravity agent IDE UI clone in 1 pure Axon file.</div>"
    h = h + "<div>• Utilized ultra-lean `std/webview.ax` runtime: 64MB V8 heap, 1 renderer process, zero junk folders in cwd.</div>"
    h = h + "<div>• Integrated 3-column layout, Google DeepMind gradient theme, slash command bar, and live IPC.</div>"
    h = h + "</div></div>"

    // Tool Call Badges
    h = h + "<div class='flex flex-wrap gap-2 text-[11px] font-mono'>"
    h = h + "<div class='px-2 py-1 rounded bg-slate-900/90 border border-slate-800 text-slate-300 flex items-center gap-1.5'>"
    h = h + "<span class='w-1.5 h-1.5 rounded-full bg-emerald-400'></span><span>default_api:run_command</span><span class='text-slate-500'>'git status'</span></div>"
    h = h + "<div class='px-2 py-1 rounded bg-slate-900/90 border border-slate-800 text-slate-300 flex items-center gap-1.5'>"
    h = h + "<span class='w-1.5 h-1.5 rounded-full bg-emerald-400'></span><span>default_api:write_file</span><span class='text-slate-500'>'examples/antigravity_ui.ax'</span></div>"
    h = h + "</div>"

    // Assistant Markdown Card
    h = h + "<div class='p-3.5 rounded-xl bg-slate-900/50 border border-slate-800/80 text-sm text-slate-200 space-y-3'>"
    h = h + "<p>Dưới đây là giao diện <strong>Antigravity IDE Clone</strong> được lập trình hoàn chỉnh bằng 100% Axon thuần (`.ax`) kết hợp nhân Chromium siêu tối ưu (`std/webview.ax`).</p>"
    h = h + "<div class='rounded-lg bg-[#060910] border border-slate-800 p-3 code-font text-xs text-sky-300 overflow-x-auto'>"
    h = h + "<div class='text-slate-500 text-[10px] mb-1'>// examples/antigravity_ui.ax</div>"
    h = h + "<div>use std::webview</div><div>use std::str</div><div class='mt-1 text-slate-400'>// Ultra-Lean runtime: RAM ~40MB, 0 Byte rác trong cwd!</div>"
    h = h + "<div>cfg := webview_default_config(\"Antigravity IDE\", 19280, 1400, 900, html)</div>"
    h = h + "<div>wv := webview_create_with_config(cfg) or return 1</div>"
    h = h + "<div>webview_open(wv)</div>"
    h = h + "</div>"
    h = h + "<p class='text-xs text-slate-400'>Bạn có thể thử nhập lệnh hoặc bấm vào các nút Slash Command bên dưới để test giao tiếp với Axon backend trực tiếp!</p>"
    h = h + "</div></div></div>"

    h = h + "</div>"

    // Slash Commands Quick Bar
    h = h + "<div class='px-4 py-1.5 bg-[#0a0f19] border-t border-slate-800/60 flex items-center gap-1.5 overflow-x-auto text-[11px]'>"
    h = h + "<span class='text-slate-500 font-medium mr-1'>Commands:</span>"
    h = h + "<button onclick='window.insertCommand(\"/goal \")' class='px-2 py-0.5 rounded bg-slate-900 border border-slate-800 hover:border-purple-500/50 text-purple-300 font-mono transition-colors'>/goal</button>"
    h = h + "<button onclick='window.insertCommand(\"/plan \")' class='px-2 py-0.5 rounded bg-slate-900 border border-slate-800 hover:border-sky-500/50 text-sky-300 font-mono transition-colors'>/plan</button>"
    h = h + "<button onclick='window.insertCommand(\"/boost \")' class='px-2 py-0.5 rounded bg-slate-900 border border-slate-800 hover:border-emerald-500/50 text-emerald-300 font-mono transition-colors'>/boost</button>"
    h = h + "<button onclick='window.insertCommand(\"/learn \")' class='px-2 py-0.5 rounded bg-slate-900 border border-slate-800 hover:border-amber-500/50 text-amber-300 font-mono transition-colors'>/learn</button>"
    h = h + "<button onclick='window.insertCommand(\"/schedule \")' class='px-2 py-0.5 rounded bg-slate-900 border border-slate-800 hover:border-slate-700 text-slate-300 font-mono transition-colors'>/schedule</button>"
    h = h + "</div>"

    // Prompt Input Bar
    h = h + "<div class='p-3 bg-[#0a0f19] border-t border-slate-800/80'>"
    h = h + "<div class='rounded-xl bg-[#0d131f] border border-slate-800 focus-within:border-sky-500/60 p-2.5 transition-colors glow-border'>"
    h = h + "<textarea id='prompt-input' rows='2' placeholder='Ask Antigravity anything, type / for commands...' class='w-full bg-transparent text-sm text-slate-100 placeholder-slate-500 focus:outline-none resize-none'></textarea>"
    h = h + "<div class='flex items-center justify-between pt-1.5 border-t border-slate-800/60 text-xs'>"
    h = h + "<div class='flex items-center gap-2 text-slate-400'>"
    h = h + "<button class='hover:text-slate-200 flex items-center gap-1'><svg class='w-3.5 h-3.5' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13'/></svg>Attach</button>"
    h = h + "<button class='hover:text-slate-200 flex items-center gap-1'><span class='text-sky-400'>@</span>Workspace</button>"
    h = h + "</div>"
    h = h + "<div class='flex items-center gap-2'>"
    h = h + "<span class='text-[11px] text-slate-500'>Enter to send</span>"
    h = h + "<button id='send-btn' onclick='window.sendMessage()' class='px-3 py-1.5 rounded-lg brand-bg-gradient text-slate-950 font-bold hover:opacity-90 flex items-center gap-1.5 shadow-md shadow-sky-500/20 transition-opacity'>"
    h = h + "<span>Send</span><svg class='w-3.5 h-3.5' fill='currentColor' viewBox='0 0 20 20'><path d='M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z'/></svg>"
    h = h + "</button></div></div></div></div></main>"

    // COLUMN 3: RIGHT PANEL - ARTIFACTS, SWARMS & METRICS (360px)
    h = h + "<aside class='w-80 bg-[#0a0f19] border-l border-slate-800/70 flex flex-col shrink-0'>"
    h = h + "<div class='h-10 border-b border-slate-800/70 flex items-center px-2 gap-1 text-xs font-medium'>"
    h = h + "<button onclick='window.switchTab(\"artifacts\")' id='tab-art' class='px-2.5 py-1 rounded bg-slate-900 text-sky-400 border border-slate-700/80 font-semibold'>Artifacts (3)</button>"
    h = h + "<button onclick='window.switchTab(\"swarms\")' id='tab-swarms' class='px-2.5 py-1 rounded text-slate-400 hover:text-slate-200'>Swarms (7)</button>"
    h = h + "<button onclick='window.switchTab(\"terminal\")' id='tab-term' class='px-2.5 py-1 rounded text-slate-400 hover:text-slate-200'>Terminal</button>"
    h = h + "</div>"

    // Artifacts Tab Content
    h = h + "<div id='content-artifacts' class='flex-1 overflow-y-auto p-3 space-y-3'>"
    h = h + "<div class='p-3 rounded-xl bg-slate-900 border border-slate-800 text-xs space-y-2'>"
    h = h + "<div class='flex items-center justify-between'><span class='font-bold text-slate-200'>std/webview.ax</span><span class='px-1.5 py-0.5 rounded text-[10px] bg-emerald-950 text-emerald-300 border border-emerald-800'>Active</span></div>"
    h = h + "<p class='text-slate-400 text-[11px]'>Ultra-Lean Chromium Host with %TEMP% ephemeral profile and V8 memory capping.</p>"
    h = h + "<div class='p-2 rounded bg-[#060910] text-[10px] font-mono text-slate-300 space-y-1'>"
    h = h + "<div class='flex justify-between'><span class='text-slate-500'>Lines:</span><span>685 lines</span></div>"
    h = h + "<div class='flex justify-between'><span class='text-slate-500'>V8 Old Space:</span><span class='text-emerald-400'>64 MB Cap</span></div>"
    h = h + "<div class='flex justify-between'><span class='text-slate-500'>Disk Cache:</span><span class='text-sky-400'>8 MB Max</span></div>"
    h = h + "<div class='flex justify-between'><span class='text-slate-500'>Project CWD:</span><span class='text-emerald-400'>0 B (Clean)</span></div>"
    h = h + "</div></div>"

    h = h + "<div class='p-3 rounded-xl bg-slate-900 border border-slate-800 text-xs space-y-2'>"
    h = h + "<div class='flex items-center justify-between'><span class='font-bold text-slate-200'>LEARN_AXON_VI.md</span><span class='text-[10px] text-slate-500'>Ch. 19 Updated</span></div>"
    h = h + "<p class='text-slate-400 text-[11px]'>Giáo trình chuẩn Axon v1.1 Tiếng Việt — 20 chương + 4 tuần lộ trình.</p></div>"
    h = h + "</div>"

    // Swarms Tab Content
    h = h + "<div id='content-swarms' class='flex-1 overflow-y-auto p-3 space-y-2 hidden text-xs font-mono'>"
    h = h + "<div class='text-[11px] text-slate-500 uppercase tracking-wider mb-1'>Active Subagents (7)</div>"
    h = h + "<div class='p-2 rounded bg-slate-900 border border-slate-800 flex items-center justify-between'><span>Compiler Auditor</span><span class='text-emerald-400'>● Ready</span></div>"
    h = h + "<div class='p-2 rounded bg-slate-900 border border-slate-800 flex items-center justify-between'><span>AI & Serving Auditor</span><span class='text-emerald-400'>● Ready</span></div>"
    h = h + "<div class='p-2 rounded bg-slate-900 border border-slate-800 flex items-center justify-between'><span>Stdlib Auditor</span><span class='text-emerald-400'>● Ready</span></div>"
    h = h + "<div class='p-2 rounded bg-slate-900 border border-slate-800 flex items-center justify-between'><span>MCP & CLI Auditor</span><span class='text-emerald-400'>● Ready</span></div>"
    h = h + "<div class='p-2 rounded bg-slate-900 border border-slate-800 flex items-center justify-between'><span>Parsers Auditor</span><span class='text-emerald-400'>● Ready</span></div>"
    h = h + "<div class='p-2 rounded bg-slate-900 border border-slate-800 flex items-center justify-between'><span>Net & Crypto Auditor</span><span class='text-emerald-400'>● Ready</span></div>"
    h = h + "<div class='p-2 rounded bg-slate-900 border border-slate-800 flex items-center justify-between'><span>Deep Security Auditor</span><span class='text-emerald-400'>● Ready</span></div>"
    h = h + "</div>"

    // Terminal Tab Content
    h = h + "<div id='content-terminal' class='flex-1 overflow-y-auto p-3 font-mono text-[11px] text-slate-300 space-y-1.5 bg-[#060a12] hidden'>"
    h = h + "<div class='text-emerald-400'>$ bin/axc.exe check tests/pass/47_webview_chromium_opt.ax</div>"
    h = h + "<div class='text-slate-400'>[OK] `47_webview_chromium_opt.ax` verified in 12778 us (0 errors)</div>"
    h = h + "<div class='text-emerald-400 mt-2'>$ bin/axc.exe test tests/pass/47_webview_chromium_opt.ax</div>"
    h = h + "<div class='text-slate-400'>[PASS] All Axon @test functions passed: 6</div>"
    h = h + "<div class='text-emerald-400 mt-2'>$ git push origin master</div>"
    h = h + "<div class='text-slate-400'>50fcbba..7f4c5c7 master -> master</div>"
    h = h + "</div>"

    h = h + "</aside></div>"

    // JAVASCRIPT LOGIC
    h = h + "<script>"
    h = h + "window.toggleThinking = function() {"
    h = h + "  const body = document.getElementById('think-body');"
    h = h + "  const ch = document.getElementById('think-chevron');"
    h = h + "  if (body.classList.contains('hidden')) { body.classList.remove('hidden'); ch.style.transform = 'rotate(0deg)'; }"
    h = h + "  else { body.classList.add('hidden'); ch.style.transform = 'rotate(-90deg)'; }"
    h = h + "};"
    h = h + "window.switchTab = function(tab) {"
    h = h + "  ['artifacts', 'swarms', 'terminal'].forEach(t => {"
    h = h + "    document.getElementById('content-' + t).classList.add('hidden');"
    h = h + "    document.getElementById('tab-' + (t === 'artifacts' ? 'art' : t)).className = 'px-2.5 py-1 rounded text-slate-400 hover:text-slate-200';"
    h = h + "  });"
    h = h + "  document.getElementById('content-' + tab).classList.remove('hidden');"
    h = h + "  document.getElementById('tab-' + (tab === 'artifacts' ? 'art' : tab)).className = 'px-2.5 py-1 rounded bg-slate-900 text-sky-400 border border-slate-700/80 font-semibold';"
    h = h + "};"
    h = h + "window.insertCommand = function(cmd) {"
    h = h + "  const inp = document.getElementById('prompt-input');"
    h = h + "  inp.value = cmd; inp.focus();"
    h = h + "};"
    h = h + "window.sendMessage = async function() {"
    h = h + "  const inp = document.getElementById('prompt-input');"
    h = h + "  const text = inp.value.trim();"
    h = h + "  if (!text) return;"
    h = h + "  const chat = document.getElementById('chat-flow');"
    h = h + "  const uMsg = document.createElement('div');"
    h = h + "  uMsg.className = 'flex justify-end gap-2.5';"
    h = h + "  uMsg.innerHTML = `<div class='max-w-2xl bg-sky-950/40 border border-sky-800/60 rounded-2xl rounded-tr-none px-4 py-2.5 text-sm text-slate-100 shadow-sm'><p>${text}</p></div><div class='w-7 h-7 rounded-full bg-sky-600 text-white font-bold flex items-center justify-center text-xs shrink-0'>U</div>`;"
    h = h + "  chat.appendChild(uMsg);"
    h = h + "  inp.value = '';"
    h = h + "  chat.scrollTop = chat.scrollHeight;"
    h = h + "  try {"
    h = h + "    const resp = await fetch('/api/chat', { method: 'POST', body: text });"
    h = h + "    const data = await resp.json();"
    h = h + "    const aMsg = document.createElement('div');"
    h = h + "    aMsg.className = 'flex items-start gap-2.5';"
    h = h + "    aMsg.innerHTML = `<div class='w-7 h-7 rounded-lg brand-bg-gradient flex items-center justify-center text-slate-950 text-xs font-black shrink-0'>A</div><div class='p-3.5 rounded-xl bg-slate-900/50 border border-slate-800/80 text-sm text-slate-200 flex-1'><p>${data.reply}</p></div>`;"
    h = h + "    chat.appendChild(aMsg);"
    h = h + "    chat.scrollTop = chat.scrollHeight;"
    h = h + "  } catch (e) { console.error(e); }"
    h = h + "};"
    h = h + "window.closeApp = async function() {"
    h = h + "  try { await fetch('/api/close'); } catch(e){}"
    h = h + "  window.close();"
    h = h + "};"
    h = h + "document.getElementById('prompt-input').addEventListener('keydown', function(e) {"
    h = h + "  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); window.sendMessage(); }"
    h = h + "});"
    h = h + "</script></body></html>"
    return h
}

fn run_antigravity_event_loop(wv: WebviewApp) {
    while true {
        req := webview_next_api_req(wv) or return
        if str_eq(req.path, "/api/close") {
            _ := webview_reply_json(req, "{\"status\":\"closed\"}")
            return
        }
        if str_eq(req.path, "/api/chat") {
            user_msg := req.body
            reply := f"Antigravity Agent nhan duoc: '{user_msg}'. Backend Axon dang xu ly sieu toc qua IPC 0.05ms!"
            json := f"{{\"reply\":\"{reply}\",\"status\":\"ok\"}}"
            _ := webview_reply_json(req, json)
            continue
        }
        if str_eq(req.path, "/api/status") {
            json := f"{{\"agent\":\"Antigravity v2.0\",\"ram_mb\":38.4,\"cwd_clean\":true}}"
            _ := webview_reply_json(req, json)
            continue
        }
        // Fallback 404
        _ := webview_reply_text(req, "404 Not Found", 404)
    }
}

fn main() -> i32 {
    println("=== [Starting Antigravity Agentic IDE Clone in Pure Axon] ===")
    println("Engine: Ultra-Lean Chromium WebView (std/webview.ax)")
    println("Profile Dir: %TEMP% Ephemeral (Zero project cwd pollution)")
    println("Memory Cap: 64 MB V8 old space, 1 renderer process")

    html := antigravity_html_page()
    cfg := webview_default_config("Antigravity — Google DeepMind Agentic IDE", 19280, 1400, 900, html)
    wv := webview_create_with_config(cfg) or return 1

    println(f"[OK] Localhost server listening on http://127.0.0.1:{wv.port}/")
    println(f"[OK] Ephemeral user data directory: {wv.profile_dir}")

    ok_open := webview_open(wv)
    if not ok_open {
        println("[ERROR] Could not launch native browser window.")
        webview_close(wv)
        return 1
    }

    println("[OK] Antigravity UI window launched successfully!")
    println("Listening for frontend REST/IPC requests (press Ctrl+C or close window to exit)...")

    // Event loop: handles API calls from frontend JavaScript
    run_antigravity_event_loop(wv)

    println("Closing Antigravity window & cleaning ephemeral profile...")
    webview_close(wv)
    println("=== [Shutdown complete. Ephemeral profile wiped.] ===")
    return 0
}
