// Test Win32 directory traversal in Axon
use std::ffi
use std::os
use std::str

fn test_dir() {
    k := ffi_open("kernel32.dll", "libc.so.6", "")
    if k == 0 {
        println("Failed to open kernel32")
        return
    }

    f_find_first := ffi_sym(k, "FindFirstFileA")
    f_find_next  := ffi_sym(k, "FindNextFileA")
    f_find_close := ffi_sym(k, "FindClose")

    println(f"FindFirstFileA: {f_find_first}")
    println(f"FindNextFileA: {f_find_next}")
    println(f"FindClose: {f_find_close}")

    find_data := ffi_alloc(512)
    pattern := ffi_cstr(".\\*")

    h := ffi_call2(f_find_first, pattern, find_data)
    println(f"Search handle: {h}")

    if h != -1 and h != 0 {
        mut count := 0
        while count < 10 {
            attr := ffi_read_u32_le(find_data, 0)
            is_dir := (attr & 16) != 0
            name := ffi_read_cstr(find_data + 44, 260)
            
            dir_str := "[DIR]" if is_dir else "[FILE]"
            println(f"  {dir_str} {name}")

            ok_n := ffi_call2(f_find_next, h, find_data) & 0xFFFFFFFF
            if ok_n == 0 {
                break
            }
            count += 1
        }
        _ := ffi_call1(f_find_close, h)
    }

    ffi_free(find_data)
    ffi_free(pattern)
}

fn main() -> i32 {
    println("Testing Axon Win32 FindFirstFile...")
    test_dir()
    return 0
}
