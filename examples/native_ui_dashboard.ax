// Axon Showcase: Zero-CEF Native HTML+CSS Desktop UI (`examples/native_ui_dashboard.ax`)
// Demonstrates rendering modern HTML5 & CSS3 Flexbox components purely in Axon Native.

use std::ui
use std::terminal
use std::time

fn main() -> i64 {
    println(term_bold(term_cyan("=== [Axon Native UI/UX Engine Demo] ===")))
    println("Engine: 100% Pure Axon Native | Zero CEF | Zero Chromium | Zero Electron\n")

    sw := sw_start()

    mut app := ui_app_new("Axon Control Center", 800, 600)

    html_code := 
        "<div id=\"app-root\" class=\"window\" style=\"display: flex; flex-direction: column; padding: 24px; gap: 20px;\">" +
            ui_component_navbar("AXON CORE MONITOR", "v1.0.0 NATIVE") +
            "<div class=\"grid-row\" style=\"display: flex; flex-direction: row; gap: 16px;\">" +
                ui_component_stat_box("CPU USAGE", "1.2% NATIVE") +
                ui_component_stat_box("FRAME TIME", "0.45 ms") +
                ui_component_stat_box("MEMORY FOOTPRINT", "64.5 KB") +
            "</div>" +
            ui_component_card("sec-card", "ZERO-CEF RUNTIME ARCHITECTURE", "Axon compiles HTML & CSS into a native DOM tree and solves Flexbox layout directly on CPU SIMD with zero WebKit or Chromium overhead.", "START SCAN") +
        "</div>"

    css_code := 
        ".window { background: #0f172a; }" +
        ".stat-box { width: 230px; border-width: 1px; border-color: #334155; }" +
        ".card { border-width: 1px; border-color: #3b82f6; }"

    ui_set_html(mut app, html_code)
    ui_set_css(mut app, css_code)

    // Render frame
    canv := ui_render(mut app)

    elapsed_us := sw_elapsed_us(sw)
    println(term_green(f"[SUCCESS] UI rendered in {elapsed_us} us! Canvas resolution: {canv.width}x{canv.height}"))

    // Export frame
    bmp := ui_export_bmp(app)
    println(f"[EXPORT] Frame exported to 32-bit BMP ({buf_len(bmp)} bytes).")
    buf_free(move bmp)

    return 0
}
