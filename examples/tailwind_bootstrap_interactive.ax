// Axon Showcase: HTML + Tailwind CSS + Bootstrap 5 + JS Reactivity (`examples/tailwind_bootstrap_interactive.ax`)
// 100% Pure Axon Native: Zero Chromium, Zero CEF, Zero Node.js, Zero NPM.

use std::ui
use std::html
use std::css
use std::ui_js
use std::terminal
use std::time

fn main() -> i64 {
    println(term_bold(term_cyan("=================================================================")))
    println(term_bold(term_white("  🚀 [Axon UI] Native HTML5 + Tailwind + Bootstrap + JS Engine")))
    println(term_dim("  - Zero CEF / Zero Chromium / Zero Electron / Zero WebKit"))
    println(term_dim("  - Zero PostCSS / Zero Node.js / Zero NPM / Zero Dependencies"))
    println(term_bold(term_cyan("=================================================================\n")))

    sw := sw_start()

    mut app := ui_app_new("Axon Fullstack Web-Native UI", 800, 600)

    html_code := 
        "<div id=\"app-root\" class=\"flex flex-col gap-4 p-6 bg-slate-950 rounded-2xl\">" +
            // Header with Tailwind flexbox and Bootstrap badge
            "<header class=\"flex justify-between items-center p-4 bg-slate-900 rounded-xl border border-slate-800\">" +
                "<div class=\"flex items-center gap-3\">" +
                    "<h1 class=\"text-white font-bold text-xl\">AXON FULLSTACK</h1>" +
                    "<span class=\"badge bg-success\">NATIVE v1.0</span>" +
                "</div>" +
                "<div class=\"flex gap-2\">" +
                    "<span class=\"badge bg-primary\">TAILWIND</span>" +
                    "<span class=\"badge bg-info\">BOOTSTRAP</span>" +
                "</div>" +
            "</header>" +

            // Metrics row using Tailwind flex and grid cards
            "<div class=\"flex flex-row gap-4\">" +
                "<div class=\"flex flex-col p-4 bg-slate-900 rounded-xl border border-slate-800 w-64\">" +
                    "<span class=\"text-slate-500 text-xs\">ENGINE FOOTPRINT</span>" +
                    "<span class=\"text-emerald-400 font-bold text-xl\">64.5 KB</span>" +
                "</div>" +
                "<div class=\"flex flex-col p-4 bg-slate-900 rounded-xl border border-slate-800 w-64\">" +
                    "<span class=\"text-slate-500 text-xs\">RENDER LATENCY</span>" +
                    "<span class=\"text-blue-400 font-bold text-xl\">< 1.0 ms</span>" +
                "</div>" +
                "<div class=\"flex flex-col p-4 bg-slate-900 rounded-xl border border-slate-800 w-64\">" +
                    "<span class=\"text-slate-500 text-xs\">CHROMIUM OVERHEAD</span>" +
                    "<span class=\"text-amber-400 font-bold text-xl\">0.0 MB</span>" +
                "</div>" +
            "</div>" +

            // Interactive Card with JS onclick action
            "<div class=\"card p-6 bg-slate-900 rounded-xl border border-slate-800 flex flex-col gap-3\">" +
                "<h2 class=\"text-white font-semibold text-lg\">Interactive JavaScript Reactivity</h2>" +
                "<p class=\"text-slate-400\">Click the button below to trigger inline JS onclick action and reactive DOM reflow without browser runtime.</p>" +
                "<div class=\"flex gap-3 items-center\">" +
                    "<button id=\"counter-btn\" class=\"btn btn-primary\" onclick=\"increment:clicks:counter-btn:Clicks: \">Clicks: 0</button>" +
                    "<button id=\"toggle-btn\" class=\"btn btn-secondary\" onclick=\"toggle:info-banner:d-none\">Toggle Alert</button>" +
                "</div>" +
            "</div>" +

            // Dynamic Alert Box
            "<div id=\"info-banner\" class=\"alert alert-success\">" +
                "State updated! Axon native DOM tree and 32-bit ARGB rasterizer reacted in real time." +
            "</div>" +
        "</div>"

    ui_set_html(mut app, html_code)

    // First render pass
    canv := ui_render(mut app)
    ms1 := sw_elapsed_us(sw)
    println(term_green(f"[PASS 1] HTML+CSS+Tailwind parsed and rendered in {ms1} us!"))

    // Simulate user interaction: Click button to increment counter
    btn_idx := dom_find_by_id(app.tree, "counter-btn")
    bx := layout_get_x(app.layout, btn_idx)
    by := layout_get_y(app.layout, btn_idx)
    ui_dispatch_click(mut app, bx + 5, by + 5)

    // Render pass 2 (reactive DOM update)
    ui_render(mut app)
    println(term_yellow(f"[PASS 2] Reactive onclick event handled: Button text updated to '{dom_get_text(app.tree, btn_idx)}'"))

    // Export frame
    bmp := ui_export_bmp(app)
    println(term_blue(f"[EXPORT] Frame buffer exported to BMP ({buf_len(bmp)} bytes)."))
    buf_free(move bmp)

    println(term_bold(term_green("\n✨ Full HTML/CSS/JS + Tailwind + Bootstrap stack verified 100% native!")))
    return 0
}
