// Axon Native Zero-CEF UI Showcase: Minimalist, Ultra-Fast & Standard Web Syntax
use std::ui

fn main() -> i64 {
    println("=== [Axon Native UI Engine - Ultra-Fast Zero-CEF Architecture] ===")

    // 1. Khởi tạo cửa sổ và load file index.html chỉ trong 1 dòng!
    mut app := ui_window("Axon Native Dashboard", 800, 600, "examples/standard_html_tailwind/index.html")
    println(f"[1] Khoi tao window & parse DOM thanh cong: {app.tree.count} elements")

    // 2. Render giao dien ARGB tren CPU (< 1 ms tren SIMD, khong can CEF/Chromium)
    ui_render(mut app)
    println(f"[2] Render frame thanh cong: {app.width}x{app.height} 32-bit ARGB")

    // 3. Dispatch click chuot vao button (chay JavaScript onclick tu HTML)
    clicked_id := ui_click(mut app, 890, 100)
    println(f"[3] Click chuot vao button: id='{clicked_id}'")

    // 4. Doc reactive DOM state bang helper 1 dong
    state_text := ui_get_text(app, "click-counter")
    println(f"[4] Reactive DOM innerText sau click: '{state_text}'")

    // 5. Chinh sua DOM truc tiep bang code Axon
    ui_set_text(mut app, "status-desc", "Axon CPU Engine: 0% CEF, 0% Chromium, < 10MB RAM!")
    updated_desc := ui_get_text(app, "status-desc")
    println(f"[5] Chinh sua DOM truc tiep: '{updated_desc}'")

    // 6. Xuat anh chup man hinh chi trong 1 dong
    ok_shot := ui_save_screenshot(app, "examples/standard_html_tailwind/screenshot.bmp")
    println(f"[6] Luu screenshot bitmap thanh cong: {ok_shot}")

    println("=== [TOAN BO HE THONG HOAN HAO & SAN SANG] ===")
    return 0
}
