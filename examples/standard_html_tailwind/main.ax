// Axon Example: Running standard index.html + Tailwind CSS + JS natively with Zero CEF
use std::os
use std::ui

fn main() -> i64 {
    println("--- Axon Native Zero-CEF HTML5/Tailwind/Bootstrap/JS Engine ---")

    // 1. One-line loading of standard index.html directly from disk
    mut app := ui_app_new("Axon Native App", 800, 600)
    ok := ui_load_html_file(mut app, "examples/standard_html_tailwind/index.html")
    if not ok {
        println("ERROR: Could not load examples/standard_html_tailwind/index.html")
        return 1
    }

    println(f"[1] Loaded index.html successfully: {app.tree.count} DOM elements")
    println(f"[2] Extracted embedded <style> CSS: {app.sheet.rule_count} rules")

    // 2. High-speed initial rendering (< 1 millisecond on CPU)
    canv1 := ui_render(mut app)
    println(f"[3] Rendered initial frame: {canv1.width}x{canv1.height}px 32-bit ARGB canvas")

    // 3. User interaction: click button #btn-click
    btn_node := document_get_element_by_id(app.tree, "btn-click")
    bx := layout_get_x(app.layout, btn_node)
    by := layout_get_y(app.layout, btn_node)
    bw := layout_get_w(app.layout, btn_node)
    bh := layout_get_h(app.layout, btn_node)
    println(f"[3.5] Button '#btn-click' layout geometry: x={bx}, y={by}, w={bw}, h={bh}")

    clicked_id := ui_dispatch_click(mut app, bx + 5, by + 5)
    println(f"[4] Mouse clicked target: id='{clicked_id}'")

    // 4. Verify reactive DOM update
    node_idx := document_get_element_by_id(app.tree, "click-counter")
    current_text := dom_get_text(app.tree, node_idx)
    println(f"[5] Reactive DOM state after click: '{current_text}'")

    // 5. Export rendered frame to native 32-bit BMP bitmap
    bmp_data := ui_export_bmp(app)
    wb := fs_write_file("examples/standard_html_tailwind/rendered_frame.bmp", bmp_data) or 0
    println(f"[6] Saved native frame to 'examples/standard_html_tailwind/rendered_frame.bmp' ({buf_len(bmp_data)} bytes)")
    println("--- ALL SYSTEMS OPERATIONAL ---")
    return 0
}
