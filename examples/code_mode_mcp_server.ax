// Standalone 100% Pure-Axon Code Mode MCP Server (`examples/code_mode_mcp_server.ax`)
// Zero Python, Zero Node.js, Zero GC — compiles in milliseconds to a standalone native executable.
// Exposes 2 ultra-lightweight MCP tools over JSON-RPC 2.0 stdio:
//   - `code_batch` : Execute a batched JSON pipeline (`read`, `glob`, `grep`, `ls`, `tree`, `write`, `edit`) in ONE native call
//   - `grep_fast`  : High-speed SWAR literal / compiled-regex codebase search with binary & ignore-dir skipping

use std::str
use std::ds
use std::json_dom
use std::mcp
use std::agent_toolkit
use std::sys

fn main() -> i32 {
    mut srv := mcp_server_new(
        "axon-code-mode",
        "1.1.1",
        "Pure-Axon Code Mode MCP Server: batch multi-file reads, globs, SWAR greps, trees, and atomic edits into ONE sub-millisecond native `code_batch` call."
    )
    _ := mcp_server_add_tool(
        mut srv,
        "code_batch",
        "Execute a batched JSON pipeline of workspace ops (`read`, `glob`, `grep`, `ls`, `tree`, `write`, `edit`) in ONE fast native call.",
        "{\"type\":\"object\",\"properties\":{\"workspace\":{\"type\":\"string\"},\"pipeline\":{\"type\":\"array\"},\"read_only\":{\"type\":\"boolean\"}},\"required\":[\"pipeline\"]}"
    )
    _ := mcp_server_add_tool(
        mut srv,
        "grep_fast",
        "Fast SWAR literal / regex codebase search skipping binaries and ignored folders.",
        "{\"type\":\"object\",\"properties\":{\"pattern\":{\"type\":\"string\"},\"path\":{\"type\":\"string\"},\"glob_filter\":{\"type\":\"string\"},\"ignore_case\":{\"type\":\"boolean\"},\"max_results\":{\"type\":\"integer\"}},\"required\":[\"pattern\"]}"
    )

    line_buf := buf_new(1048576)
    while true {
        n := stdin_read_line(line_buf)
        if n < 0 { break }
        if n == 0 { continue }
        raw := str_trim(buf_slice_str(line_buf, 0, n))
        if str_len(raw) == 0 { continue }

        req := mcp_server_handle_line(srv, raw)
        if req.is_notification { continue }
        if not req.is_tool_call {
            if str_len(req.auto_response) > 0 {
                println(req.auto_response)
            }
            continue
        }

        // Dispatch `tools/call`
        mut out_res := ""
        if str_eq(req.tool_name, "code_batch") {
            doc := jdoc_parse(req.tool_args_json) or JsonDoc(nodes = ibuf_new(0), nodes_cap = 0, node_count = 0, strings = buf_new(0), str_cap = 0, root = -1)
            if doc.root < 0 {
                out_res = mcp_tool_text_result("Invalid JSON arguments", true, 4096)
            } else {
                ws_n := jdoc_obj_get(doc, doc.root, "workspace")
                pl_n := jdoc_obj_get(doc, doc.root, "pipeline")
                ro_n := jdoc_obj_get(doc, doc.root, "read_only")
                ws := if ws_n >= 0 and jdoc_type(doc, ws_n) == JVAL_STR() { jdoc_as_str(doc, ws_n, ".") } else { "." }
                ro := if ro_n >= 0 { jdoc_as_bool(doc, ro_n, true) } else { true }
                if pl_n < 0 {
                    out_res = mcp_tool_text_result("Missing required 'pipeline' array", true, 4096)
                } else {
                    pl_json := jdoc_stringify(doc, pl_n, false, 0)
                    batch_out := tk_exec_batch_json(ws, pl_json, ro, true, 8000)
                    out_res = mcp_tool_text_result(batch_out, false, 50000)
                }
            }
            jdoc_free(move doc)
        } else if str_eq(req.tool_name, "grep_fast") {
            doc := jdoc_parse(req.tool_args_json) or JsonDoc(nodes = ibuf_new(0), nodes_cap = 0, node_count = 0, strings = buf_new(0), str_cap = 0, root = -1)
            if doc.root < 0 {
                out_res = mcp_tool_text_result("Invalid JSON arguments", true, 4096)
            } else {
                p_n  := jdoc_obj_get(doc, doc.root, "pattern")
                pa_n := jdoc_obj_get(doc, doc.root, "path")
                gf_n := jdoc_obj_get(doc, doc.root, "glob_filter")
                ic_n := jdoc_obj_get(doc, doc.root, "ignore_case")
                mr_n := jdoc_obj_get(doc, doc.root, "max_results")
                pat := if p_n >= 0 { jdoc_as_str(doc, p_n, "") } else { "" }
                pth := if pa_n >= 0 { jdoc_as_str(doc, pa_n, ".") } else { "." }
                gf  := if gf_n >= 0 { jdoc_as_str(doc, gf_n, "") } else { "" }
                ic  := if ic_n >= 0 { jdoc_as_bool(doc, ic_n, false) } else { false }
                mr  := if mr_n >= 0 { jdoc_as_i64(doc, mr_n, 100) } else { 100 }
                if str_len(pat) == 0 {
                    out_res = mcp_tool_text_result("Missing required 'pattern'", true, 4096)
                } else {
                    hits := tk_grep(pat, pth, gf, ic, true, 0, mr, false, false)
                    out_res = mcp_tool_text_result(hits, false, 50000)
                }
            }
            jdoc_free(move doc)
        } else {
            out_res = mcp_tool_text_result("Unknown tool: " + req.tool_name, true, 4096)
        }
        println(mcp_build_ok(req.id_raw, out_res))
    }

    buf_free(move line_buf)
    mcp_server_free(move srv)
    return 0
}
