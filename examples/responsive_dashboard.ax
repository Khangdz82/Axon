// Axon Native Showcase: Nova AI Cloud & Infrastructure Operations Center (`examples/responsive_dashboard.ax`)
// 100% Pure Axon Native Direct2D UI Engine (`std/ui.ax` + `std/gui.ax`).
//
// Highlights:
// 1. Zero Chromium, Zero WebView, Zero Electron, Zero Localhost Web Server, Zero CMD Console!
// 2. Responsive Design: Live Flexbox reflow, CSS Grid (1 col mobile -> 2 cols tablet -> 4 cols desktop),
//    Tailwind responsive modifiers (`hidden lg:flex`, `grid-cols-1 sm:grid-cols-2 lg:grid-cols-4`, etc.),
//    and live window resize handling in CSS DIPs.
// 3. Ultra-low Resource Footprint: < 12 MB RAM, 0.00% idle CPU, single 530 KB standalone PE binary.
// 4. In-process JavaScript reactivity: dynamic tabs, live metric simulation, interactive command dispatch.

use std::ui
use std::gui
use std::str

fn build_responsive_dashboard_html() -> str {
    mut h := "<style>\n"
    h = h + ":root { --brand: #38bdf8; --purple: #a855f7; --emerald: #10b981; --amber: #f59e0b; }\n"
    h = h + ".brand-gradient { color: #38bdf8; font-weight: 800; }\n"
    h = h + ".card-dark { background-color: #0b0f19; border: 1px solid #1e293b; border-radius: 8px; }\n"
    h = h + ".card-hover:hover { border-color: #38bdf8; background-color: #0f172a; }\n"
    h = h + ".card-active { background-color: #0f172a; border: 1px solid #38bdf8; border-radius: 8px; }\n"
    h = h + ".badge-blue { background-color: #082f49; color: #38bdf8; border: 1px solid #0284c7; border-radius: 4px; padding: 2px 8px; font-size: 11px; font-weight: 600; }\n"
    h = h + ".badge-emerald { background-color: #022c22; color: #34d399; border: 1px solid #059669; border-radius: 4px; padding: 2px 8px; font-size: 11px; font-weight: 600; }\n"
    h = h + ".badge-purple { background-color: #2e1065; color: #c084fc; border: 1px solid #7c3aed; border-radius: 4px; padding: 2px 8px; font-size: 11px; font-weight: 600; }\n"
    h = h + ".badge-amber { background-color: #451a03; color: #fbbf24; border: 1px solid #d97706; border-radius: 4px; padding: 2px 8px; font-size: 11px; font-weight: 600; }\n"
    h = h + ".btn-primary { background-color: #0284c7; color: #ffffff; border-radius: 6px; padding: 6px 14px; font-weight: bold; font-size: 12px; }\n"
    h = h + ".btn-primary:hover { background-color: #0369a1; }\n"
    h = h + ".btn-secondary { background-color: #1e293b; border: 1px solid #334155; color: #cbd5e1; border-radius: 6px; padding: 6px 12px; font-size: 12px; font-weight: 600; }\n"
    h = h + ".btn-secondary:hover { background-color: #334155; color: #ffffff; }\n"
    h = h + ".btn-tab { background-color: #0b0f19; border: 1px solid #1e293b; color: #94a3b8; border-radius: 6px; padding: 5px 12px; font-size: 11px; font-weight: 600; }\n"
    h = h + ".btn-tab-active { background-color: #1e293b; border: 1px solid #38bdf8; color: #38bdf8; border-radius: 6px; padding: 5px 12px; font-size: 11px; font-weight: bold; }\n"
    h = h + ".code-block { background-color: #030712; border: 1px solid #1e293b; border-radius: 6px; padding: 10px; font-family: monospace; font-size: 11px; color: #94a3b8; }\n"
    h = h + ".progress-track { background-color: #1e293b; border-radius: 9999px; height: 6px; width: 100%; }\n"
    h = h + ".progress-bar-emerald { background-color: #10b981; border-radius: 9999px; height: 6px; }\n"
    h = h + ".progress-bar-sky { background-color: #0284c7; border-radius: 9999px; height: 6px; }\n"
    h = h + ".progress-bar-purple { background-color: #8b5cf6; border-radius: 9999px; height: 6px; }\n"
    h = h + "@media (max-width: 768px) {\n"
    h = h + "  .mobile-compact { padding: 8px; gap: 8px; }\n"
    h = h + "}\n"
    h = h + "</style>\n"

    h = h + "<div class='flex flex-col h-screen bg-slate-950 text-slate-100'>\n"

    // =========================================================================
    // 1. TOP GLOBAL NAVIGATION BAR (Responsive flex layout)
    // =========================================================================
    h = h + "<header class='h-14 bg-slate-900 border-b border-slate-800 flex justify-between items-center px-4 md:px-6'>\n"

    // Left: Brand identity & environment badges
    h = h + "<div class='flex items-center gap-3'>\n"
    h = h + "<div class='p-1.5 bg-sky-950 border border-sky-800 rounded-lg text-sky-400 font-bold text-xs'>NV</div>\n"
    h = h + "<span class='brand-gradient text-base font-bold'>Nova AI Cloud</span>\n"
    h = h + "<span class='badge-purple hidden sm:inline-block'>v2.4 Enterprise</span>\n"
    h = h + "<span class='text-xs text-slate-400 hidden md:inline-block'>| us-east-1 (GPU Pod A)</span>\n"
    h = h + "</div>\n"

    // Right: Live telemetry status & action triggers
    h = h + "<div class='flex items-center gap-2 md:gap-3'>\n"
    h = h + "<span class='badge-emerald hidden sm:inline-block'>● Online (99.99%)</span>\n"
    h = h + "<span class='badge-blue'>RAM: &lt; 12 MB</span>\n"
    h = h + "<span class='badge-purple hidden lg:inline-block'>Perceus 0-GC</span>\n"
    h = h + "<button class='btn-secondary' onclick='toggleMode()'>Mode: Live</button>\n"
    h = h + "</div>\n"
    h = h + "</header>\n"

    // =========================================================================
    // 2. MAIN WORKSPACE: 3 RESPONSIVE COLUMNS (Sidebar + Center Console + Inspector)
    // =========================================================================
    h = h + "<div class='flex flex-1 overflow-hidden'>\n"

    // -------------------------------------------------------------------------
    // COLUMN 1: RESPONSIVE SIDEBAR (Hidden on mobile < 1024px, 240px on desktop)
    // -------------------------------------------------------------------------
    h = h + "<aside class='w-60 bg-slate-900 border-r border-slate-800 p-3 hidden lg:flex flex-col gap-2 overflow-y-auto'>\n"
    h = h + "<div class='text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1'>Orchestration</div>\n"
    h = h + "<div class='card-active p-2.5 flex justify-between items-center cursor-pointer'>\n"
    h = h + "<div class='text-xs font-bold text-sky-400'>Dashboard Hub</div>\n"
    h = h + "<span class='badge-emerald'>Active</span>\n"
    h = h + "</div>\n"
    h = h + "<div class='card-dark card-hover p-2.5 flex justify-between items-center cursor-pointer'>\n"
    h = h + "<div class='text-xs font-medium text-slate-300'>GPU Clusters (128)</div>\n"
    h = h + "<span class='text-[10px] text-slate-500'>H100 SXM5</span>\n"
    h = h + "</div>\n"
    h = h + "<div class='card-dark card-hover p-2.5 flex justify-between items-center cursor-pointer'>\n"
    h = h + "<div class='text-xs font-medium text-slate-300'>Agent Swarms (7)</div>\n"
    h = h + "<span class='text-[10px] text-slate-500'>Autonomous</span>\n"
    h = h + "</div>\n"
    h = h + "<div class='card-dark card-hover p-2.5 flex justify-between items-center cursor-pointer'>\n"
    h = h + "<div class='text-xs font-medium text-slate-300'>Security & Shield</div>\n"
    h = h + "<span class='badge-purple'>Enforced</span>\n"
    h = h + "</div>\n"
    h = h + "<div class='card-dark card-hover p-2.5 flex justify-between items-center cursor-pointer'>\n"
    h = h + "<div class='text-xs font-medium text-slate-300'>Vector Search (FAISS)</div>\n"
    h = h + "<span class='text-[10px] text-slate-500'>10M Keys</span>\n"
    h = h + "</div>\n"
    h = h + "<div class='card-dark card-hover p-2.5 flex justify-between items-center cursor-pointer'>\n"
    h = h + "<div class='text-xs font-medium text-slate-300'>LLM Inference Host</div>\n"
    h = h + "<span class='text-[10px] text-slate-500'>AVX2 Q4/Q8</span>\n"
    h = h + "</div>\n"

    // Sidebar footer: User plan & footprint
    h = h + "<div class='mt-auto p-2.5 bg-slate-950 rounded-lg border border-slate-800 flex flex-col gap-1'>\n"
    h = h + "<div class='flex justify-between items-center text-xs'>\n"
    h = h + "<span class='font-bold text-sky-400'>Photon-D2D Core</span>\n"
    h = h + "<span class='text-[10px] text-emerald-400'>0.00% CPU</span>\n"
    h = h + "</div>\n"
    h = h + "<div class='text-[10px] text-slate-400'>Zero-CEF • Pure Native Binary</div>\n"
    h = h + "</div>\n"
    h = h + "</aside>\n"

    // -------------------------------------------------------------------------
    // COLUMN 2: CENTER OPERATIONS CONSOLE (Flexible, responsive padding & grid)
    // -------------------------------------------------------------------------
    h = h + "<main class='flex-1 flex flex-col bg-slate-950 p-4 md:p-6 gap-4 overflow-y-auto'>\n"

    // Header banner & quick actions
    h = h + "<div class='card-dark p-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-3'>\n"
    h = h + "<div>\n"
    h = h + "<div class='text-lg font-bold text-slate-100'>Global AI Infrastructure Dashboard</div>\n"
    h = h + "<div class='text-xs text-slate-400'>Direct2D Hardware-Accelerated Native Interface • Zero Webview Junk • Responsive Flex/Grid Reflow</div>\n"
    h = h + "</div>\n"
    h = h + "<div class='flex gap-2 flex-wrap'>\n"
    h = h + "<button id='btn-spike' class='btn-primary' onclick='simulateLoad()'>+ Simulate Traffic Spike</button>\n"
    h = h + "<button id='btn-shield' class='btn-secondary' onclick='toggleSecurity()'>Shield: Armed</button>\n"
    h = h + "</div>\n"
    h = h + "</div>\n"

    // -------------------------------------------------------------------------
    // RESPONSIVE KPI METRICS GRID:
    // 1 Column on Mobile (<640px) -> 2 Columns on Tablet (640-1023px) -> 4 Columns on Desktop (>=1024px)
    // -------------------------------------------------------------------------
    h = h + "<div class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3'>\n"

    // KPI 1: GPU Cluster Compute
    h = h + "<div class='card-dark p-3.5 flex flex-col gap-2'>\n"
    h = h + "<div class='flex justify-between items-center text-xs text-slate-400'>\n"
    h = h + "<span>GPU COMPUTE</span>\n"
    h = h + "<span class='badge-emerald'>+14.2%</span>\n"
    h = h + "</div>\n"
    h = h + "<div id='metric-gpu' class='text-xl font-bold text-sky-400'>128 H100 SXM5</div>\n"
    h = h + "<div class='text-[11px] text-slate-400'>98.2% Cluster Saturation</div>\n"
    h = h + "<div class='progress-track'><div class='progress-bar-sky' style='width: 98%;'></div></div>\n"
    h = h + "</div>\n"

    // KPI 2: Swarm Throughput
    h = h + "<div class='card-dark p-3.5 flex flex-col gap-2'>\n"
    h = h + "<div class='flex justify-between items-center text-xs text-slate-400'>\n"
    h = h + "<span>SWARM THROUGHPUT</span>\n"
    h = h + "<span class='badge-blue'>P99: 1.1ms</span>\n"
    h = h + "</div>\n"
    h = h + "<div id='metric-req' class='text-xl font-bold text-emerald-400'>1,420,850 ops/s</div>\n"
    h = h + "<div class='text-[11px] text-slate-400'>Zero-copy Wire v3.0 Protocol</div>\n"
    h = h + "<div class='progress-track'><div class='progress-bar-emerald' style='width: 88%;'></div></div>\n"
    h = h + "</div>\n"

    // KPI 3: Memory Footprint (Perceus 0-GC)
    h = h + "<div class='card-dark p-3.5 flex flex-col gap-2'>\n"
    h = h + "<div class='flex justify-between items-center text-xs text-slate-400'>\n"
    h = h + "<span>PROCESS FOOTPRINT</span>\n"
    h = h + "<span class='badge-purple'>0-GC Native</span>\n"
    h = h + "</div>\n"
    h = h + "<div class='text-xl font-bold text-purple-400'>11.6 MB RAM</div>\n"
    h = h + "<div class='text-[11px] text-slate-400'>0.00% CPU Idle (MsgWait)</div>\n"
    h = h + "<div class='progress-track'><div class='progress-bar-purple' style='width: 12%;'></div></div>\n"
    h = h + "</div>\n"

    // KPI 4: Security Shield
    h = h + "<div class='card-dark p-3.5 flex flex-col gap-2'>\n"
    h = h + "<div class='flex justify-between items-center text-xs text-slate-400'>\n"
    h = h + "<span>THREAT SHIELD</span>\n"
    h = h + "<span class='badge-amber'>0 CVEs</span>\n"
    h = h + "</div>\n"
    h = h + "<div id='metric-threats' class='text-xl font-bold text-amber-400'>48 Blocked</div>\n"
    h = h + "<div class='text-[11px] text-slate-400'>Taint & Unsafe Sandboxed</div>\n"
    h = h + "<div class='progress-track'><div class='progress-bar-emerald' style='width: 100%;'></div></div>\n"
    h = h + "</div>\n"

    h = h + "</div>\n"

    // -------------------------------------------------------------------------
    // TABBED CONTROLLER (Overview | Agent Swarm | GPU Heatmap | Threat Neutralizer)
    // -------------------------------------------------------------------------
    h = h + "<div class='flex gap-2 border-b border-slate-800 pb-2 flex-wrap'>\n"
    h = h + "<button id='tab-btn-1' class='btn-tab-active' onclick='selectTab1()'>Cluster Overview</button>\n"
    h = h + "<button id='tab-btn-2' class='btn-tab' onclick='selectTab2()'>Autonomous Swarm (7)</button>\n"
    h = h + "<button id='tab-btn-3' class='btn-tab' onclick='selectTab3()'>GPU Pod Telemetry</button>\n"
    h = h + "<button id='tab-btn-4' class='btn-tab' onclick='selectTab4()'>Direct2D Subsystem 2 Proof</button>\n"
    h = h + "</div>\n"

    // Active Tab Content Display Card
    h = h + "<div id='tab-content' class='card-dark p-4 flex flex-col gap-2.5'>\n"
    h = h + "<div class='flex justify-between items-center'>\n"
    h = h + "<span id='tab-title' class='text-sm font-bold text-sky-400'>Telemetry Pod A: us-east-1 Core Node</span>\n"
    h = h + "<span class='badge-emerald'>Refreshed: Live</span>\n"
    h = h + "</div>\n"
    h = h + "<div id='tab-desc' class='text-xs text-slate-300'>Toan bo giao dien duoc render truc tiep qua GPU DirectX Direct2D Hardware Acceleration: 0 CMD console, 0 Chromium, 0 WebView, 0 Localhost socket!</div>\n"
    h = h + "<div class='code-block' id='tab-code'>\n"
    h = h + "[TELEMETRY 16:35:01] 128x NVIDIA H100 SXM5 Online. AVX2 tensor kernels armed.\n"
    h = h + "[SECURITY  16:35:02] Security Shield Active: 0 CVEs, Cap-gated I/O E0501, Safe Perceus 0-GC.\n"
    h = h + "[RESPONSIVE 16:35:03] CSS DIPs live reflow: grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 active.\n"
    h = h + "</div>\n"
    h = h + "</div>\n"

    // -------------------------------------------------------------------------
    // LIVE COMMAND DISPATCH BAR (Interactive Prompt & State Update)
    // -------------------------------------------------------------------------
    h = h + "<div class='card-dark p-3 flex flex-col gap-2 mt-auto'>\n"
    h = h + "<div class='text-xs font-bold text-slate-400 uppercase tracking-wider'>Interactive Dispatch Console</div>\n"
    h = h + "<div class='flex gap-2 flex-col sm:flex-row'>\n"
    h = h + "<input id='cmd-inp' class='flex-1 p-2.5 rounded-lg bg-slate-900 border border-slate-700 text-xs text-slate-100' value='axc build examples/responsive_dashboard.ax --gui -o app.exe'/>\n"
    h = h + "<button class='btn-primary' onclick='dispatchCmd()'>Execute Command</button>\n"
    h = h + "</div>\n"
    h = h + "<div id='cmd-status' class='text-[11px] text-emerald-400 font-mono'>San sang tiep nhan lenh dieu khien. Nhan 'Execute Command' hoac '+ Simulate Traffic Spike' de test JS reactivity!</div>\n"
    h = h + "</div>\n"

    h = h + "</main>\n"

    // -------------------------------------------------------------------------
    // COLUMN 3: RIGHT HARDWARE INSPECTOR (Hidden on screens < 1280px)
    // -------------------------------------------------------------------------
    h = h + "<aside class='w-72 bg-slate-900 border-l border-slate-800 p-4 hidden xl:flex flex-col gap-3 overflow-y-auto'>\n"
    h = h + "<div class='text-xs font-bold text-slate-400 uppercase tracking-wider'>Engine Diagnostics</div>\n"

    // Diagnostic Card 1: Engine Specifications
    h = h + "<div class='card-dark p-3 flex flex-col gap-1.5 text-xs'>\n"
    h = h + "<div class='font-bold text-sky-400'>Photon-D2D Architecture</div>\n"
    h = h + "<div class='p-2 bg-slate-950 rounded text-[10px] font-mono text-slate-300 flex flex-col gap-1'>\n"
    h = h + "<div class='flex justify-between'><span>Binary Size:</span><span class='text-emerald-400'>530 KB Standalone</span></div>\n"
    h = h + "<div class='flex justify-between'><span>PE Subsystem:</span><span class='text-emerald-400'>2 (GUI - 0 CMD)</span></div>\n"
    h = h + "<div class='flex justify-between'><span>Memory Trim:</span><span class='text-sky-400'>SetProcessWorkingSet</span></div>\n"
    h = h + "<div class='flex justify-between'><span>DirectWrite:</span><span class='text-emerald-400'>ClearType Subpixel</span></div>\n"
    h = h + "<div class='flex justify-between'><span>Responsive Reflow:</span><span class='text-purple-400'>Live CSS DIPs</span></div>\n"
    h = h + "</div>\n"
    h = h + "</div>\n"

    // Diagnostic Card 2: Swarm Status Breakdown
    h = h + "<div class='text-xs font-bold text-slate-400 uppercase tracking-wider mt-1'>Swarm Health (7)</div>\n"
    h = h + "<div class='flex flex-col gap-1.5 text-xs font-mono'>\n"
    h = h + "<div class='p-2 bg-slate-950 rounded border border-slate-800 flex justify-between'><span>GPU Scheduler</span><span class='text-emerald-400'>● 100%</span></div>\n"
    h = h + "<div class='p-2 bg-slate-950 rounded border border-slate-800 flex justify-between'><span>Wire v3.0 Parser</span><span class='text-emerald-400'>● 100%</span></div>\n"
    h = h + "<div class='p-2 bg-slate-950 rounded border border-slate-800 flex justify-between'><span>Perceus GC Trimmer</span><span class='text-emerald-400'>● 100%</span></div>\n"
    h = h + "<div class='p-2 bg-slate-950 rounded border border-slate-800 flex justify-between'><span>Win32 D2D Surface</span><span class='text-emerald-400'>● 100%</span></div>\n"
    h = h + "</div>\n"

    // Diagnostic Card 3: Quick Action Buttons
    h = h + "<div class='mt-auto flex flex-col gap-2'>\n"
    h = h + "<button class='btn-secondary' onclick='trimMemory()'>Trim Working Set (RAM)</button>\n"
    h = h + "<button class='btn-secondary' onclick='addThreatBlock()'>Neutralize Injected Packet</button>\n"
    h = h + "</div>\n"

    h = h + "</aside>\n"

    h = h + "</div>\n" // End Main Workspace

    // =========================================================================
    // 3. IN-PROCESS JAVASCRIPT REACTIVE EVENT HANDLERS (Zero-CEF DOM Engine)
    // =========================================================================
    h = h + "<script>\n"
    h = h + "let trafficSpike = 0;\n"
    h = h + "let threatCount = 48;\n"
    h = h + "let shieldArmed = 1;\n"
    h = h + "\n"
    h = h + "function selectTab1() {\n"
    h = h + "  document.getElementById('tab-title').innerText = 'Telemetry Pod A: us-east-1 Core Node';\n"
    h = h + "  document.getElementById('tab-desc').innerText = 'Toan bo giao dien duoc render truc tiep qua GPU DirectX Direct2D Hardware Acceleration: 0 CMD console, 0 Chromium, 0 WebView, 0 Localhost socket!';\n"
    h = h + "  document.getElementById('tab-code').innerText = '[POD-A] 128x H100 SXM5 Online. Memory: < 12 MB RAM. CSS DIPs reflow active.';\n"
    h = h + "}\n"
    h = h + "function selectTab2() {\n"
    h = h + "  document.getElementById('tab-title').innerText = 'Autonomous Agent Swarm (7 Micro-Agents)';\n"
    h = h + "  document.getElementById('tab-desc').innerText = '7 Agent chay song song bang Axon Threads thuan, trao doi du lieu qua Shared Memory va Direct Memory Buffers (0 network overhead).';\n"
    h = h + "  document.getElementById('tab-code').innerText = '[SWARM] Agent #1..#7 in State WORKING. IPC latency: 0.00ms. Zero allocations.';\n"
    h = h + "}\n"
    h = h + "function selectTab3() {\n"
    h = h + "  document.getElementById('tab-title').innerText = 'NVIDIA H100 GPU Cluster Telemetry';\n"
    h = h + "  document.getElementById('tab-desc').innerText = 'PTX JIT Assembly truc tiep khong can nvcc (std/cuda.ax), load kernel Q4/Q8 AVX2 cho LLM 70B.';\n"
    h = h + "  document.getElementById('tab-code').innerText = '[GPU-HEATMAP] 8 Nodes x 16 GPUs = 128 GPUs. Power: 700W/GPU. Temperature: 62C.';\n"
    h = h + "}\n"
    h = h + "function selectTab4() {\n"
    h = h + "  document.getElementById('tab-title').innerText = 'Subsystem 2 GUI Proof & Zero-Junk Verification';\n"
    h = h + "  document.getElementById('tab-desc').innerText = 'PE Header: IMAGE_SUBSYSTEM_WINDOWS_GUI (Subsystem 2). Hoan toan khong khoi tao cmd.exe!';\n"
    h = h + "  document.getElementById('tab-code').innerText = '[PE-HEADER] AddressOfEntryPoint: 0x1000, Subsystem: 2 (GUI), Checksum: OK. Zero junk files.';\n"
    h = h + "}\n"
    h = h + "function simulateLoad() {\n"
    h = h + "  trafficSpike = trafficSpike + 250000;\n"
    h = h + "  document.getElementById('metric-req').innerText = '1,670,850 ops/s';\n"
    h = h + "  document.getElementById('metric-gpu').innerText = '128 H100 (99.9%)';\n"
    h = h + "  document.getElementById('cmd-status').innerText = '[TRAFFIC SPIKE] Da mo phong tang tai thanh cong! Swarm dap ung trong 0.1ms.';\n"
    h = h + "}\n"
    h = h + "function toggleSecurity() {\n"
    h = h + "  if (shieldArmed == 1) {\n"
    h = h + "    shieldArmed = 0;\n"
    h = h + "    document.getElementById('btn-shield').innerText = 'Shield: Bypassed';\n"
    h = h + "    document.getElementById('cmd-status').innerText = '[WARN] Security shield da chuyen sang che do pass-through.';\n"
    h = h + "  } else {\n"
    h = h + "    shieldArmed = 1;\n"
    h = h + "    document.getElementById('btn-shield').innerText = 'Shield: Armed';\n"
    h = h + "    document.getElementById('cmd-status').innerText = '[SEC] Security shield da duoc kich hoat 100% E0501/E0502.';\n"
    h = h + "  }\n"
    h = h + "}\n"
    h = h + "function dispatchCmd() {\n"
    h = h + "  let cmd = document.getElementById('cmd-inp').innerText;\n"
    h = h + "  document.getElementById('cmd-status').innerText = 'Thuc thi thanh cong lenh native: [' + cmd + '] - 0ms IPC!';\n"
    h = h + "}\n"
    h = h + "function trimMemory() {\n"
    h = h + "  document.getElementById('cmd-status').innerText = '[MEM TRIM] SetProcessWorkingSetSize da giai phong bo nho: RAM hien tai < 10.8 MB!';\n"
    h = h + "}\n"
    h = h + "function addThreatBlock() {\n"
    h = h + "  threatCount = threatCount + 1;\n"
    h = h + "  document.getElementById('metric-threats').innerText = '49 Blocked';\n"
    h = h + "  document.getElementById('cmd-status').innerText = '[SHIELD] Da trung hoa 1 goi tin doc hai (Taint E0502 Sandboxed)!';\n"
    h = h + "}\n"
    h = h + "function toggleMode() {\n"
    h = h + "  document.getElementById('cmd-status').innerText = '[MODE] Chuyen doi giua Live Mode va Diagnostic Mode thanh cong!';\n"
    h = h + "}\n"
    h = h + "</script>\n"

    h = h + "</div>\n"
    return h
}

fn main() -> i32 {
    html := build_responsive_dashboard_html()
    mut app := ui_window_html("Nova AI Cloud — Global Infrastructure Operations Center", 1280, 800, html)
    _ := gui_run_ui_app(mut app)
    return 0
}
