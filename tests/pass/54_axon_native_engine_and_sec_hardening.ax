use std::webview

@test
fn test_webview_real_ico_favicon_and_no_globe_injection() {
    // 1. Verify synthesized 32x32 32-bit BGRA `.ico` binary structure (replaces globe icon!)
    ico := webview_build_favicon_ico(0xD97757)
    assert(buf_len(ico) == 4286)
    // ICONDIR: 00 00 01 00 01 00
    assert(buf_get(ico, 0) == 0 and buf_get(ico, 1) == 0)
    assert(buf_get(ico, 2) == 1 and buf_get(ico, 3) == 0)
    assert(buf_get(ico, 4) == 1 and buf_get(ico, 5) == 0)
    // ICONDIRENTRY: 32x32, 32bpp
    assert(buf_get(ico, 6) == 32 and buf_get(ico, 7) == 32)
    assert(buf_get(ico, 12) == 32)
    buf_free(move ico)

    // 2. Verify automatic SVG + ICO favicon + dark color-scheme injection into HTML `<head>`
    raw := "<html><head><title>Axon Claude</title></head><body>Hi</body></html>"
    inj := _webview_inject_axon_head(raw, 0xD97757, true)
    assert(str_contains(inj, "rel=\"icon\" type=\"image/svg+xml\""))
    assert(str_contains(inj, "href=\"/favicon.ico\""))
    assert(str_contains(inj, "name=\"color-scheme\" content=\"dark\""))
    assert(str_contains(inj, "d97757"))

    // 3. Respect custom user favicon (do not double-inject)
    custom := "<html><head><link rel=\"icon\" href=\"/my.png\"></head><body>Hi</body></html>"
    inj2 := _webview_inject_axon_head(custom, 0xD97757, true)
    assert(str_eq(inj2, custom))
}

@test
fn test_webview_csprng_token_security_headers_and_zero_chromium_photon() {
    // 1. Verify CSPRNG 128-bit auth token generation & constant-time comparison
    t1 := _webview_gen_csprng_token()
    t2 := _webview_gen_csprng_token()
    assert(str_len(t1) == 32 and str_len(t2) == 32)
    assert(not str_eq(t1, t2))
    assert(_webview_ct_eq(t1, t1))
    assert(not _webview_ct_eq(t1, t2))
    assert(not _webview_ct_eq("", ""))

    // 2. Verify WebviewApp embeds security headers, CSP, ETag, and CSPRNG token
    mut cfg := webview_default_config("AxonSecApp", 18977, 1024, 700, "<html><head></head><body>Safe</body></html>")
    cfg.require_auth_token = true
    wv := webview_create_with_config(cfg) or return
    assert(str_len(wv.auth_token) == 32)
    assert(wv.require_auth_token)
    assert(str_contains(wv.cached_index_resp, "X-Content-Type-Options: nosniff"))
    assert(str_contains(wv.cached_index_resp, "X-Frame-Options: DENY"))
    assert(str_contains(wv.cached_index_resp, "Content-Security-Policy:"))
    assert(str_contains(wv.cached_index_resp, "href=\"/favicon.ico\""))
    webview_close(wv)

    // 3. Verify 1-line zero-Chromium proprietary Photon-D2D runner renders cleanly headless!
    html := "<div class='flex flex-col h-screen bg-[#1B1B1B] p-4'><svg data-icon='gear' class='size-5 text-white'></svg><div class='rounded-2xl overflow-hidden bg-[#D97757] pt-6 pb-2 pl-8 pr-2 text-white'>Zero Chromium</div></div>"
    f := webview_run_photon("ZeroChromiumTest", 800, 600, html, 2, false)
    assert(f == 2)
}

@test
fn test_photon_asymmetric_box_word_wrap_svg_and_enter_submit() {
    // 1. Asymmetric padding & margin verification
    mut st := style_default()
    tw_apply_classes(mut st, "pt-6 pb-1 pl-8 pr-2 mt-5 mb-0 ml-4 mr-1")
    assert(style_pad_top(st) == 24 and style_pad_bottom(st) == 4)
    assert(style_pad_left(st) == 32 and style_pad_right(st) == 8)
    assert(st.padding_y == 28 and st.padding_x == 40)
    assert(style_mar_top(st) == 20 and style_mar_bottom(st) == 0)
    assert(style_mar_left(st) == 16 and style_mar_right(st) == 4)

    // 2. Word-boundary wrapping counts multi-line paragraphs accurately
    lines := layout_count_text_lines("Connect OpenAI Anthropic Gemini Ollama or custom endpoints", 14, 160, false)
    assert(lines >= 3)

    // 3. `<svg data-icon>` extraction + `<input onsubmit>` Enter submit + JS `+=` append!
    html := "<div><svg id='ic' data-icon='moon' class='size-4'></svg>" +
            "<input id='inp' value='Hello' onsubmit=\"document.getElementById('out').innerText += ' World'\" />" +
            "<div id='out'>Start</div></div>"
    mut app := ui_window_html("EnterTest", 600, 400, html)
    assert(str_eq(ui_get_text(app, "ic"), "moon"))
    i_inp := dom_find_by_id(app.tree, "inp")
    app.focused_idx = i_inp
    ok_ent := ui_handle_char(mut app, 13) // Enter key!
    assert(ok_ent)
    assert(str_eq(ui_get_text(app, "out"), "Start World"))
    ui_app_free(move app)
}

@test
fn test_security_patches_all_cwe_classes() {
    // 1. CWE-674: Cyclic CSS custom properties (`--a -> --b -> --a`) must NEVER stack-overflow!
    cyc_css := ":root { --a: var(--b); --b: var(--a); } .x { color: var(--a); }"
    t0 := clock_ns()
    tree := html_parse("<div id='x' class='x'>Safe</div>") or dom_tree_new("")
    sheet := css_parse_stylesheet(cyc_css)
    _ := css_compute_node_style(tree, 0, sheet)
    assert((clock_ns() - t0) < 100000000) // < 100ms
    css_stylesheet_free(move sheet)
    dom_tree_free(move tree)

    // 2. CWE-400: Recursive JS function call shares global anti-DoS fuel (no exponential hang!)
    t1 := clock_ns()
    mut jtree := html_parse("<div id='o'>ok</div>") or dom_tree_new("")
    mut jst := js_state_new()
    _ := js_eval_script(mut jtree, mut jst, "function spin() { let i = 0; while (i < 500) { i++; } spin(); } spin();")
    assert((clock_ns() - t1) < 500000000) // Bounded by shared fuel!
    js_state_free(move jst)
    dom_tree_free(move jtree)

    // 3. CWE-79: Block dangerous `.style.*` injection payloads
    assert(not _js_is_safe_css_val("javascript:alert(1)"))
    assert(not _js_is_safe_css_val("expression(alert(1))"))
    assert(not _js_is_safe_css_val("url(http://evil.com/x)"))
    assert(_js_is_safe_css_val("#D97757"))

    // 4. CWE-78: WebView rejects shell metacharacters in profile_dir & custom_bin
    bad_r1 := webview_launch_window_ex("http://127.0.0.1:18888/", 800, 600, "C:\\Temp\\axon;calc.exe")
    assert(not bad_r1.success)
    bad_r2 := webview_launch_window_ex("http://127.0.0.1:18888/", 800, 600, "C:\\Temp\\axon_ok", false, false, 64, 8, false, "C:\\bad\"bin.exe")
    assert(not bad_r2.success)

    // 5. CWE-22 / UNC / Windows reserved device names blocked in WebView & Photon-D2D `<img src>`
    assert(not _webview_is_safe_file_path("\\\\evil\\share\\p.txt"))
    assert(not _webview_is_safe_file_path("//evil/share/p.txt"))
    assert(not _webview_is_safe_file_path("../secret.txt"))
    assert(not _webview_is_safe_file_path("assets/CON.txt"))
    assert(not _webview_is_safe_file_path("assets/LPT1.png"))
    assert(_webview_is_safe_file_path("assets/logo.png"))

    assert(_p2d_is_reserved_img_path("../secret.png"))
    assert(_p2d_is_reserved_img_path("dir/NUL.png"))
    assert(_p2d_is_reserved_img_path("COM3.jpg"))
    assert(not _p2d_is_reserved_img_path("assets/avatar.png"))

    // 6. CWE-444: HTTP method allowlist & NUL byte detection
    assert(_webview_is_allowed_method("GET") and _webview_is_allowed_method("POST"))
    assert(not _webview_is_allowed_method("TRACE") and not _webview_is_allowed_method("CONNECT"))
}
