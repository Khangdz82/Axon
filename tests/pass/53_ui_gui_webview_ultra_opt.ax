@test
fn test_html_o1_sibling_parse_and_deep_nesting() {
    // Build 250 sibling items + 80-deep nested tree to verify O(1) append & >64 depth support
    out := buf_new(16384)
    buf_push_str(out, "<div id='root'>")
    mut i := 0
    while i < 250 {
        buf_push_str(out, f"<div id='item-{i}' class='p-2 bg-slate-900'>Row {i}</div>")
        i += 1
    }
    mut d := 0
    while d < 75 {
        buf_push_str(out, "<div>")
        d += 1
    }
    buf_push_str(out, "<span id='deep-leaf'>FoundDeep</span>")
    d = 0
    while d < 75 {
        buf_push_str(out, "</div>")
        d += 1
    }
    buf_push_str(out, "</div>")
    raw := buf_to_owned_str(move out)

    t0 := clock_ns()
    tree := html_parse(raw) or dom_tree_new("")
    elapsed_us := (clock_ns() - t0) / 1000

    assert(tree.count > 320)
    idx_last := dom_find_by_id(tree, "item-249")
    assert(idx_last > 0)
    assert(str_eq(dom_get_text(tree, idx_last), "Row 249"))

    idx_deep := dom_find_by_id(tree, "deep-leaf")
    assert(idx_deep > 0)
    assert(str_eq(dom_get_text(tree, idx_deep), "FoundDeep"))
    assert(elapsed_us < 500000) // Must finish far under 500ms (typically <2ms)
    dom_tree_free(move tree)
}

@test
fn test_css3_colors_gradients_calc_vars_and_at_rules() {
    // 1. HSL/HSLA, space-separated RGB Color 4, #RGBA, !important
    assert(css_parse_color("hsl(0, 100%, 50%)") == 0xFFFF0000)
    assert(css_parse_color("hsl(120, 100%, 50%)") == 0xFF00FF00)
    assert(css_parse_color("hsl(240, 100%, 50%)") == 0xFF0000FF)
    c_sp := css_parse_color("rgb(59 130 246 / 50%)")
    assert((c_sp & 0x00FFFFFF) == 0x3B82F6)
    assert(((c_sp >> 24) & 0xFF) >= 126 and ((c_sp >> 24) & 0xFF) <= 128)
    c_hex4 := css_parse_color("#f0a8")
    assert(c_hex4 == 0x88FF00AA)

    // 2. CSS calc() arithmetic
    assert(css_parse_px("calc(100px + 24px)") == 124)
    assert(css_parse_px("calc(200px - 40px)") == 160)

    // 3. @keyframes must NOT corrupt subsequent rules + nested var() + rgba() inside linear-gradient + comma :hover
    css_src := ":root { --primary: #6366f1; --grad-a: rgba(99, 102, 241, 0.9); }\n" +
               "@keyframes spin { from { opacity: 0; } to { opacity: 1; } }\n" +
               ".hero { background: linear-gradient(135deg, var(--grad-a) 0%, #8b5cf6 50%, #ec4899 100%) !important; backdrop-filter: blur(16px); text-overflow: ellipsis; }\n" +
               ".a:hover, .b:hover { color: var(--missing, var(--primary, #ffffff)); }\n" +
               ".orb { background: radial-gradient(circle, #38bdf8, #0f172a); }\n"

    html_src := "<div><div id='h' class='hero'>Hi</div><div id='a1' class='a'>A</div><div id='b1' class='b'>B</div><div id='o1' class='orb'>O</div></div>"
    tree := html_parse(html_src) or dom_tree_new("")
    sheet := css_parse_stylesheet(css_src)

    sh := css_compute_node_style(tree, dom_find_by_id(tree, "h"), sheet)
    assert(sh.grad_dir == 3)
    assert((sh.grad_from & 0x00FFFFFF) == 0x6366F1)
    assert(sh.grad_via == 0xFF8B5CF6)
    assert(sh.grad_to == 0xFFEC4899)
    assert(sh.glass_blur == 3)
    assert(sh.text_ellipsis)

    // Comma-separated :hover works on BOTH `.a` and `.b` + sets `has_hover`!
    ia := dom_find_by_id(tree, "a1")
    sa_idle := css_compute_node_style_full(tree, ia, sheet, false, false, false)
    assert(sa_idle.has_hover)
    sa_hov := css_compute_node_style_full(tree, ia, sheet, true, false, false)
    assert(sa_hov.text_color == 0xFF6366F1)

    so := css_compute_node_style(tree, dom_find_by_id(tree, "o1"), sheet)
    assert(so.grad_dir == 9)
    assert(so.grad_from == 0xFF38BDF8)
    assert(so.grad_to == 0xFF0F172A)

    css_stylesheet_free(move sheet)
    dom_tree_free(move tree)
}

@test
fn test_tailwind_v4_full_palette_glass_gradients_and_arbitrary() {
    mut st := style_default()
    // Full 22-family palette including newly added stone, lime, fuchsia + true green & neutral
    tw_apply_classes(mut st, "bg-fuchsia-500 text-lime-400 border-stone-700")
    assert(st.bg_color == 0xFFD946EF)
    assert(st.text_color == 0xFFA3E635)
    assert(st.border_color == 0xFF44403C)

    mut st2 := style_default()
    tw_apply_classes(mut st2, "bg-[#111827]/80 text-green-500/[0.5] backdrop-blur-xl shadow-indigo-500/30 ring-2 ring-offset-2 ring-cyan-400 truncate bg-clip-text bg-linear-to-tr from-sky-400 via-indigo-500 to-fuchsia-500")
    assert((st2.bg_color & 0x00FFFFFF) == 0x111827)
    assert(((st2.bg_color >> 24) & 0xFF) == 204) // 80% of 255
    assert((st2.text_color & 0x00FFFFFF) == 0x22C55E) // True Tailwind green-500
    assert(((st2.text_color >> 24) & 0xFF) == 127)
    assert(st2.glass_blur == 4)
    assert((st2.shadow_color & 0x00FFFFFF) == 0x6366F1)
    assert(st2.ring_width == 2 and st2.ring_offset == 2 and st2.ring_color == 0xFF22D3EE)
    assert(st2.text_ellipsis and st2.white_space == 1 and st2.overflow_hidden)
    assert(st2.bg_clip_text and st2.grad_dir == 6)

    // Arbitrary w-[50%], z-[100], opacity-[0.85], border-[3px], gap-x/y, size-10, justify-evenly
    mut st3 := style_default()
    tw_apply_classes(mut st3, "w-[50%] z-[100] opacity-[0.85] border-[3px] gap-x-6 gap-y-3 justify-evenly")
    assert(st3.width == -1050)
    assert(st3.z_index == 100)
    assert(st3.opacity >= 84 and st3.opacity <= 86)
    assert(st3.border_width == 3)
    assert(st3.gap_x == 24 and st3.gap_y == 12)
    assert(st3.justify_content == 5)
}

@test
fn test_lazy_canvas_zero_leak_layout_and_js_pool_reuse() {
    html := "<div class='flex flex-col h-screen p-4 gap-y-4'>" +
            "  <div id='row' class='flex justify-evenly gap-x-4'><div id='c1' class='w-24 h-10 bg-indigo-500'>A</div><div id='c2' class='w-24 h-10 bg-emerald-500'>B</div></div>" +
            "  <div id='box' style='color: #fff'>Hello</div>" +
            "</div>"
    mut app := ui_window_html("LazyCanvasTest", 800, 600, html)
    // Lazy CPU Canvas: saves ~1.9 MB (800x600x4) until software render is requested!
    assert(app.canvas.width == 0 and app.canvas.height == 0)

    // Verify justify-evenly spacing
    ic1 := dom_find_by_id(app.tree, "c1")
    ic2 := dom_find_by_id(app.tree, "c2")
    assert(layout_get_x(app.layout, ic2) > layout_get_x(app.layout, ic1) + 96)

    // Verify JS str_pool in-place reuse (500 overwrites must NOT exhaust 32KB pool!)
    mut k := 0
    while k < 500 {
        js_state_set_str(app.state, "status", "Frame-OK-1234567890123456789012345678901234567890123456789012345678901234567890")
        k += 1
    }
    assert(str_starts_with(js_state_get_str(app.state, "status"), "Frame-OK-"))

    // Verify JS `.style.color` deduplication (no unbounded string growth!)
    mut m := 0
    while m < 20 {
        _ := js_eval_action(mut app.tree, app.state, "document.getElementById('box').style.color = '#38bdf8'")
        m += 1
    }
    ib := dom_find_by_id(app.tree, "box")
    assert(str_len(dom_get_style(app.tree, ib)) < 40)

    // Software render allocates canvas lazily and renders cleanly
    canv := ui_render(mut app)
    assert(canv.width == 800 and canv.height == 600)
    assert(ui_canvas_checksum(app) != 0)
    ui_app_free(move app)
}

@test
fn test_photon_d2d_glass_studio_headless_render_and_perf() {
    html := "<!DOCTYPE html><html><body class='flex flex-col h-screen bg-slate-950 p-4 gap-4'>" +
            "<header class='flex items-center justify-between p-4 rounded-2xl bg-slate-900/70 backdrop-blur-xl border border-white/10 shadow-xl shadow-indigo-500/25'>" +
            "  <h1 class='text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-sky-400 via-indigo-400 to-fuchsia-400'>Photon Ultra</h1>" +
            "  <button id='go' class='px-4 py-2 rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 text-white hover:bg-indigo-400' onclick=\"document.getElementById('val').innerText = 'OK'\">Run</button>" +
            "</header>" +
            "<div class='grid grid-cols-3 gap-4'>" +
            "  <div class='p-4 rounded-xl bg-slate-900/60 backdrop-blur-md border border-slate-700/50 ring-2 ring-cyan-400/50'><span id='val' class='truncate text-emerald-400'>Init</span></div>" +
            "  <div class='p-4 rounded-xl bg-linear-to-tr from-emerald-600 to-teal-500 text-white'>Card 2</div>" +
            "  <div class='p-4 rounded-xl bg-radial from-fuchsia-600 to-slate-900 text-white'>Card 3</div>" +
            "</div></body></html>"

    t0 := clock_ns()
    mut app := ui_window_html("PhotonUltraBench", 1024, 640, html)
    parse_layout_us := (clock_ns() - t0) / 1000
    assert(parse_layout_us < 200000)

    // Render 2 real headless Direct2D frames via Photon-D2D!
    frames := gui_run_ui_app(mut app, 2, false)
    assert(frames == 2)

    // Verify JS click event mutates DOM cleanly
    igo := dom_find_by_id(app.tree, "go")
    _ := ui_dispatch_click_node(mut app, igo)
    assert(str_eq(ui_get_text(app, "val"), "OK"))
    ui_app_free(move app)
}

@test
fn test_webview_ultra_lean_switches_etag_and_security() {
    args := webview_build_args("http://127.0.0.1:18888/", 1280, 800, "C:\\Temp\\axon_wv_opt", false, false, 64, 8, false, true, true)
    assert(str_contains(args, "--no-proxy-server"))
    assert(str_contains(args, "--num-raster-threads=1"))
    assert(str_contains(args, "--gpu-program-cache-size-kb=1024"))
    assert(str_contains(args, "msEdgeSidebarV2"))
    assert(str_contains(args, "--headless=new"))
    assert(str_contains(args, "--js-flags=\"--max-old-space-size=64\""))

    // Reserved Windows device names blocked in static path resolver
    assert(str_len(_webview_safe_resolve_static("public", "CON")) == 0)
    assert(str_len(_webview_safe_resolve_static("public", "nul.txt")) == 0)
    assert(str_len(_webview_safe_resolve_static("public", "sub/COM1.js")) == 0)
    assert(str_len(_webview_safe_resolve_static("public", "assets/app.css")) > 0)

    // Config propagation & pre-baked index ETag cache
    mut cfg := webview_default_config("UltraWV", 18944, 1024, 700, "<h1>Ultra</h1>")
    cfg.max_memory_mb = 48
    cfg.disk_cache_mb = 4
    cfg.headless = true
    wv := webview_create_with_config(cfg) or return
    assert(wv.max_memory_mb == 48)
    assert(wv.disk_cache_mb == 4)
    assert(wv.headless)
    assert(str_len(wv.index_etag) > 4)
    assert(str_contains(wv.cached_index_resp, "ETag: "))
    webview_close(wv)
}
