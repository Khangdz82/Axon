// Test 05: Object-Capability Security (`RootCap` -> `FsCap`), Sandbox Confinement & Path-Traversal Defense (`std/cap.ax`)
use std::cap

fn main() -> i32 {
    root := acquire_root_cap()
    ro_cap := attenuate_fs(root, base_dir = "tests", read_only = true)

    // 1. Path traversal `../` MUST be blocked with error 401 before touching OS!
    blocked := cap_read_file(ro_cap, "../README.md") or buf_new(64)
    if buf_len(blocked) != 0 {
        return 51
    }
    buf_free(move blocked)

    // 2. Sandbox escape check: `README.md` exists in workspace root, NOT inside `tests/`, so `ro_cap` MUST NOT read it!
    escaped := cap_read_file(ro_cap, "README.md") or buf_new(64)
    if buf_len(escaped) != 0 {
        return 55
    }
    buf_free(move escaped)

    // 3. Valid file inside `tests/` (`tests/pass/05_capability_security.ax`) MUST succeed!
    inside := cap_read_file(ro_cap, "pass/05_capability_security.ax") or buf_new(64)
    inside_len := buf_len(inside)
    buf_free(move inside)
    if inside_len < 100 {
        return 56
    }

    // 4. Drive escape `C:\...` MUST be blocked!
    if is_safe_subpath("C:\\Windows\\win.ini") {
        return 52
    }
    if not is_safe_subpath("pass/05_capability_security.ax") {
        return 53
    }

    // 5. Read-only `FsCap` MUST reject writes (`err(403)`)!
    payload := buf_new(64)
    buf_push_str(payload, "test")
    wrote := cap_write_file(ro_cap, "tmp_probe.txt", payload) or -403
    buf_free(move payload)
    if wrote != -403 {
        return 54
    }

    println(f"  [05] Object-Capability sandbox confinement & path-traversal defense verified (inside={inside_len}B, wrote={wrote})")
    return 0
}
