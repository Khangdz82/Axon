// Test 05: Object-Capability Security (`RootCap` -> `FsCap`) & Real Path-Traversal Blocking (`std/cap.ax`)
use std::cap

fn main() -> i32 {
    root := acquire_root_cap()
    ro_cap := attenuate_fs(root, base_dir = "tests", read_only = true)

    // 1. Path traversal `../` MUST be blocked with error 401 before touching OS!
    blocked := cap_read_file(ro_cap, "../secret.txt") or buf_new(64)
    if buf_len(blocked) != 0 {
        return 51
    }

    // 2. Drive escape `C:\...` MUST be blocked!
    if is_safe_subpath("C:\\Windows\\win.ini") {
        return 52
    }
    if not is_safe_subpath("pass/05_capability_security.ax") {
        return 53
    }

    // 3. Read-only `FsCap` MUST reject writes (`err(403)`)!
    payload := buf_new(64)
    buf_push_str(payload, "test")
    wrote := cap_write_file(ro_cap, "tmp_probe.txt", payload) or -403
    if wrote != -403 {
        return 54
    }

    println(f"  [05] Object-Capability & path-traversal defense verified (wrote={wrote})")
    return 0
}
