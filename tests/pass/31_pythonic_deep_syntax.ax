# Axon v1.0.0 - Deep Pythonic Ergonomics & Syntax Test Suite
# Tests:
# 1. `def` function declaration (with default args, named args, optional `:` and `int`/`float` types)
# 2. `elif` statement chains & optional colons after `if:`, `elif:`, `else:`
# 3. `pass` statements in empty functions and control flow
# 4. `#` comments alongside `//` comments
# 5. `True` and `False` capitalized booleans
# 6. `None` / `nil` unit literals and types
# 7. `**` power operator and `**=` augmented assignment
# 8. `%=` modulo augmented assignment
# 9. Python-style ternary `val if cond else alt`
# 10. Range membership `x in min..max` and `x not in min..max`
# 11. Built-in `len()` for strings and buffers
# 12. `for i in range(n)` and `for i in range(start, end)` loops

# --- 1. Functions using `def`, optional `:`, and `int`/`float` types ---
def calculate_power(base: int, exp: int = 2) -> int: {
    # Compute power using `**`
    return base ** exp
}

def float_calc(x: float, y: float = 1.5) -> float: {
    return x * y
}

def empty_placeholder(): {
    pass
}

def check_grade(score: int) -> str: {
    # 2. `elif` chain with optional colons
    if score >= 90: {
        return "A"
    } elif score >= 80: {
        return "B"
    } elif score >= 70: {
        return "C"
    } elif score >= 60: {
        return "D"
    } else: {
        return "F"
    }
}

@test
fn test_pythonic_syntax() {
    println("Step 1: power")
    p1 := calculate_power(2, 3)
    assert(p1 == 8)
    p2 := calculate_power(5)
    assert(p2 == 25)

    println("Step 2: assign")
    mut num := 3
    num **= 3
    assert(num == 27)
    num %= 10
    assert(num == 7)

    println("Step 3: elif")
    assert(check_grade(95) == "A")
    assert(check_grade(85) == "B")
    assert(check_grade(75) == "C")
    assert(check_grade(65) == "D")
    assert(check_grade(40) == "F")

    println("Step 4: booleans")
    t := True
    f := False
    assert(t == true)
    assert(f == false)
    assert(t and not f)

    println("Step 5: pass")
    empty_placeholder()

    println("Step 6: ternary")
    score := 88
    status := "Pass" if score >= 60 else "Fail"
    assert(status == "Pass")

    bonus := 50 if score > 90 else 10
    assert(bonus == 10)

    println("Step 7: range in")
    val := 5
    is_in_range := val in 0..10
    assert(is_in_range == True)

    out_of_range := 15 in 0..10
    assert(out_of_range == False)

    assert(val not in 10..20)
    assert(15 not in 0..10)

    println("Step 8: len")
    greeting := "Hello, Axon!"
    assert(len(greeting) == 12)

    buf := buf_new(16)
    buf_push(buf, 65)
    buf_push(buf, 66)
    buf_push(buf, 67)
    assert(len(buf) == 3)
    buf_free(move buf)

    println("Step 9: range loops")
    mut sum_range := 0
    for i in range(5): {
        sum_range += i
    }
    assert(sum_range == 10)

    mut sum_range2 := 0
    for j in range(2, 6): {
        sum_range2 += j
    }
    assert(sum_range2 == 14)

    println("[PASS] 31_pythonic_deep_syntax tests passed successfully!")
}

fn main() -> i32 {
    test_pythonic_syntax()
    println("Pythonic syntax ergonomics verified!")
    return 0
}
