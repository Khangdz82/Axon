// Regression suite for Desktop UI v2 (HTML5/CSS3/Tailwind/Flexbox/JS/Photon-D2D) & Stdlib Security Fixes
use std::ui
use std::html
use std::css
use std::ui_layout
use std::ui_js
use std::json
use std::path
use std::cap
use std::crypto
use std::uuid
use std::compress
use std::http
use std::ai_harness

fn assert_eq_i64(a: i64, b: i64, code: i32) -> i32 {
    if a != b {
        println(f"[FAIL {code}] expected {b}, got {a}")
        return code
    }
    return 0
}

fn assert_true(cond: bool, code: i32) -> i32 {
    if not cond {
        println(f"[FAIL {code}] condition false")
        return code
    }
    return 0
}

fn main() -> i32 {
    mut rc: i32 = 0

    // 1. HTML5: separate placeholder vs value, entities (&lt; &#x27;), exact attr matching, void tags
    html_src := "<style>" +
        ":root { --accent: #38bdf8; --bg: #0f172a; }" +
        ".shell > .header { border-bottom: 1px solid #334155; color: var(--accent); font-size: 15px; }" +
        ".code { white-space: pre; font-family: monospace; font-size: 12px; }" +
        "</style>" +
        "<div id='root' class='shell flex flex-col h-screen bg-slate-950 text-slate-100'>" +
        "  <header id='hdr' class='header h-12 px-4 flex justify-between items-center'>" +
        "    <span id='title'>Axon &lt;Desktop&gt; &#x27;v2&#x27;</span>" +
        "    <span id='badge' class='text-xs bg-sky-950 border border-sky-800 px-2'>Ready</span>" +
        "  </header>" +
        "  <div id='body' class='flex flex-1 overflow-hidden'>" +
        "    <aside id='nav' class='w-60 border-r border-slate-800 flex flex-col p-3'>" +
        "      <div id='nav-top' class='h-10'>Top Item</div>" +
        "      <div id='nav-foot' class='mt-auto h-10'>Pinned Footer</div>" +
        "    </aside>" +
        "    <main id='main' class='flex-1 flex flex-col p-4 gap-2 overflow-y-auto'>" +
        "      <div id='code' class='code'>line1\nline2\nline3\nline4</div>" +
        "      <input id='inp' class='w-full p-2 bg-slate-900 border border-slate-700 focus:border-sky-500' placeholder='Type command...'/>" +
        "      <button id='btn-run' class='cursor-pointer hover:bg-sky-700 active:bg-sky-900' onclick='runCmd(\"/boost\")'>Run</button>" +
        "      <button id='btn-tog' onclick='toggleMode()'>Toggle</button>" +
        "      <div id='out'>idle</div>" +
        "    </main>" +
        "  </div>" +
        "  <script>" +
        "    let mode = 0;" +
        "    let total = 0;" +
        "    let k = 1;" +
        "    while (k <= 4) { total += k; k++; }" +
        "    function runCmd(cmd) {" +
        "      document.getElementById('inp').innerText = cmd;" +
        "      let cur = document.getElementById('inp').innerText;" +
        "      document.getElementById('out').innerText = 'CMD:' + cur + ':' + total;" +
        "    }" +
        "    function toggleMode() {" +
        "      if (mode == 0) {" +
        "        document.getElementById('badge').innerText = 'Active';" +
        "        document.getElementById('badge').classList.add('active-flag');" +
        "        mode = 1;" +
        "      } else {" +
        "        document.getElementById('badge').innerText = 'Paused';" +
        "        document.getElementById('badge').classList.remove('active-flag');" +
        "        mode = 0;" +
        "      }" +
        "    }" +
        "  </script>" +
        "</div>"

    mut app := ui_window_html("Test Desktop", 1200, 800, html_src)

    // HTML entity decoding & separate placeholder
    title_idx := dom_find_by_id(app.tree, "title")
    inp_idx := dom_find_by_id(app.tree, "inp")
    rc = assert_true(str_eq(dom_get_text(app.tree, title_idx), "Axon <Desktop> 'v2'"), 1)
    if rc != 0 { return rc }
    rc = assert_true(str_eq(dom_get_text(app.tree, inp_idx), ""), 2)
    if rc != 0 { return rc }
    rc = assert_true(str_eq(dom_get_placeholder(app.tree, inp_idx), "Type command..."), 3)
    if rc != 0 { return rc }

    // CSS: `>` child combinator, `var(--accent)`, ancestor inheritance, per-side border, focus/hover/active
    hdr_idx := dom_find_by_id(app.tree, "hdr")
    nav_idx := dom_find_by_id(app.tree, "nav")
    btn_idx := dom_find_by_id(app.tree, "btn-run")
    hdr_st := css_compute_node_style(app.tree, hdr_idx, app.sheet)
    title_st := css_compute_node_style(app.tree, title_idx, app.sheet)
    nav_st := css_compute_node_style(app.tree, nav_idx, app.sheet)
    btn_hov := css_compute_node_style_full(app.tree, btn_idx, app.sheet, true, false, false)
    btn_act := css_compute_node_style_full(app.tree, btn_idx, app.sheet, false, false, true)
    inp_foc := css_compute_node_style_full(app.tree, inp_idx, app.sheet, false, true, false)

    rc = assert_eq_i64(hdr_st.border_sides, 4, 4)          // border-bottom = bit 4
    if rc != 0 { return rc }
    rc = assert_eq_i64(hdr_st.text_color, 0xFF38BDF8, 5)   // var(--accent)
    if rc != 0 { return rc }
    rc = assert_eq_i64(title_st.text_color, 0xFF38BDF8, 6) // inherited color from .header
    if rc != 0 { return rc }
    rc = assert_eq_i64(title_st.font_size, 15, 7)          // inherited font-size from .header
    if rc != 0 { return rc }
    rc = assert_eq_i64(nav_st.border_sides, 2, 8)          // border-r = bit 2
    if rc != 0 { return rc }
    rc = assert_eq_i64(btn_hov.bg_color, 0xFF0369A1, 9)    // hover:bg-sky-700
    if rc != 0 { return rc }
    rc = assert_eq_i64(btn_act.bg_color, 0xFF0C4A6E, 10)   // active:bg-sky-900
    if rc != 0 { return rc }
    rc = assert_eq_i64(inp_foc.border_color, 0xFF0EA5E9, 11) // focus:border-sky-500
    if rc != 0 { return rc }

    // Layout: flex-1 vertical expansion + mt-auto pinned footer + multi-line code height
    body_idx := dom_find_by_id(app.tree, "body")
    foot_idx := dom_find_by_id(app.tree, "nav-foot")
    code_idx := dom_find_by_id(app.tree, "code")
    rc = assert_true(layout_get_h(app.layout, body_idx) >= 700, 12)
    if rc != 0 { return rc }
    rc = assert_true(layout_get_y(app.layout, foot_idx) >= 700, 13)
    if rc != 0 { return rc }
    rc = assert_true(layout_get_h(app.layout, code_idx) >= 60, 14) // 4 lines * >=16px
    if rc != 0 { return rc }

    // Embedded JS: while loop (1+2+3+4=10), function args, DOM read, string concat, if/else
    _ := js_eval_action(mut app.tree, app.state, "runCmd('/boost')")
    rc = assert_true(str_eq(ui_get_text(app, "out"), "CMD:/boost:10"), 15)
    if rc != 0 { return rc }
    _ := js_eval_action(mut app.tree, app.state, "toggleMode()")
    rc = assert_true(str_eq(ui_get_text(app, "badge"), "Active"), 16)
    if rc != 0 { return rc }
    _ := js_eval_action(mut app.tree, app.state, "toggleMode()")
    rc = assert_true(str_eq(ui_get_text(app, "badge"), "Paused"), 17)
    if rc != 0 { return rc }

    // CSS injection via JS .style blocked (S11)
    bad_sty := js_eval_action(mut app.tree, app.state, "document.getElementById('out').style.color = 'red; background: blue'")
    rc = assert_true(not bad_sty, 18)
    if rc != 0 { return rc }

    // 2. Security regressions: JSON top-level beats nested shadowing
    jdoc := "{\"meta\":{\"role\":\"admin\"},\"role\":\"guest\"}"
    role_v := json_get_str(jdoc, "role") or ""
    rc = assert_true(str_eq(role_v, "guest"), 19)
    if rc != 0 { return rc }

    // Path drive root preservation & Windows reserved device rejection
    rc = assert_true(str_eq(path_normalize("C:\\Users\\a\\..\\b"), "C:/Users/b"), 20)
    if rc != 0 { return rc }
    rc = assert_true(not is_safe_subpath("subdir/CON.txt"), 21)
    if rc != 0 { return rc }
    rc = assert_true(not is_safe_subpath("subdir/file."), 22)
    if rc != 0 { return rc }
    rc = assert_true(is_safe_subpath("subdir/valid_file.ax"), 23)
    if rc != 0 { return rc }

    // Constant-time string eq, CSPRNG UUID, incompressible LZ roundtrip, HTTP \r\n\r\n, harness safety
    rc = assert_true(ct_eq_str("secret_token", "secret_token"), 24)
    if rc != 0 { return rc }
    rc = assert_true(not ct_eq_str("secret", "secret_longer"), 25)
    if rc != 0 { return rc }
    u1 := uuid_v4()
    u2 := uuid_v4()
    rc = assert_true(str_len(u1) == 36 and not str_eq(u1, u2), 26)
    if rc != 0 { return rc }

    raw_b := buf_new(64)
    mut bi := 0
    while bi < 40 { buf_push(raw_b, (bi * 73 + 19) & 255); bi += 1 }
    comp := compress_bytes(raw_b)
    decomp := decompress_bytes(comp) or buf_new(1)
    rc = assert_eq_i64(buf_len(decomp), 40, 27)
    buf_free(move raw_b); buf_free(move comp); buf_free(move decomp)
    if rc != 0 { return rc }

    hreq := http_parse_request("GET /ping HTTP/1.1\r\nHost: localhost\r\n\r\n") or return 28
    rc = assert_true(str_eq(hreq.method, "GET") and str_eq(hreq.path, "/ping"), 28)
    if rc != 0 { return rc }

    rc = assert_true(not harness_is_safe_cmd("git status --no-index"), 29)
    if rc != 0 { return rc }
    rc = assert_true(not harness_is_safe_cmd("axc build a.ax -o C:/evil.exe"), 30)
    if rc != 0 { return rc }
    rc = assert_true(harness_is_safe_cmd("bin/axc.exe check app.ax"), 31)
    if rc != 0 { return rc }

    println("[SUITE OK] desktop-ui-v2-and-security: 31/31 assertions passed")
    return 0
}
