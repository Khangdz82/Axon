// Test 24: Zero-SDK WebAssembly (`--target wasm32`) + WASI Preview1 + 0xFD SIMD128 Parity

struct Vec2Body {
    px: f32
    vx: f32
    py: f32
    unused: f32
}

struct Point {
    x: i64
    y: i64
    label: str
}

fn format_tag(prefix: str, code: i64 = 7, scale: i64 = 3) -> str {
    return f"{prefix}:{code * scale}"
}

fn safe_div(a: i64, b: i64) -> i64 ! i64 {
    if b == 0 {
        return err(400)
    }
    return ok(a / b)
}

fn test_result_propagate(x: i64, d: i64) -> i64 ! i64 {
    q := safe_div(x, d) or return err(401)
    return ok(q + 10)
}

fn make_pair(a: i64, b: i64) -> (i64, i64) {
    return (a + 1, b * 2)
}

fn main() -> i32 {
    t0 := clock_ns()

    // 1. Default & Named args + f"..." + str concat/eq/slice/byte
    tag1 := format_tag("ax")
    tag2 := format_tag("ax", scale = 5, code = 4)
    joined := tag1 + "|" + tag2
    if joined != "ax:21|ax:20" {
        return 11
    }
    if str_len(joined) != 11 or str_byte(joined, 5) != 124 or str_slice(joined, 6, 11) != "ax:20" {
        return 12
    }

    // 2. Structs + Named args + Mutation
    mut p := Point(y = 30, label = "node", x = 10)
    p.x += 12
    if p.x != 22 or p.y != 30 or p.label != "node" {
        return 13
    }

    // 3. Tuples + Destructuring + continue/break in for_range
    (pa, pb) := make_pair(9, 15)
    if pa != 10 or pb != 30 {
        return 14
    }
    mut loop_acc := 0
    for i in 0..10 {
        if i == 2 {
            continue
        }
        if i == 7 {
            break
        }
        loop_acc += i
    }
    // 0+1+3+4+5+6 = 19
    if loop_acc != 19 {
        return 15
    }

    // 4. Error handling: ok / err / or / or return
    r_ok := safe_div(42, 6) or -1
    r_err := safe_div(42, 0) or 99
    r_prop_ok := test_result_propagate(20, 2) or -1
    r_prop_err := test_result_propagate(20, 0) or -5
    if r_ok != 7 or r_err != 99 or r_prop_ok != 20 or r_prop_err != -5 {
        return 16
    }

    // 5. ByteBuf & IntBuf across 64KB memory pages (`memory.grow`)
    bb := buf_new(512)
    buf_push_str(bb, "wasm32:")
    mut k := 0
    while k < 300 {
        buf_push(bb, 65 + (k % 26))
        k += 1
    }
    if buf_len(bb) != 307 or buf_slice_str(bb, 0, 7) != "wasm32:" or buf_get(bb, 7) != 65 {
        return 17
    }
    buf_free(move bb)

    ib := ibuf_new(16384)
    mut j := 0
    while j < 12000 {
        ibuf_push(ib, j * 3 + 1)
        j += 1
    }
    if ibuf_len(ib) != 12000 or ibuf_get(ib, 11999) != 35998 {
        return 18
    }

    // 6. Table[T] Columnar SoA + 0xFD WASM SIMD128 vector loop + scalar remainder (4099 % 4 == 3)
    n := 4099
    bodies := Table[Vec2Body]::with_capacity(n)
    table_fill_f32(bodies, 0, 2.0)
    table_fill_f32(bodies, 1, 1.5)
    table_fill_f32(bodies, 2, 5.0)
    dt := 4.0
    for b in bodies {
        b.px += b.vx * dt
        b.py *= 2.0
    }
    px0 := table_get_f32(bodies, 0, 0) as i64
    px_last := table_get_f32(bodies, 0, 4098) as i64
    py_last := table_get_f32(bodies, 2, 4098) as i64
    if px0 != 8 or px_last != 8 or py_last != 10 {
        return 19
    }

    t1 := clock_ns()
    if t1 < t0 {
        return 20
    }

    println(f"  [24] WASM32+WASI+SIMD128 verified: tag={joined}, ibuf={ibuf_len(ib)}, px_last={px_last}, py_last={py_last}")
    return 0
}
