use std::css
use std::html
use std::ui
use std::str
use std::test_kit

fn main() -> i64 {
    s := suite_new("std-css-typography")

    // Tailwind utilities must map onto ComputedStyle tokens.
    ts := style_default()
    mut tw := ts
    tw_apply_classes(mut tw, "text-2xl font-bold text-center")
    assert_eq_i64(s, tw.font_size, 24, "text-2xl -> 24px")
    assert_eq_i64(s, tw.font_weight, 700, "font-bold -> 700")
    assert_eq_i64(s, tw.text_align, 1, "text-center -> center")

    mut tw_sm := ts
    tw_apply_classes(mut tw_sm, "text-sm font-medium text-right")
    assert_eq_i64(s, tw_sm.font_size, 14, "text-sm -> 14px")
    assert_eq_i64(s, tw_sm.font_weight, 500, "font-medium -> 500")
    assert_eq_i64(s, tw_sm.text_align, 2, "text-right -> right")

    // Explicit CSS declarations win over defaults.
    mut inline := ts
    css_parse_inline(mut inline, "font-size: 18px; font-weight: bold; text-align: right")
    assert_eq_i64(s, inline.font_size, 18, "font-size px parsed")
    assert_eq_i64(s, inline.font_weight, 700, "font-weight bold parsed")
    assert_eq_i64(s, inline.text_align, 2, "text-align right parsed")

    mut numeric := ts
    css_parse_inline(mut numeric, "font-weight: 600")
    assert_eq_i64(s, numeric.font_weight, 600, "numeric font-weight parsed")

    // Invalid / hostile values must not corrupt the style.
    mut hostile := ts
    css_parse_inline(mut hostile, "font-size: -40px; font-weight: 99999; text-align: sideways")
    assert_eq_i64(s, hostile.font_size, 0, "negative font-size rejected")
    assert_eq_i64(s, hostile.font_weight, 0, "out-of-range weight rejected")
    assert_eq_i64(s, hostile.text_align, 0, "unknown alignment falls back to left")

    // Stylesheet + inline cascade through the real DOM path.
    tree := html_parse("<div id=\"a\" class=\"text-xl\">Hello</div>") or return 1
    idx := dom_find_by_id(tree, "a")
    assert_true(s, idx >= 0, "node located by id")
    sheet := css_parse_stylesheet("#a { color: #ffffff; font-size: 30px; }")
    st := css_compute_node_style(tree, idx, sheet)
    assert_eq_i64(s, st.font_size, 30, "stylesheet font-size wins over tailwind")
    assert_eq_i64(s, st.text_color, 0xFFFFFFFF, "stylesheet color applied")

    dom_tree_free(move tree)
    return suite_finish(move s)
}
