// Regression suite: Web HTML/CSS/JS UI fidelity (Grid, flex-wrap, vertical flex-1, compound/descendant CSS,
// DOM click bubbling, multi-statement JS) + Security fixes (FFI, SafeTensors, ONNX, UUID).

use std::ui
use std::gui
use std::ffi
use std::safetensors
use std::onnx
use std::uuid
use std::toml

@test
fn test_css_grid_flex_wrap_and_vertical_flex1() {
    // 1. CSS Grid 3-column layout with gap=12 on 600px container -> each cell = (600 - 24)/3 = 192px
    html := "<div id='root' class='grid grid-cols-3 gap-3'>" +
            "<div id='c1' class='p-4 bg-slate-800'>A</div>" +
            "<div id='c2' class='p-4 bg-slate-800'>B</div>" +
            "<div id='c3' class='p-4 bg-slate-800'>C</div>" +
            "<div id='c4' class='p-4 bg-slate-800'>D</div>" +
            "</div>"
    mut app := ui_window_html("Grid Test", 600, 400, html)
    i1 := document_get_element_by_id(app.tree, "c1")
    i2 := document_get_element_by_id(app.tree, "c2")
    i3 := document_get_element_by_id(app.tree, "c3")
    i4 := document_get_element_by_id(app.tree, "c4")
    assert(layout_get_w(app.layout, i1) == 192)
    assert(layout_get_x(app.layout, i2) == 204)
    assert(layout_get_x(app.layout, i3) == 408)
    assert(layout_get_x(app.layout, i4) == 0)
    assert(layout_get_y(app.layout, i4) > layout_get_y(app.layout, i1))

    // 2. Vertical flex-1 inside h-screen flex-col expands to push footer to bottom
    html2 := "<div class='flex flex-col h-screen'>" +
             "<div id='hdr' class='h-12 bg-slate-900'>Header</div>" +
             "<div id='mid' class='flex-1 bg-slate-800'>Body</div>" +
             "<div id='ftr' class='h-12 bg-slate-900'>Footer</div>" +
             "</div>"
    mut app2 := ui_window_html("FlexCol Test", 400, 500, html2)
    im := document_get_element_by_id(app2.tree, "mid")
    iftr := document_get_element_by_id(app2.tree, "ftr")
    assert(layout_get_h(app2.layout, im) > 350)
    assert(layout_get_y(app2.layout, iftr) >= 440)

    // 3. flex-wrap wraps overflowing items onto next line
    html3 := "<div class='flex flex-wrap gap-2'>" +
             "<div id='w1' class='w-40 h-8'>1</div>" +
             "<div id='w2' class='w-40 h-8'>2</div>" +
             "<div id='w3' class='w-40 h-8'>3</div>" +
             "</div>"
    mut app3 := ui_window_html("Wrap Test", 340, 200, html3)
    iw1 := document_get_element_by_id(app3.tree, "w1")
    iw3 := document_get_element_by_id(app3.tree, "w3")
    assert(layout_get_y(app3.layout, iw3) > layout_get_y(app3.layout, iw1))
}

@test
fn test_css_compound_descendant_and_many_rules() {
    // Compound (`div.card.active`), descendant (`.nav .item`), 2-value padding, and >40 rules without trap
    mut css := ".nav .item { color: #38bdf8; padding: 8px 20px; } div.card.active { background-color: #1e293b; font-family: monospace; }"
    mut r := 0
    while r < 45 {
        css = css + f" .r{r} {{ opacity: 1; }}"
        r += 1
    }
    html := "<div class='nav'><div id='it' class='item'>Link</div></div><div id='cd' class='card active'>Code</div>"
    mut app := ui_window_html("CSS Test", 500, 300, html)
    ui_set_css(mut app, css)
    assert(app.sheet.rule_count >= 47)

    iit := document_get_element_by_id(app.tree, "it")
    sit := css_compute_node_style(app.tree, iit, app.sheet)
    assert(sit.text_color == 0xFF38BDF8)
    assert(sit.padding_y == 16 and sit.padding_x == 40)

    icd := document_get_element_by_id(app.tree, "cd")
    scd := css_compute_node_style(app.tree, icd, app.sheet)
    assert(scd.bg_color == 0xFF1E293B)
    assert(scd.font_mono == true)
}

@test
fn test_js_multi_stmt_and_dom_click_bubbling() {
    html := "<div class='flex flex-col p-4'>" +
            "<button id='btn' onclick=\"document.querySelector('#out').textContent = 'Clicked!'; document.getElementById('out').classList.add('text-green-400'); #out.style.color = '#22c55e'\">" +
            "<span id='lbl'>Press</span>" +
            "</button>" +
            "<div id='out'>Idle</div>" +
            "</div>"
    mut app := ui_window_html("JS Test", 400, 200, html)
    ilbl := document_get_element_by_id(app.tree, "lbl")
    cx := layout_get_x(app.layout, ilbl) + 4
    cy := layout_get_y(app.layout, ilbl) + 4
    // Clicking inner <span> bubbles up to parent <button onclick="..."> and executes all 3 JS statements!
    _ := ui_dispatch_click(mut app, cx, cy)
    assert(str_eq(ui_get_text(app, "out"), "Clicked!"))
    iout := document_get_element_by_id(app.tree, "out")
    sout := css_compute_node_style(app.tree, iout, app.sheet)
    assert(sout.text_color == 0xFF22C55E)
}

@test
fn test_security_ffi_safetensors_onnx_uuid() {
    // 1. ffi_call_arr rejects negative / >16 argc cleanly
    ea := ibuf_new(2)
    assert(ffi_call_arr(1, -1, ea) == 0)
    assert(ffi_call_arr(1, 99, ea) == 0)
    buf_free(move ea)

    // 2. safetensors rejects decimal overflow in data_offsets
    bad_hdr := "{\"w\":{\"dtype\":\"F32\",\"shape\":[1],\"data_offsets\":[999999999999999999999,4]}}"
    off_res := safetensors_find_offsets(bad_hdr, "w") or ibuf_new(0)
    assert(ibuf_len(off_res) == 0)
    buf_free(move off_res)

    // 3. ONNX session safely skips uninitialized null input slot without crashing
    mut sess := onnx_session_new(8)
    onnx_add_node(mut sess, onnx_op_relu(), 3, -1, 4)
    onnx_add_node(mut sess, onnx_op_layernorm(), 3, -1, 5)
    inp := np_zeros(1, 2)
    out := onnx_session_run(mut sess, 0, inp, 4)
    assert(out.data_ptr == 0)
    np_free(move inp)
    onnx_session_free(move sess)

    // 4. Rapid sequential uuid_v4() calls produce distinct UUIDs
    u1 := uuid_v4()
    u2 := uuid_v4()
    assert(uuid_is_valid(u1) and uuid_is_valid(u2))
    assert(not str_eq(u1, u2))

    // 5. TOML short-line overflow fix (200x 4-byte lines), overflow guard, and `exp_ms` preservation
    mut tsrc := "exp_ms = 42\nbig = 99999999999999999999999\n"
    mut ti := 0
    while ti < 200 {
        tsrc = tsrc + "a=1\n"
        ti += 1
    }
    tdoc := toml_parse(tsrc)
    assert(toml_get_i64(tdoc, "", "exp_ms", -1) == 42)
    assert(toml_get_i64(tdoc, "", "big", -9) == -9)
    toml_free(move tdoc)
}

@test
fn test_position_absolute_input_typing_and_scroll() {
    // 1. position: absolute right-4 bottom-4 inside 400x300 container
    html := "<div class='relative w-[400px] h-[300px]'>" +
            "<div id='badge' class='absolute right-4 bottom-4 w-20 h-8'>NEW</div>" +
            "<textarea id='inp' class='w-60 h-10'>Hi</textarea>" +
            "<div class='h-[600px]'>Tall</div>" +
            "</div>"
    mut app := ui_window_html("PosInputScroll", 400, 300, html)
    ib := document_get_element_by_id(app.tree, "badge")
    // right-4 = 16px, w-20 = 80px -> x = 400 - 16 - 80 = 304; bottom-4 = 16px, h-8 = 32px -> y = 300 - 16 - 32 = 252
    assert(layout_get_x(app.layout, ib) == 304)
    assert(layout_get_y(app.layout, ib) == 252)

    // 2. Click <input> -> focus -> type Vietnamese Unicode 'ệ' (0x1EC7) -> Backspace deletes full UTF-8 char cleanly
    ii := document_get_element_by_id(app.tree, "inp")
    _ := ui_dispatch_click(mut app, layout_get_x(app.layout, ii) + 8, layout_get_y(app.layout, ii) + 8)
    assert(app.focused_idx == ii)
    assert(ui_handle_char(mut app, 0x1EC7)) // 'ệ'
    assert(str_len(ui_get_text(app, "inp")) == 5) // "Hi" (2) + 3-byte UTF-8 'ệ'
    assert(ui_handle_char(mut app, 8)) // Backspace
    assert(str_eq(ui_get_text(app, "inp"), "Hi"))

    // 3. Scroll down clamped cleanly
    assert(ui_scroll(mut app, 120))
    assert(app.scroll_y == 120)
    assert(ui_scroll(mut app, -500))
    assert(app.scroll_y == 0)
}

@test
fn test_img_src_input_value_and_per_container_scroll() {
    // 1. <img src="..."> and <input value="..."> parse cleanly + independent overflow-y-auto containers
    html := "<div class='flex flex-row h-screen'>" +
            "<div id='side' class='w-40 h-full overflow-y-auto'>" +
            "<div class='h-[500px]'>Sidebar Tall</div>" +
            "</div>" +
            "<div id='main' class='flex-1 h-full overflow-y-auto'>" +
            "<img id='av' src='.tmp_test_img.bmp' class='w-12 h-12 rounded-full'/>" +
            "<input id='q' value='Xin chao' class='w-40 h-10'/>" +
            "<div class='h-[800px]'>Chat Feed</div>" +
            "</div>" +
            "</div>"
    mut app := ui_window_html("ScrollImgTest", 500, 300, html)
    assert(str_eq(ui_get_text(app, "av"), ".tmp_test_img.bmp"))
    assert(str_eq(ui_get_text(app, "q"), "Xin chao"))

    iside := document_get_element_by_id(app.tree, "side")
    imain := document_get_element_by_id(app.tree, "main")

    // Scroll inside sidebar (x=40, y=100) -> ONLY sidebar scrolls, main stays at 0!
    assert(ui_scroll_at(mut app, 40, 100, 80))
    assert(ui_node_scroll_y(app, iside) == 80)
    assert(ui_node_scroll_y(app, imain) == 0)

    // Scroll inside main pane (x=300, y=100) -> ONLY main scrolls, sidebar stays at 80!
    assert(ui_scroll_at(mut app, 300, 100, 150))
    assert(ui_node_scroll_y(app, imain) == 150)
    assert(ui_node_scroll_y(app, iside) == 80)

    // Write a real 16x16 BMP and render 2 live Direct2D frames with <img src="..."> + clipped scrollbars!
    _ := ui_save_screenshot(app, ".tmp_test_img.bmp")
    frames := gui_run_ui_app(mut app, 2, false)
    assert(frames == 2)
}

fn main() -> i32 {
    test_css_grid_flex_wrap_and_vertical_flex1()
    test_css_compound_descendant_and_many_rules()
    test_js_multi_stmt_and_dom_click_bubbling()
    test_security_ffi_safetensors_onnx_uuid()
    test_position_absolute_input_typing_and_scroll()
    test_img_src_input_value_and_per_container_scroll()
    println("[PASS] 43_web_ui_fidelity_and_sec: Grid/Flex/Pos/Input/Scroll/Img/CSS/JS + Security verified!")
    return 0
}
