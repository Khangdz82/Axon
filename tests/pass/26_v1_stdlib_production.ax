// Axon v1.0.0 Production Stdlib & SIMD Integration Suite (100+ Assertions)
// Imports ALL v1.0.0 stdlib modules simultaneously (verifies zero symbol collisions across std/*),
// plus tests Table[T] SoA AVX2 `-=` / `+=` / `*=`, KvStore, CSV, PRNG, Path, Encoding, Stopwatch, CLI.

use std::math
use std::ai_math
use std::rand
use std::path
use std::encoding
use std::log
use std::time
use std::data
use std::cli
use std::collections
use std::http
use std::json
use std::crypto
use std::str
use std::os
use std::test_kit

struct Particle {
    x: f32
    vx: f32
}

fn main() -> i64 {
    s := suite_new("v1.0.0-stdlib-production")

    // --- 1. std::math integer & geometry suite ---
    assert_eq_i64(s, min_i64(-10, 5), -10, "min_i64")
    assert_eq_i64(s, max_i64(-10, 5), 5, "max_i64")
    assert_eq_i64(s, clamp_i64(15, 0, 10), 10, "clamp_i64 hi")
    assert_eq_i64(s, clamp_i64(-3, 0, 10), 0, "clamp_i64 lo")
    assert_eq_i64(s, abs_i64(-99), 99, "abs_i64 neg")
    assert_eq_i64(s, sign_i64(-42), -1, "sign_i64 neg")
    assert_eq_i64(s, sign_i64(0), 0, "sign_i64 zero")
    assert_eq_i64(s, sign_i64(77), 1, "sign_i64 pos")
    assert_eq_i64(s, gcd(48, 18), 6, "gcd(48,18)")
    assert_eq_i64(s, gcd(0, 17), 17, "gcd(0,17)")
    assert_eq_i64(s, lcm(21, 6) or -1, 42, "lcm(21,6)")
    assert_eq_i64(s, pow_i64(3, 10), 59049, "pow_i64(3,10)")
    assert_eq_i64(s, pow_i64(5, 0), 1, "pow_i64(5,0)")
    assert_eq_i64(s, pow_mod_i64(2, 100, 1000000007) or -1, 976371285, "pow_mod_i64(2,100,1e9+7)")
    assert_eq_i64(s, pow_mod_i64(1234567890123, 7, 1000000000039) or -1, 65010588130, "pow_mod_i64 large Russian peasant")
    assert_eq_i64(s, isqrt_i64(0), 0, "isqrt 0")
    assert_eq_i64(s, isqrt_i64(144), 12, "isqrt 144")
    assert_eq_i64(s, isqrt_i64(1000000000000000000), 1000000000, "isqrt 1e18")
    assert_eq_i64(s, ceil_div_i64(10, 3) or -1, 4, "ceil_div 10/3")
    assert_eq_i64(s, ceil_div_i64(0, 7) or -1, 0, "ceil_div 0/7")
    assert_true(s, is_pow2_i64(1024), "is_pow2 1024")
    assert_true(s, not is_pow2_i64(1023), "not is_pow2 1023")
    assert_eq_i64(s, next_pow2_i64(1000) or -1, 1024, "next_pow2 1000")
    assert_near_f64(s, math_floor(3.9), 3.0, 0.0001, "floor pos")
    assert_near_f64(s, math_floor(-1.2), -2.0, 0.0001, "floor neg")
    assert_near_f64(s, math_floor(-2.0), -2.0, 0.0001, "floor exact neg")
    assert_near_f64(s, math_ceil(3.1), 4.0, 0.0001, "ceil pos")
    assert_near_f64(s, math_ceil(-1.8), -1.0, 0.0001, "ceil neg")
    assert_near_f64(s, math_round(2.5), 3.0, 0.0001, "round pos")
    assert_near_f64(s, math_round(-2.5), -3.0, 0.0001, "round neg")
    assert_near_f64(s, math_lerp(10.0, 20.0, 0.25), 12.5, 0.0001, "lerp")
    assert_near_f64(s, math_remap(0.0, 100.0, -1.0, 1.0, 50.0), 0.0, 0.0001, "remap")
    assert_near_f64(s, math_hypot(3.0, 4.0), 5.0, 0.0001, "hypot 3-4-5")
    assert_near_f64(s, math_atan2(1.0, 1.0), 0.785398, 0.001, "atan2(1,1) ~ pi/4")
    assert_near_f64(s, math_deg_to_rad(180.0), 3.14159265, 0.0001, "deg_to_rad 180")
    assert_near_f64(s, sin_f64(0.0), 0.0, 0.0001, "ai_math sin_f64 coexists cleanly")
    assert_near_f64(s, clamp_f64(5.0, 0.0, 1.0), 1.0, 0.0001, "ai_math clamp_f64 coexists")

    // --- 2. std::rand determinism & range bounds ---
    r1 := rng_new(1337)
    r2 := rng_new(1337)
    assert_eq_i64(s, rng_next_u64(r1), rng_next_u64(r2), "rng deterministic sequence")
    mut all_in_range := true
    mut ri := 0
    while ri < 200 {
        rv := rng_range(r1, -10, 10) or -999
        if rv < -10 or rv >= 10 { all_in_range = false }
        rf := rng_f64(r1)
        if rf < 0.0 or rf >= 1.0 { all_in_range = false }
        ri += 1
    }
    assert_true(s, all_in_range, "200 rng_range + rng_f64 samples within [lo, hi)")
    assert_eq_i64(s, rng_range(r1, 5, 5) or -777, -777, "rng_range invalid interval errs")
    rng_free(move r1)
    rng_free(move r2)

    // --- 3. std::path normalization, join, basename, dirname, ext, stem ---
    assert_eq_str(s, path_normalize("/var/log/../lib/./axon//bin"), "/var/lib/axon/bin", "path_normalize abs")
    assert_eq_str(s, path_normalize("a/b/c/../../d"), "a/d", "path_normalize rel")
    assert_eq_str(s, path_normalize(""), ".", "path_normalize empty")
    assert_eq_str(s, path_join("/opt/axon/", "bin/axc"), "/opt/axon/bin/axc", "path_join")
    assert_eq_str(s, path_basename("/opt/axon/lib.ax/"), "lib.ax", "path_basename trailing slash")
    assert_eq_str(s, path_dirname("/opt/axon/main.ax"), "/opt/axon", "path_dirname")
    assert_eq_str(s, path_ext("/dir.v1/archive.tar.gz"), ".gz", "path_ext")
    assert_eq_str(s, path_stem("/dir.v1/main.ax"), "main", "path_stem")
    assert_true(s, path_is_abs("/usr/bin"), "path_is_abs posix")
    assert_true(s, path_is_abs("C:\\Windows"), "path_is_abs win")
    assert_true(s, not path_is_abs("rel/file.ax"), "path_is_abs relative")

    // --- 4. std::encoding Base64URL + ULEB128 + CSV ---
    b64u := base64url_encode("subjects?_d=1+2/3")
    assert_true(s, not str_contains(b64u, "+") and not str_contains(b64u, "/") and not str_contains(b64u, "="), "b64url alphabet no pad")
    assert_eq_str(s, base64url_decode(b64u) or "ERR", "subjects?_d=1+2/3", "b64url roundtrip")
    assert_eq_str(s, base64url_decode("SGVsbG8=") or "ERR", "Hello", "b64url accepts optional =")

    ub := buf_new(32)
    _u0 := uleb128_push(ub, 0) or -1
    _u1 := uleb128_push(ub, 127) or -1
    _u2 := uleb128_push(ub, 16384) or -1
    assert_eq_i64(s, uleb128_decode_val(ub, 0) or -1, 0, "uleb128 0")
    assert_eq_i64(s, uleb128_decode_val(ub, 1) or -1, 127, "uleb128 127")
    assert_eq_i64(s, uleb128_decode_val(ub, 2) or -1, 16384, "uleb128 16384")
    assert_eq_i64(s, uleb128_push(ub, -5) or -999, -999, "uleb128 rejects negative")
    buf_free(move ub)

    assert_eq_i64(s, csv_col_count("id,\"a,b\",c"), 3, "csv_col_count quoted comma")
    assert_eq_i64(s, csv_line_count("a,b\n\"multi\nline\",2\n"), 2, "csv_line_count quoted newline")
    assert_eq_str(s, csv_get_cell("42,\"hello, world\",true", 1) or "ERR", "hello, world", "csv_get_cell quoted")
    assert_eq_str(s, csv_escape_cell("a\"b,c"), "\"a\"\"b,c\"", "csv_escape_cell")

    // --- 5. std::time Stopwatch + std::log + std::cli defaults ---
    sw := sw_start()
    mut spin := 0
    mut si := 0
    while si < 10000 { spin += si; si += 1 }
    assert_true(s, sw_elapsed_ns(sw) >= 0 and spin > 0, "stopwatch non-negative elapsed")
    assert_eq_i64(s, ms_to_ns(5), 5000000, "ms_to_ns")
    assert_eq_i64(s, ns_to_us(15000), 15, "ns_to_us")
    assert_eq_str(s, log_kv("WARN", "srv", "port", "8080"), "[WARN] [srv] port=8080", "log_kv clean")
    assert_eq_i64(s, cli_get_i64("--missing-flag", 9090), 9090, "cli_get_i64 default")
    assert_eq_str(s, cli_require_opt("--missing-flag") or "NONE", "NONE", "cli_require_opt missing err")

    // --- 6. std::data KvStore + std::collections Map/Stack ---
    kv := kv_new(32, 4096)
    assert_true(s, kv_set(kv, "k1", "val1"), "kv_set k1")
    assert_true(s, kv_set(kv, "k2", "val2"), "kv_set k2")
    assert_true(s, kv_set(kv, "k1", "val1_updated"), "kv_overwrite k1")
    assert_eq_i64(s, kv_len(kv), 2, "kv_len")
    assert_eq_str(s, kv_get(kv, "k1") or "ERR", "val1_updated", "kv_get updated")
    assert_true(s, kv_del(kv, "k2"), "kv_del k2")
    assert_true(s, not kv_has(kv, "k2"), "kv deleted")
    kv_free(move kv)

    mp := map_new(64)
    _m0 := map_put(mp, 1001, 55)
    _m1 := map_put(mp, 2002, 88)
    assert_eq_i64(s, map_get(mp, 1001, -1), 55, "map_get hit")
    assert_eq_i64(s, map_get(mp, 9999, -1), -1, "map_get miss")
    assert_true(s, map_remove(mp, 1001) and not map_contains(mp, 1001), "map_remove")
    buf_free(move mp)

    // --- 7. Table[T] SoA AVX2 SIMD Subtraction (`-=`) & Accumulation (`+=`) ---
    tbl := Table[Particle]::with_capacity(64)
    table_fill_f32(tbl, 0, 10.0)
    table_fill_f32(tbl, 1, 2.0)
    for p in tbl {
        p.x -= p.vx * 0.5
        p.vx += p.x * 0.1
    }
    // x = 10.0 - 2.0 * 0.5 = 9.0; vx = 2.0 + 9.0 * 0.1 = 2.9
    assert_near_f64(s, table_get_f32(tbl, 0, 0), 9.0, 0.001, "Table SoA `-=` lane 0")
    assert_near_f64(s, table_get_f32(tbl, 0, 63), 9.0, 0.001, "Table SoA `-=` lane 63")
    assert_near_f64(s, table_get_f32(tbl, 1, 31), 2.9, 0.001, "Table SoA `+=` after `-=` lane 31")

    return suite_finish(move s)
}
