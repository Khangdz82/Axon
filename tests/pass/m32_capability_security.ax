// Test M32: Object-Capability Security & Supply-Chain Attack Neutralization (`std/cap.ax`)
// Asserts unforgeable linear capability tokens, path attenuation, host restriction, and zero runtime overhead.

use std::cap::RootCap;
use std::cap::FsCap;
use std::cap::NetCap;
use std::cap::root_cap_init;
use std::cap::fs_sub_dir;
use std::cap::net_allow_host;
use std::cap::cap_verify_fs;
use std::cap::cap_verify_net;
use std::cap::cap_is_zero_cost;
use std::io::fs_open_gated;
use std::net::tcp_connect_gated;
use compiler_ax::types::verify_capability_token;
use compiler_ax::types::audit_package_capability_leak;

struct M32CapSecurityReport {
    root_init_ok: i32,
    sub_dir_attenuation_ok: i32,
    traversal_blocked_ok: i32,
    net_restriction_ok: i32,
    unauthorized_connect_blocked: i32,
    supply_chain_audit_ok: i32,
    zero_cost_runtime_ok: i32,
    passed: i32,
}

fn test_capability_sandbox() -> M32CapSecurityReport {
    // 1. OS gives linear RootCap to main()
    let root = root_cap_init();
    let root_ok = if root.proc.can_spawn == 1 and root.gpu.max_vram_mb == 32768 { 1 } else { 0 };

    // 2. Attenuate filesystem capability to read-only sub-directory "./plugins/data"
    let plugin_data_hash: i64 = 8899112233;
    let (safe_fs, sub_ok) = fs_sub_dir(root.fs, plugin_data_hash, 1, 0); // ReadOnly (1), no traversal

    // 3. Attempt path traversal attack: "../../../etc/shadow" -> must be rejected
    let attack_hash: i64 = 9988776655;
    let (blocked_fs, attack_result) = fs_sub_dir(root.fs, attack_hash, 1, 1); // has_traversal == 1
    let traversal_blocked = if attack_result == 0 { 1 } else { 0 };

    // 4. Verify gated file open with attenuated capability
    let (valid_fd, open_err) = fs_open_gated(safe_fs, plugin_data_hash, 1);
    let open_ok = if open_err == 0 and valid_fd == 100 { 1 } else { 0 };

    // 5. Attenuate network capability to a single allowed host:port (api.example.com:443)
    let api_host_hash: i64 = 1122334455;
    let safe_net = net_allow_host(root.net, api_host_hash, 443);

    // 6. Connect to authorized host succeeds
    let (socket_ok, conn_status) = tcp_connect_gated(safe_net, api_host_hash, 443);
    let auth_conn_pass = if conn_status == 0 and socket_ok.port == 443 { 1 } else { 0 };

    // 7. Connect to rogue C2 server (evil.c2.io:8080) must be blocked
    let rogue_host_hash: i64 = 6677889900;
    let (blocked_sock, rogue_status) = tcp_connect_gated(safe_net, rogue_host_hash, 8080);
    let rogue_blocked = if rogue_status == -2 { 1 } else { 0 };

    // 8. Package capability audit: math package declaring NetCap (mask=2) is flagged as suspicious
    let math_leak = audit_package_capability_leak(1, 2); // Category 1: Math, Mask 2: Net -> Leak!
    let server_ok = audit_package_capability_leak(3, 3); // Category 3: Server, Mask 3: FS+Net -> Legitimate!
    let audit_pass = if math_leak == 1 and server_ok == 0 { 1 } else { 0 };

    // 9. Zero-cost verification
    let zero_cost = cap_is_zero_cost();

    let all_pass = root_ok * sub_ok * traversal_blocked * open_ok * auth_conn_pass * rogue_blocked * audit_pass * zero_cost;

    return M32CapSecurityReport(
        root_ok,
        sub_ok,
        traversal_blocked,
        auth_conn_pass,
        rogue_blocked,
        audit_pass,
        zero_cost,
        all_pass
    );
}

fn main() -> i32 {
    let rep = test_capability_sandbox();
    if rep.passed == 1 and rep.traversal_blocked_ok == 1 and rep.unauthorized_connect_blocked == 1 {
        return 0; // PASS: M32 Object-Capability Security 100% Verified
    }
    return 1;
}
