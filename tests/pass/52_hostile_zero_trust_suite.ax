// Hostile Zero-Trust Adversarial Test Suite (`tests/pass/52_hostile_zero_trust_suite.ax`)
// Covers differential verification of all x86-64 codegen optimizations (pow2 div/mod, LEA imm32,
// hoisted imm64, 4x/2x loop unroll, fib shrink-wrap, unsafe unwrap, bitwise precedence, tuple tail),
// plus hostile security/DoS/OOB/crash inputs across HTML, CSS, Tailwind, Layout, JS, HTTP, SQLite, GUI.
use std::str
use std::html
use std::css
use std::ui_tailwind
use std::ui_layout
use std::ui_js
use std::http
use std::sqlite
use std::gui

fn slow_div(a: i64, b: i64) -> i64 {
    return a / b
}

fn slow_mod(a: i64, b: i64) -> i64 {
    return a % b
}

fn fib_check(n: i64) -> i64 {
    if n <= 1 { return n }
    return fib_check(n - 1) + fib_check(n - 2)
}

fn tuple_tail_cond(c: bool, a: i64, b: i64) -> (i64, i64) {
    return if c { (a, b) } else { (b, a) }
}

fn http_req_ok(raw: str) -> bool {
    _ := http_parse_request(raw) or return false
    return true
}

fn http_hdr_ok(raw: str, name: str) -> bool {
    _ := http_get_header(raw, name) or return false
    return true
}

fn sqlite_prep_rc(db: SqliteDb, sql: str) -> i64 {
    st := sqlite_prepare(db, sql) or return -205
    sqlite_finalize(st)
    return 0
}

fn main() -> i32 {
    mut fail := 0

    // 1. Differential Verification of Strength-Reduced Pow2 Div & Mod across ALL hostile boundary i64s!
    // Covers 0, +-1, +-7, +-8, +-9, +-15, +-16, +-17, INT32_MIN/MAX, INT64_MIN, INT64_MAX.
    i64_min := 1 << 63
    i64_max := i64_min -% 1
    vals := ibuf_new(32)
    ibuf_push(vals, 0); ibuf_push(vals, 1); ibuf_push(vals, -1)
    ibuf_push(vals, 2); ibuf_push(vals, -2); ibuf_push(vals, 7); ibuf_push(vals, -7)
    ibuf_push(vals, 8); ibuf_push(vals, -8); ibuf_push(vals, 9); ibuf_push(vals, -9)
    ibuf_push(vals, 15); ibuf_push(vals, -15); ibuf_push(vals, 16); ibuf_push(vals, -16)
    ibuf_push(vals, 17); ibuf_push(vals, -17); ibuf_push(vals, 1024); ibuf_push(vals, -1025)
    ibuf_push(vals, -2147483648); ibuf_push(vals, 2147483647)
    ibuf_push(vals, i64_min); ibuf_push(vals, i64_min + 1); ibuf_push(vals, i64_max); ibuf_push(vals, i64_max - 1)
    mut vi := 0
    while vi < ibuf_len(vals) {
        x := ibuf_get(vals, vi)
        if (x / 2) != slow_div(x, 2) or (x % 2) != slow_mod(x, 2) { println(f"FAIL pow2=2 x={x}"); fail += 1 }
        if (x / 8) != slow_div(x, 8) or (x % 8) != slow_mod(x, 8) { println(f"FAIL pow2=8 x={x}"); fail += 1 }
        if (x / 16) != slow_div(x, 16) or (x % 16) != slow_mod(x, 16) { println(f"FAIL pow2=16 x={x}"); fail += 1 }
        if (x / 256) != slow_div(x, 256) or (x % 256) != slow_mod(x, 256) { println(f"FAIL pow2=256 x={x}"); fail += 1 }
        if (x / 1024) != slow_div(x, 1024) or (x % 1024) != slow_mod(x, 1024) { println(f"FAIL pow2=1024 x={x}"); fail += 1 }
        vi += 1
    }
    buf_free(move vals)

    // 2. Bitwise Precedence (`&` > `^` > `|`) & Tuple Tail Expressions & Reused `for i` Unroll Remainders (0, 1, 2, 3, 4, 5, 7)
    if (1 | 2 & 0) != 1 { println("FAIL bitwise &>|"); fail += 1 }
    if (1 | 2 ^ 3) != 1 { println("FAIL bitwise ^>|"); fail += 1 }
    if (3 ^ 1 & 0) != 3 { println("FAIL bitwise &>^"); fail += 1 }
    (ta, tb) := tuple_tail_cond(true, 11, 22)
    (tc, td) := tuple_tail_cond(false, 11, 22)
    if ta != 11 or tb != 22 or tc != 22 or td != 11 { println("FAIL tuple_tail"); fail += 1 }

    // Test fib shrink-wrap exactness across negative, 0, 1, 2, 3, 4, 5, 6, 7, 10
    if fib_check(-5) != -5 or fib_check(0) != 0 or fib_check(1) != 1 or fib_check(2) != 1 or fib_check(3) != 2 or fib_check(4) != 3 or fib_check(5) != 5 or fib_check(6) != 8 or fib_check(7) != 13 or fib_check(10) != 55 {
        println("FAIL fib_check"); fail += 1
    }

    // Reused `for i` loops with exact remainder counts (0, 1, 3, 5, 7) + hoisted imm64
    mut c0 := 0
    for i in 0..0 { c0 += 1 }
    mut c1 := 0
    for i in 0..1 { c1 += 1 }
    mut c3 := 0
    for i in 0..3 { c3 += 1 }
    mut c5 := 0
    for i in 0..5 { c5 += i }
    mut c7 := 0
    mut hz := 1
    for i in 0..7 {
        hz = hz +% 0x9E3779B97F4A7C15
        c7 += 1
    }
    if c0 != 0 or c1 != 1 or c3 != 3 or c5 != 10 or c7 != 7 or hz != (1 +% (7 *% 0x9E3779B97F4A7C15)) {
        println(f"FAIL for_rem c0={c0} c1={c1} c3={c3} c5={c5} c7={c7}"); fail += 1
    }

    // 3. Hostile HTML: unclosed attr quote hang, 200-deep nesting stack overflow, dyn_buf compaction dangling negative offset
    t_bad := html_parse("<div \"a>b\"><span id=\"ok\">alive</span></div>") or return 2
    if not str_eq(dom_get_text(t_bad, dom_find_by_id(t_bad, "ok")), "alive") {
        println("FAIL html_bad_quote"); fail += 1
    }
    deep_b := buf_new(4096)
    mut di := 0
    while di < 200 { buf_push_str(deep_b, "<div>"); di += 1 }
    buf_push_str(deep_b, "<p id=\"leaf\">x</p>")
    di = 0
    while di < 200 { buf_push_str(deep_b, "</div>"); di += 1 }
    deep_html := buf_to_owned_str(move deep_b)
    t_deep := html_parse(deep_html) or return 3
    if dom_find_by_id(t_deep, "leaf") < 0 { println("FAIL html_deep"); fail += 1 }

    mut t_dyn := html_parse("<div id=\"a\">aaa</div><div id=\"b\">bbb</div>") or return 4
    ia := dom_find_by_id(t_dyn, "a")
    ib := dom_find_by_id(t_dyn, "b")
    dom_set_text(mut t_dyn, ia, "hello_world")
    dom_set_text(mut t_dyn, ib, "keep_me_intact")
    dom_set_text(mut t_dyn, ia, "")
    dom_compact_dyn_buf(mut t_dyn, 64)
    if not str_eq(dom_get_text(t_dyn, ia), "") or not str_eq(dom_get_text(t_dyn, ib), "keep_me_intact") {
        println("FAIL html_compact_uaf"); fail += 1
    }

    // 4. Hostile CSS & Tailwind: px clamp (-1000 sentinel collision), huge var(), backtracking selector bomb, 300x modifier bomb
    px_min := css_parse_px("-999999999rem")
    px_max := css_parse_px("999999999rem")
    if px_min != -999 or px_max != 100000 {
        println(f"FAIL css_px_clamp min={px_min} max={px_max}"); fail += 1
    }
    big_b := buf_new(4096)
    mut bi := 0
    while bi < 1500 { buf_push(big_b, 97); bi += 1 }
    big_val := buf_to_owned_str(move big_b)
    sh_var := css_parse_stylesheet(":root { --big: " + big_val + "; }")
    res_var := css_resolve_var(sh_var, "var(--big) var(--big) var(--big)")
    if str_len(res_var) <= 0 { println("FAIL css_var_big"); fail += 1 }

    // Exponential selector backtracking bomb on deep tree (`div * * * * * * * * * *`) must finish fast (<100ms!)
    sh_bomb := css_parse_stylesheet("div * * * * * * * * * * p { color: #ff0000; }")
    t_css0 := clock_ns()
    _ := css_compute_node_style(t_deep, dom_find_by_id(t_deep, "leaf"), sh_bomb)
    css_ms := (clock_ns() - t_css0) / 1000000
    if css_ms > 500 { println(f"FAIL css_backtrack_dos={css_ms}ms"); fail += 1 }

    // 300x Tailwind modifier recursion bomb must not stack-overflow
    tw_b := buf_new(2048)
    mut ti := 0
    while ti < 300 { buf_push_str(tw_b, "sm:"); ti += 1 }
    buf_push_str(tw_b, "p-4")
    tw_bomb := buf_to_owned_str(move tw_b)
    mut tw_st := style_default()
    tw_apply_token(mut tw_st, tw_bomb, 1280)

    // 5. Hostile JS Engine: unary neg, `!` precedence, `//` comments, `I64_MIN/-1`, nested infinite loop fuel, quoted member op
    mut t_js := html_parse("<div id=\"x\">orig</div>") or return 5
    mut st_js := js_state_new()
    js_eval_script(mut t_js, mut st_js, "let a = 2 * -3; let b = 5 - -3; let c = !0 == 2; let d = 1 // ; d = 999\n; let e = (-9223372036854775807 - 1) / -1;")
    va := js_state_get(st_js, "a", -999)
    vb := js_state_get(st_js, "b", -999)
    vc := js_state_get(st_js, "c", -999)
    vd := js_state_get(st_js, "d", -999)
    if va != -6 or vb != 8 or vc != 0 or vd != 1 {
        println(f"FAIL js_expr a={va} b={vb} c={vc} d={vd}"); fail += 1
    }
    t_js0 := clock_ns()
    js_eval_script(mut t_js, mut st_js, "let k = 0; while (1) { while (1) { k = k + 1; } }")
    js_ms := (clock_ns() - t_js0) / 1000000
    if js_ms > 500 { println(f"FAIL js_fuel_dos={js_ms}ms"); fail += 1 }
    js_eval_script(mut t_js, mut st_js, "#x.style.color = 'innerText = hacked'")
    if not str_eq(dom_get_text(t_js, dom_find_by_id(t_js, "x")), "orig") {
        println("FAIL js_member_anchor"); fail += 1
    }

    // 6. Hostile HTTP: request smuggling, Windows drive path, UNC path, TE/CL header injection, whitespace before colon
    if http_req_ok("GET / HTTP/1.1\nHost: a\n\r\nX-Smuggled: 1\n\n") { println("FAIL http_smuggle1"); fail += 1 }
    if http_req_ok("GET / HTTP/1.1\nHost: a\r\n\r\n") { println("FAIL http_smuggle2"); fail += 1 }
    if not http_req_ok("GET /ok HTTP/1.1\r\nHost: a\r\n\r\n") { println("FAIL http_valid_req"); fail += 1 }
    if http_is_safe_path("C:/Windows/win.ini") or http_is_safe_path("//evil/share") or http_is_safe_path("relative/path") or not http_is_safe_path("/api/v1/items") {
        println("FAIL http_safe_path"); fail += 1
    }
    if http_are_safe_extra_headers("Transfer-Encoding: chunked\r\n") or http_are_safe_extra_headers("Content-Length: 99\r\n") or not http_are_safe_extra_headers("X-App: ok\r\n") {
        println("FAIL http_extra_hdrs"); fail += 1
    }
    if http_hdr_ok("GET / HTTP/1.1\r\nHost : evil\r\n\r\n", "Host") {
        println("FAIL http_hdr_space_colon"); fail += 1
    }

    // 7. Hostile SQLite: empty SQL returns -205 (no NULL stmt handle) + >64KB text roundtrip (no 64KB truncation!)
    db := sqlite_open(":memory:") or return 6
    if sqlite_prep_rc(db, "") != -205 { println("FAIL sqlite_empty_sql"); fail += 1 }
    sqlite_exec(db, "CREATE TABLE t (s TEXT);")
    sb70 := buf_new(72000)
    mut si70 := 0
    while si70 < 70000 { buf_push(sb70, 65 + (si70 % 26)); si70 += 1 }
    big70 := buf_to_owned_str(move sb70)
    st_ins := sqlite_prepare(db, "INSERT INTO t(s) VALUES (?1);") or return 7
    sqlite_bind_text(st_ins, 1, big70)
    _ := sqlite_step(st_ins)
    sqlite_finalize(st_ins)
    st_sel := sqlite_prepare(db, "SELECT s FROM t;") or return 8
    _ := sqlite_step(st_sel)
    got70 := sqlite_col_text(st_sel, 0)
    sqlite_finalize(st_sel)
    sqlite_close(db)
    if str_len(got70) != 70000 or not str_eq(got70, big70) {
        println(f"FAIL sqlite_70k len={str_len(got70)}"); fail += 1
    }

    // 8. Hostile GUI float conversion: extreme i64 values (`1<<62`, `I64_MIN`) must terminate without hang/overflow
    f_huge := _p2d_f32(1 << 62)
    f_min := _p2d_f32(i64_min)
    if f_huge == 0 or f_min == 0 {
        println(f"FAIL gui_f32 huge={f_huge} min={f_min}"); fail += 1
    }

    if fail != 0 {
        println(f"[FAIL] 52_hostile_zero_trust_suite fails={fail}")
        return 1
    }
    println(f"[PASS] 52_hostile_zero_trust_suite: all 8 hostile categories exact (css_bomb={css_ms}ms js_fuel={js_ms}ms sqlite70k=70000)")
    return 0
}
