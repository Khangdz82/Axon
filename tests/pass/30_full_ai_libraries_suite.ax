// Axon Complete AI / ML Python Library Reimplementations Test Suite (`tests/pass/30_full_ai_libraries_suite.ax`)
// Tests:
//   1. NumPy (`std/numpy.ax`): NdArray, matmul, dot, reductions, 2x2 inv & det
//   2. PyTorch & Tinygrad (`std/torch.ax`): Autograd tape, Linear layer, MSE & CrossEntropy, AdamW & SGD
//   3. SafeTensors (`std/safetensors.ax`): Serialize, header parse, zero-copy offset search, extract
//   4. ONNX Runtime (`std/onnx.ax`): InferenceSession, MatMul, Relu, Softmax, LayerNorm pipeline
//   5. LLaMA.cpp (`std/llama.ax`): GGUF header parser, RoPE, RMSNorm, SwiGLU, KV cache, Top-P sampling
//   6. vLLM (`std/vllm.ax`): PagedAttention block table, O(1) recycling, prefix sharing, request append
//   7. Transformers (`std/transformers.ax`): CausalLM pipeline text generation
//   8. TikToken & Tokenizers (`std/tiktoken.ax`, `std/tokenizers.ax`): BPE encode, decode, attention mask
//   9. FAISS (`std/faiss.ax`): IndexFlatL2, IndexFlatIP, top-k nearest neighbors
//  10. Scikit-Learn (`std/sklearn.ax`): LinearRegression, LogisticRegression, KMeans, StandardScaler, Accuracy

use std::numpy
use std::torch
use std::safetensors
use std::onnx
use std::llama
use std::vllm
use std::transformers
use std::tiktoken
use std::tokenizers
use std::faiss
use std::sklearn
use std::os

@test
fn test_numpy_full_suite() {
    // 1. Creation & basic properties
    a := np_full(2, 2, 3.0)
    b := np_full(2, 2, 2.0)
    assert(a.rows == 2 and a.cols == 2 and a.size == 4, "np_full shape mismatch")

    // 2. Elementwise ops
    c_add := np_add(a, b)
    assert(np_get(c_add, 0, 0) == 5.0, "np_add failed")

    c_mul := np_multiply(a, b)
    assert(np_get(c_mul, 0, 0) == 6.0, "np_multiply failed")

    // 3. Matrix multiplication: [2x2] x [2x2]
    // [3, 3] x [2, 2] = [12, 12]
    // [3, 3]   [2, 2]   [12, 12]
    c_mm := np_matmul(a, b)
    assert(np_get(c_mm, 0, 0) == 12.0, "np_matmul failed")
    assert(np_get(c_mm, 1, 1) == 12.0, "np_matmul failed")

    // 4. Reductions & Stats
    total := np_sum(c_mm)
    assert(total == 48.0, "np_sum failed")
    mean_val := np_mean(c_mm)
    assert(mean_val == 12.0, "np_mean failed")

    // 5. 2x2 Determinant & Inversion
    // M = [4, 7]
    //     [2, 6] -> det = 4*6 - 7*2 = 24 - 14 = 10
    m := np_zeros(2, 2)
    np_set(m, 0, 0, 4.0)
    np_set(m, 0, 1, 7.0)
    np_set(m, 1, 0, 2.0)
    np_set(m, 1, 1, 6.0)
    det := np_linalg_det_2x2(m)
    assert(det >= 9.99 and det <= 10.01, "np_linalg_det_2x2 failed")

    m_inv := np_linalg_inv_2x2(m)
    // Inv * M = I -> inv[0, 0] = 6 / 10 = 0.6
    assert(np_get(m_inv, 0, 0) >= 0.59 and np_get(m_inv, 0, 0) <= 0.61, "np_linalg_inv_2x2 failed")

    np_free(move a)
    np_free(move b)
    np_free(move c_add)
    np_free(move c_mul)
    np_free(move c_mm)
    np_free(move m)
    np_free(move m_inv)
}

@test
fn test_torch_autograd_and_training() {
    // 1. Tensors & Autograd tape
    x := tensor_new(1, 2, true)
    np_set_1d(x.data, 0, 2.0)
    np_set_1d(x.data, 1, 3.0)

    lin := torch_linear_new(2, 1)
    np_set_1d(lin.weight.data, 0, 0.5)
    np_set_1d(lin.weight.data, 1, 1.5)
    np_set_1d(lin.bias.data, 0, 0.1)

    // Forward: y = 2.0*0.5 + 3.0*1.5 + 0.1 = 1.0 + 4.5 + 0.1 = 5.6
    y_pred := torch_linear_forward(lin, x)
    val := np_get_1d(y_pred.data, 0)
    assert(val >= 5.59 and val <= 5.61, "torch forward prediction failed")

    // Target = 5.0 -> Loss = (5.6 - 5.0)^2 = 0.36
    target := tensor_new(1, 1, false)
    np_set_1d(target.data, 0, 5.0)

    mut loss_t := tensor_new(1, 1, true)
    mse := nn_mse_loss(y_pred, target, mut loss_t)
    assert(mse >= 0.35 and mse <= 0.37, "nn_mse_loss failed")

    // Gradient check: dL/dy_pred = 2 * (5.6 - 5.0) = 1.2
    d_pred := ptr_read_f32(y_pred.grad.data_ptr, 0)
    assert(d_pred >= 1.19 and d_pred <= 1.21, "grad prediction failed")

    // Optimizer Step (SGD with momentum)
    opt := optim_sgd_new(2, 0.01, 0.9, 0.0)
    // mock gradient on weights
    ptr_write_f32(lin.weight.grad.data_ptr, 0, 0.5)
    ptr_write_f32(lin.weight.grad.data_ptr, 1, 0.5)
    optim_sgd_step(opt, lin.weight, 0)

    // Weight should be updated: 0.5 - 0.01*0.5 = 0.495
    new_w0 := np_get_1d(lin.weight.data, 0)
    assert(new_w0 >= 0.49 and new_w0 <= 0.50, "optim_sgd_step failed")

    mem_free_aligned(opt.velocity_ptr)
}

@test
fn test_safetensors_and_onnx() {
    // 1. SafeTensors serialization & parsing
    w := np_zeros(2, 2)
    np_set(w, 0, 0, 1.25)
    np_set(w, 0, 1, 2.5)
    np_set(w, 1, 0, 3.75)
    np_set(w, 1, 1, 5.0)

    serialized := safetensors_serialize("fc1.weight", w)
    assert(buf_len(serialized) > 16, "safetensors_serialize failed")

    st_file := safetensors_parse_buffer(serialized) or return
    assert(st_file.header_bytes_len > 0, "safetensors_parse_buffer failed")

    loaded_w := safetensors_get_tensor(st_file, "fc1.weight", 2, 2) or return
    assert(np_get(loaded_w, 0, 0) >= 1.24 and np_get(loaded_w, 0, 0) <= 1.26, "safetensors_get_tensor failed")
    assert(np_get(loaded_w, 1, 1) >= 4.99 and np_get(loaded_w, 1, 1) <= 5.01, "safetensors_get_tensor failed")

    np_free(move w)
    np_free(move loaded_w)
    safetensors_free(move st_file)
    buf_free(move serialized)

    // 2. ONNX Runtime Graph Execution
    mut sess := onnx_session_new(16)
    
    // Slot 0: Input X [1 x 2]
    // Slot 1: Weight W [2 x 2]
    // Slot 2: MatMul Output [1 x 2]
    // Slot 3: Relu Output [1 x 2]
    onnx_add_node(mut sess, onnx_op_matmul(), 0, 1, 2)
    onnx_add_node(mut sess, onnx_op_relu(), 2, 0, 3)

    x_in := np_zeros(1, 2)
    np_set(x_in, 0, 0, 1.0)
    np_set(x_in, 0, 1, -2.0)

    w_mat := np_zeros(2, 2)
    np_set(w_mat, 0, 0, 2.0)
    np_set(w_mat, 0, 1, 1.0)
    np_set(w_mat, 1, 0, 1.0)
    np_set(w_mat, 1, 1, 2.0)
    onnx_set_tensor_slot(sess, 1, w_mat)

    // X * W = [1, -2] * [[2, 1], [1, 2]] = [1*2 - 2*1, 1*1 - 2*2] = [0, -3]
    // ReLU([0, -3]) = [0, 0]
    out_onnx := onnx_session_run(mut sess, 0, x_in, 3)
    assert(np_get_1d(out_onnx, 0) == 0.0, "onnx output 0 failed")
    assert(np_get_1d(out_onnx, 1) == 0.0, "onnx output 1 failed")

    np_free(move x_in)
    np_free(move w_mat)
    onnx_session_free(move sess)
}

@test
fn test_llama_and_vllm() {
    // 1. LLaMA RMSNorm & SwiGLU
    dim := 4
    x_buf := mem_alloc_aligned(64)
    w_buf := mem_alloc_aligned(64)
    out_buf := mem_alloc_aligned(64)

    mut i := 0
    while i < dim {
        ptr_write_f32(x_buf, i, 2.0)
        ptr_write_f32(w_buf, i, 1.0)
        i += 1
    }

    llama_rmsnorm(x_buf, w_buf, out_buf, dim)
    // rms(2, 2, 2, 2) = 2.0 => x / rms = 1.0
    val_norm := ptr_read_f32(out_buf, 0)
    assert(val_norm >= 0.99 and val_norm <= 1.01, "llama_rmsnorm failed")

    // SwiGLU
    gate := mem_alloc_aligned(64)
    up := mem_alloc_aligned(64)
    swi_out := mem_alloc_aligned(64)
    ptr_write_f32(gate, 0, 0.0) // silu(0) = 0
    ptr_write_f32(up, 0, 5.0)
    llama_swiglu(gate, up, swi_out, 1)
    assert(ptr_read_f32(swi_out, 0) == 0.0, "llama_swiglu failed")

    mem_free_aligned(x_buf)
    mem_free_aligned(w_buf)
    mem_free_aligned(out_buf)
    mem_free_aligned(gate)
    mem_free_aligned(up)
    mem_free_aligned(swi_out)

    // 2. vLLM Block Allocator
    mut bt := vllm_block_table_new(8, 16, 64)
    b0 := vllm_alloc_block(mut bt)
    b1 := vllm_alloc_block(mut bt)
    assert(b0 >= 0 and b1 >= 0 and b0 != b1, "vllm_alloc_block failed")

    // Prefix sharing
    vllm_share_block(bt, b0)
    // Free first ref: refcount becomes 1, block NOT returned to free list yet
    vllm_free_block(mut bt, b0)
    assert(ptr_read_i64(bt.ref_counts_ptr, b0) == 1, "vllm_share_block refcount failed")

    // Free second ref: refcount becomes 0, block returned to free list
    vllm_free_block(mut bt, b0)
    assert(ptr_read_i64(bt.ref_counts_ptr, b0) == 0, "vllm_free_block recycling failed")

    if bt.pool_k_ptr != 0 { mem_free_aligned(bt.pool_k_ptr) }
    if bt.pool_v_ptr != 0 { mem_free_aligned(bt.pool_v_ptr) }
    if bt.ref_counts_ptr != 0 { mem_free_aligned(bt.ref_counts_ptr) }
    buf_free(move bt.free_list_buf)
}

@test
fn test_tiktoken_and_faiss() {
    // 1. TikToken BPE
    mut vocab := tiktoken_vocab_new(64)
    tiktoken_add_token(mut vocab, "hello", 100)
    tiktoken_add_token(mut vocab, "world", 101)

    r_hello := tiktoken_get_rank(vocab, tiktoken_hash_token("hello"))
    assert(r_hello == 100, "tiktoken_get_rank failed")

    toks := tiktoken_encode(vocab, "hello")
    assert(ibuf_len(toks) > 0, "tiktoken_encode failed")
    buf_free(move toks)

    tiktoken_vocab_free(move vocab)

    // 2. FAISS Vector Search
    mut index := faiss_index_flat_new(2, faiss_metric_l2(), 8)
    
    // Add vector 0: [1.0, 1.0]
    // Add vector 1: [5.0, 5.0]
    // Add vector 2: [1.1, 1.2]
    v_mem := mem_alloc_aligned(64)
    ptr_write_f32(v_mem, 0, 1.0); ptr_write_f32(v_mem, 1, 1.0)
    faiss_index_flat_add(mut index, v_mem)

    ptr_write_f32(v_mem, 0, 5.0); ptr_write_f32(v_mem, 1, 5.0)
    faiss_index_flat_add(mut index, v_mem)

    ptr_write_f32(v_mem, 0, 1.1); ptr_write_f32(v_mem, 1, 1.2)
    faiss_index_flat_add(mut index, v_mem)

    // Query: [1.0, 1.0]
    ptr_write_f32(v_mem, 0, 1.0); ptr_write_f32(v_mem, 1, 1.0)
    res := faiss_search_flat(index, v_mem, 2)
    
    // Closest match must be vector 0 (distance 0.0)
    nearest_idx := ibuf_get(res.indices, 0)
    assert(nearest_idx == 0, "faiss nearest neighbor failed")
    nearest_dist := np_get_1d(res.distances, 0)
    assert(nearest_dist == 0.0, "faiss nearest distance failed")

    mem_free_aligned(v_mem)
    buf_free(move res.indices)
    np_free(move res.distances)
    faiss_index_flat_free(move index)
}

@test
fn test_sklearn_suite() {
    // 1. Linear Regression
    // X = [[1], [2], [3], [4]], y = [2, 4, 6, 8] (y = 2*x)
    x := np_zeros(4, 1)
    y := np_zeros(4, 1)
    mut i := 0
    while i < 4 {
        val := (i + 1) as f64
        np_set_1d(x, i, val)
        np_set_1d(y, i, val * 2.0)
        i += 1
    }

    mut lr := sklearn_linear_regression_new(1)
    sklearn_linear_regression_fit(mut lr, x, y, 0.05, 300)

    // Check learned weight is close to 2.0
    w := np_get_1d(lr.weights, 0)
    assert(w >= 1.8 and w <= 2.2, "linear regression weight failed")

    // 2. StandardScaler
    scaler := sklearn_standard_scaler_fit(x)
    x_scaled := sklearn_standard_scaler_transform(scaler, x)
    scaled_mean := np_mean(x_scaled)
    assert(scaled_mean >= -0.01 and scaled_mean <= 0.01, "standard scaler mean failed")

    // 3. Accuracy Score
    y_t := np_zeros(4, 1)
    y_p := np_zeros(4, 1)
    np_set_1d(y_t, 0, 1.0); np_set_1d(y_p, 0, 1.0)
    np_set_1d(y_t, 1, 0.0); np_set_1d(y_p, 1, 0.0)
    np_set_1d(y_t, 2, 1.0); np_set_1d(y_p, 2, 1.0)
    np_set_1d(y_t, 3, 1.0); np_set_1d(y_p, 3, 0.0) // 1 error out of 4 => 75%
    acc := sklearn_accuracy_score(y_t, y_p)
    assert(acc >= 0.74 and acc <= 0.76, "accuracy score failed")

    np_free(move x)
    np_free(move y)
    np_free(move lr.weights)
    np_free(move scaler.mean)
    np_free(move scaler.std)
    np_free(move x_scaled)
    np_free(move y_t)
    np_free(move y_p)
}
