// Test M13: Cache-Oblivious Tiling & Non-Temporal Streaming Stores (VMOVNTPS / STNP)

struct BufferStats {
    tile_size_l1: i32,
    use_streaming: i32,
    bytes_transferred: i64,
}

fn compute_matrix_tiling(dim_size: i32, total_bytes: i64) -> BufferStats {
    let elem_size = 4; // f32
    let l1_cap = 32768 / elem_size; // 8192 floats
    
    let tile_size = if (dim_size * dim_size) <= l1_cap {
        dim_size
    } else {
        l1_cap / 4 // 2048 elements fits comfortably in L1
    };
    
    // Non-temporal store trigger: buffer >= 8 MB (8388608 bytes)
    let streaming = if total_bytes >= 8388608 { 1 } else { 0 };
    
    return BufferStats(tile_size, streaming, total_bytes);
}

fn main() -> i32 {
    // 16 MB working set: should trigger streaming store
    let large_run = compute_matrix_tiling(2048, 16777216);
    if large_run.use_streaming != 1 {
        return 1;
    }
    
    // 64 KB working set: should use L1 cache tiling
    let small_run = compute_matrix_tiling(128, 65536);
    if small_run.use_streaming != 0 or small_run.tile_size_l1 <= 0 {
        return 2;
    }
    
    return 0; // PASS
}
