use std::regex
use std::test_kit

fn main() -> i64 {
    s := suite_new("std-regex-suite")

    // Literal matching
    assert_true(s, regex_is_match("hello", "hello world"), "literal match found")
    assert_true(s, not regex_is_match("goodbye", "hello world"), "literal match not found")

    // Anchors
    assert_true(s, regex_is_match("^hello", "hello world"), "^ anchor match")
    assert_true(s, not regex_is_match("^world", "hello world"), "^ anchor fail")
    assert_true(s, regex_is_match("world$", "hello world"), "$ anchor match")
    assert_true(s, not regex_is_match("hello$", "hello world"), "$ anchor fail")

    // Character classes: \d, \w, \s
    assert_true(s, regex_is_match("\\d+", "order 12345 confirmed"), "\\d+ match")
    assert_true(s, not regex_is_match("^\\d+$", "abc"), "\\d+ fail on letters")
    assert_true(s, regex_is_match("^\\d+$", "98765"), "\\d+ full match")
    assert_true(s, regex_is_match("\\w+", "test_var_123"), "\\w+ match")

    // Wildcard .
    assert_true(s, regex_is_match("h.llo", "hello"), "wildcard match")
    assert_true(s, regex_is_match("h.llo", "hallo"), "wildcard match 2")

    // Range [a-z]
    assert_true(s, regex_is_match("[a-z]+", "123hello456"), "[a-z]+ match")
    assert_true(s, not regex_is_match("^[a-z]+$", "hello123world"), "[a-z]+ anchor fail")

    // Regex replace
    rep := regex_replace("\\d+", "Item 99 costs $10", "100")
    assert_eq_str(s, "Item 100 costs $10", rep, "regex_replace first match")

    return suite_finish(move s)
}
