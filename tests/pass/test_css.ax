use std::html
use std::css
use std::test_kit

fn main() -> i64 {
    s := suite_new("std-css-suite")

    html_code := "<div id=\"main\" class=\"card active\" style=\"margin: 10px;\">" +
                 "<button class=\"btn primary\">Save</button>" +
                 "</div>"

    tree := html_parse(html_code) or return 1

    css_code := ".card { background: #0f172a; width: 400px; height: 300px; border-radius: 12px; }" +
                ".btn { background: #3b82f6; color: #ffffff; border-radius: 8px; }" +
                ".primary { border-color: #2563eb; border-width: 2px; }"

    sheet := css_parse_stylesheet(css_code)
    assert_eq_i64(s, sheet.rule_count, 3, "parsed 3 CSS rules")

    // Node 0 is .card
    style0 := css_compute_node_style(tree, 0, sheet)
    assert_eq_i64(s, style0.width, 400, "card width 400px")
    assert_eq_i64(s, style0.height, 300, "card height 300px")
    assert_eq_i64(s, style0.border_radius, 12, "card border-radius 12px")
    assert_eq_i64(s, style0.margin_x, 20, "card inline margin_x 20px")
    assert_eq_i64(s, style0.bg_color, 0xFF0F172A, "card bg color #0f172a")

    // Node 1 is button (.btn.primary)
    style1 := css_compute_node_style(tree, 1, sheet)
    assert_eq_i64(s, style1.bg_color, 0xFF3B82F6, "btn bg color #3b82f6")
    assert_eq_i64(s, style1.border_radius, 8, "btn border-radius 8px")
    assert_eq_i64(s, style1.border_width, 2, "btn border-width 2px")

    return suite_finish(move s)
}
