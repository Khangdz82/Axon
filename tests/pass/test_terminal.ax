use std::terminal
use std::test_kit

fn main() -> i64 {
    s := suite_new("std-terminal-suite")

    b := term_bold("Hello")
    assert_true(s, str_len(b) > 5, "bold wraps escape codes")

    r := term_red("Error")
    assert_true(s, str_len(r) > 5, "red wraps escape codes")

    rgb := term_rgb(100, 150, 200, "Text")
    assert_true(s, str_len(rgb) > 4, "rgb wraps truecolor escape codes")

    pbar := term_progress_bar(50, 100, 10)
    assert_true(s, str_len(pbar) > 10, "progress bar generated")

    return suite_finish(move s)
}
