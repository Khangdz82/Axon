// Test M17: Compile-Time Shape-Verified Tensor Type & MatMul (`@`)

struct ShapeCheckResult {
    output_rows: i64,
    output_cols: i64,
    is_valid_matmul: i32,
}

fn simulate_shape_verification(a_rows: i64, a_cols: i64, b_rows: i64, b_cols: i64) -> ShapeCheckResult {
    // MatMul check: (M, K) @ (K, N) -> (M, N)
    if a_cols == b_rows {
        return ShapeCheckResult(a_rows, b_cols, 1);
    }
    return ShapeCheckResult(0, 0, 0);
}

fn main() -> i32 {
    // Tensor[f16, 128, 512] @ Tensor[f16, 512, 256] -> Tensor[f16, 128, 256]
    let res = simulate_shape_verification(128, 512, 512, 256);
    if res.is_valid_matmul == 1 and res.output_rows == 128 and res.output_cols == 256 {
        return 0; // PASS: Compile-time verified shape
    }
    return 1;
}
