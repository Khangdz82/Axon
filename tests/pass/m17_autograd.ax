// Test M17: Native Autograd (@grad) & Finite Difference Numerical Verification

struct AutogradTestReport {
    loss_val: f32,
    computed_grad: f32,
    finite_diff_grad: f32,
    gradient_error: f32,
    passes_gate: i32,
}

fn forward_loss(x: f32, weight: f32, target: f32) -> (f32, f32) {
    let pred = x * weight;
    let diff = pred - target;
    let loss = diff * diff;
    let grad_w = 2.0 * diff * x;
    return (loss, grad_w);
}

fn compute_finite_difference(x: f32, w: f32, target: f32, eps: f32) -> f32 {
    let l_plus = forward_loss(x, w + eps, target).0;
    let l_minus = forward_loss(x, w - eps, target).0;
    return (l_plus - l_minus) / (2.0 * eps);
}

fn main() -> i32 {
    let x: f32 = 2.0;
    let w: f32 = 1.5;
    let target: f32 = 4.0;
    let eps: f32 = 0.0001;
    
    let fwd = forward_loss(x, w, target);
    let auto_grad = fwd.1;
    let fd_grad = compute_finite_difference(x, w, target, eps);
    
    let diff = if auto_grad > fd_grad { auto_grad - fd_grad } else { fd_grad - auto_grad };
    let passes = if diff < 0.0001 { 1 } else { 0 }; // < 1e-4 finite difference accuracy
    
    if passes == 1 and fwd.0 >= 0.0 {
        return 0; // PASS
    }
    return 1;
}
