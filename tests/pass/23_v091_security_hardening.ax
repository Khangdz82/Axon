// Axon v1.0.0 Adversarial Security Hardening Verification
// Tests CWE-158 NUL-byte FS rejection, std/cap path hardening, dynamic f-str/to_json overflow fix,
// RFC-8259 escaping, global const shadowing guard, and NIST SHA-256 / HMAC-SHA256 / ct_eq_str.

use std::cap
use std::crypto
use std::str
use std::test_kit

comptime SHADOW_VAL := 100

fn main() -> i64 {
    s := suite_new("v0.9.1-security")

    // 1. CWE-158 NUL-byte path rejection in runtime `fs_read_file` & `fs_write_file`
    pbuf := buf_new(32)
    buf_push_str(pbuf, ".tmp_nul")
    buf_push(pbuf, 0)
    buf_push_str(pbuf, ".txt")
    nul_path := buf_to_owned_str(move pbuf)

    wdata := buf_new(16)
    buf_push_str(wdata, "secret")
    wr_rc := fs_write_file(nul_path, wdata) or -999
    buf_free(move wdata)
    assert_eq_i64(s, wr_rc, -999, "fs_write_file blocks embedded NUL path")

    rbuf := fs_read_file(nul_path) or buf_new(0)
    assert_eq_i64(s, buf_len(rbuf), 0, "fs_read_file blocks embedded NUL path")
    buf_free(move rbuf)

    // 2. std/cap path traversal, control byte, and Win32 trailing dot/space sanitization
    assert_true(s, is_safe_subpath("models/weights_v1.bin"), "cap allow safe subpath")
    assert_true(s, not is_safe_subpath("../escape.txt"), "cap block ..")
    assert_true(s, not is_safe_subpath("/abs/path"), "cap block leading /")
    assert_true(s, not is_safe_subpath("C:drive.txt"), "cap block colon :")
    assert_true(s, not is_safe_subpath("evil."), "cap block trailing dot")
    assert_true(s, not is_safe_subpath("evil "), "cap block trailing space")

    // 3. Dynamic f"..." buffer (>4KB) & RFC-8259 to_json escaping (previously overflowed 1024B static buf)
    big := str_repeat("X", 4500)
    msg := f"hdr:{big}:end"
    assert_eq_i64(s, str_len(msg), 4508, "dynamic f-string >4KB")

    js := to_json("a\"b\\c\nd")
    assert_eq_str(s, js, "\"a\\\"b\\\\c\\nd\"", "to_json RFC-8259 escape")

    // 4. Local variable shadowing global constant in condition & compound assign
    mut SHADOW_VAL := 5
    mut shadow_ok := true
    if SHADOW_VAL == 100 {
        shadow_ok = false
    }
    SHADOW_VAL += 1
    assert_true(s, shadow_ok and SHADOW_VAL == 6, "local var shadows global let cleanly")

    // 5. NIST FIPS 180-4 SHA-256 + RFC 2104 HMAC-SHA256 + constant-time slice equality
    assert_eq_str(s, sha256_str(""), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "sha256 empty vector")
    assert_eq_str(s, sha256_str("abc"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "sha256 abc vector")
    assert_eq_str(s, hmac_sha256_str("key", "The quick brown fox jumps over the lazy dog"), "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8", "hmac_sha256 RFC vector")

    assert_true(s, ct_eq_str("token_xyz_123", "token_xyz_123"), "ct_eq_str match")
    assert_true(s, not ct_eq_str("token_xyz_123", "token_xyz_124"), "ct_eq_str diff")
    assert_true(s, not ct_eq_str("short", "shorter"), "ct_eq_str len diff")

    return suite_finish(move s)
}
