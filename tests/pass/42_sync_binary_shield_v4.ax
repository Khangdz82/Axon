// Test 42: std::sync (AtomicI64, SpinLock, RwLock, WaitGroup, MpmcChan), std::binary, and Shield v4 MBA
use std::sync
use std::binary

@shield
fn protected_calc(x: i64) -> i64 {
    return (x * 7 + 13) ^ 0x5A5A
}

@shield
fn main() -> i32 {
    // 1. Shield v4 MBA integrity + anti_debug_check
    if anti_debug_check() { return 1 }
    if protected_calc(10) != ((10 * 7 + 13) ^ 0x5A5A) { return 2 }

    // 2. AtomicI64 + LOCK CMPXCHG
    a := atomic_i64_new(100)
    if atomic_i64_load(a) != 100 { return 3 }
    _ := atomic_i64_add(a, 25)
    if atomic_i64_load(a) != 125 { return 4 }
    if not atomic_i64_cas(a, 125, 200) { return 5 }
    if atomic_i64_cas(a, 125, 999) { return 6 }
    if atomic_i64_load(a) != 200 { return 7 }
    atomic_i64_free(move a)

    // 3. SpinLock + RwLock + WaitGroup
    lk := spinlock_new()
    if not spinlock_try_lock(lk) { return 8 }
    if spinlock_try_lock(lk) { return 9 }
    spinlock_unlock(lk)
    spinlock_lock(lk)
    spinlock_unlock(lk)
    spinlock_free(move lk)

    rw := rwlock_new()
    rwlock_read_lock(rw)
    rwlock_read_lock(rw)
    rwlock_read_unlock(rw)
    rwlock_read_unlock(rw)
    rwlock_write_lock(rw)
    rwlock_write_unlock(rw)
    rwlock_free(move rw)

    wg := wg_new()
    wg_add(wg, 2)
    wg_done(wg)
    wg_done(wg)
    wg_wait(wg)
    if wg_count(wg) != 0 { return 10 }
    wg_free(move wg)

    // 4. MpmcChan (Go-style bounded channel)
    ch := chan_new(4)
    if not chan_try_send(ch, 11) { return 11 }
    if not chan_try_send(ch, 22) { return 12 }
    if not chan_try_send(ch, 33) { return 13 }
    if not chan_try_send(ch, 44) { return 14 }
    if chan_try_send(ch, 55) { return 15 } // full!
    v1 := chan_try_recv(ch) or return 16
    v2 := chan_try_recv(ch) or return 17
    if v1 != 11 or v2 != 22 or chan_len(ch) != 2 { return 18 }
    chan_close(ch)
    if not chan_is_closed(ch) { return 19 }
    if chan_try_send(ch, 66) { return 20 }
    chan_free(move ch)

    // 5. std::binary (LE/BE packed packet codec)
    pkt := buf_new(128)
    bw_u8(pkt, 0xAB)
    bw_u16_le(pkt, 0x1234)
    bw_u16_be(pkt, 0x5678)
    bw_u32_le(pkt, 0xDEADBEEF)
    bw_u32_be(pkt, 0xCAFEBABE)
    bw_u64_le(pkt, 0x0123456789ABCDEF)
    bw_str_u16_le(pkt, "AXON")

    b0 := br_u8(pkt, 0) or return 21
    u16l := br_u16_le(pkt, 1) or return 22
    u16b := br_u16_be(pkt, 3) or return 23
    u32l := br_u32_le(pkt, 5) or return 24
    u32b := br_u32_be(pkt, 9) or return 25
    u64l := br_u64_le(pkt, 13) or return 26
    s := br_str_u16_le(pkt, 21) or return 27
    if b0 != 0xAB or u16l != 0x1234 or u16b != 0x5678 { return 28 }
    if u32l != 0xDEADBEEF or u32b != 0xCAFEBABE or u64l != 0x0123456789ABCDEF { return 29 }
    if s != "AXON" { return 30 }
    buf_free(move pkt)

    println("  [42] Shield v4 MBA + std::sync (CAS/SpinLock/RwLock/WG/Chan) + std::binary verified!")
    return 0
}
