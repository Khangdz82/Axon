// Test M10: Zero-Cost Error Union (T ! Error) & Dual-Register Return
struct IoResult {
    bytes_read: i32,
    err_code: i32, // 0: Success, >0: Error code
}

fn try_read_stream(fd: i32, should_fail: i32) -> IoResult {
    // Returns value in RAX, error in RDX
    if should_fail == 1 {
        return IoResult(0, 404); // Error: Not found
    }
    return IoResult(1024, 0); // OK: 1024 bytes read
}

fn process_pipeline() -> i32 {
    let res1 = try_read_stream(3, 0);
    // Lowered try statement: check RDX directly without exception unwinding
    if res1.err_code != 0 {
        return res1.err_code;
    }

    let res2 = try_read_stream(4, 1);
    if res2.err_code != 0 {
        // Handled via catch logic
        return 0; // Caught expected error code
    }
    return 1;
}

fn main() -> i32 {
    let code = process_pipeline();
    return code; // Returns 0 on success
}
