// Test 37: Deep Security Hardening Regression Suite (CWE-190 / CWE-787 / CWE-113 / CWE-208 / CWE-295)
use std::os
use std::ring_bridge
use std::mem_guard
use std::ui_render
use std::tls
use std::shield
use std::game2d
use std::grpc
use std::postgres
use std::ffi

@test
fn test_ring0_overflow_and_forged_index_blocked() {
    b := ring_bridge_new(16)
    cqe := ibuf_new(4)
    ibuf_push(cqe, 0); ibuf_push(cqe, 0); ibuf_push(cqe, 0); ibuf_push(cqe, 0)

    // Attempt 1: RING_OP_MMIO_READ64 integer wraparound `(a1 + 1) * 8 == 0`
    assert(ring3_submit_sqe(b, ring_op_mmio_read64(), 101, 0x10000, 0x1FFFFFFFFFFFFFFF))
    // Attempt 2: RING_OP_DMA_SUM_I64 integer wraparound `a1 * 8 == 0`
    assert(ring3_submit_sqe(b, ring_op_dma_sum_i64(), 102, 0x10000, 0x2000000000000000))
    // Attempt 3: RING_OP_DMA_SUM_I64 Ring-0 DoS oversized count
    assert(ring3_submit_sqe(b, ring_op_dma_sum_i64(), 103, 0x10000, 50000000))

    assert(ring0_process_batch(b, 8) == 3)
    assert(ring3_reap_cqe(b, cqe))
    assert(ibuf_get(cqe, 0) == 101 and ibuf_get(cqe, 1) == -14)
    assert(ring3_reap_cqe(b, cqe))
    assert(ibuf_get(cqe, 0) == 102 and ibuf_get(cqe, 1) == -14)
    assert(ring3_reap_cqe(b, cqe))
    assert(ibuf_get(cqe, 0) == 103 and ibuf_get(cqe, 1) == -14)

    buf_free(move cqe)
    ring_bridge_free(move b)
}

@test
fn test_mem_guard_canvas_particles_overflow_blocked() {
    // ObjectPool multiplication overflow rejected cleanly
    bad_pool := obj_pool_new(1048576, 1048576)
    assert(bad_pool.slab_ptr == 0 and obj_pool_acquire(bad_pool) == -1)
    obj_pool_free(move bad_pool)

    // FrameArena huge cap & alloc overflow rejected cleanly
    bad_arena := frame_arena_new(0x7FFFFFFFFFFFFF00)
    assert(bad_arena.base_ptr == 0)
    frame_arena_free(move bad_arena)

    good_arena := frame_arena_new(4096)
    assert(frame_arena_alloc(good_arena, 0x7FFFFFFFFFFFFF00) == 0)
    assert(frame_arena_alloc(good_arena, -64) == 0)
    frame_arena_free(move good_arena)

    // Canvas integer overflow rejected cleanly
    bad_canv := canvas_new(100000, 100000)
    assert(bad_canv.width == 0 and bad_canv.height == 0)
    canvas_free(move bad_canv)

    // ParticlePool2D huge cap rejected cleanly
    bad_pp := g2_particles_new(100000000)
    assert(bad_pp.cap == 0 and bad_pp.data_ptr == 0)
    g2_particles_free(move bad_pp)
}

@test
fn test_tls_crlf_injection_and_port_validation() {
    r_port := https_request("GET", "example.com", 70000, "/") or HttpsResponse(status = -999, body = "")
    assert(r_port.status == -999)

    r_crlf_path := https_request("GET", "example.com", 443, "/ok\r\nX-Injected: evil") or HttpsResponse(status = -998, body = "")
    assert(r_crlf_path.status == -998)

    r_crlf_hdr := https_request("GET", "example.com", 443, "/", "X-Test: 1\r\n\r\nGET /evil HTTP/1.1") or HttpsResponse(status = -997, body = "")
    assert(r_crlf_hdr.status == -997)
    r_lf_hdr := https_request("GET", "example.com", 443, "/", "X-Test: 1\nX-Evil: 2") or HttpsResponse(status = -996, body = "")
    assert(r_lf_hdr.status == -996)
    r_nocolon_hdr := https_request("GET", "example.com", 443, "/", "X-Test: 1\r\nBadLineWithoutColon") or HttpsResponse(status = -995, body = "")
    assert(r_nocolon_hdr.status == -995)

    assert(not tls_is_safe_http_token("bad\r\nhost"))
    assert(tls_is_safe_http_token("api.example.com"))
}

@test
fn test_shield_mesh_constant_scan_and_cap() {
    unsafe {
    m := shield_mesh_new(99999999, 0x123456789ABCDEF0)
    assert(m.cap == 65536)
    buf := mem_alloc_aligned(64)
    ptr_write_i64(buf, 0, 42)
    ptr_write_i64(buf, 1, 99)
    mut mm := m
    idx0 := shield_mesh_register(mut mm, buf, 2)
    assert(idx0 == 0)
    assert(shield_mesh_verify_all(mm) == -1)
    ptr_write_i64(buf, 1, 100) // simulate tamper
    assert(shield_mesh_verify_all(mm) == 0)
    mem_free_aligned(buf)
    shield_mesh_free(move mm)
    }
}

@test
fn test_grpc_postgres_ffi_hardening() {
    // 1. gRPC Protobuf negative varint length-delimited field must not infinite-loop or trap
    bad_pb := buf_new(32)
    pb_write_varint(bad_pb, (1 << 3) | 2) // field 1, wire type 2 (len-delimited)
    pb_write_varint(bad_pb, -1)           // negative length -1
    parsed := pb_decode(bad_pb)
    assert(ibuf_len(parsed.fnums) == 0)
    buf_free(move bad_pb)
    buf_free(move parsed.fnums); buf_free(move parsed.wtypes); buf_free(move parsed.ivals)
    buf_free(move parsed.soffs); buf_free(move parsed.slens); buf_free(move parsed.raw)

    // 2. PostgreSQL startup message with long user/db names must not trap on 128B fixed buffer
    long_u := "user_0123456789_0123456789_0123456789_0123456789_0123456789"
    long_d := "db_0123456789_0123456789_0123456789_0123456789_0123456789"
    st := pg_encode_startup(long_u, long_d)
    assert(buf_len(st) > 128)
    buf_free(move st)

    // 3. FFI negative/overflow sizes rejected safely without trapping
    assert(ffi_alloc(0x7FFFFFFFFFFFFFF0) == 0)
    empty_b := ffi_read_bytes(0, -100)
    assert(buf_len(empty_b) == 0)
    buf_free(move empty_b)
}
