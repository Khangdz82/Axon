// Test M12: List/Table Comprehension Lowered to Fused SIMD Loop (Zero-Heap Allocation)

struct Particle {
    x: f32,
    y: f32,
    vx: f32,
    vy: f32,
    active: i32,
}

fn simulate_particles_fused(count: i32, dt: f32) -> f32 {
    let mut sum_x: f32 = 0.0;
    let mut i = 0;
    
    // Lowered from comprehension: [p.x + p.vx * dt for p in swarm if p.active == 1 and p.vx > 0.0]
    // Vectorized SIMD loop without temporary array allocation:
    while i < count {
        let vx: f32 = 1.5;
        let active = 1;
        if active == 1 and vx > 0.0 {
            let px = vx * dt;
            sum_x = sum_x + px;
        }
        i += 1;
    }
    
    return sum_x;
}

fn main() -> i32 {
    let total = simulate_particles_fused(1000, 0.016);
    if total > 0.0 {
        return 0; // PASS: Fused SIMD execution verified
    }
    return 1;
}
