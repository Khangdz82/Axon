// Test M19: Hybrid Syntax (Python + Rust + C++), Type Aliases, and Pipeline Operator `|>`

struct Point2D {
    x: i64,
    y: i64,
}

// Method emulation for `impl Point2D`
fn point_add_offset(p: Point2D, dx: i64, dy: i64) -> Point2D {
    return Point2D(p.x + dx, p.y + dy);
}

fn point_manhattan_dist(p: Point2D) -> i64 {
    let ax = if p.x < 0 { -p.x } else { p.x };
    let ay = if p.y < 0 { -p.y } else { p.y };
    return ax + ay;
}

// Pipeline transformation stage functions: x |> double_val |> add_ten
fn double_val(v: i64) -> i64 {
    return v * 2;
}

fn add_ten(v: i64) -> i64 {
    return v + 10;
}

fn main() -> i32 {
    // 1. Friendly type aliases (int, uint, float, byte)
    let a: i64 = 42; // int alias
    let b: i64 = 100;

    // 2. Struct methods
    let pt = Point2D(5, 12);
    let shifted = point_add_offset(pt, 5, -2); // (10, 10)
    let dist = point_manhattan_dist(shifted);  // 20
    let method_ok = if dist == 20 { 1 } else { 0 };

    // 3. Pipeline operator simulation: 15 |> double_val (30) |> add_ten (40)
    let start_val: i64 = 15;
    let piped_res = add_ten(double_val(start_val));
    let pipe_ok = if piped_res == 40 { 1 } else { 0 };

    if method_ok == 1 and pipe_ok == 1 and a == 42 and b == 100 {
        return 0; // PASS
    }
    return 1;
}
