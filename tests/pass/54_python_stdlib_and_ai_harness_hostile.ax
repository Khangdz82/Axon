fn test_ffi_secrets_crypto() -> i64 {
    mut fails := 0

    // 1. True UTF-8 <-> UTF-16LE roundtrip (ASCII + Vietnamese 3-byte + Emoji 4-byte surrogate pairs!)
    u_src := "Axon Tiếng Việt chuẩn 100% 🚀🔥"
    wp := ffi_wstr(u_src)
    if wp == 0 { println("FAIL ffi_wstr alloc"); fails += 1 }
    else {
        back := ffi_read_wstr(wp, 1024)
        ffi_free(wp)
        if not str_eq(back, u_src) { println(f"FAIL ffi_wstr roundtrip got={back}"); fails += 1 }
    }
    // Negative offset & NUL guard
    if ffi_read_u8(12345, -1) != 0 or ffi_open_one("") != 0 { println("FAIL ffi guards"); fails += 1 }

    // 2. OS CSPRNG (`std::secrets`)
    t1 := secrets_token_hex(32) or ""
    t2 := secrets_token_hex(32) or ""
    if str_len(t1) != 64 or str_len(t2) != 64 or str_eq(t1, t2) {
        println("FAIL secrets_token_hex"); fails += 1
    }
    tu := secrets_token_urlsafe(24) or ""
    if str_len(tu) != 32 { println(f"FAIL secrets_token_urlsafe len={str_len(tu)}"); fails += 1 }
    rb_bad := secrets_randbelow(0) or -99
    if rb_bad != -99 { println("FAIL secrets_randbelow(0)"); fails += 1 }
    mut ri := 0
    while ri < 20 {
        rv := secrets_randbelow(7) or -1
        if rv < 0 or rv >= 7 { println(f"FAIL secrets_randbelow range={rv}"); fails += 1 }
        ri += 1
    }
    if not secrets_compare_digest(t1, t1) or secrets_compare_digest(t1, t2) {
        println("FAIL secrets_compare_digest"); fails += 1
    }

    // 3. Streaming SHA-256 vs NIST vectors + HMAC-SHA256 constant-time verify
    mut sc0 := sha256_ctx_new()
    h_empty := sha256_ctx_finish_hex(mut sc0)
    sha256_ctx_free(move sc0)
    if not str_eq(h_empty, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") {
        println(f"FAIL sha256 empty={h_empty}"); fails += 1
    }
    mut sc1 := sha256_ctx_new()
    sha256_ctx_update_str(mut sc1, "a")
    sha256_ctx_update_str(mut sc1, "b")
    sha256_ctx_update_str(mut sc1, "c")
    h_abc := sha256_ctx_finish_hex(mut sc1)
    sha256_ctx_free(move sc1)
    if not str_eq(h_abc, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") {
        println(f"FAIL sha256 abc={h_abc}"); fails += 1
    }
    // Chunk across 64-byte block boundary
    long_s := str_repeat("AxonZeroTrust!", 10) // 140 bytes
    mut sc2 := sha256_ctx_new()
    sha256_ctx_update_str(mut sc2, str_slice(long_s, 0, 63))
    sha256_ctx_update_str(mut sc2, str_slice(long_s, 63, 65))
    sha256_ctx_update_str(mut sc2, str_slice(long_s, 65, 140))
    h_stream := sha256_ctx_finish_hex(mut sc2)
    sha256_ctx_free(move sc2)
    if not str_eq(h_stream, sha256_str(long_s)) {
        println("FAIL sha256 streaming mismatch"); fails += 1
    }
    mac := hmac_sha256_str("secret-key", "payload")
    if not hmac_sha256_verify("secret-key", "payload", mac) or hmac_sha256_verify("secret-key", "tampered", mac) {
        println("FAIL hmac_sha256_verify"); fails += 1
    }
    return fails
}

fn test_json_dom_hostile() -> i64 {
    mut fails := 0

    // 1. json_get_str RFC-8259 unescape (`\"`, `\\`, `\n`, `\t`, `\u0041`, surrogate pair `\uD83D\uDE80` -> 🚀)
    esc_doc := "{\"msg\":\"hi\\n\\\"axon\\\"\\t\\\\\\u0041\\uD83D\\uDE80\"}"
    got_msg := json_get_str(esc_doc, "msg") or ""
    if not str_eq(got_msg, "hi\n\"axon\"\t\\A🚀") {
        println(f"FAIL json_get_str unescape got=[{got_msg}]"); fails += 1
    }

    // 2. Full DOM + JSON Pointer + Canonical sort_keys + Indent roundtrip
    sample := "{\"z\":-9223372036854775808,\"a\":[true,false,null,{\"k/1\":\"v~1\",\"n\":3.14}]}"
    doc := jdoc_parse(sample) or return fails + 1
    if jdoc_as_i64(doc, jdoc_obj_get(doc, doc.root, "z"), 0) != (1 << 63) {
        println("FAIL jdoc INT64_MIN"); fails += 1
    }
    p_v := jdoc_path(doc, "/a/3/k~11")
    if not str_eq(jdoc_as_str(doc, p_v, ""), "v~1") {
        println("FAIL jdoc_path RFC-6901"); fails += 1
    }
    if not jdoc_is_null(doc, jdoc_path(doc, "/a/2")) or jdoc_as_bool(doc, jdoc_path(doc, "/a/0"), false) != true {
        println("FAIL jdoc bool/null"); fails += 1
    }
    c1 := jdoc_stringify(doc, -1, true, 0)
    pretty := jdoc_stringify(doc, -1, true, 2)
    jdoc_free(move doc)

    // Canonical equivalence regardless of key order & whitespace
    c2 := json_canonicalize("{ \"a\" : [ true, false, null, { \"n\": 3.14, \"k/1\": \"v~1\" } ], \"z\": -9223372036854775808 }") or ""
    c3 := json_canonicalize(pretty) or ""
    if not str_eq(c1, c2) or not str_eq(c1, c3) {
        println(f"FAIL json_canonicalize c1={c1} c2={c2}"); fails += 1
    }

    // 3. Hostile malformed JSON rejections
    bad1 := json_canonicalize("{\"a\":01}") or "REJECTED"
    bad2 := json_canonicalize("{\"a\":1,}") or "REJECTED"
    bad3 := json_canonicalize("{\"a\":1} trailing") or "REJECTED"
    bad4 := json_canonicalize("{\"a\":\"raw\nnewline\"}") or "REJECTED"
    if not str_eq(bad1, "REJECTED") or not str_eq(bad2, "REJECTED") or not str_eq(bad3, "REJECTED") or not str_eq(bad4, "REJECTED") {
        println("FAIL json hostile syntax not rejected"); fails += 1
    }
    // 150-deep nesting DoS must return err(413) cleanly without stack overflow
    deep_j := str_repeat("[", 150) + "1" + str_repeat("]", 150)
    bad_deep := json_canonicalize(deep_j) or "DEPTH_BLOCKED"
    if not str_eq(bad_deep, "DEPTH_BLOCKED") { println("FAIL json depth DoS"); fails += 1 }
    return fails
}

fn test_regex_hostile() -> i64 {
    mut fails := 0

    // 1. Escape bug regression: \n, \r, \t match actual control chars (NOT 'n', 'r', 't'!)
    if not regex_is_match("\\n", "a\nb") or regex_is_match("\\n", "anb") {
        println("FAIL regex \\n escape"); fails += 1
    }
    if not regex_is_match("\\t", "a\tb") or regex_is_match("\\t", "atb") {
        println("FAIL regex \\t escape"); fails += 1
    }

    // 2. Bracket leading ']', word boundaries \b, case-insensitive (?i), {m,n}, groups (?:...)
    if not regex_is_match("^[]a]+$", "]a]]a") { println("FAIL regex []a]"); fails += 1 }
    if not regex_is_match("\\bfn\\b", "pub fn main()") or regex_is_match("\\bfn\\b", "define_fn") {
        println("FAIL regex \\b word boundary"); fails += 1
    }
    if not regex_is_match("(?i)axon_v2", "Hello AXON_V2!") { println("FAIL regex (?i)"); fails += 1 }
    if not regex_is_match("^\\d{4}-\\d{2}-\\d{2}$", "2026-11-24") or regex_is_match("^\\d{4}-\\d{2}-\\d{2}$", "26-11-24") {
        println("FAIL regex {m,n}"); fails += 1
    }
    if not regex_is_match("^(?:foo|bar)+$", "foobarfoo") or regex_is_match("^(?:foo|bar)+$", "foobaz") {
        println("FAIL regex group (?:a|b)+"); fails += 1
    }

    // 3. find_all, replace_all, split, escape
    all := regex_find_all("\\d+", "a12 b345 c6", 10)
    if ibuf_len(all) != 6 { println(f"FAIL regex_find_all len={ibuf_len(all)}"); fails += 1 }
    buf_free(move all)

    sub := regex_replace_all("\\d+", "x=10, y=20", "#")
    if not str_eq(sub, "x=#, y=#") { println(f"FAIL regex_replace_all={sub}"); fails += 1 }

    sp := regex_split("[,;]+\\s*", "a, b;;c,d")
    if svec_len(sp) != 4 or not str_eq(svec_get(sp, 2), "c") { println("FAIL regex_split"); fails += 1 }
    svec_free(move sp)

    esc := regex_escape("a.b[0]+(c)?")
    if not regex_is_match("^" + esc + "$", "a.b[0]+(c)?") or regex_is_match("^" + esc + "$", "axb0c") {
        println("FAIL regex_escape"); fails += 1
    }

    // 4. ReDoS fuel guard: catastrophic `(a+)+b` must finish fast (<200ms)
    t0 := clock_ns()
    if regex_is_match("(a+)+b", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaX") { println("FAIL redos false match"); fails += 1 }
    ms := (clock_ns() - t0) / 1000000
    if ms > 300 { println(f"FAIL redos too slow ms={ms}"); fails += 1 }
    return fails
}

fn test_path_glob_shutil_difflib() -> i64 {
    mut fails := 0

    // 1. Windows reserved device trailing-space bypass closed (CWE-22 / DOS device)
    if str_eq(path_join_safe("ws", "CON .txt") or "BLOCKED", "BLOCKED") == false { println("FAIL path CON .txt"); fails += 1 }
    if str_eq(path_join_safe("ws", "NUL   .ax") or "BLOCKED", "BLOCKED") == false { println("FAIL path NUL .ax"); fails += 1 }
    if str_eq(path_join_safe("ws", "COM1 .log") or "BLOCKED", "BLOCKED") == false { println("FAIL path COM1 .log"); fails += 1 }
    if not path_is_subpath("/a/b", "/a/b/c") or path_is_subpath("/a/b", "/a/bc") { println("FAIL path_is_subpath"); fails += 1 }

    // 2. Non-backtracking fnmatch & glob_match + ReDoS killer
    if not fnmatch("test_01.ax", "test_[0-9]?.ax", false) or fnmatch("test_a1.ax", "test_[0-9]?.ax", false) {
        println("FAIL fnmatch"); fails += 1
    }
    if not glob_match("src/sub/deep/foo.ax", "**/*.ax", false) or not glob_match("foo.ax", "**/*.ax", false) {
        println("FAIL glob_match **"); fails += 1
    }
    t0 := clock_ns()
    if fnmatch("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaX", "*a*a*a*a*a*a*a*a*a*a*b", false) {
        println("FAIL fnmatch redos match"); fails += 1
    }
    if (clock_ns() - t0) / 1000000 > 50 { println("FAIL fnmatch redos slow"); fails += 1 }

    // 3. Safety guard: shutil_rmtree refuses root paths
    if shutil_rmtree("/") or shutil_rmtree("C:/") or shutil_rmtree(".") {
        println("FAIL shutil_rmtree root guard"); fails += 1
    }

    // 4. Real temp dir UTF-16LE FS + stat + sha256_file + copytree + glob + tree + rmtree
    tok := secrets_token_hex(6) or "fallback"
    tmp_root := path_join(fs_temp_dir(), f"axon_h54_{sys_pid()}_{tok}")
    sub_dir := path_join(tmp_root, "src")
    if not shutil_mkdir_all(sub_dir) { println("FAIL shutil_mkdir_all"); return fails + 1 }

    uni_file := path_join(sub_dir, "tiếng_việt.ax")
    if not shutil_atomic_write(uni_file, "fn hello() {\n    println(\"ok\")\n}\n") {
        println("FAIL shutil_atomic_write utf16"); fails += 1
    }
    st := shutil_stat(uni_file)
    if not st.exists or not st.is_file or st.size != 33 {
        println(f"FAIL shutil_stat size={st.size}"); fails += 1
    }
    fh := shutil_sha256_file(uni_file) or ""
    if not str_eq(fh, sha256_str("fn hello() {\n    println(\"ok\")\n}\n")) {
        println("FAIL shutil_sha256_file"); fails += 1
    }

    dst_tree := path_join(tmp_root, "backup")
    if not shutil_copytree(sub_dir, dst_tree) { println("FAIL shutil_copytree"); fails += 1 }
    found_ax := glob_find("**/*.ax", tmp_root, false, 100)
    if svec_len(found_ax) != 2 { println(f"FAIL glob_find count={svec_len(found_ax)}"); fails += 1 }
    svec_free(move found_ax)

    tr := glob_tree(tmp_root, 3, false, 50)
    if not str_contains(tr, "tiếng_việt.ax") { println("FAIL glob_tree utf16"); fails += 1 }

    if not shutil_rmtree(tmp_root) or shutil_stat(tmp_root).exists {
        println("FAIL shutil_rmtree cleanup"); fails += 1
    }

    // 5. Difflib unified diff, stats, similarity
    d := diff_unified("line1\nold\nline3\n", "line1\nnew1\nnew2\nline3\n", "a/f.ax", "b/f.ax", 2)
    if not str_contains(d, "--- a/f.ax") or not str_contains(d, "-old") or not str_contains(d, "+new1") or not str_contains(d, "+new2") {
        println(f"FAIL diff_unified:\n{d}"); fails += 1
    }
    (da, dr) := diff_stats("line1\nold\nline3\n", "line1\nnew1\nnew2\nline3\n")
    if da != 2 or dr != 1 { println(f"FAIL diff_stats a={da} r={dr}"); fails += 1 }
    if diff_similarity_pct("a\nb\nc", "a\nb\nc") != 100 or str_len(diff_unified("same", "same")) != 0 {
        println("FAIL diff identical"); fails += 1
    }
    return fails
}

fn test_net_fetch_subprocess() -> i64 {
    mut fails := 0

    // 1. Ephemeral port 0 resolution via getsockname
    ln := tcp_listen("127.0.0.1", 0, 8) or return fails + 1
    if ln.port <= 0 or ln.port > 65535 {
        println(f"FAIL tcp_listen(0) port={ln.port}"); fails += 1
    }
    tcp_listener_close(ln)

    // 2. Fetch SSRF fail-closed default + CRLF block + urlencode + SSE parser
    r_ssrf1 := fetch_get("http://127.0.0.1:80/", "", 2000, false) or FetchResponse(ok_flag = false, status = -403, final_url = "", headers_raw = "", body = "", duration_us = 0)
    r_ssrf2 := fetch_get("http://169.254.169.254/latest/meta-data", "", 2000, false) or FetchResponse(ok_flag = false, status = -403, final_url = "", headers_raw = "", body = "", duration_us = 0)
    r_crlf  := fetch_get("https://example.com/", "X-Ok: 1\r\n\r\nINJECTED", 2000, false) or FetchResponse(ok_flag = false, status = -400, final_url = "", headers_raw = "", body = "", duration_us = 0)
    if r_ssrf1.status != -403 or r_ssrf2.status != -403 or r_crlf.status != -400 {
        println("FAIL fetch SSRF/CRLF guards"); fails += 1
    }

    mut pm := smap_new(8)
    smap_set_str(mut pm, "b", "hello world")
    smap_set_str(mut pm, "a", "1+2&3")
    qs := fetch_urlencode(pm)
    smap_free(move pm)
    if not str_eq(qs, "a=1%2B2%263&b=hello%20world") {
        println(f"FAIL fetch_urlencode={qs}"); fails += 1
    }

    sse := "event: message\ndata: {\"step\":1}\n\nevent: message\ndata: {\"step\":2}\n\ndata: [DONE]\n"
    if not str_eq(sse_parse_last_data(sse), "{\"step\":2}") {
        println("FAIL sse_parse_last_data"); fails += 1
    }

    // 3. Subprocess exact Win32 argv quoting + zero-shell execution + timeout tree-kill
    if not str_eq(subproc_quote_win("hello world"), "\"hello world\"") or not str_eq(subproc_quote_win("a\"b"), "\"a\\\"b\"") {
        println("FAIL subproc_quote_win"); fails += 1
    }
    mut argv := svec_new(4, 128)
    svec_push(mut argv, "bin/axc.exe")
    svec_push(mut argv, "check")
    svec_push(mut argv, "--json")
    svec_push(mut argv, "tests/pass/01_pythonic_named_fstr.ax")
    sr := subproc_run(argv, "", "", 10000, 65536)
    svec_free(move argv)
    if not sr.ok_flag or sr.exit_code != 0 or not str_contains(sr.stdout, "\"ok\":true") {
        println(f"FAIL subproc_run rc={sr.exit_code} out={sr.stdout} err={sr.stderr}"); fails += 1
    }

    // Timeout + process-tree kill proof
    t0 := clock_ns()
    sr_to := subproc_run_shell("ping -n 6 127.0.0.1 >nul", "", 250, 4096)
    el_ms := (clock_ns() - t0) / 1000000
    if not sr_to.timed_out or sr_to.ok_flag or el_ms > 3000 {
        println(f"FAIL subproc timeout timed_out={sr_to.timed_out} ms={el_ms}"); fails += 1
    }
    return fails
}

fn test_tiktoken_perf_and_long_token() -> i64 {
    mut fails := 0
    mut v := tiktoken_vocab_new(256)
    mut b := 0
    while b < 256 {
        bb := buf_new(2); buf_push(bb, b)
        tiktoken_add_token(mut v, buf_to_owned_str(move bb), b)
        b += 1
    }
    // Register merge hierarchy up to a 32-byte token (exceeding old 8-byte decode buffer limit!)
    tiktoken_add_token(mut v, "ax", 256)
    tiktoken_add_token(mut v, "on", 257)
    tiktoken_add_token(mut v, "axon", 258)
    tiktoken_add_token(mut v, "axonaxon", 259)
    tiktoken_add_token(mut v, "axonaxonaxonaxon", 260)
    tiktoken_add_token(mut v, "axonaxonaxonaxonaxonaxonaxonaxon", 261) // 32 bytes!

    sample := "axonaxonaxonaxonaxonaxonaxonaxon"
    toks := tiktoken_encode(v, sample)
    if ibuf_len(toks) != 1 or ibuf_get(toks, 0) != 261 {
        println(f"FAIL tiktoken merge len={ibuf_len(toks)}"); fails += 1
    }
    dec := tiktoken_decode(v, toks)
    buf_free(move toks)
    if not str_eq(dec, sample) {
        println(f"FAIL tiktoken long decode got={dec}"); fails += 1
    }

    // O(N log N) speed test on 16KB prompt (old O(N^2) took seconds; min-heap finishes in milliseconds!)
    big_p := str_repeat(sample, 512) // 16,384 bytes
    t0 := clock_ns()
    cnt := tiktoken_count(v, big_p)
    ms := (clock_ns() - t0) / 1000000
    if cnt != 512 or ms > 500 {
        println(f"FAIL tiktoken 16KB perf cnt={cnt} ms={ms}"); fails += 1
    }
    tiktoken_vocab_free(move v)
    return fails
}

fn test_ai_harness_and_agent_hardening() -> i64 {
    mut fails := 0

    // 1. Structural tool-call parser: zero false-trigger on prose + parallel OpenAI/Anthropic/Gemini!
    prose := "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"Never call \\\"tool_calls\\\" or \\\"function\\\" directly.\"}}]}"
    pb0 := harness_parse_tool_calls_all(prose)
    if pb0.count != 0 { println(f"FAIL prose false-trigger count={pb0.count}"); fails += 1 }
    tool_batch_free(move pb0)

    oa_par := "{\"choices\":[{\"message\":{\"tool_calls\":[{\"id\":\"call_A\",\"type\":\"function\",\"function\":{\"name\":\"read\",\"arguments\":\"{\\\"path\\\":\\\"a.ax\\\"}\"}},{\"id\":\"call_B\",\"type\":\"function\",\"function\":{\"name\":\"grep\",\"arguments\":\"{\\\"q\\\":\\\"fn\\\"}\"}}]}}]}"
    pb1 := harness_parse_tool_calls_all(oa_par)
    if pb1.count != 2 or not str_eq(tool_batch_get(pb1, 0).id, "call_A") or not str_eq(tool_batch_get(pb1, 1).id, "call_B") or not str_contains(tool_batch_get(pb1, 0).args_json, "\"path\":\"a.ax\"") {
        println("FAIL OpenAI parallel tool_calls"); fails += 1
    }
    tool_batch_free(move pb1)

    an_par := "{\"content\":[{\"type\":\"tool_use\",\"id\":\"tu_1\",\"name\":\"glob\",\"input\":{\"p\":\"*.ax\"}},{\"type\":\"tool_use\",\"id\":\"tu_2\",\"name\":\"tree\",\"input\":{\"d\":2}}]}"
    pb2 := harness_parse_tool_calls_all(an_par)
    if pb2.count != 2 or not str_eq(tool_batch_get(pb2, 1).id, "tu_2") { println("FAIL Anthropic parallel"); fails += 1 }
    tool_batch_free(move pb2)

    gm_par := "{\"candidates\":[{\"content\":{\"parts\":[{\"functionCall\":{\"name\":\"t1\",\"args\":{\"k\":1}}},{\"functionCall\":{\"name\":\"t2\",\"args\":{\"k\":2}}}]}}]}"
    pb3 := harness_parse_tool_calls_all(gm_par)
    if pb3.count != 2 or not str_eq(tool_batch_get(pb3, 1).name, "t2") { println("FAIL Gemini parallel"); fails += 1 }
    tool_batch_free(move pb3)

    // 2. Large-file (>16KB) line-slice & grep bugfix proof
    tok := secrets_token_hex(6) or "t54"
    tmp_dir := path_join(fs_temp_dir(), f"axon_sb54_{sys_pid()}_{tok}")
    _ := shutil_mkdir_all(tmp_dir)
    big_lines := str_repeat("0123456789abcdef0123456789abcdef0123456789abcdef\n", 500) + "NEEDLE_AT_LINE_501\n"
    _ := shutil_atomic_write(path_join(tmp_dir, "big.txt"), big_lines)
    mut sb := harness_sandbox_new(tmp_dir, false, 20, 2048) // max_tool_bytes=2048 < file size (~24.5KB)!
    l501 := harness_tool_read_lines(mut sb, "big.txt", 501, 501) or ""
    g501 := harness_tool_grep(mut sb, "big.txt", "NEEDLE_AT_LINE_501", 5) or ""
    if not str_contains(l501, "501: NEEDLE_AT_LINE_501") or not str_contains(g501, "501: NEEDLE_AT_LINE_501") {
        println(f"FAIL large file read_lines/grep l={l501} g={g501}"); fails += 1
    }
    // Ambiguous strict edit rejected (409), unambiguous succeeds with diff
    _ := shutil_atomic_write(path_join(tmp_dir, "dup.txt"), "dup\ndup\nunique_tok\n")
    amb := harness_tool_edit_strict(mut sb, "dup.txt", "dup", "x", false, false) or "AMBIGUOUS_409"
    if not str_eq(amb, "AMBIGUOUS_409") { println("FAIL ambiguous edit not rejected"); fails += 1 }
    ed_diff := harness_tool_edit_strict(mut sb, "dup.txt", "unique_tok", "patched_tok", false, true) or ""
    if not str_contains(ed_diff, "-unique_tok") or not str_contains(ed_diff, "+patched_tok") {
        println("FAIL strict edit diff"); fails += 1
    }
    _ := shutil_rmtree(tmp_dir)

    // 3. O(N) secret redactor (including PEM private keys, github_pat_, xoxb-) & git CWE-88 flags & CRLF guard
    sec_in := "tok=github_pat_1234567890 slack=xoxb-abc-123\n-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEAsecret\n-----END RSA PRIVATE KEY-----\nok"
    sec_out := harness_redact_secrets(sec_in)
    if str_contains(sec_out, "1234567890") or str_contains(sec_out, "abc-123") or str_contains(sec_out, "MIIEow") or not str_contains(sec_out, "[REDACTED_PRIVATE_KEY]") {
        println(f"FAIL redact_secrets out={sec_out}"); fails += 1
    }
    if harness_is_safe_cmd("git -C /tmp status") or harness_is_safe_cmd("git --git-dir=/etc status") or harness_is_safe_cmd("git diff --textconv") {
        println("FAIL git arg-injection allowed"); fails += 1
    }
    crlf_llm := harness_llm_call("api.openai.com", 443, "/v1/chat", "sk-bad\r\nX-Injected: 1", "{}")
    if crlf_llm.ok_flag or crlf_llm.status != 400 { println("FAIL harness_llm_call CRLF"); fails += 1 }

    // 4. Token-saving context compaction + progressive tool registry discovery + ToolResultCache
    mut ctx := agent_ctx_new(8192)
    _ := agent_ctx_push(mut ctx, 0, "System prompt")
    _ := agent_ctx_push(mut ctx, 1, "Read huge log")
    _ := agent_ctx_push(mut ctx, 3, str_repeat("verbose tool output line\n", 120)) // ~3000 chars
    _ := agent_ctx_push(mut ctx, 2, "Analyzed")
    _ := agent_ctx_push(mut ctx, 1, "Next task")
    _ := agent_ctx_push(mut ctx, 2, "Ready")
    saved := agent_ctx_compact_tool_outputs(mut ctx, 2, 200)
    if saved <= 300 or not str_eq(agent_ctx_msg_text(ctx, 0), "System prompt") {
        println(f"FAIL ctx tool compaction saved={saved}"); fails += 1
    }
    agent_ctx_free(move ctx)

    mut reg := tool_reg_new()
    tool_reg_add_coding_defaults(mut reg)
    man := tool_reg_compact_manifest(reg)
    srch := tool_reg_search(reg, "edit", 3)
    desc := tool_reg_describe(reg, "read_file") or ""
    if not str_contains(man, "read_file(path: str") or not str_contains(srch, "edit_file(") or not str_contains(desc, "Schema:") {
        println("FAIL tool_reg progressive discovery"); fails += 1
    }
    tool_reg_free(move reg)

    mut tc := tool_cache_new(5000)
    tool_cache_put(mut tc, "k1", "cached_val", 5000)
    if not str_eq(tool_cache_get(mut tc, "k1") or "", "cached_val") or tc.hits != 1 {
        println("FAIL tool_cache hit"); fails += 1
    }
    tool_cache_invalidate(mut tc, "k1")
    if str_eq(tool_cache_get(mut tc, "k1") or "MISS", "MISS") == false { println("FAIL tool_cache invalidate"); fails += 1 }
    tool_cache_free(move tc)

    // 5. `.axmem` v2 SHA-256 tamper resistance + canonical JSON stuck-loop detector
    mem_path := path_join(fs_temp_dir(), f"axon_mem54_{sys_pid()}_{tok}.axmem")
    mut mem := agent_mem_new(32, 4096)
    _ := agent_mem_put(mut mem, "k", "t", "authentic_value")
    _ := agent_mem_save(mem, mem_path) or -1
    agent_mem_free(move mem)
    m_ok := agent_mem_load(mem_path) or agent_mem_new(16, 4096)
    if m_ok.count != 1 or not str_eq(agent_mem_get(m_ok, "k") or "", "authentic_value") {
        println("FAIL axmem v2 load"); fails += 1
    }
    agent_mem_free(move m_ok)
    // Flip 1 byte in payload -> SHA-256 MUST reject!
    raw_m := fs_read_file(mem_path) or buf_new(0)
    if buf_len(raw_m) > 85 {
        buf_set(raw_m, buf_len(raw_m) - 1, buf_get(raw_m, buf_len(raw_m) - 1) ^ 1)
        _ := fs_write_file(mem_path, raw_m) or -1
    }
    buf_free(move raw_m)
    m_bad := agent_mem_load(mem_path) or agent_mem_new(16, 4096)
    if m_bad.count != 0 { println("FAIL axmem v2 tamper accepted!"); fails += 1 }
    agent_mem_free(move m_bad)
    _ := sys_fs_remove(mem_path)

    // Canonical stuck-loop: different whitespace/key order MUST still trip 3-repeat breaker!
    mut lp := agent_loop_new(10, 3)
    if not agent_loop_record_step(mut lp, "grep", "{\"a\":1,\"b\":2}", true, 10) { fails += 1 }
    if not agent_loop_record_step(mut lp, "grep", "{ \"b\" : 2 , \"a\" : 1 }", true, 10) { fails += 1 }
    if agent_loop_record_step(mut lp, "grep", "{\"a\": 1, \"b\": 2}", true, 10) {
        println("FAIL canonical stuck-loop bypass"); fails += 1
    }
    agent_loop_free(move lp)

    // 6. Eval JSON Pointer grader
    if not grade_json_path_str_eq("{\"result\":{\"verdict\":\"pass\"}}", "/result/verdict", "pass") {
        println("FAIL grade_json_path_str_eq"); fails += 1
    }
    return fails
}

fn _run_live_mcp_ipc(srv_exe: str, ws: str) -> i64 ! i64 {
    mut s_argv := svec_new(4, 128)
    svec_push(mut s_argv, srv_exe)
    svec_push(mut s_argv, "--root")
    svec_push(mut s_argv, ws)
    mut cl := mcp_stdio_connect(s_argv, "", 10000) or return err(500)
    svec_free(move s_argv)

    mut fails := 0
    tools_res := mcp_stdio_list_tools(mut cl, 10000) or ""
    if not str_contains(tools_res, "\"code_batch\"") or not str_contains(tools_res, "\"grep_fast\"") {
        println(f"FAIL live MCP tools/list={tools_res}"); fails += 1
    }

    // Escape `ws` backslashes/quotes safely for JSON args
    ws_eb := buf_new(str_len(ws) * 2 + 16)
    json_push_escaped(ws_eb, ws)
    ws_esc := buf_to_owned_str(move ws_eb)
    call_args := "{\"workspace\":\"" + ws_esc + "\",\"read_only\":true,\"pipeline\":[{\"op\":\"glob\",\"pattern\":\"**/*.ax\"},{\"op\":\"grep\",\"pattern\":\"beta\"},{\"op\":\"read\",\"path\":\"../secret.txt\"}]}"

    t0 := clock_ns()
    call_res := mcp_stdio_call_tool(mut cl, "code_batch", call_args, 10000) or ""
    ipc_us := (clock_ns() - t0) / 1000
    if not str_contains(call_res, "pkg/app.ax") or not str_contains(call_res, "fn beta()") or not str_contains(call_res, "Forbidden path") {
        println(f"FAIL live MCP code_batch={call_res}"); fails += 1
    }
    println(f"  [E2E LIVE MCP STDIO IPC] warm code_batch (glob+grep+jail-check) completed in {ipc_us} us")
    mcp_stdio_close(move cl)
    return ok(fails)
}

fn test_agent_toolkit_and_live_mcp_ipc() -> i64 {
    mut fails := 0

    // 1. Agent Toolkit SWAR grep + atomic multi_edit + batch pipeline
    tok := secrets_token_hex(6) or "tk54"
    ws := path_join(fs_temp_dir(), f"axon_tk54_{sys_pid()}_{tok}")
    _ := shutil_mkdir_all(path_join(ws, "pkg"))
    _ := shutil_atomic_write(path_join(ws, "pkg/app.ax"), "fn alpha() -> i64 {\n    return 1\n}\nfn beta() -> i64 {\n    return 2\n}\n")
    // Write a binary file with NUL bytes that MUST be skipped by SWAR grep
    bin_b := buf_new(32)
    buf_push(bin_b, 0); buf_push_str(bin_b, "alpha_in_binary")
    _ := fs_write_file(path_join(ws, "pkg/data.bin"), bin_b) or -1
    buf_free(move bin_b)

    gh := tk_grep("alpha", ws, "", false, false, 0, 50, false, false)
    if not str_contains(gh, "pkg/app.ax:1: fn alpha()") or str_contains(gh, "data.bin") {
        println(f"FAIL tk_grep SWAR={gh}"); fails += 1
    }

    // Atomic multi-edit (all-or-nothing: bad 2nd edit must NOT modify file!)
    me_bad := tk_multi_edit(path_join(ws, "pkg/app.ax"), "[{\"old\":\"return 1\",\"new\":\"return 10\"},{\"old\":\"NON_EXISTENT\",\"new\":\"x\"}]", false) or "ROLLED_BACK"
    if not str_eq(me_bad, "ROLLED_BACK") { println("FAIL multi_edit non-atomic"); fails += 1 }
    chk_orig := fs_read_text(path_join(ws, "pkg/app.ax")) or ""
    if not str_contains(chk_orig, "return 1") { println("FAIL multi_edit corrupted file on error"); fails += 1 }

    // Valid multi-edit + diff
    me_ok := tk_multi_edit(path_join(ws, "pkg/app.ax"), "[{\"old\":\"return 1\",\"new\":\"return 11\"},{\"old\":\"return 2\",\"new\":\"return 22\"}]", true) or ""
    if not str_contains(me_ok, "+    return 11") or not str_contains(me_ok, "+    return 22") {
        println(f"FAIL multi_edit diff={me_ok}"); fails += 1
    }

    // Batch Code-Mode pipeline (with jail escape blocked!)
    pipe := "[{\"op\":\"glob\",\"pattern\":\"**/*.ax\"},{\"op\":\"read\",\"path\":\"pkg/app.ax\",\"start_line\":1,\"end_line\":3,\"numbered\":true},{\"op\":\"read\",\"path\":\"../escape.txt\"}]"
    bout := tk_exec_batch_json(ws, pipe, true, true, 4000)
    if not str_contains(bout, "pkg/app.ax") or not str_contains(bout, "2:     return 11") or not str_contains(bout, "Forbidden path") {
        println(f"FAIL tk_exec_batch_json={bout}"); fails += 1
    }

    // 2. McpHub progressive discovery + SHA-256 fingerprint + disk schema cache + CSPRNG bridge auth
    cache_f := path_join(ws, "mcp_cache.json")
    mut hub := mcp_hub_new(cache_f)
    fp := mcp_hub_server_fingerprint("{\"command\":\"node\",\"args\":[\"srv.js\"]}", path_join(ws, "pkg/app.ax"))
    if str_len(fp) != 24 { println("FAIL mcp_hub fingerprint"); fails += 1 }
    n_reg := mcp_hub_register_tools_json(mut hub, "github-mcp", "{\"tools\":[{\"name\":\"create_issue\",\"description\":\"Create a GitHub issue\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"repo\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"labels\":{\"type\":\"array\"}},\"required\":[\"repo\",\"title\"]}},{\"name\":\"list_prs\",\"description\":\"List pull requests\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"repo\":{\"type\":\"string\"}},\"required\":[\"repo\"]}}]}", fp)
    if n_reg != 2 { println(f"FAIL mcp_hub register={n_reg}"); fails += 1 }
    if not mcp_hub_save_cache(hub) { println("FAIL mcp_hub_save_cache"); fails += 1 }
    mcp_hub_free(move hub)

    mut hub2 := mcp_hub_new(cache_f)
    if mcp_hub_load_cache(mut hub2) != 2 { println("FAIL mcp_hub_load_cache"); fails += 1 }
    s_hit := mcp_hub_search(hub2, "issue", "", 5)
    d_hit := mcp_hub_describe(hub2, "github_mcp", "create_issue") or ""
    if not str_contains(s_hit, "github-mcp.create_issue(repo: str, title: str, labels?: list)") or not str_contains(d_hit, "Create a GitHub issue") {
        println(f"FAIL mcp_hub search/describe s={s_hit} d={d_hit}"); fails += 1
    }
    mcp_hub_free(move hub2)

    btok := mcp_bridge_make_token() or ""
    if not mcp_bridge_verify_token(btok, btok) or mcp_bridge_verify_token(btok, "wrong_token") {
        println("FAIL mcp_bridge token auth"); fails += 1
    }

    // 3. LIVE E2E ZERO-MOCK MCP STDIO IPC: compile & spawn `examples/code_mode_mcp_server.ax` over real OS pipes!
    srv_exe := path_join(ws, "axon_mcp_srv.exe")
    mut b_argv := svec_new(6, 128)
    svec_push(mut b_argv, "bin/axc.exe")
    svec_push(mut b_argv, "build")
    svec_push(mut b_argv, "examples/code_mode_mcp_server.ax")
    svec_push(mut b_argv, "-o")
    svec_push(mut b_argv, srv_exe)
    br := subproc_run(b_argv, "", "", 15000, 65536)
    svec_free(move b_argv)
    if not br.ok_flag or not shutil_stat(srv_exe).is_file {
        println(f"FAIL build code_mode_mcp_server rc={br.exit_code} out={br.stdout} err={br.stderr}"); fails += 1
    } else {
        ipc_fails := _run_live_mcp_ipc(srv_exe, ws) or 1
        fails += ipc_fails
    }
    _ := shutil_rmtree(ws)
    return fails
}

fn main() -> i32 {
    mut total_fails := 0
    total_fails += test_ffi_secrets_crypto()
    total_fails += test_json_dom_hostile()
    total_fails += test_regex_hostile()
    total_fails += test_path_glob_shutil_difflib()
    total_fails += test_net_fetch_subprocess()
    total_fails += test_tiktoken_perf_and_long_token()
    total_fails += test_ai_harness_and_agent_hardening()
    total_fails += test_agent_toolkit_and_live_mcp_ipc()

    if total_fails != 0 {
        println(f"[FAIL] 54_python_stdlib_and_ai_harness_hostile: {total_fails} failure(s)")
        return 1
    }
    println("[PASS] 54_python_stdlib_and_ai_harness_hostile: ALL 10 hostile Python-stdlib + AI harness + Live MCP IPC suites passed!")
    return 0
}
