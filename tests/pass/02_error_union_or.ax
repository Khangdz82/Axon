// Test 02: Zero-Cost Value Error Unions (`T ! Error`) + `or` Fallback + `or return` + `?` Propagation

fn parse_port(raw: i64) -> i64 ! i64 {
    if raw <= 0 or raw > 65535 {
        return err(400)
    }
    return ok(raw)
}

fn compute_cluster_base(raw_port: i64) -> i64 ! i64 {
    p := parse_port(raw_port)?
    return ok(p + 1000)
}

fn resolve_with_guard(raw_port: i64) -> i64 {
    v := compute_cluster_base(raw_port) or return 9999
    return v * 2
}

fn main() -> i32 {
    // 1. `or` inline default fallback on error vs success
    good := parse_port(8080) or 3000
    bad := parse_port(-5) or 3000
    if good != 8080 or bad != 3000 {
        return 21
    }

    // 2. `?` error propagation + `or return` early return
    r_ok := resolve_with_guard(500)
    // (500 + 1000) * 2 = 3000
    if r_ok != 3000 {
        return 22
    }

    r_err := resolve_with_guard(99999)
    if r_err != 9999 {
        return 23
    }

    println(f"  [02] Error union T!E verified: good={good}, fallback={bad}, r_err={r_err}")
    return 0
}
