// Axon v6.0 Pass Test 10: Long-Running Server Stability Soak (5,000,000 Loop Iterations)
// Proves Perceus Loop Self-FBIP reuses `ByteBuf` and `IntBuf` in-place across 5M cycles
// (340 GB of logical buffer allocations -> 1 VirtualAlloc + 1 VirtualFree, 0 leaks, flat RAM).

fn run_server_soak(cycles: i64) -> i64 {
    mut checksum := 0
    mut iter := 0
    while iter < cycles {
        pkt := buf_new(4096)
        hdr := ibuf_new(256)

        b0 := (iter *% 131 +% 17) & 255
        b1 := (iter *% 97 +% 43) & 255
        buf_push(pkt, b0)
        buf_push(pkt, b1)
        ibuf_push(hdr, buf_get(pkt, 0) + buf_get(pkt, 1))

        checksum = checksum +% ibuf_get(hdr, 0)
        iter += 1
    }
    return checksum
}

fn main() -> i32 {
    t0 := clock_ns()
    cycles := 5000000
    csum := run_server_soak(cycles)
    elapsed_ms := (clock_ns() - t0) / 1000000

    if csum <= 0 {
        return 1
    }
    println(f"  [10] Long-run 5,000,000-cycle Perceus Self-FBIP soak verified: checksum={csum} in {elapsed_ms} ms (0 leaks)")
    return 0
}
