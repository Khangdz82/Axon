// Test 48: Antigravity Agentic IDE Desktop UI Test (`examples/antigravity_ui.ax`)
// Verifies:
// 1. Antigravity Native Photon-D2D Engine (std/ui.ax + std/gui.ax).
// 2. 3-column layout components: Sessions, Agent Trajectory, Artifacts & Swarms.
// 3. Slash commands & Thinking accordion markup integrity.
// 4. In-process JavaScript onclick event execution & reactive DOM innerText update.
// 5. Headless frame presentation without external browsers or localhost servers.

use std::ui
use std::gui
use std::str

fn test_antigravity_native_html_gen() -> str {
    mut h := "<style>\n"
    h = h + ".card { background-color: #0f172a; border: 1px solid #334155; border-radius: 8px; }\n"
    h = h + ".btn-primary { background-color: #2563eb; color: #ffffff; border-radius: 6px; padding: 6px 14px; }\n"
    h = h + "</style>\n"
    h = h + "<div class='flex flex-col h-screen bg-slate-950 text-white'>\n"
    h = h + "<header class='h-12 bg-slate-900 border-b border-slate-800 flex justify-between items-center px-4'>\n"
    h = h + "<div class='text-sky-400 font-bold'>Antigravity 2.0 DeepMind</div>\n"
    h = h + "<div class='text-xs text-slate-400'>Gemini 2.5 Pro | Photon-D2D Native</div>\n"
    h = h + "</header>\n"
    h = h + "<div class='flex flex-1 overflow-hidden'>\n"
    h = h + "<aside id='sessions' class='w-60 bg-slate-900 border-r border-slate-800 p-3'>Sessions List</aside>\n"
    h = h + "<main id='chat' class='flex-1 flex flex-col p-4 gap-3 overflow-y-auto'>\n"
    h = h + "<div id='agent-box' class='card p-3'>Antigravity Agent Ready</div>\n"
    h = h + "<div class='flex gap-2'>\n"
    h = h + "<input id='prompt' class='flex-1 p-2 bg-slate-900 border border-slate-700' value='Ask Antigravity...'/>\n"
    h = h + "<button id='send' class='btn-primary' onclick='submitMsg()'>Send</button>\n"
    h = h + "</div>\n"
    h = h + "<div id='out' class='text-xs text-emerald-400'>Ready.</div>\n"
    h = h + "</main>\n"
    h = h + "<aside id='artifacts' class='w-72 bg-slate-900 border-l border-slate-800 p-3'>Artifacts & Swarms</aside>\n"
    h = h + "</div>\n"
    h = h + "<script>\n"
    h = h + "function submitMsg() {\n"
    h = h + "  document.getElementById('out').innerText = 'Antigravity: Da phan hoi ngay lap tuc tai may (0ms network)!';\n"
    h = h + "}\n"
    h = h + "</script>\n"
    h = h + "</div>\n"
    return h
}

@test
fn test_antigravity_ui_markup_components() {
    html := test_antigravity_native_html_gen()
    assert(str_contains(html, "Antigravity 2.0 DeepMind"))
    assert(str_contains(html, "Gemini 2.5 Pro"))
    assert(str_contains(html, "Photon-D2D Native"))
    assert(str_contains(html, "Sessions List"))
    assert(str_contains(html, "Artifacts & Swarms"))
    assert(str_contains(html, "submitMsg()"))
}

@test
fn test_antigravity_native_d2d_lifecycle_and_js_event() {
    html := test_antigravity_native_html_gen()
    mut app := ui_window_html("Antigravity Native Test", 1200, 800, html)
    assert(app.tree.count > 5)

    isend := document_get_element_by_id(app.tree, "send")
    iout := document_get_element_by_id(app.tree, "out")
    assert(isend > 0 and iout > 0)

    // Simulate clicking Send button -> executes in-process JavaScript without network
    sx := layout_get_x(app.layout, isend) + 4
    sy := layout_get_y(app.layout, isend) + 4
    _ := ui_dispatch_click(mut app, sx, sy)
    assert(str_eq(ui_get_text(app, "out"), "Antigravity: Da phan hoi ngay lap tuc tai may (0ms network)!"))

    // Render 2 Direct2D hardware frames in headless mode
    frames := gui_run_ui_app(mut app, 2, false)
    assert(frames == 2)
}
