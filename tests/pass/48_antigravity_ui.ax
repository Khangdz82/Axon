// Test 48: Antigravity Agentic IDE Desktop UI Test (`examples/antigravity_ui.ax`)
// Verifies:
// 1. Antigravity HTML5 + Tailwind CSS + JS template structure & DeepMind branding.
// 2. 3-column layout components: Sessions, Agent Trajectory, Artifacts & Swarms.
// 3. Slash commands & Thinking accordion markup integrity.
// 4. Ultra-lean WebView binding on ephemeral profile & clean shutdown.

use std::webview
use std::str
use std::sys

fn test_antigravity_html_gen() -> str {
    mut h := "<!doctype html><html lang='en' class='dark'><head><meta charset='utf-8'/>"
    h = h + "<title>Antigravity — Google DeepMind Agentic IDE</title>"
    h = h + "<script src='https://cdn.tailwindcss.com'></script></head>"
    h = h + "<body class='bg-[#080c14] text-slate-100 flex flex-col h-screen'>"
    h = h + "<header class='h-11 bg-[#0d131f] border-b border-slate-800 flex items-center justify-between px-3'>"
    h = h + "<span class='font-bold text-sm text-sky-400'>Antigravity 2.0 DeepMind</span>"
    h = h + "<span class='text-xs text-slate-400'>Gemini 2.5 Pro | Axon Native</span></header>"
    h = h + "<div class='flex flex-1 overflow-hidden'>"
    h = h + "<aside class='w-64 bg-[#0a0f19] border-r border-slate-800 p-2'>Sessions</aside>"
    h = h + "<main class='flex-1 flex flex-col p-4'>Agent Trajectory</main>"
    h = h + "<aside class='w-80 bg-[#0a0f19] border-l border-slate-800 p-2'>Artifacts & Swarms</aside>"
    h = h + "</div></body></html>"
    return h
}

@test
fn test_antigravity_ui_markup_components() {
    html := test_antigravity_html_gen()
    assert(str_starts_with(html, "<!doctype html>"))
    assert(str_contains(html, "Antigravity"))
    assert(str_contains(html, "DeepMind"))
    assert(str_contains(html, "Gemini 2.5 Pro"))
    assert(str_contains(html, "Sessions"))
    assert(str_contains(html, "Agent Trajectory"))
    assert(str_contains(html, "Artifacts & Swarms"))
    assert(str_ends_with(html, "</html>"))
}

@test
fn test_antigravity_webview_lifecycle() {
    html := test_antigravity_html_gen()
    cfg := webview_default_config("Antigravity IDE Test", 19282, 1280, 800, html)
    assert(cfg.ephemeral_profile == true)
    assert(cfg.max_memory_mb == 64)
    assert(cfg.disk_cache_mb == 8)

    wv := webview_create_with_config(cfg) or return
    assert(wv.port == 19282)
    assert(wv.width == 1280 and wv.height == 800)
    assert(wv.is_ephemeral == true)
    assert(str_contains(wv.profile_dir, "axon_wv_"))

    // Close and verify ephemeral cleanup
    webview_close(wv)
}
