// Axon v8.0 Test Suite 19: GGUF Model Parser, Dequantization, LoRA & 8-bit AdamW
use std::ai_math
use std::ai_quant
use std::ai_autograd
use std::ai_gguf
use std::ai_lora

fn test_gguf_subsystem() -> bool {
    mock_path := "test_model_v8.gguf"
    
    // 1. Generate mock Q8_0 GGUF file
    wr := gguf_create_mock_file(mock_path, "layers.0.feed_forward.w1", ggml_type_q8_0(), 64) or -1
    if wr <= 0 {
        return false
    }

    // 2. Open and parse GGUF header
    mut gf := gguf_open(mock_path) or return false
    if gf.version != 3 {
        gguf_close(move gf)
        return false
    }
    if gf.tensor_count != 1 {
        gguf_close(move gf)
        return false
    }
    if gf.kv_count != 1 {
        gguf_close(move gf)
        return false
    }

    // 3. Inspect tensor descriptor
    t_idx := gguf_find_tensor(gf, "layers.0.feed_forward.w1")
    if t_idx != 0 {
        gguf_close(move gf)
        return false
    }

    // 4. Check tensor type and element count
    ttype := gguf_tensor_type(gf, 0)
    if ttype != ggml_type_q8_0() {
        gguf_close(move gf)
        return false
    }
    telem := gguf_tensor_elements(gf, 0)
    if telem != 64 {
        gguf_close(move gf)
        return false
    }

    // 5. Dequantize tensor to FP32
    out_f32 := mem_alloc_aligned(64 * 4)
    deq_ok := gguf_dequant_tensor(gf, 0, out_f32)
    if not deq_ok {
        mem_free_aligned(out_f32)
        gguf_close(move gf)
        return false
    }

    // Verify first block values: scale d=1.0, quants 0..31
    // val[0] = 0.0, val[1] = 1.0, val[10] = 10.0
    val0 := ptr_read_f32(out_f32, 0)
    val1 := ptr_read_f32(out_f32, 1)
    val10 := ptr_read_f32(out_f32, 10)
    
    mem_free_aligned(out_f32)
    gguf_close(move gf)

    if val0 < -0.01 or val0 > 0.01 { return false }
    if val1 < 0.99 or val1 > 1.01 { return false }
    if val10 < 9.99 or val10 > 10.01 { return false }

    // 6. Test Q4_K mock file and dequantization
    mock_q4k := "test_model_q4k.gguf"
    wr2 := gguf_create_mock_file(mock_q4k, "layers.0.attention.wq", ggml_type_q4_k(), 256) or -1
    if wr2 <= 0 {
        return false
    }

    mut gf2 := gguf_open(mock_q4k) or return false
    out_q4k := mem_alloc_aligned(256 * 4)
    deq2_ok := gguf_dequant_tensor(gf2, 0, out_q4k)
    mem_free_aligned(out_q4k)
    gguf_close(move gf2)

    return deq2_ok
}

fn test_lora_and_adamw8bit() -> bool {
    in_dim := 8
    out_dim := 8
    rank := 2
    alpha := 4.0
    batch := 1

    rng := ai_rng_new(42)
    mut l := lora_new(in_dim, out_dim, rank, alpha, rng, 2, false)
    ai_rng_free(move rng)

    // Fill adapter weights manually for deterministic verification
    // A: [rank, in_dim] = [2, 8] -> fill with 0.5
    mut i := 0
    while i < l.a.numel {
        ptr_write_f32(l.a.data_ptr, i, 0.5)
        i += 1
    }
    // B: [out_dim, rank] = [8, 2] -> fill with 0.25
    i = 0
    while i < l.b.numel {
        ptr_write_f32(l.b.data_ptr, i, 0.25)
        i += 1
    }

    // Allocate tensors for forward/backward
    x_ptr := mem_alloc_aligned(batch * in_dim * 4)
    out_ptr := mem_alloc_aligned(batch * out_dim * 4)
    h_buf := mem_alloc_aligned(batch * rank * 4)
    dout_ptr := mem_alloc_aligned(batch * out_dim * 4)
    dh_buf := mem_alloc_aligned(batch * rank * 4)

    // Set input x = [1.0, 1.0, ...]
    i = 0
    while i < in_dim {
        ptr_write_f32(x_ptr, i, 1.0)
        i += 1
    }

    // Set dout = [1.0, 1.0, ...]
    i = 0
    while i < out_dim {
        ptr_write_f32(dout_ptr, i, 1.0)
        i += 1
    }

    // Run LoRA forward: base_w = 0 (adapter only branch)
    lora_fwd_f32(0, l, x_ptr, out_ptr, h_buf, batch)

    // Check forward output
    // H = X @ A^T -> each elem = sum(1.0 * 0.5) over 8 elements = 4.0
    // out = scale * H @ B^T where scale = alpha / rank = 4.0 / 2 = 2.0
    // out_elem = 2.0 * (4.0 * 0.25 + 4.0 * 0.25) = 2.0 * 2.0 = 4.0
    out0 := ptr_read_f32(out_ptr, 0)

    // Run LoRA backward pass
    lora_zero_grad(l)
    lora_bwd_f32(0, l, x_ptr, h_buf, dout_ptr, 0, dh_buf, batch, false)

    grad_b0 := ptr_read_f32(l.b.grad_ptr, 0)
    grad_a0 := ptr_read_f32(l.a.grad_ptr, 0)

    // Initialize 8-bit AdamW optimizer states for A and B
    opt_a := adamw_8bit_init(l.a.numel)
    opt_b := adamw_8bit_init(l.b.numel)

    b0_before := ptr_read_f32(l.b.data_ptr, 0)
    // Run 8-bit AdamW optimization step
    lora_step_adamw_8bit(l, opt_a, opt_b, 1, 0.01, 0.001)
    b0_after := ptr_read_f32(l.b.data_ptr, 0)

    // Cleanup memory
    adamw_8bit_free(move opt_a)
    adamw_8bit_free(move opt_b)
    lora_free(move l)

    mem_free_aligned(x_ptr)
    mem_free_aligned(out_ptr)
    mem_free_aligned(h_buf)
    mem_free_aligned(dout_ptr)
    mem_free_aligned(dh_buf)

    // Validations
    if out0 < 3.9 or out0 > 4.1 { return false }
    if grad_b0 < 0.1 { return false }
    if grad_a0 < 0.1 { return false }
    // Parameter should have been updated by optimizer step
    if b0_after == b0_before { return false }

    return true
}

fn test_dora_serialization() -> bool {
    rng := ai_rng_new(123)
    mut l := lora_new(16, 16, 4, 8.0, rng, 2, true)
    ai_rng_free(move rng)

    ptr_write_f32(l.mag.data_ptr, 0, 2.5)

    save_path := "test_dora_checkpoint.axlora"
    w := lora_save_file(save_path, l) or return false
    if w <= 0 {
        lora_free(move l)
        return false
    }

    mut loaded := lora_load_file(save_path, 2) or return false
    lora_free(move l)

    val0 := ptr_read_f32(loaded.mag.data_ptr, 0)
    has_dora := loaded.use_dora
    lora_free(move loaded)

    return has_dora and val0 > 2.49 and val0 < 2.51
}

fn main() -> i32 {
    println("[19] Running v8.0 AI GGUF & LoRA test suite...")

    ok_gguf := test_gguf_subsystem()
    if not ok_gguf {
        println("FAILED: GGUF parser or dequantization kernel test failed!")
        return 1
    }
    println("  [PASS] GGUF v3 header, metadata, tensor table, Q8_0 and Q4_K dequantization verified.")

    ok_lora := test_lora_and_adamw8bit()
    if not ok_lora {
        println("FAILED: LoRA forward/backward or 8-bit AdamW optimizer test failed!")
        return 1
    }
    println("  [PASS] LoRA low-rank adaptation forward/backward and 8-bit AdamW optimizer verified.")

    ok_dora := test_dora_serialization()
    if not ok_dora {
        println("FAILED: DoRA checkpoint serialization test failed!")
        return 1
    }
    println("  [PASS] DoRA magnitude parameter save/load serialization verified.")

    println("[19] All AI GGUF and LoRA tests passed cleanly!")
    return 0
}
