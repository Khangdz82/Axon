// Test 17 (v7.0): Built-in Zero-Config Unit Test Runner (`@test` + `axc test` + `assert`)

use std::decimal
use std::math3d

@test
fn test_decimal_exact_hft() {
    a := 10.05d
    b := 20.15d
    assert(a + b == 30.20d)
    assert(round_half_even(1.2250d) == 1.22d)
    assert(round_half_even(1.2350d) == 1.24d)
}

@test
fn test_simd_vec3_dot() {
    u := vec3_new(2.0, 3.0, 6.0)
    d := vec3_dot(u, u) as i64
    assert(d == 49)
}

@test
fn test_comptime_fold() {
    x := comptime (12 * 12 + 6)
    assert(x == 150)
}

fn main() -> i32 {
    test_decimal_exact_hft()
    test_simd_vec3_dot()
    test_comptime_fold()
    println("  [17] v7 @test suite + assert verified (decimal 0.01d, SIMD vec3, comptime)")
    return 0
}
