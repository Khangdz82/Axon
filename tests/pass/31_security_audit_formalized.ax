// Formalized Security Audit Test: Slot reuse and streaming buffer stability
use std::html
use std::ui_signal

fn test_dom_slot_reuse() -> bool {
    mut tree := html_parse("<div id=\"test\">Initial</div>") or return false
    
    // Set 20 bytes
    dom_set_text(mut tree, 0, "12345678901234567890")
    off1 := buf_len(tree.dynamic_buf)
    
    // Shrink to 5 bytes in-place
    dom_set_text(mut tree, 0, "12345")
    off2 := buf_len(tree.dynamic_buf)
    
    // Grow back to 10 bytes (still <= original 20 bytes)
    dom_set_text(mut tree, 0, "1234567890")
    off3 := buf_len(tree.dynamic_buf)
    
    // In-place reuse guarantees no buffer expansion
    if off3 > off2 {
        return false
    }
    return off1 == off2 and off2 == off3
}

fn test_stream_buffer_stability() -> bool {
    mut tree := html_parse("<div id=\"chat\">Initial</div>") or return false
    mut g := signal_graph_new()
    sig_idx := signal_register_str(mut g, "token", "")
    signal_bind_node(mut g, sig_idx, 0, signal_target_text(), "", "")

    mut s := ""
    mut i := 0
    while i < 100 {
        s = s + "12345678901234567890123456789012345678901234567890"
        signal_set_str(mut g, mut tree, "token", s)
        i += 1
    }
    return str_len(s) == 5000
}

fn main() -> i32 {
    println("[31] Running formalized security audit test suite...")
    
    ok1 := test_dom_slot_reuse()
    if not ok1 {
        println("FAILED: DOM slot reuse leaked memory!")
        return 1
    }
    println("  [PASS] DOM in-place slot reuse verified (zero-leak).")
    
    ok2 := test_stream_buffer_stability()
    if not ok2 {
        println("FAILED: Streaming buffer crashed or truncated!")
        return 1
    }
    println("  [PASS] Continuous stream buffer stability verified.")
    
    println("[31] All formalized security audit tests passed cleanly!")
    return 0
}
