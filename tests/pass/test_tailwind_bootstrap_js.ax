use std::ui
use std::html
use std::css
use std::ui_js
use std::test_kit

fn main() -> i64 {
    s := suite_new("std-tailwind-bootstrap-js-suite")

    mut app := ui_app_new("Tailwind & Bootstrap Showcase", 800, 600)

    html_markup := 
        "<div id=\"root\" class=\"flex flex-col gap-4 p-6 bg-slate-900 rounded-xl\">" +
            "<header class=\"flex justify-between items-center\">" +
                "<h1 class=\"text-white font-bold\">Axon Tailwind</h1>" +
                "<span class=\"badge bg-primary\">Bootstrap Badge</span>" +
            "</header>" +
            "<div id=\"alert-box\" class=\"alert alert-primary\">System Ready</div>" +
            "<div class=\"card bg-slate-800 p-4 rounded-lg border border-slate-700\">" +
                "<p class=\"text-slate-400\">Reactive Counter Test</p>" +
                "<button id=\"btn-counter\" class=\"btn btn-success\" onclick=\"increment:click_count:btn-counter:Count: \">Count: 0</button>" +
            "</div>" +
        "</div>"

    ui_set_html(mut app, html_markup)

    // Render frame 1
    canv := ui_render(mut app)
    assert_eq_i64(s, canv.width, 800, "canvas w 800")

    // Check Tailwind style resolved on root
    root_style := css_compute_node_style(app.tree, 0, app.sheet)
    assert_eq_i64(s, root_style.display, 1, "root has display: flex (Tailwind)")
    assert_eq_i64(s, root_style.flex_direction, 1, "root has flex-col (Tailwind)")
    assert_eq_i64(s, root_style.gap, 16, "root has gap-4 = 16px (Tailwind)")
    assert_eq_i64(s, root_style.bg_color, 0xFF0F172A, "root has bg-slate-900 (Tailwind)")
    assert_eq_i64(s, root_style.border_radius, 12, "root has rounded-xl = 12px (Tailwind)")

    // Check JS reactivity & DOM text mutation
    btn_idx := dom_find_by_id(app.tree, "btn-counter")
    assert_true(s, btn_idx >= 0, "btn-counter found")
    btn_text_before := dom_get_text(app.tree, btn_idx)
    assert_eq_str(s, btn_text_before, "Count: 0", "initial button text")

    // Simulate clicking on the button (triggers JS onclick action: increment)
    bx := layout_get_x(app.layout, btn_idx)
    by := layout_get_y(app.layout, btn_idx)
    clicked_id := ui_dispatch_click(mut app, bx + 10, by + 10)
    assert_eq_str(s, clicked_id, "btn-counter", "button clicked")

    // Check that button text was reactively updated by JS action!
    btn_text_after := dom_get_text(app.tree, btn_idx)
    assert_eq_str(s, btn_text_after, "Count: 1", "JS onclick incremented text to Count: 1")

    // Direct JS DOM manipulation API
    ui_set_inner_text(mut app, "alert-box", "Status: Online")
    alert_idx := dom_find_by_id(app.tree, "alert-box")
    assert_eq_str(s, dom_get_text(app.tree, alert_idx), "Status: Online", "document_set_inner_text updated")

    // Class toggling
    ui_toggle_class(mut app, "alert-box", "d-none")
    assert_true(s, str_find(dom_get_class(app.tree, alert_idx), "d-none", 0) >= 0, "d-none class toggled on")

    return suite_finish(move s)
}
