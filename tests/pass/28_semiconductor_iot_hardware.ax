// Axon Semiconductor, Deep IoT & Hardware Acceleration Test Suite (`tests/pass/28_semiconductor_iot_hardware.ax`)
// Tests: MMIO, Bitfields, DMA Ring, NVIC, GPIO, UART, SPI, I2C, PWM, ADC, Systolic Grid, NPU

use std::semiconductor
use std::iot
use std::npu
use std::os

@test
fn test_semiconductor_mmio_and_bitfields() {
    // Allocate simulated memory-mapped hardware peripheral block
    hw_mem := mem_alloc_aligned(1024)
    mut i := 0
    while i < 128 {
        ptr_write_i64(hw_mem, i, 0)
        i += 1
    }

    // 1. 8-bit, 16-bit, 32-bit, 64-bit MMIO
    mmio_write8(hw_mem, 0xAB)
    assert(mmio_read8(hw_mem) == 0xAB, "mmio_read8 failed")

    mmio_write16(hw_mem + 4, 0x1234)
    assert(mmio_read16(hw_mem + 4) == 0x1234, "mmio_read16 failed")

    mmio_write32(hw_mem + 8, 0x12345678)
    assert(mmio_read32(hw_mem + 8) == 0x12345678, "mmio_read32 failed")

    // 2. Bitfield manipulations
    mmio_set_bits32(hw_mem + 8, 0x00000001)
    assert(mmio_read32(hw_mem + 8) == 0x12345679, "mmio_set_bits32 failed")

    mmio_clear_bits32(hw_mem + 8, 0x00000079)
    assert((mmio_read32(hw_mem + 8) & 0xFF) == 0x00, "mmio_clear_bits32 failed")

    mmio_toggle_bits32(hw_mem + 8, 0x00000055)
    assert((mmio_read32(hw_mem + 8) & 0xFF) == 0x55, "mmio_toggle_bits32 failed")

    // Bitfield extract & deposit
    reg_val := 0x12345678
    // Extract bits [15..8] = 0x56
    b_ext := bitfield_extract(reg_val, 8, 8)
    assert(b_ext == 0x56, "bitfield_extract failed")

    // Deposit 0xAA into bits [15..8]
    b_dep := bitfield_deposit(reg_val, 8, 8, 0xAA)
    assert(bitfield_extract(b_dep, 8, 8) == 0xAA, "bitfield_deposit failed")

    mem_free_aligned(hw_mem)
}

@test
fn test_dma_ring_and_nvic() {
    // 1. DMA Circular Descriptor Ring
    mut ring := dma_ring_new(4)
    assert(ring.num_descs == 4, "dma_ring_new capacity mismatch")

    ok1 := dma_ring_enqueue(mut ring, 0x10000000, 512, false)
    assert(ok1, "dma_ring_enqueue 1 failed")
    ok2 := dma_ring_enqueue(mut ring, 0x20000000, 1024, true)
    assert(ok2, "dma_ring_enqueue 2 failed")

    dma_ring_free(move ring)

    // 2. NVIC Interrupt Controller
    sim_nvic_mem := mem_alloc_aligned(2048)
    mut i := 0
    while i < 256 {
        ptr_write_i64(sim_nvic_mem, i, 0)
        i += 1
    }

    nvic := nvic_controller_new(sim_nvic_mem, 64)
    nvic_enable_irq(nvic, 5)
    nvic_set_pending(nvic, 5)
    assert(nvic_is_pending(nvic, 5), "nvic_is_pending failed")

    nvic_clear_pending(nvic, 5)
    assert(not nvic_is_pending(nvic, 5), "nvic_clear_pending failed")

    mem_free_aligned(sim_nvic_mem)
}

@test
fn test_iot_gpio_uart_spi_i2c_pwm_adc() {
    // Simulated Peripheral Memory Space
    periph_mem := mem_alloc_aligned(4096)
    mut i := 0
    while i < 512 {
        ptr_write_i64(periph_mem, i, 0)
        i += 1
    }

    // 1. GPIO Port
    gpio := gpio_port_new(periph_mem, 16)
    gpio_set_mode(gpio, 3, gpio_mode_output())
    gpio_write(gpio, 3, true)
    // In BSRR lower 16 bits, bit 3 is written
    assert((mmio_read32(periph_mem + 0x18) & (1 << 3)) != 0, "gpio_write HIGH failed")

    gpio_write(gpio, 3, false)
    // In BSRR upper 16 bits, bit 19 is written
    assert((mmio_read32(periph_mem + 0x18) & (1 << 19)) != 0, "gpio_write LOW failed")

    // 2. PWM Controller
    pwm := pwm_new(periph_mem + 0x100, 1, 1000, 1000000) // 1000Hz on 1MHz clock => period = 1000 ticks
    assert(pwm.period_ticks == 1000, "pwm_new period calculation failed")
    pwm_set_duty(pwm, 5000) // 50.00% duty => 500 ticks
    ccr1 := mmio_read32(periph_mem + 0x100 + 0x34)
    assert(ccr1 == 500, "pwm_set_duty failed")

    // 3. ADC Controller
    adc := adc_new(periph_mem + 0x200, 3300, 12)
    // Mock ADC DR = 2048 (half of 4095 => ~1650 mV)
    mmio_write32(periph_mem + 0x200 + 0x4C, 2048)
    mmio_write32(periph_mem + 0x200 + 0x00, 1 << 1) // Set EOC bit in SR
    mv := adc_read_millivolts(adc, 0)
    assert(mv >= 1640 and mv <= 1660, "adc_read_millivolts failed")

    mem_free_aligned(periph_mem)
}

@test
fn test_npu_systolic_and_bit_serial_mac() {
    // 1. 2D Systolic Array Grid (2x2)
    grid := systolic_grid_new(2, 2)
    // Weight matrix:
    // [ 1.0,  2.0 ]
    // [ 3.0,  4.0 ]
    weights := mem_alloc_aligned(64)
    ptr_write_f32(weights, 0, 1.0)
    ptr_write_f32(weights, 1, 2.0)
    ptr_write_f32(weights, 2, 3.0)
    ptr_write_f32(weights, 3, 4.0)
    systolic_load_weights(grid, weights, 4)

    // Input activation: [ 2.0, 3.0 ]
    act := mem_alloc_aligned(64)
    ptr_write_f32(act, 0, 2.0)
    ptr_write_f32(act, 1, 3.0)

    // Output accum: out = act * W
    // out[0] = 2.0*1.0 + 3.0*3.0 = 2 + 9 = 11.0
    // out[1] = 2.0*2.0 + 3.0*4.0 = 4 + 12 = 16.0
    out := mem_alloc_aligned(64)
    systolic_step_gemv(grid, act, out)

    o0 := ptr_read_f32(out, 0)
    o1 := ptr_read_f32(out, 1)
    assert(o0 >= 10.99 and o0 <= 11.01, "systolic out[0] failed")
    assert(o1 >= 15.99 and o1 <= 16.01, "systolic out[1] failed")

    mem_free_aligned(weights)
    mem_free_aligned(act)
    mem_free_aligned(out)
    systolic_grid_free(move grid)

    // 2. Bit-Serial MAC
    // Multiply 5 by 6 = 30
    mac_res := bit_serial_mac(5, 6, 8)
    assert(mac_res == 30, "bit_serial_mac failed")

    // 3. 1-Bit BNN Dot Product (XNOR + Popcount)
    // Vector A: 64 ones (0xFFFFFFFFFFFFFFFF)
    // Vector B: 64 ones (0xFFFFFFFFFFFFFFFF)
    // Result should be +64
    bnn_dot := vdpu_dot_bnn_1bit_64(-1, -1)
    assert(bnn_dot == 64, "vdpu_dot_bnn_1bit_64 all ones failed")

    // Vector B with 32 zeros, 32 ones -> dot should be 0
    bnn_dot_half := vdpu_dot_bnn_1bit_64(-1, 0x00000000FFFFFFFF)
    assert(bnn_dot_half == 0, "vdpu_dot_bnn_1bit_64 orthogonal failed")
}
