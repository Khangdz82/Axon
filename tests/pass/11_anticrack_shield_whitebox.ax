// Axon v6.0 Pass Test 11: Polymorphic @shield v2 + Rolling @secret + GF(2^8) @whitebox Defense
// Verifies hardware-speed license/integrity protection with zero plaintext key leakage in PE32+.

use std::crypto

@shield
fn compute_license_tag(challenge: i64) -> i64 {
    key := @secret("AXON-V6-MASTER-LICENSE-KEY-2026")
    n := str_len(key)
    mut acc := challenge ^ 0x517CC1B7
    mut i := 0
    while i < n {
        kb := str_byte(key, i)
        sb := whitebox_sbox(0x6A09E667BB67AE85, (kb ^ i) & 255)
        acc = (acc *% 16777619) ^ sb
        i += 1
    }
    return acc & 0x7FFFFFFF
}

@shield
fn main() -> i32 {
    tag1 := compute_license_tag(20260600)
    tag2 := compute_license_tag(20260600)
    tag_diff := compute_license_tag(20260601)

    if tag1 <= 0 or tag1 != tag2 or tag1 == tag_diff {
        return 1
    }
    if not verify_tag(tag1, tag2) {
        return 2
    }
    println(f"  [11] Polymorphic @shield v2 + @secret wipe + @whitebox verified: tag={tag1}")
    return 0
}
