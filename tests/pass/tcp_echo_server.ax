// High-Throughput Zero-Copy Echo Server in Axon
struct EchoServer {
    port: i32,
    total_requests: i64,
    active_connections: i32,
}

fn handle_connection(sock_id: i32, bytes_len: i32) -> i32 {
    let sent = bytes_len;
    return sent;
}

fn run_server(mut s: EchoServer, max_requests: i64) -> i32 {
    isolated req: i64 = 0;
    while req < max_requests {
        let sent = handle_connection(1, 128);
        s.total_requests += 1;
        req += 1;
    }
    return 0;
}

fn main() -> i32 {
    isolated s = EchoServer(8080, 0, 0);
    let res = run_server(mut s, 500_000);
    if s.total_requests != 500_000 {
        return 1;
    }
    return 0;
}
