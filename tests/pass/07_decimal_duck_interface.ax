// Test 07: Exact Financial `dec` Fixed-Point + Duck-Typed `interface` + True Join-Semilattice CRDTs
use std::decimal
use std::crdt

interface Billable {
    fn net_total(self) -> dec
}

struct Invoice {
    unit_price: dec
    qty: i64
}

impl Invoice {
    fn net_total(self) -> dec {
        sub := self.unit_price * self.qty
        return apply_tax(sub, rate_pct = 0.10d)
    }
}

fn settle_item(b: Billable) -> dec {
    return b.net_total()
}

fn main() -> i32 {
    // 1. Exact IEEE-free decimal math: 0.10d + 0.20d == 0.30d!
    sum := 0.10d + 0.20d
    if sum != 0.30d {
        return 71
    }

    inv := Invoice(25.00d, 4)
    // 25.00 * 4 = 100.00 + 10% tax = 110.00d
    total := settle_item(inv)
    if total != 110.00d {
        return 72
    }

    // 2. Verify CRDT Join-Semilattice Idempotence, Commutativity, and Associativity!
    mut r0 := gcounter_new()
    r0 = gcounter_inc(r0, 0, 5)
    r0 = gcounter_inc(r0, 1, 2)

    mut r1 := gcounter_new()
    r1 = gcounter_inc(r1, 0, 3)
    r1 = gcounter_inc(r1, 1, 9)
    r1 = gcounter_inc(r1, 2, 4)

    // True lattice merge: max(5,3)=5, max(2,9)=9, max(0,4)=4 -> 18 (NOT 5+3+2+9+4=23!)
    m_ab := gcounter_merge(r0, r1)
    m_ba := gcounter_merge(r1, r0)
    m_idem := gcounter_merge(m_ab, m_ab)

    if gcounter_value(m_ab) != 18 {
        return 73
    }
    if gcounter_value(m_ba) != 18 or gcounter_value(m_idem) != 18 {
        return 74
    }

    println(f"  [07] Exact dec ({total}) + Duck interface + CRDT lattice (18) verified")
    return 0
}
