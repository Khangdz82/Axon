use std::uuid
use std::test_kit

fn main() -> i64 {
    s := suite_new("std-uuid-suite")

    u4 := uuid_v4()
    assert_true(s, uuid_is_valid(u4), "uuid_v4 is valid")

    u7 := uuid_v7()
    assert_true(s, uuid_is_valid(u7), "uuid_v7 is valid")

    parsed := uuid_parse(u4) or uuid_nil()
    assert_true(s, not uuid_is_nil(parsed), "parsed u4 is not nil")
    restr := uuid_to_str(parsed)
    assert_eq_str(s, u4, restr, "roundtrip uuid_to_str")

    nil_u := uuid_nil()
    assert_true(s, uuid_is_nil(nil_u), "uuid_nil is nil")
    assert_eq_str(s, uuid_to_str(nil_u), "00000000-0000-0000-0000-000000000000", "uuid_nil str")

    assert_true(s, not uuid_is_valid("invalid-uuid"), "invalid-uuid rejected")
    assert_true(s, not uuid_is_valid("00000000-0000-0000-0000-00000000000Z"), "invalid char rejected")

    return suite_finish(move s)
}
