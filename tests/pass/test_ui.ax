use std::ui
use std::test_kit

fn main() -> i64 {
    s := suite_new("std-ui-framework-suite")

    mut app := ui_app_new("Axon Dashboard", 800, 600)

    html_markup := "<div id=\"root\" class=\"app-container\" style=\"display: flex; flex-direction: column; padding: 20px; gap: 16px;\">" +
                   "<header id=\"nav\" class=\"navbar\" style=\"display: flex; flex-direction: row; justify-content: space-between; height: 50px;\">" +
                   "<h1 id=\"brand\">AXON</h1>" +
                   "</header>" +
                   "<main id=\"main-card\" class=\"card\" style=\"display: flex; flex-direction: column; padding: 24px; background: #1e293b; border-radius: 12px; height: 200px;\">" +
                   "<h2 id=\"card-title\">ZERO-CEF NATIVE GUI</h2>" +
                   "<button id=\"btn-action\" class=\"btn-primary\" style=\"width: 150px; height: 40px; background: #3b82f6; border-radius: 8px;\">Click Me</button>" +
                   "</main>" +
                   "</div>"

    css_stylesheet := ".btn-primary { color: #ffffff; }" +
                      ".card { border-width: 1px; border-color: #334155; }"

    ok_html := ui_set_html(mut app, html_markup)
    assert_true(s, ok_html, "html parsed into app")

    ui_set_css(mut app, css_stylesheet)

    // Render frame to canvas
    canv := ui_render(mut app)
    assert_eq_i64(s, canv.width, 800, "canvas width 800")
    assert_eq_i64(s, canv.height, 600, "canvas height 600")

    // Hit-testing
    // Root is covering (20, 20)
    hit_root := ui_hit_test_id(app, 25, 25)
    assert_true(s, str_len(hit_root) > 0, "hit test detected element")

    // Export frame to BMP
    bmp_buf := ui_export_bmp(app)
    assert_true(s, buf_len(bmp_buf) > 54, "exported BMP header + pixel data")
    buf_free(move bmp_buf)

    return suite_finish(move s)
}
