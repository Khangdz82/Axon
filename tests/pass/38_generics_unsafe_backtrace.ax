// Comprehensive Verification: Monomorphized Generics (`std::vec`) + Enforced `unsafe` Boundary
use std::vec

struct Triple[A, B, C] {
    a: A,
    b: B,
    c: C
}

fn identity_val[T](x: T) -> T {
    return x
}

unsafe fn raw_read_first_i64(ptr: i64) -> i64 {
    return ptr_read_i64(ptr, 0)
}

@test fn test_monomorphized_structs() -> i64 {
    b_int := Box[i64](42)
    b_str := Box[str]("axon_generics")
    p := Pair[i64, str](7, "seven")
    sw := swap_pair[i64, str](p)
    nested := Box[Pair[i64, str]](Pair[i64, str](99, "nested"))
    tr := Triple[i64, f64, bool](10, 2.5, true)
    if b_int.value != 42 { return 1 }
    if not str_eq(b_str.value, "axon_generics") { return 2 }
    if not str_eq(sw.first, "seven") or sw.second != 7 { return 3 }
    if nested.value.first != 99 or not str_eq(nested.value.second, "nested") { return 4 }
    if tr.a != 10 or tr.b < 2.4 or tr.b > 2.6 or not tr.c { return 5 }
    return 0
}

@test fn test_monomorphized_fns_and_inference() -> i64 {
    o1 := some[i64](123)
    o2 := none_opt[i64](0)
    if unwrap_or(o1, 999) != 123 { return 1 }
    if unwrap_or(o2, 999) != 999 { return 2 }
    if max_val(10, 25) != 25 { return 3 }
    if min_val[f64](3.5, 1.25) > 1.26 { return 4 }
    if clamp_val(50, 0, 10) != 10 { return 5 }
    if clamp_val(-5, 0, 10) != 0 { return 6 }
    if identity_val(777) != 777 { return 7 }
    return 0
}

@test fn test_unsafe_blocks_and_fn() -> i64 {
    ptr := unsafe { mem_alloc_aligned(64) }
    unsafe {
        ptr_write_i64(ptr, 0, 1337)
        ptr_write_i64(ptr, 1, 9001)
    }
    v0 := unsafe { raw_read_first_i64(ptr) }
    v1 := unsafe { ptr_read_i64(ptr, 1) }
    unsafe { mem_free_aligned(ptr) }
    if v0 != 1337 or v1 != 9001 { return 1 }
    return 0
}

fn main() {
    r1 := test_monomorphized_structs()
    r2 := test_monomorphized_fns_and_inference()
    r3 := test_unsafe_blocks_and_fn()
    if r1 != 0 or r2 != 0 or r3 != 0 {
        println(f"FAIL r1={r1} r2={r2} r3={r3}")
        return
    }
    println("[PASS] 38_generics_unsafe_backtrace: monomorphized generics + unsafe boundary verified")
}
