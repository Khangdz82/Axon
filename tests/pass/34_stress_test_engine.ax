// Axon v1.0.0 Intensive Runtime Stress Test Engine (`tests/pass/34_stress_test_engine.ax`)
// Multi-workload continuous stress testing: Allocator, Archetype ECS, Hash Map, SPSC RingBuffer, Crypto & SWAR JSON.

use std::collections
use std::ringbuf
use std::crypto
use std::json
use std::game_ecs

fn stress_test_perceus_allocator() -> bool {
    // 100,000 rapid allocation, string build, byte mutate, and free cycles
    mut i := 0
    while i < 100000 {
        b := buf_new(64)
        buf_push_str(b, "StressTest_Payload_")
        buf_push(b, 48 + (i % 10))
        if buf_len(b) != 20 {
            buf_free(move b)
            return false
        }
        buf_free(move b)
        i += 1
    }
    return true
}

fn stress_test_ecs_archetypes() -> bool {
    // Spawn 10,000 entities, run 50 physics steps, and despawn
    mut world := ecs_world_new(16384)
    mask := comp_position() | comp_velocity() | comp_health()

    mut i := 0
    while i < 10000 {
        e := ecs_spawn(world, mask)
        if e < 0 {
            ecs_world_free(move world)
            return false
        }
        ecs_set_position(world, e, i as f64, 0.0, 0.0)
        ecs_set_velocity(world, e, 1.0, 2.0, 0.5)
        ecs_set_health(world, e, 100.0, 100.0)
        i += 1
    }

    // Run 50 simulation steps
    mut step := 0
    while step < 50 {
        ecs_system_movement(world, 0.016)
        ecs_system_gravity(world, 0.0, -9.81, 0.0, 0.016)
        step += 1
    }

    // Verify entity 1 position evolved as expected
    p1_x := ecs_get_pos_x(world, 1)
    if p1_x <= 0.0 {
        ecs_world_free(move world)
        return false
    }

    // Despawn all 10,000 entities (entities 1 to 10000)
    mut di := 1
    while di <= 10000 {
        if not ecs_despawn(world, di) {
            ecs_world_free(move world)
            return false
        }
        di += 1
    }

    ecs_world_free(move world)
    return true
}

fn stress_test_hash_map() -> bool {
    // Insert 20,000 key-value pairs, lookup, and verify
    m := map_new(32768)
    mut i := 0
    while i < 20000 {
        map_put(m, i, i * 7 + 3)
        i += 1
    }

    if map_len(m) != 20000 {
        buf_free(move m)
        return false
    }

    // Verify samples
    if map_get(m, 0) != 3 { buf_free(move m); return false }
    if map_get(m, 1000) != 7003 { buf_free(move m); return false }
    if map_get(m, 19999) != 19999 * 7 + 3 { buf_free(move m); return false }

    buf_free(move m)
    return true
}

fn stress_test_spsc_ringbuffer() -> bool {
    // 50,000 push and pop cycles through SPSC lock-free ring
    mut ring := spsc_new(1024)
    mut i := 0
    while i < 50000 {
        // Push batch of 500
        mut p := 0
        while p < 500 {
            if not spsc_try_push(ring, i + p) {
                spsc_free(move ring)
                return false
            }
            p += 1
        }

        // Pop batch of 500 and verify ordering
        mut q := 0
        while q < 500 {
            val := spsc_try_pop(ring) or -1
            if val != i + q {
                spsc_free(move ring)
                return false
            }
            q += 1
        }

        i += 500
    }

    spsc_free(move ring)
    return true
}

fn stress_test_crypto_and_json() -> bool {
    // 10,000 JSON serialization, parsing, and SHA-256 hashes
    mut i := 0
    while i < 10000 {
        out := buf_new(128)
        json_begin_obj(out)
        json_kv_i64(out, "id", i)
        json_kv_str(out, "status", "active")
        json_end_obj(out)

        doc := buf_slice_str(out, 0, buf_len(out))
        v_id := json_get_i64(doc, "id") or -1
        if v_id != i {
            buf_free(move out)
            return false
        }

        // FNV-1a hash check
        h := fnv1a_str(doc)
        if h == 0 {
            buf_free(move out)
            return false
        }

        buf_free(move out)
        i += 1
    }
    return true
}

fn main() -> i32 {
    println("[34] Starting Comprehensive High-Intensity Stress Test Suite...")

    t0 := clock_ns()
    if not stress_test_perceus_allocator() {
        println("  [FAIL] Stress Test 1: Perceus Allocator 100,000 cycles failed!")
        return 1
    }
    el_1 := (clock_ns() - t0) / 1000000
    println(f"  [PASS] Stress Test 1: Perceus Allocator 100,000 rapid cycles verified ({el_1} ms)")

    t1 := clock_ns()
    if not stress_test_ecs_archetypes() {
        println("  [FAIL] Stress Test 2: Archetype ECS 10,000 entities failed!")
        return 2
    }
    el_2 := (clock_ns() - t1) / 1000000
    println(f"  [PASS] Stress Test 2: Archetype ECS 10,000 entities + 50 physics steps verified ({el_2} ms)")

    t2 := clock_ns()
    if not stress_test_hash_map() {
        println("  [FAIL] Stress Test 3: Hash Map 20,000 elements failed!")
        return 3
    }
    el_3 := (clock_ns() - t2) / 1000000
    println(f"  [PASS] Stress Test 3: Hash Map 20,000 elements insert/lookup verified ({el_3} ms)")

    t3 := clock_ns()
    if not stress_test_spsc_ringbuffer() {
        println("  [FAIL] Stress Test 4: SPSC RingBuffer 50,000 cycles failed!")
        return 4
    }
    el_4 := (clock_ns() - t3) / 1000000
    println(f"  [PASS] Stress Test 4: SPSC Lock-Free RingBuffer 50,000 push/pop verified ({el_4} ms)")

    t4 := clock_ns()
    if not stress_test_crypto_and_json() {
        println("  [FAIL] Stress Test 5: Crypto & JSON 10,000 cycles failed!")
        return 5
    }
    el_5 := (clock_ns() - t4) / 1000000
    println(f"  [PASS] Stress Test 5: Crypto Hashing & SWAR JSON 10,000 cycles verified ({el_5} ms)")

    total_ms := (clock_ns() - t0) / 1000000
    println(f"[34] All 5 Stress Test Workloads PASSED with 100% stability in {total_ms} ms!")
    return 0
}
