// Test 03: Static Perceus Deterministic Drop + Zero-Syscall FBIP In-Place Memory Reuse

fn transform_packet_fbip(seed: i64) -> i64 {
    // First allocation `buf_a` (dies right after reading `checksum_a`)
    buf_a := buf_new(1024)
    mut i := 0
    while i < 64 {
        buf_push(buf_a, (seed + i * 3) & 255)
        i += 1
    }
    checksum_a := buf_get(buf_a, 0) + buf_get(buf_a, 63) + buf_len(buf_a)

    // `buf_a` is dead here! Perceus FBIP reuses `buf_a` in-place for `buf_b` with 0 syscalls!
    buf_b := buf_new(1024)
    if buf_len(buf_b) != 0 {
        return -1
    }
    buf_push_u32(buf_b, 0x12345678)
    buf_push_u32(buf_b, checksum_a)
    total := buf_get(buf_b, 0) + buf_get(buf_b, 4) + buf_len(buf_b)
    // Perceus deterministically emits `VirtualFree` for `buf_b` at function epilogue!
    return total
}

fn main() -> i32 {
    res := transform_packet_fbip(10)
    // buf_a[0]=10, buf_a[63]=(10+189)&255=199, len=64 -> checksum_a = 273 (0x111 -> low byte 0x11 = 17)
    // buf_b[0] = 0x78 = 120, buf_b[4] = 17, buf_len(buf_b) = 8 -> total = 145
    if res != 145 {
        return 31
    }
    println(f"  [03] Perceus FBIP in-place reuse & deterministic drop verified: res={res}")
    return 0
}
