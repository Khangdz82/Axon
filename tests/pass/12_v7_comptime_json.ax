// Test 12 (v7.0): `comptime` AST VM, Zero-Alloc `.rdata` Lookup Table, SQL Validation & Zero-Reflection `to_json`

comptime fn build_crc8_lut() -> IntBuf {
    tbl := ibuf_new(256)
    mut i := 0
    while i < 256 {
        mut crc := i
        mut bit := 0
        while bit < 8 {
            if (crc & 1) != 0 {
                crc = (crc >> 1) ^ 0x8C
            } else {
                crc = crc >> 1
            }
            bit += 1
        }
        ibuf_push(tbl, crc)
        i += 1
    }
    return tbl
}

comptime fn is_valid_select_sql(q: str) -> bool {
    return str_len(q) > 12 and str_slice(q, 0, 7) == "SELECT "
}

comptime CRC8_LUT := build_crc8_lut()

comptime {
    comptime_assert(is_valid_select_sql("SELECT id, balance FROM accounts"), "Invalid compile-time SQL")
    comptime_assert(ibuf_len(CRC8_LUT) == 256, "CRC8 LUT must have 256 entries")
}

struct TradeEvent {
    order_id: i64
    symbol: str
    filled: bool
}

fn crc8_fast(s: str) -> i64 {
    mut c := 0
    mut i := 0
    n := str_len(s)
    while i < n {
        idx := (c ^ str_byte(s, i)) & 255
        c = CRC8_LUT[idx]
        i += 1
    }
    return c
}

fn main() -> i32 {
    h1 := crc8_fast("AXON-V7-COMPTIME")
    h2 := comptime crc8_fast("AXON-V7-COMPTIME")
    if h1 != h2 or h1 <= 0 {
        return 121
    }

    ev := TradeEvent(order_id = 9001, symbol = "BTCUSD", filled = true)
    js := to_json(ev)
    expected := "{\"order_id\":9001,\"symbol\":\"BTCUSD\",\"filled\":true}"
    if js != expected {
        println(f"Mismatch JSON: {js}")
        return 122
    }

    println(f"  [12] v7 comptime .rdata LUT + SQL check + 0-reflection to_json verified: crc8={h1}, json={js}")
    return 0
}
