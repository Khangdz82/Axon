// Test 18 (v7.0): Direct C Header Reader (`@cImport`) + Multi-DLL `.idata` (`msvcrt.dll`) Zero-Overhead FFI

@cImport("tests/pass/c_demo_header.h", link = "msvcrt.dll")

fn main() -> i32 {
    if C_MAGIC_PORT != 8443 or C_FLAG_FAST != 32 or C_HEX_TOKEN != 0xCAFE {
        return 181
    }

    win := CWindowDesc(width = 1920, height = 1080)
    if win.width + win.height != 3000 {
        return 182
    }

    a := abs(-777)
    n := strlen("AxonZeroOverheadFFI")
    if a != 777 or n != 19 {
        println(f"FFI mismatch: abs={a}, strlen={n}")
        return 183
    }

    println(f"  [18] v7 @cImport C header + Multi-DLL msvcrt.dll FFI verified: port={C_MAGIC_PORT}, win={win.width}x{win.height}, abs={a}, strlen={n}")
    return 0
}
