// Test 04: Native `Table[T]` Columnar SoA Storage + Dead-Column Elimination + Hardware AVX2 FMA3 SIMD

struct Particle {
    x: f32
    vx: f32
    y: f32
    vy: f32
    mass: f32
    charge: f32
}

fn main() -> i32 {
    n := 1024
    world := Table[Particle]::with_capacity(n)

    // Initialize columns: col 0 (x) = 10.0, col 1 (vx) = 2.5, col 2 (y) = 4.0
    table_fill_f32(world, 0, 10.0)
    table_fill_f32(world, 1, 2.5)
    table_fill_f32(world, 2, 4.0)

    dt := 4.0
    // `for p in world` compiles to 8-wide 256-bit AVX2 `VFMADD231PS` + `VMULPS`
    // and eliminates 3 dead columns (`vy`, `mass`, `charge`) from memory traffic!
    for p in world {
        p.x += p.vx * dt
        p.y *= 3.0
    }

    // Expected: x = 10.0 + 2.5 * 4.0 = 20.0, y = 4.0 * 3.0 = 12.0 across all 1024 particles!
    x0 := table_get_f32(world, 0, 0) as i64
    x_last := table_get_f32(world, 0, 1023) as i64
    y_mid := table_get_f32(world, 2, 511) as i64

    if x0 != 20 or x_last != 20 or y_mid != 12 {
        return 41
    }

    println(f"  [04] Table[Particle] SoA AVX2 SIMD verified: x[0]={x0}, x[1023]={x_last}, y[511]={y_mid}")
    return 0
}
