// Test 49: Responsive Tailwind CSS & CSS @media Engine Test (`tests/pass/49_responsive_ui.ax`)
// Verifies:
// 1. Tailwind breakpoint modifiers: `sm:`, `md:`, `lg:`, `xl:`, `2xl:`, `max-md:`, `max-lg:`.
// 2. CSS @media (min-width: Xpx) and @media (max-width: Ypx) rules.
// 3. Dynamic layout reflow at different window/viewport widths.

use std::ui
use std::css
use std::ui_tailwind
use std::ui_layout
use std::str

@test
fn test_tailwind_responsive_breakpoints() {
    // 1. Hidden on mobile, flex on desktop (`hidden md:flex`)
    mut s1 := style_default()
    tw_apply_classes(mut s1, "hidden md:flex", 600)
    assert(s1.display == 3) // Hidden at 600px (< 768px)

    mut s2 := style_default()
    tw_apply_classes(mut s2, "hidden md:flex", 1024)
    assert(s2.display == 1) // Flex at 1024px (>= 768px)

    // 2. Multi-tier responsive width: `w-full md:w-1/2 lg:w-1/3`
    mut s_mobile := style_default()
    tw_apply_classes(mut s_mobile, "w-full md:w-1/2 lg:w-1/3", 500)
    assert(s_mobile.width == -1) // 100% full width

    mut s_tablet := style_default()
    tw_apply_classes(mut s_tablet, "w-full md:w-1/2 lg:w-1/3", 800)
    assert(s_tablet.width == -1050) // 50% width

    mut s_desktop := style_default()
    tw_apply_classes(mut s_desktop, "w-full md:w-1/2 lg:w-1/3", 1280)
    assert(s_desktop.width == -1033) // 33.3% width

    // 3. Responsive max-width modifier: `max-md:hidden`
    mut s_max_mob := style_default()
    tw_apply_classes(mut s_max_mob, "block max-md:hidden", 600)
    assert(s_max_mob.display == 3) // Hidden on mobile

    mut s_max_desk := style_default()
    tw_apply_classes(mut s_max_desk, "block max-md:hidden", 1024)
    assert(s_max_desk.display == 0) // Visible block on desktop
}

@test
fn test_css_media_query_parsing_and_dispatch() {
    css := "
    .card { background-color: #0f172a; padding: 10px; }
    @media (max-width: 768px) {
        .card { background-color: #ff0000; }
    }
    @media (min-width: 1024px) {
        .card { padding: 30px; }
    }
    "
    mut sheet := css_parse_stylesheet(css)
    tree := html_parse("<div class='card'>Card</div>") or dom_tree_new("<div class='card'>Card</div>")

    // Test mobile viewport (600px): max-width 768px triggers (#ff0000)
    sheet.viewport_w = 600
    st_mobile := css_compute_node_style(tree, 0, sheet)
    assert(st_mobile.bg_color == 0xFFFF0000)
    assert(st_mobile.padding_x == 20) // Base 10px * 2

    // Test desktop viewport (1200px): min-width 1024px triggers (30px padding), max-width 768px ignored
    sheet.viewport_w = 1200
    st_desktop := css_compute_node_style(tree, 0, sheet)
    assert(st_desktop.bg_color == 0xFF0F172A)
    assert(st_desktop.padding_x == 60) // 30px * 2
}
