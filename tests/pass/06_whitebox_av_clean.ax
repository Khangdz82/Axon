// Test 06: `@shield` `.text` FNV-1a Code Integrity + `@whitebox` GF(2^8) Bijective Tables + `@secret`
use std::crypto

@shield
fn main() -> i32 {
    // 1. `@secret` compile-time scrambling + stack reconstruction + epilogue zeroization
    api_key := @secret("AXON-V5-MASTER-KEY-778899")
    if str_len(api_key) != 25 {
        return 61
    }
    if str_byte(api_key, 0) != 65 or str_byte(api_key, 24) != 57 {
        return 62
    }

    // 2. Verify `@whitebox` GF(2^8) lookup table is a true mathematical bijection (256 distinct outputs!)
    seen := ibuf_new(256)
    mut i := 0
    while i < 256 {
        ibuf_push(seen, 0)
        i += 1
    }
    mut x := 0
    mut unique_count := 0
    while x < 256 {
        y := whitebox_sbox(0x7319A5C3, x)
        if y < 0 or y >= 256 {
            return 63
        }
        if ibuf_get(seen, y) == 0 {
            ibuf_set(seen, y, 1)
            unique_count += 1
        }
        x += 1
    }
    if unique_count != 256 {
        return 64
    }

    // 3. White-box MAC determinism & avalanche test
    mac1 := whitebox_mac_str("axon-license-pro-v5")
    mac2 := whitebox_mac_str("axon-license-pro-v5")
    mac_diff := whitebox_mac_str("axon-license-pro-v6")
    if mac1 != mac2 or mac1 == mac_diff {
        return 65
    }

    println(f"  [06] @shield + @whitebox GF(2^8) 256-bijection + @secret verified: mac={mac1}")
    return 0
}
