// Diverse Real-World Simple-to-Stress Speed & Accuracy Suite (`tests/pass/39_speed_stress_suite.ax`)
// Covers recursion, prime sieve, quicksort, radix sort, FP32 GEMM, BNN POPCNT,
// 3D SoA physics, SWAR JSON, zero-cost generics hot loop, and Perceus 0-GC FBIP churn.
use std::vec
use std::json
use std::ai_math

struct Particle39 {
    x: f32,
    y: f32,
    z: f32,
    vx: f32,
    vy: f32,
    vz: f32
}

fn fib(n: i64) -> i64 {
    if n <= 1 { return n }
    return fib(n - 1) + fib(n - 2)
}

fn qsort_39(arr: i64, lo: i64, hi: i64) {
    if lo >= hi { return }
    unsafe {
        pivot := ptr_read_i64(arr, hi)
        mut i := lo - 1
        mut j := lo
        while j < hi {
            vj := ptr_read_i64(arr, j)
            if vj <= pivot {
                i += 1
                vi := ptr_read_i64(arr, i)
                ptr_write_i64(arr, i, vj)
                ptr_write_i64(arr, j, vi)
            }
            j += 1
        }
        pi := i + 1
        vp := ptr_read_i64(arr, pi)
        ptr_write_i64(arr, pi, pivot)
        ptr_write_i64(arr, hi, vp)
        qsort_39(arr, lo, pi - 1)
        qsort_39(arr, pi + 1, hi)
    }
}

fn main() {
    // 1. Recursive Fibonacci (fib(35) == 9227465)
    t0 := clock_ns()
    f35 := fib(35)
    ms_fib := (clock_ns() - t0) as f64 / 1000000.0
    if f35 != 9227465 { println(f"FAIL fib={f35}"); return }

    // 2. Prime Sieve to 2,000,000 (exact count == 148933)
    n_sieve := 2000000
    sieve := unsafe { mem_alloc_aligned(n_sieve + 64) }
    unsafe { mem_set(sieve, 1, n_sieve + 1); ptr_write_u8(sieve, 0, 0); ptr_write_u8(sieve, 1, 0) }
    t1 := clock_ns()
    mut p := 2
    while p * p <= n_sieve {
        if unsafe { ptr_read_u8(sieve, p) } == 1 {
            unsafe { mem_stride_zero_u8(sieve, p * p, p, n_sieve) }
        }
        p += 1
    }
    mut pcnt := 0
    mut si := 2
    while si <= n_sieve {
        pcnt += unsafe { ptr_read_u8(sieve, si) }
        si += 1
    }
    ms_sieve := (clock_ns() - t1) as f64 / 1000000.0
    unsafe { mem_free_aligned(sieve) }
    if pcnt != 148933 { println(f"FAIL sieve={pcnt}"); return }

    // 3. Quicksort 100,000 i64s
    n_sort := 100000
    qarr := unsafe { mem_alloc_aligned(n_sort * 8 + 64) }
    mut seed := 42
    mut qi := 0
    while qi < n_sort {
        seed = (seed *% 1103515245 +% 12345) & 0x7FFFFFFF
        unsafe { ptr_write_i64(qarr, qi, seed % 1000000) }
        qi += 1
    }
    t2 := clock_ns()
    qsort_39(qarr, 0, n_sort - 1)
    ms_qsort := (clock_ns() - t2) as f64 / 1000000.0
    mut sorted_ok := true
    qi = 1
    while qi < n_sort {
        if unsafe { ptr_read_i64(qarr, qi) } < unsafe { ptr_read_i64(qarr, qi - 1) } { sorted_ok = false; break }
        qi += 1
    }
    unsafe { mem_free_aligned(qarr) }
    if not sorted_ok { println("FAIL qsort"); return }

    // 4. Dense FP32 GEMM 256x256
    gn := 256
    ga := unsafe { mem_alloc_aligned(gn * gn * 4 + 64) }
    gb := unsafe { mem_alloc_aligned(gn * gn * 4 + 64) }
    gc := unsafe { mem_alloc_aligned(gn * gn * 4 + 64) }
    mut gi := 0
    while gi < gn * gn {
        unsafe { ptr_write_f32(ga, gi, 0.5); ptr_write_f32(gb, gi, 0.5); ptr_write_f32(gc, gi, 0.0) }
        gi += 1
    }
    t3 := clock_ns()
    gemm_fast_f32(ga, gb, gc, gn, gn, gn)
    ms_gemm := (clock_ns() - t3) as f64 / 1000000.0
    gc0 := unsafe { ptr_read_f32(gc, 0) }
    unsafe { mem_free_aligned(ga); mem_free_aligned(gb); mem_free_aligned(gc) }
    if gc0 < 63.9 or gc0 > 64.1 { println(f"FAIL gemm={gc0}"); return }

    // 5. BNN 1-Bit POPCNT GEMV 4096x4096
    brows := 4096; bwords := 64
    bw := unsafe { mem_alloc_aligned(brows * bwords * 8 + 64) }
    ba := unsafe { mem_alloc_aligned(bwords * 8 + 64) }
    bo := unsafe { mem_alloc_aligned(brows * 8 + 64) }
    mut bi := 0
    while bi < brows * bwords { unsafe { ptr_write_i64(bw, bi, 0x5555555555555555) }; bi += 1 }
    bi = 0
    while bi < bwords { unsafe { ptr_write_i64(ba, bi, 0xAAAAAAAAAAAAAAAA) }; bi += 1 }
    bi = 0
    while bi < brows { unsafe { ptr_write_i64(bo, bi, 0) }; bi += 1 }
    t4 := clock_ns()
    unsafe { bnn_gemv_popcnt(bw, ba, bo, brows, bwords) }
    ms_bnn := (clock_ns() - t4) as f64 / 1000000.0
    bo0 := unsafe { ptr_read_i64(bo, 0) }
    bo_last := unsafe { ptr_read_i64(bo, brows - 1) }
    unsafe { mem_free_aligned(bw); mem_free_aligned(ba); mem_free_aligned(bo) }
    if bo0 != 4096 or bo_last != 4096 { println(f"FAIL bnn={bo0},{bo_last}"); return }

    // 6. 3D Particle Physics SoA (50,000 x 10 steps)
    pn := 50000
    mut pts := Table[Particle39]::with_capacity(pn)
    table_fill_f32(pts, 0, 1.0); table_fill_f32(pts, 1, 2.0); table_fill_f32(pts, 2, 3.0)
    table_fill_f32(pts, 3, 0.1); table_fill_f32(pts, 4, -0.2); table_fill_f32(pts, 5, 0.3)
    dt := 0.016
    t5 := clock_ns()
    mut stp := 0
    while stp < 10 {
        for pt in pts {
            pt.x += pt.vx * dt
            pt.y += pt.vy * dt
            pt.z += pt.vz * dt
        }
        stp += 1
    }
    ms_phys := (clock_ns() - t5) as f64 / 1000000.0

    // 7. Zero-Cost Monomorphized Generic Hot Loop (10,000,000 iterations)
    t6 := clock_ns()
    mut gsum := 0
    mut gl := 0
    while gl < 10000000 {
        gsum += clamp_val(gl & 127, 10, 100)
        gl += 1
    }
    ms_gen := (clock_ns() - t6) as f64 / 1000000.0
    if gsum <= 0 { println("FAIL generic loop"); return }

    // 8. Perceus 0-GC FBIP Churn (2,000,000 iterations)
    t7 := clock_ns()
    mut churn_acc := 0
    mut ci := 0
    while ci < 2000000 {
        b := ibuf_new(8)
        ibuf_push(b, ci & 255)
        churn_acc += ibuf_get(b, 0)
        ci += 1
    }
    ms_fbip := (clock_ns() - t7) as f64 / 1000000.0
    if churn_acc <= 0 { println("FAIL fbip"); return }

    println(f"[PASS] 39_speed_stress_suite: fib35={ms_fib}ms sieve2M={ms_sieve}ms qsort100K={ms_qsort}ms gemm256={ms_gemm}ms bnn4096={ms_bnn}ms phys50K={ms_phys}ms generic10M={ms_gen}ms fbip2M={ms_fbip}ms")
}
