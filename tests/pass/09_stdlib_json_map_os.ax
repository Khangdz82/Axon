// Axon v6.0 Pass Test 09: Standard Library (`std/collections`, `std/json`, `std/os`) Verification
use std::os
use std::collections
use std::json

fn main() -> i32 {
    // 1. Verify `IntMap` open-addressing 64-bit hash map with FNV-1a string keys
    m := map_new(128)
    k_alpha := fnv1a_64("service:alpha")
    k_beta := fnv1a_64("service:beta")
    k_gamma := fnv1a_64("service:gamma")

    map_put(m, k_alpha, 8080)
    map_put(m, k_beta, 9090)
    map_put(m, k_gamma, 7070)
    map_put(m, k_beta, 9095)

    if map_len(m) != 3 { return 1 }
    if map_get(m, k_alpha, -1) != 8080 { return 2 }
    if map_get(m, k_beta, -1) != 9095 { return 3 }
    if not map_contains(m, k_gamma) { return 4 }
    if not map_remove(m, k_gamma) { return 5 }
    if map_contains(m, k_gamma) or map_len(m) != 2 { return 6 }

    // 2. Verify `IntStack` LIFO operations
    st := stack_new(32)
    stack_push(st, 11)
    stack_push(st, 22)
    stack_push(st, 33)
    if stack_len(st) != 3 { return 7 }
    if stack_pop(st, 0) != 33 { return 8 }
    if stack_pop(st, 0) != 22 { return 9 }

    // 3. Verify zero-allocation JSON writer & scanner + `parse_i64`
    out := buf_new(512)
    json_begin_obj(out)
    json_kv_str(out, "engine", "axon-v6")
    json_kv_i64(out, "rps", 1250000)
    json_kv_bool(out, "shield", true)
    json_end_obj(out)

    doc := buf_slice_str(out, 0, buf_len(out))
    eng := json_get_str(doc, "engine") or "bad"
    rps := json_get_i64(doc, "rps") or -1
    shd := json_get_bool(doc, "shield") or false
    parsed_neg := parse_i64("  -42000 ") or 0

    if not str_eq(eng, "axon-v6") { return 10 }
    if rps != 1250000 { return 11 }
    if not shd { return 12 }
    if parsed_neg != -42000 { return 13 }
    if not str_starts_with(doc, "{\"engine\":") or not str_ends_with(doc, "true}") { return 14 }

    println(f"  [09] std/collections + std/json + std/os verified: map_len={map_len(m)}, rps={rps}, engine={eng}")
    return 0
}
