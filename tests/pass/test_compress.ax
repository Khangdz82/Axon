use std::compress
use std::test_kit

fn main() -> i64 {
    s := suite_new("std-compress-suite")

    // Test repetitive text compression
    orig_text := "AxonLanguageAxonLanguageAxonLanguageAxonLanguage1234567890AxonLanguageAxonLanguage"
    comp := compress_str(orig_text)
    
    assert_true(s, buf_len(comp) < str_len(orig_text), "compression reduces repetitive text size")

    decomp := decompress_to_str(comp) or "FAIL"
    buf_free(move comp)
    assert_eq_str(s, orig_text, decomp, "roundtrip decompression matches original exactly")

    // Test small string
    short := "Hello, Axon!"
    c2 := compress_str(short)
    d2 := decompress_to_str(c2) or "FAIL"
    buf_free(move c2)
    assert_eq_str(s, short, d2, "roundtrip short string")

    return suite_finish(move s)
}
