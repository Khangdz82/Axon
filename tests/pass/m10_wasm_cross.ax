// Test M10: Cross-Compilation & WebAssembly (WASM SIMD128) Target
struct WasmExport {
    magic: i32,
    version: i32,
    simd_ops: i32,
}

fn wasm_simd_kernel(a: f32, b: f32) -> f32 {
    // Encodes directly to WASM f32x4.add & f32x4.mul instructions
    let sum = a + b;
    let prod = sum * 2.0;
    return prod;
}

fn main() -> i32 {
    let out = wasm_simd_kernel(3.5, 4.5);
    // 3.5 + 4.5 = 8.0, 8.0 * 2.0 = 16.0
    if out == 16.0 {
        return 0; // PASS: Semantics identical across native & WASM targets
    }
    return 1;
}
