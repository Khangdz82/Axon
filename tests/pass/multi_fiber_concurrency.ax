// Multi-Fiber Concurrency & Linear Ownership in Axon (.ax)
struct Particle {
    x: f32,
    y: f32,
    vx: f32,
    vy: f32,
}

fn step_chunk(mut swarm: Table[Particle], dt: f32) {
    for p in swarm {
        p.x += p.vx * dt;
        p.y += p.vy * dt;
    }
}

fn compute_val(a: i64, b: i64) -> i64 {
    let sum = a +% b;
    return sum;
}

fn main() -> i32 {
    isolated swarm1 = Table[Particle]::with_capacity(500_000);
    isolated swarm2 = Table[Particle]::with_capacity(500_000);

    let job1 = spawn {
        step_chunk(mut swarm1, 0.016);
        return move swarm1;
    };

    let job2 = spawn {
        step_chunk(mut swarm2, 0.016);
        return move swarm2;
    };

    let job3 = spawn {
        let v = compute_val(100, 200);
        return v;
    };

    let res1 = job1.join();
    let res2 = job2.join();
    let res3 = job3.join();

    if res3 != 300 {
        return 1;
    }

    return 0;
}
