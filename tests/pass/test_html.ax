use std::html
use std::test_kit

fn main() -> i64 {
    s := suite_new("std-html-suite")

    raw := "<div id=\"app\" class=\"container dark\">" +
           "<header class=\"navbar\">" +
           "<h1 id=\"title\">Axon UI</h1>" +
           "<span class=\"badge\">v1.0</span>" +
           "</header>" +
           "<main class=\"content\">" +
           "<p>Welcome to native HTML UI without CEF!</p>" +
           "<input type=\"text\" placeholder=\"Enter name\" />" +
           "<button id=\"btn-submit\" class=\"btn primary\">Submit</button>" +
           "</main>" +
           "</div>"

    tree := html_parse(raw) or return 1

    assert_true(s, dom_node_count(tree) > 0, "nodes parsed")
    assert_eq_i64(s, tree.root_idx, 0, "root is index 0")
    assert_eq_str(s, "div", dom_get_tag(tree, 0), "root tag is div")
    assert_eq_str(s, "app", dom_get_id(tree, 0), "root id is app")
    assert_eq_str(s, "container dark", dom_get_class(tree, 0), "root class is container dark")

    btn_idx := dom_find_by_id(tree, "btn-submit")
    assert_true(s, btn_idx >= 0, "btn-submit found by id")
    assert_eq_str(s, "button", dom_get_tag(tree, btn_idx), "btn tag is button")
    assert_eq_str(s, "btn primary", dom_get_class(tree, btn_idx), "btn class is btn primary")
    assert_eq_str(s, "Submit", dom_get_text(tree, btn_idx), "btn text is Submit")

    h1_idx := dom_find_by_id(tree, "title")
    assert_true(s, h1_idx >= 0, "title found by id")
    assert_eq_str(s, "Axon UI", dom_get_text(tree, h1_idx), "h1 text is Axon UI")

    return suite_finish(move s)
}
