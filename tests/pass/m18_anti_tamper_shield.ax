// Test M18: Anti-Tamper, Control-Flow Flattening, Opaque Predicates & Silent Poisoning (`@shield`)

struct ShieldTestResult {
    flattened_steps_executed: i32,
    opaque_branch_correct: i32,
    anti_debug_tripped: i32,
    poisoned_key_diverged: i32,
    passed: i32,
}

fn simulate_flattened_dispatcher(initial_state: i32, iterations: i32) -> (i32, i32) {
    let mut state = initial_state;
    let mut accumulator: i32 = 0;
    let mut step: i32 = 0;

    while step < iterations {
        // State machine dispatcher (Control-Flow Flattening)
        if state == 100 {
            accumulator += 10;
            state = 205; // Dynamic next state
        } else if state == 205 {
            accumulator += 25;
            state = 310;
        } else if state == 310 {
            accumulator *= 2;
            state = 100;
        } else {
            accumulator -= 1;
            state = 100;
        }
        step += 1;
    }
    return (state, accumulator);
}

fn test_opaque_predicates(x: i64) -> i32 {
    // Invariant: x * (x + 1) is always even
    let invariant = (x *% (x +% 1)) & 1;
    if invariant == 0 {
        return 42; // Real path
    }
    return -999; // Decoy path (dead branch)
}

fn test_anti_debug_silent_poison(dr0: i64, clean_key: i64) -> (i64, i32) {
    let debugger_present = if dr0 != 0 { 1 } else { 0 };
    // Silent Poisoning: mutate key instead of crashing
    let effective_key = if debugger_present == 1 {
        clean_key ^ -2401053088876216593 // 0xDEADBEEFCAFEBABE
    } else {
        clean_key
    };
    return (effective_key, debugger_present);
}

fn main() -> i32 {
    // 1. Flattening test
    let (final_state, accum) = simulate_flattened_dispatcher(100, 6);
    let flattening_ok = if accum == 190 { 1 } else { 0 };

    // 2. Opaque predicate test
    let opaque_val = test_opaque_predicates(1337);
    let opaque_ok = if opaque_val == 42 { 1 } else { 0 };

    // 3. Silent poisoning test (clean vs tampered)
    let original_key: i64 = 123456789;
    let (key_clean, dbg_clean) = test_anti_debug_silent_poison(0, original_key);
    let (key_tampered, dbg_tampered) = test_anti_debug_silent_poison(1, original_key);

    let poison_ok = if key_clean == original_key and key_tampered != original_key and dbg_tampered == 1 { 1 } else { 0 };

    if flattening_ok == 1 and opaque_ok == 1 and poison_ok == 1 {
        return 0; // PASS
    }
    return 1;
}
