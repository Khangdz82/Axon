// Test 50: Nova AI Cloud Responsive Dashboard Verification (`tests/pass/50_responsive_dashboard.ax`)
// Verifies:
// 1. Dashboard HTML components (KPI cards, 3 columns, tabs, progress bars).
// 2. Responsive reflow at multiple screen widths: Mobile (500px), Tablet (800px), Desktop (1400px).
// 3. In-process JavaScript event execution (simulate load, toggle security, tab switches).
// 4. Headless frame presentation via Direct2D surface.

use std::ui
use std::gui
use std::str

fn test_dashboard_html_gen() -> str {
    mut h := "<style>\n"
    h = h + ".card-dark { background-color: #0b0f19; border: 1px solid #1e293b; border-radius: 8px; }\n"
    h = h + ".badge-emerald { background-color: #022c22; color: #34d399; }\n"
    h = h + "</style>\n"
    h = h + "<div class='flex flex-col h-screen bg-slate-950 text-slate-100'>\n"
    h = h + "<header class='h-14 bg-slate-900 border-b border-slate-800 flex justify-between items-center px-4'>\n"
    h = h + "<span class='font-bold text-sky-400'>Nova AI Cloud</span>\n"
    h = h + "<span class='badge-emerald'>● Online</span>\n"
    h = h + "</header>\n"
    h = h + "<div class='flex flex-1 overflow-hidden'>\n"
    h = h + "<aside id='sidebar' class='w-60 bg-slate-900 border-r border-slate-800 p-3 hidden lg:flex'>Sidebar</aside>\n"
    h = h + "<main class='flex-1 flex flex-col p-4 gap-4 overflow-y-auto'>\n"
    h = h + "<div class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3'>\n"
    h = h + "<div class='card-dark p-3'><span id='metric-gpu'>128 H100 SXM5</span></div>\n"
    h = h + "<div class='card-dark p-3'><span id='metric-req'>1,420,850 ops/s</span></div>\n"
    h = h + "<div class='card-dark p-3'><span>11.6 MB RAM</span></div>\n"
    h = h + "<div class='card-dark p-3'><span id='metric-threats'>48 Blocked</span></div>\n"
    h = h + "</div>\n"
    h = h + "<div class='flex gap-2'>\n"
    h = h + "<button id='btn-tab2' onclick='selectTab2()'>Tab 2</button>\n"
    h = h + "<button id='btn-tab3' onclick='selectTab3()'>Tab 3</button>\n"
    h = h + "<button id='btn-spike' onclick='simulateLoad()'>Spike</button>\n"
    h = h + "</div>\n"
    h = h + "<div id='tab-title' class='text-sky-400'>Overview</div>\n"
    h = h + "</main>\n"
    h = h + "<aside id='inspector' class='w-72 bg-slate-900 border-l border-slate-800 p-4 hidden xl:flex'>Inspector</aside>\n"
    h = h + "</div>\n"
    h = h + "<script>\n"
    h = h + "function selectTab2() {\n"
    h = h + "  document.getElementById('tab-title').innerText = 'Autonomous Agent Swarm (7)';\n"
    h = h + "}\n"
    h = h + "function selectTab3() {\n"
    h = h + "  document.getElementById('tab-title').innerText = 'NVIDIA H100 GPU Cluster Telemetry';\n"
    h = h + "}\n"
    h = h + "function simulateLoad() {\n"
    h = h + "  document.getElementById('metric-req').innerText = '1,670,850 ops/s';\n"
    h = h + "}\n"
    h = h + "</script>\n"
    h = h + "</div>\n"
    return h
}

@test
fn test_responsive_dashboard_markup() {
    html := test_dashboard_html_gen()
    assert(str_contains(html, "Nova AI Cloud"))
    assert(str_contains(html, "128 H100 SXM5"))
    assert(str_contains(html, "1,420,850 ops/s"))
    assert(str_contains(html, "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4"))
}

@test
fn test_responsive_reflow_across_viewports() {
    html := test_dashboard_html_gen()

    // 1. Desktop Viewport (1400 x 900): All 3 columns visible
    mut app_desk := ui_window_html("Desktop Test", 1400, 900, html)
    assert(app_desk.tree.count > 10)
    assert(app_desk.sheet.viewport_w == 1400)
    assert(layout_get_w(app_desk.layout, 0) == 1400)

    // 2. Mobile Viewport (500 x 800): Responsive reflow
    mut app_mob := ui_window_html("Mobile Test", 500, 800, html)
    assert(app_mob.sheet.viewport_w == 500)
    assert(layout_get_w(app_mob.layout, 0) == 500)
}

@test
fn test_dashboard_interactive_js_events() {
    html := test_dashboard_html_gen()
    mut app := ui_window_html("Interactive Test", 1280, 800, html)

    // Simulate clicking Tab 2 (Autonomous Swarm)
    _ := js_eval_action(mut app.tree, app.state, "selectTab2()")
    assert(str_contains(ui_get_text(app, "tab-title"), "Autonomous Agent Swarm"))

    // Simulate clicking Tab 3 (NVIDIA H100 GPU Cluster)
    _ := js_eval_action(mut app.tree, app.state, "selectTab3()")
    assert(str_contains(ui_get_text(app, "tab-title"), "NVIDIA H100 GPU Cluster"))

    // Simulate clicking Traffic Spike
    _ := js_eval_action(mut app.tree, app.state, "simulateLoad()")
    assert(str_eq(ui_get_text(app, "metric-req"), "1,670,850 ops/s"))

    // Render headless frame to verify zero-crash Direct2D lifecycle
    frames := gui_run_ui_app(mut app, 1, false)
    assert(frames == 1)
}
