// Test M12: Deterministic Resource Management (`with` Scoped Perceus Cleanup)

struct ManagedBuffer {
    handle_id: i32,
    capacity: i32,
    is_closed: i32,
}

fn open_resource(id: i32, cap: i32) -> ManagedBuffer {
    return ManagedBuffer(id, cap, 0);
}

fn close_resource(mut buf: ManagedBuffer) -> i32 {
    buf.is_closed = 1;
    return 0;
}

fn process_with_block() -> i32 {
    // Lowered from:
    // with buf = try open_resource(101, 4096) { ... }
    let mut buf = open_resource(101, 4096);
    let valid = if buf.handle_id == 101 and buf.capacity == 4096 { 1 } else { 0 };
    
    // Deterministic drop & cleanup at exit of scope
    close_resource(mut buf);
    
    if valid == 1 {
        return 0; // Success
    }
    return 1;
}

fn main() -> i32 {
    let code = process_with_block();
    return code; // PASS: 0
}
