struct Particle {
    x: f32,
    y: f32,
    vx: f32,
    vy: f32,
}

fn update_particle(p: Particle) -> Particle {
    let old = Particle(p.x, p.y, p.vx, p.vy);
    let nx = old.x + 1.0;
    let ny = old.y + 1.0;
    let next = Particle(nx, ny, old.vx, old.vy);
    return next;
}

fn main() -> i32 {
    let p = Particle(0.0, 0.0, 1.0, 1.0);
    let p2 = update_particle(p);
    return 0;
}
