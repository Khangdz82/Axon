// Test 38: Standards-Compliant Native WebView App Host (`std/webview.ax`)
use std::net
use std::webview

@test
fn test_webview_create_rejects_bad_port_and_binds_loopback() {
    bad := webview_create("Bad Port", 80, 1200, 800, "<h1>Hi</h1>") or WebviewApp(
        title = "", port = -1, width = 0, height = 0,
        listener = TcpListener(fd = -1, api = net_load() or NetApi(lib = 0, fn_socket = 0, fn_bind = 0, fn_listen = 0, fn_accept = 0, fn_connect = 0, fn_send = 0, fn_recv = 0, fn_close = 0, fn_setsockopt = 0, fn_getaddrinfo = 0, fn_freeaddrinfo = 0)),
        html_body = ""
    )
    assert(bad.port == -1)

    wv := webview_create("Axon Studio", 18432, 1280, 800, "<!doctype html><html><body><h1>OK</h1></body></html>") or return
    assert(wv.port == 18432 and wv.width == 1280 and wv.height == 800)
    webview_close(wv)
}
