// Test 08: Real OS Win64 File I/O (`fs_write_file`, `fs_read_file`), `ByteBuf`, `IntBuf` & Colorless `spawn`

fn main() -> i32 {
    tmp_path := "bin/test_io_roundtrip.bin"
    out_buf := buf_new(256)
    buf_push_str(out_buf, "AXON_IO_OK:")
    buf_push_u32(out_buf, 0x44332211)

    written := fs_write_file(tmp_path, out_buf) or -1
    if written != 15 {
        return 81
    }

    in_buf := fs_read_file(tmp_path) or buf_new(64)
    if buf_len(in_buf) != 15 {
        return 82
    }

    header := buf_slice_str(in_buf, 0, 11)
    if header != "AXON_IO_OK:" {
        return 83
    }
    if buf_get(in_buf, 11) != 0x11 or buf_get(in_buf, 14) != 0x44 {
        return 84
    }

    // Colorless fiber `spawn` + `.join()` with isolated linear buffer move
    worker := spawn {
        b0 := buf_get(move in_buf, 12)
        return b0 + 100
    }
    joined := worker.join()
    // 0x22 (34) + 100 = 134
    if joined != 134 {
        return 85
    }

    println(f"  [08] Native Win64 File I/O + ByteBuf + spawn.join() verified: written={written}, joined={joined}")
    return 0
}
