// Test 14 (v7.0): Multi-Core OS-Thread `par_for` (`CreateThread`) + Native Win64 `IOCP` `async`/`await`

use std::async_io

struct Agent {
    x: f32
    vx: f32
}

async fn run_iocp_batch(reactor: AsyncReactor) -> i64 {
    k1 := await async_submit_and_wait(reactor, 128, 7001)
    k2 := await async_submit_and_wait(reactor, 256, 7002)
    k3 := await async_submit_and_wait(reactor, 512, 7003)
    return k1 + k2 + k3
}

fn main() -> i32 {
    // 1. Multi-core OS thread pool `par_for` over 65,536 rows
    n := 65536
    swarm := Table[Agent]::with_capacity(n)
    table_fill_f32(swarm, 0, 100.0)
    table_fill_f32(swarm, 1, 6.0)

    par_for a in swarm {
        a.x += a.vx * 5.0
    }

    first_x := table_get_f32(swarm, 0, 0) as i64
    mid_x := table_get_f32(swarm, 0, 32768) as i64
    last_x := table_get_f32(swarm, 0, 65535) as i64
    if first_x != 130 or mid_x != 130 or last_x != 130 {
        return 141
    }

    // 2. Native Windows Kernel IOCP + Stackless `async`/`await`
    reactor := reactor_new() or return 142
    sum_keys := await run_iocp_batch(reactor)
    reactor_close(move reactor)
    if sum_keys != 21006 {
        return 143
    }

    threads := cpu_threads()
    println(f"  [14] v7 Multi-core par_for ({threads} threads, N=65536 -> {last_x}) + Win64 IOCP async/await (keys={sum_keys}) verified")
    return 0
}
