// Axon v1.0.0 Comprehensive Verification Suite for Desktop UI/UX, Memory Leak Guard, AI, Game2D & Stdlib
// (`tests/pass/35_ui_mem_ai_game_30_suite.ax`)

use std::os
use std::str
use std::ui
use std::ui_render
use std::ui_signal
use std::mem_guard
use std::ai_engine
use std::game2d
use std::prelude
use std::datetime
use std::csv
use std::toml
use std::cache

@test
fn test_prelude_and_datetime() {
    assert(parse_int_or("  -4200 ", 0) == -4200)
    assert(clamp_i64(150, 0, 100) == 100)
    assert(str_eq(format_bytes(2048), "2 KB"))

    dt := dt_parse_iso8601("2026-11-21T18:45:30Z")
    assert(dt.year == 2026 and dt.month == 11 and dt.day == 21)
    assert(dt.hour == 18 and dt.minute == 45 and dt.second == 30)
    iso := dt_format_iso8601(dt)
    assert(str_eq(iso, "2026-11-21T18:45:30Z"))
}

@test
fn test_toml_and_csv() {
    doc := toml_parse("[app]\nname = \"Axon Desktop\"\nfps = 240\nvsync = true\n")
    assert(str_eq(toml_get_str(doc, "app", "name", ""), "Axon Desktop"))
    assert(toml_get_i64(doc, "app", "fps", 0) == 240)
    assert(toml_get_bool(doc, "app", "vsync", false) == true)
    toml_free(move doc)

    tbl := csv_parse("id,title,score\n1,\"Fast UI\",950\n2,\"Zero Lag\",1050\n")
    assert(tbl.row_count == 3 and tbl.col_count == 3)
    assert(str_eq(csv_get(tbl, 1, 1), "Fast UI"))
    assert(csv_sum_col_i64(tbl, 2, 1) == 2000)
    csv_free(move tbl)
}

@test
fn test_mem_guard_zero_leaks_and_double_free_block() {
    g := leak_guard_new(256)
    p1 := leak_guard_alloc(g, 128)
    p2 := leak_guard_alloc(g, 256)
    assert(p1 != 0 and p2 != 0)
    assert(leak_guard_active_blocks(g) == 2)
    assert(leak_guard_active_bytes(g) == 384)
    assert(leak_guard_free(g, p1) == true)
    assert(leak_guard_free(g, p2) == true)
    assert(leak_guard_is_clean(g) == true)
    // Verify double-free is safely blocked and recorded
    assert(leak_guard_free(g, p1) == false)
    assert(leak_guard_double_frees(g) == 1)
    leak_guard_destroy(move g)

    arena := frame_arena_new(65536)
    a1 := frame_arena_alloc(arena, 512)
    assert(a1 != 0 and frame_arena_used(arena) == 512)
    frame_arena_reset(arena)
    assert(frame_arena_used(arena) == 0)
    frame_arena_free(move arena)

    pool := obj_pool_new(64, 32)
    s0 := obj_pool_acquire(pool)
    assert(s0 >= 0 and obj_pool_active_count(pool) == 1)
    assert(obj_pool_release(pool, s0) == true)
    assert(obj_pool_release(pool, s0) == false)
    obj_pool_free(move pool)
}

@test
fn test_cache_lru_and_bloom() {
    c := lru_new(64)
    lru_put(c, 10, 1000)
    lru_put(c, 20, 2000)
    assert(lru_get(c, 10, -1) == 1000)
    assert(lru_get(c, 20, -1) == 2000)
    assert(lru_get(c, 99, -1) == -1)
    assert(lru_hits(c) == 2 and lru_misses(c) == 1)
    lru_free(move c)

    bf := bloom_new(4096)
    bloom_add(bf, 424242)
    assert(bloom_may_contain(bf, 424242) == true)
    bloom_free(move bf)
}

@test
fn test_ui_fast_raster_and_virtual_list() {
    mut app := ui_window_html("Fast UI Test", 320, 200, "<div class=\"p-4 bg-slate-800 rounded-lg\"><h1 id=\"t\">Axon</h1></div>")
    _ := ui_signal(mut app, "cnt", 0)
    _ := ui_bind_signal(mut app, "cnt", "t", 1, "Count: ", "")
    _ := ui_render(mut app)
    assert(ui_signal_update_and_patch(mut app, "cnt", 42) == true)
    assert(ui_signal_get(app, "cnt") == 42)
    assert(ui_canvas_checksum(app) > 0)
    assert(ui_virtual_list_visible(100000, 2800, 28, 560) == 22)
    (sp_pos, sp_vel) := ui_spring_step(0.0, 100.0, 0.0, 180.0, 20.0, 0.016)
    assert(sp_pos > 0.0 and sp_vel > 0.0)
    canvas_free(move app.canvas)
    signal_graph_free(move app.signals)
}

@test
fn test_ai_and_game2d_kernels() {
    unsafe {
    x := mem_alloc_aligned(64 * 4 + 64)
    w := mem_alloc_aligned(64 * 4 + 64)
    o := mem_alloc_aligned(64 * 4 + 64)
    mut i := 0
    while i < 64 {
        ptr_write_f32(x, i, (i as f64) * 0.1 + 0.1)
        ptr_write_f32(w, i, 1.0)
        i += 1
    }
    ai_rmsnorm_f32(o, x, w, 64, 0.00001)
    ai_rope_inplace_f32(o, 64, 3)
    ai_softmax_inplace_f32(o, 64)
    best := ai_argmax_f32(o, 64)
    assert(best >= 0 and best < 64)
    mem_free_aligned(x); mem_free_aligned(w); mem_free_aligned(o)

    tm := g2_tilemap_new(16, 16)
    plen := g2_astar_find_path(tm, 1, 1, 14, 14)
    assert(plen == 27)
    g2_tilemap_free(move tm)
    }
}
