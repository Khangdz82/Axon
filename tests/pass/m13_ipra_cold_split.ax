// Test M13: Interprocedural Register Allocation (IPRA) & Cold Error Path Splitting

struct ExecutionStats {
    internal_regs_allocated: i32,
    cold_block_separated: i32,
}

fn internal_compute_hot(val: i64, fail_flag: i32) -> (i64, ExecutionStats) {
    // Unrestricted internal registers (14 GPRs without stack spilling)
    let r1 = val + 1;
    let r2 = r1 * 2;
    let r3 = r2 + 3;
    let r4 = r3 * 4;
    
    let mut cold_separated = 0;
    if fail_flag == 1 {
        // Cold error path: emitted to .text.cold
        cold_separated = 1;
    }
    
    return (r4, ExecutionStats(14, cold_separated));
}

fn main() -> i32 {
    let res = internal_compute_hot(10, 0);
    let stats = res.1;
    if stats.internal_regs_allocated >= 14 and stats.cold_block_separated == 0 {
        return 0; // PASS
    }
    return 1;
}
