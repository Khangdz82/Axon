// Axon v1.0.0 Production Stdlib Verification (`std/str`, `std/http`, `std/data`, `std/test_kit`)

use std::os
use std::str
use std::http
use std::data
use std::test_kit

fn main() -> i64 {
    t0 := bench_start()
    s := suite_new("v0.9.1-stdlib")

    // 1. std::str
    assert_true(s, str_cmp("abc", "abd") < 0, "str_cmp less")
    assert_eq_i64(s, str_cmp("abc", "abc"), 0, "str_cmp eq")
    assert_eq_i64(s, str_find("axon compiler", "comp", 0), 5, "str_find")
    assert_eq_i64(s, str_rfind("a/b/c/d", "/"), 5, "str_rfind")
    assert_true(s, str_contains("zero-allocation", "alloc"), "str_contains")
    assert_eq_str(s, str_trim(" \t hello \r\n "), "hello", "str_trim")
    assert_eq_str(s, str_to_lower("AxOn_09"), "axon_09", "str_to_lower")
    assert_eq_str(s, str_to_upper("AxOn_09"), "AXON_09", "str_to_upper")
    assert_true(s, str_eq_ignore_case("Content-Type", "content-type"), "eq_ignore_case")
    assert_eq_str(s, str_repeat("ab", 4), "abababab", "str_repeat")
    assert_eq_str(s, str_replace("foo bar foo", "foo", "bazzz"), "bazzz bar bazzz", "str_replace grow")
    assert_eq_str(s, str_replace("hello---world---!", "---", "-"), "hello-world-!", "str_replace shrink")
    assert_eq_str(s, str_from_i64(-123456), "-123456", "str_from_i64")
    assert_eq_str(s, str_from_i64(0), "0", "str_from_i64 zero")

    sp := str_split_ranges("alpha,beta,gamma", 44)
    assert_eq_i64(s, str_split_count(sp), 3, "split count")
    assert_eq_str(s, str_split_at("alpha,beta,gamma", sp, 1), "beta", "split item 1")
    buf_free(move sp)

    hx := str_to_hex("Ax0")
    assert_eq_str(s, hx, "417830", "str_to_hex")
    uhx := str_from_hex(hx) or "ERR"
    assert_eq_str(s, uhx, "Ax0", "str_from_hex")
    bad_hx := str_from_hex("123") or "BAD"
    assert_eq_str(s, bad_hx, "BAD", "str_from_hex odd reject")

    // RFC 4648 Base64 vectors
    assert_eq_str(s, base64_encode(""), "", "b64 empty")
    assert_eq_str(s, base64_encode("f"), "Zg==", "b64 f")
    assert_eq_str(s, base64_encode("fo"), "Zm8=", "b64 fo")
    assert_eq_str(s, base64_encode("foobar"), "Zm9vYmFy", "b64 foobar")
    b64d := base64_decode("Zm9vYmFy") or "ERR"
    assert_eq_str(s, b64d, "foobar", "b64 decode foobar")
    b64f := base64_decode("Zg==") or "ERR"
    assert_eq_str(s, b64f, "f", "b64 decode f")
    b64bad := base64_decode("Z===") or "BAD"
    assert_eq_str(s, b64bad, "BAD", "b64 bad padding")

    uenc := url_encode("hi world/100%?")
    assert_eq_str(s, uenc, "hi%20world%2F100%25%3F", "url_encode")
    udec := url_decode("hi+world%2F100%25%3F") or "ERR"
    assert_eq_str(s, udec, "hi world/100%?", "url_decode")

    // 2. std::http
    raw_req := "POST /api/v1/users/42?q=axon%20fast&lang=ax HTTP/1.1\r\nHost: localhost\r\ncontent-type: application/json\r\nContent-Length: 11\r\n\r\n{\"ok\":true}"
    req := http_parse_request(raw_req) or HttpRequest("", "", "", "", "", -1)
    assert_eq_str(s, req.method, "POST", "http method")
    assert_eq_str(s, req.path, "/api/v1/users/42", "http path")
    assert_eq_i64(s, req.content_len, 11, "http content_len")
    assert_eq_str(s, req.body, "{\"ok\":true}", "http body")
    hdr := http_get_header(raw_req, "Content-Type") or "NONE"
    assert_eq_str(s, hdr, "application/json", "http case-insensitive header")
    qp := http_query_param(req.query, "q") or "NONE"
    assert_eq_str(s, qp, "axon fast", "http query_param")
    assert_true(s, http_route_match("/api/v1/users/:id", req.path), "http route match")
    uid := http_route_param("/api/v1/users/:id", req.path, "id") or "NONE"
    assert_eq_str(s, uid, "42", "http route param")
    assert_eq_str(s, http_mime_type("app.wasm"), "application/wasm", "http mime wasm")
    assert_true(s, not http_is_safe_header_val("text/plain\r\nSet-Cookie: pwn=1"), "http reject CRLF header")

    resp := http_build_response(200, "text/plain\r\nEvil: 1", "ok", "")
    assert_true(s, not str_contains(resp, "Evil: 1"), "http CRLF fallback content-type")
    assert_true(s, str_contains(resp, "X-Content-Type-Options: nosniff"), "http sec header")
    sse := http_sse_event("token", "hello\nworld", "7")
    assert_eq_str(s, sse, "id: 7\nevent: token\ndata: hello world\n\n", "http sse sanitize")

    // 3. std::data (CSV + Log + Checksummed KvStore)
    assert_eq_str(s, csv_escape_cell("a,\"b\""), "\"a,\"\"b\"\"\"", "csv escape")
    csv_line := "101,\"hello, \"\"axon\"\"\",true"
    c1 := csv_get_cell(csv_line, 1) or "ERR"
    assert_eq_str(s, c1, "hello, \"axon\"", "csv parse quoted")

    kv := kv_new(64, 65536)
    assert_true(s, kv_set(kv, "k1", "val1"), "kv set k1")
    assert_true(s, kv_set(kv, "k2", "val2"), "kv set k2")
    assert_true(s, kv_set(kv, "k1", "val1_updated"), "kv overwrite k1")
    assert_eq_i64(s, kv_len(kv), 2, "kv len 2")
    assert_true(s, kv_del(kv, "k2"), "kv del k2")
    assert_true(s, not kv_has(kv, "k2"), "kv has deleted false")
    g1 := kv_get(kv, "k1") or "MISS"
    assert_eq_str(s, g1, "val1_updated", "kv get k1")

    snap_path := ".tmp_test22_kv.axkv"
    saved_bytes := kv_save(kv, snap_path) or -1
    assert_true(s, saved_bytes > 24, "kv_save bytes")
    kv_free(move kv)

    kv2 := kv_load(snap_path) or kv_new(16, 4096)
    g2 := kv_get(kv2, "k1") or "MISS"
    assert_eq_str(s, g2, "val1_updated", "kv_load roundtrip")
    assert_eq_i64(s, kv_len(kv2), 1, "kv_load len")
    kv_free(move kv2)

    // Tamper 1 byte in snapshot -> checksum MUST reject!
    tamper_buf := fs_read_file(snap_path) or buf_new(0)
    if buf_len(tamper_buf) > 25 {
        buf_set(tamper_buf, 25, buf_get(tamper_buf, 25) ^ 1)
        _w := fs_write_file(snap_path, tamper_buf) or -1
    }
    buf_free(move tamper_buf)
    kv_bad := kv_load(snap_path) or kv_new(16, 4096)
    assert_true(s, not kv_has(kv_bad, "k1"), "kv_load rejects tampered checksum")
    kv_free(move kv_bad)

    rc := suite_finish(move s)
    us := bench_elapsed_us(t0)
    println(f"  [22] stdlib suite done in {us} us")
    return rc
}
