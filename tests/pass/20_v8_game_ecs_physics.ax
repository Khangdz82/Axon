// Axon v8.0 Test Suite 20: Archetype ECS, 2D SAT, 3D Kinematics & Rasterizer
use std::game_ecs
use std::game_physics
use std::game_render
use std::audio

fn test_ecs_subsystem() -> bool {
    mut world := ecs_world_new(256)

    // Spawn entities across different archetypes
    m_pv := comp_position() | comp_velocity()
    m_pvr := comp_position() | comp_velocity() | comp_renderable() | comp_rigid_body()
    m_pc := comp_position() | comp_collider()

    e1 := ecs_spawn(world, m_pv)
    e2 := ecs_spawn(world, m_pvr)
    e3 := ecs_spawn(world, m_pc)

    ecs_set_position(world, e1, 10.0, 20.0, 0.0)
    ecs_set_velocity(world, e1, 5.0, -2.0, 0.0)

    ecs_set_position(world, e2, 0.0, 100.0, 0.0)
    ecs_set_velocity(world, e2, 0.0, 0.0, 0.0)
    ecs_set_render(world, e2, 0xFF00FF00, 1.0)
    ecs_set_rigid_body(world, e2, 1.0, 0.5, 0.2, 0.0)

    ecs_set_position(world, e3, 50.0, 50.0, 0.0)
    ecs_set_collider(world, e3, 2.5, 1)

    // Run movement and gravity systems
    _moved := ecs_system_movement(world, 0.5)
    _grav := ecs_system_gravity(world, 0.0, -10.0, 0.0, 0.5)

    // Verify e1 position: x = 10 + 5*0.5 = 12.5, y = 20 + (-2*0.5) = 19.0
    px1 := ecs_get_pos_x(world, e1)
    py1 := ecs_get_pos_y(world, e1)
    if px1 < 12.4 or px1 > 12.6 {
        ecs_world_free(move world)
        return false
    }
    if py1 < 18.9 or py1 > 19.1 {
        ecs_world_free(move world)
        return false
    }

    // Verify e2 velocity affected by gravity: vy = 0 + (-10*0.5) = -5.0
    vy2 := ecs_get_vel_y(world, e2)
    if vy2 < -5.1 or vy2 > -4.9 {
        ecs_world_free(move world)
        return false
    }

    // Test O(1) swap-remove despawning
    despawned := ecs_despawn(world, e2)
    if not despawned {
        ecs_world_free(move world)
        return false
    }
    if ecs_is_alive(world, e2) {
        ecs_world_free(move world)
        return false
    }
    if not ecs_is_alive(world, e1) or not ecs_is_alive(world, e3) {
        ecs_world_free(move world)
        return false
    }

    ecs_world_free(move world)
    return true
}

fn test_physics_subsystem() -> bool {
    // 1. Circle vs Circle Collision
    c1 := Circle2D(cx = 0.0, cy = 0.0, r = 5.0)
    c2 := Circle2D(cx = 6.0, cy = 0.0, r = 3.0)
    m_circle := phys2d_circle_vs_circle(c1, c2)
    if not m_circle.has_hit { return false }
    // Overlap depth: (5 + 3) - 6 = 2.0
    if m_circle.depth < 1.9 or m_circle.depth > 2.1 { return false }

    // 2. 2D SAT OBB vs OBB Collision
    // Box 1 at (0, 0), half-width=4, half-height=4
    // Box 2 at (6, 0), half-width=4, half-height=4
    m_obb := phys2d_sat_obb_vs_obb(0.0, 0.0, 4.0, 4.0, 0.0, 6.0, 0.0, 4.0, 4.0, 0.0)
    if not m_obb.has_hit { return false }
    if m_obb.depth < 1.9 or m_obb.depth > 2.1 { return false }

    // 3. 2D Raycast vs Circle
    ray2d := Ray2D(ox = -10.0, oy = 0.0, dx = 1.0, dy = 0.0)
    hit2d := phys2d_ray_circle(ray2d, c1, 50.0)
    if not hit2d.hit { return false }
    // Distance to circle boundary (radius 5 at origin) starting from x = -10: t = 5.0
    if hit2d.t < 4.9 or hit2d.t > 5.1 { return false }

    // 4. 3D Möller-Trumbore Ray-Triangle Intersection
    ray3d := Ray3D(ox = 0.0, oy = 0.0, oz = -5.0, dx = 0.0, dy = 0.0, dz = 1.0)
    hit3d := phys3d_ray_triangle(ray3d, -2.0, -2.0, 0.0, 2.0, -2.0, 0.0, 0.0, 2.0, 0.0, 50.0)
    if not hit3d.hit { return false }
    // Distance to triangle at z = 0 starting from z = -5: t = 5.0
    if hit3d.t < 4.9 or hit3d.t > 5.1 { return false }

    // 5. 3D Kinematics Integration
    mut body := phys3d_body_new(0.0, 10.0, 0.0, 1.0)
    phys3d_body_set_vel(body, 2.0, 0.0, 0.0)
    phys3d_integrate_body(body, 0.0, -9.8, 0.0, 0.5)

    bx := phys3d_body_px(body)
    by := phys3d_body_py(body)
    phys3d_body_free(move body)

    if bx < 0.9 or bx > 1.1 { return false }
    if by >= 10.0 { return false } // Must have fallen under gravity

    return true
}

fn test_render_subsystem() -> bool {
    mut fb := fb_new(64, 64)
    fb_clear(fb, 0xFF000000, 1.0)

    // Draw Bresenham Line
    fb_draw_line(fb, 0, 0, 10, 10, 0xFFFFFFFF)
    p0 := fb_get_pixel(fb, 0, 0)
    p5 := fb_get_pixel(fb, 5, 5)
    if p0 != 0xFFFFFFFF or p5 != 0xFFFFFFFF {
        fb_free(move fb)
        return false
    }

    // Draw Triangle with Depth Buffer
    fb_draw_triangle_depth(fb, 10.0, 10.0, 0.2, 50.0, 10.0, 0.2, 30.0, 50.0, 0.2, 0xFFFF0000)
    p_center := fb_get_pixel(fb, 30, 20)
    d_center := fb_get_depth(fb, 30, 20)
    if p_center != 0xFFFF0000 {
        fb_free(move fb)
        return false
    }
    if d_center < 0.19 or d_center > 0.21 {
        fb_free(move fb)
        return false
    }

    // Sprite Batch Rendering
    mut batch := render_batch_new(16)
    render_batch_draw(mut batch, 2.0, 2.0, 4.0, 4.0, 0xFF00FF00)
    render_batch_flush(mut batch, fb)
    render_batch_free(move batch)

    p_sprite := fb_get_pixel(fb, 3, 3)
    fb_free(move fb)

    if p_sprite != 0xFF00FF00 {
        return false
    }

    return true
}

fn test_audio_subsystem() -> bool {
    b := buf_new(2048)
    s_cnt := audio_synth_square(b, 440.0, 0.01)
    if s_cnt <= 0 {
        buf_free(move b)
        return false
    }
    s_zero := audio_synth_square(b, 0.0, 0.005)
    if s_zero <= 0 {
        buf_free(move b)
        return false
    }
    audio_apply_adsr(b, 0.002, 0.002, 0.7, 0.1)
    buf_free(move b)
    return true
}

fn main() -> i32 {
    println("[20] Running v8.0 Game Engine ECS, Physics & Renderer test suite...")

    ok_ecs := test_ecs_subsystem()
    if not ok_ecs {
        println("FAILED: Archetype ECS movement, gravity or despawn test failed!")
        return 1
    }
    println("  [PASS] Archetype-based SoA ECS query iteration, systems and O(1) swap-remove verified.")

    ok_phys := test_physics_subsystem()
    if not ok_phys {
        println("FAILED: Physics 2D SAT, Raycast, or 3D Moller-Trumbore test failed!")
        return 1
    }
    println("  [PASS] 2D Circle, 2D SAT OBB, 2D Raycast, 3D Moller-Trumbore and Kinematics verified.")

    ok_render := test_render_subsystem()
    if not ok_render {
        println("FAILED: Software rasterizer, Bresenham line, Z-buffer, or sprite batch test failed!")
        return 1
    }
    println("  [PASS] Framebuffer rasterizer, Bresenham line, scanline Z-buffer and sprite batch verified.")

    ok_aud := test_audio_subsystem()
    if not ok_aud {
        println("FAILED: Audio synthesizer or ADSR envelope test failed!")
        return 1
    }
    println("  [PASS] Audio PCM synthesizer frequency guards and ADSR release envelope verified.")

    println("[20] All Game Engine ECS, Physics and Renderer tests passed cleanly!")
    return 0
}
