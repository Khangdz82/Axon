// Test 01: Pythonic Zero-Ceremony Syntax (`and`/`or`/`not`, `:=`, Named Args, Default Args, `|>` Pipe, `f"..."`)

fn connect_endpoint(host: str, port: i64 = 8080, retries: i64 = 3, tls: bool = true) -> i64 {
    mut score := str_len(host) * 100 + port + retries * 10
    if tls and not (port == 80) {
        score += 7
    }
    return score
}

fn add_offset(val: i64, delta: i64) -> i64 {
    return val + delta
}

fn scale_val(val: i64, factor: i64) -> i64 {
    return val * factor
}

fn main() -> i32 {
    // 1. Out-of-order named arguments + default parameter values
    s1 := connect_endpoint(port = 443, host = "axon.io")
    // str_len("axon.io")=7 -> 700 + 443 + 30 + 7 = 1180
    if s1 != 1180 {
        return 11
    }

    s2 := connect_endpoint("local", port = 80, retries = 1, tls = false)
    // 500 + 80 + 10 = 590
    if s2 != 590 {
        return 12
    }

    // 2. Pipeline `|>` operator desugaring + Pythonic boolean logic
    piped := 15 |> add_offset(5) |> scale_val(3)
    if piped != 60 {
        return 13
    }

    ok_logic := (piped == 60 and s1 > 1000) and (false or not false)
    if not ok_logic {
        return 14
    }

    // 3. String equality & interpolated f-string execution
    tag := "superlang"
    if tag != "superlang" or tag == "other" {
        return 15
    }
    println(f"  [01] Pythonic syntax & named-args verified: s1={s1}, piped={piped}")
    return 0
}
