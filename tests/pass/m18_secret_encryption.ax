// Test M18: Compile-Time String/Constant Encryption & In-Register Decryption (`@secret`)

struct SecretTestContext {
    plaintext_word: i64,
    ephemeral_key: i64,
    ciphertext_word: i64,
    decrypted_word: i64,
    passed: i32,
}

fn encrypt_constant_at_comptime(plaintext: i64, key: i64) -> i64 {
    // Compile-time secret mixing
    let mask = (key *% 6364136223846793005) ^ -49064778989728563;
    return plaintext ^ mask;
}

fn decrypt_constant_in_registers(ciphertext: i64, key: i64) -> i64 {
    // Runtime decryption executes directly in CPU register (RAX / RDX)
    let mask = (key *% 6364136223846793005) ^ -49064778989728563;
    let plaintext = ciphertext ^ mask;
    return plaintext;
}

fn simulate_secure_wipe(mut val: i64) -> i64 {
    // Volatile memory zeroing after use
    val = 0;
    return val;
}

fn main() -> i32 {
    // Represents API_KEY: "AXON-SEC" packed in 64-bit integer
    let original_secret: i64 = 4785604130324838465;
    let ephemeral_key: i64 = 884920491823901234;

    // 1. Compile-time encryption: ciphertext resides in rodata
    let cipher = encrypt_constant_at_comptime(original_secret, ephemeral_key);
    let ciphertext_differs = if cipher != original_secret { 1 } else { 0 };

    // 2. Runtime in-register decryption
    let decrypted = decrypt_constant_in_registers(cipher, ephemeral_key);
    let plaintext_matches = if decrypted == original_secret { 1 } else { 0 };

    // 3. Register / stack buffer wipe
    let wiped = simulate_secure_wipe(decrypted);
    let wipe_ok = if wiped == 0 { 1 } else { 0 };

    if ciphertext_differs == 1 and plaintext_matches == 1 and wipe_ok == 1 {
        return 0; // PASS
    }
    return 1;
}
