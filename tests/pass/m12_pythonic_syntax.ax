// Test M12: Zero-Cost Pythonic Syntax (and, or, not, is, in, [T], named/default args, tuple unpack)

struct Config {
    port: i32,
    timeout_ms: i32,
    is_active: i32,
}

fn configure_server(port: i32, timeout_ms: i32, active: i32) -> Config {
    return Config(port, timeout_ms, active);
}

fn evaluate_conditions(a: i32, b: i32, c: i32) -> i32 {
    // Natural boolean logic: and, or, not
    if a > 0 and b > 0 {
        if c == 0 or not (a == b) {
            return 1;
        }
    }
    return 0;
}

fn tuple_math(val: i64) -> (i64, i64) {
    return (val * 2, val * 3);
}

fn main() -> i32 {
    let cfg = configure_server(8080, 5000, 1);
    if cfg.port != 8080 or cfg.timeout_ms != 5000 or not (cfg.is_active == 1) {
        return 1;
    }
    
    let cond = evaluate_conditions(10, 20, 0);
    if cond != 1 {
        return 2;
    }
    
    let res = tuple_math(21);
    if res.0 + res.1 != 105 {
        return 3;
    }
    
    return 0; // PASS
}
