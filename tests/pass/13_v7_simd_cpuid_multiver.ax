// Test 13 (v7.0): Runtime CPUID Multi-Versioning (`Scalar SSE2` / `AVX2+FMA3` / `AVX-512F EVEX`)

struct SimBody {
    pos: f32
    vel: f32
    energy: f32
}

fn main() -> i32 {
    // Prime length `1031` exercises 16-wide ZMM (64x16=1024) / 8-wide YMM (128x8=1024) + 7-element SSE2 tail!
    n := 1031
    bodies := Table[SimBody]::with_capacity(n)
    table_fill_f32(bodies, 0, 5.0)
    table_fill_f32(bodies, 1, 3.0)
    table_fill_f32(bodies, 2, 2.0)

    dt := 4.0
    for b in bodies {
        b.pos += b.vel * dt
        b.energy *= 5.0
    }

    p0 := table_get_f32(bodies, 0, 0) as i64
    p_tail := table_get_f32(bodies, 0, 1030) as i64
    e_tail := table_get_f32(bodies, 2, 1030) as i64
    if p0 != 17 or p_tail != 17 or e_tail != 10 {
        return 131
    }

    tier := cpu_simd_tier()
    println(f"  [13] v7 CPUID SIMD multi-versioning verified: tier={tier}, pos[0]={p0}, pos[1030]={p_tail}, energy[1030]={e_tail}")
    return 0
}
