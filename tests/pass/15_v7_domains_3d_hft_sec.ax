// Test 15 (v7.0): 3D Game SIMD (`vec3`/`quat`/`mat4`/`FrameArena`) + `@no_alloc` HFT (`dec`/`SpscRing`) + Taint Security

use std::math3d
use std::decimal
use std::ringbuf
use std::taint

@no_alloc
fn hft_process_tick(ring: SpscRing, bid: dec, ask: dec) -> dec {
    mid := round_half_even((bid + ask) / 2)
    _ok := spsc_try_push(ring, 55001)
    return mid
}

fn main() -> i32 {
    // 1. 3D Game SIMD Math + 60-FPS 0-Syscall FrameArena
    v_up := vec3_new(0.0, 1.0, 0.0)
    v_right := vec3_new(1.0, 0.0, 0.0)
    v_fwd := vec3_cross(v_right, v_up)
    if (v_fwd.z as i64) != 1 {
        return 151
    }
    tr := Transform3D(pos = vec3_new(10.0, 20.0, 30.0), rot = quat_id(), scale = vec3_new(2.0, 2.0, 2.0))
    model := transform3d_matrix(tr)
    world_pt := transform_point(model, vec3_new(3.0, 4.0, 5.0))
    if (world_pt.x as i64) != 16 or (world_pt.y as i64) != 28 or (world_pt.z as i64) != 40 {
        return 152
    }

    farena := frame_arena_new(65536)
    mut frame := 0
    while frame < 1000 {
        _p1 := frame_arena_alloc(farena, 256)
        _p2 := frame_arena_alloc(farena, 512)
        frame_arena_reset(farena)
        frame += 1
    }
    if frame_arena_used(farena) != 0 {
        frame_arena_free(move farena)
        return 153
    }
    frame_arena_free(move farena)

    // 2. HFT Exact Banker's Rounding + `@no_alloc` Lock-Free SPSC Queue
    r_even := round_half_even(1.2250d)
    r_odd := round_half_even(1.2350d)
    if r_even != 1.22d or r_odd != 1.24d {
        return 154
    }
    ring := spsc_new(64)
    mid_px := hft_process_tick(ring, 100.00d, 100.05d)
    popped := spsc_try_pop(ring) or -1
    spsc_free(move ring)
    if mid_px != 100.02d or popped != 55001 {
        return 155
    }

    // 3. Compile-Time Taint Tracking + Runtime Sanitizer Enforcement
    good_in := taint_str("acct_9001")
    clean_id := sanitize_sql_id(good_in) or return 156
    q_len := sql_exec(f"SELECT balance FROM ledger WHERE id = '{clean_id}'")
    if q_len <= 20 {
        return 157
    }

    sqli_attack := taint_str("admin'; DROP TABLE ledger;--")
    rejected := sanitize_sql_id(sqli_attack) or "BLOCKED"
    if rejected != "BLOCKED" {
        return 158
    }

    path_attack := taint_str("../../Windows/System32/cmd.exe")
    blocked_path := sanitize_subpath(path_attack) or "BLOCKED_PATH"
    if blocked_path != "BLOCKED_PATH" {
        return 159
    }

    println(f"  [15] v7 3D SIMD (pt={world_pt.x as i64},{world_pt.y as i64},{world_pt.z as i64}) + HFT @no_alloc (mid={mid_px}, pop={popped}) + Taint Defense verified")
    return 0
}
