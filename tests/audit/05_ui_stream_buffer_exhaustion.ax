// VULNERABILITY AUDIT 5: Continuous streaming exceeds fixed 256KB buffer, crashing via h_sec_trap()
use std::html
use std::ui_signal

fn main() -> i64 {
    mut tree := html_parse("<div id=\"chat\">Initial</div>") or return 1
    mut g := signal_graph_new()
    sig_idx := signal_register_str(mut g, "token", "")
    signal_bind_node(mut g, sig_idx, 0, signal_target_text(), "", "")

    mut s := ""
    mut i := 0
    // Streaming 3000 steps of 100-byte tokens -> crashes at ~72 steps (262KB limit)
    while i < 100 {
        s = s + "1234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890"
        signal_set_str(mut g, mut tree, "token", s)
        i += 1
    }
    return 0
}
