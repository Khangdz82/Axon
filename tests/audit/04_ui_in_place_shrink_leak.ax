// VULNERABILITY AUDIT 4: In-place text shrink causes subsequent allocations to leak buffer
use std::html

fn main() -> i64 {
    mut tree := html_parse("<div id=\"test\">Initial</div>") or return 1
    
    // Set 20 bytes
    dom_set_text(mut tree, 0, "12345678901234567890")
    off1 := buf_len(tree.dynamic_buf)
    
    // Shrink to 5 bytes (in-place)
    dom_set_text(mut tree, 0, "12345")
    off2 := buf_len(tree.dynamic_buf)
    
    // Grow back to 10 bytes (still <= original 20 bytes!)
    dom_set_text(mut tree, 0, "1234567890")
    off3 := buf_len(tree.dynamic_buf)
    
    println(f"off1: {off1}, off2: {off2}, off3: {off3}")
    if off3 > off2 {
        println("[FLAW DETECTED] dom_set_text leaked new allocation instead of reusing slot!")
    }
    return 0
}
