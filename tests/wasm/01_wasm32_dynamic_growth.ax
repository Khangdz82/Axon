// Axon v1.0.0 WASM32-Specific Dynamic Linear-Memory Growth & SIMD128 Test Suite
// Tests multi-page `memory.grow` growth in ByteBuf & IntBuf + SIMD128 operations.

use std::test_kit

fn main() -> i64 {
    s := suite_new("v1.0.0-wasm32-growth")

    // 1. ByteBuf auto-grow starting from cap=8 past 65,536 bytes (> 1 WASM 64KB page)
    bb := buf_new(8)
    mut i := 0
    while i < 70000 {
        buf_push(bb, (i * 7 + 3) & 255)
        i += 1
    }
    assert_eq_i64(s, buf_len(bb), 70000, "wasm ByteBuf grew past 1 page")
    assert_eq_i64(s, buf_get(bb, 0), 3, "wasm ByteBuf elem 0")
    assert_eq_i64(s, buf_get(bb, 69999), (69999 * 7 + 3) & 255, "wasm ByteBuf elem 69999")
    buf_free(move bb)

    // 2. IntBuf auto-grow starting from cap=4 past 8,000 i64s (> 64KB)
    ib := ibuf_new(4)
    i = 0
    while i < 8000 {
        ibuf_push(ib, i * 1000003)
        i += 1
    }
    assert_eq_i64(s, ibuf_len(ib), 8000, "wasm IntBuf grew past 64KB")
    assert_eq_i64(s, ibuf_get(ib, 7999), 7999 * 1000003, "wasm IntBuf elem 7999")

    // 3. Large dynamic string slice across page boundary
    sb := buf_new(16)
    i = 0
    while i < 1000 {
        buf_push_str(sb, "AXON_WASM_")
        i += 1
    }
    big_s := buf_slice_str(sb, 0, buf_len(sb))
    assert_eq_i64(s, str_len(big_s), 10000, "wasm 10KB string built via growth")
    assert_eq_i64(s, str_byte(big_s, 9999), 95, "wasm 10KB string last byte '_'")
    buf_free(move sb)

    return suite_finish(move s)
}
