// Benchmark 4: Zero-Copy Parser (1 GB Stream - Refinement Bounds Elision)
struct ParseRecord {
    timestamp: i64,
    status_code: i32,
    bytes_read: i32,
    is_valid: i32,
}

fn parse_log_chunk(data: Table[i32], chunk_len: usize where chunk_len <= data.len) -> i32 {
    isolated idx: usize = 0;
    isolated valid_count: i32 = 0;
    while idx < chunk_len {
        let b = data[idx];
        if b > 32 {
            valid_count += 1;
        }
        idx += 1;
    }
    return valid_count;
}

fn main() -> i32 {
    isolated buffer = Table[i32]::with_capacity(1_000_000);
    isolated iters: i64 = 0;
    while iters < 100 {
        let count = parse_log_chunk(buffer, 1_000_000);
        iters += 1;
    }
    return 0;
}
