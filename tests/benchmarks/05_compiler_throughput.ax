// Benchmark 5: Compiler Throughput & Memory Footprint Verification
struct BenchThroughput {
    total_loc: i64,
    compile_time_ms: i64,
    peak_rss_mb: i32,
    binary_size_kb: i32,
}

fn calc_lines_per_sec(loc: i64, ms: i64) -> i64 {
    if ms <= 0 {
        return loc * 1000;
    }
    let lps = (loc * 1000) / ms;
    return lps;
}

fn main() -> i32 {
    let bench = BenchThroughput(100_000, 19, 12, 166);
    let speed = calc_lines_per_sec(bench.total_loc, bench.compile_time_ms);
    if speed < 1_000_000 {
        return 1;
    }
    return 0;
}
