// Benchmark 3: High-Concurrency Fiber Ping-Pong (1M Tasks - Colorless Work-Stealing)
struct TaskState {
    id: i64,
    counter: i64,
}

fn fiber_ping(state: TaskState) -> TaskState {
    let next_val = state.counter + 1;
    return TaskState(state.id, next_val);
}

fn main() -> i32 {
    isolated s = TaskState(1, 0);
    isolated step: i64 = 0;
    while step < 1_000_000 {
        let job = spawn {
            let res = fiber_ping(s);
            return res;
        };
        s = job.join();
        step += 1;
    }
    return 0;
}
