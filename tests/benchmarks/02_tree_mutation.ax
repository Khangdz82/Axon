// Benchmark 2: Binary Tree In-Place Mutation (5M Nodes - Perceus FBIP Reuse)
struct TreeNode {
    val: i64,
    left_id: i32,
    right_id: i32,
    balance: i32,
}

fn mutate_node(node: TreeNode, delta: i64) -> TreeNode {
    let old = TreeNode(node.val, node.left_id, node.right_id, node.balance);
    let nval = old.val +% delta;
    let next = TreeNode(nval, old.left_id, old.right_id, old.balance);
    return next;
}

fn main() -> i32 {
    isolated node = TreeNode(100, 0, 0, 0);
    isolated count: i64 = 0;
    while count < 5_000_000 {
        node = mutate_node(node, 1);
        count += 1;
    }
    return 0;
}
