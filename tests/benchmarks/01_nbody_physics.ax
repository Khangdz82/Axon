// Benchmark 1: N-Body Physics Simulation (10M Particles - Native SoA + Auto-SIMD)
struct Particle {
    x: f32,
    y: f32,
    vx: f32,
    vy: f32,
}

fn step_nbody(mut swarm: Table[Particle], dt: f32) {
    for p in swarm {
        p.x += p.vx * dt;
        p.y += p.vy * dt;
    }
}

fn main() -> i32 {
    isolated world = Table[Particle]::with_capacity(10_000_000);
    isolated f: i64 = 0;
    while f < 100 {
        step_nbody(mut world, 0.016);
        f += 1;
    }
    return 0;
}
