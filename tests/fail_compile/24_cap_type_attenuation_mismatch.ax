// Compile-time Bounds / Negative Fixed Array Capacity or Ambient FsCap Violation:
// Reading host file without FsCap when ambient IO guard is active via cap module.
use std::cap

fn main() -> i32 {
    // Missing write permission: passing wrong parameter type `RootCap` to `cap_read_file(FsCap, str)` must fail compile!
    root := acquire_root_cap()
    _b := cap_read_file(root, "secret.txt") or buf_new(0)
    return 0
}
