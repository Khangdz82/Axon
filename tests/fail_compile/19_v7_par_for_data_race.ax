// Static Multi-Core Data-Race Violation Test (`E0204`): `par_for` mutates shared outer scalar.

struct Particle {
    x: f32
    vx: f32
}

fn main() -> i32 {
    pts := Table[Particle]::with_capacity(1024)
    mut shared_counter := 0
    par_for p in pts {
        p.x = p.x + p.vx
        shared_counter += 1
    }
    return 0
}
