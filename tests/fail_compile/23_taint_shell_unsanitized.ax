// Compile-time Taint Violation Test: untrusted `tainted[str]` cannot reach `shell_exec` directly.
fn shell_exec(cmd: str) -> i64 { return str_len(cmd) }
fn taint_str(raw: str) -> tainted[str] { return raw }

fn main() -> i32 {
    user_arg := taint_str("foo; id")
    _r := shell_exec(f"ls {user_arg}")
    return 0
}
