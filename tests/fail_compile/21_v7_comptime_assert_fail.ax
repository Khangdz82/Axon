// Compile-Time Assertion Failure Test (`E0604`): `comptime_assert` evaluated inside AST VM during `sema`.

comptime fn validate_sql_prefix(q: str) -> bool {
    return str_len(q) >= 6 and str_slice(q, 0, 6) == "SELECT"
}

comptime {
    comptime_assert(validate_sql_prefix("DROP TABLE users"), "Only SELECT queries allowed in read replica")
}

fn main() -> i32 {
    return 0
}
