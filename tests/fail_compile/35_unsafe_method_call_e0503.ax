// Expect E0503: calling `unsafe fn` struct method outside `unsafe` block must fail compile
struct RawMem {
    addr: i64
}

impl RawMem {
    unsafe fn poke(self: RawMem, v: i64) -> i64 {
        return self.addr + v
    }
}

fn main() -> i32 {
    m := RawMem(addr = 10)
    _ := m.poke(5)
    return 0
}
