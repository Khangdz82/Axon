// Transitive `@no_alloc` Violation Test (`E0601`): hot-path HFT tick calls an allocating helper.

fn sneaky_helper() -> i64 {
    b := buf_new(128)
    n := buf_len(b)
    buf_free(move b)
    return n
}

@no_alloc
fn on_market_tick(price: dec) -> i64 {
    if price > 0.00d {
        return sneaky_helper()
    }
    return 0
}

fn main() -> i32 {
    return 0
}
